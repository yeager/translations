#: ../scripts/ltnu.pod:58
msgid "pkg-zsh"
msgstr "pkg-zsh"

#. type: textblock
#: ../scripts/ltnu.pod:60
msgid "pkg-zsh-devel@lists.alioth.debian.org"
msgstr "pkg-zsh-devel@lists.alioth.debian.org"

#. type: =item
