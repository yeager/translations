msgid "B<+FORMAT>"
msgstr "B<+FORMAT>"

#. type: Plain text
#: ../scripts/annotate-output.1:24
msgid ""
"A format string that may use the conversion specifiers from the "
"B<date>(1)-utility. The printed string is separated from the following "
"stream indicator by a single space. May be overridden by later options that "
"specify the format string."
msgstr ""
"En formatsträng som kan använda konverteringsspecifikationerna från "
"verktyget B<date>(1). Den utskrivna strängen skiljs från följande "
"strömindikator med ett mellanslag. Kan åsidosättas av senare flaggor som "
"anger formatsträngen."

#. type: Plain text
#: ../scripts/annotate-output.1:26
msgid "Defaults to \"%H:%M:%S\"."
msgstr "Standardinställningen är \"%H:%M:%S\"."

#. type: TP
#: ../scripts/annotate-output.1:26
#, no-wrap
msgid "B<--raw-date-format> I<FORMAT>"
msgstr "B<--raw-date-format> I<FORMAT>"

#. type: Plain text
#: ../scripts/annotate-output.1:32
msgid ""
"A format string that may use the conversion specifiers from the "
"B<date>(1)-utility. There is no separator between the printed string and the"
" following stream indicator. May be overridden by later options that specify"
" the format string."
msgstr ""
"En formatsträng som kan använda konverteringsspecifikationerna från "
"verktyget B<date>(1). Ingen avgränsare finns mellan den utskrivna strängen "
"och följande strömindikator. Kan åsidosättas av senare flaggor som anger "
"formatsträngen."

#. type: TP
#: ../scripts/annotate-output.1:32
#, no-wrap
msgid "B<-->"
msgstr "B<-->"

#. type: Plain text
#: ../scripts/annotate-output.1:35
msgid "Ends option parsing (unless it is itself an argument to an option)."
msgstr ""
"Avslutar tolkningen av flaggor om den inte själv är ett argument till en "
"flagga."

