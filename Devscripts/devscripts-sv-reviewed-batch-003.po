#: ../scripts/dcmd.1:46
#, no-wrap
msgid "B<--indepudeb>"
msgstr "B<--indepudeb>"

#. type: Plain text
#: ../scripts/dcmd.1:49
msgid "Select architecture-independent I<.udeb> binary packages."
msgstr "Välj arkitekturoberoende binärpaket av typen I<.udeb>."

#. type: TP
#: ../scripts/dcmd.1:49
#, no-wrap
msgid "B<--udeb>"
msgstr "B<--udeb>"

#. type: Plain text
#: ../scripts/dcmd.1:52
msgid ""
"Select I<.udeb> binary packages. Implies B<--archudeb> and B<--indepudeb>."
msgstr ""
"Välj binärpaket av typen I<.udeb>. Medför B<--archudeb> och B<--indepudeb>."

#. type: TP
#: ../scripts/dcmd.1:52
#, no-wrap
msgid "B<--tar>,\\ B<--orig>"
msgstr "B<--tar>,\\ B<--orig>"

#. type: Plain text
#: ../scripts/dcmd.1:55
msgid "Select the upstream I<.tar> file."
msgstr "Välj uppströmsfilen I<.tar>."

#. type: TP
#: ../scripts/dcmd.1:55
#, no-wrap
msgid "B<--diff>,\\ B<--debtar>"
msgstr "B<--diff>,\\ B<--debtar>"

#. type: Plain text
#: ../scripts/dcmd.1:58
msgid "Select the Debian I<.debian.tar> or I<.diff> file."
msgstr "Välj Debian-filen I<.debian.tar> eller I<.diff>."

#. type: Plain text
#: ../scripts/dcmd.1:61
msgid ""
"Each option may be prefixed by B<--no> to indicate that all files I<not> "
"matching the specification should be selected."
msgstr ""
"Varje alternativ kan föregås av B<--no> för att ange att alla filer som "
"I<inte> matchar specifikationen ska väljas."

#. type: Plain text
#: ../scripts/dcmd.1:65
msgid ""
"It is not possible to combine positive filtering options (e.g. B<--dsc>)  "
"and negative filtering options (e.g. B<--no-changes>) in the same B<dcmd> "
"invocation."
msgstr ""
"Det går inte att kombinera positiva filtreringsalternativ (till exempel "
"B<--dsc>) och negativa filtreringsalternativ (till exempel B<--no-changes>) "
"i samma B<dcmd>-anrop."

#. type: TP
#: ../scripts/dcmd.1:65
#, no-wrap
msgid "B<--no-fail-on-missing>, B<-r>"
msgstr "B<--no-fail-on-missing>, B<-r>"

#. type: Plain text
#: ../scripts/dcmd.1:68
msgid "If any of the requested files were not found, do not output an error."
msgstr ""
"Om någon av de begärda filerna inte hittades, skriv inte ut något fel."

#. type: TP
#: ../scripts/dcmd.1:68
#, no-wrap
msgid "B<--package>, B<-p>"
msgstr "B<--package>, B<-p>"

#. type: Plain text
#: ../scripts/dcmd.1:71
msgid "Output package name part only."
msgstr "Skriv endast ut paketnamnsdelen."

#. type: TP
#: ../scripts/dcmd.1:71
#, no-wrap
msgid "B<--sort>, B<-s>"
msgstr "B<--sort>, B<-s>"

#. type: Plain text
#: ../scripts/dcmd.1:74
