msgstr "B<--buildinfo>"

#. type: Plain text
#: ../scripts/dcmd.1:25
msgid "Select the I<.buildinfo> file."
msgstr "Välj filen I<.buildinfo>."

#. type: TP
#: ../scripts/dcmd.1:25
#, no-wrap
msgid "B<--schanges>"
msgstr "B<--schanges>"

#. type: Plain text
#: ../scripts/dcmd.1:28
msgid "Select I<.changes> files for the 'source' architecture."
msgstr "Välj I<.changes>-filer för 'source'-arkitekturen."

#. type: TP
#: ../scripts/dcmd.1:28
#, no-wrap
msgid "B<--bchanges>"
msgstr "B<--bchanges>"

#. type: Plain text
#: ../scripts/dcmd.1:31
msgid "Select I<.changes> files for binary architectures."
msgstr "Välj I<.changes>-filer för binära arkitekturer."

#. type: TP
#: ../scripts/dcmd.1:31
#, no-wrap
msgid "B<--changes>"
msgstr "B<--changes>"

#. type: Plain text
#: ../scripts/dcmd.1:34
msgid "Select I<.changes> files. Implies B<--schanges> and B<--bchanges>."
msgstr "Välj I<.changes>-filer. Medför B<--schanges> och B<--bchanges>."

#. type: TP
#: ../scripts/dcmd.1:34
#, no-wrap
msgid "B<--archdeb>"
msgstr "B<--archdeb>"

#. type: Plain text
#: ../scripts/dcmd.1:37
msgid "Select architecture-dependent binary packages (I<.deb> files)."
msgstr "Välj arkitekturberoende binärpaket (I<.deb>-filer)."

#. type: TP
#: ../scripts/dcmd.1:37
#, no-wrap
msgid "B<--indepdeb>"
msgstr "B<--indepdeb>"

#. type: Plain text
#: ../scripts/dcmd.1:40
msgid "Select architecture-independent binary packages (I<.deb> files)."
msgstr "Välj arkitekturoberoende binärpaket (I<.deb>-filer)."

#. type: TP
#: ../scripts/dcmd.1:40
#, no-wrap
msgid "B<--deb>"
msgstr "B<--deb>"

#. type: Plain text
#: ../scripts/dcmd.1:43
msgid ""
"Select binary packages (I<.deb> files). Implies B<--archdeb> and "
"B<--indepdeb>."
msgstr ""
"Välj binärpaket (I<.deb>-filer). Medför B<--archdeb> och B<--indepdeb>."

#. type: TP
#: ../scripts/dcmd.1:43
#, no-wrap
msgid "B<--archudeb>"
msgstr "B<--archudeb>"

#. type: Plain text
#: ../scripts/dcmd.1:46
msgid "Select architecture-dependent I<.udeb> binary packages."
msgstr "Välj arkitekturberoende binärpaket av typen I<.udeb>."

