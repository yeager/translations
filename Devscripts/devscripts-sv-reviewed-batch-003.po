msgid "pkg-perl"
msgstr "pkg-perl"

#. type: textblock
#: ../scripts/ltnu.pod:56
msgid "pkg-perl-maintainers@lists.alioth.debian.org"
msgstr "pkg-perl-maintainers@lists.alioth.debian.org"

