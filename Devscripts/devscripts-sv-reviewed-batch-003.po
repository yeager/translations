"  Matching-Pattern: https://registry.npmjs.org/aes-js/-/aes-js-(\\d[\\d\\.]*)@ARCHIVE_EXT@\n"
"\n"

#. type: =head3
#: ../scripts/debian-watch.pod:537
msgid "HTTP options"
msgstr "HTTP-alternativ"

#. type: =item
#: ../scripts/debian-watch.pod:541
msgid "B<User-Agent:> I<< <user-agent-string> >>"
msgstr "B<User-Agent:> I<< <user-agent-string> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:543 ../scripts/debian-watch-4.pod:472
msgid ""
"Set the user-agent string used to contact the HTTP(S) server as I<user-"
"agent-string>. (persistent)"
msgstr ""
"Ange användaragentsträngen I<user-agent-string> som används för kontakt med "
"HTTP(S)-servern. (Varaktigt.)"

#. type: =head3
#: ../scripts/debian-watch.pod:548
msgid "Metacpan options"
msgstr "MetaCPAN-alternativ"

#. type: =item
#: ../scripts/debian-watch.pod:552
msgid "B<Maturity:> I<< <maturity> >>"
msgstr "B<Maturity:> I<< <maturity> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:554
msgid ""
"Select the kind of CPAN releases to look at. This option is valid only in "
"B<metacpan> mode."
msgstr ""
"Välj vilken typ av CPAN-utgåvor som ska beaktas. Alternativet är endast "
"giltigt i B<metacpan>-läge."

#. type: =item
#: ../scripts/debian-watch.pod:559
msgid "B<released> I<(default)>: consider only stable releases"
msgstr "B<released> I<(standard)>: beakta endast stabila utgåvor."

#. type: =item
#: ../scripts/debian-watch.pod:561
msgid ""
"B<developer>: consider only developer releases, I<i.e.> releases whose "
"version contains a B<_> or whose archive name ends with B<-TRIAL>"
msgstr ""
"B<developer>: beakta endast utvecklarutgåvor, det vill säga utgåvor vars "
"version innehåller B<_> eller vars arkivnamn slutar med B<-TRIAL>."

#. type: =item
#: ../scripts/debian-watch.pod:564
msgid "B<any>: consider all releases"
msgstr "B<any>: beakta alla utgåvor."

#. type: textblock
#: ../scripts/debian-watch.pod:568
msgid ""
"MetaCPAN strips the developer suffix from the version it reports "
"I<(B<v1.0.901> for F<Carton-v1.0.901-TRIAL.tar.gz>)>; B<uscan> restores it "
"so that a developer release isn't mistaken for the final one. As a B<-> "
"can't be used in a Debian upstream version and always introduces a pre-"
"release marker here I<(B<-TRIAL>, B<-alpha1>, ...)>, it is replaced by a "
"B<~>, which sorts such a version before the matching final release."
msgstr ""
"MetaCPAN tar bort utvecklarsuffixet från versionen som rapporteras "
"I<(B<v1.0.901> för F<Carton-v1.0.901-TRIAL.tar.gz>)>; B<uscan> återställer "
"det så att en utvecklarutgåva inte misstas för den slutliga. Eftersom B<-> "
"inte kan användas i en Debian-uppströmsversion och alltid anger en "
"förhandsutgåva här I<(B<-TRIAL>, B<-alpha1>, …)>, ersätts det med B<~>, "
"vilket sorterar en sådan version före motsvarande slutliga utgåva."

#. type: =head2
#: ../scripts/debian-watch.pod:577
msgid "Filename and version manipulations"
msgstr "Filnamns- och versionsmanipuleringar"

#. type: =item
#: ../scripts/debian-watch.pod:581
msgid "B<Dversion-Mangle:> I<< <rules> >>"
msgstr "B<Dversion-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:583 ../scripts/debian-watch-4.pod:485
msgid ""
"Normalize the last upstream version string found in F<debian/changelog> to "
"compare it to the available upstream tarball version.  Removal of the Debian"
" specific suffix such as B<s/@DEB_EXT@//> is usually done here."
msgstr ""
"Normalisera den senaste uppströmsversionssträngen i F<debian/changelog> för "
"att jämföra den med den tillgängliga uppströmsversionen av tararkivet. "
"Borttagning av Debian-specifika suffix som B<s/@DEB_EXT@//> görs vanligen "
"här."

#. type: textblock
#: ../scripts/debian-watch.pod:587
msgid ""
"You can also use \"B<Dversion-Mangle: auto>\", this is exactly the same than"
" \"B<< Dversion-Mangle: s/@DEB_EXT@// >>\""
msgstr ""
"Du kan också använda \"B<Dversion-Mangle: auto>\"; det är exakt samma som "
"\"B<< Dversion-Mangle: s/@DEB_EXT@// >>\"."

#. type: =item
#: ../scripts/debian-watch.pod:590
msgid "B<Dirversion-Mangle:> I<< <rules> >>"
msgstr "B<Dirversion-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:592 ../scripts/debian-watch-4.pod:494
msgid ""
"Normalize the directory path string matching the regex in a set of "
"parentheses of B<http://>I<URL> as the sortable version index string.  This "
"is used as the directory path sorting index only."
msgstr ""
"Normalisera katalogvägssträngen som matchar det reguljära uttrycket inom en "
"parentesgrupp i B<http://>I<URL> som den sorterbara versionsindexsträngen. "
"Detta används endast som sorteringsindex för katalogvägen."

#. type: textblock
#: ../scripts/debian-watch.pod:596
msgid "Substitution such as B<< s/PRE/~pre/; s/RC/~rc/ >> may help."
msgstr "Ersättningar som B<< s/PRE/~pre/; s/RC/~rc/ >> kan hjälpa."

#. type: =item
#: ../scripts/debian-watch.pod:598
msgid "B<Page-Mangle:> I<< <rules> >>"
msgstr "B<Page-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:600 ../scripts/debian-watch-4.pod:502
msgid ""
"Normalize the downloaded web page string.  (Don't use this unless this is "
"absolutely needed.  Generally, B<g> flag is required for these I<rules>.)"
msgstr ""
"Normalisera den hämtade webbsidessträngen. (Använd inte detta om det inte är"
" absolut nödvändigt. Vanligen krävs flaggan B<g> för dessa I<rules>.)"

#. type: textblock
#: ../scripts/debian-watch.pod:603 ../scripts/debian-watch-4.pod:505
msgid ""
"This is handy if you wish to access Amazon AWS or Subversion repositories in"
" which <a href=\"...\"> is not used."
msgstr ""
"Detta är praktiskt om du vill använda Amazon AWS- eller Subversion-arkiv där"
" <a href=\"...\"> inte används."

#. type: =item
#: ../scripts/debian-watch.pod:606
msgid "B<Uversion-Mangle:> I<< <rules> >>"
msgstr "B<Uversion-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:608 ../scripts/debian-watch-4.pod:510
msgid ""
"Normalize the candidate upstream version strings extracted from hrefs in the"
" source of the web page.  This is used as the version sorting index when "
"selecting the latest upstream version."
msgstr ""
"Normalisera kandidatsträngarna för uppströmsversioner som extraheras från "
"href-värden i webbsidans källkod. Detta används som versionssorteringsindex "
"vid val av senaste uppströmsversion."

#. type: textblock
#: ../scripts/debian-watch.pod:612 ../scripts/debian-watch-4.pod:498
#: ../scripts/debian-watch-4.pod:514
msgid "Substitution such as B<s/PRE/~pre/; s/RC/~rc/> may help."
msgstr "Ersättningar som B<s/PRE/~pre/; s/RC/~rc/> kan hjälpa."

#. type: textblock
#: ../scripts/debian-watch.pod:614
msgid ""
"You can also use \"B<Uversion-Mangle: auto>\", this is exactly the same than"
" \"B<< Uversion-Mangle: "
"s/(\\d)[_\\.\\-\\+]?((?:RC|rc|pre|dev|beta|alpha)\\d*)$/$1~$2/ >>\""
msgstr ""
"Du kan också använda \"B<Uversion-Mangle: auto>\"; det är exakt samma som "
"\"B<< Uversion-Mangle: "
"s/(\\d)[_\\.\\-\\+]?((?:RC|rc|pre|dev|beta|alpha)\\d*)$/$1~$2/ >>\"."

#. type: =item
#: ../scripts/debian-watch.pod:617
msgid "B<Version-Mangle:> I<< <rules> >>"
msgstr "B<Version-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:619
msgid "Syntactic shorthand for:"
msgstr "Syntaktisk förkortning för:"

#. type: verbatim
#: ../scripts/debian-watch.pod:621
#, no-wrap
msgid ""
"  Uversion-Mangle: <rules>\n"
"  Dversion-Mangle: <rules>\n"
"\n"
msgstr ""
"  Uversion-Mangle: <rules>\n"
"  Dversion-Mangle: <rules>\n"
"\n"

#. type: =item
#: ../scripts/debian-watch.pod:624 ../scripts/debian-watch-4.pod:520
msgid "B<hrefdecode=percent-encoding>"
msgstr "B<hrefdecode=percent-encoding>"

#. type: textblock
#: ../scripts/debian-watch.pod:626
msgid ""
"When set to B<yes>, convert the selected upstream tarball href string from "
"the percent-encoded hexadecimal string to the decoded normal URL string for "
"obfuscated web sites. Only B<percent-encoding> is available and it is "
"decoded with B<s/%([A-Fa-f\\d]{2})/chr hex $1/eg>."
msgstr ""
"När inställningen är B<yes> konverteras den valda href-strängen för "
"uppströms tararkiv från en procentkodad hexadecimal sträng till en avkodad "
"normal URL-sträng för dolda webbplatser. Endast B<percent-encoding> är "
"tillgängligt och det avkodas med B<s/%([A-Fa-f\\d]{2})/chr hex $1/eg>."

#. type: =item
#: ../scripts/debian-watch.pod:631
msgid "B<Download-Url-Mangle:> I<< <rules> >>"
msgstr "B<Download-Url-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:633 ../scripts/debian-watch-4.pod:529
msgid ""
"Convert the selected upstream tarball href string into the accessible URL "
"for obfuscated web sites.  This is run after B<hrefdecode>."
msgstr ""
"Konvertera den valda href-strängen för uppströms tararkiv till en "
"tillgänglig URL för dolda webbplatser. Detta körs efter B<hrefdecode>."

#. type: =item
#: ../scripts/debian-watch.pod:636
msgid "B<Filename-Mangle:> I<< <rules> >>"
msgstr "B<Filename-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:638 ../scripts/debian-watch-4.pod:534
msgid ""
"Generate the upstream tarball filename from the selected href string if "
"I<matching-pattern> can extract the latest upstream version I<< <uversion> "
">> from the selected href string.  Otherwise, generate the upstream tarball "
"filename from its full URL string and set the missing I<< <uversion> >> from"
" the generated upstream tarball filename."
msgstr ""
"Generera filnamnet på uppströms tararkiv från den valda href-strängen om "
"I<matching-pattern> kan extrahera senaste uppströmsversionen I<< <uversion> "
">> därifrån. Annars genereras filnamnet från hela URL-strängen och det "
"saknade I<< <uversion> >> sätts från det genererade filnamnet."

#. type: textblock
#: ../scripts/debian-watch.pod:644 ../scripts/debian-watch-4.pod:540
msgid ""
"Without this option, the default upstream tarball filename is generated by "
"taking the last component of the URL and removing everything after any '?' "
"or '#'."
msgstr ""
"Utan detta alternativ skapas standardfilnamnet för uppströms tararkivet "
"genom att ta den sista URL-komponenten och ta bort allt efter \"?\" eller "
"\"#\"."

#. type: textblock
#: ../scripts/debian-watch.pod:648
msgid ""
"You can use here \"B<Filename-Mangle: auto>\", this is exactly the same than"
" \"B<< Filename-Mangle: s/.*?(@ANY_VERSION@@ARCHIVE_EXT@)/@PACKAGE@-$1/ >>\""
" for main source or \"B<< Filename-Mangle: "
"s/.*?(@ANY_VERSION@@ARCHIVE_EXT@)/@PACKAGE@-@COMPONENT@-$1/ >>\" for "
"components."
msgstr ""
"Du kan använda \"B<Filename-Mangle: auto>\"; det är exakt samma som \"B<< "
"Filename-Mangle: s/.*?(@ANY_VERSION@@ARCHIVE_EXT@)/@PACKAGE@-$1/ >>\" för "
"huvudkällan eller \"B<< Filename-Mangle: "
"s/.*?(@ANY_VERSION@@ARCHIVE_EXT@)/@PACKAGE@-@COMPONENT@-$1/ >>\" för "
"komponenter."

#. type: =item
#: ../scripts/debian-watch.pod:653
msgid "B<Pgp-Sig-Url-Mangle:> I<< <rules> >>"
msgstr "B<Pgp-Sig-Url-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:655 ../scripts/debian-watch-4.pod:546
msgid ""
"Generate the candidate upstream signature file URL string from the upstream "
"tarball URL."
msgstr ""
"Generera kandidat-URL:en för uppströms signaturfil från uppströms tararkivs "
"URL."

#. type: =item
#: ../scripts/debian-watch.pod:658
msgid "B<Oversion-Mangle:> I<< <rules> >>"
msgstr "B<Oversion-Mangle:> I<< <rules> >>"

#. type: textblock
#: ../scripts/debian-watch.pod:660 ../scripts/debian-watch-4.pod:551
msgid ""
"Generate the version string I<< <oversion> >> of the source tarball I<< "
"<spkg>_<oversion>.orig.tar.gz >> from I<< <uversion> >>.  This should be "
"used to add a suffix such as B<+dfsg> to a MUT package."
msgstr ""
"Generera versionssträngen I<< <oversion> >> för källarkivet I<< "
"<spkg>_<oversion>.orig.tar.gz >> från I<< <uversion> >>. Detta bör användas "
"för att lägga till ett suffix som B<+dfsg> till ett MUT-paket."

#. type: textblock
#: ../scripts/debian-watch.pod:666 ../scripts/debian-watch-4.pod:557
msgid ""
"Here, the mangling rules apply the I<rules> to the pertinent string.  "
"Multiple rules can be specified in a mangling rule string by making a "
"concatenated string of each mangling I<rule> separated by B<;> (semicolon)."
msgstr ""
"Här tillämpar omskrivningsreglerna I<rules> på den relevanta strängen. Flera"
" regler kan anges i en omskrivningsregelsträng genom att sammanfoga varje "
"omskrivnings-I<rule> med B<;> (semikolon)."

#. type: textblock
#: ../scripts/debian-watch.pod:670 ../scripts/debian-watch-4.pod:561
msgid ""
"Each mangling I<rule> cannot contain B<;> (semicolon), B<,> (comma), or "
"B<\"> (double quote)."
msgstr ""
"Varje omskrivnings-I<rule> får inte innehålla B<;> (semikolon), B<,> (komma)"
" eller B<\"> (dubbelt citattecken)."

#. type: textblock
#: ../scripts/debian-watch.pod:673 ../scripts/debian-watch-4.pod:564
msgid ""
"Each mangling I<rule> behaves as if a Perl command \"I<$string> B<=~> "
"I<rule>\" is executed.  There are some notable details."
msgstr ""
"Varje omskrivnings-I<rule> fungerar som om Perl-kommandot \"I<$string> B<=~>"
" I<rule>\" kördes. Några detaljer är särskilt viktiga."

#. type: =item
#: ../scripts/debian-watch.pod:678 ../scripts/debian-watch-4.pod:569
msgid "* I<rule> may only use the B<s>, B<tr>, and B<y> operations."
msgstr "* I<rule> får endast använda operationerna B<s>, B<tr> och B<y>."

#. type: =item
#: ../scripts/debian-watch.pod:682 ../scripts/debian-watch-4.pod:573
msgid "B<s/>I<regex>B</>I<replacement>B</>I<options>"
msgstr "B<s/>I<regex>B</>I<replacement>B</>I<options>"

#. type: textblock
#: ../scripts/debian-watch.pod:684 ../scripts/debian-watch-4.pod:575
msgid ""
"Regex pattern match and replace the target string.  Only the B<g>, B<i> and "
"B<x> flags are available.  Use the B<$1> syntax for back references (No "
"B<\\1> syntax).  Code execution is not allowed (i.e. no B<(?{})> or "
"B<(??{})> constructs)."
msgstr ""
"Matcha reguljära uttryck och ersätt målsträngen. Endast flaggorna B<g>, B<i>"
" och B<x> är tillgängliga. Använd syntaxen B<$1> för bakåtreferenser (ingen "
"syntax B<>). Kodkörning är inte tillåten (dvs. inga konstruktioner B<(?{})>"
" eller B<(??{})>)."

#. type: =item
#: ../scripts/debian-watch.pod:689 ../scripts/debian-watch-4.pod:580
msgid "B<y/>I<source>B</>I<dest>B</> or B<tr/>I<source>B</>I<dest>B</>"
msgstr "B<y/>I<source>B</>I<dest>B</> eller B<tr/>I<source>B</>I<dest>B</>"

#. type: textblock
#: ../scripts/debian-watch.pod:691 ../scripts/debian-watch-4.pod:582
msgid "Transliterate the characters in the target string."
msgstr "Transliterera tecknen i målsträngen."

#. type: =head1
#: ../scripts/debian-watch.pod:697 ../scripts/debian-watch-4.pod:588
msgid "EXAMPLE OF EXECUTION"
msgstr "EXEMPEL PÅ UTFÖRANDE"

#. type: textblock
#: ../scripts/debian-watch.pod:699 ../scripts/debian-watch-4.pod:590
msgid ""
"B<uscan> reads the first entry in F<debian/changelog> to determine the "
"source package name and the last upstream version."
msgstr ""
"B<uscan> läser den första posten i F<debian/changelog> för att fastställa "
"källpaketets namn och den senaste uppströmsversionen."

#. type: textblock
#: ../scripts/debian-watch.pod:702 ../scripts/debian-watch-4.pod:593
msgid "For example, if the first entry of F<debian/changelog> is:"
msgstr "Om till exempel den första posten i F<debian/changelog> är:"

#. type: =item
#: ../scripts/debian-watch.pod:706 ../scripts/debian-watch-4.pod:597
msgid "* I<< bar >> (B<3:2.03+dfsg-4>) unstable; urgency=low"
msgstr "* I<< bar >> (B<3:2.03+dfsg-4>) unstable; urgency=low"

#. type: textblock
#: ../scripts/debian-watch.pod:710 ../scripts/debian-watch-4.pod:601
msgid ""
"then, the source package name is I<< bar >> and the last Debian package "
"version is B<3:2.03+dfsg-4>."
msgstr ""
"då är källpaketets namn I<< bar >> och den senaste Debian-paketversionen är "
"B<3:2.03+dfsg-4>."

#. type: textblock
#: ../scripts/debian-watch.pod:713 ../scripts/debian-watch-4.pod:604
msgid ""
"The last upstream version is normalized to B<2.03+dfsg> by removing the "
"epoch and the Debian revision."
msgstr ""
"Den senaste uppströmsversionen normaliseras till B<2.03+dfsg> genom att "
"epoken och Debian-revisionen tas bort."

#. type: textblock
#: ../scripts/debian-watch.pod:716
msgid ""
"If the B<Dversion-Mangle> rule exists, the last upstream version is further "
"normalized by applying this rule to it.  For example, if the last upstream "
"version is B<2.03+dfsg> indicating the source tarball is repackaged, the "
"suffix B<+dfsg> is removed by the string substitution B<s/\\+dfsg\\d*$//> to"
" make the (Dversion-Mangled) last upstream version B<2.03> and it is "
"compared to the candidate upstream tarball versions such as B<2.03>, "
"B<2.04>, ... found in the remote site.  Thus, set this rule as:"
msgstr ""
"Om regeln B<Dversion-Mangle> finns normaliseras den senaste "
"uppströmsversionen ytterligare genom att denna regel tillämpas på den. Om "
"den senaste uppströmsversionen till exempel är B<2.03+dfsg>, vilket anger "
"att källarkivet har paketerats om, tas suffixet B<+dfsg> bort genom "
"strängersättningen B<s/\\+dfsg\\d*$//>. Den senaste Dversion-Mangle-"
"bearbetade uppströmsversionen blir då B<2.03> och jämförs med tillgängliga "
"versioner av uppströms tararkiv, såsom B<2.03>, B<2.04>, ... på "
"fjärrplatsen. Ställ därför in denna regel så här:"

#. type: verbatim
#: ../scripts/debian-watch.pod:724
#, no-wrap
msgid ""
"  Dversion-Mangle: s/\\+dfsg\\d*$//\n"
"\n"
msgstr ""
"  Dversion-Mangle: s/\\+dfsg\\d*$//\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:726
msgid ""
"B<uscan> downloads a web page from B<http://>I<URL> specified in B<Source:> "
"field."
msgstr ""
"B<uscan> hämtar en webbsida från B<http://>I<URL> som anges i fältet "
"B<Source:>."

#. type: =item
#: ../scripts/debian-watch.pod:731
msgid ""
"* If the directory name part of B<Source:> has no parentheses, B<(> and "
"B<)>, it is taken as verbatim."
msgstr ""
"* Om katalognamnet i B<Source:> inte har några parenteser, B<(> och B<)>, "
"tas det som det står."

#. type: =item
#: ../scripts/debian-watch.pod:734
msgid ""
"* If the directory name part of B<Source:> has parentheses, B<(> and B<)>, "
"then B<uscan> recursively searches all possible directories to find a page "
"for the newest version.  If a B<Dirversion-Mangle> rule exists, the "
"generated sorting index is used to find the newest version.  If a specific "
"version is specified for the download, the matching version string has "
"priority over the newest version."
msgstr ""
"* Om katalognamnet i B<Source:> innehåller parenteser, B<(> och B<)>, söker "
"B<uscan> rekursivt igenom alla möjliga kataloger för att hitta en sida för "
"den senaste versionen. Om en B<Dirversion-Mangle>-regel finns används det "
"genererade sorteringsindexet för att hitta den senaste versionen. Om en "
"specifik version anges för nedladdningen har den matchande versionssträngen "
"prioritet framför den senaste versionen."

#. type: textblock
#: ../scripts/debian-watch.pod:743
msgid "For example, this B<Source: http://>I<URL> may be specified as:"
msgstr "Till exempel kan denna B<Source: http://>I<URL> anges som:"

#. type: verbatim
#: ../scripts/debian-watch.pod:745
#, no-wrap
msgid ""
"  Source: http://www.example.org/@ANY_VERSION@/\n"
"\n"
msgstr ""
"  Source: http://www.example.org/@ANY_VERSION@/\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:747 ../scripts/debian-watch-4.pod:646
msgid ""
"Please note the trailing B</> in the above to make B<@ANY_VERSION@> as the "
"directory."
msgstr "Observera att B</> i ovanstående gör B<@ANY_VERSION@> till katalogen."

#. type: textblock
#: ../scripts/debian-watch.pod:750
msgid ""
"If the B<Page-Mangle> rule exists, the whole downloaded web page as a string"
" is normalized by applying this rule to it.  This is very powerful tool and "
"needs to be used with caution.  If other mangling rules can be used to "
"address your objective, do not use this rule."
msgstr ""
"Om regeln B<Page-Mangle> finns normaliseras hela den nedladdade webbsidan "
"som en sträng genom att denna regel tillämpas på den. Detta är ett mycket "
"kraftfullt verktyg och måste användas med försiktighet. Om andra "
"omskrivningsregler kan användas för att uppnå ditt mål, använd inte denna "
"regel."

#. type: textblock
#: ../scripts/debian-watch.pod:755 ../scripts/debian-watch-4.pod:654
msgid ""
"The downloaded web page is scanned for hrefs defined in the B<< <a href=\" "
">> I<...> B<< \"> >> tag to locate the candidate upstream tarball hrefs.  "
"These candidate upstream tarball hrefs are matched by the Perl regex pattern"
" I<matching-pattern> such as B<< DL-(?:[\\d\\.]+?)/foo-(.+)\\.tar\\.gz >> to"
" narrow down the candidates.  This pattern match needs to be anchored at the"
" beginning and the end.  For example, candidate hrefs may be:"
msgstr ""
"Den nedladdade webbsidan genomsöks efter href-värden som definieras i taggen"
" B<< <a href=\" >> I<...> B<< \"> >> för att hitta tänkbara href-värden för "
"uppströms tararkiv. Dessa href-värden matchas med Perl-regex-mönstret "
"I<matching-pattern>, till exempel B<< DL-(?:[\\d\\.]+?)/foo-(.+)\\.tar\\.gz "
">>, för att begränsa urvalet. Denna mönstermatchning måste förankras i "
"början och slutet. Exempel på tänkbara href-värden kan vara:"

#. type: =item
#: ../scripts/debian-watch.pod:764 ../scripts/debian-watch-4.pod:663
msgid "* B<< DL-2.02/foo-2.02.tar.gz >>"
msgstr "* B<< DL-2.02/foo-2.02.tar.gz >>"

#. type: =item
#: ../scripts/debian-watch.pod:766 ../scripts/debian-watch-4.pod:665
msgid "* B<< DL-2.03/foo-2.03.tar.gz >>"
msgstr "* B<< DL-2.03/foo-2.03.tar.gz >>"

#. type: =item
#: ../scripts/debian-watch.pod:768 ../scripts/debian-watch-4.pod:667
msgid "* B<< DL-2.04/foo-2.04.tar.gz >>"
msgstr "* B<< DL-2.04/foo-2.04.tar.gz >>"

#. type: textblock
#: ../scripts/debian-watch.pod:772 ../scripts/debian-watch-4.pod:671
msgid ""
"Here the matching string of B<(.+)> in I<matching-pattern> is considered as "
"the candidate upstream version.  If there are multiple matching strings of "
"capturing patterns in I<matching-pattern>, they are all concatenated with "
"B<.> (period) to form the candidate upstream version.  Make sure to use the "
"non-capturing regex such as B<(?:[\\d\\.]+?)> instead for the variable text "
"matching part unrelated to the version."
msgstr ""
"Här betraktas den matchande strängen B<(.+)> i I<matching-pattern> som den "
"tänkbara uppströmsversionen. Om det finns flera matchande strängar från "
"fångande mönster i I<matching-pattern> sammanfogas de med B<.> (punkt) för "
"att bilda den tänkbara uppströmsversionen. Se till att i stället använda "
"icke-fångande reguljära uttryck, såsom B<(?:[\\d\\.]+?)>, för variabla "
"textmatchande delar som inte hör till versionen."

#. type: textblock
#: ../scripts/debian-watch.pod:779 ../scripts/debian-watch-4.pod:678
msgid "Then, the candidate upstream versions are:"
msgstr "Då är de möjliga uppströmsversionerna:"

#. type: =item
#: ../scripts/debian-watch.pod:783 ../scripts/debian-watch-4.pod:682
msgid "* B<2.02>"
msgstr "* B<2.02>"

#. type: =item
#: ../scripts/debian-watch.pod:785 ../scripts/debian-watch-4.pod:684
msgid "* B<2.03>"
msgstr "* B<2.03>"

#. type: =item
#: ../scripts/debian-watch.pod:787 ../scripts/debian-watch-4.pod:686
msgid "* B<2.04>"
msgstr "* B<2.04>"

#. type: textblock
#: ../scripts/debian-watch.pod:791 ../scripts/debian-watch-4.pod:690
msgid ""
"The downloaded tarball filename is basically set to the same as the filename"
" in the remote URL of the selected href."
msgstr ""
"Filnamnet på det nedladdade tararkivet är i princip samma som filnamnet i "
"den fjärranslutna URL:en för det valda href-värdet."

#. type: textblock
#: ../scripts/debian-watch.pod:794
msgid ""
"If the B<Uversion-Mangle> rule exists, the candidate upstream versions are "
"normalized by applying this rule to them. (This rule may be useful if the "
"upstream version scheme doesn't sort correctly to identify the newest "
"version.)"
msgstr ""
"Om regeln B<Uversion-Mangle> finns, normaliseras de aktuella "
"uppströmsversionerna genom att denna regel tillämpas på dem. (Denna regel "
"kan vara användbar om uppströmsversionsschemat inte sorterar korrekt för att"
" identifiera den senaste versionen.)"

#. type: textblock
#: ../scripts/debian-watch.pod:798
msgid ""
"The upstream tarball href corresponding to the newest (Uversion-Mangled)  "
"candidate upstream version newer than the (Dversion-Mangled) last upstream "
"version is selected."
msgstr ""
"Det href-värde för uppströms tararkiv som motsvarar den senaste tänkbara "
"Uversion-Mangle-bearbetade uppströmsversionen, nyare än den senaste "
"Dversion-Mangle-bearbetade uppströmsversionen, väljs."

#. type: textblock
#: ../scripts/debian-watch.pod:802 ../scripts/debian-watch-4.pod:701
msgid ""
"If multiple upstream tarball hrefs corresponding to a single version with "
"different extensions exist, the highest compression one is chosen. "
"(Priority: B<< tar.xz > tar.lzma > tar.bz2 > tar.gz >>.)"
msgstr ""
"Om det finns flera uppströms-tarball-hrefs som motsvarar en enda version med"
" olika tillägg, väljs den med högst komprimering. (Prioritet: B<< tar.xz > "
"tar.lzma > tar.bz2 > tar.gz >>.)"

#. type: textblock
#: ../scripts/debian-watch.pod:806 ../scripts/debian-watch-4.pod:705
msgid ""
"If the selected upstream tarball href is the relative URL, it is converted "
"to the absolute URL using the base URL of the web page.  If the B<< <base "
"href=\" >> I< ... > B<< \"> >> tag exists in the web page, the selected "
"upstream tarball href is converted to the absolute URL using the specified "
"base URL in the base tag, instead."
msgstr ""
"Om det valda href-värdet för uppströms tararkiv är en relativ URL "
"konverteras det till en absolut URL med hjälp av webbsidans bas-URL. Om "
"taggen B<< <base href=\" >> I< ... > B<< \"> >> finns på webbsidan "
"konverteras det valda href-värdet i stället till en absolut URL med hjälp av"
" den angivna bas-URL:en i base-taggen."

#. type: textblock
#: ../scripts/debian-watch.pod:812
msgid ""
"If the B<Download-Url-Mangle> rule exists, the selected upstream tarball "
"href is normalized by applying this rule to it. (This is useful for some "
"sites with the obfuscated download URL.)"
msgstr ""
"Om regeln B<Download-Url-Mangle> finns, normaliseras den valda uppströms-"
"tarball-href genom att tillämpa denna regel på den. (Detta är användbart för"
" vissa webbplatser med förvrängda nedladdnings-URL:er.)"

#. type: textblock
#: ../scripts/debian-watch.pod:816
msgid ""
"If the B<Filename-Mangle> rule exists, the downloaded tarball filename is "
"generated by applying this rule to the selected href if I<matching-pattern> "
"can extract the latest upstream version I<< <uversion> >> from the selected "
"href string. Otherwise, generate the upstream tarball filename from its full"
" URL string and set the missing I<< <uversion> >> from the generated "
"upstream tarball filename."
msgstr ""
"Om regeln B<Filename-Mangle> finns genereras filnamnet på det nedladdade "
"tararkivet genom att tillämpa denna regel på det valda href-värdet om "
"I<matching-pattern> kan extrahera den senaste uppströmsversionen I<< "
"<uversion> >> från den valda href-strängen. Annars genereras filnamnet på "
"uppströms tararkivet från dess fullständiga URL-sträng och det saknade I<< "
"<uversion> >> sätts från det genererade filnamnet."

#. type: textblock
#: ../scripts/debian-watch.pod:823
msgid ""
"Without the B<Filename-Mangle> rule, the default upstream tarball filename "
"is generated by taking the last component of the URL and removing everything"
" after any '?' or '#'."
msgstr ""
"Utan regeln B<Filename-Mangle> genereras standardnamnet på uppströms-"
"tarballen genom att ta den sista komponenten i URL:en och ta bort allt efter"
" '?' eller '#'."

#. type: textblock
#: ../scripts/debian-watch.pod:827 ../scripts/debian-watch-4.pod:726
msgid ""
"B<uscan> downloads the selected upstream tarball to the parent B<../> "
"directory.  For example, the downloaded file may be:"
msgstr ""
"B<uscan> laddar ner det valda uppströms tararkivet till den överordnade "
"B<../>-katalogen. Den nedladdade filen kan till exempel vara:"

#. type: =item
#: ../scripts/debian-watch.pod:832 ../scripts/debian-watch-4.pod:731
msgid "* F<../foo-2.04.tar.gz>"
msgstr "* F<../foo-2.04.tar.gz>"

#. type: textblock
#: ../scripts/debian-watch.pod:836 ../scripts/debian-watch-4.pod:735
msgid ""
"Let's call this downloaded version B<2.04> in the above example generically "
"as I<< <uversion> >> in the following."
msgstr ""
"Låt oss kalla den nedladdade versionen B<2.04> i exemplet ovan generiskt för"
" I<< <uversion> >> i det följande."

#. type: textblock
#: ../scripts/debian-watch.pod:839
msgid ""
"If the B<Pgp-Sig-Url-Mangle> rule exists, the upstream signature file URL is"
" generated by applying this rule to the (Download-Url-Mangled) selected "
"upstream tarball href and the signature file is tried to be downloaded from "
"it."
msgstr ""
"Om regeln B<Pgp-Sig-Url-Mangle> finns genereras URL:en till uppströms "
"signaturfilen genom att tillämpa denna regel på det valda Download-Url-"
"Mangle-bearbetade href-värdet för uppströms tararkiv, och ett försök görs "
"att hämta signaturfilen från den."

#. type: textblock
#: ../scripts/debian-watch.pod:843
msgid ""
"If the B<Pgp-Sig-Url-Mangle> rule doesn't exist, B<uscan> warns user if the "
"matching upstream signature file is available from the same URL with their "
"filename being suffixed by the 5 common suffix B<asc>, B<sig>, B<sign>, "
"B<pgp> and B<gpg>. (You can avoid this warning by setting B<Pgp-Mode: "
"none>.)"
msgstr ""
"Om regeln B<Pgp-Sig-Url-Mangle> inte finns, varnar B<uscan> användaren om "
"den matchande uppströms signaturfilen är tillgänglig från samma URL med "
"filnamnet försett med något av de fem vanliga suffixen B<asc>, B<sig>, "
"B<sign>, B<pgp> och B<gpg>. (Du kan undvika denna varning genom att ställa "
"in B<Pgp-Mode: none>.)"

#. type: textblock
#: ../scripts/debian-watch.pod:848 ../scripts/debian-watch-4.pod:747
msgid ""
"If the signature file is downloaded, the downloaded upstream tarball is "
"checked for its authenticity against the downloaded signature file using the"
" armored keyring F<debian/upstream/signing-key.asc> (see L<uscan(1)/KEYRING "
"FILE EXAMPLES>).  If its signature is not valid, or not made by one of the "
"listed keys, B<uscan> will report an error."
msgstr ""
"Om signaturfilen laddas ner kontrolleras det nedladdade uppströms "
"tararkivets äkthet mot den nedladdade signaturfilen med hjälp av den ASCII-"
"armorerade nyckelringen F<debian/upstream/signing-key.asc> (se "
"L<uscan(1)/EXEMPEL PÅ NYCKELRINGSFILER>). Om signaturen inte är giltig eller"
" inte har skapats av någon av de listade nycklarna rapporterar B<uscan> ett "
"fel."

#. type: textblock
#: ../scripts/debian-watch.pod:854
msgid ""
"If the B<Oversion-Mangle> rule exists, the source tarball version "
"I<oversion> is generated from the downloaded upstream version I<uversion> by"
" applying this rule. This rule is useful to add suffix such as B<+dfsg> to "
"the version of all the source packages of the MUT package for which the "
"B<Repack-Suffix> mechanism doesn't work."
msgstr ""
"Om regeln B<Oversion-Mangle> finns genereras källarkivets version "
"I<oversion> från den nedladdade uppströmsversionen I<uversion> genom att "
"tillämpa denna regel. Regeln är användbar för att lägga till suffix som "
"B<+dfsg> till versionen av alla källpaket i MUT-paketet där mekanismen "
"B<Repack-Suffix> inte fungerar."

#. type: textblock
#: ../scripts/debian-watch.pod:860 ../scripts/debian-watch-4.pod:759
msgid ""
"B<uscan> invokes B<mk-origtargz> to create the source tarball properly named"
" for the source package with B<.orig.> (or B<< .orig-<component>. >> for the"
" secondary tarballs) in its filename."
msgstr ""
"B<uscan> anropar B<mk-origtargz> för att skapa källkodsarkivet med rätt namn"
" för källkodspaketet med B<.orig.> (eller B<< .orig-<component>. >> för "
"sekundära arkiv) i filnamnet."

#. type: =item
#: ../scripts/debian-watch.pod:866 ../scripts/debian-watch-4.pod:765
msgid "case A: packaging of the upstream tarball as is"
msgstr "fall A: förpackning av uppströms-tarballen som den är"

#. type: textblock
#: ../scripts/debian-watch.pod:868 ../scripts/debian-watch-4.pod:767
msgid ""
"B<mk-origtargz> creates a symlink I<< ../bar_<oversion>.orig.tar.gz >> "
"linked to the downloaded local upstream tarball. Here, I<< bar >> is the "
"source package name found in F<debian/changelog>. The generated symlink may "
"be:"
msgstr ""
"B<mk-origtargz> skapar en symbolisk länk I<< ../bar_<oversion>.orig.tar.gz "
">> till det nedladdade lokala uppströms tararkivet. Här är I<< bar >> namnet"
" på källpaketet som finns i F<debian/changelog>. Den genererade symboliska "
"länken kan vara:"

#. type: =item
#: ../scripts/debian-watch.pod:874 ../scripts/debian-watch-4.pod:773
msgid "* F<../bar_2.04.orig.tar.gz> -> F<foo-2.04.tar.gz> (as is)"
msgstr "* F<../bar_2.04.orig.tar.gz> -> F<foo-2.04.tar.gz> (som det är)"

#. type: textblock
#: ../scripts/debian-watch.pod:878
msgid ""
"Usually, there is no need to set up B<Dversion-Mangle: I<...>> for this "
"case."
msgstr ""
"Vanligtvis behöver man inte ställa in B<Dversion-Mangle: I<...>> för detta "
"fall."

#. type: =item
#: ../scripts/debian-watch.pod:881 ../scripts/debian-watch-4.pod:780
msgid ""
"case B: packaging of the upstream tarball after removing non-DFSG files"
msgstr ""
"fall B: paketering av uppströms-tarballen efter borttagning av icke-DFSG-"
"filer"

#. type: textblock
#: ../scripts/debian-watch.pod:883
msgid ""
"B<mk-origtargz> checks the filename glob of the B<Files-Excluded> stanza in "
"the first section of F<debian/copyright>, removes matching files to create a"
" repacked upstream tarball.  Normally, the repacked upstream tarball is "
"renamed with I<suffix> to I<< ../bar_<oversion><suffix>.orig.tar.gz >> using"
" the B<Repack-Suffix:> option for the single upstream package.  Here I<< "
"<oversion> >> is updated to be I<< <oversion><suffix> >>."
msgstr ""
"B<mk-origtargz> kontrollerar filnamnsglobben i B<Files-Excluded>-stycket i "
"den första sektionen av F<debian/copyright> och tar bort matchande filer för"
" att skapa ett ompackat uppströms tararkiv. Normalt döps det ompackade "
"uppströms tararkivet om till I<< ../bar_<oversion><suffix>.orig.tar.gz >> "
"genom att I<suffix> läggs till med alternativet B<Repack-Suffix:> för paket "
"med ett enda uppströms tararkiv. Här uppdateras I<< <oversion> >> till I<< "
"<oversion><suffix> >>."

#. type: textblock
#: ../scripts/debian-watch.pod:890 ../scripts/debian-watch-4.pod:789
msgid ""
"The removal of files is required if files are not DFSG-compliant.  For such "
"case, B<+dfsg> is used as I<suffix>."
msgstr ""
"Filernas borttagning krävs om filerna inte är DFSG-kompatibla.  I sådana "
"fall används B<+dfsg> som I<suffix>."

#. type: textblock
#: ../scripts/debian-watch.pod:893
msgid "So the combined options are set as"
msgstr "De kombinerade alternativen är alltså inställda som"

#. type: verbatim
#: ../scripts/debian-watch.pod:895
#, no-wrap
msgid ""
"  Dversion-Mangle: s/\\+dfsg\\d*$//\n"
"  Repack-Suffix: +dfsg\">\n"
"\n"
msgstr ""
"  Dversion-Mangle: s/\\+dfsg\\d*$//\n"
"  Repack-Suffix: +dfsg\">\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:898 ../scripts/debian-watch-4.pod:795
msgid "For example, the repacked upstream tarball may be:"
msgstr "Till exempel kan det ompackade uppströms tararkivet vara:"

#. type: =item
#: ../scripts/debian-watch.pod:902 ../scripts/debian-watch-4.pod:799
msgid "* F<../bar_2.04+dfsg.orig.tar.gz> (repackaged)"
msgstr "* F<../bar_2.04+dfsg.orig.tar.gz> (ompackad)"

#. type: textblock
#: ../scripts/debian-watch.pod:908
msgid ""
"B<uscan> normally invokes \"B<uupdate> B<--find --upstream-version> "
"I<oversion>\"."
msgstr ""
"B<uscan> anropar normalt \"B<uupdate> B<--find --upstream-version> "
"I<oversion>\"."

#. type: textblock
#: ../scripts/debian-watch.pod:910 ../scripts/debian-watch-4.pod:808
msgid ""
"Please note that B<--find> option is used here since B<mk-origtargz> has "
"been invoked to make B<*.orig.tar.gz> file already.  B<uscan> picks I<< bar "
">> from F<debian/changelog>."
msgstr ""
"Observera att alternativet B<--find> används här eftersom B<mk-origtargz> "
"har anropats för att skapa filen B<*.orig.tar.gz>.  B<uscan> hämtar I<< bar "
">> från F<debian/changelog>."

#. type: textblock
#: ../scripts/debian-watch.pod:914 ../scripts/debian-watch-4.pod:812
msgid ""
"It creates the new upstream source tree under the I<< ../bar-<oversion> >> "
"directory and Debianize it leveraging the last package contents."
msgstr ""
"Det skapar det nya uppströms källkodsträdet under katalogen I<< "
"../bar-<oversion> >> och Debianiserar det med hjälp av det senaste paketets "
"innehåll."

#. type: =head1
#: ../scripts/debian-watch.pod:917 ../scripts/debian-watch-4.pod:815
msgid "WATCH FILE EXAMPLES"
msgstr "EXEMPEL PÅ WATCHFIL"

#. type: textblock
#: ../scripts/debian-watch.pod:919 ../scripts/debian-watch-4.pod:817
msgid ""
"When writing the watch file, you should rely on the latest upstream source "
"announcement web page.  You should not try to second guess the upstream "
"archive structure if possible.  Here are the typical F<debian/watch> files."
msgstr ""
"När du skriver watchfilen bör du utgå från den senaste utgåveannonseringen "
"på uppströmsprojektets webbplats. Försök om möjligt inte gissa "
"uppströmsarkivets struktur. Här är typiska F<debian/watch>-filer."

#. type: textblock
#: ../scripts/debian-watch.pod:923 ../scripts/debian-watch-4.pod:821
msgid ""
"Please note that executing B<uscan> with B<-v> or B<-vv> reveals what "
"exactly happens internally."
msgstr ""
"Observera att om du kör B<uscan> med B<-v> eller B<-vv> avslöjas exakt vad "
"som händer internt."

#. type: textblock
#: ../scripts/debian-watch.pod:926 ../scripts/debian-watch-4.pod:824
msgid ""
"The existence and non-existence of a space the before tailing B<\\> (back "
"slash)  are significant."
msgstr ""
"Förekomst eller frånvaro av ett mellanslag före det avslutande B<\\> "
"(bakstrecket) har betydelse."

#. type: textblock
#: ../scripts/debian-watch.pod:929 ../scripts/debian-watch-4.pod:827
msgid ""
"Some undocumented shorter configuration strings are used in the below "
"EXAMPLES to help you with typing.  These are intentional ones.  B<uscan> is "
"written to accept such common sense abbreviations but don't push the limit."
msgstr ""
"Några odokumenterade kortare konfigurationssträngar används i exemplen nedan"
" för att underlätta skrivning. De är avsiktliga. B<uscan> är skrivet för att"
" acceptera sådana förnuftiga förkortningar, men överdriv inte."

#. type: =head2
#: ../scripts/debian-watch.pod:933 ../scripts/debian-watch-4.pod:831
msgid "HTTP site (basic)"
msgstr "HTTP-webbplats (grundläggande)"

#. type: textblock
#: ../scripts/debian-watch.pod:935 ../scripts/debian-watch-4.pod:833
msgid "Here is an example for the basic single upstream tarball."
msgstr "Här är ett exempel på ett enkelt uppströms tararkiv."

#. type: verbatim
#: ../scripts/debian-watch.pod:939
#, no-wrap
msgid ""
"  Source: http://example.com/~user/release/@PACKAGE@.html\n"
"  Matching-Pattern: files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: http://example.com/~user/release/@PACKAGE@.html\n"
"  Matching-Pattern: files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:942
msgid "Or without using the substitution strings (not recommended):"
msgstr "Eller utan att använda ersättningssträngarna (rekommenderas inte):"

#. type: verbatim
#: ../scripts/debian-watch.pod:946
#, no-wrap
msgid ""
"  Source: http://example.com/~user/release/foo.html\n"
"  Matching-Pattern: files/foo-([\\d\\.]+)\\.tar\\.gz\n"
"\n"
msgstr ""
"  Source: http://example.com/~user/release/foo.html\n"
"  Matching-Pattern: files/foo-([\\d\\.]+)\\.tar\\.gz\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:949 ../scripts/debian-watch-4.pod:845
msgid ""
"For the upstream source package B<foo-2.0.tar.gz>, this watch file downloads"
" and creates the Debian B<orig.tar> file B<foo_2.0.orig.tar.gz>."
msgstr ""
"För uppströmskällpaketet B<foo-2.0.tar.gz> hämtar denna watchfil filen och "
"skapar Debians B<orig.tar>-fil B<foo_2.0.orig.tar.gz>."

#. type: =head2
#: ../scripts/debian-watch.pod:952
msgid "HTTP site (Pgp-Sig-Url-Mangle)"
msgstr "HTTP-webbplats (Pgp-Sig-Url-Mangle)"

#. type: textblock
#: ../scripts/debian-watch.pod:954 ../scripts/debian-watch-4.pod:850
msgid ""
"Here is an example for the basic single upstream tarball with the matching "
"signature file in the same file path."
msgstr ""
"Här är ett exempel på ett enkelt uppströms tararkiv med motsvarande "
"signaturfil på samma sökväg."

#. type: verbatim
#: ../scripts/debian-watch.pod:959
#, no-wrap
msgid ""
"  Source: http://example.com/release/@PACKAGE@.html\n"
"  Matching-Pattern: files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.asc%\n"
"\n"
msgstr ""
"  Source: http://example.com/release/@PACKAGE@.html\n"
"  Matching-Pattern: files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.asc%\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:963 ../scripts/debian-watch-4.pod:857
msgid ""
"For the upstream source package B<foo-2.0.tar.gz> and the upstream signature"
" file B<foo-2.0.tar.gz.asc>, this watch file downloads these files, verifies"
" the authenticity using the keyring F<debian/upstream/signing-key.asc> and "
"creates the Debian B<orig.tar> file B<foo_2.0.orig.tar.gz>."
msgstr ""
"För uppströmskällpaketet B<foo-2.0.tar.gz> och uppströmssignaturfilen "
"B<foo-2.0.tar.gz.asc> hämtar denna watchfil filerna, verifierar äktheten med"
" nyckelringen F<debian/upstream/signing-key.asc> och skapar Debians "
"B<orig.tar>-fil B<foo_2.0.orig.tar.gz>."

#. type: textblock
#: ../scripts/debian-watch.pod:968 ../scripts/debian-watch-4.pod:862
msgid ""
"Here is another example for the basic single upstream tarball with the "
"matching signature file on decompressed tarball in the same file path."
msgstr ""
"Här är ett annat exempel på ett enkelt uppströms tararkiv med motsvarande "
"signaturfil för det dekomprimerade tararkivet på samma sökväg."

#. type: verbatim
#: ../scripts/debian-watch.pod:973
#, no-wrap
msgid ""
"  Source: http://example.com/release/@PACKAGE@.html\n"
"  Matching-Pattern: files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%@ARCHIVE_EXT@$%.asc%\n"
"  Decompress: yes\n"
"\n"
msgstr ""
"  Source: http://example.com/release/@PACKAGE@.html\n"
"  Matching-Pattern: files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%@ARCHIVE_EXT@$%.asc%\n"
"  Decompress: yes\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:978 ../scripts/debian-watch-4.pod:870
msgid ""
"For the upstream source package B<foo-2.0.tar.gz> and the upstream signature"
" file B<foo-2.0.tar.asc>, this watch file downloads these files, verifies "
"the authenticity using the keyring F<debian/upstream/signing-key.asc> and "
"creates the Debian B<orig.tar> file B<foo_2.0.orig.tar.gz>."
msgstr ""
"För uppströmskällpaketet B<foo-2.0.tar.gz> och uppströmssignaturfilen "
"B<foo-2.0.tar.asc> hämtar denna watchfil filerna, verifierar äktheten med "
"nyckelringen F<debian/upstream/signing-key.asc> och skapar Debians "
"B<orig.tar>-fil B<foo_2.0.orig.tar.gz>."

#. type: =head2
#: ../scripts/debian-watch.pod:983
msgid "HTTP site (Pgp-Mode: next/previous)"
msgstr "HTTP-webbplats (Pgp-Mode: next/previous)"

#. type: textblock
#: ../scripts/debian-watch.pod:985 ../scripts/debian-watch-4.pod:877
msgid ""
"Here is an example for the basic single upstream tarball with the matching "
"signature file in the unrelated file path."
msgstr ""
"Här är ett exempel på ett enkelt uppströms tararkiv med motsvarande "
"signaturfil på en annan sökväg."

#. type: verbatim
#: ../scripts/debian-watch.pod:990
#, no-wrap
msgid ""
"  Source: http://example.com/release/@PACKAGE@.html\n"
"  Matching-Pattern: files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Mode: next\n"
"\n"
msgstr ""
"  Source: http://example.com/release/@PACKAGE@.html\n"
"  Matching-Pattern: files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Mode: next\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:994
#, no-wrap
msgid ""
"  Source: http://example.com/release/@PACKAGE@.html\n"
"  Matching-Pattern: .*?files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@SIGNATURE_EXT@\n"
"  Pgp-Mode: previous\n"
"  Version-Schema: previous\n"
"\n"
msgstr ""
"  Source: http://example.com/release/@PACKAGE@.html\n"
"  Matching-Pattern: .*?files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@SIGNATURE_EXT@\n"
"  Pgp-Mode: previous\n"
"  Version-Schema: previous\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:999 ../scripts/debian-watch-4.pod:886
msgid ""
"B<(?:\\d+)> part can be any random value.  The tarball file can have B<53>, "
"while the signature file can have B<33>."
msgstr ""
"B<(?:\\d+)>-delen kan vara vilket godtyckligt värde som helst. Tararkivfilen"
" kan ha B<53>, medan signaturfilen kan ha B<33>."

#. type: textblock
#: ../scripts/debian-watch.pod:1002 ../scripts/debian-watch-4.pod:889
msgid ""
"B<([\\d\\.]+)> part for the signature file has a strict requirement to match"
" that for the upstream tarball specified in the previous line by having "
"B<previous> as I<version> in the watch line."
msgstr ""
"B<([\\d\\.]+)>-delen för signaturfilen måste matcha delen för uppströms "
"tararkivet på föregående rad genom att B<previous> används som I<version> i "
"watchraden."

#. type: =head2
#: ../scripts/debian-watch.pod:1006 ../scripts/debian-watch-4.pod:893
msgid "HTTP site (flexible)"
msgstr "HTTP-webbplats (flexibel)"

#. type: textblock
#: ../scripts/debian-watch.pod:1008 ../scripts/debian-watch-4.pod:895
msgid ""
"Here is an example for the maximum flexibility of upstream tarball and "
"signature file extensions."
msgstr ""
"Här är ett exempel på maximal flexibilitet för filändelserna för uppströms "
"tararkiv och signaturfiler."

#. type: verbatim
#: ../scripts/debian-watch.pod:1013
#, no-wrap
msgid ""
"  Source: http://example.com/DL/\n"
"  Matching-Pattern: files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Mode: next\n"
"\n"
msgstr ""
"  Source: http://example.com/DL/\n"
"  Matching-Pattern: files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Mode: next\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1017
#, no-wrap
msgid ""
"  Source: http://example.com/DL/\n"
"  Matching-Pattern: files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@SIGNATURE_EXT@\n"
"  Pgp-Mode: previous\n"
"  Version-Schema: previous\n"
"\n"
msgstr ""
"  Source: http://example.com/DL/\n"
"  Matching-Pattern: files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@SIGNATURE_EXT@\n"
"  Pgp-Mode: previous\n"
"  Version-Schema: previous\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1022 ../scripts/debian-watch-4.pod:905
msgid "HTTP site (basic MUT)"
msgstr "HTTP-webbplats (grundläggande MUT)"

#. type: textblock
#: ../scripts/debian-watch.pod:1024 ../scripts/debian-watch-4.pod:907
msgid "Here is an example for the basic multiple upstream tarballs."
msgstr "Här är ett exempel på flera enkla uppströms tararkiv."

#. type: verbatim
#: ../scripts/debian-watch.pod:1028
#, no-wrap
msgid ""
"  Source: http://example.com/release/foo.html\n"
"  Matching-Pattern: files/foo-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"\n"
msgstr ""
"  Source: http://example.com/release/foo.html\n"
"  Matching-Pattern: files/foo-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1032
#, no-wrap
msgid ""
"  Component: bar\n"
"  Source: http://example.com/release/foo.html\n"
"  Matching-Pattern: files/foobar-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"  Version-Constraint: same\n"
"\n"
msgstr ""
"  Component: bar\n"
"  Source: http://example.com/release/foo.html\n"
"  Matching-Pattern: files/foobar-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"  Version-Constraint: same\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1038
#, no-wrap
msgid ""
"  Component: baz\n"
"  Source: http://example.com/release/foo.html\n"
"  Matching-Pattern: files/foobaz-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"  Version-Constraint: same\n"
"\n"
msgstr ""
"  Component: baz\n"
"  Source: http://example.com/release/foo.html\n"
"  Matching-Pattern: files/foobaz-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"  Version-Constraint: same\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1044 ../scripts/debian-watch-4.pod:920
msgid ""
"For the main upstream source package B<foo-2.0.tar.gz> and the secondary "
"upstream source packages B<foobar-2.0.tar.gz> and B<foobaz-2.0.tar.gz> which"
" install under F<bar/> and F<baz/>, this watch file downloads and creates "
"the Debian B<orig.tar> file B<foo_2.0.orig.tar.gz>, B<foo_2.0.orig-"
"bar.tar.gz> and B<foo_2.0.orig-baz.tar.gz>.  Also, these upstream tarballs "
"are verified by their signature files."
msgstr ""
"För huvudkällpaketet uppströms B<foo-2.0.tar.gz> och de sekundära "
"uppströmskällpaketen B<foobar-2.0.tar.gz> och B<foobaz-2.0.tar.gz>, som "
"installeras under F<bar/> och F<baz/>, hämtar denna watchfil filerna och "
"skapar Debians B<orig.tar>-filer B<foo_2.0.orig.tar.gz>, B<foo_2.0.orig-"
"bar.tar.gz> och B<foo_2.0.orig-baz.tar.gz>. Dessutom verifieras tararkiven "
"med respektive signaturfil."

#. type: =head2
#: ../scripts/debian-watch.pod:1051 ../scripts/debian-watch-4.pod:927
msgid "HTTP site (recursive directory scanning)"
msgstr "HTTP-webbplats (rekursiv katalogskanning)"

#. type: textblock
#: ../scripts/debian-watch.pod:1053 ../scripts/debian-watch-4.pod:929
msgid ""
"Here is an example with the recursive directory scanning for the upstream "
"tarball and its signature files released in a directory named after their "
"version."
msgstr ""
"Här är ett exempel på rekursiv katalogsökning efter uppströms tararkivet och"
" dess signaturfiler, som ges ut i en katalog med namn efter versionen."

#. type: verbatim
#: ../scripts/debian-watch.pod:1059
#, no-wrap
msgid ""
"  Source: http://tmrc.mit.edu/mirror/twisted/Twisted/@ANY_VERSION@/\n"
"  Matching-Pattern: Twisted-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Dirversion-Mangle: s/-PRE/~pre/;s/-RC/~rc/\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"\n"
msgstr ""
"  Source: http://tmrc.mit.edu/mirror/twisted/Twisted/@ANY_VERSION@/\n"
"  Matching-Pattern: Twisted-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Dirversion-Mangle: s/-PRE/~pre/;s/-RC/~rc/\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1064 ../scripts/debian-watch-4.pod:938
msgid "Here, the web site should be accessible at the following URL:"
msgstr "Här bör webbplatsen vara tillgänglig på följande URL:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1066 ../scripts/debian-watch-4.pod:940
#, no-wrap
msgid ""
"  http://tmrc.mit.edu/mirror/twisted/Twisted/\n"
"\n"
msgstr ""
"  http://tmrc.mit.edu/mirror/twisted/Twisted/\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1068
msgid ""
"Here, B<Dirversion-Mangle> option is used to normalize the sorting order of "
"the directory names."
msgstr ""
"Här används alternativet B<Dirversion-Mangle> för att normalisera "
"sorteringsordningen för katalognamnen."

#. type: =head2
#: ../scripts/debian-watch.pod:1071 ../scripts/debian-watch-4.pod:945
msgid "HTTP site (alternative shorthand)"
msgstr "HTTP-webbplats (alternativ förkortning)"

#. type: textblock
#: ../scripts/debian-watch.pod:1073 ../scripts/debian-watch-4.pod:947
msgid ""
"For the bare HTTP site where you can directly see archive filenames, the "
"normal watch file:"
msgstr ""
"På en enkel HTTP-webbplats där arkivfilernas namn visas direkt ser den "
"vanliga watchfilen ut så här:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1078 ../scripts/debian-watch.pod:1087
#, no-wrap
msgid ""
"  Source: http://www.cpan.org/modules/by-module/Text/\n"
"  Matching-Pattern: Text-CSV_XS-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"\n"
msgstr ""
"  Source: http://www.cpan.org/modules/by-module/Text/\n"
"  Matching-Pattern: Text-CSV_XS-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Pgp-Sig-Url-Mangle: s%$%.sig%\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1082 ../scripts/debian-watch-4.pod:955
msgid ""
"can be rewritten in an alternative shorthand form only with a single string "
"covering URL and filename:"
msgstr ""
"kan skrivas om i en alternativ kortform med en enda sträng som täcker både "
"URL och filnamn:"

#. type: =head2
#: ../scripts/debian-watch.pod:1091 ../scripts/debian-watch-4.pod:973
msgid "HTTP site (funny version)"
msgstr "HTTP-webbplats (ovanliga versionsnummer)"

#. type: textblock
#: ../scripts/debian-watch.pod:1093 ../scripts/debian-watch-4.pod:975
msgid ""
"For a site which has funny version numbers, the parenthesized groups will be"
" joined with B<.> (period) to make a sanitized version number."
msgstr ""
"För en webbplats med ovanliga versionsnummer sammanfogas grupperna inom "
"parentes med B<.> (punkt) till ett normaliserat versionsnummer."

#. type: verbatim
#: ../scripts/debian-watch.pod:1098
#, no-wrap
msgid ""
"  Source: http://www.site.com/pub/foobar/\n"
"  Matching-Pattern: foobar_v(\\d+)_(\\d+)@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: http://www.site.com/pub/foobar/\n"
"  Matching-Pattern: foobar_v(\\d+)_(\\d+)@ARCHIVE_EXT@\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1101 ../scripts/debian-watch-4.pod:981
msgid "HTTP site (DFSG)"
msgstr "HTTP-webbplats (DFSG)"

#. type: textblock
#: ../scripts/debian-watch.pod:1103 ../scripts/debian-watch-4.pod:983
msgid ""
"The upstream part of the Debian version number can be mangled to indicate "
"the source package was repackaged to clean up non-DFSG files:"
msgstr ""
"Uppströmsdelen av Debians versionsnummer kan skrivas om för att ange att "
"källpaketet har packats om för att rensa bort filer som inte uppfyller DFSG:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1108
#, no-wrap
msgid ""
"  Source: http://some.site.org/some/path/\n"
"  Matching-Pattern: foobar-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Dversion-Mangle: s/\\+dfsg\\d*$//\n"
"  Repacksuffix: +dfsg\n"
"\n"
msgstr ""
"  Source: http://some.site.org/some/path/\n"
"  Matching-Pattern: foobar-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Dversion-Mangle: s/\\+dfsg\\d*$//\n"
"  Repacksuffix: +dfsg\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1113 ../scripts/debian-watch.pod:1178
#: ../scripts/debian-watch-4.pod:990 ../scripts/debian-watch-4.pod:1045
msgid "See L<uscan(1)/COPYRIGHT FILE EXAMPLES>."
msgstr "Se L<uscan(1)/COPYRIGHT FILE EXAMPLES>."

#. type: =head2
#: ../scripts/debian-watch.pod:1115
msgid "HTTP site (Filename-Mangle)"
msgstr "HTTP-webbplats (filnamn-Mangle)"

#. type: textblock
#: ../scripts/debian-watch.pod:1117 ../scripts/debian-watch-4.pod:994
msgid ""
"The upstream tarball filename is found by taking the last component of the "
"URL and removing everything after any '?' or '#'."
msgstr ""
"Filnamnet för uppströms tararkivet fås genom att ta den sista delen av "
"URL:en och ta bort allt efter ett eventuellt B<?> eller B<#>."

#. type: textblock
#: ../scripts/debian-watch.pod:1120
msgid ""
"If this does not fit to you, use B<Filename-Mangle>.  For example, F<< <A "
"href=\"http://foo.bar.org/dl/?path=&dl=foo-0.1.1.tar.gz\"> >> could be "
"handled as:"
msgstr ""
"Om detta inte passar, använd B<Filename-Mangle>. Till exempel kan F<< <A "
"href=\"http://foo.bar.org/dl/?path=&dl=foo-0.1.1.tar.gz\"> >> hanteras så "
"här:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1126
#, no-wrap
msgid ""
"  Source: http://foo.bar.org/dl/\n"
"  Matching-Pattern: \\?path=&dl=foo-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Filename-Mangle: s/.*=(.*)/$1/\n"
"\n"
msgstr ""
"  Source: http://foo.bar.org/dl/\n"
"  Matching-Pattern: \\?path=&dl=foo-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Filename-Mangle: s/.*=(.*)/$1/\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1130 ../scripts/debian-watch-4.pod:1005
msgid ""
"F<< <A href=\"http://foo.bar.org/dl/?path=&dl_version=0.1.1\"> >> could be "
"handled as:"
msgstr ""
"F<< <A href=\"http://foo.bar.org/dl/?path=&dl_version=0.1.1\"> >> kan "
"hanteras på följande sätt:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1135
#, no-wrap
msgid ""
"  Source: http://foo.bar.org/dl/\n"
"  Matching-Pattern: \\?path=&dl_version=@ANY_VERSION@\n"
"  Filename-Mangle: s/.*=(.*)/foo-$1\\.tar\\.gz/\n"
"\n"
msgstr ""
"  Source: http://foo.bar.org/dl/\n"
"  Matching-Pattern: \\?path=&dl_version=@ANY_VERSION@\n"
"  Filename-Mangle: s/.*=(.*)/foo-$1\\.tar\\.gz/\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1139
msgid ""
"If the href string has no version using I<matching-pattern>, the version can"
" be obtained from the full URL using B<Filename-Mangle>."
msgstr ""
"Om href-strängen saknar en version enligt I<matching-pattern> kan versionen "
"hämtas ur den fullständiga URL:en med B<Filename-Mangle>."

#. type: verbatim
#: ../scripts/debian-watch.pod:1144
#, no-wrap
msgid ""
"  Source: http://foo.bar.org/dl/@ANY_VERSION@/\n"
"  Matching-Pattern: foo.tar.gz\n"
"  Filename-Mangle: s|.*/dl/(.*)/foo\\.tar\\.gz|foo-$1\\.tar\\.gz|\n"
"\n"
msgstr ""
"  Source: http://foo.bar.org/dl/@ANY_VERSION@/\n"
"  Matching-Pattern: foo.tar.gz\n"
"  Filename-Mangle: s|.*/dl/(.*)/foo\\.tar\\.gz|foo-$1\\.tar\\.gz|\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1148
msgid "HTTP site (Download-Url-Mangle)"
msgstr "HTTP-webbplats (Download-Url-Mangle)"

#. type: textblock
#: ../scripts/debian-watch.pod:1150
msgid ""
"The option B<Download-Url-Mangle> can be used to mangle the URL of the file "
"to download.  This can only be used with B<http://> URLs.  This may be "
"necessary if the link given on the web page needs to be transformed in some "
"way into one which will work automatically, for example:"
msgstr ""
"Alternativet B<Download-Url-Mangle> kan användas för att skriva om URL:en "
"till filen som ska hämtas. Det kan bara användas med B<http://>-URL:er. Det "
"kan behövas om länken på webbsidan måste omvandlas till en länk som fungerar"
" automatiskt, till exempel:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1157
#, no-wrap
msgid ""
"  Source: http://developer.berlios.de/project/showfiles.php?group_id=2051\n"
"  Matching-Pattern: http://prdownload.berlios.de/softdevice/vdr-softdevice-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Download-Url-Mangle: s/prdownload/download/\n"
"\n"
msgstr ""
"  Source: http://developer.berlios.de/project/showfiles.php?group_id=2051\n"
"  Matching-Pattern: http://prdownload.berlios.de/softdevice/vdr-softdevice-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Download-Url-Mangle: s/prdownload/download/\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1161
msgid "HTTP site (Oversion-Mangle, MUT)"
msgstr "HTTP-webbplats (Oversion-Mangle, MUT)"

#. type: textblock
#: ../scripts/debian-watch.pod:1163
msgid ""
"The option B<Oversion-Mangle> can be used to mangle the version of the "
"source tarball (B<.orig.tar.gz> and B<.orig-bar.tar.gz>).  For example, "
"B<+dfsg> can be added to the upstream version as:"
msgstr ""
"Alternativet B<Oversion-Mangle> kan användas för att skriva om versionen för"
" källkodstararkivet (B<.orig.tar.gz> och B<.orig-bar.tar.gz>). Till exempel "
"kan B<+dfsg> läggas till i uppströmsversionen så här:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1169
#, no-wrap
msgid ""
"  Source: http://example.com/~user/release/foo.html\n"
"  Matching-Pattern: files/foo-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Oversion-Mangle: s/(.*)/$1+dfsg/\n"
"\n"
msgstr ""
"  Source: http://example.com/~user/release/foo.html\n"
"  Matching-Pattern: files/foo-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Oversion-Mangle: s/(.*)/$1+dfsg/\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1173
#, no-wrap
msgid ""
"  Component: bar\n"
"  Source: http://example.com/~user/release/foo.html\n"
"  Matching-Pattern: files/bar-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Version-Constraint: same\n"
"\n"
msgstr ""
"  Component: bar\n"
"  Source: http://example.com/~user/release/foo.html\n"
"  Matching-Pattern: files/bar-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Version-Constraint: same\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1180
msgid "HTTP site (Page-Mangle)"
msgstr "HTTP-webbplats (Page-Mangle)"

#. type: textblock
#: ../scripts/debian-watch.pod:1182
msgid ""
"The option B<Page-Mangle> can be used to mangle the downloaded web page "
"before applying other rules.  The non-standard web page without proper B<< "
"<a href=\" >> << ... >> B<< \"> >> entries can be converted.  For example, "
"if F<foo.html> uses B<< <a bogus=\" >> I<< ... >> B<< \"> >>, this can be "
"converted to the standard page format with:"
msgstr ""
"Alternativet B<Page-Mangle> kan användas för att skriva om den hämtade "
"webbsidan innan andra regler tillämpas. Den icke-standardiserade webbsidan "
"utan korrekta B<< <a href=\" >> << ... >> B<< \"> >>-element kan "
"konverteras. Om F<foo.html> till exempel använder B<< <a bogus=\" >> I<< ..."
" >> B<< \"> >> kan detta konverteras till standardformatet med:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1190
#, no-wrap
msgid ""
"  Source: href=/g\"\n"
"  Matching-Pattern: http://example.com/release/foo.html\n"
"  Page-Mangle: \"s/<a\\s+bogus=/<a\n"
"  Version-Constraint: files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: href=/g\"\n"
"  Matching-Pattern: http://example.com/release/foo.html\n"
"  Page-Mangle: \"s/<a\\s+bogus=/<a\n"
"  Version-Constraint: files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1195 ../scripts/debian-watch-4.pod:1060
msgid "Please note the use of B<g> here to replace all occurrences."
msgstr "Observera att B<g> används här för att ersätta alla förekomster."

#. type: textblock
#: ../scripts/debian-watch.pod:1197 ../scripts/debian-watch-4.pod:1062
msgid ""
"If F<foo.html> uses B<< <Key> >> I<< ... >> B<< </Key> >>, this can be "
"converted to the standard page format with:"
msgstr ""
"Om F<foo.html> använder B<< <Key> >> I<< ... >> B<< </Key> >> kan detta "
"konverteras till standardformatet med:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1202
#, no-wrap
msgid ""
"  Source: http://example.com/release/foo.html\n"
"  Matching-Pattern: (?:.*)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Page-Mangle: s%<Key>([^<]*)</Key>%<Key><a href=\"$1\">$1</a></Key>%g\n"
"\n"
msgstr ""
"  Source: http://example.com/release/foo.html\n"
"  Matching-Pattern: (?:.*)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Page-Mangle: s%<Key>([^<]*)</Key>%<Key><a href=\"$1\">$1</a></Key>%g\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1206 ../scripts/debian-watch-4.pod:1070
msgid "FTP site (basic):"
msgstr "FTP-webbplats (grundläggande):"

#. type: verbatim
#: ../scripts/debian-watch.pod:1210
#, no-wrap
msgid ""
"  Source: ftp://ftp.tex.ac.uk/tex-archive/web/c_cpp/cweb/\n"
"  Matching-Pattern: cweb-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: ftp://ftp.tex.ac.uk/tex-archive/web/c_cpp/cweb/\n"
"  Matching-Pattern: cweb-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1213 ../scripts/debian-watch-4.pod:1075
msgid "FTP site (regex special characters):"
msgstr "FTP-webbplats (specialtecken i reguljära uttryck):"

#. type: verbatim
#: ../scripts/debian-watch.pod:1217
#, no-wrap
msgid ""
"  Source: ftp://ftp.worldforge.org/pub/worldforge/libs/Atlas-C++/transitional/\n"
"  Matching-Pattern: Atlas-C\\+\\+-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: ftp://ftp.worldforge.org/pub/worldforge/libs/Atlas-C++/transitional/\n"
"  Matching-Pattern: Atlas-C\\+\\+-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1220 ../scripts/debian-watch-4.pod:1081
msgid ""
"Please note that this URL is connected to be I< ... >B<libs/Atlas-C++/>I< "
"... > . For B<++>, the first one in the directory path is verbatim while the"
" one in the filename is escaped by B<\\>."
msgstr ""
"Observera att denna URL ansluter till I< ... >B<libs/Atlas-C++/>I< ... >. "
"För B<++> skrivs den första förekomsten i katalogsökvägen ordagrant, medan "
"den i filnamnet skyddas med B<\\>."

#. type: =head2
#: ../scripts/debian-watch.pod:1224 ../scripts/debian-watch-4.pod:1085
msgid "FTP site (funny version)"
msgstr "FTP-webbplats (ovanliga versionsnummer)"

#. type: textblock
#: ../scripts/debian-watch.pod:1226 ../scripts/debian-watch-4.pod:1087
msgid ""
"This is another way of handling site with funny version numbers, this time "
"using mangling.  (Note that multiple groups will be concatenated before "
"mangling is performed, and that mangling will only be performed on the "
"basename version number, not any path version numbers.)"
msgstr ""
"Detta är ett annat sätt att hantera en webbplats med ovanliga "
"versionsnummer, denna gång med omskrivning. Observera att flera grupper "
"sammanfogas innan omskrivningen utförs och att omskrivningen bara utförs på "
"versionsnumret i basnamnet, inte på versionsnummer i sökvägen."

#. type: verbatim
#: ../scripts/debian-watch.pod:1234
#, no-wrap
msgid ""
"  Source: ftp://ftp.ibiblio.org/pub/Linux/ALPHA/wine/development/\n"
"  Matching-Pattern: Wine-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Uversion-Mangle: s/^/0.0./\n"
"\n"
msgstr ""
"  Source: ftp://ftp.ibiblio.org/pub/Linux/ALPHA/wine/development/\n"
"  Matching-Pattern: Wine-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Uversion-Mangle: s/^/0.0./\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1238 ../scripts/debian-watch-4.pod:1098
msgid "sf.net"
msgstr "sf.net"

#. type: textblock
#: ../scripts/debian-watch.pod:1240 ../scripts/debian-watch-4.pod:1100
msgid ""
"For SourceForge based projects, qa.debian.org runs a redirector which allows"
" a simpler form of URL. The format below will automatically be rewritten to "
"use the redirector with the watch file:"
msgstr ""
"För SourceForge-baserade projekt kör qa.debian.org en omdirigeringstjänst "
"som möjliggör en enklare URL-form. Formatet nedan skrivs automatiskt om så "
"att tjänsten används med watchfilen:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1246
#, no-wrap
msgid ""
"  Source: https://sf.net/<project>/\n"
"  Matching-Pattern: <tar-name>-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: https://sf.net/<project>/\n"
"  Matching-Pattern: <tar-name>-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1249 ../scripts/debian-watch-4.pod:1107
msgid "For B<audacity>, set the watch file as:"
msgstr "För B<audacity> ställs watchfilen in så här:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1253
#, no-wrap
msgid ""
"  Source: https://sf.net/audacity/\n"
"  Matching-Pattern: audacity-minsrc-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: https://sf.net/audacity/\n"
"  Matching-Pattern: audacity-minsrc-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1256 ../scripts/debian-watch.pod:1398
#: ../scripts/debian-watch-4.pod:1112 ../scripts/debian-watch-4.pod:1227
msgid ""
"Please note, you can still use normal functionalities of B<uscan> to set up "
"a watch file for this site without using the redirector."
msgstr ""
"Observera att du fortfarande kan använda B<uscans> vanliga funktioner för "
"att ställa in en watchfil för denna webbplats utan omdirigeringstjänsten."

#. type: verbatim
#: ../scripts/debian-watch.pod:1261
#, no-wrap
msgid ""
"  Source: http://sourceforge.net/projects/audacity/files/audacity/@ANY_VERSION@/\n"
"  Matching-Pattern: (?:.*)audacity-minsrc-@ANY_VERSION@@ARCHIVE_EXT@/download\n"
"  Filename-Mangle: s%(?:.*)audacity-minsrc-(.+)\\.tar\\.xz/download%audacity-$1.tar.xz%\n"
"  Uversion-Mangle: s/-pre/~pre/\n"
"\n"
msgstr ""
"  Source: http://sourceforge.net/projects/audacity/files/audacity/@ANY_VERSION@/\n"
"  Matching-Pattern: (?:.*)audacity-minsrc-@ANY_VERSION@@ARCHIVE_EXT@/download\n"
"  Filename-Mangle: s%(?:.*)audacity-minsrc-(.+)\\.tar\\.xz/download%audacity-$1.tar.xz%\n"
"  Uversion-Mangle: s/-pre/~pre/\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1266 ../scripts/debian-watch-4.pod:1122
msgid "Here, B<%> is used as the separator instead of the standard B</>."
msgstr ""
"Här används B<%> som avgränsare i stället för standardavgränsaren B</>."

#. type: =head2
#: ../scripts/debian-watch.pod:1268
msgid "GitHub"
msgstr "GitHub"

#. type: textblock
#: ../scripts/debian-watch.pod:1270 ../scripts/debian-watch-4.pod:1126
msgid ""
"For GitHub based projects, you can use the releases or tags API page.  If "
"upstream releases properly named tarballs on their releases page, you can "
"search for the browser download URL (API key F<browser_download_url>):"
msgstr ""
"För GitHub-baserade projekt kan du använda API-sidan för utgåvor eller "
"taggar. Om uppströmsprojektet ger ut tararkiv med korrekt namn på sin "
"utgivningssida kan du söka efter webbläsarens nedladdnings-URL (API-nyckeln "
"F<browser_download_url>):"

#. type: verbatim
#: ../scripts/debian-watch.pod:1276
#, no-wrap
msgid ""
"  Template: GitHub\n"
"  Dist: <URL-to-the-project> \n"
"\n"
msgstr ""
"  Template: GitHub\n"
"  Dist: <URL-to-the-project> \n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1279
msgid "or:"
msgstr "eller:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1283
#, no-wrap
msgid ""
"  Template: GitHub\n"
"  Owner: <user>\n"
"  Project: <project>\n"
"\n"
msgstr ""
"  Template: GitHub\n"
"  Owner: <user>\n"
"  Project: <project>\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1287
msgid "which is equivalent to:"
msgstr "vilket motsvarar:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1291
#, no-wrap
msgid ""
"  Source: https://api.github.com/repos/<user>/<project>/git/matching-refs/tags/\n"
"  Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@\n"
"  Download-Url-Mangle: s%(api.github.com/repos/[^/]+/[^/]+)/git/refs/%$1/tarball/refs/%g\n"
"  Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%\n"
"  Search-Mode: plain\n"
"  Pgp-Mode: plain\n"
"\n"
msgstr ""
"  Source: https://api.github.com/repos/<user>/<project>/git/matching-refs/tags/\n"
"  Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@\n"
"  Download-Url-Mangle: s%(api.github.com/repos/[^/]+/[^/]+)/git/refs/%$1/tarball/refs/%g\n"
"  Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%\n"
"  Search-Mode: plain\n"
"  Pgp-Mode: plain\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1298 ../scripts/debian-watch.pod:1420
msgid "See L<uscan-templates(5)> for more."
msgstr "Se L<uscan-templates(5)> för mer information."

#. type: textblock
#: ../scripts/debian-watch.pod:1300 ../scripts/debian-watch-4.pod:1138
msgid ""
"It is also possible to filter tags by prefix. For example to get only tags "
"starting by C<v1>:"
msgstr ""
"Det är också möjligt att filtrera taggar efter prefix. Till exempel för att "
"endast få taggar som börjar med C<v1>:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1305
#, no-wrap
msgid ""
"  Source: https://api.github.com/repos/<user>/<project>/git/matching-refs/tags/v1\n"
"  Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@\n"
"  Download-Url-Mangle: s%(api.github.com/repos/[^/]+/[^/]+)/git/refs/%$1/tarball/refs/%g\n"
"  Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Source: https://api.github.com/repos/<user>/<project>/git/matching-refs/tags/v1\n"
"  Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@\n"
"  Download-Url-Mangle: s%(api.github.com/repos/[^/]+/[^/]+)/git/refs/%$1/tarball/refs/%g\n"
"  Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%\n"
"  Search-Mode: plain\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1311 ../scripts/debian-watch-4.pod:1149
msgid ""
"Alternatives with releases only (if upstream does not delete tag after "
"release):"
msgstr ""
"Alternativ med endast utgåvor (om uppströms inte raderar taggen efter "
"utgåvan):"

#. type: verbatim
#: ../scripts/debian-watch.pod:1315
#, no-wrap
msgid ""
"  Source: https://api.github.com/repos/<user>/<project>/git/matching-refs/tags/\n"
"  Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@\n"
"  Download-Url-Mangle: s%api.github.com/repos/([^/]+/[^/]+)/git/refs/tags/@ANY_VERSION@%github.com/$1/archive/refs/tags/$2.tar.gz%g\n"
"  Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Källa: https://api.github.com/repos/<user>/<project>/git/matching-refs/tags/\n"
"  Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@\n"
"  Download-Url-Mangle: s%api.github.com/repos/([^/]+/[^/]+)/git/refs/tags/@ANY_VERSION@%github.com/$1/archive/refs/tags/$2.tar.gz%g\n"
"  Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%\n"
"  Search-Mode: plain\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1321 ../scripts/debian-watch-4.pod:1159
msgid "In case of release that does not use tags or deleted tags:"
msgstr "Vid en utgåva som inte taggas eller vars tagg har raderats:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1325
#, no-wrap
msgid ""
"  Source: https://api.github.com/repos/<user>/<project>/releases?per_page=100\n"
"  Matching-Pattern: https://api.github.com/repos/<user>/<project>/tarball/@ANY_VERSION@\n"
"  Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Source: https://api.github.com/repos/<user>/<project>/releases?per_page=100\n"
"  Matching-Pattern: https://api.github.com/repos/<user>/<project>/tarball/@ANY_VERSION@\n"
"  Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%\n"
"  Search-Mode: plain\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1330
msgid ""
"If upstream releases alpha/beta tarballs, you will need to make use of the "
"B<Uversion-Mangle> option: F<Uversion-Mangle: "
"s/(a|alpha|b|beta|c|dev|pre|rc)/~$1/>"
msgstr ""
"Om uppströmsprojektet ger ut alfa- eller betatararkiv måste du använda "
"alternativet B<Uversion-Mangle>: F<Uversion-Mangle: "
"s/(a|alpha|b|beta|c|dev|pre|rc)/~$1/>"

#. type: textblock
#: ../scripts/debian-watch.pod:1333
msgid ""
"If upstream forget to tag a release for instance here the C<1.2.3> version "
"corresponding to commit C<0123456789abcdf01234567890abcef012345678>, you "
"could download it, using the following combination of B<Oversion-Mangle>, "
"B<Filename-Mangle>, B<Download-Url-Mangle> options:"
msgstr ""
"Om uppströmsprojektet till exempel glömmer att tagga en utgåva, här "
"versionen C<1.2.3> som motsvarar incheckningen "
"C<0123456789abcdf01234567890abcef012345678>, kan du hämta den med följande "
"kombination av alternativen B<Oversion-Mangle>, B<Filename-Mangle> och "
"B<Download-Url-Mangle>:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1340
#, no-wrap
msgid ""
"  Source: https://api.github.com/repos/ImageMagick/ImageMagick/git/matching-refs/tags/\n"
"  Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@\n"
"  Download-Url-Mangle: s%(api.github.com/repos/[^/]+/[^/]+)/git/refs/.*%$1/tarball/0123456789abcdf01234567890abcef012345678%g\n"
"  Filename-Mangle: s%.*%1.2.3~git.tar.gz%\n"
"  Oversion-Mangle: s/.*/1.2.3~git/g\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Source: https://api.github.com/repos/ImageMagick/ImageMagick/git/matching-refs/tags/\n"
"  Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@\n"
"  Download-Url-Mangle: s%(api.github.com/repos/[^/]+/[^/]+)/git/refs/.*%$1/tarball/0123456789abcdf01234567890abcef012345678%g\n"
"  Filename-Mangle: s%.*%1.2.3~git.tar.gz%\n"
"  Oversion-Mangle: s/.*/1.2.3~git/g\n"
"  Search-Mode: plain\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1347 ../scripts/debian-watch-4.pod:1183
msgid ""
"Remember, in this case, after B<gbp> B<import-orig> B<--uscan> to revert the"
" F<debian/watch> file."
msgstr ""
"Kom ihåg att återställa filen F<debian/watch> efter att ha kört B<gbp> "
"B<import-orig> B<--uscan> i detta fall."

#. type: =head2
#: ../scripts/debian-watch.pod:1350 ../scripts/debian-watch-4.pod:1186
msgid "Forgejo (Codeberg)"
msgstr "Forgejo (Codeberg)"

#. type: textblock
#: ../scripts/debian-watch.pod:1352 ../scripts/debian-watch-4.pod:1188
msgid ""
"Releases with manually-attached tarballs "
"(F<assets[...].browser_download_url>):"
msgstr ""
"Utgåvor med manuellt bifogade tararkiv "
"(F<assets[...].browser_download_url>):"

#. type: verbatim
#: ../scripts/debian-watch.pod:1356
#, no-wrap
msgid ""
"  Source: https://codeberg.org/api/v1/repos/<user>/<project>/releases\n"
"  Matching-Pattern: https://codeberg.org/<user>/<project>/releases/download/[^/-_v]*@ANY_VERSION@/[^\"]*@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Source: https://codeberg.org/api/v1/repos/<user>/<project>/releases\n"
"  Matching-Pattern: https://codeberg.org/<user>/<project>/releases/download/[^/-_v]*@ANY_VERSION@/[^\"]*@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1360 ../scripts/debian-watch-4.pod:1195
msgid "Releases with automatically-generated tarballs (F<tarball_url>):"
msgstr "Utgåvor med automatiskt genererade tararkiv (F<tarball_url>):"

#. type: verbatim
#: ../scripts/debian-watch.pod:1364
#, no-wrap
msgid ""
"  Source: https://codeberg.org/api/v1/repos/<user>/<project>/releases\n"
"  Matching-Pattern: https://codeberg.org/<user>/<project>/archive/[^\"-_v]*@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"  Filename-Mangle: s%.*/[^\"-_v]*@ANY_VERSION@%@PACKAGE@-$1%\n"
"\n"
msgstr ""
"  Source: https://codeberg.org/api/v1/repos/<user>/<project>/releases\n"
"  Matching-Pattern: https://codeberg.org/<user>/<project>/archive/[^\"-_v]*@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"  Filename-Mangle: s%.*/[^\"-_v]*@ANY_VERSION@%@PACKAGE@-$1%\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1369 ../scripts/debian-watch-4.pod:1202
msgid "Tags with automatically-generated tarballs (F<tarball_url>):"
msgstr "Taggar med automatiskt genererade tararkiv (F<tarball_url>):"

#. type: verbatim
#: ../scripts/debian-watch.pod:1373
#, no-wrap
msgid ""
"  Source: https://codeberg.org/api/v1/repos/<user>/<project>/tags\n"
"  Matching-Pattern: https://codeberg.org/<user>/<project>/archive/[^\"-_v]*@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"  Filename-Mangle: s%.*/[^\"-_v]*@ANY_VERSION@%@PACKAGE@-$1%\n"
"\n"
msgstr ""
"  Källa: https://codeberg.org/api/v1/repos/<användare>/<projekt>/tags\n"
"  Matching-Pattern: https://codeberg.org/<användare>/<projekt>/archive/[^\"-_v]*@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"  Filename-Mangle: s%.*/[^\"-_v]*@ANY_VERSION@%@PACKAGE@-$1%\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1378 ../scripts/debian-watch-4.pod:1209
msgid "Replace I<codeberg.org> with the Forgejo instance in question."
msgstr "Ersätt I<codeberg.org> med den aktuella Forgejo-instansen."

#. type: =head2
#: ../scripts/debian-watch.pod:1380 ../scripts/debian-watch-4.pod:1211
msgid "PyPI"
msgstr "PyPI"

#. type: textblock
#: ../scripts/debian-watch.pod:1382 ../scripts/debian-watch-4.pod:1213
msgid ""
"For PyPI based projects, pypi.debian.net runs a redirector which allows a "
"simpler form of URL. The format below will automatically be rewritten to use"
" the redirector with the watch file:"
msgstr ""
"För PyPI-baserade projekt kör pypi.debian.net en omdirigeringstjänst som "
"möjliggör en enklare URL-form. Formatet nedan skrivs automatiskt om så att "
"tjänsten används med watchfilen:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1388
#, no-wrap
msgid ""
"  Source: https://pypi.python.org/packages/source/<initial>/<project>/\n"
"  Matching-Pattern: <tar-name>-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: https://pypi.python.org/packages/source/<initial>/<project>/\n"
"  Matching-Pattern: <tar-name>-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1391 ../scripts/debian-watch-4.pod:1221
msgid "For B<cfn-sphere>, set the watch file as:"
msgstr "För B<cfn-sphere> ställs watchfilen in så här:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1395
#, no-wrap
msgid ""
"  Source: https://pypi.python.org/packages/source/c/cfn-sphere/\n"
"  Matching-Pattern: cfn-sphere-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  Source: https://pypi.python.org/packages/source/c/cfn-sphere/\n"
"  Matching-Pattern: cfn-sphere-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1403
#, no-wrap
msgid ""
"  Source: https://pypi.python.org/pypi/cfn-sphere/\n"
"  Matching-Pattern: https://pypi.python.org/packages/.*/.*/.*/cfn-sphere-@ANY_VERSION@@ARCHIVE_EXT@#.*\n"
"\n"
msgstr ""
"  Source: https://pypi.python.org/pypi/cfn-sphere/\n"
"  Matching-Pattern: https://pypi.python.org/packages/.*/.*/.*/cfn-sphere-@ANY_VERSION@@ARCHIVE_EXT@#.*\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1406 ../scripts/debian-watch-4.pod:1236
msgid "code.google.com"
msgstr "code.google.com"

#. type: textblock
#: ../scripts/debian-watch.pod:1408
msgid ""
"Sites which used to be hosted on the Google Code service should have "
"migrated to elsewhere (GitHub?).  Please look for the newer upstream site if"
" available."
msgstr ""
"Webbplatser som tidigare låg hos Google Code-tjänsten bör ha flyttats någon "
"annanstans (GitHub?). Leta efter den nyare uppströmswebbplatsen om den "
"finns."

#. type: =head2
#: ../scripts/debian-watch.pod:1411 ../scripts/debian-watch-4.pod:1241
msgid "npmjs.org (node modules)"
msgstr "npmjs.org (Node.js-moduler)"

#. type: textblock
#: ../scripts/debian-watch.pod:1413 ../scripts/debian-watch-4.pod:1243
msgid ""
"npmjs.org modules are published in JSON files. Here is a way to read them:"
msgstr "npmjs.org-moduler publiceras i JSON-filer. Så här kan de läsas:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1417
#, no-wrap
msgid ""
"  Template: Npmregistry\n"
"  Dist: @lemonldap/handler\n"
"\n"
msgstr ""
"  Template: Npmregistry\n"
"  Dist: @lemonldap/handler\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1422
msgid "Grouped package"
msgstr "Grupperat paket"

#. type: textblock
#: ../scripts/debian-watch.pod:1424 ../scripts/debian-watch-4.pod:1252
msgid ""
"Some node modules are split into multiple little upstream package. Here is a"
" way to group them:"
msgstr ""
"Vissa Node.js-moduler är uppdelade i flera små uppströmskällpaket. Så här "
"kan de grupperas:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1427
#, no-wrap
msgid ""
"  Version: 5\n"
"  Version-Schema: group\n"
"\n"
msgstr ""
"  Version: 5\n"
"  Version-Schema: group\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1430 ../scripts/debian-watch.pod:1458
#, no-wrap
msgid ""
"  Source: https://registry.npmjs.org/mongodb\n"
"  Matching-Pattern: https://registry.npmjs.org/mongodb/-/mongodb-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Source: https://registry.npmjs.org/mongodb\n"
"  Matching-Pattern: https://registry.npmjs.org/mongodb/-/mongodb-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1434 ../scripts/debian-watch.pod:1462
#, no-wrap
msgid ""
"  Component: bson\n"
"  Source: https://registry.npmjs.org/bson\n"
"  Matching-Pattern: https://registry.npmjs.org/bson/-/bson-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Component: bson\n"
"  Source: https://registry.npmjs.org/bson\n"
"  Matching-Pattern: https://registry.npmjs.org/bson/-/bson-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1439 ../scripts/debian-watch.pod:1467
#, no-wrap
msgid ""
"  Component: mongodb-core\n"
"  Source: https://registry.npmjs.org/mongodb-core\n"
"  Matching-Pattern: https://registry.npmjs.org/mongodb-core/-/mongodb-core-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Component: mongodb-core\n"
"  Source: https://registry.npmjs.org/mongodb-core\n"
"  Matching-Pattern: https://registry.npmjs.org/mongodb-core/-/mongodb-core-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch.pod:1444 ../scripts/debian-watch.pod:1472
#, no-wrap
msgid ""
"  Component: requireoptional\n"
"  Source: https://registry.npmjs.org/require_optional\n"
"  Matching-Pattern: https://registry.npmjs.org/require_optional/-/require_optional-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Component: requireoptional\n"
"  Source: https://registry.npmjs.org/require_optional\n"
"  Matching-Pattern: https://registry.npmjs.org/require_optional/-/require_optional-@ANY_VERSION@@ARCHIVE_EXT@\n"
"  Search-Mode: plain\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1449 ../scripts/debian-watch-4.pod:1269
msgid ""
"Package version is then the concatenation of upstream versions separated by "
"\"+~\"."
msgstr ""
"Paketversionen är då en sammanfogning av uppströmsversioner separerade med "
"\"+~\"."

#. type: textblock
#: ../scripts/debian-watch.pod:1452
msgid ""
"To avoid having a too long version, the \"checksum\" method can be used.  In"
" this case, the main source is automatically declared as \"group\":"
msgstr ""
"För att undvika ett alltför långt versionsnummer kan metoden \"checksum\" "
"användas. I detta fall deklareras huvudkällan automatiskt som \"group\":"

#. type: verbatim
#: ../scripts/debian-watch.pod:1455
#, no-wrap
msgid ""
"  Version: 5\n"
"  Version-Schema: checksum\n"
"\n"
msgstr ""
"  Version: 5\n"
"  Version-Schema: checksum\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1477 ../scripts/debian-watch-4.pod:1289
msgid ""
"The \"checksum\" is made up of the separate sum of each number composing the"
" component versions and prefixed with ~cs (short for checksum).  Following "
"is an example with 3 components whose versions are \"1.2.4\", \"2.0.1\" and "
"\"10.0\", with the main tarball having version \"2.0.6\":"
msgstr ""
"\"Kontrollsumman\" består av den separata summan av varje tal i "
"komponentversionerna och har prefixet ~cs (en förkortning av kontrollsumma)."
" Nedan följer ett exempel med tre komponenter med versionerna \"1.2.4\", "
"\"2.0.1\" och \"10.0\", där huvudtararkivet har versionen \"2.0.6\":"

#. type: verbatim
#: ../scripts/debian-watch.pod:1482 ../scripts/debian-watch-4.pod:1294
#, no-wrap
msgid ""
"  Main: 2.0.6\n"
"  Comp1:         1 .     2 .     4\n"
"  Comp2:         2 .     0 .     1\n"
"  Comp3:        10 .     0\n"
"  ================================\n"
"  Result  : 1+2+10 . 2+0+0 .   4+1\n"
"  Checksum:     13 .     2 .     5\n"
"  ================================\n"
"  Final Version:   2.0.6+~cs13.2.5\n"
"\n"
msgstr ""
"  Main: 2.0.6\n"
"  Comp1:         1 .     2 .     4\n"
"  Comp2:         2 .     0 .     1\n"
"  Comp3:        10 .     0\n"
"  ================================\n"
"  Result  : 1+2+10 . 2+0+0 .   4+1\n"
"  Checksum:     13 .     2 .     5\n"
"  ================================\n"
"  Final Version:   2.0.6+~cs13.2.5\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1492 ../scripts/debian-watch-4.pod:1304
msgid ""
"uscan will also display the original version string before being encoded "
"into the checksum, which can for example be used in a debian/changelog entry"
" to easily follow the changes:"
msgstr ""
"uscan visar också den ursprungliga versionssträngen innan den kodas till "
"kontrollsumman. Den kan till exempel användas i en post i debian/changelog "
"för att enkelt följa ändringarna:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1496 ../scripts/debian-watch-4.pod:1308
#, no-wrap
msgid ""
"  2.0.6+~1.2.4+~2.0.1+~10.0\n"
"\n"
msgstr ""
"  2.0.6+~1.2.4+~2.0.1+~10.0\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1498 ../scripts/debian-watch-4.pod:1310
msgid ""
"B<Note>: This feature currently accepts only versions composed of digits and"
" full stops (`.`)."
msgstr ""
"B<Obs>: Denna funktion accepterar för närvarande endast versioner som består"
" av siffror och punkter (`.`)."

#. type: =head2
#: ../scripts/debian-watch.pod:1501 ../scripts/debian-watch-4.pod:1313
msgid "direct access to the git repository (tags)"
msgstr "direkt åtkomst till git-arkivet (taggar)"

#. type: textblock
#: ../scripts/debian-watch.pod:1503 ../scripts/debian-watch-4.pod:1315
msgid ""
"If the upstream only publishes its code via the git repository and its code "
"has no web interface to obtain the release tarball, you can use B<uscan> "
"with the tags of the git repository to track and package the new upstream "
"release."
msgstr ""
"Om uppströmsprojektet endast publicerar sin kod via git-arkivet och koden "
"saknar ett webbgränssnitt för att hämta utgåvans tararkiv, kan du använda "
"B<uscan> med taggarna i git-arkivet för att följa och paketera den nya "
"uppströmsutgåvan."

#. type: verbatim
#: ../scripts/debian-watch.pod:1509
#, no-wrap
msgid ""
"  Source: http://git.ao2.it/tweeper.git\n"
"  Matching-Pattern: refs/tags/@ANY_VERSION@\n"
"  Git-Mode: full\n"
"  Mode: git\n"
"\n"
msgstr ""
"  Source: http://git.ao2.it/tweeper.git\n"
"  Matching-Pattern: refs/tags/@ANY_VERSION@\n"
"  Git-Mode: full\n"
"  Mode: git\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1514 ../scripts/debian-watch-4.pod:1324
msgid "Please note \"B<git ls-remote>\" is used to obtain references for tags."
msgstr ""
"Observera att \"B<git ls-remote>\" används för att hämta referenser för "
"taggar."

#. type: textblock
#: ../scripts/debian-watch.pod:1516 ../scripts/debian-watch-4.pod:1326
msgid ""
"If a tag B<v20.5> is the newest tag, the above example downloads "
"I<spkg>B<-20.5.tar.xz> after making a full clone of the git repository which"
" is needed for dumb git server."
msgstr ""
"Om taggen B<v20.5> är den senaste taggen hämtar exemplet ovan "
"I<spkg>B<-20.5.tar.xz> efter att ha gjort en fullständig klon av git-"
"arkivet, vilket behövs för en enkel git-server."

#. type: textblock
#: ../scripts/debian-watch.pod:1520
msgid "If tags are signed, set B<Pgp-Mode: gittag> to verify them."
msgstr ""
"Om taggarna är signerade ställer du in B<Pgp-Mode: gittag> för att verifiera"
" dem."

#. type: =head2
#: ../scripts/debian-watch.pod:1522 ../scripts/debian-watch-4.pod:1332
msgid "direct access to the git repository (HEAD)"
msgstr "direkt åtkomst till git-arkivet (HEAD)"

#. type: textblock
#: ../scripts/debian-watch.pod:1524 ../scripts/debian-watch-4.pod:1334
msgid ""
"If the upstream only publishes its code via the git repository and its code "
"has no web interface nor the tags to obtain the released tarball, you can "
"use B<uscan> with the HEAD of the git repository to track and package the "
"new upstream release with an automatically generated version string."
msgstr ""
"Om uppströmsprojektet endast publicerar sin kod via git-arkivet och koden "
"saknar både webbgränssnitt och taggar för att hämta utgåvans tararkiv, kan "
"du använda B<uscan> med git-arkivets HEAD för att följa och paketera den nya"
" uppströmsutgåvan med en automatiskt genererad versionssträng."

#. type: verbatim
#: ../scripts/debian-watch.pod:1531
#, no-wrap
msgid ""
"  Source: https://github.com/Debian/dh-make-golang\n"
"  Matching-Pattern: HEAD\n"
"  Mode: git\n"
"\n"
msgstr ""
"  Source: https://github.com/Debian/dh-make-golang\n"
"  Matching-Pattern: HEAD\n"
"  Mode: git\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1535 ../scripts/debian-watch-4.pod:1344
msgid ""
"Please note that a local shallow copy of the git repository is made with "
"\"B<git clone --bare --depth=1> ...\" normally in the target directory.  "
"B<uscan> generates the new upstream version with \"B<git log "
"--date=format:%Y%m%d --pretty=0.0~git%cd.%h>\" on this local copy of "
"repository as its default behavior."
msgstr ""
"Observera att en lokal ytlig kopia av git-arkivet normalt skapas i "
"målkatalogen med \"B<git clone --bare --depth=1> ...\". Som standard "
"genererar B<uscan> den nya uppströmsversionen med \"B<git log "
"--date=format:%Y%m%d --pretty=0.0~git%cd.%h>\" i denna lokala arkivkopia."

#. type: textblock
#: ../scripts/debian-watch.pod:1541
msgid ""
"The generation of the upstream version string may the adjusted to your taste"
" by adding B<Git-Pretty> and B<Git-Date> options."
msgstr ""
"Genereringen av uppströmsversionssträngen kan anpassas efter dina önskemål "
"med alternativen B<Git-Pretty> och B<Git-Date>."

#. type: =head2
#: ../scripts/debian-watch.pod:1544 ../scripts/debian-watch-4.pod:1353
msgid "direct access to the git repository (with submodules)"
msgstr "direkt åtkomst till git-arkivet (med undermoduler)"

#. type: textblock
#: ../scripts/debian-watch.pod:1546 ../scripts/debian-watch-4.pod:1355
msgid ""
"If the upstream only publishes its code via a git repository and the "
"repository includes submodules, you can use B<uscan> with the tags or HEAD "
"of the git repository to track and package the new upstream release."
msgstr ""
"Om uppströms endast publicerar sin kod via ett git-arkiv och arkivet "
"innehåller undermoduler, kan du använda B<uscan> med taggarna eller HEAD i "
"git-arkivet för att spåra och paketera den nya uppströmsversionen."

#. type: textblock
#: ../scripts/debian-watch.pod:1550
msgid "Use B<Git-Modules> to clone all submodules:"
msgstr "Använd B<Git-Modules> för att klona alla undermoduler:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1554
#, no-wrap
msgid ""
"  Source: https://github.com/namespace/project\n"
"  Matching-Pattern: [refs/tags/@ANY_VERSION@|HEAD]\n"
"  Git-Mode: shallow\n"
"  Git-Modules: all\n"
"  Mode: git\n"
"\n"
msgstr ""
"  Source: https://github.com/namespace/project\n"
"  Matching-Pattern: [refs/tags/@ANY_VERSION@|HEAD]\n"
"  Git-Mode: shallow\n"
"  Git-Modules: all\n"
"  Mode: git\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1560
msgid ""
"To clone selected submodules (and exclude others), use B<Git-Modules> with a"
" semicolon-separated list:"
msgstr ""
"Använd B<Git-Modules> med en semikolonseparerad lista för att klona utvalda "
"undermoduler och utesluta övriga:"

#. type: verbatim
#: ../scripts/debian-watch.pod:1565
#, no-wrap
msgid ""
"  Source: https://github.com/namespace/project\n"
"  Matching-Pattern: [refs/tags/@ANY_VERSION@|HEAD]\n"
"  Git-Mode: shallow\n"
"  Git-Modules: m4;doc/common\n"
"  Mode: git\n"
"\n"
msgstr ""
"  Source: https://github.com/namespace/project\n"
"  Matching-Pattern: [refs/tags/@ANY_VERSION@|HEAD]\n"
"  Git-Mode: shallow\n"
"  Git-Modules: m4;doc/common\n"
"  Mode: git\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1571 ../scripts/debian-watch-4.pod:1372
msgid "direct access to the Subversion repository (tags)"
msgstr "direkt åtkomst till Subversion-arkivet (taggar)"

#. type: textblock
#: ../scripts/debian-watch.pod:1573 ../scripts/debian-watch-4.pod:1374
msgid ""
"If the upstream only publishes its code via the Subversion repository and "
"its code has no web interface to obtain the release tarball, you can use "
"B<uscan> with the tags of the Subversion repository to track and package the"
" new upstream release."
msgstr ""
"Om uppströmsprojektet endast publicerar sin kod via Subversion-arkivet och "
"koden saknar ett webbgränssnitt för att hämta utgåvans tararkiv, kan du "
"använda B<uscan> med taggarna i Subversion-arkivet för att följa och "
"paketera den nya uppströmsutgåvan."

#. type: verbatim
#: ../scripts/debian-watch.pod:1580
#, no-wrap
msgid ""
"  Source: svn://svn.code.sf.net/p/jmol/code/tags/\n"
"  Matching-Pattern: @ANY_VERSION@\\/\n"
"  Mode: svn\n"
"\n"
msgstr ""
"  Source: svn://svn.code.sf.net/p/jmol/code/tags/\n"
"  Matching-Pattern: @ANY_VERSION@\\/\n"
"  Mode: svn\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1584 ../scripts/debian-watch-4.pod:1384
msgid "direct access to the Subversion repository (HEAD)"
msgstr "direkt åtkomst till Subversion-arkivet (HEAD)"

#. type: textblock
#: ../scripts/debian-watch.pod:1586 ../scripts/debian-watch-4.pod:1386
msgid ""
"If the upstream only publishes its code via the Subversion repository and "
"its code has no web interface to obtain the release tarball, you can use "
"B<uscan> to get the most recent source of a subtree in the repository with "
"an automatically generated version string."
msgstr ""
"Om uppströmsprojektet endast publicerar sin kod via Subversion-arkivet och "
"koden saknar ett webbgränssnitt för att hämta utgåvans tararkiv, kan du "
"använda B<uscan> för att hämta den senaste källkoden för ett delträd i "
"arkivet med en automatiskt genererad versionssträng."

#. type: verbatim
#: ../scripts/debian-watch.pod:1591
#, no-wrap
msgid ""
"  Source: svn://svn.code.sf.net/p/jmol/code/trunk/\n"
"  Matching-Pattern: HEAD\n"
"  Mode: svn\n"
"\n"
msgstr ""
"  Source: svn://svn.code.sf.net/p/jmol/code/trunk/\n"
"  Matching-Pattern: HEAD\n"
"  Mode: svn\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1595
msgid ""
"By default, B<uscan> generates the new upstream version by appending the "
"revision number to \"0.0~svn\". This can later be changed using B<Filename-"
"Mangle>."
msgstr ""
"Som standard genererar B<uscan> den nya uppströmsversionen genom att lägga "
"till revisionsnumret till \"0.0~svn\". Detta kan senare ändras med hjälp av "
"B<Filename-Mangle>."

#. type: =head2
#: ../scripts/debian-watch.pod:1599 ../scripts/debian-watch-4.pod:1400
msgid "Fossil"
msgstr "Fossil"

#. type: textblock
#: ../scripts/debian-watch.pod:1601 ../scripts/debian-watch-4.pod:1402
msgid ""
"For Fossil based projects, the tarball URL can be deduced from the taglist "
"page."
msgstr ""
"För Fossil-baserade projekt kan URL:en till tararkivet härledas från "
"tagglistningssidan."

#. type: verbatim
#: ../scripts/debian-watch.pod:1605
#, no-wrap
msgid ""
"  Source: http://grammalecte.net:8080/taglist\n"
"  Matching-Pattern: /timeline\\?t=@ANY_VERSION@\n"
"  Download-Url-Mangle: s#/timeline\\?t=(@ANY_VERSION@)#/tarball/Grammalecte.tar.gz?r=$1#\n"
"  Filename-Mangle: s/timeline\\?t=(@ANY_VERSION@)/@PACKAGE@-$1.tar.gz/\n"
"  Search-Mode: plain\n"
"\n"
msgstr ""
"  Source: http://grammalecte.net:8080/taglist\n"
"  Matching-Pattern: /timeline\\?t=@ANY_VERSION@\n"
"  Download-Url-Mangle: s#/timeline\\?t=(@ANY_VERSION@)#/tarball/Grammalecte.tar.gz?r=$1#\n"
"  Filename-Mangle: s/timeline\\?t=(@ANY_VERSION@)/@PACKAGE@-$1.tar.gz/\n"
"  Search-Mode: plain\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch.pod:1611
msgid "GitLab"
msgstr "GitLab"

#. type: textblock
#: ../scripts/debian-watch.pod:1613
msgid ""
"GitLab uses a specific way to expose archive corresponding to tags. Uscan "
"embeds a B<Mode: gitlab> to be able to download such archives. Examples:"
msgstr ""
"GitLab har ett särskilt sätt att exponera arkiv som motsvarar taggar. uscan "
"har B<Mode: gitlab> inbyggt för att kunna hämta sådana arkiv. Exempel:"

#. type: =item
#: ../scripts/debian-watch.pod:1618
msgid "* Using templates"
msgstr "* Använda mallar"

#. type: verbatim
#: ../scripts/debian-watch.pod:1622
#, no-wrap
msgid ""
"  Template: GitLab\n"
"  Dist: https://salsa.debian.org/debian/devscripts\n"
"\n"
msgstr ""
"  Template: GitLab\n"
"  Dist: https://salsa.debian.org/debian/devscripts\n"
"\n"

#. type: =item
#: ../scripts/debian-watch.pod:1625
msgid "* Using B<Mode: gitlab>"
msgstr "* Använda B<Mode: gitlab>"

#. type: verbatim
#: ../scripts/debian-watch.pod:1629
#, no-wrap
msgid ""
"  Source: https://salsa.debian.org/debian/devscripts\n"
"  Mode: gitlab\n"
"  Matching-Pattern: @STABLE_VERSION@\n"
"  Pgp-Mode: none\n"
"  Filename-Mangle: s/.*(@ARCHIVE_EXT@)/@PACKAGE@.tar.gz/\n"
"\n"
msgstr ""
"  Source: https://salsa.debian.org/debian/devscripts\n"
"  Mode: gitlab\n"
"  Matching-Pattern: @STABLE_VERSION@\n"
"  Pgp-Mode: none\n"
"  Filename-Mangle: s/.*(@ARCHIVE_EXT@)/@PACKAGE@.tar.gz/\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch.pod:1639
msgid ""
"L<uscan(1)>, L<uscan-templates(5)>, L<mk-origtargz(1)>, L<perlre(1)>, "
"L<uupdate(1)>, L<devscripts.conf(5)>"
msgstr ""
"L<uscan(1)>, L<uscan-templates(5)>, L<mk-origtargz(1)>, L<perlre(1)>, "
"L<uupdate(1)>, L<devscripts.conf(5)>"

#. type: textblock
#: ../scripts/debian-watch.pod:1644 ../scripts/debian-watch-4.pod:1418
#: ../scripts/uscan.pl:845
msgid ""
"The original version of uscan was written by Christoph Lameter "
"<clameter@debian.org>. Significant improvements, changes and bugfixes were "
"made by Julian Gilbey <jdg@debian.org>. HTTP support was added by Piotr "
"Roszatycki <dexter@debian.org>. The program was rewritten in Perl by Julian "
"Gilbey. Xavier Guimard converted it in object-oriented Perl using L<Moo>."
msgstr ""
"Den ursprungliga versionen av uscan skrevs av Christoph Lameter "
"<clameter@debian.org>. Betydande förbättringar, ändringar och buggfixar "
"gjordes av Julian Gilbey <jdg@debian.org>. HTTP-stöd lades till av Piotr "
"Roszatycki <dexter@debian.org>. Programmet skrevs om i Perl av Julian "
"Gilbey. Xavier Guimard konverterade det till objektorienterad Perl med hjälp"
" av L<Moo>."

#. type: textblock
#: ../scripts/debian-watch-4.pod:5
msgid "debian/watch - Format specification for version 4"
msgstr "debian/watch – formatspecifikation för version 4"

#. type: textblock
#: ../scripts/debian-watch-4.pod:9
msgid "This document describes the version 4 format of F<debian/watch>."
msgstr "Detta dokument beskriver version 4 av formatet F<debian/watch>."

#. type: =head1
#: ../scripts/debian-watch-4.pod:11
msgid "FORMAT OF THE WATCH FILE, VERSION 4"
msgstr "WATCHFILENS FORMAT, VERSION 4"

#. type: textblock
#: ../scripts/debian-watch-4.pod:13
msgid "The version 4 format of F<debian/watch> can be summarized as follows:"
msgstr ""
"Version 4-formatet för F<debian/watch> kan sammanfattas enligt följande:"

#. type: =item
#: ../scripts/debian-watch-4.pod:17
msgid "* Leading spaces and tabs are dropped."
msgstr "* Inledande mellanslag och tabulatorer tas bort."

#. type: =item
#: ../scripts/debian-watch-4.pod:19
msgid "* Empty lines are dropped."
msgstr "* Tomma rader tas bort."

#. type: =item
#: ../scripts/debian-watch-4.pod:23
msgid ""
"* A single B<\\> (back slash) at the end of a line is dropped and the next "
"line is concatenated after removing leading spaces and tabs. The "
"concatenated line is parsed as a single line. (The existence or non-"
"existence of the space before the tailing single B<\\> is significant.)"
msgstr ""
"* Ett ensamt B<\\> (bakstreck) i slutet av en rad tas bort, och nästa rad "
"fogas samman efter att inledande mellanslag och tabulatorer har tagits bort."
" Den sammanfogade raden tolkas som en enda rad. (Förekomst eller frånvaro av"
" mellanslag före det avslutande ensamma B<\\> har betydelse.)"

#. type: =item
#: ../scripts/debian-watch-4.pod:28
msgid "* The first non-comment line is:"
msgstr "* Den första raden utan kommentar är:"

#. type: =item
#: ../scripts/debian-watch-4.pod:32
msgid "B<version=4>"
msgstr "B<version=4>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:38
msgid ""
"If you use \"B<version=3>\" instead here, some features may not work as "
"documented here.  See L<uscan(1)/HISTORY AND UPGRADING>."
msgstr ""
"Om du använder \"B<version=3>\" här i stället kanske vissa funktioner inte "
"fungerar enligt beskrivningen. Se L<uscan(1)/HISTORY AND UPGRADING>."

#. type: =item
#: ../scripts/debian-watch-4.pod:41
msgid ""
"* The following non-comment lines (watch lines) specify the rules for the "
"selection of the candidate upstream tarball URLs and are in one of the "
"following three formats:"
msgstr ""
"* Följande rader utan kommentarer (watchrader) anger reglerna för att välja "
"kandidat-URL:er till uppströms tararkiv och har ett av följande tre format:"

#. type: =item
#: ../scripts/debian-watch-4.pod:47
msgid ""
"* B<opts=\"> I<...> B<\"> B<http://>I<URL> I<matching-pattern> [I<version> "
"[I<script>]]"
msgstr ""
"* B<opts=\"> I<...> B<\"> B<http://>I<URL> I<matching-pattern> [I<version> "
"[I<script>]]"

#. type: =item
#: ../scripts/debian-watch-4.pod:49
msgid "* B<http://>I<URL> I<matching-pattern> [I<version> [I<script>]]"
msgstr "* B<http://>I<URL> I<matching-pattern> [I<version> [I<script>]]"

#. type: =item
#: ../scripts/debian-watch-4.pod:51
msgid "* B<opts=\"> I<...> B<\">"
msgstr "* B<opts=\"> I<...> B<\">"

#. type: textblock
#: ../scripts/debian-watch-4.pod:55
msgid "Here,"
msgstr "Här,"

#. type: =item
#: ../scripts/debian-watch-4.pod:59
msgid ""
"* B<opts=\"> I<...> B<\"> specifies the behavior of B<uscan>.  See "
"L<uscan(1)/WATCH FILE OPTIONS>."
msgstr ""
"* B<opts=\"> I<...> B<\"> anger beteendet för B<uscan>.  Se L<uscan(1)/WATCH"
" FILE OPTIONS>."

#. type: =item
#: ../scripts/debian-watch-4.pod:62
msgid ""
"* B<http://>I<URL> specifies the web page where upstream publishes the link "
"to the latest source archive."
msgstr ""
"* B<http://>I<URL> anger webbsidan där uppströms publicerar länken till det "
"senaste källarkivet."

#. type: =item
#: ../scripts/debian-watch-4.pod:67
msgid "* B<https://>I<URL> may also be used, as may"
msgstr "* B<https://>I<URL> kan också användas, liksom"

#. type: =item
#: ../scripts/debian-watch-4.pod:69
msgid "* B<ftp://>I<URL>"
msgstr "* B<ftp://>I<URL>"

#. type: =item
#: ../scripts/debian-watch-4.pod:71
msgid ""
"* Some parts of I<URL> may be in the regex match pattern surrounded between "
"B<(> and B<)> such as B</foo/bar-([\\.\\d]+)/>.  (If multiple directories "
"match, the highest version is picked.) Otherwise, the I<URL> is taken as "
"verbatim."
msgstr ""
"* Delar av I<URL> kan ingå i det reguljära uttrycksmönstret mellan B<(> och "
"B<)>, till exempel B</foo/bar-([\\.\\d]+)/>. (Om flera kataloger matchar "
"väljs den högsta versionen.) I annat fall tas I<URL> ordagrant."

#. type: =item
#: ../scripts/debian-watch-4.pod:78
msgid ""
"* I<matching-pattern> specifies the full string matching pattern for hrefs "
"in the web page.  See L<uscan(1)/WATCH FILE EXAMPLES>."
msgstr ""
"* I<matching-pattern> anger det fullständiga strängmatchningsmönstret för "
"href:er på webbsidan. Se L<uscan(1)/WATCH FILE EXAMPLES>."

#. type: =item
#: ../scripts/debian-watch-4.pod:83
msgid ""
"* All matching parts in B<(> and B<)> are concatenated with B<.> (period)  "
"to form the upstream version."
msgstr ""
"* Alla matchande delar i B<(> och B<)> sammanfogas med B<.> (punkt) för att "
"bilda uppströmsversionen."

#. type: =item
#: ../scripts/debian-watch-4.pod:86
msgid ""
"* If the hrefs do not contain directories, you can combine this with the "
"previous entry. I.e., B<http://>I<URL>B</>I<matching-pattern> ."
msgstr ""
"* Om href:erna inte innehåller kataloger kan detta kombineras med föregående"
" post, alltså B<http://>I<URL>B</>I<matching-pattern>."

#. type: =item
#: ../scripts/debian-watch-4.pod:91
msgid ""
"* I<version> restricts the upstream tarball which may be downloaded.  The "
"newest available version is chosen in each case."
msgstr ""
"* I<version> begränsar vilka uppströms tararkiv som får hämtas. Den senaste "
"tillgängliga versionen väljs i varje fall."

#. type: =item
#: ../scripts/debian-watch-4.pod:96
msgid ""
"* B<debian> I<(default)> requires the downloading upstream tarball to be "
"newer than the version obtained from F<debian/changelog>."
msgstr ""
"* B<debian> I<(standard)> kräver att det hämtade uppströms tararkivet är "
"nyare än versionen i F<debian/changelog>."

#. type: =item
#: ../scripts/debian-watch-4.pod:99
msgid ""
"* I<version-number> such as B<12.5> requires the upstream tarball to be "
"newer than the I<version-number>."
msgstr ""
"* I<version-number>, till exempel B<12.5>, kräver att uppströms tararkivet "
"är nyare än I<version-number>."

#. type: =item
#: ../scripts/debian-watch-4.pod:102
msgid ""
"* B<same> requires the downloaded version of the secondary tarballs to be "
"exactly the same as the one for the first upstream tarball downloaded. "
"(Useful only for MUT)"
msgstr ""
"* B<same> kräver att den hämtade versionen av de sekundära tararkiven är "
"exakt densamma som för det första hämtade uppströms tararkivet. (Endast "
"användbart för MUT.)"

#. type: =item
#: ../scripts/debian-watch-4.pod:106
msgid ""
"* B<previous> restricts the version of the signature file. (Used with "
"pgpmode=previous)"
msgstr ""
"* B<previous> begränsar versionen av signaturfilen. (Används med "
"pgpmode=previous)"

#. type: =item
#: ../scripts/debian-watch-4.pod:109
msgid ""
"* B<ignore> does not restrict the version of the secondary tarballs. (Maybe "
"useful for MUT)"
msgstr ""
"* B<ignore> begränsar inte versionen för de sekundära tararkiven. (Kan vara "
"användbart för MUT.)"

#. type: =item
#: ../scripts/debian-watch-4.pod:112
msgid ""
"* B<group> requires the downloading upstream tarball to be newer than the "
"version obtained from F<debian/changelog>. Package version is the "
"concatenation of all \"group\" upstream version."
msgstr ""
"* B<group> kräver att det hämtade uppströms tararkivet är nyare än versionen"
" i F<debian/changelog>. Paketversionen är en sammanfogning av alla "
"uppströmsversioner i \"group\"."

#. type: =item
#: ../scripts/debian-watch-4.pod:116
msgid ""
"* B<checksum> requires the downloading upstream tarball to be newer than the"
" version obtained from F<debian/changelog>. Package version is the "
"concatenation of the version of the main tarball, followed by a checksum of "
"all the tarballs using the \"checksum\" version system.  At least the main "
"upstream source has to be declared as \"group\"."
msgstr ""
"* B<checksum> kräver att det hämtade uppströms tararkivet är nyare än "
"versionen i F<debian/changelog>. Paketversionen är huvudtararkivets version "
"följd av en kontrollsumma för alla tararkiv som använder versionssystemet "
"\"checksum\". Minst huvudkällan uppströms måste deklareras som \"group\"."

#. type: =item
#: ../scripts/debian-watch-4.pod:124
msgid ""
"* If set, I<script> is executed at the end of B<uscan> execution with "
"appropriate arguments provided by B<uscan> I<(default: no action)>.  See "
"L<uscan/\"Custom script\"> for more details on these scripts and "
"L<uscan/\"HISTORY AND UPGRADING\"> for how B<uscan> invokes the custom "
"I<script> (or L<uupdate>)."
msgstr ""
"* Om I<script> anges körs det i slutet av B<uscan>-körningen med lämpliga "
"argument från B<uscan> I<(standard: ingen åtgärd)>. Se L<uscan/\"Custom "
"script\"> för mer om dessa skript och L<uscan/\"HISTORY AND UPGRADING\"> för"
" hur B<uscan> anropar det egna I<script> (eller L<uupdate>)."

#. type: =item
#: ../scripts/debian-watch-4.pod:132
msgid ""
"* The typical Debian package is a non-native package made from one upstream "
"tarball.  Only a single line of the watch line in one of the first two "
"formats is usually used with its I<version> set to B<debian> and I<script> "
"set to B<uupdate>."
msgstr ""
"* Det typiska Debian-paketet är ett icke-inhemskt paket som skapas från ett "
"uppströms tararkiv. Vanligtvis används bara en watchrad i något av de två "
"första formaten, med I<version> inställd på B<debian> och I<script> inställd"
" på B<uupdate>."

#. type: =item
#: ../scripts/debian-watch-4.pod:137
msgid "* A native package should not specify I<script>."
msgstr "* Ett inbyggt paket bör inte ange I<script>."

#. type: =item
#: ../scripts/debian-watch-4.pod:139
msgid ""
"* A multiple upstream tarball (MUT) package should specify B<uupdate> as "
"I<script> in the last watch line and should skip specifying I<script> in the"
" rest of the watch lines."
msgstr ""
"* Ett paket med flera uppströms tararkiv (MUT) bör ange B<uupdate> som "
"I<script> på den sista watchraden och inte ange I<script> på de övriga "
"watchraderna."

#. type: =item
#: ../scripts/debian-watch-4.pod:145
msgid ""
"* The last format of the watch line is useful to set the persistent "
"parameters: B<user-agent>, B<compression>.  If this format is used, this "
"must be followed by the I<URL> defining watch line(s)."
msgstr ""
"* Watchradens sista format används för att ställa in beständiga parametrar: "
"B<user-agent>, B<compression>. Om detta format används måste det följas av "
"den eller de watchrader som definierar I<URL>."

#. type: =item
#: ../scripts/debian-watch-4.pod:149
msgid ""
"* [ and ] in the above format are there to mark the optional parts and "
"should not be typed."
msgstr ""
"* [ och ] i ovanstående format markerar de valfria delarna och ska inte "
"skrivas in."

#. type: textblock
#: ../scripts/debian-watch-4.pod:168
msgid "This is substituted by the legal upstream version regex (capturing)."
msgstr ""
"Detta ersätts av det giltiga reguljära uttrycket för uppströmsversionen (med"
" fångstgrupp)."

#. type: textblock
#: ../scripts/debian-watch-4.pod:174
msgid ""
"This is substituted by the typical archive file extension regex (non-"
"capturing)."
msgstr ""
"Detta ersätts av det vanliga reguljära uttrycket för arkivfiländelser (utan "
"fångstgrupp)."

#. type: textblock
#: ../scripts/debian-watch-4.pod:180
msgid ""
"This is substituted by the typical signature file extension regex (non-"
"capturing)."
msgstr ""
"Detta ersätts av det vanliga reguljära uttrycket för signaturfiländelser "
"(utan fångstgrupp)."

#. type: verbatim
#: ../scripts/debian-watch-4.pod:182
#, no-wrap
msgid ""
"  (?i)(?:\\.(?:tar\\.xz|tar\\.bz2|tar\\.gz|tar\\.zstd?|zip|tgz|tbz|txz))(?:\\.(?:asc|pgp|gpg|sig|sign))\n"
"\n"
msgstr ""
"  (?i)(?:\\.(?:tar\\.xz|tar\\.bz2|tar\\.gz|tar\\.zstd?|zip|tgz|tbz|txz))(?:\\.(?:asc|pgp|gpg|sig|sign))\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch-4.pod:186
msgid ""
"This is substituted by the typical Debian extension regexp (capturing)."
msgstr ""
"Detta ersätts av det vanliga reguljära uttrycket för Debian-filändelsen (med"
" fångstgrupp)."

#. type: textblock
#: ../scripts/debian-watch-4.pod:197
msgid ""
"B<uscan> reads the watch options specified in B<opts=\"> I<...> B<\"> to "
"customize its behavior. Multiple options I<option1>, I<option2>, I<option3>,"
" ... can be set as B<opts=\">I<option1>B<,> I<option2>B<,> I<option3>B<,> I<"
" ...  >B<\"> .  The double quotes are necessary if options contain any "
"spaces."
msgstr ""
"B<uscan> läser watchalternativen som anges i B<opts=\" I<...> B<\"> för att "
"anpassa sitt beteende. Flera alternativ I<option1>, I<option2>, I<option3>, "
"... kan anges som B<opts=\"I<option1>B<,> I<option2>B<,> I<option3>B<,> I< "
"...  >B<\">. Dubbla citattecken behövs om alternativen innehåller "
"mellanslag."

#. type: textblock
#: ../scripts/debian-watch-4.pod:202
msgid ""
"Unless otherwise noted as persistent, most options are valid only within "
"their containing watch line."
msgstr ""
"Om de inte uttryckligen anges som beständiga är de flesta alternativen bara "
"giltiga på den watchrad där de anges."

#. type: textblock
#: ../scripts/debian-watch-4.pod:205
msgid "The available watch options are:"
msgstr "De tillgängliga watchalternativen är:"

#. type: =item
#: ../scripts/debian-watch-4.pod:209
msgid "B<component=>I<component>"
msgstr "B<component=>I<component>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:211
msgid ""
"Set the name of the secondary source tarball as I<< "
"<spkg>_<oversion>.orig-<component>.tar.gz >> for a MUT package."
msgstr ""
"Ange namnet på det sekundära källkodstararkivet som I<< "
"<spkg>_<oversion>.orig-<component>.tar.gz >> för ett MUT-paket."

#. type: =item
#: ../scripts/debian-watch-4.pod:214
msgid "B<ctype=>I<component-type>"
msgstr "B<ctype=>I<component-type>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:219
msgid ""
"When using B<ctype=nodejs>, uscan tries to find a version in "
"C<package.json>, when using B<ctype=perl>, uscan tries to find a version in "
"C<META.json>.  If a version is found, it is used as current version for this"
" component, regardless version found in Debian version string. This permits "
"a better change detection when using I<ignore> or I<checksum> as Debian "
"version."
msgstr ""
"När du använder B<ctype=nodejs> försöker uscan hitta en version i "
"C<package.json>. När du använder B<ctype=perl> försöker uscan hitta en "
"version i C<META.json>.  Om en version hittas används den som aktuell "
"version för denna komponent, oavsett vilken version som finns i Debians "
"versionssträng. Detta möjliggör bättre ändringsdetektering när du använder "
"I<ignore> eller I<checksum> som Debian-version."

#. type: =item
#: ../scripts/debian-watch-4.pod:225
msgid "B<compression=>I<method>"
msgstr "B<compression=>I<method>"

#. type: =item
#: ../scripts/debian-watch-4.pod:245
msgid "* B<repack> is set in the watch line as B<opts=\"repack,>I<...>B<\">."
msgstr "* B<repack> anges på watchraden som B<opts=\"repack,>I<...>B<\">."

#. type: =item
#: ../scripts/debian-watch-4.pod:258
msgid "B<repack>"
msgstr "B<repack>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:260
msgid ""
"Force repacking of the upstream tarball using the compression I<method>."
msgstr ""
"Tvinga ompackning av uppströms tararkivet med komprimeringsmetoden "
"I<method>."

#. type: =item
#: ../scripts/debian-watch-4.pod:262
msgid "B<repacksuffix=>I<suffix>"
msgstr "B<repacksuffix=>I<suffix>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:264
msgid ""
"Add I<suffix> to the Debian package upstream version only when the source "
"tarball is repackaged.  This rule should be used only for a single upstream "
"tarball package."
msgstr ""
"Lägg till I<suffix> till uppströmsversionen av Debian-paketet endast när "
"källkodstararkivet packas om. Regeln ska bara användas för paket med ett "
"enda uppströms tararkiv."

#. type: =item
#: ../scripts/debian-watch-4.pod:268
msgid "B<mode=>I<mode>"
msgstr "B<mode=>I<mode>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:282
msgid ""
"This mode accesses the upstream git archive directly with the B<git> command"
" and packs the source tree with the specified tag via I<matching-pattern> "
"into I<spkg-version>B<.tar.xz>."
msgstr ""
"Detta läge använder kommandot B<git> för direkt åtkomst till "
"uppströmsgitarkivet och packar källträdet med den tagg som anges av "
"I<matching-pattern> till I<spkg-version>B<.tar.xz>."

#. type: textblock
#: ../scripts/debian-watch-4.pod:286
msgid ""
"If the upstream publishes the released tarball via its web interface, please"
" use it instead of using this mode. This mode is the last resort method."
msgstr ""
"Om uppströmsprojektet publicerar utgåvans tararkiv via sitt webbgränssnitt "
"ska du använda det i stället. Detta läge är en sista utväg."

#. type: textblock
#: ../scripts/debian-watch-4.pod:289
msgid ""
"For git mode, I<matching-pattern> specifies the full string matching pattern"
" for tags instead of hrefs. If I<matching-pattern> is set to "
"B<refs/tags/>I<tag-matching-pattern>, B<uscan> downloads source from the "
"B<refs/tags/>I<matched-tag> of the git repository.  The upstream version is "
"extracted from concatenating the matched parts in B<(> ... B<)> with B<.> ."
"  See L<WATCH FILE EXAMPLES>."
msgstr ""
"För gitläget anger I<matching-pattern> det fullständiga "
"strängmatchningsmönstret för taggar i stället för href:er. Om I<matching-"
"pattern> är B<refs/tags/>I<tag-matching-pattern> hämtar B<uscan> källkoden "
"från B<refs/tags/>I<matched-tag> i gitarkivet. Uppströmsversionen fås genom "
"att de matchade delarna mellan B<(> ... B<)> sammanfogas med B<.>. Se "
"L<WATCH FILE EXAMPLES>."

#. type: textblock
#: ../scripts/debian-watch-4.pod:296
msgid ""
"If I<matching-pattern> is set to B<HEAD>, B<uscan> downloads source from the"
" B<HEAD> of the git repository and the pertinent I<version> is automatically"
" generated with the date and hash of the B<HEAD> of the git repository."
msgstr ""
"Om I<matching-pattern> är inställt på B<HEAD>, hämtar B<uscan> källkoden "
"från B<HEAD> i git-arkivet och den relevanta I<version> genereras "
"automatiskt med datum och hash för B<HEAD> i git-arkivet."

#. type: textblock
#: ../scripts/debian-watch-4.pod:300
msgid ""
"If I<matching-pattern> is set to B<heads/>I<branch>, B<uscan> downloads "
"source from the named I<branch> of the git repository."
msgstr ""
"Om I<matching-pattern> är inställt på B<heads/>I<branch>, B<uscan> laddar "
"ner källkoden från den namngivna I<branch> i git-arkivet."

#. type: textblock
#: ../scripts/debian-watch-4.pod:303
msgid ""
"The local repository is created temporarily as either a bare git repository "
"or a cloned git repository if B<gitmodules> is specified. The tarball is "
"then generated from the temporary git repository and saved in the "
"destination directory."
msgstr ""
"Det lokala arkivet skapas tillfälligt antingen som ett naket gitarkiv eller "
"som ett klonat gitarkiv om B<gitmodules> anges. Tararkivet genereras sedan "
"från det tillfälliga gitarkivet och sparas i målkatalogen."

#. type: textblock
#: ../scripts/debian-watch-4.pod:311
msgid ""
"If the current directory is a git repository and the searched repository is "
"listed among the registered \"remotes\", then uscan will use it instead of "
"cloning separately.  The only local change is that uscan will run a "
"\"fetch\" command to refresh the repository."
msgstr ""
"Om den aktuella katalogen är ett gitarkiv och det sökta arkivet finns bland "
"de registrerade fjärrarna använder uscan det i stället för att klona "
"separat. Den enda lokala ändringen är att uscan kör kommandot \"fetch\" för "
"att uppdatera arkivet."

#. type: =item
#: ../scripts/debian-watch-4.pod:336
msgid "B<pretty=>I<rule>"
msgstr "B<pretty=>I<rule>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:338
msgid ""
"Set the upstream version string to an arbitrary format as an optional "
"B<opts> argument when the I<matching-pattern> is B<HEAD> or "
"B<heads/>I<branch> for B<git> mode. For the exact syntax, see the B<git-log>"
" manpage under B<tformat>.  The default is B<pretty=0.0~git%cd.%h>. No "
"version mangling rule is necessary for this case."
msgstr ""
"Ange uppströmsversionssträngen i ett valfritt format som ett valfritt "
"B<opts>-argument när I<matching-pattern> är B<HEAD> eller B<heads/>I<branch>"
" i B<git>-läge. Se manualsidan för B<git-log> under B<tformat> för exakt "
"syntax. Standardvärdet är B<pretty=0.0~git%cd.%h>. Ingen regel för "
"versionsomskrivning behövs i detta fall."

#. type: textblock
#: ../scripts/debian-watch-4.pod:344
msgid ""
"When B<pretty=describe> is used, the upstream version string is the output "
"of the \"B<git describe --tags | sed s/-/./g>\" command instead. For "
"example, if the commit is the B<5>-th after the last tag B<v2.17.12> and its"
" short hash is B<ged992511>, then the string is B<v2.17.12.5.ged992511>. For"
" this case, it is recommended to add "
"B<filenamemangle=s/^(@PACKAGE@)-/$1-0.0~/> or "
"B<filenamemangle=s/^(@PACKAGE@-)v/$1/> to make the upstream version string "
"suitable for Debian. Please note that in order for B<pretty=describe> to "
"function well, upstream needs to avoid tagging with random alphabetic tags."
msgstr ""
"När B<pretty=describe> används är uppströmsversionssträngen i stället "
"resultatet av kommandot \"B<git describe --tags | sed s/-/./g>\". Om "
"incheckningen till exempel är den B<5>:e efter den senaste taggen "
"B<v2.17.12> och dess korta hash är B<ged992511>, blir strängen "
"B<v2.17.12.5.ged992511>. I detta fall rekommenderas "
"B<filenamemangle=s/^(@PACKAGE@)-/$1-0.0~/> eller "
"B<filenamemangle=s/^(@PACKAGE@-)v/$1/> för att göra "
"uppströmsversionssträngen lämplig för Debian. För att B<pretty=describe> ska"
" fungera väl måste uppströmsprojektet undvika slumpmässiga alfabetiska "
"taggar."

#. type: textblock
#: ../scripts/debian-watch-4.pod:353
msgid ""
"Using B<pretty=describe> also sets B<gitmode=full> to make a full local "
"clone of the repository automatically."
msgstr ""
"Om du använder B<pretty=describe> ställs även B<gitmode=full> in så att en "
"fullständig lokal klon av arkivet skapas automatiskt."

#. type: =item
#: ../scripts/debian-watch-4.pod:356
msgid "B<date=>I<rule>"
msgstr "B<date=>I<rule>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:358
msgid ""
"Set the date string used by the B<pretty> option to an arbitrary format as "
"an optional B<opts> argument when the I<matching-pattern> is B<HEAD> or "
"B<heads/>I<branch> for B<git> mode.  For the exact syntax, see the "
"B<strftime> manpage.  The default is B<date=%Y%m%d>."
msgstr ""
"Ange datumsträngen som alternativet B<pretty> använder i ett valfritt format"
" som ett valfritt B<opts>-argument när I<matching-pattern> är B<HEAD> eller "
"B<heads/>I<branch> i B<git>-läge. Se manualsidan för B<strftime> för exakt "
"syntax. Standardvärdet är B<date=%Y%m%d>."

#. type: =item
#: ../scripts/debian-watch-4.pod:363
msgid "B<gitexport=>I<mode>"
msgstr "B<gitexport=>I<mode>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:365
msgid ""
"Set the git archive export operation I<mode>. The default is "
"B<gitexport=default>.  Set this to B<gitexport=all> to include all files in "
"the .orig.tar archive, ignoring any I<export-ignore> git attributes defined "
"by the upstream. This option also applies to submodules, if B<gitmodules> is"
" specified."
msgstr ""
"Ange I<mode> för exporten av gitarkivet. Standardvärdet är "
"B<gitexport=default>. Ange B<gitexport=all> för att inkludera alla filer i "
".orig.tar-arkivet och ignorera git-attributet I<export-ignore> som "
"uppströmsprojektet har angett. Alternativet gäller också undermoduler om "
"B<gitmodules> anges."

#. type: =item
#: ../scripts/debian-watch-4.pod:372
msgid "B<gitmode=>I<mode>"
msgstr "B<gitmode=>I<mode>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:374
msgid ""
"Set the git clone operation I<mode>. The default is B<gitmode=shallow>.  For"
" some dumb git server, you may need to manually set B<gitmode=full> to force"
" full clone operation."
msgstr ""
"Ange I<mode> för gitkloningen. Standardvärdet är B<gitmode=shallow>. För "
"vissa enkla git-servrar kan du behöva ange B<gitmode=full> manuellt för att "
"tvinga fram en fullständig kloning."

#. type: textblock
#: ../scripts/debian-watch-4.pod:378
msgid ""
"If the current directory is a git repository and the searched repository is "
"listed among the registered \"remotes\", then uscan will use it instead of "
"cloning separately."
msgstr ""
"Om den aktuella katalogen är ett gitarkiv och det sökta arkivet finns bland "
"de registrerade fjärrarna använder uscan det i stället för att klona "
"separat."

#. type: =item
#: ../scripts/debian-watch-4.pod:382
msgid "B<gitmodules>[=I<modules>]"
msgstr "B<gitmodules>[=I<modules>]"

#. type: textblock
#: ../scripts/debian-watch-4.pod:384
msgid ""
"Clone one or more submodules after cloning the main git repository. By "
"default, uscan will clone all submodules linked to the git repository."
msgstr ""
"Klona en eller flera undermoduler efter att huvudgitarkivet har klonats. Som"
" standard klonar uscan alla undermoduler som är länkade till gitarkivet."

#. type: textblock
#: ../scripts/debian-watch-4.pod:387
msgid ""
"To clone selected submodules, use a semicolon-separated list. For example: "
"gitmodules=m4;doc/common."
msgstr ""
"Använd en semikolonseparerad lista för att klona utvalda undermoduler. Till "
"exempel: gitmodules=m4;doc/common."

#. type: =item
#: ../scripts/debian-watch-4.pod:390
msgid "B<pgpmode=>I<mode>"
msgstr "B<pgpmode=>I<mode>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:392
msgid "Set the OpenPGP signature verification I<mode>."
msgstr "Ställ in verifiering av OpenPGP-signaturer i I<mode>."

#. type: textblock
#: ../scripts/debian-watch-4.pod:398
msgid ""
"B<uscan> checks possible URLs for the signature file and autogenerates a "
"B<pgpsigurlmangle> rule to use it."
msgstr ""
"B<uscan> kontrollerar möjliga URL:er till signaturfilen och genererar "
"automatiskt en B<pgpsigurlmangle>-regel för att använda den."

#. type: textblock
#: ../scripts/debian-watch-4.pod:403
msgid ""
"Use B<pgpsigurlmangle=>I<rules> to generate the candidate upstream signature"
" file URL string from the upstream tarball URL. (default)"
msgstr ""
"Använd B<pgpsigurlmangle=>I<rules> för att skapa kandidat-URL-strängen till "
"uppströmsprojektets signaturfil från URL:en till uppströms tararkivet. "
"(standard)"

#. type: textblock
#: ../scripts/debian-watch-4.pod:406
msgid ""
"If the specified B<pgpsigurlmangle> is missing, B<uscan> checks possible "
"URLs for the signature file and suggests adding a B<pgpsigurlmangle> rule."
msgstr ""
"Om B<pgpsigurlmangle> inte anges kontrollerar B<uscan> möjliga URL:er till "
"signaturfilen och föreslår att en B<pgpsigurlmangle>-regel läggs till."

#. type: textblock
#: ../scripts/debian-watch-4.pod:411
msgid ""
"Use B<pgpsigurlmangle=>I<rules> to generate the candidate upstream signature"
" file URL string from the upstream tarball URL."
msgstr ""
"Använd B<pgpsigurlmangle=>I<rules> för att skapa kandidat-URL-strängen till "
"uppströmsprojektets signaturfil från URL:en till uppströms tararkivet."

#. type: textblock
#: ../scripts/debian-watch-4.pod:416
msgid ""
"Verify this downloaded tarball file with the signature file specified in the"
" next watch line.  The next watch line must be B<pgpmode=previous>.  "
"Otherwise, no verification occurs."
msgstr ""
"Verifiera det hämtade tararkivet med signaturfilen som anges på nästa "
"watchrad. Nästa watchrad måste vara B<pgpmode=previous>. Annars sker ingen "
"verifiering."

#. type: textblock
#: ../scripts/debian-watch-4.pod:422
msgid ""
"Verify the downloaded tarball file specified in the previous watch line with"
" this signature file.  The previous watch line must be B<pgpmode=next>."
msgstr ""
"Verifiera tararkivet som hämtades på föregående watchrad med denna "
"signaturfil. Föregående watchrad måste vara B<pgpmode=next>."

#. type: textblock
#: ../scripts/debian-watch-4.pod:436
msgid "No signature available. (No warning.)"
msgstr "Ingen signatur tillgänglig. (Ingen varning.)"

#. type: =item
#: ../scripts/debian-watch-4.pod:440
msgid "B<searchmode=>I<mode>"
msgstr "B<searchmode=>I<mode>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:442
msgid "Set the parsing search mode."
msgstr "Ange tolkningssökläget."

#. type: verbatim
#: ../scripts/debian-watch-4.pod:454
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"searchmode=plain\" \\\n"
"   https://registry.npmjs.org/aes-js \\\n"
"   https://registry.npmjs.org/aes-js/-/aes-js-(\\d[\\d\\.]*)@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"searchmode=plain\" \\\n"
"   https://registry.npmjs.org/aes-js \\\n"
"   https://registry.npmjs.org/aes-js/-/aes-js-(\\d[\\d\\.]*)@ARCHIVE_EXT@\n"
"\n"

#. type: =item
#: ../scripts/debian-watch-4.pod:461
msgid "B<decompress>"
msgstr "B<decompress>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:463
msgid ""
"Decompress compressed archive before the OpenPGP signature verification."
msgstr "Packa upp komprimerade arkiv innan OpenPGP-signaturverifieringen."

#. type: =item
#: ../scripts/debian-watch-4.pod:465
msgid "B<bare>"
msgstr "B<bare>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:467
msgid ""
"Disable all site specific special case code such as URL redirector uses and "
"page content alterations. (persistent)"
msgstr ""
"Inaktivera all webbplatsspecifik specialkod, såsom URL-omdirigeringar och "
"ändringar av sidinnehållet. (beständigt)"

#. type: =item
#: ../scripts/debian-watch-4.pod:470
msgid "B<user-agent=>I<user-agent-string>"
msgstr "B<user-agent=>I<user-agent-string>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:475
msgid ""
"B<user-agent> option should be specified by itself in the watch line without"
" I<URL>, to allow using semicolons and commas in it."
msgstr ""
"Alternativet B<user-agent> bör anges för sig på watchraden utan I<URL> så "
"att semikolon och kommatecken kan användas i den."

#. type: =item
#: ../scripts/debian-watch-4.pod:478
msgid "B<unzipopt=>I<options>"
msgstr "B<unzipopt=>I<options>"

#. type: =item
#: ../scripts/debian-watch-4.pod:483
msgid "B<dversionmangle=>I<rules>"
msgstr "B<dversionmangle=>I<rules>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:489
msgid ""
"You can also use B<dversionmangle=auto>, this is exactly the same than "
"B<dversionmangle=s/@DEB_EXT@//>"
msgstr ""
"Du kan också använda B<dversionmangle=auto>, vilket är exakt samma sak som "
"B<dversionmangle=s/@DEB_EXT@//>"

#. type: =item
#: ../scripts/debian-watch-4.pod:492
msgid "B<dirversionmangle=>I<rules>"
msgstr "B<dirversionmangle=>I<rules>"

#. type: =item
#: ../scripts/debian-watch-4.pod:500
msgid "B<pagemangle=>I<rules>"
msgstr "B<pagemangle=>I<rules>"

#. type: =item
#: ../scripts/debian-watch-4.pod:508
msgid "B<uversionmangle=>I<rules>"
msgstr "B<uversionmangle=>I<rules>"

#. type: =item
#: ../scripts/debian-watch-4.pod:516
msgid "B<versionmangle=>I<rules>"
msgstr "B<versionmangle=>I<rules>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:518
msgid ""
"Syntactic shorthand for B<uversionmangle=>I<rules>B<, "
"dversionmangle=>I<rules>"
msgstr ""
"Syntaktisk förkortning för B<uversionmangle=>I<rules>B<, "
"dversionmangle=>I<rules>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:522
msgid ""
"Convert the selected upstream tarball href string from the percent-encoded "
"hexadecimal string to the decoded normal URL string for obfuscated web "
"sites.  Only B<percent-encoding> is available and it is decoded with "
"B<s/%([A-Fa-f\\d]{2})/chr hex $1/eg>."
msgstr ""
"Konvertera href-strängen för det valda uppströms tararkivet från "
"procentkodad hexadecimal form till avkodad vanlig URL-sträng för fördunklade"
" webbplatser. Endast B<percent-encoding> är tillgänglig och avkodas med "
"B<s/%([A-Fa-f\\d]{2})/chr hex $1/eg>."

#. type: =item
#: ../scripts/debian-watch-4.pod:527
msgid "B<downloadurlmangle=>I<rules>"
msgstr "B<downloadurlmangle=>I<rules>"

#. type: =item
#: ../scripts/debian-watch-4.pod:532
msgid "B<filenamemangle=>I<rules>"
msgstr "B<filenamemangle=>I<rules>"

#. type: =item
#: ../scripts/debian-watch-4.pod:544
msgid "B<pgpsigurlmangle=>I<rules>"
msgstr "B<pgpsigurlmangle=>I<rules>"

#. type: =item
#: ../scripts/debian-watch-4.pod:549
msgid "B<oversionmangle=>I<rules>"
msgstr "B<oversionmangle=>I<rules>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:607
msgid ""
"If the B<dversionmangle> rule exists, the last upstream version is further "
"normalized by applying this rule to it.  For example, if the last upstream "
"version is B<2.03+dfsg> indicating the source tarball is repackaged, the "
"suffix B<+dfsg> is removed by the string substitution B<s/\\+dfsg\\d*$//> to"
" make the (dversionmangled) last upstream version B<2.03> and it is compared"
" to the candidate upstream tarball versions such as B<2.03>, B<2.04>, ... "
"found in the remote site.  Thus, set this rule as:"
msgstr ""
"Om regeln B<dversionmangle> finns normaliseras den senaste "
"uppströmsversionen ytterligare genom att regeln tillämpas på den. Om den "
"senaste uppströmsversionen till exempel är B<2.03+dfsg>, vilket visar att "
"källkodstararkivet har packats om, tas suffixet B<+dfsg> bort med "
"strängersättningen B<s/\\+dfsg\\d*$//>. Den (dversionmangle-omskrivna) "
"senaste uppströmsversionen blir då B<2.03> och jämförs med "
"kandidatversionerna för uppströms tararkiv på fjärrplatsen, till exempel "
"B<2.03>, B<2.04>, ... Ange därför regeln så här:"

#. type: =item
#: ../scripts/debian-watch-4.pod:617
msgid "* B<opts=\"dversionmangle=s/\\+dfsg\\d*$//\">"
msgstr "* B<opts=\"dversionmangle=s/\\+dfsg\\d*$//\">"

#. type: textblock
#: ../scripts/debian-watch-4.pod:621
msgid ""
"B<uscan> downloads a web page from B<http://>I<URL> specified in "
"F<debian/watch>."
msgstr ""
"B<uscan> hämtar en webbsida från B<http://>I<URL> som anges i "
"F<debian/watch>."

#. type: =item
#: ../scripts/debian-watch-4.pod:626
msgid ""
"* If the directory name part of I<URL> has no parentheses, B<(> and B<)>, it"
" is taken as verbatim."
msgstr ""
"* Om katalognamnsdelen i I<URL> saknar parenteser, B<(> och B<)>, tas den "
"ordagrant."

#. type: =item
#: ../scripts/debian-watch-4.pod:629
msgid ""
"* If the directory name part of I<URL> has parentheses, B<(> and B<)>, then "
"B<uscan> recursively searches all possible directories to find a page for "
"the newest version.  If the B<dirversionmangle> rule exists, the generated "
"sorting index is used to find the newest version.  If a specific version is "
"specified for the download, the matching version string has priority over "
"the newest version."
msgstr ""
"* Om katalognamnet i I<URL> innehåller parenteser, B<(> och B<)>, söker "
"B<uscan> rekursivt igenom alla möjliga kataloger för att hitta en sida för "
"den senaste versionen.  Om regeln B<dirversionmangle> finns, används det "
"genererade sorteringsindexet för att hitta den senaste versionen.  Om en "
"specifik version anges för nedladdningen, har den matchande versionssträngen"
" prioritet framför den senaste versionen."

#. type: textblock
#: ../scripts/debian-watch-4.pod:638
msgid "For example, this B<http://>I<URL> may be specified as:"
msgstr "Till exempel kan denna B<http://>I<URL> anges så här:"

#. type: =item
#: ../scripts/debian-watch-4.pod:642
msgid "* B<http://www.example.org/@ANY_VERSION@/>"
msgstr "* B<http://www.example.org/@ANY_VERSION@/>"

#. type: textblock
#: ../scripts/debian-watch-4.pod:649
msgid ""
"If the B<pagemangle> rule exists, the whole downloaded web page as a string "
"is normalized by applying this rule to it.  This is very powerful tool and "
"needs to be used with caution.  If other mangling rules can be used to "
"address your objective, do not use this rule."
msgstr ""
"Om regeln B<pagemangle> finns normaliseras hela den hämtade webbsidan som en"
" sträng genom att regeln tillämpas på den. Det är ett mycket kraftfullt "
"verktyg och måste användas med försiktighet. Använd inte denna regel om "
"andra omskrivningsregler kan uppnå målet."

#. type: textblock
#: ../scripts/debian-watch-4.pod:693
msgid ""
"If the B<uversionmangle> rule exists, the candidate upstream versions are "
"normalized by applying this rule to them. (This rule may be useful if the "
"upstream version scheme doesn't sort correctly to identify the newest "
"version.)"
msgstr ""
"Om regeln B<uversionmangle> finns normaliseras kandidatversionerna uppströms"
" genom att regeln tillämpas på dem. (Regeln kan vara användbar om "
"uppströmsprojektets versionsschema inte sorterar korrekt för att identifiera"
" den senaste versionen.)"

#. type: textblock
#: ../scripts/debian-watch-4.pod:697
msgid ""
"The upstream tarball href corresponding to the newest (uversionmangled)  "
"candidate upstream version newer than the (dversionmangled) last upstream "
"version is selected."
msgstr ""
"Href:en för uppströms tararkivet som motsvarar den senaste kandidatversionen"
" uppströms, efter uversionmangle och nyare än den senaste uppströmsversionen"
" efter dversionmangle, väljs."

#. type: textblock
#: ../scripts/debian-watch-4.pod:711
msgid ""
"If the B<downloadurlmangle> rule exists, the selected upstream tarball href "
"is normalized by applying this rule to it. (This is useful for some sites "
"with the obfuscated download URL.)"
msgstr ""
"Om regeln B<downloadurlmangle> finns normaliseras href:en för det valda "
"uppströms tararkivet genom att regeln tillämpas på den. (Detta är användbart"
" för vissa webbplatser med fördunklad nedladdnings-URL.)"

#. type: textblock
#: ../scripts/debian-watch-4.pod:715
msgid ""
"If the B<filenamemangle> rule exists, the downloaded tarball filename is "
"generated by applying this rule to the selected href if I<matching-pattern> "
"can extract the latest upstream version I<< <uversion> >> from the selected "
"href string. Otherwise, generate the upstream tarball filename from its full"
" URL string and set the missing I<< <uversion> >> from the generated "
"upstream tarball filename."
msgstr ""
"Om regeln B<filenamemangle> finns skapas filnamnet för det hämtade "
"tararkivet genom att regeln tillämpas på den valda href:en, om I<matching-"
"pattern> kan extrahera den senaste uppströmsversionen I<< <uversion> >> ur "
"den valda href-strängen. Annars skapas filnamnet för uppströms tararkivet "
"från hela URL-strängen, och den saknade I<< <uversion> >> anges utifrån det "
"skapade filnamnet."

#. type: textblock
#: ../scripts/debian-watch-4.pod:722
msgid ""
"Without the B<filenamemangle> rule, the default upstream tarball filename is"
" generated by taking the last component of the URL and removing everything "
"after any '?' or '#'."
msgstr ""
"Utan regeln B<filenamemangle> skapas standardfilnamnet för uppströms "
"tararkivet genom att den sista delen av URL:en tas och allt efter ett "
"eventuellt B<?> eller B<#> tas bort."

#. type: textblock
#: ../scripts/debian-watch-4.pod:738
msgid ""
"If the B<pgpsigurlmangle> rule exists, the upstream signature file URL is "
"generated by applying this rule to the (downloadurlmangled) selected "
"upstream tarball href and the signature file is tried to be downloaded from "
"it."
msgstr ""
"Om regeln B<pgpsigurlmangle> finns skapas URL:en till uppströmsprojektets "
"signaturfil genom att regeln tillämpas på den valda href:en för uppströms "
"tararkivet efter downloadurlmangle, och signaturfilen försöker hämtas från "
"den."

#. type: textblock
#: ../scripts/debian-watch-4.pod:742
msgid ""
"If the B<pgpsigurlmangle> rule doesn't exist, B<uscan> warns user if the "
"matching upstream signature file is available from the same URL with their "
"filename being suffixed by the 5 common suffix B<asc>, B<sig>, B<sign>, "
"B<pgp> and B<gpg>. (You can avoid this warning by setting B<pgpmode=none>.)"
msgstr ""
"Om regeln B<pgpsigurlmangle> inte finns, varnar B<uscan> användaren om den "
"matchande uppströms signaturfilen är tillgänglig från samma URL med "
"filnamnet försett med något av de fem vanliga suffixen B<asc>, B<sig>, "
"B<sign>, B<pgp> och B<gpg>. (Du kan undvika denna varning genom att ställa "
"in B<pgpmode=none>.)"

#. type: textblock
#: ../scripts/debian-watch-4.pod:753
msgid ""
"If the B<oversionmangle> rule exists, the source tarball version I<oversion>"
" is generated from the downloaded upstream version I<uversion> by applying "
"this rule. This rule is useful to add suffix such as B<+dfsg> to the version"
" of all the source packages of the MUT package for which the repacksuffix "
"mechanism doesn't work."
msgstr ""
"Om regeln B<oversionmangle> finns skapas källkodstararkivets version "
"I<oversion> från den hämtade uppströmsversionen I<uversion> genom att regeln"
" tillämpas. Regeln är användbar för att lägga till suffix som B<+dfsg> till "
"versionen av alla källkodspaket i ett MUT-paket där mekanismen repacksuffix "
"inte fungerar."

#. type: textblock
#: ../scripts/debian-watch-4.pod:777
msgid ""
"Usually, there is no need to set up B<opts=\"dversionmangle=> I<...> B<\"> "
"for this case."
msgstr ""
"Vanligtvis behöver man inte ställa in B<opts=\"dversionmangle=> I<...> B<\">"
" för detta fall."

#. type: textblock
#: ../scripts/debian-watch-4.pod:782
msgid ""
"B<mk-origtargz> checks the filename glob of the B<Files-Excluded> stanza in "
"the first section of F<debian/copyright>, removes matching files to create a"
" repacked upstream tarball.  Normally, the repacked upstream tarball is "
"renamed with I<suffix> to I<< ../bar_<oversion><suffix>.orig.tar.gz >> using"
" the B<repacksuffix> option for the single upstream package.  Here I<< "
"<oversion> >> is updated to be I<< <oversion><suffix> >>."
msgstr ""
"B<mk-origtargz> kontrollerar filnamnsgloben i stycket B<Files-Excluded> i "
"det första avsnittet av F<debian/copyright> och tar bort matchande filer för"
" att skapa ett ompackat uppströms tararkiv. Normalt får det ompackade "
"uppströms tararkivet namnet I<< ../bar_<oversion><suffix>.orig.tar.gz >> med"
" I<suffix> genom alternativet B<repacksuffix> för paket med ett enda "
"uppströms tararkiv. Här uppdateras I<< <oversion> >> till I<< "
"<oversion><suffix> >>."

#. type: textblock
#: ../scripts/debian-watch-4.pod:792
msgid ""
"So the combined options are set as B<opts=\"dversionmangle=s/\\+dfsg\\d*$// "
",repacksuffix=+dfsg\">, instead."
msgstr ""
"De kombinerade alternativen anges i stället som "
"B<opts=\"dversionmangle=s/\\+dfsg\\d*$// ,repacksuffix=+dfsg\">."

#. type: textblock
#: ../scripts/debian-watch-4.pod:805
msgid ""
"B<uscan> normally invokes \"B<uupdate> B<--find --upstream-version> "
"I<oversion> \" for the version=4 watch file."
msgstr ""
"B<uscan> anropar normalt \"B<uupdate> B<--find --upstream-version> "
"I<oversion> \" för watchfilen version=4."

#. type: verbatim
#: ../scripts/debian-watch-4.pod:835
#, no-wrap
msgid ""
"  version=4\n"
"  http://example.com/~user/release/@PACKAGE@.html \\\n"
"      files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  http://example.com/~user/release/@PACKAGE@.html \\\n"
"      files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:839
#, no-wrap
msgid ""
"Or without using the substitution strings (not recommended):\n"
"  http://example.com/~user/release/foo.html \\\n"
"      files/foo-([\\d\\.]+)\\.tar\\.gz\n"
"\n"
msgstr ""
"Eller utan ersättningssträngarna (rekommenderas inte):\n"
"  http://example.com/~user/release/foo.html \\\n"
"      files/foo-([\\d\\.]+)\\.tar\\.gz\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:843
#, no-wrap
msgid ""
"  version=4\n"
"\n"
msgstr ""
"  version=4\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch-4.pod:848
msgid "HTTP site (pgpsigurlmangle)"
msgstr "HTTP-webbplats (pgpsigurlmangle)"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:853
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.asc%\" http://example.com/release/@PACKAGE@.html \\\n"
"      files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.asc%\" http://example.com/release/@PACKAGE@.html \\\n"
"      files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:865
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%@ARCHIVE_EXT@$%.asc%,decompress\" \\\n"
"      http://example.com/release/@PACKAGE@.html \\\n"
"      files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%@ARCHIVE_EXT@$%.asc%,decompress\" \\\n"
"      http://example.com/release/@PACKAGE@.html \\\n"
"      files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch-4.pod:875
msgid "HTTP site (pgpmode=next/previous)"
msgstr "HTTP-webbplats (pgpmode=next/previous)"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:880
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpmode=next\" http://example.com/release/@PACKAGE@.html \\\n"
"      files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@ debian\n"
"  opts=\"pgpmode=previous\" http://example.com/release/@PACKAGE@.html \\\n"
"      files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@SIGNATURE_EXT@ previous\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpmode=next\" http://example.com/release/@PACKAGE@.html \\\n"
"      files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@ debian\n"
"  opts=\"pgpmode=previous\" http://example.com/release/@PACKAGE@.html \\\n"
"      files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@SIGNATURE_EXT@ previous\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:898
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpmode=next\" http://example.com/DL/ \\\n"
"      files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@ debian\n"
"  opts=\"pgpmode=previous\" http://example.com/DL/ \\\n"
"      files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@SIGNATURE_EXT@ \\\n"
"      previous\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpmode=next\" http://example.com/DL/ \\\n"
"      files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@ debian\n"
"  opts=\"pgpmode=previous\" http://example.com/DL/ \\\n"
"      files/(?:\\d+)/@PACKAGE@@ANY_VERSION@@SIGNATURE_EXT@ \\\n"
"      previous\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:909
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%\" \\\n"
"      http://example.com/release/foo.html \\\n"
"      files/foo-@ANY_VERSION@@ARCHIVE_EXT@ debian\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%, component=bar\" \\\n"
"      http://example.com/release/foo.html \\\n"
"      files/foobar-@ANY_VERSION@@ARCHIVE_EXT@ same\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%, component=baz\" \\\n"
"      http://example.com/release/foo.html \\\n"
"      files/foobaz-@ANY_VERSION@@ARCHIVE_EXT@ same\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%\" \\\n"
"      http://example.com/release/foo.html \\\n"
"      files/foo-@ANY_VERSION@@ARCHIVE_EXT@ debian\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%, component=bar\" \\\n"
"      http://example.com/release/foo.html \\\n"
"      files/foobar-@ANY_VERSION@@ARCHIVE_EXT@ same\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%, component=baz\" \\\n"
"      http://example.com/release/foo.html \\\n"
"      files/foobaz-@ANY_VERSION@@ARCHIVE_EXT@ same\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:933
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%, dirversionmangle=s/-PRE/~pre/;s/-RC/~rc/\" \\\n"
"      http://tmrc.mit.edu/mirror/twisted/Twisted/@ANY_VERSION@/ \\\n"
"      Twisted-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%, dirversionmangle=s/-PRE/~pre/;s/-RC/~rc/\" \\\n"
"      http://tmrc.mit.edu/mirror/twisted/Twisted/@ANY_VERSION@/ \\\n"
"      Twisted-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch-4.pod:942
msgid ""
"Here, B<dirversionmangle> option is used to normalize the sorting order of "
"the directory names."
msgstr ""
"Här används alternativet B<dirversionmangle> för att normalisera "
"sorteringsordningen för katalognamnen."

#. type: verbatim
#: ../scripts/debian-watch-4.pod:950
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%\" \\\n"
"      http://www.cpan.org/modules/by-module/Text/ \\\n"
"      Text-CSV_XS-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%\" \\\n"
"      http://www.cpan.org/modules/by-module/Text/ \\\n"
"      Text-CSV_XS-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:958
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%\" \\\n"
"      http://www.cpan.org/modules/by-module/Text/Text-CSV_XS-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%\" \\\n"
"      http://www.cpan.org/modules/by-module/Text/Text-CSV_XS-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch-4.pod:962
msgid ""
"In version=4, initial white spaces are dropped.  Thus, this alternative "
"shorthand form can also be written as:"
msgstr ""
"I version=4 tas inledande blanktecken bort. Den alternativa kortformen kan "
"därför också skrivas så här:"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:965
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%\" \\\n"
"      http://www.cpan.org/modules/by-module/Text/\\\n"
"      Text-CSV_XS-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pgpsigurlmangle=s%$%.sig%\" \\\n"
"      http://www.cpan.org/modules/by-module/Text/\\\n"
"      Text-CSV_XS-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch-4.pod:970
msgid ""
"Please note the subtle difference of a space before the tailing B<\\> "
"between the first and the last examples."
msgstr ""
"Observera den subtila skillnaden med ett mellanslag före det avslutande "
"B<\\> mellan det första och det sista exemplet."

#. type: verbatim
#: ../scripts/debian-watch-4.pod:978
#, no-wrap
msgid ""
"  version=4\n"
"  http://www.site.com/pub/foobar/foobar_v(\\d+)_(\\d+)@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  http://www.site.com/pub/foobar/foobar_v(\\d+)_(\\d+)@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:986
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"dversionmangle=s/\\+dfsg\\d*$//,repacksuffix=+dfsg\" \\\n"
"  http://some.site.org/some/path/foobar-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"dversionmangle=s/\\+dfsg\\d*$//,repacksuffix=+dfsg\" \\\n"
"  http://some.site.org/some/path/foobar-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch-4.pod:992
msgid "HTTP site (filenamemangle)"
msgstr "HTTP-webbplats (filenamemangle)"

#. type: textblock
#: ../scripts/debian-watch-4.pod:997
msgid ""
"If this does not fit to you, use B<filenamemangle>.  For example, F<< <A "
"href=\"http://foo.bar.org/dl/?path=&dl=foo-0.1.1.tar.gz\"> >> could be "
"handled as:"
msgstr ""
"Om detta inte passar, använd B<filenamemangle>. Till exempel kan F<< <A "
"href=\"http://foo.bar.org/dl/?path=&dl=foo-0.1.1.tar.gz\"> >> hanteras så "
"här:"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1001
#, no-wrap
msgid ""
"  version=4\n"
"  opts=filenamemangle=s/.*=(.*)/$1/ \\\n"
"  http://foo.bar.org/dl/\\?path=&dl=foo-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=filenamemangle=s/.*=(.*)/$1/ \\\n"
"  http://foo.bar.org/dl/\\?path=&dl=foo-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1008
#, no-wrap
msgid ""
"  version=4\n"
"  opts=filenamemangle=s/.*=(.*)/foo-$1\\.tar\\.gz/ \\\n"
"  http://foo.bar.org/dl/\\?path=&dl_version=@ANY_VERSION@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=filenamemangle=s/.*=(.*)/foo-$1\\.tar\\.gz/ \\\n"
"  http://foo.bar.org/dl/\\?path=&dl_version=@ANY_VERSION@\n"
"\n"

#. type: textblock
#: ../scripts/debian-watch-4.pod:1012
msgid ""
"If the href string has no version using <I>matching-pattern>, the version "
"can be obtained from the full URL using B<filenamemangle>."
msgstr ""
"Om href-strängen saknar en version enligt <I>matching-pattern> kan versionen"
" hämtas ur den fullständiga URL:en med B<filenamemangle>."

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1015
#, no-wrap
msgid ""
"  version=4\n"
"  opts=filenamemangle=s&.*/dl/(.*)/foo\\.tar\\.gz&foo-$1\\.tar\\.gz& \\\n"
"  http://foo.bar.org/dl/@ANY_VERSION@/ foo.tar.gz\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=filenamemangle=s&.*/dl/(.*)/foo\\.tar\\.gz&foo-$1\\.tar\\.gz& \\\n"
"  http://foo.bar.org/dl/@ANY_VERSION@/ foo.tar.gz\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch-4.pod:1019
msgid "HTTP site (downloadurlmangle)"
msgstr "HTTP-webbplats (downloadurlmangle)"

#. type: textblock
#: ../scripts/debian-watch-4.pod:1021
msgid ""
"The option B<downloadurlmangle> can be used to mangle the URL of the file to"
" download.  This can only be used with B<http://> URLs.  This may be "
"necessary if the link given on the web page needs to be transformed in some "
"way into one which will work automatically, for example:"
msgstr ""
"Alternativet B<downloadurlmangle> kan användas för att skriva om URL:en till"
" filen som ska hämtas. Det kan bara användas med B<http://>-URL:er. Det kan "
"behövas om länken på webbsidan måste omvandlas till en länk som fungerar "
"automatiskt, till exempel:"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1026
#, no-wrap
msgid ""
"  version=4\n"
"  opts=downloadurlmangle=s/prdownload/download/ \\\n"
"  http://developer.berlios.de/project/showfiles.php?group_id=2051 \\\n"
"  http://prdownload.berlios.de/softdevice/vdr-softdevice-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=downloadurlmangle=s/prdownload/download/ \\\n"
"  http://developer.berlios.de/project/showfiles.php?group_id=2051 \\\n"
"  http://prdownload.berlios.de/softdevice/vdr-softdevice-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch-4.pod:1031
msgid "HTTP site (oversionmangle, MUT)"
msgstr "HTTP-webbplats (oversionmangle, MUT)"

#. type: textblock
#: ../scripts/debian-watch-4.pod:1033
msgid ""
"The option B<oversionmangle> can be used to mangle the version of the source"
" tarball (B<.orig.tar.gz> and B<.orig-bar.tar.gz>).  For example, B<+dfsg> "
"can be added to the upstream version as:"
msgstr ""
"Alternativet B<oversionmangle> kan användas för att skriva om versionen för "
"källkodstararkivet (B<.orig.tar.gz> och B<.orig-bar.tar.gz>). Till exempel "
"kan B<+dfsg> läggas till i uppströmsversionen så här:"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1037
#, no-wrap
msgid ""
"  version=4\n"
"  opts=oversionmangle=s/(.*)/$1+dfsg/ \\\n"
"  http://example.com/~user/release/foo.html \\\n"
"  files/foo-@ANY_VERSION@@ARCHIVE_EXT@ debian\n"
"  opts=\"component=bar\" \\\n"
"  http://example.com/~user/release/foo.html \\\n"
"  files/bar-@ANY_VERSION@@ARCHIVE_EXT@ same\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=oversionmangle=s/(.*)/$1+dfsg/ \\\n"
"  http://example.com/~user/release/foo.html \\\n"
"  files/foo-@ANY_VERSION@@ARCHIVE_EXT@ debian\n"
"  opts=\"component=bar\" \\\n"
"  http://example.com/~user/release/foo.html \\\n"
"  files/bar-@ANY_VERSION@@ARCHIVE_EXT@ same\n"
"\n"

#. type: =head2
#: ../scripts/debian-watch-4.pod:1047
msgid "HTTP site (pagemangle)"
msgstr "HTTP-webbplats (pagemangle)"

#. type: textblock
#: ../scripts/debian-watch-4.pod:1049
msgid ""
"The option B<pagemangle> can be used to mangle the downloaded web page "
"before applying other rules.  The non-standard web page without proper B<< "
"<a href=\" >> << ... >> B<< \"> >> entries can be converted.  For example, "
"if F<foo.html> uses B<< <a bogus=\" >> I<< ... >> B<< \"> >>, this can be "
"converted to the standard page format with:"
msgstr ""
"Alternativet B<pagemangle> kan användas för att skriva om den hämtade "
"webbsidan innan andra regler tillämpas. Den icke-standardiserade webbsidan "
"utan korrekta B<< <a href=\" >> << ... >> B<< \"> >>-element kan "
"konverteras. Om F<foo.html> till exempel använder B<< <a bogus=\" >> I<< ..."
" >> B<< \"> >> kan detta konverteras till standardformatet med:"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1055
#, no-wrap
msgid ""
"  version=4\n"
"  opts=pagemangle=\"s/<a\\s+bogus=/<a href=/g\" \\\n"
"  http://example.com/release/foo.html \\\n"
"  files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=pagemangle=\"s/<a\\s+bogus=/<a href=/g\" \\\n"
"  http://example.com/release/foo.html \\\n"
"  files/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1065
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"pagemangle=s%<Key>([^<]*)</Key>%<Key><a href=\"$1\">$1</a></Key>%g\" \\\n"
"  http://example.com/release/foo.html \\\n"
"  (?:.*)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"pagemangle=s%<Key>([^<]*)</Key>%<Key><a href=\"$1\">$1</a></Key>%g\" \\\n"
"  http://example.com/release/foo.html \\\n"
"  (?:.*)/@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1072
#, no-wrap
msgid ""
"  version=4\n"
"  ftp://ftp.tex.ac.uk/tex-archive/web/c_cpp/cweb/cweb-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  ftp://ftp.tex.ac.uk/tex-archive/web/c_cpp/cweb/cweb-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1077
#, no-wrap
msgid ""
"  version=4\n"
"  ftp://ftp.worldforge.org/pub/worldforge/libs/\\\n"
"  Atlas-C++/transitional/Atlas-C\\+\\+-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  ftp://ftp.worldforge.org/pub/worldforge/libs/\\\n"
"  Atlas-C++/transitional/Atlas-C\\+\\+-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"

#. type: verbatim
#: ../scripts/debian-watch-4.pod:1093
#, no-wrap
msgid ""
"  version=4\n"
"  opts=\"uversionmangle=s/^/0.0./\" \\\n"
"  ftp://ftp.ibiblio.org/pub/Linux/ALPHA/wine/\\\n"
"  development/Wine-@ANY_VERSION@@ARCHIVE_EXT@\n"
"\n"
msgstr ""
"  version=4\n"
"  opts=\"uversionmangle=s/^/0.0./\" \\\n"
"  ftp://ftp.ibiblio.org/pub/Linux/ALPHA/wine/\\\n"
"  development/Wine-@ANY_VERSION@@ARCHIVE_EXT@\n"
