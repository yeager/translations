#. type: =head3
#: ../scripts/salsa.pl:1204
msgid "Configuration file example"
msgstr "Exempel på konfigurationsfil"

#. type: textblock
#: ../scripts/salsa.pl:1206
msgid ""
"Example to use salsa with L<https://gitlab.ow2.org> (group \"lemonldap-"
"ng\"):"
msgstr ""
"Exempel på hur man använder salsa med L<https://gitlab.ow2.org> (grupp "
"\"lemonldap-ng\"):"

#. type: verbatim
#: ../scripts/salsa.pl:1208
#, no-wrap
msgid ""
"  SALSA_TOKEN=`cat ~/.ow2-gitlab-token`\n"
"  SALSA_API_URL=https://gitlab.ow2.org/api/v4\n"
"  SALSA_GIT_SERVER_URL=git@gitlab.ow2.org:\n"
"  SALSA_GROUP_ID=34\n"
"\n"
msgstr ""
"  SALSA_TOKEN=`cat ~/.ow2-gitlab-token`\n"
"  SALSA_API_URL=https://gitlab.ow2.org/api/v4\n"
"  SALSA_GIT_SERVER_URL=git@gitlab.ow2.org:\n"
"  SALSA_GROUP_ID=34\n"
"\n"

#. type: textblock
#: ../scripts/salsa.pl:1213
msgid "Then to use it, add something like this in your C<.bashrc> file:"
msgstr ""
"För att använda det, lägg till något liknande detta i din C<.bashrc>-fil:"

#. type: verbatim
#: ../scripts/salsa.pl:1215
#, no-wrap
msgid ""
"  alias llng_admin='salsa --conffile ~/.salsa-ow2.conf'\n"
"\n"
msgstr ""
"  alias llng_admin='salsa --conffile ~/.salsa-ow2.conf'\n"
"\n"

