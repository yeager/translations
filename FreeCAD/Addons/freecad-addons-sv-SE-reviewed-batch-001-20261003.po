msgid "Render"
msgstr "Rendera"

#. Crowdin string ID: 6706041
msgctxt ""
"MovieClapperboard['Note: \n"
"This version of FreeCAD seems unable to import cv2!\n"
"To create or play back a video, try a different version, like 1.0, \n"
"or use the images generated here in an external recording program.']"
msgid ""
"Note: \n"
"This version of FreeCAD seems unable to import cv2!\n"
"To create or play back a video, try a different version, like 1.0, \n"
"or use the images generated here in an external recording program."
msgstr ""
"Obs: Den här versionen av FreeCAD verkar inte kunna\n"
"importera cv2! För att skapa eller spela upp en video\n"
"kan du prova en annan version, exempelvis 1.0, eller\n"
"använda bilderna som skapas här i ett externt inspelningsprogram."

#. Crowdin string ID: 6706043
msgctxt "MovieClapperboard['Clapperboard']"
msgid "Clapperboard"
msgstr "Klappa"

#. Crowdin string ID: 6706047
msgctxt ""
"MovieClapperboard['Select at least one MovieCamera or MovieObject \n"
