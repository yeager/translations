#: (content/about/privacy_policy/contents+en.lr:privacy_policy.body)
#: https://www.torproject.org/about/privacy_policy/
msgid ""
"# Privacy Policy for Tor Browser for Desktop, Tor Browser for Android, and "
"Tor VPN"
msgstr ""
"# Integritetspolicy för Tor Browser för datorer, Tor Browser för Android och "
"Tor VPN"

#: (content/about/privacy_policy/contents+en.lr:privacy_policy.body)
