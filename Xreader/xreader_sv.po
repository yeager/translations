#: ../data/xreader.appdata.xml.in.h:1
msgid "A Document Viewer"
msgstr "En dokumentvisare"

#: ../data/xreader.appdata.xml.in.h:2
msgid ""
"<p> Xreader is a simple multi-page document viewer. It can display and print "
"PostScript (PS), Encapsulated PostScript (EPS), DJVU, DVI, XPS and Portable "
"Document Format (PDF) files, as well as comic book archive files. When "
"supported by the document, it also allows searching for text, copying text "
"to the clipboard, hypertext navigation and table-of-contents bookmarks. </p>"
msgstr ""
"<p>Xreader är en enkel dokumentvisare för flersidiga dokument. Den kan visa "
"och skriva ut PostScript-filer (PS), Encapsulated PostScript-filer (EPS), "
"DJVU-, DVI-, XPS- och Portable Document Format-filer (PDF) samt serietidningsarkiv. "
"När dokumentet har stöd för det går det även att söka efter och kopiera text, "
"navigera via hyperlänkar och använda innehållsförteckningens bokmärken.</p>"

