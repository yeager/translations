#: ../src/ui/tools/tool-data.cpp:50
msgid "Modify selected path points (nodes) directly."
msgstr "Ändra valda banpunkter (noder) direkt."

#: ../src/ui/tools/tool-data.cpp:51
msgid "Construct shapes with the interactive Boolean tool."
msgstr "Konstruera former med det interaktiva booleska verktyget."

#: ../src/ui/tools/tool-data.cpp:52
msgid ""
"<b>Drag</b> to create a rectangle. <b>Drag controls</b> to round corners and "
"resize. <b>Click</b> to select."
msgstr ""
"<b>Dra</b> för att skapa en rektangel. <b>Dra kontroller</b> för att runda "
"hörnen och ändra storlek. <b>Klicka</b> för att välja."

#: ../src/ui/tools/tool-data.cpp:53
msgid ""
"<b>Drag</b> to create an ellipse. <b>Drag controls</b> to make an arc or "
"segment. <b>Click</b> to select."
msgstr ""
"<b>Dra</b> för att skapa en ellips. <b>Dra kontroller</b> för att göra en "
"båge eller segment. <b>Klicka</b> för att välja."

#: ../src/ui/tools/tool-data.cpp:54
msgid ""
"<b>Drag</b> to create a star. <b>Drag controls</b> to edit the star shape. "
"<b>Click</b> to select."
msgstr ""
"<b>Dra</b> för att skapa en stjärna. <b>Dra kontroller</b> för att redigera "
"stjärnformen. <b>Klicka</b> för att välja."

#: ../src/ui/tools/tool-data.cpp:55
msgid ""
"<b>Drag</b> to create a 3D box. <b>Drag controls</b> to resize in "
"perspective. <b>Click</b> to select (with <b>Ctrl+Alt</b> for single faces)."
msgstr ""
"<b>Dra</b> för att skapa en 3D-ruta. <b>Dra kontroller</b> för att ändra "
"storlek i perspektiv. <b>Klicka</b> för att välja (med <b>Ctrl+Alt</b> för "
"enskilda sidor)."

#: ../src/ui/tools/tool-data.cpp:56
msgid ""
"<b>Drag</b> to create a spiral. <b>Drag controls</b> to edit the spiral "
"shape. <b>Click</b> to select."
msgstr ""
"<b>Dra</b> för att skapa en spiral. <b>Dra kontroller</b> för att redigera "
"spiralformen. <b>Klicka</b> för att välja."

#: ../src/ui/tools/tool-data.cpp:57
msgid ""
"<b>Click</b> a shape to start editing its markers. <b>Drag controls</b> to "
"change orientation, scale, and position."
msgstr ""
"<b>Klicka</b> på en form för att börja redigera dess markörer. <b>Dra "
"kontroller</b> för att ändra orientering, skala och position."

#: ../src/ui/tools/tool-data.cpp:58
msgid ""
"<b>Drag</b> to create a freehand line. <b>Shift</b> appends to selected "
"path, <b>Alt</b> activates sketch mode."
msgstr ""
"<b>Dra</b> för att skapa en frihandslinje. <b>Skift</b> lägger till i den "
"valda banan, <b>Alt</b> aktiverar skissläge."

#: ../src/ui/tools/tool-data.cpp:59
msgid ""
"<b>Click</b> or <b>click and drag</b> to start a path; with <b>Shift</b> to "
"append to selected path. <b>Ctrl+click</b> to create single dots (straight "
"line modes only)."
msgstr ""
"<b>Klicka</b> eller <b>klicka och dra</b> för att starta en bana; med <b>"
"Skift</b> för att lägga till i vald bana. <b>Ctrl+klick</b> för att skapa "
"enstaka punkter (endast i lägen för raka linjer)."

#: ../src/ui/tools/tool-data.cpp:60
#
msgid ""
"<b>Drag</b> to draw a calligraphic stroke; with <b>%1</b> to track a guide "
"path. <b>Arrow keys</b> adjust width (left/right) and angle (up/down)."
msgstr ""
"<b>Dra</b> för att rita ett kalligrafiskt streck; med <b>%1</b> för att "
"kalkera en hjälpbana. <b>Piltangenter</b> justerar bredd (vänster/höger) och "
"vinkel (upp/ned)."

#: ../src/ui/tools/tool-data.cpp:63
msgid ""
"<b>Drag</b> or <b>double click</b> to create a gradient on selected objects, "
"<b>drag handles</b> to adjust gradients."
msgstr ""
"<b>Dra</b> eller <b>dubbelklicka</b> för att skapa en gradient på markerade "
"objekt, <b>dra handtag</b> för att justera gradienter."

#: ../src/ui/tools/tool-data.cpp:64
msgid ""
"<b>Drag</b> or <b>double click</b> to create a mesh on selected objects, <b>"
"drag handles</b> to adjust meshes."
msgstr ""
"<b>Dra</b> eller <b>dubbelklicka</b> för att skapa ett nät på valda objekt, "
"<b>dra handtag</b> för att justera nät."

#: ../src/ui/tools/tool-data.cpp:65
#
msgid ""
"<b>Click</b> or <b>drag around an area</b> to zoom in, <b>%1+Click</b> to "
"zoom out."
msgstr ""
"<b>Klicka</b> eller <b>dra runt ett område</b> för att zooma in, "
"<b>%1+klicka</b> för att zooma ut."

#: ../src/ui/tools/tool-data.cpp:67
msgid ""
"<b>Drag</b> to measure the dimensions of objects.  Press <b>Alt+C</b> to "
"copy the length to the clipboard."
msgstr ""
"<b>Dra</b> för att mäta dimensionerna på objekt. Tryck på <b>Alt+C</b> för "
"att kopiera längden till urklipp."

#: ../src/ui/tools/tool-data.cpp:68
#
msgid ""
"<b>Click</b> to set fill, <b>%1+Click</b> to set stroke; <b>drag</b> to "
"average color in area; with <b>%2</b> to pick inverse color; <b>Ctrl+C</b> "
"to copy the color under mouse to clipboard"
msgstr ""
"<b>Klicka</b> för att ställa in fyllning, <b>%1+klicka</b> för att ställa "
"in streck; <b>dra</b> för att beräkna medelfärgen i området; med <b>%2</b> "
"för att välja inverterad färg; <b>Ctrl+C</b> för att kopiera färgen under "
"muspekaren till urklipp"

#: ../src/ui/tools/tool-data.cpp:71
