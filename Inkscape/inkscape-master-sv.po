msgstr "Multiplicera t-range med 2*pi"

#: ../share/extensions/param_curves.inx:10
msgid "X-value of rectangle's left:"
msgstr "X-värde för rektangelns vänstra sida:"

#: ../share/extensions/param_curves.inx:11
