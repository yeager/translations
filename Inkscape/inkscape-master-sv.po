#: ../src/live_effects/effect.cpp:114
msgctxt "path effect"
msgid "Bend"
msgstr "Böj"

#: ../src/live_effects/effect.cpp:117
msgid "Bend an object along the curvature of another path"
msgstr "Böj ett objekt längs krökningen av en annan bana"

#: ../src/live_effects/effect.cpp:128
msgctxt "path effect"
msgid "Gears"
msgstr "Kuggar"

#: ../src/live_effects/effect.cpp:131
msgid "Create interlocking, configurable gears based on the nodes of a path"
msgstr ""
"Skapa sammankopplade, konformerbara kugghjul baserat på noderna på en bana"

#: ../src/live_effects/effect.cpp:142
msgctxt "path effect"
msgid "Pattern Along Path"
msgstr "Mönster längs bana"

#: ../src/live_effects/effect.cpp:145
msgid "Place one or more copies of another path along the path"
msgstr "Placera en eller flera kopior av en annan bana längs banan"

#: ../src/live_effects/effect.cpp:156
msgctxt "path effect"
msgid "Stitch Sub-Paths"
msgstr "Sy ihop underbanor"

#: ../src/live_effects/effect.cpp:159
msgid ""
"Draw perpendicular lines between subpaths of a path, like rungs of a ladder"
msgstr ""
"Rita vinkelräta linjer mellan underbanor på en bana, som stegpinnar på en "
"stege"

#: ../src/live_effects/effect.cpp:171
msgctxt "path effect"
msgid "VonKoch"
msgstr "VonKoch"

#: ../src/live_effects/effect.cpp:174
msgid "Create VonKoch fractal"
msgstr "Skapa VonKoch-fraktal"

#: ../src/live_effects/effect.cpp:185
msgctxt "path effect"
msgid "Knot"
msgstr "Knut"

#: ../src/live_effects/effect.cpp:188
msgid "Create gaps in self-intersections, as in Celtic knots"
msgstr "Skapa mellanrum i själv-snitt, som i keltiska knopar"

#: ../src/live_effects/effect.cpp:199
msgctxt "path effect"
msgid "Construct grid"
msgstr "Konstruera rutnät"

#: ../src/live_effects/effect.cpp:202
msgid "Create a (perspective) grid from a 3-node path"
msgstr "Skapa ett (perspektiv)rutnät från en 3-nodsbana"

#: ../src/live_effects/effect.cpp:213
msgctxt "path effect"
msgid "Spiro spline"
msgstr "Spiro-spline"

#: ../src/live_effects/effect.cpp:216
msgid ""
"Make the path curl like wire, using Spiro B-Splines. This effect is usually "
"used directly on the canvas with the Spiro mode of the drawing tools."
msgstr ""
"Få banan att krulla sig som en tråd med hjälp av Spiro B-Splines. Denna "
"effekt används vanligtvis direkt på duken med ritverktygens Spiro-läge."

#: ../src/live_effects/effect.cpp:227
msgctxt "path effect"
msgid "Envelope Deformation"
msgstr "Konvolutdeformation"

#: ../src/live_effects/effect.cpp:230
msgid "Adjust the shape of an object by transforming paths on its four sides"
msgstr ""
"Justera formen på ett objekt genom att transformera banor på dess fyra sidor"

#: ../src/live_effects/effect.cpp:241
msgctxt "path effect"
msgid "Interpolate Sub-Paths"
msgstr "Interpolera underbanor"

#: ../src/live_effects/effect.cpp:244
msgid ""
"Create a smooth transition between the two subpaths of a path, blending "
"their shapes together in steps."
msgstr ""
"Skapa en jämn övergång mellan de två delbanorna i en bana genom att stegvis "
"blanda ihop deras former."

#: ../src/live_effects/effect.cpp:255
msgctxt "path effect"
msgid "Hatches (rough)"
msgstr "Skraffel (grova)"

#: ../src/live_effects/effect.cpp:258
msgid "Fill the object with adjustable hatching"
msgstr "Fyll objektet med justerbar skraffering"

#: ../src/live_effects/effect.cpp:269
msgctxt "path effect"
msgid "Sketch"
msgstr "Skissa"

#: ../src/live_effects/effect.cpp:272
msgid "Draw multiple short strokes along the path, as in a pencil sketch"
msgstr "Rita flera korta streck längs banan, som i en blyertsskiss"

#: ../src/live_effects/effect.cpp:283
msgctxt "path effect"
msgid "Ruler"
msgstr "Linjal"

#.
#. File: ../src/live_effects/effect.cpp, line: 275
#: ../src/live_effects/effect.cpp:286
msgid ""
"Add ruler marks to the object in adjustable intervals, using the object's "
"stroke style."
msgstr ""
"Lägg till linjalmarkeringar på objektet i justerbara intervall med hjälp av "
"objektets streckstil."

#: ../src/live_effects/effect.cpp:298
msgctxt "path effect"
msgid "Power stroke"
msgstr "Kraftstreck"

#: ../src/live_effects/effect.cpp:301
msgid ""
"Create calligraphic strokes and control their variable width and curvature. "
"This effect can also be used directly on the canvas with a pressure "
"sensitive stylus and the Pencil tool."
msgstr ""
"Skapa kalligrafiska streck och kontrollera deras varierande bredd och "
"krökning. Den här effekten kan också användas direkt på duken med en "
"tryckkänslig stylus och blyertsverktyget."

#: ../src/live_effects/effect.cpp:312
msgctxt "path effect"
msgid "Clone original"
msgstr "Klona original"

#: ../src/live_effects/effect.cpp:315
msgid ""
"Let an object take on the shape, fill, stroke and/or other attributes of "
"another object."
msgstr ""
"Låt ett objekt ta formen, fyllningen, strecket och/eller andra attribut från "
"ett annat objekt."

#: ../src/live_effects/effect.cpp:327
msgctxt "path effect"
msgid "Simplify"
msgstr "Förenkla"

#.
#. File: ../src/live_effects/effect.cpp, line: 319
#: ../src/live_effects/effect.cpp:330
msgid ""
"Smoothen and simplify a object. This effect is also available in the Pencil "
"tool's tool controls."
msgstr ""
"Utjämnar och förenklar ett objekt. Denna effekt är också tillgänglig i "
"blyertsverktygets verktygskontroller."

#: ../src/live_effects/effect.cpp:341
msgctxt "path effect"
msgid "Lattice Deformation"
msgstr "Gitterdeformation"

#: ../src/live_effects/effect.cpp:344
msgid "Warp an object's shape based on a 5x5 grid"
msgstr "Förvräng ett objekts form baserat på ett 5x5-rutnät"

#: ../src/live_effects/effect.cpp:355
msgctxt "path effect"
msgid "Perspective/Envelope"
msgstr "Perspektiv/Konvolut"

#: ../src/live_effects/effect.cpp:358
msgid ""
"Transform the object to fit into a shape with four corners, either by "
"stretching it or creating the illusion of a 3D-perspective"
msgstr ""
"Transformera objektet så att det passar in i en form med fyra hörn, antingen "
"genom att sträcka ut det eller genom att skapa en illusion av ett 3D-"
"perspektiv"

#: ../src/live_effects/effect.cpp:369
msgctxt "path effect"
msgid "Interpolate points"
msgstr "Interpolera punkter"

#: ../src/live_effects/effect.cpp:372
msgid ""
"Change the type of all nodes on the path. Useful for smoothing the shape or "
"making it sharp."
msgstr ""
"Ändra typ för alla noder på banan. Användbar för att jämna ut formen eller "
"göra den skarp."

#: ../src/live_effects/effect.cpp:383
msgctxt "path effect"
msgid "Transform by 2 points"
msgstr "Transformera med 2 punkter"

#: ../src/live_effects/effect.cpp:386
msgid "Scale, stretch and rotate an object by two handles"
msgstr "Skala, sträck ut och rotera ett objekt med två handtag"

#: ../src/live_effects/effect.cpp:397
msgctxt "path effect"
msgid "Show handles"
msgstr "Visa handtag"

#: ../src/live_effects/effect.cpp:400
msgid ""
"Draw the handles and nodes of objects (replaces the original styling with a "
"black stroke)"
msgstr ""
"Rita handtag och noder på objekt (ersätter den ursprungliga stylingen med "
"ett svart streck)"

#: ../src/live_effects/effect.cpp:411
msgctxt "path effect"
msgid "Roughen"
msgstr "Förgrova"

#: ../src/live_effects/effect.cpp:414
msgid "Roughen an object by adding and randomly shifting new nodes"
msgstr ""
"Gör ett objekt grövre genom att lägga till och slumpmässigt flytta nya noder"

#: ../src/live_effects/effect.cpp:425
msgctxt "path effect"
msgid "BSpline"
msgstr "BSpline"

#: ../src/live_effects/effect.cpp:428
msgid ""
"Create a BSpline that molds into the path's corners. This effect is usually "
"used directly on the canvas with the BSpline mode of the drawing tools."
msgstr ""
"Skapa en BSpline som formar sig efter banans hörn. Den här effekten används "
"vanligtvis direkt på duken med BSpline-läget i ritverktygen."

#: ../src/live_effects/effect.cpp:439
msgctxt "path effect"
msgid "Join type"
msgstr "Fogtyper"

#.
#. File: ../src/live_effects/effect.cpp, line: 431
#: ../src/live_effects/effect.cpp:442
msgid ""
"Select among various join types for a object's corner nodes (mitre, rounded, "
"extrapolated arc, ...)"
msgstr ""
"Välj mellan olika fogtyper för ett objekts hörnnoder (gering, rundad, "
"extrapolerad båge, ...)"

#: ../src/live_effects/effect.cpp:453
msgctxt "path effect"
msgid "Taper stroke"
msgstr "Avsmalnande streck"

#: ../src/live_effects/effect.cpp:456
msgid "Let the path's ends narrow down to a tip"
msgstr "Låt banans ändar smalna av till en spets"

#: ../src/live_effects/effect.cpp:467
msgctxt "path effect"
msgid "Mirror symmetry"
msgstr "Spegelsymmetri"

#: ../src/live_effects/effect.cpp:470
msgid ""
"Mirror an object along a movable axis, or around the page center. The "
"mirrored copy can be styled independently."
msgstr ""
"Spegla ett objekt längs en rörlig axel eller runt sidans mitt. Den speglade "
"kopian kan stylas oberoende av varandra."

#: ../src/live_effects/effect.cpp:481
msgctxt "path effect"
msgid "Rotate copies"
msgstr "Rotera kopior"

#: ../src/live_effects/effect.cpp:484
msgid ""
"Create multiple rotated copies of an object, as in a kaleidoscope. The "
"copies can be styled independently."
msgstr ""
"Skapa flera roterade kopior av ett objekt, som i ett kalejdoskop. Kopiorna "
"kan stylas oberoende av varandra."

#: ../src/live_effects/effect.cpp:496
msgctxt "path effect"
msgid "Attach path"
msgstr "Fäst bana"

#: ../src/live_effects/effect.cpp:499
msgid ""
"Glue the current path's ends to a specific position on one or two other paths"
msgstr ""
"Limma den aktuella banans ändar till en specifik position på en eller två "
"andra banor"

#: ../src/live_effects/effect.cpp:511
msgctxt "path effect"
msgid "Fill between many"
msgstr "Fyll mellan många"

#: ../src/live_effects/effect.cpp:514
msgid ""
"Turn the path into a fill between multiple other open paths (e.g. between "
"paths with PowerStroke applied to them)"
msgstr ""
"Förvandla banan till en fyllning mellan flera andra öppna banor (t.ex. "
"mellan banor med PowerStroke tillämpat på dem)"

#: ../src/live_effects/effect.cpp:525
msgctxt "path effect"
msgid "Ellipse by 5 points"
msgstr "Ellips med 5 punkter"

#: ../src/live_effects/effect.cpp:528
msgid "Create an ellipse from 5 nodes on its circumference"
msgstr "Skapa en ellips från 5 noder på dess omkrets"

#: ../src/live_effects/effect.cpp:539
msgctxt "path effect"
msgid "Bounding Box"
msgstr "Avgränsningsruta"

#: ../src/live_effects/effect.cpp:542
msgid ""
"Turn the path into a bounding box that entirely encompasses another path"
msgstr ""
"Gör om banan till en avgränsningsruta som helt och hållet omfattar en annan "
"bana"

#: ../src/live_effects/effect.cpp:554
msgctxt "path effect"
msgid "Measure Segments"
msgstr "Mätsegment"

#: ../src/live_effects/effect.cpp:557
msgid ""
"Add dimensioning for distances between nodes, optionally with projection and "
"many other configuration options"
msgstr ""
"Lägg till mått för avstånd mellan noder, eventuellt med projektion och många "
"andra konformationsalternativ"

#: ../src/live_effects/effect.cpp:568
msgctxt "path effect"
msgid "Corners"
msgstr "Hörn"

#: ../src/live_effects/effect.cpp:571
msgid ""
"Fillet/Chamfer: Adjust the shape of a path's corners, rounding them to a "
"specified radius, or cutting them off"
msgstr ""
"Avrundning/avfasning: Justera formen på en banans hörn, runda dem till en "
"angiven radie eller skär av dem"

#: ../src/live_effects/effect.cpp:582
msgctxt "path effect"
msgid "Power clip"
msgstr "Kraftklippning"

#: ../src/live_effects/effect.cpp:585
msgid "Invert, hide or flatten a clip (apply like a Boolean operation)"
msgstr ""
"Invertera, dölj eller platta till ett klipp (tillämpas som en boolesk "
"operation)"

#: ../src/live_effects/effect.cpp:596
msgctxt "path effect"
msgid "Power mask"
msgstr "Kraftmask"

#: ../src/live_effects/effect.cpp:599
msgid "Invert or hide a mask, or use its negative"
msgstr "Invertera eller dölj en mask, eller använd dess negativ"

#: ../src/live_effects/effect.cpp:610
msgctxt "path effect"
msgid "Ellipse from points"
msgstr "Ellips från punkter"

#: ../src/live_effects/effect.cpp:613
msgid "Draw a circle, ellipse, arc or slice based on the nodes of a path"
msgstr "Rita en cirkel, ellips, båge eller skiva baserat på noderna i en bana"

#: ../src/live_effects/effect.cpp:624
msgctxt "path effect"
msgid "Offset"
msgstr "Förskjutning"

#: ../src/live_effects/effect.cpp:627
msgid "Offset the path, optionally keeping cusp corners cusp"
msgstr "Förskjut banan, eventuellt behålla spetshörn spetsiga"

#: ../src/live_effects/effect.cpp:638
msgctxt "path effect"
msgid "Dashed Stroke"
msgstr "Streckat streck"

#: ../src/live_effects/effect.cpp:641
msgid ""
"Add a dashed stroke whose dashes end exactly on a node, optionally with the "
"same number of dashes per path segment"
msgstr ""
"Lägg till en streckad linje vars streck slutar exakt på en nod, eventuellt "
"med samma antal streck per bansegment"

#: ../src/live_effects/effect.cpp:653
msgctxt "path effect"
msgid "Boolean operation"
msgstr "Boolesk operation"

#: ../src/live_effects/effect.cpp:656
msgid ""
"Cut, union, subtract, intersect and divide a path non-destructively with "
"another path"
msgstr ""
"Kapa, sammanfoga, subtrahera, korsa och dela en bana på ett icke-destruktivt "
"sätt med en annan bana"

#: ../src/live_effects/effect.cpp:667
msgctxt "path effect"
msgid "Slice"
msgstr "Skiva"

#: ../src/live_effects/effect.cpp:670
msgid "Slices the item into parts. It can also be applied multiple times."
msgstr "Skivar upp objektet i delar. Den kan också användas flera gånger."

#: ../src/live_effects/effect.cpp:682
msgctxt "path effect"
msgid "Tiling"
msgstr "Brickor"

#: ../src/live_effects/effect.cpp:685
msgid ""
"Create multiple copies of an object following a grid layout. Customize size, "
"rotation, distances, style and tiling symmetry."
msgstr ""
"Skapa flera kopior av ett objekt som följer en rutnätslayout. Anpassa "
"storlek, rotation, avstånd, stil och plattsymmetri."

#: ../src/live_effects/effect.cpp:697
msgctxt "path effect"
msgid "Angle bisector"
msgstr "Vinkelbisektris"

#: ../src/live_effects/effect.cpp:700
msgid ""
"Draw a line that halves the angle between the first three nodes of the path"
msgstr ""
"Rita en linje som halverar vinkeln mellan de tre första noderna på banan"

#: ../src/live_effects/effect.cpp:711
msgctxt "path effect"
msgid "Circle"
msgstr "Cirkel"

#: ../src/live_effects/effect.cpp:714
msgid ""
"Draw a circle by center and radius, where the first node of the path is the "
"center, and the last determines its radius"
msgstr ""
"Rita en cirkel med centrum och radie, där den första noden i banan är "
"centrum och den sista bestämmer dess radie"

#: ../src/live_effects/effect.cpp:725
msgctxt "path effect"
msgid "Circle by 3 points"
msgstr "Cirkel med 3 punkter"

#: ../src/live_effects/effect.cpp:728
msgid ""
"Draw a circle whose circumference passes through the first three nodes of "
"the path"
msgstr "Rita en cirkel vars omkrets passerar genom banans tre första noder"

#: ../src/live_effects/effect.cpp:739
msgctxt "path effect"
msgid "Extrude"
msgstr "Extrudera"

#: ../src/live_effects/effect.cpp:742
msgid "Extrude the path, creating a face for each path segment"
msgstr "Extrudera banan och skapa en yta för varje bansegment"

#: ../src/live_effects/effect.cpp:753
msgctxt "path effect"
msgid "Line Segment"
msgstr "Linjesegment"

#: ../src/live_effects/effect.cpp:756
msgid "Draw a straight line that connects the first and last node of a path"
msgstr "Rita en rak linje som ansluter den första och sista noden på en bana"

#: ../src/live_effects/effect.cpp:767
msgctxt "path effect"
msgid "Parallel"
msgstr "Parallell"

#: ../src/live_effects/effect.cpp:770
msgid "Create a draggable line that will always be parallel to a two-node path"
msgstr ""
"Skapa en dragbar linje som alltid är parallell med en bana med två noder"

#: ../src/live_effects/effect.cpp:781
msgctxt "path effect"
msgid "Perpendicular bisector"
msgstr "Vinkelrät bisektris"

#: ../src/live_effects/effect.cpp:784
msgid ""
"Draw a perpendicular line in the middle of the (imaginary) line that "
"connects the start and end nodes"
msgstr ""
"Rita en vinkelrät linje i mitten av den (imaginära) linje som ansluter "
"start- och slutnoderna"

#: ../src/live_effects/effect.cpp:795
msgctxt "path effect"
msgid "Tangent to curve"
msgstr "Tangent till kurva"

