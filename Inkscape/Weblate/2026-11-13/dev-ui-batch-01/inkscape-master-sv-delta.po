msgid "When in Groups or Layers"
msgstr "I grupper eller lager"

#: ../src/ui/dialog/inkscape-preferences.cpp:1008
#: ../share/ui/dialog-objects.glade:111
msgid ""
"Indicate the selected group or layer by making all other groups or layers "
"fade."
msgstr ""
"Markera den valda gruppen eller det valda lagret genom att tona ned alla "
"andra grupper eller lager."

#: ../src/ui/dialog/inkscape-preferences.cpp:2082
msgid "Show version in title"
msgstr "Visa version i titeln"

#: ../src/ui/dialog/inkscape-preferences.cpp:3160
msgid "Draw glyph boxes"
msgstr "Rita glyfrutor"

#: ../src/ui/dialog/inkscape-preferences.cpp:3160
msgid "Show boxes around glyphs"
msgstr "Visa rutor runt glyfer"

#: ../src/ui/dialog/inkscape-preferences.cpp:3162
msgid "Debug color fonts"
msgstr "Felsök färgteckensnitt"

#: ../src/ui/dialog/inkscape-preferences.cpp:3167
msgid "Debug Cairo fonts"
msgstr "Felsök Cairo-teckensnitt"

#: ../src/ui/dialog/inkscape-preferences.cpp:3853
msgid "Default template:"
msgstr "Standardmall:"

#: ../src/ui/dialog/inkscape-preferences.cpp:3855
msgid "Templates"
msgstr "Mallar"

