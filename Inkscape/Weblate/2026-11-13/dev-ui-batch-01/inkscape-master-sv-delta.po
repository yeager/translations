msgid "Add filter"
msgstr "Lägg till filter"

#: ../src/ui/modifiers.cpp:163
msgid "Maintain gap"
msgstr "Behåll mellanrum"

#: ../src/ui/modifiers.cpp:166
msgid "Clear inline size"
msgstr "Rensa inbäddad storlek"

#: ../src/ui/modifiers.cpp:186
