#: ../src/actions/actions-node-tool.cpp:190
msgid "Nodes insert"
msgstr "Infoga noder"

#: ../src/actions/actions-node-tool.cpp:190
msgid "Insert nodes in selected segments"
msgstr "Infoga nya noder i markerade segment"

#: ../src/actions/actions-node-tool.cpp:191
msgid "Nodes delete"
msgstr "Ta bort noder"

#: ../src/actions/actions-node-tool.cpp:193
msgid "Nodes join"
msgstr "Sammanfoga noder"

#: ../src/actions/actions-node-tool.cpp:194
msgid "Nodes break"
msgstr "Dela upp noder"

#: ../src/actions/actions-node-tool.cpp:194
msgid "Break path between selected nodes"
msgstr "Dela upp banan mellan markerade noder"

#: ../src/actions/actions-node-tool.cpp:195
msgid "Segments join"
msgstr "Sammanfoga segment"

#: ../src/actions/actions-node-tool.cpp:195
msgid "Join selected end nodes with a new segment"
msgstr "Sammanfoga markerade ändnoder med ett nytt segment"

#: ../src/actions/actions-node-tool.cpp:196
msgid "Segments break"
msgstr "Dela upp segment"

#: ../src/actions/actions-node-tool.cpp:196
msgid "Delete segment between two non-end nodes"
msgstr "Ta bort segment mellan två noder som inte är ändnoder"

#: ../src/actions/actions-node-tool.cpp:197
msgid "Simplify path"
msgstr "Förenkla bana"

#: ../src/actions/actions-node-tool.cpp:197
msgid "Join selected nodes which are very close together"
msgstr "Sammanfoga markerade noder som ligger mycket nära varandra"

#: ../src/actions/actions-node-tool.cpp:199
msgid "Nodes to cusp"
msgstr "Gör noder till hörnnoder"

#: ../src/actions/actions-node-tool.cpp:199
msgid "Convert selected nodes to corner nodes"
msgstr "Gör markerade noder till hörnnoder"

#: ../src/actions/actions-node-tool.cpp:200
msgid "Nodes to smooth"
msgstr "Gör noder till mjuka noder"

#: ../src/actions/actions-node-tool.cpp:200
msgid "Convert selected nodes to smooth nodes"
msgstr "Gör markerade noder till mjuka noder"

#: ../src/actions/actions-node-tool.cpp:201
msgid "Nodes to symmetrical"
msgstr "Gör noder till symmetriska noder"

#: ../src/actions/actions-node-tool.cpp:201
msgid "Convert selected nodes to symmetrical nodes"
msgstr "Gör markerade noder symmetriska"

#: ../src/actions/actions-node-tool.cpp:202
msgid "Nodes to auto"
msgstr "Gör noder till automatiskt mjuka noder"

#: ../src/actions/actions-node-tool.cpp:202
msgid "Convert selected nodes to auto smooth nodes"
msgstr "Gör markerade noder automatiskt släta"

#: ../src/actions/actions-node-tool.cpp:204
msgid "Segments to curves"
msgstr "Gör segment till kurvor"

#: ../src/actions/actions-node-tool.cpp:204
msgid "Convert selected path segments to curves"
msgstr "Gör markerade segment till kurvor"

#: ../src/actions/actions-node-tool.cpp:205
msgid "Segments to lines"
msgstr "Gör segment till linjer"

#: ../src/actions/actions-node-tool.cpp:205
msgid "Convert selected path segments to lines"
msgstr "Gör markerade segment till raka linjer"

#: ../src/actions/actions-selection-object.cpp:156
#: ../share/ui/toolbar-select.ui:186
msgid "Bring selection up one step"
msgstr "Höj markeringen ett steg"

#: ../src/actions/actions-selection-object.cpp:157
#: ../share/ui/toolbar-select.ui:200
msgid "Bring selection down one step"
msgstr "Sänk markeringen ett steg"

#: ../src/actions/actions-text-attributes.cpp:67
msgctxt "Undo"
msgid "Text: Change text-decoration"
msgstr "Text: Ändra textdekoration"

#: ../src/actions/actions-text-attributes.cpp:143
msgid "Text Underline"
msgstr "Understruken text"

#: ../src/actions/actions-text-attributes.cpp:143
msgid "Toggle text underline"
msgstr "Växla understruken text"

#: ../src/actions/actions-text-attributes.cpp:145
msgid "Text Overline"
msgstr "Överstruken text"

#: ../src/actions/actions-text-attributes.cpp:145
msgid "Toggle text overline"
msgstr "Växla överstruken text"

#: ../src/actions/actions-text.cpp:144
msgid "Select text by Font"
msgstr "Markera text efter teckensnitt"

#: ../src/actions/actions-text.cpp:144
msgid ""
"Select all text objects which use the selected font, or the last font used."
msgstr ""
"Markera alla textobjekt som använder det markerade teckensnittet eller det "
"senast använda teckensnittet."

#: ../src/live_effects/lpe-curvestitch.cpp:36
msgid ""
"The amount of random jitter to move the start points of the stitches inside "
"&amp; outside the guide path"
msgstr ""
"Mängden slumpmässigt jitter för att flytta stygnens startpunkter inom och "
"utanför hjälpbanan"

#: ../src/live_effects/lpe-curvestitch.cpp:39
msgid ""
"The amount of random shifting to move the start points of the stitches back "
"&amp; forth along the guide path"
msgstr ""
"Mängden slumpmässig förskjutning för att flytta stygnens startpunkter fram "
"och tillbaka längs hjälpbanan"

#: ../src/live_effects/lpe-curvestitch.cpp:44
msgid ""
"The amount of randomness that moves the end points of the stitches inside "
"&amp; outside the guide path"
msgstr ""
"Mängden slumpmässighet som flyttar stygnens slutpunkter inom och utanför "
"hjälpbanan"

#: ../src/live_effects/lpe-curvestitch.cpp:47
msgid ""
"The amount of random shifting to move the end points of the stitches back "
"&amp; forth along the guide path"
msgstr ""
"Mängden slumpmässig förskjutning för att flytta stygnens slutpunkter fram "
"och tillbaka längs hjälpbanan"

#: ../src/path/path-object-set.cpp:92
msgid "Top object must be a shape or text to perform boolean operations."
msgstr ""
"Det översta objektet måste vara en form eller text för att booleska "
"operationer ska kunna utföras."

#: ../src/path/path-object-set.cpp:188
msgid "Select <b>at least 2 paths</b> to perform the boolean operation."
msgstr ""
"Markera <b>minst 2 slingor</b> för att utföra den booleska operationen."

#: ../src/ui/clipboard.cpp:777
msgid "Select object(s) to paste style to."
msgstr "Markera objekt att klistra in stilen på."

#: ../src/ui/clipboard.cpp:841
msgid "Select object(s) to paste size to."
msgstr "Markera objekt att klistra in storleken på."

#: ../src/ui/clipboard.cpp:903
msgid "Select object(s) to paste live path effect to."
msgstr "Markera objekt att klistra in banverkan på."

