msgstr "Minska ljusheten"

msgid "Less Saturation"
msgstr "Minska mättnaden"

msgid "More Hue"
msgstr "Öka nyansen"

msgid "More Light"
msgstr "Öka ljusheten"

msgid "More Saturation"
msgstr "Öka mättnaden"

msgid "Negative"
msgstr "Invertera"

msgid "Replace Color"
