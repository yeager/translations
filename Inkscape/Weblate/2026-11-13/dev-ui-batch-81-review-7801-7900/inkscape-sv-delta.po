msgid "Vary the height of lowercase ascenders"
msgstr "Variera höjden på uppstaplar i gemener"

msgid "Vary the depth of lowercase descenders"
msgstr "Variera djupet på nedstaplar i gemener"

msgid "Vary the height of figures"
msgstr "Variera höjden på siffrorna"

msgid "Controls the flaring of the stems"
msgstr "Styr utvidgningen av stammarna"

msgid "Volume works in combination with flare to transform serifs"
msgstr "Volym fungerar tillsammans med utvidgning för att omforma serifer"

msgid "Binary switch used to control substitution of “wonky” forms"
msgstr "Binär omkopplare som styr ersättning av oregelbundna former"

msgid "Selection of the base element glyphs are composed of"
msgstr "Välj vilket baselement glyferna består av"

msgid "Controls vertical element alignment"
msgstr "Styr vertikal justering av element"

msgid "Controls ink bleed effect"
msgstr "Kontrollerar effekten av bläckutflytning"

msgid "Controls scanline effect"
msgstr "Kontrollerar rasterlinjeeffekten"

msgid "Controls morphing characteristics"
msgstr "Kontrollerar egenskaper för formförändring"

msgid "Controls bounce/spring effect"
msgstr "Kontrollerar studs- och fjädereffekten"

msgid "Controls character 3D horizontal rotation"
msgstr "Kontrollerar tecknets horisontella 3D-rotation"

msgid "Controls character 3D vertical rotation"
msgstr "Kontrollerar tecknets vertikala 3D-rotation"

msgid "Controls the weight of an underline"
msgstr "Kontrollerar tjockleken på en understrykning"

msgid "Controls the Y reflection"
msgstr "Kontrollerar Y-speglingen"

msgid "Controls the weight of a font’s outline"
msgstr "Kontrollerar tjockleken på ett typsnitts kontur"

msgid "Controls the relative X advance - horizontal motion of the glyph"
msgstr "Kontrollerar den relativa X-förflyttningen (glyfens horisontella rörelse)"

msgid "Controls the relative Y advance - vertical motion of the glyph"
msgstr "Kontrollerar den relativa Y-förflyttningen (glyfens vertikala rörelse)"

msgid "Controls the relative second value - as in one second of animation time"
msgstr "Kontrollerar det relativa andra värdet, som en sekunds animationstid"

