#: ../src/live_effects/lpe-tiling.cpp:895
msgid ""
"Blend rotation from <b>top to bottom</b> (top row uses original rotation, "
"bottom row uses new rotation)"
msgstr ""
"Blanda rotation <b>uppifrån och ned</b> (översta raden använder "
"originalrotation, nedersta raden använder ny rotation)"

#: ../src/live_effects/lpe-tiling.cpp:898
msgid "Random rotation (hit <b>Randomize</b> button to shuffle)"
msgstr "Slumpmässig rotation (klicka på knappen <b>Slumpa</b> för att blanda)"

