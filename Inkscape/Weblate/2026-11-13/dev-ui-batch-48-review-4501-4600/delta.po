msgid "N_r of generations:"
msgstr "A_ntal generationer:"

#: ../src/live_effects/lpe-vonkoch.cpp:50
msgid "_Use uniform transforms only"
msgstr "_Använd endast enhetliga transformationer"

#: ../src/live_effects/lpe-vonkoch.cpp:50
msgid ""
"2 consecutive segments are used to reverse/preserve orientation only "
"(otherwise, they define a general transform)."
msgstr ""
"Två segment i följd används enbart för att vända eller bevara orienteringen "
"(annars definierar de en allmän transformation)."

#: ../src/live_effects/lpe-vonkoch.cpp:51
msgid "If unchecked, draw only the last generation"
msgstr "Om den avmarkeras ritas endast den sista generationen"

#: ../src/live_effects/lpe-vonkoch.cpp:57
msgid "Disable effect if the output is too complex"
msgstr "Inaktivera effekten om resultatet är för komplext"

