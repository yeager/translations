#: ../src/ui/dialog/inkscape-preferences.cpp:2029
msgid "Toolbox icon size:"
msgstr "Ikonstorlek i verktygslådan:"

#: ../src/ui/dialog/inkscape-preferences.cpp:2050
msgid "Present simplified snapping options that manage all advanced settings"
msgstr "Visa förenklade fästalternativ som hanterar alla avancerade inställningar"

#: ../src/ui/dialog/inkscape-preferences.cpp:2051
msgid "Expose all snapping options for manual control"
msgstr "Visa alla fästalternativ för manuell styrning"

#: ../src/ui/dialog/inkscape-preferences.cpp:2052
msgid "All advanced snap options appear in a permanent bar"
msgstr "Alla avancerade fästalternativ visas i ett permanent fält"

#: ../src/ui/dialog/inkscape-preferences.cpp:2054
msgid "Snap controls bar:"
msgstr "Kontrollfält för fästning:"

#: ../src/ui/dialog/inkscape-preferences.cpp:2076
msgid "Set what shows when loading the program normally."
msgstr "Ange vad som visas när programmet startas normalt."

#: ../src/ui/dialog/inkscape-preferences.cpp:2091
msgid "Show close button in tab"
msgstr "Visa stängknapp i fliken"

#: ../src/ui/dialog/inkscape-preferences.cpp:2105
msgid "Set the default window size"
msgstr "Ange standardfönsterstorlek"

#: ../src/ui/dialog/inkscape-preferences.cpp:2121
msgid "Use GTK open and save dialogs "
msgstr "Använd GTK-dialogrutor för att öppna och spara "

#: ../src/ui/dialog/inkscape-preferences.cpp:2123
msgid "Dialogs settings"
msgstr "Inställningar för dialogrutor"

#: ../src/ui/dialog/inkscape-preferences.cpp:2134
msgid "Dialogs stay on top of document windows"
msgstr "Dialogrutorna hålls ovanpå dokumentfönster"

#: ../src/ui/dialog/inkscape-preferences.cpp:2135
msgid "Same as Normal but may work better with some window managers"
msgstr "Samma som normalt, men kan fungera bättre med vissa fönsterhanterare"

#: ../src/ui/dialog/inkscape-preferences.cpp:2146
msgid "Show close button in dialog tabs"
msgstr "Visa stängknapp i dialogflikar"

#: ../src/ui/dialog/inkscape-preferences.cpp:2149
msgid "Save and restore dialogs' status"
msgstr "Spara och återställ dialogrutornas status"

#: ../src/ui/dialog/inkscape-preferences.cpp:2154
msgid "Whether dialog windows are to be hidden in the window manager taskbar"
msgstr "Anger om dialogrutorna ska döljas i fönsterhanterarens aktivitetsfält"

#: ../src/ui/dialog/inkscape-preferences.cpp:2173
msgid "Use compact color selector mode switch"
msgstr "Använd en kompakt lägesväxlare för färgväljaren"

#: ../src/ui/dialog/inkscape-preferences.cpp:2210
msgid "Visible color pickers"
msgstr "Synliga färgväljare"

#: ../src/ui/dialog/inkscape-preferences.cpp:2219
msgid "Minor grid line color"
msgstr "Färg på mindre rutnätslinjer"

#: ../src/ui/dialog/inkscape-preferences.cpp:2221
msgid "Major grid line color"
msgstr "Färg på större rutnätslinjer"

#: ../src/ui/dialog/inkscape-preferences.cpp:2246
msgid "Show dots instead of lines"
msgstr "Visa punkter i stället för linjer"

#: ../src/ui/dialog/inkscape-preferences.cpp:2247
msgid "If set, display dots at gridpoints instead of gridlines"
msgstr "Om alternativet är valt visas punkter vid rutnätets skärningspunkter i stället för rutnätslinjer"

#: ../src/ui/dialog/inkscape-preferences.cpp:2258
msgid "Y axis vertical"
msgstr "Y-axeln är lodrät"

#: ../src/ui/dialog/inkscape-preferences.cpp:2259
msgid "Angle of X:"
msgstr "X-vinkel:"

#: ../src/ui/dialog/inkscape-preferences.cpp:2261
msgid "Angle of Z:"
msgstr "Z-vinkel:"
