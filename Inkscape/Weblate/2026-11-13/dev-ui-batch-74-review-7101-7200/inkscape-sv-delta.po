msgid ""
"Adjust the <b>tip radius</b> of the star or polygon; with <b>Shift</b> to "
"round; with <b>Alt</b> to randomize"
msgstr ""
"Justera <b>spetsradien</b> för stjärnan eller polygonen; med <b>Skift</b> "
"för att runda av och med <b>Alt</b> för att slumpa"

msgid ""
"Roll/unroll the spiral from <b>outside</b>; with <b>Ctrl</b> to snap angle; "
"with <b>Shift</b> to scale/rotate; with <b>Alt</b> to lock radius"
msgstr ""
"Rulla ihop/rulla upp spiralen från <b>utsidan</b>; med <b>Ctrl</b> för att "
"fästa vinkeln, med <b>Skift</b> för att skala eller rotera och med <b>Alt</b> "
"för att låsa radien"

msgctxt "Undo"
msgid "Modify textpath startOffset"
msgstr "Ändra textbanans startförskjutning"

msgctxt "Undo"
msgid "Change textpath side"
msgstr "Ändra textbanans sida"

msgid "Adjust the <b>rectangular</b> region of the text."
msgstr "Justera textens <b>rektangulära</b> område."

msgid "Adjust the text <b>shape padding</b>."
msgstr "Justera textformens <b>utfyllnad</b>."

msgid ""
"<b>Drag</b> to adjust the <b>start offset</b>. <b>Click</b> to open on-"
"canvas textPath controls."
msgstr ""
"<b>Dra</b> för att justera <b>startförskjutningen</b>. <b>Klicka</b> för att "
"öppna textPath-kontroller på ritytan."

msgid ""
"<b>Drag</b> to adjust the <b>textpath side</b>. <b>Click</b> to open on-"
"canvas textPath controls."
msgstr ""
"<b>Dra</b> för att justera <b>textbanans sida</b>. <b>Klicka</b> för att "
"öppna textPath-kontroller på ritytan."

msgid "Select a filename for export"
msgstr "Välj ett filnamn för export"

msgctxt "Undo"
msgid "Drag curve"
msgstr "Dra kurva"

msgctxt "Path segment tip"
msgid "<b>%1</b>: drag to open or move BSpline handles"
msgstr "<b>%1</b>: dra för att öppna eller flytta B-spline-handtag"

msgctxt "Path segment tip"
msgid "<b>%1</b>: click to toggle segment selection"
msgstr "<b>%1</b>: klicka för att växla markering av segmentet"

msgctxt "Path handle tip"
msgid "<b>%s</b>: Snap handle to steps defined in BSpline Live Path Effect"
msgstr "<b>%s</b>: fäst handtaget i steg som definieras i B-spline-baneffekten (LPE)"

msgctxt "Status line hint"
msgid ""
"<b>BSpline node handle</b> (%.3g power): Shift-drag to move, double-click to "
"reset. (more: %s)"
msgstr ""
"<b>B-spline-nodhandtag</b> (%.3g styrka): Skift-dra för att flytta, "
"dubbelklicka för att återställa. (fler: %s)"

msgctxt "Status line hint"
msgid ""
"<b>%s</b>: drag to shape the path, hover to lock, Shift+S to make smooth, "
"Shift+Y to make symmetric. (more: %s)"
msgstr ""
"<b>%s</b>: dra för att forma banan, håll pekaren över den för att låsa, "
"Skift+S för att göra den jämn och Skift+Y för att göra den symmetrisk. "
"(fler: %s)"

msgctxt "Status line hint"
msgid ""
"<b>%s</b>: drag to shape the path, hover to lock, Shift+Y to make symmetric. "
"(more: %s)"
msgstr ""
"<b>%s</b>: dra för att forma banan, håll pekaren över den för att låsa och "
"Skift+Y för att göra den symmetrisk. (fler: %s)"

msgctxt "Status line hint"
msgid ""
"<b>%s</b>: drag to make smooth, hover to lock, Shift+Y to make symmetric. "
"(more: %s)"
msgstr ""
"<b>%s</b>: dra för att göra den jämn, håll pekaren över den för att låsa och "
"Skift+Y för att göra den symmetrisk. (fler: %s)"

msgctxt "Path node tip"
msgid "<b>BSpline node</b> (%.3g power): drag to shape the path. (more: %s)"
msgstr "<b>B-spline-nod</b> (%.3g styrka): dra för att forma banan. (mer: %s)"

msgid "Auto-smooth node"
msgstr "Automatiskt utjämnad nod"

msgctxt "Transform handle tip"
msgid "<b>Scale handle</b>: drag to scale the selection"
msgstr "<b>Skalningshandtag</b>: dra för att skala markeringen"

msgctxt "Transform handle tip"
msgid ""
"<b>Rotation handle</b>: drag to rotate the selection around the rotation "
"center"
msgstr ""
"<b>Rotationshandtag</b>: dra för att rotera markeringen kring rotationscentrum"

msgctxt "Transform handle tip"
msgid ""
"<b>%1</b>: skew about the rotation center with snapping to %2° increments"
msgstr "<b>%1</b>: skeva kring rotationscentrum och fäst vinkeln i steg om %2°"

msgctxt "Transform handle tip"
msgid ""
"<b>Skew handle</b>: drag to skew (shear) selection about the opposite handle"
msgstr "<b>Skevhandtag</b>: dra för att skeva markeringen kring motsatt handtag"

msgctxt "Undo"
msgid "Arc: Change start/end"
msgstr "Båge: Ändra start/slut"

msgid "(hairline)"
msgstr "(hårlinje)"

msgid "(speed blows up stroke)"
msgstr "(hastigheten blåser upp strecket)"
