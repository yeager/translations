msgid ""
msgstr ""
"Project-Id-Version: Inkscape\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: sv\n"

msgid "Translate X"
msgstr "Förflytta X"

msgid "Translate Y"
msgstr "Förflytta Y"

msgid "If you selected \"Other\" above, you must specify the details for this \"other\" here."
msgstr "Om du valde \"Annat\" ovan måste du ange detaljerna för detta \"andra\" här."

msgid "Other Attribute type:"
msgstr "Annan typ av attribut:"

msgid "Number"
msgstr "Tal"

msgid "Transformation"
msgstr "Omvandling"

msgid "This effect applies a value for any interpolatable attribute for all elements inside the selected group or for all elements in a multiple selection."
msgstr "Denna effekt tillämpar ett värde på ett interpolerbart attribut för alla element i den markerade gruppen eller i en flermarkering."

msgid "Auto-Text:"
msgstr "Automatisk text:"

msgid "This extension allows you to install, update and remove auto-texts for a JessyInk presentation. Please see code.google.com/p/jessyink for more details."
msgstr "Med det här tillägget kan du installera, uppdatera och ta bort automatiska texter för en JessyInk-presentation. Se code.google.com/p/jessyink för mer information."

msgid "This extension allows you to install, update and remove object effects for a JessyInk presentation. Please see code.google.com/p/jessyink for more details."
msgstr "Med det här tillägget kan du installera, uppdatera och ta bort objekteffekter för en JessyInk-presentation. Se code.google.com/p/jessyink för mer information."

msgid "JessyInk zipped pdf or png output"
msgstr "JessyInk-utdata som komprimerad PDF eller PNG"

msgid "This extension allows you to export a JessyInk presentation once you created an export layer in your browser. Please see code.google.com/p/jessyink for more details."
msgstr "Med det här tillägget kan du exportera en JessyInk-presentation när du har skapat ett exportlager i webbläsaren. Se code.google.com/p/jessyink för mer information."

msgid "JessyInk zipped pdf or png output (*.zip)"
msgstr "JessyInk-utdata som komprimerad PDF eller PNG (*.zip)"

msgid "Creates a zip file containing pdfs or pngs of all slides of a JessyInk presentation."
msgstr "Skapar en ZIP-fil med PDF- eller PNG-filer av alla bilder i en JessyInk-presentation."

msgid "This extension allows you to install or update the JessyInk script in order to turn your SVG file into a presentation. Please see code.google.com/p/jessyink for more details."
msgstr "Med det här tillägget kan du installera eller uppdatera JessyInk-skriptet för att göra SVG-filen till en presentation. Se code.google.com/p/jessyink för mer information."

msgid "Key bindings"
msgstr "Tangentbindningar"

msgid "Toggle progress bar:"
msgstr "Växla förloppsindikatorn:"

msgid "Reset timer:"
msgstr "Återställ tidtagning:"

msgid "Set path width to default:"
msgstr "Ställ in banbredden på standardvärdet:"

msgid "Undo last path segment:"
msgstr "Ångra senaste bansegment:"

msgid "Select the slide to the left:"
msgstr "Välj bilden till vänster:"

msgid "Select the slide to the right:"
msgstr "Välj bilden till höger:"

msgid "Select the slide above:"
msgstr "Välj bilden ovanför:"

msgid "Select the slide below:"
msgstr "Välj bilden nedanför:"

msgid "This extension allows you customize the key bindings JessyInk uses. Please see code.google.com/p/jessyink for more details."
msgstr "Med det här tillägget kan du anpassa tangentbindningarna som JessyInk använder. Se code.google.com/p/jessyink för mer information."

msgid "If no layer name is supplied, the master slide is unset."
msgstr "Om inget lagernamn anges har huvudbilden inget värde."

msgid "This extension allows you to change the master slide JessyInk uses. Please see code.google.com/p/jessyink for more details."
msgstr "Med det här tillägget kan du ändra huvudbilden som JessyInk använder. Se code.google.com/p/jessyink för mer information."

msgid "This extension allows you customize the mouse handler JessyInk uses. Please see code.google.com/p/jessyink for more details."
msgstr "Med det här tillägget kan du anpassa mushanteraren som JessyInk använder. Se code.google.com/p/jessyink för mer information."

msgid "This extension allows you to obtain information about the JessyInk script, effects and transitions contained in this SVG file. Please see code.google.com/p/jessyink for more details."
msgstr "Med det här tillägget kan du hämta information om JessyInk-skriptet samt effekter och övergångar som ingår i SVG-filen. Se code.google.com/p/jessyink för mer information."
