msgid ""
msgstr ""
"Project-Id-Version: Inkscape\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: sv\n"

msgid "Force"
msgstr "Kraft"

msgid "In color mode, act on object's hue"
msgstr "Påverka objektets nyans i färgläge"

msgid "In color mode, act on object's saturation"
msgstr "Påverka objektets mättnad i färgläge"

msgid "In color mode, act on object's lightness"
msgstr "Påverka objektets ljushet i färgläge"

msgid "In color mode, act on object's opacity"
msgstr "Påverka objektets opacitet i färgläge"

msgid "Live Preview"
msgstr "Förhandsgranskning i realtid"

msgid ""
"The total length of the pattern is too small\n"
"Please choose a larger object or set 'Space between copies' > 0"
msgstr ""
"Den totala längden på mönstret är för liten\n"
"Välj ett större objekt eller ställ in \"Mellanrum mellan kopior\" > 0"

msgid "Binary DXF file has unexpected header."
msgstr "Binär DXF-fil har ett oväntat filhuvud."

msgid ""
"The sliced bitmaps have been saved as:\n"
"\n"
msgstr ""
"De uppdelade rasterbilderna har sparats som:\n"
"\n"

msgid "Font not found; Unable to generate glyph table."
msgstr "Typsnittet hittades inte; kunde inte generera glyftabell."

msgid ""
"Warning: unable to render text.\n"
"Please use Text > Remove Manual Kerns to remove kerning prior to using this "
"extension."
msgstr ""
"Varning: texten kan inte återges.\n"
"Använd Text > Ta bort manuell kerning för att ta bort kerning innan du "
"använder det här tillägget."

msgid ""
"Warning: unable to convert text flowed into a frame.\n"
"Please use Text > Unflow to convert it prior to use.\n"
"If you are unable to identify the object in question, please contact "
"technical support for help."
msgstr ""
"Varning: det går inte att konvertera flödande text i en ram.\n"
"Använd Text > Ta bort flöde för att konvertera den före användning.\n"
"Om du inte kan identifiera objektet i fråga, kontakta teknisk support för "
"att få hjälp."
