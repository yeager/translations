msgid "Satiny metal surface effect"
msgstr "Effekt av satinerad metallyta"

#: ../build/share/filters/filters.svg.h:760
msgid "Dark chrome effect"
msgstr "Mörk kromeffekt"

#: ../build/share/filters/filters.svg.h:764
