#: ../build/share/filters/filters.svg.h:592
msgid "Oversaturate colors which can be fluorescent in real world"
msgstr "Övermätta färger som kan vara fluorescerande i verkligheten"

#: ../build/share/filters/filters.svg.h:672
msgid "Overlay with a small scale screen like noise"
msgstr "Lägg över ett småskaligt skärmliknande brus"

#: ../build/share/filters/filters.svg.h:676
msgid "Adds a small scale screen like noise locally"
msgstr "Lägger lokalt till ett småskaligt skärmliknande brus"

#: ../build/share/filters/filters.svg.h:704
msgid "Adds a small scale screen like graininess"
msgstr "Lägger till en småskalig skärmliknande kornighet"

#: ../build/share/filters/filters.svg.h:720
msgid "Highly configurable checkered tartan pattern"
msgstr "Mycket konfigurerbart skotskrutigt mönster"

#: ../build/share/filters/filters.svg.h:728
msgid "Colorizable filling with liquid transparency"
msgstr "Färgbar fyllning med flytande genomskinlighet"

