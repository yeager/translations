msgid "Break apart"
msgstr "Dela upp"

msgid "Reverse path"
msgstr "Vänd bana"

msgid "Select <b>exactly 2 paths</b> to perform difference, division, or path cut."
msgstr "Välj <b>exakt 2 banor</b> för att utföra differens, division eller banklippning."

msgid "Outset path"
msgstr "Utvidga bana"

msgid "Inset path"
msgstr "Dra in bana"

msgid "Pop selection from group"
msgstr "Ta ut markering ur grupp"

msgid "Raise to top"
