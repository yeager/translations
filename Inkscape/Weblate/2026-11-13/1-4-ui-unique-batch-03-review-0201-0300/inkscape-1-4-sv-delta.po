msgctxt "Action"
msgid "Clone"
msgstr "Klona"

msgid "unSymbol all selected symbols"
msgstr "Ta bort symbolstatus från alla valda symboler"

msgid " in <b>%i</b> parent (%s)"
msgstr " i <b>%i</b> överordnat objekt (%s)"

msgid " in <b>%i</b> layer"
msgstr " i <b>%i</b> lager"

