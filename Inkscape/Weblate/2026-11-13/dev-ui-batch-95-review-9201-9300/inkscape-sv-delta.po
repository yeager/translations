msgid "Spray copies of the initial selection"
msgstr "Spraya kopior av den ursprungliga markeringen"

msgid "Spray clones of the initial selection"
msgstr "Spraya kloner av den ursprungliga markeringen"

msgid "The width of the spray area (relative to the visible canvas area)"
msgstr "Sprayområdets bredd (relativt till det synliga rityteområdet)"

msgid "Apply over no transparent areas"
msgstr "Tillämpa på ogenomskinliga områden"

msgid "Apply over transparent areas"
msgstr "Tillämpa på genomskinliga områden"

msgid "Apply picked color to fill"
msgstr "Tillämpa vald färg på fyllning"

msgid "Apply picked color to stroke"
msgstr "Tillämpa vald färg på streck"

msgid "Pick from center instead of average area."
msgstr "Välj från mitten i stället för från ett genomsnittligt område."

msgid "Regular polygon (with one handle) instead of a star"
msgstr "Vanlig polygon (med ett handtag) i stället för en stjärna"

msgid "Star instead of a regular polygon (with one handle)"
msgstr "Stjärna i stället för en vanlig polygon (med ett handtag)"

msgid "CANVAS TOOLS"
msgstr "RITYTEVERKTYG"

msgid "Push parts of paths in any direction"
msgstr "Flytta delar av banor i valfri riktning"

msgid "Shrink (inset) parts of paths; with Shift grow (outset)"
msgstr "Förminska (fäll in) delar av banor; med Skift för att förstora (fäll ut)"

msgid "Attract parts of paths towards cursor; with Shift from cursor"
msgstr "Dra delar av banor mot muspekaren; med Skift bort från muspekaren"

msgid "Roughen parts of paths"
msgstr "Gör delar av banor grövre"
