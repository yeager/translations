msgid ""
msgstr ""
"Project-Id-Version: Inkscape 1.4.x\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: sv\n"

msgid "Circle vertical lines halftone shading"
msgstr "Cirkel med vertikala linjer och halvtonsskuggning"

msgid "Wave vertical lines shading 2"
msgstr "Vågiga vertikala skuggningslinjer 2"

msgid "Wave vertical lines shading"
msgstr "Vågiga vertikala skuggningslinjer"

msgid "Vertical lines shading"
msgstr "Skuggning med vertikala linjer"

msgid "Lines half circle shading"
msgstr "Halvcirkelformad linjeskuggning"

msgid "CD Label 120mmx120mm"
msgstr "CD-etikett 120 mm × 120 mm"

msgid "Display Mode: Toggle Preview"
msgstr "Visningsläge: växla förhandsvisning"

msgid "Toggle between preview and previous mode"
msgstr "Växla mellan förhandsvisning och föregående läge"

msgid "Unhid all objects in the current layer"
msgstr "Visa alla objekt i aktuellt lager"

msgid "Unlocked all objects in the current layer"
msgstr "Lås upp alla objekt i aktuellt lager"

msgid "Unhid selected items and their descendents."
msgstr "Visa valda objekt och deras underordnade objekt."

msgid "Unlocked selected items and their descendents."
msgstr "Lås upp valda objekt och deras underordnade objekt."

msgid "Even horizontal gaps"
msgstr "Fördela horisontella mellanrum jämnt"

msgid "Set clipping path"
msgstr "Ange klippbana"

msgid "Set Inverse Clip(LPE)"
msgstr "Ange omvänd klippning (LPE)"

msgid "Release clipping path"
msgstr "Frigör klippbana"

msgid "Enter string for PDF Version, e.g. 1.4 or 1.5"
msgstr "Ange PDF-version, till exempel 1.4 eller 1.5"

msgid "Resize page to fit"
msgstr "Anpassa sidans storlek"

msgid "Restore backup of stored selection of objects or nodes"
msgstr "Återställ lagrad säkerhetskopia av markering av objekt eller noder"

msgid "Write path data for every non-path shape into its inkscape:d attribute. The value will not update automatically."
msgstr "Skriv bandata för varje icke-banform i dess inkscape:d-attribut. Värdet uppdateras inte automatiskt."

msgid "<b>Drag</b> to draw a calligraphic stroke; with <b>Ctrl</b> to track a guide path. <b>Arrow keys</b> adjust width (left/right) and angle (up/down)."
msgstr "<b>Dra</b> för att rita ett kalligrafiskt streck; håll ned <b>Ctrl</b> för att följa en hjälpbana. <b>Piltangenter</b> justerar bredd (vänster/höger) och vinkel (upp/ned)."

msgid "<b>Click</b> or <b>drag around an area</b> to zoom in, <b>Shift+click</b> to zoom out."
msgstr "<b>Klicka</b> eller <b>dra runt ett område</b> för att zooma in, <b>Shift+klicka</b> för att zooma ut."

msgid "<b>Click</b> to paint a bounded area, <b>Shift+click</b> to union the new fill with the current selection, <b>Ctrl+click</b> to change the clicked object's fill and stroke to the current setting."
msgstr "<b>Klicka</b> för att färga ett avgränsat område, <b>Shift+klick</b> för att sammanfoga den nya fyllningen med den nuvarande markeringen, <b>Ctrl+klick</b> för att ändra det klickade objektets fyllnings- och streckinställningar till den aktuella inställningen."

msgid ""
"The tutorial files are not installed.\\n"
"For Linux, you may need to install 'inkscape-tutorials'; for Windows, please re-run the setup and select 'Tutorials'.\\n"
"The tutorials can also be found online at https://inkscape.org/en/learn/tutorials/."
msgstr ""
"Självstudiefilerna är inte installerade.\\n"
"I Linux kan du behöva installera 'inkscape-tutorials'. I Windows kör du installationsprogrammet igen och väljer 'Tutorials'.\\n"
"Självstudierna finns också på https://inkscape.org/en/learn/tutorials/."
