#: ../src/live_effects/lpe-taperstroke.cpp:91
#: ../share/ui/object-attributes.glade:131
msgid "Center"
msgstr "Mitten"

#: ../src/live_effects/lpe-taperstroke.cpp:103
msgid "The (non-tapered) width of the path"
msgstr "Banans ursprungliga bredd (utan avsmalning)"

#: ../src/live_effects/lpe-taperstroke.cpp:104
msgid "Taper distance from path start"
msgstr "Avsmalningens avstånd från banans början"

#: ../src/live_effects/lpe-taperstroke.cpp:106
msgid "Start smoothing:"
msgstr "Utjämning vid början:"

#: ../src/live_effects/lpe-taperstroke.cpp:107
msgid "End smoothing:"
msgstr "Utjämning vid slutet:"

#: ../src/live_effects/lpe-taperstroke.cpp:111
msgid "Limit for miter joins"
msgstr "Geringsgräns"

#: ../src/live_effects/lpe-tiling.cpp:93
msgid "Scale %"
msgstr "Skala i %"

#: ../src/live_effects/lpe-tiling.cpp:93
msgid "Scale tiles by this percentage"
msgstr "Skala brickorna med den här procentsatsen"

#: ../src/live_effects/lpe-tiling.cpp:95
msgid "Offset tiles by this percentage of width/height"
msgstr "Förskjut brickorna med den här procentandelen av bredden eller höjden"

#: ../src/live_effects/lpe-tiling.cpp:99
msgid ""
"Minimize gaps between scaled objects (does not work with rotation/diagonal "
"mode)"
msgstr ""
"Minimera mellanrum mellan skalade objekt (fungerar inte med rotations- eller "
"diagonalläge)"

#: ../src/live_effects/lpe-tiling.cpp:108
msgid "Link styles in split mode, can also be used to reset style of copies"
msgstr "Länka stilar i delningsläge. Kan även användas för att återställa kopiors stil"

#: ../src/live_effects/lpe-tiling.cpp:112
msgid "Randomize scale"
msgstr "Slumpa skalan"

#: ../src/live_effects/lpe-tiling.cpp:113
msgid "Randomization seed"
msgstr "Slumpfrö"

#: ../src/live_effects/lpe-tiling.cpp:794
msgid "Randomization seed for random mode for scaling, rotation and gaps"
msgstr "Slumpfrö för skalning, rotation och mellanrum i slumpmässigt läge"

#: ../src/live_effects/lpe-tiling.cpp:826
msgid "Offset alternate rows"
msgstr "Förskjut varannan rad"

#: ../src/live_effects/lpe-tiling.cpp:827
msgid "Offset alternate cols"
msgstr "Förskjut varannan kolumn"

#: ../src/live_effects/lpe-tiling.cpp:858
msgid ""
"Blend scale from <b>top to bottom</b> (top row uses original scale, bottom "
"row uses new scale)"
msgstr ""
"Blanda skala <b>uppifrån och ned</b> (översta raden använder originalskala, "
"nedersta raden använder ny skala)"

#: ../src/live_effects/lpe-tiling.cpp:861
msgid "Random scale (hit <b>Randomize</b> button to shuffle)"
msgstr "Slumpmässig skala (klicka på knappen <b>Slumpa</b> för att blanda)"
