#: ../src/inkscape-application.cpp:672
msgid "Resolution for bitmaps and rasterized filters; default is 96"
msgstr "Upplösning för rasterbilder och rastrerade filter; standard är 96"

#: ../src/inkscape-application.cpp:689
msgid "Background color for exported bitmaps (any SVG color string)"
msgstr "Bakgrundsfärg för exporterade rasterbilder (valfri SVG-färgsträng)"

#: ../src/inkscape-application.cpp:691
msgid "Background opacity for exported bitmaps (0.0 to 1.0, or 1 to 255)"
msgstr ""
"Bakgrundsopacitet för exporterade rasterbilder (0,0 till 1,0, eller 1 till "
"255)"

#: ../src/inkscape-application.cpp:724
msgid "Close GUI after executing all actions"
msgstr "Stäng det grafiska gränssnittet efter att ha utfört alla åtgärder"

#: ../src/inkscape-application.cpp:726
msgid "Start Inkscape in interactive shell mode"
msgstr "Starta Inkscape i interaktivt skal-läge"

#: ../src/inkview-application.cpp:63
msgid "Inkview - An SVG File Viewer"
msgstr "Inkview - en SVG-filvisare"

#: ../src/inkview-application.cpp:79
msgid "Change image every NUMBER seconds"
msgstr "Byt bild var NUMMER:e sekund"

#: ../src/inkview-application.cpp:81
msgid "Preload files"
msgstr "Läs in filer i förväg"

#: ../src/live_effects/effect.cpp:131
msgid "Create interlocking, configurable gears based on the nodes of a path"
msgstr ""
"Skapa sammankopplade, konfigurerbara kugghjul baserat på noderna på en bana"

#: ../src/live_effects/effect.cpp:142
msgctxt "path effect"
msgid "Pattern Along Path"
msgstr "Mönster längs en bana"

#: ../src/live_effects/effect.cpp:174
msgid "Create VonKoch fractal"
msgstr "Skapa Von Koch-fraktal"

