#: ../build/share/filters/filters.svg.h:188
msgid "A volcanic texture, a little like leather"
msgstr "En vulkanisk textur, lite som läder"

#: ../build/share/filters/filters.svg.h:344
msgid ""
"Phantasmagorical turbulent wisps, like Hieronymus Bosch's Garden of Delights"
msgstr ""
"Fantasmagoriska turbulenta strimmor, som Hieronymus Boschs Lustarnas trädgård"

#: ../build/share/filters/filters.svg.h:348
msgid "In and out glow with a possible offset and colorizable flood"
msgstr "Sken inuti och utanför med möjlig förskjutning och färgbar fyllning"

#: ../build/share/filters/filters.svg.h:352
msgid "Emboss effect : 3D relief where white is replaced by black"
msgstr "Präglingseffekt: 3D-relief där vitt ersätts av svart"

#: ../build/share/filters/filters.svg.h:358
msgid "Blotting Paper"
msgstr "Läskpapper"

#: ../build/share/filters/filters.svg.h:360
msgid "Inkblot on blotting paper"
msgstr "Bläckfläck på läskpapper"

# TODO
#: ../build/share/filters/filters.svg.h:322
msgid "Roughen Inside"
msgstr "Rugga upp insidan"

#: ../build/share/filters/filters.svg.h:332
msgid "Low turbulence gives sponge look and high turbulence chalk"
msgstr ""
"Låg turbulens ger ett svampigt utseende och hög turbulens ett kritaktigt"

#: ../build/share/filters/filters.svg.h:336
msgid "Colorized blotches, like a crowd of people"
msgstr "Färgade fläckar, som en grupp människor"

#: ../build/share/filters/filters.svg.h:354
msgid "Bubbly Bumps Matte"
msgstr "Bubbliga matta gupp"

#: ../build/share/filters/filters.svg.h:356
msgid "Same as Bubbly Bumps but with a diffuse light instead of a specular one"
msgstr ""
"Samma som Bubbliga gupp men med ett diffust ljus i stället för ett "
"spegelblankt"

#: ../build/share/filters/filters.svg.h:204
msgid "Silk carpet texture, horizontal stripes"
msgstr "Silkmattetextur, horisontella ränder"

#: ../build/share/filters/filters.svg.h:364
msgid "Wax print on tissue texture"
msgstr "Vaxtryck på silkespappersstruktur"

#: ../build/share/filters/filters.svg.h:268
msgid ""
"Crumpled glossy paper effect which can be used for pictures as for objects"
msgstr ""
"Effekt av skrynklat blankt papper som kan användas för både bilder och objekt"

#: ../build/share/filters/filters.svg.h:282
msgid "Cool Outside"
msgstr "Sval utsida"

#: ../build/share/filters/filters.svg.h:286
msgid "Electronic Microscopy"
msgstr "Elektronmikroskopi"

#: ../build/share/filters/filters.svg.h:288
msgid ""
"Bevel, crude light, discoloration and glow like in electronic microscopy"
msgstr "Fasning, grovt ljus, missfärgning och sken som vid elektronmikroskopi"

#: ../build/share/filters/filters.svg.h:292
msgid "Checkered tartan pattern"
msgstr "Skotskrutigt mönster"

# TODO
#: ../build/share/filters/filters.svg.h:300
msgid "Glowing image content without blurring it"
msgstr "Får bilden att lysa utan att göra den oskarp"

#: ../build/share/filters/filters.svg.h:326
msgid "Evanescent"
msgstr "Flyktig"
