#: ../src/ui/dialog/inkscape-preferences.cpp:3006
msgid ""
"Request that the canvas should be painted with OpenGL rather than Cairo. If "
"OpenGL is unsupported, it will fall back to Cairo."
msgstr ""
"Begär att ritytan ska målas med OpenGL i stället för Cairo. Om OpenGL inte "
"stöds används Cairo i stället."

#: ../src/ui/dialog/inkscape-preferences.cpp:3028
#: ../src/ui/dialog/inkscape-preferences.cpp:3052
msgid "Lower quality (some artifacts), but display is faster"
msgstr "Lägre kvalitet (med vissa artefakter), men visningen är snabbare"

#: ../src/ui/dialog/inkscape-preferences.cpp:3119
msgid "Asynchronous"
msgstr "Asynkron"

#: ../src/ui/dialog/inkscape-preferences.cpp:3119
msgid "Synchronous"
msgstr "Synkron"

#: ../src/ui/dialog/inkscape-preferences.cpp:3124
msgid "Use buffers bigger than the window by this amount"
msgstr "Använd buffertar som är större än fönstret med detta mått"

#: ../src/ui/dialog/inkscape-preferences.cpp:3130
msgid "Min size for coarsener algorithm"
msgstr "Minimistorlek för coarsener-algoritmen"

#: ../src/ui/dialog/inkscape-preferences.cpp:3132
msgid "Glue size for coarsener algorithm"
msgstr "Sammanfogningsstorlek för coarsener-algoritmen"

#: ../src/ui/dialog/inkscape-preferences.cpp:3134
msgid "Min fullness for coarsener algorithm"
msgstr "Minsta fyllnadsgrad för coarsener-algoritmen"

#: ../src/ui/dialog/inkscape-preferences.cpp:3134
msgid ""
"Refuse coarsening algorithm's attempt if the result would be more empty than "
"this."
msgstr ""
"Avvisa coarsener-algoritmens försök om resultatet blir glesare än detta."

#: ../src/ui/dialog/inkscape-preferences.cpp:3148
msgid "Show unclean region"
msgstr "Visa område som behöver ritas om"

#: ../src/ui/dialog/inkscape-preferences.cpp:3150
msgid ""
"Show the region that still contains a saved copy of previously rendered "
"content in blue (only in Cairo mode)"
msgstr ""
"Visa området som fortfarande innehåller en sparad kopia av tidigare renderat "
"innehåll i blått (endast i Cairo-läge)"

#: ../src/ui/dialog/inkscape-preferences.cpp:3152
msgid "Show clean region's fragmentation"
msgstr "Visa fragmenteringen av det rena området"

#: ../src/ui/dialog/inkscape-preferences.cpp:3154
msgid "Temporarily disable the idle redraw process completely"
msgstr "Inaktivera tillfälligt processen för omritning vid inaktivitet helt"

#: ../src/ui/dialog/inkscape-preferences.cpp:3156
msgid "Sticky decoupled mode"
msgstr "Beständigt frikopplat läge"

#: ../src/ui/dialog/inkscape-preferences.cpp:3158
msgid "Continuously adjust viewing parameters in an animation loop."
msgstr "Justera visningsparametrarna kontinuerligt i en animationsslinga."

#: ../src/ui/dialog/inkscape-preferences.cpp:3179
msgid "Automatically reload linked images when file is changed on disk"
msgstr "Läs automatiskt in länkade bilder igen när filen ändras på disk"

#: ../src/ui/dialog/inkscape-preferences.cpp:3185
msgid "_SVG editor:"
msgstr "_SVG-redigerare:"

#: ../src/ui/dialog/inkscape-preferences.cpp:3197
msgid "Pop-up linking and scaling dialog when importing bitmap image."
msgstr "Visa dialogrutan för länkning och skalning när en rasterbild importeras."

#: ../src/ui/dialog/inkscape-preferences.cpp:3200
msgid "Pop-up linking and scaling dialog when importing SVG image."
msgstr "Visa dialogrutan för länkning och skalning när en SVG-bild importeras."
