msgid ""
"Drop onto the hovered item from the selected item, instead of the other way "
"around"
msgstr "Släpp från det valda objektet på objektet under pekaren, i stället för tvärtom"

msgid "Apply color to stroke"
msgstr "Använd färgen för strecket"

msgid "Apply style to item"
msgstr "Tillämpa stil på objekt"

msgid "Replace only the first color in drag"
msgstr "Ersätt bara den första färgen vid dragning"

msgid ""
"Replace only the initial color from drag throughout the drag"
msgstr "Ersätt bara den ursprungliga färgen under hela dragningen"

msgid "Move handles together"
msgstr "Flytta handtagen tillsammans"

msgid "Open position dialog"
msgstr "Öppna positionsdialogrutan"

msgid "When dragging a B-Spline segment, create and/or move handles instead"
msgstr "När du drar ett B-spline-segment skapas eller flyttas handtag i stället"

msgid "Drag handle from node"
msgstr "Dra ut handtag från en nod"

msgid "Linear node selection"
msgstr "Linjär nodmarkering"

msgid "Select the next nodes with scroll wheel or keyboard"
msgstr "Välj följande noder med rullningshjul eller tangentbord"

msgid "Spatial node selection"
msgstr "Rumslig nodmarkering"

msgid "Inverted node selection"
msgstr "Omvänt nodval"

msgid "Remove nodes from selection"
msgstr "Ta bort noder från markeringen"

msgid "Retract handle into node"
msgstr "Dra in handtag i nod"

msgid "Straighten segment when double-clicked"
msgstr "Räta ut segment vid dubbelklick"

msgid "Reverse the direction of the tweak"
msgstr "Vänd på justeringens riktning"

msgid "Canvas"
msgstr "Rityta"

msgid "Movement"
msgstr "Förflyttning"

msgid ""
"Adjust the <b>width and height</b> of the rectangle; with <b>%1</b> to lock "
"ratio or stretch in one dimension only"
msgstr ""
"Justera rektangelns <b>bredd och höjd</b>; använd <b>%1</b> för att låsa "
"proportionerna eller sträcka ut i en enda riktning"

msgid ""
"Resize box in X/Y direction; with <b>%1</b> along the Z axis; with <b>%2</b> "
"to constrain to the directions of edges or diagonals"
msgstr ""
"Ändra rutans storlek i X/Y-riktningen; använd <b>%1</b> längs Z-axeln och "
"<b>%2</b> för att begränsa till kant- eller diagonalriktningarna"

msgid ""
"Resize box along the Z axis; with <b>%1</b> in X/Y direction; with <b>%2</b> "
"to constrain to the directions of edges or diagonals"
msgstr ""
"Ändra rutans storlek längs Z-axeln; använd <b>%1</b> i X/Y-riktningen och "
"<b>%2</b> för att begränsa till kant- eller diagonalriktningarna"
