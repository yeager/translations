#: ../src/actions/actions-object-align.cpp:793
msgid "Enable on-canvas alignment"
msgstr "Aktivera justering på ritytan"

#: ../src/actions/actions-object-align.cpp:793
#: ../share/ui/align-and-distribute.ui:117
msgid "Enable on-canvas alignment handles"
msgstr "Aktivera justeringshandtag på ritytan"

#: ../src/actions/actions-object-align.cpp:800
msgid "Align selection vertically to top edge"
msgstr "Justera markeringen lodrätt mot överkanten"

#: ../src/actions/actions-object-align.cpp:801
msgid "Align selection vertically to bottom edge"
msgstr "Justera markeringen lodrätt mot nederkanten"

#: ../src/actions/actions-object-align.cpp:821
#: ../share/ui/align-and-distribute.ui:666 ../share/ui/toolbar-connector.ui:104
msgid "Nicely arrange selected connector network"
msgstr "Ordna markerade anslutningsnätverk snyggt"

#: ../src/actions/actions-object-align.cpp:822
msgid "Exchange in selection order"
msgstr "Byt plats i markeringsordning"

#: ../src/actions/actions-object-align.cpp:822
#: ../share/ui/align-and-distribute.ui:686
msgid "Exchange positions of selected objects - selection order"
msgstr "Byt plats på markerade objekt i markeringsordning"

#: ../src/actions/actions-object-align.cpp:823
msgid "Exchange in z-order"
msgstr "Byt plats i staplingsordning"

#: ../src/actions/actions-object-align.cpp:823
#: ../share/ui/align-and-distribute.ui:706
msgid "Exchange positions of selected objects - stacking order"
msgstr "Byt plats på markerade objekt i staplingsordning"

#: ../src/actions/actions-object-align.cpp:824
msgid "Exchange around center"
msgstr "Byt plats runt mittpunkten"

#: ../src/actions/actions-object-align.cpp:824
#: ../share/ui/align-and-distribute.ui:726
msgid "Exchange positions of selected objects - rotate around center point"
msgstr "Byt plats på markerade objekt genom att rotera runt mittpunkten"

#: ../src/actions/actions-object-align.cpp:825
msgid "Random exchange"
msgstr "Byt plats slumpmässigt"

#: ../src/actions/actions-object-align.cpp:825
#: ../share/ui/align-and-distribute.ui:746
msgid "Randomize centers in both dimensions"
msgstr "Slumpa mittpunkterna i båda riktningarna"

#: ../src/actions/actions-object-align.cpp:826
#: ../share/ui/align-and-distribute.ui:766
msgid "Unclump objects: try to equalize edge-to-edge distances"
msgstr "Fördela objekten jämnt: försök att jämna ut avstånden mellan kanterna"
