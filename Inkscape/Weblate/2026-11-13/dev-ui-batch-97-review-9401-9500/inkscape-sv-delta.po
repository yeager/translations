msgid ""
msgstr ""
"Project-Id-Version: Inkscape\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: sv\n"

msgid "{} is now a method in the SvgDocumentElement class. Use `self.svg.uutounit(value, unit)` instead."
msgstr "{} är nu en metod i klassen SvgDocumentElement. Använd `self.svg.uutounit(value, unit)` i stället."

msgid "{} is now a method in the SvgDocumentElement class. Use `self.svg.add_unit(value)` instead."
msgstr "{} är nu en metod i klassen SvgDocumentElement. Använd `self.svg.add_unit(value)` i stället."

msgid "Attribute \"xlink:href\" not set on node {}."
msgstr "Attributet \"xlink:href\" saknas på nod {}."

msgid "An error occurred during document preparation"
msgstr "Ett fel inträffade vid förberedelsen av dokumentet"

msgid "There is no selection to interpolate"
msgstr "Det finns ingen markering att interpolera"

msgid ""
"To assign an effect, please select an object.\n"
"\n"
msgstr ""
"Välj ett objekt för att tilldela en effekt.\n"
"\n"

msgid "The JessyInk script is not installed in this SVG file or has a different version than the JessyInk extensions. Please select \"install/update...\" from the \"JessyInk\" sub-menu of the \"Extensions\" menu to install or update the JessyInk script.\n\n"
msgstr "JessyInk-skriptet är inte installerat i den här SVG-filen eller har en annan version än JessyInk-tilläggen. Välj \"Installera/uppdatera...\" från undermenyn \"JessyInk\" i menyn \"Tillägg\" för att installera eller uppdatera JessyInk-skriptet.\n\n"

msgid "JessyInk script version {} installed."
msgstr "JessyInk-skript version {} installerades."

msgid "JessyInk script installed."
msgstr "JessyInk-skriptet installerades."

msgid " using effect \"{0}\""
msgstr " med effekten \"{0}\""

msgid "Export exists ({}), not overwriting"
msgstr "Exportfilen finns redan ({}); skriver inte över den"

msgid "unable to locate marker: %s"
msgstr "Det går inte att hitta markören: %s"

msgid "Chart-Layer: {}"
msgstr "Diagramlager: {}"

msgid "Unknown input type"
msgstr "Okänd indatatyp"

msgid ""
"Failed to import module 'packaging'.\n"
"Please make sure it is installed (e.g. using 'pip install packaging'\n"
"or 'sudo apt-get install python3-packaging') and try again.\n"
msgstr ""
"Det gick inte att importera modulen \"packaging\".\n"
"Kontrollera att den är installerad (t.ex. med \"pip install packaging\"\n"
"eller \"sudo apt-get install python3-packaging\") och försök igen.\n"

msgid ""
"Failed to import module 'scour'.\n"
"Please make sure it is installed (e.g. using 'pip install scour'\n"
"  or 'sudo apt-get install python3-scour') and try again.\n"
msgstr ""
"Det gick inte att importera modulen \"scour\".\n"
"Kontrollera att den är installerad (t.ex. med \"pip install scour\"\n"
"  eller \"sudo apt-get install python3-scour\") och försök igen.\n"

msgid "You must select two objects only."
msgstr "Du måste välja exakt två objekt."

msgid "This extension requires that the second path be four nodes long."
msgstr "Detta tillägg kräver att den andra banan består av fyra noder."

msgid "Selection contains non-symetric scaling"
msgstr "Markeringen innehåller asymmetrisk skalning"

msgid "Selection contains non-symetric scaling, can't snap stroke width"
msgstr "Markeringen innehåller asymmetrisk skalning; det går inte att fästa streckbredden"

msgid "Can't find wavefront object file {}"
msgstr "Det går inte att hitta Wavefront-objektfilen {}"

msgid ""
"The optipng command failed, possibly due to a mismatch of theinterlacing and compression level options. Please try to disable \"Interlaced\" or set \"Level\" to 1 or higher."
msgstr "Kommandot optipng misslyckades, möjligen på grund av att alternativen för sammanflätning och komprimeringsnivå inte stämmer överens. Försök att inaktivera \"Interlaced\" eller ställ in \"Level\" på 1 eller högre."

msgid "Wrong symbol '{}' in alphanumeric representation: Should be [A-Z, 0-9] or {}"
msgstr "Fel symbol '{}' i den alfanumeriska representationen: ska vara [A-Z, 0-9] eller {}"

msgid "Please enter an input text"
msgstr "Ange en indatatext"

msgid "Can't find symbol {}"
msgstr "Det går inte att hitta symbolen {}"

msgid "Couldn't find anything using that font, please ensure the spelling and spacing is correct."
msgstr "Det gick inte att hitta något med det typsnittet. Kontrollera att stavning och mellanrum är korrekta."

msgid "Nothing to do, no action specified."
msgstr "Det finns inget att göra, ingen åtgärd har angetts."

msgid "Could not detect Scribus version ()"
msgstr "Kunde inte identifiera Scribus-versionen ()"

msgid "Found Scribus {}. This extension requires Scribus 1.5.x."
msgstr "Scribus {} hittades. Detta tillägg kräver Scribus 1.5.x."
