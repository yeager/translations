msgid "Drawing cancelled"
msgstr "Ritningen avbröts"

msgid "Appending to selected path"
msgstr "Lägger till i vald bana"

msgid ""
"<b>Curve handle</b>: angle %%3.2f&#176;, length %%s; with <b>%1</b> to snap "
"angle"
msgstr ""
"<b>Kurvhandtag</b>: vinkel %%3.2f&#176;, längd %%s; med <b>%1</b> för att "
"fästa vinkeln"

msgid ""
"<b>Curve handle, symmetric</b>: angle %%3.2f&#176;, length %%s; with <b>%1</"
"b> to snap angle, with <b>Shift</b> to move this handle only"
msgstr ""
"<b>Kurvhandtag, symmetriskt</b>: vinkel %%3.2f&#176;, längd %%s; med <b>%1</"
"b> för att fästa vinkeln, med <b>Skift</b> för att endast flytta handtaget"

msgid ""
"<b>Curve handle</b>: angle %%3.2f&#176;, length %%s; with <b>%1</b> to snap "
"angle, with <b>Shift</b> to move this handle only"
msgstr ""
"<b>Kurvhandtag</b>: vinkel %%3.2f&#176;, längd %%s; med <b>%1</b> för att "
"fästa vinkeln, med <b>Skift</b> för att endast flytta handtaget"

msgid "Drawing finished"
msgstr "Ritningen är klar"

msgid "Drawing a freehand path"
msgstr "Ritar en frihandsbana"

msgid "Finishing freehand"
msgstr "Avslutar frihandsteckning"

msgid "Finishing freehand sketch"
msgstr "Avslutar frihandsskissen"

msgid ""
"<b>Rectangle</b>: %s &#215; %s (constrained to golden ratio 1.618 : 1); with "
"<b>%s</b> to draw around the starting point"
msgstr ""
"<b>Rektangel</b>: %s &#215; %s (begränsad till gyllene snittet 1,618 : 1); "
"med <b>%s</b> för att rita runt startpunkten"

msgid ""
"<b>Rectangle</b>: %s &#215; %s (constrained to golden ratio 1 : 1.618); with "
"<b>%s</b> to draw around the starting point"
msgstr ""
"<b>Rektangel</b>: %s &#215; %s (begränsad till gyllene snittet 1 : 1,618); "
"med <b>%s</b> för att rita runt startpunkten"

msgid ""
"<b>Rectangle</b>: %s &#215; %s; with <b>%s</b> to make square, integer-"
"ratio, or golden-ratio rectangle; with <b>%s</b> to draw around the starting "
"point"
msgstr ""
"<b>Rektangel</b>: %s &#215; %s; med <b>%s</b> för att skapa en kvadrat, en "
"rektangel med heltalsförhållande eller en rektangel enligt det gyllene "
"snittet; med <b>%s</b> för att rita runt startpunkten"

msgid "Click selection again to toggle scale/rotation handles"
msgstr "Klicka på markeringen igen för att växla skal- och rotationshandtag"

msgid "Move canceled."
msgstr "Flyttningen avbröts."

msgid "Selection canceled."
msgstr "Markeringen avbröts."

#, c-format
msgid ""
"<b>Draw over</b> objects to select them; press <b>%s</b> to deselect them; "
"release <b>%s</b> to switch to rubberband selection"
msgstr ""
"<b>Dra över</b> objekt för att markera dem; tryck på <b>%s</b> för att "
"avmarkera dem; släpp <b>%s</b> för att växla till gummibandsmarkering"

#, c-format
msgid ""
"<b>Drag near</b> objects to select them; press <b>%s</b> to deselect them; "
"press <b>%s</b> to switch to touch selection"
msgstr ""
"<b>Dra nära</b> objekt för att markera dem; tryck på <b>%s</b> för att "
"avmarkera dem; tryck på <b>%s</b> för att växla till beröringsmarkering"

#, c-format
msgid ""
"<b>Drag around</b> objects to select them; press <b>%s</b> to deselect them; "
"press <b>%s</b> to switch to touch selection"
msgstr ""
"<b>Dra runt</b> objekt för att markera dem; tryck på <b>%s</b> för att "
"avmarkera dem; tryck på <b>%s</b> för att växla till beröringsmarkering"

msgid "Selected object is not a group. Cannot enter."
msgstr "Det markerade objektet är inte en grupp. Det går inte att gå in i det."

msgid "Quick Pan Canvas"
msgstr "Snabbpanorera ritytan"

msgid "Focus First Widget"
msgstr "Fokusera första inmatningsfältet"

msgid "Focus the first input widget in the active tool's toolbar."
msgstr "Fokusera det första inmatningsfältet i det aktiva verktygets verktygsfält."

msgid "Scale Objects"
msgstr "Skala objekt"

#, c-format
msgid ""
"%s. Drag, click or click and scroll to spray <b>copies</b> of the initial "
"selection. Right-click + move to update single click item."
msgstr ""
"%s. Dra, klicka eller klicka och rulla för att spraya <b>kopior</b> av den "
"ursprungliga markeringen. Högerklicka och dra för att uppdatera objektet vid "
"ett enda klick."

#, c-format
msgid ""
"%s. Drag, click or click and scroll to spray <b>clones</b> of the initial "
"selection. Right-click + move to update single click item."
msgstr ""
"%s. Dra, klicka eller klicka och rulla för att spraya <b>kloner</b> av den "
"ursprungliga markeringen. Högerklicka och dra för att uppdatera objektet vid "
"ett enda klick."

#, c-format
msgid ""
"%s. Drag, click or click and scroll to spray into a <b>single path</b>. "
"Right-click + move to update single click item."
msgstr ""
"%s. Dra, klicka eller klicka och rulla för att spraya in i <b>en enda bana</"
"b>. Högerklicka och dra för att uppdatera objektet vid ett enda klick."

