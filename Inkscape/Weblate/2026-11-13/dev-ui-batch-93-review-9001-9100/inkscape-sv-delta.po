"Language: sv\n"

msgid ""
"Toggle vanishing point in x-direction between 'finite' and 'infinite' (= "
"parallel)"
msgstr ""
"Växla flyktpunkt i x-riktningen mellan ”ändlig” och ”oändlig” (= parallell)"

msgid ""
"Toggle vanishing point in y-direction between 'finite' and 'infinite' (= "
"parallel)"
msgstr ""
"Växla flyktpunkt i y-riktningen mellan ”ändlig” och ”oändlig” (= parallell)"

msgid ""
"Toggle vanishing point in z-direction between 'finite' and 'infinite' (= "
"parallel)"
msgstr ""
"Växla flyktpunkt i z-riktningen mellan ”ändlig” och ”oändlig” (= parallell)"

msgid "The width of the calligraphic pen (relative to the visible canvas area)"
msgstr "Bredden på kalligrafipennan (relativt till det synliga rityteområdet)"

msgid "Tremor"
msgstr "Darrning"

msgid "Wiggle"
msgstr "Vinglighet"

msgid "Make connector orthogonal or polyline"
msgstr "Gör anslutningen ortogonal eller till en polylinje"

msgid "The amount of space left around objects by auto-routing connectors"
msgstr "Avståndet som automatiskt dragna anslutningar lämnar runt objekt"

msgid ""
"Pick both the color and the alpha (transparency) under cursor; otherwise, "
"pick only the visible color premultiplied by alpha"
msgstr ""
"Välj både färg och alfa (genomskinlighet) under markören. Annars väljs "
"endast den synliga färgen som har premultiplicerats med alfa"

msgid ""
"If alpha was picked, assign it to selection as fill or stroke transparency"
msgstr ""
"Om alfa har valts tilldelas det markeringen som fyllnings- eller "
"streckopacitet"

msgid "The width of the eraser pen (relative to the visible canvas area)"
msgstr "Bredden på suddarpennan (relativt till det synliga rityteområdet)"

msgid "Increase to make the eraser slowed by inertia"
msgstr "Öka för att få suddarpennan att släpa efter av tröghet"

msgid "Width of selection"
msgstr "Markeringens bredd"

msgid "Insert new stop"
msgstr "Infoga nytt gradientstopp"

msgid "Delete stop"
msgstr "Ta bort gradientstopp"

msgid "Open LPE dialog (to adapt parameters numerically)"
msgstr "Öppna dialogrutan Baneffekt (LPE) för att anpassa parametrar numeriskt"

msgid "Edit marker on canvas."
msgstr "Redigera markör på ritytan."
