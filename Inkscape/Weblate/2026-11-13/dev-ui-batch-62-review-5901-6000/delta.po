#: ../src/ui/dialog/inkscape-preferences.cpp:1615
msgid "Odia (or)"
msgstr "Odia (or)"

#: ../src/ui/dialog/inkscape-preferences.cpp:1618
msgid "Santali (sat)"
msgstr "Santali (sat)"

#: ../src/ui/dialog/inkscape-preferences.cpp:1682
msgid "Clear list"
msgstr "Töm listan"

#: ../src/ui/dialog/inkscape-preferences.cpp:1685
msgid ""
"Maximum documents\n"
" in Open _Recent:"
msgstr ""
"Maximalt antal dokument\n"
" i Öppna s_enaste:"

#: ../src/ui/dialog/inkscape-preferences.cpp:1686
msgid ""
"Set the maximum length of the Open Recent list in the File menu, or clear "
"the list"
msgstr ""
"Ange det högsta antalet dokument i listan Öppna senaste på Arkivmenyn, eller "
"töm listan"

#: ../src/ui/dialog/inkscape-preferences.cpp:1689
msgid ""
"Adjust the slider until the length of the ruler on your screen matches its "
"real length. This information is used when zooming to 1:1, 1:2, etc., to "
"display objects in their true sizes"
msgstr ""
"Justera reglaget tills längden på linjalen på skärmen motsvarar dess "
"faktiska längd. Informationen används vid zoomning till 1:1, 1:2 och så "
"vidare för att visa objekt i deras faktiska storlek"

#: ../src/ui/dialog/inkscape-preferences.cpp:1693
msgid "Show zoom percentage corrected by factor"
msgstr "Visa zoomprocenten korrigerad med en faktor"

#: ../src/ui/dialog/inkscape-preferences.cpp:1696
msgid "Lock canvas rotation by default"
msgstr "Lås ritytans rotation som standard"

#: ../src/ui/dialog/inkscape-preferences.cpp:1698
msgid ""
"Prevent accidental canvas rotation by disabling on-canvas keyboard and mouse "
"actions for rotation"
msgstr ""
"Förhindra oavsiktlig rotation av ritytan genom att inaktivera tangentbords- "
"och musåtgärder för rotation på ritytan"

#: ../src/ui/dialog/inkscape-preferences.cpp:1700
msgid "Show selection in ruler"
msgstr "Visa markering på linjalen"

#: ../src/ui/dialog/inkscape-preferences.cpp:1706
msgid "Set the relative size of node handles"
msgstr "Ange relativ storlek på nodhandtag"

#: ../src/ui/dialog/inkscape-preferences.cpp:1740
msgid "Handle colors"
msgstr "Handtagsfärger"

#: ../src/ui/dialog/inkscape-preferences.cpp:1742
msgid "Use narrow number entry boxes"
msgstr "Använd smala talinmatningsfält"

#: ../src/ui/dialog/inkscape-preferences.cpp:1743
msgid "Make number editing boxes smaller by limiting padding"
msgstr "Gör talinmatningsfälten mindre genom att minska utfyllnaden"

#: ../src/ui/dialog/inkscape-preferences.cpp:1751
msgid "Set whether the GTK interface animations are enabled"
msgstr "Anger om animeringar i GTK-gränssnittet är aktiverade"

#: ../src/ui/dialog/inkscape-preferences.cpp:1759
msgid "Control visibility of current fill, stroke and opacity in status bar."
msgstr "Styr synligheten av aktuell fyllning, streck och opacitet i statusfältet."

#: ../src/ui/dialog/inkscape-preferences.cpp:1762
msgid "Control visibility of layer selection menu in status bar."
msgstr "Styr synligheten av menyn för lagerval i statusfältet."

#: ../src/ui/dialog/inkscape-preferences.cpp:1765
msgid "Control visibility of mouse coordinates X & Y in status bar."
msgstr "Styr synligheten av muskoordinaterna X och Y i statusfältet."

#: ../src/ui/dialog/inkscape-preferences.cpp:1767
msgid "Show snapshot buttons"
msgstr "Visa knappar för ögonblicksbilder"

#: ../src/ui/dialog/inkscape-preferences.cpp:1768
msgid "Control visibility of canvas snapshot controls."
msgstr "Styr synligheten av ritytans kontroller för ögonblicksbilder."

#: ../src/ui/dialog/inkscape-preferences.cpp:1771
msgid "Control visibility of canvas rotation in status bar."
msgstr "Styr synligheten av ritytans rotation i statusfältet."

#: ../src/ui/dialog/inkscape-preferences.cpp:1775
msgid ""
"When off, cursor scaling is disabled. Cursor scaling may be broken when "
"fractional scaling is enabled."
msgstr ""
"När alternativet är avstängt är markörskalning inaktiverad. Markörskalning "
"kan fungera felaktigt när fraktionerad skalning är aktiverad."

#: ../src/ui/dialog/inkscape-preferences.cpp:1822
msgid "Reset font size to 100%"
msgstr "Återställ typsnittsstorlek till 100 %"

#: ../src/ui/dialog/inkscape-preferences.cpp:1913
msgid "Base color for icons"
msgstr "Grundfärg för ikoner"

#: ../src/ui/dialog/inkscape-preferences.cpp:1920
msgid "Highlight colors supported by some symbolic icon themes"
msgstr "Framhävningsfärger som stöds av vissa symboliska ikonteman"
