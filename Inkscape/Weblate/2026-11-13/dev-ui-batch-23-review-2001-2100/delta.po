#: ../src/actions/actions-output.cpp:283
msgid "Export Use Hints"
msgstr "Använd sparade tips vid export"

#: ../src/actions/actions-output.cpp:286
msgid "Export PNG Color Mode"
msgstr "PNG-färgläge för export"

#: ../src/actions/actions-output.cpp:288
msgid "Export PNG Compression"
msgstr "PNG-komprimering för export"

#: ../src/actions/actions-output.cpp:289
msgid "Export PNG Antialiasing"
msgstr "PNG-kantutjämning för export"

#: ../src/actions/actions-output.cpp:315
msgid "Enter 1/0 for Yes/No to export ignoring filters"
msgstr "Ange 1/0 för Ja/Nej för att exportera utan filter"

#: ../src/actions/actions-output.cpp:319
msgid "Enter string for page numbers e.g. '1', '1-3' or '2,4'"
msgstr "Ange sträng för sidnummer, t.ex. \"1\", \"1-3\" eller \"2,4\""

#: ../src/actions/actions-pages.cpp:36
msgctxt "Undo"
msgid "Duplicate Page"
msgstr "Duplicerade sida"

#: ../src/actions/actions-pages.cpp:63 ../src/ui/tools/pages-tool.cpp:426
msgctxt "Undo"
msgid "Delete Page"
msgstr "Tog bort sida"

#: ../src/actions/actions-pages.cpp:81
msgctxt "Undo"
msgid "Shift Page Backwards"
msgstr "Flyttade sida bakåt"

#: ../src/actions/actions-pages.cpp:91
msgctxt "Undo"
msgid "Shift Page Forwards"
msgstr "Flyttade sida framåt"

#: ../src/actions/actions-pages.cpp:118
msgid "Move Objects with Page"
msgstr "Flytta objekt med sidan"

#: ../src/actions/actions-pages.cpp:119
msgid "Move Before Previous"
msgstr "Flytta före föregående"

#: ../src/actions/actions-pages.cpp:149
msgid "Delete the selected page and center view on next page"
msgstr "Ta bort den markerade sidan och centrera vyn på nästa sida"

#: ../src/actions/actions-paths.cpp:260
msgid "Create a fill object using the selected paths"
msgstr "Skapa ett fyllningsobjekt med hjälp av de markerade banorna"

#: ../src/actions/actions-paths.cpp:264
msgid "Offset selected paths"
msgstr "Förskjut markerade banor"

#: ../src/actions/actions-output.cpp:323
msgid ""
"Enter number for background opacity, either between 0.0 and 1.0, or 1 up to "
"255"
msgstr ""
"Ange ett tal för bakgrundsopacitet, antingen mellan 0.0 och 1.0 eller mellan "
"1 och 255"
