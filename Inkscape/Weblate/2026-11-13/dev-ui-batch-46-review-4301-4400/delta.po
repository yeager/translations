#: ../src/live_effects/lpe-measure-segments.cpp:104
#: ../src/live_effects/lpe-roughen.cpp:53
msgid ""
"Add nodes to path evenly. Choose <b>Segment size</b> method from the "
"dropdown to use this subdivision method."
msgstr ""
"Lägg till noder jämnt längs banan. Välj metoden <b>Segmentstorlek</b> i "
"rullgardinsmenyn för att använda den här indelningsmetoden."

#: ../src/live_effects/lpe-roughen.cpp:60
msgid ""
"Uncheck to use this LPE for just adding nodes, without roughening; useful "
"for further interactive processing."
msgstr ""
"Avmarkera om du vill använda den här baneffekten (LPE) för att bara lägga "
"till noder utan att göra banan grövre. Användbart för vidare interaktiv "
"bearbetning."

#: ../src/live_effects/lpe-roughen.cpp:62
msgid "Spray Tool friendly"
msgstr "Anpassad för sprayverktyget"

#: ../src/live_effects/lpe-roughen.cpp:62
msgid "For use with Spray Tool in copy mode"
msgstr "För användning med sprayverktyget i kopieringsläge"

#: ../src/live_effects/lpe-ruler.cpp:46
#, no-c-format
msgid "Space between path and minor ruler mark, % of mark length"
msgstr "Avstånd mellan banan och den mindre linjalmarkeringen, i % av markeringens längd"

#: ../src/live_effects/lpe-ruler.cpp:50
#, no-c-format
msgid "Space between path and major ruler mark, % of mark length"
msgstr "Avstånd mellan banan och den större linjalmarkeringen, i % av markeringens längd"

#: ../src/live_effects/lpe-ruler.cpp:53
msgid "Mark angle:"
msgstr "Markeringsvinkel:"

#: ../src/live_effects/lpe-ruler.cpp:54
msgid "Shift marks _by:"
msgstr "Förskjut markeringar _med:"

#: ../src/live_effects/lpe-ruler.cpp:55
msgid "Mark direction:"
msgstr "Markeringsriktning:"

#: ../src/live_effects/lpe-simplify.cpp:32
msgid "Simplify paths separately"
msgstr "Förenkla banor separat"

#: ../src/live_effects/lpe-simplify.cpp:32
msgid ""
"Simplify each path individually. This maintains detail in complex shapes."
msgstr ""
"Förenkla varje bana separat. Det bevarar detaljer i komplexa former."

#: ../src/live_effects/lpe-simplify.cpp:34
msgid "Just coalesce"
msgstr "Bara sammanfoga"

#: ../src/live_effects/lpe-simplify.cpp:34
msgid "Simplify just coalesce"
msgstr "Förenkla endast genom att sammanfoga"

#: ../src/live_effects/lpe-sketch.cpp:37
msgid "Stroke length max."
msgstr "Maximal strecklängd."

#: ../src/live_effects/lpe-sketch.cpp:42
msgid "How much successive strokes should overlap (relative to maximum length)"
msgstr "Hur mycket efterföljande streck ska överlappa (i förhållande till maximal längd)"

#: ../src/live_effects/lpe-sketch.cpp:43
msgid "Overlap"
msgstr "Överlappning"

#: ../src/live_effects/lpe-sketch.cpp:44
msgid "Random variation of overlap (relative to maximum overlap)"
msgstr "Slumpmässig variation av överlappning (i förhållande till maximal överlappning)"

#: ../src/live_effects/lpe-sketch.cpp:48
msgid "Maximum tremble magnitude"
msgstr "Maximal skakningsamplitud"

#: ../src/live_effects/lpe-sketch.cpp:62
msgid "0: evenly distributed construction lines, 1: purely random placement"
msgstr "0: jämnt fördelade konstruktionslinjer, 1: helt slumpmässig placering"

#: ../src/live_effects/lpe-sketch.cpp:65
msgid "min curvature"
msgstr "minsta krökning"

#: ../src/live_effects/lpe-sketch.cpp:66
msgid "max curvature"
msgstr "maximal krökning"

#: ../src/live_effects/lpe-slice.cpp:58
msgid "Slice line start"
msgstr "Snittlinjens start"
