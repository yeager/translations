msgid ""
msgstr ""
"Project-Id-Version: Inkscape 1.4.x\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: sv\n"

msgid "'%s' complete, loading result..."
msgstr "'%s' är klar, läser in resultat ..."

msgid "out of %i"
msgstr "av %i"

msgid "Twitter card image"
msgstr "Bild för Twitter-kort"

msgid "Twitter header"
msgstr "Twitter-rubrik"

msgid "Twitter post image"
msgstr "Bild för Twitter-inlägg"

msgid "Twitter profile picture"
msgstr "Profilbild på Twitter"

msgid "Twitter video landscape"
msgstr "Liggande Twitter-video"

msgid "Twitter video portrait"
msgstr "Stående Twitter-video"

msgid "Twitter video square"
msgstr "Kvadratisk Twitter-video"

msgid "No Inkscape extension found to save document (%s). This may have been caused by an unknown or missing filename extension."
msgstr "Inget Inkscape-tillägg hittades för att spara dokumentet (%s). Detta kan bero på en okänd eller saknad filnamnsändelse."

msgid "Reverse gradient"
msgstr "Vänd på gradient"

msgid "Added patch row or column"
msgstr "Lade till rad eller kolumn med nätfält"

msgid "%s %d for: %s%s; drag with <b>Ctrl</b> to snap offset; click with <b>Ctrl+Alt</b> to delete stop"
msgstr "%s %d för: %s%s; dra med <b>Ctrl</b> för att fästa förskjutningen; klicka med <b>Ctrl+Alt</b> för att ta bort stopp"

msgid "%s for: %s%s; drag with <b>Ctrl</b> to snap angle, with <b>Ctrl+Alt</b> to preserve angle, with <b>Ctrl+Shift</b> to scale around center"
msgstr "%s för: %s%s; dra med <b>Ctrl</b> för att fästa vinkeln, med <b>Ctrl+Alt</b> för att behålla vinkeln, med <b>Ctrl+Skift</b> för att skala runt mitten"

msgid "Fixup broken links"
msgstr "Reparera trasiga länkar"

msgid "With LPE's"
msgstr "Med LPE:er"

msgid "Without LPE's"
msgstr "Utan LPE:er"

msgid "Item from which to take the original data"
msgstr "Objekt vars ursprungliga data ska användas"

msgid "No Shape Sync to Current"
msgstr "Ingen formsynkronisering med aktuell"

msgid "The path that will be used as stitch"
msgstr "Banan som används som stygn"

msgid "The amount of random jitter to move the start points of the stitches inside & outside the guide path"
msgstr "Mängden slumpmässig avvikelse för att flytta stygnens startpunkter inom och utanför hjälpbanan"

msgid "The amount of randomness that moves the end points of the stitches inside & outside the guide path"
msgstr "Mängden slumpmässig avvikelse som flyttar stygnens slutpunkter inom och utanför hjälpbanan"

msgid "Change knot crossing"
msgstr "Ändra knutkorsning"

msgid "Center Vertical"
msgstr "Centrera lodrätt"

msgid "Center Horizontal"
msgstr "Centrera vågrätt"

msgid "Change number of repeats of simplifying operation. Useful for complex paths that need to be significantly simplified."
msgstr "Ändra antalet upprepningar av förenklingsoperationen. Detta är användbart för komplexa banor som behöver förenklas avsevärt."

msgid "Paths separately"
msgstr "Banor var för sig"

msgid "When there are multiple paths in the selection, simplify each one separately."
msgstr "När det finns flera banor i urvalet förenklar du var och en separat."

msgid "Change bool parameter"
msgstr "Ändra boolesk parameter"

msgid "Change color button parameter"
msgstr "Ändra färgknappsparameter"

msgid "Paste path parameter"
msgstr "Klistra in banparameter"

msgid "Remove path"
msgstr "Ta bort banan"

msgid "Change random parameter"
msgstr "Ändra slumpmässighetsparameter"

msgid "Link itemarray parameter to item"
msgstr "Länka itemarray-parametern till objektet"
