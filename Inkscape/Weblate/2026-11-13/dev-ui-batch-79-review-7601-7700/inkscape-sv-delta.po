msgid "<b>Space+mouse move</b> to pan canvas"
msgstr "<b>Mellanslag+musflyttning</b> för att panorera ritytan"

msgid ""
"<b>Drag</b> to draw a calligraphic stroke; with <b>%1</b> to track a guide "
"path. <b>Arrow keys</b> adjust width (left/right) and angle (up/down)."
msgstr ""
"<b>Dra</b> för att rita ett kalligrafiskt streck; med <b>%1</b> för att "
"följa en hjälpbana. <b>Piltangenter</b> justerar bredd (vänster/höger) och "
"vinkel (upp/ned)."

msgid ""
"<b>Drag</b> to measure the dimensions of objects.  Press <b>Alt+C</b> to "
"copy the length to the clipboard."
msgstr ""
"<b>Dra</b> för att mäta dimensionerna på objekt. Tryck på <b>Alt+C</b> för "
"att kopiera längden till urklippet."

msgid ""
"<b>Click</b> to set fill, <b>%1+Click</b> to set stroke; <b>drag</b> to "
"average color in area; with <b>%2</b> to pick inverse color; <b>Ctrl+C</b> "
"to copy the color under mouse to clipboard"
msgstr ""
"<b>Klicka</b> för att ställa in fyllning, <b>%1+klicka</b> för att ställa in "
"streck; <b>dra</b> för att beräkna medelfärg i ett område; med <b>%2</b> för "
"att välja den inverterade färgen; <b>Ctrl+C</b> för att kopiera färgen under "
"muspekaren till urklippet"

msgid "To tweak a path by pushing, select it and drag over it."
msgstr "Markera en bana och dra över den för att justera den genom att trycka."

#, c-format
msgid "%s. Drag or click to <b>attract paths</b>; with %s to <b>repel</b>."
msgstr "%s. Dra eller klicka för att <b>dra till dig banor</b>; med %s för att <b>stöta bort</b>."

#, c-format
msgid "%s. Drag or click to <b>roughen paths</b>."
msgstr "%s. Dra eller klicka för att <b>göra banor grovare</b>."

