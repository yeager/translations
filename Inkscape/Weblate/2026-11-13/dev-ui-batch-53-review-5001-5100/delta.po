#: ../src/ui/dialog/clonetiler.cpp:115
msgid "<b>P1</b>: simple translation"
msgstr "<b>P1</b>: enkel förskjutning"

#: ../src/ui/dialog/clonetiler.cpp:140
msgid "Select one of the 17 symmetry groups for the tiling"
msgstr "Välj en av de 17 symmetrigrupperna för plattsättningen"

#: ../src/ui/dialog/clonetiler.cpp:182
#, no-c-format
msgid "Horizontal shift per row (in % of tile width)"
msgstr "Horisontell förskjutning per rad (i % av brickans bredd)"

#: ../src/ui/dialog/clonetiler.cpp:190
#, no-c-format
msgid "Horizontal shift per column (in % of tile width)"
msgstr "Horisontell förskjutning per kolumn (i % av brickans bredd)"

#: ../src/ui/dialog/clonetiler.cpp:215
#, no-c-format
msgid "Vertical shift per row (in % of tile height)"
msgstr "Vertikal förskjutning per rad (i % av brickans höjd)"

#: ../src/ui/dialog/clonetiler.cpp:223
#, no-c-format
msgid "Vertical shift per column (in % of tile height)"
msgstr "Vertikal förskjutning per kolumn (i % av brickans höjd)"

#: ../src/ui/dialog/clonetiler.cpp:306
msgid "Exclude tile height in shift"
msgstr "Exkludera brickans höjd i förskjutningen"

#: ../src/ui/dialog/clonetiler.cpp:311
msgid "Exclude tile width in shift"
msgstr "Exkludera brickans bredd i förskjutningen"

#: ../src/ui/dialog/clonetiler.cpp:337
#, no-c-format
msgid "Horizontal scale per row (in % of tile width)"
msgstr "Horisontell skalning per rad (i % av brickans bredd)"

#: ../src/ui/dialog/clonetiler.cpp:345
#, no-c-format
msgid "Horizontal scale per column (in % of tile width)"
msgstr "Horisontell skalning per kolumn (i % av brickans bredd)"

#: ../src/ui/dialog/clonetiler.cpp:368
#, no-c-format
msgid "Vertical scale per row (in % of tile height)"
msgstr "Vertikal skalning per rad (i % av brickans höjd)"

#: ../src/ui/dialog/clonetiler.cpp:376
#, no-c-format
msgid "Vertical scale per column (in % of tile height)"
msgstr "Vertikal skalning per kolumn (i % av brickans höjd)"

#: ../src/ui/dialog/clonetiler.cpp:397
msgid "Whether row scaling is uniform (1), converge (<1) or diverge (>1)"
msgstr "Om radskalningen är enhetlig (1), konvergerar (<1) eller divergerar (>1)"

#: ../src/ui/dialog/clonetiler.cpp:403
msgid "Whether column scaling is uniform (1), converge (<1) or diverge (>1)"
msgstr "Om kolumnskalningen är enhetlig (1), konvergerar (<1) eller divergerar (>1)"

#: ../src/ui/dialog/clonetiler.cpp:418
#: ../src/ui/dialog/clonetiler.cpp:424
msgid ""
"Base for a logarithmic spiral: not used (0), converge (<1), or diverge (>1)"
msgstr ""
"Bas för en logaritmisk spiral: används inte (0), konvergerar (<1) eller "
"divergerar (>1)"

#: ../src/ui/dialog/clonetiler.cpp:660
msgid "Initial color: "
msgstr "Ursprunglig färg: "

#: ../src/ui/dialog/clonetiler.cpp:664
msgid "Initial color of tiled clones"
msgstr "Ursprunglig färg för plattsatta kloner"

#: ../src/ui/dialog/clonetiler.cpp:665
msgid ""
"Initial color for clones (works only if the original has unset fill or "
"stroke or on spray tool in copy mode)"
msgstr ""
"Ursprunglig färg för kloner (fungerar endast om originalet saknar fyllning "
"eller streck, eller om sprayverktyget används i kopieringsläge)"
