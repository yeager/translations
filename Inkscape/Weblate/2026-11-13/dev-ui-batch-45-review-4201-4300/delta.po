#: ../src/live_effects/lpe-measure-segments.cpp:104
#: ../src/live_effects/lpe-powermask.cpp:27
msgid "Hide mask"
msgstr "Dölj masken"

#: ../src/live_effects/lpe-powerstroke.cpp:161
msgid "Start cap:"
msgstr "Startändform:"

#: ../src/live_effects/lpe-powerstroke.cpp:161
msgid "Determines the shape of the path's start"
msgstr "Anger formen i början av banan"

#: ../src/live_effects/lpe-powerstroke.cpp:164
msgid "End cap"
msgstr "Slutändform"

#: ../src/live_effects/lpe-powerstroke.cpp:164
msgid "Determines the shape of the path's end"
msgstr "Anger formen i slutet av banan"

#: ../src/live_effects/lpe-pts2ellipse.cpp:66
msgid ""
"Generate open arc (open ellipse) based on first and last node\n"
"(only for methods \"Auto ellipse\" and \"Force circle\")"
msgstr ""
"Generera en öppen båge (öppen ellips) baserat på den första och sista noden\n"
"(endast för metoderna \"Automatisk ellips\" och \"Tvinga cirkel\")"

#: ../src/live_effects/lpe-pts2ellipse.cpp:70
msgid "_Slice arc"
msgstr "_Dela båge"

#: ../src/live_effects/lpe-pts2ellipse.cpp:70
msgid "Create a circle / ellipse segment"
msgstr "Skapa ett cirkel- eller ellipssegment"

#: ../src/live_effects/lpe-rough-hatches.cpp:215
msgid "Growth of distance between hatches."
msgstr "Ökning av avståndet mellan skrafflingslinjerna."

#: ../src/live_effects/lpe-rough-hatches.cpp:218
msgid ""
"Set smoothness/sharpness of path when reaching a 'bottom' half-turn. "
"0=sharp, 1=default"
msgstr ""
"Ange hur mjuk eller skarp banan ska vara när den når ett halvvarv vid botten. "
"0 = skarp, 1 = standard"

#: ../src/live_effects/lpe-rough-hatches.cpp:219
msgid ""
"Set smoothness/sharpness of path when leaving a 'bottom' half-turn. 0=sharp, "
"1=default"
msgstr ""
"Ange hur mjuk eller skarp banan ska vara när den lämnar ett halvvarv vid botten. "
"0 = skarp, 1 = standard"

#: ../src/live_effects/lpe-rough-hatches.cpp:220
msgid ""
"Set smoothness/sharpness of path when reaching a 'top' half-turn. 0=sharp, "
"1=default"
msgstr ""
"Ange hur mjuk eller skarp banan ska vara när den når ett halvvarv vid toppen. "
"0 = skarp, 1 = standard"

#: ../src/live_effects/lpe-rough-hatches.cpp:221
msgid ""
"Set smoothness/sharpness of path when leaving a 'top' half-turn. 0=sharp, "
"1=default"
msgstr ""
"Ange hur mjuk eller skarp banan ska vara när den lämnar ett halvvarv vid toppen. "
"0 = skarp, 1 = standard"

#: ../src/live_effects/lpe-rough-hatches.cpp:222
msgid ""
"Randomly moves 'bottom' half-turns up and down to produce magnitude "
"variations."
msgstr ""
"Flyttar halvvarven vid botten slumpmässigt uppåt och nedåt för att skapa "
"variationer i storlek."

#: ../src/live_effects/lpe-rough-hatches.cpp:223
msgid ""
"Randomly moves 'top' half-turns up and down to produce magnitude variations."
msgstr ""
"Flyttar halvvarven vid toppen slumpmässigt uppåt och nedåt för att skapa "
"variationer i storlek."

#: ../src/live_effects/lpe-rough-hatches.cpp:224
msgid ""
"Add direction randomness by moving 'bottom' half-turns tangentially to the "
"boundary."
msgstr ""
"Lägg till slumpmässig riktning genom att flytta halvvarven vid botten "
"tangentiellt mot gränsen."

#: ../src/live_effects/lpe-rough-hatches.cpp:225
msgid ""
"Add direction randomness by randomly moving 'top' half-turns tangentially to "
"the boundary."
msgstr ""
"Lägg till slumpmässig riktning genom att slumpmässigt flytta halvvarven vid "
"toppen tangentiellt mot gränsen."

#: ../src/live_effects/lpe-rough-hatches.cpp:226
msgid "Randomness of 'bottom' half-turns' smoothness"
msgstr "Slumpmässighet i jämnheten för halvvarv vid botten"

#: ../src/live_effects/lpe-rough-hatches.cpp:227
msgid "Randomness of 'top' half-turns' smoothness"
msgstr "Slumpmässighet i jämnheten för halvvarv vid toppen"

#: ../src/live_effects/lpe-rough-hatches.cpp:231
msgid "Width at 'bottom' half-turns"
msgstr "Bredd vid halvvarv i botten"

#: ../src/live_effects/lpe-rough-hatches.cpp:232
msgid "Width at 'top' half-turns"
msgstr "Bredd vid halvvarv i toppen"

#: ../src/live_effects/lpe-rough-hatches.cpp:234
msgid "Width of line from 'top' to 'bottom'"
msgstr "Linjens bredd från toppen till botten"

#: ../src/live_effects/lpe-rough-hatches.cpp:235
msgid "Width of line from 'bottom' to 'top'"
msgstr "Linjens bredd från botten till toppen"

#: ../src/live_effects/lpe-rough-hatches.cpp:239
msgid ""
"Relative position to a reference point defines global bending direction and "
"amount"
msgstr ""
"Den relativa positionen i förhållande till en referenspunkt anger riktning "
"och omfattning för den globala böjningen"
