#: ../build/share/filters/filters.svg.h:376
msgid ""
"Felt like texture with color turbulence and slightly darker at the edges"
msgstr "Filtliknande textur med färgturbulens och något mörkare kanter"

#: ../build/share/filters/filters.svg.h:456
msgid "Gives a pointillist HSL sensitive transparency"
msgstr "Ger en pointillistisk HSL-känslig genomskinlighet"

#: ../build/share/filters/filters.svg.h:460
msgid "Gives a canvas like HSL sensitive transparency."
msgstr "Ger en HSL-känslig genomskinlighet som liknar duk."

#: ../build/share/filters/filters.svg.h:462
msgid "Smear Transparency"
msgstr "Utsmetad genomskinlighet"

# TODO
#: ../build/share/filters/filters.svg.h:470
msgid "Burst"
msgstr "Brisera"

#: ../build/share/filters/filters.svg.h:472
msgid "Burst balloon texture crumpled and with holes"
msgstr "Sprucken ballongtextur skrynklig och med hål"

#: ../build/share/filters/filters.svg.h:534
msgid "Riddled"
msgstr "Genomhålad"

#: ../build/share/filters/filters.svg.h:536
msgid "Riddle the surface and add bump to images"
msgstr "Genomhåla ytan och ge bilderna en upphöjd effekt"

#: ../build/share/filters/filters.svg.h:520
msgid ""
"Gives a controllable roughness engraving effect to bitmaps and materials"
msgstr ""
"Ger en kontrollerbar grovhet för en graveringseffekt till rasterbilder och "
"material"

#: ../build/share/filters/filters.svg.h:384
msgid "Smooth rainbow colors melted along the edges and colorizable"
msgstr "Jämna regnbågsfärger som smälter längs kanterna och kan färgsättas"

#: ../build/share/filters/filters.svg.h:388
msgid "Smooth rainbow colors slightly melted along the edges"
msgstr "Jämna regnbågsfärger som smälter lätt längs kanterna"

#: ../build/share/filters/filters.svg.h:408
msgid "3D warped, iridescent pearly shell texture"
msgstr "3D-förvrängd, iriserande pärlemorskimrande skalstruktur"

#: ../build/share/filters/filters.svg.h:418
msgid "Film Grain"
msgstr "Filmkorn"

#: ../build/share/filters/filters.svg.h:428
msgid "Gives Smooth Bumps velvet like"
msgstr "Ger släta gupp ett sammetslikt utseende"

#: ../build/share/filters/filters.svg.h:432
msgid "Comics shader with creamy waves transparency"
msgstr "Serieeffekt med krämiga, genomskinliga vågor"

#: ../build/share/filters/filters.svg.h:444
msgid "Smooth rainbow colors warped along the edges and colorizable"
msgstr "Jämna regnbågsfärger som förvrängs längs kanterna och kan färgsättas"

#: ../build/share/filters/filters.svg.h:452
msgid "Slightly posterize and draw edges like on old printed postcards"
msgstr "Posterisera lätt och rita kanter som på gamla tryckta vykort"
