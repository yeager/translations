msgid "Crash Report"
msgstr "Kraschrapport"

msgid ""
"If you can reproduce this crash, please <a href=\"https://inkscape.org/"
"report\">file a bug</a> and include the backtrace from the area below."
msgstr ""
"Om du kan återskapa kraschen, <a href=\"https://inkscape.org/report\">"
"rapportera ett fel</a> och inkludera stackspårningen från området nedan."

msgid "Export everything inside document"
msgstr "Exportera allt i dokumentet"

msgid "Export cropped content inside the page"
msgstr "Exportera beskuret innehåll på sidan"

msgid "Export format"
msgstr "Exportformat"

msgid "Set Favorite"
msgstr "Markera som favorit"

msgid "Unset Favorite"
msgstr "Ta bort från favoriter"

msgid "Show/hide this Live Path Effect"
msgstr "Visa eller dölj denna baneffekt (LPE)"

msgid "Remove this Live Path Effect"
msgstr "Ta bort denna baneffekt (LPE)"

msgid "Menu with options related to this Live Path Effect"
msgstr "Meny med alternativ för denna baneffekt (LPE)"

msgid "Reorder this Live Path Effect"
msgstr "Ändra ordning på denna baneffekt (LPE)"

msgid "Expand to display selection"
msgstr "Fäll ut för att visa markeringen"

msgid "Swatch fill"
msgstr "Färgprovsfyllning"

msgid "Zoom to fit"
msgstr "Anpassa zoomningen"
