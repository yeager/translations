msgid ""
"Mesh gradients are part of SVG 2:\n"
"* Syntax may change.\n"
"* Web browser implementation is not guaranteed.\n"
"\n"
"For web: convert to bitmap (Edit->Make bitmap copy).\n"
"For print: export to PDF."
msgstr ""
"Nätgradienter är en del av SVG 2:\n"
"* Syntaxen kan ändras.\n"
"* Stödet i webbläsare är inte garanterat.\n"
"\n"
"För webb: konvertera till rasterbild (Redigera->Gör rasterbildskopia).\n"
"För utskrift: exportera till PDF."

msgid "ex.: 100x100cm"
msgstr "t.ex. 100x100cm"

msgid ""
"Type in width & height of a page. (ex.: 15x10cm, 10in x 100mm)\n"
"or choose preset from dropdown."
msgstr ""
"Skriv in bredd och höjd på en sida. (t.ex. 15x10cm, 10 tum x 100 mm)\n"
"eller välj en förinställning i rullgardinsmenyn."

