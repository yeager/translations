msgctxt "Undo"
msgid "Apply last set color to fill"
msgstr "Tillämpa den senast inställda färgen på fyllningen"

msgctxt "Undo"
msgid "Apply last set color to stroke"
msgstr "Tillämpa den senast inställda färgen på strecket"

msgctxt "Undo"
msgid "Apply last selected color to fill"
msgstr "Tillämpa den senast valda färgen på fyllningen"

msgctxt "Undo"
msgid "Apply last selected color to stroke"
msgstr "Tillämpa den senast valda färgen på strecket"

msgctxt "Undo"
msgid "Invert stroke"
msgstr "Invertera streck"

msgctxt "Undo"
msgid "White stroke"
msgstr "Vitt streck"

msgctxt "Undo"
msgid "Paste stroke"
msgstr "Klistra in streck"

msgid "Last Set Color"
msgstr "Senast inställda färgen"

msgid "Last Selected Color"
msgstr "Senast valda färgen"

msgid "Stroke width: Hairline"
msgstr "Streckbredd: Hårfin"

msgid ""
"<b>Opacity (%)</b>\n"
"Middle-click cycles through 0%, 50%, 100%"
msgstr ""
"<b>Opacitet (%)</b>\n"
"Mittklick växlar mellan 0 %, 50 % och 100 %"

msgid ""
"Adjusting <b>stroke width</b>: was %.3g, now <b>%.3g</b> (diff %.3g)"
msgstr ""
"Justera <b>streckbredd</b>: var %.3g, nu <b>%.3g</b> (skillnad %.3g)"

msgid "Cap"
msgstr "Ändform"

msgid "Dashes"
msgstr "Streckmönster"

msgid "Repeating \"dash gap ...\" pattern"
msgstr "Upprepat mönster av \"streckmellanrum ...\""

msgid ""
"Mid Markers are drawn on every node of a path or shape except the first and "
"last nodes"
msgstr ""
"Mittmarkörer ritas på varje nod av en bana eller form utom den första och "
"sista noden"

msgctxt "Undo"
msgid "Remove hairline stroke"
msgstr "Ta bort hårfint streck"

msgctxt "Undo"
msgid "Set stroke dash"
msgstr "Ställ in streckmönster"

#, c-format
msgid "Stroke: %s"
msgstr "Streck: %s"

msgid "Start marker is drawn on the first node of a path"
msgstr "Startmarkören ritas på den första noden av en bana"

msgid ""
"Middle markers are drawn on every node of the path except the first and last "
"nodes"
msgstr ""
"Mittmarkörer ritas på varje nod av banan utom den första och sista noden"
