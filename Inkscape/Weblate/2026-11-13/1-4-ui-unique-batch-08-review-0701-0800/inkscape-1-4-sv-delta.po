msgid "Arc: Change start/end"
msgstr "Båge: ändra start/slut"

#: ../src/ui/toolbar/gradient-toolbar.cpp:717
#: ../src/ui/widget/gradient-editor.cpp:649
msgid "Change gradient stop offset"
msgstr "Ändra gradientstoppets förskjutning"

