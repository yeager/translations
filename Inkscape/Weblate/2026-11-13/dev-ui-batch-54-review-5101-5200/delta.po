#: ../src/ui/dialog/clonetiler.cpp:743
msgid "Change the color lightness by this percentage for each row"
msgstr "Ändra färgens ljushet med denna procentsats för varje rad"

#: ../src/ui/dialog/clonetiler.cpp:749
msgid "Change the color lightness by this percentage for each column"
msgstr "Ändra färgens ljushet med denna procentsats för varje kolumn"

#: ../src/ui/dialog/clonetiler.cpp:755
msgid "Randomize the color lightness by this percentage"
msgstr "Slumpa färgens ljushet med denna procentsats"

#: ../src/ui/dialog/clonetiler.cpp:793
msgid ""
"For each clone/sprayed item, pick a value from the drawing in its location "
"and apply it"
msgstr ""
"För varje klon eller sprayat objekt hämtas ett värde från ritningen vid dess "
"plats och tillämpas"

#: ../src/ui/dialog/clonetiler.cpp:874
msgid "Pick the lightness of the color"
msgstr "Välj färgens ljushet"

#: ../src/ui/dialog/clonetiler.cpp:942
msgid ""
"Each clone is created with the probability determined by the picked value in "
"that point"
msgstr ""
"Sannolikheten att en klon skapas bestäms av det valda värdet vid den punkten"

#: ../src/ui/dialog/clonetiler.cpp:1953
msgid "Select <b>one object</b> whose tiled clones to unclump."
msgstr "Välj <b>ett objekt</b> vars plattsatta kloner du vill minska klumpbildningen hos."

