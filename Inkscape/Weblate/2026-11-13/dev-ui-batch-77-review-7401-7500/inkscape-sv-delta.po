#, c-format
msgid ""
"<b>Click</b> to set fill, <b>%s+Click</b> to set stroke; <b>drag</b> to "
"average color in area; with <b>%s</b> to pick inverse color; <b>Ctrl+C</b> "
"to copy the color under mouse to clipboard"
msgstr ""
"<b>Klicka</b> för att ställa in fyllning, <b>%s+klick</b> för att ställa in "
"streck; <b>dra</b> för att beräkna medelfärg i ett område; med <b>%s</b> för "
"att välja den inverterade färgen; <b>Ctrl+C</b> för att kopiera färgen under "
"muspekaren till urklippet"

msgid "<b>Drawing</b> an eraser stroke"
msgstr "<b>Ritar</b> ett suddgummistreck"

msgctxt "Undo"
msgid "Draw eraser stroke"
msgstr "Rita suddgummistreck"

msgid "Cannot cut out from a bitmap, use <b>Clip</b> mode instead."
msgstr "Det går inte att klippa ut från en rasterbild. Använd <b>Klipp</b>-läget i stället."

msgid ""
"Cannot cut out from a path with zero area, use <b>Clip</b> mode instead."
msgstr ""
"Det går inte att klippa ut från en bana med noll area. Använd <b>Klipp</b>-"
"läget i stället."

#, c-format
msgid "Area filled, path with <b>%d</b> node created and unioned with selection."
msgid_plural "Area filled, path with <b>%d</b> nodes created and unioned with selection."
msgstr[0] "Område fyllt, bana med <b>%d</b> nod skapades och sammanfogades med markeringen."
msgstr[1] "Område fyllt, bana med <b>%d</b> noder skapades och sammanfogades med markeringen."

#, c-format
msgid "Area filled, path with <b>%d</b> node created."
msgid_plural "Area filled, path with <b>%d</b> nodes created."
msgstr[0] "Område fyllt, bana med <b>%d</b> nod skapades."
msgstr[1] "Område fyllt, bana med <b>%d</b> noder skapades."

msgid "<b>Area is not bounded</b>, cannot fill."
msgstr "<b>Området är inte begränsat</b> och kan inte fyllas."

msgid ""
"<b>Only the visible part of the bounded area was filled.</b> If you want to "
"fill all of the area, undo, zoom out, and fill again."
msgstr ""
"<b>Endast den synliga delen av det avgränsade området fylldes.</b> Om du vill "
"fylla hela området, ångra, zooma ut och fyll igen."

msgctxt "Undo"
msgid "Fill bounded area"
msgstr "Fyll avgränsat område"

#, c-format
msgid "%s selected"
msgstr "%s markerad"

#, c-format
msgid ""
"One handle merging %d stop (drag with <b>Shift</b> to separate) selected"
msgid_plural ""
"One handle merging %d stops (drag with <b>Shift</b> to separate) selected"
msgstr[0] "Ett handtag som sammanfogar %d stopp är markerat (dra med <b>Skift</b> för att separera)"
msgstr[1] "Ett handtag som sammanfogar %d stopp är markerat (dra med <b>Skift</b> för att separera)"

#, c-format
msgid "<b>%d</b> gradient handle selected out of %d"
msgid_plural "<b>%d</b> gradient handles selected out of %d"
msgstr[0] "<b>%d</b> gradienthandtag markerat av %d"
msgstr[1] "<b>%d</b> gradienthandtag markerade av %d"

msgctxt "Undo"
msgid "Simplify gradient"
msgstr "Förenkla gradient"

msgid "Snap gradient angle"
msgstr "Fäst gradientens vinkel"

