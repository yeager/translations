#: ../src/actions/actions-object.cpp:487
msgctxt "Undo"
msgid "Remove Live Path Effect"
msgstr "Tog bort baneffekt"

#: ../src/actions/actions-object.cpp:525
msgid "Add Corners LPE"
msgstr "Lägg till hörn-baneffekt"

#: ../src/actions/actions-object.cpp:525
