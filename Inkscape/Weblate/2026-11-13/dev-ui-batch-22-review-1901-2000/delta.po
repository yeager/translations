msgstr "Tillämpa omvänd klippbana på markeringen (Power Clip LPE)"

#: ../src/actions/actions-object.cpp:530
msgid "Remove clipping path from selection"
msgstr "Ta bort klippbanan från markeringen"

#: ../src/actions/actions-object.cpp:532
msgid "Apply mask to selection (using the topmost object as mask)"
msgstr ""
"Tillämpa mask på markeringen (genom att använda det översta objektet som "
"mask)"

#: ../src/actions/actions-object.cpp:533
msgid "Apply inverse mask to selection (Power Mask LPE)"
msgstr "Tillämpa omvänd mask på markeringen (Power Mask LPE)"

#: ../src/actions/actions-object.cpp:534
msgid "Remove mask from selection"
msgstr "Ta bort masken från markeringen"

#: ../src/actions/actions-object.cpp:540
msgid "Turn stars and polygons upright"
msgstr "Räta upp stjärnor och polygoner"

