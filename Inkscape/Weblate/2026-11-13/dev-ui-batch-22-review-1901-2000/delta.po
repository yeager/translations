msgctxt "Undo"
msgid "Set clipping path"
msgstr "Angav klippbana"

#: ../src/actions/actions-object.cpp:284
msgctxt "Undo"
msgid "Set Inverse Clip(LPE)"
msgstr "Angav omvänd klippning (LPE)"

#: ../src/actions/actions-object.cpp:298
msgctxt "Undo"
msgid "Release clipping path"
msgstr "Frigjorde klippbana"

#: ../src/actions/actions-object.cpp:323
msgctxt "Undo"
msgid "Set mask"
msgstr "Angav mask"

#: ../src/actions/actions-object.cpp:337
msgctxt "Undo"
msgid "Set Inverse Mask (LPE)"
