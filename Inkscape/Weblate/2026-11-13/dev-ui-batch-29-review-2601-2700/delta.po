#: ../src/extension/internal/bitmap/charcoal.cpp:49
msgid "Apply charcoal stylization to selected bitmap(s)"
msgstr "Tillämpa kolstilisering på markerade rasterbilder"

#: ../src/extension/internal/bitmap/colorize.cpp:58
msgid "Colorize selected bitmap(s) with specified color, using given opacity"
msgstr "Färglägg markerade rasterbild(ar) med angiven färg, med angiven opacitet"

#: ../src/extension/internal/bitmap/crop.cpp:80
msgid "Crop selected bitmap(s)"
msgstr "Beskär markerade rasterbilder"

#: ../src/extension/internal/bitmap/cycleColormap.cpp:47
msgid "Cycle colormap(s) of selected bitmap(s)"
msgstr "Växla färgkartor för vald(a) rasterbild(ar)"

#: ../src/extension/internal/bitmap/despeckle.cpp:45
msgid "Reduce speckle noise of selected bitmap(s)"
msgstr "Minska fläckbrus för markerade rasterbilder"

#: ../src/extension/internal/bitmap/edge.cpp:47
msgid "Highlight edges of selected bitmap(s)"
msgstr "Markera kanter på markerade rasterbilder"

#: ../src/extension/internal/bitmap/emboss.cpp:49
msgid "Emboss selected bitmap(s); highlight edges with 3D effect"
msgstr "Prägla utmarkerade rasterbilder; framhäv kanter med 3D-effekt"

#: ../src/extension/internal/bitmap/enhance.cpp:44
msgid "Enhance selected bitmap(s); minimize noise"
msgstr "Förbättra vald rasterbild(ar); minimera brus"

# TODO
#: ../src/extension/internal/bitmap/equalize.cpp:44
msgid "Equalize selected bitmap(s); histogram equalization"
msgstr "Utjämna markerade rasterbilder; histogramutjämning"

#: ../src/extension/internal/bitmap/gaussianBlur.cpp:49
msgid "Gaussian blur selected bitmap(s)"
msgstr "Gör markerade rasterbilder gaussiskt oskarpa"

#: ../src/extension/internal/bitmap/implode.cpp:47
msgid "Implode selected bitmap(s)"
msgstr "Implodera markerade rasterbilder"

#: ../src/extension/internal/bitmap/negate.cpp:45
msgid "Negate (take inverse) selected bitmap(s)"
msgstr "Negera (ta invers) markerade rasterbilder"

#: ../src/extension/internal/bitmap/oilPaint.cpp:47
msgid "Stylize selected bitmap(s) so that they appear to be painted with oils"
msgstr ""
"Stilisera markerade rasterbilder så att de ser ut att vara målade med oljefärg"

#: ../src/extension/internal/bitmap/opacity.cpp:48
msgid "Modify opacity channel(s) of selected bitmap(s)"
msgstr "Ändra opacitetskanal(er) för markerade rasterbilder"

#: ../src/extension/internal/bitmap/shade.cpp:52
msgid "Shade selected bitmap(s) simulating distant light source"
msgstr "Skugga vald(a) rasterbild(ar) som simulerar en avlägsen ljuskälla"

#: ../src/extension/internal/bitmap/sharpen.cpp:49
msgid "Sharpen selected bitmap(s)"
msgstr "Skärp markerade rasterbilder"

#: ../src/extension/internal/bitmap/solarize.cpp:49
msgid "Solarize selected bitmap(s), like overexposing photographic film"
msgstr "Solarisera utmarkerade rasterbilder, som att överexponera fotografisk film"

#: ../src/extension/internal/bitmap/swirl.cpp:47
msgid "Swirl selected bitmap(s) around center point"
msgstr "Virvla vald(a) rasterbild(ar) runt mittpunkten"

#: ../src/extension/internal/bitmap/threshold.cpp:48
msgid "Threshold selected bitmap(s)"
msgstr "Tröskelvärde för vald(a) rasterbild(ar)"

#: ../src/extension/internal/bitmap/unsharpmask.cpp:54
msgid "Sharpen selected bitmap(s) using unsharp mask algorithms"
msgstr "Skärp markerade rasterbilder med hjälp av algoritmer för oskarp mask"

#: ../src/extension/internal/bitmap/wave.cpp:49
msgid "Alter selected bitmap(s) along sine wave"
msgstr "Ändra vald(a) rasterbild(ar) längs sinusvåg"
