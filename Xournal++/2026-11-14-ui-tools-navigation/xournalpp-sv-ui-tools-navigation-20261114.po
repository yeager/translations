#: ../desktop/com.github.xournalpp.xournalpp.desktop.in:8
msgid "tablet;Wacom;pen input;PDF Annotation;markup;journal;handwriting;diary;notes;"
msgstr "ritplatta;Wacom;penninmatning;PDF-annotering;uppmärkning;journal;handskrift;dagbok;anteckningar;"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:10
msgid "Xournal++ is a hand note-taking software written in C++ with the target of flexibility, functionality and speed. Stroke recognizer and other parts are based on Xournal Code, which you can find at sourceforge. It supports GNU/Linux (e.g. Ubuntu, Debian, Arch, SUSE), macOS and Windows. Supports pen input from devices such as Wacom Tablets."
msgstr "Xournal++ är ett program för handskrivna anteckningar, skrivet i C++ med fokus på flexibilitet, funktionalitet och snabbhet. Streckigenkänningen och andra delar bygger på Xournal Code, som finns på SourceForge. Programmet stöder GNU/Linux (t.ex. Ubuntu, Debian, Arch och SUSE), macOS och Windows samt penninmatning från enheter som Wacom-ritplattor."

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:21
msgid "Supports pressure-sensitive styluses and digital pen tables (e.g. Wacom, Huion, XP Pen, etc. tablets)"
msgstr "Stöd för tryckkänsliga pennor och digitala ritplattor (t.ex. Wacom-, Huion- och XP Pen-plattor)"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:22
msgid "Paper backgrounds for note-taking, scratch paper, or whiteboarding"
msgstr "Pappersbakgrunder för anteckningar, kladdpapper och skrivtavlor"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:24
msgid "Select text from the background PDF, copy, highlight or underline it or strike it through"
msgstr "Markera text i bakgrunds-PDF:en och kopiera, överstryk, stryk under eller stryk över den"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:27
msgid "Different drawing tools (e.g. pen, highlighter) and stroke styles (e.g. solid, dotted)"
msgstr "Olika ritverktyg (t.ex. penna och överstrykningspenna) och streckstilar (t.ex. hel och prickad)"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:28
msgid "Shape drawing (line, arrow, circle, rectangle, spline)"
msgstr "Figurritning (linje, pil, cirkel, rektangel, spline)"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:29
msgid "Use the set-square and compass tools for measurements or as a guide for drawing straight lines, circular arcs and radii"
msgstr "Använd vinkelhake och passare för mätning eller som stöd när du ritar raka linjer, cirkelbågar och radier"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:30
msgid "Fill shape functionality"
msgstr "Funktion för att fylla figurer"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:31
msgid "Shape resizing and rotation"
msgstr "Storleksändring och rotering av figurer"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:32
msgid "Rotation and grid snapping for precise alignment of objects"
msgstr "Rotering och fästning vid rutnät för exakt justering av objekt"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:33
msgid "Input stabilization for smoother writing/drawing"
msgstr "Indatastabilisering för jämnare skrivning och ritning"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:34
msgid "Text tool for adding text in different fonts, colors, and sizes"
msgstr "Textverktyg för att lägga till text med olika typsnitt, färger och storlekar"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:36
msgid "Eraser with multiple configurations"
msgstr "Suddgummi med flera konfigurationer"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:37
msgid "LaTeX support (requires a working LaTeX installation) with customizable template and a resizable editor with syntax highlighting"
msgstr "LaTeX-stöd (kräver en fungerande LaTeX-installation) med anpassningsbar mall och storleksändringsbar redigerare med syntaxmarkering"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:38
msgid "Sidebar containing page previews with advanced page sorting, PDF bookmarks and layers (can be individually hidden/edited)"
msgstr "Sidopanel med sidförhandsvisningar, avancerad sidordning, PDF-bokmärken och lager (kan döljas eller redigeras var för sig)"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:39
msgid "Allows mapping different tools/colors etc. to stylus/mouse buttons"
msgstr "Gör det möjligt att koppla olika verktyg, färger med mera till penn- och musknappar"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:40
msgid "Customizable toolbar with multiple configurations, e.g. to optimize toolbar for portrait/landscape"
msgstr "Anpassningsbart verktygsfält med flera konfigurationer, t.ex. för stående eller liggande format"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:41
msgid "Custom color palette support using the .gpl format"
msgstr "Stöd för anpassade färgpaletter i .gpl-format"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:43
msgid "Bug reporting, autosave, and auto backup tools"
msgstr "Verktyg för felrapportering, automatiskt sparande och automatiska säkerhetskopior"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:44
msgid "Audio recording and playback alongside with handwritten notes"
msgstr "Ljudinspelning och uppspelning tillsammans med handskrivna anteckningar"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:57
msgid "Note taking"
msgstr "Anteckningar"

#: ../resources-templates/com.github.xournalpp.xournalpp.appdata.xml.in:65
msgid "LaTeX with customized preamble"
msgstr "LaTeX med anpassad preambel"

#: ../resources-templates/com.github.xournalpp.xournalpp.xml.in:4
msgid "Xournal note file"
msgstr "Xournal-anteckningsfil"

#: ../resources-templates/com.github.xournalpp.xournalpp.xml.in:8
msgid "Xournal++ note file"
msgstr "Xournal++-anteckningsfil"

#: ../resources-templates/com.github.xournalpp.xournalpp.xml.in:12
msgid "Xournal++ page template file"
msgstr "Xournal++-sidmallsfil"

