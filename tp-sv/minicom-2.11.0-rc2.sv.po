#: src/minicom.c:884
#, c-format
msgid ""
"Usage: %s [OPTION]... [configuration]\n"
"A terminal program for Linux and other unix-like systems.\n"
"\n"
"  -b, --baudrate         : set baudrate (ignore the value from config)\n"
"  -D, --device           : set device name (ignore the value from config)\n"
"  -s, --setup            : enter setup mode\n"
"  -o, --noinit           : do not initialize modem & lockfiles at startup\n"
"  -m, --metakey          : use meta or alt key for commands\n"
"  -M, --metakey8         : use 8bit meta key for commands\n"
"  -l, --ansi             : literal; assume screen uses non IBM-PC character set\n"
"  -L, --iso              : don't assume screen uses ISO8859\n"
"  -w, --wrap             : Linewrap on\n"
"  -H, --displayhex       : display output in hex\n"
"  -z, --statline         : try to use terminal's status line\n"
"  -7, --7bit             : force 7bit mode\n"
"  -8, --8bit             : force 8bit mode\n"
"  -c, --color=on/off     : ANSI style color usage on or off\n"
"  -a, --attrib=on/off    : use reverse or highlight attributes on or off\n"
"  -t, --term=TERM        : override TERM environment variable\n"
"  -S, --script=SCRIPT    : run SCRIPT at startup\n"
"  -d, --dial=ENTRY       : dial ENTRY from the dialing directory\n"
"  -p, --ptty=TTYP        : connect to pseudo terminal\n"
"  -C, --capturefile=FILE : start capturing to FILE\n"
"  --capturefile-buffer-mode=MODE : set buffering mode of capture file\n"
"  -F, --statlinefmt      : format of status line\n"
"  -R, --remotecharset    : character set of communication partner\n"
"  -v, --version          : output version information and exit\n"
"  -h, --help             : show help\n"
"  configuration          : configuration file to use\n"
"\n"
"These options can also be specified in the MINICOM environment variable.\n"
msgstr ""
"Användning: %s [OPTION]... [configuration]\n"
"Ett terminalprogram för Linux och andra Unix-liknande system.\n"
"\n"
"  -b, --baudrate         : ange överföringshastighet (ignorera värdet i konfigurationen)\n"
"  -D, --device           : ange enhetsnamn (ignorera värdet i konfigurationen)\n"
"  -s, --setup            : öppna inställningsläge\n"
"  -o, --noinit           : initiera inte modem och låsfiler vid uppstart\n"
"  -m, --metakey          : använd Meta- eller Alt-tangent för kommandon\n"
"  -M, --metakey8         : använd 8-bitars Meta-tangent för kommandon\n"
"  -l, --ansi             : bokstavlig; anta att skärmen inte använder IBM-PC-teckenuppsättning\n"
"  -L, --iso              : anta inte att skärmen använder ISO8859\n"
"  -w, --wrap             : slå på radbrytning\n"
"  -H, --displayhex       : visa utdata hexadecimalt\n"
"  -z, --statline         : försök använda terminalens statusrad\n"
"  -7, --7bit             : tvinga 7-bitarsläge\n"
"  -8, --8bit             : tvinga 8-bitarsläge\n"
"  -c, --color=on/off     : slå på eller av ANSI-färger\n"
"  -a, --attrib=on/off    : slå på eller av omvända eller framhävda attribut\n"
"  -t, --term=TERM        : åsidosätt miljövariabeln TERM\n"
"  -S, --script=SCRIPT    : kör SCRIPT vid uppstart\n"
"  -d, --dial=ENTRY       : ring ENTRY från telefonkatalogen\n"
"  -p, --ptty=TTYP        : anslut till pseudoterminal\n"
"  -C, --capturefile=FILE : börja fånga till FILE\n"
"  --capturefile-buffer-mode=MODE : ange buffringsläge för fångstfilen\n"
"  -F, --statlinefmt      : format för statusrad\n"
"  -R, --remotecharset    : teckenuppsättning för kommunikationspartner\n"
"  -v, --version          : skriv ut versionsinformation och avsluta\n"
"  -h, --help             : visa hjälp\n"
"  configuration          : konfigurationsfil att använda\n"
"\n"
"Dessa flaggor kan också anges i miljövariabeln MINICOM.\n"

