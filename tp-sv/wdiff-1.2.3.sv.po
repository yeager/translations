#: src/wdiff2.c:177
msgid ""
"wdiff - Compute word differences by internally launching `mdiff -W'.\n"
"This program exists mainly to support the now oldish `wdiff' syntax.\n"
msgstr ""
"wdiff – Beräknar ordskillnader genom att internt köra ”mdiff -W”.\n"
"Detta program finns huvudsakligen för att ge stöd för den numera gamla syntaxen för ”wdiff”.\n"

#: src/wdiff2.c:182
#, c-format
msgid "Usage: %s [OPTION]... FILE1 FILE2\n"
msgstr "Användning: %s [FLAGGA]... FIL1 FIL2\n"

#: src/wdiff2.c:199
msgid "  -q, --quiet                inhibit the `mdiff' call message\n"
