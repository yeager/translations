#: src/wdiff.c:1237
msgid "wdiff - Compares words in two files and report differences.\n"
msgstr "wdiff – Jämför ord i två filer och rapporterar skillnader.\n"

#: src/wdiff.c:1241
#, c-format
msgid ""
"Usage: %s [OPTION]... FILE1 FILE2\n"
"   or: %s -d [OPTION]... [FILE]\n"
msgstr ""
"Användning: %s [FLAGGA]... FIL1 FIL2\n"
"     eller: %s -d [FLAGGA]... [FIL]\n"

#: src/wdiff.c:1246 src/wdiff2.c:186
msgid "Mandatory arguments to long options are mandatory for short options too.\n"
msgstr "Obligatoriska argument för långa flaggor är även obligatoriska för korta flaggor.\n"

#: src/wdiff.c:1249 src/wdiff2.c:189
msgid "  -C, --copyright            display copyright then exit\n"
msgstr "  -C, --copyright            skriv copyright och avsluta\n"

#: src/wdiff.c:1253 src/wdiff2.c:193
msgid "  -a, --auto-pager           automatically calls a pager\n"
msgstr "  -a, --auto-pager           ge resultatet till en sidvisare\n"

#: src/wdiff.c:1254
msgid "  -d, --diff-input           use single unified diff as input\n"
msgstr "  -d, --diff-input           använd enad skillnad som indata\n"

#: src/wdiff.c:1255 src/wdiff2.c:194
msgid "  -h, --help                 display this help then exit\n"
msgstr "  -h, --help                 skriv denna hjälp och avsluta\n"

#: src/wdiff.c:1256 src/wdiff2.c:195
msgid "  -i, --ignore-case          fold character case while comparing\n"
msgstr "  -i, --ignore-case          ignorera skiftläge vid jämförelse\n"

#: src/wdiff.c:1257 src/wdiff2.c:196
msgid "  -l, --less-mode            variation of printer mode for \"less\"\n"
msgstr "  -l, --less-mode            variant av skrivarläge för ”less”\n"

#: src/wdiff.c:1258 src/wdiff2.c:197
msgid "  -n, --avoid-wraps          do not extend fields through newlines\n"
msgstr "  -n, --avoid-wraps          låt inte fält fortsätta över radbrytningar\n"

#: src/wdiff.c:1259 src/wdiff2.c:198
msgid "  -p, --printer              overstrike as for printers\n"
msgstr "  -p, --printer              överstrykning som för skrivare\n"

#: src/wdiff.c:1260 src/wdiff2.c:200
msgid "  -s, --statistics           say how many words deleted, inserted etc.\n"
msgstr "  -s, --statistics           visa hur många ord som har tagits bort, lagts till osv.\n"

#: src/wdiff.c:1261 src/wdiff2.c:201
msgid "  -t, --terminal             use termcap as for terminal displays\n"
msgstr "  -t, --terminal             använd termcap för terminaler\n"

#: src/wdiff.c:1262 src/wdiff2.c:202
msgid "  -v, --version              display program version then exit\n"
msgstr "  -v, --version              skriv programversion och avsluta\n"

#: src/wdiff.c:1263 src/wdiff2.c:203
msgid "  -w, --start-delete=STRING  string to mark beginning of delete region\n"
msgstr "  -w, --start-delete=STRÄNG  sträng som markerar början av borttagningsområdet\n"

#: src/wdiff.c:1264 src/wdiff2.c:204
msgid "  -x, --end-delete=STRING    string to mark end of delete region\n"
msgstr "  -x, --end-delete=STRÄNG    sträng som markerar slutet av borttagningsområdet\n"

#: src/wdiff.c:1265 src/wdiff2.c:205
msgid "  -y, --start-insert=STRING  string to mark beginning of insert region\n"
msgstr "  -y, --start-insert=STRÄNG  sträng som markerar början av infogningsområdet\n"

#: src/wdiff.c:1266 src/wdiff2.c:206
msgid "  -z, --end-insert=STRING    string to mark end of insert region\n"
msgstr "  -z, --end-insert=STRÄNG    sträng som markerar slutet av infogningsområdet\n"

#: src/wdiff.c:1385
#, c-format
msgid "cannot use -t, termcap not available"
msgstr "kan inte använda -t, termcap finns inte tillgängligt"

#: src/wdiff.c:1434 src/wdiff.c:1452
#, c-format
msgid "too many file arguments"
msgstr "för många filargument"

#: src/wdiff.c:1447 src/wdiff2.c:320
#, c-format
msgid "missing file arguments"
msgstr "filargument saknas"

