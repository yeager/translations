#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Försök med \"%s --help\" för mer information.\n"

#: src/mdiff.c:3767
msgid ""
"mdiff - Studies multiple files and searches for similar sequences, it then\n"
"produces possibly detailed lists of differences and similarities.\n"
msgstr ""
"mdiff – Analyserar flera filer och söker efter liknande sekvenser; skapar därefter"
" eventuellt detaljerade listor över skillnader och likheter.\n"

#: src/mdiff.c:3772
#, c-format
msgid "Usage: %s [OPTION]... [FILE]...\n"
msgstr "Användning: %s [FLAGGA]... [FIL]...\n"

#: src/mdiff.c:3776
msgid ""
"\n"
"Operation modes:\n"
msgstr ""
"\n"
"Arbetslägen:\n"

#: src/mdiff.c:3777
msgid "  -h                     (ignored)\n"
msgstr "  -h                     (ignorerad)\n"

#: src/mdiff.c:3778
msgid "  -v, --verbose          report a few statistics on stderr\n"
msgstr "  -v, --verbose          rapportera en del statistik på standardfel\n"

#: src/mdiff.c:3779 src/unify.c:295
msgid "      --help             display this help then exit\n"
msgstr "      --help             visa denna hjälptext och avsluta\n"

#: src/mdiff.c:3780 src/unify.c:296
msgid "      --version          display program version then exit\n"
msgstr "      --version          visa versionsinformation och avsluta\n"

#: src/mdiff.c:3782
msgid ""
"\n"
"Formatting output:\n"
msgstr ""
"\n"
"Formatera resultat:\n"

#: src/mdiff.c:3783
msgid "  -T, --initial-tab       produce TAB instead of initial space\n"
msgstr "  -T, --initial-tab       skriv TAB i stället för inledande mellanslag\n"

#: src/mdiff.c:3784
msgid "  -l, --paginate          paginate output through `pr'\n"
msgstr "  -l, --paginate          skicka resultatet genom \"pr\" för sidindelning\n"

#: src/mdiff.c:3785
msgid "  -S, --string[=STRING]   take note of another user STRING\n"
msgstr "  -S, --string[=STRÄNG]   ta även hänsyn till STRÄNG\n"

#: src/mdiff.c:3786
msgid "  -V, --show-links        give file and line references in annotations\n"
msgstr "  -V, --show-links        ange fil- och radreferenser i annoteringar\n"

#: src/mdiff.c:3787
msgid "  -t, --expand-tabs       expand tabs to spaces in the output\n"
msgstr "  -t, --expand-tabs       ersätt tabulatortecken med mellanslag i resultatet\n"

#: src/mdiff.c:3790
msgid ""
"\n"
"Debugging:\n"
msgstr ""
"\n"
"Felsökning:\n"

#: src/mdiff.c:3791
msgid "  -0, --debugging   output many details about what is going on\n"
msgstr "  -0, --debugging   skriv ut många detaljer om vad som händer\n"

#: src/mdiff.c:3794
msgid ""
"\n"
"Word mode options:\n"
msgstr ""
"\n"
"Flaggor för ordläge:\n"

#: src/mdiff.c:3795 src/wdiff.c:1250 src/wdiff2.c:190
msgid "  -1, --no-deleted           inhibit output of deleted words\n"
msgstr "  -1, --no-deleted           visa inte borttagna ord\n"

#: src/mdiff.c:3796 src/wdiff.c:1251 src/wdiff2.c:191
msgid "  -2, --no-inserted          inhibit output of inserted words\n"
msgstr "  -2, --no-inserted          visa inte tillagda ord\n"

#: src/mdiff.c:3797 src/wdiff.c:1252 src/wdiff2.c:192
msgid "  -3, --no-common            inhibit output of common words\n"
msgstr "  -3, --no-common            visa inte gemensamma ord\n"

#: src/mdiff.c:3798
msgid "  -A, --auto-pager           automatically calls a pager\n"
msgstr "  -A, --auto-pager           ge resultatet till en sidvisare\n"

#: src/mdiff.c:3799
msgid "  -k, --less-mode            variation of printer mode for \"less\"\n"
msgstr "  -k, --less-mode            särskild variant av skrivarläge för ”less”\n"

#: src/mdiff.c:3800
msgid "  -m, --avoid-wraps          do not extend fields through newlines\n"
msgstr "  -m, --avoid-wraps          låt inte fält löpa över flera rader\n"

#: src/mdiff.c:3801
msgid "  -o, --printer              overstrike as for printers\n"
msgstr "  -o, --printer              dubbelskrift som för skrivare\n"

#: src/mdiff.c:3802
msgid "  -z, --terminal             use termcap as for terminal displays\n"
msgstr "  -z, --terminal             använd termcap för att markera ord\n"

#: src/mdiff.c:3803
msgid "  -O, --item-regexp=REGEXP   compare items as defined by REGEXP\n"
msgstr "  -O, --item-regexp=REGEXP   jämför poster som definieras av REGEXP\n"

#: src/mdiff.c:3804
msgid "  -W, --word-mode            compare words instead of lines\n"
msgstr "  -W, --word-mode            jämför ord istället för rader\n"

#: src/mdiff.c:3989
msgid "With no FILE, or when FILE is -, read standard input.\n"
msgstr "Utan FIL eller om FIL är -, läs standard in.\n"

#: src/mdiff.c:3991 src/unify.c:300 src/wdiff.c:1268 src/wdiff2.c:210
msgid "Report bugs to <wdiff-bugs@gnu.org>.\n"
msgstr ""
"Rapportera fel till <wdiff-bugs@gnu.org>\n"
"Rapportera fel eller synpunkter på översättningen till <tp-sv@listor.tp-sv.se>.\n"

#: src/mdiff.c:4003
#, c-format
msgid "ignoring option %s (not implemented)"
msgstr "ignorerar flaggan %s (inte implementerad)"

#: src/mdiff.c:4297
#, c-format
msgid "cannot use -z, termcap not available"
msgstr "kan inte använda -z, termcap finns inte tillgängligt"

#: src/mdiff.c:4336
#, c-format
msgid "word merging for two files only (so far)"
msgstr "ordsammanslagning finns endast för två filer (än så länge)"

