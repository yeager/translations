#: src/main.c:115
msgid "verify PO modification time"
msgstr "verifiera ändringstid för PO-fil"

#: src/main.c:118
msgid "make sure the submitted PO file is for the latest package version"
msgstr "säkerställ att den inskickade PO-filen är för den senaste paketversionen"

#: src/main.c:148
msgid "not a boolean"
msgstr "inte ett booleskt värde"

#: src/main.c:172
msgid "Use <command> for compression."
msgstr "Använd <kommando> för komprimering."

#: src/main.c:173
msgid "command"
msgstr "kommando"

#: src/main.c:175
msgid "Set the name of the langtab file."
msgstr "Ställ in namnet på langtab-filen."

#: src/main.c:176
msgid "file"
msgstr "fil"

#: src/main.c:178
msgid "Set recipient address. Multiple emails are allowed."
msgstr "Ställ in mottagaradress. Flera e-postadresser kan anges."

#: src/main.c:179 src/main.c:191
msgid "email"
msgstr "e-postadress"

#: src/main.c:181
msgid "Set carbon copy recipients."
msgstr "Ställ in mottagare av kopia."

#: src/main.c:182 src/main.c:185
msgid "emails"
msgstr "e-postadresser"

#: src/main.c:184
msgid "Set blind carbon copy recipients."
msgstr "Ställ in mottagare av blindkopia."

#: src/main.c:187
msgid "Save copy in <folder>."
msgstr "Spara kopia i <mapp>."

#: src/main.c:188
msgid "folder"
msgstr "mapp"

#: src/main.c:190
msgid "Set sender address"
msgstr "Ställ in avsändaradress"

#: src/main.c:193
msgid "Read sender address from the PO file."
msgstr "Läs avsändaradress från PO-filen."

#: src/main.c:195
msgid "Verify PO modification time"
msgstr "Verifiera ändringstid för PO-fil"

#: src/main.c:196 src/main.c:199
msgid "arg: bool"
msgstr "arg: boolesk"

#: src/main.c:198
msgid "Verify package version."
msgstr "Verifiera paketversion."

