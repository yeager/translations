#: src/main.c:19
msgid "Submit PO files to the Translation Project"
msgstr "Skicka PO-filer till Translation Project"

#: src/main.c:20
msgid "FILE ..."
msgstr "FIL …"

#: src/main.c:81
msgid "General Options:"
msgstr "Allmänna flaggor:"

#: src/main.c:83
msgid "do nothing, print what would have been done"
msgstr "gör inget, skriv ut vad som skulle ha gjorts"

#: src/main.c:86
msgid "produce verbose output"
msgstr "skriv ut utförliga utdata"

#: src/main.c:88
msgid "FILE"
msgstr "FIL"

#: src/main.c:89
msgid "set the name of langtab file"
msgstr "ställ in namnet på langtab-filen"

#: src/main.c:91
msgid "COMMAND"
msgstr "KOMMANDO"

#: src/main.c:92
msgid "use this COMMAND for compression"
msgstr "använd detta KOMMANDO för komprimering"

#: src/main.c:96
msgid "Mail Address Control:"
msgstr "E-postadresskontroll:"

#: src/main.c:97 src/main.c:109
msgid "EMAIL"
msgstr "E-POST"

#: src/main.c:98
msgid "send to this email address"
msgstr "skicka till denna e-postadress"

#: src/main.c:100 src/main.c:103
msgid "EMAIL-LIST"
msgstr "SÄNDLISTA"

#: src/main.c:101
msgid "set Carbon-copy recipients"
msgstr "ställ in mottagare av kopia"

#: src/main.c:104
msgid "set Blind carbon-copy recipients"
msgstr "ställ in mottagare av blindkopia"

#: src/main.c:106
msgid "FOLDER"
