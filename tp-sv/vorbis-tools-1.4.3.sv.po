#: ogginfo/ogginfo2.c:401
#, c-format
msgid ""
"(c) 2003-2005 Michael Smith <msmith@xiph.org>\n"
"\n"
"Usage: ogginfo [flags] file1.ogg [file2.ogx ... fileN.ogv]\n"
