#: ../actions/menus/ObjectMenu/Lyrics/InsertStanzaNumber.scm:5
msgid "Bold"
msgstr "Fetstil"

#: ../src/ui/markup.c:520
msgid "Inserts markup to make the selected text bold."
msgstr "Infogar markup som gör den markerade texten fet."

#: ../src/ui/markup.c:524 ../actions/denemo.scm:281 ../actions/denemo.scm:342
#: ../actions/menus/ObjectMenu/Directives/Markings/TextMarks/TextAnnotation.scm:18
#: ../actions/menus/ObjectMenu/Lyrics/InsertHighlightedLyricSyllable.scm:11
#: ../actions/menus/ObjectMenu/Lyrics/InsertStanzaNumber.scm:11
msgid "Italic"
msgstr "Kursiv"

#: ../src/ui/markup.c:525
msgid "Inserts markup to make the selected text italic."
msgstr "Infogar markup som gör den markerade texten kursiv."

#: ../src/ui/markup.c:529 ../actions/denemo.scm:281 ../actions/denemo.scm:342
msgid "Upright"
msgstr "Rak stil"

#: ../src/ui/markup.c:530
msgid "Inserts markup to make the selected text not italic."
msgstr "Infogar formateringskod som gör den markerade texten rak i stället för kursiv."

#: ../src/ui/markup.c:534
msgid "Un-Bold"
msgstr "Ej fetmarkerad"

#: ../src/ui/markup.c:535
msgid "Inserts markup to make the selected text not bold."
msgstr "Infogar markup som gör att den markerade texten inte är fet."

#: ../src/ui/markup.c:539
msgid "Superscript"
msgstr "Upphöjt"

#: ../src/ui/markup.c:540
msgid "Inserts markup to make the selected text as superscript."
msgstr "Infogar markup som gör den markerade texten upphöjd."

#: ../src/ui/markup.c:544
msgid "Subscript"
msgstr "Nedsänkt"

#: ../src/ui/markup.c:545
msgid "Inserts markup to make the selected text as subscript."
msgstr "Infogar formateringskod som gör den markerade texten nedsänkt."

#: ../src/ui/markup.c:549
msgid "Column"
msgstr "Kolumn"

#: ../src/ui/markup.c:550
msgid "Inserts markup to place the selected text in a column. You can nest lines inside columns."
msgstr "Infogar formateringskod som placerar den markerade texten i en kolumn. Du kan nästla rader i kolumner."

#: ../src/ui/markup.c:554
msgid "Line"
msgstr "Rad"

#: ../src/ui/markup.c:555
msgid "Inserts markup to place the selected text in a line."
msgstr "Infogar formateringskod som placerar den markerade texten på en rad."

#: ../src/ui/markup.c:559
msgid "Box"
msgstr "Ruta"

#: ../src/ui/markup.c:560
msgid "Inserts markup to place the selected text in a box."
msgstr "Infogar formateringskod som placerar den markerade texten i en ruta."

#: ../src/ui/markup.c:586
msgid "Insert (with value)"
msgstr "Infoga (med ett värde)"

#: ../src/ui/markup.c:587
msgid "Pop up a menu of insertions that require a value to insert."
msgstr "Öppna en meny med inmatningar som kräver ett värde för att matas in."

#: ../src/ui/markup.c:591
msgid "Paste Current Snippet"
msgstr "Klistra in aktuell musiksnutt"

#: ../src/ui/markup.c:592
msgid ""
"Pastes the music captured in the currently selected Snippet into the text at the cursor.\n"
"The music appears here in the LilyPond syntax.\n"
"It will print as typeset music embedded in the sentence you are writing.\n"
"You can edit the syntax following the LilyPond syntax.\n"
msgstr ""
"Klistrar in musiken från den aktuella musiksnutten i texten vid markören.\n"
"Musiken visas här som LilyPond-kod.\n"
"Vid utskrift visas den som satta noter i meningen du skriver.\n"
"Du kan redigera koden enligt LilyPonds syntax.\n"

#: ../src/ui/markup.c:601
msgid "Paste Chord Symbol"
msgstr "Klistra in ackordsymbol"

#: ../src/ui/markup.c:602
msgid ""
"Pastes chord symbol for the chord at the cursor in a choice of font style and size.\n"
"The chord is pasted as LilyPond markup.\n"
"It will print as the chord symbol (fakechord) in the sentence you are writing, transposed according to any global transposition you set.\n"
msgstr ""
"Klistrar in symbolen för ackordet vid markören med valfri teckensnittsstil och storlek.\n"
"Ackordet infogas som LilyPond-markup.\n"
"Vid utskrift visas ackordsymbolen (fakechord) i meningen du skriver, transponerad enligt eventuell global transponering.\n"

#: ../src/ui/markup.c:610
msgid "Paste Fret Diagram"
msgstr "Klistra in ackorddiagram"

#: ../src/ui/markup.c:611
msgid ""
"Pastes the chord at the cursor as a Fret Diagram\n"
"The music appears here in the LilyPond syntax.\n"
"It will print as fret diagram in the sentence you are writing, transposed according to the global transposition set.\n"
msgstr ""
"Klistrar in ackordet vid markören som ett ackorddiagram.\n"
"Musiken visas här som LilyPond-kod.\n"
"Vid utskrift visas ett ackorddiagram i meningen du skriver, transponerat enligt den globala transponeringsinställningen.\n"

#: ../src/ui/markup.c:618
msgid "Insert “ Open Quotes"
msgstr "Infoga “ inledande citattecken"

#: ../src/ui/markup.c:619
msgid "Inserts open double quote. Note that this is not the \" character which is used for grouping words not to be treated as markup. The \" marks must be paired or LilyPond will not typeset the music."
msgstr "Infogar ett inledande dubbelt citattecken. Det är inte samma tecken som det raka citattecknet \", som används för att gruppera ord som inte ska tolkas som formateringskod. De raka citattecknen måste förekomma parvis, annars kan LilyPond inte sätta noterna."

#: ../src/ui/markup.c:623
msgid "Insert ” Close Quotes"
msgstr "Infoga ” avslutande citattecken"

#: ../src/ui/markup.c:624
msgid "Inserts close double quote. Note that this is not the \" character which is used for grouping words  not to be treated as markup. The \" marks must be paired or LilyPond will not typeset the music."
msgstr "Infogar ett avslutande dubbelt citattecken. Det är inte samma tecken som det raka citattecknet \", som används för att gruppera ord som inte ska tolkas som formateringskod. De raka citattecknen måste förekomma parvis, annars kan LilyPond inte sätta noterna."

#: ../src/ui/markup.c:628
msgid "Segno"
msgstr "Segno"

#: ../src/ui/markup.c:629
msgid "Inserts Segno sign at the cursor position in the text."
msgstr "Infogar ett segnotecken vid markörens position i texten."

#: ../src/ui/markup.c:633
msgid "Coda"
msgstr "Coda"

#: ../src/ui/markup.c:634
msgid "Inserts Coda sign at the cursor position in the text."
msgstr "Infogar ett codatecken vid markörens position i texten."

#: ../src/ui/markup.c:660
msgid "Menu of special characters and graphics to insert at the cursor position"
msgstr "Meny med specialtecken och grafik som ska infogas vid markörens position"

#: ../src/ui/markup.c:665
msgid ""
"Makes the next Snippet the one that can be pasted.\n"
"To see the music snippets you need to check View → Snippets\n"
"The one selected is in bold black."
msgstr ""
"Väljer nästa musiksnutt för inklistring.\n"
"För att se musiksnuttarna aktiverar du Visa → Musiksnuttar.\n"
"Den valda musiksnutten visas med fet svart stil."

#: ../src/ui/markup.c:673
msgid "Selection"
msgstr "Markering"

#: ../src/ui/markup.c:674
msgid "Pops up a menu to apply some style to the selection."
msgstr "Öppnar en meny för att tillämpa en stil på markeringen."

#: ../src/ui/markup.c:680
msgid "Inserts the markup needed to leave space above this line of text. Ineffective on the top line of standalone text, instead drag such text in the Print View"
msgstr "Infogar formateringskod som lämnar utrymme ovanför denna textrad. Detta har ingen effekt på den översta raden i fristående text; dra i stället sådan text i utskriftsvyn."

#: ../src/ui/markup.c:691
msgid "Preview"
msgstr "Förhandsvisa"

#: ../src/ui/markup.c:692
msgid "Shows what the text will look like when typeset in the Print View window. For score and movement titles the appearance is correct only relative to the default title."
msgstr "Visar hur texten kommer att se ut när den sätts i fönstret Utskriftsvy. För partitur- och satstitlar är utseendet korrekt endast i förhållande till standardtiteln."

#: ../src/ui/mousing.c:1008
msgid "Right Click Appending."
msgstr "Högerklick vid tillägg i slutet."

#: ../src/ui/mousing.c:1008
msgid "This pops up the append menu"
msgstr "Öppnar menyn för att lägga till i slutet"

#: ../src/ui/mousing.c:1018
msgid "Control-Right Click."
msgstr "Ctrl-Högerklicka."

#: ../src/ui/mousing.c:1018
msgid "This pops up menu for inserting barlines and many other sorts of objects"
msgstr "Öppnar en meny för att infoga taktstreck och många andra typer av objekt"

#: ../src/ui/mousing.c:1025
msgid "Shift-Right Click."
msgstr "Skift-högerklicka."

#: ../src/ui/mousing.c:1025
msgid "This allows editing the directives/attributes of the object at the cursor"
msgstr "Detta gör det möjligt att redigera direktiven/attributen för objektet vid markören"

#: ../src/ui/mousing.c:1058
msgid "Dragging line separator."
msgstr "Drar radavgränsare."

#: ../src/ui/mousing.c:1058
msgid "This will allow the display to show more music, split into lines. The typeset score is not affected."
msgstr "Detta gör att notvyn kan visa mer musik, uppdelad på rader. Det satta partituret påverkas inte."

#: ../src/ui/mousing.c:1069
msgid "Dragging measure width/staff spacing."
msgstr "Drar för att ändra taktbredd/avstånd mellan notsystem."

#: ../src/ui/mousing.c:1069
msgid "This will widen/narrow the measures/staffs in the display."
msgstr "Detta gör takterna/notsystemen bredare eller smalare i visningen."

#: ../src/ui/mousing.c:1097
msgid "Double Click Note Onset"
msgstr "Dubbelklick på tonansats"

#: ../src/ui/mousing.c:1097
msgid ""
"This represents detected note onsets which occur\n"
"before the start of the score.\n"
"If they are just noise,\n"
"or if you are working on just a portion of the audio that is ok.\n"
"Otherwise drag with left mouse button to synchronize\n"
"with the start of the score."
msgstr ""
"Detta representerar upptäckta tonansatser som inträffar\n"
"före början av partituret.\n"
"Om de bara är brus,\n"
"eller om du bara arbetar med en del av ljudet är det ok.\n"
"Annars drar du med vänster musknapp för att synkronisera\n"
"med början av partituret."

#: ../src/ui/mousing.c:1101
msgid "Double Click Recorded MIDI Note"
msgstr "Dubbelklicka på inspelad MIDI-not"

#: ../src/ui/mousing.c:1101
msgid "This marks/un-marks the current recorded MIDI note."
msgstr "Markerar/upphäver markeringen av den aktuella MIDI-noten."

#: ../src/ui/mousing.c:1119
msgid "Left on Note Onset"
msgstr "Vänsterklick på tonansats"

#: ../src/ui/mousing.c:1119
msgid "preparing to drag..."
msgstr "förbereder sig för att dra…"

#: ../src/ui/mousing.c:1121
msgid "Start Playing Recording"
msgstr "Starta uppspelning av inspelningen"

#: ../src/ui/mousing.c:1121
msgid "This starts playing the recorded MIDI notes from the marked onset"
msgstr "Detta startar uppspelningen av de inspelade MIDI-noterna från den markerade startpunkten"

#: ../src/ui/mousing.c:1139
msgid "Control-Shift Left click on MIDI Recording Track"
msgstr "Control-Skift-vänsterklick på MIDI-inspelningsspåret"

#: ../src/ui/mousing.c:1139
msgid "Starts/Stops playback of recorded MIDI from marked note."
msgstr "Startar/stoppar uppspelning av inspelad MIDI från markerad not."

#: ../src/ui/mousing.c:1147
msgid "Control Left click on MIDI Recording Track"
msgstr "Control-vänsterklick på MIDI-inspelningsspåret"

#: ../src/ui/mousing.c:1147
msgid "Start dragging to change tempo of MIDI recorded track."
msgstr "Börja dra för att ändra tempot på det MIDI-inspelade spåret."

#: ../src/ui/mousing.c:1156
msgid "Shift Left click on MIDI Recording Track"
msgstr "Skift-vänsterklick på MIDI-inspelningsspåret"

#: ../src/ui/mousing.c:1156
msgid "Drag the marked MIDI note to synchronize to a place in the score."
msgstr "Dra den markerade MIDI-noten för att synkronisera den till en plats i partituret."

#: ../src/ui/mousing.c:1163
msgid "Left Click Recorded MIDI Note"
msgstr "Vänsterklick på inspelad MIDI-not"

#: ../src/ui/mousing.c:1163
msgid "This marks the current recorded MIDI note."
msgstr "Här markeras den aktuella MIDI-noten som spelats in."

#: ../src/ui/mousing.c:1171
msgid "Right click on MIDI Recording Track"
msgstr "Högerklicka på MIDI-inspelningsspåret"

#: ../src/ui/mousing.c:1171
msgid "Menu of options for MIDI recorded track."
msgstr "Meny med alternativ för MIDI-inspelat spår."

#: ../src/ui/mousing.c:1244 ../src/ui/mousing.c:1258 ../src/ui/mousing.c:1299
msgid "Press Left."
msgstr "Tryck vänster."

#: ../src/ui/mousing.c:1244
msgid "This moved the cursor to the measure offscreen left. The display is shifted to place that measure on screen."
msgstr "Detta flyttade markören till takten utanför skärmen till vänster. Vyn flyttas så att takten visas på skärmen."

#: ../src/ui/mousing.c:1258
msgid "This moved the cursor to the measure off-screen right. That measure becomes the second from the left."
msgstr "Detta flyttade markören till takten utanför skärmen till höger. Takten blir den andra från vänster."

#: ../src/ui/mousing.c:1282
msgid "Double Click on Click Track"
msgstr "Dubbelklicka på klickspåret"

#: ../src/ui/mousing.c:1282
msgid "This will mark the MIDI note onset."
msgstr "Detta markerar MIDI-notens ansats."

#: ../src/ui/mousing.c:1290
msgid "Double Click."
msgstr "Dubbelklicka."

#: ../src/ui/mousing.c:1290
msgid "This gives information about the object at the cursor. Click on a notehead for information about a note in a chord."
msgstr "Detta ger information om objektet vid markören. Klicka på ett nothuvud för att få information om en not i ett ackord."

#: ../src/ui/mousing.c:1299
msgid "This moved the cursor to the object position clicked. The cursor height becomes the clicked point."
msgstr "Detta flyttar markören till den klickade objektpositionen. Markörens höjd blir den klickade punkten."

#: ../src/ui/mousing.c:1311
msgid ""
"The clef shown here affects the display only (as this voice is displayed on the staff above). You can change the display clef using the clef menu.\n"
"Warning! you will get confused if you set the key signature or time signature of a voice different to the staff it is typeset on. Run the Staff/Voice property editor to adjust any inconsistencies."
msgstr ""
"Klaven som visas här påverkar endast notvyn, eftersom denna stämma visas på notsystemet ovanför. Du kan ändra visningsklaven i klavmenyn.\n"
"Varning! Det blir förvirrande om stämman har en annan tonartsbeteckning eller taktart än notsystemet där den sätts. Använd egenskapsredigeraren för notsystem/stämma för att rätta eventuella skillnader."

#: ../src/ui/mousing.c:1324
msgid "Left on Part name."
msgstr "Vänsterklick på stämnamnet."

#: ../src/ui/mousing.c:1324
msgid "This pops up the built-in staff properties. For other properties of the current staff see the staff menu or the tools icon before the clef."
msgstr "Öppnar de inbyggda egenskaperna för notsystemet. Andra egenskaper för det aktuella notsystemet finns i notsystemsmenyn eller via verktygsikonen framför klaven."

#: ../src/ui/mousing.c:1336
msgid "Left on initial Clef."
msgstr "Vänsterklick på den inledande klaven."

#: ../src/ui/mousing.c:1336
msgid "This pops up the initial clef menu."
msgstr "Öppnar menyn för den inledande klaven."

#: ../src/ui/mousing.c:1349
msgid "Left Click on blue."
msgstr "Vänsterklicka på blå."

#: ../src/ui/mousing.c:1349
msgid "This adds one sharp."
msgstr "Detta lägger till ett korsförtecken."

#: ../src/ui/mousing.c:1351 ../src/ui/mousing.c:1359
msgid "Initial Key Signature Change"
msgstr "Ändra den inledande tonartsbeteckningen"

#: ../src/ui/mousing.c:1351
msgid "Sharpen Keysignature?"
msgstr "Ändra tonartsbeteckningen mot korsförtecken?"

#: ../src/ui/mousing.c:1357
msgid "Left Click on red."
msgstr "Vänsterklicka på rött."

#: ../src/ui/mousing.c:1357
msgid "This adds one flat."
msgstr "Detta lägger till ett b-förtecken."

#: ../src/ui/mousing.c:1359
msgid "Flatten Keysignature?"
msgstr "Ändra tonartsbeteckningen mot b-förtecken?"

#: ../src/ui/mousing.c:1366
msgid "Right Click on key."
msgstr "Högerklick på tonartsbeteckningen."

#: ../src/ui/mousing.c:1366
msgid "This pops up the key signature menu."
msgstr "Öppnar menyn för tonartsbeteckning."

#: ../src/ui/mousing.c:1375
msgid "Click on Time."
msgstr "Klick på taktarten."

#: ../src/ui/mousing.c:1375
msgid "This pops up the time signature menu."
msgstr "Öppnar taktartsmenyn."

#: ../src/ui/mousing.c:1397
msgid "Editing Staff Groups (Braces)"
msgstr "Redigera notsystemsgrupper (klamrar)"

#: ../src/ui/mousing.c:1397
msgid "Edit Start Brace"
msgstr "Redigera startklammer"

#: ../src/ui/mousing.c:1397
msgid "Edit End Brace"
msgstr "Redigera slutklammer"

#: ../src/ui/mousing.c:1412
msgid "This staff grouping has no End Brace so it finishes on the lowest staff. Use the Staffs/Voices->Staff Groupings menu to place an End Brace on the desired staff"
msgstr "Denna notsystemsgrupp har ingen slutklammer och avslutas därför vid det nedersta notsystemet. Använd menyn Notsystem/stämmor->Notsystemsgrupperingar för att placera en slutklammer vid önskat notsystem"

#: ../src/ui/mousing.c:1432
msgid "Click on Staff Directives."
msgstr "Klicka på Notsystemsdirektiv."

#: ../src/ui/mousing.c:1432
msgid "This pops up the staff directives menu for editing"
msgstr "Detta öppnar menyn för notsystemsdirektiv för redigering"

#: ../src/ui/mousing.c:1441
msgid "Click on Voice Directives."
msgstr "Klicka på stämmodirektiv."

#: ../src/ui/mousing.c:1441
msgid "This pops up the voice directives menu for editing"
msgstr "Detta öppnar menyn för stämmodirektiv för redigering"

#: ../src/ui/mousing.c:1464
msgid "Control-Shift-Drag."
msgstr "Dra med Control och Skift."

#: ../src/ui/mousing.c:1464
msgid ""
"This allows dragging objects in the display.\n"
"All sorts of directives such as staccato dots, ornaments, repeat marks etc can be dragged if the display is too cluttered.\n"
"The typeset score is unaffected.\n"
"Click on a notehead to drag things attached to the notehead,\n"
"or off the noteheads for things attached to the whole chord."
msgstr ""
"Du kan dra objekt i notvyn.\n"
"Direktiv som staccatopunkter, ornament och repristecken kan flyttas om vyn är för rörig.\n"
"Det satta partituret påverkas inte.\n"
"Klicka på ett nothuvud för att dra sådant som hör till just den noten,\n"
"eller utanför nothuvudena för sådant som hör till hela ackordet."

#: ../src/ui/mousing.c:1473
msgid ""
"Control-Shift-Drag is used to tidy up the Denemo display. Useful if Denemo has created a clutter with your input music.\n"
"If you have several things attached to one object you can move them in turn by dragging them in turn.\n"
"Notes, Slurs and Ties are fixed but most other things can be moved to make the input music clear. Does not affect the typeset score!\n"
"NB! if you have dragged something to one side of a note you have to control-shift-click on the note itself to drag it back - it is where the cursor is that counts."
msgstr ""
"Dra med Control och Skift för att ordna objekten i Denemos notvy. Det är användbart om den inmatade musiken har blivit rörig.\n"
"Om flera saker hör till ett objekt kan du flytta dem en i taget genom att dra upprepade gånger.\n"
"Noter, legatobågar och bindebågar ligger fast, men det mesta annat kan flyttas för att göra notvyn tydligare. Det satta partituret påverkas inte!\n"
"Obs! Om du har dragit något åt sidan om en not måste du klicka på själva noten med Control och Skift för att dra tillbaka det. Det är markörens position som räknas."

#: ../src/ui/mousing.c:1543
msgid "Dragged line separator."
msgstr "Drog radavgränsare."

#: ../src/ui/mousing.c:1543
msgid "This allows the display to show more music, split into lines. The typeset score is not affected."
msgstr "Detta gör att notvyn kan visa mer musik, uppdelad på rader. Det satta partituret påverkas inte."

#: ../src/ui/mousing.c:1589
msgid "Ctrl + Mouse Wheel Up"
msgstr "Ctrl + mushjul upp"

#: ../src/ui/mousing.c:1598
msgid "Shift + Mouse Wheel Up"
msgstr "Skift + Mushjul Upp"

#: ../src/ui/mousing.c:1607
msgid "Unshifted + Mouse Wheel Up"
msgstr "Mushjul upp utan Skift"

#: ../src/ui/mousing.c:1628
msgid "Ctrl + Mouse Wheel Down"
msgstr "Ctrl + mushjul nedåt"

#: ../src/ui/mousing.c:1640
msgid "Shift + Mouse Wheel Down"
msgstr "Skift + mushjulet nedåt"

#: ../src/ui/mousing.c:1648
msgid "Unshifted + Mouse Wheel Down"
msgstr "Mushjul ned utan Skift"

#: ../src/ui/mwidthdialog.c:61
msgid "Set minimum measure width"
msgstr "Ange minsta taktbredd"

#: ../src/ui/mwidthdialog.c:68
msgid "Enter width (in pixels) of measures:"
msgstr "Ange takternas bredd i pixlar:"

#: ../src/ui/palettes.c:61 ../src/ui/palettes.c:205
msgid "Destroy All Palettes"
msgstr "Ta bort alla paletter"

#: ../src/ui/palettes.c:61
msgid "Get rid of all palettes permanently?"
msgstr "Bli av med alla paletter permanent?"

