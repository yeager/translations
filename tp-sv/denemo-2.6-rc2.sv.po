#: ../actions/menus/MainMenu/ViewMenu/DisplayEditingTime.scm:2
msgid "This score has taken\n"
msgstr "Denna poäng har tagit\n"

#: ../actions/menus/MainMenu/ViewMenu/DisplayEditingTime.scm:2
