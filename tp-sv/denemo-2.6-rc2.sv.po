msgstr "Detta objekt (%s) börjar %d 𝅘𝅥 in i takten och varar %d/%d 𝅘𝅥.\n"

#: ../src/command/object.c:695
#, c-format
msgid "This %s starts %d/%d 𝅘𝅥  's into the measure and lasts %d 𝅘𝅥 's.\n"
msgstr "Detta objekt (%s) börjar %d/%d 𝅘𝅥 in i takten och varar %d 𝅘𝅥.\n"

