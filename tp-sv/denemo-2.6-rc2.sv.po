#: ../actions/menus/ObjectMenu/NotesRests/Markings/Articulations/HarmonicSelectionSwitcher.xml.h:1
#: ../actions/menus/ObjectMenu/NotesRests/Markings/Articulations/ToggleHarmonic.xml.h:1
