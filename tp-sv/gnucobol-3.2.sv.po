msgstr "specialregister att aktivera"

#: cobc/help.c:287
msgid "<word> or <word>:<definition>, where definition uses backslash escaped spaces"
msgstr "<ord> eller <ord>:<definition>, där definitionen använder blanksteg med omvänt snedstreck som escape-tecken"

#: cobc/parser.y:307
#, c-format
msgid "'%s' should start in Area A"
msgstr "”%s” ska börja i Area A"

#: cobc/parser.y:315
