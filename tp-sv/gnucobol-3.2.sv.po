msgid "word to be taken out of the reserved words list"
msgstr "ord som tas ut ur listan över reserverade ord"

#: cobc/help.c:282 cobc/help.c:283 cobc/help.c:285
msgid "<word>"
msgstr "<ord>"

#: cobc/help.c:283
msgid "word to be added to reserved words list"
msgstr "ord som läggs till listan över reserverade ord"

#: cobc/help.c:284
msgid "word to be added to reserved words list as alias"
msgstr "ord som läggs till listan över reserverade ord som alternativnamn"

#: cobc/help.c:284
msgid "<word>:<alias>"
msgstr "<ord>:<alternativnamn>"

#: cobc/help.c:285
msgid "special register to disable"
msgstr "specialregister att inaktivera"

#: cobc/help.c:286
