msgstr "ENTRY ”%s” duplicerad"

#: cobc/parser.y:594
#, c-format
msgid "ENTRY FOR GO TO '%s' duplicated"
msgstr "ENTRY FOR GO TO ”%s” duplicerad"

#: cobc/parser.y:610
#, c-format
