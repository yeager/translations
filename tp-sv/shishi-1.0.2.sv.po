#: lib/error.c:33
msgid "Shishi success"
msgstr "Shishi lyckades"

#: lib/error.c:35
msgid "Error in ASN.1 function (corrupt data?)"
msgstr "Fel i ASN.1-funktionen (skadade data?)"

#: lib/error.c:37
msgid "Could not open file"
msgstr "Kunde inte öppna filen"

#: lib/error.c:39
msgid "File input/output error"
msgstr "Fel vid in- eller utmatning av fil"

#: lib/error.c:41
msgid "Memory allocation error in shishi library."
msgstr "Minnesallokeringsfel i Shishi-biblioteket."

#: lib/error.c:43
msgid "Base64 encoding or decoding failed. Data corrupt?"
msgstr "Base64-kodning/-avkodning misslyckades. Skadade data?"

#: lib/error.c:45
msgid "Client realm value differ between request and reply."
msgstr "Klientens domänvärde skiljer sig mellan förfrågan och svar."

#: lib/error.c:47
msgid "Client name value differ between request and reply."
msgstr "Klientens namn skiljer sig mellan förfrågan och svar."

#: lib/error.c:49
msgid "Replay protection value (nonce) differ between request and reply."
msgstr "Värdet för återuppspelningsskydd (nonce) skiljer sig mellan förfrågan och svar."

#: lib/error.c:51
msgid "Incorrect key type used in TGS reply."
msgstr "Felaktig nyckeltyp användes i TGS-svaret."

#: lib/error.c:53
msgid "Incorrect key type used in reply from KDC."
msgstr "Felaktig nyckeltyp användes i svaret från KDC."

#: lib/error.c:55
msgid "Incorrect key type used in AP reply."
msgstr "Felaktig nyckeltyp användes i AP-svaret."

#: lib/error.c:57
msgid "Failed verification of AP reply."
msgstr "Verifieringen av AP-svaret misslyckades."

#: lib/error.c:59
msgid "Incorrect key type used in AP request."
msgstr "Felaktig nyckeltyp användes i AP-förfrågan."

#: lib/error.c:61
msgid "Provided buffer was too small."
msgstr "Den angivna bufferten var för liten."

#: lib/error.c:63
msgid "Derived key material is too short to be applicable."
msgstr "Det härledda nyckelmaterialet är för kort för att kunna användas."

#: lib/error.c:65
msgid "The key is too large to be usable."
msgstr "Nyckeln är för stor för att kunna användas."

#: lib/error.c:67
msgid "Low-level cryptographic primitive failed.  This usually indicates bad password or data corruption."
msgstr "En kryptografisk grundfunktion misslyckades. Det tyder vanligtvis på fel lösenord eller skadade data."

#: lib/error.c:70
msgid "Internal error in low-level crypto routines."
msgstr "Internt fel i kryptografiska grundrutiner."

#: lib/error.c:72
msgid "The system call socket() failed.  This usually indicates that your system does not support the socket type."
msgstr "Systemanropet socket() misslyckades. Det tyder vanligtvis på att systemet inte stöder uttagstypen."

#: lib/error.c:75
msgid "The system call bind() failed.  This usually indicates insufficient permissions."
msgstr "Systemanropet bind() misslyckades. Det tyder vanligtvis på otillräckliga behörigheter."

#: lib/error.c:78
msgid "The system call sendto() failed."
msgstr "Systemanropet sendto() misslyckades."

#: lib/error.c:80
msgid "Error receiving data from server"
msgstr "Fel vid mottagning av data från servern"

#: lib/error.c:82
msgid "The system call close() failed."
msgstr "Systemanropet close() misslyckades."

#: lib/error.c:84
msgid "Timed out talking to KDC. This usually indicates a network or KDC address problem."
msgstr "Tidsgränsen överskreds vid kommunikation med KDC. Det tyder vanligtvis på ett nätverksfel eller ett fel i KDC-adressen."

#: lib/error.c:87
msgid "No KDC known for given realm."
msgstr "Ingen KDC är känd för den angivna domänen."

#: lib/error.c:89
msgid "No TTY assigned to process."
msgstr "Ingen TTY har tilldelats processen."

#: lib/error.c:91
msgid "Server replied to the request with an error message."
msgstr "Servern svarade på förfrågan med ett felmeddelande."

#: lib/error.c:93
msgid "Failure to use handle.  Missing handle, or misconfigured."
msgstr "Det gick inte att använda handtaget. Det saknas eller är felkonfigurerat."

#: lib/error.c:95
msgid "Ticket set not initialized.  This usually indicates an internal application error."
msgstr "Biljettuppsättningen har inte initierats. Det tyder vanligtvis på ett internt programfel."

#: lib/error.c:98
msgid "Key type used to encrypt ticket doesn't match provided key. This usually indicates an internal application error."
msgstr "Nyckeltypen som användes för att kryptera biljetten stämmer inte överens med den angivna nyckeln. Det tyder vanligtvis på ett internt programfel."

#: lib/error.c:101
msgid "Reference to invalid encryption key."
msgstr "Referens till en ogiltig krypteringsnyckel."

#: lib/error.c:103
msgid "Could not decrypt AP-REQ using provided key. This usually indicates an internal application error."
msgstr "Kunde inte dekryptera AP-REQ med den angivna nyckeln. Det tyder vanligtvis på ett internt programfel."

#: lib/error.c:106
msgid "Could not decrypt Ticket using provided key. This usually indicates an internal application error."
msgstr "Kunde inte dekryptera biljetten med den angivna nyckeln. Det tyder vanligtvis på ett internt programfel."

#: lib/error.c:109
msgid "Invalid ticked passed in call."
msgstr "En ogiltig biljett angavs i anropet."

#: lib/error.c:111
msgid "Argument lies outside of valid range."
msgstr "Argumentet ligger utanför det giltiga intervallet."

#: lib/error.c:113
msgid "The ASN.1 structure does not contain the indicated element."
msgstr "ASN.1-strukturen innehåller inte det angivna elementet."

#: lib/error.c:115
msgid "Attempted access to non-existent key type."
msgstr "Försök att komma åt en obefintlig nyckeltyp."

#: lib/error.c:117 lib/error.c:135
msgid "Verification failed on either side."
msgstr "Verifieringen misslyckades på någon av sidorna."

#: lib/error.c:119
msgid "Invalid PKCS5 descriptor."
msgstr "Ogiltig PKCS5-deskriptor."

#: lib/error.c:121
msgid "Invalid claim of iteration count in PKCS5 descriptor."
msgstr "Ogiltigt värde för iterationsantal i PKCS5-deskriptorn."

#: lib/error.c:123
msgid "Derived key length is incorrect for PKCS5 descriptor."
msgstr "Den härledda nyckellängden är felaktig för PKCS5-deskriptorn."

#: lib/error.c:125
msgid "Derived key is too long for PKCS5 descriptor."
msgstr "Den härledda nyckeln är för lång för PKCS5-deskriptorn."

#: lib/error.c:127
msgid "Principal name syntax error."
msgstr "Syntaxfel i huvudnamnet."

#: lib/error.c:129
msgid "Invalid argument passed in call.  Wrong or unknown value."
msgstr "Ett ogiltigt argument angavs i anropet. Felaktigt eller okänt värde."

#: lib/error.c:131
msgid "The indicated ASN.1 element does not carry a value."
msgstr "Det angivna ASN.1-elementet innehåller inget värde."

#: lib/error.c:133
msgid "Connection attempt failed.  Try again, or check availability."
msgstr "Anslutningsförsöket misslyckades. Försök igen eller kontrollera tillgängligheten."

#: lib/error.c:137
msgid "The private key uses an incompatible encryption type."
msgstr "Den privata nyckeln använder en inkompatibel krypteringstyp."

#: lib/error.c:139
msgid "The desired file could not be accessed.  Check permissions."
msgstr "Den efterfrågade filen gick inte att komma åt. Kontrollera behörigheterna."

#: lib/error.c:141
msgid "The present AP reply specifies an inpermissible key type."
msgstr "Det aktuella AP-svaret anger en otillåten nyckeltyp."

#: lib/error.c:143
msgid "A request for present time of day has failed. This is usually internal, but a valid time is imperative for us."
msgstr "Begäran om aktuell tid misslyckades. Felet är vanligtvis internt, men en giltig tid är nödvändig."

#: lib/error.c:146
msgid "Failed to parse keytab file"
msgstr "Kunde inte tolka keytab-filen"

#: lib/error.c:148
msgid "Failed to parse credential cache file"
msgstr "Kunde inte tolka cachefilen med autentiseringsuppgifter"

#: lib/error.c:165
msgid "Unknown error"
msgstr "Okänt fel"

#: lib/error.c:196 lib/krberror.c:1259
msgid "No error"
msgstr "Inget fel"

#: lib/error.c:326
#, c-format
msgid "libshishi: info: %s"
msgstr "libshishi: info: %s"

#: lib/error.c:330
#, c-format
msgid "libshishi: info: %s\n"
msgstr "libshishi: info: %s\n"

#: lib/error.c:364
#, c-format
msgid "libshishi: warning: %s"
msgstr "libshishi: varning: %s"

#: lib/error.c:368
#, c-format
msgid "libshishi: warning: %s\n"
msgstr "libshishi: varning: %s\n"

#: lib/krberror.c:137
#, c-format
msgid "Writing KRB-ERROR to %s...\n"
msgstr "Skriver KRB-ERROR till %s…\n"

#: lib/krberror.c:144
#, c-format
msgid "Writing KRB-ERROR in %s format...\n"
msgstr "Skriver KRB-ERROR i %s-format…\n"

#: lib/krberror.c:159
#, c-format
msgid "Writing KRB-ERROR to %s...done\n"
msgstr "Skriver KRB-ERROR till %s… klart\n"

#: lib/krberror.c:217
#, c-format
msgid "Reading KRB-ERROR from %s...\n"
msgstr "Läser KRB-ERROR från %s…\n"

#: lib/krberror.c:224
#, c-format
msgid "Reading KRB-ERROR in %s format...\n"
msgstr "Läser KRB-ERROR i %s-format…\n"

#: lib/krberror.c:239
#, c-format
msgid "Reading KRB-ERROR from %s...done\n"
msgstr "Läser KRB-ERROR från %s… klart\n"

#: lib/krberror.c:1261
msgid "Client's entry in database has expired"
msgstr "Klientens post i databasen har gått ut"

#: lib/krberror.c:1263
msgid "Server's entry in database has expired"
msgstr "Serverns post i databasen har gått ut"

#: lib/krberror.c:1265
msgid "Requested protocol version number not supported"
msgstr "Det begärda protokollversionsnumret stöds inte"

#: lib/krberror.c:1267
msgid "Client's key encrypted in old master key"
msgstr "Klientens nyckel är krypterad med en gammal huvudnyckel"

#: lib/krberror.c:1269
msgid "Server's key encrypted in old master key"
msgstr "Serverns nyckel är krypterad med en gammal huvudnyckel"

#: lib/krberror.c:1271
msgid "Client not found in database"
msgstr "Klienten finns inte i databasen"

#: lib/krberror.c:1273
msgid "Server not found in database"
msgstr "Servern finns inte i databasen"

#: lib/krberror.c:1275
msgid "Multiple principal entries in database"
msgstr "Flera huvudnamnsposter i databasen"

#: lib/krberror.c:1277
msgid "The client or server has a null key"
msgstr "Klienten eller servern har en nollnyckel"

#: lib/krberror.c:1279
msgid "Ticket not eligible for postdating"
msgstr "Biljetten kan inte efterdateras"

#: lib/krberror.c:1281
msgid "Requested start time is later than end time"
msgstr "Den begärda starttiden är senare än sluttiden"

#: lib/krberror.c:1283
msgid "KDC policy rejects request"
msgstr "KDC-policyn avvisar begäran"

#: lib/krberror.c:1285
msgid "KDC cannot accommodate requested option"
msgstr "KDC kan inte tillmötesgå det begärda alternativet"

#: lib/krberror.c:1287
msgid "KDC has no support for encryption type"
msgstr "KDC har inte stöd för krypteringstypen"

#: lib/krberror.c:1289
msgid "KDC has no support for checksum type"
msgstr "KDC har inte stöd för denna typ av kontrollsumma"

#: lib/krberror.c:1291
msgid "KDC has no support for padata type"
msgstr "KDC har inte stöd för padata-typen"

#: lib/krberror.c:1293
msgid "KDC has no support for transited type"
msgstr "KDC har inte stöd för transited-typen"

#: lib/krberror.c:1295
msgid "Clients credentials have been revoked"
msgstr "Klientens autentiseringsuppgifter har återkallats"

#: lib/krberror.c:1297
msgid "Credentials for server have been revoked"
msgstr "Serverns autentiseringsuppgifter har återkallats"

#: lib/krberror.c:1299
msgid "TGT has been revoked"
msgstr "TGT har återkallats"

#: lib/krberror.c:1301
msgid "Client not yet valid - try again later"
msgstr "Klienten är ännu inte giltig; försök igen senare"

#: lib/krberror.c:1303
msgid "Server not yet valid - try again later"
msgstr "Servern är ännu inte giltig; försök igen senare"

#: lib/krberror.c:1305
msgid "Password has expired "
msgstr "Lösenordet har gått ut "

#: lib/krberror.c:1307
msgid "Pre-authentication information was invalid"
msgstr "Förautentiseringsinformationen var ogiltig"

#: lib/krberror.c:1309
msgid "Additional pre-authentication required"
msgstr "Ytterligare förautentisering krävs"

#: lib/krberror.c:1311
msgid "Requested server and ticket don't match"
msgstr "Den begärda servern och biljetten stämmer inte överens"

#: lib/krberror.c:1313
msgid "Server principal valid for user2user only"
msgstr "Serverns huvudnamn är endast giltigt för användare-till-användare"

#: lib/krberror.c:1315
msgid "KDC Policy rejects transited path"
msgstr "KDC-policyn avvisar transited-sökvägen"

#: lib/krberror.c:1317
msgid "A service is not available"
msgstr "En tjänst är inte tillgänglig"

#: lib/krberror.c:1319
msgid "Integrity check on decrypted field failed"
msgstr "Integritetskontrollen av det dekrypterade fältet misslyckades"

#: lib/krberror.c:1321
msgid "Ticket expired"
msgstr "Biljetten har gått ut"

#: lib/krberror.c:1323
msgid "Ticket not yet valid"
msgstr "Biljetten är ännu inte giltig"

#: lib/krberror.c:1325
msgid "Request is a replay"
msgstr "Begäran är en återuppspelning"

#: lib/krberror.c:1327
msgid "The ticket isn't for us"
msgstr "Biljetten är inte avsedd för oss"

#: lib/krberror.c:1329
msgid "Ticket and authenticator don't match"
msgstr "Biljetten och autentiseraren stämmer inte överens"

#: lib/krberror.c:1331
msgid "Clock skew too great"
msgstr "Klockavvikelse för stor"

#: lib/krberror.c:1333
msgid "Incorrect net address"
msgstr "Felaktig nätverksadress"

#: lib/krberror.c:1335
msgid "Protocol version mismatch"
msgstr "Protokollversionerna stämmer inte överens"

#: lib/krberror.c:1337
msgid "Invalid msg type"
msgstr "Ogiltig meddelandetyp"

#: lib/krberror.c:1339
msgid "Message stream modified"
msgstr "Meddelandeströmmen har ändrats"

#: lib/krberror.c:1341
msgid "Message out of order"
msgstr "Meddelandet kommer i fel ordning"

#: lib/krberror.c:1343
msgid "Specified version of key is not available"
msgstr "Den angivna versionen av nyckeln är inte tillgänglig"

#: lib/krberror.c:1345
msgid "Service key not available"
msgstr "Servicenyckeln är inte tillgänglig"

#: lib/krberror.c:1347
msgid "Mutual authentication failed"
msgstr "Ömsesidig autentisering misslyckades"

#: lib/krberror.c:1349
msgid "Incorrect message direction"
msgstr "Felaktig meddelanderiktning"

#: lib/krberror.c:1351
msgid "Alternative authentication method required"
msgstr "En alternativ autentiseringsmetod krävs"

#: lib/krberror.c:1353
msgid "Incorrect sequence number in message"
msgstr "Felaktigt sekvensnummer i meddelandet"

#: lib/krberror.c:1355
msgid "Inappropriate type of checksum in message"
msgstr "Olämplig kontrollsummetyp i meddelandet"

#: lib/krberror.c:1357
msgid "Policy rejects transited path"
msgstr "Policyn avvisar transited-sökvägen"

#: lib/krberror.c:1359
msgid "Response too big for UDP, retry with TCP"
msgstr "Svaret är för stort för UDP; försök med TCP"

#: lib/krberror.c:1361
msgid "Generic error (description in e-text)"
msgstr "Allmänt fel (beskrivning i e-text)"

#: lib/krberror.c:1363
msgid "Field is too long for this implementation"
msgstr "Fältet är för stort för den här implementeringen"

#: lib/krberror.c:1365 lib/krberror.c:1367 lib/krberror.c:1369
#: lib/krberror.c:1371 lib/krberror.c:1373 lib/krberror.c:1381
#: lib/krberror.c:1383 lib/krberror.c:1385 lib/krberror.c:1387
#: lib/krberror.c:1389 lib/krberror.c:1391 lib/krberror.c:1393
msgid "(pkinit)"
msgstr "(pkinit)"

#: lib/krberror.c:1375 lib/krberror.c:1377 lib/krberror.c:1379
msgid "(user-to-user)"
msgstr "(användare-till-användare)"

