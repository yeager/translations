msgstr "Okänd KRB-ERROR-kod %d."

#: db/err.c:33
msgid "Shisa success"
msgstr "Shisa lyckades"

#: db/err.c:35
msgid "Shisa could not be initialized."
msgstr "Shisa kunde inte initialiseras."

#: db/err.c:37
msgid "The Shisa configuration file does not exist."
msgstr "Konfigurationsfilen för Shisa finns inte."

#: db/err.c:39
msgid "File I/O error for Shisa configuration file."
msgstr "Fel vid in- eller utmatning av Shisas konfigurationsfil."

#: db/err.c:41
msgid "Syntax error in Shisa configuration token."
msgstr "Syntaxfel i Shisas konfigurationstoken."

#: db/err.c:43
msgid "Shisa database could not be opened."
msgstr "Shisas databas kunde inte öppnas."

#: db/err.c:45
msgid "Error enumerating realms in database."
msgstr "Fel vid uppräkning av domäner i databasen."

#: db/err.c:47
msgid "Error enumerating principals in database."
msgstr "Fel vid uppräkning av huvudnamn i databasen."

#: db/err.c:49
msgid "Error enumerating keys in database."
msgstr "Fel vid uppräkning av nycklar i databasen."

#: db/err.c:51
msgid "Supplied realm does not exist."
msgstr "Den angivna domänen finns inte."

#: db/err.c:53
msgid "Supplied principal does not exist."
msgstr "Det angivna huvudnamnet finns inte."

#: db/err.c:55
msgid "Principal is not associated with any matching key."
msgstr "Huvudnamnet är inte kopplat till någon matchande nyckel."

#: db/err.c:57
msgid "Error finding principal."
msgstr "Kunde inte hitta huvudnamnet."

#: db/err.c:59
msgid "Tried to add a realm that already exist."
msgstr "Försökte lägga till en domän som redan finns."

#: db/err.c:61
msgid "Error adding realm to database."
msgstr "Fel vid tillägg av domänen i databasen."

#: db/err.c:63
msgid "Tried to remove a non-empty realm."
msgstr "Försökte ta bort en domän som inte är tom."

#: db/err.c:65
msgid "Error removing realm from database."
msgstr "Fel vid borttagning av domänen från databasen."

#: db/err.c:67
msgid "Tried to add a principal that already exist."
msgstr "Försökte lägga till ett huvudnamn som redan finns."

#: db/err.c:69
msgid "Error adding principal to database."
msgstr "Fel vid tillägg av huvudnamnet i databasen."

#: db/err.c:71
msgid "Error removing principal from database."
msgstr "Fel vid borttagning av huvudnamnet från databasen."

#: db/err.c:73
msgid "Error adding key to principal."
msgstr "Fel vid tillägg av nyckeln till huvudnamnet."

#: db/err.c:75
msgid "Error removing key from principal."
msgstr "Fel vid borttagning av nyckeln från huvudnamnet."

#: db/err.c:77
msgid "More than one key match given search criteria."
msgstr "Fler än en nyckel matchar de angivna sökkriterierna."

#: db/err.c:98
msgid "Unknown Shisa error"
msgstr "Okänt Shisa-fel"

