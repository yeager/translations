#: doc/tin.5:1238
#, no-wrap
msgid "B<shortname>"
msgstr "B<shortname>"

#. type: Plain text
#: doc/tin.5:1242
msgid "nickname(s) for the nntpserver. Nicknames must not contain \":\" and must be unique."
msgstr "smeknamn för nntpserver. Smeknamn får inte innehålla \":\" och måste vara unika."

