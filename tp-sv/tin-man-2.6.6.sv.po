#, no-wrap
msgid "B<Color of highlighting with -stroke- (col_markstroke)>"
msgstr "B<Färg på markering med -stroke- (col_markstroke)>"

#. type: Plain text
#: doc/tin.1:1812 doc/tin.5:1572
msgid "Color of words emphasized like -this-. See also B<word_h_display_marks> and B<word_highlight>."
msgstr "Färg på ord som betonas som -detta-. Se även B<word_h_display_marks> och B<word_highlight>."

#. type: TP
#: doc/tin.1:1812
#, no-wrap
msgid "B<Color of mini help menu (col_minihelp)>"
msgstr "B<Färg på minihjälpmenyn (col_minihelp)>"

