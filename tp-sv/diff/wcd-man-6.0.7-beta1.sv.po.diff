+msgstr "Spärrfilen kan redigeras med en textredigerare. Du kan använda jokertecken och namnen matchas mot den absoluta sökvägen."
 
 #. type: textblock
 #: wcd.pod:256
 msgid "Banned paths are not excluded from scanning the disk. To do that use option B<-xf>."
-msgstr "Förbjudna sökvägar är inte uteslutna från avläsning av disk. För detta, använd flaggan B<-xf>."
+msgstr "Spärrade sökvägar utesluts inte när disken genomsöks. Använd flaggan B<-xf> för att göra det."
 
