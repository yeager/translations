@@ -421,22 +420,22 @@
 #. type: textblock
 #: wcd.pod:248
 msgid "Ban current path."
-msgstr "Förbjud nuvarande sökväg."
+msgstr "Spärra den aktuella sökvägen."
 
 #. type: textblock
 #: wcd.pod:250
 msgid "Wcd places the current path in the ban file. This means that wcd ignores all matches of this directory and its sub directories."
-msgstr "Wcd placerar den aktuella sökvägen i förbudsfilen. Detta betyder att wcd ignorerar alla matchningar av denna katalog och dess underkataloger."
