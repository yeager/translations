+"  -o, --noinit           : initiera inte modem och låsfiler vid uppstart\n"
+"  -m, --metakey          : använd Meta- eller Alt-tangent för kommandon\n"
+"  -M, --metakey8         : använd 8-bitars Meta-tangent för kommandon\n"
+"  -l, --ansi             : bokstavlig; anta att skärmen inte använder IBM-PC-teckenuppsättning\n"
+"  -L, --iso              : anta inte att skärmen använder ISO8859\n"
+"  -w, --wrap             : slå på radbrytning\n"
+"  -H, --displayhex       : visa utdata hexadecimalt\n"
+"  -z, --statline         : försök använda terminalens statusrad\n"
+"  -7, --7bit             : tvinga 7-bitarsläge\n"
+"  -8, --8bit             : tvinga 8-bitarsläge\n"
+"  -c, --color=on/off     : slå på eller av ANSI-färger\n"
+"  -a, --attrib=on/off    : slå på eller av omvända eller framhävda attribut\n"
 "  -t, --term=TERM        : åsidosätt miljövariabeln TERM\n"
-"  -S, --script=SKRIPT    : kör SKRIPT vid uppstart\n"
