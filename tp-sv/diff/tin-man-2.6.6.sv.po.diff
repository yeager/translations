 #: doc/tin.1:2364
 #, no-wrap
 msgid "B<Format string for the display of uue header at Article level (page_uue_format)>"
-msgstr "B<Formatsträng för visning av uue-huvud på artikelnivå (page_uue_format)>"
+msgstr "B<Formatsträng för visning av uue-rubrik på artikelnivå (page_uue_format)>"
 
 #. type: Plain text
 #: doc/tin.1:2369
 msgid "Format string B<tin> uses for uue header at Page level. See the section \"CUSTOMIZING THE SCREEN FORMAT\".  Default is \"[-- %T%S%*n%I%!d%*e --]\"."
-msgstr "Formatsträng som B<tin> använder för uue-huvudet på sidnivå. Se avsnittet \"ANPASSA SKÄRMFORMATET\".  Standard är \"[-- %T%S%*n%I%!d%*e --]\"."
+msgstr "Formatsträng som B<tin> använder för uue-rubriken på sidnivå. Se avsnittet \"ANPASSA SKÄRMFORMATET\".  Standard är \"[-- %T%S%*n%I%!d%*e --]\"."
 
 #. type: TP
