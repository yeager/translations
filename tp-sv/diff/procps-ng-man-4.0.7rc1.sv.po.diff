 #: ../man/procps.3:173
 msgid "Add #include E<lt>libproc2/xtra-procps-debug.hE<gt> to any program I<after> the named interface includes."
-msgstr "Lägg till #include E<lt>libproc2/xtra-procps-debug.hE<gt> till alla program I<efter> inkluderandet av de namngivna gränssnitten."
+msgstr "Lägg till #include E<lt>libproc2/xtra-procps-debug.hE<gt> i ett program I<efter> inkluderingarna för det namngivna gränssnittet."
 
 #. type: Plain text
 #: ../man/procps.3:177 ../man/procps_pids.3:191
 msgid "This verification feature incurs substantial overhead.  Therefore, it is important that it I<not> be activated for a production/release build."
-msgstr "Denna verifieringsfunktion orsakar en väsentlig kostnad. Därför är det viktigt att den I<inte> är aktiverad för produktions-/utgåvebyggen."
+msgstr "Denna verifieringsfunktion medför en betydande extrabelastning. Därför är det viktigt att den I<inte> aktiveras för produktions- eller utgåvebyggen."
 
