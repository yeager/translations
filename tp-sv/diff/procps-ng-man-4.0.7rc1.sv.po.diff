-msgstr "Lägg till CFLAGS='-DXTRA_PROCPS_DEBUG' till eventuella övriga flaggor som används till ./configure."
+msgstr "Lägg till CFLAGS='-DXTRA_PROCPS_DEBUG' bland övriga använda ./configure-flaggor."
 
 #. type: IP
 #: ../man/procps.3:170 ../man/procps_pids.3:184
@@ -15169,12 +15169,12 @@
