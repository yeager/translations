+msgstr "Antalet B<större> sidfel som inträffat för en uppgift. Ett sidfel inträffar när en process försöker läsa från eller skriva till en virtuell sida som inte för närvarande finns i dess adressrymd. Ett större sidfel uppstår när åtkomst till \\*(AS krävs för att göra sidan tillgänglig."
 
 #. type: TP
 #: ../man/top.1:1228
 #, no-wrap
 msgid "B<nMin \\*(Em Minor Page Fault count >"
-msgstr "B<aSmå \\*(Em Antal mindre sidfel >"
+msgstr "B<nMin \\*(Em Antal mindre sidfel >"
 
 #. type: Plain text
 #: ../man/top.1:1235
