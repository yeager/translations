+msgstr "3. ett urval är antingen skiftlägesokänsligt eller skiftlägeskänsligt"
 
 #. type: TP
 #: ../man/top.1:2437
 #, no-wrap
 msgid "4. the default is inclusion, prepending \\[oq]!\\[cq] denotes exclusions"
-msgstr "4. standard är att inkludera, ett inledande \\[rq]!\\[rq] markerar exkludering"
+msgstr "4. standard är inkludering; ett inledande \\[oq]!\\[cq] markerar exkludering"
 
 #. type: TP
 #: ../man/top.1:2439
 #, no-wrap
 msgid "5. multiple selection criteria can be applied to a \\*(TW"
-msgstr "5. flera urvalksriterium kan användas på ett \\*(TW"
+msgstr "5. flera urvalskriterier kan tillämpas på ett \\*(TW"
 
 #. type: TP
