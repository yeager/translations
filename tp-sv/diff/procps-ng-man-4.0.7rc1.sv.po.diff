 #, no-wrap
 msgid "B<TGID \\*(Em Thread Group Id >"
-msgstr "B<TGID \\*(Em Trådgrupps-id >"
+msgstr "B<TGID \\*(Em Trådgrupps-ID >"
 
 #. type: Plain text
 #: ../man/top.1:1119
 msgid "The ID of the thread group to which a task belongs.  It is the PID of the thread group leader.  In kernel terms, it represents those tasks that share an mm_struct."
-msgstr "Trådgruppens ID som en uppgift hör till. Det är trådgruppledarens PID. I kärnans termer representerar det de uppgifter som delar en mm_struct."
+msgstr "ID:t för trådgruppen som en uppgift tillhör. Det är trådgruppsledarens PID. I kärnans terminologi representerar det de uppgifter som delar en mm_struct."
 
 #. type: TP
 #: ../man/top.1:1120
@@ -12009,7 +12009,7 @@
 #. type: Plain text
 #: ../man/top.1:1128
 msgid "Total \\*(PU time the task has used since it started.  When Cumulative mode is \\*O, each process is listed with the \\*(Pu time that it and its dead children have used.  You toggle Cumulative mode with \\[oq]S\\[cq], which is both a \\*(CO and an \\*(CI.  \\*(XC \\[oq]S\\[cq] \\*(CI for additional information regarding this mode."
-msgstr "Total \\*(PU-tid uppgiften har använt sedan den startades. När kumulativt läge är \\*O listas varje process med \\*(Pu-tiden som den och dess döda barn har använt. Man växlar kumulativt läge med \\[rq]S\\[rq], vilket är både en \\*(CO och ett \\*(CI. \\*(XC Det interaktiva kommandot \\[rq]S\\[rq] för ytterligare information om detta läge."
+msgstr "Total \\*(PU-tid som uppgiften har använt sedan den startades. När kumulativt läge är \\*O listas varje process med \\*(Pu-tiden som den och dess avslutade barnprocesser har använt. Man växlar kumulativt läge med \\[oq]S\\[cq], vilket är både en \\*(CO och ett \\*(CI. \\*(XC det interaktiva kommandot \\[oq]S\\[cq] för mer information om detta läge."
 
 #. type: TP
 #: ../man/top.1:1129
@@ -12020,40 +12020,40 @@
 #. type: Plain text
 #: ../man/top.1:1133
 msgid "The same as TIME, but reflecting more granularity through hundredths of a second."
-msgstr "Samma som TID, men avspeglar mer noggrannhet genom hundradelar av sekunder."
+msgstr "Samma som TID, men med större precision i hundradelssekunder."
 
 #. type: TP
 #: ../man/top.1:1134
 #, no-wrap
 msgid "B<TPGID \\*(Em Tty Process Group Id >"
-msgstr "B<TPGID \\*(Em Tty-processgrupps-id >"
+msgstr "B<TPGID \\*(Em TTY-processgrupps-ID >"
 
 #. type: Plain text
 #: ../man/top.1:1140
 msgid "The process group ID of the foreground process for the connected tty, or -1 if a process is not connected to a terminal.  By convention, this value equals the process ID (\\*(Xa PID) of the process group leader (\\*(Xa PGRP)."
-msgstr "Förgrundsprocessens processgrupps-ID för den anslutna tty:n, eller -1 om en process inte är ansluten till en terminal. Enligt konvention är detta värde lika med processgruppsledarens (\\*(Xa PGRP) process-ID (\\*(Xa PID)."
+msgstr "Förgrundsprocessens processgrupps-ID för den anslutna TTY:n, eller -1 om en process inte är ansluten till en terminal. Enligt konvention är detta värde lika med processgruppsledarens (\\*(Xa PGRP) process-ID (\\*(Xa PID)."
 
 #. type: TP
