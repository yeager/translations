 #. type: SS
 #: ../src/xz/xz.1
@@ -310,7 +310,7 @@
 #. type: Plain text
 #: ../src/xz/xz.1
 msgid "If multiple operation mode options are given, the last one takes effect."
-msgstr "Om flera arbetslägesflaggor ges gäller den sista."
