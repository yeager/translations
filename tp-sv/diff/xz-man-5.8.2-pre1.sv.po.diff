+msgstr "Om B<xz> inte skriver till standard ut visas en varning och I<filen> hoppas över om något av följande gäller:"
 
 #. type: Plain text
 #: ../src/xz/xz.1
@@ -170,7 +170,7 @@
 #. type: Plain text
