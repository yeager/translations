 #. type: Plain text
 #: ../disk-utils/raw.8.adoc:54
@@ -4416,7 +4416,7 @@
 #. type: Plain text
 #: ../disk-utils/raw.8.adoc:56
 msgid "Raw I/O devices do not maintain cache coherency with the Linux block device buffer cache. If you use raw I/O to overwrite data already in the buffer cache, the buffer cache will no longer correspond to the contents of the actual storage device underneath. This is deliberate, but is regarded as either a bug or a feature, depending on who you ask!"
-msgstr "Raw I/O-enheter upprätthåller inte cachekoherens med Linux-blockenhetens buffertcache. Om du använder rå I/O för att skriva över data som redan finns i buffertcachen kommer buffertcachen inte längre att motsvara innehållet i den faktiska lagringsenheten under. Detta är avsiktligt, men betraktas som antingen ett fel eller en funktion, beroende på vem du frågar!"
+msgstr "Raw I/O-enheter upprätthåller inte cachekoherens med Linux-blockenhetens buffertcache. Om du använder raw I/O för att skriva över data som redan finns i buffertcachen kommer buffertcachen inte längre att motsvara innehållet i den underliggande faktiska lagringsenheten. Detta är avsiktligt, men betraktas som antingen ett fel eller en funktion, beroende på vem du frågar!"
 
