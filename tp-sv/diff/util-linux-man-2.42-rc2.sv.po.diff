 #: ../sys-utils/lscpu.1.adoc:74
@@ -25159,7 +25159,7 @@
 #. type: Plain text
 #: ../sys-utils/lscpu.1.adoc:77
 msgid "Use subsections in summary output. For backward compatibility, the default is to use subsections only when output on a terminal, and to use flattened output on a non-terminal. The optional argument _when_ can be *never*, *always*, or *auto*. If the _when_ argument is omitted, it defaults to *always*."
-msgstr "Använd underavsnitt i sammanfattningsutdata. För bakåtkompatibilitet används underavsnitt som standard endast vid utmatning till en terminal, och platt utmatning annars. Det valfria argumentet _när_ kan vara *never*, *always* eller *auto*. Om argumentet _när_ utelämnas används *always*."
+msgstr "Använd underavsnitt i sammanfattningsutdata. För bakåtkompatibilitet används underavsnitt som standard endast vid utdata till en terminal och platta utdata i annat fall. Det valfria argumentet _när_ kan vara *never*, *always* eller *auto*. Om argumentet _när_ utelämnas används *always*."
 
