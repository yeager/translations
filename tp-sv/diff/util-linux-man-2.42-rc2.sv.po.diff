 #. type: Plain text
 #: ../sys-utils/dmesg.1.adoc:199
@@ -21294,7 +21294,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:22
 msgid "eject - eject removable media"
-msgstr "eject - mata ut flyttbara media"
+msgstr "eject - mata ut löstagbara medier"
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:26
@@ -21304,7 +21304,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:30
 msgid "*eject* allows removable media (typically a CD-ROM, floppy disk, tape, JAZ, ZIP or USB disk) to be ejected under software control. The command can also control some multi-disc CD-ROM changers, the auto-eject feature supported by some devices, and close the disc tray of some CD-ROM drives."
-msgstr "*eject* gör det möjligt att mata ut flyttbara media (vanligtvis en CD-ROM, diskett, band, JAZ-, ZIP- eller USB-disk) under programvarukontroll. Kommandot kan också styra vissa cd-rom-växlare med flera skivor, den automatiska utmatningsfunktionen som stöds av vissa enheter och stänga skivfacket på vissa cd-rom-enheter."
+msgstr "*eject* gör det möjligt att mata ut löstagbara medier, vanligen CD-ROM, disketter, band, JAZ-, ZIP- eller USB-diskar, under programvarukontroll. Kommandot kan också styra vissa CD-ROM-växlare med flera skivor, funktionen för automatisk utmatning som stöds av vissa enheter och stänga skivfacket på vissa CD-ROM-enheter."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:32
@@ -21314,7 +21314,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:34
 msgid "There are four different methods of ejecting, depending on whether the device is a CD-ROM, SCSI device, removable floppy, or tape. By default *eject* tries all four methods in order until it succeeds."
-msgstr "Det finns fyra olika metoder för utmatning, beroende på om enheten är en CD-ROM, en SCSI-enhet, en flyttbar diskett eller ett band. Som standard försöker *eject* alla fyra metoderna i tur och ordning tills den lyckas."
+msgstr "Det finns fyra olika utmatningsmetoder, beroende på om enheten är en CD-ROM, SCSI-enhet, löstagbar diskett eller band. Som standard försöker *eject* metoderna i tur och ordning tills kommandot lyckas."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:36
@@ -21324,7 +21324,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:38
 msgid "If the device or a device partition is currently mounted, it is unmounted before ejecting. The eject is processed on exclusive open block device file descriptor if *--no-unmount* or *--force* are not specified."
-msgstr "Om enheten eller en enhetspartition för närvarande är monterad, avmonteras den innan den matas ut. Utmatningen bearbetas på en exklusiv öppen blockenhetsfildeskriptor om *--no-unmount* eller *--force* inte har angetts."
+msgstr "Om enheten eller en enhetspartition är monterad avmonteras den innan utmatning. Utmatningen bearbetas på en öppnad blockenhetsfildeskriptor med exklusiv åtkomst om *--no-unmount* eller *--force* inte anges."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:41
@@ -21335,18 +21335,18 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:43
 msgid "This option controls the auto-eject mode, supported by some devices. When enabled, the drive automatically ejects when the device is closed."
-msgstr "Den här flaggan styr läget för automatisk utmatning, som stöds av vissa enheter. När det är aktiverat matas enheten ut automatiskt när enheten stängs."
+msgstr "Flaggan styr läget för automatisk utmatning, som stöds av vissa enheter. När läget är aktiverat matar läsaren ut automatiskt när enheten stängs."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:44
 #, no-wrap
 msgid "*-c*, *--changerslot* _slot_"
-msgstr "*-c*, *--changerslot* _slot_"
+msgstr "*-c*, *--changerslot* _fack_"
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:46
 msgid "With this option a CD slot can be selected from an ATAPI/IDE CD-ROM changer. The CD-ROM drive cannot be in use (mounted data CD or playing a music CD) for a change request to work. Please also note that the first slot of the changer is referred to as 0, not 1."
-msgstr "Med denna flagga kan en CD-plats väljas från en ATAPI/IDE CD-ROM-växlare. CD-ROM-enheten får inte vara i bruk (monterad data-CD eller spela en musik-CD) för att en ändringsbegäran ska fungera. Observera också att den första kortplatsen i växlaren kallas 0, inte 1."
+msgstr "Med flaggan kan ett CD-fack väljas i en ATAPI/IDE-CD-ROM-växlare. CD-ROM-läsaren får inte vara i bruk, till exempel med en monterad data-CD eller vid uppspelning av en musik-CD, för att en ändringsbegäran ska fungera. Observera också att växlarens första fack betecknas med 0, inte 1."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:47
@@ -21357,7 +21357,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:49
 msgid "List the default device name."
-msgstr "Lista standardnamnet på enheten."
+msgstr "Visa standardnamnet på enheten."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:50
@@ -21368,7 +21368,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:52
 msgid "Force eject, don't check device type, don't open device with exclusive lock. The successful result may be false positive on non hot-pluggable devices."
-msgstr "Forcera utmatning, kontrollera inte enhetstyp, öppna inte enhet med exklusivt lås. Det lyckade resultatet kan vara falskt positivt på enheter som inte kan anslutas direkt."
+msgstr "Tvinga fram utmatning: kontrollera inte enhetstypen och öppna inte enheten med exklusivt lås. Det lyckade resultatet kan vara falskt positivt på enheter som inte stöder hot-plug."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:53
@@ -21379,7 +21379,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:55
 msgid "This option specifies that the drive should be ejected using a removable floppy disk eject command."
-msgstr "Den här flaggan anger att enheten ska matas ut med hjälp av kommandot för utmatning av flyttbar diskett."
+msgstr "Flaggan anger att läsaren ska matas ut med ett utmatningskommando för löstagbar diskett."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:56
@@ -21390,7 +21390,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:58
 msgid "This option controls locking of the hardware eject button. When enabled, the drive will not be ejected when the button is pressed. This is useful when you are carrying a laptop in a bag or case and don't want it to eject if the button is inadvertently pressed."
-msgstr "Den här flaggan styr låsningen av utmatningsknappen för maskinvara. När detta är aktiverat matas inte hårddisken ut när knappen trycks in. Detta är användbart när du bär med dig en bärbar dator i en väska eller fodral och inte vill att den ska matas ut om knappen trycks in av misstag."
+msgstr "Flaggan styr låsningen av utmatningsknappen. När den är aktiverad matas läsaren inte ut när knappen trycks ned. Detta är användbart när du bär en bärbar dator i en väska eller ett fodral och inte vill att den ska mata ut om knappen trycks ned av misstag."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:59
@@ -21401,7 +21401,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:61
 msgid "The option tells *eject* to not try to unmount other partitions on partitioned devices. If another partition is still mounted, the program will not attempt to eject the media. It will attempt to unmount only the device or mountpoint given on the command line."
-msgstr "Flaggan säger till *eject* att inte försöka avmontera andra partitioner på partitionerade enheter. Om en annan partition fortfarande är monterad kommer programmet inte att försöka mata ut mediet. Det kommer bara att försöka avmontera den enhet eller monteringspunkt som anges på kommandoraden."
+msgstr "Flaggan säger åt *eject* att inte försöka avmontera andra partitioner på partitionerade enheter. Om en annan partition fortfarande är monterad försöker programmet inte mata ut mediet. Det försöker endast avmontera den enhet eller monteringspunkt som anges på kommandoraden."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:62
@@ -21445,7 +21445,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:73
 msgid "This option specifies that the drive should be ejected using a tape drive offline command."
-msgstr "Den här flaggan anger att enheten ska matas ut med hjälp av ett offlinekommando för bandstationen."
+msgstr "Flaggan anger att bandstationen ska matas ut med offlinekommandot för bandstationen."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:74
@@ -21456,7 +21456,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:76
 msgid "This option specifies that the drive should be ejected using a CDROM eject command."
-msgstr "Denna flagga anger att enheten ska matas ut med hjälp av ett CDROM-utmatningskommando."
+msgstr "Flaggan anger att läsaren ska matas ut med ett CDROM-utmatningskommando."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:77
@@ -21467,7 +21467,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:79
 msgid "This option specifies that the drive should be ejected using SCSI commands."
-msgstr "Denna flagga anger att enheten ska matas ut med hjälp av SCSI-kommandon."
+msgstr "Flaggan anger att läsaren ska matas ut med SCSI-kommandon."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:80
@@ -21478,7 +21478,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:82
 msgid "With this option the drive is given a CD-ROM tray close command if it's opened, and a CD-ROM tray eject command if it's closed. Not all devices support this command, because it uses the above CD-ROM tray close command."
-msgstr "Med denna flagga får enheten ett kommando för att stänga CD-ROM-facket om det öppnas och ett kommando för att mata ut CD-ROM-facket om det stängs. Detta kommando stöds inte av alla enheter, eftersom det använder kommandot \"CD-ROM tray close\" ovan."
+msgstr "Med flaggan får läsaren ett kommando för att stänga CD-ROM-facket om det är öppet, och ett kommando för att mata ut CD-ROM-facket om det är stängt. Inte alla enheter stöder kommandot, eftersom det använder det ovan nämnda kommandot för att stänga CD-ROM-facket."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:83
@@ -21489,12 +21489,12 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:85
 msgid "With this option the drive is given a CD-ROM tray close command. Not all devices support this command."
-msgstr "Med denna flagga får enheten ett kommando för att stänga CD-ROM-facket. Detta kommando stöds inte av alla enheter."
+msgstr "Med flaggan får läsaren ett kommando för att stänga CD-ROM-facket. Inte alla enheter stöder kommandot."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:88
 msgid "Run in verbose mode; more information is displayed about what the command is doing."
-msgstr "Körs i utförligt läge; mer information visas om vad kommandot gör."
+msgstr "Kör i utförligt läge; mer information visas om vad kommandot gör."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:89
@@ -21505,7 +21505,7 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:91
 msgid "With this option the CD-ROM drive will be probed to detect the available speeds. The output is a list of speeds which can be used as an argument of the *-x* option. This only works with Linux 2.6.13 or higher, on previous versions solely the maximum speed will be reported. Also note that some drives may not correctly report the speed and therefore this option does not work with them."
-msgstr "Med denna flagga kommer CD-ROM-enheten att undersökas för att upptäcka tillgängliga hastigheter. Utdata är en lista över hastigheter som kan användas som argument för flaggan *-x*. Detta fungerar endast med Linux 2.6.13 eller senare, på tidigare versioner kommer endast den maximala hastigheten att rapporteras. Observera också att vissa enheter kanske inte rapporterar hastigheten korrekt och att den här flaggan därför inte fungerar med dem."
+msgstr "Med flaggan avsöks CD-ROM-läsaren för att upptäcka tillgängliga hastigheter. Utdata är en lista över hastigheter som kan användas som argument till flaggan *-x*. Detta fungerar endast med Linux 2.6.13 eller senare; på tidigare versioner rapporteras endast den maximala hastigheten. Observera också att vissa läsare kanske inte rapporterar hastigheten korrekt och att flaggan därför inte fungerar med dem."
 
 #. type: Labeled list
 #: ../sys-utils/eject.1.adoc:92
@@ -21516,37 +21516,37 @@
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:94
 msgid "With this option the drive is given a CD-ROM select speed command. The _speed_ argument is a number indicating the desired speed (e.g., 8 for 8X speed), or 0 for maximum data rate. Not all devices support this command and you can only specify speeds that the drive is capable of. Every time the media is changed this option is cleared. This option can be used alone, or with the *-t* and *-c* options."
-msgstr "Med denna flagga får enheten ett kommando för att välja CD-ROM-hastighet. Argumentet _hastighet_ är ett tal som anger önskad hastighet (t.ex. 8 för 8X-hastighet), eller 0 för maximal datahastighet. Alla enheter stöder inte detta kommando och du kan bara ange hastigheter som enheten klarar av. Varje gång mediet byts ut rensas denna flagga. Denna flagga kan användas ensam eller tillsammans med flaggorna *-t* och *-c*."
+msgstr "Med flaggan får läsaren ett kommando för att välja CD-ROM-hastighet. Argumentet _hastighet_ är ett tal som anger önskad hastighet, till exempel 8 för 8X-hastighet, eller 0 för maximal datahastighet. Inte alla enheter stöder kommandot och du kan bara ange hastigheter som läsaren klarar av. Varje gång mediet byts återställs inställningen. Flaggan kan användas ensam eller tillsammans med *-t* och *-c*."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:104
 msgid "*eject* only works with devices that support one or more of the four methods of ejecting. This includes most CD-ROM drives (IDE, SCSI, and proprietary), some SCSI tape drives, JAZ drives, ZIP drives (parallel port, SCSI, and IDE versions), and LS120 removable floppies. Users have also reported success with floppy drives on Sun SPARC and Apple Macintosh systems. If *eject* does not work, it is most likely a limitation of the kernel driver for the device and not the *eject* program itself."
-msgstr "*eject* fungerar bara med enheter som stöder en eller flera av de fyra metoderna för utmatning. Detta inkluderar de flesta CD-ROM-enheter (IDE, SCSI och egenutvecklade), vissa SCSI-bandenheter, JAZ-enheter, ZIP-enheter (parallellport-, SCSI- och IDE-versioner) och LS120 flyttbara disketter. Användare har också rapporterat framgångar med diskettenheter på Sun SPARC och Apple Macintosh-system. Om *eject* inte fungerar är det troligen en begränsning i kärndrivrutinen för enheten och inte i själva *eject*-programmet."
+msgstr "*eject* fungerar bara med enheter som stöder en eller flera av de fyra utmatningsmetoderna. Detta omfattar de flesta CD-ROM-läsare, IDE, SCSI och egenutvecklade, vissa SCSI-bandstationer, JAZ- och ZIP-läsare, parallellport-, SCSI- och IDE-versioner, samt löstagbara LS120-disketter. Användare har också rapporterat framgångar med diskettenheter på Sun SPARC- och Apple Macintosh-system. Om *eject* inte fungerar beror det troligen på en begränsning i kärndrivrutinen för enheten, inte på själva programmet *eject*."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:106
 msgid "The *-r*, *-s*, *-f*, and *-q* options allow controlling which methods are used to eject. More than one method can be specified. If none of these options are specified, it tries all four (this works fine in most cases)."
-msgstr "Flaggorna *-r*, *-s*, *-f* och *-q* gör det möjligt att styra vilka metoder som används för att mata ut. Mer än en metod kan anges. Om inget av dessa flaggor anges, försöker alla fyra (detta fungerar bra i de flesta fall)."
+msgstr "Flaggorna *-r*, *-s*, *-f* och *-q* gör det möjligt att styra vilka utmatningsmetoder som används. Flera metoder kan anges. Om ingen av flaggorna anges försöker *eject* med alla fyra, vilket fungerar bra i de flesta fall."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:108
 msgid "*eject* may not always be able to determine if the device is mounted (e.g., if it has several names). If the device name is a symbolic link, *eject* will follow the link and use the device that it points to."
-msgstr "*eject* kanske inte alltid kan avgöra om enheten är monterad (t.ex. om den har flera namn). Om enhetsnamnet är en symbolisk länk kommer *eject* att följa länken och använda den enhet som den pekar på."
+msgstr "*eject* kan inte alltid avgöra om enheten är monterad, till exempel om den har flera namn. Om enhetsnamnet är en symbolisk länk följer *eject* länken och använder den enhet som länken pekar på."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:110
 msgid "If *eject* determines that the device can have multiple partitions, it will attempt to unmount all mounted partitions of the device before ejecting (see also *--no-partitions-unmount*). If an unmount fails, the program will not attempt to eject the media."
-msgstr "Om *eject* fastställer att enheten kan ha flera partitioner, kommer det att försöka avmontera alla monterade partitioner på enheten innan utmatning (se även *--no-partitions-unmount*). Om en avmontering misslyckas kommer programmet inte att försöka mata ut mediet."
+msgstr "Om *eject* fastställer att enheten kan ha flera partitioner försöker programmet avmontera alla monterade partitioner på enheten före utmatning, se även *--no-partitions-unmount*. Om en avmontering misslyckas försöker programmet inte mata ut mediet."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:112
 msgid "You can eject an audio CD. Some CD-ROM drives will refuse to open the tray if the drive is empty. Some devices do not support the tray close command."
-msgstr "Du kan mata ut en ljud-CD. Vissa CD-ROM-enheter vägrar att öppna facket om enheten är tom. Vissa enheter stöder inte kommandot för att stänga facket."
+msgstr "Du kan mata ut en ljud-CD. Vissa CD-ROM-läsare vägrar att öppna facket om läsaren är tom. Vissa enheter stöder inte kommandot för att stänga facket."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:114
 msgid "If the auto-eject feature is enabled, then the drive will always be ejected after running this command. Not all Linux kernel CD-ROM drivers support the auto-eject mode. There is no way to find out the state of the auto-eject mode."
-msgstr "Om funktionen för automatisk utmatning är aktiverad kommer enheten alltid att matas ut efter att detta kommando har körts. Det är inte alla CD-ROM-drivrutiner i Linux-kärnan som stöder auto-eject-läget. Det finns inget sätt att ta reda på statusen för auto-eject-läget."
+msgstr "Om funktionen för automatisk utmatning är aktiverad matas läsaren alltid ut efter att kommandot har körts. Inte alla CD-ROM-drivrutiner i Linuxkärnan stöder läget för automatisk utmatning. Det går inte att avgöra vilket läge för automatisk utmatning som används."
 
 #. type: Plain text
 #: ../sys-utils/eject.1.adoc:116
@@ -21572,42 +21572,42 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:12
 msgid "fallocate - preallocate or deallocate space to a file"
-msgstr "fallocate - förallokera eller avallokera utrymme till en fil"
+msgstr "fallocate - förallokera eller avallokera utrymme i en fil"
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:16
 msgid "*fallocate* [*-c*|*-p*|*-z*|*-w*] [*-o* _offset_] *-l* _length_ [*-n*] _filename_"
-msgstr "*fallocate* [*-c*|*-p*|*-z*|*-w*] [*-o* _position_] *-l* _längd_ [*-n*] _filnamn_"
+msgstr "*fallocate* [*-c*|*-p*|*-z*|*-w*] [*-o* _förskjutning_] *-l* _längd_ [*-n*] _filnamn_"
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:18
 msgid "*fallocate* *-d* [*-o* _offset_] [*-l* _length_] _filename_"
-msgstr "*fallocate* *-d* [*-o* _offset_] [*-l* _längd_] _filnamn_"
+msgstr "*fallocate* *-d* [*-o* _förskjutning_] [*-l* _längd_] _filnamn_"
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:20
 msgid "*fallocate* *-r* [*-o* _offset_] _filename_"
-msgstr "*fallocate* *-r* [*-o* _position_] _filnamn_"
+msgstr "*fallocate* *-r* [*-o* _förskjutning_] _filnamn_"
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:22
 msgid "*fallocate* *-x* [*-o* _offset_] *-l* _length filename_"
-msgstr "*fallocate* *-x* [*-o* _offset_] *-l* _length filename_"
+msgstr "*fallocate* *-x* [*-o* _förskjutning_] *-l* _längd filnamn_"
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:26
 msgid "*fallocate* is used to manipulate the allocated disk space for a file, either to deallocate or preallocate it. For filesystems which support the *fallocate*(2) system call, preallocation is done quickly by allocating blocks and marking them as uninitialized, requiring no IO to the data blocks. This is much faster than creating a file by filling it with zeroes."
-msgstr "*fallocate* används för att manipulera det allokerade diskutrymmet för en fil, antingen för att avallokera eller förallokera det. För filsystem som stöder systemanropet *fallocate*(2) sker förallokering snabbt genom att block allokeras och markeras som oinitialiserade, vilket inte kräver någon IO till datablocken. Detta är mycket snabbare än att skapa en fil genom att fylla den med nollor."
+msgstr "*fallocate* används för att hantera en fils tilldelade diskutrymme, antingen för att avallokera eller förallokera det. För filsystem som stöder systemanropet *fallocate*(2) går förallokering snabbt genom att block tilldelas och markeras som oinitialiserade, utan I/O till datablocken. Detta går mycket snabbare än att skapa en fil genom att fylla den med nollor."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:28
 msgid "The exit status returned by *fallocate* is 0 on success and 1 on failure."
-msgstr "Avslutningsstatusen som returneras av *fallocate* är 0 vid framgång och 1 vid misslyckande."
+msgstr "*fallocate* har slutstatusen 0 vid framgång och 1 vid fel."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:32
 msgid "The _length_ and _offset_ arguments may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, TiB, PiB, EiB, ZiB, and YiB (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\") or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, TB, PB, EB, ZB, and YB."
-msgstr "Argumenten _längd_ och _offset_ kan följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024) och så vidare för GiB, TiB, PiB, EiB, ZiB och YiB (iB är valfritt, t.ex. har \"K\" samma betydelse som \"KiB\") eller suffixen KB (=1000), MB (=1000*1000) och så vidare för GB, TB, PB, EB, ZB och YB."
+msgstr "Argumenten _längd_ och _förskjutning_ kan följas av multiplikativa suffix: KiB (=1024), MiB (=1024*1024) och så vidare för GiB, TiB, PiB, EiB, ZiB och YiB (”iB” är valfritt; till exempel har ”K” samma betydelse som ”KiB”), eller suffixen KB (=1000), MB (=1000*1000) och så vidare för GB, TB, PB, EB, ZB och YB."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:34
@@ -21623,17 +21623,17 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:37
 msgid "Removes a byte range from a file, without leaving a hole. The byte range to be collapsed starts at _offset_ and continues for _length_ bytes. At the completion of the operation, the contents of the file starting at the location __offset__+_length_ will be appended at the location _offset_, and the file will be _length_ bytes smaller. The option *--keep-size* may not be specified for the collapse-range operation."
-msgstr "Tar bort ett byteintervall från en fil utan att lämna ett hål. Byteintervallet som ska kollapsas börjar vid _offset_ och fortsätter i _längd_ bytes. När operationen är klar kommer innehållet i filen som börjar på platsen __offset__+_längd_ att läggas till på platsen _offset_, och filen kommer att vara _längd_ bytes mindre. Flaggan *--keep-size* får inte anges för operationen collapse-range."
+msgstr "Tar bort ett byteintervall från en fil utan att lämna ett hål. Intervallet som ska dras samman börjar vid _förskjutning_ och fortsätter i _längd_ byte. När åtgärden är klar läggs innehållet i filen, som börjar vid __förskjutning__+_längd_, till vid _förskjutning_, och filen blir _längd_ byte mindre. Flaggan *--keep-size* får inte anges för åtgärden collapse-range."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:39
 msgid "Available since Linux 3.15 for ext4 (only for extent-based files) and XFS."
-msgstr "Tillgänglig sedan Linux 3.15 för ext4 (endast för extent-baserade filer) och XFS."
+msgstr "Tillgänglig sedan Linux 3.15 för ext4, endast för extentbaserade filer, och XFS."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:41
 msgid "A filesystem may place limitations on the granularity of the operation, in order to ensure efficient implementation. Typically, _offset_ and _length_ must be a multiple of the filesystem logical block size, which varies according to the filesystem type and configuration. If a filesystem has such a requirement, the operation will fail with the error *EINVAL* if this requirement is violated."
-msgstr "Ett filsystem kan lägga begränsningar på operationens granularitet för att säkerställa en effektiv implementering. Vanligtvis måste _offset_ och _längd_ vara en multipel av filsystemets logiska blockstorlek, som varierar beroende på filsystemets typ och konfiguration. Om ett filsystem har ett sådant krav kommer åtgärden att misslyckas med felet *EINVAL* om detta krav inte uppfylls."
+msgstr "Ett filsystem kan begränsa åtgärdens upplösning för att säkerställa en effektiv implementering. Vanligtvis måste _förskjutning_ och _längd_ vara multiplar av filsystemets logiska blockstorlek, som varierar med filsystemets typ och konfiguration. Om ett filsystem har ett sådant krav misslyckas åtgärden med felet *EINVAL* om kravet inte uppfylls."
 
 #. type: Labeled list
 #: ../sys-utils/fallocate.1.adoc:42
@@ -21644,12 +21644,12 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:44
 msgid "Detect and dig holes. This makes the file sparse in-place, without using extra disk space. The minimum size of the hole depends on filesystem I/O block size (usually 4096 bytes). Also, when using this option, *--keep-size* is implied. If no range is specified by *--offset* and *--length*, then the entire file is analyzed for holes."
-msgstr "Upptäck och gräv hål. Detta gör filen gles på plats, utan att använda extra diskutrymme. Den minsta storleken på hålet beror på filsystemets I/O-blockstorlek (vanligtvis 4096 byte). När du använder den här flaggan är *--keep-size* underförstått. Om inget intervall anges med *--offset* och *--length* analyseras hela filen efter hål."
+msgstr "Upptäck och skapa hål. Detta gör filen gles på plats utan att använda extra diskutrymme. Hålets minsta storlek beror på filsystemets I/O-blockstorlek, vanligen 4096 byte. När flaggan används är *--keep-size* implicit. Om inget intervall anges med *--offset* och *--length* analyseras hela filen efter hål."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:46
 msgid "You can think of this option as doing a \"*cp --sparse*\" and then renaming the destination file to the original, without the need for extra disk space."
-msgstr "Du kan se den här flaggan som att göra en \"*cp --sparse*\" och sedan byta namn på destinationsfilen till originalfilen, utan att det behövs extra diskutrymme."
+msgstr "Du kan se flaggan som att köra ”*cp --sparse*” och sedan byta namn på målfilen till originalfilen utan att det behövs extra diskutrymme."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:48 ../sys-utils/fallocate.1.adoc:61
@@ -21670,12 +21670,12 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:57
 msgid "For each hole the offset, end and size in bytes are printed in verbose mode, followed by a summary that gives the total size and percentage of the file that each hole type represents by default.  If no offset is specified with *--offset*, the whole file is scanned."
-msgstr "För varje hål skrivs startposition, slutposition och storlek i byte ut i utförligt läge, följt av en sammanfattning som som standard anger total storlek och andel av filen för varje håltyp. Om ingen position anges med *--offset* söks hela filen igenom."
+msgstr "För varje hål skrivs förskjutning, slut och storlek i byte ut i utförligt läge, följt av en sammanfattning som standard anger den totala storleken och den andel av filen som varje håltyp utgör. Om ingen förskjutning anges med *--offset* avsöks hela filen."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:59
 msgid "This option is read-only and can be used on any file to estimate how much space could be reclaimed by *--dig-holes*."
-msgstr "Denna flagga är skrivskyddad och kan användas på vilken fil som helst för att uppskatta hur mycket utrymme som skulle kunna återvinnas med *--dig-holes*."
+msgstr "Flaggan gör endast läsning och kan användas på vilken fil som helst för att uppskatta hur mycket utrymme som kan återvinnas med *--dig-holes*."
 
 #. type: Labeled list
 #: ../sys-utils/fallocate.1.adoc:62
@@ -21686,7 +21686,7 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:64
 msgid "Insert a hole of _length_ bytes from _offset_, shifting existing data."
-msgstr "Infoga ett hål på _längd_ byte från _offset_ och flytta befintliga data."
+msgstr "Infoga ett hål på _längd_ byte från _förskjutning_ och flytta befintliga data."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:67
@@ -21702,12 +21702,12 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:70
 msgid "Do not modify the apparent length of the file. This may effectively allocate blocks past EOF, which can be removed with a truncate."
-msgstr "Ändra inte den synliga längden på filen. Detta kan effektivt allokera block efter EOF, som kan tas bort med en truncate."
+msgstr "Ändra inte filens synliga längd. Detta kan i praktiken tilldela block efter EOF, som kan tas bort med en avkortning."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:73
 msgid "Specifies the beginning offset of the range, in bytes."
-msgstr "Anger startoffset för intervallet, i byte."
+msgstr "Ange intervallets inledande förskjutning i byte."
 
 #. type: Labeled list
 #: ../sys-utils/fallocate.1.adoc:74
@@ -21718,12 +21718,12 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:76
 msgid "Deallocates space (i.e., creates a hole) in the byte range starting at _offset_ and continuing for _length_ bytes. Within the specified range, partial filesystem blocks are zeroed, and whole filesystem blocks are removed from the file. After a successful call, subsequent reads from this range will return zeroes. This option may not be specified at the same time as the *--zero-range* option. Also, when using this option, *--keep-size* is implied."
-msgstr "Avallokerar utrymme (dvs. skapar ett hål) i byteintervallet som börjar vid _offset_ och fortsätter i _längd_ bytes. Inom det angivna intervallet nollställs partiella filsystemblock och hela filsystemblock tas bort från filen. Efter ett lyckat anrop kommer efterföljande läsningar från detta intervall att returnera nollor. Den här flaggan får inte anges samtidigt som flaggan *--zero-range*. När du använder den här flaggan är *--keep-size* underförstått."
+msgstr "Avallokerar utrymme, det vill säga skapar ett hål, i byteintervallet som börjar vid _förskjutning_ och fortsätter i _längd_ byte. Inom det angivna intervallet nollställs partiella filsystemblock och hela filsystemblock tas bort från filen. Efter ett lyckat anrop returnerar efterföljande läsningar från intervallet nollor. Flaggan får inte anges samtidigt som *--zero-range*. När flaggan används är *--keep-size* implicit."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:78
 msgid "Supported for XFS (since Linux 2.6.38), ext4 (since Linux 3.0), Btrfs (since Linux 3.7), tmpfs (since Linux 3.5) and gfs2 (since Linux 4.16)."
-msgstr "Stöd för XFS (sedan Linux 2.6.38), ext4 (sedan Linux 3.0), Btrfs (sedan Linux 3.7), tmpfs (sedan Linux 3.5) och gfs2 (sedan Linux 4.16)."
+msgstr "Stöds för XFS sedan Linux 2.6.38, ext4 sedan Linux 3.0, Btrfs sedan Linux 3.7, tmpfs sedan Linux 3.5 och gfs2 sedan Linux 4.16."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:81
@@ -21739,7 +21739,7 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:84
 msgid "Zeroes space in the byte range starting at _offset_ and continuing for _length_ bytes. Within the specified range, written blocks are preallocated for the regions that span the holes in the file. After a successful call, subsequent reads from this range will return zeroes and subsequent writes to that range do not require further changes to the file mapping metadata."
-msgstr "Nollställer utrymmet i byteintervallet som börjar vid _position_ och omfattar _längd_ byte. Inom intervallet förallokeras skrivna block för områden som sträcker sig över hålen i filen. Efter ett lyckat anrop returnerar efterföljande läsningar från intervallet nollor och efterföljande skrivningar till intervallet kräver inga ytterligare ändringar av filens mappningsmetadata."
+msgstr "Nollställer utrymmet i byteintervallet som börjar vid _förskjutning_ och omfattar _längd_ byte. Inom intervallet förallokeras skrivna block för områden som sträcker sig över hål i filen. Efter ett lyckat anrop returnerar efterföljande läsningar från intervallet nollor och efterföljande skrivningar till intervallet kräver inga ytterligare ändringar av filens mappningsmetadata."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:86
@@ -21760,7 +21760,7 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:91
 msgid "Enable POSIX operation mode. In that mode allocation operation always completes, but it may take longer time when fast allocation is not supported by the underlying filesystem."
-msgstr "Aktivera POSIX-operationsläge. I det läget slutförs allokeringen alltid, men det kan ta längre tid när snabb allokering inte stöds av det underliggande filsystemet."
+msgstr "Aktivera POSIX-läge. I detta läge slutförs allokeringen alltid, men den kan ta längre tid när snabb allokering inte stöds av det underliggande filsystemet."
 
 #. type: Labeled list
 #: ../sys-utils/fallocate.1.adoc:92
@@ -21771,22 +21771,22 @@
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:94
 msgid "Zeroes space in the byte range starting at _offset_ and continuing for _length_ bytes. Within the specified range, blocks are preallocated for the regions that span the holes in the file. After a successful call, subsequent reads from this range will return zeroes."
-msgstr "Nollställer utrymmet i byteintervallet som börjar vid _offset_ och fortsätter i _längd_ bytes. Inom det angivna intervallet förallokeras block för de regioner som sträcker sig över hålen i filen. Efter ett lyckat anrop kommer efterföljande läsningar från detta intervall att returnera nollor."
+msgstr "Nollställer utrymmet i byteintervallet som börjar vid _förskjutning_ och fortsätter i _längd_ byte. Inom det angivna intervallet förallokeras block för de områden som sträcker sig över hål i filen. Efter ett lyckat anrop returnerar efterföljande läsningar från intervallet nollor."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:96
 msgid "Zeroing is done within the filesystem preferably by converting the range into unwritten extents. This approach means that the specified range will not be physically zeroed out on the device (except for partial blocks at either end of the range), and I/O is (otherwise) required only to update metadata."
-msgstr "Nollställningen görs inom filsystemet, företrädesvis genom att omvandla intervallet till oskrivna extenter. Detta tillvägagångssätt innebär att det angivna intervallet inte kommer att nollställas fysiskt på enheten (med undantag för partiella block i vardera änden av intervallet), och I/O krävs (annars) endast för att uppdatera metadata."
+msgstr "Nollställningen görs inom filsystemet, företrädesvis genom att omvandla intervallet till oskrivna extenter. Detta innebär att det angivna intervallet inte nollställs fysiskt på enheten, med undantag för partiella block i intervallets båda ändar, och att I/O i övrigt endast krävs för att uppdatera metadata."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:98
 msgid "Option *--keep-size* can be specified to prevent file length modification."
-msgstr "Flaggan *--keep-size* kan anges för att förhindra ändring av fillängd."
+msgstr "Flaggan *--keep-size* kan anges för att förhindra att filens längd ändras."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:100
 msgid "Available since Linux 3.14 for ext4 (only for extent-based files) and XFS."
-msgstr "Tillgänglig sedan Linux 3.14 för ext4 (endast för extent-baserade filer) och XFS."
+msgstr "Tillgänglig sedan Linux 3.14 för ext4, endast för extentbaserade filer, och XFS."
 
 #. type: Plain text
 #: ../sys-utils/fallocate.1.adoc:107
@@ -21812,7 +21812,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:43
 msgid "*flock* [options] _file_|_directory_ _command_ [_arguments_]"
-msgstr "*flock* [flaggor] _fil_|_katalog_ _kommando_ [_arguments_]"
+msgstr "*flock* [flaggor] _fil_|_katalog_ _kommando_ [_arg_]"
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:45
@@ -21853,12 +21853,12 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:63
 msgid "The exit status used when the *-n* option is in use, and the conflicting lock exists, or the *-w* option is in use, and the timeout is reached. The default value is *1*. The _number_ has to be in the range of 0 to 255."
-msgstr "Avslutningsstatus som används när flaggan *-n* används och det finns ett motstridigt lås, eller när flaggan *-w* används och tidsgränsen har uppnåtts. Standardvärdet är *1*. _nummer_ måste ligga inom intervallet 0 till 255."
+msgstr "Slutstatusen används när flaggan *-n* används och ett konkurrerande lås finns, eller när flaggan *-w* används och tidsgränsen löper ut. Standardvärdet är *1*. _nummer_ måste ligga inom intervallet 0 till 255."
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:66
 msgid "Do not fork before executing _command_. Upon execution the flock process is replaced by _command_ which continues to hold the lock. This option is incompatible with *--close* as there would otherwise be nothing left to hold the lock."
-msgstr "Gör ingen fork innan du utför _kommando_. När flock-processen exekveras ersätts den av _kommando_ som fortsätter att hålla låset. Den här flaggan är inte kompatibelt med *--close* eftersom det annars inte skulle finnas något kvar att hålla låset."
+msgstr "Förgrena inte processen före körning av _kommando_. Vid körningen ersätts flock-processen av _kommando_, som fortsätter att hålla låset. Flaggan är inte kompatibel med *--close*, eftersom det annars inte finns något kvar som håller låset."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:67
@@ -21869,7 +21869,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:69
 msgid "Obtain an exclusive lock, sometimes called a write lock. This is the default."
-msgstr "Skaffa ett exklusivt lås, ibland kallat skrivlås. Detta är standardinställningen."
+msgstr "Ta ett exklusivt lås, ibland kallat skrivlås. Detta är standardvärdet."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:70
@@ -21880,7 +21880,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:72
 msgid "Fail rather than wait if the lock cannot be immediately acquired. See the *-E* option for the exit status used."
-msgstr "Misslyckas i stället för att vänta om låset inte kan förvärvas omedelbart. Se flaggan *-E* för den avslutsstatus som används."
+msgstr "Avsluta med fel i stället för att vänta om låset inte kan tas omedelbart. Se flaggan *-E* för den slutstatus som används."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:73
@@ -21891,7 +21891,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:75
 msgid "Close the file descriptor on which the lock is held before executing _command_. This is useful if _command_ spawns a child process which should not be holding the lock."
-msgstr "Stäng filbeskrivaren som låset hålls på innan du utför _kommando_. Detta är användbart om _kommando_ startar en underordnad process som inte bör hålla låset."
+msgstr "Stäng filbeskrivaren som håller låset före körning av _kommando_. Detta är användbart om _kommando_ startar en barnprocess som inte bör hålla låset."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:76
@@ -21902,7 +21902,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:78
 msgid "Obtain a shared lock, sometimes called a read lock."
-msgstr "Få ett delat lås, ibland kallat ett läslås."
+msgstr "Ta ett delat lås, ibland kallat läslås."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:79
@@ -21913,7 +21913,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:81
 msgid "Drop a lock. This is usually not required, since a lock is automatically dropped when the file is closed. However, it may be required in special cases, for example if the enclosed command group may have forked a background process which should not be holding the lock."
-msgstr "Släpp ett lås. Detta är vanligtvis inte nödvändigt, eftersom ett lås automatiskt släpps när filen stängs. Det kan dock krävas i särskilda fall, t.ex. om den bifogade kommandogruppen kan ha förgrenat en bakgrundsprocess som inte borde hålla låset."
+msgstr "Släpp ett lås. Detta behövs vanligen inte, eftersom ett lås automatiskt släpps när filen stängs. Det kan dock krävas i särskilda fall, till exempel om den omslutande kommandogruppen kan ha förgrenat en bakgrundsprocess som inte bör hålla låset."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:82
@@ -21924,7 +21924,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:84
 msgid "Fail if the lock cannot be acquired within _seconds_. Decimal fractional values are allowed. See the *-E* option for the exit status used. The zero number of _seconds_ is interpreted as *--nonblock*."
-msgstr "Misslyckas om låset inte kan förvärvas inom _sekunder_. Decimala fraktionerade värden är tillåtna. Se flaggan *-E* för den avslutsstatus som används. Noll antal _sekunder_ tolkas som *--nonblock*."
+msgstr "Avsluta med fel om låset inte kan tas inom _sekunder_. Decimala bråktal är tillåtna. Se flaggan *-E* för den slutstatus som används. Noll sekunder tolkas som *--nonblock*."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:85
@@ -21946,12 +21946,12 @@
 #: ../sys-utils/flock.1.adoc:90
 #, no-wrap
 msgid "*--start* _offset_"
-msgstr "*--start* _position_"
+msgstr "*--start* _förskjutning_"
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:92
 msgid "The starting offset for lock. This option implies *--fcntl*."
-msgstr "Låsets startposition. Flaggan medför *--fcntl*."
+msgstr "Låsets inledande förskjutning. Flaggan medför *--fcntl*."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:93
@@ -21962,32 +21962,32 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:95
 msgid "The number of bytes to lock. This option implies *--fcntl*."
-msgstr "Antalet byte att låsa. Flaggan medför *--fcntl*."
+msgstr "Antalet byte som ska låsas. Flaggan medför *--fcntl*."
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:98
 msgid "Report how long it took to acquire the lock, or why the lock could not be obtained."
-msgstr "Rapportera hur lång tid det tog att skaffa låset eller varför låset inte kunde skaffas."
+msgstr "Rapportera hur lång tid det tog att ta låset, eller varför låset inte kunde tas."
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:104
 msgid "The command uses <sysexits.h> exit status values for everything, except when using either of the options *-n* or *-w* which report a failure to acquire the lock with an exit status given by the *-E* option, or 1 by default. The exit status given by *-E* has to be in the range of 0 to 255."
-msgstr "Kommandot använder <sysexits.h> utgångsstatusvärden för allt, utom när något av flaggorna *-n* eller *-w* används, som rapporterar ett misslyckande med att förvärva låset med en utgångsstatus som anges av flaggan *-E*, eller 1 som standard. Utgångsstatusen som ges av *-E* måste ligga inom intervallet 0 till 255."
+msgstr "Kommandot använder värden för slutstatus från <sysexits.h>, utom när någon av flaggorna *-n* eller *-w* används och rapporterar att låset inte kunde tas med en slutstatus som anges av *-E*, eller 1 som standard. Slutstatusen från *-E* måste ligga inom intervallet 0 till 255."
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:106
 msgid "When using the _command_ variant, and executing the child worked, then the exit status is that of the child command."
-msgstr "När _kommando_-varianten används och det underordnade kommandot utförs, är utgångsstatusen den som gäller för det underordnade kommandot."
+msgstr "När varianten _kommando_ används och körningen av barnkommandot lyckas är slutstatusen densamma som barnkommandots."
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:110
 msgid "*flock* does not detect deadlock. See *flock*(2) for details."
-msgstr "*flock* upptäcker inte deadlock. Se *flock*(2) för mer information."
+msgstr "*flock* upptäcker inte dödlägen. Se *flock*(2) för mer information."
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:112
 msgid "Some file systems (e. g. NFS and CIFS) have a limited implementation of *flock*(2) and flock may always fail. For details see *flock*(2), *nfs*(5) and *mount.cifs*(8). Depending on mount options, flock can always fail there."
-msgstr "Vissa filsystem (t.ex. NFS och CIFS) har en begränsad implementering av *flock*(2) och flock kan alltid misslyckas. För detaljer se *flock*(2), *nfs*(5) och *mount.cifs*(8). Beroende på monterinsflaggor kan flock alltid misslyckas där."
+msgstr "Vissa filsystem, till exempel NFS och CIFS, har en begränsad implementering av *flock*(2), och flock kan alltid misslyckas. Se *flock*(2), *nfs*(5) och *mount.cifs*(8) för mer information. Beroende på monteringsflaggor kan flock alltid misslyckas där."
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:116
@@ -22003,7 +22003,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:119
 msgid "Set exclusive lock to directory _/tmp_ and the second command will fail."
-msgstr "Sätt exklusivt lås på katalogen _/tmp_ och det andra kommandot kommer att misslyckas."
+msgstr "Sätt ett exklusivt lås på katalogen _/tmp_, så misslyckas det andra kommandot."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:120
@@ -22014,24 +22014,24 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:122
 msgid "Set shared lock to directory _/tmp_ and the second command will not fail. Notice that attempting to get exclusive lock with second command would fail."
-msgstr "Sätt shared lock till katalogen _/tmp_ så kommer det andra kommandot inte att misslyckas. Observera att försök att få exklusivt lås med det andra kommandot skulle misslyckas."
+msgstr "Sätt ett delat lås på katalogen _/tmp_, så misslyckas inte det andra kommandot. Observera att ett försök att ta ett exklusivt lås med det andra kommandot skulle misslyckas."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:123
 #, no-wrap
 msgid "shell> flock -x local-lock-file echo 'a b c'"
-msgstr "shell> flock -x local-lock-fil echo 'a b c'"
+msgstr "shell> flock -x local-lock-file echo 'a b c'"
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:125
 msgid "Grab the exclusive lock \"local-lock-file\" before running echo with 'a b c'."
-msgstr "Hämta det exklusiva låset \"local-lock-file\" innan du kör echo med 'a b c'."
+msgstr "Ta det exklusiva låset ”local-lock-file” före körning av echo med ”a b c”."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:126
 #, no-wrap
 msgid "(; flock -n 9 || exit 1; # ... commands executed under lock ...; ) 9>/var/lock/mylockfile"
-msgstr "(; flock -n 9 || exit 1; # ... kommandon utförda under lås ...; ) 9>/var/lock/mylockfile"
+msgstr "(; flock -n 9 || exit 1; # ... commands executed under lock ...; ) 9>/var/lock/mylockfile"
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:128
@@ -22047,7 +22047,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:131
 msgid "This is useful boilerplate code for shell scripts. Put it at the top of the shell script you want to lock and it'll automatically lock itself on the first run. If the environment variable *$FLOCKER* is not set to the shell script that is being run, then execute *flock* and grab an exclusive non-blocking lock (using the script itself as the lock file) before re-execing itself with the right arguments. It also sets the *FLOCKER* environment variable to the right value so it doesn't run again."
-msgstr "Detta är användbar standardkod för skalskript. Lägg den högst upp i det skalskript som du vill låsa så låser det sig automatiskt vid första körningen. Om miljövariabeln *$FLOCKER* inte är inställd på det skalskript som körs, exekveras *flock* och tar ett exklusivt icke-blockerande lås (med själva skriptet som låsfil) innan det exekveras igen med rätt argument. Det ställer också in miljövariabeln *FLOCKER* till rätt värde så att det inte körs igen."
+msgstr "Detta är användbar standardkod för skalskript. Lägg den högst upp i skalskriptet som ska låsas, så låser skriptet sig automatiskt vid första körningen. Om miljövariabeln *$FLOCKER* inte innehåller skalskriptet som körs, kör *flock* och tar ett exklusivt ickeblockerande lås, med skriptet självt som låsfil, innan skriptet körs igen med rätt argument. Miljövariabeln *FLOCKER* sätts också till rätt värde så att detta inte körs igen."
 
 #. type: Labeled list
 #: ../sys-utils/flock.1.adoc:132
@@ -22058,7 +22058,7 @@
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:134
 msgid "This form is convenient for locking a file without spawning a subprocess. The shell opens the lock file for reading and writing as file descriptor 4, then *flock* is used to lock the descriptor."
-msgstr "Denna form är lämplig för att låsa en fil utan att starta en subprocess. Shell öppnar låsfilen för läsning och skrivning som fildeskriptor 4, sedan används *flock* för att låsa deskriptorn."
+msgstr "Formen är lämplig för att låsa en fil utan att starta en underprocess. Skalet öppnar låsfilen för läsning och skrivning som filbeskrivare 4, och sedan används *flock* för att låsa filbeskrivaren."
 
 #. type: Plain text
 #: ../sys-utils/flock.1.adoc:138
@@ -22085,7 +22085,7 @@
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:12
 msgid "fsfreeze - suspend access to a filesystem (Ext3/4, ReiserFS, JFS, XFS)"
-msgstr "fsfreeze - avbryt åtkomst till ett filsystem (Ext3/4, ReiserFS, JFS, XFS)"
+msgstr "fsfreeze - frys åtkomst till ett filsystem (Ext3/4, ReiserFS, JFS, XFS)"
 
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:16
@@ -22095,17 +22095,17 @@
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:20
 msgid "*fsfreeze* suspends or resumes access to a filesystem."
-msgstr "*fsfreeze* stänger av eller återupptar åtkomst till ett filsystem."
+msgstr "*fsfreeze* fryser eller återupptar åtkomst till ett filsystem."
 
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:22
 msgid "*fsfreeze* halts any new access to the filesystem and creates a stable image on disk. *fsfreeze* is intended to be used with hardware RAID devices that support the creation of snapshots."
-msgstr "*fsfreeze* stoppar all ny åtkomst till filsystemet och skapar en stabil avbildning på disken. *fsfreeze* är avsedd att användas med RAID-enheter i maskinvara som stöder skapandet av ögonblicksbilder."
+msgstr "*fsfreeze* stoppar all ny åtkomst till filsystemet och skapar en stabil avbildning på disken. *fsfreeze* är avsett att användas med maskinvaru-RAID-enheter som stöder skapande av ögonblicksbilder."
 
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:24
 msgid "*fsfreeze* is unnecessary for *device-mapper* devices. The device-mapper (and LVM) automatically freezes a filesystem on the device when a snapshot creation is requested. For more details see the *dmsetup*(8) man page."
-msgstr "*fsfreeze* är onödigt för *enhet-mappare*-enheter. Device-mappern (och LVM) fryser automatiskt ett filsystem på enheten när en snapshot-skapelse begärs. För mer information se man-sidan *dmsetup*(8)."
+msgstr "*fsfreeze* behövs inte för *device-mapper*-enheter. Device-mapper och LVM fryser automatiskt ett filsystem på enheten när en ögonblicksbild begärs. Se manualsidan för *dmsetup*(8) för mer information."
 
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:26
@@ -22115,7 +22115,7 @@
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:28
 msgid "Note that access-time updates are also suspended if the filesystem is mounted with the traditional atime behavior (mount option *strictatime*, for more details see *mount*(8))."
-msgstr "Observera att uppdateringar av åtkomsttid också avbryts om filsystemet är monterat med det traditionella atime-beteendet (monteringsflaggor *strictatime*, för mer information se *mount*(8))."
+msgstr "Observera att uppdateringar av åtkomsttid också stoppas om filsystemet är monterat med det traditionella atime-beteendet, det vill säga monteringsflaggan *strictatime*; se *mount*(8) för mer information."
 
 #. type: Labeled list
 #: ../sys-utils/fsfreeze.8.adoc:31
@@ -22126,12 +22126,12 @@
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:33
 msgid "This option requests the specified filesystem to be frozen from new modifications. When this is selected, all ongoing transactions in the filesystem are allowed to complete, new *write*(2) system calls are halted, other calls which modify the filesystem are halted, and all dirty data, metadata, and log information are written to disk. Any process attempting to write to the frozen filesystem will block waiting for the filesystem to be unfrozen."
-msgstr "Denna flagga begär att det angivna filsystemet ska frysas från nya modifieringar. När detta är valt tillåts alla pågående transaktioner i filsystemet att slutföras, nya *write*(2)-systemanrop stoppas, andra anrop som modifierar filsystemet stoppas och alla smutsiga data, metadata och logginformation skrivs till disk. Alla processer som försöker skriva till det frysta filsystemet kommer att blockeras i väntan på att filsystemet ska frysas upp igen."
+msgstr "Flaggan begär att det angivna filsystemet fryses mot nya ändringar. När flaggan väljs får alla pågående transaktioner i filsystemet slutföras, nya *write*(2)-systemanrop stoppas, andra anrop som ändrar filsystemet stoppas och alla smutsiga data, metadata och logginformation skrivs till disk. Processer som försöker skriva till det frysta filsystemet blockeras i väntan på att frysningen ska hävas."
 
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:35
 msgid "Note that even after freezing, the on-disk filesystem can contain information on files that are still in the process of unlinking. These files will not be unlinked until the filesystem is unfrozen or a clean mount of the snapshot is complete."
-msgstr "Observera att även efter frysning kan filsystemet på disken innehålla information om filer som fortfarande håller på att kopplas bort. Dessa filer kommer inte att avlänkas förrän filsystemet har frysts upp eller en ren montering av ögonblicksbilden har slutförts."
+msgstr "Observera att filsystemet på disken även efter frysning kan innehålla information om filer som fortfarande håller på att tas bort. Filerna tas inte bort förrän frysningen av filsystemet hävs eller en ren montering av ögonblicksbilden är klar."
 
 #. type: Labeled list
 #: ../sys-utils/fsfreeze.8.adoc:36
@@ -22142,7 +22142,7 @@
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:38
 msgid "This option is used to un-freeze the filesystem and allow operations to continue. Any filesystem modifications that were blocked by the freeze are unblocked and allowed to complete."
-msgstr "Denna flagga används för att häva frysningen av filsystemet och tillåta att operationer fortsätter. Alla ändringar av filsystemet som blockerades av frysningen avblockeras och tillåts slutföras."
+msgstr "Flaggan används för att häva frysningen av filsystemet och tillåta att åtgärder fortsätter. Alla filsystemsändringar som blockerades av frysningen släpps fria och får slutföras."
 
 #. type: Title ==
 #: ../sys-utils/fsfreeze.8.adoc:41
@@ -22153,12 +22153,12 @@
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:44
 msgid "This command will work only if filesystem supports has support for freezing. List of these filesystems include (2016-12-18) *btrfs*, *ext2/3/4*, *f2fs*, *jfs*, *nilfs2*, *reiserfs*, and *xfs*. Previous list may be incomplete, as more filesystems get support. If in doubt easiest way to know if a filesystem has support is create a small loopback mount and test freezing it."
-msgstr "Detta kommando fungerar endast om filsystemet har stöd för freezing. Lista över dessa filsystem inkluderar (2016-12-18) *btrfs*, *ext2/3/4*, *f2fs*, *jfs*, *nilfs2*, *reiserfs* och *xfs*. Tidigare lista kan vara ofullständig, eftersom fler filsystem får stöd. Om du är osäker är det enklaste sättet att veta om ett filsystem har stöd att skapa ett litet loopback-mount och testa att frysa det."
+msgstr "Kommandot fungerar endast om filsystemet stöder frysning. Listan över filsystem som stöder detta omfattar, den 2016-12-18, *btrfs*, *ext2/3/4*, *f2fs*, *jfs*, *nilfs2*, *reiserfs* och *xfs*. Listan kan vara ofullständig eftersom fler filsystem får stöd. Om du är osäker är det enklaste sättet att avgöra om ett filsystem stöds att skapa en liten loopback-montering och prova att frysa den."
 
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:48
 msgid "This man page is based on *xfs_freeze*(8)."
-msgstr "Denna man-sida är baserad på *xfs_freeze*(8)."
+msgstr "Manualsidan är baserad på *xfs_freeze*(8)."
 
 #. type: Plain text
 #: ../sys-utils/fsfreeze.8.adoc:52
@@ -22184,22 +22184,22 @@
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:56
 msgid "The file *fstab* contains descriptive information about the filesystems the system can mount. *fstab* is only read by programs, and not written; it is the duty of the system administrator to properly create and maintain this file. The order of records in *fstab* is important because *fsck*(8), *mount*(8), and *umount*(8) sequentially iterate through *fstab* doing their thing."
-msgstr "Filen *fstab* innehåller beskrivande information om de filsystem som systemet kan montera. *fstab* läses endast av program och skrivs inte; det är systemadministratörens skyldighet att skapa och underhålla filen på rätt sätt. Ordningen på posterna i *fstab* är viktig eftersom *fsck*(8), *mount*(8) och *umount*(8) sekventiellt itererar genom *fstab* och gör sina saker."
+msgstr "Filen *fstab* innehåller beskrivande information om de filsystem som systemet kan montera. *fstab* läses endast av program och skrivs inte; systemadministratören ansvarar för att skapa och underhålla filen korrekt. Ordningen på posterna i *fstab* är viktig eftersom *fsck*(8), *mount*(8) och *umount*(8) går igenom *fstab* i tur och ordning."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:58
 msgid "The file is not read by *mount*(8) only but often is used by many other tools and daemons, and proper functionality may require additional steps. For example, on systemd-based systems, it's recommended to use *systemctl daemon-reload* after *fstab* modification."
-msgstr "Filen läses inte bara av *mount*(8) utan används ofta av många andra verktyg och demoner, och för att den ska fungera korrekt kan det krävas ytterligare åtgärder. På systemd-baserade system rekommenderas t.ex. att *systemctl daemon-reload* används efter att *fstab* har ändrats."
+msgstr "Filen läses inte bara av *mount*(8) utan används ofta av många andra verktyg och demoner, och korrekt funktion kan kräva ytterligare åtgärder. På system som bygger på systemd rekommenderas till exempel att köra *systemctl daemon-reload* efter ändringar i *fstab*."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:60
 msgid "See the *swapon*(8) man page for details about swap area fstab configuration."
-msgstr "Se manualsidan *swapon*(8) för detaljer om konfiguration av växlingsutrymme i fstab."
+msgstr "Se manualsidan för *swapon*(8) för mer information om fstab-konfigurationen för växlingsutrymme."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:62
 msgid "Each filesystem is described on a separate line, with fields separated by tabs or spaces. The line is split into fields before being parsed. This means that any spaces or tabs within the fields must be escaped using \\040 or \\011, even within quoted strings (e.g. LABEL=\"foo\\040bar\")."
-msgstr "Varje filsystem beskrivs på en egen rad, med fält som separeras med tabbar eller mellanslag. Raden delas upp i fält innan den analyseras. Detta innebär att eventuella mellanslag eller tabbar i fälten måste escapas med \\040 eller \\011, även inom citerade strängar (t.ex. LABEL=\"foo\\040bar\")."
+msgstr "Varje filsystem beskrivs på en egen rad med fält avgränsade av tabbar eller mellanslag. Raden delas upp i fält innan den tolkas. Det innebär att mellanslag eller tabbar i fälten måste skyddas med escape som \\040 eller \\011, även i citerade strängar, till exempel LABEL=\"foo\\040bar\"."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:64
@@ -22215,7 +22215,7 @@
 #: ../sys-utils/fstab.5.adoc:69
 #, no-wrap
 msgid "LABEL=t-home2   /home      ext4    defaults,auto_da_alloc      0  2\n"
-msgstr "LABEL=t-home2 /home ext4 defaults,auto_da_alloc 0 2\n"
+msgstr "LABEL=t-home2   /home      ext4    defaults,auto_da_alloc      0  2\n"
 
 #. type: Title ===
 #: ../sys-utils/fstab.5.adoc:71
@@ -22226,17 +22226,17 @@
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:74
 msgid "This field describes the block special device, remote filesystem or filesystem image for loop device to be mounted or swap file or swap device to be enabled."
-msgstr "Detta fält beskriver den blockspecifika enhet, fjärrfilsystem eller filsystemavbildning för loop-enhet som ska monteras eller växlingsfil eller växlingsenhet som ska aktiveras."
+msgstr "Fältet beskriver den blockspeciella enhet, det fjärrfilsystem eller den filsystemavbildning för en loop-enhet som ska monteras, eller den växlingsfil eller växlingsenhet som ska aktiveras."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:76
 msgid "For ordinary mounts, it will hold (a link to) a block special device node (as created by *mknod*(2)) for the device to be mounted, like _/dev/cdrom_ or _/dev/sdb7_. For NFS mounts, this field is _<host>:<dir>_, e.g., _knuth.aeb.nl:/_. For filesystems with no storage, any string can be used, and will show up in *df*(1) output, for example. Typical usage is _proc_ for *procfs*; _mem_, _none_, or _tmpfs_ for *tmpfs*. Other special filesystems, like *udev* and *sysfs*, are typically not listed in *fstab*."
-msgstr "För vanliga monteringar kommer det att innehålla (en länk till) en blockspecifik enhetsnod (som skapats av *mknod*(2)) för den enhet som ska monteras, t.ex. _/dev/cdrom_ eller _/dev/sdb7_. För NFS-monteringar är det här fältet _<host>:<dir>_, t.ex. _knuth.aeb.nl:/_. För filsystem utan lagringsutrymme kan vilken sträng som helst användas och visas t.ex. i *df*(1)-utdata. Typisk användning är _proc_ för *procfs*; _mem_, _none_ eller _tmpfs_ för *tmpfs*. Andra speciella filsystem, som *udev* och *sysfs*, är vanligtvis inte listade i *fstab*."
+msgstr "För vanliga monteringar innehåller fältet en blockspeciell enhetsnod, eller en länk till en sådan, som skapats av *mknod*(2), för enheten som ska monteras, till exempel _/dev/cdrom_ eller _/dev/sdb7_. För NFS-monteringar är fältet _<host>:<kat>_, till exempel _knuth.aeb.nl:/_. För filsystem utan lagringsutrymme kan vilken sträng som helst användas och visas till exempel i utdata från *df*(1). Typisk användning är _proc_ för *procfs*; _mem_, _none_ eller _tmpfs_ för *tmpfs*. Andra speciella filsystem, som *udev* och *sysfs*, tas vanligen inte upp i *fstab*."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:78
 msgid "LABEL=<label> or UUID=<uuid> may be given instead of a device name. This is the recommended method, as device names are often a coincidence of hardware detection order, and can change when other disks are added or removed. For example, 'LABEL=Boot' or 'UUID=3e6be9de-8139-11d1-9106-a43f08d823a6'. (Use a filesystem-specific tool like *e2label*(8), *xfs_admin*(8), or *fatlabel*(8) to set LABELs on filesystems)."
-msgstr "LABEL=<label> eller UUID=<uuid> kan anges i stället för ett enhetsnamn. Detta är den rekommenderade metoden, eftersom enhetsnamn ofta är en tillfällighet som beror på maskinvarans identifieringsordning och kan ändras när andra diskar läggs till eller tas bort. Till exempel 'LABEL=Boot' eller 'UUID=3e6be9de-8139-11d1-9106-a43f08d823a6'. (Använd ett filsystemspecifikt verktyg som *e2label*(8), *xfs_admin*(8) eller *fatlabel*(8) för att ställa in LABEL på filsystem)."
+msgstr "LABEL=<etikett> eller UUID=<uuid> kan anges i stället för ett enhetsnamn. Detta är den rekommenderade metoden, eftersom enhetsnamn ofta beror på ordningen vid maskinvaruidentifiering och kan ändras när andra diskar läggs till eller tas bort. Till exempel 'LABEL=Boot' eller 'UUID=3e6be9de-8139-11d1-9106-a43f08d823a6'. Använd ett filsystemspecifikt verktyg som *e2label*(8), *xfs_admin*(8) eller *fatlabel*(8) för att ställa in LABEL:er på filsystem."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:80
@@ -22257,12 +22257,12 @@
 #: ../sys-utils/fstab.5.adoc:85
 #, no-wrap
 msgid "The second field (_fs_file_)."
-msgstr "Det andra fältet (_fs_fil_)."
+msgstr "Det andra fältet (_fs_file_)."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:88
 msgid "This field describes the mount point (target) for the filesystem. For swap area, this field should be specified as `none'. If the name of the mount point contains spaces or tabs these can be escaped as `\\040' and '\\011' respectively."
-msgstr "Detta fält beskriver monteringspunkten (target) för filsystemet. För växlingsområden bör detta fält anges som `none'. Om namnet på monteringspunkten innehåller mellanslag eller tabbar kan dessa escapas som `\\040' respektive '\\011'."
+msgstr "Fältet beskriver monteringspunkten, det vill säga målet, för filsystemet. För växlingsutrymme bör fältet anges som `none'. Om monteringspunktens namn innehåller mellanslag eller tabbar kan dessa skyddas med escape som `\\040' respektive '\\011'."
 
 #. type: Title ===
 #: ../sys-utils/fstab.5.adoc:89
@@ -22278,7 +22278,7 @@
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:94
 msgid "An entry _swap_ denotes a file or partition to be used for swapping, cf. *swapon*(8). An entry _none_ is useful for bind or move mounts."
-msgstr "En post _swap_ betecknar en fil eller partition som ska användas för swapping, jfr *swapon*(8). En post _none_ är användbar för bindnings- eller flyttmonteringar."
+msgstr "En post _swap_ betecknar en fil eller partition som ska användas för växling, jämför *swapon*(8). En post _none_ är användbar för bindnings- eller flyttmonteringar."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:96
@@ -22288,7 +22288,7 @@
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:98
 msgid "*mount*(8) and *umount*(8) support filesystem _subtypes_. The subtype is defined by '.subtype' suffix. For example 'fuse.sshfs'. It's recommended to use subtype notation rather than add any prefix to the first fstab field (for example 'sshfs#example.com' is deprecated)."
-msgstr "*mount*(8) och *umount*(8) stöder filsystemets _subtypes_. Subtypen definieras av suffixet '.subtype'. Till exempel 'fuse.sshfs'. Vi rekommenderar att du använder subtypsnotation i stället för att lägga till något prefix i det första fstab-fältet (t.ex. 'sshfs#example.com' är föråldrat)."
+msgstr "*mount*(8) och *umount*(8) stöder filsystemets _undertypes_. Undertypen definieras av suffixet '.subtype', till exempel 'fuse.sshfs'. Använd undertypsnotation i stället för att lägga till ett prefix i det första fstab-fältet; till exempel är 'sshfs#example.com' föråldrat."
 
 #. type: Title ===
 #: ../sys-utils/fstab.5.adoc:99
@@ -22304,17 +22304,17 @@
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:104
 msgid "It is formatted as a comma-separated list of options and is optional for *mount*(8) or *swapon*(8). The usual convention is to use at least \"defaults\" keyword there."
-msgstr "Den är formaterad som en kommaseparerad lista med flaggor och är valfria för *mount*(8) eller *swapon*(8). Den vanliga konventionen är att använda åtminstone nyckelordet \"defaults\" där."
+msgstr "Det formateras som en kommaseparerad lista med flaggor och är valfritt för *mount*(8) eller *swapon*(8). Den vanliga konventionen är att använda åtminstone nyckelordet ”defaults” där."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:106
 msgid "It usually contains the type of mount (*ro* or *rw*, the default is *rw*), plus any additional options appropriate to the filesystem type (including performance-tuning options). For details, see *mount*(8) or *swapon*(8)."
-msgstr "Den innehåller vanligtvis typen av montering (*ro* eller *rw*, standard är *rw*), plus eventuella ytterligare flaggor som är lämpliga för filsystemtypen (inklusive prestandajusteringsflaggor). För mer information, se *mount*(8) eller *swapon*(8)."
+msgstr "Fältet innehåller vanligen monteringssättet, *ro* eller *rw* där *rw* är standard, och ytterligare flaggor som passar filsystemtypen, inklusive flaggor för prestandajustering. Se *mount*(8) eller *swapon*(8) för mer information."
 
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:108
 msgid "Basic filesystem-independent options are:"
-msgstr "Grundläggande filsystemoberoende flaggor är:"
+msgstr "Grundläggande filsystemsoberoende flaggor är:"
 
 #. type: Labeled list
 #: ../sys-utils/fstab.5.adoc:109 ../sys-utils/mount.8.adoc:607
@@ -22337,7 +22337,7 @@
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:113
 msgid "do not mount when *mount -a* is given (e.g., at boot time)"
