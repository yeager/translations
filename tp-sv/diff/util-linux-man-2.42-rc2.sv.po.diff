 #. type: Labeled list
 #: ../sys-utils/fstab.5.adoc:113 ../sys-utils/mount.8.adoc:747
@@ -22370,7 +22370,7 @@
 #. type: Plain text
 #: ../sys-utils/fstab.5.adoc:119
 msgid "or *x-<name>* for use by fstab-maintaining programs"
-msgstr "eller *x-<name>* för användning av fstab-underhållande program"
