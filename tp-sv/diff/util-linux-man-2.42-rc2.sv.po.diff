-msgstr "*-d*, *--disable* _cpu-list_"
+msgstr "*-d*, *--disable* _CPU-lista_"
 
 #. type: Plain text
 #: ../sys-utils/chcpu.8.adoc:34
 msgid "Disable the specified CPUs. Disabling a CPU means that the kernel sets it offline."
-msgstr "Inaktivera de angivna processorerna. Att inaktivera en CPU innebär att kärnan sätter den offline."
+msgstr "Inaktivera de angivna CPU:erna. Att inaktivera en CPU innebär att kärnan sätter den offline."
 
