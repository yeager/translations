 #: ../term-utils/scriptlive.1.adoc:61 ../term-utils/scriptreplay.1.adoc:64
 msgid "Speed up the replay displaying this _number_ of times. The argument is a floating-point number. It's called divisor because it divides the timings by this factor. This option overrides old-style arguments."
-msgstr "Påskynda uppspelningen genom att visa detta _antal_ gånger. Argumentet är ett flyttal. Det kallas divisor eftersom det dividerar tidsangivelserna med denna faktor. Den här flaggan åsidosätter gamla argument."
+msgstr "Snabba upp uppspelningen med faktorn _nummer_. Argumentet är ett flyttal. Det kallas delare eftersom tidsangivelserna delas med den faktorn. Flaggan åsidosätter argument i gammal stil."
 
 #. type: Labeled list
 #: ../term-utils/scriptlive.1.adoc:62 ../term-utils/scriptreplay.1.adoc:65
@@ -36850,7 +36850,7 @@
 #. type: Plain text
 #: ../term-utils/scriptlive.1.adoc:64 ../term-utils/scriptreplay.1.adoc:67
 msgid "Set the maximum delay between updates to _number_ of seconds. The argument is a floating-point number. This can be used to avoid long pauses in the typescript replay."
-msgstr "Ställ in den maximala fördröjningen mellan uppdateringar till _antal_ sekunder. Argumentet är ett flyttal. Detta kan användas för att undvika långa pauser i uppspelningen av typskriften."
+msgstr "Ställ in den maximala fördröjningen mellan uppdateringar till _nummer_ sekunder. Argumentet är ett flyttal. Detta kan användas för att undvika långa pauser vid uppspelning av typescriptfilen."
 
