-msgstr "Länka ingenting, utan lista den absoluta sökvägen till varje duplicerad fil, en per rad, föregången av en unik 16-bytes diskriminator och en tabb."
+msgstr "Länka ingenting, utan lista varje dubblettfils absoluta sökväg, en per rad, föregången av en unik 16-byteidentifierare och en tabb."
 
 #. type: Labeled list
 #: ../misc-utils/hardlink.1.adoc:73
@@ -14416,7 +14416,7 @@
 #. type: Plain text
 #: ../misc-utils/hardlink.1.adoc:75
 msgid "Among equal files, keep the file with the highest link count."
-msgstr "Bland likvärdiga filer behåller du filen med det högsta länkantalet."
+msgstr "Behåll filen med högst länkantal bland identiska filer."
 
 #. type: Labeled list
 #: ../misc-utils/hardlink.1.adoc:76
@@ -14427,7 +14427,7 @@
 #. type: Plain text
