@@ -19845,7 +19845,7 @@
 #. type: Plain text
 #: ../sys-utils/blkdiscard.8.adoc:50
 msgid "Perform a secure discard. A secure discard is the same as a regular discard except that all copies of the discarded blocks that were possibly created by garbage collection must also be erased. This requires support from the device."
-msgstr "Utför en säker kassering. Säker kassering är samma sak som vanlig kassering, men alla kopior av de kasserade block som kan ha skapats av skräpsamling måste också raderas. Funktionen kräver stöd från enheten."
+msgstr "Utför en säker förkastning. En säker förkastning är detsamma som en vanlig förkastning, förutom att alla kopior av de förkastade block som kan ha skapats vid skräprensning också måste raderas. Funktionen kräver stöd från enheten."
 
 #. type: Labeled list
 #: ../sys-utils/blkdiscard.8.adoc:51
@@ -19856,27 +19856,27 @@
 #. type: Plain text
 #: ../sys-utils/blkdiscard.8.adoc:53
