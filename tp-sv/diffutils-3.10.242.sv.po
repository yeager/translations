#: src/cmp.c:167
msgid "-b, --print-bytes          print differing bytes"
msgstr "-b, --print-bytes          skriv ut byte som skiljer sig"

#: src/cmp.c:168
msgid "-i, --ignore-initial=SKIP         skip first SKIP bytes of both inputs"
msgstr "-i, --ignore-initial=HOPP         hoppa över de första HOPP bytena i båda indata"

#: src/cmp.c:169
msgid ""
"-i, --ignore-initial=SKIP1:SKIP2  skip first SKIP1 bytes of FILE1 and\n"
"                                      first SKIP2 bytes of FILE2"
msgstr ""
"-i, --ignore-initial=HOPP1:HOPP2  hoppa över de HOPP1 första byten i FIL1 och\n"
"                                      de HOPP2 första byten i FIL2"

#: src/cmp.c:171
msgid "-l, --verbose              output byte numbers and differing byte values"
msgstr "-l, --verbose              skriv ut bytenummer och värden för byte som skiljer sig"

#: src/cmp.c:172
msgid "-n, --bytes=LIMIT          compare at most LIMIT bytes"
msgstr "-n, --bytes=GRÄNS          jämför högst GRÄNS byte"

#: src/cmp.c:173
msgid "-s, --quiet, --silent      suppress all normal output"
msgstr "-s, --quiet, --silent      undertryck all normal utdata"

#: src/cmp.c:174
msgid "    --help                 display this help and exit"
msgstr "    --help                 visa denna hjälp och avsluta"

#: src/cmp.c:175
msgid "-v, --version              output version information and exit"
msgstr "-v, --version              visa versionsinformation och avsluta"

#: src/cmp.c:182
#, c-format
msgid "Usage: %s [OPTION]... FILE1 [FILE2 [SKIP1 [SKIP2]]]\n"
msgstr "Användning: %s [FLAGGA]... FIL1 [FIL2 [HOPP1 [HOPP2]]]\n"

#: src/cmp.c:184
msgid "Compare two files byte by byte."
msgstr "Jämför två filer byte för byte."

#: src/cmp.c:186
msgid ""
"The optional SKIP1 and SKIP2 specify the number of bytes to skip\n"
"at the beginning of each file (zero by default)."
msgstr ""
"De valfria HOPP1 och HOPP2 anger antalet byte att hoppa över\n"
"i början av varje fil, noll som standard."

#: src/cmp.c:189 src/diff.c:1070 src/diff3.c:459 src/sdiff.c:211
msgid "Mandatory arguments to long options are mandatory for short options too.\n"
msgstr "Obligatoriska argument till långa flaggor är obligatoriska även för de korta.\n"

#: src/cmp.c:195
msgid ""
"SKIP values may be followed by the following multiplicative suffixes:\n"
"kB 1000, K 1024, MB 1,000,000, M 1,048,576,\n"
"GB 1,000,000,000, G 1,073,741,824, and so on for T, P, E, Z, Y."
msgstr ""
"HOPP-värden kan följas av följande multiplikativa suffix:\n"
"kB 1000, K 1024, MB 1 000 000, M 1 048 576\n"
"GB 1 000 000 000, G 1 073 741 824, och så vidare för T, P, E, Z, Y."

#: src/cmp.c:198
msgid "If a FILE is '-' or missing, read standard input."
msgstr "Om FIL är ”-” eller saknas, läs standardindata."

#: src/cmp.c:199 src/diff.c:1060 src/sdiff.c:221
msgid "Exit status is 0 if inputs are the same, 1 if different, 2 if trouble."
msgstr "Slutstatus är 0 om indata är lika, 1 om de skiljer sig och 2 vid problem."

