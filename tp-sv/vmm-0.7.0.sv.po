#: VirtualMailManager/alias.py:59
#, python-format
msgid ""
"Cannot add %(count_new)i new destination(s) to alias '%(address)s'.\n"
"Currently this alias expands into %(count)i/%(limit)i recipients.\n"
"%(count_new)i additional destination(s) will render this alias unusable.\n"
"Hint: Increase Postfix' virtual_alias_expansion_limit"
msgstr ""
"Det går inte att lägga till %(count_new)i nya destinationer till aliaset ”%(address)s”.\n"
"För närvarande utökas aliaset till %(count)i/%(limit)i mottagare.\n"
"%(count_new)i ytterligare destinationer gör aliaset oanvändbart.\n"
"Tips: Öka Postfix virtual_alias_expansion_limit"

#: VirtualMailManager/alias.py:66
#, python-format
msgid ""
"Cannot add %(count_new)i new destination(s) to alias '%(address)s'.\n"
"This alias already exceeds its expansion limit (%(count)i/%(limit)i).\n"
"So its unusable, all messages addressed to this alias will be bounced.\n"
"Hint: Delete some destination addresses."
msgstr ""
"Det går inte att lägga till %(count_new)i nya destinationer till aliaset ”%(address)s”.\n"
"Aliaset överskrider redan sin utökningsgräns (%(count)i/%(limit)i).\n"
"Det är därför oanvändbart; alla meddelanden till aliaset studsar.\n"
"Tips: Ta bort några destinationsadresser."

