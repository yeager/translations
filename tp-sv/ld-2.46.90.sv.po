#: eaarch64elf.c:1063 eaarch64elf32.c:1063 eaarch64elf32b.c:1063
#: eaarch64elfb.c:1063 eaarch64fbsd.c:1063 eaarch64fbsdb.c:1063
#: eaarch64haiku.c:1058 eaarch64linux.c:1063 eaarch64linux32.c:1063
#: eaarch64linux32b.c:1063 eaarch64linuxb.c:1063 eaarch64nto.c:1235
#, c-format
msgid ""
"  --fix-cortex-a53-843419[=full|adr|adrp]      Fix erratum 843419 and optionally specify which workaround to use.\n"
"                                               full (default): Use both ADRP and ADR workaround, this will \n"
"                                                 increase the size of your binaries.\n"
"                                               adr: Only use the ADR workaround, this will not cause any increase\n"
"                                                 in binary size but linking will fail if the referenced address is\n"
"                                                 out of range of an ADR instruction.  This will remove the need of using\n"
"                                                 a veneer and results in both performance and size benefits.\n"
"                                               adrp: Use only the ADRP workaround, this will never rewrite your ADRP\n"
"                                                 instruction into an ADR.  As such the workaround will always use a\n"
"                                                 veneer and this will give you both a performance and size overhead.\n"
msgstr ""
"  --fix-cortex-a53-843419[=full|adr|adrp]      Åtgärda fel 843419 och ange valfritt vilken lösning som ska användas.\n"
"                                               full (standard): Använd både ADRP- och ADR-lösningen, detta\n"
"                                                 kommer att öka storleken på dina binärfiler.\n"
"                                               adr: Använd endast ADR-lösningen, detta kommer inte att orsaka någon\n"
"                                                 ökning av binärstorleken men länkningen kommer att misslyckas om den\n"
"                                                 refererade adressen ligger utanför räckvidden för en ADR-instruktion.\n"
"                                                 Detta tar bort behovet av en stubb och ger både prestanda- och\n"
"                                                 storleksfördelar.\n"
"                                               adrp: Använd endast ADRP-lösningen, detta kommer aldrig att skriva om din\n"
"                                                 ADRP-instruktion till en ADR.  Lösningen kommer därför alltid att använda\n"
"                                                 en stubb, vilket medför kostnader för både prestanda och storlek.\n"

