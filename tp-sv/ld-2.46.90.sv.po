#, c-format
msgid ""
"  -z force-bti                         Turn on Branch Target Identification mechanism and generate PLTs with BTI.\n"
"                                         Generate warnings for missing BTI markings on inputs\n"
msgstr ""
"  -z force-bti                         Aktivera mekanismen Branch Target Identification och generera PLT:er med BTI.\n"
"                                         Generera varningar för saknade BTI-markeringar i indata\n"

#: eaarch64elf.c:1078 eaarch64elf32.c:1078 eaarch64elf32b.c:1078
#: eaarch64elfb.c:1078 eaarch64fbsd.c:1078 eaarch64fbsdb.c:1078
#: eaarch64haiku.c:1073 eaarch64linux.c:1078 eaarch64linux32.c:1078
#: eaarch64linux32b.c:1078 eaarch64linuxb.c:1078 eaarch64nto.c:1250
#, c-format
msgid ""
"  -z bti-report[=none|warning|error]   Emit warning/error on mismatch of BTI marking between input objects and ouput.\n"
"                                         none: Does not emit any warning/error messages.\n"
"                                         warning (default): Emit warning when the input objects are missing BTI markings\n"
"                                           and output has BTI marking.\n"
"                                         error: Emit error when the input objects are missing BTI markings\n"
"                                           and output has BTI marking.\n"
msgstr ""
"  -z bti-report[=none|warning|error]   Utfärda varning/fel vid avvikande BTI-markering mellan indataobjekt och utdata.\n"
"                                         none: Utfärda inga varnings- eller felmeddelanden.\n"
"                                         warning (standard): Utfärda en varning när indataobjekten saknar BTI-markeringar\n"
"                                           och utdata har en BTI-markering.\n"
"                                         error: Utfärda ett fel när indataobjekten saknar BTI-markeringar\n"
"                                           och utdata har en BTI-markering.\n"

#: eaarch64elf.c:1085 eaarch64elf32.c:1085 eaarch64elf32b.c:1085
