msgid "be case-insensitive (use when searching)"
msgstr "ignorera skiftläge (använd vid sökning)"

#: src/doodle/doodle.c:80
msgid "LIBRARY"
msgstr "BIBLIOTEK"

#: src/doodle/doodle.c:81 src/doodle/doodled.c:69
msgid "load an extractor plugin named LIBRARY"
msgstr "läs in instick för extraherare med namnet BIBLIOTEK"

