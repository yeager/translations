msgctxt "MSG_AskProjectSaveFirstAnswers (//)"
msgid "*Save project|_Cancel"
msgstr "*Spara projekt|_Avbryt"

msgctxt "MSG_AskProjectRetryContinueAnswers (//)"
msgid "*Retry|Continue"
msgstr "*Försök igen|Fortsätt"

