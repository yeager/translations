msgstr "Kunde inte öppna enheten ”%s” för läsning och skrivning."

#: sys/v4l2/v4l2_calls.c:635
#, c-format
msgid "Device '%s' is not a capture device."
msgstr "Enheten ”%s” är inte en fångstenhet."

#: sys/v4l2/v4l2_calls.c:642
#, c-format
msgid "Device '%s' is not a output device."
msgstr "Enheten ”%s” är inte en utdataenhet."

#: sys/v4l2/v4l2_calls.c:649
#, c-format
msgid "Device '%s' is not a M2M device."
msgstr "Enheten ”%s” är ingen M2M-enhet."

#: sys/v4l2/v4l2_calls.c:701
#, c-format
msgid "Could not dup device '%s' for reading and writing."
msgstr "Kunde inte duplicera enheten ”%s” för läsning och skrivning."

#: sys/v4l2/v4l2_calls.c:785
#, c-format
msgid "Failed to set norm for device '%s'."
msgstr "Misslyckades med att ställa in norm för enheten ”%s”."

#: sys/v4l2/v4l2_calls.c:823
#, c-format
msgid "Failed to get current tuner frequency for device '%s'."
msgstr "Misslyckades med att hämta aktuell mottagarfrekvens för enheten ”%s”."

#: sys/v4l2/v4l2_calls.c:865
#, c-format
msgid "Failed to set current tuner frequency for device '%s' to %lu Hz."
msgstr "Misslyckades med att ställa in aktuell mottagarfrekvens för enheten ”%s” till %lu Hz."

#: sys/v4l2/v4l2_calls.c:899
#, c-format
msgid "Failed to get signal strength for device '%s'."
msgstr "Misslyckades med att hämta signalstyrkan för enheten ”%s”."

#: sys/v4l2/v4l2_calls.c:935
#, c-format
msgid "Failed to get value for control %d on device '%s'."
msgstr "Misslyckades med att få tag på värdet för kontrollen %d på enheten ”%s”."

#: sys/v4l2/v4l2_calls.c:970
#, c-format
msgid "Failed to set value %d for control %d on device '%s'."
msgstr "Kunde inte ställa in värdet %d för kontrollen %d på enheten ”%s”."

#: sys/v4l2/v4l2_calls.c:1030
#, c-format
msgid "Failed to set value %s for control %d on device '%s'."
msgstr "Kunde inte ställa in värdet %s för kontrollen %d på enheten ”%s”."

#: sys/v4l2/v4l2_calls.c:1118
#, c-format
msgid "Failed to get current input on device '%s'. May be it is a radio device"
msgstr "Misslyckades med att hämta aktuell ingång för enheten ”%s”. Det kan vara en "
"radioenhet."

#: sys/v4l2/v4l2_calls.c:1143
#, c-format
msgid "Failed to set input %u on device %s."
msgstr "Kunde inte ställa in ingång %u på enheten %s."

#: sys/v4l2/v4l2_calls.c:1190
#, c-format
msgid "Failed to get current output on device '%s'. May be it is a radio device"
msgstr "Misslyckades med att hämta aktuell utdata för enheten ”%s”. Det kan vara en "
"radioenhet."

#: sys/v4l2/v4l2_calls.c:1215
#, c-format
msgid "Failed to set output %u on device %s."
msgstr "Misslyckades med att ställa in utdata %u på enheten %s."

