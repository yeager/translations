#: sys/v4l2/gstv4l2videoenc.c:151
#, c-format
msgid "Encoder on device %s has no supported output format"
msgstr "Kodaren på enheten %s har inget utgångsformat som stöds"

#: sys/v4l2/gstv4l2videoenc.c:158
#, c-format
msgid "Encoder on device %s has no supported input format"
msgstr "Kodaren på enheten %s har inget ingångsformat som stöds"

#: sys/v4l2/gstv4l2videoenc.c:841
msgid "Failed to force keyframe."
msgstr "Misslyckades med att tvinga fram en nyckelbildruta."

#: sys/v4l2/gstv4l2videoenc.c:888
msgid "Failed to start encoding thread."
msgstr "Misslyckades med att starta kodningstråden."

#: sys/v4l2/v4l2_calls.c:92
#, c-format
msgid "Error getting capabilities for device '%s': It isn't a v4l2 driver. Check if it is a v4l1 driver."
msgstr "Fel vid hämtning av caps för enheten ”%s”: Det är inte en v4l2-drivrutin. "
"Kontrollera om det är en v4l1-drivrutin."

#: sys/v4l2/v4l2_calls.c:156
#, c-format
msgid "Failed to query attributes of input %d in device %s"
msgstr "Misslyckades med att fråga efter attribut för ingång %d på enheten %s"

