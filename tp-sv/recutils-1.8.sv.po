#. TRANSLATORS: --help output, recfix synopsis.
#. no-wrap
#: utils/recfix.c:117
#, c-format
msgid "Usage: recfix [OPTION]... [OPERATION] [OP_OPTION]... [FILE]\n"
msgstr "Användning: recfix [FLAGGA]... [ÅTGÄRD] [ÅTGÄRDSFLAGGA]... [FIL]\n"

