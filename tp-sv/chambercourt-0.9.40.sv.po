#: chambercourt/game.py:281
msgid "cannot find asset `{}'"
msgstr "kan inte hitta resurs `{}'"

#: chambercourt/game.py:910
msgid "Start at level: ←{}→/{}"
msgstr "Starta på nivå: ←{}→/{}"

#: chambercourt/game.py:951
msgid "Press Space or button A to play!"
msgstr "Tryck på mellanslag eller knapp A för att spela!"

#. TRANSLATORS: this message should appear in the previous one
#. It will be highlighted as a button.
#: chambercourt/game.py:954 chambercourt/game.py:964 chambercourt/game.py:973
msgid "play"
msgstr "spela"

#: chambercourt/game.py:1230
msgid "Level {}:"
msgstr "Nivå {}:"

#: chambercourt/game.py:1315
msgid "a directory or Zip file of levels to use"
msgstr "en katalog eller zip-fil med nivåer att använda"

#: chambercourt/game.py:1342
msgid "pygame does not have extended image format support"
msgstr "pygame har inte utökat stöd för bildformat"

#: chambercourt/game.py:1390
msgid "Error reading levels: {}"
msgstr "Fel vid läsning av nivåer: {}"

#: chambercourt/game.py:1393
msgid "Could not find any levels"
msgstr "Kunde inte hitta några nivåer"

# Texten centrerad ungefär enligt följande:
# Blanksteg före + antal tecken + blanksteg efter=40
#: chambercourt/game.py:1406
msgid ""
"Z/X - Left/Right   '/? - Up/Down\n"
"or use arrow keys, game controller\n"
"joystick, mouse or tap the screen\n"
msgstr ""
"Z/X - Vänster/Höger   '/? - Upp/Ner\n"
"eller använd piltangenterna,\n"
"handkontrollens styrpinne, musen\n"
"eller tryck på skärmen\n"

#: chambercourt/game.py:1412
msgid ""
"S/Button A - Save position\n"
"L/Button B - Load position\n"
"R/Button Y - Restart level\n"
"Q - Quit game\n"
"F - toggle full screen\n"
msgstr ""
"S/Knapp A - Spara position\n"
"L/Knapp B - läs in position\n"
"R/Knapp Y - Starta om nivå\n"
"Q - Avsluta spel\n"
"F - växla helskärmsläge\n"
