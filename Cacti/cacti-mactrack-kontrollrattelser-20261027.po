#: mactrack_actions.php
#, php-format
msgid "Mactrack Device: (%s) successfully updated"
msgstr "Mactrack-enhet: (%s) har uppdaterats"

#: mactrack_macauth.php
msgid "Click 'Continue' to delete the following Authorized Mac's?"
msgstr "Klicka på ”Fortsätt” för att ta bort följande auktoriserade MAC-adresser?"

#: mactrack_macwatch.php
msgid "Click 'Continue' to delete the following watched Mac's?"
msgstr "Klicka på ”Fortsätt” för att ta bort följande bevakade MAC-adresser?"

#: mactrack_sites.php
msgid "Click 'Continue' to delete the following Site(s)?"
msgstr "Klicka på ”Fortsätt” för att ta bort följande platser?"

#: mactrack_utilities.php
msgid "Process Status Information"
msgstr "Information om processernas status"

#: mactrack_utilities.php
msgid "Deletes ALL <strong>Aggregated</strong> (Not Scan Results) Port to MAC to IP associations from the database and their re-creation based on <strong>All scanned data</strong> now."
msgstr "Tar bort alla <strong>aggregerade</strong> kopplingar mellan portar, MAC-adresser och IP-adresser från databasen och återskapar dem direkt utifrån <strong>alla skanningsdata</strong>. Skanningsresultaten lämnas kvar."
