"Uppdatera config.php med den korrekta relativa URI-platsen för Cacti "
"(url_path)."

#: lib/installer.php:2190
msgid ""
"Your Cacti configuration has the relative correct path (url_path) in "
"config.php."
msgstr ""
"Din Cacti-konfiguration har den relativa korrekta sökvägen (url_path) i "
"config.php."

#: lib/installer.php:2199
#, php-format
msgid "PHP - Recommendations (%s)"
msgstr "PHP - Rekommendationer (%s)"

#: lib/installer.php:2203
msgid "PHP Recommendations ("
msgstr "PHP-rekommendationer ("

#: lib/installer.php:2204
msgid "Current"
msgstr "Aktuellt"

#: lib/installer.php:2204
msgid "Recommended"
msgstr "Rekommenderad"

#: lib/installer.php:2212
msgid "PHP Binary"
msgstr "PHP Binär"

#: lib/installer.php:2215
msgid "The PHP binary location is not valid and must be updated."
msgstr "Den binära PHP-platsen är inte giltig och måste uppdateras."

#: lib/installer.php:2222
msgid "Update the path_php_binary value in the settings table."
msgstr "Uppdatera värdet path_php_binary i inställningstabellen."

#: lib/installer.php:2234
