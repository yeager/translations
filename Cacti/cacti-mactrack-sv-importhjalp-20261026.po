#: mactrack_device_types.php
msgid ""
" - The vendor specific snmp sysObjectID that distinguishes this device from "
"the next"
msgstr ""
" - Tillverkarens SNMP sysObjectID som skiljer den här enheten från andra "
"enheter"

#: mactrack_devices.php
msgid " - The current snmp read string for the device"
msgstr " - Enhetens aktuella SNMP-communitysträng för läsåtkomst"

#: mactrack_devices.php
msgid ""
" - The snmp version you wish to scan this device with.  Valid values are 1, "
"2 and 3"
msgstr ""
" - SNMP-versionen som ska användas för att skanna enheten. Giltiga värden är"
" 1, 2 och 3"

#: mactrack_devices.php
msgid " - The UDP port that the snmp agent is running on"
msgstr " - UDP-porten som SNMP-agenten använder"

#: mactrack_devices.php
msgid ""
" - The timeout in milliseconds to wait for an snmp response before trying "
"again"
msgstr ""
" - Tiden i millisekunder som ett SNMP-svar inväntas innan ett nytt försök "
"görs"

#: mactrack_devices.php
msgid ""
" - Specified the number of OID's that can be obtained in a single SNMP Get "
"request"
msgstr " - Antalet OID:er som kan hämtas i en enda SNMP GET-förfrågan"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP username"
msgstr " - SNMPv3: SNMP-användarnamn"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP privacy passphrase"
msgstr " - SNMPv3: lösenfras för SNMP-kryptering"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP privacy protocol"
msgstr " - SNMPv3: SNMP-krypteringsprotokoll"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP engine id"
msgstr " - SNMPv3: SNMP-motor-ID"
