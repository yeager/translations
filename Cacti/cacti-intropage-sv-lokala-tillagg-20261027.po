#: intropage.php
msgid "Refresh Disabled"
msgstr "Uppdatering inaktiverad"

#: intropage.php
msgid "Refresh by Poller"
msgstr "Uppdatering via datainsamlare"

#: intropage.php
msgid "Refresh Every 1 Minute"
msgstr "Uppdatera varje minut"

#: intropage.php
msgid "Reload Panel Definitions"
msgstr "Läs in paneldefinitioner på nytt"

#: intropage.php
msgid "Use shared dashboard"
msgstr "Använd delad instrumentpanel"

#: intropage.php
msgid "No shared dashboards"
msgstr "Inga delade instrumentpaneler"

#: intropage.php
msgid "If you want to copy text from panel, you have to disable drag and drop function, use icon"
msgstr "Om du vill kopiera text från panelen måste du inaktivera funktionen för dra och släpp med ikonen"

#: intropage.php
msgid "Disable panel move/Enable copy text from panel"
msgstr "Inaktivera panelrörelse/aktivera kopiering av text från panel"

#: intropage.php
msgid "Details Function does not exist."
msgstr "Detaljfunktionen finns inte."

#: intropage.php
msgid "No Data Present.  Either Force Update, or wait for next Cacti Polling cycle."
msgstr "Det finns inga data. Tvinga antingen fram en uppdatering eller vänta på nästa datainsamlingscykel i Cacti."

#: intropage.php
msgid "No Data Present.  This Panel does not allow for Forced Updates.  You will have to wait until the Cacti's Poller to perform the check."
msgstr "Det finns inga data. Den här panelen tillåter inte tvångsuppdateringar. Du måste vänta tills Cactis datainsamlare utför kontrollen."

#: intropage.php
msgid "Reload Panel"
msgstr "Läs in panelen på nytt"

#: intropage.php
msgid "No Data Found.  Either wait for next check, <br/>or use the Force Reload if available."
msgstr "Det finns inga data. Vänta antingen på nästa kontroll <br/>eller använd Tvinga omladdning om det är tillgängligt."

#: intropage.php
msgid "Cannot add to Dashboard. Custom timespan."
msgstr "Det går inte att lägga till på instrumentpanelen. Anpassad tidsperiod."

#: intropage.php
msgid "You can Allow/Disallow Panels for User"
msgstr "Du kan tillåta eller neka paneler för användare"

#: intropage.php
msgid "Automatically by poller"
msgstr "Automatiskt av datainsamlare"

#: intropage.php
#, php-format
msgid "%d lines"
msgstr "%d linjer"

#: intropage.php
msgid "Poller Timeout"
msgstr "Datainsamlarens tidsgräns"

#: intropage.php
msgid "The amount of time, in minutes, that the Intropage background poller can run before being interrupted and killed by Cacti."
msgstr "Den tid i minuter som Intropages bakgrundsdatainsamlare kan köras innan den avbryts och stoppas av Cacti."

#: intropage.php
msgid "Poller runs this task. It could cause long poller run."
msgstr "Datainsamlaren kör den här uppgiften. Det kan orsaka en lång insamlingskörning."

#: intropage.php
msgid "Alarm non-empty Poller Output"
msgstr "Larma vid ej tom utdata från datainsamlare"

#: intropage.php
msgid "Alarm Red/Yellow Polling Time"
msgstr "Larmgränser för datainsamlingstid: gult/rött"

#: intropage.php
msgid "Polling times above these thresholds will trigger a Warning or Alert status color."
msgstr "Datainsamlingstider över dessa tröskelvärden utlöser en varnings- eller larmstatusfärg."

#: intropage.php
msgid "20s / 40s Yellow / Red"
msgstr "20 s / 40 s, gult / rött"

#: intropage.php
msgid "Alerts"
msgstr "Larm"

#: intropage.php
msgid "State"
msgstr "Tillstånd"

#: intropage.php
msgid "Analyze DS stats"
msgstr "Analysera datakällestatistik"

#: intropage.php
msgid "Success - Token"
msgstr "Lyckades – token"

#: intropage.php
msgid "Log Size: Larger than 2GB"
msgstr "Loggstorlek: större än 2 GB"

#: intropage.php
msgid "Log Size: Quite Large"
msgstr "Loggstorlek: ganska stor"

#: intropage.php
msgid "Skipping DB tables checks. Database too large"
msgstr "Kontroller av databastabeller hoppas över. Databasen är för stor"

#: intropage.php
#, php-format
msgid "Table %s status %s"
msgstr "Tabell %s: status %s"

#: intropage.php
#, php-format
msgid "Connection errors: %s - try to restart SQL service, check SQL log, ..."
msgstr "Anslutningsfel: %s. Försök att starta om SQL-tjänsten och kontrollera SQL-loggen."

#: intropage.php
msgid "Please have a look to device parameter \"Bulk Walk Maximum Repetitions\". You can improve your poller performance"
msgstr "Kontrollera enhetsparametern ”Bulk Walk Maximum Repetitions”. Du kan förbättra datainsamlingens prestanda"

#: intropage.php
msgid "RRD Checker last run"
msgstr "Senaste körning för RRD-kontroll"

#: intropage.php
msgid "RRD Cleaner last run"
msgstr "Senaste körning för RRD-rensning"

