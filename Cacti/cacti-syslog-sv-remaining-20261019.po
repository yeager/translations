msgid "Waiting for a completed processing run."
msgstr "Väntar på att en bearbetningskörning ska slutföras."

msgid "Processing is completing within the allowed delay."
msgstr "Bearbetningen slutförs inom den tillåtna fördröjningen."

#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Ingen bearbetningskörning har slutförts på över %d sekunder."

msgid "Incoming messages are within the configured limits."
msgstr "Inkommande meddelanden ligger inom de konfigurerade gränserna."

msgid "Incoming queue metrics are unavailable."
msgstr "Mått för den inkommande kön är inte tillgängliga."

#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "En inkommande kö med minst %s meddelanden överskrider gränsen %s."

msgid "The oldest incoming message timestamp is unavailable."
msgstr ""
"Tidsstämpeln för det äldsta inkommande meddelandet är inte tillgänglig."

#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Obearbetade meddelanden är äldre än %d sekunder."

msgid "Synchronization is not enabled on this collector."
msgstr "Synkronisering är inte aktiverad på den här insamlaren."

msgid "Synchronization is within the allowed delay."
msgstr "Synkroniseringen ligger inom den tillåtna fördröjningen."

msgid "Synchronization queue metrics are unavailable."
msgstr "Mått för synkroniseringskön är inte tillgängliga."

msgid "The oldest synchronization record timestamp is unavailable."
msgstr ""
"Tidsstämpeln för den äldsta synkroniseringsposten är inte tillgänglig."

msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr ""
"Synkroniseringen har misslyckats eller poster i kön överskrider den tillåtna"
" fördröjningen."

msgid "Partition maintenance is not blocked."
msgstr "Partitionsunderhåll är inte blockerat."

