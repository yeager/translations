msgid "Not materialized yet, with NAT: %s, without NAT: %s."
msgstr "Ännu inte materialiserade, med NAT: %s, utan NAT: %s."

msgid "Up to date"
msgstr "Aktuell"

msgid "Running"
msgstr "Pågår"

msgid "Required"
msgstr "Krävs"

msgid "The number of queries of this Filter that are running now."
msgstr "Antalet frågor för detta filter som körs just nu."

#, php-format
msgid "With NAT: %d, without NAT: %d."
msgstr "Med NAT: %d, utan NAT: %d."

#, php-format
msgid "Running: %s"
msgstr "Pågår: %s"

#, php-format
msgid ""
"ERROR: The Parallel Query did not finish within the Maximum Run Time of %d "
"seconds.  Check the Maximum Run Time under the FlowView Settings, and that "
"the database is not busy with another operation such as an ALTER TABLE."
msgstr ""
"FEL: Den parallella frågan slutfördes inte inom den maximala körtiden på %d "
"sekunder.  Kontrollera den maximala körtiden i Flowview-inställningarna och "
"att databasen inte är upptagen med en annan åtgärd, till exempel ALTER "
"TABLE."
