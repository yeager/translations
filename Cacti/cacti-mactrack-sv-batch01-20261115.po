msgid "None of the selected MAC Addresses were valid, so no action was taken."
msgstr "Ingen av de valda MAC-adresserna var giltig, så ingen åtgärd vidtogs."

msgid ""
"MacTrack is upgrading its database in the background. This can take up to an "
"hour on large installations, and some MacTrack data may be incomplete until "
"it finishes."
msgstr ""
"MacTrack uppgraderar sin databas i bakgrunden. Det kan ta upp till en timme "
"i stora installationer och en del MacTrack-data kan vara ofullständiga tills "
"uppgraderingen är klar."

#, php-format
msgid ""
"MacTrack could not start its database upgrade in the background, see the "
"Cacti log for the reason. Run it manually from the command line: %s"
msgstr ""
"MacTrack kunde inte starta databasuppgraderingen i bakgrunden. Se Cacti-"
"loggen för orsaken. Kör den manuellt från kommandoraden: %s"

msgid "Not observed in latest scan"
msgstr "Observerades inte vid den senaste genomsökningen"
