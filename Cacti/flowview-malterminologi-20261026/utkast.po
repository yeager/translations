msgid ""
"Invalid IP for the Destination Address!<br>(Must be in the form of "
"'192.168.0.1')"
msgstr "Ogiltig IP-adress för måladressen!<br>(Måste ha formen \"192.168.0.1\")"

msgid ""
"Invalid subnet for the Destination Address!<br>(Must be in the form of "
"'192.168.0.1/255.255.255.0' or '192.168.0.1/24')"
msgstr ""
"Ogiltigt delnät för måladressen!<br>(Måste ha formen "
"\"192.168.0.1/255.255.255.0\" eller \"192.168.0.1/24\")"

msgid "Invalid value for Destination Interface!"
msgstr "Ogiltigt värde för målgränssnittet!"
