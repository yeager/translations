#: setup.php
msgid "This is the default timespan that will be displayed on the page."
msgstr "Det här är standardtidsintervallet som visas på sidan."

#: setup.php
msgid "Column Count"
msgstr "Antal kolumner"

#: setup.php
msgid "In Tree Mode this is the number of columns that will be used."
msgstr "I trädläge är detta antalet kolumner som ska användas."

#: setup.php
msgid "Check this to display legend."
msgstr "Markera detta för att visa förklaringen."

#: setup.php
msgid "Select which method to use for custom graph rotation.\n\nIf you select 'Specific List', you must define a list of Graph ID's"
msgstr "Välj vilken metod som ska användas för anpassad diagramrotation.\n\nOm du väljer ”Specifik lista” måste du definiera en lista med diagram-ID:n"

#: setup.php
msgid "This must be a comma delimited list of Graph ID's to cycle through. For example '1,2,3,4'"
msgstr "Det här måste vara en kommaseparerad lista med diagram-ID:n att bläddra igenom. Till exempel ”1,2,3,4”"

#: setup.php
msgid "Default Tree"
msgstr "Standardträd"

#: setup.php
msgid "Select the graph tree to cycle if Tree Mode is selected"
msgstr "Välj det diagramträd som ska visas om trädläge är valt"
