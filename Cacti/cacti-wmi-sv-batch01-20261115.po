msgstr ""
"Project-Id-Version: cacti-wmi\n"
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "ERROR: Invalid WinRM port"
msgstr "FEL: Ogiltig WinRM-port"

msgid "ERROR: Invalid WinRM authentication method"
msgstr "FEL: Ogiltig WinRM-autentiseringsmetod"

msgid "ERROR: Basic WinRM authentication requires HTTPS"
msgstr "FEL: Basic-autentisering för WinRM kräver HTTPS"

msgid "Use WinRM over HTTPS"
msgstr "Använd WinRM över HTTPS"

msgid ""
"Use TLS for CIM/WinRM connections. Configure and trust the target "
"certificate; certificate checks are not disabled."
msgstr ""
"Använd TLS för CIM-/WinRM-anslutningar. Konfigurera och betrakta "
"målets certifikat som betrott. Certifikatkontroller är inte inaktiverade."

msgid "WinRM Port Override"
msgstr "Åsidosätt WinRM-port"

msgid "Optional port override. Leave blank for the Windows WinRM default port."
msgstr "Valfri åsidosättning av port. Lämna tomt för Windows standardport för WinRM."

msgid ""
"Negotiate is the default. Use Kerberos for domain hosts where available. "
"Basic authentication is accepted only when HTTPS is enabled."
msgstr ""
"Negotiate är standard. Använd Kerberos för domänvärdar där det är möjligt. "
"Basic-autentisering godtas endast när HTTPS är aktiverat."

msgid "Negotiate"
msgstr "Negotiate"

msgid "Kerberos"
msgstr "Kerberos"

msgid "Basic (HTTPS only)"
msgstr "Basic, endast HTTPS"

msgid "ERROR: At least one performance counter path is required"
msgstr "FEL: Minst en sökväg till en prestandaräknare krävs"

msgid "ERROR: A PDH query can contain at most 64 counter paths"
msgstr "FEL: En PDH-fråga kan innehålla högst 64 räknarsökvägar"

msgid ""
"Default for accounts that inherit server settings. Configure and trust the "
"target certificate; certificate checks are not disabled."
msgstr ""
"Standard för konton som ärver serverinställningarna. Konfigurera och betrakta "
"målets certifikat som betrott. Certifikatkontroller är inte inaktiverade."

msgid ""
"Default port override for accounts that inherit server settings. Leave blank "
"for the Windows default."
msgstr ""
"Standardåsidosättning av port för konton som ärver serverinställningarna. "
"Lämna tomt för Windows standardport."

msgid ""
"Default for accounts that inherit server settings. Use Kerberos for domain "
"hosts where available. Basic requires HTTPS."
msgstr ""
"Standard för konton som ärver serverinställningarna. Använd Kerberos för "
"domänvärdar där det är möjligt. Basic-autentisering kräver HTTPS."

msgid "WinRM Transport"
msgstr "WinRM-transport"

msgid ""
"Choose whether this account inherits the server setting or uses HTTP or "
"HTTPS."
msgstr ""
"Välj om kontot ärver serverinställningen eller använder HTTP eller HTTPS."

msgid "Use Server Default"
msgstr "Använd serverns standardvärde"

msgid "HTTP"
msgstr "HTTP"

msgid "HTTPS"
msgstr "HTTPS"

msgid "Leave blank to inherit the server setting and Windows WinRM default."
msgstr "Lämna tomt för att ärva serverinställningen och Windows standard för WinRM."

msgid ""
"Choose whether this account inherits the server setting or uses a specific "
"authentication method. Basic requires HTTPS."
msgstr ""
"Välj om kontot ärver serverinställningen eller använder en särskild "
"autentiseringsmetod. Basic-autentisering kräver HTTPS."

msgid "Use a WMI namespace, or enter PDH for native performance counter paths."
msgstr "Använd en WMI-namnrymd eller ange PDH för inbyggda prestandaräknarsökvägar."

msgid ""
"Enter WQL, or for PDH enter one Windows performance counter path per line."
msgstr ""
"Ange WQL eller, för PDH, en Windows-sökväg till en prestandaräknare per rad."

msgid ""
"Enter WQL, or for PDH enter one Windows performance counter path per line. "
"Broad queries can return many rows; responses are capped at 16 MiB."
msgstr ""
"Ange WQL eller, för PDH, en Windows-sökväg till en prestandaräknare per rad. "
"Breda frågor kan returnera många rader. Svaren begränsas till 16 MiB."

msgid "Last Poll"
msgstr "Senaste avläsning"

msgid "Timeouts"
msgstr "Tidsgränser"

msgid "Most Recent Error"
msgstr "Senaste fel"
