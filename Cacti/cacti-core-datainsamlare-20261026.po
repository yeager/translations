#: poller.php:405
#, php-format
msgid ""
"WARNING: %s is out of sync with the Poller Interval for Poller[%d]!  The "
"Poller Interval is %d seconds, with a maximum of a %d seconds, but %d "
"seconds have passed since the last poll!"
msgstr ""
"VARNING: %s är inte synkroniserad med insamlingsintervallet för "
"datainsamlare [%d]! Intervallet är %d sekunder, med högst %d sekunder, men "
"%d sekunder har gått sedan den senaste insamlingen!"

#: poller.php:579
#, php-format
msgid ""
"WARNING: There are %d processes detected as overrunning a polling cycle for "
"Poller[%d], please investigate."
msgstr ""
"VARNING: %d processer har upptäckts överskrida en insamlingscykel för "
"datainsamlare [%d]. Undersök orsaken."

#: poller.php:637
#, php-format
msgid ""
"WARNING: Poller Output Table not empty for Poller[%d].  Issues: %d, %s."
msgstr ""
"VARNING: Utdatatabellen är inte tom för datainsamlare [%d]. Problem: %d, %s."

#: poller.php:671
#, php-format
msgid ""
"ERROR: The spine path: %s is invalid for Poller[%d].  Poller can not "
"continue!"
msgstr ""
"FEL: Sökvägen till Spine, %s, är ogiltig för datainsamlare [%d]. "
"Datainsamlaren kan inte fortsätta!"

#: poller.php:819
#, php-format
msgid "Maximum runtime of %d seconds exceeded for Poller[%d]. Exiting."
msgstr ""
"Den maximala körtiden på %d sekunder har överskridits för datainsamlare "
"[%d]. Avslutar."
