#: syslog_dashboards.php
msgid ""
"Renaming applies to every viewer of this dashboard. Panels are managed by "
"their owners from the Syslog Dashboard tab."
msgstr ""
"Namnbytet gäller alla som visar denna instrumentpanel. Paneler hanteras av "
"sina ägare från Syslogs instrumentpanelsflik."

#: syslog_device_rules.php
msgid "Choose a future pause end date and time."
msgstr "Välj framtida datum och tid då pausen ska upphöra."

#: syslog_device_rules.php
msgid "A device name is required."
msgstr "Ett enhetsnamn krävs."

#: syslog_device_rules.php
#, php-format
msgid "Click Continue to %s the following Device Alert Rule(s)."
msgstr "Klicka på Fortsätt för att %s följande larmregel/-regler för enheter."

#: syslog_device_rules.php
msgid "Do not pass any priority"
msgstr "Släpp inte igenom någon prioritet"

#: syslog_device_rules.php
#, php-format
msgid "%s and more urgent"
msgstr "%s och mer akuta"

#: syslog_device_rules.php
msgid "Device Alert Rule"
msgstr "Larmregel för enhet"

#: syslog_device_rules.php
msgid ""
"Search current Syslog devices as you type, or enter any IP address or "
"hostname."
msgstr ""
"Sök bland aktuella Syslog-enheter medan du skriver, eller ange valfri IP-"
"adress eller värdnamn."

#: syslog_device_rules.php
msgid "Alert Handling"
msgstr "Larmhantering"

#: syslog_device_rules.php
msgid "Do not pause"
msgstr "Pausa inte"

#: syslog_device_rules.php
msgid "Pause all non-exempt alerts until a date, or indefinitely."
msgstr ""
"Pausa alla larm utan undantag till ett visst datum eller tills vidare."

#: syslog_device_rules.php
msgid "Pause indefinitely"
msgstr "Pausa tills vidare"

#: syslog_device_rules.php
msgid "Pause until"
msgstr "Pausa till"

#: syslog_device_rules.php
msgid "Local date and time, YYYY-MM-DD HH:MM."
msgstr "Lokalt datum och tid, YYYY-MM-DD HH:MM."

#: syslog_device_rules.php
msgid "Pause Ends"
msgstr "Pausen upphör"

#: syslog_device_rules.php
msgid "Always Allow Priority"
msgstr "Prioritet som alltid tillåts"

#: syslog_device_rules.php
msgid ""
"These priorities pass through this device pause and maintenance windows. "
"Critical and more urgent is a typical platinum-device choice."
msgstr ""
"Dessa prioriteter passerar igenom enhetspausen och underhållsfönstren. "
"Kritisk och mer akut är ett vanligt val för platinum-enheter."

#: syslog_device_rules.php
msgid "Allow During Maintenance"
msgstr "Tillåt under underhåll"

#: syslog_device_rules.php
msgid ""
"Allow all priorities from this device during an alert maintenance window. "
"The priority exception above still applies when this is No."
msgstr ""
"Tillåt alla prioriteter från denna enhet under ett underhållsfönster för "
"larm. Prioritetsundantaget ovan gäller fortfarande när detta är Nej."

#: syslog_device_rules.php
msgid "Device Alert Rule [edit]"
msgstr "Larmregel för enhet [redigera]"

#: syslog_device_rules.php
msgid "Device Alert Rule [new]"
msgstr "Larmregel för enhet [ny]"

#: syslog_device_rules.php
msgid "Device Alert Rule Filters"
msgstr "Filter för larmregler för enheter"

#: syslog_device_rules.php
msgid "Handling"
msgstr "Hantering"

#: syslog_device_rules.php
msgid "Maintenance"
msgstr "Underhåll"

#: syslog_device_rules.php
msgid "Pass Through"
msgstr "Släpp igenom"

#: syslog_device_rules.php
msgid "No device alert rules found."
msgstr "Inga larmregler för enheter hittades."

#: syslog_device_rules.php
msgid "Not paused"
msgstr "Inte pausad"

#: syslog_device_rules.php
msgid "Paused indefinitely"
msgstr "Pausad tills vidare"

#: syslog_device_rules.php
#, php-format
msgid "Paused until %s"
msgstr "Pausad till %s"

#: syslog_device_rules.php
msgid "and more urgent"
msgstr "och mer akuta"

#: syslog_device_rules.php
msgid "Allow all"
msgstr "Tillåt alla"

#: syslog_device_rules.php
msgid "Use priority exception"
msgstr "Använd prioritetsundantag"

#: syslog_removal.php
msgid "Removal filter conditions"
msgstr "Filtervillkor för borttagning"

#: syslog_saved_searches.php
msgid "Unable to save the template. Please try again."
msgstr "Det gick inte att spara mallen. Försök igen."

#: syslog_saved_searches.php
msgid "Enter a template name between 1 and 128 characters."
msgstr "Ange ett mallnamn med mellan 1 och 128 tecken."

#: syslog_saved_searches.php
msgid "Templates"
msgstr "Mallar"

#: syslog_saved_searches.php
msgid "Query"
msgstr "Fråga"

#: syslog_saved_searches.php
msgid ""
"No shared search templates. Save a search for all users from Syslog to "
"create one."
msgstr ""
"Inga delade sökmallar. Spara en sökning för alla användare från Syslog för "
"att skapa en."

#: syslog_saved_searches.php
msgid "Click 'Continue' to Export the following Saved Search Template(s)."
msgstr ""
"Klicka på ”Fortsätt” för att exportera följande mall(ar) för sparade "
"sökningar."

#: syslog_saved_searches.php
msgid "Click 'Continue' to Delete the following Saved Search Template(s)."
msgstr ""
"Klicka på ”Fortsätt” för att ta bort följande mall(ar) för sparade "
"sökningar."

#: syslog_saved_searches.php
msgid "Delete Saved Search Template(s)"
msgstr "Ta bort mall(ar) för sparade sökningar"

#: syslog_saved_searches.php
msgid "Export Saved Search Template(s)"
msgstr "Exportera mall(ar) för sparade sökningar"

#: syslog_saved_searches.php
#, php-format
msgid "NOTE: Imported %d and updated %d Saved Search Template(s)."
msgstr ""
"OBS: Importerade %d och uppdaterade %d mall(ar) för sparade sökningar."

#: syslog_saved_searches.php
#, php-format
msgid "ERROR: %d Saved Search Template(s) failed to import."
msgstr "FEL: %d mall(ar) för sparade sökningar kunde inte importeras."

#: syslog_saved_searches.php
msgid "Import Saved Search Template from Local File"
msgstr "Importera mall för sparad sökning från lokal fil"

#: syslog_saved_searches.php
msgid ""
"If the JSON file containing the Saved Search Template definition data is "
"located on your local machine, select it here."
msgstr ""
"Om JSON-filen som innehåller definitionsdata för mallen för sparad sökning "
"finns på din lokala dator väljer du den här."

#: syslog_saved_searches.php
msgid "Import Saved Search Template from Text"
msgstr "Importera mall för sparad sökning från text"

#: syslog_saved_searches.php
msgid ""
"If you have the JSON file containing the Saved Search Template definition "
"data as text, you can paste it into this box to import it."
msgstr ""
"Om du har JSON-filen som innehåller definitionsdata för mallen för sparad "
"sökning som text kan du klistra in den i denna ruta för att importera den."

#: syslog_saved_searches.php
msgid "Import Saved Search Template"
msgstr "Importera mall för sparad sökning"

#: syslog_saved_searches.php
msgid "Edit Saved Search Template"
msgstr "Redigera mall för sparad sökning"
