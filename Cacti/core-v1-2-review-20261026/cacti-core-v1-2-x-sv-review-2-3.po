#: lib/spikekill.php
msgid ""
"FATAL: The outlier-start and outlier-end arguments must be in the format of "
"YYYY-MM-DD HH:MM or a unix timestamp."
msgstr ""
"ALLVARLIGT: Argumenten outlier-start och outlier-end måste anges i formatet "
"ÅÅÅÅ-MM-DD HH:MM eller som en Unix-tidsstämpel."

#: lib/spikekill.php
msgid "FATAL: Number of spikes to remove must be a positive integer"
msgstr ""
"ALLVARLIGT: Antalet toppar som ska tas bort måste vara ett positivt heltal"

#: lib/spikekill.php
msgid ""
"FATAL: Outlier time range requires outlier-start and outlier-end to be "
"specified."
msgstr ""
"ALLVARLIGT: Tidsintervallet för avvikande värden kräver att outlier-start "
"och outlier-end anges."

#: lib/spikekill.php
msgid ""
"FATAL: Outlier time range requires outlier-start to be less than outlier-"
"end."
msgstr ""
"ALLVARLIGT: För tidsintervallet för avvikande värden måste outlier-start "
"vara mindre än outlier-end."

