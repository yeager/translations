#: automation_graph_rules.php graphs.php include/global_arrays.php
#: include/global_form.php
msgid "Data Query"
msgstr "Datafråga"

#: data_queries.php
#, php-format
msgid ""
"The Data Query ID [%s] that you are trying to Edit does not exist.  Please "
"run the repair_database.php CLI script to resolve this database issue."
msgstr ""
"Datafrågan med ID [%s] som du försöker redigera finns inte. Kör "
"kommandoradsskriptet repair_database.php för att åtgärda databasproblemet."

#: data_queries.php
msgid "The name of this Data Query."
msgstr "Datafrågans namn."

#: data_queries.php
msgid "The number of Graphs using this Data Query."
msgstr "Antalet grafer som använder datafrågan."

#: data_queries.php
msgid "The number of Graphs Templates using this Data Query."
msgstr "Antalet grafmallar som använder datafrågan."

#: data_queries.php
msgid ""
"The Data Input Method used to collect data for Data Sources associated with "
"this Data Query."
msgstr ""
"Datainmatningsmetoden som används för att samla in data till datakällor som "
"är kopplade till datafrågan."

#: host.php host_templates.php
msgid "Add Data Query"
msgstr "Lägg till datafråga"

#: host_templates.php
#, php-format
msgid "Data Query Name: %s"
msgstr "Datafrågans namn: %s"

#: include/global_form.php
msgid ""
"Choose the input method for this Data Query.  This input method defines how "
"data is collected for each Device associated with the Data Query."
msgstr ""
"Välj inmatningsmetod för datafrågan. Metoden anger hur data samlas in för "
"varje enhet som är kopplad till datafrågan."

#: include/global_form.php package_import.php
msgid "Replace Data Query Suggested Value Patterns"
msgstr "Ersätt datafrågans föreslagna värdemönster"

#: include/global_form.php
msgid ""
"Replace Data Source and Graph Template Suggested Value Records for Data "
"Queries.  Graphs and Data Sources will take on new names after either a Data"
" Query Reindex or by using the forced Replace Suggested Values process."
msgstr ""
"Ersätt föreslagna värden för datakällor och grafmallar för datafrågor. "
"Grafer och datakällor får nya namn när datafrågan omindexeras eller när "
"ersättning av föreslagna värden tvingas fram."

#: include/global_settings.php
msgid "Graph/Data Source/Data Query Settings"
msgstr "Inställningar för grafer, datakällor och datafrågor"

#: include/global_settings.php
msgid "The maximum Data Query field length."
msgstr "Den maximala fältlängden för datafrågor."

#: include/global_settings.php
msgid "By Template/Data Query"
msgstr "Efter mall/datafråga"

#: lib/data_query.php
#, php-format
msgid "Click to show Data Query output for field '%s'"
msgstr "Klicka för att visa datafrågans utdata för fältet ”%s”."

#: package_import.php
msgid ""
"Replace Data Source and Graph Template Suggested Value Records.  Graphs and "
"Data Sources will take on new names after either a Data Query Reindex or by "
"using the forced Replace Suggested Values process."
msgstr ""
"Ersätt föreslagna värden för datakällor och grafmallar. Grafer och "
"datakällor får nya namn när datafrågan omindexeras eller när ersättning av "
"föreslagna värden tvingas fram."
