msgstr "Kräv att nya lösenord innehåller minst ett specialtecken."

#: include/global_settings.php
msgid "Force Complexity Upon Old Passwords"
msgstr "Kräv att gamla lösenord uppfyller komplexitetskraven"

#: include/global_settings.php
