msgid "Email Sender/Receiver Details"
msgstr "Uppgifter om e-postavsändare och mottagare"

#: lib/html_reports.php
msgid "Cacti Report"
msgstr "Cacti-rapport"

#: lib/html_reports.php
msgid ""
"This value will be used as the default Email subject.  The report name will "
"be used if left blank."
msgstr ""
"Värdet används som förvalt ämne för e-post. Om fältet lämnas tomt används "
"rapportens namn."

#: lib/html_reports.php
msgid "This Name will be used as the default E-mail Sender"
msgstr "Namnet används som förvald e-postavsändare"

#: lib/html_reports.php
msgid "This Address will be used as the E-mail Senders address"
msgstr "Adressen används som e-postavsändarens adress"

#: lib/html_reports.php
msgid "Image attach type"
msgstr "Typ av bildbilaga"

#: lib/html_reports.php
msgid "Date/Time moved to the same time Tomorrow"
msgstr "Datum och tid flyttades till samma tid i morgon"

#: lib/html_reports.php
msgid "Click 'Continue' to delete the following Report(s)."
msgstr "Klicka på ”Fortsätt” för att ta bort följande rapporter."

#: lib/html_reports.php
msgid "Click 'Continue' to take ownership of the following Report(s)."
msgstr ""
"Klicka på ”Fortsätt” för att ta över ägarskapet för följande rapporter."

#: lib/html_reports.php
msgid ""
"Click 'Continue' to duplicate the following Report(s).  You may optionally "
"change the title for the new Reports"
msgstr ""
"Klicka på ”Fortsätt” för att duplicera följande rapporter. Du kan ändra "
"titeln för de nya rapporterna"

#: lib/html_reports.php
msgid "Click 'Continue' to enable the following Report(s)."
msgstr "Klicka på ”Fortsätt” för att aktivera följande rapporter."

#: lib/html_reports.php
msgid "Click 'Continue' to disable the following Reports."
msgstr "Klicka på ”Fortsätt” för att inaktivera följande rapporter."

#: lib/html_reports.php
msgid "Click 'Continue' to send the following Report(s) now."
msgstr "Klicka på ”Fortsätt” för att skicka följande rapporter nu."

#: lib/html_reports.php
#, php-format
msgid "Unable to send Report '%s'.  Please set destination e-mail addresses"
msgstr "Kunde inte skicka rapporten ”%s”. Ange mottagarnas e-postadresser"

#: lib/html_reports.php
#, php-format
msgid "Unable to send Report '%s'.  Please set an e-mail subject"
msgstr "Kunde inte skicka rapporten ”%s”. Ange ett ämne för e-postmeddelandet"

#: lib/html_reports.php
#, php-format
msgid "Unable to send Report '%s'.  Please set an e-mail From Name"
msgstr ""
"Kunde inte skicka rapporten ”%s”. Ange ett avsändarnamn för "
"e-postmeddelandet"

#: lib/html_reports.php
#, php-format
msgid "Unable to send Report '%s'.  Please set an e-mail from address"
msgstr ""
"Kunde inte skicka rapporten ”%s”. Ange en avsändaradress för "
"e-postmeddelandet"

