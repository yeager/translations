"'%d'"

#: includes/functions.php
msgid ""
"You must specify either 'High Alert Threshold' or 'Low Alert Threshold' or "
"both!"
msgstr ""
"Du måste ange antingen en övre larmtröskel eller en nedre larmtröskel, eller"
" båda!"

#: includes/functions.php
msgid ""
"Impossible threshold: 'High Warning Threshold' smaller than the 'Low Warning"
" Threshold'!"
msgstr ""
"Omöjligt tröskelvärde: den övre varningströskeln är lägre än den nedre "
"varningströskeln!"

#: includes/functions.php
msgid ""
"Impossible threshold: 'High Warning Threshold' larger than the 'High Alert "
"Threshold'!"
msgstr ""
"Omöjligt tröskelvärde: den övre varningströskeln är högre än den övre "
"larmtröskeln!"

#: includes/functions.php
msgid ""
"Impossible threshold: 'Low Alert Threshold' larger than the 'Low Warning "
"Threshold'!"
msgstr ""
"Omöjligt tröskelvärde: den nedre larmtröskeln är högre än den nedre "
"varningströskeln!"

#: includes/functions.php
msgid ""
"Impossible threshold: The Alert Trigger Count must be greater or eval to 1!"
msgstr "Omöjligt tröskelvärde: antalet larmutlösningar måste vara minst 1!"

#: includes/functions.php
msgid ""
"Impossible threshold: The Alert Trigger Count must be less than or equal to "
"the Trigger Count or eval to 1!"
msgstr ""
"Omöjligt tröskelvärde: antalet larmutlösningar måste vara högst antalet "
"utlösningar eller 1!"

#: includes/functions.php
msgid ""
"Impossible threshold: The Warning Trigger Count must be less than or equal "
"to the Trigger Count or eval to 1!"
msgstr ""
"Omöjligt tröskelvärde: antalet varningsutlösningar måste vara högst antalet "
"utlösningar eller 1!"

#: includes/functions.php
msgid ""
"Impossible threshold: 'Low Warning Threshold' smaller than the 'Low Alert "
"Threshold'!"
msgstr ""
"Omöjligt tröskelvärde: den nedre varningströskeln är lägre än den nedre "
"larmtröskeln!"

#: includes/functions.php
msgid ""
"Mailer Error: No <b>TO</b> address set!!<br>If using the <i>Test Mail</i> "
"link, please set the <b>Alert Email</b> setting."
msgstr ""
"E-postfel: ingen <b>mottagaradress</b> har angetts!<br>Om du använder länken"
" <i>Testa e-post</i> anger du inställningen <b>Larm-e-post</b>."

