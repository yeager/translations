msgstr "Välj ett tillgängligt objekt"

#: notify_lists.php
#, php-format
msgid ""
"ERROR: You can not have your Email in both the To and BCC lines. The Email "
"below is invalid!<br><br>%s"
msgstr ""
"FEL: Din e-postadress kan inte finnas på både Till- och BCC-raden. "
"E-postadressen nedan är ogiltig!<br><br>%s"

#: notify_queue.php
msgid "Attempts"
msgstr "Försök"

#: notify_queue.php
#| msgid "The number of Graphs for this Device"
msgid "The number of delivery attempts made for this notification."
msgstr "Antalet leveransförsök som har gjorts för denna avisering."

#: notify_queue.php
msgid "Next Attempt"
msgstr "Nästa försök"

#: notify_queue.php
msgid "When a failed notification is eligible for its next retry."
msgstr "När en misslyckad avisering kan försöka igen."

