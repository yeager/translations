#: setup.php
msgid "Mac Authorizations"
msgstr "Auktorisering av MAC-adresser"

#: setup.php
msgid ""
"Provide key information to help Mactrack detect the type of device.  The "
"wildcard character is the '&#42;' sign."
msgstr ""
"Ange information som hjälper Mactrack att identifiera enhetstypen. "
"Jokertecknet är ”&#42;”."

#: setup.php
msgid "SNMP v3 username for this device."
msgstr "SNMPv3-användarnamn för den här enheten."

#: setup.php
msgid "SNMP v3 password for this device."
msgstr "SNMPv3-lösenord för den här enheten."

#: setup.php
msgid "Choose the SNMPv3 Authorization Protocol."
msgstr "Välj autentiseringsprotokoll för SNMPv3."

#: setup.php
msgid "Enter the SNMP v3 Context to use for this device."
msgstr "Ange SNMPv3-kontexten som ska användas för den här enheten."

#: setup.php
msgid "Enter the SNMP v3 Engine ID to use for this device."
msgstr "Ange SNMPv3-motor-ID som ska användas för den här enheten."
