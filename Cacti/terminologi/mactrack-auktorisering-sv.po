msgid ""
"The following MAC Addresses Could not be revoked because they are members of"
" Group Authorizations %s"
msgstr ""
"Auktoriseringen av följande MAC-adresser kunde inte återkallas eftersom de "
"ingår i gruppauktoriseringarna %s"

#: mactrack_view_macs.php
msgid "Click 'Continue' to Authorize the following MAC Addresses."
msgstr "Klicka på ”Fortsätt” för att auktorisera följande MAC-adresser."

#: mactrack_view_macs.php
msgid "Click 'Continue' to Revoke the following MAC Addresses."
msgstr ""
"Klicka på ”Fortsätt” för att återkalla auktoriseringen av följande MAC-"
"adresser."
