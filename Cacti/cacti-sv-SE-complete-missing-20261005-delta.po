msgid "The following Graph is using this Data Source."
msgstr "Följande diagram använder den här datakällan."

msgid "The following Graph is using these Data Sources."
msgstr "Följande diagram använder dessa datakällor."

msgid "Leave the Graph Untouched"
msgstr "Lämna diagrammet oförändrat"

msgid "Delete all Graph Items that reference this Data Source."
msgstr "Ta bort alla diagramobjekt som refererar till den här datakällan."

msgid "Delete all Graphs that reference this Data Source."
msgstr "Ta bort alla diagram som refererar till den här datakällan."

msgid "The following Data Source is used by this Graph."
msgstr "Följande datakälla används av det här diagrammet."

msgid "The following Data Source is used by these Graphs."
msgstr "Följande datakälla används av dessa diagram."

msgid "Delete the Data Sources referenced by this Graph"
msgstr "Ta bort datakällorna som det här diagrammet refererar till"

msgid "Leave the Data Source untouched."
msgstr "Lämna datakällan oförändrad."

msgid "The following Data Source is in use by this Graph."
msgstr "Följande datakälla används av det här diagrammet."

msgid "The following Data Source is in use by these Graphs."
msgstr "Följande datakälla används av dessa diagram."

msgid "Click 'Continue' to Import the following Package."
msgstr "Klicka på ”Fortsätt” för att importera följande paket."

msgid ""
"The following Selected Package will be skipped as no Files or Template Items"
" were selected."
msgstr ""
"Följande valda paket hoppas över eftersom inga filer eller mallobjekt har "
"valts."

msgid "Import Package"
msgstr "Importera paket"

msgid "Click 'Continue' to delete the following ."
msgstr "Klicka på ”Fortsätt” för att ta bort följande."

msgid "Delete Public Key"
msgstr "Ta bort offentlig nyckel"

msgid "Delete Package Repository"
msgstr "Ta bort paketförråd"

msgid "Click 'Continue' to disable the following Package Repository."
msgstr "Klicka på ”Fortsätt” för att inaktivera följande paketförråd."

msgid "Disable Package Repository"
msgstr "Inaktivera paketförråd"

msgid "Enabled Package Repository"
msgstr "Aktiverat paketförråd"
