msgid "Must be an IP pointing to your Cacti server."
msgstr "Måste vara en IP-adress som pekar på din Cacti-server."

#: includes/arrays.php
msgid "Email Options"
msgstr "E-postalternativ"

#: includes/arrays.php
msgid "From Address"
