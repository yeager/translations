msgid "Last Backup"
msgstr "Senaste säkerhetskopiering"

#: router-devices.php
msgid "Date Backup"
msgstr "Datum för säkerhetskopiering"

#: includes/arrays.php
msgid "Default timeout"
msgstr "Standardtidsgräns"

#: includes/arrays.php
msgid "Default sleep time"
msgstr "Standardväntetid"

#: includes/arrays.php
msgid "Assume elevated"
msgstr "Anta förhöjd behörighet"

#: includes/arrays.php
msgid "Check this box to assume this device is always elevated"
msgstr "Markera rutan för att anta att den här enheten alltid har förhöjd behörighet"

#: includes/arrays.php
msgid "Check End in Config"
msgstr "Kontrollera slutet i konfigurationen"

#: includes/arrays.php
msgid "Any Key prompt"
msgstr "Prompt för valfri tangent"

