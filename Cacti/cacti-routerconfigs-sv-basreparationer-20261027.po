#: includes/arrays.php
msgid "TFTP Backup Directory Path"
msgstr "Sökväg till TFTP-katalog för säkerhetskopior"

#: includes/functions.php router-backups.php
msgid "Backups"
msgstr "Säkerhetskopior"

#: includes/functions.php
msgid "FATAL: TFTP Backup Path is not set or is not a directory"
msgstr "FATAL: Sökvägen till TFTP-säkerhetskopior har inte angetts eller är inte en katalog"

#: includes/functions.php
#, php-format
msgid "%s devices disabled from backup."
msgstr "%s enheter har inaktiverats för säkerhetskopiering."

#: includes/functions.php
msgid "ERROR: Backup Path is not set or is not a directory"
msgstr "ERROR: Sökvägen till säkerhetskopior har inte angetts eller är inte en katalog"

