msgid "You must select at least Router Device."
msgstr "Du måste välja minst en routerenhet."

#: includes/arrays.php
msgid "Close without exit"
msgstr "Stäng utan att avsluta"

#: includes/arrays.php
msgid "If ticked, when closing down the device connection, no 'exit' command is issued"
msgstr "Om detta är markerat skickas inget ”exit”-kommando när anslutningen till enheten stängs"

#: includes/arrays.php
msgid "Debug Connection Buffer"
msgstr "Felsökningsbuffert för anslutning"

