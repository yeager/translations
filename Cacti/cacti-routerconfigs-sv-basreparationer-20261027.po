msgid "Text to match a 'Press Any Key To Continue' styled prompt"
msgstr "Text som matchar en prompt i stil med ”Tryck på valfri tangent för att fortsätta”"

#: router-devices.php
msgid "You must select at least Router Device."
msgstr "Du måste välja minst en routerenhet."

#: includes/arrays.php
msgid "Close without exit"
msgstr "Stäng utan att avsluta"

#: includes/arrays.php
msgid "If ticked, when closing down the device connection, no 'exit' command is issued"
msgstr "Om detta är markerat skickas inget ”exit”-kommando när anslutningen till enheten stängs"

#: includes/arrays.php
msgid "Debug Connection Buffer"
msgstr "Felsökningsbuffert för anslutning"

#: includes/arrays.php
msgid "Whether to log direct output of device connection"
msgstr "Om direktutdata från enhetsanslutningen ska loggas"

#: includes/arrays.php
msgid "Assume all devices elevated"
msgstr "Anta att alla enheter har förhöjd behörighet"

#: includes/arrays.php
msgid "Whether to assume all devices are elevated"
msgstr "Om alla enheter ska antas ha förhöjd behörighet"

#: includes/arrays.php
msgid "Download Hour"
msgstr "Tid för nedladdning"

#: includes/arrays.php
msgid "Retry Schedule"
msgstr "Schema för nya försök"

#: includes/arrays.php
msgid "The time to wait before attempting to perform an additional download when scheduled download fails"
msgstr "Tiden att vänta innan ett nytt nedladdningsförsök görs när en schemalagd nedladdning misslyckas"

#: includes/arrays.php
msgid "Default connection type"
msgstr "Standardanslutningstyp"

#: includes/arrays.php
