msgid "Cacti Device id %s was not found; not added to RouterConfigs."
msgstr "Cacti-enheten med ID %s hittades inte och lades inte till i RouterConfigs."

#: includes/functions.php
#, php-format
msgid "Device '%s' added to RouterConfigs (disabled until an account and device type are set)."
msgstr "Enheten ”%s” lades till i RouterConfigs och är inaktiverad tills ett konto och en enhetstyp har angetts."

#: includes/functions.php
#, php-format
msgid "ERROR: Failed to connect to Device '%s' using connection type: %s"
msgstr "FEL: Det gick inte att ansluta till enheten ”%s” med anslutningstypen %s"

#: includes/functions.php
#, php-format
msgid "ERROR: Failed to download '%s' to '%s' via '%s'"
msgstr "FEL: Det gick inte att ladda ner ”%s” till ”%s” via ”%s”"

#: router-backups.php
msgid "Either an IP address, or hostname.  If a hostname, it must be resolvable by either DNS, or from your hosts file."
msgstr "Antingen en IP-adress eller ett värdnamn. Om det är ett värdnamn måste det kunna lösas med DNS eller via din värdfil."

#: router-backups.php
msgid "Perform functions against this backup"
msgstr "Utför åtgärder för den här säkerhetskopian"

