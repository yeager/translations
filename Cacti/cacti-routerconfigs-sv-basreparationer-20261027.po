msgid "The time to wait before attempting to perform an additional download when scheduled download fails"
msgstr "Tiden att vänta innan ett nytt nedladdningsförsök görs när en schemalagd nedladdning misslyckas"

#: includes/arrays.php
msgid "Default connection type"
msgstr "Standardanslutningstyp"

#: includes/arrays.php
