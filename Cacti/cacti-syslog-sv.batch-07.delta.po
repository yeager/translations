#: syslog_alerts.php
msgid "Use rule timeframe"
msgstr "Använd regelns tidsfönster"

#: syslog_alerts.php
msgid "Rule Maintenance Days"
msgstr "Dagar för regelunderhåll"

#: syslog_alerts.php
msgid "Days for this rule timeframe, when Use rule timeframe is selected."
msgstr ""
"Dagar för denna regels tidsfönster när Använd regelns tidsfönster är valt."

#: syslog_alerts.php
msgid "Rule Maintenance Starts"
msgstr "Regelunderhåll börjar"

#: syslog_alerts.php
msgid "Local start time for this rule timeframe."
msgstr "Lokal starttid för denna regels tidsfönster."

#: syslog_alerts.php
msgid "Rule Maintenance Ends"
msgstr "Regelunderhåll slutar"

#: syslog_alerts.php
msgid "Local end time for this rule timeframe."
msgstr "Lokal sluttid för denna regels tidsfönster."

#: syslog_alerts.php
msgid "One-time Rule Maintenance Starts"
msgstr "Engångsunderhåll för regel börjar"

#: syslog_alerts.php
msgid ""
"Optional local date and time to begin muting this rule. Format: YYYY-MM-DD "
"HH:MM."
msgstr ""
"Valfritt lokalt datum och tid då denna regel börjar tystas. Format: YYYY-MM-"
"DD HH:MM."

#: syslog_alerts.php
msgid "One-time Rule Maintenance Ends"
msgstr "Engångsunderhåll för regel slutar"

#: syslog_alerts.php
msgid ""
"Optional local date and time to stop muting this rule. Format: YYYY-MM-DD "
"HH:MM."
msgstr ""
"Valfritt lokalt datum och tid då denna regel slutar tystas. Format: YYYY-MM-"
"DD HH:MM."

#: syslog_alerts.php syslog_removal.php
msgid "Test rule"
msgstr "Testa regel"

#: syslog_alerts.php syslog_removal.php
msgid "Rule Test Preview"
msgstr "Förhandsgranskning av regeltest"

#: syslog_alerts.php syslog_removal.php
msgid "Value"
msgstr "Värde"

#: syslog_alerts.php syslog_removal.php
msgid "Enter a value"
msgstr "Ange ett värde"

#: syslog_alerts.php syslog_removal.php
msgid "Match"
msgstr "Matcha"

#: syslog_alerts.php syslog_removal.php
msgid "Exclude"
msgstr "Uteslut"

#: syslog_alerts.php syslog_removal.php
msgid "Enter a nonnegative integer"
msgstr "Ange ett icke-negativt heltal"

#: syslog_alerts.php
msgid "Alarm filter conditions"
msgstr "Filtervillkor för larm"

#: syslog_alerts.php syslog_dashboards.php syslog_removal.php
#: syslog_saved_searches.php
msgid ""
"Import rejected: the file is empty, invalid, or contains a different type of"
" Syslog object."
msgstr ""
"Importen avvisades: filen är tom, ogiltig eller innehåller en annan typ av "
"Syslog-objekt."

#: syslog_dashboards.php syslog_saved_searches.php
msgid "Select a valid owner."
msgstr "Välj en giltig ägare."

#: syslog_dashboards.php
msgid "Unable to save the dashboard. Please try again."
msgstr "Det gick inte att spara instrumentpanelen. Försök igen."

#: syslog_dashboards.php
msgid "Enter a dashboard name between 1 and 128 characters."
msgstr "Ange ett namn på instrumentpanelen med mellan 1 och 128 tecken."

#: syslog_dashboards.php syslog_saved_searches.php
msgid "Share with users…"
msgstr "Dela med användare…"

#: syslog_dashboards.php syslog_saved_searches.php
msgid "Share with groups…"
msgstr "Dela med grupper…"

#: syslog_dashboards.php syslog_saved_searches.php
msgid "Owner"
msgstr "Ägare"

#: syslog_dashboards.php
msgid "Shared"
msgstr "Delad"

#: syslog_dashboards.php
msgid "Panels"
msgstr "Paneler"

#: syslog_dashboards.php
msgid "deleted user"
msgstr "borttagen användare"

#: syslog_dashboards.php
msgid "No dashboards yet. Users create them from the Dashboard tab of Syslog."
msgstr ""
"Inga instrumentpaneler ännu. Användare skapar dem från fliken "
"Instrumentpanel i Syslog."

#: syslog_dashboards.php
msgid ""
"Click 'Continue' to Delete the following Dashboard(s) and all of their "
"Panels."
msgstr ""
"Klicka på ”Fortsätt” för att ta bort följande instrumentpanel(er) och alla "
"deras paneler."

#: syslog_dashboards.php
msgid "Delete Dashboard(s)"
msgstr "Ta bort instrumentpanel(er)"

#: syslog_dashboards.php
msgid "Click 'Continue' to Export the following Dashboard(s)."
msgstr "Klicka på ”Fortsätt” för att exportera följande instrumentpanel(er)."

#: syslog_dashboards.php
msgid "Export Dashboard(s)"
msgstr "Exportera instrumentpanel(er)"

#: syslog_dashboards.php
#, php-format
msgid "NOTE: Imported %d and updated %d Dashboard(s)."
msgstr "OBS: Importerade %d och uppdaterade %d instrumentpanel(er)."

#: syslog_dashboards.php
#, php-format
msgid "ERROR: %d Dashboard(s) failed to import."
msgstr "FEL: %d instrumentpanel(er) kunde inte importeras."

#: syslog_dashboards.php
msgid "Import Dashboard from Local File"
msgstr "Importera instrumentpanel från lokal fil"

#: syslog_dashboards.php
msgid ""
"If the JSON file containing the Dashboard definition data is located on your"
" local machine, select it here."
msgstr ""
"Om JSON-filen som innehåller definitionsdata för instrumentpanelen finns på "
"din lokala dator väljer du den här."

#: syslog_dashboards.php
msgid "Import Dashboard from Text"
msgstr "Importera instrumentpanel från text"

#: syslog_dashboards.php
msgid ""
"If you have the JSON file containing the Dashboard definition data as text, "
"you can paste it into this box to import it."
msgstr ""
"Om du har JSON-filen som innehåller definitionsdata för instrumentpanelen "
"som text kan du klistra in den i denna ruta för att importera den."

#: syslog_dashboards.php
msgid "Import Dashboard"
msgstr "Importera instrumentpanel"

#: syslog_dashboards.php syslog_saved_searches.php
msgid "All Users"
msgstr "Alla användare"

#: syslog_dashboards.php syslog_saved_searches.php
msgid "All Groups"
msgstr "Alla grupper"

#: syslog_dashboards.php
msgid "Edit Dashboard"
msgstr "Redigera instrumentpanel"

#: syslog_dashboards.php
msgid "The name shown in the Dashboards select of the Syslog Dashboard tab."
msgstr ""
"Namnet som visas i instrumentpanelsväljaren på Syslogs instrumentpanelsflik."

#: syslog_dashboards.php
msgid "The account that owns this dashboard and can manage its panels."
msgstr "Kontot som äger denna instrumentpanel och kan hantera dess paneler."

#: syslog_dashboards.php syslog_saved_searches.php
msgid "Shared With Users"
msgstr "Delad med användare"

#: syslog_dashboards.php
msgid ""
"Users who can view this dashboard in addition to its owner and any global "
"sharing. All Users shares it with everyone."
msgstr ""
"Användare som kan visa denna instrumentpanel utöver dess ägare och eventuell"
" global delning. Alla användare delar den med alla."

#: syslog_dashboards.php
msgid ""
"Groups who can view this dashboard in addition to its owner and any global "
"sharing. All Groups shares it with everyone."
msgstr ""
"Grupper som kan visa denna instrumentpanel utöver dess ägare och eventuell "
"global delning. Alla grupper delar den med alla."

#: syslog_dashboards.php syslog_saved_searches.php
msgid "Shared With Groups"
msgstr "Delad med grupper"
