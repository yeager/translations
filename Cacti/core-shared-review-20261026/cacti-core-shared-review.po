msgid "Purge Notification Log"
msgstr "Rensa aviseringsloggen"

#: include/global_settings.php:1573
msgid "Report Generation Timeout"
msgstr "Tidsgräns för rapportgenerering"

#: user_domains.php:396
msgid "Require Group Membership"
msgstr "Kräv gruppmedlemskap"

#: user_domains.php:397
msgid ""
"Require user to be member of group to authenticate. Group settings must be "
"set for this to work, enabling without proper group settings will cause "
"authentication failure."
msgstr ""
"Kräv att användaren är medlem i gruppen för att autentiseras. "
"Gruppinställningarna måste anges; annars misslyckas autentiseringen."

#: user_group_admin.php:66
msgid "Restrict Access"
msgstr "Begränsa åtkomst"

#: include/global_settings.php:1454
msgid "SNMP Bulkwalk Fetch Size"
msgstr "Hämtningsstorlek för SNMP Bulkwalk"

#: include/global_settings.php:1474
