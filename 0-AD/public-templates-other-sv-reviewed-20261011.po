#: simulation/data/damage_types/crush.json
msgctxt "damage type"
msgid "Damage caused by sheer force, like with a club or by trampling."
msgstr "Skada som orsakas av ren kraft, som med en klubba eller tramp."

#: simulation/data/damage_types/fire.json
msgctxt "damage type"
msgid "Fire"
msgstr "Eld"

#: simulation/data/damage_types/fire.json
msgctxt "damage type"
msgid "Damage caused by burning objects, like a torch or a flaming arrow."
msgstr ""
"Skada som orsakats av brinnande objekt, som en fackla eller en brinnande "
"pil."

#: simulation/data/damage_types/hack.json
msgctxt "damage type"
msgid "Hack"
msgstr "Hacka"

#: simulation/data/damage_types/hack.json
msgctxt "damage type"
msgid ""
"Damage caused by sharp objects cutting or chopping, like with a sword or an "
"axe."
msgstr ""
"Skada som orsakas av vassa föremål som skär eller hugger, som med ett svärd "
"eller en yxa."

#: simulation/data/damage_types/pierce.json
msgctxt "damage type"
