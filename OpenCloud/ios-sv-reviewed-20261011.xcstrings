    "Get in touch with our community in the forums - or file a GitHub issue to report a bug or request a feature.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treten Sie mit unserer Community in den Foren in Kontakt – oder erstellen Sie ein GitHub-Issue, um einen Fehler zu melden oder eine Funktion anzufordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get in touch with our community in the forums - or file a GitHub issue to report a bug or request a feature."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contactez notre communauté sur les forums, ou ouvrez une issue GitHub pour signaler un bug ou demander une fonctionnalité."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem contact op met onze community op de forums - of dien een GitHub-probleem in om een fout te melden of een functie aan te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontaktuj się z naszą społecznością na forach – lub zgłoś problem na GitHubie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delta i vår community i forumen eller skapa ett GitHub-ärende för att rapportera ett fel eller begära en funktion."
          }
        },
