          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "设备会保留最近归档的10条日志，每条最多涵盖24小时的使用情况。分享日志前，请留意其中可能含有敏感信息，例如服务器网址或特定用户的信息。"
