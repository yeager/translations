    "Search on the server is unavailable while not connected. To search offline, switch to the Account scope.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serversuche ist ohne Verbindung nicht verfügbar. Um offline zu suchen, wechseln Sie zum Kontobereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search on the server is unavailable while not connected. To search offline, switch to the Account scope."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche sur le serveur est indisponible hors connexion. Pour rechercher hors ligne, passez en mode Compte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken op de server is niet beschikbaar als er geen verbinding is. Om offline te zoeken, schakelt u over naar de Account-scope."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
