uptime-help-pretty = visa drifttid i lättläst format
uptime-output-up-text = igång
uptime-format-pretty-min = { $min ->
    [one] { $min } minut
   *[other] { $min } minuter
}
uptime-format-pretty-hour = { $hour ->
    [one] { $hour } timme
   *[other] { $hour } timmar
}
uptime-format-pretty-day = { $day ->
    [one] { $day } dag
   *[other] { $day } dagar
}
