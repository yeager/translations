env-about = Ange VALUE för varje NAME i miljön och kör COMMAND
env-usage = env [FLAGGA]... [-] [NAMN=VÄRDE]... [KOMMANDO [ARGUMENT]...]
env-after-help = Ett ensamt - innebär -i. Om inget KOMMANDO anges skrivs den resulterande miljön ut.
env-help-ignore-environment = börja med en tom miljö
env-help-chdir = ändra arbetskatalog till DIR
env-help-null = avsluta varje utdatarad med en 0 byte i stället för en radbrytning, endast giltigt när miljön skrivs ut
env-help-unset = ta bort variabel från miljön
env-help-debug = skriv ut utförlig information för varje bearbetningssteg
env-help-split-string = bearbeta och dela S i separata argument; används för att skicka flera argument på shebangrader
env-help-argv0 = Åsidosätt det nollte argumentet som skickas till kommandot som körs. Utan denna flagga används standardvärdet `command`.
env-help-ignore-signal = ange att SIG signaler inte ska hanteras
env-help-default-signal = återställ hanteringen av SIG signaler till standardåtgärden
env-help-block-signal = blockera leverans av SIG signaler medan KOMMANDO körs
env-help-list-signal-handling = lista ändringar i signalhantering som har begärts av föregående flaggor
env-error-missing-closing-quote = avslutande citattecken saknas i -S strängen vid position { $position } för citattecknet '{ $quote }'
env-error-invalid-backslash-at-end = ogiltigt omvänt snedstreck i slutet av strängen i -S vid position { $position } i sammanhanget { $context }
env-error-backslash-c-not-allowed = '\c' får inte förekomma i en -S sträng med dubbla citattecken vid position { $position }
env-error-invalid-sequence = ogiltig sekvens '\{ $char }' i -S vid position { $position }
env-error-missing-closing-brace = avslutande klammerparentes saknas vid position { $position }
env-error-missing-variable = variabelnamn saknas vid position { $position }
env-error-only-braced-variable = endast expansion av ${VARNAMN} stöds vid position { $position }
env-error-only-braced-variable-at = endast expansion av {"${VARNAMN}"} stöds, fel vid: { $rest }
env-error-unexpected-number = oväntat tecken: '{ $char }'; förväntat variabelnamn får inte börja med 0 till 9 vid position { $position }
env-error-cannot-specify-null-with-command = kan inte ange --null (-0) med kommando
env-error-invalid-signal = { $signal }: ogiltig signal
env-error-generic = fel: { $error }
env-error-no-such-file = { $program }: filen eller katalogen finns inte
env-error-use-s-shebang = använd -[v]S för att skicka flaggor i shebangrader
env-error-cannot-unset = kan inte ta bort '{ $name }': ogiltigt argument
env-error-cannot-unset-invalid = kan inte ta bort { $name }: ogiltigt argument
env-error-must-specify-command-with-chdir = måste ange kommando med --chdir (-C)
env-error-cannot-change-directory = kan inte byta katalog till { $directory }: { $error }
env-error-argv0-not-supported = --argv0 stöds för närvarande inte på denna plattform
env-error-failed-set-signal-action = kunde inte ange signalåtgärd för signalen { $signal }: { $error }
env-warning-no-name-specified = inget namn har angetts för värdet { $value }
env-diag-label-variable-digit = ett variabelnamn får inte börja med en siffra
env-diag-label-missing-brace = denna {"{"} stängs aldrig
env-diag-help-quoting = -S citerar som skalet: ' och " hör ihop parvis, och \' skyddar ett citattecken
env-diag-help-backslash = ett omvänt snedstreck skyddar nästa tecken, så det kan inte avsluta strängen
env-diag-help-backslash-c = \c avslutar -S strängen och saknar betydelse i dubbla citattecken
env-diag-help-escape = -S förstår \r, \n, \t, \f, \v, \_, \#, \$, \" och \c
env-diag-help-variable = endast $NAME och ${"{"}NAME{"}"} expanderas; övriga skalformer stöds inte
