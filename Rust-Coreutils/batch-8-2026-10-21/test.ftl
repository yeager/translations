test-diag-label-unary-operator-expected = detta behöver ett uttryck på båda sidor
test-diag-help-integer-op = -eq, -ne, -lt, -le, -gt och -ge jämför heltal. Använd =, { "!" }=, { "<" } eller { ">" } för att jämföra strängar
test-diag-help-unknown-operator = kör '{ $name } --help' för listan över operatörer som stöds
test-diag-help-integer-op-mnemonics = -eq lika med, -ne inte lika med, -lt mindre än, -le mindre än eller lika med, -gt större än, -ge större än eller lika med
test-diag-help-file-descriptor = -t tar ett filbeskrivarnummer: 0 är standardindata, 1 standardutdata, 2 standardfel
test-diag-help-missing-argument = en odefinierad eller tom variabel expanderar till ingenting och lämnar operatören utan operand. Citera den som "$var"
test-diag-help-extra-argument = en ociterad variabel som expanderar till flera ord är den vanliga orsaken. Citera den som "$var" för att behålla den som en operand
test-error-binary-operator-expected = { $operator }: binär operator förväntades
test-error-expected-found = { $expected } förväntades, hittade { $found }
test-error-does-not-accept-length = { $operator } accepterar inte -l
