dd-standard-input = 'standardindata'
dd-standard-output = 'standardutdata'
dd-error-failed-discard-cache = kunde inte tömma cacheminnet för: { $file }
dd-diag-help-operand = en operand är NYCKEL=VÄRDE, som i if=file bs=4k count=10
dd-diag-help-status = status= är none, noxfer eller progress
dd-diag-help-number = ett tal kan följas av en multiplikator: c, w, b, sedan K, M, G och så vidare för 1024, eller kB, MB, GB för 1000
dd-error-invalid-output-flag = ogiltig utdataflagga: '{ $flag }'
dd-diag-label-conv = inte en känd konvertering
dd-diag-label-iflag = inte en känd indataflagga
dd-diag-label-oflag = inte en känd utdataflagga
dd-diag-help-conv = conv= är ascii, ebcdic, ibm, lcase, ucase, block, unblock, swab, sync, noerror, sparse, excl, nocreat, notrunc, fdatasync eller fsync
dd-diag-help-iflag = iflag= är direct, directory, dsync, sync, nocache, nonblock, noatime, noctty, nofollow, fullblock, count_bytes eller skip_bytes
dd-diag-help-oflag = oflag= är direct, directory, dsync, sync, nocache, nonblock, noatime, noctty, nofollow, append eller seek_bytes
dd-error-failed-to-truncate = kunde inte trunkera till { $size } byte i utdatafilen { $file }
