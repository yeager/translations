csplit-diag-help-pattern = ett mönster är ett radnummer N, /REGUTTR/[FÖRSKJUTNING] eller %REGUTTR%[FÖRSKJUTNING], som var och en valfritt följs av { "{" }N{ "}" } eller { "{" }*{ "}" }
csplit-diag-help-line-number = radnummer börjar på 1 och får inte minska från ett mönster till nästa
csplit-diag-help-digits = --digits tar ett decimalt antal siffror, som i -n 3
csplit-diag-help-suffix-format = ett suffixformat är en printf-konvertering för ett heltal utan tecken, som i %03u
