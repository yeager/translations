#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "join-about"
msgid ""
"For each pair of input lines with identical join fields, write a line to\n"
"standard output. The default join field is the first, delimited by blanks.\n"
"\n"
"When FILE1 or FILE2 (not both) is -, read standard input."
msgstr ""
"För varje par av inmatningsrader med identiska sammanfogningsfält skrivs en rad till standardutdata.\n"
"Standardfältet för sammanfogning är det första och avgränsas med mellanslag.\n"
"\n"
"När FILE1 eller FILE2, men inte båda, är - läses standardindata."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "join-help-v"
msgid "like -a FILENUM, but suppress joined output lines"
msgstr "som -a FILENUM, men skriv inte ut sammanfogade rader"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "join-help-1"
msgid "join on this FIELD of file 1"
msgstr "sammanfoga utifrån detta FIELD i fil 1"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "join-help-2"
msgid "join on this FIELD of file 2"
msgstr "sammanfoga utifrån detta FIELD i fil 2"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "join-help-check-order"
msgid ""
"check that the input is correctly sorted, even if all input lines are "
"pairable"
msgstr ""
"kontrollera att inmatningen är korrekt sorterad, även om alla "
"inmatningsrader kan sammanfogas"

