    {
      "id": 199029343,
      "source": [
        "Returning = added or consumed a bottle on 2 or more separate calendar days, counted over the whole history rather than a recent window. Adding fifty bottles in one sitting is one day, not fifty."
      ],
      "target": [
        "Återvändande = har lagt till eller förbrukat en flaska under minst 2 separata kalenderdagar, räknat över hela historiken i stället för ett nyligt tidsfönster. Att lägga till femtio flaskor vid samma tillfälle är en dag, inte femtio."
      ],
      "state": 20,
      "context": "adminStats.retentionNote"
    },
