    {
      "id": 200480781,
      "source": [
        "Merge this entry into another — every wine is re-pointed and the old name becomes a synonym"
      ],
      "target": [
        "Slå ihop denna post med en annan — varje vin pekas om och det gamla namnet blir en synonym"
      ],
      "state": 20,
      "context": "admin.taxonomy.mergeTitle"
