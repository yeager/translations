msgctxt "extensions.notification_content.error_state.hide_details"
msgid "Hide details"
msgstr "Dölj detaljer"

msgctxt "extensions.notification_content.error_state.message"
msgid ""
"The stream or file could not be loaded. Check that it is reachable and try "
"again."
msgstr ""
"Det gick inte att läsa in strömmen eller filen. Kontrollera att den går att "
"nå och försök igen."

msgctxt "extensions.notification_content.error_state.retry"
msgid "Try again"
msgstr "Försök igen"

msgctxt "extensions.notification_content.error_state.show_details"
msgid "Show details"
msgstr "Visa detaljer"

msgctxt "extensions.notification_content.error_state.title"
msgid "Media unavailable"
msgstr "Mediet är inte tillgängligt"

msgctxt "settings_sensors.health.metric.move_goal.footer"
msgid ""
"Reported in kilocalories, so this stays unavailable while the Move ring is "
"set to move time."
msgstr ""
"Rapporteras i kilokalorier och är därför inte tillgängligt så länge "
"Rörelseringen är inställd på rörelsetid."

msgctxt "settings_sensors.sensors.requires_apple_watch.accessibility_label"
msgid "Only reports with a paired Apple Watch"
msgstr "Rapporterar bara om en Apple Watch är parkopplad"

msgctxt "settings_sensors.sensors.requires_apple_watch.badge"
msgid "Requires Apple Watch"
msgstr "Kräver Apple Watch"
