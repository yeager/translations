msgstr "Fil saknas"

msgid ""
"Remote playback requires a Remote Watch Pass or Plex Pass. Visit "
"plex.tv/plans to purchase one."
msgstr ""
"Fjärruppspelning kräver ett Remote Watch Pass eller Plex Pass. Besök "
"plex.tv/plans för att köpa ett."

msgid ""
"This app does not allow this item to be direct played. Check your settings "
"and try again."
msgstr ""
"Denna app tillåter inte direktuppspelning för objekt. Kontrollera dina "
"inställningar och försök igen."

msgid "Not enough bandwidth for direct play of this item."
msgstr ""
"Inte tillräckligt med bandbredd för direktuppspelning av detta objekt."

msgid "CPU is not powerful enough to convert this item."
msgstr "CPU är inte tillräckligt kraftfull för att konvertera detta objekt."

msgid "Not enough disk space to convert this item."
msgstr "Inte tillräckligt med diskutrymme för att konvertera objektet."

msgid "Not enough CPU power to convert this item."
msgstr "Inte tillräckligt med processorkraft för att konvertera objektet."

msgid "Not enough memory to convert this item."
msgstr "Inte tillräckligt med internminne för att konvertera objektet."

msgid "Not enough bandwidth for requested quality."
msgstr "Inte tillräckligt med bandbredd för vald kvalité."

msgid ""
"This app does not allow item to be converted for playback. Check your "
"settings and try again."
msgstr ""
"Denna app tillåter inte objekt att konverteras för uppspelning. Kontrollera "
"dina inställningar och försök igen."

msgid "Conversion failed. The transcoder exited due to an error."
msgstr ""
"Konverteringen misslyckades. Transcoderen lämnade på grund av ett fel."

msgid "Conversion encoder or decoder not found."
msgstr "Konverteringskodare eller avkodare kunde inte hittas."

msgid "Conversion failed. The transcoder process crashed."
msgstr "Konverteringen misslyckades. Transcoderprocessen kraschade."

msgid "Conversion failed. The transcoder failed to start up."
msgstr ""
"Konverteringen misslyckades. Transcoderen misslyckades med att starta upp."

msgid ""
"The server has reached its configured limit for maximum simultaneous video "
"transcodes."
msgstr ""
"Servern har nått den konfigurerade gränsen för högsta antal samtidiga "
"videoomkodningar."

msgid "This app cannot play this item. The reason is: {1}."
msgstr "Denna app kan inte spela detta objekt. Anledningen är: {1}."

msgid ""
"Not enough bandwidth for any playback of this item. Required bandwidth is "
"not known and only {1}kbps is available."
msgstr ""
"Det finns inte tillräckligt med bandbredd för uppspelning av det här "
"objektet. Nödvändig bandbredd är inte känd och endast {1}kbps är "
"tillgänglig."

msgid ""
"Not enough bandwidth for any playback of this item. Required bandwidth is "
"{1}kbps and only {2}kbps is available."
msgstr ""
"Inte tillräckligt med bandbredd för att spela upp detta objekt. Det krävs "
"minst {1}kbps och endast {2}kbps bandbredd är tillgänglig."

msgid ""
"Not enough bandwidth for any playback of this item. Required minimum "
"bandwidth is {1}kbps and only {2}kbps is available."
msgstr ""
"Inte tillräckligt med bandbredd för att spela upp detta objekt. Det krävs "
"minst {1}kbps och endast {2}kbps bandbredd är tillgänglig."

msgid "File is unplayable. Codec is unavailable for analysis."
msgstr "Filen är korrupt. Codec är otillgänglig för analys."

msgid ""
"\"{1}\" asked to stop your playback from this server. The device might be "
"busy, restarting, or under maintenance. Try again in a few minutes."
msgstr ""
"\"{1}\" bad om att stoppa din uppspelning från den här servern. Enheten kan "
"vara upptagen, under omstart eller underhålls. Försök igen om några minuter."

msgid "\"{1}\" asked to stop your playback from this server: {2}"
msgstr "\"{1}\" vill gärna att du slutar strömma från servern : {2}"

msgid "File contains DRM"
msgstr "Filen innehåller DRM"

msgid ""
"Cannot direct play this item. Required bandwidth is not known and only "
"{2}kbps is available."
msgstr ""
"Det finns inte tillräckligt med bandbredd för direktuppspelning av detta "
"objekt. Nödvändig bandbredd inte är känd och endast {2}kbps är tillgängligt."

msgid ""
"Not enough bandwidth for direct play of this item. Required bandwidth is "
"{1}kbps and only {2}kbps is available."
msgstr ""
"Det finns inte tillräckligt med bandbredd för att spela upp detta objekt. "
"Det krävs minst {1}kbps och endast {2}kbps bandbredd är tillgängligt."

msgid "App cannot direct play this item. Direct play is disabled."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Direktuppspelning är"
" inaktiverat."

msgid ""
"App cannot direct play this item. Container is unavailable for analysis."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Behållaren är inte "
"tillgänglig för analys."

msgid ""
"App cannot direct play this item. Multi-part media requires a conversion "
"when all parts are selected."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Flerdelad media "
"kräver en konvertering när alla delar är valda."

msgid ""
"App cannot direct play this item. Media must be converted in order to use "
"the {1} protocol."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Media måste vara "
"konverterat för att använda {1}-protokollet."

msgid ""
"App cannot direct play this item. No direct play music profile exists for "
"protocol {1}, with container {2} using codec {3}."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Det finns ingen "
"musikprofil för protokoll {1}, men behållaren {2} som använder codec {3}."

msgid ""
"App cannot direct play this item. No direct play photo profile exists for "
"{1}."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Ingen profil för "
"direktuppspelning av foto finns för {1}."

msgid "App cannot direct play this item. Boost Dialog is enabled."
msgstr ""
"Appen kan inte direktspela upp det här objektet. Förstärk dialog är "
"aktiverat."

msgid "App cannot direct play this item. Normalize Loudness is enabled."
msgstr ""
"Appen kan inte direktspela upp det här objektet. Normalisera ljudstyrka är "
"aktiverat."

msgid ""
"App cannot direct play this item. Boost Dialog and Normalize Loudness are "
"enabled."
msgstr ""
"Appen kan inte direktspela upp det här objektet. Förstärk dialog och "
"Normalisera ljudstyrka är aktiverade."

msgid ""
"App cannot direct play this item. Unknown audio Enhancement is enabled."
msgstr ""
"Appen kan inte direktspela upp det här objektet. En okänd ljudförbättring är"
" aktiverad."

msgid ""
"App cannot direct play this item. Non-selected embedded subtitle stream {1} "
"cannot be direct-played."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Icke-vald inbäddad "
"undertextström {1} kan inte direktuppspelas."

msgid ""
"App cannot direct play this item. Item requires conversion of selected "
"subtitle stream."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Objektet kräver en "
"konvertering av den valda undertextströmmen. "

msgid ""
"App cannot direct play this item. No direct play video profile exists for "
"protocol {1}, with container {2}, using video codec {3}, audio codec {4}, "
"and subtitle codec {5}."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Det finns ingen "
"videoprofil med direktuppspelning för protokoll {1}, med behållaren {2} som "
"använder videocodec {3}, ljudcodec {4} och undertextcodec {5}."

msgid ""
"App cannot direct play this item. Selected embedded subtitle stream is not "
"the first embedded subtitle stream."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Vald inbäddad "
"textningsström är inte den första inbäddade textningströmen."

msgid ""
"App cannot direct play this item. Selected embedded subtitle stream must be "
"extracted to sidecar."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Den valda inbäddade "
"textningströmen måste extraheras till sidovagn."

msgid ""
"App cannot direct play this item. Selected sidecar subtitle stream cannot be"
" direct played."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Den valda sidruta-"
"textströmmen kan inte spelas direkt."

msgid ""
"App cannot direct play this item. Selected sidecar subtitle stream must be "
"segmented."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Den valda sidruta-"
"textströmmen måste segmenteras."

msgid ""
"App cannot direct play this item. Selected sidecar subtitle stream must be "
"embedded."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Den valda "
"textströmmen måste vara inbäddad."

msgid ""
"App cannot direct play this item. Selected audio stream is not the first "
"audio stream and app cannot select audio streams in direct play."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Vald ljudström är "
"inte den första ljudströmmen och appen kan inte välja ljudflöden i "
"direktuppspelning."

msgid ""
"App cannot direct play this item. Embedded subtitles must be removed for "
"direct play."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. Inbäddade "
"undertexter måste raderas för direktspelning."

msgid ""
"App cannot direct play this item. App requested burned subtitles and "
"conversion of video is required to burn subtitles."
msgstr ""
"App kan inte utföra direktuppspelning för detta objekt. App begärde inbränd "
"textning och omvandling av video krävs för att bränna undertexter."

msgid ""
"App cannot direct play this item. No direct play video profile exists for "
"protocol {1}, with container {2}, and video codec {3}."
msgstr ""
"App kan inte direkt spela detta objekt. Ingen direktspelningsprofil finns "
"för protokollet {1}, med behållare {2} och videocodec {3}."

msgid ""
"App cannot direct play this item. No direct play video profile exists for "
"protocol {1}, with container {2}, video codec {3}, and audio codec {4}."
msgstr ""
"App kan inte direkt spela detta objekt. Ingen direktspelningsprofil finns "
"för protokollet {1}, med behållare {2}, videocodec {3} och ljudkodec {4}."

msgid "Not enough CPU for conversion of this item."
msgstr "Inte tillräckligt med processorkraft för att konvertera objektet."

msgid ""
"Not enough bandwidth for any playback of this item. Cannot convert to below "
"minimum bandwidth of {1}kbps."
msgstr ""
"Inte tillräckligt med bandbredd för någon uppspelning av det här objektet. "
"Kan inte konvertera till en minsta bandbredd på {1} kbps."

msgid ""
"Not enough bandwidth for any playback of this item. Cannot reduce quality "
"down to target bandwidth of {1}kbps."
msgstr ""
"Inte tillräckligt med bandbredd för någon uppspelning av det här objektet. "
"Kan inte sänka kvaliteten till målbandbredd på {1} kbps."

msgid ""
"Cannot convert this item. No conversion audio and video encoders could be "
"found in app profile."
msgstr ""
"Kan inte konvertera det här objektet. Inga konverterings- ljud- och "
"videokodare kunde hittas i profilen."

msgid "Recording failed. Please check your tuner or antenna."
msgstr "Inspelnings misslyckad. Var vänlig kontrollera din antenn."

msgid ""
"This item cannot be played at this time. The server has reached its "
"configured limit for maximum simultaneous video transcodes."
msgstr ""
"Det här objektet kan inte spelas upp just nu. Servern har nått den "
"konfigurerade gränsen för högsta antal samtidiga videoomkodningar."

msgid ""
"Cannot convert this item. No conversion profile found for protocol {1}."
msgstr ""
"Kan inte konvertera detta objekt. Ingen profil hittades för protokoll {1}."

msgid ""
"Conversion failed. A required codec could not be found or failed to install."
msgstr ""
"Konverteringen misslyckades. En begärd codec kunde inte hittas eller "
"misslyckades att installeras."

msgid "Cannot convert this item. Implementation for {1} {2} '{3}' not found."
msgstr ""
"Kan inte konvertera det här objektet. Implementering för {1} {2} '{3}' "
"hittades inte."

