msgid "Not enough bandwidth for any playback of this item."
msgstr "Inte tillräckligt med bandbredd för att spela upp detta objekt."

msgid ""
"Number of allowed streams has been reached. Stop a playback or ask admin for"
" more permissions."
msgstr ""
"Antal tillåtna strömmar har uppnåtts. Stoppa en uppspelning eller fråga "
"administratören om mer behörighet."

msgid "File is unplayable."
msgstr "Filen är korrupt."

