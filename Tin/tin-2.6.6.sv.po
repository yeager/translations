#: src/lang.c:1547
msgid ""
"# Changing colors of several screen parts\n"
"# Possible values are:\n"
"#  -1 = default (white for foreground and black for background)\n"
"#   0 = black\n"
"#   1 = red\n"
"#   2 = green\n"
"#   3 = brown\n"
"#   4 = blue\n"
"#   5 = pink\n"
"#   6 = cyan\n"
"#   7 = white\n"
"# These are *only* for foreground:\n"
"#   8 = gray\n"
"#   9 = light red\n"
"#  10 = light green\n"
"#  11 = yellow\n"
"#  12 = light blue\n"
"#  13 = light pink\n"
"#  14 = light cyan\n"
"#  15 = light white\n"
"\n"
msgstr ""
"# Ändra färger på flera skärmdelar\n"
"# Möjliga värden är:\n"
"# -1 = standard (vit för förgrund och svart för bakgrund)\n"
"# 0 = svart\n"
"# 1 = röd\n"
"# 2 = grön\n"
"# 3 = brun\n"
"# 4 = blå\n"
"# 5 = rosa\n"
"# 6 = cyan\n"
"# 7 = vit\n"
"# Dessa är *endast* för förgrunden:\n"
"# 8 = grå\n"
"# 9 = ljusröd\n"
"# 10 = ljusgrön\n"
"# 11 = gul\n"
"# 12 = ljusblå\n"
"# 13 = ljusrosa\n"
"# 14 = ljus cyan\n"
"# 15 = ljus vit\n"
"\n"

