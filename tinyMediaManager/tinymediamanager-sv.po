#. MOVIES
#. ###################################
#. Scraper hints. Since scraper will be loaded dynamically, the texts resist here for now
#, auto-java-messageformat
msgctxt "scraper.tmdb.hint"
msgid ""
"<html><h3>The Movie Database (TMDB)</h3><br />The largest free movie "
"database maintained by the community. It provides metadata and artwork in "
"many different languages.<br /><br />Available languages: Multiple.</html>"
msgstr ""
"<html><h3>The Movie Database (TMDB)</h3><br />Den största fria filmdatabasen "
"som sköts av en community. Den tillhandahåller metadata och bilder på många "
"olika språk.<br /><br />Tillgängliga språk: flera.</html>"

#, auto-java-messageformat
msgctxt "scraper.imdb.hint"
msgid ""
"<html><h3>Internet Movie Database (IMDb)</h3><br />The most used database "
"for movies all over the world. Does not contain plot/title/tagline in every "
"language.<br /><br />Available languages: Multiple</html>"
msgstr ""
"<html><h3>Internet Movie Database (IMDb)</h3><br />Världens mest använda "
"databas för filmer. Innehåller inte handling, titel eller slogan på alla "
"språk.<br /><br />Tillgängliga språk: flera</html>"

#, auto-java-messageformat
msgctxt "scraper.ofdb.hint"
msgid ""
"<html><h3>Online Filmdatenbank (OFDb)</h3><br />A German movie database "
"driven by the community.<br /><br />Available languages: DE</html>"
msgstr ""
"<html><h3>Online Filmdatenbank (OFDb)</h3><br />En tysk filmdatabas, drivs "
"av en gemenskap.<br /><br />Språk: DE</html>"

#, auto-java-messageformat
msgctxt "scraper.zelluloid.hint"
msgid ""
"<html><h3>Zelluloid.de</h3><br />A German movie database.<br /><br />"
"Available languages: DE</html>"
msgstr ""
"<html><h3>Zelluloid.de</h3><br />En tysk filmdatabas.<br /><br />Språk: DE</"
"html>"

#, auto-java-messageformat
msgctxt "scraper.moviemeter.hint"
msgid ""
"<html><h3>Moviemeter.nl</h3><br />A Dutch movie database.<br /><br />"
"Available languages: NL</html>"
msgstr ""
"<html><h3>Moviemeter.nl</h3><br />En holländsk filmdatabas.<br /><br />"
"Språk: NL</html>"

#, auto-java-messageformat
msgctxt "scraper.rottentomatoes.hint"
msgid ""
"<html><h3>Rotten Tomatoes</h3><br />An American movie database.<br />Does "
"not provide plot for older movies via the API.<br /><br />Available "
"languages: EN</html>"
msgstr ""
"<html><h3>Rotten Tomatoes</h3><br />En amerikansk filmdatabas. <br />"
"Handlingen för äldre filmer är inte tillgänglig via API.<br /><br />Språk: "
"EN</html>"

#, auto-java-messageformat
msgctxt "scraper.omdbapi.hint"
msgid ""
"<html><h3>Omdbapi.com</h3><br />The OMDb API is a RESTful web service to "
"obtain movie information. All content and images on the site are contributed "
"and maintained by our users. <br /><br />TinyMediaManager offers limited "
"access to OMDb (10 calls per 15 seconds). If you want to use OMDb with more "
"than this restricted access, you should become a patron of OMDb (https://"
"www.patreon.com/join/omdb).<br /><br />Available languages: EN</html>"
msgstr ""
"<html><h3>Omdbapi.com</h3><br />OMDb API är en RESTful webbtjänst för att "
"hämta filminformation. Allt innehåll och alla bilder på webbplatsen "
"tillhandahålls och underhålls av våra användare.<br /><br />tinyMediaManager "
"erbjuder begränsad åtkomst till OMDb (10 anrop per 15 sekunder). Om du vill "
"använda OMDb med mer än denna begränsade åtkomst bör du bli OMDb-patron "
"(https://www.patreon.com/join/omdb).<br /><br />Tillgängliga språk: "
"engelska</html>"

#, auto-java-messageformat
msgctxt "scraper.trakt.hint"
msgid ""
"<html><h3>Trakt.tv</h3><br />Trakt.tv is a platform that does many things, "
"but primarily keeps track of TV shows and movies you watch. It also provides "
"metadata for movies and TV shows.<br /><br />Available languages: EN</html>"
msgstr ""
"<html> <h3>Trakt.tv</h3><br />Trakt.tv är en plattform som gör många saker, "
"men främst håller reda på tv-serier och filmer du tittar på. Det ger också "
"metadata för filmer och TV-serier. <br /> <br />Tillgängliga språk: EN</html>"

#, auto-java-messageformat
msgctxt "scraper.universal_movie.hint"
msgid ""
"<html><h3>Universal movie scraper</h3><br />A meta scraper which allows to "
"collect and combine data from other scrapers.<br /><br />To make this "
"scraper work, you need to specify <b>at least</b> which scraper should be "
"used for searching. After that you can choose which scraper should be used "
"for every supported metadata field. <b>You need to set up all used scrapers "
"individually.</b></html>"
msgstr ""
"<html><h3>Universell filmskrapa</h3><br />En metaskrapa som gör det möjligt "
"att samla in data från olika skrapor.<br /><br />För att få denna skrapa att "
"fungera måste du ange <b>åtminstone</b> vilken skrapa som ska användas för "
"att söka. Därefter kan du välja vilken skrapa som ska användas för varje "
"metadatafält som stöds.<b>Du måste konfigurera alla skrapor individuellt som "
"ska användas.</b></html>"

#, auto-java-messageformat
msgctxt "scraper.universal_tvshow.hint"
msgid ""
"<html><h3>Universal TV show scraper</h3><br />A meta scraper which allows to "
"collect and combine data from other scrapers.<br /><br />To make this "
"scraper work, you need to specify <b>at least</b> which scraper should be "
"used for searching. After that you can choose which scraper should be used "
"for every supported metadata field. <b>You need to set up all used scrapers "
"individually.</b></html>"
msgstr ""
"<html><h3>Universell tv-serieskrapa</h3><br />En metaskrapa som gör det "
"möjligt att samla in och kombinera data från övriga skrapor.<br /><br />För "
"att få denna skrapa att fungera måste du ange <b>åtminstone</b> vilken "
"skrapa ska användas för att söka. Efter det kan du välja vilken skrapa som "
"ska användas för varje metadatafält som stöds.<b>Du måste konfigurera alla "
"skrapor individuellt som ska användas.</b></html>"

#, auto-java-messageformat
msgctxt "scraper.mpdbtv.hint"
msgid ""
"<html><h3>MPDb.TV</h3><br />MPDb.TV is a private metadata provider for "
"French-speaking users - you may need to become a member there to use this "
"service (more infos at http://www.mpdb.tv/)<br /><br />Available languages: "
"FR</html>"
msgstr ""
"<html> <h3>MPDb.TV</h3><br />MPDb.TV är en privat metadataleverantör för "
"fransktalande användare - du kan behöva bli medlem där för att använda den "
"här tjänsten (mer information på http://www.mpdb.tv/)<br /><br />"
"Tillgängliga språk: FR</html>"

#. TVSHOWS
#, auto-java-messageformat
msgctxt "scraper.anidb.hint"
msgid ""
"<html><h3>aniDB</h3><br />AniDB stands for Anime DataBase. AniDB is a non-"
"profit anime database that is open freely to the public.</html>"
msgstr ""
"<html> <h3>aniDB</h3><br />AniDB står för Anime DataBase. AniDB är en ideell "
"anime-databas som är öppen fritt för allmänheten. </html>"

#, auto-java-messageformat
msgctxt "scraper.tvdb.hint"
msgid ""
"<html><h3>TheTVDB</h3><br />An open database for television fans. This "
"scraper is able to scrape TV series metadata and artwork</html>"
msgstr ""
"<html><h3>TheTVDB</h3><br />En öppen databas för tv-fans. Denna skrapa kan "
"skrapa metadata och bilder för tv-serier</html>"

#. ARTWORK
#, auto-java-messageformat
msgctxt "scraper.animated.hint"
msgid ""
"<html><h3>Animated Movie Posters</h3><br />as seen on http://forum.kodi.tv/"
"showthread.php?tid=215727 :)</html>"
msgstr ""
"<html><h3>Animerade filmaffischer</h3><br />som kan ses på http://"
"forum.kodi.tv/showthread.php?tid=215727 :)</html>"

#, auto-java-messageformat
msgctxt "scraper.fanarttv.hint"
msgid ""
"<html><h3>Fanart.tv</h3><br />Fanart.tv provides a huge library of artwork "
"for movies, TV shows and music. This service can be consumed with the API "
"key tinyMediaManager offers, but if you want to have faster access to the "
"artwork, you should become a VIP at fanart.tv (https://fanart.tv/vip/).</"
"html>"
msgstr ""
"<html> <h3>Fanart.tv</h3><br />Fanart.tv ger ett enormt bibliotek med bilder "
"för filmer, tv-serier samt musik. Denna tjänst kan användas med API-nyckeln "
"som tinyMediaManager erbjuder, men om du vill ha snabbare tillgång till "
"bilder bör du bli VIP på fanart.tv (https://fanart.tv/vip/). </html>"

