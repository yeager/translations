+bool IsSwedishLocale() {
+    const char *locale = std::getenv("LC_ALL");
+    if (locale == nullptr || *locale == '\0') {
+        locale = std::getenv("LC_MESSAGES");
+    }
+    if (locale == nullptr || *locale == '\0') {
+        locale = std::getenv("LANG");
+    }
+    return locale != nullptr && std::string_view{locale}.starts_with("sv");
+}
