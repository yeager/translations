msgstr "DuoAgentsPlatform|Något gick fel när arbetsobjektets statusar hämtades. Försök igen."

msgid "DuoAgentsPlatform|Status changed to %{statusNames}"
msgstr "DuoAgentsPlatform|Status ändrades till %{statusNames}"

msgid "DuoSlack|%{count} more actions are not shown here."
msgstr "DuoSlack|%{count} ytterligare åtgärder visas inte här."

msgid "DuoSlack|Approve and continue"
msgstr "DuoSlack|Godkänn och fortsätt"

msgid "DuoSlack|Close"
msgstr "DuoSlack|Stäng"

