msgid "Feature flag %{name}"
msgstr "Funktionsflagga %{name}"

#. Crowdin string ID: 494776
msgid "MergeRequestSavedViews|You can create a maximum of %{limit} saved views."
msgstr "MergeRequestSavedViews|Du kan skapa högst %{limit} sparade vyer."

#. Crowdin string ID: 494778
msgid "ProjectsNew|Project slug can only contain letters, digits, underscores, periods, and dashes."
msgstr "ProjectsNew|Projekt-sluggen får endast innehålla bokstäver, siffror, understreck, punkter och bindestreck."

#. Crowdin string ID: 494780
msgid "ProjectsNew|Project slug must end with a letter or digit."
msgstr "ProjectsNew|Projekt-sluggen måste sluta med en bokstav eller siffra."

#. Crowdin string ID: 494782
msgid "ProjectsNew|Project slug must not contain consecutive underscores, periods, or dashes."
msgstr "ProjectsNew|Projekt-sluggen får inte innehålla flera understreck, punkter eller bindestreck i följd."

#. Crowdin string ID: 494784
msgid "ProjectsNew|Project slug must not end with `.git` or `.atom`."
msgstr "ProjectsNew|Projekt-sluggen får inte sluta med `.git` eller `.atom`."

#. Crowdin string ID: 494786
msgid "ProjectsNew|Project slug must start with a letter or digit."
msgstr "ProjectsNew|Projekt-sluggen måste börja med en bokstav eller siffra."

#. Crowdin string ID: 494788
msgid "SecurityReports|Ask a group Owner to turn it on."
msgstr "SecurityReports|Be en gruppägare att aktivera det."

#. Crowdin string ID: 494790
msgid "SecurityReports|Enable False Positive Detection on at least 1 project in this group."
msgstr "SecurityReports|Aktivera identifiering av falska positiva för minst ett projekt i gruppen."

#. Crowdin string ID: 494792
msgid "SecurityReports|Enable Vulnerability Resolution on at least 1 project in this group."
msgstr "SecurityReports|Aktivera sårbarhetsåtgärd för minst ett projekt i gruppen."
