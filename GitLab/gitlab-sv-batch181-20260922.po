msgid ""
msgstr "Language: sv\n"

msgid "Approve a pending member"
msgstr "Godkänn en väntande medlem"

msgid "Approve %d pending members"
msgstr "Godkänn %d väntande medlemmar"

msgid "Approved members will use an additional seat in your subscription."
msgstr "Godkända medlemmar använder ytterligare en plats i din prenumeration."

msgid "Approved members will use an additional %d seats in your subscription."
msgstr ""
"Godkända medlemmar använder ytterligare %d platser i din prenumeration."

msgid "Control who has access to your group and what they can do"
msgstr "Bestäm vem som har åtkomst till gruppen och vad de kan göra"

msgid "Control who has access to your project and what they can do"
msgstr "Bestäm vem som har åtkomst till projektet och vad de kan göra"

msgid "Copy SSH clone URL"
msgstr "Kopiera SSH-kloningsadress"

msgid "Copy SSH public key"
msgstr "Kopiera offentlig SSH-nyckel"

msgid ""
"Could not link %{issuables}. You must be a member of the project or group of"
" both %{issuables}."
msgstr ""
"Det gick inte att länka %{issuables}. Du måste vara medlem i projektet eller"
" gruppen för båda %{issuables}."

msgid "Could not revoke impersonation token %{token_name}."
msgstr "Det gick inte att återkalla personifieringstoken %{token_name}."

msgid "Could not verify device authenticity. Try using a different device."
msgstr ""
"Det gick inte att verifiera enhetens äkthet. Försök med en annan enhet."

msgid "Delete WebAuthn device"
msgstr "Ta bort WebAuthn-enhet"

msgid "Direct members"
msgstr "Direkta medlemmar"

msgid ""
"Disable inviting new members to group or project by group/project owners or "
"project maintainers"
msgstr ""
"Inaktivera inbjudningar av nya medlemmar till grupp eller projekt från "
"grupp- eller projektägare och projektansvariga"

msgid ""
"Discussion is %{lockedLinkStart}locked%{lockedLinkEnd}. Only members can "
"comment."
msgstr ""
"Diskussionen är %{lockedLinkStart}låst%{lockedLinkEnd}. Endast medlemmar kan"
" kommentera."

msgid "Dormant members"
msgstr "Vilande medlemmar"

msgid "Enable authenticated API request rate limit"
msgstr "Aktivera hastighetsbegränsning för autentiserade API-förfrågningar"

msgid "Enable authenticated Git HTTP request rate limit"
msgstr ""
"Aktivera hastighetsbegränsning för autentiserade Git HTTP-förfrågningar"

msgid "Enable authenticated Git LFS request rate limit"
msgstr ""
"Aktivera hastighetsbegränsning för autentiserade Git LFS-förfrågningar"

msgid "Enable authenticated web request rate limit"
msgstr "Aktivera hastighetsbegränsning för autentiserade webbförfrågningar"

msgid ""
"Enable to allow %{docs_link_start}Device authorization grant "
"flow%{docs_link_end}."
msgstr ""
"Aktivera för att tillåta %{docs_link_start}flödet för "
"enhetsauktorisering%{docs_link_end}."

msgid "Enable unauthenticated API request rate limit"
msgstr "Aktivera hastighetsbegränsning för oautentiserade API-förfrågningar"

msgid "Enable unauthenticated Git HTTP request rate limit"
msgstr ""
"Aktivera hastighetsbegränsning för oautentiserade Git HTTP-förfrågningar"

msgid "Enable unauthenticated web request rate limit"
msgstr "Aktivera hastighetsbegränsning för oautentiserade webbförfrågningar"

msgid "Enabled Git access protocols"
msgstr "Aktiverade Git-åtkomstprotokoll"

msgid "Everyone With Access"
msgstr "Alla med åtkomst"

msgid "External authorization denied access to this project"
msgstr "Extern auktorisering nekade åtkomst till det här projektet"

msgid ""
"Failed to assign custom admin role. Try again or select a different role."
msgstr ""
"Det gick inte att tilldela anpassad administratörsroll. Försök igen eller "
"välj en annan roll."

msgid ""
"Failed to authenticate due to a configuration issue. Try again later or "
"contact support."
msgstr ""
"Autentiseringen misslyckades på grund av ett konfigurationsproblem. Försök "
"igen senare eller kontakta supporten."

msgid "Failed to authenticate. Verify your identity with your device."
msgstr "Autentiseringen misslyckades. Verifiera din identitet med enheten."

msgid ""
"Failed to cancel auto stop because you do not have permission to update the "
"environment."
msgstr ""
"Det gick inte att avbryta automatisk stoppning eftersom du inte har "
"behörighet att uppdatera miljön."

msgid "Failed to discover authorization server: %{error}"
msgstr "Det gick inte att identifiera auktoriseringsservern: %{error}"

msgid "Failed to protect the branch"
msgstr "Det gick inte att skydda grenen"

msgid "Failed to refresh token: %{error}"
msgstr "Det gick inte att uppdatera token: %{error}"

msgid "Failed to verify WebAuthn challenge. Try again."
msgstr "Det gick inte att verifiera WebAuthn-utmaningen. Försök igen."

msgid "Failed to verify cryptographic signature. Try authenticating again."
msgstr ""
"Det gick inte att verifiera den kryptografiska signaturen. Försök att "
"autentisera igen."
