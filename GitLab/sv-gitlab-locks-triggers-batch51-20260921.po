#. Crowdin string ID: 496020
msgid "Start 30-day trial"
msgstr "Starta 30-dagarsprovperiod"

#. Crowdin string ID: 496022
msgid "WorkItemDuoQuestion|Recommended"
msgstr "WorkItemDuoQuestion|Rekommenderas"

#. Crowdin string ID: 496024
msgid "WorkItemDuoQuestion|Something went wrong while sending your answer. Please try again."
msgstr "WorkItemDuoQuestion|Något gick fel när ditt svar skickades. Försök igen."

#. Crowdin string ID: 496026
msgid "WorkItemDuoQuestion|Your answer was posted, but the thread could not be resolved. Resolve it manually so GitLab Duo can continue."
msgstr "WorkItemDuoQuestion|Ditt svar skickades, men tråden kunde inte lösas. Lös den manuellt så att GitLab Duo kan fortsätta."

#. Crowdin string ID: 496028
msgid "AWS region must be a valid region code, for example us-east-1"
msgstr "AWS-regionen måste vara en giltig regionskod, till exempel us-east-1"

#. Crowdin string ID: 496030
msgid "Are you sure you want to lock the \"%{name}\" directory?"
msgstr "Är du säker på att du vill låsa katalogen ”%{name}”?"

#. Crowdin string ID: 496032
msgid "Are you sure you want to lock the \"%{name}\" file?"
msgstr "Är du säker på att du vill låsa filen ”%{name}”?"

#. Crowdin string ID: 496034
msgid "Are you sure you want to unlock the \"%{name}\" directory?"
msgstr "Är du säker på att du vill låsa upp katalogen ”%{name}”?"

#. Crowdin string ID: 496036
msgid "Are you sure you want to unlock the \"%{name}\" file?"
msgstr "Är du säker på att du vill låsa upp filen ”%{name}”?"

#. Crowdin string ID: 496038
msgid "DeleteProject|Failed to remove some tags in project container registry. The container registry at %{registry_url} could not be reached (%{error}). If the container registry is not in use, disable the integration to allow the project to be deleted."
msgstr "DeleteProject|Det gick inte att ta bort vissa taggar i projektets containerregister. Det gick inte att nå containerregistret på %{registry_url} (%{error}). Om containerregistret inte används kan du inaktivera integreringen så att projektet kan tas bort."

#. Crowdin string ID: 496040
msgid "DuoAgentsPlatform|Triggers connect flows or external agents to events in this project. Create a trigger to determine when your flows or external agents are run."
msgstr "DuoAgentsPlatform|Utlösare kopplar flöden eller externa agenter till händelser i projektet. Skapa en utlösare för att avgöra när dina flöden eller externa agenter körs."

#. Crowdin string ID: 496042
msgid "DuoAgentsPlatform|Triggers run a flow or external agent when defined events occur."
msgstr "DuoAgentsPlatform|Utlösare kör ett flöde eller en extern agent när definierade händelser inträffar."

#. Crowdin string ID: 496044
msgid "Failed to create the organization user"
msgstr "Det gick inte att skapa organisationsanvändaren"

#. Crowdin string ID: 496046
msgid "Failed to delete the organization user"
msgstr "Det gick inte att ta bort organisationsanvändaren"

#. Crowdin string ID: 496048
msgid "PolicyStore|Disable"
msgstr "PolicyStore|Inaktivera"

#. Crowdin string ID: 496050
msgid "PolicyStore|Enable"
msgstr "PolicyStore|Aktivera"

#. Crowdin string ID: 496052
msgid "PolicyStore|The policy could not be updated. Try again."
msgstr "PolicyStore|Policyn kunde inte uppdateras. Försök igen."

#. Crowdin string ID: 496054
msgid "The parent directory \"%{path}\" is locked. To unlock this directory, unlock \"%{path}\"."
msgstr "Överordnad katalog ”%{path}” är låst. Lås upp ”%{path}” för att låsa upp katalogen."

#. Crowdin string ID: 496056
msgid "The user cannot be added because their home organization is isolated"
msgstr "Användaren kan inte läggas till eftersom hens hemorganisation är isolerad"

#. Crowdin string ID: 496058
msgid "The user could not be found"
msgstr "Användaren hittades inte"

#. Crowdin string ID: 496060
msgid "The user is already a member of the organization"
msgstr "Användaren är redan medlem i organisationen"

#. Crowdin string ID: 496062
msgid "TransferProject|Failed to transfer project. The container registry at %{registry_url} could not be reached (%{error}). If the container registry is not in use, disable the integration to allow the project to be transferred."
msgstr "TransferProject|Det gick inte att överföra projektet. Det gick inte att nå containerregistret på %{registry_url} (%{error}). Om containerregistret inte används kan du inaktivera integreringen så att projektet kan överföras."

#. Crowdin string ID: 496064
msgid "UsageQuota|An error occurred while loading the storage usage details. Please refresh the page to try again."
msgstr "UsageQuota|Ett fel uppstod när uppgifterna om lagringsanvändningen lästes in. Uppdatera sidan för att försöka igen."

#. Crowdin string ID: 496066
msgid "View lock"
msgstr "Visa lås"

#. Crowdin string ID: 496068
msgid "You cannot delete a user from their home organization"
msgstr "Du kan inte ta bort en användare från hens hemorganisation"

#. Crowdin string ID: 496070
msgid "You cannot delete the last owner of the organization"
msgstr "Du kan inte ta bort organisationens sista ägare"

#. Crowdin string ID: 496072
msgid "You cannot lock this directory because \"%{path}\" inside it is locked."
msgstr "Du kan inte låsa katalogen eftersom ”%{path}” i den är låst."

#. Crowdin string ID: 496074
msgid "You have insufficient permissions to create an organization user"
msgstr "Du har inte tillräcklig behörighet för att skapa en organisationsanvändare"

#. Crowdin string ID: 496076
msgid "You have insufficient permissions to delete the organization user"
msgstr "Du har inte tillräcklig behörighet för att ta bort organisationsanvändaren"

#. Crowdin string ID: 496078
msgid "is not valid YAML: %{message}"
msgstr "är inte giltig YAML: %{message}"
