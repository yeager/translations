msgstr ""
"Det här jobbet kunde inte köras på grund av otillräckliga behörigheter att "
"skapa en nedströmspipeline"

msgid ""
"Job|This job could not be executed because of insufficient permissions to "
"track the upstream project."
msgstr ""
"Det här jobbet kunde inte köras på grund av otillräckliga behörigheter att "
"spåra uppströmsprojektet."

msgid ""
"Job|This job could not be executed because the trigger:project value "
"resolved to a blank value. Check that the variables or inputs used in "
"trigger:project are set."
msgstr ""
"Det här jobbet kunde inte köras eftersom värdet trigger:project blev tomt. "
"Kontrollera att variablerna eller indata som används i trigger:project är "
"angivna."

msgid ""
"Job|This job could not be executed because upstream bridge project could not"
" be found."
msgstr ""
"Det här jobbet kunde inte köras eftersom uppströmsprojektet för bryggan inte"
" hittades."

msgid ""
"Job|This job failed because the necessary resources were not successfully "
"created."
msgstr ""
"Det här jobbet misslyckades eftersom de nödvändiga resurserna inte skapades."

msgid ""
"Job|This job failed to retrieve secrets because it does not have access to "
"GitLab Secrets Manager."
msgstr ""
"Det här jobbet kunde inte hämta hemligheter eftersom det saknar åtkomst till"
" GitLab Secrets Manager."

