msgstr ""
"Jobbet fastnade i vänteläge trots att matchande runners var tillgängliga. "
"Kontrollera jobbkonfigurationen eller försök igen"

msgid ""
"Job|The job was stuck in pending state with no matching runners available. "
"Check your runner tags or configuration"
msgstr ""
"Jobbet fastnade i vänteläge utan matchande tillgängliga runners. Kontrollera"
" runner-taggarna eller konfigurationen"

msgid ""
"Job|The runner could not reach an external dependency. Please try again."
msgstr "Runnern kunde inte nå ett externt beroende. Försök igen."

