msgid ""
"DuoCodeReview|:warning: %{user_reference}, you don't have permission to "
"create a pipeline for Code Review Flow in this project. Contact your "
"administrator to update your permissions."
msgstr ""
":warning: %{user_reference}, du har inte behörighet att skapa en pipeline "
"för kodgranskningsflödet i det här projektet. Kontakta administratören för "
"att uppdatera dina behörigheter."

msgid ""
"DuoCodeReview|:warning: %{user_reference}, you need to set a default GitLab "
"Duo namespace to use Code Review Flow in this project. Please set a default "
"GitLab Duo namespace in your [preferences](%{docs_url})."
msgstr ""
":warning: %{user_reference}, du måste ange en standardnamnrymd för GitLab "
"Duo för att använda Code Review Flow i detta projekt. Ange en "
"standardnamnrymd för GitLab Duo i dina [inställningar](%{docs_url})."

msgid ""
"DuoCodeReview|:warning: Code Review Flow completed the review but could not "
"post the review comments. Please request a new review to try again."
msgstr ""
":warning: Code Review Flow slutförde granskningen men kunde inte publicera "
"granskningskommentarerna. Begär en ny granskning för att försöka igen."

msgid ""
"DuoCodeReview|:warning: Code Review Flow could not create the required CI/CD"
" pipeline. Please request a new review. If the problem persists, contact "
"your administrator."
msgstr ""
":warning: Flödet för kodgranskning kunde inte skapa den CI/CD-pipeline som "
"krävs. Begär en ny granskning. Om problemet kvarstår kontaktar du "
"administratören."

msgid ""
"DuoCodeReview|:warning: Code Review Flow could not obtain the required "
"authentication tokens to connect to the GitLab AI Gateway and API. Please "
"request a new review. If the issue persists, contact your administrator."
msgstr ""
":warning: Code Review Flow kunde inte hämta de autentiseringstoken som krävs"
" för att ansluta till GitLab AI Gateway och API:t. Begär en ny granskning. "
"Om problemet kvarstår, kontakta din administratör."

msgid ""
"DuoCodeReview|:warning: Code Review Flow could not retrieve the source "
"branch for this merge request. Please request a new review."
msgstr ""
":warning: Code Review Flow kunde inte hämta källgrenen för denna "
"sammanfogningsbegäran. Begär en ny granskning."

msgid ""
"DuoCodeReview|:warning: Code Review Flow could not start because the "
"namespace has run out of compute minutes. Ask someone with billing access to"
" add compute minutes before trying again."
msgstr ""
":warning: Code Review Flow kunde inte starta eftersom namnrymdens "
"beräkningsminuter har tagit slut. Be någon med faktureringsåtkomst att lägga"
" till beräkningsminuter innan du försöker igen."

msgid ""
"DuoCodeReview|:warning: Code Review Flow could not start because the project"
" has no runner available. It needs an instance runner or a top-level group "
"runner with the `%{tag}` tag and a Docker-compatible executor."
msgstr ""
":warning: Code Review Flow kunde inte starta eftersom projektet saknar en "
"tillgänglig runner. Det behöver en instans-runner eller en runner för en "
"grupp på högsta nivån med taggen `%{tag}` och en Docker-kompatibel "
"exekverare."

msgid ""
"DuoCodeReview|:warning: Code Review Flow is enabled but the service account "
"needs to be verified. Contact your administrator."
msgstr ""
":warning: Code Review Flow är aktiverat men tjänstkontot måste verifieras. "
"Kontakta administratören."

msgid ""
"DuoCodeReview|:warning: Code Review Flow is not available for this project. "
"Contact your administrator to verify that the flow is enabled and the "
"required configuration is in place."
msgstr ""
":warning: Code Review Flow är inte tillgängligt för detta projekt. Kontakta "
"administratören för att kontrollera att flödet är aktiverat och att den "
"nödvändiga konfigurationen finns."

msgid ""
"DuoCodeReview|:warning: Code Review Flow is not enabled. Contact your group "
"administrator to enable the foundational flow in the top-level group."
msgstr ""
":warning: Code Review Flow är inte aktiverat. Kontakta gruppadministratören "
"för att aktivera det grundläggande flödet i toppnivågruppen."

msgid ""
"DuoCodeReview|:warning: No GitLab Credits remain for this billing period. To"
" continue using Code Review Flow, contact your administrator."
msgstr ""
":warning: Inga GitLab-krediter återstår för denna faktureringsperiod. "
"Kontakta administratören för att fortsätta använda Code Review Flow."

msgid ""
"DuoCodeReview|:warning: Something went wrong and the review request was "
"stopped. Please request a new review."
msgstr ""
":warning: Något gick fel och granskningsbegäran stoppades. Begär en ny "
"granskning."

msgid ""
"DuoCodeReview|:warning: Something went wrong while GitLab Duo was generating"
" a code review summary."
msgstr ""
":warning: Något gick fel när GitLab Duo skapade en sammanfattning av "
"kodgranskningen."

msgid ""
"DuoCodeReview|:warning: Something went wrong while I was processing the "
"review results. Please request a new review."
msgstr ""
":warning: Något gick fel när jag bearbetade granskningsresultaten. Begär en "
"ny granskning."

msgid ""
"DuoCodeReview|:warning: Something went wrong while requesting a review from "
"GitLab Duo. Please request a new review."
msgstr ""
":warning: Något gick fel när en granskning begärdes från GitLab Duo. Begär "
"en ny granskning."

msgid ""
"DuoCodeReview|:warning: Something went wrong while starting Code Review "
"Flow. Please try again later."
msgstr ""
":warning: Något gick fel när Code Review Flow startades. Försök igen senare."

msgid ""
"DuoCodeReview|:warning: Usage billing is not available for this account. To "
"continue using Code Review Flow, contact your administrator."
msgstr ""
":warning: Användningsfakturering är inte tillgänglig för detta konto. "
"Kontakta administratören för att fortsätta använda Code Review Flow."

msgid "DuoCodeReview|:wave: There's nothing for me to review."
msgstr ":wave: Det finns inget för mig att granska."

msgid ""
"DuoCodeReview|Can't access the merge request. When SAML single sign-on is "
"enabled on a group or its parent, Duo Code Reviews can't be requested from "
"the API. Request a review from the GitLab UI instead."
msgstr ""
"Det går inte att komma åt sammanfogningsbegäran. När SAML-enkel inloggning "
"är aktiverad för en grupp eller dess överordnade grupp kan Duo-"
"kodgranskningar inte begäras via API:t. Begär i stället en granskning från "
"GitLabs gränssnitt."

msgid ""
"DuoCodeReview|Can't create the progress note. This can happen if the Duo "
"Code Review bot does not have permission to create notes on the merge "
"request."
msgstr ""
"Det gick inte att skapa förloppsanteckningen. Det kan bero på att Duo Code "
"Review-botten inte har behörighet att skapa anteckningar på "
"sammanfogningsbegäran."

msgid ""
"DuoCodeReview|Code Review Flow is enabled but reviews for users with a "
"GitLab Duo Enterprise seat are handled by the non-agentic GitLab Duo Code "
"Review instead. To use Code Review Flow for all reviews in this namespace, "
"clear and then re-select Code Review Flow."
msgstr ""
"Code Review Flow är aktiverat, men granskningar för användare med en GitLab "
"Duo Enterprise-användarplats hanteras i stället av den icke-agentbaserade "
"GitLab Duo Code Review. För att använda Code Review Flow för alla "
"granskningar i den här namnrymden avmarkerar du Code Review Flow och väljer "
"sedan alternativet igen."

msgid ""
"DuoCodeReview|Code Review Flow is enabled for this namespace. All reviews "
"are handled by the flow and consume GitLab Credits"
msgstr ""
"Code Review Flow är aktiverat för detta namnrymdsområde. Alla granskningar "
"hanteras av flödet och förbrukar GitLab-krediter"

msgid ""
"DuoCodeReview|Control whether GitLab Duo automatically reviews merge "
"requests across all groups and projects. This setting cascades to subgroups "
"and projects but can be overridden."
msgstr ""
"Styr om GitLab Duo automatiskt granskar sammanfogningsbegäranden i alla "
"grupper och projekt. Denna inställning ärvs av undergrupper och projekt men "
"kan åsidosättas."

msgid ""
"DuoCodeReview|Control whether GitLab Duo automatically reviews merge "
"requests. This setting cascades to subgroups and projects but can be "
"overridden."
msgstr ""
"Styr om GitLab Duo automatiskt granskar sammanfogningsbegäranden. Denna "
"inställning ärvs av undergrupper och projekt men kan åsidosättas."

msgid "DuoCodeReview|Enable Code Review Flow"
msgstr "Aktivera Code Review Flow"

msgid "DuoCodeReview|Enable Code Review Flow for this namespace?"
msgstr "Aktivera Code Review Flow för detta namnrymdsområde?"

msgid "DuoCodeReview|Enable automatic reviews by GitLab Duo"
msgstr "Aktivera automatiska granskningar med GitLab Duo"

msgid "DuoCodeReview|Error code: [%{error_code}](%{error_code_url})"
msgstr "Felkod: [%{error_code}](%{error_code_url})"

msgid "DuoCodeReview|Failed to start the Duo workflow. Please try again."
msgstr "Kunde inte starta Duo-arbetsflödet. Försök igen."

msgid "DuoCodeReview|GitLab Duo Code Review"
msgstr "GitLab Duo Code Review"

msgid ""
"DuoCodeReview|GitLab Duo Code Review was not automatically added. Contact "
