msgstr ""
"Det här jobbet tillhör en underordnad pipeline och kan inte skapa fler "
"underordnade pipelines"

msgid ""
"Job|This job could not be executed because downstream bridge project could "
"not be found"
msgstr ""
"Det här jobbet kunde inte köras eftersom nedströmsprojektet för bryggan inte"
" hittades"

msgid ""
"Job|This job could not be executed because downstream pipeline trigger "
"definition is invalid"
msgstr ""
"Det här jobbet kunde inte köras eftersom triggerdefinitionen för "
"nedströmspipelinen är ogiltig"

msgid ""
"Job|This job could not be executed because group IP address restrictions are"
" enabled, and the runner's IP address is not in the allowed range."
msgstr ""
"Det här jobbet kunde inte köras eftersom gruppens IP-adressbegränsningar är "
"aktiverade och runnerns IP-adress inte finns i det tillåtna intervallet."

msgid ""
"Job|This job could not be executed because it would create an environment "
"with an invalid parameter."
msgstr ""
"Det här jobbet kunde inte köras eftersom det skulle skapa en miljö med en "
"ogiltig parameter."

msgid ""
"Job|This job could not be executed because it would create infinitely "
"looping pipelines"
msgstr ""
"Det här jobbet kunde inte köras eftersom det skulle skapa pipelines med "
"oändliga slingor"

msgid ""
"Job|This job could not be executed because of insufficient permissions to "
