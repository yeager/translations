msgstr ""
"Jobbet avbröts men visade ingen aktivitet under en längre tid. Försök igen"

msgid ""
"Job|The job was running but showed no activity for an extended period. Check"
" your job script or try again"
msgstr ""
"Jobbet kördes men visade ingen aktivitet under en längre tid. Kontrollera "
"jobbskriptet eller försök igen"

