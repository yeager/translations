msgid "DatabaseDiagnostics|A cost delay of zero disables throttling, so autovacuum runs at full speed and can cause write storms and replication lag."
msgstr "DatabaseDiagnostics|En kostnadsfördröjning på noll inaktiverar strypning, så autovacuum körs med full hastighet och kan orsaka skrivstormar och replikeringsfördröjning."

msgid "DatabaseDiagnostics|Autovacuum configuration"
msgstr "DatabaseDiagnostics|Autovacuum-konfiguration"

msgid "DatabaseDiagnostics|Autovacuum is disabled. Dead tuples will not be reclaimed automatically, risking bloat and eventually transaction ID wraparound."
msgstr "DatabaseDiagnostics|Autovacuum är inaktiverat. Döda tupler återvinns inte automatiskt, vilket riskerar uppsvällning och till sist omslag av transaktions-ID."

msgid "DatabaseDiagnostics|Disabled"
msgstr "DatabaseDiagnostics|Inaktiverad"

msgid "DatabaseDiagnostics|Effective autovacuum settings and per-table overrides for each database connection, with known-risky values flagged."
msgstr "DatabaseDiagnostics|Effektiva autovacuum-inställningar och åsidosättningar per tabell för varje databasanslutning, där kända riskvärden är markerade."

msgid "DatabaseDiagnostics|Effective settings"
msgstr "DatabaseDiagnostics|Effektiva inställningar"

msgid "DatabaseDiagnostics|Inherited"
msgstr "DatabaseDiagnostics|Ärvd"

msgid "DatabaseDiagnostics|Learn more about PostgreSQL autovacuum and transaction ID wraparound."
msgstr "DatabaseDiagnostics|Läs mer om PostgreSQL autovacuum och omslag av transaktions-ID."

msgid "DatabaseDiagnostics|Low"
msgstr "DatabaseDiagnostics|Låg"

msgid "DatabaseDiagnostics|No autovacuum settings could be read."
msgstr "DatabaseDiagnostics|Inga autovacuum-inställningar kunde läsas."

msgid "DatabaseDiagnostics|OK"
msgstr "DatabaseDiagnostics|OK"

msgid "DatabaseDiagnostics|Only a few autovacuum workers are configured, which may be too few for a large or decomposed database fleet."
msgstr "DatabaseDiagnostics|Endast ett fåtal autovacuum-arbetare är konfigurerade, vilket kan vara för få för en stor eller uppdelad databaspark."

msgid "DatabaseDiagnostics|Setting"
msgstr "DatabaseDiagnostics|Inställning"

msgid "DatabaseDiagnostics|Status"
msgstr "DatabaseDiagnostics|Status"

msgid "DatabaseDiagnostics|The autovacuum_work_mem setting is unset and inherits maintenance_work_mem. Consider setting it explicitly to bound per-worker memory."
msgstr "DatabaseDiagnostics|Inställningen autovacuum_work_mem är inte angiven och ärver maintenance_work_mem. Överväg att ange den explicit för att begränsa minnet per arbetare."

msgid "DatabaseDiagnostics|The cost limit is at or near the conservative default, which is likely too low to keep up on modern storage."
msgstr "DatabaseDiagnostics|Kostnadsgränsen är på eller nära den försiktiga standardinställningen, som sannolikt är för låg för att hänga med på modern lagring."

