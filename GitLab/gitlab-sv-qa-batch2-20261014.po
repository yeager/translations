msgid " %{start} to %{end}"
msgstr " %{start} till %{end}"

msgid " or %{emphasisStart}&epic ID%{emphasisEnd}"
msgstr " eller %{emphasisStart}ärende &id%{emphasisEnd}"

msgid " reacted with :%{name}:"
msgstr " reagerade med:%{name}:"

msgid "%{listToShow}, and %{awardsListLength} more"
msgstr "%{listToShow} och %{awardsListLength} mer"

msgid "%{startDate} – %{dueDate}"
msgstr "%{startDate} till %{dueDate}"

msgid "%{startDate} – No due date"
msgstr "%{startDate} utan förfallodatum"

msgid ""
"%{strong_start}%{model_name}%{strong_end} (deprecated for "
"%{strong_start}%{feature_title}%{strong_end} on "
"%{strong_start}%{deprecation_date}%{strong_end} - Removal scheduled for: "
"%{strong_start}%{removal_version}%{strong_end})"
msgstr ""
"%{strong_start}%{model_name}%{strong_end} (föråldrad för "
"%{strong_start}%{feature_title}%{strong_end} den "
"%{strong_start}%{deprecation_date}%{strong_end} och borttagning är planerad "
"till: %{strong_start}%{removal_version}%{strong_end})"

msgid ""
"%{strong_start}%{model_name}%{strong_end} (deprecated on "
"%{strong_start}%{deprecation_date}%{strong_end} - Removal scheduled for: "
"%{strong_start}%{removal_version}%{strong_end})"
msgstr ""
"%{strong_start}%{model_name}%{strong_end} (föråldrad den "
"%{strong_start}%{deprecation_date}%{strong_end} och borttagning är planerad "
"till: %{strong_start}%{removal_version}%{strong_end})"

msgid "1-9 contributions"
msgstr "1 till 9 bidrag"

msgid "10-19 contributions"
msgstr "10 till 19 bidrag"

msgid "20-29 contributions"
msgstr "20 till 29 bidrag"

msgid ""
"APIFuzzing|Something went wrong while loading the API fuzzing configuration."
msgstr "Något gick fel när API fuzzing konfigurationen lästes in."

msgid ""
"AccessTokens|Make sure you copy your token - you won't be able to access it "
"again."
msgstr "Se till att kopiera token. Du kan inte komma åt den igen."

msgid "AccessTokens|Search or filter access tokens…"
msgstr "Sök eller filtrera åtkomstnycklar…"

msgid ""
"AccessTokens|Token rotated successfully. Make sure you copy your token - you"
" won't be able to access it again."
msgstr ""
"Token roterades. Se till att kopiera token. Du kan inte komma åt den igen."

msgid ""
"AccessTokens|Your incoming email token authenticates you when you create "
"issues and merge requests by email, and is included in your personal "
"project-specific email addresses."
msgstr ""
"Din token för inkommande e-post autentiserar dig när du skapar ärenden och "
"sammanslagningsbegäranden via e-post och ingår i dina personliga "
"projektspecifika e-postadresser."

msgid ""
"AdminSettings|When disabled, runner registration tokens are disabled from "
"runner pages, and maintainers and owners cannot use registration tokens to "
"register runners. They can use runner authentication tokens instead as the "
"more secure runner registration method."
msgstr ""
"När den här inställningen är inaktiverad är registreringstoken för runners "
"inaktiverade på runner-sidorna och underhållare och ägare kan inte använda "
"registreringstoken för att registrera runners. De kan i stället använda "
"autentiseringstoken för runners, som är den säkrare registreringsmetoden."

msgid ""
"AdminUsers|An error occurred while fetching this user's contributions, and "
"the request cannot return the number of issues, merge requests, groups, and "
"projects linked to this user. If you proceed with deleting the user, all "
"their contributions will still be deleted."
msgstr ""
"Ett fel uppstod när den här användarens bidrag hämtades och begäran kan inte"
" returnera antalet ärenden, sammanslagningsbegäranden, grupper och projekt "
"som är länkade till denna användare. Om du ändå fortsätter med att ta bort "
"användaren tas alla användarens bidrag bort."

msgid ""
"AICatalog|This %{linkStart}service account%{linkEnd} is created "
"automatically and used internally by the Code Review flow. To trigger the "
"flow, assign %{boldStart}@GitLabDuo%{boldEnd} as a reviewer on a merge "
"request — do not assign or mention this account."
msgstr ""
"Det här %{linkStart}tjänstekontot%{linkEnd} skapas automatiskt och används "
"internt av Code Review flödet. För att utlösa flödet tilldelar du "
"%{boldStart}@GitLabDuo%{boldEnd} som granskare i en "
"sammanslagningsförfrågan. Tilldela eller nämn inte det här kontot."

msgid "AiGovernance|Most active developers using agents"
msgstr "Mest aktiva utvecklare som använder agenter"

msgid "AiGovernance|Most recent sessions"
msgstr "Senaste sessionerna"

msgid "AiGovernance|Most used agents"
msgstr "Mest använda agenter"

msgid "AiGovernance|Projects with the most active agent sessions"
msgstr "Projekt med flest aktiva agentsessioner"

msgid "AiPowered|%{word} by %{source} — subgroups cannot opt in."
msgstr "%{word} av %{source}: undergrupper kan inte välja att delta."

msgid "AiPowered|%{word} by %{source} — subgroups cannot opt out."
msgstr "%{word} av %{source}: undergrupper kan inte välja bort detta."

msgid "AiPowered|%{word} — subgroups cannot opt in."
msgstr "%{word}: undergrupper kan inte välja detta."

msgid "AiPowered|%{word} — subgroups cannot opt out."
msgstr "%{word}: undergrupper kan inte välja bort detta."

msgid ""
"AiPowered|%{word} — subgroups default to off but can opt in individually."
msgstr ""
"%{word}: undergrupper är avstängda som standard men kan välja detta "
"individuellt."

msgid ""
"AiPowered|%{word} — subgroups default to on but can opt out individually."
msgstr ""
"%{word}: undergrupper är aktiverade som standard men kan välja bort detta "
"individuellt."
