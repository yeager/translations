# GitLab Swedish security, SSH and decisions review batch 3 — published through Crowdin

msgid "Archived decisions cannot be deleted"
msgstr "Arkiverade beslut kan inte tas bort"

msgid "Decision is already archived"
msgstr "Beslutet är redan arkiverat"

msgid "Only resolved decisions can be archived"
msgstr "Endast lösta beslut kan arkiveras"

msgid "Resolved decisions cannot be deleted"
msgstr "Lösta beslut kan inte tas bort"

msgid "SecurityOrchestration|Schedule not editable in rule mode"
msgstr "SecurityOrchestration|Schemat kan inte redigeras i regelläge"

msgid "SecurityOrchestration|This schedule uses a format rule mode cannot display, like a range, step, or minute offset. The YAML is valid and the policy still runs. Switch to YAML mode to change the schedule."
msgstr "SecurityOrchestration|Det här schemat använder ett format som regelläget inte kan visa, till exempel ett intervall, steg eller minutförskjutning. YAML-koden är giltig och policyn körs fortfarande. Växla till YAML-läge för att ändra schemat."

msgid "ScanProfiles|Delete %{profileName}"
msgstr "ScanProfiles|Ta bort %{profileName}"

msgid "ScanProfiles|Delete profile"
msgstr "ScanProfiles|Ta bort profil"

msgid "ScanProfiles|Deleted “%{profileName}”"
msgstr "ScanProfiles|”%{profileName}” har tagits bort"

msgid "ScanProfiles|GitLab-managed profiles can't be deleted."
msgstr "ScanProfiles|GitLab-hanterade profiler kan inte tas bort."

msgid "ScanProfiles|You are about to delete “%{profileName}”. Are you sure you want to proceed?"
msgstr "ScanProfiles|Du håller på att ta bort ”%{profileName}”. Är du säker på att du vill fortsätta?"

msgid "SecurityConfiguration|Failed to delete “%{profileName}”."
msgstr "SecurityConfiguration|Det gick inte att ta bort ”%{profileName}”."

msgid "AiPowered|Failed to load last run details."
msgstr "AiPowered|Det gick inte att läsa in information om den senaste körningen."

msgid "IdentityVerification|Verify your identity to commit this change"
msgstr "IdentityVerification|Verifiera din identitet för att verkställa ändringen"

msgid "Notes|The comment you're looking for could not be found. It may have been deleted, or you may not have permission to view it."
msgstr "Notes|Kommentaren du söker hittades inte. Den kan ha tagits bort, eller så saknar du behörighet att visa den."

msgid "Reports|Accessibility scanning results are not available"
msgstr "Reports|Resultat från tillgänglighetsskanning är inte tillgängliga"

msgid "DuoAgentsPlatform|Session has been canceled successfully."
msgstr "DuoAgentsPlatform|Sessionen har avbrutits."

msgid "SshCertificates|Add certificate authority"
msgstr "SshCertificates|Lägg till certifikatutfärdare"

msgid "SshCertificates|An error occurred while adding the SSH certificate authority. Please try again."
msgstr "SshCertificates|Ett fel uppstod när SSH-certifikatutfärdaren lades till. Försök igen."

msgid "SshCertificates|Certificate authority added."
msgstr "SshCertificates|Certifikatutfärdare har lagts till."

msgid "SshCertificates|Key titles are publicly visible."
msgstr "SshCertificates|Nyckeltitlar är offentligt synliga."

msgid "SshCertificates|Public key"
msgstr "SshCertificates|Offentlig nyckel"

msgid "SshCertificates|Public key is required."
msgstr "SshCertificates|Offentlig nyckel krävs."

msgid "SshCertificates|This is the CA's public key, not an individual user's key. Certificates it signs are trusted instance-wide."
msgstr "SshCertificates|Det här är CA:ns offentliga nyckel, inte en enskild användares nyckel. Certifikat som den signerar är betrodda i hela instansen."

msgid "SshCertificates|Title is required."
msgstr "SshCertificates|Titel krävs."
