# GitLab Swedish registry and security review batch 2 — published through Crowdin

msgid "AnalyticsDashboards|GitLab Analytics"
msgstr "AnalyticsDashboards|GitLab-analys"

msgid "AnalyticsDashboards|Keep your teams aligned around the metrics that matter most"
msgstr "AnalyticsDashboards|Håll teamen samordnade kring de mätvärden som är viktigast"

msgid "ArtifactRegistry|%{count} of %{cap}"
msgstr "ArtifactRegistry|%{count} av %{cap}"

msgid "ArtifactRegistry|%{format} repositories"
msgstr "ArtifactRegistry|%{format}-arkiv"

msgid "ArtifactRegistry|%{name} moved to position %{position} of %{total}."
msgstr "ArtifactRegistry|%{name} flyttades till position %{position} av %{total}."

msgid "ArtifactRegistry|A virtual repository combines other repositories behind one endpoint. It resolves artifacts from an ordered list of upstream repositories."
msgstr "ArtifactRegistry|Ett virtuellt arkiv kombinerar andra arkiv bakom en slutpunkt. Det hämtar artefakter från en ordnad lista med uppströmsarkiv."

msgid "ArtifactRegistry|Add repository"
msgstr "ArtifactRegistry|Lägg till arkiv"

msgid "ArtifactRegistry|All upstream repositories removed. The list is empty."
msgstr "ArtifactRegistry|Alla uppströmsarkiv har tagits bort. Listan är tom."

msgid "ArtifactRegistry|Edit %{name}"
msgstr "ArtifactRegistry|Redigera %{name}"

msgid "ArtifactRegistry|Edit virtual repository"
msgstr "ArtifactRegistry|Redigera virtuellt arkiv"

msgid "ArtifactRegistry|Move %{name} down"
msgstr "ArtifactRegistry|Flytta %{name} nedåt"

msgid "ArtifactRegistry|Move %{name} up"
msgstr "ArtifactRegistry|Flytta %{name} uppåt"

msgid "ArtifactRegistry|Move to end of list"
msgstr "ArtifactRegistry|Flytta till slutet av listan"

msgid "ArtifactRegistry|Move to start of list"
msgstr "ArtifactRegistry|Flytta till början av listan"

msgid "ArtifactRegistry|New virtual repository"
msgstr "ArtifactRegistry|Nytt virtuellt arkiv"

msgid "ArtifactRegistry|No repositories added yet. Select %{addLabel} to add a source."
msgstr "ArtifactRegistry|Inga arkiv har lagts till ännu. Välj %{addLabel} för att lägga till en källa."

msgid "ArtifactRegistry|Remove %{name}"
msgstr "ArtifactRegistry|Ta bort %{name}"

msgid "ArtifactRegistry|Resolution order updated: %{names}."
msgstr "ArtifactRegistry|Upplösningsordningen uppdaterades: %{names}."

msgid "ArtifactRegistry|The format cannot be changed after the repository is created. Upstream repositories must use the same format."
msgstr "ArtifactRegistry|Formatet kan inte ändras efter att arkivet har skapats. Uppströmsarkiv måste använda samma format."

msgid "ArtifactRegistry|Use the arrow buttons to reorder repositories. Artifacts are resolved from top to bottom."
msgstr "ArtifactRegistry|Använd pilknapparna för att ändra arkivens ordning. Artefakter hämtas uppifrån och ned."

msgid "SecurityOrchestration|This rule is an allow list. New license rules can only deny; to change this rule back to a deny list, edit the policy YAML directly."
msgstr "SecurityOrchestration|Den här regeln är en tillåtelselista. Nya licensregler kan bara neka; redigera policy-YAML direkt för att ändra regeln tillbaka till en förbudslista."

msgid "AiGovernance|Last 30 days"
msgstr "AiGovernance|De senaste 30 dagarna"

msgid "AiGovernance|Shows the current registry, not filtered by date range."
msgstr "AiGovernance|Visar det aktuella registret, inte filtrerat efter datumintervall."

msgid "AiGovernance|Shows the most recent sessions, not filtered by date range."
msgstr "AiGovernance|Visar de senaste sessionerna, inte filtrerade efter datumintervall."

msgid "AiGovernance|Usage rankings are always based on the last 30 days."
msgstr "AiGovernance|Användningsrankningen baseras alltid på de senaste 30 dagarna."

msgid "ArtifactRegistry|Cache clear successfully scheduled for %{name}."
msgstr "ArtifactRegistry|Rensning av cache har schemalagts för %{name}."
