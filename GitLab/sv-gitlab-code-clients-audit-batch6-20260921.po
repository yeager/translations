msgid "Audit event streaming"
msgstr "Strömning av granskningshändelser"

msgid "CodeDropdownClients|Add client"
msgstr "CodeDropdownClients|Lägg till klient"

msgid "CodeDropdownClients|Add custom \"Open with\" entries to the project Code dropdown for all users on this instance. GitLab can't verify these applications, so add only clients you trust."
msgstr "CodeDropdownClients|Lägg till anpassade poster för ”Öppna med” i projektets Kod-rullgardinsmeny för alla användare i instansen. GitLab kan inte verifiera dessa program, så lägg endast till klienter du litar på."

msgid "CodeDropdownClients|An unknown error occurred. Please try again."
msgstr "CodeDropdownClients|Ett okänt fel uppstod. Försök igen."

msgid "CodeDropdownClients|Another client already uses this URL template."
msgstr "CodeDropdownClients|En annan klient använder redan denna URL-mall."

msgid "CodeDropdownClients|Another client already uses this display name."
msgstr "CodeDropdownClients|En annan klient använder redan detta visningsnamn."

msgid "CodeDropdownClients|Client name"
msgstr "CodeDropdownClients|Klientnamn"

msgid "CodeDropdownClients|Code dropdown clients"
msgstr "CodeDropdownClients|Klienter i Kod-rullgardinsmenyn"

msgid "CodeDropdownClients|Code dropdown clients updated."
msgstr "CodeDropdownClients|Klienterna i Kod-rullgardinsmenyn har uppdaterats."

msgid "CodeDropdownClients|Define the name of the client shown to users in the Code dropdown."
msgstr "CodeDropdownClients|Ange namnet på klienten som visas för användare i Kod-rullgardinsmenyn."

msgid "CodeDropdownClients|Delete client"
msgstr "CodeDropdownClients|Ta bort klient"

msgid "CodeDropdownClients|Delete code dropdown client?"
msgstr "CodeDropdownClients|Ta bort klient i Kod-rullgardinsmenyn?"

msgid "CodeDropdownClients|Display name"
msgstr "CodeDropdownClients|Visningsnamn"

msgid "CodeDropdownClients|Display name must be %{max} characters or less."
msgstr "CodeDropdownClients|Visningsnamnet får vara högst %{max} tecken."

msgid "CodeDropdownClients|Edit client"
msgstr "CodeDropdownClients|Redigera klient"

msgid "CodeDropdownClients|Enter a display name."
msgstr "CodeDropdownClients|Ange ett visningsnamn."

msgid "CodeDropdownClients|Enter at least one URL template."
msgstr "CodeDropdownClients|Ange minst en URL-mall."

msgid "CodeDropdownClients|No clients have been added."
msgstr "CodeDropdownClients|Inga klienter har lagts till."

msgid "CodeDropdownClients|The %{scheme} scheme is not allowed."
msgstr "CodeDropdownClients|Schemat %{scheme} är inte tillåtet."

msgid "CodeDropdownClients|URL template must be %{max} characters or less."
msgstr "CodeDropdownClients|URL-mallen får vara högst %{max} tecken."

msgid "CodeDropdownClients|URL template must be a valid URL with a scheme, for example vscode://."
msgstr "CodeDropdownClients|URL-mallen måste vara en giltig URL med ett schema, till exempel vscode://."

msgid "CodeDropdownClients|URL template must contain {url} exactly once."
msgstr "CodeDropdownClients|URL-mallen måste innehålla {url} exakt en gång."

msgid "CodeDropdownClients|Use {url} as the placeholder for the clone URL."
msgstr "CodeDropdownClients|Använd {url} som platshållare för klonings-URL:en."

msgid "CodeDropdownClients|You are about to delete the %{name} client."
msgstr "CodeDropdownClients|Du håller på att ta bort klienten %{name}."
