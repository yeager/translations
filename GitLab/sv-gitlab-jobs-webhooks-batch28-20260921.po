msgid "Job|There has been a configuration error. Check your job configuration or contact your runner administrator."
msgstr "Job|Ett konfigurationsfel har uppstått. Kontrollera jobbkonfigurationen eller kontakta runner-administratören."

msgid "Job|There has been a missing dependency failure"
msgstr "Job|Ett fel på grund av ett saknat beroende har uppstått"

msgid "Job|There has been a runner system failure, please try again"
msgstr "Job|Ett systemfel i runner har uppstått. Försök igen"

msgid "Job|There has been a timeout failure or the job got stuck. Check your timeout limits or try again"
msgstr "Job|Ett tidsgränsfel har uppstått eller så har jobbet fastnat. Kontrollera tidsgränserna eller försök igen"

msgid "Job|There has been an API failure, please try again"
msgstr "Job|Ett API-fel har uppstått. Försök igen"

msgid "Job|There has been an unknown job problem, please contact your system administrator with the job ID to review the logs"
msgstr "Job|Ett okänt jobbproblem har uppstått. Kontakta systemadministratören med jobb-id:t för att granska loggarna"

msgid "Job|There is an unknown failure, please try again"
msgstr "Job|Ett okänt fel har uppstått. Försök igen"

msgid "Job|This deployment job was rejected."
msgstr "Job|Det här driftsättningsjobbet avvisades."

msgid "Job|This job belongs to a child pipeline and cannot create further child pipelines"
msgstr "Job|Det här jobbet tillhör en underordnad pipeline och kan inte skapa fler underordnade pipelines"

msgid "Job|This job could not be executed because downstream bridge project could not be found"
msgstr "Job|Det här jobbet kunde inte köras eftersom nedströmsprojektet för bryggan inte hittades"

msgid "Job|This job could not be executed because downstream pipeline trigger definition is invalid"
msgstr "Job|Det här jobbet kunde inte köras eftersom triggerdefinitionen för nedströmspipelinen är ogiltig"

msgid "Job|This job could not be executed because group IP address restrictions are enabled, and the runner's IP address is not in the allowed range."
msgstr "Job|Det här jobbet kunde inte köras eftersom gruppens IP-adressbegränsningar är aktiverade och runnerns IP-adress inte finns i det tillåtna intervallet."

msgid "Job|This job could not be executed because it would create an environment with an invalid parameter."
msgstr "Job|Det här jobbet kunde inte köras eftersom det skulle skapa en miljö med en ogiltig parameter."

msgid "Job|This job could not be executed because it would create infinitely looping pipelines"
msgstr "Job|Det här jobbet kunde inte köras eftersom det skulle skapa pipelines med oändliga slingor"

msgid "Job|This job could not be executed because of insufficient permissions to create a downstream pipeline"
msgstr "Job|Det här jobbet kunde inte köras på grund av otillräckliga behörigheter att skapa en nedströmspipeline"

msgid "Job|This job could not be executed because of insufficient permissions to track the upstream project."
msgstr "Job|Det här jobbet kunde inte köras på grund av otillräckliga behörigheter att spåra uppströmsprojektet."

msgid "Job|This job could not be executed because the trigger:project value resolved to a blank value. Check that the variables or inputs used in trigger:project are set."
msgstr "Job|Det här jobbet kunde inte köras eftersom värdet trigger:project blev tomt. Kontrollera att variablerna eller indata som används i trigger:project är angivna."

msgid "Job|This job could not be executed because upstream bridge project could not be found."
msgstr "Job|Det här jobbet kunde inte köras eftersom uppströmsprojektet för bryggan inte hittades."

msgid "Job|Too many downstream pipelines triggered in the last minute. Try again later."
msgstr "Job|För många nedströms-pipelines utlöstes under den senaste minuten. Försök igen senare."

msgid "Job|You reached the maximum depth of child pipelines"
msgstr "Job|Du har nått det maximala djupet för underordnade pipelines"

msgid "Queued for (re)classification."
msgstr "Köad för (om)klassificering."

msgid "Resize dynamic panel"
msgstr "Ändra storlek på dynamisk panel"

msgid "Resize static panel"
msgstr "Ändra storlek på statisk panel"

msgid "SecurityOrchestration|Bypass settings"
msgstr "SecurityOrchestration|Inställningar för förbikoppling"

msgid "Waiting to be classified."
msgstr "Väntar på att klassificeras."

msgid "Webhooks|Flows that reference this webhook receive lifecycle and progress events. Progress events can include agent reasoning and tool arguments. %{link_start}Learn more%{link_end}."
msgstr "Webhooks|Flöden som refererar till denna webhook tar emot livscykel- och förloppshändelser. Förloppshändelser kan innehålla agentresonemang och verktygsargument. %{link_start}Läs mer%{link_end}."

msgid "Webhooks|Send Duo flow events to this webhook"
msgstr "Webhooks|Skicka Duo-flödeshändelser till denna webhook"

msgid "An administrator can review the affected member's access or the group's email domain restrictions, then run the sync again."
msgstr "En administratör kan granska den berörda medlemmens åtkomst eller gruppens begränsningar för e-postdomäner och sedan köra synkroniseringen igen."

msgid "AnalyticsDashboards|No projects"
msgstr "AnalyticsDashboards|Inga projekt"

msgid "Notify|Go to %{organization_name}"
msgstr "Notify|Gå till %{organization_name}"

