#
msgid ""
msgstr "Language: sv\n"

msgid ""
"DomainVerification|To verify ownership of your domain, add the above key to "
"a TXT record within your DNS configuration within seven days. "
"%{link_to_help}"
msgstr ""
"För att verifiera ägarskapet för domänen lägger du till nyckeln ovan i en "
"TXT-post i DNS-konfigurationen inom sju dagar. %{link_to_help}"

msgid ""
"Don't paste the private part of the GPG key. Paste the public part which "
"begins with '-----BEGIN PGP PUBLIC KEY BLOCK-----'."
msgstr ""
"Klistra inte in den privata delen av GPG-nyckeln. Klistra in den offentliga "
"delen som börjar med '-----BEGIN PGP PUBLIC KEY BLOCK-----'."

msgid "GPG key was added to your account"
msgstr "En GPG-nyckel lades till på ditt konto"

msgid "GPG keys allow you to verify signed commits."
msgstr "Med GPG-nycklar kan du verifiera signerade incheckningar."

msgid "GPG signature (loading…)"
msgstr "GPG-signatur (läser in …)"

msgid "IdentityVerification|Help us protect your account"
msgstr "Hjälp oss att skydda ditt konto"

msgid ""
"IdentityVerification|Maximum login attempts exceeded. Wait %{interval} and "
"try again."
msgstr ""
"Det högsta antalet inloggningsförsök har överskridits. Vänta %{interval} och"
" försök igen."

msgid ""
"If checked, group owners can manage LDAP group links and LDAP member "
"overrides"
msgstr ""
"Om markerat kan gruppägare hantera LDAP-grupplänkar och LDAP-"
"medlemsöverskridanden"

msgid ""
"If checked, new group memberships and permissions can only be added via SAML"
" Group Links synchronization"
msgstr ""
"Om markerat kan nya gruppmedlemskap och behörigheter endast läggas till "
"genom synkronisering av SAML-grupplänkar"

msgid "If enabled, only protected branches will be mirrored."
msgstr "Om aktiverat speglas endast skyddade grenar."

msgid ""
"If you are unable to sign in or recover your password, contact a GitLab "
"administrator."
msgstr ""
"Kontakta en GitLab-administratör om du inte kan logga in eller återställa "
"lösenordet."

msgid ""
"If you did not recently sign in, you should immediately "
"%{password_link_start}change your password%{password_link_end}."
msgstr ""
"Om du inte nyligen har loggat in ska du genast %{password_link_start}ändra "
"lösenordet%{password_link_end}."

msgid ""
"If you did not recently sign in, you should immediately change your "
"password: %{password_link}."
msgstr ""
"Om du inte nyligen har loggat in ska du genast ändra lösenordet: "
"%{password_link}."

msgid ""
"If you did not recently try to sign in, you should immediately "
"%{password_link_start}change your password%{password_link_end}."
msgstr ""
"Om du inte nyligen har försökt logga in ska du genast "
"%{password_link_start}ändra lösenordet%{password_link_end}."

msgid ""
"If you did not recently try to sign in, you should immediately change your "
"password: %{password_link}."
msgstr ""
"Om du inte nyligen har försökt logga in ska du genast ändra lösenordet: "
"%{password_link}."

msgid ""
"If you lose access to your 2FA method, use your %{doc_start}recovery "
"codes%{doc_end}."
msgstr ""
"Om du förlorar åtkomsten till din tvåfaktormetod använder du dina "
"%{doc_start}återställningskoder%{doc_end}."

msgid ""
"Next time you sign in, select the sign-in with passkey option and follow "
"your device's instructions to authenticate and access your account. "
"%{link_start}Learn more about passkeys.%{link_end}"
msgstr ""
"Nästa gång du loggar in väljer du alternativet för att logga in med passkey "
"och följer enhetens instruktioner för att autentisera och få åtkomst till "
"kontot. %{link_start}Läs mer om passkeys.%{link_end}"

msgid ""
"Next time you sign in, select the sign-in with passkey option and follow "
"your device's instructions to authenticate and access your account. To learn"
" more about passkeys, visit %{learn_more}"
msgstr ""
"Nästa gång du loggar in väljer du alternativet för att logga in med passkey "
"och följer enhetens instruktioner för att autentisera och få åtkomst till "
"kontot. Mer information om passkeys finns på %{learn_more}"

msgid "Passkey has been deleted!"
msgstr "Passkey har tagits bort!"

msgid ""
"Passkey is now your default 2FA method. If you lose access to your 2FA "
"method, use your %{doc_start}recovery codes%{doc_end}."
msgstr ""
"Passkey är nu din standardmetod för tvåfaktorsautentisering. Om du förlorar "
"åtkomsten till tvåfaktormetoden använder du dina "
"%{doc_start}återställningskoder%{doc_end}."

msgid "Passkey may have been cloned. Contact your administrator."
msgstr "Passkey kan ha klonats. Kontakta administratören."

msgid "Passkey registered"
msgstr "Passkey registrerad"

msgid "Passkey successfully authenticated."
msgstr "Passkey autentiserades."

msgid "PasskeyAuthentication|Passkey"
msgstr "PasskeyAuthentication|Passkey"

msgid ""
"Passwords should be unique and not used for any other sites or services."
msgstr ""
"Lösenord ska vara unika och inte användas för andra webbplatser eller "
"tjänster."

msgid "Password|cannot include your name, username, or email"
msgstr ""
"Password|får inte innehålla ditt namn, användarnamn eller din e-postadress"

msgid "Password|cannot use common phrases (e.g. \"password\")"
msgstr "Password|får inte använda vanliga fraser (till exempel ”lösenord”)"

msgid "Password|must be between 8-128 characters"
msgstr "Password|måste innehålla 8–128 tecken"

msgid "Password|requires at least one lowercase letter"
msgstr "Password|kräver minst en gemen bokstav"

msgid "Password|requires at least one number"
msgstr "Password|kräver minst en siffra"

msgid "Password|requires at least one symbol character"
msgstr "Password|kräver minst ett specialtecken"

msgid "Password|requires at least one uppercase letter"
msgstr "Password|kräver minst en versal bokstav"
