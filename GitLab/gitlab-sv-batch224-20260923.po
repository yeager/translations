#. Crowdin string 58584
msgctxt "HelloMessage|%{magnifier_emoji} Create a new GitLab issue: %{new_issue_link}"
msgid "HelloMessage|%{magnifier_emoji} Create a new GitLab issue: %{new_issue_link}"
msgstr "%{magnifier_emoji} Skapa ett nytt GitLab-ärende: %{new_issue_link}"

#. Crowdin string 58588
msgctxt "HelloMessage|Does this page need fixes or improvements? Open an issue or contribute a merge request to help make GitLab more lovable. At GitLab, everyone can contribute!"
msgid "HelloMessage|Does this page need fixes or improvements? Open an issue or contribute a merge request to help make GitLab more lovable. At GitLab, everyone can contribute!"
msgstr "Behöver denna sida korrigeringar eller förbättringar? Öppna ett ärende eller bidra med en sammanfogningsbegäran för att göra GitLab ännu bättre. I GitLab kan alla bidra!"

#. Crowdin string 418355
msgctxt "HomePageMergeRequestsWidget|Merge requests"
msgid "HomePageMergeRequestsWidget|Merge requests"
msgstr "Sammanfogningsbegäranden"

#. Crowdin string 415327
msgctxt "HomePageMergeRequestsWidget|The number of merge requests is not available. Please refresh the page to try again, or visit the dashboard."
msgid "HomePageMergeRequestsWidget|The number of merge requests is not available. Please refresh the page to try again, or visit the dashboard."
msgstr "Antalet sammanfogningsbegäranden är inte tillgängligt. Uppdatera sidan och försök igen eller gå till instrumentpanelen."

#. Crowdin string 489896
msgctxt "HomePageRecentlyViewedWidget|Work items, merge requests, and wiki pages you visit will appear here."
msgid "HomePageRecentlyViewedWidget|Work items, merge requests, and wiki pages you visit will appear here."
msgstr "Arbetsobjekt, sammanfogningsbegäranden och wikisidor som du besöker visas här."

#. Crowdin string 420691
msgctxt "HomepageActivityWidget|Activity in projects you own or are a member of."
msgid "HomepageActivityWidget|Activity in projects you own or are a member of."
msgstr "Aktivitet i projekt som du äger eller är medlem i."

#. Crowdin string 415531
msgctxt "HomepageActivityWidget|Start creating merge requests, pushing code, commenting in issues, and doing other work to view a feed of your activity here."
msgid "HomepageActivityWidget|Start creating merge requests, pushing code, commenting in issues, and doing other work to view a feed of your activity here."
msgstr "Börja skapa sammanfogningsbegäranden, skicka upp kod, kommentera ärenden och utföra annat arbete för att se ett flöde med din aktivitet här."

#. Crowdin string 415533
msgctxt "HomepageActivityWidget|Your contributions, like commits and work on issues and merge requests."
msgid "HomepageActivityWidget|Your contributions, like commits and work on issues and merge requests."
msgstr "Dina bidrag, som incheckningar och arbete med ärenden och sammanfogningsbegäranden."

#. Crowdin string 425081
msgctxt "Homepage|A new day for new merge requests"
msgid "Homepage|A new day for new merge requests"
msgstr "En ny dag för nya sammanfogningsbegäranden"

