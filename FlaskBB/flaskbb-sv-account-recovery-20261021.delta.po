msgid ""
"You have entered an username or email address that is not linked with your "
"account."
msgstr ""
"Du har angett ett användarnamn eller en e-postadress som inte är kopplad "
"till ditt konto."

msgid "Email sent! Please check your inbox."
msgstr "E-postmeddelandet har skickats! Kontrollera din inkorg."

msgid "Error when resetting password"
msgstr "Fel vid återställning av lösenord"

msgid "Your password has been updated."
msgstr "Ditt lösenord har uppdaterats."

msgid "A new account activation token has been sent to your email address."
msgstr "En ny token för kontoaktivering har skickats till din e-postadress."

msgid "Could not activate account due to an unrecoverable error"
msgstr "Kontot kunde inte aktiveras på grund av ett oåterkalleligt fel"

msgid "Your account has been activated and you can now login."
msgstr "Ditt konto har aktiverats och du kan nu logga in."

msgid "Entered email doesn't exist"
msgstr "Den angivna e-postadressen finns inte"

msgid "Account is already activated"
msgstr "Kontot är redan aktiverat"

msgid ""
"Your account is currently locked out due to too many failed login attempts"
msgstr ""
"Ditt konto är för närvarande låst på grund av för många misslyckade "
"inloggningsförsök"

msgid ""
"In order to use your account you have to activate it through the link we "
"have sent to your email address."
msgstr ""
"För att använda ditt konto måste du aktivera det via länken som vi har "
"skickat till din e-postadress."

msgid "Wrong username or password."
msgstr "Fel användarnamn eller lösenord."
