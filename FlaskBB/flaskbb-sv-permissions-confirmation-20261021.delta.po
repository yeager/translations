msgid "You do not have the permissions to execute this action."
msgstr "Du har inte behörighet att utföra den här åtgärden."

msgid "You do not have the permissions to delete these topics."
msgstr "Du har inte behörighet att ta bort de här ämnena."

msgid "You do not have the permissions to hide these topics."
msgstr "Du har inte behörighet att dölja de här ämnena."

msgid "You do not have the permissions to unhide these topics."
msgstr "Du har inte behörighet att visa de här ämnena igen."

msgid "The registration has been disabled."
msgstr "Registreringen har inaktiverats."

msgid "A link to a website i.e. 'http://flaskbb.com'."
msgstr "En länk till en webbplats, t.ex. 'http://flaskbb.com'."

msgid "Email confirmation token"
msgstr "Token för e-postbekräftelse"

msgid "Please enter the token we have sent to you."
msgstr "Ange token som vi har skickat till dig."

msgid "Confirm Email"
msgstr "Bekräfta e-postadress"

msgid "Post topic"
msgstr "Skapa ämne"

msgid "Save topic"
msgstr "Spara ämne"

msgid "You are not allowed to access that forum"
msgstr "Du har inte behörighet att öppna det forumet"
