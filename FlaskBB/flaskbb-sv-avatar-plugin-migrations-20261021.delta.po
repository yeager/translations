msgid "Always"
msgstr "Alltid"

msgid "Never"
msgstr "Aldrig"

msgid "New Avatar"
msgstr "Ny profilbild"

msgid "A avatar image must be provided."
msgstr "En profilbild måste anges."

msgid "This file type is not supported for avatar images"
msgstr "Den här filtypen stöds inte för profilbilder"

msgid "Error while updating avatar"
msgstr "Fel vid uppdatering av profilbild"

msgid "Avatar updated."
msgstr "Profilbilden har uppdaterats."

msgid "Avatar deleted."
msgstr "Profilbilden har tagits bort."

msgid ""
"Couldn't apply the migrations of %(plugin)s, it stays disabled: %(error)s"
msgstr ""
"Migreringarna för %(plugin)s kunde inte tillämpas och insticksmodulen "
"förblir inaktiverad: %(error)s"

msgid "Plugin %(plugin)s has to be enabled first."
msgstr "Insticksmodulen %(plugin)s måste aktiveras först."

msgid "Couldn't apply the migrations of %(plugin)s: %(error)s"
msgstr "Migreringarna för %(plugin)s kunde inte tillämpas: %(error)s"

msgid ""
"The migrations of %(plugin)s have been applied. Restart FlaskBB to load it "
"and install its settings."
msgstr ""
"Migreringarna för %(plugin)s har tillämpats. Starta om FlaskBB för att läsa "
"in insticksmodulen och installera dess inställningar."
