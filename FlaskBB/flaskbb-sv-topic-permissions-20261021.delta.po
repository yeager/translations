msgid "You are not allowed to access that topic"
msgstr "Du har inte behörighet att öppna det ämnet"

msgid "You are not allowed to post a reply to this topic."
msgstr "Du har inte behörighet att svara i det här ämnet."

msgid "You are not allowed to post a topic here"
msgstr "Du har inte behörighet att skapa ett ämne här"

msgid "You are not allowed to edit that topic"
msgstr "Du har inte behörighet att redigera det ämnet"

msgid "You are not allowed to manage this forum"
msgstr "Du har inte behörighet att hantera det här forumet"

msgid "You are not allowed to post a reply"
msgstr "Du har inte behörighet att svara"

msgid "You are not allowed to edit that post"
msgstr "Du har inte behörighet att redigera det inlägget"

msgid "You are not allowed to delete this topic"
msgstr "Du har inte behörighet att ta bort det här ämnet"

msgid "You are not allowed to lock this topic"
msgstr "Du har inte behörighet att låsa det här ämnet"

msgid "You are not allowed to unlock this topic"
msgstr "Du har inte behörighet att låsa upp det här ämnet"

msgid "You are not allowed to highlight this topic"
msgstr "Du har inte behörighet att fästa det här ämnet"

msgid "You are not allowed to trivialize this topic"
msgstr "Du har inte behörighet att markera det här ämnet som oviktigt"
