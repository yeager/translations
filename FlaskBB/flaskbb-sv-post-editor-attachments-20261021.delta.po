msgid "Hide this topic from regular forum listings."
msgstr "Dölj det här ämnet från vanliga forumlistor."

msgid "Insert"
msgstr "Infoga"

msgid "Remove"
msgstr "Ta bort"

msgid "Attach up to %(amount)s files. Each file can be up to %(size)s."
msgstr ""
"Bifoga högst %(amount)s filer. Varje fil får vara högst %(size)s stor."

msgid "Choose files"
msgstr "Välj filer"

msgid "or drag and drop them here"
msgstr "eller dra och släpp dem här"

msgid "Attached files"
msgstr "Bifogade filer"

msgid "Editing a post in %(topic)s"
msgstr "Redigerar ett inlägg i %(topic)s"

msgid "Replying to %(topic)s"
msgstr "Svarar på %(topic)s"

msgid "Please correct the highlighted fields."
msgstr "Korrigera de markerade fälten."

msgid "Update your post..."
msgstr "Uppdatera ditt inlägg…"

msgid "Write your reply..."
msgstr "Skriv ditt svar…"
