msgid "You do not have the permissions to ban this user."
msgstr "Du har inte behörighet att spärra den här användaren."

msgid "Unban"
msgstr "Häv spärr"

msgid "User is now banned."
msgstr "Användaren har spärrats."

msgid "Could not ban user."
msgstr "Det gick inte att spärra användaren."

msgid "You do not have the permissions to unban this user."
msgstr "Du har inte behörighet att häva spärren för den här användaren."

msgid "Ban"
msgstr "Spärra"

msgid "User is now unbanned."
msgstr "Spärren för användaren har hävts."

msgid "Could not unban user."
msgstr "Det gick inte att häva spärren för användaren."

msgid "Add Group"
msgstr "Lägg till grupp"

msgid "Group added."
msgstr "Gruppen har lagts till."

msgid "Edit Group"
msgstr "Redigera grupp"

msgid "Group updated."
msgstr "Gruppen har uppdaterats."
