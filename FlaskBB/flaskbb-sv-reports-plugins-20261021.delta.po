msgid "Plugin %(plugin)s disabled. Please restart FlaskBB now."
msgstr "Insticksmodulen %(plugin)s har inaktiverats. Starta om FlaskBB nu."

msgid "Plugin has been uninstalled."
msgstr "Insticksmodulen har avinstallerats."

msgid "Plugin has been installed."
msgstr "Insticksmodulen har installerats."
