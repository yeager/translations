msgid "Category updated."
msgstr "Kategorin har uppdaterats."

msgid "Category with all associated forums deleted."
msgstr "Kategorin och alla tillhörande forum har tagits bort."

msgid "Report %(id)s is already marked as read."
msgstr "Rapport %(id)s är redan markerad som läst."

msgid "Report %(id)s marked as read."
