msgid "%(count)s users unbanned."
msgstr "Spärren har hävts för %(count)s användare."

msgid "You are not allowed to unban this user."
msgstr "Du har inte behörighet att häva spärren för den här användaren."

msgid "%(count)s groups deleted."
msgstr "%(count)s grupper har tagits bort."

msgid "%(count)s reports marked as read."
msgstr "%(count)s rapporter har markerats som lästa."

msgid "%(count)s reports deleted."
msgstr "%(count)s rapporter har tagits bort."

msgid "You are not allowed to manage attachments"
msgstr "Du har inte behörighet att hantera bilagor"

msgid "%(count)s attachments deleted."
msgstr "%(count)s bilagor har tagits bort."

msgid "Attachment deleted."
msgstr "Bilagan har tagits bort."

msgid ""
"Removed %(rows)s attachment(s) with a missing file and %(files)s orphaned "
"file(s)."
msgstr ""
"Tog bort %(rows)s bilagor med saknade filer och %(files)s överblivna filer."

msgid "Purged %(rows)s attachment(s) and %(files)s leftover file(s)."
msgstr "Rensade %(rows)s bilagor och %(files)s kvarvarande filer."

msgid "This plugin has no settings to upgrade."
msgstr "Den här insticksmodulen har inga inställningar att uppgradera."

msgid "This plugin's settings are already up to date."
msgstr "Inställningarna för den här insticksmodulen är redan uppdaterade."
