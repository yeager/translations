msgid "Error while updating email"
msgstr "Fel vid uppdatering av e-postadress"

msgid "Error while updating user details"
msgstr "Fel vid uppdatering av användaruppgifter"

msgid "Old email does not match"
msgstr "Den gamla e-postadressen stämmer inte"

msgid "New email address must be different"
msgstr "Den nya e-postadressen måste skilja sig från den gamla"

msgid "New password must be different"
msgstr "Det nya lösenordet måste skilja sig från det gamla"

msgid "Old password is wrong"
msgstr "Det gamla lösenordet är fel"

msgid "Could not retrieve avatar"
msgstr "Det gick inte att hämta profilbilden"

msgid "Attachments"
msgstr "Bilagor"

msgid "Delete attachments"
msgstr "Ta bort bilagor"

msgid "Attachments are disabled."
msgstr "Bilagor är inaktiverade."

msgid "You are not allowed to upload attachments."
msgstr "Du har inte behörighet att ladda upp bilagor."

msgid "Only %(amount)s attachments per post are allowed."
msgstr "Högst %(amount)s bilagor per inlägg är tillåtna."
