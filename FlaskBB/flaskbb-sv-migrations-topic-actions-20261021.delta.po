msgid ""
"Disable %(plugin)s and restart FlaskBB before uninstalling it, its tables "
"are still in use."
msgstr ""
"Inaktivera %(plugin)s och starta om FlaskBB innan du avinstallerar den. Dess"
" tabeller används fortfarande."

msgid "Couldn't revert the migrations of %(plugin)s: %(error)s"
msgstr "Migreringarna för %(plugin)s kunde inte återställas: %(error)s"

msgid "view post"
msgstr "visa inlägg"

msgid "Online guests"
msgstr "Gäster online"

msgid "Apply them with the install button"
msgstr "Tillämpa dem med installationsknappen"

msgid "migrations"
msgstr "migreringar"

msgid "Add this topic to your Topic Tracker."
msgstr "Lägg till det här ämnet i din ämnesbevakning."

msgid "Highlight topic"
msgstr "Fäst ämne"

msgid "Keep this topic above regular topics in the forum."
msgstr "Håll det här ämnet ovanför vanliga ämnen i forumet."

msgid "Lock topic"
msgstr "Lås ämne"

msgid "Prevent regular members from replying."
msgstr "Hindra vanliga medlemmar från att svara."

msgid "Hide topic"
msgstr "Dölj ämne"
