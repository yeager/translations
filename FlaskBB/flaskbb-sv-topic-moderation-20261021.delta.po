msgid "In order to perform this action you have to select at least one topic."
msgstr "För att utföra den här åtgärden måste du välja minst ett ämne."

msgid "%(count)s topics locked."
msgstr "%(count)s ämnen har låsts."

msgid "%(count)s topics unlocked."
msgstr "%(count)s ämnen har låsts upp."

msgid "%(count)s topics highlighted."
msgstr "%(count)s ämnen har fästs."

msgid "%(count)s topics trivialized."
msgstr "%(count)s ämnen har markerats som oviktiga."

msgid "%(count)s topics deleted."
msgstr "%(count)s ämnen har tagits bort."

msgid "Please choose a new forum for the topics."
msgstr "Välj ett nytt forum för ämnena."

msgid "You do not have the permissions to move this topic."
msgstr "Du har inte behörighet att flytta det här ämnet."

msgid "Topics moved."
msgstr "Ämnena har flyttats."

msgid "Failed to move topics."
msgstr "Det gick inte att flytta ämnena."

msgid "%(count)s topics hidden."
msgstr "%(count)s ämnen har dolts."

msgid "%(count)s topics unhidden."
msgstr "%(count)s ämnen har visats igen."
