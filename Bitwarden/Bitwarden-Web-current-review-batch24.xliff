<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2"><file original="main/src/locales/en/Bitwarden Web Vault - Strings to translate" source-language="en" target-language="sv" datatype="x-bitwarden-json"><body><trans-unit id="rotateAccountEncryptionDialogDescription" resname="rotateAccountEncryptionDialogDescription"><source>Generate a new key and re-encrypt all vault data. This is recommended if you believe your account may have been compromised.</source><target state="translated">Skapa en ny nyckel och kryptera om alla valvdata. Detta rekommenderas om du tror att kontot kan ha komprometterats.</target></trans-unit><trans-unit id="rotateAccountEncryptionCallout" resname="rotateAccountEncryptionCallout"><source>You'll be logged out and prompted to re-authenticate. To avoid data corruption, do not close your browser until the process is complete.</source><target state="translated">Du loggas ut och uppmanas att autentisera dig igen. Stäng inte webbläsaren innan processen är slutförd för att undvika datakorruption.</target></trans-unit><trans-unit id="accountEncryptionKeyRotated" resname="accountEncryptionKeyRotated"><source>Account encryption key rotated</source><target state="translated">Kontots krypteringsnyckel roterades</target></trans-unit><trans-unit id="callout" resname="callout"><source>Callout</source><target state="translated">Informationsruta</target></trans-unit><trans-unit id="clickedVaultBannerButton" resname="clickedVaultBannerButton"><source>Clicked vault banner button</source><target state="translated">Klickade på knappen i valvbanderollen</target></trans-unit><trans-unit id="progressBar" resname="progressBar"><source>Progress bar</source><target state="translated">Förloppsindikator</target></trans-unit><trans-unit id="separateDomainsWithComma" resname="separateDomainsWithComma"><source>Separate domains with a comma</source><target state="translated">Avgränsa domäner med kommatecken</target></trans-unit><trans-unit id="errorImportingMyItemsMultiCollection" resname="errorImportingMyItemsMultiCollection"><source>You cannot import items into My Items that are part of multiple collections</source><target state="translated">Du kan inte importera objekt till Mina objekt som ingår i flera samlingar</target></trans-unit><trans-unit id="driversLicenseDetails" resname="driversLicenseDetails"><source>License details</source><target state="translated">Körkortsuppgifter</target></trans-unit><trans-unit id="birthMonth" resname="birthMonth"><source>Birth month</source><target state="translated">Födelsemånad</target></trans-unit><trans-unit id="birthDay" resname="birthDay"><source>Birth day</source><target state="translated">Födelsedag</target></trans-unit><trans-unit id="birthYear" resname="birthYear"><source>Birth year</source><target state="translated">Födelseår</target></trans-unit><trans-unit id="issuingCountry" resname="issuingCountry"><source>Issuing country</source><target state="translated">Utfärdandeland</target></trans-unit><trans-unit id="issuingState" resname="issuingState"><source>Issuing state / province</source><target state="translated">Utfärdande delstat/provins</target></trans-unit><trans-unit id="issueMonth" resname="issueMonth"><source>Issue month</source><target state="translated">Utfärdandemånad</target></trans-unit><trans-unit id="issueDay" resname="issueDay"><source>Issue day</source><target state="translated">Utfärdandedag</target></trans-unit><trans-unit id="issueYear" resname="issueYear"><source>Issue year</source><target state="translated">Utfärdandeår</target></trans-unit><trans-unit id="expirationDay" resname="expirationDay"><source>Expiration day</source><target state="translated">Utgångsdag</target></trans-unit><trans-unit id="issuingAuthority" resname="issuingAuthority"><source>Issuing authority</source><target state="translated">Utfärdande myndighet</target></trans-unit><trans-unit id="licenseClass" resname="licenseClass"><source>License class</source><target state="translated">Körkortsklass</target></trans-unit><trans-unit id="pamAccessRuleEnabled" resname="pamAccessRuleEnabled"><source>Enabled</source><target state="translated">Aktiverad</target></trans-unit><trans-unit id="pamAccessRuleEnabledHint" resname="pamAccessRuleEnabledHint"><source>When disabled, the rule is inactive and does not restrict access.</source><target state="translated">När regeln är inaktiverad är den overksam och begränsar inte åtkomsten.</target></trans-unit><trans-unit id="pamAccessRuleNotFound" resname="pamAccessRuleNotFound"><source>Access rule not found.</source><target state="translated">Åtkomstregeln hittades inte.</target></trans-unit><trans-unit id="pamAccessRulesSubheading" resname="pamAccessRulesSubheading"><source>Set rules to control who can request access to sensitive credentials, under what conditions, and for how long.</source><target state="translated">Ange regler som styr vem som kan begära åtkomst till känsliga inloggningsuppgifter, under vilka villkor och hur länge.</target></trans-unit><trans-unit id="pamAccessRuleNamePlaceholder" resname="pamAccessRuleNamePlaceholder"><source>e.g. VPN + business hours</source><target state="translated">t.ex. VPN + kontorstid</target></trans-unit><trans-unit id="pamAccessRuleGeneralInfoHeading" resname="pamAccessRuleGeneralInfoHeading"><source>General info</source><target state="translated">Allmän information</target></trans-unit><trans-unit id="pamAccessRuleOptionalConditionsHeading" resname="pamAccessRuleOptionalConditionsHeading"><source>Optional conditions</source><target state="translated">Valfria villkor</target></trans-unit><trans-unit id="pamAccessRuleCollectionsHint" resname="pamAccessRuleCollectionsHint"><source>This access rule will apply to all selected collections.</source><target state="translated">Åtkomstregeln tillämpas på alla valda samlingar.</target></trans-unit><trans-unit id="pamAccessRuleCollectionsLoadError" resname="pamAccessRuleCollectionsLoadError"><source>Couldn't load collections. Refresh the page to try again.</source><target state="translated">Det gick inte att läsa in samlingar. Uppdatera sidan och försök igen.</target></trans-unit><trans-unit id="pamAccessRuleDefaultDurationHint" resname="pamAccessRuleDefaultDurationHint"><source>This duration will be pre-filled in access requests.</source><target state="translated">Denna varaktighet anges automatiskt i åtkomstbegäranden.</target></trans-unit><trans-unit id="pamAccessRuleDescription" resname="pamAccessRuleDescription"><source>Description</source><target state="translated">Beskrivning</target></trans-unit><trans-unit id="pamAccessRuleDefaultDuration" resname="pamAccessRuleDefaultDuration"><source>Default access duration</source><target state="translated">Standardvaraktighet för åtkomst</target></trans-unit><trans-unit id="pamAccessRuleMaxDuration" resname="pamAccessRuleMaxDuration"><source>Maximum access duration</source><target state="translated">Längsta varaktighet för åtkomst</target></trans-unit><trans-unit id="pamAccessRuleMaxDurationHint" resname="pamAccessRuleMaxDurationHint"><source>Any single lease is clamped to at most this long, whatever the requester asks for.</source><target state="translated">Varje enskild åtkomstperiod begränsas till högst denna längd, oavsett vad den som begär åtkomst anger.</target></trans-unit><trans-unit id="pamAccessRuleDuration15m" resname="pamAccessRuleDuration15m"><source>15 minutes</source><target state="translated">15 minuter</target></trans-unit><trans-unit id="pamAccessRuleDuration30m" resname="pamAccessRuleDuration30m"><source>30 minutes</source><target state="translated">30 minuter</target></trans-unit><trans-unit id="pamAccessRuleDuration1h" resname="pamAccessRuleDuration1h"><source>1 hour</source><target state="translated">1 timme</target></trans-unit><trans-unit id="pamAccessRuleDuration2h" resname="pamAccessRuleDuration2h"><source>2 hours</source><target state="translated">2 timmar</target></trans-unit><trans-unit id="pamAccessRuleDuration4h" resname="pamAccessRuleDuration4h"><source>4 hours</source><target state="translated">4 timmar</target></trans-unit><trans-unit id="pamAccessRuleDuration8h" resname="pamAccessRuleDuration8h"><source>8 hours</source><target state="translated">8 timmar</target></trans-unit><trans-unit id="pamAccessRuleDuration24h" resname="pamAccessRuleDuration24h"><source>24 hours</source><target state="translated">24 timmar</target></trans-unit><trans-unit id="pamAccessRuleSingleActiveLease" resname="pamAccessRuleSingleActiveLease"><source>Only one user can hold an active lease at a time</source><target state="translated">Endast en användare kan ha en aktiv åtkomstperiod åt gången</target></trans-unit><trans-unit id="pamAccessRuleSingleActiveLeaseHint" resname="pamAccessRuleSingleActiveLeaseHint"><source>New requests are queued until the current lease ends or is revoked.</source><target state="translated">Nya begäranden köas tills den aktuella åtkomstperioden avslutas eller återkallas.</target></trans-unit><trans-unit id="pamAccessRuleAllowExtensions" resname="pamAccessRuleAllowExtensions"><source>Allow lease extensions</source><target state="translated">Tillåt förlängning av åtkomstperioder</target></trans-unit><trans-unit id="pamAccessRuleAllowExtensionsHint" resname="pamAccessRuleAllowExtensionsHint"><source>Members can extend an active lease once without a new approval, up to the maximum length below.</source><target state="translated">Medlemmar kan förlänga en aktiv åtkomstperiod en gång utan nytt godkännande, upp till längsta längden nedan.</target></trans-unit><trans-unit id="pamAccessRuleMaxExtensionLength" resname="pamAccessRuleMaxExtensionLength"><source>Maximum extension length</source><target state="translated">Längsta förlängning</target></trans-unit><trans-unit id="pamAccessRuleMaxExtensionLengthHint" resname="pamAccessRuleMaxExtensionLengthHint"><source>The longest a single extension may run.</source><target state="translated">Den längsta tid som en enskild förlängning får löpa.</target></trans-unit><trans-unit id="pamAccessRuleConditionHumanApproval" resname="pamAccessRuleConditionHumanApproval"><source>Require approval</source><target state="translated">Kräv godkännande av person</target></trans-unit><trans-unit id="pamAccessRuleConditionIpAllowlist" resname="pamAccessRuleConditionIpAllowlist"><source>Restrict by IP address</source><target state="translated">Begränsa med IP-adress</target></trans-unit><trans-unit id="pamAccessRuleApprovers" resname="pamAccessRuleApprovers"><source>Approvers</source><target state="translated">Godkännare</target></trans-unit></body></file></xliff>