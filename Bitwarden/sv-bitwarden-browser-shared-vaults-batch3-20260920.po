#
msgid ""
msgstr ""
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Show $COUNT$ more"
msgstr "Visa $COUNT$ till"

msgid "No shared folders added"
msgstr "Inga delade mappar har lagts till"

msgid "Add a shared folder to securely share vault items with other members."
msgstr ""
"Lägg till en delad mapp för att säkert dela valvobjekt med andra medlemmar."

msgid "Permissions"
msgstr "Behörigheter"

msgid "View items"
msgstr "Visa objekt"

msgid "View items, hidden passwords"
msgstr "Visa objekt, dolda lösenord"

msgid "Edit items"
msgstr "Redigera objekt"

msgid "Edit items, hidden passwords"
msgstr "Redigera objekt, dolda lösenord"

msgid ""
"Ensure you change your password first. Deleting only removes the item from "
"your vault, it doesn't fix the risk."
msgstr ""
"Se till att du ändrar lösenordet först. En borttagning tar bara bort "
"objektet från valvet, den åtgärdar inte risken."

msgid "No items in My vault"
msgstr "Inga objekt i Mitt valv"

msgid "No items in My items"
msgstr "Inga objekt i Mina objekt"

msgid "No items in $VAULT_NAME$"
msgstr "Inga objekt i $VAULT_NAME$"

msgid "No items in $VAULT_NAME$"
msgstr "Inga objekt i $VAULT_NAME$"

msgid "Your vaults are empty"
msgstr "Dina valv är tomma"

msgid "No items match selected filters"
msgstr "Inga objekt matchar de valda filtren"

msgid "No items match \"$SEARCH_TERM$\""
msgstr "Inga objekt matchar ”$SEARCH_TERM$”"

msgid "Import items"
msgstr "Importera objekt"

msgid ""
"Items you delete will appear here and be permanently deleted after 30 days."
msgstr ""
"Objekt som du tar bort visas här och tas bort permanent efter 30 dagar."

msgid "Add logins, IDs, cards, and other items to get started."
msgstr ""
"Lägg till inloggningar, identiteter, kort och andra objekt för att komma "
"igång."

msgid ""
"Add items to this shared folder, then give access to other $VAULT_NAME$ "
"members."
msgstr ""
"Lägg till objekt i den här delade mappen och ge sedan andra medlemmar i "
"$VAULT_NAME$ åtkomst."

msgid ""
"My items is your private space for storing items that stay owned by "
"$VAULT_NAME$ but aren't visible to other members."
msgstr ""
"Mina objekt är ditt privata utrymme för objekt som fortsatt ägs av "
"$VAULT_NAME$ men inte visas för andra medlemmar."

msgid "You have no folders."
msgstr "Du har inga mappar."

msgid ""
"Use folders to organize vault items. They're just for you — no one else will"
" see or use them."
msgstr ""
"Använd mappar för att organisera valvobjekt. De är bara för dig – ingen "
"annan kan se eller använda dem."

msgid "1 result"
msgstr "1 resultat"

msgid "$COUNT$ results"
msgstr "$COUNT$ resultat"

msgid "No filters match “$SEARCH$”"
msgstr "Inga filter matchar ”$SEARCH$”"

msgid "Switch vault"
msgstr "Byt valv"

msgid "No folders"
msgstr "Inga mappar"

msgid "Share"
msgstr "Dela"

msgid "People who can view"
msgstr "Personer som kan visa"
