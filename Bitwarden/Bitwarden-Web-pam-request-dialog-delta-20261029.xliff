<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file id="58" original="/main/src/locales/en/messages.json" source-language="en" target-language="sv-SE" datatype="plaintext" project-id="308189" tool-id="crowdin">
    <header>
      <tool tool-id="crowdin" tool-name="Crowdin" tool-version="1.1" />
    </header>
    <body>
      <trans-unit id="69253" resname="requestAccessModalSubmit">
        <source>Request access</source>
        <target state="translated">Begär åtkomst</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalSubmit</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69255" resname="requestAccessModalAutomaticDescription">
        <source>Pick a duration. You'll get immediate access for that long.</source>
        <target state="translated">Välj en varaktighet. Du får åtkomst direkt under den perioden.</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalAutomaticDescription</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69257" resname="requestAccessModalHumanDescription">
        <source>Pick a window and tell the approver why you need access. They'll review and decide.</source>
        <target state="translated">Välj ett tidsintervall och berätta för godkännaren varför du behöver åtkomst. Personen granskar och fattar ett beslut.</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalHumanDescription</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69259" resname="requestAccessModalDuration">
        <source>Duration</source>
        <target state="translated">Varaktighet</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalDuration</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69261" resname="requestAccessModalStartDate">
        <source>Start date</source>
        <target state="translated">Startdatum</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalStartDate</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69263" resname="requestAccessModalStart">
        <source>Start time</source>
        <target state="translated">Starttid</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalStart</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69265" resname="requestAccessModalEndDate">
        <source>End date</source>
        <target state="translated">Slutdatum</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalEndDate</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69267" resname="requestAccessModalEnd">
        <source>End time</source>
        <target state="translated">Sluttid</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalEnd</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69269" resname="requestAccessModalEndNotAfterStart">
        <source>End must be after the start.</source>
        <target state="translated">Sluttiden måste vara efter starttiden.</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalEndNotAfterStart</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69271" resname="requestAccessModalStartNow">
        <source>$TIME$ (now)</source>
        <target state="translated">$TIME$ (nu)</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalStartNow

A sample value for the variable $time$: 10:57 AM</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69273" resname="requestAccessModalCustomOption">
        <source>Custom time…</source>
        <target state="translated">Anpassad tid…</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalCustomOption</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69275" resname="requestAccessModalCustomEndOption">
        <source>Custom end date and time…</source>
        <target state="translated">Anpassat slutdatum och anpassad sluttid…</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalCustomEndOption</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69277" resname="requestAccessModalShowStartPresets">
        <source>Show suggested start times</source>
        <target state="translated">Visa föreslagna starttider</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalShowStartPresets</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69279" resname="requestAccessModalShowEndPresets">
        <source>Back to suggested durations</source>
        <target state="translated">Tillbaka till föreslagna tidslängder</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalShowEndPresets</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69281" resname="requestAccessModalDurationUntil">
        <source>$DURATION$, until $END$</source>
        <target state="translated">$DURATION$, till $END$</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalDurationUntil

A sample value for the variable $duration$: 4 hours
A sample value for the variable $end$: 2:57 PM</context>
        </context-group>
      </trans-unit>
      <trans-unit id="69283" resname="requestAccessModalWindowSummary">
        <source>Requesting $DURATION$ of access: $START$ – $END$</source>
        <target state="translated">Begär åtkomst i $DURATION$: $START$–$END$</target>
        <context-group purpose="information">
          <context context-type="source">requestAccessModalWindowSummary

A sample value for the variable $duration$: 2 days, 22 hours
A sample value for the variable $start$: Tue, Sep 29, 10:57 AM
A sample value for the variable $end$: Thu, Oct 1, 9:00 AM</context>
        </context-group>
      </trans-unit>
    </body>
  </file>
</xliff>