<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file original="main/src/locales/en/Bitwarden Web Vault - Strings to translate" source-language="en" target-language="sv" datatype="x-bitwarden-json">
    <body>
      <trans-unit id="requestAccessModalSubmit" resname="requestAccessModalSubmit">
        <source>Request access</source>
        <target state="translated">Begär åtkomst</target>
      </trans-unit>
      <trans-unit id="requestAccessModalAutomaticDescription" resname="requestAccessModalAutomaticDescription">
        <source>Pick a duration. You'll get immediate access for that long.</source>
        <target state="translated">Välj en varaktighet. Du får åtkomst direkt under den perioden.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalHumanDescription" resname="requestAccessModalHumanDescription">
        <source>Pick a window and tell the approver why you need access. They'll review and decide.</source>
        <target state="translated">Välj ett tidsintervall och berätta för godkännaren varför du behöver åtkomst. Personen granskar och fattar ett beslut.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalDuration" resname="requestAccessModalDuration">
        <source>Duration</source>
        <target state="translated">Varaktighet</target>
      </trans-unit>
      <trans-unit id="requestAccessModalStartDate" resname="requestAccessModalStartDate">
        <source>Start date</source>
        <target state="translated">Startdatum</target>
      </trans-unit>
      <trans-unit id="requestAccessModalStart" resname="requestAccessModalStart">
        <source>Start time</source>
        <target state="translated">Starttid</target>
      </trans-unit>
      <trans-unit id="requestAccessModalEndDate" resname="requestAccessModalEndDate">
        <source>End date</source>
        <target state="translated">Slutdatum</target>
      </trans-unit>
      <trans-unit id="requestAccessModalEnd" resname="requestAccessModalEnd">
        <source>End time</source>
        <target state="translated">Sluttid</target>
      </trans-unit>
      <trans-unit id="requestAccessModalEndNotAfterStart" resname="requestAccessModalEndNotAfterStart">
        <source>End must be after the start.</source>
        <target state="translated">Sluttiden måste vara efter starttiden.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalStartNow" resname="requestAccessModalStartNow">
        <source>$TIME$ (now)</source>
        <target state="translated">$TIME$ (nu)</target>
      </trans-unit>
      <trans-unit id="requestAccessModalCustomOption" resname="requestAccessModalCustomOption">
        <source>Custom time…</source>
        <target state="translated">Anpassad tid…</target>
      </trans-unit>
      <trans-unit id="requestAccessModalCustomEndOption" resname="requestAccessModalCustomEndOption">
        <source>Custom end date and time…</source>
        <target state="translated">Anpassat slutdatum och anpassad sluttid…</target>
      </trans-unit>
      <trans-unit id="requestAccessModalShowStartPresets" resname="requestAccessModalShowStartPresets">
        <source>Show suggested start times</source>
        <target state="translated">Visa föreslagna starttider</target>
      </trans-unit>
      <trans-unit id="requestAccessModalShowEndPresets" resname="requestAccessModalShowEndPresets">
        <source>Back to suggested durations</source>
        <target state="translated">Tillbaka till föreslagna tidslängder</target>
      </trans-unit>
      <trans-unit id="requestAccessModalDurationUntil" resname="requestAccessModalDurationUntil">
        <source>$DURATION$, until $END$</source>
        <target state="translated">$DURATION$, till $END$</target>
      </trans-unit>
      <trans-unit id="requestAccessModalWindowSummary" resname="requestAccessModalWindowSummary">
        <source>Requesting $DURATION$ of access: $START$ – $END$</source>
        <target state="translated">Begär åtkomst i $DURATION$: $START$–$END$</target>
      </trans-unit>
    </body>
  </file>
</xliff>
