<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file original="main/src/locales/en/Bitwarden Web Vault - Strings to translate" source-language="en" target-language="sv" datatype="x-bitwarden-json">
    <body>
      <trans-unit id="requestAccessModalWindowSummary" resname="requestAccessModalWindowSummary">
        <source>Requesting $DURATION$ of access: $START$ – $END$</source>
        <target state="translated">Begär åtkomst i $DURATION$: $START$–$END$</target>
      </trans-unit>
      <trans-unit id="requestAccessModalWindowInPast" resname="requestAccessModalWindowInPast">
        <source>The requested window has already ended. Pick a later date or time.</source>
        <target state="translated">Det begärda tidsfönstret har redan passerat. Välj ett senare datum eller en senare tid.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalWindowExceedsMax" resname="requestAccessModalWindowExceedsMax">
        <source>The window can't exceed $DURATION$.</source>
        <target state="translated">Tidsfönstret får inte vara längre än $DURATION$.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalReasonRequired" resname="requestAccessModalReasonRequired">
        <source>Reason</source>
        <target state="translated">Motivering</target>
      </trans-unit>
      <trans-unit id="requestAccessModalReasonOptional" resname="requestAccessModalReasonOptional">
        <source>Reason (optional)</source>
        <target state="translated">Motivering (valfritt)</target>
      </trans-unit>
      <trans-unit id="requestAccessModalReasonPlaceholder" resname="requestAccessModalReasonPlaceholder">
        <source>Why do you need this?</source>
        <target state="translated">Varför behöver du åtkomst?</target>
      </trans-unit>
      <trans-unit id="requestAccessModalAutomaticReasonHint" resname="requestAccessModalAutomaticReasonHint">
        <source>This reason is saved with your access request.</source>
        <target state="translated">Den här motiveringen sparas med din åtkomstbegäran.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalHumanReasonHint" resname="requestAccessModalHumanReasonHint">
        <source>Approvers will see this reason when reviewing your request.</source>
        <target state="translated">Godkännare ser den här motiveringen när de granskar din begäran.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalGenericError" resname="requestAccessModalGenericError">
        <source>Could not request access. Try again.</source>
        <target state="translated">Det gick inte att begära åtkomst. Försök igen.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalApprovedSuccess" resname="requestAccessModalApprovedSuccess">
        <source>Access approved — select Start access to begin.</source>
        <target state="translated">Åtkomsten har godkänts – välj Starta åtkomst för att börja.</target>
      </trans-unit>
      <trans-unit id="requestAccessModalRequestCreatedSuccess" resname="requestAccessModalRequestCreatedSuccess">
        <source>Request submitted — awaiting approval.</source>
        <target state="translated">Begäran har skickats – väntar på godkännande.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
