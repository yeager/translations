#
msgid ""
msgstr ""
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Any account restricted exports you have saved will become invalid."
msgstr "Alla sparade begränsade kontoexporter blir ogiltiga."

msgid ""
"One or more organization policies require the master password to meet the "
"following requirements:"
msgstr ""
"En eller flera organisationsprinciper kräver att huvudlösenordet uppfyller "
"följande krav:"

msgid "Server login token"
msgstr "Inloggningstoken för server"

msgid "Only items in your individual vault will export."
msgstr "Endast objekt i ditt enskilda valv exporteras."

msgid ""
"Only items associated with the $ORGANIZATION$ vault will export. Items in "
"individual vaults will not."
msgstr ""
"Endast objekt som är kopplade till $ORGANIZATION$-valvet exporteras. Objekt "
"i enskilda valv exporteras inte."

msgid ""
"1 corrupted attachment was skipped during export. All other vault data and "
"attachments exported successfully."
msgstr ""
"1 skadad bilaga hoppades över vid exporten. Alla andra valvdata och bilagor "
"exporterades."

msgid ""
"$COUNT$ corrupted attachments were skipped during export. All other vault "
"data and attachments exported successfully."
msgstr ""
"$COUNT$ skadade bilagor hoppades över vid exporten. Alla andra valvdata och "
"bilagor exporterades."

msgid "Shared unlock"
msgstr "Delad upplåsning"

msgid "Use different login method"
msgstr "Använd en annan inloggningsmetod"

msgid "Make Bitwarden your browser's default password manager"
msgstr "Gör Bitwarden till webbläsarens standardlösenordshanterare"

msgid ""
"We'll turn off your browser's built-in password manager so you can enjoy a "
"secure login experience."
msgstr ""
"Vi stänger av webbläsarens inbyggda lösenordshanterare så att du får en "
"säker inloggningsupplevelse."

msgid ""
"You'll be asked to grant a $BROWSER$ browser permission to make Bitwarden "
"your default password manager."
msgstr ""
"Du uppmanas att ge $BROWSER$-behörighet för att göra Bitwarden till "
"standardlösenordshanterare."

msgid "Made Bitwarden your default browser password manager"
msgstr "Bitwarden är nu webbläsarens standardlösenordshanterare"

msgid "SSO authentication required"
msgstr "SSO-autentisering krävs"

msgid "Email verification"
msgstr "E-postverifiering"

msgid "Please check your email and enter the verification code below"
msgstr "Kontrollera din e-post och ange verifieringskoden nedan"

msgid "Two-factor authentication"
msgstr "Tvåfaktorsautentisering"

msgid ""
"Your Keeper account requires a two-factor authentication method that is not "
"currently supported by the direct importer."
msgstr ""
"Ditt Keeper-konto kräver en tvåfaktorsautentiseringsmetod som för närvarande"
" inte stöds av direktimporten."
