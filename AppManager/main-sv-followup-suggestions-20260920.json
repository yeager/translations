    {
      "unitId": 206856964,
      "target": [
        "App Manager kunde inte ansluta automatiskt med trådlös felsökning. Tryck på <b>Parkoppla</b> om du inte har parkopplat App Manager via Wi-Fi eller om auktoriseringen har återkallats. Annars trycker du på <b>Anslut</b> för att ange portnumret manuellt. Du kan också använda knappen högst upp för att gå till inställningen för trådlös felsökning."
      ],
      "status": "suggested",
      "suggestionId": 4013877
    },
