msgid ""
"-p PURPOSE                     Comma-delimited certificate purpose\n"
"                               (serverAuth, clientAuth, codeSigning, emailProtection, timeStamping, OCSPSigning)"
msgstr ""
"-p PURPOSE                     Kommaavgränsat certifikatsyfte\n"
"                               (serverAuth, clientAuth, codeSigning, emailProtection, timeStamping, OCSPSigning)"

msgid "-r ROOT-NAME                   Name of root certificate"
msgstr "-r ROOT-NAME                   Namn på rotcertifikat"

msgid "-s SCOPE(S)                    Specify the scope(s) to authorize"
msgstr ""
"-s SCOPE(S)                    Ange de behörighetsomfattningar som ska "
"auktoriseras"

msgid ""
"-t TYPE                        Certificate type\n"
"                               (rsa-2048, rsa-3072, rsa-4096, ecdsa-p256, ecdsa-p384, ecdsa-p521)"
msgstr ""
"-t TYPE                        Certifikattyp\n"
"                               (rsa-2048, rsa-3072, rsa-4096, ecdsa-p256, ecdsa-p384, ecdsa-p521)"

msgid ""
"-u USAGE                       Comma-delimited key usage\n"
"                               (digitalSignature, nonRepudiation, keyEncipherment, dataEncipherment, keyAgreement, keyCertSign, cRLSign, encipherOnly, decipherOnly, default-ca, default-tls)"
msgstr ""
"-u USAGE                       Kommaavgränsad nyckelanvändning\n"
"                               (digitalSignature, nonRepudiation, keyEncipherment, dataEncipherment, keyAgreement, keyCertSign, cRLSign, encipherOnly, decipherOnly, default-ca, default-tls)"

#, c-format
msgid "Bad \"attributes-natural-language\" value '%s'."
msgstr "Ogiltigt värde för \"attributes-natural-language\": '%s'."

msgid "Bad JOB_PRINTER_URI variable."
msgstr "Felaktig JOB_PRINTER_URI-variabel."

msgid "Bad certificate."
msgstr "Felaktigt certifikat."

msgid "Bad extKeyUsage extension in X.509 certificate request."
msgstr "Felaktig extKeyUsage-utökning i X.509-certifikatbegäran."

msgid "Bad keyUsage extension in X.509 certificate request."
msgstr "Felaktig keyUsage-utökning i X.509-certifikatbegäran."

#, c-format
msgid "Bad notify-recipient-uri URI \"%s\"."
msgstr "Felaktig notify-recipient-uri-URI \"%s\"."

msgid "Bad private key."
msgstr "Felaktig privat nyckel."
