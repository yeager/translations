#, c-format
msgid "Directory \"%s\" permissions OK (0%o/uid=%d/gid=%d)."
msgstr "Rättigheterna för katalogen \"%s\" är OK (0%o/uid=%d/gid=%d)."

#, c-format
msgid "File \"%s\" permissions OK (0%o/uid=%d/gid=%d)."
msgstr "Rättigheterna för filen \"%s\" är OK (0%o/uid=%d/gid=%d)."

#, c-format
msgid "The printer-uri \"%s\" contains invalid characters."
msgstr "Printer-URI:n ”%s” innehåller ogiltiga tecken."

msgid "The printer-uri must be of the form \"ipp://HOSTNAME/classes/CLASSNAME\"."
msgstr "Printer-URI:n måste ha formatet ”ipp://VÄRDNAMN/classes/KLASSNAMN”."

msgid ""
"The printer-uri must be of the form \"ipp://HOSTNAME/printers/PRINTERNAME\"."
msgstr ""
"Printer-URI:n måste ha formatet ”ipp://VÄRDNAMN/printers/SKRIVARNAMN”."

#, c-format
msgid "Unsupported number-up value %d, using number-up=1."
msgstr "Värdet %d för number-up stöds inte; number-up=1 används."

#, c-format
msgid "Unsupported number-up-layout value %s, using number-up-layout=lrtb."
msgstr ""
"Värdet %s för number-up-layout stöds inte; number-up-layout=lrtb används."

#, c-format
msgid "Unsupported page-border value %s, using page-border=none."
msgstr "Värdet %s för page-border stöds inte; page-border=none används."
