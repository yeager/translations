msgid "Unable to get authorization server information"
msgstr "Det gick inte att hämta information om auktoriseringsservern"

msgid "Unable to import X.509 certificate request."
msgstr "Det gick inte att importera X.509-certifikatbegäran."

msgid "Unable to load X.509 CA certificate and private key."
msgstr "Det gick inte att läsa in X.509-CA-certifikat och privat nyckel."

msgid "Unable to read IPP attribute name."
msgstr "Det gick inte att läsa IPP-attributnamnet."

msgid "Unable to verify X.509 certificate request."
msgstr "Det gick inte att verifiera X.509-certifikatbegäran."

msgid "Unable to write X.509 certificate signing request."
msgstr "Det gick inte att skriva X.509-certifikatsigneringsbegäran."

#, c-format
msgid "Unsupported \"attributes-charset\" value '%s'."
msgstr "Värdet '%s' för \"attributes-charset\" stöds inte."

#, c-format
msgid "Unsupported '%s' value."
msgstr "Värdet '%s' stöds inte."

msgid "Usage: cups-oauth [OPTIONS] [SUB-COMMAND [ARGUMENT(S)]]"
msgstr "Användning: cups-oauth [FLAGGOR] [UNDERKOMMANDO [ARGUMENT]]"

msgid "Usage: cups-x509 [OPTIONS] [SUB-COMMAND] [ARGUMENT]"
msgstr "Användning: cups-x509 [FLAGGOR] [UNDERKOMMANDO] [ARGUMENT]"

#, c-format
msgid "User Code: %s"
msgstr "Användarkod: %s"

msgid "Validation of subjectAltName in X.509 certificate request failed."
msgstr "Validering av subjectAltName i X.509-certifikatbegäran misslyckades."
