msgid "Bad subjectAltName extension in X.509 certificate request."
msgstr "Felaktig subjectAltName-utökning i X.509-certifikatbegäran."

msgid "Cannot specify both 'finishings' and 'finishings-col'."
msgstr "Det går inte att ange både 'finishings' och 'finishings-col'."

msgid "Cannot specify both 'media' and 'media-col'."
msgstr "Det går inte att ange både 'media' och 'media-col'."

msgid ""
"Cannot specify both notify-pull-method and notify-recipient-uri in the same "
"request."
msgstr ""
"Det går inte att ange både notify-pull-method och notify-recipient-uri i "
"samma begäran."

#, c-format
msgid "Couldn't resolve mDNS URI \"%s\"."
msgstr "Det gick inte att slå upp mDNS-URI:n \"%s\"."

msgid "Credentials are OK/trusted."
msgstr "Autentiseringsuppgifterna är korrekta/tillförlitliga."

msgid "Credentials do not validate against CA certificates."
msgstr "Autentiseringsuppgifterna valideras inte mot CA-certifikaten."

#, c-format
msgid "Device Code: %s"
msgstr "Enhetskod: %s"

msgid "Device authorization grant is not supported by this server."
msgstr "Den här servern stöder inte auktoriseringsbeviljande för enheter."

#, c-format
msgid "File device URI \"%s\" is not allowed."
msgstr "Enhets-URI:n för fil \"%s\" är inte tillåten."

msgid "Home"
msgstr "Hem"

msgid "IP address is not allowed as hostname when using Negotiate - use FQDN."
msgstr ""
"En IP-adress är inte tillåten som värdnamn vid användning av Negotiate – "
"använd FQDN."
