#, c-format
msgid "cups-x509: Unable to allocate memory for '%s': %s"
msgstr "cups-x509: det gick inte att allokera minne för '%s': %s"

#, c-format
msgid "cups-x509: Unable to connect to '%s': %s"
msgstr "cups-x509: det gick inte att ansluta till '%s': %s"

#, c-format
msgid "cups-x509: Unable to create certificate (%s)"
msgstr "cups-x509: det gick inte att skapa certifikatet (%s)"

#, c-format
msgid "cups-x509: Unable to create certificate request (%s)"
msgstr "cups-x509: det gick inte att skapa certifikatbegäran (%s)"

#, c-format
msgid "cups-x509: Unable to encrypt connection: %s"
msgstr "cups-x509: det gick inte att kryptera anslutningen: %s"

#, c-format
msgid "cups-x509: Unable to get generated certificate for '%s'."
msgstr "cups-x509: det gick inte att hämta det skapade certifikatet för '%s'."

#, c-format
msgid "cups-x509: Unable to get generated certificate request for '%s'."
msgstr ""
"cups-x509: det gick inte att hämta den skapade certifikatbegäran för '%s'."

#, c-format
msgid "cups-x509: Unable to get generated private key for '%s'."
msgstr ""
"cups-x509: det gick inte att hämta den skapade privata nyckeln för '%s'."

#, c-format
msgid "cups-x509: Unable to listen on port %d: %s"
msgstr "cups-x509: det gick inte att lyssna på port %d: %s"

#, c-format
msgid "cups-x509: Unable to read '%s'."
msgstr "cups-x509: det gick inte att läsa '%s'."

#, c-format
msgid "cups-x509: Unable to stat '%s': %s"
msgstr "cups-x509: det gick inte att hämta filstatus för '%s': %s"

msgid "get-access-token [RESOURCE]    Get the current access token"
msgstr "get-access-token [RESURS]    Hämta den aktuella åtkomsttoken"
