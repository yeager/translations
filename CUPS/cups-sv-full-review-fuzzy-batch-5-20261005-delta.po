msgid "Unable to import credentials."
msgstr "Det gick inte att importera autentiseringsuppgifter."

msgid "Unable to initialize private key context."
msgstr "Det gick inte att initiera kontexten för den privata nyckeln."

#, c-format
msgid "Unable to read generated PPD: %s"
msgstr "Det gick inte att läsa den skapade PPD-filen: %s"

#, c-format
msgid "Unable to run cups-driverd: %s"
msgstr "Det gick inte att köra cups-driverd: %s"

#, c-format
msgid "Unable to save PPD file: %s"
msgstr "Det gick inte att spara PPD-filen: %s"

#, c-format
msgid "Unable to save value for \"%s\" with a temporary printer."
msgstr "Det gick inte att spara värdet för \"%s\" med en tillfällig skrivare."

msgid "Unable to write X.509 certificate."
msgstr "Det gick inte att skriva X.509-certifikatet."

msgid "Unable to write private key."
msgstr "Det gick inte att skriva den privata nyckeln."
