#. Weblate unit ID: 214506444
msgctxt "214506444"
msgid "\"%s\": Bad %s value \"%s\" - UTF-16 surrogate U+%04X (RFC 3629 section 3)."
msgstr "\"%s\": Ogiltigt %s-värde \"%s\": UTF-16-surrogatet U+%04X (RFC 3629, avsnitt 3)."

#. Weblate unit ID: 214506445
msgctxt "214506445"
msgid "\"%s\": Bad %s value \"%s\" - character U+%04X out of range (RFC 3629 section 3)."
msgstr "\"%s\": Ogiltigt %s-värde \"%s\": tecknet U+%04X ligger utanför intervallet (RFC 3629, avsnitt 3)."

#. Weblate unit ID: 214506446
msgctxt "214506446"
msgid "\"%s\": Bad %s value \"%s\" - leading byte order mark (RFC 5198)."
msgstr "\"%s\": Ogiltigt %s-värde \"%s\": inledande byteordningsmarkering (RFC 5198)."

#. Weblate unit ID: 214506447
msgctxt "214506447"
msgid "\"%s\": Bad %sd value \"%s\" - overlong UTF-8 sequence (RFC 3629 section 3)."
msgstr "\"%s\": Ogiltigt %sd-värde \"%s\": för lång UTF-8-sekvens (RFC 3629, avsnitt 3)."

#. Weblate unit ID: 214506448
msgctxt "214506448"
msgid "\"%s\": Bad text value \"%s\" - CR without LF (RFC 5198 section 2)."
msgstr "\"%s\": Felaktigt textvärde \"%s\": CR utan LF (RFC 5198, avsnitt 2)."

#. Weblate unit ID: 214506449
msgctxt "214506449"
msgid "%s: Cannot specify --oauth-uri and --password at the same time."
msgstr "%s: Det går inte att ange --oauth-uri och --password samtidigt."

#. Weblate unit ID: 214506450
msgctxt "214506450"
msgid "%s: Cannot specify --oauth-uri, --pam-service, and --password at the same time."
msgstr "%s: Det går inte att ange --oauth-uri, --pam-service och --password samtidigt."

#. Weblate unit ID: 214506451
msgctxt "214506451"
msgid "%s: Missing password after '--password'."
msgstr "%s: Lösenord saknas efter '--password'."

#. Weblate unit ID: 214506452
msgctxt "214506452"
msgid "%s: Missing scope(s) after '--oauth-scopes'."
msgstr "%s: En eller flera OAuth-omfattningar saknas efter '--oauth-scopes'."

#. Weblate unit ID: 214506453
msgctxt "214506453"
msgid "%s: Missing/bad URI after '--oauth-uri'."
msgstr "%s: URI saknas eller är felaktig efter '--oauth-uri'."

#. Weblate unit ID: 214506454
msgctxt "214506454"
msgid "%s: Unable to get metadata for OAuth Authorization Server '%s': %s"
msgstr "%s: Det gick inte att hämta metadata för OAuth-auktoriseringsservern '%s': %s"

#. Weblate unit ID: 214506455
msgctxt "214506455"
msgid "--oauth-scopes SCOPE[,...]     Use the specified OAuth scopes"
msgstr "--oauth-scopes SCOPE[,...]     Använd angivna OAuth-omfattningar"

#. Weblate unit ID: 214506456
msgctxt "214506456"
msgid "--oauth-uri AS-URI             Use the specified OAuth Authorization Server"
msgstr "--oauth-uri AS-URI             Använd angiven OAuth-auktoriseringsserver"

#. Weblate unit ID: 214506457
msgctxt "214506457"
msgid "--password PASSWORD            Use the specified password to authenticate"
msgstr "--password PASSWORD            Använd angivet lösenord för autentisering"

#. Weblate unit ID: 214506458
msgctxt "214506458"
msgid "Bad Unicode escape."
msgstr "Felaktig Unicode-escape-sekvens."

#. Weblate unit ID: 214506459
msgctxt "214506459"
msgid "Credentials do not validate against CA certificates."
msgstr "Inloggningsuppgifterna kan inte valideras mot CA-certifikaten."

#. Weblate unit ID: 215541972
msgctxt "215541972"
msgid "Bad JWT signature."
msgstr "Felaktig JWT-signatur."

#. Weblate unit ID: 215541978
msgctxt "215541978"
msgid "Unable allocate memory for signature."
msgstr "Det gick inte att allokera minne för signaturen."

#. Weblate unit ID: 215541980
msgctxt "215541980"
msgid "Unable to decode JOSE header."
msgstr "Det gick inte att avkoda JOSE-huvudet."

#. Weblate unit ID: 215541982
msgctxt "215541982"
msgid "Unable to decode JWT claims."
msgstr "Det gick inte att avkoda JWT-anspråken."

#. Weblate unit ID: 215541985
msgctxt "215541985"
msgid "Unable to decode JWT payload data."
msgstr "Det gick inte att avkoda JWT-nyttolastdata."

#. Weblate unit ID: 215541987
msgctxt "215541987"
msgid "Unable to decode JWT protected data."
msgstr "Det gick inte att avkoda JWT-skyddade data."

#. Weblate unit ID: 215541989
msgctxt "215541989"
msgid "Unable to decode JWT signature."
msgstr "Det gick inte att avkoda JWT-signaturen."

#. Weblate unit ID: 215541991
msgctxt "215541991"
msgid "Unable to find JWT payload data."
msgstr "Det gick inte att hitta JWT-nyttolastdata."

#. Weblate unit ID: 215541994
msgctxt "215541994"
msgid "Unable to find JWT protected data."
msgstr "Det gick inte att hitta JWT-skyddade data."

#. Weblate unit ID: 215541996
msgctxt "215541996"
msgid "Unable to find JWT signature."
msgstr "Det gick inte att hitta JWT-signaturen."
