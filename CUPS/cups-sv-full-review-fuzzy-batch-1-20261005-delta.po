msgid "  -i MIME/TYPE            Set input MIME type (otherwise auto-typed)."
msgstr "  -i MIME/TYPE            Ange MIME-indatatyp (autotypas annars)."

msgid ""
"  -j JOB-ID[,N]           Filter file N from the specified job (default is "
"file 1)."
msgstr ""
"  -j JOB-ID[,N]           Filtrera fil N från angivet jobb (standard är fil "
"1)."

msgid ""
"  -m MIME/TYPE            Set output MIME type (otherwise application/pdf)."
msgstr ""
"  -m MIME/TYPE            Ange MIME-utdatatyp (annars application/pdf)."

msgid "  -n COPIES               Set number of copies."
msgstr "  -n COPIES               Ange antal kopior."

msgid "  -o NAME=VALUE           Set option(s)."
msgstr "  -o NAME=VALUE           Ange flagga eller flaggor."

#, c-format
msgid ""
"%s: Error - need \"completed\", \"not-completed\", \"successful\", or "
"\"all\" after \"-W\" option."
msgstr ""
"%s: Fel – \"completed\", \"not-completed\", \"successful\" eller \"all\" "
"krävs efter flaggan \"-W\"."

#, c-format
msgid "%s: Missing client name after '--client-name'."
msgstr "%s: klientnamn saknas efter '--client-name'."

#, c-format
msgid "%s: Scheduler is not running."
msgstr "%s: schemaläggaren körs inte."
