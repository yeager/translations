msgid "cups-x509: Bad HTTP version."
msgstr "cups-x509: felaktig HTTP-version."

#, c-format
msgid "cups-x509: Bad certificate type '%s'."
msgstr "cups-x509: felaktig certifikattyp '%s'."

#, c-format
msgid "cups-x509: Bad key usage '%s'."
msgstr "cups-x509: felaktig nyckelanvändning '%s'."

#, c-format
msgid "cups-x509: Bad purpose '%s'."
msgstr "cups-x509: felaktigt syfte '%s'."

