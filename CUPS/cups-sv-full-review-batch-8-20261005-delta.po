msgstr "cups-x509: klienten stängde anslutningen."

msgid "cups-x509: Missing CSR filename after '-R'."
msgstr "cups-x509: CSR-filnamn saknas efter '-R'."

msgid "cups-x509: Missing certificate type after '-t'."
msgstr "cups-x509: certifikattyp saknas efter '-t'."

