"--pam-service SERVICE          Use the named PAM service" = "--pam-service SERVICE          Använd angiven PAM-tjänst";
"--path REGEX                   Match resource path to regular expression" = "--path REGEX                   Matcha resurssökväg mot reguljärt uttryck";
"--pin                          Pin certificate found by client command" = "--pin                          Fäst certifikatet som klientkommandot hittade";
"--port NUMBER[-NUMBER]         Match port to number or range" = "--port NUMBER[-NUMBER]         Matcha port mot nummer eller intervall";
"--print                        Print URI if true" = "--print                        Skriv ut URI om villkoret är sant";
"--print-name                   Print service name if true" = "--print-name                   Skriv ut tjänstnamn om villkoret är sant";
"--quiet                        Quietly report match via exit code" = "--quiet                        Rapportera matchning tyst via slutkod";
"--remote                       True if service is remote" = "--remote                       Sant om tjänsten är fjärransluten";
"--require-ca                   Require CA-signed certificate for client command" = "--require-ca                   Kräv CA-signerat certifikat för klientkommandot";
"--stop-after-include-error     Stop tests after a failed INCLUDE" = "--stop-after-include-error     Stoppa tester efter ett misslyckat INCLUDE";
"--true                         Always true" = "--true                         Alltid sant";
