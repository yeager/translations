#, c-format
msgid "%s attributes cannot be supplied in a job creation request."
msgstr ""
"Attribut av typen %s kan inte anges i en begäran om att skapa ett jobb."

#, c-format
msgid "%s: '-i' and '-n' are incompatible with '--ippfile', '-P', and '-X'."
msgstr "%s: '-i' och '-n' kan inte användas med '--ippfile', '-P' och '-X'."

#, c-format
msgid "%s: File '%s' is too large to load in memory."
msgstr "%s: Filen '%s' är för stor för att läsas in i minnet."

#, c-format
msgid "%s: Missing user agent after '--user-agent'."
msgstr "%s: Användaragent saknas efter '--user-agent'."

#, c-format
msgid "%s: Unable to access '%s': %s"
msgstr "%s: Det går inte att komma åt '%s': %s"

#, c-format
msgid "%s: Unable to allocate memory for '%s': %s"
msgstr "%s: Det gick inte att allokera minne för '%s': %s"

#, c-format
msgid "%s: Unable to open '%s': %s"
msgstr "%s: Det gick inte att öppna '%s': %s"

#, c-format
msgid "%s: Unable to read '%s': %s"
msgstr "%s: Det gick inte att läsa '%s': %s"

msgid "--user-agent USER-AGENT Set the HTTP User-Agent string"
msgstr "--user-agent USER-AGENT Ange HTTP User-Agent-strängen"

msgid "-P filename.ppd         Load printer attributes from PPD file"
msgstr "-P filename.ppd         Läs in skrivarattribut från PPD-fil"

msgid ""
"-a OAUTH-URI                   Specify the OAuth authorization server URL"
msgstr ""
"-a OAUTH-URI                   Ange webbadressen till OAuth-"
"auktoriseringsservern"

msgid "-a SUBJECT-ALT-NAME            Add a subjectAltName."
msgstr "-a SUBJECT-ALT-NAME            Lägg till ett subjectAltName."
