msgid "cups-oauth: Missing resource URI and/or access token."
msgstr "cups-oauth: resurs-URI och/eller åtkomsttoken saknas."

msgid "cups-oauth: Missing resource URI and/or device token."
msgstr "cups-oauth: resurs-URI och/eller enhetstoken saknas."

msgid "cups-oauth: Missing scope(s) after '-s'."
msgstr "cups-oauth: omfattning(ar) saknas efter '-s'."

msgid "cups-oauth: No authorization server specified."
msgstr "cups-oauth: ingen auktoriseringsserver har angetts."

#, c-format
msgid "cups-oauth: Unable to get access token from '%s': %s"
msgstr "cups-oauth: det gick inte att hämta åtkomsttoken från '%s': %s"

#, c-format
msgid "cups-oauth: Unable to get authorization from '%s': %s"
msgstr "cups-oauth: det gick inte att hämta auktorisering från '%s': %s"

#, c-format
msgid "cups-oauth: Unable to get device authorization from '%s': %s"
msgstr "cups-oauth: det gick inte att hämta enhetsauktorisering från '%s': %s"

#, c-format
msgid "cups-oauth: Unable to get device token from '%s': %s"
msgstr "cups-oauth: det gick inte att hämta enhetstoken från '%s': %s"

#, c-format
msgid "cups-oauth: Unable to get metadata for '%s': %s"
msgstr "cups-oauth: det gick inte att hämta metadata för '%s': %s"

#, c-format
msgid "cups-oauth: Unable to get user ID for '%s': %s"
msgstr "cups-oauth: det gick inte att hämta användar-ID för '%s': %s"

#, c-format
msgid "cups-oauth: Unknown command '%s'."
msgstr "cups-oauth: okänt kommando '%s'."

#, c-format
msgid "cups-x509: Bad DAYS value '%s' after '-d'."
msgstr "cups-x509: felaktigt DAYS-värde '%s' efter '-d'."
