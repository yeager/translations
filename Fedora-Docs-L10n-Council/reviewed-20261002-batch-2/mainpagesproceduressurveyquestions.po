#: pages/procedures/survey/questions.adoc:31
#, no-wrap
msgid "Changelog"
msgstr "Ändringslogg"

#. type: Plain text
#: pages/procedures/survey/questions.adoc:33
msgid ""
"2023: Add Developer role, removed Ask and Twitter, added a question on "
"membership in leadership teams."
msgstr ""
"2023: Lade till rollen utvecklare, tog bort Ask och Twitter samt lade till "
"en fråga om medlemskap i ledningsteam."

#. type: Plain text
#: pages/procedures/survey/questions.adoc:34
msgid ""
"2022: Added more variants for many answers based on previous survey answers."
msgstr ""
"2022: Lade till fler varianter för många svar utifrån svar i tidigare "
"enkäter."

