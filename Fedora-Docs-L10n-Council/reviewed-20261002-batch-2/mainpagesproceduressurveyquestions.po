#: pages/procedures/survey/questions.adoc:23
#, no-wrap
msgid "How to contact someone about issues with the survey"
msgstr "Så kontaktar du någon vid frågor om enkäten"

#. type: Plain text
#: pages/procedures/survey/questions.adoc:25
msgid "Send an email to fca@fedoraproject.org."
msgstr "Skicka e-post till fca@fedoraproject.org."

#. type: Labeled list
#: pages/procedures/survey/questions.adoc:26
#, no-wrap
msgid "Survey open and close dates"
msgstr "Enkätens öppnings- och stängningsdatum"

#. type: Plain text
#: pages/procedures/survey/questions.adoc:28
msgid "<June 1st - 30th>"
msgstr "<1–30 juni>"

#. type: Plain text
#: pages/procedures/survey/questions.adoc:30
msgid "Don't forget to claim your Survey Taker badge after you click \"Submit\"!"
msgstr ""
"Glöm inte att hämta ditt märke för enkätbesvarare när du har klickat på "
