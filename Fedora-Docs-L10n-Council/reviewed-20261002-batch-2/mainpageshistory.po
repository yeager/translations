#: pages/history.adoc:123
#, no-wrap
#| msgid "History of Fedora Board Membership"
msgid "Fedora Board Membership"
msgstr "Medlemmar i Fedorastyrelsen"

#. type: Plain text
#: pages/history.adoc:127
#| msgid ""
#| "The Fedora Board was the Project's top-level governance body from July 2007 "
#| "to November 2014. Before that, the \"Fedora Advisory Board\" was merely (as "
#| "the name suggests) advisory and had no formal membership."
msgid ""
"The Fedora Board was the Project's top-level governance body from July 2007 "
"to November 2014.  Before that, the \"Fedora Advisory Board\" was merely (as"
" the name suggests) advisory and had no formal membership."
msgstr ""
"Fedorastyrelsen var projektets högsta styrande organ från juli 2007 till "
"november 2014.  Dessförinnan var ”Fedora Advisory Board” endast, som namnet "
"antyder, rådgivande och hade inga formella medlemmar."

