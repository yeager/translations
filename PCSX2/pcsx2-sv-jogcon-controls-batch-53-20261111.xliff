<trans-unit id="11994"><source>Dial Deadzone</source><target state="translated">Rattens dödzon</target></trans-unit>
<trans-unit id="11996"><source>Sets the dial deadzone. Inputs below this value will not be sent to the PS2.</source><target state="translated">Anger rattens dödzon. Inmatning under detta värde skickas inte till PS2.</target></trans-unit>
<trans-unit id="11998"><source>Dial Sensitivity</source><target state="translated">Rattkänslighet</target></trans-unit>
<trans-unit id="12020"><source>Twist Deadzone</source><target state="translated">Vridningsdödzon</target></trans-unit>
