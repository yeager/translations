msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Inskickningstjänst för Last.fm"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Inskickningstjänst för Last.fm skickar information om de låtar du lyssnat på i Kodi till Last.fm"

msgctxt "#30000"
msgid "General"
msgstr "Allmänt"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Skicka låtinfo till Last.fm"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Sänd information om strömmande radio till Last.fm"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Last.fm-användarnamn"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Last.fm-lösenord"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Bekräfta Älska/Hata-inskickningar"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Skicka musikvideor till Last.fm"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr "Avancerat"

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "Aktivera loggning"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr "Vid flera artister används endast den första"

# empty strings from id 300010 to 32010
msgctxt "#32011"
msgid "Last.fm"
msgstr "Last.fm"

msgctxt "#32012"
msgid "Do you want to add the current track to your loved tracks?"
msgstr "Vill du lägga till detta spår i dina älskade spår?"

# empty string with id 32013
msgctxt "#32014"
msgid "Added to your loved tracks: '%s'."
msgstr "Tillagt i dina älskade spår: '%s'."

msgctxt "#32015"
msgid "Could not add '%s' to your loved tracks."
msgstr "Kunde inte lägga till '%s' till dina älskade spår."

# empty strings from id 32016 to 32025
msgctxt "#32026"
msgid "Connect to Last.fm failed"
msgstr "Anslutning till Last.fm misslyckades"

msgctxt "#32027"
msgid "No username or password provided"
msgstr "Inget användarnamn eller lösenord angivet"
