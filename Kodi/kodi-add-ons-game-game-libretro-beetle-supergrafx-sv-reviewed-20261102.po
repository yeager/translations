msgctxt "Addon Summary"
msgid "NEC - PC Engine SuperGrafx (Beetle SuperGrafx)"
msgstr "NEC - PC Engine SuperGrafx (Beetle SuperGrafx)"

msgctxt "Addon Description"
msgid ""
"Beetle SuperGrafx is a PC Engine emulator. It was ported from Mednafen PCE "
"Fast to libretro."
msgstr "Beetle SuperGrafx är en PC Engine-emulator. Den portades från Mednafen PCE Fast till libretro."

