msgctxt "#30055"
msgid "Video -> High Resolution. (Needs Restart)"
msgstr "Video -> Hög upplösning (kräver omstart)"

msgctxt "#30056"
msgid "Media -> Floppy Drive Sound"
msgstr "Media -> Diskettstationsljud"

msgctxt "#30057"
msgid "Media -> Floppy Sound Volume"
msgstr "Media -> Volym för diskettljud"

msgctxt "#30058"
msgid "System -> CPU Speed"
msgstr "System -> Processorhastighet"

msgctxt "#30059"
msgid ""
"Uses hatari's polarized lowpass filters on audio to simulate distortion."
msgstr ""
"Använder Hataris polariserade lågpassfilter för ljud för att simulera "
"distorsion."

msgctxt "#30060"
msgid "Disabled"
msgstr "Inaktiverad"

msgctxt "#30061"
msgid "Enabled"
msgstr "Aktiverad"

msgctxt "#30062"
msgid ""
"Loads SYSTEM\\hatari\\hatari.cfg on content start.  Warning.  Overrides "
"everything except for selected TOS image."
msgstr ""
"Läser in SYSTEM\\hatari\\hatari.cfg när innehållet startar. Varning: "
"åsidosätter alla inställningar utom vald TOS-avbildning."

msgctxt "#30063"
msgid "System"
msgstr "System"

msgctxt "#30064"
msgid "Set Machine Type.  Ramsize.  TOS Used.  Enable Fast Boot."
msgstr ""
"Ange maskintyp, RAM-storlek och TOS-avbildning samt aktivera snabbstart."

msgctxt "#30065"
msgid "Pick emulated machine.  ST, STE, TT or Falcon (Needs Restart)"
msgstr "Välj emulerad maskin: ST, STE, TT eller Falcon (kräver omstart)"

msgctxt "#30066"
msgid "ST (1.02, 2.06)"
msgstr "ST (1.02, 2.06)"

msgctxt "#30067"
msgid "STE (1.62, 2.06)"
msgstr "STE (1.62, 2.06)"

msgctxt "#30068"
msgid "TT (3.01, 3.05, 3.06)"
msgstr "TT (3.01, 3.05, 3.06)"

msgctxt "#30069"
msgid "Falcon (4.00 and up)"
msgstr "Falcon (4.00 och senare)"

msgctxt "#30070"
msgid "Set amount of emulated ram.  (Needs Restart)"
msgstr "Ange mängden emulerat RAM (kräver omstart)"

msgctxt "#30071"
msgid "512 KB"
msgstr "512 kB"

msgctxt "#30072"
msgid "1 MB"
msgstr "1 MB"

msgctxt "#30073"
msgid "2 MB"
msgstr "2 MB"

msgctxt "#30074"
msgid "4 MB"
msgstr "4 MB"

msgctxt "#30075"
msgid "8 MB"
msgstr "8 MB"

msgctxt "#30076"
msgid "14 MB"
msgstr "14 MB"

msgctxt "#30077"
msgid ""
"Select from list.\n"
"\n"
"Place TOS images in system\\hatari\\tos\\ folder.\n"
"Defaults to tos.img in SYSTEM folder"
msgstr ""
"Välj i listan.\n"
"\n"
"Placera TOS-avbildningar i mappen system\\hatari\\tos\\.\n"
"Standardvärdet är tos.img i SYSTEM-mappen"

msgctxt "#30078"
msgid "system\\tos.img (not found)"
msgstr "system\\tos.img (hittades inte)"

msgctxt "#30079"
msgid "Enable/Disable fast boot TOS patch."
msgstr "Aktivera/inaktivera TOS-korrigeringen för snabbstart."

msgctxt "#30080"
msgid "Whether to Cold Start or Warm Start on \"Restart\"."
msgstr "Välj kallstart eller varmstart vid ”Starta om”."

msgctxt "#30081"
msgid "Warm Start"
msgstr "Varmstart"

msgctxt "#30082"
msgid "Cold Start"
msgstr "Kallstart"

msgctxt "#30083"
msgid ""
"Set 68000 CPU clock speed. 8 MHz is authentic ST hardware speed. 16 MHz "
"doubles speed for faster loading and gameplay."
msgstr ""
"Ange 68000-processorns klockfrekvens. 8 MHz motsvarar den ursprungliga ST-"
"hårdvarans hastighet. 16 MHz fördubblar hastigheten för snabbare inläsning "
"och spel."

msgctxt "#30084"
msgid "8 MHz (Authentic)"
msgstr "8 MHz (ursprunglig)"

msgctxt "#30085"
msgid "16 MHz (Fast)"
msgstr "16 MHz (snabb)"

msgctxt "#30086"
msgid "Input"
msgstr "Inmatning"

msgctxt "#30087"
msgid "Enable/Disable second joystick, system mouse or system keyboard."
msgstr ""
"Aktivera/inaktivera den andra styrspaken, systemmusen eller "
"systemtangentbordet."

msgctxt "#30088"
msgid ""
"Starts with emulated mouse active on port 1.  Otherwise joystick is active "
"on port 1."
msgstr ""
"Startar med den emulerade musen aktiv på port 1. Annars är styrspaken aktiv "
"på port 1."

msgctxt "#30089"
msgid ""
"Set whether emulated mouse is controlled by left or right analog stick."
msgstr ""
"Välj om den emulerade musen styrs med vänster eller höger analog spak."

msgctxt "#30090"
msgid "Left Analog"
msgstr "Vänster analog spak"

msgctxt "#30091"
msgid "Right Analog"
msgstr "Höger analog spak"

msgctxt "#30092"
msgid "Set the starting mouse speed from 1 to 6.  Default is 2."
msgstr "Ange den inledande mushastigheten från 1 till 6. Standardvärdet är 2."

msgctxt "#30093"
msgid "2 (default)"
msgstr "2 (standard)"

msgctxt "#30094"
msgid "Enables a second joystick on port 2, may conflict with mouse."
msgstr ""
"Aktiverar en andra styrspak på port 2. Kan komma i konflikt med musen."

msgctxt "#30095"
msgid ""
"Prevents input from your sytem mouse device. Gamepad mouse mode (select) is "
"not disabled."
msgstr ""
"Förhindrar inmatning från systemets musenhet. Musläget för handkontroll "
"(Select) inaktiveras inte."

msgctxt "#30096"
msgid "disabled"
msgstr "inaktiverad"

msgctxt "#30097"
msgid "enabled"
msgstr "aktiverad"

msgctxt "#30098"
msgid ""
"Prevents input from your system keyboard. Virtual keyboard is not disabled."
msgstr ""
"Förhindrar inmatning från systemets tangentbord. Det virtuella tangentbordet"
" inaktiveras inte."

msgctxt "#30099"
msgid "Video"
msgstr "Video"

msgctxt "#30100"
msgid "Enable/Disable high resolution or overscan cropping.  Set Frameskip."
msgstr ""
"Aktivera/inaktivera hög upplösning eller beskärning av overscan. Ange "
"överhoppning av bildrutor."

msgctxt "#30101"
msgid ""
"Enable Hi-Resolution (832x576). Disable for standard low/medium resolution "
"(352x240)."
msgstr ""
"Aktivera hög upplösning (832x576). Inaktivera för standardupplösning, "
"låg/medel (352x240)."

msgctxt "#30102"
msgid "Enable for games.  Disable for low/med resolution overscan demos"
msgstr ""
"Aktivera för spel. Inaktivera för overscan-demonstrationer i "
"låg/medelupplösning"

msgctxt "#30103"
msgid ""
"Force refresh rate to Auto, NTSC 60hz or PAL 50hz.  Auto uses selected TOS "
"rate."
msgstr ""
"Tvinga uppdateringsfrekvensen till Auto, NTSC 60 Hz eller PAL 50 Hz. Auto "
"använder frekvensen för vald TOS."

msgctxt "#30104"
msgid "Auto"
msgstr "Auto"

msgctxt "#30105"
msgid "NTSC 60hz"
msgstr "NTSC 60 Hz"

msgctxt "#30106"
msgid "PAL 50hz"
msgstr "PAL 50 Hz"

msgctxt "#30107"
msgid "Disabled, 1-4, Auto (Max 5), Auto (Max 10)."
msgstr "Inaktiverad, 1–4, Auto (max 5), Auto (max 10)."

msgctxt "#30108"
msgid "Auto (Max 5)"
msgstr "Auto (max 5)"

msgctxt "#30109"
msgid "Auto (Max 10)"
msgstr "Auto (max 10)"

msgctxt "#30110"
msgid "Where to display Joystick/Mouse toggle and speed change information"
msgstr ""
"Var information om växling mellan styrspak/mus och hastighetsändringar ska "
"visas"

msgctxt "#30111"
msgid "Off"
msgstr "Av"

msgctxt "#30112"
msgid "Status"
msgstr "Status"

msgctxt "#30113"
msgid "OSD"
msgstr "OSD"

msgctxt "#30114"
msgid "Enable to show activity in Retroarch status display"
msgstr "Aktivera för att visa aktivitet i RetroArchs statusvy"

msgctxt "#30115"
msgid "Media"
msgstr "Media"

msgctxt "#30116"
msgid "Set Fast floppy access and Auto insert drive B."
msgstr "Ange snabb diskettåtkomst och mata in enhet B automatiskt."

msgctxt "#30117"
msgid ""
"Play mechanical floppy drive sounds on disk access. Place floppy.raw (s16le "
"stereo 44100Hz) in RetroArch system dir for custom sound."
msgstr ""
"Spela mekaniska diskettstationsljud vid diskåtkomst. Placera floppy.raw "
"(s16le stereo 44100 Hz) i RetroArchs systemmapp för ett eget ljud."

msgctxt "#30118"
msgid "Volume of the floppy drive sound effect."
msgstr "Volym för diskettstationens ljudeffekt."

msgctxt "#30119"
msgid "25%"
msgstr "25 %"

msgctxt "#30120"
msgid "50%"
msgstr "50 %"

msgctxt "#30121"
msgid "75%"
msgstr "75 %"

msgctxt "#30122"
msgid "100%"
msgstr "100 %"

msgctxt "#30123"
msgid "Decreases the time spent loading from disk."
msgstr "Minskar tiden som används för att läsa in från disk."

msgctxt "#30124"
msgid ""
"Auto inserts disk in Drive B if detected.\n"
"Use only for content that can use two drives.\n"
"M3U loads 2nd entry.  Otherwise looks for \"b\" as last letter before extension."
msgstr ""
"Matar automatiskt in disken i enhet B om den identifieras.\n"
"Använd endast för innehåll som kan använda två enheter.\n"
"M3U läser in den andra posten. Annars söks ”b” som sista bokstav före filändelsen."

msgctxt "#30125"
msgid "Enable/Disable write protection for floppy disks."
msgstr "Aktivera/inaktivera skrivskydd för disketter."

msgctxt "#30126"
msgid "On"
msgstr "På"

msgctxt "#30127"
msgid "Enable/Disable write protection for hard drives."
msgstr "Aktivera/inaktivera skrivskydd för hårddiskar."

