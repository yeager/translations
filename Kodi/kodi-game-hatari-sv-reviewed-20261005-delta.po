msgctxt "#30254"
msgid "Unmapped defaults to turbo fire/Mouse button 2."
msgstr "Ej tilldelad motsvarar som standard turboeld/musknapp 2."

msgctxt "#30255"
msgid ""
"Unmapped defaults to fire/mouse button 1.\n"
"VKBD: Press selected key."
msgstr ""
"Ej tilldelad motsvarar som standard eld/musknapp 1.\n"
"VKBD: Tryck på vald tangent."

msgctxt "#30256"
msgid "VKBD: Toggle.  Remapping overrides VKBD toggle."
msgstr "VKBD: Växla. Ommappning åsidosätter VKBD-växlingen."

msgctxt "#30257"
msgid "VKBD: Toggle 'ShiftLock'. Remapping overrides VKBD function!"
msgstr "VKBD: Växla ”Skiftlås”. Ommappning åsidosätter VKBD-funktionen!"

msgctxt "#30258"
msgid "Unmapped defaults to Joystick/Mouse mode toggle."
msgstr "Ej tilldelad motsvarar som standard växling av styrspaks-/musläge."

msgctxt "#30259"
msgid "Unmapped defaults to Enter/Exit the Hatari Settings."
msgstr ""
"Ej tilldelad motsvarar som standard att öppna/stänga Hatari-inställningarna."

msgctxt "#30260"
msgid "Unmapped defaults to toggle the Status display."
msgstr "Ej tilldelad motsvarar som standard växling av statusvyn."

msgctxt "#30261"
msgid "Unmapped defaults to switch virtual keyboard page."
msgstr ""
"Ej tilldelad motsvarar som standard växling av sida på det virtuella "
"tangentbordet."

msgctxt "#30262"
msgid "Unmapped defaults to decrease mouse speed."
msgstr "Ej tilldelad motsvarar som standard minskad mushastighet."

msgctxt "#30263"
msgid "Unmapped defaults to increase mouse speed."
msgstr "Ej tilldelad motsvarar som standard ökad mushastighet."

msgctxt "#30264"
msgid "Unmapped defaults to space."
msgstr "Ej tilldelad motsvarar som standard blanksteg."

msgctxt "#30265"
msgid ""
"Mouse mode must be off or on right analog.\n"
"Ignored if assigned to VKBD.\n"
msgstr ""
"Musläget måste vara av eller använda höger analog spak.\n"
"Ignoreras om det är tilldelat VKBD.\n"

msgctxt "#30266"
msgid "Mouse mode must be off or on left analog."
msgstr "Musläget måste vara av eller använda vänster analog spak."

