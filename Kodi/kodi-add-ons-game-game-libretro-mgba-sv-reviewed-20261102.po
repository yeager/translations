msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (mGBA)"
msgstr ""

msgctxt "Addon Description"
msgid ""
"mGBA aims to be faster and more accurate than many existing Game Boy Advance "
"emulators, as well as adding features that other emulators lack."
msgstr "mGBA ska vara snabbare och mer exakt än många befintliga Game Boy Advance-emulatorer och dessutom lägga till funktioner som andra emulatorer saknar."

msgctxt "#30001"
msgid "Game Boy Model (Restart)"
msgstr "Game Boy-modell (omstart)"

msgctxt "#30002"
msgid "Use BIOS File if Found (Restart)"
msgstr "Använd BIOS-fil om den hittas (omstart)"

msgctxt "#30003"
msgid "Skip BIOS Intro (Restart)"
msgstr "Hoppa över BIOS-intro (omstart)"

msgctxt "#30004"
msgid "Default Game Boy Palette"
msgstr "Standardpalett för Game Boy"

msgctxt "#30005"
msgid "Hardware Preset Game Boy Palettes (Restart)"
msgstr "Förinställda Game Boy-paletter för maskinvara (omstart)"

msgctxt "#30006"
msgid "Use Super Game Boy Borders (Restart)"
msgstr "Använd Super Game Boy-ramar (omstart)"

msgctxt "#30007"
msgid "Color Correction"
msgstr "Färgkorrigering"

msgctxt "#30008"
msgid "Interframe Blending"
msgstr "Blandning mellan bildrutor"

msgctxt "#30009"
