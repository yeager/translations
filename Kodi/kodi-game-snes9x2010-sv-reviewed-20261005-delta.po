msgstr "Förbättrat MSU-1-ljud"

msgctxt "#30015"
msgid "SuperFX Cycle Accuracy"
msgstr "Cykelnoggrannhet för SuperFX"

msgctxt "#30016"
msgid "Mode 7 - Hires"
msgstr "Mode 7 – hög upplösning"

msgctxt "#30017"
