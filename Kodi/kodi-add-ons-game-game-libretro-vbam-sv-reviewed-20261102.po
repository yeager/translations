msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (VBA-M)"
msgstr "Nintendo - Game Boy Advance (VBA-M)"

msgctxt "Addon Description"
msgid ""
"VBA-M is a Nintendo Game Boy and Game Boy Advance emulator based on the "
"official VisualBoyAdvance by Forgotten and the VBA development team."
msgstr "VBA-M är en Nintendo Game Boy- och Game Boy Advance-emulator baserad på den officiella VisualBoyAdvance av Forgotten och VBA:s utvecklingsteam."

msgctxt "#30001"
msgid "Use Official BIOS (If Available)"
msgstr "Använd officiellt BIOS (om tillgängligt)"

msgctxt "#30002"
