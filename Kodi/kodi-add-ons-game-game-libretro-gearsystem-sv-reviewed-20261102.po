msgid "Sega - MS/GG/SG-1000 (Gearsystem)"
msgstr "Sega - MS/GG/SG-1000 (Gearsystem)"

msgctxt "Addon Description"
msgid ""
"Gearsystem is an open source, cross-platform, Sega Master System / Game "
"Gear / SG-1000 / Othello Multivision emulator."
msgstr "Gearsystem är en plattformsoberoende emulator med öppen källkod för Sega Master System / Game Gear / SG-1000 / Othello Multivision."

