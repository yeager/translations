msgctxt "Addon Summary"
msgid "PVR WMC Client"
msgstr "PVR WMC-klient"

msgctxt "Addon Description"
msgid "A PVR client to interface with Windows Media Center's Recording and EPG services. Thanks to Tomba73 and Hoopsdavis. Special thanks to DBurckh."
msgstr "En PVR-klient som ansluter till Windows Media Centers inspelnings- och EPG-tjänster. Tack till Tomba73 och Hoopsdavis, med ett särskilt tack till DBurckh."

msgctxt "Addon Disclaimer"
msgid "This is experimental software. Use at your own risk."
msgstr "Det här är experimentell programvara. Använd den på egen risk."

msgctxt "#30000"
msgid "Server Hostname or IP"
msgstr "Servernamn eller IP"

msgctxt "#30001"
msgid "Keep IP address to 127.0.0.1, if server is running on this same system"
msgstr "Behåll IP-adressen 127.0.0.1 om servern körs på samma system"

msgctxt "#30002"
msgid "Port Number"
msgstr "Portnummer"

msgctxt "#30003"
msgid "Stream timeout, unknown problem"
msgstr "Tidsgränsen för strömmen överskreds, okänt problem"

msgctxt "#30004"
msgid "No video data found on this channel"
msgstr "Ingen videodata hittades på den här kanalen"

msgctxt "#30005"
msgid "Tuner is needed for recording"
msgstr "Mottagaren behövs för inspelning"

msgctxt "#30006"
msgid "Recording delete failed, file in use or write protected"
msgstr "Kunde inte radera inspelningen. Filen används eller är skrivskyddad"

msgctxt "#30007"
msgid "Recording delete failed, recorded file doesn't exist"
msgstr "Kunde inte radera inspelningen. Den inspelade filen finns inte"

msgctxt "#30008"
msgid "Recording file not found"
msgstr "Inspelningsfil hittades inte"

msgctxt "#30009"
msgid "Alternate channel chosen: "
msgstr "Alternativ kanal vald: "

msgctxt "#30010"
msgid "Alternate time chosen: "
msgstr "Alternativ tid vald: "

msgctxt "#30011"
msgid "Can't start, tuner is no longer available"
msgstr "Kan inte starta, mottagaren är inte längre tillgänglig"

msgctxt "#30012"
msgid "Channel content is protected"
msgstr "Kanalinnehållet är skyddat"

msgctxt "#30013"
msgid "End time increased by "
msgstr "Sluttid ökad med "

msgctxt "#30014"
msgid "Enable SignalStatus calls"
msgstr "Aktivera SignalStatus-förfrågningar"

msgctxt "#30015"
msgid "Refresh SignalStatus Interval (sec)"
msgstr "Uppdateringsintervall för SignalStatus (s)"

msgctxt "#30016"
msgid "Store Resume/Watched status on server"
msgstr "Spara status för återupptagning och sett på servern"

msgctxt "#30017"
msgid "Recorded TV folder not found"
msgstr "Inspelningsmappen hittades inte"

msgctxt "#30018"
msgid "Recorded TV folder cannot be opened"
msgstr "Inspelningsmappen kunde inte öppnas"

msgctxt "#30019"
msgid "ServerWMC version update is available (%s)"
msgstr "En uppdatering av ServerWMC (%s) finns tillgänglig"

msgctxt "#30020"
msgid "All tuners for this channel are busy"
msgstr "Alla mottagare för den här kanalen är upptagna"

msgctxt "#30021"
msgid "LiveTV timed-out"
msgstr "Tidsgränsen för direktsänd tv överskreds"

msgctxt "#30022"
msgid "LiveTV error, exited early"
msgstr "Fel i direktsänd tv, avslutades i förtid"

msgctxt "#30023"
msgid "Recording stream timed-out"
msgstr "Väntetid för inspelningsström överskreds"

msgctxt "#30024"
msgid "Recording stream exited early"
msgstr "Inspelningsström avslutades tidigt"

msgctxt "#30025"
msgid "Use WakeOnLAN to wake up server"
msgstr "Använd WakeOnLAN för att väcka server"

msgctxt "#30026"
msgid "Sending WakeOnLAN to server..."
msgstr "Skickar Wake-on-LAN till servern …"

msgctxt "#30027"
msgid "Time drift between client and backend of %s minutes"
msgstr "Tidsskillnaden mellan klienten och bakänden är %s minuter"

