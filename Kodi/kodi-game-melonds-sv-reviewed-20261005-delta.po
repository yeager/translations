msgctxt "#30012"
msgid "Microphone Input"
msgstr "Mikrofoningång"

msgctxt "#30014"
msgid "Audio Interpolation"
msgstr "Ljudinterpolering"

msgctxt "#30015"
msgid "Touch Mode"
msgstr "Pekläge"

msgctxt "#30018"
msgid "Screen Gap"
msgstr "Avstånd mellan skärmar"

msgctxt "#30019"
msgid "Hybrid Small Screen Mode"
msgstr "Läge för liten skärm i hybridvy"

msgctxt "#30020"
msgid "Hybrid Ratio (OpenGL Only)"
msgstr "Hybridförhållande (endast OpenGL)"

msgctxt "#30021"
msgid "JIT Enable (Restart)"
msgstr "Aktivera JIT (omstart)"

msgctxt "#30022"
msgid "JIT Block Size"
msgstr "Storlek på JIT-block"

msgctxt "#30023"
msgid "JIT Branch Optimisations"
msgstr "Optimering av JIT-grenar"

msgctxt "#30024"
msgid "JIT Literal Optimisations"
msgstr "Optimering av JIT-litteraler"

msgctxt "#30025"
msgid "JIT Fast Memory"
msgstr "Snabbt JIT-minne"

msgctxt "#30026"
msgid "System"
msgstr "System"

msgctxt "#30027"
msgid "Change system settings."
msgstr "Ändra systeminställningar."

msgctxt "#30028"
msgid ""
"Choose if the core should boot the game directly or if it should boot to the"
" DS menu instead (BIOS and firmware files required)."
msgstr ""
"Välj om kärnan ska starta spelet direkt eller starta DS-menyn i stället "
"(BIOS- och fast programvarufiler krävs)."

msgctxt "#30029"
msgid ""
"Use language and username from the DS firmware. When disabled or if firmware"
" file was not found, the username will be provided by the Libretro frontend,"
" if it's empty it will default to 'melonDS'."
msgstr ""
"Använd språk och användarnamn från DS:ens fasta programvara. När funktionen "
"är inaktiverad eller filen med fast programvara inte hittas används "
"användarnamnet från Libretro-gränssnittet. Om det är tomt används ”melonDS”."

msgctxt "#30030"
msgid ""
"Selected language will be used if 'Use Firmware Settings' is disabled or if "
"firmware file was not found."
msgstr ""
"Det valda språket används om ”Använd inställningar för fast programvara” är "
"inaktiverat eller om filen med fast programvara inte hittas."

msgctxt "#30031"
msgid "Video"
msgstr "Video"

msgctxt "#30032"
msgid "Change video settings."
msgstr "Ändra videoinställningar."

msgctxt "#30033"
msgid "Audio"
msgstr "Ljud"

msgctxt "#30034"
msgid "Change audio settings."
msgstr "Ändra ljudinställningar."

msgctxt "#30035"
msgid "Choose the type of noise that will be used as microphone input."
msgstr "Välj vilken typ av brus som ska användas som mikrofoningång."

msgctxt "#30036"
msgid "Screen"
msgstr "Skärm"

msgctxt "#30037"
msgid "Change screen settings."
msgstr "Ändra skärminställningar."

msgctxt "#30038"
msgid "Choose mode for interactions with the touch screen."
msgstr "Välj läge för interaktion med pekskärmen."

msgctxt "#30039"
msgid "Choose if the 'Swap screens' button should work on press or on hold."
msgstr ""
"Välj om knappen ”Byt skärmar” ska fungera vid tryckning eller nedhållning."

msgctxt "#30040"
msgid ""
"Choose how many screens should be displayed and how they should be "
"displayed."
msgstr "Välj hur många skärmar som ska visas och hur de ska visas."

msgctxt "#30041"
msgid "Choose how large the gap between the 2 screens should be."
msgstr "Välj hur stort avståndet mellan de två skärmarna ska vara."

msgctxt "#30042"
msgid ""
"Choose the position of the small screen when using a 'hybrid' mode, or if it"
" should show both screens."
msgstr ""
"Välj positionen för den lilla skärmen när ett hybridläge används, eller om "
"båda skärmarna ska visas."

msgctxt "#30043"
msgid "CPU Emulation"
msgstr "CPU-emulering"

msgctxt "#30044"
msgid "Change CPU emulation settings."
msgstr "Ändra inställningar för CPU-emulering."

msgctxt "#30045"
msgid "Linear"
msgstr "Linjär"

msgctxt "#30046"
msgid "Cosine"
msgstr "Cosinus"

msgctxt "#30047"
msgid "Cubic"
msgstr "Kubisk"

msgctxt "#30048"
msgid "Mouse"
msgstr "Mus"

msgctxt "#30049"
msgid "Touch"
msgstr "Pekning"

msgctxt "#30050"
msgid "Joystick"
msgstr "Styrspak"
