msgstr "386 (långsam) – 386-instruktionsuppsättning med kontroll av minnesbehörighet"

msgctxt "#30376"
msgid "386 (prefetch) - With prefetch queue emulation (only on 'auto' and 'normal' core)"
msgstr "386 (förhämtning) – med emulering av förhämtningskö (endast i kärnorna ”automatiskt” och ”normal”)"

msgctxt "#30377"
msgid "486 (slow) - 486 instruction set with memory privilege checks"
