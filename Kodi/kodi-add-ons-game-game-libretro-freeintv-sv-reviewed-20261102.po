#, ignore-same
msgctxt "Addon Summary"
msgid "Mattel - Intellivision (FreeIntv)"
msgstr "Mattel - Intellivision (FreeIntv)"

msgctxt "Addon Description"
msgid ""
"FreeIntv is a libretro emulation core for the Mattel Intellivision designed "
"for joypad compatibility."
msgstr "FreeIntv är en libretro-emuleringskärna för Mattel Intellivision som är utformad för joypad-kompatibilitet."

#. Empty string with ID 30000
msgctxt "#30001"
msgid "Default Player 1 Controller (Restart)"
msgstr "Standardkontroller för spelare 1 (omstart)"

msgctxt "#30002"
msgid ""
"Onscreen Interactive Keypad Overlays (Restart and Touchscreen/Mouse Required)"
msgstr "Interaktiva knappsatsöverlägg på skärmen (kräver omstart samt pekskärm eller mus)"

# Suggested in Weblate: Inmatning
msgctxt "#30003"
msgid "Input"
msgstr "Inmatning"

msgctxt "#30004"
msgid "Change controller settings."
msgstr "Ändra handkontrollinställningar."

msgctxt "#30005"
msgid ""
"Specify whether the Left or Right Controller is set to Player 1 as the "
"default."
msgstr "Ange om vänster eller höger handkontroll är inställd som spelare 1 som standard."

# Suggested in Weblate: Vänster
msgctxt "#30006"
msgid "Left"
msgstr "Vänster"

# Suggested in Weblate: Höger
msgctxt "#30007"
msgid "Right"
msgstr "Höger"

msgctxt "#30008"
msgid "Display"
msgstr "Visning"

msgctxt "#30009"
msgid "Change display settings."
msgstr "Ändra visningsinställningar."

msgctxt "#30010"
msgid ""
"Enable multi-screen mode with onscreen interactive keypad overlays (370x600 "
"PNG files) and side-by-side game/keypad display. Changing this setting "
"requires a core restart. Mouse or touchscreen input is required to interact "
"with the keypad overlays."
msgstr "Aktivera flerskärmsläge med interaktiva knappsatsöverlägg på skärmen (PNG-filer på 370x600) och sidoordnad visning av spel och knappsats. Ändring av inställningen kräver omstart av kärnan. Mus- eller pekskärmsinmatning krävs för att använda knappsatsöverläggen."

msgctxt "#30011"
msgid "Disabled"
msgstr "Inaktiverad"

msgctxt "#30012"
msgid "Enabled"
msgstr "Aktiverad"
