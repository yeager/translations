msgctxt "#718"
msgid ""
"Send boot config files from /flash, kodi.log, kernel log and Samba configs "
"to http://ix.io, and display the short URL"
msgstr ""
"Skicka startkonfigurationsfilerna från /flash, kodi.log, kärnlogg och Samba-"
"konfigurationer till http://ix.io och visa den korta URL:en"

msgctxt "#719"
msgid ""
"Send boot config files from /flash, kodi_crash.log, kernel log and Samba "
"configs to http://ix.io, and display the short URL"
msgstr ""
"Skicka startkonfigurationsfilerna från /flash, kodi_crash.log, kärnlogg och "
"Samba-konfigurationer till http://ix.io och visa den korta URL:en"

msgctxt "#32031"
msgid "Working..."
msgstr "Arbetar…"

msgctxt "#32032"
msgid "Firmware is up to date."
msgstr "Den fasta programvaran är uppdaterad."

msgctxt "#32150"
msgid "Edit"
msgstr "Redigera"

msgctxt "#32240"
msgid "Wireless Regulatory Domain"
msgstr "Regleringsdomän för trådlöst nätverk"

msgctxt "#32317"
msgid "Thank you"
msgstr "Tack"

msgctxt "#32374"
msgid ""
"Error: Invalid backup file. Filename must end in: .tar, .tar.bz2, .tar.gz, "
".tar.xz, or .tar.zst"
msgstr ""
"Fel: ogiltig säkerhetskopieringsfil. Filnamnet måste sluta med: .tar, "
".tar.bz2, .tar.gz, .tar.xz eller .tar.zst"

msgctxt "#32377"
msgid "Upload latest Kodi log and configs, and view the short URL"
msgstr ""
"Ladda upp den senaste Kodi-loggen och konfigurationerna och visa den korta "
"URL:en"

msgctxt "#32378"
msgid "Upload latest Kodi crash log and configs, and view the short URL"
msgstr ""
"Ladda upp den senaste Kodi-kraschloggen och konfigurationerna och visa den "
"korta URL:en"

msgctxt "#32417"
msgid "Sending..."
msgstr "Skickar…"
