msgctxt "Addon Summary"
msgid "Lua Engine (Lutro)"
msgstr "Lua Engine (Lutro)"

msgctxt "Addon Description"
msgid ""
"Lutro is an experimental Lua game framework for libretro inspired by LÖVE."
msgstr "Lutro är ett experimentellt Lua-spelramverk för libretro inspirerat av LÖVE."

#. Empty string with ID 30000
msgctxt "#30001"
msgid "Mouse Input Device"
msgstr "Musinmatningsenhet"

msgctxt "#30002"
msgid ""
"Select the input device to manage lutro.mouse. 'Mouse' tracks relative "
"movement, while 'Pointer' maps absolute coordinates."
msgstr "Välj inmatningsenhet för lutro.mouse. \"Mus\" följer relativ rörelse, medan \"pekare\" mappar absoluta koordinater."

