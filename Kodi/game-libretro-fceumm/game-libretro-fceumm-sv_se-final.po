msgctxt "#30183"
msgid "Change processor overclocking and emulation accuracy settings affecting low-level performance and compatibility."
msgstr "Ändra inställningar för processoröverklockning och emuleringsnoggrannhet som påverkar prestanda och kompatibilitet på låg nivå."

msgctxt "#30184"
msgid "No Sprite Limit"
msgstr "Ingen gräns för sprites"

msgctxt "#30185"
msgid "Removes the 8-per-scanline hardware limit. This reduces sprite flickering but can cause some games to glitch since some use this for effects."
msgstr "Tar bort maskinvarans gräns på 8 sprites per skanningsrad. Detta minskar spriteflimmer men kan orsaka fel i vissa spel, eftersom en del använder gränsen för effekter."

msgctxt "#30186"
msgid "Overclock"
msgstr "Överklockning"

msgctxt "#30187"
msgid "Enables or disables overclocking, which can reduce slowdowns in some games. Postrender method is more compatible with every game, Vblank is more effective for games like Contra Force."
msgstr "Aktiverar eller inaktiverar överklockning, vilket kan minska inbromsningar i vissa spel. Postrender-metoden är mer kompatibel med alla spel, medan Vblank är effektivare för spel som Contra Force."

msgctxt "#30188"
msgid "2x-Postrender"
msgstr "2× postrender"

msgctxt "#30189"
msgid "2x-VBlank"
msgstr "2× Vblank"

msgctxt "#30190"
msgid "RAM Power-On Fill (Restart Required)"
msgstr "RAM-fyllning vid påslagning (omstart krävs)"

msgctxt "#30191"
msgid "RAM values on power up. Some games rely on initial RAM values for random number generation as an example."
msgstr "RAM-värden vid påslagning. Vissa spel använder till exempel de ursprungliga RAM-värdena för att generera slumptal."

msgctxt "#30192"
msgid "$FF"
msgstr "$FF"

msgctxt "#30193"
msgid "$00"
msgstr "$00"

msgctxt "#30194"
msgid "Random"
msgstr "Slumpmässigt"
