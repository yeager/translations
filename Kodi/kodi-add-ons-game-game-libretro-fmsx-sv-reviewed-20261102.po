msgctxt "Addon Summary"
msgid "Microsoft - MSX (fMSX)"
msgstr "Microsoft - MSX (fMSX)"

msgctxt "Addon Description"
msgid ""
"fMSX is a MSX emulator written by Marat Fayzullin. It emulates MSX, MSX2, "
"and MSX2+ 8-bit home computers."
msgstr "fMSX är en MSX-emulator skriven av Marat Fayzullin. Den emulerar MSX, MSX2 och MSX2+ 8-bitars hemdatorer."

msgctxt "Addon Disclaimer"
msgid "Image credit: Garage Research Emulators"
msgstr "Bild: Garage Research Emulators"

