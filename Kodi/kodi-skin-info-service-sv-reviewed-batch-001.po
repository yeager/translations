msgstr "Topp 250 måste vara 0–250"

msgctxt "#32027"
msgid "Use Movie Filename Prefix"
msgstr "Använd filnamnsprefix för film"

msgctxt "#32028"
msgid "Save as 'Avatar-poster.jpg' instead of 'poster.jpg' in movie folder"
msgstr "Spara som ”Avatar-poster.jpg” i stället för ”poster.jpg” i filmmappen"

