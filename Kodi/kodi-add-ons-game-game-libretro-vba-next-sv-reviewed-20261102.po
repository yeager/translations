#, ignore-same
msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (VBA Next)"
msgstr "Nintendo - Game Boy Advance (VBA Next)"

msgctxt "Addon Description"
msgid ""
"VBA-Next is a fork from the now inactive VisualBoy Advance project, with "
"goals to improve the compatibility and features of the emulator."
msgstr "VBA-Next är en fork från det nu inaktiva VisualBoy Advance-projektet, med mål att förbättra emulatorns kompatibilitet och funktioner."

msgctxt "#30001"
msgid "Use BIOS if available (Restart)"
msgstr "Använd BIOS om tillgängligt (omstart)"

msgctxt "#30003"
msgid "Enable Turbo Buttons"
msgstr "Aktivera Turbo-knappar"

msgctxt "#30004"
msgid "Turbo Delay in frames"
msgstr "Turbo-fördröjning i bildrutor"

msgctxt "#30005"
msgid "RTC (Restart)"
msgstr "RTC (omstart)"

msgctxt "#30006"
msgid "Threaded Renderer (Restart)"
msgstr "Trådad renderare (omstart)"

msgctxt "#30007"
msgid "Uses BIOS present in RetroArch's system directory."
msgstr "Använder BIOS som finns i RetroArchs systemkatalog."

msgctxt "#30008"
msgid ""
"Controls Real-Time Clock emulation. 'auto' uses the per-ROM override list. "
"'enabled' forces RTC on for any ROM (useful for ROM hacks needing RTC "
"without a matching override). 'disabled' forces RTC off, overriding the "
"override list."
msgstr "Styr emuleringen av realtidsklockan. ”auto” använder listan med åsidosättningar per ROM. ”enabled” tvingar på RTC för alla ROM:ar (användbart för ROM-hack som kräver RTC utan en matchande åsidosättning). ”disabled” tvingar av RTC och åsidosätter listan med åsidosättningar."

msgctxt "#30009"
msgid ""
"Render scanlines on a worker thread.  May reduce stutter on slower CPUs at "
"the cost of slight input-to-display latency.  Restart required for changes "
"to take effect."
msgstr "Återger skanningslinjer i en arbetstråd. Kan minska ryckighet på långsammare processorer på bekostnad av en liten fördröjning från inmatning till visning. Omstart krävs för att ändringarna ska börja gälla."

msgctxt "#30010"
msgid "Enable or disable gamepad turbo buttons."
msgstr "Aktivera eller inaktivera turboknappar på handkontrollen."

msgctxt "#30011"
msgid "Repeat rate of turbo triggers in frames. Higher value triggers more."
msgstr "Upprepningshastighet för turboavtryckare i bildrutor. Högre värde utlöser fler."
