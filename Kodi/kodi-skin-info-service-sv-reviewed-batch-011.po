msgctxt "#32688"
msgid "Favourite TV Shows"
msgstr "Favorit-tv-serier"

msgctxt "#32689"
msgid "Favourite Episodes"
msgstr "Favoritavsnitt"

msgctxt "#32690"
msgid "Favourite Music Videos"
msgstr "Favoritmusikvideor"

msgctxt "#32691"
msgid "Music video thumb source"
msgstr "Källa för miniatyrbild till musikvideo"

#. Options for which image fills an empty music video thumb during automatic
#. fetching
msgctxt "#32692"
msgid "Video screenshots"
msgstr "Videobildrutor"

msgctxt "#32693"
msgid "Album cover"
msgstr "Albumomslag"

msgctxt "#32694"
msgid "Artist thumb"
msgstr "Artistminiatyrbild"

msgctxt "#32695"
msgid "Ratings sources to check (IMDb always on)"
msgstr "Betygskällor att kontrollera (IMDb alltid aktiverat)"

msgctxt "#32696"
msgid "Continue Watching"
msgstr "Fortsätt titta"

msgctxt "#32697"
msgid "Similar Artists"
msgstr "Liknande artister"

msgctxt "#32698"
msgid "Wait 60s and Retry"
msgstr "Vänta 60 s och försök igen"

msgctxt "#32699"
msgid "Retry Tomorrow"
msgstr "Försök igen i morgon"

msgctxt "#32700"
msgid "Stop All Updates"
msgstr "Stoppa alla uppdateringar"

#. {0} is the provider name, e.g. TRAKT
msgctxt "#32701"
msgid "Continue Without {0}"
msgstr "Fortsätt utan {0}"

#. {0} is a web address, {1} a short code the user types there, {2} the
#. seconds left
msgctxt "#32702"
msgid ""
"1. Visit: {0}\n"
"2. Enter code: [B]{1}[/B]\n"
"3. Click Authorize on the website\n"
"\n"
"Waiting for authorization... ({2}s remaining)"
msgstr ""
"1. Besök: {0}\n"
"2. Ange koden: [B]{1}[/B]\n"
"3. Klicka på Auktorisera på webbplatsen\n"
"\n"
"Väntar på auktorisering … ({2} s återstår)"

msgctxt "#32703"
msgid "Person Info"
msgstr "Personinformation"

msgctxt "#32704"
msgid "Scanning {0}"
msgstr "Söker igenom {0}"

msgctxt "#32705"
msgid "ETA {0}"
msgstr "Beräknad tid {0}"

msgctxt "#32706"
msgid "Queued: {0}"
msgstr "I kö: {0}"

msgctxt "#32707"
msgid "Found: {0} | Cached: {1} | Existing: {2}"
msgstr "Hittade: {0} | Cachade: {1} | Befintliga: {2}"

msgctxt "#32708"
msgid "Option {0}"
msgstr "Alternativ {0}"

#. {2} is a language name
msgctxt "#32709"
msgid "{0} of {1} available ({2})"
msgstr "{0} av {1} tillgängliga ({2})"

msgctxt "#32710"
msgid "{0} available"
msgstr "{0} tillgängliga"

#. {0} is an art type such as Fanart or Poster
msgctxt "#32711"
msgid "Multi-Art {0}"
msgstr "Flergrafik {0}"

#. {0} is a media type, {1} a list of art types
msgctxt "#32712"
msgid "Art type not supported for {0}: {1}"
msgstr "Grafiktypen stöds inte för {0}: {1}"

msgctxt "#32713"
msgid "No MusicBrainz ID for this artist"
msgstr "Inget MusicBrainz-ID för den här artisten"

msgctxt "#32714"
msgid "No MusicBrainz ID for this album"
msgstr "Inget MusicBrainz-ID för det här albumet"

msgctxt "#32715"
msgid "Failed to fetch artwork"
msgstr "Kunde inte hämta grafik"

#. {0} is a list of art types
msgctxt "#32716"
msgid "No {0} artwork found"
msgstr "Ingen grafik av typen {0} hittades"

msgctxt "#32717"
msgid "Artwork updated"
msgstr "Grafiken uppdaterades"

msgctxt "#32718"
msgid "Applied: {0} | Skipped: {1} | Auto-skipped: {2}"
msgstr "Tillämpade: {0} | Överhoppade: {1} | Automatiskt överhoppade: {2}"

#. {0} is a library name such as Movies
msgctxt "#32719"
msgid "{0} - Select Action"
msgstr "{0} – välj åtgärd"

#. {0} is a library name such as Movies
msgctxt "#32720"
msgid "No report available for {0}"
msgstr "Ingen rapport tillgänglig för {0}"

msgctxt "#32721"
msgid "No reports available"
msgstr "Inga rapporter tillgängliga"

#. {0} is a library name such as Movies
msgctxt "#32722"
msgid "Auto-Fill {0}"
msgstr "Fyll automatiskt i {0}"

msgctxt "#32723"
msgid ""
"Automatically applies missing artwork without review.[CR]Only fills in "
"missing artwork, won't replace existing.[CR]View results afterwards in "
"Session History.[CR][CR]Continue?"
msgstr ""
"Tillämpa saknad grafik automatiskt utan granskning.[CR]Fyller bara i saknad "
"grafik och ersätter inte befintlig.[CR]Visa resultatet efteråt i "
"Sessionshistorik.[CR][CR]Vill du fortsätta?"

msgctxt "#32724"
msgid "Enter the date as YYYY-MM-DD"
msgstr "Ange datumet som ÅÅÅÅ-MM-DD"

msgctxt "#32725"
msgid "That date cannot exist"
msgstr "Det datumet kan inte finnas"

#. {0} is a field name such as Genre
msgctxt "#32726"
msgid ""
"No existing {0} found in library.[CR]Use Quick Edit or Add/Remove instead."
msgstr ""
"Inget befintligt objekt av typen {0} hittades i biblioteket.[CR]Använd "
"Snabbredigering eller Lägg till/ta bort i stället."

msgctxt "#32727"
msgid "{0} votes"
msgstr "{0} röster"

#. {0} is a field name such as Genre
msgctxt "#32728"
msgid "{0} updated"
msgstr "{0} uppdaterade"

#. {0} is how many more values are not shown
msgctxt "#32729"
msgid "(+{0} more)"
msgstr "(+{0} till)"

#. {0} is the name of the running task
msgctxt "#32730"
msgid "Cancel Current Task: {0}"
msgstr "Avbryt aktuell åtgärd: {0}"

#. {0} is the name of the running task
msgctxt "#32731"
msgid "[B]Currently Running:[/B] {0}"
msgstr "[B]Körs just nu:[/B] {0}"

#. {0} is a time such as 5m 3s
msgctxt "#32732"
msgid "[B]Duration:[/B] {0}"
msgstr "[B]Varaktighet:[/B] {0}"

#. {0} is a time such as 5m 3s
msgctxt "#32733"
msgid "[B]Last Activity:[/B] {0} ago"
msgstr "[B]Senaste aktivitet:[/B] för {0} sedan"

#. {0} is the name of the task about to start
msgctxt "#32734"
msgid "[B]New Task:[/B] {0}"
msgstr "[B]Ny åtgärd:[/B] {0}"

msgctxt "#32735"
msgid "Cancelling will stop the current task safely."
msgstr "Ett avbrott stoppar den aktuella åtgärden på ett säkert sätt."

msgctxt "#32736"
msgid ""
"Not set in Kodi's settings. This folder holds the artwork for movie "
"sets.[CR][CR]Select a folder now?"
msgstr ""
"Inte angivet i Kodis inställningar. Den här mappen innehåller grafik för "
"filmsamlingar.[CR][CR]Vill du välja en mapp nu?"

msgctxt "#32737"
msgid ""
"Not set in Kodi's settings. This folder holds the artwork and metadata for "
"artists.[CR][CR]Select a folder now?"
msgstr ""
"Inte angivet i Kodis inställningar. Den här mappen innehåller grafik och "
"metadata för artister.[CR][CR]Vill du välja en mapp nu?"
