#, ignore-same
msgctxt "Addon Summary"
msgid "Sega - MS/GG (SMS Plus GX)"
msgstr "Sega - MS/GG (SMS Plus GX)"

msgctxt "Addon Description"
msgid ""
"SMS Plus GX is a port of the original Sega Master System emulator for the "
"Nintendo GameCube."
msgstr "SMS Plus GX är en portning av den ursprungliga Sega Master System-emulatorn för Nintendo GameCube."

msgctxt "Addon Disclaimer"
msgid "Ported to libretro by gameblabla"
msgstr "Portad till libretro av gameblabla"

msgctxt "#30001"
msgid "Master System BIOS (Restart Required)"
msgstr "BIOS för Master System (omstart krävs)"

msgctxt "#30002"
msgid "Hardware (Restart Required)"
msgstr "Hårdvara (omstart krävs)"

msgctxt "#30003"
msgid "Region (Restart Required)"
msgstr "Region (omstart krävs)"

msgctxt "#30004"
msgid "Use FM (YM2413) (Restart Required)"
msgstr "Använd FM (YM2413) (Omstart krävs)"

msgctxt "#30005"
msgid "Hide SMS Left Border"
msgstr "Dölj SMS vänster kant"

msgctxt "#30006"
msgid "Blargg NTSC Filter"
msgstr "Blargg NTSC-filter"

msgctxt "#30007"
msgid ""
"Use official BIOS/bootloader for emulated hardware, if present in "
"RetroArch's system directory. Displays console-specific start-up sequence/"
"animation."
msgstr "Använd officiellt BIOS/startprogram för emulerad hårdvara, om det finns i RetroArchs systemkatalog. Visar konsolspecifik uppstartssekvens/-animering."

msgctxt "#30008"
msgid "Emulates which system hardware to use."
msgstr "Emulerar vilken systemhårdvara som ska användas."

msgctxt "#30009"
msgid "Runs console at a specific video timing based on region."
msgstr "Kör konsolen med specifik videorytm baserad på region."

msgctxt "#30010"
msgid ""
"Use FM Sound for some Master System games to enable enhanced music. Some "
"games will only enable YM2413 sound if the Region option is also set to ntsc-"
"j (e.g. Wonder Boy III)."
msgstr "Använd FM-ljud för vissa Master System-spel för att aktivera förbättrad musik. Vissa spel aktiverar endast YM2413-ljud om regionalternativet också är inställt på ntsc-j (till exempel Wonder Boy III)."

msgctxt "#30011"
msgid "Hides left border and center image onscreen."
msgstr "Döljer vänster kant och bildens mitt på skärmen."

msgctxt "#30012"
msgid "Enable blargg NTSC filter."
msgstr "Aktivera blargg NTSC-filter."

