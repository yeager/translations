#. Option to alter the image hue in video settings
msgctxt "#471"
msgid "Hue"
msgstr "Nyans"

#. Option to alter the image saturation in video settings
msgctxt "#472"
msgid "Saturation"
msgstr "Färgmättnad"

#. Label for context menu item on a video source to refresh the library information of all items in it
msgctxt "#13363"
msgid "Refresh all content"
msgstr "Uppdatera allt innehåll"

#. Label for context menu item on a video source to stop refreshing the library information of all items in it
msgctxt "#13364"
msgid "Stop refreshing"
msgstr "Avbryt uppdateringen"

#. Shown on context menu for a Blu-ray disc image, BDMV folder or an already saved bluray://
#. playlist, when further choices (see #13485 and #13486) will be offered
msgctxt "#13484"
msgid "Choose playlist ..."
msgstr "Välj spellista …"

#. Shown on the "Choose playlist ..." context menu of a library item, to assign the chosen
#. Blu-ray playlist to it
msgctxt "#13485"
msgid "and Save"
msgstr "och spara"

#. Shown on the "Choose playlist ..." context menu of a library item, to assign the chosen
#. Blu-ray playlist to it and play it
msgctxt "#13486"
msgid "and Play"
msgstr "och spela"

#. Option to set the granularity (default 1.0) of the brightness/contrast/hue/saturation/gamma settings in video settings
msgctxt "#13602"
msgid "Image adjustment granularity"
msgstr "Stegstorlek för bildjustering"

#. Name of the video filter category that holds the filters without a shader
msgctxt "#16298"
msgid "Built-in"
msgstr "Inbyggd"

#. Label for the optional provider-scoped channel OSD setting
msgctxt "#19358"
msgid "Show channels by provider in channel OSD"
msgstr "Visa kanaler efter leverantör i kanalens OSD"

#. Progress text while extracting an add-on package
msgctxt "#24188"
msgid "Unpacking add-on..."
msgstr "Packar upp tillägg …"

#. Header of the background progress bar when installing an add-on, followed by the percentage
msgctxt "#24189"
msgid "Installing {0:s}"
msgstr "Installerar {0:s}"

#. Error dialog text when an emulator can't find a file it needs, such as a BIOS file. {0:s} - emulator name, {1:s} - file name
msgctxt "#35240"
msgid "The emulator \"{0:s}\" couldn't find {1:s}."
msgstr "Emulatorn \"{0:s}\" kunde inte hitta {1:s}."

#. Error dialog text when an emulator can't find files it needs and doesn't say which. {0:s} - emulator name
msgctxt "#35241"
msgid ""
"The emulator \"{0:s}\" couldn't find files it needs, such as BIOS files."
msgstr ""
"Emulatorn \"{0:s}\" kunde inte hitta filer som den behöver, till exempel "
"BIOS-filer."

#. Help text for the hardcore mode setting
msgctxt "#35302"
msgid ""
"Earn achievements worth double points. Rewind, loading save states, slow "
"motion and cheats are unavailable while this is on, and turning it on "
"restarts the game."
msgstr ""
"Tjäna prestationer värda dubbla poäng. Bakåtspolning, inläsning av sparade "
"lägen, slow motion och fusk är inte tillgängliga när detta är aktiverat, och "
"spelet startas om när det aktiveras."

#. Notification shown when hardcore mode refuses something, {0:s} is the feature
msgctxt "#35305"
msgid "{0:s} is not available"
msgstr "{0:s} är inte tillgänglig"

#. Notification shown when resuming a save state turns hardcore mode off
msgctxt "#35306"
msgid "Hardcore mode turned off. Achievements will be earned in casual mode."
msgstr "Hardcore-läget har stängts av. Prestationer tjänas in i normalt läge."

#. Name of the feature hardcore mode refused, used with #35305
msgctxt "#35308"
msgid "Loading save states"
msgstr "Läser in sparade lägen"

#. Name of the feature hardcore mode refused, used with #35305
msgctxt "#35309"
msgid "Rewind"
msgstr "Spola tillbaka"

#. Label of the Manual button in the game OSD, which shows the game's instruction booklet
msgctxt "#35310"
msgid "Manual"
msgstr "Handbok"

# empty strings from id 35512 to 35699
#. Label of the setting that enables RetroAchievements hardcore mode
msgctxt "#35700"
msgid "Hardcore mode"
msgstr "Hardcore-läge"

#. Name of the feature hardcore mode refused, used with #35305
msgctxt "#35701"
msgid "Slow motion"
msgstr "Slow motion"

#. Confirmation shown before turning hardcore mode on during a game, followed by #19194
msgctxt "#35702"
msgid ""
"Starting a hardcore session restarts the game. Any unsaved progress will be "
"lost."
msgstr ""
"När du startar en hardcore-session startas spelet om. Alla framsteg som inte "
"har sparats går förlorade."

#. Shown as a game with achievements starts in hardcore mode, {0:d} earned of {1:d}
#, c++-format
msgctxt "#35703"
msgid "Hardcore mode: {0:d} of {1:d} achievements unlocked"
msgstr "Hardcore-läge: {0:d} av {1:d} prestationer upplåsta"

# empty strings from id 35704 to 35709
#. Marks a locked achievement that can be missed for good
msgctxt "#35710"
msgid "Missable"
msgstr "Kan missas"

#. Button that picks which of a game's achievement sets is shown
msgctxt "#35711"
msgid "Achievement set"
msgstr "Prestationsuppsättning"

#. An achievement set whose progression and win achievements are all earned
msgctxt "#35712"
msgid "Beaten"
msgstr "Klarad"

#. How close an achievement set is to being beaten, {0:d} earned of {1:d} needed
#, c++-format
msgctxt "#35713"
msgid "{0:d} of {1:d} to beat"
msgstr "{0:d} av {1:d} för att klara"

#. An achievement set the player turned off
msgctxt "#35714"
msgid "Turned off"
msgstr "Avstängd"

#. The game's own achievement set, as opposed to its subsets
msgctxt "#35715"
msgid "Main Set"
msgstr "Huvuduppsättning"

# empty strings from id 35716 to 35717
#. Marks an achievement being attempted in the list of a game's achievements
msgctxt "#35718"
msgid "Attempt active"
msgstr "Försök aktivt"

#. Description of setting with label #13602 "Image adjustment granularity"
msgctxt "#36059"
msgid ""
"Step size of the brightness, contrast, hue and saturation sliders in the "
"video settings."
msgstr ""
"Stegstorlek för reglagen för ljusstyrka, kontrast, nyans och färgmättnad i "
"videoinställningarna."

msgctxt "#36117"
msgid "Render on high-performance GPU"
msgstr "Rendera med högpresterande GPU"

#. Description of setting with label #36117 "Render on high-performance GPU"
msgctxt "#36118"
msgid ""
"On laptops with two GPUs, render on the high-performance GPU even when the "
"display is connected to the other GPU. Frees the CPU's power and memory "
"bandwidth for decoding, but uses more power. Exclusive fullscreen is not "
"available in this mode."
msgstr ""
"På bärbara datorer med två GPU:er renderas bilden med den högpresterande "
"GPU:n även om skärmen är ansluten till den andra GPU:n. Det frigör "
"processorkraft och minnesbandbredd för avkodning, men använder mer energi. "
"Exklusivt helskärmsläge är inte tillgängligt i detta läge."

#. Description of setting with label #19358 "Show channels by provider in channel OSD"
msgctxt "#36462"
msgid ""
"Show only channels from the selected provider and group in the channel OSD. "
"Switching groups also cycles through providers. Switching to the next or "
"previous channel stays within the provider of the playing channel. Disable "
"to use the standard channel group list."
msgstr ""
"Visa endast kanaler från den valda leverantören och gruppen i kanalens OSD. "
"När du byter grupp växlar du också mellan leverantörer. När du byter till "
"nästa eller föregående kanal stannar du inom den uppspelade kanalens "
"leverantör. Inaktivera för att använda standardlistan över kanalgrupper."

# empty strings from id 36643 to 36644
#. Label of setting "Pictures -> Slideshow -> Show date and time metadata on screen"
msgctxt "#36645"
msgid "Show date and time metadata on screen"
msgstr "Visa datum- och tidsmetadata på skärmen"

#. Description of setting "Pictures -> Slideshow -> Show date and time metadata on screen" with label #36645
msgctxt "#36646"
msgid ""
"During a slideshow, show the date and time from a picture's EXIF metadata, "
"if it has them. Not every skin supports this."
msgstr ""
"Visa datum och tid från bildens EXIF-metadata under ett bildspel, om de "
"finns. Alla skal har inte stöd för detta."

#. Title of the setting that chooses if the Dolby Vision extensions is used
msgctxt "#39218"
msgid "Use Dolby Vision extensions"
msgstr "Använd Dolby Vision-tillägg"

#. Help text for setting "Dolby Vision extensions" of label #39218
msgctxt "#39219"
msgid ""
"Use the system Dolby Vision extensions to correctly display Dolby Vision "
"profile 5, 7 (excludes FEL reconstruction), 8 and 10 video."
msgstr ""
"Använd systemets Dolby Vision-tillägg för att visa Dolby Vision-video med "
"profilerna 5, 7 (utan FEL-rekonstruktion), 8 och 10 korrekt."

#. Asked before choosing one of a disc's playlists for an extra that plays the whole disc
msgctxt "#40052"
msgid "Assign a playlist to this extra?"
msgstr "Koppla en spellista till detta extramaterial?"

#. Asked before choosing an extra from the playlists of the movie's own disc
msgctxt "#40053"
msgid "Add an extra from this disc?"
msgstr "Lägg till extramaterial från denna skiva?"

#. Asked when a disc is picked as an extra, to add one of its playlists rather than the whole disc
msgctxt "#40054"
msgid "Choose a playlist from this disc?"
msgstr "Välj en spellista från denna skiva?"

#. Shown when a playlist chosen for an extra already belongs to the same movie, or one chosen for a version is already its extra
msgctxt "#40055"
msgid "This playlist already belongs to this movie."
msgstr "Den här spellistan tillhör redan denna film."

#. Asked before taking a playlist away from another movie's extra that uses it
msgctxt "#40056"
msgid ""
"The selected playlist is already assigned to another extra. Reassign it?"
msgstr ""
"Den valda spellistan är redan kopplad till annat extramaterial. Vill du "
"koppla om den?"

#. Manage video extras context menu item
msgctxt "#40057"
msgid "Manage extras"
msgstr "Hantera extramaterial"

#. Asked when adding an extra while an extra on a disc is selected
msgctxt "#40058"
msgid "Add another extra from this disc?"
msgstr "Lägg till mer extramaterial från denna skiva?"

#. Help for ignore video extras settting
msgctxt "#40205"
msgid ""
"Select scanner action for video extras, in an \"extras\" folder or named by "
"a Blu-ray disc.[CR][Enabled] Leave video extras out of the library, other "
"than those a movie's nfo records.[CR][Disabled] Add video extras to library "
"for associated video."
msgstr ""
"Välj genomsökningsåtgärd för videoextramaterial i en mapp med namnet "
"\"extras\" eller som har identifierats av en Blu-ray-skiva.[CR][Aktiverad] "
"Lämna videoextramaterial utanför biblioteket, utom sådant som finns "
"registrerat i en films NFO-fil.[CR][Inaktiverad] Lägg till "
"videoextramaterial i biblioteket för den tillhörande videon."

#. Setting to retrieve art not cached yet when the video library is exported
msgctxt "#40231"
msgid "Retrieve all art during export"
msgstr "Hämta allt bildmaterial vid export"

#. Help for the retrieve all art during export setting
msgctxt "#40232"
msgid ""
"When exporting the library with images, retrieve art that isn't cached yet. "
"Turn off to only export art that is already cached."
msgstr ""
"Hämta bildmaterial som ännu inte finns i cacheminnet när biblioteket "
"exporteras med bilder. Inaktivera för att endast exportera bildmaterial som "
"redan finns i cacheminnet."

