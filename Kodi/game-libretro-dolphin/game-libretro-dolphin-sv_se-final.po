msgctxt "#30025"
msgid "Core > Emulation Speed"
msgstr "Kärna > Emuleringshastighet"

msgctxt "#30026"
msgid "Set speed limit for emulation."
msgstr "Ställ in hastighetsgräns för emuleringen."

msgctxt "#30027"
msgid "100% (Normal Speed)"
msgstr "100 % (normal hastighet)"

msgctxt "#30028"
msgid "Unlimited"
msgstr "Obegränsad"

msgctxt "#30029"
msgid "Core > Dual Core Mode"
msgstr "Kärna > Dubbelkärnigt läge"

msgctxt "#30030"
msgid "Enable dual-core CPU emulation. Requires core RESTART."
msgstr "Aktivera dubbelkärnig CPU-emulering. Kräver omstart av kärnan."

msgctxt "#30031"
msgid "Disabled"
msgstr "Inaktiverad"

msgctxt "#30032"
msgid "Enabled"
msgstr "Aktiverad"

msgctxt "#30033"
msgid "Core > Load Whole Game Into Memory"
msgstr "Kärna > Läs in hela spelet i minnet"

msgctxt "#30034"
msgid "Load Whole Game Into Memory. Requires core RESTART."
msgstr "Läs in hela spelet i minnet. Kräver omstart av kärnan."

msgctxt "#30035"
msgid "Core > Precision Frame Timing"
msgstr "Kärna > Exakt bildrutetajmning"

msgctxt "#30036"
msgid "Use busy-wait for more accurate frame timing."
msgstr "Använd aktiv väntan för exaktare bildrutetajmning."

msgctxt "#30037"
msgid "Core > Fastmem"
msgstr "Kärna > Fastmem"

msgctxt "#30038"
msgid "Enable fastmem optimization - which uses memory mapping for faster access."
msgstr "Aktivera Fastmem-optimering, som använder minnesmappning för snabbare åtkomst."

msgctxt "#30039"
msgid "Core > Fastmem Arena"
msgstr "Kärna > Fastmem-arena"

msgctxt "#30040"
msgid "Enable fastmem arena - reserves 12 GiB of virtual memory for super fast access."
msgstr "Aktivera Fastmem-arena, som reserverar 12 GiB virtuellt minne för mycket snabb åtkomst."

msgctxt "#30041"
msgid "Core > Accurate CPU cache"
msgstr "Kärna > Exakt CPU-cache"

msgctxt "#30042"
msgid "Enabled - fast, Disabled - guarantees correctness involving cache behaviour."
msgstr "Aktiverad – snabb, inaktiverad – garanterar korrekthet för cachebeteendet."

msgctxt "#30043"
msgid "Core > Internal Cheats"
msgstr "Kärna > Inbyggda fuskkoder"

msgctxt "#30044"
msgid "Enable built-in cheat codes. Restart core to take effect."
msgstr "Aktivera inbyggda fuskkoder. Starta om kärnan för att verkställa."

msgctxt "#30045"
msgid "Core > Skip GameCube BIOS"
msgstr "Kärna > Hoppa över GameCube-BIOS"

msgctxt "#30046"
msgid "Skip the GameCube BIOS animation/menu and start the game directly."
msgstr "Hoppa över GameCube-BIOS-animationen/-menyn och starta spelet direkt."

msgctxt "#30047"
msgid "Core > Disc Based Games Boot to Wii Menu"
msgstr "Kärna > Skivbaserade spel startar i Wii-menyn"

msgctxt "#30048"
msgid "When a Wii System Menu is installed in the save location and the game is a disc based game, it will start the Wii Menu with the disc inserted in the drive instead of directly booting the game. Beware: The game region must match the Wii Menu region otherwise the game will not be recognized."
msgstr "När en Wii-systemmeny är installerad på sparplatsen och spelet är skivbaserat startas Wii-menyn med skivan isatt i enheten i stället för att spelet startas direkt. Observera: spelregionen måste matcha Wii-menyns region, annars känns spelet inte igen."

