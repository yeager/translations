msgctxt "Addon Summary"
msgid "Nintendo - GameCube / Wii (Dolphin)"
msgstr "Nintendo - GameCube / Wii (Dolphin)"

msgctxt "Addon Description"
msgid "Dolphin is an emulator for two recent Nintendo video game consoles: the GameCube and the Wii."
msgstr "Dolphin är en emulator för två av Nintendos senaste videospelskonsoler: GameCube och Wii."

# Empty string with ID 30000
msgctxt "#30001"
msgid "Core"
msgstr "Kärna"

msgctxt "#30002"
msgid "Configure CPU emulation, timing, and core system settings."
msgstr "Konfigurera CPU-emulering, tidsinställning och grundläggande systeminställningar."

msgctxt "#30003"
msgid "Core > CPU Core"
msgstr "Kärna > CPU-kärna"

msgctxt "#30004"
msgid "Select CPU emulation method - JIT provides best performance."
msgstr "Välj CPU-emuleringsmetod – JIT ger bäst prestanda."

msgctxt "#30005"
msgid "Interpreter (slowest)"
msgstr "Tolk (långsammast)"

msgctxt "#30006"
msgid "JIT64 (Recommended)"
msgstr "JIT64 (rekommenderas)"

msgctxt "#30007"
msgid "Cached Interpreter (slower)"
msgstr "Cachelagd tolk (långsammare)"

msgctxt "#30008"
msgid "Core > CPU Clock Rate"
msgstr "Kärna > CPU-klockfrekvens"

msgctxt "#30009"
msgid "Adjust emulated CPU speed."
msgstr "Justera den emulerade CPU-hastigheten."

