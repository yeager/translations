msgstr "Sök kontinuerligt efter Wiimotes."

msgctxt "#30159"
msgid "System Configuration > Alt GC Ports (Wii)"
msgstr "Systemkonfiguration > Alternativa GC-portar (Wii)"

msgctxt "#30160"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Använd port 5–8 för GameCube-handkontroller i Wii-läge."

msgctxt "#30161"
msgid "System Configuration > Bluetooth passthrough mode"
msgstr "Systemkonfiguration > Bluetooth-genomsläppsläge"

msgctxt "#30162"
msgid "Pass all traffic directly to the host's Bluetooth adapter. Press F12 to begin the sync process."
msgstr "Skicka all trafik direkt till värdens Bluetooth-adapter. Tryck på F12 för att starta synkroniseringsprocessen."

msgctxt "#30163"
msgid "System Configuration > Wii Speak"
msgstr "Systemkonfiguration > Wii Speak"

msgctxt "#30164"
msgid "Emulate the Wii Speak microphone. Restart when changing this option."
msgstr "Emulera Wii Speak-mikrofonen. Starta om när alternativet ändras."

msgctxt "#30165"
msgid "Audio > Devices > Wii Speak Muted"
msgstr "Ljud > Enheter > Wii Speak avstängd"

msgctxt "#30166"
msgid "Mute or unmute the Wii Speak microphone."
msgstr "Stäng av eller slå på ljudet för Wii Speak-mikrofonen."

msgctxt "#30167"
msgid "System Configuration > Logitech USB Microphone"
msgstr "Systemkonfiguration > Logitech USB-mikrofon"

msgctxt "#30168"
msgid "Emulate the Logitech USB microphone. Restart when changing this option."
msgstr "Emulera Logitech USB-mikrofonen. Starta om när alternativet ändras."

