msgstr "Koreanska"

msgctxt "#30061"
msgid "Core > Speed Up Disc Transfer"
msgstr "Kärna > Snabba upp skivöverföring"

msgctxt "#30062"
msgid "Reduce loading times."
msgstr "Minska inläsningstiderna."

msgctxt "#30063"
msgid "Core > Enable MMU"
msgstr "Kärna > Aktivera MMU"

msgctxt "#30064"
msgid "Enable emulation of the Memory Management Unit."
msgstr "Aktivera emulering av minneshanteringsenheten."

msgctxt "#30065"
msgid "Core > Rush Frame Presentation"
msgstr "Kärna > Snabb bildrutepresentation"

msgctxt "#30066"
msgid "Enable rushing frame presentation for lower latency."
msgstr "Aktivera snabb bildrutepresentation för lägre fördröjning."

msgctxt "#30067"
msgid "Core > Smooth Early Presentation"
msgstr "Kärna > Mjuk tidig bildrutepresentation"

msgctxt "#30068"
msgid "Enable smoother early frame presentation timing."
msgstr "Aktivera mjukare tajmning för tidig bildrutepresentation."

msgctxt "#30069"
msgid "Audio / DSP"
msgstr "Ljud / DSP"

msgctxt "#30070"
msgid "Configure audio output and DSP emulation."
msgstr "Konfigurera ljudutdata och DSP-emulering."

msgctxt "#30071"
msgid "Audio / DSP > DSP HLE"
msgstr "Ljud / DSP > DSP HLE"

msgctxt "#30072"
msgid "Choose DSP method - HLE is faster, LLE is more accurate."
msgstr "Välj DSP-metod – HLE är snabbare, LLE är exaktare."

msgctxt "#30073"
msgid "HLE (Fast)"
msgstr "HLE (snabb)"

msgctxt "#30074"
msgid "LLE (Accurate)"
msgstr "LLE (exakt)"

msgctxt "#30075"
msgid "Audio / DSP > DSP JIT"
msgstr "Ljud / DSP > DSP JIT"

msgctxt "#30076"
msgid "Enable JIT for DSP LLE."
msgstr "Aktivera JIT för DSP LLE."

msgctxt "#30077"
msgid "Audio / DSP > Async Audio Callback"
msgstr "Ljud / DSP > Asynkront ljudåteranrop"

msgctxt "#30078"
msgid "Use asynchronous audio callbacks."
msgstr "Använd asynkrona ljudåteranrop."

msgctxt "#30079"
msgid "Sync - Dolphin will push samples"
msgstr "Synkront – Dolphin skickar samplingsvärden"

msgctxt "#30080"
msgid "Sync - Per Frame using target refresh rate"
msgstr "Synkront – per bildruta med måluppdateringsfrekvens"

msgctxt "#30081"
msgid "Async - driven by callbacks using refresh rate and audio buffer status"
msgstr "Asynkront – styrs av återanrop med uppdateringsfrekvens och ljudbuffertstatus"

