msgstr "Manuellt"

msgctxt "#30005"
msgid "Color Format (Restart Required)"
msgstr "Färgformat (omstart krävs)"

msgctxt "#30006"
msgid "16-Bit (RGB565)"
msgstr "16-bitars (RGB565)"

msgctxt "#30007"
msgid "32-Bit (RGB8888)"
msgstr "32-bitars (RGB8888)"

msgctxt "#30008"
msgid "Force 60Hz"
msgstr "Tvinga 60 Hz"

msgctxt "#30009"
msgid ""
"Force 60Hz instead of original 75Hz refresh rate, for perfectly smooth "
"movement on 60Hz displays"
msgstr "Tvinga 60 Hz i stället för ursprunglig uppdateringsfrekvens på 75 Hz för helt jämna rörelser på 60 Hz-skärmar"

