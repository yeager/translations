msgctxt "Addon Summary"
msgid "A SoundFont Synthesizer"
msgstr "En SoundFont-syntesizer"

msgctxt "Addon Description"
msgid "FluidSynth is a real-time software synthesizer based on the SoundFont 2 specifications and has reached widespread distribution. FluidSynth itself does not have a graphical user interface, but due to its powerful API several applications utilize it and it has even found its way onto embedded systems and is used in some mobile apps."
msgstr "FluidSynth är en programvarusyntesizer i realtid, baserad på SoundFont 2-specifikationerna, och har fått stor spridning. FluidSynth har inget grafiskt användargränssnitt, men tack vare sitt kraftfulla API används det av flera program och har även funnit användning i inbyggda system och vissa mobilappar."

# Consistency: make terms, settings names, brands and other minutiae consistent throughout the file.
# Capitalization: avoid capitalizing every second word.
# Prefer wording such as "This new string" instead of "This New String".
# Reuse a suitable existing string where possible.
# Refer to a setting name in quotes when writing a description or setting.
# For example, use "Press \"OK\" for \"All seasons\"" after the first word.
msgctxt "#30000"
msgid "Soundfont"
msgstr "Soundfont"

msgctxt "#30001"
msgid "To use FluidSynth you need a working sound font."
msgstr "För att använda FluidSynth behöver du en fungerande SoundFont."

msgctxt "#30002"
msgid "Scan MIDI for title"
msgstr "Sök igenom MIDI efter titel"

msgctxt "#30003"
msgid "Search in MIDI file for information to get an exact title."
msgstr "Sök igenom MIDI-filen efter information för att få en exakt titel."

msgctxt "#30010"
msgid "SoundFont audio decode"
msgstr "SoundFont-ljudavkodare"

msgctxt "#30011"
msgid "Soundfont not configured, check add-on settings."
msgstr "SoundFont är inte konfigurerad. Kontrollera tilläggsinställningarna."
