msgctxt "Addon Summary"
msgid "Atari - 7800 (ProSystem)"
msgstr "Atari - 7800 (ProSystem)"

msgctxt "Addon Description"
msgid ""
"ProSystem is an Atari 7800 emulator.[CR][CR]Place [I]7800 BIOS (U).rom[/I] "
"(optional) in the emulator's userdata folder."
msgstr "ProSystem är en Atari 7800-emulator.[CR][CR]Placera [I]7800 BIOS (U).rom[/I] (valfritt) i emulatorns userdata-mapp."

msgctxt "#30001"
msgid "Color Depth (Restart)"
msgstr "Färgdjup (omstart)"

