msgctxt "Addon Summary"
msgid "Nintendo - SNES / SFC (Snes9x 2010)"
msgstr "Nintendo - SNES / SFC (Snes9x 2010)"

msgctxt "Addon Description"
msgid ""
"A port of Snes9x 1.52+ to Libretro. Rewritten in C with several "
"optimizations and speedhacks."
msgstr "En portning av Snes9x 1.52+ till Libretro. Omskriven i C med flera optimeringar och speedhacks."

msgctxt "Addon Disclaimer"
msgid "Icon credit: HarryBana (harrybana.deviantart.com)"
msgstr "Ikonreferens: HarryBana (harrybana.deviantart.com)"

