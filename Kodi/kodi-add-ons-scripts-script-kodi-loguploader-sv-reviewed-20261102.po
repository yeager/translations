msgctxt "Addon Summary"
msgid "Uploads your kodi.log file."
msgstr "Laddar upp din kodi.log-fil."

msgctxt "Addon Description"
msgid "Uploads your kodi.log file and returns an url you can post on http://forum.kodi.tv/"
msgstr "Laddar upp din kodi.log-fil och ger en URL som du kan publicera på http://forum.kodi.tv/"

msgctxt "#32001"
msgid "The file is empty"
msgstr "Filen är tom"

msgctxt "#32002"
msgid "Failed to read the file"
msgstr "Misslyckades med att läsa filen"

msgctxt "#32003"
msgid "Failed to connect to the server"
msgstr "Misslyckades med att ansluta till servern"

msgctxt "#32004"
msgid "Failed to retrieve the paste url"
msgstr "Det gick inte att hämta klistringslänken"

msgctxt "#32005"
msgid "This file is too large. Max size is 2MB."
msgstr "Filen är för stor. Maximal storlek är 2 MB."

msgctxt "#32006"
msgid "Post this url or scan QRcode for your %s, together with a problem description, on the Kodi forum: %s"
msgstr "Publicera den här URL:en eller skanna QR-koden för din %s tillsammans med en problembeskrivning på Kodi-forumet: %s"

msgctxt "#32007"
msgid "Error posting the logfile."
msgstr "Fel vid uppladdning av loggfilen."

msgctxt "#32011"
msgid "Error posting the kodi.log file"
msgstr "Fel vid uppladdning av kodi.log-filen"

msgctxt "#32012"
msgid "Error posting the old log file"
msgstr "Fel vid uppladdning av den gamla loggfilen"

msgctxt "#32013"
msgid "Error posting the crashlog file"
msgstr "Fel vid uppladdning av kraschloggfilen"

msgctxt "#32021"
msgid "No old log file found"
msgstr "Ingen gammal loggfil hittades"

msgctxt "#32022"
msgid "No crashlog file found"
msgstr "Ingen kraschloggfil hittades"

msgctxt "#32023"
msgid "Windows crashlogs are not supported, please disable this option in the addon settings"
msgstr "Windows-kraschloggar stöds inte. Inaktivera det här alternativet i tilläggsinställningarna."

msgctxt "#32024"
msgid "Android crashlogs are not supported, please disable this option in the addon settings"
msgstr "Android-kraschloggar stöds inte. Inaktivera det här alternativet i tilläggsinställningarna."

msgctxt "#32031"
msgid "logfile"
msgstr "loggfil"

msgctxt "#32032"
msgid "old log"
msgstr "gammal logg"

msgctxt "#32033"
msgid "crashlog"
msgstr "kraschlogg"

msgctxt "#32040"
msgid "Do you want to view your %s or upload it to http://paste.kodi.tv/?"
msgstr "Vill du visa dina %s eller ladda upp dem till http://paste.kodi.tv/?"

msgctxt "#32041"
msgid "view"
msgstr "Visa"

msgctxt "#32042"
msgid "upload"
msgstr "Ladda upp"

msgctxt "#32501"
msgid "Advanced options"
msgstr "Avancerade alternativ"

msgctxt "#32502"
msgid "Additional logfiles to post"
msgstr "Ytterligare loggfiler att ladda upp"

msgctxt "#32503"
msgid "Post the old logfile, from the last time Kodi ran"
msgstr "Ladda upp den gamla loggfilen från förra gången Kodi kördes"

msgctxt "#32504"
msgid "Post the crashlog (available on linux/osx/ios only)"
msgstr "Ladda upp kraschloggen (endast tillgängligt på Linux/macOS/iOS)"

#~ msgctxt "#32005"
#~ msgid "This file is too large. Max size is 1MB."
#~ msgstr "Den här filen är för stor. Max storlek är 1MB."
