msgstr "2 nyanser"

msgctxt "#30024"
msgid "Set contrast level of emulated liquid crystal display."
msgstr "Ställ in kontrastnivån för den emulerade flytande kristallskärmen."

msgctxt "#30025"
msgid "Set brightness offset of emulated liquid crystal display."
msgstr "Ställ in ljusstyrkeförskjutningen för den emulerade flytande kristallskärmen."

msgctxt "#30026"
msgid ""
"Specify palette used to 'colorize' the emulated liquid crystal display. "
"'Default' mimics real hardware."
msgstr "Ange paletten som används för att färgsätta den emulerade flytande kristallskärmen. ”Default” efterliknar riktig maskinvara."

