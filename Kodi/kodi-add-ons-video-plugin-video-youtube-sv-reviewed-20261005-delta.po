msgctxt "#30504"
msgid "Subscribed Channels"
msgstr "Prenumererade kanaler"

msgctxt "#30546"
msgid "Please sign in and complete all access authorisation prompts"
msgstr "Logga in och slutför alla uppmaningar om åtkomstbehörighet"

msgctxt "#30547"
msgid ""
"You may be prompted to sign in and enable access to multiple applications so"
" that this addon can function properly."
msgstr ""
"Du kan uppmanas att logga in och ge flera program åtkomst så att det här "
"tillägget fungerar korrekt."

msgctxt "#30548"
msgid ""
"Authorisation process failed. Check the log for more information about this "
"message.[CR][CR]Refer to the wiki for detailed setup instructions: "
"[B]https://ytaddon.page.link/keys[/B]"
msgstr ""
"Behörighetsprocessen misslyckades. Se loggen för mer information om "
"meddelandet.[CR][CR]I wikin finns detaljerade installationsanvisningar: "
"[B]https://ytaddon.page.link/keys[/B]"

msgctxt "#30630"
msgid "Check API configuration page address"
msgstr "Kontrollera adressen till API-konfigurationssidan"

msgctxt "#30703"
msgid "Use YouTube error notification video upon playback failure"
msgstr "Använd YouTubes video med felmeddelande när uppspelningen misslyckas"
