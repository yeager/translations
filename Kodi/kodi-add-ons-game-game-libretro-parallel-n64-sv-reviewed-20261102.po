msgctxt "Addon Summary"
msgid "Nintendo - Nintendo 64 (ParaLLEl N64)"
msgstr "Nintendo - Nintendo 64 (ParaLLEl N64)"

msgctxt "Addon Description"
msgid ""
"ParaLLEl N64 is an optimized/rewritten Nintendo 64 emulator based on Mupen64 "
"Plus. It was made specifically for Libretro."
msgstr "ParaLLEl N64 är en optimerad/omskriven Nintendo 64-emulator baserad på Mupen64 Plus. Den är speciellt framtagen för Libretro."

msgctxt "Addon Lifecyclestate"
msgid "Use Mupen64Plus-Next for software rendereing."
msgstr "Använd Mupen64Plus-Next för programvaruåtergivning."

