msgid "Left/Right"
msgstr "Vänster/höger"

msgctxt "#30089"
msgid "Right/Left"
msgstr "Höger/vänster"

msgctxt "#30090"
msgid "Top only"
msgstr "Endast överst"

msgctxt "#30091"
msgid "Bottom only"
msgstr "Endast nederst"

msgctxt "#30092"
msgid "Hybrid/Top"
msgstr "Hybrid/överst"

msgctxt "#30093"
msgid "Hybrid/Bottom"
msgstr "Hybrid/nederst"

msgctxt "#30094"
msgid "Sets the amout of space between the top and bottom screens."
msgstr "Anger mängden utrymme mellan den övre och den nedre skärmen."

msgctxt "#30095"
msgid "Sets the screen ratio for the hybrid screen(s) to use."
msgstr "Anger skärmförhållandet för hybridskärmarna som ska användas."

msgctxt "#30096"
msgid "Force the small screen to render at 1:1px."
msgstr "Tvinga den lilla skärmen att återges med 1:1 bildpunkt."

msgctxt "#30097"
msgid "Show both top & bottom small screens."
msgstr "Visa både den övre och den nedre lilla skärmen."

msgctxt "#30098"
msgid "Only display the cursor on the small bottom screen."
msgstr "Visa endast markören på den lilla nedre skärmen."

