#, ignore-same
msgctxt "Addon Summary"
msgid "Nintendo - DS (DeSmuME)"
msgstr "Nintendo - DS (DeSmuME)"

msgctxt "Addon Description"
msgid "DeSmuME is software that allows you to emulate a Nintendo DS system."
msgstr "DeSmuME är en programvara som gör att du kan emulera ett Nintendo DS-system."

msgctxt "Addon Disclaimer"
msgid ""
"Special thanks to yopyop (original author of DeSmuME) and Martin Korth "
"(author of GBATEK)"
msgstr "Särskilt tack till yopyop (ursprunglig upphovsperson till DeSmuME) och Martin Korth (upphovsperson till GBATEK)"

msgctxt "#30001"
msgid "Firmware Language"
msgstr "Firmware-språk"

msgctxt "#30002"
msgid "Use External BIOS/Firmware (restart)"
msgstr "Använd extern BIOS/Firmware (omstart)"

msgctxt "#30003"
msgid "Boot Into BIOS (interpreter and external bios only)"
msgstr "Starta i BIOS (endast tolk och externt BIOS)"

msgctxt "#30004"
msgid "Load Game Into Memory (restart)"
msgstr "Läs in spelet i minnet (omstart)"

msgctxt "#30005"
msgid "CPU Cores"
msgstr "CPU-kärnor"

msgctxt "#30006"
msgid "CPU Mode (restart)"
msgstr "CPU-läge (omstart)"

msgctxt "#30007"
msgid "JIT Block Size"
msgstr "JIT-blockstorlek"

msgctxt "#30008"
msgid "Enable Advanced Bus-Level Timing"
msgstr "Aktivera avancerad timing på bussnivå"

msgctxt "#30009"
msgid "Frameskip"
msgstr "Hoppa över bildrutor"

msgctxt "#30010"
msgid "Internal Resolution"
msgstr "Intern upplösning"

msgctxt "#30011"
msgid "OpenGL Rasterizer (restart)"
msgstr "OpenGL Rasterizer (omstart)"

msgctxt "#30012"
msgid "OpenGL: Color Depth (restart)"
msgstr "OpenGL: färgdjup (kräver omstart)"

msgctxt "#30013"
msgid "OpenGL: Multisampling AA"
msgstr "OpenGL: Multisampling AA"

msgctxt "#30014"
msgid "OpenGL: Texture Smoothing"
msgstr "OpenGL: Utjämning av textur"

msgctxt "#30015"
msgid "OpenGL: Shadow Polygons"
msgstr "OpenGL: Skuggpolygoner"

msgctxt "#30016"
msgid "OpenGL: Special 0 Alpha"
msgstr "OpenGL: särskilt alfa 0"

msgctxt "#30017"
msgid "OpenGL: NDS Depth Calculation"
msgstr "OpenGL: NDS-djupberäkning"

msgctxt "#30018"
msgid "OpenGL: Depth-LEqual Polygon Facing"
msgstr "OpenGL: polygonvändning med djup mindre än eller lika med"

msgctxt "#30019"
msgid "Soft3D: High-res Color Interpolation"
msgstr "Soft3D: färginterpolering med hög upplösning"

msgctxt "#30020"
msgid "Soft3D: Line Hack"
msgstr "Soft3D: linjehack"

msgctxt "#30021"
msgid "Soft3D: Texture Hack"
msgstr "Soft3D: Texturhack"

msgctxt "#30022"
msgid "Edge Marking"
msgstr "Kantmarkering"

msgctxt "#30023"
msgid "Texture Scaling (xBrz)"
msgstr "Skalning av textur (xBrz)"

msgctxt "#30024"
msgid "Texture Deposterization"
msgstr "Avbandning av texturer"

msgctxt "#30025"
msgid "Screen Layout"
msgstr "Skärmlayout"

msgctxt "#30026"
msgid "Screen Gap"
msgstr "Skärmmellanrum"

msgctxt "#30027"
msgid "Hybrid Layout: Ratio"
msgstr "Hybridlayout: förhållande"

msgctxt "#30028"
msgid "Hybrid Layout: Scale So Small Screen is 1:1px"
msgstr "Hybridlayout: skala så att den lilla skärmen är 1:1 bildpunkt"

msgctxt "#30029"
msgid "Hybrid Layout: Show Both Screens"
msgstr "Hybridlayout: visa båda skärmarna"

msgctxt "#30030"
msgid "Hybrid Layout: Cursor Always on Small Screen"
msgstr "Hybridlayout: markören alltid på liten skärm"

msgctxt "#30031"
msgid "Mouse/Pointer"
msgstr "Mus/Pekare"

msgctxt "#30032"
msgid "Pointer Type"
msgstr "Typ av pekare"

msgctxt "#30033"
msgid "Mouse Speed"
msgstr "Mushastighet"

msgctxt "#30034"
msgid "Pointer Rotation"
msgstr "Rotation av pekare"

msgctxt "#30035"
msgid "Pointer Mode for Left Analog"
msgstr "Pekarläge för vänster analogspak"

msgctxt "#30036"
msgid "Pointer Mode for Right Analog"
msgstr "Pekarläge för höger analogspak"

msgctxt "#30037"
msgid "Emulated Pointer Deadzone Percent"
msgstr "Dödzonsprocent för emulerad pekare"

msgctxt "#30038"
msgid "Emulated Pointer Acceleration Modifier Percent"
msgstr "Procent för modifiering av emulerad pekaracceleration"

msgctxt "#30039"
msgid "Emulated Stylus Pressure Modifier Percent"
msgstr "Procent för modifiering av emulerat penntryck"

msgctxt "#30040"
msgid "Pointer Colour"
msgstr "Pekarfärg"

msgctxt "#30041"
msgid "Microphone Button Noise Type"
msgstr "Brustyp för mikrofonknappen"

msgctxt "#30042"
msgid "Sets what type of noise to use when pressing the microfone button."
msgstr "Anger vilken typ av brus som ska användas när mikrofonknappen trycks ned."

msgctxt "#30043"
msgid "Pattern"
msgstr "Mönster"

# Suggested in Weblate: Slumpmässig
msgctxt "#30044"
msgid "Random"
msgstr "Slumpmässigt"

# Suggested in Weblate: System
msgctxt "#30045"
msgid "System"
msgstr "System"

msgctxt "#30046"
msgid "Configure system options."
msgstr "Konfigurera systemalternativ."

msgctxt "#30047"
msgid "Set language to use for firmware."
msgstr "Ange språk som ska användas för fast programvara."

msgctxt "#30048"
msgid "Use official BIOS. Core needs to be restarted for changes to apply."
msgstr "Använd officiellt BIOS. Kärnan måste startas om för att ändringarna ska gälla."

msgctxt "#30049"
msgid "Boot directly into the BIOS."
msgstr "Starta direkt i BIOS."

msgctxt "#30050"
msgid "Load the game into memory to reduce IO lag."
msgstr "Läs in spelet i minnet för att minska I/O-fördröjningen."

msgctxt "#30051"
msgid "Set the amount of CPU cores to use."
msgstr "Ange antal CPU-kärnor som ska användas."

msgctxt "#30052"
msgid "Enable or disable the use of the dynamic recompiler."
msgstr "Aktivera eller inaktivera användning av den dynamiska rekompilatorn."

msgctxt "#30053"
msgid "Set the block size of the JIT dynamic recompiler."
msgstr "Ange blockstorlek för JIT:s dynamiska rekompilator."

msgctxt "#30054"
msgid "Enables the use of Advanced Bus-Level Timing."
msgstr "Aktiverar användning av avancerad timing på bussnivå."

msgctxt "#30055"
msgid "Graphics"
msgstr "Grafik"

msgctxt "#30056"
msgid "Configure graphics options."
msgstr "Konfigurera grafikalternativ."

msgctxt "#30057"
msgid "Sets the amount of frames to skip."
msgstr "Anger antal bildrutor som ska hoppas över."

msgctxt "#30058"
msgid ""
"Sets the internal resolution. Higher resolutions can provide better clarity "
"for 3D scenes & objects, but will increase the performance requirements"
msgstr "Anger den interna upplösningen. Högre upplösningar kan ge bättre skärpa för 3D-scener och -objekt, men ökar prestandakraven."

msgctxt "#30059"
msgid "1x (256x192)"
msgstr "1× (256 × 192)"

msgctxt "#30060"
msgid "2x (512x384)"
msgstr "2× (512 × 384)"

msgctxt "#30061"
msgid "3x (768x576)"
msgstr "3× (768 × 576)"

msgctxt "#30062"
msgid "4x (1024x768)"
msgstr "4× (1024 × 768)"

msgctxt "#30063"
msgid "5x (1280x960)"
msgstr "5× (1280 × 960)"

msgctxt "#30064"
msgid "6x (1536x1152)"
msgstr "6× (1536 × 1152)"

msgctxt "#30065"
msgid "7x (1792x1344)"
msgstr "7× (1792 × 1344)"

msgctxt "#30066"
msgid "8x (2048x1536)"
msgstr "8× (2048 × 1536)"

msgctxt "#30067"
msgid "9x (2304x1728)"
msgstr "9× (2304 × 1728)"

msgctxt "#30068"
msgid "10x (2560x1920)"
msgstr "10× (2560 × 1920)"

msgctxt "#30069"
msgid "Enable the OpenGL Rasterizer for 3D."
msgstr "Aktivera OpenGL-rasteriseraren för 3D."

msgctxt "#30070"
msgid ""
"Sets the Color Depth to either 16-bit or 32-bit colors. Requires the OpenGL "
"Rasterizer."
msgstr "Anger färgdjupet till antingen 16- eller 32-bitarsfärger. Kräver OpenGL-rasteriseraren."

msgctxt "#30071"
msgid ""
"Set the multiplier for Multisampling Anti Aliasing. Requires the OpenGL "
"Rasterizer."
msgstr "Ange multiplikatorn för multisampling-kantutjämning. Kräver OpenGL-rasteriseraren."

msgctxt "#30072"
msgid "Enables Texture Smoothing. Requires the OpenGL Rasterizer."
msgstr "Aktiverar texturutjämning. Kräver OpenGL-rasteriseraren."

msgctxt "#30073"
msgid "Enables Shadow Polygons. Requires the OpenGL Rasterizer."
msgstr "Aktiverar skuggpolygoner. Kräver OpenGL-rasteriseraren."

msgctxt "#30074"
msgid "Enables Special 0 Alpha. Requires the OpenGL Rasterizer."
msgstr "Aktiverar särskilt alfa 0. Kräver OpenGL-rasteriseraren."

msgctxt "#30075"
msgid "Enables NDS Depth Calculation. Requires the OpenGL Rasterizer."
msgstr "Aktiverar NDS-djupberäkning. Kräver OpenGL-rasteriseraren."

msgctxt "#30076"
msgid "Enables Depth-LEqual Polygon Facing. Requires the OpenGL Rasterizer."
msgstr "Aktiverar polygonvändning med djup mindre än eller lika med. Kräver OpenGL-rasteriseraren."

msgctxt "#30077"
msgid "Enables High-res Color Interpolation."
msgstr "Aktiverar färginterpolering med hög upplösning."

msgctxt "#30078"
msgid "Enables Line Hack."
msgstr "Aktiverar linjehack."

msgctxt "#30079"
msgid "Enables Texture Hack."
msgstr "Aktiverar texturhack."

msgctxt "#30080"
msgid "Enables Edge Marking."
msgstr "Aktiverar kantmarkering."

msgctxt "#30081"
msgid "Sets the multiplier for xBrz texture scaling to use."
msgstr "Anger multiplikatorn för xBrz-texturskalning som ska användas."

msgctxt "#30082"
msgid "Enables Texture Deposterization."
msgstr "Aktiverar avbandning av texturer."

msgctxt "#30083"
msgid "Screen"
msgstr "Skärm"

msgctxt "#30084"
msgid "Configure screen options."
msgstr "Konfigurera skärmalternativ."

msgctxt "#30085"
msgid "Select the screen layout to use."
msgstr "Välj skärmlayout som ska användas."

