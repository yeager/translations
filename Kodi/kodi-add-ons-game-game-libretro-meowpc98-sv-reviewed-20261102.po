msgctxt "Addon Summary"
msgid "NEC - PC-98 (Neko Project II)"
msgstr "NEC - PC-98 (Neko Project II)"

msgctxt "Addon Description"
msgid ""
"Neko Project II is an excellent PC-98 emulator.[CR][CR]PC-98 is a lineup of "
"Japanese 16-bit and 32-bit personal computers manufactured by NEC from 1982 "
"to 2000."
msgstr "Neko Project II är en utmärkt emulator för PC-98.[CR][CR]PC-98 är en serie japanska 16-bitars och 32-bitars persondatorer som tillverkades av NEC mellan 1982 och 2000."

