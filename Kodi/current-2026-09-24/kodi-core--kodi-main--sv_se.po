#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35276"
msgid "Insert"
msgstr "Mata in"

#. Label for the button that resumes playing the current game. Called from the
#. in-game menu.
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35277"
msgid "Resume game"
msgstr "Återuppta spel"

#. Error message shown when the disc can't be ejected for a game's virtual CD
#. drive
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35278"
msgid "The disc can't be ejected right now."
msgstr "Skivan kan inte matas ut just nu."

#. Error message shown when the disc can't be inserted (closing the disc tray)
#. for a game's virtual CD drive
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35279"
msgid "The disc can't be inserted right now."
msgstr "Skivan kan inte matas in just nu."

#. Title of the dialog to select a new disc image for a game's virtual CD
#. drive
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35280"
msgid "Select disc"
msgstr "Välj skiva"

#. Heading of the notification shown when the player earns an achievement
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35281"
msgid "Achievement Unlocked"
msgstr "Prestation upplåst"

#. Heading of the notification shown when every achievement of a game has been
#. earned in hardcore mode
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35282"
