#. Setting "Audio/video queue time"
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#37130"
msgid "Audio/video queue time"
msgstr "Kötid för ljud/video"

#. Description of setting with label #37130 "Audio/video queue time"
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#37131"
msgid ""
"Duration in seconds of audio/video queues. The duration determines the "
"amount of data stored in memory."
msgstr ""
"Varaktighet i sekunder för ljud-/videoköer. Varaktigheten avgör hur mycket "
"data som lagras i minnet."

#. Setting "Video queue maximum size"
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#37132"
msgid "Video queue maximum size"
msgstr "Maximal storlek på videokö"

#. Description of setting with label #37132 "Video queue maximum size"
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#37133"
msgid ""
"Limits the maximum memory usage for the video queue. The amount of memory "
"used depends on the video bitrate and the length of the queue. If the memory"
" limit is reached, the queue time is reduced as necessary."
msgstr ""
"Begränsar den maximala minnesanvändningen för videokön. Hur mycket minne som"
" används beror på videobitfrekvensen och längden på kön. Om minnesgränsen "
"nås minskas kötiden vid behov."

#. Setting #38011 "Show All Items entry"
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#38011"
msgid "Show \"All items\" entry"
msgstr "Visa \"Alla objekt\"-meny"

#. Description of setting "Show All Items entry"
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#38012"
msgid "Show \"All items\" entry in directory, e.g. \"All albums\" or \"All seasons\"."
msgstr ""
