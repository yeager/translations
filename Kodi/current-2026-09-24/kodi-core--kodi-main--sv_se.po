msgstr "Vanlig"

#. Rarity category of an achievement earned by 10% to 50% of players
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35291"
msgid "Uncommon"
msgstr "Ovanlig"

#. Rarity category of an achievement earned by 2% to 10% of players
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35292"
msgid "Rare"
msgstr "Sällsynt"

#. Rarity category of an achievement earned by fewer than 2% of players
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35293"
msgid "Ultra rare"
msgstr "Extremt sällsynt"

#. Point value of an achievement, abbreviated to fit the list. {0:d} is the
#. number of points
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35294"
msgid "{0:d} pts"
msgstr "{0:d} poäng"

#. Notification shown after signing in to RetroAchievements. {0:s} is the
#. account name
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35295"
msgid "Logged in as {0:s}"
msgstr "Inloggad som {0:s}"

#. Notification shown when RetroAchievements becomes unreachable during play
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35296"
msgid "Unlocks will be submitted when the connection returns."
msgstr "Upplåsningar skickas när anslutningen är tillbaka."

#. Notification shown when RetroAchievements becomes reachable again
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35297"
msgid "Pending unlocks have been submitted."
msgstr "Väntande upplåsningar har skickats."

#. empty strings from id 35281 to 35297
#. Error message shown when trying to load a compressed savestate in an
#. unsupported version of Kodi
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35298"
msgid ""
"This savestate is compressed and can't be loaded by this version of Kodi."
msgstr ""
"Det här sparläget är komprimerat och kan inte läsas in av den här versionen "
"av Kodi."

#. Shown when the achievements dialog is opened before the game has been
#. identified
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35299"
msgid "Still looking this game up..."
msgstr "Söker fortfarande upp det här spelet …"

#. Shown when hardware rendering fails. {0:s} is the requested API/version,
#. such as "OpenGL 4.3"; {1:s} is the available API, such as "OpenGL".
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35300"
msgid ""
"Kodi couldn't initialize {0:s} rendering for this game. This display "
"supports {1:s}."
msgstr ""
"Kodi kunde inte initiera {0:s}-rendering för det här spelet. Den här skärmen"
" stöder {1:s}."

#. Shown when a game needs the graphics card directly but the display can't
#. provide it
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35301"
msgid ""
"Kodi couldn't initialize {0:s} rendering for this game on this display."
msgstr ""
"Kodi kunde inte initiera {0:s}-rendering för det här spelet på den här "
"skärmen."

#. Label of the setting that enables RetroAchievements encore mode
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35303"
msgid "Encore mode"
msgstr "Encore-läge"

#. Help text for the encore mode setting
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35304"
msgid ""
"Allow achievements you have already earned to be triggered "
"again.[CR][CR]Applies the next time you load the game."
msgstr ""
"Tillåt att prestationer som du redan har tjänat in utlöses "
"igen.[CR][CR]Tillämpas nästa gång du läser in spelet."

#. Notification shown when all achievements of a subset are earned, {0:s} is
#. the subset
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35307"
msgid "Subset completed"
msgstr "Delmängd slutförd"

#. empty strings from id 35313 to 35319
#. Label of the Cheats button in the game OSD, heading of the cheats dialog,
#. and
#. of the cheats group in settings
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35320"
msgid "Cheats"
msgstr "Fusk"

#. Label of the setting that points at the folder holding cheat files
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35321"
msgid "Cheats folder"
msgstr "Fuskmapp"

#. Help text for the cheats folder setting
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35322"
msgid ""
"Set a custom folder containing libretro cheats, or install cheats in the "
"Add-on Manager."
msgstr ""
"Ange en anpassad mapp med libretro-fusk eller installera fusk i "
"tilläggshanteraren."

#. Shown when no cheat pack matches the current game
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
