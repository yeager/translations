msgid "This game doesn't support RetroAchievements"
msgstr "Det här spelet har inte stöd för RetroAchievements"

#. Label for the button that opens the achievements dialog, and heading of
#. that dialog
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35287"
msgid "Achievements"
msgstr "Prestationer"

#. Progress through a game's achievements, weighted by point value. {0:d} is a
#. percentage
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35288"
