#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#35284"
msgid "{0:d} of {1:d} achievements unlocked"
msgstr "{0:d} av {1:d} prestationer upplåsta"

#. Message shown when the achievements dialog is opened without being logged
