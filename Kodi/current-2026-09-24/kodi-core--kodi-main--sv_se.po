msgstr "Bläddra i bibliotek"

#. Select the movie to be added as a version
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40030"
msgid "Select movie to add as a version"
msgstr "Välj film som ska läggas till som en version"

#. No other movies found in the library
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40031"
msgid "No other movies found in the library."
msgstr "Inga andra filmer hittades i biblioteket."

#. Add version: no similar movies were found in the library.
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40032"
msgid "No similar movies were found in the library."
msgstr "Inga liknande filmer hittades i biblioteket."

#. Add version: Add another version from this disc - for Blurays
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40033"
msgid "Add another version from this disc?"
msgstr "Lägg till en annan version från denna skiva?"

#. Addition of new extra: a movie with multiple versions cannot be turned into
#. an extra of another movie.
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40034"
msgid ""
"The default version of a movie with multiple versions cannot be added as an "
"extra to another movie. Please move or remove the other versions first."
msgstr ""
"Standardversionen av en film med flera versioner kan inte läggas till som "
"extramaterial till en annan film. Flytta eller ta bort de andra versionerna "
"först."

#. Addition of new version: the user picked an extra of another movie. Ask for
#. confirmation.
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40035"
msgid ""
"You are about to convert a movie extra into a movie version. Are you sure?"
msgstr ""
"Du är på väg att konvertera en extrafilm till en filmversion. Är du säker på"
" det?"

#. Addition of new version: the user picked an extra of another movie. Ask for
#. confirmation.
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40036"
msgid ""
"You are about to convert a movie version into a movie extra. Are you sure?"
msgstr ""
"Du är på väg att konvertera en filmversion till en extrafilm. Är du säker på"
" det?"

#. Addition of new version to a movie: the user chose a movie that has
#. multiple versions. Ask for confirmation.
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40037"
msgid ""
"The movie to be added has multiple versions.[CR]The type of the default "
"version will be selected in the next dialog. The other versions will keep "
"their current type.[CR]Do you want to continue?"
msgstr ""
"Den film som ska läggas till har flera versioner.[CR]Typen för "
"standardversionen kommer att väljas i nästa dialogruta. De andra versionerna"
" behåller sin nuvarande typ.[CR]Vill du fortsätta?"

#. Addition of new version: the default version of a movie with multiple
#. versions cannot be turned into a version of another movie.
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40038"
msgid ""
"The default version of a movie with multiple versions cannot be added to "
"another movie. Please move or remove the other versions first."
msgstr ""
"Standardversionen av en film med flera versioner kan inte läggas till i en "
"annan film. Flytta eller ta bort de andra versionerna först."

#. Remove video extra dialog title
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40039"
msgid "Remove video extra"
msgstr "Ta bort extravideo"

#. Remove video extra dialog text
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40040"
msgid "Are you sure to remove the extra \"{0:s}\"?"
msgstr "Är du säker på att du har tagit bort extramaterialet \"{0:s}\"?"

#. Prompt to assign playlist to current movie version
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40041"
msgid "Assign playlist to current movie version?"
msgstr "Tilldela spellista till aktuell filmversion?"

#. Different video version found dialog text for blurays
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40042"
msgid ""
"Found a different version of the movie \"{0:s}\" in playlist {1:s} of {2:s} "
"- length {3:s}. Would you like to convert it into an additional version of "
"the original?"
msgstr ""
"Hittade en annan version av filmen ”{0:s}” i spellistan {1:s} i {2:s} – "
"längd {3:s}. Vill du omvandla den till en ytterligare version av originalet?"

#. Ungroup video version dialog title
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40043"
msgid "Ungroup video version"
msgstr "Dela upp videoversion"

#. Manage versions, ungroup: ungrouping the default version of a movie is not
#. allowed.
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40044"
msgid ""
"The default version of a movie cannot be ungrouped. Set a different default "
"version and try again."
msgstr ""
"En films standardversion kan inte delas upp. Välj en annan standardversion "
"och försök igen."

#. Ungroup video version dialog text
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40045"
msgid ""
"Are you sure to ungroup version \"{0:s}\"?[CR]It will be turned into a "
"library movie entry."
msgstr ""
"Är du säker på att du vill dela upp versionen ”{0:s}”?[CR]Den omvandlas till"
" en film i biblioteket."

#. Button name for video version ungroup function of the manage versions
#. dialog
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40046"
msgid "Ungroup"
msgstr "Dela upp"

#. Shown when the playlist chosen for a movie version already belongs to
#. another version of it
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40047"
msgid "This playlist already belongs to another version of this movie."
msgstr "Den här spellistan tillhör redan en annan version av filmen."

#. Asked before a playlist already assigned to another episode is taken away
#. from it
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40048"
msgid ""
"The selected playlist is already assigned to another episode. Reassign it?"
msgstr ""
"Den valda spellistan är redan kopplad till ett annat avsnitt. Koppla om den?"

#. Asked before a playlist already assigned to another movie version is taken
#. away from it
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40049"
msgid ""
"The selected playlist is already assigned to another movie version. Reassign"
" it?"
msgstr ""
"Den valda spellistan är redan kopplad till en annan filmversion. Koppla om "
"den?"

#. Asked before an episode joins a playlist that several episodes already
#. share
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40050"
msgid ""
"The selected playlist is shared by several episodes. Use it for this item as"
" well?"
msgstr ""
"Den valda spellistan delas av flera avsnitt. Vill du använda den även för "
"det här objektet?"

#. Shown when a playlist cannot be given up because a movie version still uses
#. its file
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40051"
msgid ""
"This playlist is still in use by another movie version and could not be "
"reassigned."
msgstr ""
"Den här spellistan används fortfarande av en annan filmversion och kunde "
"inte kopplas om."

#. Ignore different video versions settting
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40202"
msgid "Ignore different video versions on scan"
msgstr "Ignorera olika videoversioner vid genomsökning"

#. Help for Ignore different video versions settting
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40203"
msgid ""
"Select the scanner action for different versions of a video.[CR][Off] Add "
"versions of a video to the library as separate entries.[CR][Ask] Prompt if "
"different versions should be added separately or grouped with the "
"original.[CR][Auto] Automatically create and group the additional versions "
"with the original."
msgstr ""
"Välj skanningsåtgärd för olika versioner av en video.[CR][Av] Lägg till "
"versioner av en video i biblioteket som separata poster.[CR][Fråga] Fråga om"
" olika versioner ska läggas till separat eller grupperas med "
"originalet.[CR][Automatiskt] Skapa automatiskt ytterligare versioner och "
"gruppera dem med originalet."

#. Ignore video extras settting
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40204"
msgid "Ignore video extras on scan"
msgstr "Ignorera videoextramaterial vid genomsökning"

#. Help for ignore video extras settting
#, ignore-long-untranslated, ignore-multiple-failures, ignore-optional-plural
msgctxt "#40205"
msgid ""
"Select scanner action for video extras in \"extras\" folder.[CR][Enabled] "
"Scan video extras like regular videos.[CR][Disabled] Add video extras to "
"library for associated video."
msgstr ""
"Välj genomsökningsåtgärd för videoextramaterial i mappen "
"\"extras\".[CR][Aktiverad] Sök igenom videoextramaterial som vanliga "
"videor.[CR][Inaktiverad] Lägg till videoextramaterial i biblioteket för "
"tillhörande video."

