msgid ""
msgstr ""
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "Invalid language code: ${language}"
msgid "Invalid language code: ${language}"
msgstr "Ogiltig språkkod: ${language}"

msgctxt "List is not explicitly addressed"
msgid "List is not explicitly addressed"
msgstr "Listan är inte uttryckligen angiven som mottagare"

msgctxt "Cannot unshunt message ${filebase}, skipping: ${error}"
msgid "Cannot unshunt message ${filebase}, skipping: ${error}"
msgstr ""
"Kan inte återföra meddelandet ${filebase} till kön, hoppar över det: "
"${error}"

msgctxt ""
"    Discard shunted messages instead of moving them back to their original\n"
"    queue."
msgid ""
"    Discard shunted messages instead of moving them back to their original\n"
"    queue."
msgstr ""
"    Kasta meddelanden i undantagskön i stället för att flytta tillbaka dem\n"
"    till deras ursprungliga kö."

msgctxt ""
"Stop and restart the Mailman runner subprocesses. Note: runners that have "
"died and are not currently running will not be restarted by this command. To"
" restart dead runners, use mailman stop followed by mailman start."
msgid ""
"Stop and restart the Mailman runner subprocesses. Note: runners that have "
"died and are not currently running will not be restarted by this command. To"
" restart dead runners, use mailman stop followed by mailman start."
msgstr ""
"Stoppa och starta om Mailmans runner-delprocesser. Observera att runner-"
"processer som har avslutats och inte längre körs inte startas om med detta "
"kommando. För att starta om avslutade runner-processer, kör mailman stop "
"följt av mailman start."

msgctxt ""
"    Delete all the members of the list.  If specified, none of -f/--file,\n"
"    -m/--member or --fromall may be specified.\n"
"    "
msgid ""
"    Delete all the members of the list.  If specified, none of -f/--file,\n"
"    -m/--member or --fromall may be specified.\n"
"    "
msgstr ""
"    Ta bort alla medlemmar i listan. Om detta anges får inget av -f/--file,\n"
"    -m/--member eller --fromall anges.\n"
"    "

msgctxt ""
"    Delete the member(s) specified by -m/--member and/or -f/--file from all\n"
"    lists in the installation.  This may not be specified together with\n"
"    -a/--all or -l/--list.\n"
"    "
msgid ""
"    Delete the member(s) specified by -m/--member and/or -f/--file from all\n"
"    lists in the installation.  This may not be specified together with\n"
"    -a/--all or -l/--list.\n"
"    "
msgstr ""
"    Ta bort den eller de medlemmar som anges med -m/--member och/eller\n"
"    -f/--file från alla listor i installationen. Detta får inte anges\n"
"    tillsammans med -a/--all eller -l/--list.\n"
"    "

msgid ""
"    Add all member addresses in FILENAME with delivery mode as specified\n"
"    with -d/--delivery.  FILENAME can be '-' to indicate standard input.\n"
"    Blank lines and lines that start with a '#' are ignored.\n"
"    "
msgstr ""
"    Lägg till alla medlemsadresser i FILENAME med det leveranssätt som anges\n"
"    med -d/--delivery. FILENAME kan vara '-' för standardinmatning.\n"
"    Tomma rader och rader som börjar med '#' ignoreras.\n"
"    "

msgid ""
"    Add and delete members as necessary to syncronize a list's membership\n"
"    with an input file.  FILENAME is the file containing the new membership,\n"
"    one member per line.  Blank lines and lines that start with a '#' are\n"
"    ignored.  Addresses in FILENAME which are not current list members\n"
"    will be added to the list with delivery mode as specified with\n"
"    -d/--delivery.  List members whose addresses are not in FILENAME will\n"
"    be removed from the list.  FILENAME can be '-' to indicate standard input.\n"
"    "
msgstr ""
"    Lägg till och ta bort medlemmar efter behov för att synkronisera listans\n"
"    medlemskap med en inmatningsfil. FILENAME är filen med de nya medlemmarna,\n"
"    en per rad. Tomma rader och rader som börjar med '#' ignoreras.\n"
"    Adresser i FILENAME som inte redan finns på listan läggs till med det\n"
"    leveranssätt som anges med -d/--delivery. Medlemmar vars adresser inte\n"
"    finns i FILENAME tas bort från listan. FILENAME kan vara '-' för\n"
"    standardinmatning.\n"
"    "

msgid "--send and --periodic flags cannot be used together"
msgstr "Flaggorna --send och --periodic kan inte användas tillsammans"

msgid ""
"\n"
"    Run a script.  The argument is the module path to a callable.  This\n"
"    callable will be imported and then, if --listspec/-l is also given, is\n"
"    called with the mailing list as the first argument.  If additional\n"
"    arguments are given at the end of the command line, they are passed as\n"
"    subsequent positional arguments to the callable.  For additional help, see\n"
"    --details.\n"
"\n"
"    If no --listspec/-l argument is given, the script function being called is\n"
"    called with no arguments.\n"
"    "
msgstr ""
"\n"
"    Kör ett skript. Argumentet är modulsökvägen till ett anropbart objekt.\n"
"    Objektet importeras och anropas sedan, om --listspec/-l också anges, med\n"
"    sändlistan som första argument. Ytterligare argument i slutet av\n"
"    kommandoraden skickas som efterföljande positionsargument till objektet.\n"
"    Mer hjälp finns under --details.\n"
"\n"
"    Om inget --listspec/-l-argument anges anropas skriptfunktionen utan\n"
"    argument.\n"
"    "
