msgid "list:admin:notice:increment.txt"
msgstr ""
"Studsningspoängen för $member på $listname har ökat.\n"
"\n"
"Det utlösande DSN-meddelandet bifogas om det finns tillgängligt."

msgid "list:admin:action:subscribe.txt"
msgstr ""
"Ditt godkännande krävs för en begäran om prenumeration på sändlistan:\n"
"\n"
"    För: $member\n"
"    Lista: $listname"

msgid "list:admin:action:unsubscribe.txt"
msgstr ""
"Ditt godkännande krävs för en begäran om att avsluta en prenumeration på sändlistan:\n"
"\n"
"    För: $member\n"
"    Lista: $listname"
