#: forms/list_forms.py:1098
msgid "Admin immed notify"
msgstr "Meddela moderatorer omedelbart"

#: forms/list_forms.py:1112
msgid "Admin notify held with attachment"
msgstr "Bifoga kvarhållna meddelanden i aviseringar"

#: forms/list_forms.py:1114
msgid ""
"If the above Admin immed notify setting is Yes, should the notice of a held "
"message have the message attached.  You may want to set this to No if "
"notices of held spammy messages are caught in the admin's spam filters."
msgstr ""
"Om ”Meddela moderatorer omedelbart” ovan är inställt på Ja, ska det "
"kvarhållna meddelandet bifogas aviseringen? Välj Nej om aviseringar om "
"kvarhållen skräppost fastnar i administratörens skräppostfilter."
