msgid "The seventh in a row of seven soldiers wearing blue skirts."
msgstr "Den sjunde i en rad med sju soldater som bär blå kjolar."

#: 834R15
msgctxt "834R15"
msgid "The broken chariot is useless."
msgstr "Den trasiga stridsvagnen är värdelös."

#: 834R20
msgctxt "834R20"
msgid "The chariot is broken. It isn't going anywhere."
msgstr "Stridsvagnen är trasig. Den kommer ingenstans."

#: 844R02
msgctxt "844R02"
msgid "One of the support beams has fallen from the ceiling of this corridor."
msgstr "En av stödbjälkarna har fallit från taket i den här korridoren."

#: 844R03
msgctxt "844R03"
msgid "The first in a row of seven soldiers wearing red skirts."
msgstr "Den första i en rad med sju soldater som bär röda kjolar."

#: 844R04
msgctxt "844R04"
msgid "The second in a row of seven soldiers wearing red skirts."
msgstr "Den andra i en rad med sju soldater som bär röda kjolar."

#: 844R05
msgctxt "844R05"
msgid "The third in a row of seven soldiers wearing red skirts."
msgstr "Den tredje i en rad med sju soldater som bär röda kjolar."

#: 844R06
msgctxt "844R06"
msgid "The fourth in a row, seven soldiers wearing red skirts."
msgstr "Den fjärde i en rad med sju soldater som bär röda kjolar."

#: 844R07
msgctxt "844R07"
msgid "The fifth in a row of seven soldiers wearing red skirts."
msgstr "Den femte i en rad med sju soldater som bär röda kjolar."

#: 844R08
