#: ../../msn/msn_r1_r.c:185
msgid "Alben"
msgstr "Album"

#: ../../msn/msn_r1_r.c:185
msgid "Deine Briefmarkensammlung."
msgstr "Din frimärkssamling."

#: ../../msn/msn_r1_r.c:188
msgid "Es ist ungefähr 10 m lang und 4 cm dick."
msgstr "Den är cirka 10 meter lång och 4 cm tjock."

#: ../../msn/msn_r1_r.c:190
msgid "Das ist dein Schrank."
msgstr "Det här är din garderob."

#: ../../msn/msn_r1_r.c:191 ../../msn/msn_r1_r.c:274 ../../msn/msn_r1_r.c:275
msgid "Krimskram"
msgstr "Krim-grejer"

#: ../../msn/msn_r1_r.c:191 ../../msn/msn_r1_r.c:274 ../../msn/msn_r1_r.c:275
msgid "Es ist nichts brauchbares dabei."
msgstr "Det finns inget användbart."

#: ../../msn/msn_r1_r.c:192 ../../msn/msn_r1_r.c:273
msgid "Kleider"
msgstr "Kläder"

#: ../../msn/msn_r1_r.c:192
msgid "Es sind Standard-Weltraum-Klamotten."
msgstr "Det är vanliga rymdkläder."

#: ../../msn/msn_r1_r.c:193 ../../msn/msn_r1_r.c:269 ../../msn/msn_r1_r.c:271
msgid "Unterwäsche"
msgstr "Underkläder"

#: ../../msn/msn_r1_r.c:194
msgid "Strümpfe"
msgstr "Strumpor"

#: ../../msn/msn_r1_r.c:197 ../../msn/msn_r1_r.c:268
msgid "Buch"
msgstr "Bok"

#: ../../msn/msn_r1_r.c:197
msgid "Es ist|\"Per Anhalter durch die Galaxis\"|von Douglas Adams."
msgstr "Det är|”Liftarens guide till galaxen”|av Douglas Adams."

#: ../../msn/msn_r1_r.c:212
msgid "Herb!"
msgstr "Stramt!"

#: ../../msn/msn_r1_r.c:214
msgid "Genial!"
msgstr "Genialiskt!"

#: ../../msn/msn_r1_r.c:217
msgid "Es scheint noch nicht fertig zu sein."
msgstr "Det verkar inte vara färdigt än."

#: ../../msn/msn_r1_r.c:218
msgid "Stift"
msgstr "Penna"

#: ../../msn/msn_r1_r.c:218
msgid "Ein Kugelschreiber."
msgstr "En kulspetspenna."

#: ../../msn/msn_r1_r.c:230 ../../msn/msn_r1_r.c:231
msgid "Poster"
msgstr "Affisch"

#: ../../msn/msn_r1_r.c:230
msgid "Ein Poster von \"Big Boss\"."
msgstr "En affisch av \"Big Boss\"."

#: ../../msn/msn_r1_r.c:231
msgid "Ein Poster von \"Rock Desaster\"."
msgstr "En affisch av \"Rock Disaster\"."

#: ../../msn/msn_r1_r.c:232
msgid "Box"
msgstr "Högtalare"

#: ../../msn/msn_r1_r.c:235
msgid "Schallplatte"
msgstr "Skiva"

#: ../../msn/msn_r1_r.c:235
msgid "Die Platte ist von \"Big Boss\"."
msgstr "Skivan är från \"Big Boss\"."

#: ../../msn/msn_r1_r.c:237
msgid "Schallplattenständer"
msgstr "Skivstativ"

#: ../../msn/msn_r1_r.c:237
msgid "Du hast jetzt keine Zeit, in|der Plattensammlung rumzustöbern."
msgstr "Du har inte tid att rota|i skivsamlingen nu."

#: ../../msn/msn_r1_r.c:240
msgid "Plattenspieler"
msgstr "Skivspelare"

#: ../../msn/msn_r1_r.c:240
msgid "Sieht aus, als käme|er aus dem Museum."
msgstr "Den ser ut att komma|från ett museum."

#: ../../msn/msn_r1_r.c:244
msgid "Stecker"
msgstr "Stickpropp"

#: ../../msn/msn_r1_r.c:261
msgid "Pistole"
msgstr "Pistol"

#: ../../msn/msn_r1_r.c:261
msgid "Es ist keine Munition drin."
msgstr "Det finns ingen ammunition i den."

#: ../../msn/msn_r1_r.c:263
msgid "Bücher"
msgstr "Böcker"

#: ../../msn/msn_r1_r.c:263
msgid "Lauter wissenschaftliche Bücher."
msgstr "Massor av vetenskapliga böcker."

#: ../../msn/msn_r1_r.c:265
msgid "Kabelrolle"
msgstr "Kabelvinda"

#: ../../msn/msn_r1_r.c:265
msgid "Da sind mindestens zwanzig Meter drauf."
msgstr "Det finns minst 20 meter på den."

#: ../../msn/msn_r1_r.c:269 ../../msn/msn_r1_r.c:271
msgid "Ich habe keine Lust, in|der Unterwäsche des|Commanders rumzuwühlen."
msgstr "Jag känner inte för att rota|i befälhavarens|underkläder."

#: ../../msn/msn_r1_r.c:284
msgid "Ordner"
msgstr "Mappar"

#: ../../msn/msn_r1_r.c:284
msgid ""
"Darauf steht \"Dienstanweisungen|zur Mission Supernova\".|Es steht nichts "
"wichtiges drin."
msgstr ""
"Där står: ”Instruktioner|för Mission Supernova”.|Det står inget viktigt i "
"den."

#: ../../msn/msn_r1_r.c:291
msgid "Klo"
msgstr "Toalett"

#: ../../msn/msn_r1_r.c:291
msgid "Ein Klo mit Saugmechanismus."
msgstr "En toalett med sugmekanism."

#: ../../msn/msn_r1_r.c:292
msgid "Dusche"
msgstr "Dusch"

#: ../../msn/msn_r2.c:57
msgid "Die Raumschiffe sind alle verschlossen."
msgstr "Alla rymdskepp är låsta."

#: ../../msn/msn_r2.c:64 ../../msn/msn_r2.c:1098
msgid "Unsinn!"
msgstr "Nonsens!"

#: ../../msn/msn_r2.c:91
msgid ""
"Komisch! Auf einmal kannst du|das Schild lesen! Darauf steht:|\"Treffpunkt "
"Galactica\"."
msgstr ""
"Lustigt! Plötsligt kan du|läsa skylten! Där står:|”Mötesplats Galactica”."

#: ../../msn/msn_r2.c:92
msgid "Darauf steht:|\"Treffpunkt Galactica\"."
msgstr "Där står:|”Mötesplats Galactica”."

#: ../../msn/msn_r2.c:144
msgid "Wieso das denn nicht?"
msgstr "Varför inte?"

#: ../../msn/msn_r2.c:145 ../../msn/msn_r2.c:154 ../../msn/msn_r2.c:1082
msgid "Wo bin ich hier?"
msgstr "Var är jag här?"

#: ../../msn/msn_r2.c:146 ../../msn/msn_r2.c:183
msgid "Wo soll ich die Schuhe ablegen?"
msgstr "Var ska jag ställa mina skor?"

#: ../../msn/msn_r2.c:147
msgid "Schwachsinn! Ich gehe jetzt nach oben!"
msgstr "Struntprat! Jag går upp på övervåningen nu!"

#: ../../msn/msn_r2.c:155
msgid "Schönes Wetter heute, nicht wahr?"
msgstr "Visst är det fint väder i dag?"

#: ../../msn/msn_r2.c:156
msgid "Würden Sie mich bitte durchlassen."
msgstr "Kan ni släppa förbi mig, tack?"
