#: ../../msn/msn_r3.c:1688
msgid "Tür"
msgstr "Dörr"

#: ../../msn/msn_r2.c:1245
msgid "Kaugummi"
msgstr "Tuggummi"

#: ../../msn/msn_r2.c:1246
msgid "Gummibärchen"
msgstr "Gummibjörnar"

#: ../../msn/msn_r2.c:1247
msgid "Schokokugel"
msgstr "Chokladboll"

#: ../../msn/msn_r2.c:1248
msgid "Überraschungsei"
msgstr "Överraskningsägg"

#: ../../msn/msn_r2.c:1249
msgid "Lakritz"
msgstr "Lakrits"

#: ../../msn/msn_r2.c:1250
msgid "Tablette"
msgstr "Tablett"

#: ../../msn/msn_r2.c:1250
msgid ""
"Die Plastikhülle zeigt einen|Mund mit einer Sprechblase. Was|darin steht, "
"kannst du nicht lesen."
msgstr ""
"Plasthöljet visar en|mun med en pratbubbla. Vad|som står i den kan du inte "
"läsa."

#: ../../msn/msn_r2.c:1253
msgid "Automat"
msgstr "Varuautomat"

#: ../../msn/msn_r2.c:1253
msgid "Sieht aus wie ein Kaugummiautomat."
msgstr "Ser ut som en tuggummimaskin."

#: ../../msn/msn_r2.c:1254
msgid "Die Toiletten sind denen|auf der Erde sehr ähnlich."
msgstr "Toaletterna är mycket lika|dem på jorden."

#: ../../msn/msn_r2.c:1258 ../../msn/msn_r2.c:1269
msgid "Treppe"
msgstr "Trappa"

#: ../../msn/msn_r2.c:1260
msgid "Münzen"
msgstr "Mynt"

#: ../../msn/msn_r2.c:1260
msgid "Es sind seltsame|Köpfe darauf abgebildet."
msgstr "Det finns märkliga|huvuden avbildade på dem."

#: ../../msn/msn_r2.c:1262
msgid "Tablettenhülle"
msgstr "Tablettförpackning"

#: ../../msn/msn_r2.c:1262
msgid ""
"Darauf steht:\"Wenn Sie diese|Schrift jetzt lesen können,|hat die Tablette "
"gewirkt.\""
msgstr "Det står: ”Om du kan läsa|den här texten nu har|tabletten verkat.”"

#: ../../msn/msn_r2.c:1270
msgid "Stuhl"
msgstr "Stol"

#: ../../msn/msn_r2.c:1271
msgid "Schuhe"
msgstr "Skor"

#: ../../msn/msn_r2.c:1271
msgid "Wie ist der denn mit|Schuhen hier reingekommen?"
msgstr "Hur kom han in här med skorna?"

#: ../../msn/msn_r2.c:1278
msgid "Froschgesicht"
msgstr "Grodansikte"

#: ../../msn/msn_r2.c:1279
msgid "Gekritzel"
msgstr "Klotter"

#: ../../msn/msn_r2.c:1279
msgid "\"Mr Spock was here\""
msgstr "\"Mr Spock var här\""

#: ../../msn/msn_r2.c:1280
msgid "Brieftasche"
msgstr "Plånbok"

#: ../../msn/msn_r2.c:1281
msgid "Speisekarte"
msgstr "Meny"

#: ../../msn/msn_r2.c:1281
msgid "\"Heute empfehlen wir:|Fonua Opra mit Ulk.\""
msgstr "\"I dag rekommenderar vi: Fonua Opra med Ulk.\""

#: ../../msn/msn_r2.c:1282
msgid "Tasse"
msgstr "Mugg"

#: ../../msn/msn_r2.c:1282
msgid "Sie enthält eine grünliche Flüssigkeit."
msgstr "Den innehåller en grönaktig vätska."

#: ../../msn/msn_r2.c:1284
msgid "10-Buckazoid-Schein"
msgstr "En sedel på 10 buckazoider"

#: ../../msn/msn_r2.c:1284
msgid "Nicht gerade sehr viel Geld."
msgstr "Det är inte direkt mycket pengar."

#: ../../msn/msn_r2.c:1286 ../../msn/msn_r2.c:1297
msgid "Keycard von Roger"
msgstr "Rogers nyckelkort"

#: ../../msn/msn_r2.c:1301
msgid "Anzeige"
msgstr "Display"

#: ../../msn/msn_r2.c:1301 ../../msn/msn_r2.c:1302
msgid "Hmm, seltsame Anzeigen."
msgstr "Hmm, konstiga instrument."

#: ../../msn/msn_r2.c:1308
msgid "Roger W."
msgstr "Roger W."

#: ../../msn/msn_r2.c:1317
msgid "Ufo"
msgstr "UFO"

#: ../../msn/msn_r2.c:1317
msgid "Der Eingang scheint offen zu sein."
msgstr "Ingången verkar vara öppen."

#: ../../msn/msn_r3.c:27
msgid "Du drückst den Knopf,|aber nichts passiert."
msgstr "Du trycker på knappen,|men ingenting händer."

#: ../../msn/msn_r3.c:88
msgid "Bei deinem Fluchtversuch hat|dich der Roboter erschossen."
msgstr "Roboten sköt dig när du försökte fly."

#: ../../msn/msn_r3.c:91
msgid "Du ißt etwas, aber|es schmeckt scheußlich."
msgstr "Du äter något, men|det smakar hemskt."

#: ../../msn/msn_r3.c:171
msgid "Du wachst auf und findest dich in|einem geschlossenen Raum wieder."
msgstr "Du vaknar och befinner dig i ett slutet rum."

#: ../../msn/msn_r3.c:230
msgid "Äh ... nein, mein Name ist Müller."
msgstr "Öh … nej, mitt namn är Müller."

#: ../../msn/msn_r3.c:231
msgid "Oh, ich habe mich im Gang vertan."
msgstr "Åh, jag gick vilse."

#: ../../msn/msn_r3.c:237
msgid "Würden Sie mich bitte zum Fahrstuhl lassen?"
msgstr "Kan jag få använda hissen?"

#: ../../msn/msn_r3.c:238
msgid "Ich gehe wieder."
msgstr "Jag går nu."

#: ../../msn/msn_r3.c:243
msgid "Dann gehe ich eben wieder."
msgstr "Då går jag väl."

#: ../../msn/msn_r3.c:244
msgid "Ach, halten Sie's Maul, ich gehe trotzdem!"
msgstr "Håll käften, jag ska ändå gå!"

#: ../../msn/msn_r3.c:245 ../../msn/msn_r3.c:246
msgid "Wenn Sie mich durchlassen gebe ich Ihnen %d Xa."
msgstr "Om du släpper igenom mig ger jag dig %d Xa."

#: ../../msn/msn_r3.c:258
msgid "Sie schon wieder?"
msgstr "Du igen?"

#: ../../msn/msn_r3.c:264
msgid "Halt! Sie sind doch dieser Hummel.|Bleiben Sie sofort stehen!"
msgstr "Stopp! Du är den där Hummel.|Stanna genast!"
