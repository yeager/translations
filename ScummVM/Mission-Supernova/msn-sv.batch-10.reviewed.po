#: ../../msn/msn_r2.c:1240
msgid "Portier"
msgstr "Portier"

#: ../../msn/msn_r2.c:1240
msgid "Du siehst doch selbst, wie er aussieht."
msgstr "Du kan själv se hur han ser ut."

#: ../../msn/msn_r2.c:1242 ../../msn/msn_r3.c:1480 ../../msn/msn_r3.c:1545
#: ../../msn/msn_r3.c:1560 ../../msn/msn_r3.c:1569 ../../msn/msn_r3.c:1580
