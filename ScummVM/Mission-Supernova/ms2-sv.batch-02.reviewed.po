#: ../../ms2/ms2_mod.c:603
msgid "Oh!"
msgstr "Åh!"

#: ../../ms2/ms2_mod.c:605
msgid "Nicht schlecht!"
msgstr "Inte illa!"

#: ../../ms2/ms2_mod.c:607
msgid "Supersound!"
msgstr "Superljud!"

#: ../../ms2/ms2_mod.c:609
msgid "Klasse!"
msgstr "Världsklass!"

#: ../../ms2/ms2_mod.c:611
msgid "Nicht zu fassen!"
msgstr "Otroligt!"

#: ../../ms2/ms2_mod.c:613
msgid "Super, ey!"
msgstr "Häftigt!"

#: ../../ms2/ms2_mod.c:615
msgid "Fantastisch!"
msgstr "Fantastiskt!"

#: ../../ms2/ms2_mod.c:617
msgid "Umwerfend!"
msgstr "Maffigt!"

#: ../../ms2/ms2_mod.c:619
msgid "Genial!"
msgstr "Genialiskt!"

#: ../../ms2/ms2_mod.c:621
msgid "Spitze!"
msgstr "Topp!"

#: ../../ms2/ms2_mod.c:623
msgid "Jawoll!"
msgstr "Ja, verkligen!"

#: ../../ms2/ms2_mod.c:625
msgid "Hervorragend!"
msgstr "Enastående!"

#: ../../ms2/ms2_mod.c:627
msgid "Ultragut!"
msgstr "Jättebra!"

#: ../../ms2/ms2_mod.c:629
msgid "Megacool!"
msgstr "Megacool!"

#: ../../ms2/ms2_mod.c:631
msgid "Yeah!"
msgstr "Ja!"

#: ../../ms2/ms2_mus.c:60
msgid "Ein Wächter betritt den Raum.|Du wirst verhaftet."
msgstr "En vakt kommer in i rummet.|Du blir arresterad."

#: ../../ms2/ms2_mus.c:73
msgid "Die nächsten paar Jahre|verbringst du im Knast."
msgstr "Du kommer att tillbringa de|närmaste åren i fängelse."

#: ../../ms2/ms2_mus.c:145
msgid "Es wird Alarm ausgelöst."
msgstr "Ett larm utlöses."

#: ../../ms2/ms2_mus.c:200
msgid "Du hörst Schritte."
msgstr "Du hör fotsteg."

#: ../../ms2/ms2_mus.c:232
msgid "Um das Schloss zu öffnen,|brauchst du einige Zeit."
msgstr "Du behöver lite tid för|att dyrka upp låset."

#: ../../ms2/ms2_mus.c:238
msgid "Du gerätst in Panik|und ziehst die Keycard|aus der Tür."
msgstr "Du får panik|och drar ut nyckelkortet|ur dörren."

#: ../../ms2/ms2_mus.c:316
msgid "Du hast deinen Auftrag|noch nicht ausgeführt."
msgstr "Du har inte utfört|ditt uppdrag ännu."

#: ../../ms2/ms2_mus.c:322
msgid "Es gelingt dir, zu fliehen."
msgstr "Du lyckas fly."

#: ../../ms2/ms2_mus.c:330
msgid ""
"Obwohl du die Alarmanlage noch|nicht ausgeschaltet hast,|entscheidest du "
"dich, zu fliehen."
msgstr ""
"Trots att du inte har|stängt av larmet än|bestämmer du dig för att fly."

#: ../../ms2/ms2_mus.c:337
msgid ""
"Du entledigst dich der Einbruchswerkzeuge|und nimmst ein Taxi zum "
"Kulturpalast."
msgstr ""
"Du gör dig av med inbrottsverktygen|och tar en taxi till Kulturpalatset."

#: ../../ms2/ms2_mus.c:376 ../../ms2/ms2_mus.c:532 ../../ms2/ms2_mus.c:631
msgid "Diese Tür brauchst|du nicht zu öffnen."
msgstr "Du behöver inte öppna den här dörren."

#: ../../ms2/ms2_mus.c:394
msgid "Uff, es hat geklappt!"
msgstr "Puh, det fungerade!"

#: ../../ms2/ms2_mus.c:407
msgid "Zurück im Quartier der Gangster ..."
msgstr "Tillbaka i gangstrarnas gömställe …"

#: ../../ms2/ms2_mus.c:417
msgid "Das lief ja wie am Schnürchen!"
msgstr "Det gick som en klocka!"

#: ../../ms2/ms2_mus.c:418
msgid "Hier, dein Anteil von 30000 Xa."
msgstr "Här, din andel av 30000 Xa."

#: ../../ms2/ms2_mus.c:425
msgid "Wo ist denn der Saurierkopf?"
msgstr "Var är dinosauriehuvudet?"

#: ../../ms2/ms2_mus.c:426
msgid "Dazu hatte ich keine Zeit mehr."
msgstr "Jag hade inte tid med det."

#: ../../ms2/ms2_mus.c:427
msgid "Was? Du spinnst wohl!|Dann kriegst du auch deinen|Anteil nicht. Raus!"
msgstr "Va? Du måste vara galen!|Då får du inte heller|din andel. Försvinn!"

#: ../../ms2/ms2_mus.c:703
msgid "Der Sauger ist schon dort."
msgstr "Sugkoppen sitter redan där."

#: ../../ms2/ms2_mus.c:707
msgid "Du heftest den Sauger an die Wand|und hälst dich daran fest."
msgstr "Du fäster sugkoppen på väggen och håller fast i den."

#: ../../ms2/ms2_mus.c:718
msgid "Du stellst dich auf den|Boden nimmst den Sauger|wieder von der Wand"
msgstr "Du ställer dig på|golvet och tar ner sugkoppen|från väggen"

#: ../../ms2/ms2_mus.c:722
msgid "Die Alarmanlage ist|schon ausgeschaltet."
msgstr "Larmsystemet är redan avstängt."

#: ../../ms2/ms2_mus.c:725
msgid "Um die Anlage abzuschalten,|brauchst du einige Zeit."
msgstr "Du behöver lite tid för|att stänga av systemet."

#: ../../ms2/ms2_mus.c:729
msgid "Die Alarmanlage ist jetzt ausgeschaltet."
msgstr "Larmsystemet är nu avstängt."

#: ../../ms2/ms2_mus.c:746 ../../ms2/ms2_mus.c:875
msgid "Saurier"
msgstr "Dinosaurie"

#: ../../ms2/ms2_mus.c:746
msgid "Du hast jetzt besseres zu tun,|als das Ding anzuschauen."
msgstr "Du har nu bättre saker att göra|än att titta på den där saken."

