#. I18N: You already carry this.
#: ../../msn/msn.c:3341
msgid "Das trägst du doch bei dir."
msgstr "Du har redan den här med dig."

#. I18N: You're already there.
#: ../../msn/msn.c:3344
msgid "Du bist doch schon da."
msgstr "Du är redan där."

#. I18N: This is closed
#: ../../msn/msn.c:3347 ../../msn/msn_r1.c:683
msgid "Das ist geschlossen."
msgstr "Det här är stängt."

#. I18N: You already have that
#: ../../msn/msn.c:3357
msgid "Das hast du doch schon."
msgstr "Det har du redan."

#. I18N: You do not need that.
#: ../../msn/msn.c:3360
msgid "Das brauchst du nicht."
msgstr "Du behöver inte det."

#. I18N: You can't take that.
#: ../../msn/msn.c:3363
msgid "Das kannst du nicht nehmen."
msgstr "Den kan du inte ta."

#. I18N: This can't be opened
#: ../../msn/msn.c:3370
msgid "Das läßt sich nicht öffnen."
msgstr "Den går inte att öppna."

#. I18N: This is already opened.
#: ../../msn/msn.c:3373
msgid "Das ist schon offen."
msgstr "Den är redan öppen."

#. I18N: This is locked.
#: ../../msn/msn.c:3376
msgid "Das ist verschlossen."
msgstr "Den här är låst."

#. I18N: This can't be closed.
#: ../../msn/msn.c:3393
msgid "Das läßt sich nicht schließen."
msgstr "Detta går inte att dra någon slutsats av."

#. I18N: This is already closed.
#: ../../msn/msn.c:3396 ../../msn/msn_r1.c:829
msgid "Das ist schon geschlossen."
msgstr "Den är redan stängd."

