#. I18N: This is not possible.
#: ../../msn/msn.c:3418
msgid "Das geht nicht."
msgstr "Det kan du inte göra."

#: ../../msn/msn_mod.c:573
msgid "^(C) 1994 Thomas und Steffen Dingel#"
msgstr "^(C) 1994 Thomas och Steffen Dingel#"

#: ../../msn/msn_mod.c:574
msgid "Story und Grafik:^ Thomas Dingel#"
msgstr "Berättelse och grafik:^ Thomas Dingel#"

#: ../../msn/msn_mod.c:575
msgid "Programmierung:^ Steffen Dingel#"
msgstr "Programmering:^ Steffen Dingel#"

#: ../../msn/msn_mod.c:576
msgid "Musik:^ Bernd Hoffmann#"
msgstr "Musik:^ Bernd Hoffmann#"

#: ../../msn/msn_mod.c:577
msgid "Getestet von ...#"
msgstr "Testat av …#"

#: ../../msn/msn_mod.c:587
msgid "^             E#N#D#E ...########"
msgstr "^             S#L#U#T …########"

#: ../../msn/msn_mod.c:588
msgid "#       ... des ersten Teils!########"
msgstr "#       … av första delen!########"

#: ../../msn/msn_mod.c:590
msgid "^Aber:#"
msgstr "^Men:#"

#: ../../msn/msn_mod.c:591
msgid "Das Abenteuer geht weiter, ...##"
msgstr "Äventyret fortsätter …##"

#: ../../msn/msn_mod.c:592
msgid "... wenn Sie sich für 30,- DM registrieren lassen!##"
msgstr "… om du registrerar dig för 30,- DM!##"

#: ../../msn/msn_mod.c:593
msgid "(Falls Sie das nicht schon längst getan haben.)##"
msgstr "(Om du inte redan har gjort det.)##"

#: ../../msn/msn_mod.c:594
msgid "In^ Teil 2 - Der Doppelgänger^ erwarten Sie:##"
msgstr "I^ del 2 – Dubbelgångaren^ väntar:##"

#: ../../msn/msn_mod.c:595
msgid "Knifflige Puzzles,##"
msgstr "Knepiga pussel,##"

#: ../../msn/msn_mod.c:596
msgid "noch mehr Grafik und Sound,##"
msgstr "ännu mer grafik och ljud,##"

#: ../../msn/msn_mod.c:597
msgid "ein perfekt geplanter Museumseinbruch,##"
msgstr "ett perfekt planerat inbrott i ett museum,##"

#: ../../msn/msn_mod.c:598
msgid "das Virtual-Reality-Spiel \"Indiana Joe\"##"
msgstr "spelet ”Indiana Joe” i virtuell verklighet##"

#: ../../msn/msn_mod.c:599
msgid "und vieles mehr!##"
msgstr "och mycket mer!##"

#. I18N: There's nothing special about it
#: ../../msn/msn_r0.c:26
msgid "Es ist nichts Besonderes daran."
msgstr "Det är inget speciellt med det."

#. I18N: You first have to take it
#: ../../msn/msn_r0.c:28 ../../msn/msn_r0.c:230
msgid "Das mußt du erst nehmen."
msgstr "Du måste ta det först."

#. I18N: Hello
#: ../../msn/msn_r0.c:33
msgid "Hallo!"
msgstr "Hallå!"

#. I18N: Good day!
#: ../../msn/msn_r0.c:35
msgid "Guten Tag!"
msgstr "God dag!"

#. I18N: It's me, Horst Hummel
#: ../../msn/msn_r0.c:37
msgid "Ich bin's, Horst Hummel."
msgstr "Det är jag, Horst Hummel."

#: ../../msn/msn_r0.c:127
#, c-format
msgid "%d Xa"
msgstr "%d Xa"

#: ../../msn/msn_r0.c:147
msgid "Ok."
msgstr "Okej."

#: ../../msn/msn_r0.c:166
msgid "Irgendwie ist ein Raumhelm|beim Essen unpraktisch."
msgstr "Det är opraktiskt att äta med en|rymdhjälm."

#: ../../msn/msn_r0.c:182 ../../msn/msn_r0.c:192
msgid "Schmeckt ganz gut."
msgstr "Smakar ganska bra."

#: ../../msn/msn_r0.c:194
msgid "Da war irgendetwas drin,|aber jetzt hast du es|mit runtergeschluckt."
msgstr "Det fanns något i den,|men nu har du svalt det."

#: ../../msn/msn_r0.c:202
msgid "Du hast es doch schon geöffnet."
msgstr "Du har redan öppnat den."

#: ../../msn/msn_r0.c:206
msgid "In dem Ei ist eine Tablette|in einer Plastikhülle."
msgstr "I ägget finns en tablett|i ett plasthölje."

#: ../../msn/msn_r0.c:214
msgid "Du ißt die Tablette und merkst,|daß sich irgendetwas verändert hat."
msgstr "Du sväljer tabletten och märker|att något har förändrats."

#: ../../msn/msn_r0.c:224
msgid ""
"Komisch! Auf einmal kannst du die Schrift lesen!|Darauf steht:\"Wenn Sie "
"diese Schrift jetzt|lesen können, hat die Tablette gewirkt.\""
msgstr ""
"Märkligt! Plötsligt kan du läsa texten!|Där står: ”Om du kan läsa den här "
"texten nu|har tabletten fungerat.”"

#: ../../msn/msn_r0.c:232
msgid "Sie ist leer."
msgstr "Den är tom."

#: ../../msn/msn_r0.c:235
msgid "Du findest 10 Buckazoids und eine Keycard."
msgstr "Du hittar 10 Buckazoids och ett nyckelkort."

#: ../../msn/msn_r0.c:242
msgid "Es ist eine Art elektronische Zeitung."
msgstr "Det är en slags elektronisk tidning."

#: ../../msn/msn_r0.c:245
msgid "Halt, hier ist ein interessanter Artikel."
msgstr "Vänta, här är en intressant artikel."

#: ../../msn/msn_r0.c:268
msgid "Hmm, irgendwie komme|ich mir verarscht vor."
msgstr "På något sätt känns det som om jag blir lurad."

#: ../../msn/msn_r0.c:273
msgid "Es ist die Keycard des Commanders."
msgstr "Det är befälhavarens nyckelkort."

#: ../../msn/msn_r0.c:277
msgid ""
"Es ist eine Uhr mit extra|lautem Wecker. Sie hat einen|Knopf zum Verstellen "
"der Alarmzeit.|Uhrzeit: %s   Alarmzeit: %s"
msgstr ""
"Det är en klocka med ett mycket|högt larm. Den har en knapp för|att ställa "
"larmtiden.|Tid: %s   Alarm: %s"

#: ../../msn/msn_r0.c:291
msgid "Neue Alarmzeit (hh:mm) :"
msgstr "Ny larmtid (hh:mm):"

#: ../../msn/msn_r0.c:332 ../../msn/msn_r1.c:486 ../../msn/msn_r1.c:595
msgid "Leitung mit Lüsterklemme"
msgstr "Kabel med glansplint"

#: ../../msn/msn_r0.c:344
msgid "Kabelrolle mit Lüsterklemme"
msgstr "Kabelvinda med glansplint"

#: ../../msn/msn_r0.c:355 ../../msn/msn_r1.c:495 ../../msn/msn_r1.c:604
msgid "Womit denn?"
msgstr "Med vad?"

#: ../../msn/msn_r0.c:366 ../../msn/msn_r1.c:499 ../../msn/msn_r1.c:608
#: ../../msn/msn_r1_r.c:115
msgid "langes Kabel mit Stecker"
msgstr "lång kabel med kontakt"

#: ../../msn/msn_r0.c:381 ../../msn/msn_r0.c:418 ../../msn/msn_r0.c:454
msgid "Die Luft hier ist atembar,|du ziehst den Anzug aus."
msgstr "Luften här går att andas,|du tar av dig dräkten."

#: ../../msn/msn_r0.c:387 ../../msn/msn_r0.c:424 ../../msn/msn_r0.c:460
msgid "Hier drinnen brauchst du deinen Anzug nicht."
msgstr "Du behöver inte dräkten här inne."

#: ../../msn/msn_r0.c:395
msgid "Du mußt erst den Helm abnehmen."
msgstr "Du måste ta av dig hjälmen först."

#: ../../msn/msn_r0.c:397
msgid "Du mußt erst den Versorgungsteil abnehmen."
msgstr "Du måste först ta bort syrgasenheten."

#: ../../msn/msn_r0.c:401
msgid "Du ziehst den Raumanzug aus."
msgstr "Du tar av dig rymddräkten."

#: ../../msn/msn_r0.c:407
msgid "Du ziehst den Raumanzug an."
msgstr "Du tar på dig rymddräkten."
