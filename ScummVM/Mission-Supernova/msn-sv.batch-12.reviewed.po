#: ../../msn/msn_r3.c:1112
msgid "Verbindung unmöglich"
msgstr "Anslutning kan inte upprättas"

#: ../../msn/msn_r3.c:1116
msgid "Verbindung wird hergestellt"
msgstr "Anslutningen upprättas"

#. I18N: Here the %s is a name
#: ../../msn/msn_r3.c:1121
#, c-format
msgid "%s am Apparat."
msgstr "%s här."

#: ../../msn/msn_r3.c:1127
#, c-format
msgid "Hier ist %s. Können Sie mal gerade kommen?"
msgstr "Det här är %s. Kan du komma hit genast?"

#: ../../msn/msn_r3.c:1134
msgid "Huch, Sie hören sich aber|nicht gut an. Ich komme sofort."
msgstr "Oj, du låter inte så bra. Jag kommer strax."

#: ../../msn/msn_r3.c:1145
msgid "Horst Hummel! Von wo rufen Sie an?"
msgstr "Horst Hummel! Varifrån ringer du?"

#: ../../msn/msn_r3.c:1151
msgid "Hmm, keine Antwort."
msgstr "Hmm, inget svar."

#: ../../msn/msn_r3.c:1164
msgid "Passwort:"
msgstr "Lösenord:"

#: ../../msn/msn_r3.c:1215
msgid "Was war das für ein Geräusch?"
msgstr "Vad var det för oljud?"

#: ../../msn/msn_r3.c:1217 ../../msn/msn_s.c:312
msgid "Ich werde mal nachsehen."
msgstr "Jag ska ta en titt."

#: ../../msn/msn_r3.c:1305
msgid "Jetzt verschwinden Sie endlich!"
msgstr "Försvinn härifrån nu!"

#: ../../msn/msn_r3.c:1306
msgid "Huch, ich habe mich vertan."
msgstr "Oj, jag gjorde ett misstag."

#: ../../msn/msn_r3.c:1368
msgid ""
"Nachdem du zwei Stunden im|Dschungel herumgeirrt bist,|findest du ein "
"Gebäude."
msgstr ""
"Efter att ha irrat omkring i|djungeln i två timmar hittar|du en byggnad."

#: ../../msn/msn_r3.c:1481
msgid "Tablett"
msgstr "Bricka"

#: ../../msn/msn_r3.c:1481
msgid "Es ist irgendein Fraß und|etwas zu Trinken darauf."
msgstr "Det finns lite mat och något att dricka på den."

#: ../../msn/msn_r3.c:1483
msgid "Stange"
msgstr "Stång"

#: ../../msn/msn_r3.c:1483
msgid "Es scheint eine Lampe zu sein."
msgstr "Det ser ut att vara en lampa."

#: ../../msn/msn_r3.c:1484
msgid "Augen"
msgstr "Ögon"

#: ../../msn/msn_r3.c:1484
msgid "Es ist nur ein Bild."
msgstr "Det är bara en bild."

#: ../../msn/msn_r3.c:1486
msgid "Sieht etwas anders aus als auf der Erde."
msgstr "Ser lite annorlunda ut än på jorden."

#: ../../msn/msn_r3.c:1488
msgid "Metallblock"
msgstr "Metallblock"

#: ../../msn/msn_r3.c:1488
msgid "Er ist ziemlich schwer."
msgstr "Den är ganska tung."

#: ../../msn/msn_r3.c:1490
msgid "Roboter"
msgstr "Robot"

#: ../../msn/msn_r3.c:1490
msgid "Den hast du erledigt."
msgstr "Du tog hand om den."

#: ../../msn/msn_r3.c:1491 ../../msn/msn_r3.c:1528
msgid "Tisch"
msgstr "Bord"

#: ../../msn/msn_r3.c:1491
msgid "Ein kleiner Metalltisch."
msgstr "Ett litet metallbord."

#: ../../msn/msn_r3.c:1524
msgid "Zellentür"
msgstr "Celldörr"

#: ../../msn/msn_r3.c:1524
msgid "Hier warst du eingesperrt."
msgstr "Du var inlåst här."

#: ../../msn/msn_r3.c:1526
msgid "Laptop"
msgstr "Bärbar dator"

#: ../../msn/msn_r3.c:1576 ../../msn/msn_r3.c:1577
msgid "Säule"
msgstr "Pelare"

#: ../../msn/msn_r3.c:1580
msgid "Auf einem Schild an der Tür steht \"Dr. Alab Hansi\"."
msgstr "På en skylt på dörren står det \"Dr Alab Hansi\"."

#: ../../msn/msn_r3.c:1582
msgid "Auf einem Schild an der Tür steht \"Saval Lun\"."
msgstr "På dörren finns en skylt med texten \"Saval Lun\"."

#: ../../msn/msn_r3.c:1584
msgid "Auf einem Schild an der Tür steht \"Prof. Dr. Ugnul Tschabb\"."
msgstr "På dörren finns en skylt med texten \"Prof Dr Ugnul Tschabb\"."

#: ../../msn/msn_r3.c:1586
msgid "Auf einem Schild an der Tür steht \"Alga Hurz Li\"."
msgstr "På dörren finns en skylt med texten \"Alga Hurz Li\"."

#: ../../msn/msn_r3.c:1597 ../../msn/msn_r3.c:1613
msgid "Axacussaner"
msgstr "Axacussan"

#: ../../msn/msn_r3.c:1597
msgid "Du müßtest ihn irgendwie ablenken."
msgstr "Du måste distrahera honom på nåt sätt."

#: ../../msn/msn_r3.c:1599
msgid "Komisches Bild."
msgstr "Konstig bild."

#: ../../msn/msn_r3.c:1600
msgid "Karte"
msgstr "Nyckelkort"

#: ../../msn/msn_r3.c:1600
msgid "Darauf steht: \"Generalkarte\"."
msgstr "Det står: ”Huvudnyckelkort”."

#: ../../msn/msn_r3.c:1612
msgid "Lampe"
msgstr "Lampa"

#: ../../msn/msn_r3.c:1614
msgid "Seltsam!"
msgstr "Konstigt!"

#: ../../msn/msn_r3.c:1623 ../../msn/msn_r3.c:1670
msgid "Geld"
msgstr "Pengar"

#: ../../msn/msn_r3.c:1623
msgid "Es sind 500 Xa."
msgstr "Det finns 500 Xa."

#: ../../msn/msn_r3.c:1624
msgid "Schließfach"
msgstr "Förvaringsskåp"

#: ../../msn/msn_r3.c:1624
msgid "Es hat ein elektronisches Zahlenschloß."
msgstr "Den har ett elektroniskt kombinationslås."

#: ../../msn/msn_r3.c:1626
msgid "Brief"
msgstr "Brev"

#: ../../msn/msn_r3.c:1635
msgid "Würfel"
msgstr "Tärningar"

#: ../../msn/msn_r3.c:1635
msgid "Sonderbar!"
msgstr "Underligt!"

#: ../../msn/msn_r3.c:1636
msgid "Affenstark!"
msgstr "Häftigt!"

#: ../../msn/msn_r3.c:1637
msgid "Komisches Ding"
msgstr "Konstig sak"
