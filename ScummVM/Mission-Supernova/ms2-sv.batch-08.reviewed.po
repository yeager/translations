#: ../../ms2/ms2_r2.c:87
msgid "Wer sind Sie?"
msgstr "Vem är du?"

#: ../../ms2/ms2_r2.c:88
msgid "Horst Hummel!"
msgstr "Horst Hummel!"

#: ../../ms2/ms2_r2.c:89
msgid "Kenne ich nicht."
msgstr "Jag har aldrig hört talas om honom."

#: ../../ms2/ms2_r2.c:90
msgid "Was, Sie kennen den berühmten Horst Hummel nicht?"
msgstr "Känner du inte till den berömde Horst Hummel?"

#: ../../ms2/ms2_r2.c:91
msgid "Ich bin doch der, der immer im Fernsehen zu sehen ist."
msgstr "Jag är den som alltid är på teven."

#: ../../ms2/ms2_r2.c:92
msgid "Ich kenne Sie wirklich nicht."
msgstr "Jag känner dig verkligen inte."

#: ../../ms2/ms2_r2.c:93
msgid "Komisch."
msgstr "Konstigt."

#: ../../ms2/ms2_r2.c:95 ../../ms2/ms2_r2.c:1155
msgid "Aha."
msgstr "Jag förstår."

#: ../../ms2/ms2_r2.c:97
msgid "Ja, kann ich."
msgstr "Ja, det kan jag."

#: ../../ms2/ms2_r2.c:98
msgid "Von wem denn?"
msgstr "Från vem?"

#: ../../ms2/ms2_r2.c:99
msgid "Diese Information kostet einen Xa."
msgstr "Denna information kostar en Xa."

#: ../../ms2/ms2_r2.c:104
msgid "Wie Sie meinen."
msgstr "Som du vill."

#: ../../ms2/ms2_r2.c:110
msgid "Sie können die Karte von MIR bekommen!"
msgstr "Du kan få biljetten av MIG!"

#: ../../ms2/ms2_r2.c:111
msgid "Aber nur eine Teilnahmekarte,|keine Eintrittskarte."
msgstr "Men bara en deltagarbiljett,|inte en entrébiljett."

#: ../../ms2/ms2_r2.c:112
msgid "Was wollen Sie dafür haben?"
msgstr "Vad vill du ha i gengäld?"

#: ../../ms2/ms2_r2.c:113
msgid "Machen Sie ein Angebot!"
msgstr "Lägg ett bud!"

#: ../../ms2/ms2_r2.c:133
msgid "Das ist ein gutes Angebot!"
msgstr "Det är ett bra erbjudande!"

#: ../../ms2/ms2_r2.c:135
msgid "Dafür gebe ich Ihnen meine|letzte Teilnahmekarte!"
msgstr "För det ger jag dig min|sista deltagarbiljett!"

#: ../../ms2/ms2_r2.c:140
msgid "(Dieser Trottel!)"
msgstr "(Den idioten!)"

#: ../../ms2/ms2_r2.c:190
msgid "Ich würde gern beim Musikwettbewerb zuschauen."
msgstr "Jag skulle gärna vilja se musiktävlingen."

#: ../../ms2/ms2_r2.c:191
msgid "Ich würde gern am Musikwettbewerb teilnehmen."
msgstr "Jag skulle vilja delta i musiktävlingen."

#: ../../ms2/ms2_r2.c:192
msgid "Wieviel Uhr haben wir?"
msgstr "Vad är klockan?"

#: ../../ms2/ms2_r2.c:196 ../../ms2/ms2_r2.c:749
msgid "Ja."
msgstr "Ja."

#: ../../ms2/ms2_r2.c:197 ../../ms2/ms2_r2.c:379 ../../ms2/ms2_r2.c:391
#: ../../ms2/ms2_r2.c:697
msgid "Nein."
msgstr "Nej."

#: ../../ms2/ms2_r2.c:201
msgid "Hallo, Leute!"
msgstr "Hej, gott folk!"

#: ../../ms2/ms2_r2.c:202
msgid "Hi, Fans!"
msgstr "Hej, fans!"

#: ../../ms2/ms2_r2.c:203
msgid "Gute Nacht!"
msgstr "God natt!"

#: ../../ms2/ms2_r2.c:207
msgid "Äh, wie geht es euch?"
msgstr "Öh, hur mår ni?"

#: ../../ms2/ms2_r2.c:208
msgid "Schönes Wetter heute."
msgstr "Fint väder idag."

#: ../../ms2/ms2_r2.c:212
msgid "Hmm ..."
msgstr "Hmm …"

#: ../../ms2/ms2_r2.c:213
msgid "Tja ..."
msgstr "Tja …"

#: ../../ms2/ms2_r2.c:214
msgid "Also ..."
msgstr "Alltså …"

#: ../../ms2/ms2_r2.c:218
msgid "Ok, los gehts!"
msgstr "Okej, nu kör vi!"

#: ../../ms2/ms2_r2.c:219
msgid "Ich klimper mal was auf dem Keyboard hier."
msgstr "Jag spelar lite på|klaviaturen här."

#: ../../ms2/ms2_r2.c:234
msgid "Halt, sie sind doch schon drangewesen!"
msgstr "Vänta, de har redan haft sin tur!"

#: ../../ms2/ms2_r2.c:240
msgid "He, Sie! Haben Sie|eine Eintrittskarte?"
msgstr "Hallå, du där! Har du|en biljett?"

#: ../../ms2/ms2_r2.c:244
msgid "Ja natürlich, hier ist meine Teilnahmekarte."
msgstr "Ja, naturligtvis. Här är|min deltagarbiljett."

#: ../../ms2/ms2_r2.c:245
msgid ""
"Sie sind Teilnehmer! Fragen|Sie bitte an der Kasse nach,|wann Sie auftreten "
"können."
msgstr "Du är deltagare! Fråga|i kassan när|du får uppträda."

#: ../../ms2/ms2_r2.c:247
msgid "Äh, nein."
msgstr "Öh, nej."

#: ../../ms2/ms2_r2.c:252
msgid "He, wo ist Ihr Musikchip?"
msgstr "Var är ditt musikchip?"

#: ../../ms2/ms2_r2.c:267
msgid "Laber nicht!"
msgstr "Sluta snacka!"

#: ../../ms2/ms2_r2.c:270
msgid "Fang an!"
msgstr "Kom igång!"

#: ../../ms2/ms2_r2.c:273
msgid "Einen Moment, ich muß erstmal überlegen, was ich|euch spiele."
msgstr "Ett ögonblick, jag måste|först tänka på vad jag|ska spela för er."

#: ../../ms2/ms2_r2.c:275
msgid "Anfangen!!!"
msgstr "Kom igång!!!"

#: ../../ms2/ms2_r2.c:278
msgid "Nun denn ..."
msgstr "Nåväl …"

#: ../../ms2/ms2_r2.c:279
msgid "Raus!"
msgstr "Ut!"

#: ../../ms2/ms2_r2.c:291 ../../ms2/ms2_r2.c:306
msgid "Buh!"
msgstr "Bu!"

#: ../../ms2/ms2_r2.c:298
msgid "Aufhören!"
msgstr "Sluta!"

#: ../../ms2/ms2_r2.c:309
msgid "Hilfe!"
msgstr "Hjälp!"

#: ../../ms2/ms2_r2.c:312
msgid "Ich verziehe mich lieber."
msgstr "Det är bäst att jag går härifrån."
