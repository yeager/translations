#: ../../msn/msn_s.c:315
msgid "Scheißetagenbett!"
msgstr "Jävla våningssäng!"

#: ../../msn/msn_s.c:317
msgid "Erst mal den Lichtschalter finden."
msgstr "Leta först upp ljusströmbrytaren."

#: ../../msn/msn_s.c:318
msgid "Hmm, gar nicht so einfach|bei Schwerelosigkeit."
msgstr "Hmm, inte så lätt|i tyngdlöshet."

#: ../../msn/msn_s.c:320
msgid "Ah, hier ist er."
msgstr "Ah, här är den."
