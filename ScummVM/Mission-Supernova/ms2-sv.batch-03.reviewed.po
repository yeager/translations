#: ../../ms2/ms2_pyra.c:1230 ../../ms2/ms2_pyra.c:1238
#: ../../ms2/ms2_pyra.c:1246
msgid "Gang"
msgstr "Korridor"

#: ../../ms2/ms2_mus.c:875
msgid "Ziemlich groß."
msgstr "Ganska stor."

#: ../../ms2/ms2_mus.c:876 ../../ms2/ms2_r1.c:787
msgid "Saurierkopf"
msgstr "Dinosauriehuvud"

#: ../../ms2/ms2_mus.c:876
msgid "Dies ist der Kopf,|den du suchst."
msgstr "Det här är huvudet|du letar efter."

#: ../../ms2/ms2_mus.c:975
msgid "Alarmanlage"
msgstr "Larmsystem"

#: ../../ms2/ms2_mus.c:976 ../../ms2/ms2_r1.c:783
msgid "Sauger"
msgstr "Sugkopp"

#: ../../ms2/ms2_mus.c:977
msgid "Wand"
msgstr "Vägg"

#: ../../ms2/ms2_pyra.c:26 ../../ms2/ms2_pyra.c:1255 ../../ms2/ms2_pyra.c:1256
#: ../../ms2/ms2_pyra.c:1274 ../../ms2/ms2_pyra.c:1284
msgid "Loch"
msgstr "Hål"

#: ../../ms2/ms2_pyra.c:27
msgid "Buchstabe"
msgstr "Bokstav"

#: ../../ms2/ms2_pyra.c:28
msgid "Sie ist sehr massiv."
msgstr "Den är mycket solid."

#: ../../ms2/ms2_pyra.c:29
msgid "Hmm, X und Y, irgendwo|habe ich die Buchstaben|schon gesehen."
msgstr "Hmm, X och Y, de bokstäverna|har jag sett någonstans|förut."

#: ../../ms2/ms2_pyra.c:34
msgid "Deine Zeit ist um, Fremder!"
msgstr "Din tid är ute, främling!"

#: ../../ms2/ms2_pyra.c:76
msgid "Du hast das Seil|doch schon festgebunden."
msgstr "Du har ju redan|knutit fast repet."

#: ../../ms2/ms2_pyra.c:80
msgid "Das würde wenig bringen."
msgstr "Det skulle inte vara till någon större nytta."

#: ../../ms2/ms2_pyra.c:126
msgid "Sonnenstich, oder was?"
msgstr "Solsting, eller vad?"

#: ../../ms2/ms2_pyra.c:385
msgid "Du merkst, daß der Boden|unter dir nachgibt, und|springst zur Seite."
msgstr "Du märker att marken|under dig ger vika och|hoppar åt sidan."

#: ../../ms2/ms2_pyra.c:537
msgid "Puzzleteil"
msgstr "Pusselbit"

#: ../../ms2/ms2_pyra.c:570
msgid "Neben diesem Stein|ist kein freies Feld."
msgstr "Det finns ingen ledig ruta|bredvid den här stenen."

#: ../../ms2/ms2_pyra.c:683
msgid "Du spielst gerade ein|Adventure, kein Rollenspiel!"
msgstr "Du spelar ett äventyrsspel, inte ett rollspel!"

#: ../../ms2/ms2_pyra.c:699 ../../ms2/ms2_pyra.c:800
msgid "Du kannst das Seil|nirgends befestigen."
msgstr "Du kan inte fästa repet|någonstans."

#: ../../ms2/ms2_pyra.c:705 ../../ms2/ms2_pyra.c:784
msgid "Es paßt nicht|zwischen die Steine."
msgstr "Den passar inte|mellan stenarna."

#: ../../ms2/ms2_pyra.c:710 ../../ms2/ms2_pyra.c:741 ../../ms2/ms2_pyra.c:840
msgid "Das ist doch|oben festgebunden!"
msgstr "Det är ju|fastbundet där uppe!"

#: ../../ms2/ms2_pyra.c:715
msgid "Hey, das ist|mindestens 10 Meter tief!"
msgstr "Det är ju|minst 10 meter djupt!"

#: ../../ms2/ms2_pyra.c:731
msgid "In dem Schlitz|ist nichts mehr."
msgstr "Det finns inget kvar|i öppningen."

#: ../../ms2/ms2_pyra.c:765
msgid "Das ist mindestens 5 Meter tief!"
msgstr "Det är minst 5 meter djupt!"

#: ../../ms2/ms2_pyra.c:900
msgid ""
"Du versuchst, den Sarg zu|öffnen, aber der Deckel bewegt|sich keinen "
"Millimeter."
msgstr "Du försöker öppna kistan,|men locket rör sig|inte en millimeter."

#: ../../ms2/ms2_pyra.c:913 ../../ms2/ms2_pyra.c:923
msgid "Du hast die Kugel schon gedrückt."
msgstr "Du har redan tryckt på bollen."

#: ../../ms2/ms2_pyra.c:944
msgid "Die Kugel bewegt sich ein Stück."
msgstr "Bollen rör sig en aning."

#: ../../ms2/ms2_pyra.c:961
msgid "Das Auge ist schon offen."
msgstr "Ögat är redan öppet."

#: ../../ms2/ms2_pyra.c:965
msgid "Herzlichen Glückwunsch!"
msgstr "Grattis!"

#: ../../ms2/ms2_pyra.c:966
msgid "Sie haben das Spiel gelöst|und gewinnen 400 Xa!"
msgstr "Du har klarat spelet|och får 400 Xa!"

#: ../../ms2/ms2_pyra.c:967
msgid "Vielen Dank für die Benutzung eines|VIRTUAL-REALITY-SYSTEMS-Produkts!"
msgstr "Tack för att du använder en|produkt från VIRTUAL-REALITY-SYSTEMS!"

#: ../../ms2/ms2_pyra.c:991
msgid "N"
msgstr "N"

#: ../../ms2/ms2_pyra.c:991
msgid "O"
msgstr "Ö"

#: ../../ms2/ms2_pyra.c:991
msgid "S"
msgstr "S"

#: ../../ms2/ms2_pyra.c:991
msgid "W"
msgstr "W"

#: ../../ms2/ms2_pyra.c:1008 ../../ms2/ms2_pyra.c:1200
#: ../../ms2/ms2_pyra.c:1254 ../../ms2/ms2_pyra.c:1262
#: ../../ms2/ms2_pyra.c:1273 ../../ms2/ms2_pyra.c:1283
msgid "Seil"
msgstr "Rep"

#: ../../ms2/ms2_pyra.c:1009 ../../ms2/ms2_pyra.c:1043 ../../ms2/ms2_r1.c:850
#: ../../ms2/ms2_r2.c:1223 ../../ms2/ms2_r2.c:1224 ../../ms2/ms2_r2.c:1233
#: ../../ms2/ms2_r2.c:1234
msgid "Schild"
msgstr "Skylt"

#: ../../ms2/ms2_pyra.c:1009
msgid ""
"Darauf steht:|\"Willst du finden das|richtige Loch, so wage|dich in die "
"Pyramide!\"."
msgstr "Det står:|”Vill du hitta|rätt hål? Våga dig då|in i pyramiden!”."

#: ../../ms2/ms2_pyra.c:1010
msgid "Es ist eine kleine Öffnung."
msgstr "Det är en liten öppning."

#: ../../ms2/ms2_pyra.c:1011
msgid "Pyramide"
msgstr "Pyramid"

#: ../../ms2/ms2_pyra.c:1011
msgid ""
"Komisch! Was soll eine Pyramide|bei den Axacussanern? Deine|eigenen Gedanken"
" scheinen|den Spielverlauf zu beeinflussen."
msgstr ""
"Märkligt! Vad gör en pyramid|bland axacussanerna? Dina|egna tankar verkar "
"påverka|spelets gång."

#: ../../ms2/ms2_pyra.c:1012
msgid "Sonne"
msgstr "Solen"

#: ../../ms2/ms2_pyra.c:1012
msgid "Schön!"
msgstr "Vackert!"

#: ../../ms2/ms2_pyra.c:1043
msgid ""
"\"Hallo Fremder, wenn du diesen|Raum betreten hast, bleibt|dir nur noch eine"
" Stunde Zeit,|um deine Aufgabe zu erfüllen!\""
msgstr ""
"”Hej främling, när du kommer in i|det här rummet har du bara en timme|på dig"
" att utföra din uppgift!”"

