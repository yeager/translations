#: ../../msn/msn_r1_r.c:186 ../../msn/msn_r1_r.c:195 ../../msn/msn_r1_r.c:204
#: ../../msn/msn_r1_r.c:222 ../../msn/msn_r1_r.c:248 ../../msn/msn_r1_r.c:262
#: ../../msn/msn_r1_r.c:264 ../../msn/msn_r1_r.c:267 ../../msn/msn_r1_r.c:282
#: ../../msn/msn_r2.c:1299
msgid "Fach"
msgstr "Fack"

#: ../../msn/msn_r1_r.c:155 ../../msn/msn_r1_r.c:170 ../../msn/msn_r1_r.c:206
#: ../../msn/msn_r1_r.c:224 ../../msn/msn_r1_r.c:250 ../../msn/msn_r1_r.c:278
#: ../../msn/msn_r2.c:1254
msgid "Toilette"
msgstr "Toalett"

#: ../../msn/msn_r1_r.c:161 ../../msn/msn_r1_r.c:176 ../../msn/msn_r2.c:1283
msgid "Schachspiel"
msgstr "Schackspel"

#: ../../msn/msn_r1_r.c:161
msgid "Es macht wohl Spaß, an|der Decke Schach zu spielen."
msgstr "Det måste vara kul att spela schack i taket."

#: ../../msn/msn_r1_r.c:163
msgid "Tennisschläger"
msgstr "Tennisracket"

#: ../../msn/msn_r1_r.c:163
msgid "Fliegt Boris Becker auch mit?"
msgstr "Är Boris Becker också med i besättningen?"

#: ../../msn/msn_r1_r.c:164
msgid "Tennisball"
msgstr "Tennisboll"

#: ../../msn/msn_r1_r.c:164 ../../msn/msn_r1_r.c:213
msgid "Toll!"
msgstr "Jättebra!"

#: ../../msn/msn_r1_r.c:176
msgid "Dein Magnetschachspiel. Schach war|schon immer deine Leidenschaft."
msgstr "Ditt magnetiska schackspel. Schack har|alltid varit din passion."

#: ../../msn/msn_r1_r.c:178
msgid "Bett"
msgstr "Säng"

#: ../../msn/msn_r1_r.c:178
msgid "Das ist dein Bett. Toll, nicht wahr?"
msgstr "Det här är din säng. Visst är den fin?"

#: ../../msn/msn_r1_r.c:183 ../../msn/msn_r1_r.c:186 ../../msn/msn_r1_r.c:195
msgid "Das ist eins deiner drei Fächer."
msgstr "Det här är ett av dina tre fack."
