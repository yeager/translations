msgstr "Tangentbord"

#: ../../msn/msn_r1_r.c:116
msgid "leere Kabelrolle"
msgstr "Tom kabelvinda"

#: ../../msn/msn_r1_r.c:117
msgid ""
"Hey, das ist die Keycard des Commanders!|Er muß sie bei dem "
"überstürzten|Aufbruch verloren haben."
msgstr ""
"Det är befälhavarens nyckelkort!|Han måste ha tappat det under|den hastiga "
"avfärden."

#: ../../msn/msn_r1_r.c:119 ../../msn/msn_r1_r.c:137 ../../msn/msn_r1_r.c:188
#: ../../msn/msn_r2.c:1212
msgid "Seil"
msgstr "Rep"

#: ../../msn/msn_r1_r.c:124
