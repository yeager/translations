#: ../../msn/msn_r1_r.c:243 ../../msn/msn_r3.c:1485
msgid "Leitung"
msgstr "Kabel"

#: ../../msn/msn_r1_r.c:126
msgid "Spannungmessgerät"
msgstr "Voltmeter"

#: ../../msn/msn_r1_r.c:127
msgid "Klemme"
msgstr "Klämma"

#: ../../msn/msn_r1_r.c:128
msgid "Sie führt vom Generator zum Spannungmessgerät."
msgstr "Den går från generatorn till voltmätaren."

#: ../../msn/msn_r1_r.c:143 ../../msn/msn_r1_r.c:212 ../../msn/msn_r1_r.c:213
#: ../../msn/msn_r1_r.c:214 ../../msn/msn_r1_r.c:217 ../../msn/msn_r3.c:1599
#: ../../msn/msn_r3.c:1614 ../../msn/msn_r3.c:1636 ../../msn/msn_r3.c:1646
#: ../../msn/msn_r3.c:1647
msgid "Bild"
msgstr "Bild"

#: ../../msn/msn_r1_r.c:143
msgid "Manche Leute haben schon|einen komischen Geschmack."
msgstr "Vissa människor har konstig smak."

#: ../../msn/msn_r1_r.c:145
msgid "Zeichengeräte"
msgstr "Ritningsinstrument"

#: ../../msn/msn_r1_r.c:146
msgid ""
"Auf dem Zettel sind lauter|unverständliche Skizzen und "
"Berechnungen.|(Jedenfalls für dich unverständlich.)"
msgstr ""
"Papperet är fullt av|obegripliga skisser och beräkningar.|(Åtminstone för "
"dig.)"

#: ../../msn/msn_r1_r.c:148 ../../msn/msn_r1_r.c:215 ../../msn/msn_r1_r.c:233
#: ../../msn/msn_r1_r.c:276
msgid "Magnete"
msgstr "Magneter"

#: ../../msn/msn_r1_r.c:148 ../../msn/msn_r1_r.c:215 ../../msn/msn_r1_r.c:233
#: ../../msn/msn_r1_r.c:276
msgid "Damit werden Sachen auf|dem Tisch festgehalten."
msgstr "De håller fast saker|på bordet."

#: ../../msn/msn_r1_r.c:152 ../../msn/msn_r1_r.c:167 ../../msn/msn_r1_r.c:190
#: ../../msn/msn_r1_r.c:203 ../../msn/msn_r1_r.c:221 ../../msn/msn_r1_r.c:247
