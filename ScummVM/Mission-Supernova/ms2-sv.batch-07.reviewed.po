#: ../../ms2/ms2_r1.c:819 ../../ms2/ms2_r1.c:820
msgid "Stange"
msgstr "Stång"

#: ../../ms2/ms2_r1.c:821
msgid "Pfosten"
msgstr "Stolpe"

#: ../../ms2/ms2_r1.c:822
msgid "Geländer"
msgstr "Räcke"

#: ../../ms2/ms2_r1.c:829
msgid "Plakat"
msgstr "Affisch"

#: ../../ms2/ms2_r1.c:829
msgid ""
"Musik Pur - Der Musikwettbewerb!|Heute im "
"Kulturpalast|Hauptpreis:|Fernsehauftritt mit Horst Hummel|Sponsored by Artus"
" GmbH"
msgstr ""
"Musik för fulla muggar – musiktävlingen!|I dag på "
"Kulturpalatset|Förstapris:|Ett tv-framträdande med Horst Hummel|Sponsras av "
"Artus GmbH"

#: ../../ms2/ms2_r1.c:830 ../../ms2/ms2_r1.c:831
msgid "Kabine"
msgstr "Telefonhytt"

#: ../../ms2/ms2_r1.c:830
msgid "Sie ist frei!"
msgstr "Den är ledig!"

#: ../../ms2/ms2_r1.c:831
msgid "Sie ist besetzt."
msgstr "Den är upptagen."

#: ../../ms2/ms2_r1.c:832
msgid "Füße"
msgstr "Fötter"

#: ../../ms2/ms2_r1.c:832
msgid "Komisch, die|Füße scheinen|erstarrt zu sein."
msgstr "Konstigt, fötterna|verkar ha|frusit fast."

#: ../../ms2/ms2_r1.c:841
msgid "Haube"
msgstr "Hårtorkshuva"

#: ../../ms2/ms2_r1.c:841
msgid "Sieht aus wie beim Frisör."
msgstr "Det ser ut som en frisörsalong."

#: ../../ms2/ms2_r1.c:842
msgid "400 Xa"
msgstr "400 Xa"

#: ../../ms2/ms2_r1.c:843
msgid "10 Xa"
msgstr "10 Xa"

#: ../../ms2/ms2_r1.c:844
msgid "Darüber steht:|\"Geldeinwurf: 10 Xa\"."
msgstr "Ovanför står det:|”Myntinkast: 10 Xa”."

#: ../../ms2/ms2_r1.c:845
msgid "Darüber steht:|\"Gewinnausgabe / Geldrückgabe\"."
msgstr "Ovanför står det:|”Vinstutbetalning / återbetalning”."

#: ../../ms2/ms2_r1.c:846 ../../ms2/ms2_r2.c:1264
msgid "Stuhl"
msgstr "Stol"

#: ../../ms2/ms2_r1.c:846
msgid "Etwas Entspannung könntest du jetzt gebrauchen."
msgstr "Du skulle behöva lite avkoppling just nu."

#: ../../ms2/ms2_r1.c:847 ../../ms2/ms2_r1.c:848
msgid "Gekritzel"
msgstr "Klotter"

#: ../../ms2/ms2_r1.c:849 ../../ms2/ms2_r1.c:873
msgid "Gesicht"
msgstr "Ansikte"

#: ../../ms2/ms2_r1.c:849
msgid "Nicht zu fassen! Die|Wände sind genauso beschmutzt|wie auf der Erde."
msgstr "Otroligt! Väggarna är lika smutsiga som på jorden."

#: ../../ms2/ms2_r1.c:858
msgid "Bücher"
msgstr "Böcker"

#: ../../ms2/ms2_r1.c:859
msgid "Lexikon"
msgstr "Lexikon"

#: ../../ms2/ms2_r1.c:860
msgid "Pflanze"
msgstr "Växt"

#: ../../ms2/ms2_r1.c:861
msgid "Maske"
msgstr "Mask"

#: ../../ms2/ms2_r1.c:862
msgid "Schlange"
msgstr "Orm"

#: ../../ms2/ms2_r1.c:863
msgid "Becher"
msgstr "Bägare"

#: ../../ms2/ms2_r1.c:864
msgid "Joystick"
msgstr "Joystick"

#: ../../ms2/ms2_r1.c:865
msgid "Eine normale Zahnbürste,|es steht nur \"Artus\" darauf."
msgstr "En vanlig tandborste,|det står bara ”Artus” på den."

#: ../../ms2/ms2_r1.c:866
msgid "Musikgerät"
msgstr "Musikspelare"

#: ../../ms2/ms2_r1.c:866
msgid ""
"Ein Gerät zum Abspielen und|Aufnehmen von Musikchips.|Es ist ein Mikrofon "
"daran."
msgstr ""
"En apparat för att spela upp och|spela in musikchipp.|Den har en mikrofon."

#: ../../ms2/ms2_r1.c:867 ../../ms2/ms2_r1.c:868 ../../ms2/ms2_r1.c:869
#: ../../ms2/ms2_r1.c:870 ../../ms2/ms2_r1.c:871
msgid "Flasche"
msgstr "Flaska"

#: ../../ms2/ms2_r1.c:867
msgid "Auf dem Etikett steht:|\"Enthält 10% Hyperalkohol\"."
msgstr "På etiketten står det:|”Innehåller 10 % hyperalkohol”."

#: ../../ms2/ms2_r1.c:872
msgid "Kiste"
msgstr "Låda"

#: ../../ms2/ms2_r1.c:874
msgid "Verkäufer"
msgstr "Säljare"

#: ../../ms2/ms2_r2.c:36
msgid "Was? Dafür wollen Sie die Karte haben?"
msgstr "Va? Vill du ha kortet för det?"

#: ../../ms2/ms2_r2.c:37
msgid "Sie sind wohl nicht ganz über|die aktuellen Preise informiert!"
msgstr "Du är förmodligen inte fullt informerad om de aktuella priserna!"

#: ../../ms2/ms2_r2.c:47
msgid "Ich bin's, Horst Hummel!"
msgstr "Det är jag, Horst Hummel!"

#: ../../ms2/ms2_r2.c:48
msgid "Schönes Wetter heute!"
msgstr "Vackert väder idag!"

#: ../../ms2/ms2_r2.c:49
msgid "Können Sie mir sagen, von wem ich eine Eintrittskarte"
msgstr "Kan du säga vem jag kan få en biljett"

#: ../../ms2/ms2_r2.c:50
msgid "für den Musikwettbewerb kriegen kann?"
msgstr "till musiktävlingen av?"

#: ../../ms2/ms2_r2.c:55
msgid "Ok, hier haben Sie den Xa."
msgstr "Okej, här är ett Xa."

#: ../../ms2/ms2_r2.c:60
msgid "Ich biete Ihnen 500 Xa."
msgstr "Jag erbjuder dig 500 Xa."

#: ../../ms2/ms2_r2.c:61
msgid "Ich biete Ihnen 1000 Xa."
msgstr "Jag erbjuder dig 1000 Xa."

#: ../../ms2/ms2_r2.c:62
msgid "Ich biete Ihnen 5000 Xa."
msgstr "Jag erbjuder dig 5000 Xa."

#: ../../ms2/ms2_r2.c:63
msgid "Ich biete Ihnen 10000 Xa."
msgstr "Jag erbjuder dig 10000 Xa."

#: ../../ms2/ms2_r2.c:72
msgid "Vielen Dank für Ihren Kauf!"
msgstr "Tack för ditt köp!"

#: ../../ms2/ms2_r2.c:77
msgid "Was bieten Sie mir|denn nun für die Karte?"
msgstr "Vad erbjuder du mig|för biljetten?"

#: ../../ms2/ms2_r2.c:81
msgid "Hallo, Sie!"
msgstr "Hallå där!"

#: ../../ms2/ms2_r2.c:83 ../../ms2/ms2_r2.c:719
msgid "Was wollen Sie?"
msgstr "Vad är det du vill?"
