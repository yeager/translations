#: ../../msn/msn_r3.c:1060
msgid "Guten Tag, hier ist Horst Hummel."
msgstr "Hej, det här är Horst Hummel."

#: ../../msn/msn_r3.c:1062
msgid "Es ist sehr wichtig."
msgstr "Det är mycket viktigt."

#: ../../msn/msn_r3.c:1068
msgid "Vom Mars."
msgstr "Från Mars."

#: ../../msn/msn_r3.c:1069
msgid "Vom Klo."
msgstr "Från toaletten."

#: ../../msn/msn_r3.c:1070
msgid "Das werde ich kaum erzählen."
msgstr "Det tänker jag knappast säga."

#: ../../msn/msn_r3.c:1079
msgid "1 Büromanager"
msgstr "1 kontorschef"

#: ../../msn/msn_r3.c:1080
msgid "2 Telomat"
msgstr "2 Telomat"

#: ../../msn/msn_r3.c:1081
