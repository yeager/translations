msgstr "3 ProText"

#: ../../msn/msn_r3.c:1082
msgid "4 Calculata"
msgstr "4 Calculata"

#: ../../msn/msn_r3.c:1083
msgid "Bitte wählen"
msgstr "Välj ett alternativ"

#: ../../msn/msn_r3.c:1091
msgid "Geben Sie den gewünschten Namen ein:"
msgstr "Ange önskat namn:"

#: ../../msn/msn_r3.c:1092
msgid "(Vor- und Nachname)"
msgstr "(för- och efternamn)"

#: ../../msn/msn_r3.c:1106
