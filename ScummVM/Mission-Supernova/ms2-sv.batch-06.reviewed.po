#: ../../ms2/ms2_r1.c:683
msgid "Häßlich, nicht wahr?"
msgstr "Visst är det fult?"

#: ../../ms2/ms2_r1.c:683
msgid "Aber verkaufen tut sich das Zeug gut."
msgstr "Men grejerna säljer bra."

#: ../../ms2/ms2_r1.c:699
#, c-format
msgid "Das kostet %d Xa."
msgstr "Det kostar %d Xa."

#: ../../ms2/ms2_r1.c:726
msgid "Schauen Sie sich ruhig um!"
msgstr "Titta gärna runt!"

#: ../../ms2/ms2_r1.c:728
msgid "Unsinn!"
msgstr "Nonsens!"

#: ../../ms2/ms2_r1.c:730
msgid "Tut mir leid, die sind|schon alle ausverkauft."
msgstr "Tyvärr, de är redan slutsålda."

#: ../../ms2/ms2_r1.c:743
msgid "Guten Abend."
msgstr "God kväll."

#: ../../ms2/ms2_r1.c:744
msgid "Hallo."
msgstr "Hallå."

#: ../../ms2/ms2_r1.c:754
msgid "Huch, Sie haben mich aber erschreckt!"
msgstr "Oj, du skrämde mig!"

#: ../../ms2/ms2_r1.c:755
msgid "Wieso?"
msgstr "Varför då?"

#: ../../ms2/ms2_r1.c:756
msgid "Ihre Verkleidung ist wirklich täuschend echt."
msgstr "Din förklädnad är verkligen|bedrägligt lik en riktig."

#: ../../ms2/ms2_r1.c:757
msgid "Welche Verkleidung?"
msgstr "Vilken förklädnad?"

#: ../../ms2/ms2_r1.c:758
msgid "Na, tun Sie nicht so!"
msgstr "Låtsas inte!"

#: ../../ms2/ms2_r1.c:759
msgid ""
"Sie haben sich verkleidet wie der Außerirdische,|dieser Horst Hummel, oder "
"wie er heißt."
msgstr ""
"Du har klätt ut dig till|den där utomjordingen, Horst Hummel,|eller vad han "
"nu heter."

#: ../../ms2/ms2_r1.c:760 ../../ms2/ms2_r2.c:419
msgid "Ich BIN Horst Hummel!"
msgstr "JAG ÄR Horst Hummel!"

#: ../../ms2/ms2_r1.c:761
msgid "Geben Sie's auf!"
msgstr "Glöm det!"

#: ../../ms2/ms2_r1.c:762
msgid "An Ihrer Gestik merkt man, daß Sie|ein verkleideter Axacussaner sind."
msgstr "Man kan se på dina gester att du är en Axacussan i förklädnad."

#: ../../ms2/ms2_r1.c:763
msgid "Der echte Hummel bewegt sich|anders, irgendwie ruckartig."
msgstr "Den riktige Hummel rör sig|annorlunda, lite ryckigt."

#: ../../ms2/ms2_r1.c:764
msgid "Weil er ein Roboter ist! ICH bin der Echte!"
msgstr "För att han är en robot!|JAG är den riktige!"

#: ../../ms2/ms2_r1.c:765 ../../ms2/ms2_r2.c:56
msgid "Ach, Sie spinnen ja!"
msgstr "Åh, du är galen!"

#: ../../ms2/ms2_r1.c:766
msgid "Sie Trottel!!!"
msgstr "Din idiot!!!"

#: ../../ms2/ms2_r1.c:767
msgid "Seien Sie still, oder ich werfe Sie raus!"
msgstr "Håll käften, annars kastar jag ut dig!"

#: ../../ms2/ms2_r1.c:780
msgid "Taschenmesser"
msgstr "Fickkniv"

#: ../../ms2/ms2_r1.c:780
msgid "Hey, da ist sogar eine Säge dran."
msgstr "Det finns till och med en såg på den."

#: ../../ms2/ms2_r1.c:781
msgid "20 Xa"
msgstr "20 Xa"

#: ../../ms2/ms2_r1.c:782
msgid "Discman"
msgstr "Discman"

#: ../../ms2/ms2_r1.c:782
msgid "Da ist noch die \"Mad Monkeys\"-CD drin."
msgstr "CD:n \"Mad Monkeys\" är kvar där inne."

#: ../../ms2/ms2_r1.c:783
msgid "Mit dem Ding sollst du dich|an der Wand festhalten."
msgstr "Med den där saken ska du|hålla dig fast vid väggen."

#: ../../ms2/ms2_r1.c:785
msgid "Spezialkeycard"
msgstr "Specialnyckelkort"

#: ../../ms2/ms2_r1.c:785
msgid "Damit sollst du die|Türen knacken können."
msgstr "Du borde kunna knäcka dörrarna med den."

#: ../../ms2/ms2_r1.c:786
msgid "Alarmknacker"
msgstr "Larmknäckare"

#: ../../ms2/ms2_r1.c:786
msgid "Ein kleines Gerät, um|die Alarmanlage auszuschalten."
msgstr "En liten enhet för att stänga av larmsystemet."

#: ../../ms2/ms2_r1.c:788
msgid "Karte"
msgstr "Nyckelkort"

#: ../../ms2/ms2_r1.c:795
msgid "Raumschiff"
msgstr "Rymdskepp"

#: ../../ms2/ms2_r1.c:795
msgid "Damit bist du hierhergekommen."
msgstr "Det var så du hamnade här."

#: ../../ms2/ms2_r1.c:796
msgid "Fahrzeuge"
msgstr "Fordon"

#: ../../ms2/ms2_r1.c:796
msgid "Du kannst von hier aus nicht erkennen,|was das für Fahrzeuge sind."
msgstr "Det går inte att se härifrån vad det är för typ av fordon."

#: ../../ms2/ms2_r1.c:803 ../../ms2/ms2_r1.c:804
msgid "Fahrzeug"
msgstr "Fordon"

#: ../../ms2/ms2_r1.c:803 ../../ms2/ms2_r1.c:804
msgid "Es scheint ein Taxi zu sein."
msgstr "Det ser ut att vara en taxi."

#: ../../ms2/ms2_r1.c:805
msgid "Komisch, er ist verschlossen."
msgstr "Lustigt, den är låst."

#: ../../ms2/ms2_r1.c:806
msgid "Portemonnaie"
msgstr "Plånbok"

#: ../../ms2/ms2_r1.c:806
msgid "Das muß ein Axacussaner|hier verloren haben."
msgstr "En axacussan|måste ha tappat den här."

#: ../../ms2/ms2_r1.c:807
msgid "Gerät"
msgstr "Enhet"

#: ../../ms2/ms2_r1.c:807
msgid "Auf dem Gerät steht: \"Taxi-Call\".|Es ist ein kleiner Knopf daran."
msgstr "På apparaten står det: ”Taxi-Call”.|Den har en liten knapp."

#: ../../ms2/ms2_r1.c:808
msgid "Ausweis"
msgstr "ID-kort"

#: ../../ms2/ms2_r1.c:808
msgid "Auf dem Ausweis steht:|  Berta Tschell|  Axacuss City|  115AY2,96A,32"
msgstr "På id-kortet står det:|  Berta Tschell|  Axacuss City|  115AY2,96A,32"

#: ../../ms2/ms2_r1.c:817
msgid "Treppe"
msgstr "Trappa"

#: ../../ms2/ms2_r1.c:817
msgid "Sie führt zu den Geschäften."
msgstr "Den leder till butikerna."

#: ../../ms2/ms2_r1.c:818
msgid "Geschäftsstraße im Hintergrund"
msgstr "Shoppinggata i bakgrunden"

#: ../../ms2/ms2_r1.c:818
msgid "Die Straße scheint kein Ende zu haben."
msgstr "Vägen verkar inte ha något slut."
