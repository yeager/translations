#: ../../ms2/ms2_pyra.c:1143 ../../ms2/ms2_pyra.c:1151
#: ../../ms2/ms2_pyra.c:1159 ../../ms2/ms2_pyra.c:1167
msgid "Schrift"
msgstr "Inskription"

#: ../../ms2/ms2_pyra.c:1175 ../../ms2/ms2_pyra.c:1184
msgid "Tomate"
msgstr "Tomat"

#: ../../ms2/ms2_pyra.c:1175 ../../ms2/ms2_pyra.c:1184
msgid "Komisch!"
msgstr "Konstigt!"

#: ../../ms2/ms2_pyra.c:1183 ../../ms2/ms2_pyra.c:1272
msgid "Messer"
msgstr "Kniv"

#: ../../ms2/ms2_pyra.c:1183
msgid "Es ist ein relativ stabiles Messer."
msgstr "Det är en relativt robust kniv."

#: ../../ms2/ms2_pyra.c:1192 ../../ms2/ms2_pyra.c:1203
#: ../../ms2/ms2_pyra.c:1214
msgid "Monster"
msgstr "Monster"

#: ../../ms2/ms2_pyra.c:1192
msgid "Sieht gefährlich aus!"
msgstr "Det ser farligt ut!"

#: ../../ms2/ms2_pyra.c:1200
msgid "Es ist dick und|ungefähr 15 Meter lang."
msgstr "Den är tjock och|ungefär 15 meter lång."

#: ../../ms2/ms2_pyra.c:1201 ../../ms2/ms2_pyra.c:1212
msgid "Augen"
msgstr "Ögon"

#: ../../ms2/ms2_pyra.c:1202 ../../ms2/ms2_pyra.c:1213
#: ../../ms2/ms2_pyra.c:1336
msgid "Mund"
msgstr "Mun"

#: ../../ms2/ms2_pyra.c:1203 ../../ms2/ms2_pyra.c:1214
msgid "Es ist nur eine Statue."
msgstr "Det är bara en staty."

#: ../../ms2/ms2_pyra.c:1211 ../../ms2/ms2_pyra.c:1263
msgid "Zettel"
msgstr "Papperslapp"

#: ../../ms2/ms2_pyra.c:1211
msgid "Darauf steht:|\"Wenn du fast am Ziel|bist, tu folgendes:|Sauf!\""
msgstr "Det står:|”När du nästan är framme,|gör följande: Drick!”"

#: ../../ms2/ms2_pyra.c:1255
msgid "Es ist ca. 10 Meter tief."
msgstr "Den är cirka 10 meter djup."

#: ../../ms2/ms2_pyra.c:1256
msgid "Oben siehst du helles Licht."
msgstr "Ovanför dig ser du starkt ljus."

#: ../../ms2/ms2_pyra.c:1263
msgid ""
"Darauf steht:|\"Ruhe eine Minute im Raum|zwischen den Monstern,|und du wirst"
" belohnt!\""
msgstr ""
"Det står:|”Vila en minut i rummet|mellan monstren, så|blir du belönad!”"

#: ../../ms2/ms2_pyra.c:1264 ../../ms2/ms2_r1.c:844 ../../ms2/ms2_r1.c:845
#: ../../ms2/ms2_r2.c:1243
msgid "Schlitz"
msgstr "Springa"

#: ../../ms2/ms2_pyra.c:1264
msgid "Du kommst mit den|Händen nicht rein."
msgstr "Du kommer inte in|med händerna."

#: ../../ms2/ms2_pyra.c:1274
msgid "Es ist ca. 5 Meter tief."
msgstr "Den är cirka 5 meter djup."

#: ../../ms2/ms2_pyra.c:1275
msgid "Steine"
msgstr "Stenar"

#: ../../ms2/ms2_pyra.c:1285
msgid "Platte"
msgstr "Platta"

#: ../../ms2/ms2_pyra.c:1315 ../../ms2/ms2_pyra.c:1323
msgid "Sarg"
msgstr "Kista"

#: ../../ms2/ms2_pyra.c:1316 ../../ms2/ms2_pyra.c:1322
#: ../../ms2/ms2_pyra.c:1333 ../../ms2/ms2_r1.c:833 ../../ms2/ms2_r1.c:840
#: ../../ms2/ms2_r1.c:857 ../../ms2/ms2_r2.c:1215 ../../ms2/ms2_r2.c:1248
msgid "Ausgang"
msgstr "Utgång"

#: ../../ms2/ms2_pyra.c:1323
msgid "Unheimlich!"
msgstr "Läskigt!"

#: ../../ms2/ms2_pyra.c:1324 ../../ms2/ms2_r1.c:865
msgid "Zahnbürste"
msgstr "Tandborste"

#: ../../ms2/ms2_pyra.c:1324 ../../ms2/ms2_pyra.c:1325
msgid "Die Sache mit der|Artus GmbH scheint dir zu|Kopf gestiegen zu sein."
msgstr "Det där med Artus GmbH verkar|ha stigit dig åt huvudet."

#: ../../ms2/ms2_pyra.c:1325
msgid "Zahnpastatube"
msgstr "Tandkrämstub"

#: ../../ms2/ms2_pyra.c:1326 ../../ms2/ms2_pyra.c:1327
msgid "Kugel"
msgstr "Boll"

#: ../../ms2/ms2_pyra.c:1326 ../../ms2/ms2_pyra.c:1327
msgid "Hmm, die Kugel sieht lose aus."
msgstr "Bollen ser lös ut."

#: ../../ms2/ms2_pyra.c:1334 ../../ms2/ms2_pyra.c:1335
msgid "Auge"
msgstr "Öga"

#: ../../ms2/ms2_pyra.c:1334 ../../ms2/ms2_pyra.c:1335
msgid "Irgendwas stimmt damit nicht."
msgstr "Det är något fel på den."

#: ../../ms2/ms2_r1.c:11
msgid "Es ist nichts Besonderes daran."
msgstr "Det är inget speciellt med det."

#: ../../ms2/ms2_r1.c:12
msgid "Sieht nach Metall aus."
msgstr "Ser ut som metall."

#: ../../ms2/ms2_r1.c:83
msgid "Ein Taxi kommt angerauscht,|du steigst ein."
msgstr "En taxi kommer dundrande,|och du kliver in."

#: ../../ms2/ms2_r1.c:90
msgid "Du drückst auf den Knopf, aber nichts passiert"
msgstr "Du trycker på knappen, men ingenting händer"

#: ../../ms2/ms2_r1.c:94
msgid "Es ist leer."
msgstr "Den är tom."

#: ../../ms2/ms2_r1.c:97
msgid "Du findest ein kleines Gerät,|einen Ausweis und einen Xa."
msgstr "Du hittar en liten apparat,|ett id-kort och ett Xa."

#: ../../ms2/ms2_r1.c:109
msgid "Du heftest den|Magnet an die Stange."
msgstr "Du fäster|magneten på stången."

#: ../../ms2/ms2_r1.c:110
msgid "Stange mit Magnet"
msgstr "Stång med magnet"

#: ../../ms2/ms2_r1.c:111
msgid "Raffiniert!"
msgstr "Raffinerat!"

#: ../../ms2/ms2_r1.c:118
msgid "Du mußt das|Gerät erst kaufen."
msgstr "Du måste köpa|enheten först."

#: ../../ms2/ms2_r1.c:127
msgid "Du legst den Chip|in das Gerät ein."
msgstr "Du sätter in chippet|i enheten."

#: ../../ms2/ms2_r1.c:137
msgid "Du überspielst die CD|auf den Musikchip."
msgstr "Du överför cd-skivan|till musikchippet."

#: ../../ms2/ms2_r1.c:141
msgid ""
"Ohne einen eingelegten|Musikchip kannst du auf dem|Gerät nichts aufnehmen."
msgstr "Utan ett isatt|musikchipp kan du inte|spela in något på enheten."

#: ../../ms2/ms2_r1.c:152
msgid "Du nimmst den Chip|aus dem Gerät."
msgstr "Du tar ut chippet|ur enheten."

#: ../../ms2/ms2_r1.c:157
msgid "Es ist kein Chip eingelegt."
msgstr "Inget chipp är isatt."

#: ../../ms2/ms2_r1.c:162
msgid "Wozu? Du hast sowieso nur die eine CD."
msgstr "Vad är det för mening med det? Du har ju ändå bara en CD."

#: ../../ms2/ms2_r1.c:166
msgid "Die \"Mad Monkeys\"-CD. Du hast|sie schon tausendmal gehört."
msgstr "CD:n \"Mad Monkeys\". Du har hört den tusen gånger."

#: ../../ms2/ms2_r1.c:183
msgid "Du hörst nichts.|Der Chip ist unbespielt."
msgstr "Du hör ingenting.|Chippet är tomt."

#: ../../ms2/ms2_r1.c:185
msgid "Du hörst dir den Anfang|der überspielten CD an."
msgstr "Du lyssnar på början|av den kopierade cd-skivan."
