#: engines/sci/detection_options.h:58
#, ignore-ellipsis, ignore-same
msgid "Keep all pixels the same size (portraits appear larger)"
msgstr "Behåll alla bildpunkter i samma storlek (porträtt visas större)"

#: engines/sci/detection_options.h:59
#, ignore-ellipsis, ignore-same
msgid ""
"Show low-resolution graphics and text at exactly double size, instead of "
"stretching them unevenly. High-resolution portraits cover slightly more of "
"the scene, and scenes look slightly shorter than in the original release"
msgstr ""
"Visa lågupplöst grafik och text i exakt dubbel storlek i stället för att "
"sträcka dem ojämnt. Högupplösta porträtt täcker något mer av scenen och "
"scener ser något kortare ut än i den ursprungliga utgåvan."

#: engines/scumm/metaengine.cpp:469
#, ignore-ellipsis, ignore-same
msgid "Rebel Assault II PlayStation support is not compiled in"
msgstr "Stöd för Rebel Assault II på PlayStation är inte kompilerat"

#: engines/scumm/metaengine.cpp:746
#, ignore-ellipsis, ignore-same
msgid "Use PAL timing for SID audio"
msgstr "Använd PAL-timing för SID-ljud"

#: engines/scumm/metaengine.cpp:747
#, ignore-ellipsis, ignore-same
msgid ""
"This lowers the pitch and slows down playback compared to the original NTSC "
"timing."
msgstr ""
"Detta sänker tonhöjden och saktar ned uppspelningen jämfört med ursprunglig "
"NTSC-timing."

#: engines/scumm/metaengine.cpp:955
#, ignore-ellipsis, ignore-same
msgid ""
"Play additional sections included in the demo's game data but omitted from "
"its original sequence"
msgstr ""
"Spela ytterligare avsnitt som finns i demots speldata men utelämnades ur "
"dess ursprungliga sekvens"

#: engines/scumm/metaengine.cpp:982
#, ignore-ellipsis, ignore-same
msgid ""
"Play extra chapters included in the demo's game data but omitted from its "
"original sequence"
msgstr ""
"Spela extra kapitel som finns i demots speldata men utelämnades ur dess "
"ursprungliga sekvens"

#: engines/scumm/metaengine.cpp:991
#, ignore-ellipsis, ignore-same
msgid ""
"Enable the full game's view jolt and recovery rules, including the demo's "
"unused crash and repair animations"
msgstr ""
"Aktivera hela spelets regler för vyryck och återhämtning, inklusive demots "
"oanvända krasch- och reparationsanimationer"

#: engines/scumm/metaengine.cpp:1000
#, ignore-ellipsis, ignore-same
msgid ""
"Enable the original game's cheat shortcuts for rescuing animals, changing "
"shellshock and skipping flights"
msgstr ""
"Aktivera det ursprungliga spelets fuskgenvägar för att rädda djur, ändra "
"granatchock och hoppa över flygningar"

#: engines/scumm/metaengine.cpp:1008
#, ignore-ellipsis, ignore-same
msgid "Programmer's Easter egg"
msgstr "Programmerarens påskägg"

#: engines/scumm/metaengine.cpp:1009
#, ignore-ellipsis, ignore-same
msgid ""
"Replace the rhinoceros interview text with the hidden programmer dialogue"
msgstr "Ersätt noshörningsintervjutexten med den dolda programmerardialogen"

#: engines/scumm/metaengine.cpp:1412
#, ignore-ellipsis, ignore-same
msgid "Change view"
msgstr "Ändra vy"

#: engines/scumm/saveload.cpp:201
#, ignore-ellipsis, ignore-same
msgid ""
"This game does not support saving from the menu. Progress is saved "
"automatically when a level is completed"
msgstr ""
"Det här spelet stöder inte sparning från menyn. Framstegen sparas "
"automatiskt när en nivå är klar"

