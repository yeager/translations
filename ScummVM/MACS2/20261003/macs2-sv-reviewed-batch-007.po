msgctxt "scene:9:225"
msgid ""
"Die Fracht ist gut\n"
"vertäut. Da lass ich\n"
"besser die Finger\n"
"davon."
msgstr ""
"Lasten är väl surrad.\n"
"Det är nog bäst\n"
"att jag inte rör\n"
"den."

msgctxt "scene:9:229"
msgid ""
"Ich bezweifle, dass\n"
"dies eine positive\n"
"Wirkung hätte."
msgstr ""
"Jag betvivlar att\n"
"det skulle ha\n"
"någon positiv effekt."

msgctxt "scene:9:232"
msgid ""
"Der Captain wird mich\n"
"Kielholen lassen, wenn\n"
"ich das Fenster mit\n"
"dem Fass einschmeisse."
msgstr ""
"Kaptenen kommer att\n"
"låta kölhala mig\n"
"om jag slår\n"
"sönder fönstret med tunnan."

msgctxt "scene:9:236"
msgid ""
"Das wäre wohl möglich,\n"
"doch ich möchte fremdes\n"
"Eigentum nicht be-\n"
"schädigen."
msgstr ""
"Det skulle visserligen vara\n"
"möjligt, men jag vill\n"
"inte skada någon\n"
"annans egendom."

msgctxt "scene:9:240"
msgid ""
"Wenn ich das tue, bricht\n"
"die Klinge, oder das Fens-\n"
"ter wird beschädigt."
msgstr ""
"Om jag gör det\n"
"går klingan sönder, eller\n"
"så skadas fönstret."

msgctxt "scene:9:243"
msgid ""
"Soll ich einschnitzen:\n"
"FIREHAND WAR HIER?"
msgstr ""
"Ska jag rista in:\n"
"FIREHAND VAR HÄR?"

msgctxt "scene:10:0"
msgid ""
"Kommen Sie nur her,\n"
"Mr. Firehand. Stellen\n"
"Sie sich zu uns!"
msgstr ""
"Kom hit bara,\n"
"mr Firehand. Ställ\n"
"er hos oss!"

msgctxt "scene:10:3"
msgid ""
"Mr. Droll sagte mir,\n"
"Sie wollen hinauf in\n"
"die Berge. Die Silber-\n"
"minen dort oben wollen\n"
"Sie untersuchen,\n"
"Mr. Firehand?"
msgstr ""
"Mr Droll sade\n"
"att ni vill\n"
"upp i bergen.\n"
"Vill ni undersöka\n"
"silvergruvorna där\n"
"uppe, mr Firehand?"

msgctxt "scene:10:9"
msgid ""
"1. Ja, ich will ab-\n"
"   schätzen, ob sich\n"
"   die Arbeit in den\n"
"   Minen noch lohnt."
msgstr ""
"1. Ja, jag\n"
"vill uppskatta om\n"
"arbetet i gruvorna\n"
"fortfarande lönar sig."

msgctxt "scene:10:13"
msgid ""
"2. Ja, aber bis dort-\n"
"   hin ist es noch ein\n"
"   langer Weg."
msgstr ""
"2. Ja, men det\n"
"är fortfarande en lång\n"
"väg dit."

msgctxt "scene:10:16"
msgid ""
"Meinen Sie denn,\n"
"den Ertrag einer\n"
"alten Mine richtig\n"
"abschätzen zu können?"
msgstr ""
"Är ni säker\n"
"på att ni\n"
"kan bedöma avkastningen från\n"
"en gammal gruva korrekt?"

msgctxt "scene:10:20"
msgid ""
"1. Sonst würde ich\n"
"   bestimmt nicht die\n"
"   lange Reise machen."
msgstr ""
"1. Annars skulle\n"
"jag knappast göra\n"
"den långa resan."

msgctxt "scene:10:23"
msgid ""
"2. Ich habe schon viel\n"
"   über Minen gelesen\n"
"   und glaube, den Wert\n"
"   der Silberminen\n"
"   richtig abschätzen\n"
"   zu können."
msgstr ""
"2. Jag har\n"
"läst mycket om\n"
"gruvor och tror\n"
"att jag\n"
"kan bedöma silvergruvornas\n"
"värde korrekt."

msgctxt "scene:10:29"
msgid ""
"Ja, da haben Sie\n"
"natürlich recht.\n"
"Entschuldigen Sie\n"
"meine plumpe Frage."
msgstr ""
"Ja, ni\n"
"har naturligtvis\n"
"rätt. Ursäkta\n"
"min klumpiga fråga."

msgctxt "scene:10:33"
msgid ""
"Nun, da trauen Sie sich\n"
"aber viel zu.\n"
"Sollten Sie einmal Hilfe\n"
"brauchen, stehe ich\n"
"Ihnen gerne zur\n"
"Verfügung. Als Ingenieur\n"
"kenne ich mich mit alten\n"
"Minen gut aus."
msgstr ""
"Tja, ni har stort\n"
"självförtroende. Om\n"
"ni någon gång behöver\n"
"hjälp står jag\n"
"gärna till\n"
"tjänst. Som ingenjör känner\n"
"jag väl till gamla\n"
"gruvor."

msgctxt "scene:10:41"
msgid ""
"Und welchen Weg\n"
"werden Sie einschlagen,\n"
"wenn der Dampfer sein\n"
"Ziel erreicht hat,\n"
"Mr. Firehand?"
msgstr ""
"Och vilken\n"
"väg tänker ni ta\n"
"när ångaren har\n"
"nått sitt mål,\n"
"mr Firehand?"

msgctxt "scene:10:46"
msgid ""
"1. Der Weg über Land\n"
"   ist noch weit. Ich\n"
"   werde einige\n"
"   Stationen machen."
msgstr ""
"1. Vägen över\n"
"land är fortfarande\n"
"lång. Jag\n"
"ska göra några uppehåll."

msgctxt "scene:10:50"
msgid ""
"2. Ich habe mir noch\n"
"   keine Gedanken über\n"
"   den Weg gemacht."
msgstr ""
"2. Jag har\n"
"inte funderat på\n"
"vägen än."

msgctxt "scene:10:53"
msgid ""
"Und welche Stationen\n"
"sollen das sein?"
msgstr ""
"Och vilka uppehåll\n"
"blir det?"

msgctxt "scene:10:55"
msgid ""
"1. Butlers Farm liegt\n"
"   auf dem Weg."
msgstr ""
"1. Butlers gård ligger\n"
"längs vägen."

msgctxt "scene:10:57"
msgid ""
"2. Von Sheridan aus,\n"
"   geht es in die\n"
"   Berge."
msgstr ""
"2. Från Sheridan\n"
"går vägen upp\n"
"i bergen."

msgctxt "scene:10:60"
msgid ""
"Butlers Farm?! So\n"
"ein Zufall aber auch!\n"
"Dann wollen Sie ja\n"
"zu meinem Schwager,\n"
"und obendrein ist das\n"
"auch mein Ziel."
msgstr ""
"Butlers gård?! Vilken\n"
"tillfällighet! Då ska\n"
"ni alltså till\n"
"min svåger och\n"
"dessutom är det\n"
"också mitt mål."

msgctxt "scene:10:66"
msgid ""
"Ich schlage vor,\n"
"dass wir uns auf\n"
"der Farm treffen.\n"
"Sie werden dort\n"
"jederzeit willkommen\n"
"sein."
msgstr ""
"Jag föreslår\n"
"att vi\n"
"träffas på\n"
"gården. Ni\n"
"är alltid välkomna\n"
"där."

msgctxt "scene:10:72"
msgid ""
"Sheridan. Hab schon\n"
"davon gehört. Dort\n"
"arbeitet der Ingenieur\n"
"Charoy. Er kümmert\n"
"sich um den Bau der\n"
"Eisenbahn. Sie werden\n"
"ihn bestimmt treffen."
msgstr ""
"Sheridan. Jag har\n"
"hört talas om\n"
"det. Ingenjören Charoy\n"
"arbetar där. Han\n"
"ansvarar för järnvägsbygget.\n"
"Ni kommer säkert\n"
"att träffa honom."

msgctxt "scene:10:79"
msgid ""
"So was könnte ich mir\n"
"nicht leisten. Wenn\n"
"ich keine Landkarte\n"
"vor mir habe, komme\n"
"ich sowieso nie ans\n"
"Ziel, haha."
msgstr ""
"Det skulle jag inte\n"
"ha råd med. Om\n"
"jag inte har en\n"
"karta framför mig kommer\n"
"jag ändå aldrig fram,\n"
"haha."

msgctxt "scene:10:85"
msgid ""
"Aber so ein richtiger\n"
"Westmann wie Sie, wird\n"
"damit sicherlich kein\n"
"Problem haben."
msgstr ""
"Men en riktig\n"
"västerman som ni\n"
"har säkert inga\n"
"problem med det."

msgctxt "scene:10:89"
msgid ""
"He, das ist der Pri-\n"
"vatbereich des Cap-\n"
"tains!"
msgstr ""
"Hördu, det är\n"
"kaptenens privata\n"
"område!"

msgctxt "scene:10:92"
msgid ""
"Es kommt mir schon\n"
"etwas eigenartig vor,\n"
"dass die Fenster ge-\n"
"rade jetzt geputzt\n"
"werden, die sehen\n"
"doch sauber aus."
msgstr ""
"Jag tycker det\n"
"är lite märkligt\n"
"att fönstren putsas\n"
"just nu. De\n"
"ser ju\n"
"rena ut."

msgctxt "scene:10:98"
msgid "Was haben Sie vor..."
msgstr "Vad tänker du göra …"

msgctxt "scene:10:99"
msgid ""
"Ich werde wohl noch\n"
"meinen wohlverdienten\n"
"Whisky trinken, und\n"
"mich dann etwas nie-\n"
"derlegen."
msgstr ""
"Jag tänker nog\n"
"dricka min välförtjänta\n"
"whisky och sedan\n"
"lägga mig en\n"
"stund."

msgctxt "scene:10:104"
msgid ""
"Eigenartige Sitten ha-\n"
"ben die schon an Bord,\n"
"einfach die Fenster zu\n"
"reinigen, wenn sich\n"
"Gäste in der Bar befin-\n"
"den..."
msgstr ""
"De har märkliga\n"
"vanor ombord, att\n"
"bara putsa fönstren\n"
"när det finns\n"
"gäster i baren\n"
"…"

msgctxt "scene:10:110"
msgid ""
"Droll und ich unter-\n"
"halten uns noch ein\n"
"wenig, und dann werde\n"
"ich mich wohl etwas\n"
"in meiner Kajüte hin-\n"
"legen, um auszuruhen."
msgstr ""
"Droll och jag\n"
"ska prata lite\n"
"till. Sedan lägger\n"
"jag mig nog\n"
"i min hytt\n"
"en stund för att vila."

msgctxt "scene:10:116"
msgid ""
"Es wäre etwas sehr unhöflich\n"
"die Runde wortlos zu verlassen.\n"
"Die Leute haben mich ja einge-\n"
"laden, und ich kann sie nicht\n"
"vor den Kopf stossen."
msgstr ""
"Det vore mycket ohövligt\n"
"att lämna sällskapet utan ett\n"
"ord. De bjöd ju in\n"
"mig och jag kan\n"
"inte förolämpa dem."

msgctxt "scene:10:121"
msgid ""
"Ich glaube nicht, dass\n"
"Droll für eine solche\n"
"Handlung Verständnis\n"
"zeigen würde."
msgstr ""
"Jag tror inte\n"
"att Droll skulle\n"
"ha förståelse för\n"
"en sådan handling."

msgctxt "scene:10:125"
msgid ""
"Ich kann mich des Ein-\n"
"druckes nicht erwehren,\n"
"dass Du den Sinn dieses\n"
"Spieles nicht richtig\n"
"erfasst hast."
msgstr ""
"Jag kan inte\n"
"undgå intrycket att du\n"
"inte riktigt har förstått\n"
"meningen med det\n"
"här spelet."

msgctxt "scene:10:130"
msgid ""
"Warum sollte ich den\n"
"Mann schlagen, er hat\n"
"mir ja nichts getan?"
msgstr ""
"Varför skulle jag slå\n"
"mannen? Han har ju\n"
"inte gjort mig något?"

msgctxt "scene:10:133"
msgid ""
"Ich kann Deine Gedanken-\n"
"gänge nicht so recht nach-\n"
"vollziehen. Warum sollte\n"
"ich ihn verletzen oder gar\n"
"töten?"
msgstr ""
"Jag kan inte riktigt\n"
"följa dina tankegångar. Varför\n"
"skulle jag skada eller\n"
"till och med döda\n"
"honom?"

msgctxt "scene:10:138"
msgid ""
"He, was glaubst Du\n"
"hier zu tun? Schau,\n"
"dass Du sofort aus\n"
"der Bar verschwindest!"
msgstr ""
"Hördu, vad tror du\n"
"att du gör här?\n"
"Se till att genast\n"
"försvinna från baren!"

msgctxt "scene:10:142"
msgid ""
"Jawohl Chef, ich bin\n"
"schon weg Chef..."
msgstr ""
"Ja chef, jag är redan\n"
"på väg, chef …"

msgctxt "scene:10:144"
msgid ""
"Na, das ist ja eine\n"
"schöne Sauerei, das\n"
"ganze Fenster ist\n"
"verschmiert, so ein\n"
"Tölpel!"
msgstr ""
"Nå, vilken\n"
"röra. Hela\n"
"fönstret är\n"
"kladdigt, vilken\n"
"klåpare!"

msgctxt "scene:10:149"
msgid ""
"Und ich muss es\n"
"wieder in Ordnung\n"
"bringen."
msgstr ""
"Och jag måste\n"
"få ordning på\n"
"det igen."

msgctxt "scene:10:152"
msgid ""
"He,Firehand! Kommen Sie\n"
"mal eben her!"
msgstr ""
"Hördu, Firehand! Kom hit\n"
"ett ögonblick!"

msgctxt "scene:10:154"
msgid ""
"Oh, wie's aussieht\n"
"wollte der Kerl uns\n"
"wohl belauschen. Na,\n"
"das ist ihm jetzt ja\n"
"vergangen. Ich möchte\n"
"zu gerne wissen, für\n"
"wen er spionieren\n"
"wollte."
msgstr ""
"Åh, som det ser\n"
"ut ville karlen nog\n"
"avlyssna oss. Nå, nu\n"
"har han fått vad\n"
"han tål. Jag skulle\n"
"gärna vilja veta åt\n"
"vem han ville\n"
"spionera."

msgctxt "scene:10:162"
msgid ""
"Das ist eigentlich\n"
"nicht sehr schwer zu\n"
"erraten - der Captain\n"
"hat mir zu Beginn\n"
"der Fahrt von den\n"
"Tramps, die sich auf\n"
"dem Schiff befinden,\n"
"erzählt."
msgstr ""
"Det är\n"
"egentligen inte svårt\n"
"att gissa. Kaptenen\n"
"berättade för\n"
"mig i\n"
"början av resan\n"
"om luffarna på\n"
"fartyget."

msgctxt "scene:10:170"
msgid ""
"Da hat bei unserem\n"
"Fensterputzer wohl\n"
"die Aussicht auf\n"
"schnell verdientes\n"
"Geld den Verstand\n"
"getrübt."
msgstr ""
"Vår fönsterputsare\n"
"har väl\n"
"fått förståndet\n"
"grumlat av\n"
"utsikten till\n"
"lättförtjänta pengar."

msgctxt "scene:10:176"
msgid ""
"So ist das eben, Mr.\n"
"Patterson. Vor den\n"
"Ganoven ist man nir-\n"
"gends sicher. Noch\n"
"nicht einmal bei einem\n"
"Glas Whisky, haha."
msgstr ""
"Så är det,\n"
"mr Patterson. Man\n"
"är inte säker\n"
"för skurkar någonstans.\n"
"Inte ens över ett\n"
"glas whisky, haha."

msgctxt "scene:10:182"
msgid ""
"Da haben sie leider\n"
"recht, Mr. Droll. Ähm\n"
"- Mr. Firehand? Sie\n"
"würden mir einen gros-\n"
"sen Gefallen tun,"
msgstr ""
"Ni har tyvärr\n"
"rätt, mr Droll. Eh\n"
"… mr Firehand?\n"
"Ni skulle göra mig\n"
"en stor tjänst,"

msgctxt "scene:10:187"
msgid ""
"wenn Sie für den Rest\n"
"der Fahrt mein Bowie-\n"
"messer aufbewahren\n"
"könnten."
msgstr ""
"om ni kunde\n"
"förvara min Bowiekniv\n"
"resten av\n"
"resan."

msgctxt "scene:10:191"
msgid ""
"Wieso? Was ist denn\n"
"so Besonderes an dem\n"
"Bowiemesser, dass ich\n"
"darauf aufpassen soll?"
msgstr ""
"Varför? Vad är\n"
"så speciellt med\n"
"Bowiekniven att jag ska\n"
"hålla reda på den?"

msgctxt "scene:10:195"
msgid ""
"Nun, nachdem wir nicht\n"
"mehr belauscht werden,\n"
"kann ich es Ihnen ja\n"
"beruhigt erklären: Im\n"
"Griff des Messers habe\n"
"ich 9.000 Dollar ver-\n"
"steckt."
msgstr ""
"Tja, nu när\n"
"ingen längre avlyssnar\n"
"oss kan jag\n"
"lugnt förklara: Jag\n"
"har gömt 9.000\n"
"dollar i knivens\n"
"skaft."
