msgid "HINTERGRUND GRAFIK"
msgstr "BAKGRUNDSGRAFIK"

msgid "CHRISTIAN MICHEL"
msgstr "CHRISTIAN MICHEL"

msgid "MARKUS          "
msgstr "MARKUS          "

msgid "  MUCKENSCHNABL"
msgstr "  MUCKENSCHNABL"

msgid "ZUSAETZLICHE GRAFIK"
msgstr "YTTERLIGARE GRAFIK"

msgid "PETER KRAINER"
msgstr "PETER KRAINER"

