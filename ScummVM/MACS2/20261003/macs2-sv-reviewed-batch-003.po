msgstr "CHRISTIAN PREISSL"

msgid "EDITIERT"
msgstr "REDIGERING"

msgid "JUDITH NUNN"
msgstr "JUDITH NUNN"

msgid "GERLINDE GRIMMER"
msgstr "GERLINDE GRIMMER"

msgid "TESTING"
msgstr "TESTNING"

msgid "ROLF FEUSI"
msgstr "ROLF FEUSI"

msgid "ELFRIEDE BOSONNET"
msgstr "ELFRIEDE BOSONNET"

msgid "LIZENSIERT"
msgstr "LICENSIERAD"

msgid "KARL MAY VERLAG"
msgstr "KARL MAY VERLAG"

msgid ""
"Freunde! Ihr werdet\n"
"schon gewusst haben,\n"
"warum Ihr den weiten\n"
"Weg hierher auf Euch\n"
"genommen habt. Und\n"
"ich kann Euch sagen:\n"
"Eure Mühen werden\n"
"sich lohnen."
msgstr ""
"Vänner! Ni måste\n"
"redan veta varför\n"
"ni har tagit er\n"
"den långa vägen\n"
"hit. Och jag kan\n"
"lova er följande:\n"
"mödan kommer\n"
"att löna sig."

msgid ""
"Hoffentlich versprichst\n"
"Du uns nicht zuviel,\n"
"Brinkley."
msgstr ""
"Förhoppningsvis lovar\n"
"du oss inte för\n"
"mycket, Brinkley."

msgid ""
"Sicher nicht. Ihr\n"
"könnt mir vertrauen!\n"
"Ich versichere Euch,\n"
"dass oben am Silber-\n"
"see genug Schätze\n"
"für jeden von Euch\n"
"liegen."
msgstr ""
"Absolut inte. Ni kan\n"
"lita på mig! Jag\n"
"försäkrar er att det\n"
"finns tillräckligt\n"
"med skatter uppe\n"
"vid Silversjön åt\n"
"var och en av er."

msgid ""
"Woher willst Du das\n"
"denn wissen, hä? Bei\n"
"den Rafter's wäre es\n"
"beinahe schief ge-\n"
"gangen."
msgstr ""
"Hur kan du\n"
"veta det, va?\n"
"Hos Rafters\n"
"gick det\n"
"nästan snett."

msgid ""
"Diese Karte hier ist\n"
"der Schlüssel zu un-\n"
"serem Erfolg.Auf ihr\n"
"ist der genaue Weg\n"
"zum Schatz beschrie-\n"
"ben, es kann über-\n"
"haupt nichts"
msgstr ""
"Kartan här är\n"
"nyckeln till vår\n"
"framgång. Den\n"
"beskriver den\n"
"exakta vägen till\n"
"skatten. Ingenting\n"
"kan alls"

msgid ""
"schiefgehen. Doch be-\n"
"vor wir uns auf den\n"
"Weg in die Berge ma-\n"
"chen können, sollten\n"
"wir Butler's Farm\n"
"einen Besuch abstat-\n"
"ten."
msgstr ""
"gå snett. Men\n"
"innan vi kan\n"
"ge oss av\n"
"upp i bergen\n"
"bör vi\n"
"besöka Butlers\n"
"farm."

msgid ""
"Und was die Rafter's\n"
"anbelangt, so kann man\n"
"doch wohl sagen, dass\n"
"es ein Erfolg war: Wir\n"
"haben das Geld."
msgstr ""
"Och när det gäller\n"
"Rafters kan man\n"
"väl säga att det\n"
"var en framgång:\n"
"Vi har pengarna."

msgid ""
"Gut, die Rafter's waren\n"
"ein Erfolg, aber warum\n"
"den Butler's einen\n"
"Besuch abstatten?"
msgstr ""
"Bra, Rafters var\n"
"en framgång men\n"
"varför ska vi\n"
"besöka Butlers?"

msgid ""
"Butler ist ein verdammt\n"
"reicher Mann. Es wäre\n"
"bestimmt nicht Euer\n"
"Schaden, wenn wir ihn\n"
"um sein Geld erleich-\n"
"tern."
msgstr ""
"Butler är en\n"
"förbannat rik man.\n"
"Det skulle säkert\n"
"inte skada er om\n"
"vi lättade honom\n"
"på hans pengar."

msgid ""
"Schliesslich ist es noch\n"
"ein weiter Weg zum Sil-\n"
"bersee. Wir brauchen\n"
"das Geld!"
msgstr ""
"Det är trots allt\n"
"långt kvar till\n"
"Silversjön. Vi\n"
"behöver pengarna!"

msgid ""
"Und Du hast uns hier-\n"
"her bestellt, nur um\n"
"uns das zu sagen?"
msgstr ""
"Och du kallade\n"
"hit oss bara för\n"
"att säga det?"

msgid ""
"Nicht nur deshalb,\n"
"ich brauche Eure\n"
"Hilfe. Butler's Farm\n"
"gleicht einer Festung.\n"
"Allein oder zu zweit\n"
"ist es fast"
msgstr ""
"Inte bara därför,\n"
"jag behöver er\n"
"hjälp. Butlers farm\n"
"liknar en fästning.\n"
"Ensam eller två\n"
"är det nästan"

msgid ""
"unmöglich, die Farm\n"
"zu stürmen. Gegen\n"
"uns alle hat Butler\n"
"jedoch keine Chance."
msgstr ""
"omöjligt att storma\n"
"farmen. Men mot\n"
"oss alla har Butler\n"
"ingen chans."

msgid ""
"Wenn das alles stimmt,\n"
"und für uns genug da-\n"
"bei herausspringt,\n"
"frage ich mich, wo-\n"
"rauf wir noch warten."
msgstr ""
"Om allt det där\n"
"stämmer och det blir\n"
"tillräckligt för\n"
"oss undrar jag vad\n"
"vi väntar på."

msgid ""
"Das sind die Worte\n"
"auf die ich gewartet\n"
"habe. Also, Männer,\n"
"auf zu Butler's Farm!"
msgstr ""
"Det är de ord\n"
"jag har väntat\n"
"på. Nå, män, mot\n"
"Butlers farm!"

msgid "Etwas Später..."
msgstr "Lite senare …"

msgid ""
"Die Tramps waren hier.\n"
"Sie haben immer noch\n"
"einen Vorsprung."
msgstr ""
"Luffarna var här.\n"
"De har fortfarande\n"
"ett försprång."

msgid ""
"Naja, die Gauner haben\n"
"auch Pferde. Wir sind\n"
"nur zu Fuss unterwegs."
msgstr ""
"Tja, skurkarna har\n"
"ju hästar. Vi är\n"
"bara till fots."

msgid ""
"Wir müssen uns sehr\n"
"beeilen, um Butler's\n"
"Farm noch rechtzeitig\n"
"zu erreichen. Die\n"
"Tramps werden mit den\n"
"Pferden nicht über"
msgstr ""
"Vi måste skynda oss\n"
"mycket för att\n"
"hinna fram till\n"
"Butlers farm.\n"
"Luffarna kommer inte\n"
"att ha ridit över"

msgid ""
"die Berge geritten sein,\n"
"obwohl das eine Abkür-\n"
"zung ist. Vielleicht\n"
"haben wir noch eine\n"
"Chance."
msgstr ""
"bergen, trots\n"
"att det är en\n"
"genväg. Kanske\n"
"har vi fortfarande\n"
"en chans."

msgid ""
"Oh,  Mr. Firehand.\n"
"Es ist mir eine Ehre,\n"
"Sie an Bord begrüssen\n"
"zu dürfen!"
msgstr ""
"Åh, herr Firehand.\n"
"Det är en ära att\n"
"få hälsa er\n"
"välkommen ombord!"

msgid ""
"Freut mich, Kapitän,\n"
"dass Sie meiner\n"
"Person soviel Bedeu-\n"
"tung beimessen."
msgstr ""
"Jag är glad,\n"
"kapten, att ni\n"
"fäster sådan vikt\n"
"vid min person."

msgid ""
"Na ja, man trifft\n"
"ja nicht alle Tage\n"
"einen so berühmten\n"
"Westmann wie Sie,\n"
"Mr. Firehand. Ihr\n"
"Ruf eilt Ihnen weit\n"
"voraus. Ihre Anwe-\n"
"senheit wird sich"
msgstr ""
"Tja, man träffar\n"
"inte varje dag en\n"
"så berömd västerlänning\n"
"som ni, herr Firehand.\n"
"Ert rykte går långt\n"
"före er. Er\n"
"närvaro kommer\n"
"säkert snabbt att"

msgid ""
"sicher schnell an\n"
"Bord herumsprechen.\n"
"Hoffen wir, dass Ihr\n"
"Name auch das Gesin-\n"
"del beeindruckt."
msgstr ""
"sprida sig ombord.\n"
"Låt oss hoppas\n"
"att ert namn\n"
"också imponerar\n"
"på packet."

msgid ""
"Gesindel? Ist das\n"
"ein Problem für Sie?"
msgstr ""
"Packet? Är det ett\n"
"problem för er?"

msgid ""
"Da fragen Sie noch !\n"
"Haben Sie sie denn\n"
"noch nicht gesehen -\n"
"die drei Tramps, die\n"
"auf meinem Schiff\n"
"herumlungern und die\n"
"Passagiere in Furcht\n"
"versetzen ?"
msgstr ""
"Frågar ni ens?\n"
"Har ni inte sett\n"
"dem ännu – de\n"
"tre luffarna som\n"
"driver omkring\n"
"på mitt fartyg\n"
"och skrämmer\n"
"passagerarna?"

msgid ""
"Nein, nein, den dreien\n"
"bin ich noch nicht\n"
"begegnet. Ich bin ja\n"
"auch gerade erst an\n"
"Bord gekommen."
msgstr ""
"Nej, nej, jag\n"
"har inte träffat\n"
"de tre än. Jag\n"
"har ju precis\n"
"kommit ombord."

msgid ""
"Würde mich interessie-\n"
"ren, was in der Kiste\n"
"ist, vielleicht gibt\n"
"es für mich etwas zu\n"
"holen."
msgstr ""
"Jag undrar vad\n"
"som finns i kistan.\n"
"Kanske finns\n"
"det något att\n"
"hämta åt mig."
