msgstr "   STEINWACHS"

msgid "ANIMATIONEN"
msgstr "ANIMATIONER"

msgid "MICHAEL TSCHOEGL"
msgstr "MICHAEL TSCHOEGL"

msgid "PORTRAIS"
msgstr "PORTRÄTT"

