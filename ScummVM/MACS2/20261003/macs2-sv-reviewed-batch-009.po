msgctxt "scene:12:46"
msgid ""
"Und wenn die Kohle alle\n"
"ist, wird mit Holz ge-\n"
"heizt."
msgstr ""
"Och när kolet är\n"
"slut eldar man med\n"
"ved."

msgctxt "scene:12:49"
msgid ""
"Einige Kohlen liegen\n"
"hier einzeln in der\n"
"Gegend herum. Der Heizer\n"
"hatte wohl keine Zeit\n"
"aufzuräumen..."
msgstr ""
"Några kolbitar ligger\n"
"utspridda här. Eldaren\n"
"hade nog inte\n"
"tid att städa\n"
"…"

msgctxt "scene:12:54"
msgid ""
"Jede Kohle zählt, darum\n"
"lass ich die liegen."
msgstr ""
"Varje kolbit räknas, så\n"
"jag låter dem ligga."

msgctxt "scene:12:56"
msgid ""
"Ich mag nicht Kohlen\n"
"mit mir herumschleppen."
msgstr ""
"Jag vill inte\n"
"släpa runt på kol."

msgctxt "scene:12:58"
msgid ""
"Ich habe keinen Kamin,\n"
"darum lasse ich das Holz\n"
"lieber liegen."
msgstr ""
"Jag har ingen eldstad,\n"
"så jag låter hellre\n"
"veden ligga."

msgctxt "scene:12:61"
msgid ""
"Die Tür klemmt, kommt\n"
"wohl von den rostigen\n"
"Angeln."
msgstr ""
"Dörren kärvar, nog på\n"
"grund av de rostiga\n"
"gångjärnen."

msgctxt "scene:12:64"
msgid ""
"Well, da komme ich\n"
"nicht d'ran!"
msgstr ""
"Tja, jag når\n"
"inte dit!"

msgctxt "scene:12:66"
msgid ""
"Au! Die Klappe kann ich\n"
"von Hand nicht öffnen,\n"
"die ist zu heiss!"
msgstr ""
"Aj! Jag kan inte\n"
"öppna luckan för hand,\n"
"den är för varm!"

msgctxt "scene:12:69"
msgid ""
"Es hat lang genug gedauert,\n"
"die Klappe aufzukriegen.\n"
"Ich werde sie also sicher\n"
"nicht wieder zumachen!"
msgstr ""
"Det tog lång tid\n"
"nog att få upp\n"
"luckan. Jag tänker minsann\n"
"inte stänga den igen!"

msgctxt "scene:12:73"
msgid ""
"Die Schaufel passt nicht\n"
"in die Vorrichtung der\n"
"Tür."
msgstr ""
"Skyffeln passar inte\n"
"i dörrens\n"
"mekanism."

msgctxt "scene:12:76"
msgid ""
"Das würde die Klappe\n"
"auch nicht genügend\n"
"abkühlen!"
msgstr ""
"Det skulle inte\n"
"kyla ned luckan\n"
"tillräckligt heller!"

msgctxt "scene:12:79"
msgid ""
"Da liegt etwas d'rinn,\n"
"eingewickelt in einem\n"
"Lappen!"
msgstr ""
"Det ligger något därinne,\n"
"inlindat i en\n"
"trasa!"

msgctxt "scene:12:82"
msgid ""
"Es ist Pattersons\n"
"Bowie-Messer!!!\n"
"Das muss dieser\n"
"Brinkley hier ver-\n"
"steckt haben. Sicher\n"
"hat er das Schiff\n"
"angebohrt."
msgstr ""
"Det är Pattersons\n"
"Bowiekniv!!! Den\n"
"måste Brinkley\n"
"ha gömt här.\n"
"Han har säkert\n"
"borrat hål i\n"
"fartyget."

msgctxt "scene:12:89"
msgid ""
"Da liegt irgendwas\n"
"d'rinn!"
msgstr ""
"Det ligger något\n"
"därinne!"

msgctxt "scene:12:91"
msgid ""
"Aber ich komme nicht\n"
"d'ran! Die Hitze von\n"
"unten ist zu gross!"
msgstr ""
"Men jag når\n"
"inte dit! Värmen\n"
"underifrån är för stark!"

msgctxt "scene:12:94"
msgid ""
"Da oben im Ofen\n"
"gibt es nichts\n"
"mehr zu holen!"
msgstr ""
"Där uppe i\n"
"ugnen finns inget\n"
"mer att hämta!"

msgctxt "scene:12:97"
msgid ""
"Ich glaube nicht, dass\n"
"ich etwas finde, indem\n"
"ich mit einem Haken\n"
"in einem Haufen Kohle\n"
"herumstochere."
msgstr ""
"Jag tror inte att\n"
"jag hittar något genom\n"
"att peta med\n"
"en krok i en\n"
"hög kol."

msgctxt "scene:12:102"
msgid ""
"Diese Klappe hat keine\n"
"Vorrichtung um mit einem\n"
"Haken geöffnet zu\n"
"werden."
msgstr ""
"Luckan har ingen\n"
"mekanism för att\n"
"öppnas med\n"
"en krok."

msgctxt "scene:12:106"
msgid ""
"Der Haken scheint\n"
"mir nicht geeignet, die\n"
"verklemmte Tür zu repa-\n"
"rieren. Der Haken ist\n"
"viel zu schwach..."
msgstr ""
"Kroken verkar inte\n"
"vara lämplig för att\n"
"reparera den kärvande dörren.\n"
"Den är alldeles för\n"
"svag …"

msgctxt "scene:12:111"
msgid ""
"Wenn ich den Haken verwende,\n"
"wird das Loch nur grösser,\n"
"und ich will ja das Loch\n"
"stopfen, nicht das Schiff\n"
"noch schneller versenken."
msgstr ""
"Om jag använder kroken\n"
"blir hålet bara större.\n"
"Jag vill täppa till\n"
"hålet och inte sänka\n"
"fartyget ännu snabbare."

msgctxt "scene:12:116"
msgid ""
"Meine Probleme werden auch\n"
"nicht gelöst, indem ich mit\n"
"dem Haken auf die Maschine\n"
"einschlage."
msgstr ""
"Mina problem löses inte\n"
"heller genom att jag\n"
"slår på maskinen med\n"
"kroken."

msgctxt "scene:12:120"
msgid ""
"Eine gute Idee, aber den\n"
"Lappen wird es durch den\n"
"Druck einfach wieder heraus-\n"
"spühlen..."
msgstr ""
"Bra idé, men trasan\n"
"kommer helt enkelt att\n"
"pressas ut igen av trycket\n"
"…"

msgctxt "scene:12:124"
msgid ""
"Deine Reinlichkeit in\n"
"Ehren, aber ich glaube,\n"
"dass dies hier nicht\n"
"viel nützt, und unsere\n"
"Probleme kaum lösen\n"
"wird."
msgstr ""
"All respekt för din\n"
"renlighet, men jag tror\n"
"inte att det\n"
"hjälper mycket här och\n"
"knappast löser våra\n"
"problem."

msgctxt "scene:12:130"
msgid ""
"Ich denke nicht daran,\n"
"jetzt Kohlen zu schippen."
msgstr ""
"Jag tänker inte\n"
"skyffla kol just nu."

msgctxt "scene:12:132"
msgid ""
"Die Schaufel ist sicher\n"
"zu schwach, um die Türe zu\n"
"lösen. Alles was ich da-\n"
"mit erreiche, ist die\n"
"Schaufel zu verbiegen."
msgstr ""
"Skyffeln är säkert för\n"
"svag för att få\n"
"loss dörren. Det enda\n"
"jag åstadkommer är\n"
"att böja skyffeln."

msgctxt "scene:12:137"
msgid ""
"Dies ist sicher nicht\n"
"das richtige Werkzeug\n"
"für eine solche Arbeit."
msgstr ""
"Det här är säkert\n"
"inte rätt verktyg för\n"
"ett sådant arbete."

msgctxt "scene:12:140"
msgid ""
"Den wollten wir ja der\n"
"Dame zurückgeben."
msgstr ""
"Den skulle vi ju lämna\n"
"tillbaka till damen."

msgctxt "scene:14:0"
msgid ""
"Die Tür ist\n"
"abgeschlossen!"
msgstr ""
"Dörren\n"
"är låst!"

msgctxt "scene:14:2"
msgid ""
"Die Tür ist\n"
"abgeschlossen!"
msgstr ""
"Dörren\n"
"är låst!"

msgctxt "scene:14:4"
msgid ""
"Ich glaube, ich lasse\n"
"ihn lieber schlafen,\n"
"bis ich eine Lösung\n"
"für das Problem gefunden\n"
"habe!"
msgstr ""
"Jag tror att jag\n"
"hellre låter honom sova\n"
"tills jag har\n"
"hittat en lösning på\n"
"problemet!"

msgctxt "scene:14:9"
msgid ""
"Ah, da sind Sie ja\n"
"wieder, Mr. Firehand."
msgstr ""
"Jaså, där är\n"
"ni igen, mr Firehand."

msgctxt "scene:14:11"
msgid ""
"Und, haben Sie eine\n"
"Lösung für das Problem\n"
"mit den Tramps?"
msgstr ""
"Nå, har ni\n"
"en lösning på problemet\n"
"med luffarna?"

msgctxt "scene:14:14"
msgid ""
"1. Sie müssten\n"
"   einen der Tramps\n"
"   ablenken."
msgstr ""
"1. Ni\n"
"måste distrahera en\n"
"av luffarna."

msgctxt "scene:14:17"
msgid ""
"2. Sie müssten sich\n"
"   verkleiden."
msgstr ""
"2. Ni måste\n"
"klä ut er."

msgctxt "scene:14:19"
msgid ""
"Ich weiss! Das haben\n"
"wir ja schon be-\n"
"sprochen. Und wie?\n"
"Wie soll ich ihn\n"
"ablenken???"
msgstr ""
"Jag vet! Det har\n"
"vi redan pratat\n"
"om. Men på vilket\n"
"sätt? Hur ska\n"
"jag distrahera honom?"

msgctxt "scene:14:24"
msgid ""
"Sie müssten sich\n"
"verkleiden..."
msgstr ""
"Ni måste klä\n"
"ut er …"

msgctxt "scene:14:26"
msgid ""
"Womit denn? Ich habe\n"
"keine anderen Sachen."
msgstr ""
"Men till vad? Jag\n"
"har inga andra kläder."

msgctxt "scene:14:28"
msgid ""
"1. Das weiss ich auch\n"
"   nicht."
msgstr ""
"1. Det vet jag\n"
"inte heller."

msgctxt "scene:14:30"
msgid ""
"2. Setzen Sie doch den\n"
"   Hut auf, den ich\n"
"   besorgt habe."
msgstr ""
"2. Sätt på\n"
"er hatten som\n"
"jag ordnade."

msgctxt "scene:14:33"
msgid ""
"Waaas? Diesen Hut?!\n"
"Da sehe ich ja wie\n"
"eine Frau aus!"
msgstr ""
"Vaaad? Den där hatten?!\n"
"Då ser jag ju\n"
"ut som en kvinna!"

msgctxt "scene:14:36"
msgid ""
"Wenn ich es mir aber\n"
"so überlege, dann\n"
"muss ich schon sagen,\n"
"dass die Idee gar\n"
"nicht so schlecht ist."
msgstr ""
"Men när jag\n"
"tänker efter\n"
"måste jag säga\n"
"att idén\n"
"inte är så dum."

msgctxt "scene:14:41"
msgid ""
"Auf den Trick fällt\n"
"dieser finstere\n"
"Geselle bestimmt\n"
"herein.\n"
"Was für ein Spass!"
msgstr ""
"Den här mörka\n"
"typen går\n"
"säkert på\n"
"det\n"
"tricket. Vilket nöje!"

msgctxt "scene:14:46"
msgid "Einen Moment..."
msgstr "Ett ögonblick …"

msgctxt "scene:14:47"
msgid ""
"So würde mich sicher\n"
"nicht einmal meine\n"
"Mutter erkennen.\n"
"Also, Mr. Firehand, ans'\n"
"Werk. Zeigen Sie mir,\n"
"wo der Tramp herum-\n"
"lungert."
msgstr ""
"Så här skulle\n"
"inte ens min\n"
"mor känna igen\n"
"mig. Nåväl, mr Firehand,\n"
"sätt i gång. Visa\n"
"mig var luffaren\n"
"håller till."

msgctxt "scene:14:54"
msgid ""
"Wäre doch gelacht, wenn\n"
"ich den nicht um den\n"
"kleinen Finger wickeln\n"
"könnte, hehe."
msgstr ""
"Det vore väl sjutton\n"
"om jag inte\n"
"kunde linda honom runt\n"
"lillfingret, hehe."

msgctxt "scene:14:58"
msgid ""
"Vielleicht finden Sie\n"
"ja noch eine Lösung\n"
"für das Problem mit\n"
"den Tramps.\n"
"Bis später..."
msgstr ""
"Kanske hittar ni\n"
"en lösning på\n"
"problemet med luffarna.\n"
"Vi ses\n"
"senare …"

msgctxt "scene:14:63"
msgid ""
"Was gibt es denn,\n"
"Mr. Firehand?"
msgstr ""
"Vad kan jag hjälpa till\n"
"med, mr Firehand?"

msgctxt "scene:14:65"
msgid ""
"1. Mir scheint, die\n"
"   Tramps führen was\n"
"   im Schilde!"
msgstr ""
"1. Det verkar som\n"
"om luffarna har något\n"
"i görningen!"

msgctxt "scene:14:68"
msgid ""
"2. Entschuldigen Sie\n"
"   die Störung."
msgstr ""
"2. Ursäkta att\n"
"jag stör."

msgctxt "scene:14:70"
msgid ""
"Wie kommen Sie denn\n"
"darauf? Obwohl, das\n"
"würde mich nicht über-\n"
"raschen."
msgstr ""
"Hur kommer ni\n"
"fram till det?\n"
"Fast det skulle inte\n"
"förvåna mig."
