msgctxt "scene:23:87"
msgid ""
"Quatsch! Sie wollen\n"
"ein Westmann sein,\n"
"und wissen noch nicht\n"
"einmal, was das hier\n"
"für ein Gewehr ist?!"
msgstr ""
"Struntprat! Ni vill\n"
"vara västerman men\n"
"vet inte ens\n"
"vad det här\n"
"är för gevär?!"

msgctxt "scene:23:92"
msgid ""
"Nein, nein - keine\n"
"Winchester. Und sie\n"
"wollen ein Westmann\n"
"sein?"
msgstr ""
"Nej, nej, ingen\n"
"Winchester. Och ni\n"
"vill vara\n"
"västerman?"

msgctxt "scene:23:96"
msgid ""
"Na sowas?! Dass sie\n"
"das erkannt haben!\n"
"Das ist tatsächlich\n"
"ein Henry-Stutzen."
msgstr ""
"Nå, se där?!\n"
"Ni kände igen\n"
"det! Det är\n"
"faktiskt en Henrybössa."

msgctxt "scene:23:100"
msgid ""
"Es gibt ja wirklich\n"
"nicht sehr viele von\n"
"diesen Stücken. Sie\n"
"müssen ein richtiger\n"
"Westmann sein. Seien\n"
"sie mir willkommen!"
msgstr ""
"Det finns\n"
"verkligen inte många\n"
"sådana vapen.\n"
"Ni måste vara\n"
"en riktig västerman.\n"
"Var välkommen!"

msgctxt "scene:23:106"
msgid ""
"1. Ich bin berühmt\n"
"   im ganzen Westen."
msgstr ""
"1. Jag är\n"
"berömd i hela Västern."

msgctxt "scene:23:108"
msgid ""
"2. Ich bin ein ehren-\n"
"   wehrter Mensch!"
msgstr ""
"2. Jag är\n"
"en hedervärd människa!"

msgctxt "scene:23:110"
msgid ""
"3. Was machen sie\n"
"   hier im Wald?"
msgstr ""
"3. Vad gör ni\n"
"här i skogen?"

msgctxt "scene:23:112"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:113"
msgid ""
"Fragt sich nur, in\n"
"welcher Hinsicht be-\n"
"rühmt. Ich habe schon\n"
"von Old Firehand ge-\n"
"hört, doch wer garan-\n"
"tiert mir, dass du\n"
"die Wahrheit sagst?"
msgstr ""
"Frågan är bara\n"
"på vilket sätt\n"
"du är berömd. Jag\n"
"har hört talas\n"
"om Old Firehand, men\n"
"vem garanterar att\n"
"du talar sanning?"

msgctxt "scene:23:120"
msgid ""
"Tsja, wenn ich nur\n"
"einen fragen könnte.\n"
"Sie können mir ja\n"
"viel erzählen. Ich\n"
"habe schon meine\n"
"Erfahrungen gemacht,\n"
"und bin deshalb\n"
"vorsichtig."
msgstr ""
"Tja, om jag\n"
"bara kunde fråga någon.\n"
"Ni kan ju\n"
"berätta vad som\n"
"helst för mig.\n"
"Jag har varit med\n"
"om saker och\n"
"är därför försiktig."

msgctxt "scene:23:128"
msgid ""
"Das werde ich Ihnen\n"
"auch noch gerade\n"
"erzählen."
msgstr ""
"Det ska jag då\n"
"rakt inte berätta\n"
"för er."

msgctxt "scene:23:131"
msgid ""
"1. Kennen Sie\n"
"   einen Mr. Droll?"
msgstr ""
"1. Känner\n"
"ni en mr Droll?"

msgctxt "scene:23:133"
msgid ""
"2. Kennen Sie einen\n"
"   Mr. Patterson?"
msgstr ""
"2. Känner ni\n"
"en mr Patterson?"

msgctxt "scene:23:135"
msgid ""
"3. Kennen Sie einen\n"
"   gewissen Cornel?"
msgstr ""
"3. Känner ni\n"
"en viss Cornel?"

msgctxt "scene:23:137"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:138"
msgid ""
"Droll? Droll? Ja! Ich\n"
"habe den Namen schon\n"
"einmal gehört. Können\n"
"sie mir mehr zu diesem\n"
"Mann sagen?"
msgstr ""
"Droll? Droll? Ja!\n"
"Jag har hört\n"
"namnet förut. Kan\n"
"ni berätta mer\n"
"om den mannen?"

msgctxt "scene:23:143"
msgid ""
"Patterson? Nein,\n"
"nie gehört?"
msgstr ""
"Patterson? Nej, aldrig hört\n"
"talas om honom?"

msgctxt "scene:23:145"
msgid ""
"Der Cornel? Einmal\n"
"erzählte mir jemand,\n"
"dass der Cornel ein\n"
"gefährlicher Bandit\n"
"sei. Stimmt das?"
msgstr ""
"Cornel? Någon berättade\n"
"en gång för\n"
"mig att Cornel\n"
"är en farlig\n"
"bandit. Stämmer det?"

msgctxt "scene:23:150"
msgid ""
"1. Der Cornel ist\n"
"   ein Verbrecher."
msgstr ""
"1. Cornel\n"
"är en brottsling."

msgctxt "scene:23:152"
msgid ""
"2. Der Cornel ist\n"
"   kein Verbrecher."
msgstr ""
"2. Cornel\n"
"är ingen brottsling."

msgctxt "scene:23:154"
msgid ""
"3. Der Cornel hat\n"
"   meinen Kompagnon\n"
"   gefangengenommen."
msgstr ""
"3. Cornel\n"
"har tagit min\n"
"följeslagare till fånga."

msgctxt "scene:23:157"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:158"
msgid ""
"So, so - ein Verbrecher.\n"
"Was hat er denn schon\n"
"Böses getan?"
msgstr ""
"Jaså, en brottsling. Vad\n"
"har han egentligen gjort\n"
"för ont?"

msgctxt "scene:23:161"
msgid ""
"Komisch! Man erzählt\n"
"sich aber die tollsten\n"
"Geschichten über ihn."
msgstr ""
"Märkligt! Men man\n"
"berättar de mest\n"
"fantastiska historier om honom."

msgctxt "scene:23:164"
msgid ""
"Welchen Kompangnon\n"
"denn?"
msgstr ""
"Vilken följeslagare\n"
"då?"

msgctxt "scene:23:166"
msgid ""
"1. Er hat meinen Kom-\n"
"   pangnon gefangen."
msgstr ""
"1. Han har tagit\n"
"min följeslagare till fånga."

msgctxt "scene:23:168"
msgid ""
"2. Nichts, er ist gar\n"
"   nicht so gefährlich,\n"
"   wie man sagt."
msgstr ""
"2. Ingenting, han är\n"
"inte alls så farlig\n"
"som man säger."

msgctxt "scene:23:171"
msgid ""
"3. Er droht, meinen\n"
"   Freund zu töten."
msgstr ""
"3. Han hotar att\n"
"döda min vän."

msgctxt "scene:23:173"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:174"
msgid "Welchen Kompagnon?"
msgstr "Vilken följeslagare?"

msgctxt "scene:23:175"
msgid ""
"Na, warum sollen wir\n"
"uns dann das Maul über\n"
"ihn zerreissen."
msgstr ""
"Nå, varför skulle\n"
"vi då prata\n"
"illa om honom."

msgctxt "scene:23:178"
msgid ""
"Welchen Freund\n"
"meinen sie?"
msgstr ""
"Vilken vän\n"
"menar ni?"

msgctxt "scene:23:180"
msgid ""
"1. Man nennt ihn\n"
"   auch den 'Onkel'!"
msgstr ""
"1. Han\n"
"kallas också ”farbror”!"

msgctxt "scene:23:182"
msgid ""
"2. Droll trägt den\n"
"   Beinamen 'Tante'?"
msgstr ""
"2. Droll\n"
"har smeknamnet ”tant”?"

msgctxt "scene:23:184"
msgid ""
"3. Mr. Droll spricht\n"
"   wie eine Frau."
msgstr ""
"3. Mr Droll talar\n"
"som en kvinna."

msgctxt "scene:23:186"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:187"
msgid ""
"Onkel Droll? Nein,\n"
"nein, da muss ich mich\n"
"geirrt haben. Ich\n"
"habe den Namen wohl\n"
"verwechselt."
msgstr ""
"Farbror Droll? Nej,\n"
"då måste jag ha\n"
"misstagit mig. Jag\n"
"har nog blandat\n"
"ihop namnet."

msgctxt "scene:23:192"
msgid ""
"Tante Droll? Genau!\n"
"Das ist der Name. Wenn\n"
"Sie ihn kennen, können\n"
"sie mir ja auch noch\n"
"mehr von ihm erzählen."
msgstr ""
"Tant Droll? Just\n"
"det! Det är namnet.\n"
"Om ni känner honom\n"
"kan ni kanske\n"
"berätta mer om honom."

msgctxt "scene:23:197"
msgid ""
"Der Mann soll wie eine\n"
"Frau sprechen? Davon\n"
"habe ich noch nichts\n"
"gehört!"
msgstr ""
"Mannen ska tala som\n"
"en kvinna? Det\n"
"har jag aldrig\n"
"hört!"

msgctxt "scene:23:201"
msgid ""
"1. Die Tante trägt\n"
"   nie Hosen."
msgstr ""
"1. Tanten bär\n"
"aldrig byxor."

msgctxt "scene:23:203"
msgid ""
"2. Droll ist ein\n"
"   Verbrecher."
msgstr ""
"2. Droll är\n"
"en brottsling."

msgctxt "scene:23:205"
msgid ""
"3. Man nennt Ihn Tante,\n"
"   weil seine Hose ei-\n"
"   nem Rock gleicht."
msgstr ""
"3. Han kallas tant\n"
"eftersom hans byxor\n"
"liknar en kjol."

msgctxt "scene:23:208"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:209"
msgid ""
"Nun, da muss ich mich\n"
"getäuscht haben. In dem\n"
"Zusammenhang sagt mir\n"
"der Name doch nichts."
msgstr ""
"Tja, då måste\n"
"jag ha misstagit mig.\n"
"I det sammanhanget\n"
"säger namnet mig ingenting."

msgctxt "scene:23:213"
msgid ""
"Ich glaube, wir sprechen\n"
"nicht von dem gleichen\n"
"Mr.Droll."
msgstr ""
"Jag tror inte att\n"
"vi talar om samma\n"
"mr Droll."

msgctxt "scene:23:216"
msgid ""
"Genau! Der Lederrock!\n"
"Und sie kennen die\n"
"Tante Droll?"
msgstr ""
"Just det! Läderskjolen!\n"
"Och ni känner\n"
"tant Droll?"

msgctxt "scene:23:219"
msgid ""
"1. Nein, ich bin ihr\n"
"   nie begegnet."
msgstr ""
"1. Nej, jag har\n"
"aldrig träffat honom."

msgctxt "scene:23:221"
msgid ""
"2. Zusammen mit Droll\n"
"   jage ich den Cornel,\n"
"   einen Verbrecher."
msgstr ""
"2. Tillsammans med\n"
"Droll jagar jag\n"
"Cornel, en brottsling."

msgctxt "scene:23:224"
msgid ""
"3. Ich bin mit Droll\n"
"   zur Schule gegangen."
msgstr ""
"3. Jag gick\n"
"i skolan med Droll."

msgctxt "scene:23:226"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."
