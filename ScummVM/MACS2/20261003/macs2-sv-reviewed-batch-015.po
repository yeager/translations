msgctxt "scene:22:45"
msgid ""
"Zwei leere Flaschen\n"
"liegen da herum."
msgstr ""
"Två tomma flaskor\n"
"ligger här."

msgctxt "scene:22:47"
msgid ""
"Ein alter Wasserkrug,\n"
"der bereits ein Loch\n"
"hat."
msgstr ""
"En gammal vattenkruka som\n"
"redan har ett\n"
"hål."

msgctxt "scene:22:50"
msgid ""
"Eine schon fast abge-\n"
"brannte Kerze."
msgstr ""
"Ett nästan\n"
"nedbrunnet ljus."

msgctxt "scene:22:52"
msgid ""
"Ein Bärenfell, das\n"
"wohl schon etwas\n"
"feucht geworden ist,\n"
"denn es modert bereits."
msgstr ""
"Ett björnskinn som nog\n"
"har blivit lite\n"
"fuktigt, för det håller\n"
"redan på att mögla."

msgctxt "scene:22:56"
msgid ""
"Ein Seekoffer, wie er\n"
"unten im Raum steht."
msgstr ""
"En sjökista som den\n"
"nere i rummet."

msgctxt "scene:22:58"
msgid ""
"Die Luke, runter in\n"
"den anderen Raum."
msgstr ""
"Luckan ned till\n"
"det andra rummet."

msgctxt "scene:22:60"
msgid ""
"Ein kleines Schränkchen\n"
"mit zwei Schubladen."
msgstr ""
"Ett litet skåp\n"
"med två lådor."

msgctxt "scene:22:62"
msgid ""
"Ein Fass, die muss er\n"
"früher wohl zum Sammeln\n"
"von Trinkwasser ver-\n"
"wendet haben."
msgstr ""
"En tunna. Han\n"
"använde den nog\n"
"tidigare för att\n"
"samla dricksvatten."

msgctxt "scene:22:66"
msgid ""
"Eine Stofftasche,wie\n"
"sie von Ärzten und\n"
"Handelsreisenden oft\n"
"benutzt werden."
msgstr ""
"En tygväska av\n"
"den sort som\n"
"läkare och handelsresande\n"
"ofta använder."

msgctxt "scene:22:70"
msgid ""
"Ein Haufen nutzloses\n"
"Zeug liegt hier herum.\n"
"Nur lauter Gerümpel,\n"
"scheint ein leiden-\n"
"schaftlicher Sammler\n"
"zu sein."
msgstr ""
"En hög med\n"
"oanvändbara saker ligger\n"
"här. Bara skräp.\n"
"Han verkar vara\n"
"en passionerad\n"
"samlare."

msgctxt "scene:22:76"
msgid ""
"Den Balken kann ich\n"
"nicht mitnehmen, da\n"
"würde ja das Dach\n"
"einstürzen."
msgstr ""
"Jag kan inte\n"
"ta med bjälken,\n"
"då skulle taket\n"
"rasa in."

msgctxt "scene:22:80"
msgid ""
"Die Holztreppe könnte\n"
"bei einem Hausbau\n"
"sicher nützlich sein,\n"
"aber nur zum herum-\n"
"schleppen ist sie\n"
"einfach zu schwer."
msgstr ""
"Trappan av trä skulle\n"
"säkert vara användbar\n"
"vid ett husbygge, men\n"
"den är alldeles för\n"
"tung att bara\n"
"släpa runt på."

msgctxt "scene:22:86"
msgid ""
"Leider ist die Flasche\n"
"bereits leer, sonst\n"
"hätte ich mir einen\n"
"Schluck genehmigt."
msgstr ""
"Tyvärr är flaskan\n"
"redan tom, annars\n"
"hade jag tagit\n"
"mig en klunk."

msgctxt "scene:22:90"
msgid ""
"Nein, der hat ja schon\n"
"ein Loch, den lasse ich\n"
"stehen."
msgstr ""
"Nej, den har ju redan\n"
"ett hål. Jag låter den\n"
"stå."

msgctxt "scene:22:93"
msgid ""
"Die ist beinahe schon\n"
"runtergebrannt, dafür\n"
"lohnt es sich nicht,\n"
"über das ganze Gerüm-\n"
"pel zu klettern."
msgstr ""
"Den är nästan\n"
"nedbrunnen. Det är\n"
"inte värt att\n"
"klättra över allt\n"
"skräp för den."

msgctxt "scene:22:98"
msgid ""
"Den vermoderten Fetzen\n"
"lass ich liegen, der\n"
"kann mir nicht von\n"
"Nutzen sein."
msgstr ""
"Jag låter den murkna\n"
"trasan ligga. Den kan\n"
"inte vara till nytta\n"
"för mig."

msgctxt "scene:22:102"
msgid ""
"Der Koffer ist mit einem\n"
"grossen Schloss fest ver-\n"
"schlossen. Ich möchte ihn\n"
"nicht aufbrechen."
msgstr ""
"Kistan är ordentligt låst\n"
"med ett stort lås.\n"
"Jag vill inte bryta\n"
"upp den."

msgctxt "scene:22:106"
msgid ""
"Das Fass ist schwer,\n"
"und Wasservorräte\n"
"muss ich nicht mit-\n"
"nehmen, nachdem der\n"
"Fluss gerade nur ein\n"
"paar Schritte ent-\n"
"fernt ist."
msgstr ""
"Tunnan är tung\n"
"och jag\n"
"behöver inte ta\n"
"med vattenförråd när\n"
"floden bara ligger\n"
"några steg\n"
"bort."

msgctxt "scene:22:113"
msgid ""
"All das alte Zeug ist\n"
"nutzlos und braucht nur\n"
"viel Platz..."
msgstr ""
"Alla de här gamla sakerna\n"
"är oanvändbara och tar bara\n"
"upp plats …"

msgctxt "scene:23:0"
msgid ""
"HALT!\n"
"Stehenbleiben, oder ich\n"
"schiesse!"
msgstr ""
"STANNA!\n"
"Stå still, annars skjuter\n"
"jag!"

msgctxt "scene:23:3"
msgid ""
"Aha, wolltest dich\n"
"wohl an meinem \n"
"Wagen zu schaffen\n"
"machen?"
msgstr ""
"Jaså, ville\n"
"du rota\n"
"i min\n"
"vagn?"

msgctxt "scene:23:7"
msgid ""
"Wo denken sie hin,\n"
"guter Mann. Ich bin\n"
"zufällig auf ihren\n"
"Lagerplatz gestossen."
msgstr ""
"Hur kan ni\n"
"tro det, gode man?\n"
"Jag råkade bara\n"
"stöta på ert läger."

msgctxt "scene:23:11"
msgid ""
"Und was treibst du\n"
"dich dann so heim-\n"
"lich hier herum?"
msgstr ""
"Och vad gör\n"
"du då här\n"
"och smyger omkring?"

msgctxt "scene:23:14"
msgid ""
"Ah, Sie schon wieder!\n"
"Haben Sie sich die Ant-\n"
"wort überlegt?"
msgstr ""
"Ah, ni igen!\n"
"Har ni tänkt\n"
"ut svaret?"

msgctxt "scene:23:17"
msgid ""
"1. Ich bin ganz\n"
"   zufällig hier."
msgstr ""
"1. Jag råkade\n"
"bara vara här."

msgctxt "scene:23:19"
msgid ""
"2. Ich habe sie\n"
"   gesucht."
msgstr ""
"2. Jag letade\n"
"efter er."

msgctxt "scene:23:21"
msgid ""
"3. Gangster haben\n"
"   meinen Freund\n"
"   gefangen."
msgstr ""
"3. Gangstrar\n"
"har fångat\n"
"min vän."

msgctxt "scene:23:24"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:25"
msgid ""
"Zufällig?! Raus' mit\n"
"der Sprache, was\n"
"wollen sie hier?"
msgstr ""
"Råkade?! Tala om\n"
"vad ni\n"
"vill här?"

msgctxt "scene:23:28"
msgid ""
"Mich gesucht? Ich\n"
"kenne sie ja gar\n"
"nicht, Freundchen!\n"
"Also, warum sollten\n"
"sie mich hier im\n"
"Wald suchen, hä?"
msgstr ""
"Letade efter mig?\n"
"Jag känner ju\n"
"inte er, min vän!\n"
"Varför skulle ni leta\n"
"efter mig här\n"
"i skogen, va?"

msgctxt "scene:23:34"
msgid ""
"Und die Geschichte\n"
"soll ich dir glau-\n"
"ben? Pah! Denk dir\n"
"schnell was Besse-\n"
"res aus!"
msgstr ""
"Och den historien\n"
"ska jag tro\n"
"på? Pytt! Hitta\n"
"snabbt på något\n"
"bättre!"

msgctxt "scene:23:39"
msgid ""
"Sieh nur zu, dass\n"
"du hier verschwin-\n"
"dest!"
msgstr ""
"Se till\n"
"att försvinna\n"
"härifrån!"

msgctxt "scene:23:42"
msgid ""
"1. Mein Name ist\n"
"   Old Firehand."
msgstr ""
"1. Jag\n"
"heter Old Firehand."

msgctxt "scene:23:44"
msgid ""
"2. Ich habe mich im\n"
"   Wald verirrt."
msgstr ""
"2. Jag har gått\n"
"vilse i skogen."

msgctxt "scene:23:46"
msgid ""
"3. Zielen sie nicht\n"
"   dauernd mit dem\n"
"   Gewehr auf mich!"
msgstr ""
"3. Sluta rikta\n"
"geväret mot mig\n"
"hela tiden!"

msgctxt "scene:23:49"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:50"
msgid ""
"Old Firehand? Na und?\n"
"Noch nie den Namen\n"
"gehört."
msgstr ""
"Old Firehand? Jaså?\n"
"Aldrig hört\n"
"namnet."

msgctxt "scene:23:53"
msgid ""
"Nun - das kann man\n"
"schon glauben. Die-\n"
"ser Wald kann zu-\n"
"weilen sehr tückisch\n"
"werden."
msgstr ""
"Tja, det kan\n"
"man gott tro.\n"
"Den här skogen\n"
"kan ibland vara\n"
"riktigt förrädisk."

msgctxt "scene:23:58"
msgid ""
"1. Wenn man sich hier\n"
"   auskennt, kann\n"
"   nichts schiefgehen."
msgstr ""
"1. Om man känner\n"
"till området kan\n"
"inget gå fel."

msgctxt "scene:23:61"
msgid ""
"2. Sie haben sich doch\n"
"   bestimmt verirrt."
msgstr ""
"2. Ni har väl\n"
"säkert gått vilse."

msgctxt "scene:23:63"
msgid ""
"3. Sind sie absichtlich\n"
"   mit ihrem Planwagen\n"
"   hier?"
msgstr ""
"3. Är ni här\n"
"med flit i er\n"
"täckta vagn?"

msgctxt "scene:23:66"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:23:67"
msgid ""
"Ja, ja - dafür gibt\n"
"es ja Landkarten."
msgstr ""
"Jaja, det är därför\n"
"det finns kartor."

msgctxt "scene:23:69"
msgid ""
"Das geht sie\n"
"gar nichts an!"
msgstr ""
"Det angår\n"
"inte er alls!"

msgctxt "scene:23:71"
msgid ""
"Lassen sie das, Mister!\n"
"Oder ich brenn' ihnen\n"
" 'ne Kugel auf den Pelz!"
msgstr ""
"Sluta med det, mister!\n"
"Annars sätter jag en\n"
"kula i skinnet på er!"

msgctxt "scene:23:74"
msgid ""
"Mit diesem Gewehr\n"
"treffe ich jeden\n"
"Halunken, auch wenn\n"
"ich nicht auf ihn\n"
"direkt ziele!"
msgstr ""
"Med det här\n"
"geväret träffar jag\n"
"varje skurk, även när\n"
"jag inte siktar\n"
"rakt på honom!"

msgctxt "scene:23:79"
msgid ""
"1. Ist das Gewehr\n"
"   ein Bärentöter?"
msgstr ""
"1. Är\n"
"geväret en björndödare?"

msgctxt "scene:23:81"
msgid ""
"2. Ist das Gewehr\n"
"   eine Winchester?"
msgstr ""
"2. Är\n"
"geväret en Winchester?"

msgctxt "scene:23:83"
msgid ""
"3. Das Gewehr sieht\n"
"   stark nach einem\n"
"   Henry-Stutzen aus."
msgstr ""
"3. Geväret ser\n"
"verkligen ut som\n"
"en Henrybössa."

msgctxt "scene:23:86"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."
