msgctxt "scene:24:147"
msgid ""
"Mit diesem stumpfen\n"
"Messer kann ich das\n"
"Seil zu den Stämmen\n"
"nicht durchschneiden."
msgstr ""
"Med den här\n"
"slöa kniven kan\n"
"jag inte skära\n"
"av repet till stockarna."

msgctxt "scene:26:0"
msgid ""
"Oh, da liegt ja ein\n"
"angerostetes Messer.\n"
"Das kann ich sicher\n"
"irgendwo gebrauchen,\n"
"ich nehme es mit."
msgstr ""
"Åh, där ligger\n"
"en rostig kniv.\n"
"Den kan jag\n"
"säkert använda någonstans.\n"
"Jag tar med den."

msgctxt "scene:26:5"
msgid ""
"Ich wüsste nicht, was\n"
"ich von dort noch\n"
"nehmen könnte."
msgstr ""
"Jag vet inte vad\n"
"mer jag skulle\n"
"kunna ta därifrån."

msgctxt "scene:26:8"
msgid ""
"Was soll ich mit\n"
"einem Busch an-\n"
"fangen?"
msgstr ""
"Vad ska jag\n"
"göra med en\n"
"buske?"

msgctxt "scene:26:11"
msgid ""
"Da liegt etwas unter\n"
"dem Busch, halb im\n"
"Dreck vergraben."
msgstr ""
"Det ligger något\n"
"under busken, halvt\n"
"begravt i jorden."

msgctxt "scene:26:14"
msgid ""
"Da ist nichts mehr, ausser\n"
"Aesten und Erde."
msgstr ""
"Där finns inget mer än\n"
"grenar och jord."

msgctxt "scene:26:16"
msgid ""
"An dem Busch sind einige\n"
"Aeste abgeschnitten wor-\n"
"den..."
msgstr ""
"Några grenar har skurits\n"
"av från busken\n"
"…"

msgctxt "scene:26:19"
msgid ""
"Der gesamte Weg wird\n"
"von undurchdring-\n"
"lichem Gebüsch ge-\n"
"säumt."
msgstr ""
"Hela vägen\n"
"kantas av\n"
"ogenomträngligt\n"
"buskage."

msgctxt "scene:26:23"
msgid ""
"Ein holpriger Pfad,\n"
"doch ungewöhnlich\n"
"breit, scheint mir."
msgstr ""
"En gropig stig,\n"
"men ovanligt\n"
"bred, tycker jag."

msgctxt "scene:26:26"
msgid ""
"Da liegen überall auf\n"
"dem Weg Steine herum."
msgstr ""
"Det ligger stenar\n"
"överallt på vägen."

msgctxt "scene:26:28"
msgid ""
"Ein Baum mitten im\n"
"Wald..."
msgstr ""
"Ett träd mitt i\n"
"skogen …"

msgctxt "scene:26:30"
msgid ""
"Weit sieht man durch\n"
"dieses Dickicht im\n"
"Wald gar nicht hindurch."
msgstr ""
"Man kan inte se\n"
"särskilt långt genom\n"
"det här snåret i skogen."

msgctxt "scene:26:33"
msgid ""
"Das Gestrüpp könnte man\n"
"eventuell für ein Lager-\n"
"feuer gut gebrauchen,\n"
"doch ich habe nicht vor,\n"
"ein Lagerfeuer zu ent-\n"
"fachen."
msgstr ""
"Snåret skulle kanske\n"
"passa bra till\n"
"en lägereld, men\n"
"jag tänker inte\n"
"tända någon\n"
"lägereld."

msgctxt "scene:26:39"
msgid ""
"Wenn man Wege so ein-\n"
"fach mitnehmen könnte..."
msgstr ""
"Om man bara kunde ta\n"
"med sig vägar så där …"

msgctxt "scene:26:41"
msgid ""
"Nein, die Steine sind\n"
"nur überflüssiger Bal-\n"
"last für mich."
msgstr ""
"Nej, stenarna är\n"
"bara överflödig ballast\n"
"för mig."

msgctxt "scene:26:44"
msgid ""
"Ein Baum wäre wohl\n"
"schön, doch Du über-\n"
"schätzt mich etwas."
msgstr ""
"Ett träd vore\n"
"trevligt, men du\n"
"överskattar mig lite."

msgctxt "scene:26:47"
msgid ""
"Mit dem ganzen Wald\n"
"würde ich mich wohl\n"
"etwas übernehmen..."
msgstr ""
"Jag skulle nog ta\n"
"mig vatten över huvudet\n"
"med hela skogen …"

msgctxt "scene:28:0"
msgid ""
"Wir haben es tatsäch-\n"
"lich geschafft. Wahr-\n"
"scheinlich bereitet\n"
"der Cornel den Angriff\n"
"erst sorgfältig vor -\n"
"das gibt uns etwas\n"
"Zeit."
msgstr ""
"Vi klarade\n"
"det faktiskt.\n"
"Cornel förbereder\n"
"antagligen först anfallet\n"
"noga. Det\n"
"ger oss\n"
"lite tid."

msgctxt "scene:28:7"
msgid "Es ist verschlossen."
msgstr "Det är låst."

msgctxt "scene:28:8"
msgid "Hallo, ist da jemand?"
msgstr "Hallå, är det någon där?"

msgctxt "scene:28:9"
msgid ""
"Leuten zu helfen ist\n"
"schwieriger als ich\n"
"dachte."
msgstr ""
"Att hjälpa folk\n"
"är svårare än\n"
"jag trodde."

msgctxt "scene:28:12"
msgid ""
"Am besten versuchen\n"
"Sie's nochmal!"
msgstr ""
"Det är bäst att\n"
"ni försöker igen!"

msgctxt "scene:28:14"
msgid ""
"Gut, ich hoffe, dass\n"
"unser Freund diesesmal\n"
"für unsere Argumente\n"
"zugänglicher ist."
msgstr ""
"Bra, jag hoppas att\n"
"vår vän den här\n"
"gången är mottaglig för\n"
"våra argument."

msgctxt "scene:28:18"
msgid ""
"Was wollen Sie denn\n"
"jetzt schon wieder ?"
msgstr ""
"Vad vill\n"
"ni nu igen?"

msgctxt "scene:28:20"
msgid "Kann ich ihnen helfen?"
msgstr "Kan jag hjälpa er?"

msgctxt "scene:28:21"
msgid ""
"1. Bitte öffnen Sie\n"
"   das Tor und lassen\n"
"   Sie uns hinein."
msgstr ""
"1. Öppna grinden\n"
"och släpp in\n"
"oss, tack."

msgctxt "scene:28:24"
msgid ""
"2. Wir wollten nicht\n"
"   stören, auf Wieder-\n"
"   sehen."
msgstr ""
"2. Vi\n"
"ville inte störa.\n"
"Farväl."

msgctxt "scene:28:27"
msgid ""
"3. Jeder Zeit kann die\n"
"   Farm angegriffen\n"
"   werden, öffnen Sie!"
msgstr ""
"3. Gården kan\n"
"när som helst\n"
"bli angripen. Öppna!"

msgctxt "scene:28:30"
msgid ""
"Aber wer sind Sie denn?\n"
"Ich kenne Sie nicht?"
msgstr ""
"Men vilka är ni?\n"
"Jag känner inte er?"

msgctxt "scene:28:32"
msgid ""
"1. Unsere Namen sind\n"
"   unwichtig. Lassen\n"
"   Sie uns hinein!"
msgstr ""
"1. Våra namn\n"
"är oviktiga. Släpp\n"
"in oss!"

msgctxt "scene:28:35"
msgid ""
"2. Ich bin Old Fire-\n"
"   hand und dies ist\n"
"   Tante Droll."
msgstr ""
"2. Jag är Old\n"
"Firehand och det här\n"
"är tant Droll."

msgctxt "scene:28:38"
msgid ""
"3. Schon gut, auf\n"
"   Wiedersehen."
msgstr ""
"3. Det är\n"
"bra, farväl."

msgctxt "scene:28:40"
msgid ""
"Ich habe Anweisun-\n"
"gen, keine Fremden\n"
"hereinzulassen."
msgstr ""
"Jag har instruktioner\n"
"om att inte\n"
"släppa in främlingar."

msgctxt "scene:28:43"
msgid "Ich kenne Sie nicht!"
msgstr "Jag känner inte er!"

msgctxt "scene:28:44"
msgid ""
"1. Wir sind hier ver-\n"
"   abredet. Glauben\n"
"   Sie mir doch!"
msgstr ""
"1. Vi har\n"
"en överenskommelse här.\n"
"Tro mig!"

msgctxt "scene:28:47"
msgid ""
"2. Was soll das\n"
"   heissen?"
msgstr ""
"2. Vad\n"
"menar ni?"

msgctxt "scene:28:49"
msgid ""
"3. Mr. Butler erwartet\n"
"   uns, fragen Sie ihn."
msgstr ""
"3. Mr Butler väntar\n"
"på oss. Fråga honom."

msgctxt "scene:28:51"
msgid "4. Auf Wiedersehen."
msgstr "4. Farväl."

msgctxt "scene:28:52"
msgid ""
"Mit wem sind Sie hier\n"
"verabredet? Mir hat\n"
"niemand etwas gesagt."
msgstr ""
"Vem har ni en\n"
"överenskommelse med här? Ingen\n"
"har sagt något till mig."

msgctxt "scene:28:55"
msgid ""
"1. Wir haben eine\n"
"   Verabredung mit\n"
"   Mr. Butler."
msgstr ""
"1. Vi har\n"
"en överenskommelse med\n"
"mr Butler."

msgctxt "scene:28:58"
msgid ""
"2. Mr. Patterson\n"
"   erwartet uns."
msgstr ""
"2. Mr Patterson\n"
"väntar på oss."

msgctxt "scene:28:60"
msgid ""
"3. Mrs. Butler er-\n"
"   wartet uns."
msgstr ""
"3. Mrs Butler\n"
"väntar på oss."

msgctxt "scene:28:62"
msgid "4. Unwichtig, Bye!"
msgstr "4. Oviktigt, hej då!"

msgctxt "scene:28:63"
msgid ""
"Das kann nicht sein.\n"
"Mr. Butler ist nicht\n"
"zuhause!"
msgstr ""
"Det kan inte stämma.\n"
"Mr Butler är inte\n"
"hemma!"

msgctxt "scene:28:66"
msgid ""
"1. Mrs. Butler war-\n"
"   tet auf uns."
msgstr ""
"1. Mrs Butler\n"
"väntar på oss."

msgctxt "scene:28:68"
msgid ""
"2. Mr. Patterson er-\n"
"   wartet uns."
msgstr ""
"2. Mr Patterson väntar\n"
"på oss."

msgctxt "scene:28:70"
msgid ""
"Am besten besprechen\n"
"Sie das mit Mrs. Butler\n"
"persönlich. Einen\n"
"Moment bitte."
msgstr ""
"Det är bäst att\n"
"ni pratar med mrs\n"
"Butler personligen. Ett\n"
"ögonblick, tack."

msgctxt "scene:28:74"
msgid ""
"Mr. Patterson ist mit\n"
"Mr. Butler ausser Haus.\n"
"Tut mir leid."
msgstr ""
"Mr Patterson är\n"
"ute tillsammans med mr\n"
"Butler. Beklagar."

msgctxt "scene:28:77"
msgid ""
"Mr. Patterson hat Sie\n"
"eingeladen? Davon\n"
"weiss ich nichts."
msgstr ""
"Mr Patterson har bjudit\n"
"in er? Det\n"
"vet jag inget om."

msgctxt "scene:28:80"
msgid ""
"Mrs. Butler? Hm - Am\n"
"besten, Sie sprechen\n"
"selbst mit ihr. Einen\n"
"Moment bitte."
msgstr ""
"Mrs Butler? Hm, det\n"
"är bäst att ni\n"
"pratar med henne själva.\n"
"Ett ögonblick, tack."
