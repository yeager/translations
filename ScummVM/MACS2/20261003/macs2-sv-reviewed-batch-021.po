msgctxt "scene:28:84"
msgid ""
"Sollte ich Sie kennen?\n"
"Entschuldigen Sie, aber\n"
"das muss ich mir nicht\n"
"anhören."
msgstr ""
"Borde jag känna er?\n"
"Ursäkta, men jag behöver\n"
"inte lyssna på det\n"
"här."

msgctxt "scene:28:88"
msgid ""
"Mr. Butler kann ich\n"
"nicht fragen. Mr.\n"
"Butler ist nicht auf\n"
"der Farm."
msgstr ""
"Jag kan inte\n"
"fråga mr Butler.\n"
"Han är inte\n"
"på gården."

msgctxt "scene:28:92"
msgid "Good bye."
msgstr "Farväl."

msgctxt "scene:28:93"
msgid ""
"Ein Angriff? Es ist ja\n"
"alles ruhig hier."
msgstr ""
"Ett anfall? Allt är\n"
"ju lugnt här."

msgctxt "scene:28:95"
msgid ""
"1. Doch, doch!\n"
"   Tramps wollen\n"
"   die Farm plündern."
msgstr ""
"1. Jo,\n"
"jo! Luffarna\n"
"vill plundra gården."

msgctxt "scene:28:98"
msgid ""
"2. Sie werden schon\n"
"   sehen."
msgstr ""
"2. Ni kommer att\n"
"få se."

msgctxt "scene:28:100"
msgid "3. Auf Wiedersehen."
msgstr "3. Farväl."

msgctxt "scene:28:101"
msgid "Glaub' ich nicht."
msgstr "Det tror jag inte."

msgctxt "scene:28:102"
msgid "Oder auch nicht."
msgstr "Eller kanske inte."

msgctxt "scene:28:103"
msgid ""
"Nun, meine Herren, Sie\n"
"wollten mich sprechen?"
msgstr ""
"Nå, mina herrar, ni\n"
"ville tala med mig?"

msgctxt "scene:28:105"
msgid "Guten Tag, Mrs.Butler."
msgstr "God dag, mrs Butler."

msgctxt "scene:28:106"
msgid ""
"Guten Tag Mister. Wie\n"
"kann ich Ihnen helfen?"
msgstr ""
"God dag, mister. Hur\n"
"kan jag hjälpa er?"

msgctxt "scene:28:108"
msgid ""
"1. Wir möchten Ihren\n"
"   Mann sprechen."
msgstr ""
"1. Vi vill tala\n"
"med er man."

msgctxt "scene:28:110"
msgid ""
"2. Mr. Patterson er-\n"
"   wartet uns bestimmt."
msgstr ""
"2. Mr Patterson\n"
"väntar säkert på oss."

msgctxt "scene:28:112"
msgid ""
"3. Wir müssen dringend\n"
"   mit  ihnen sprechen."
msgstr ""
"3. Vi måste\n"
"tala med er omedelbart."

msgctxt "scene:28:114"
msgid ""
"Ich muss Sie enttäu-\n"
"schen. Mein Mann ist\n"
"nicht zuhause."
msgstr ""
"Jag måste göra er\n"
"besviken. Min man är\n"
"inte hemma."

msgctxt "scene:28:117"
msgid ""
"Mr. Patterson ist mit\n"
"meinem Mann ausser\n"
"Haus. Tut mir leid."
msgstr ""
"Mr Patterson är\n"
"ute tillsammans med\n"
"min man. Beklagar."

msgctxt "scene:28:120"
msgid "Worum geht es denn?"
msgstr "Vad gäller saken?"

msgctxt "scene:28:121"
msgid ""
"1. Sie sind in\n"
"   grosser Gefahr!"
msgstr ""
"1. Ni är\n"
"i stor fara!"

msgctxt "scene:28:123"
msgid ""
"2. Tramps wollen\n"
"   die Farm über-\n"
"   fallen."
msgstr ""
"2. Luffarna\n"
"vill anfalla\n"
"gården."

msgctxt "scene:28:126"
msgid ""
"Wieso sollte ich gerade\n"
"Ihnen vertrauen?"
msgstr ""
"Varför skulle jag lita\n"
"på just er?"

msgctxt "scene:28:128"
msgid ""
"Woher weiss ich, dass\n"
"SIE uns nicht überfal-\n"
"len wollen?"
msgstr ""
"Hur vet jag att\n"
"NI inte vill anfalla\n"
"oss?"

msgctxt "scene:28:131"
msgid ""
"1. Wir sind ehrliche\n"
"   Leute."
msgstr ""
"1. Vi är\n"
"hederliga människor."

msgctxt "scene:28:133"
msgid ""
"2. Lassen Sie uns hi-\n"
"   nein. Wir verlieren\n"
"   nur Zeit."
msgstr ""
"2. Släpp in\n"
"oss. Vi förlorar\n"
"bara tid."

msgctxt "scene:28:136"
msgid ""
"3. Mr. Patterson kennt\n"
"   uns, er könnte Sie\n"
"   überzeugen."
msgstr ""
"3. Mr Patterson\n"
"känner oss. Han\n"
"kan övertyga er."

msgctxt "scene:28:139"
msgid ""
"Nennen Sie mir doch\n"
"bitte erst einmal\n"
"ihre Namen."
msgstr ""
"Nämn först\n"
"era namn,\n"
"tack."

msgctxt "scene:28:142"
msgid ""
"Mr. Patterson ist leider\n"
"nicht in der Nähe. Viel-\n"
"leicht sagen mir Ihre\n"
"Namen ja etwas."
msgstr ""
"Mr Patterson är tyvärr\n"
"inte i närheten. Kanske\n"
"säger era namn\n"
"mig något."

msgctxt "scene:28:146"
msgid "Wer sind Sie eigentlich?"
msgstr "Vem är ni egentligen?"

msgctxt "scene:28:147"
msgid ""
"Verzeihen Sie bitte\n"
"mein Benehmen, ich bin\n"
"Firehand und meinen\n"
"Begleiter nennt man\n"
"Tante Droll."
msgstr ""
"Ursäkta mitt uppträdande.\n"
"Jag är Firehand\n"
"och min följeslagare\n"
"kallas tant\n"
"Droll."

msgctxt "scene:28:152"
msgid ""
"Firehand?! Ja, Sie wer-\n"
"den bereits von Ihren\n"
"Freunden, den Rafters,\n"
"erwartet. Seien Sie mir\n"
"gegrüsst und treten Sie\n"
"ein."
msgstr ""
"Firehand?! Ja, era\n"
"vänner Rafters väntar\n"
"redan på er.\n"
"Var hälsad och\n"
"stig\n"
"in."

msgctxt "scene:29:0"
msgid ""
"Ah, Firehand, Du schon\n"
"wieder, mir scheint,\n"
"dass sich unsere Wege\n"
"immer wieder kreuzen."
msgstr ""
"Ah, Firehand, du\n"
"igen. Det verkar\n"
"som om våra\n"
"vägar fortsätter att korsas."

msgctxt "scene:29:4"
msgid ""
"Ja, Cornel, ich werde\n"
"Dir so lange nach-\n"
"stellen, bis Du Deine\n"
"gerechte Strafe\n"
"erlangst."
msgstr ""
"Ja, Cornel, jag\n"
"jagar dig\n"
"tills du får\n"
"ditt rättvisa\n"
"straff."

msgctxt "scene:29:9"
msgid ""
"Ha,Ha,..! Mir scheint\n"
"Du hast noch nicht\n"
"genug, trotz der zwei\n"
"Niederlagen, die Du\n"
"schon hattest..."
msgstr ""
"Ha, ha …! Du\n"
"har tydligen inte\n"
"fått nog trots de\n"
"två nederlag du redan\n"
"har lidit …"

msgctxt "scene:29:14"
msgid ""
"Jetzt werden wir ihm\n"
"seine letzte Lektion\n"
"erteilen, und die Sache\n"
"endgültig erledigen."
msgstr ""
"Nu ska vi ge\n"
"honom hans sista läxa\n"
"och göra slut på det\n"
"här en gång för alla."

msgctxt "scene:29:18"
msgid ""
"Ja, der wird sich\n"
"wundern."
msgstr ""
"Ja, han ska\n"
"bli förvånad."

msgctxt "scene:29:20"
msgid ""
"Du siehst Firehand,\n"
"meine Leute sind fest\n"
"entschlossen, und ich\n"
"werde auch nicht gehen,\n"
"bevor wir unsere Kasse\n"
"aufgebessert haben."
msgstr ""
"Du förstår, Firehand,\n"
"mina män är\n"
"fast beslutna. Jag\n"
"går inte heller\n"
"innan vi har\n"
"förbättrat vår kassa."

msgctxt "scene:29:26"
msgid ""
"Wir haben nicht vor,\n"
"Dir das geringste zu\n"
"geben. Mach, dass Du\n"
"wegkommst."
msgstr ""
"Vi tänker\n"
"inte ge\n"
"dig det\n"
"minsta. Försvinn."

msgctxt "scene:29:30"
msgid ""
"Ich gebe Euch noch\n"
"eine letzte Chance\n"
"aufzugeben. Wenn Ihr\n"
"Euch ergebt, dann\n"
"geschieht Euch nichts."
msgstr ""
"Jag ger er\n"
"en sista chans\n"
"att ge upp.\n"
"Om ni kapitulerar\n"
"händer er inget."

msgctxt "scene:29:35"
msgid ""
"Deine Versprechungen\n"
"sind nichts wert,\n"
"Cornel. Wir werden uns\n"
"zu wehren wissen."
msgstr ""
"Dina löften\n"
"är värdelösa,\n"
"Cornel. Vi kan\n"
"försvara oss."

msgctxt "scene:29:39"
msgid ""
"Was reden wir da noch\n"
"lange herum, lasst uns\n"
"die Farm stürmen.."
msgstr ""
"Varför pratar vi\n"
"så länge? Låt\n"
"oss storma gården."

msgctxt "scene:29:42"
msgid "Kawumm!"
msgstr "Pang!"

msgctxt "scene:29:43"
msgid ""
"Was war denn das? Ich\n"
"habe geglaubt die sind\n"
"nicht bewaffnet, und\n"
"nun schiessen die mit\n"
"Kanonen auf uns."
msgstr ""
"Vad var det? Jag\n"
"trodde att de inte\n"
"var beväpnade och nu\n"
"skjuter de med kanoner\n"
"på oss."

msgctxt "scene:29:48"
msgid ""
"Na, Ihr Schurken, soll\n"
"ich Euch noch eine\n"
"Kostprobe liefern oder\n"
"seid Ihr nun überzeugt,\n"
"dass es hier für Euch\n"
"nichts zu holen gibt?"
msgstr ""
"Nå, era skurkar, ska\n"
"jag ge er ett\n"
"smakprov till, eller är\n"
"ni övertygade om att det\n"
"inte finns något för\n"
"er att hämta här?"

msgctxt "scene:29:54"
msgid ""
"Damnet, hat uns dieser\n"
"Firehand wieder einen\n"
"Strich durch die Rech-\n"
"nung gemacht..."
msgstr ""
"Förbannat, Firehand\n"
"har förstört\n"
"våra planer\n"
"igen …"

msgctxt "scene:29:58"
msgid ""
"Also Männer, lasst uns\n"
"von hier verschwinden,\n"
"die haben uns ausge-\n"
"bootet, doch wir\n"
"werden uns am Silbersee\n"
"schadlos halten."
msgstr ""
"Kom igen, män, låt\n"
"oss försvinna härifrån. De\n"
"har lurat oss,\n"
"men vid Silverlake\n"
"ska vi hålla oss\n"
"skadeslösa."

msgctxt "scene:29:64"
msgid ""
"Wir gehen Firehand,\n"
"doch wir werden uns\n"
"wiedersehen, und\n"
"dann wird sich das\n"
"Blatt wenden."
msgstr ""
"Vi går,\n"
"Firehand, men\n"
"vi ses\n"
"igen. Då\n"
"vänder lyckan."

msgctxt "scene:29:69"
msgid ""
"Ich kann es kaum\n"
"erwarten Dich wieder\n"
"zu treffen, ich\n"
"werde dann dafür\n"
"sorgen, dass Du nie\n"
"mehr Schaden\n"
"anrichten wirst."
msgstr ""
"Jag kan knappt\n"
"vänta på att träffa\n"
"dig igen. Då\n"
"ska jag se\n"
"till att du aldrig\n"
"mer kan\n"
"ställa till skada."

msgctxt "scene:30:0"
msgid ""
"Ah, Mr.Firehand! Kann\n"
"ich ihnen noch irgend-\n"
"wie behilflich sein ?"
msgstr ""
"Ah, mr Firehand!\n"
"Kan jag hjälpa\n"
"er med något mer?"

msgctxt "scene:30:3"
msgid ""
"Nein, Ich glaube, ich\n"
"habe bereits alle\n"
"Probleme gelöst."
msgstr ""
"Nej, jag tror att\n"
"jag redan har\n"
"löst alla problem."

msgctxt "scene:30:6"
msgid ""
"Dann wird der Cornel\n"
"wohl böse Überraschung\n"
"erleben..."
msgstr ""
"Då får Cornel\n"
"nog en obehaglig\n"
"överraskning …"
