msgctxt "scene:18:9"
msgid ""
"Wenn ich richtig infor-\n"
"miert bin, wird dabei\n"
"für jeden von euch ein\n"
"nettes Sümmchen\n"
"herausspringen."
msgstr ""
"Om jag är\n"
"rätt underrättad får\n"
"var och en\n"
"av er\n"
"en nätt slant."

msgctxt "scene:18:14"
msgid ""
"Und was ist mit diesem\n"
"Old Firehand und der\n"
"verrückten Tante Droll?"
msgstr ""
"Och vad gör vi\n"
"med Old Firehand och\n"
"den tokiga tant Droll?"

msgctxt "scene:18:17"
msgid ""
"Macht euch über die\n"
"beiden keine Sorgen!\n"
"Bis die unser Lager\n"
"finden, sind wir schon\n"
"längst über alle Berge."
msgstr ""
"Oroa er inte\n"
"för dem! När\n"
"de hittar vårt\n"
"läger har vi för\n"
"länge sedan lämnat platsen."

msgctxt "scene:18:22"
msgid ""
"Und sollten sie uns\n"
"doch in die Quere kom-\n"
"men, werden wir mit den\n"
"zwei Anfängern doch\n"
"wohl spielend fertig,\n"
"oder?"
msgstr ""
"Och om de\n"
"ändå kommer i vår\n"
"väg blir vi väl\n"
"lätt klara med\n"
"de två nybörjarna,\n"
"eller?"

msgctxt "scene:18:28"
msgid ""
"Ich habe aber schon die\n"
"tollsten Geschichten\n"
"über die Tante Droll\n"
"und Old Firehand\n"
"gehört. Mit denen ist\n"
"nicht zu spassen!"
msgstr ""
"Men jag har hört\n"
"de mest fantastiska\n"
"historier om tant\n"
"Droll och Old\n"
"Firehand. Man ska inte\n"
"skoja med dem!"

msgctxt "scene:18:34"
msgid ""
"Jetzt zerbrecht euch\n"
"nicht meinen Kopf,\n"
"ihr Memmen! Passt lieber\n"
"auf, dass ihr mir den\n"
"Plan mit den Rafters\n"
"nicht versaut!"
msgstr ""
"Gör mig inte\n"
"huvudvärk, era ynkryggar!\n"
"Se hellre till\n"
"att ni inte\n"
"förstör min plan\n"
"med Rafters!"

msgctxt "scene:18:40"
msgid ""
"...ist doch eine ideale\n"
"Nacht für unsere Vor-\n"
"bereitungen zum..."
msgstr ""
"… är ju en\n"
"idealisk natt för våra\n"
"förberedelser inför …"

msgctxt "scene:18:43"
msgid ""
"Seht mal her, was ich\n"
"hier gefunden habe..."
msgstr ""
"Se vad jag\n"
"hittade här …"

msgctxt "scene:18:45"
msgid ""
"Na, wen haben wir denn\n"
"da? Die berühmte Tante\n"
"Droll!? Nun hat sich\n"
"das Blatt wohl gewen-\n"
"det, was?"
msgstr ""
"Nå, vem har vi\n"
"här? Den berömda tant\n"
"Droll!? Nu har\n"
"väl vinden vänt, eller\n"
"hur?"

msgctxt "scene:18:50"
msgid ""
"So trifft man Schurken\n"
"an Orten, wo man sie\n"
"am wenigsten erwartet\n"
"hätte."
msgstr ""
"Så här träffar man\n"
"skurkar på de ställen\n"
"där man minst väntar\n"
"sig det."

msgctxt "scene:18:54"
msgid ""
"Wo ist denn dein\n"
"Freund, dieser\n"
"Firehand!? Der muss\n"
"ja auch irgendwo in\n"
"der Gegend herum-\n"
"lungern."
msgstr ""
"Var är\n"
"din vän\n"
"Firehand!? Han\n"
"måste väl\n"
"också stryka\n"
"omkring någonstans."

msgctxt "scene:18:60"
msgid ""
"Ich habe keine Ahnung\n"
"wo der sein könnte, wir\n"
"haben uns nach eurer\n"
"Flucht getrennt..."
msgstr ""
"Jag har ingen aning\n"
"om var han kan\n"
"vara. Vi skildes åt\n"
"efter er flykt …"

msgctxt "scene:18:64"
msgid ""
"Das stimmt Cornel, ich\n"
"habe nur ihn beim lau-\n"
"schen erwischt."
msgstr ""
"Det stämmer, Cornel. Jag\n"
"kom bara på honom\n"
"när han tjuvlyssnade."

msgctxt "scene:18:67"
msgid ""
"Da hat dir wohl dein\n"
"Freund Firehand die\n"
"Freundschaft gekündigt,\n"
"nahdem ich dir ent-\n"
"kommen bin."
msgstr ""
"Firehand har visst\n"
"sagt upp vänskapen\n"
"med dig sedan\n"
"jag kom undan\n"
"dig."

msgctxt "scene:18:72"
msgid ""
"Los! Fesselt den Kerl\n"
"und dann werden wir\n"
"uns etwas Schlaf gön-\n"
"nen.\n"
"Um den werde ich mich\n"
"morgen selbst kümmern."
msgstr ""
"Fort! Bind fast karlen,\n"
"sedan ska vi\n"
"unna oss lite sömn.\n"
"I\n"
"morgon tar jag själv\n"
"hand om honom."

msgctxt "scene:18:78"
msgid "He! Wer schiesst da?"
msgstr "Hördu! Vem skjuter där?"

msgctxt "scene:18:79"
msgid ""
"Wir werden Ange-\n"
"griffen. Das sind\n"
"sicher die Rafters!"
msgstr ""
"Vi blir\n"
"anfallna. Det\n"
"är säkert Rafters!"

msgctxt "scene:18:82"
msgid ""
"Lasst uns zu deren\n"
"Lager gehen. Der\n"
"Überfall wird nicht\n"
"erst morgen durch-\n"
"geführt. Das erledi-\n"
"gen wir gleich!"
msgstr ""
"Låt oss gå\n"
"till deras\n"
"läger. Överfallet genomförs\n"
"inte först i\n"
"morgon. Vi gör\n"
"det genast!"

msgctxt "scene:18:88"
msgid ""
"Was ist denn hier los?\n"
"Wir haben Schüsse ge-\n"
"hört!"
msgstr ""
"Vad händer här?\n"
"Vi hörde\n"
"skott!"

msgctxt "scene:18:91"
msgid ""
"Hier lagerte eine\n"
"Gruppe von Tramps,\n"
"die diesem Herrn\n"
"hier nichts gutes\n"
"wollten. Ich habe\n"
"sie vertrieben."
msgstr ""
"Här låg en\n"
"grupp luffare som\n"
"inte ville den\n"
"här herrn något\n"
"gott. Jag drev\n"
"bort dem."

msgctxt "scene:18:97"
msgid ""
"Wenn das nicht der\n"
"berühmte Mr. Fire-\n"
"hand ist. Seien Sie\n"
"uns gegrüsst, wir\n"
"sind Rafter und la-\n"
"gern etwas Flussauf-\n"
"wärts."
msgstr ""
"Om det inte\n"
"är den berömde\n"
"mr Firehand. Var\n"
"hälsad. Vi är\n"
"Rafters och har\n"
"läger lite längre\n"
"uppströms."

msgctxt "scene:18:104"
msgid ""
"Freut mich, Sie zu\n"
"sehen, Gentlemans.\n"
"In der Tat, ich bin\n"
"Old Firehand und\n"
"diesen ehrenwerten\n"
"Herrn nennt man die\n"
"Tante Droll."
msgstr ""
"Trevligt att träffa\n"
"er, herrar. Jag\n"
"är faktiskt Old\n"
"Firehand. Den\n"
"här ärade herrn\n"
"kallas tant\n"
"Droll."

msgctxt "scene:18:111"
msgid ""
"Sie haben sie ver-\n"
"trieben? Womit denn?\n"
"Ein Mann kann doch\n"
"höchstens mit zwei\n"
"Gewehren schiessen\n"
"und das klang mir\n"
"nach einer ganzen\n"
"Kavalerieschwadron."
msgstr ""
"Ni drev bort\n"
"dem? Med vad\n"
"då? En man\n"
"kan ju högst\n"
"skjuta med två\n"
"gevär och för\n"
"mig lät det\n"
"som en hel kavalleriskvadron."

msgctxt "scene:18:119"
msgid ""
"Ich habe die Gauner\n"
"getäuscht. Die Ge-\n"
"wehrschüsse waren\n"
"nichts weiter als\n"
"harmlose Knall-\n"
"frösche. Doch die\n"
"Tramps sind auf den\n"
"Trick hereingefal-\n"
"len."
msgstr ""
"Jag lurade\n"
"skurkarna. Gevärsskotten\n"
"var bara\n"
"ofarliga smällare.\n"
"Men\n"
"luffarna\n"
"gick\n"
"på\n"
"tricket."

msgctxt "scene:18:128"
msgid ""
"Und mich hat der\n"
"Trick vor dem siche-\n"
"ren Tod gerettet."
msgstr ""
"Och tricket\n"
"räddade mig från\n"
"en säker död."

msgctxt "scene:18:131"
msgid ""
"Aber wenn Sie die\n"
"Schurken nur ver-\n"
"trieben haben, dann\n"
"ist ja unser Lager\n"
"in Gefahr. Wir müssen\n"
"schnell die Verfol-\n"
"gung aufnehmen."
msgstr ""
"Men om\n"
"ni bara\n"
"drev bort skurkarna\n"
"är vårt läger\n"
"i fara. Vi\n"
"måste snabbt ta\n"
"upp förföljelsen."

msgctxt "scene:18:138"
msgid ""
"Ich werde das Boot klar\n"
"machen, um die Verfol-\n"
"gung aufzunehmen..."
msgstr ""
"Jag gör i ordning\n"
"båten för att ta\n"
"upp förföljelsen …"

msgctxt "scene:18:141"
msgid "Halt! Wer da?"
msgstr "Stopp! Vem där?"

msgctxt "scene:18:142"
msgid ""
"Alarm!...Hands up oder\n"
"ich schiesse!"
msgstr ""
"Alarm! Upp med händerna,\n"
"annars skjuter jag!"

msgctxt "scene:18:144"
msgid ""
"Ah, sieh einer an, da\n"
"ist ja Old Firehand.\n"
"Na dir werden wir die\n"
"Flügel etwas stutzen."
msgstr ""
"Jaså, se vem som\n"
"är här: Old Firehand.\n"
"Nå, vi ska nog\n"
"tukta dig lite."

msgctxt "scene:18:148"
msgid ""
"Der Baum bildet ein\n"
"richtiges Blätterdach\n"
"über dem Lagerplatz.\n"
"Die Tramps haben sich\n"
"diesen Platz gut aus-\n"
"gesucht."
msgstr ""
"Trädet bildar\n"
"ett riktigt\n"
"lövtak över\n"
"lägerplatsen. Luffarna\n"
"har valt\n"
"platsen väl."

msgctxt "scene:18:154"
msgid ""
"An dieser Stelle ist\n"
"der Fluss ruhig und\n"
"ohne Stromschnellen."
msgstr ""
"Här är\n"
"floden lugn\n"
"och utan forsar."

msgctxt "scene:18:157"
msgid ""
"Der Baum bietet eine\n"
"Deckung zum Lagerfeuer\n"
"hin."
msgstr ""
"Trädet ger skydd\n"
"i riktning mot\n"
"lägerelden."

msgctxt "scene:18:160"
msgid ""
"Ein grosses Lagerfeuer,\n"
"die Tramps müssen sich\n"
"sehr sicher sein..."
msgstr ""
"En stor lägereld. Luffarna\n"
"måste känna sig\n"
"mycket säkra …"

msgctxt "scene:18:163"
msgid ""
"Hier liegt überall\n"
"Schwemmgut vom Fluss.\n"
"Ein grosser Ast..."
msgstr ""
"Här ligger flodens\n"
"drivgods överallt. En\n"
"stor gren …"

msgctxt "scene:18:166"
msgid ""
"Das niedere Gestrüpp\n"
"entlang des Ufers zeugt\n"
"davon, dass der Fluss\n"
"öfters über seine Ufer\n"
"tritt."
msgstr ""
"Det låga\n"
"snåret längs stranden\n"
"visar att floden\n"
"ofta svämmar\n"
"över."

msgctxt "scene:18:171"
msgid ""
"Ah, einige Büsche von der\n"
"Art, die bei der kleinsten\n"
"Berührung rascheln, so\n"
"hat man von der Seite des\n"
"Lagers eine natürliche Wache."
msgstr ""
"Ah, några buskar av\n"
"den sort som prasslar\n"
"vid minsta beröring.\n"
"Så har man en\n"
"naturlig vakt på lägrets sida."

msgctxt "scene:18:176"
msgid ""
"Felsen und grosse Steine\n"
"liegen hier überall herum.\n"
"Zum Teil sind sie schon\n"
"richtig vermoost..."
msgstr ""
"Klippor och stora\n"
"stenar ligger överallt.\n"
"Vissa är redan\n"
"riktigt mossiga …"

msgctxt "scene:18:180"
msgid ""
"Der Baum bildet mit\n"
"seinen Blättern ein\n"
"Dach über dem Lager.\n"
"Er wird den Morgentau\n"
"etwas abhalten."
msgstr ""
"Trädet bildar ett\n"
"tak över lägret\n"
"med sina löv.\n"
"Det håller undan en\n"
"del av morgondaggen."

msgctxt "scene:18:185"
msgid "Ich bin nicht durstig."
msgstr "Jag är inte törstig."

msgctxt "scene:18:186"
msgid ""
"Ich kann mit einem\n"
"Baum nicht sehr viel\n"
"anfangen. Abgesehen\n"
"davon, würde er mich\n"
"sicher etwas behin-\n"
"dern."
msgstr ""
"Jag har inte\n"
"mycket användning för\n"
"ett träd. Dessutom\n"
"skulle det säkert\n"
"vara lite i\n"
"vägen."

msgctxt "scene:18:192"
msgid ""
"Da könnte ich mir in\n"
"doppelter Hinsicht die\n"
"Finger verbrennen,\n"
"wenn ich jetzt ans\n"
"Feuer will."
msgstr ""
"Där kan jag\n"
"bränna fingrarna i dubbel\n"
"bemärkelse om jag\n"
"ger mig på\n"
"elden nu."

msgctxt "scene:18:197"
msgid ""
"An den komme ich\n"
"jetzt nicht heran."
msgstr ""
"Jag kommer inte\n"
"åt den just nu."

msgctxt "scene:18:199"
msgid ""
"Das Gestrüpp ist,\n"
"ausser zum ver-\n"
"brennen, zu nichts\n"
"zu gebrauchen."
msgstr ""
"Snåret är\n"
"inte användbart\n"
"till annat än\n"
"att bränna."

msgctxt "scene:18:203"
msgid ""
"Das Gestrüpp ist,\n"
"ausser zum ver-\n"
"brennen, zu nichts\n"
"zu gebrauchen."
msgstr ""
"Snåret är\n"
"inte användbart\n"
"till annat än\n"
"att bränna."

msgctxt "scene:18:207"
msgid "Die sind mir zu schwer"
msgstr "De är för tunga för mig"

msgctxt "scene:18:208"
msgid ""
"Der bestbekannte Schurke,\n"
"unser Cornel."
msgstr ""
"Den ökände skurken,\n"
"vår Cornel."

msgctxt "scene:18:210"
msgid "Raschel!"
msgstr "Prassel!"

msgctxt "scene:18:211"
msgid "Was war denn das?"
msgstr "Vad var det?"

msgctxt "scene:18:212"
msgid ""
"Hat wieder einer\n"
"feuchtes Holz ins\n"
"Feuer getan."
msgstr ""
"Har någon lagt\n"
"fuktigt trä på\n"
"elden igen."
