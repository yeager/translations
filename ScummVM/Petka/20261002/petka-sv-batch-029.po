#. p_1_0 msg_888, 0 - Петька
msgid "Макароны - еда итальянская."
msgstr "Pasta är italiensk."

#. p_1_0 msg_889, 0 - Петька
msgid "Употреблять с умом надо - класть в рот только вдоль!"
msgstr ""
"Man måste tänka på hur man äter det här. Kom ihåg att stoppa den korta änden"
" först i munnen!"

#. p_1_0 msg_890, 0 - Петька
msgid "Я вам не итальянец - макароны жрать!"
msgstr "Jag är ingen Mario som äter pasta!"

#. p_1_0 msg_891, 0 - Петька
msgid "Да и вообще, макароны - не мой стиль."
msgstr "Pasta är inte min stil."

#. p_1_0 msg_892, 0 - Петька
msgid "Мой стиль - вельветовые рубашки..."
msgstr "Vodka är ..."

#. p_1_0 msg_893, 0 - Петька
msgid "Дешевое и практичное средство передвижения."
msgstr "Ett billigt och praktiskt fordon."

#. p_1_0 msg_894, 0 - Петька
msgid "Когда я был маленьким, у меня был точно такой же."
msgstr "Jag hade en precis likadan när jag var liten."

#. p_1_0 msg_895, 1 - Василий Иванович
msgid "Брось, Петька, совсем в детство впал!"
msgstr "Kom igen, Petka. Du är inget barn längre!"

#. p_1_0 msg_896, 0 - Петька
msgid "Слыхал, в Петрограде слон из зоопарка вырвался..."
msgstr ""
"Jag hörde att en elefant rymde från en djurpark i Petrograd häromdagen ..."

#. p_1_0 msg_897, 0 - Петька
msgid "Говорят, полгорода передавил, пока из пушки его не убили."
msgstr "Den dödade många innan de sköt den från kryssaren Aurora!"

#. p_1_0 msg_898, 1 - Василий Иванович
msgid "Слоники нам не нужны..."
msgstr "Vi behöver inga elefanter ..."

#. p_1_0 msg_899, 1 - Василий Иванович
msgid "Это пусть вон, братья-пилоты орудуют!"
msgstr "Låt oss lämna den åt Pilotbröderna!"

#. p_1_0 msg_900, 0 - Петька
msgid "Наша страна без серпа и молота - как корова без молока!"
msgstr "Sovjetryssland utan hammaren och skäran är som en ko utan mjölk!"

#. p_1_0 msg_901, 0 - Петька
msgid "Так и порезаться недолго!..."
msgstr "Vi kan lätt skära oss på det här!..."

#. p_1_0 msg_906, 0 - Петька
msgid "Сначала ноги вытирать заставят."
msgstr "Först ber de dig rengöra stövlarna."

#. p_1_0 msg_907, 0 - Петька
msgid "А потом, глядишь, еще и руки мыть придется!"
msgstr "Sedan tvätta händerna!"

#. p_1_0 msg_908, 0 - Петька
msgid "Коврик очень пыльный, брать его в руки - негигиенично!"
msgstr "Vilken dammig trasa! Det vore ohygieniskt att ens röra vid den!"

#. p_1_0 msg_909, 0 - Петька
msgid "Кроме того, он нам нафиг не нужен..."
msgstr "Dessutom behöver vi den inte ändå ..."

#. p_1_0 msg_910, 0 - Петька
msgid "Копилка, конечно, симпатичная, но пустая."
msgstr "Fin liten spargris. Tom, tyvärr."

#. p_1_0 msg_912, 0 - Петька
msgid "Это дедушка Ленин."
msgstr "Det här är Lenin."

#. p_1_0 msg_913, 0 - Петька
msgid "Говорят, он очень любит детей..."
msgstr "De säger att han älskade barn ..."

#. p_1_0 msg_914, 0 - Петька
msgid "И красноармейцев..."
msgstr "Och rödarmister också ..."

#. p_1_0 msg_915, 0 - Петька
msgid "Интересно, а женщин он тоже любит?"
msgstr "Undrar om han älskade kvinnor?"

#. p_1_0 msg_916, 0 - Петька
msgid "У меня нет никакого желания брать в руки бюст нашего вождя!"
msgstr "Jag har ingen lust att ta vår ledares byst!"

#. p_1_0 msg_917, 0 - Петька
msgid "Знакомый плакатик..."
msgstr "Det här har jag sett förut ..."

#. p_1_0 msg_918, 0 - Петька
msgid "Вряд ли у меня получится отодрать плакат аккуратно."
msgstr "Jag tvivlar på att jag kan slita loss den utan att skada den."

#. p_1_0 msg_919, 0 - Петька
msgid "Пива нет!"
msgstr "Här finns inget öl!"

#. p_1_0 msg_920, 0 - Петька
msgid "Я же сказал - пива нет!"
msgstr "Jag sa ju – inget öl!"

#. p_1_0 msg_921, 0 - Петька
msgid "Хватит! Это игра не для алкоголиков."
msgstr "Nu räcker det! Det här är inget spel för alkoholister."

#. p_1_0 msg_922, 0 - Петька
msgid "А для извращенцев..."
msgstr "Det är ett spel för perversa ..."

#. p_1_0 msg_923, 0 - Петька
msgid "Было бы пиво, был бы и разговор!"
msgstr "Om det ändå fanns öl!"

#. p_1_0 msg_924, 0 - Петька
msgid "А вообще-то она ничего."
msgstr "Hon är vacker ... på sitt sätt."

#. p_1_0 msg_925, 0 - Петька
msgid "Женщина видная."
msgstr "Vilken kvinna ..."

#. p_1_0 msg_926, 0 - Петька
msgid "Взять продавщицу?"
msgstr "Ta kassörskan?"

#. p_1_0 msg_927, 0 - Петька
msgid "Она не в моем вкусе."
msgstr "Hon är inte min typ."

#. p_1_0 msg_928, 0 - Петька
msgid "Наш вам поклон, мудмуазеле. Славная нынче погодка!"
msgstr "God dag, unga dam. Fint väder, eller hur!"

#. p_1_0 msg_929, 0 - Петька
msgid "Нет ли чего для умственного развития?"
msgstr "Har du något som, öh ... stimulerar hjärnan?"

#. p_1_0 msg_930, 0 - Петька
msgid "Не отпустишь ли в кредит, хозяюшка?"
msgstr "Tar ni kredit, madame?"

#. p_1_0 msg_931, 0 - Петька
msgid "Попить не найдется?"
msgstr "Har ni något att dricka?"

#. p_1_0 msg_932, 0 - Петька
msgid "Прощайте, мудмуазеле!"
msgstr "Au revoir, mademoiselle!"

#. p_1_0 msg_933, 220 - Продавщица
msgid "Какое там, славная."
msgstr "Fint väder, pyttsan."

#. p_1_0 msg_934, 220 - Продавщица
msgid "Духотища вон какая стоит..."
msgstr "All den här kvävande hettan ..."

#. p_1_0 msg_935, 220 - Продавщица
msgid "Ой, а ты хоть грамотный?"
msgstr "Kan du ens läsa?"

#. p_1_0 msg_936, 0 - Петька
msgid "Знамо дело."
msgstr "Visst kan jag."

#. p_1_0 msg_937, 0 - Петька
msgid "У нас в отряде неграмотным делать нечего."
msgstr "Det finns inga analfabeter i vår grupp."

#. p_1_0 msg_938, 220 - Продавщица
msgid "Есть... классики марксизма-ленинизма."
msgstr "Tja, vi har lite klassiker inom marxismen-leninismen ..."

#. p_1_0 msg_939, 0 - Петька
msgid "О-о-о, это для меня самый раз."
msgstr "Åh, det är precis vad jag behöver."

#. p_1_0 msg_940, 220 - Продавщица
msgid "На, может поумнеешь!"
msgstr "Varsågod, det gör dig gott!"

#. p_1_0 msg_941, 220 - Продавщица
msgid "Какой там кредит!"
msgstr "Kredit, pyttsan!"

#. p_1_0 msg_942, 220 - Продавщица
msgid "Твой кредит уж вышел давно!"
msgstr "Din kredit är sedan länge slut!"
