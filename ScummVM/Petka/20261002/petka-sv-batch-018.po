#. p_1_0 msg_270, 0 - Петька
msgid "Я в трубу не полезу."
msgstr "Jag går inte in i skorstenen."

#. p_1_0 msg_271, 0 - Петька
msgid "Не хватало еще там застрять!"
msgstr "Jag vill inte fastna där inne!"

#. p_1_0 msg_272, 0 - Петька
msgid ""
"Если дыма из трубы нет, значит, сейчас там никто париться не собирается..."
msgstr ""
"Om det inte kommer någon rök ur skorstenen betyder det att ingen vill bada "
"bastu där nu."

#. p_1_0 msg_273, 1 - Василий Иванович
msgid "Чего мне по крышам лазить?"
msgstr "Varför skulle jag vilja gå på tak?"

#. p_1_0 msg_274, 1 - Василий Иванович
msgid "Мне, Петька, на крыше делать нечего."
msgstr "Jag har inget att göra på taket, Petka."

#. p_1_0 msg_275, 0 - Петька
msgid "Зачем?"
msgstr "Varför?"

#. p_1_0 msg_276, 0 - Петька
msgid "Нет дыма без огня."
msgstr "Ingen rök utan eld."

#. p_1_0 msg_277, 0 - Петька
msgid "А если дым есть, значит кто-то собрался попариться..."
msgstr "Och om det finns rök har någon bestämt sig för att bada bastu."

#. p_1_0 msg_278, 0 - Петька
msgid "Например, я с Анкой!"
msgstr "Som jag med Anka!"

#. p_1_0 msg_281, 0 - Петька
msgid "Заперто!!!"
msgstr "LÅST!!!"

#. p_1_0 msg_282, 0 - Петька
msgid "Это дверь в баню."
msgstr "Det här är bastudörren."

#. p_1_0 msg_283, 0 - Петька
msgid ""
"Деревенские ребятишки иногда развлекаются, подглядывая за раздевающимися в "
"замочную скважину."
msgstr ""
"Bykillarna roar sig med att kika på de nakna flickorna genom nyckelhålet."

#. p_1_0 msg_284, 0 - Петька
msgid "Но мы-то с Василь Иванычем уже взрослые люди."
msgstr "Men Vasilij Ivanovitj och jag är vuxna karlar."

#. p_1_0 msg_285, 0 - Петька
msgid "Нам это совершенно ни к чему..."
msgstr "Det intresserar oss inte alls ..."

#. p_1_0 msg_286, 1 - Василий Иванович
msgid "А чего я там не видел?"
msgstr "Vad var det jag inte har sett där?"

#. p_1_0 msg_287, 0 - Петька
msgid "Рубить топором эту дверь мне совершенно не хочется."
msgstr "Jag har ingen lust att slå sönder den här dörren med en yxa."

#. p_1_0 msg_288, 0 - Петька
msgid ""
"Во-первых, если на мой стук ее резко откроют изнутри, то я могу нечаянно "
"зарубить человека..."
msgstr ""
"Tänk om någon plötsligt öppnar dörren? Jag hugger honom i småbitar ..."

#. p_1_0 msg_289, 0 - Петька
msgid "Это будет очень плохо!"
msgstr "Det vore illa!"

#. p_1_0 msg_290, 0 - Петька
msgid "Для него..."
msgstr "För dem ..."

#. p_1_0 msg_291, 0 - Петька
msgid "Во-вторых, я могу его и не зарубить..."
msgstr "Och om jag inte hugger honom i småbitar???"

#. p_1_0 msg_292, 0 - Петька
msgid "А, например, только слегка задеть..."
msgstr "Bara river honom ..."

#. p_1_0 msg_293, 0 - Петька
msgid "И это будет..."
msgstr "Det vore ..."

#. p_1_0 msg_294, 0 - Петька
msgid "СОВЕРШЕННО УЖАСНО!"
msgstr "FRUKTANSVÄRT!"

#. p_1_0 msg_295, 0 - Петька
msgid "Для меня..."
msgstr "För mig ..."

#. p_1_0 msg_296, 0 - Петька
msgid "Как вы хотите, чтобы я использовал замочную скважину?"
msgstr "Hur vill du att jag ska använda nyckelhålet?"

#. p_1_0 msg_297, 0 - Петька
msgid "Поковырял?.."
msgstr "Pilla med det? ..."

#. p_1_0 msg_298, 0 - Петька
msgid "Потер?.."
msgstr "Gnugga det? ..."

#. p_1_0 msg_299, 0 - Петька
msgid "Понюхал?.."
msgstr "Lukta på det? ..."

#. p_1_0 msg_300, 0 - Петька
msgid "Полизал?.."
msgstr "Slicka på det? ..."

#. p_1_0 msg_301, 0 - Петька
msgid "КАК-КАК???"
msgstr "HUR? HUR???"

#. p_1_0 msg_302, 0 - Петька
msgid "Ну уж нет!"
msgstr "Aldrig i livet!"

#. p_1_0 msg_303, 0 - Петька
msgid "Да за кого вы меня принимаете?!!"
msgstr "Vem tror du att jag är?!"

#. p_1_0 msg_304, 0 - Петька
msgid "Какой-такой Ларри?"
msgstr "Någon sorts Larry?"

#. p_1_0 msg_305, 0 - Петька
msgid "Я вам не Ларри!"
msgstr "Jag är ingen Larry!"

#. p_1_0 msg_306, 0 - Петька
msgid "И игра эта называется не \"Ларри\"!!!"
msgstr "Och det här spelet heter inte \"Larry\"!!!"

#. p_1_0 msg_307, 0 - Петька
msgid "Эта игра называется..."
msgstr "Det här spelet heter ..."

#. p_1_0 msg_308, 0 - Петька
msgid "Называется..."
msgstr "Heter ..."

#. p_1_0 msg_309, 0 - Петька
msgid "Тьфу, ты..."
msgstr "Usch, du ..."

#. p_1_0 msg_310, 0 - Петька
msgid "Из-за вас забыл, как она называется..."
msgstr "På grund av dig glömde jag vad spelet heter ..."

#. p_1_0 msg_311, 0 - Петька
msgid "Ну так и быть, если только разочек..."
msgstr "Nåväl, bara den här gången ..."

#. p_1_0 msg_313, 0 - Петька
msgid "Ключ тут не поможет - дверь заперта изнутри на засов."
msgstr "Nyckeln hjälper inte här – det är låst från insidan."

#. p_1_0 msg_314, 0 - Петька
msgid "Идея неплохая, но..."
msgstr "Bra idé, men ..."

#. p_1_0 msg_315, 0 - Петька
msgid "Замочная скважина слишком мала для пистолета."
msgstr ""
"Nyckelhålet är alldeles för litet för att jag ska kunna sticka in min pistol"
" i det."

#. p_1_0 msg_317, 0 - Петька
msgid "Может быть, лучше сначала его зарядить? Хотя..."
msgstr "Om jag laddar den först? Tja ..."

#. p_1_0 msg_318, 0 - Петька
msgid "Выбить топором этот замок не получится."
msgstr "Jag kan inte slå sönder låset med en yxa."

#. p_1_0 msg_319, 0 - Петька
msgid "К тому же, напоминаю, что дверь заперта изнутри на засов."
msgstr "Dessutom är dörren låst från insidan."

#. p_1_0 msg_320, 0 - Петька
msgid "Пустой шприц идеально проходит в замочную скважину!"
msgstr "Ja! En tom spruta passar perfekt i låset!"

#. p_1_0 msg_321, 0 - Петька
msgid "Ну и что дальше?"
msgstr "Och nu då?"

#. p_1_0 msg_322, 0 - Петька
msgid "Ай да Петька!"
msgstr "Petka!"

#. p_1_0 msg_323, 0 - Петька
msgid "Ай да с-"
msgstr "Din lycklige jävel ..."
