#. p_1_0 msg_943, 0 - Петька
msgid "Ну дай хоть хлебушка батончик..."
msgstr "Kan du ge mig bara en limpa bröd? ..."

#. p_1_0 msg_944, 0 - Петька
msgid "Ну дай хоть папиросок фирменных попробовать."
msgstr "Kan du åtminstone ge mig några speciella trubbiga föremål att prova?"

#. p_1_0 msg_945, 0 - Петька
msgid "Ну дай хоть серп. Пойду пшенички накошу..."
msgstr "Tja, ge mig en skära då, så går jag och skördar lite vete ..."

#. p_1_0 msg_946, 0 - Петька
msgid "Ну дай хоть пальму. Кокосы пойду выращивать..."
msgstr "Tja, ge mig palmen då. Jag ska odla lite kokosnötter ..."

#. p_1_0 msg_947, 220 - Продавщица
msgid "Да таким батоном только сваи заколачивать!"
msgstr "Du kan slå i spik med den här limpan!"

#. p_1_0 msg_948, 220 - Продавщица
msgid "И не проси!"
msgstr "Fråga inte ens!"

#. p_1_0 msg_949, 220 - Продавщица
msgid "Папиросы заморские, трофейные."
msgstr "De kommer från utlandet, det är troféer."

#. p_1_0 msg_950, 220 - Продавщица
msgid "Для красоты стоят."
msgstr "De finns här för syns skull."

#. p_1_0 msg_951, 220 - Продавщица
msgid "А выдавать никому не велено."
msgstr "Det är förbjudet att dela ut dem."

#. p_1_0 msg_952, 220 - Продавщица
msgid "Серп у нас только вместе с молотом продается."
msgstr "Skäran hör bara ihop med hammaren."

#. p_1_0 msg_953, 220 - Продавщица
msgid "По отдельности никак."
msgstr "Båda eller ingen."

#. p_1_0 msg_954, 220 - Продавщица
msgid "Пальму-то я Вам, конечно, не дам..."
msgstr "Jag kan förstås inte ge dig palmen ..."

#. p_1_0 msg_955, 220 - Продавщица
msgid "А вот семян дать могу."
msgstr "Men jag kan ge dig fröna."

#. p_1_0 msg_956, 220 - Продавщица
msgid "Сажать-то знаешь как?"
msgstr "Vet du hur man planterar dem?"

#. p_1_0 msg_957, 0 - Петька
msgid "А чего там знать-то?"
msgstr "Vad är problemet?"

#. p_1_0 msg_958, 0 - Петька
msgid "В землю бросил, и всех делов..."
msgstr "Kasta den i jorden, så är det klart ..."

#. p_1_0 msg_959, 220 - Продавщица
msgid "Ну-ну... Тогда жди рекордного урожая."
msgstr "Javisst ... Du får en rekordskörd."

#. p_1_0 msg_960, 220 - Продавщица
msgid "Агроном!"
msgstr "Lantbrukare!"

#. p_1_0 msg_961, 220 - Продавщица
msgid "Ох уж мне этот Фурманов со своей наглядной агитацией!"
msgstr "Ibland vill jag döda Furmanov för hans kala propaganda!"

#. p_1_0 msg_962, 220 - Продавщица
msgid "Попить у нас теперь только по талонам."
msgstr "Nu serverar vi alla drycker endast mot kuponger."

#. p_1_0 msg_963, 220 - Продавщица
msgid "Сам Фурманов приказал."
msgstr "Furmanovs order!"

#. p_1_0 msg_964, 220 - Продавщица
msgid "Приходят всякие... Бойцы новоявленные..."
msgstr "Titta på dem ... Armémän, pyttsan ..."

#. p_1_0 msg_965, 220 - Продавщица
msgid "И все пить требуют!"
msgstr "Och varenda en av dem ber om något att dricka!"

#. p_1_0 msg_966, 220 - Продавщица
msgid "То-ли спирт, то-ли спрут, то-ли спрайт какой-то..."
msgstr "Och de frågar alla efter ... vad var det? Sproot? Sprat? Sprite!"

#. p_1_0 msg_967, 220 - Продавщица
msgid "Талон мне давайте - будет вам попить!"
msgstr "Ge mig en kupong så hittar jag något att dricka åt dig!"

#. p_1_0 msg_968, 220 - Продавщица
msgid "А раз нету талона - нечего и разговаривать!"
msgstr "Ingen kupong – inga drycker!"

#. p_1_0 msg_969, 1 - Василий Иванович
msgid "Да, агрегат солидный."
msgstr "Det här är vad jag kallar en apparat!"

#. p_1_0 msg_970, 0 - Петька
msgid "И денег там внутри небось вагон!"
msgstr "Det måste finnas mycket pengar i den!"

#. p_1_0 msg_971, 1 - Василий Иванович
msgid "Рублей тыщу, наверное!"
msgstr "Tusen rubel!"

#. p_1_0 msg_972, 0 - Петька
msgid "Ну или хотя бы сто..."
msgstr "Eller kanske till och med hundra ..."

#. p_1_0 msg_973, 1 - Василий Иванович
msgid "Уж рублей пять-то - наверняка..."
msgstr "Tja, åtminstone fem rubel ..."

#. p_1_0 msg_974, 0 - Петька
msgid "Василий Иванович, у вас случайно с собой женского чулка нет?"
msgstr "Har du några strumpor, möjligen, Vasilij Ivanovitj?"

#. p_1_0 msg_975, 1 - Василий Иванович
msgid "Нет."
msgstr "Nej."

#. p_1_0 msg_976, 1 - Василий Иванович
msgid "А зачем тебе?"
msgstr "Varför frågar du?"

#. p_1_0 msg_977, 1 - Василий Иванович
msgid "Ты что, извращенец?"
msgstr "Är du någon sorts pervers?"

#. p_1_0 msg_978, 0 - Петька
msgid "Да нет, просто надо кассу по-быстрому взять..."
msgstr "Nej, nej. Jag behöver bara råna lite ..."

#. p_1_0 msg_979, 1 - Василий Иванович
msgid "Взять кассу?.."
msgstr "Med strumpor på dig?"

#. p_1_0 msg_980, 1 - Василий Иванович
msgid "В чулках?.."
msgstr "Är du galen?"

#. p_1_0 msg_981, 1 - Василий Иванович
msgid "Красиво!"
msgstr "Underbara!"

#. p_1_0 msg_982, 0 - Петька
msgid "Точно такой же купальник я подарил Анке."
msgstr "Precis som de jag gav Anka i present."

#. p_1_0 msg_983, 0 - Петька
msgid "Только она им почему-то совсем не пользуется..."
msgstr "Hon har dem nästan aldrig på sig, av någon anledning ..."

#. p_1_0 msg_984, 0 - Петька
msgid "Может он ей не нравится?"
msgstr "Undrar varför?"

#. p_1_0 msg_985, 0 - Петька
msgid "Правда, она вообще никаким купальником не пользуется..."
msgstr "Naturligtvis använder hon vanligtvis ingen baddräkt alls ..."

#. p_1_0 msg_986, 1 - Василий Иванович
msgid "И правильно!"
msgstr "Just det!"

#. p_1_0 msg_987, 1 - Василий Иванович
msgid "Зачем бойцу красной армии купальник?"
msgstr "Varför skulle en rödarmist, även en kvinna, behöva en baddräkt?"

#. p_1_0 msg_988, 1 - Василий Иванович
msgid "Я, например, никогда купальником не пользуюсь!"
msgstr "Du skulle till exempel aldrig få se mig i en!"

#. p_1_0 msg_989, 0 - Петька
msgid "Ну уж если купальник Анке не пригодился, то мне он и подавно не нужен!"
msgstr "Om inte Anka gör det, varför skulle jag?"

#. p_1_0 msg_990, 1 - Василий Иванович
msgid "Логично!"
msgstr "Det är ju sex!"

#. p_1_0 msg_991, 0 - Петька
msgid "Вы, наверное, хотели сказать \"АНАЛОГИЧНО\", Василий Иванович?"
msgstr "Öh, menade du \"logiskt\", Vasilij Ivanovitj?"

#. p_1_0 msg_992, 1 - Василий Иванович
msgid "Что хотел, то и сказал..."
msgstr "Jag sa precis vad jag menade!"
