#. p_1_0 msg_213, 0 - Петька
msgid "Дюже сундук крепкий..."
msgstr "Kistan är för stadig..."

#. p_1_0 msg_214, 0 - Петька
msgid "Больше внутри ничего интересного не оказалось."
msgstr "Inget intressant där inne."

#. p_1_0 msg_215, 0 - Петька
msgid "Разный хлам..."
msgstr "Bara skräp..."

#. p_1_0 msg_216, 0 - Петька
msgid "Какие-то старые карты..."
msgstr "Några gamla kartor..."

#. p_1_0 msg_217, 0 - Петька
msgid "Да и то, не полная колода!"
msgstr "Och den här ... kortleken är inte ens komplett!"

#. p_1_0 msg_219, 0 - Петька
msgid "Не надо бросать что попало в сундук."
msgstr "Släng inte vad som helst där."

#. p_1_0 msg_220, 0 - Петька
msgid "Табуретка - оружие пролетариата."
msgstr "En pall: proletariatets vapen."

#. p_1_0 msg_221, 0 - Петька
msgid "Пригодна в ближнем бою..."
msgstr "Lämplig för närstrid..."

#. p_1_0 msg_222, 0 - Петька
msgid "Да и при дальнем обстреле сгодится."
msgstr "Även användbar för angrepp på avstånd."

#. p_1_0 msg_223, 0 - Петька
msgid "Что мы, капиталисты - с собой кресла носить?"
msgstr "Vad är vi, kapitalister, som släpar runt på våra stolar?"

#. p_1_0 msg_224, 0 - Петька
msgid "Посидим на дорожку?"
msgstr "Låt oss sätta oss en stund före resan, va?"

#. p_1_0 msg_225, 1 - Василий Иванович
msgid "Раньше сядешь, раньше выйдешь."
msgstr "Ju tidigare du sätter dig, desto tidigare åker du."

#. p_1_0 msg_232, 0 - Петька
msgid "Василь Иваныч, чайник."
msgstr "Vasilij Ivanovitj, en vattenkokare."

#. p_1_0 msg_233, 1 - Василий Иванович
msgid "Сам ты \"чайник\", Петька, сейчас по башке получишь!"
msgstr "Vadå \"kreatur\", Petka? Vi har inga kreatur."

#. p_1_0 msg_234, 0 - Петька
msgid "Да это я не про вас, вон же чайник в печке стоит."
msgstr "Jag menar inte boskap – jag menar vattenkokaren där i spisen."

#. p_1_0 msg_235, 1 - Василий Иванович
msgid "Смотри у меня, Петька, на этот раз прощаю."
msgstr "Jaja, Petka, jag fattar redan."

#. p_1_0 msg_236, 0 - Петька
msgid "Так чайник не заваришь."
msgstr "Så får man inte en vattenkokare att koka."

#. p_1_0 msg_237, 0 - Петька
msgid "Этот чайник вообще никак не заваришь."
msgstr "Det går inte att koka den här vattenkokaren."

#. p_1_0 msg_238, 1 - Василий Иванович
msgid "Кипяточку, что ль, глотнуть?"
msgstr "Vill du ha kokhett vatten, va?"

#. p_1_0 msg_239, 0 - Петька
msgid "Нет тут кипяточку."
msgstr "Vi har inget kokhett vatten."

#. p_1_0 msg_240, 0 - Петька
msgid "Да и вообще водички нет."
msgstr "Vi har inget vatten alls."

#. p_1_0 msg_241, 0 - Петька
msgid "Ой, сироты мы!!!"
msgstr "Stackars, stackars oss!!!"

#. p_1_0 msg_242, 0 - Петька
msgid "Ну и чего мы ждем?"
msgstr "Vad väntar vi på?"

#. p_1_0 msg_243, 0 - Петька
msgid "Старика Хоттабыча?"
msgstr "En ande ur en lampa?"

#. p_1_0 msg_244, 0 - Петька
msgid "Или Алладина?"
msgstr "Eller vad?"

#. p_1_0 msg_245, 0 - Петька
msgid "Нечего дурью маяться, надо знамя искать."
msgstr "Sluta fjanta dig, vi måste hitta vår fana!"

#. p_1_0 msg_246, 0 - Петька
msgid "Старая, ржавая, сломанная, никчемная и никому не нужная лампа."
msgstr "Gammal, rostig, trasig – en helt oanvändbar lampa."

#. p_1_0 msg_247, 0 - Петька
msgid "Я же сказал..."
msgstr "Jag sa ju det..."

#. p_1_0 msg_248, 0 - Петька
msgid "Это старая. Ржавая. Сломанная. Никчемная!"
msgstr "Den är gammal. Rostig. Trasig!"

#. p_1_0 msg_249, 0 - Петька
msgid "И НИКОМУ НЕ НУЖНАЯ лампа..."
msgstr "OCH DET ÄR EN HELT OANVÄNDBAR lampa..."

#. p_1_0 msg_250, 0 - Петька
msgid "СПРАШИВАЕТСЯ -"
msgstr "SÅ JAG FRÅGAR:"

#. p_1_0 msg_251, 0 - Петька
msgid "Нам-то она НАФИГ НУЖНА?"
msgstr "Vad i hela friden BEHÖVER vi den TILL?"

#. p_1_0 msg_252, 1 - Василий Иванович
msgid "Меня, боевого командира, как какого-то там джинна в лампу посадить?"
msgstr "Jag, en militär befälhavare, instängd i en lampa som en ande?"

#. p_1_0 msg_253, 1 - Василий Иванович
msgid "Не выйдет!"
msgstr "Aldrig i livet!"

#. p_1_0 msg_254, 1 - Василий Иванович
msgid "В этой баньке очень было бы неплохо попариться!"
msgstr "Jag önskar att vi kunde bada bastu lite!"

#. p_1_0 msg_255, 0 - Петька
msgid "Особенно с Анкой!"
msgstr "Särskilt med Anka!"

#. p_1_0 msg_256, 0 - Петька
msgid "Да, Василь Иваныч?"
msgstr "Visst, Vasilij Ivanovitj?"

#. p_1_0 msg_257, 1 - Василий Иванович
msgid "Ну, это смотря по обстоятельствам..."
msgstr "Det beror på omständigheterna..."

#. p_1_0 msg_258, 1 - Василий Иванович
msgid "И почему, собственно, только с Анкой?"
msgstr "Och varför bara med Anka?"

#. p_1_0 msg_259, 1 - Василий Иванович
msgid "Неохота в одиночку париться."
msgstr "Jag vill inte bada bastu ensam."

#. p_1_0 msg_260, 1 - Василий Иванович
msgid "Как думаешь, Петька, кому это грозит вождь мировой революции?"
msgstr ""
"Petka, vem tror du att världrevolutionens ledare viftar med fingret åt?"

#. p_1_0 msg_261, 0 - Петька
msgid "Не знаю, Василий Иванович... Кому?"
msgstr "Vet inte, Vasilij Ivanovitj ... Vem då?"

#. p_1_0 msg_262, 1 - Василий Иванович
msgid "Белякам проклятым!"
msgstr "Åt de förbannade vita!"

#. p_1_0 msg_263, 0 - Петька
msgid "А почему же он тогда улыбается?"
msgstr "Varför ler han då?"

#. p_1_0 msg_264, 1 - Василий Иванович
msgid "Утомил ты, Петр,  меня своими вопросами!"
msgstr "Nu räcker det med dina frågor, Petka!"

#. p_1_0 msg_265, 1 - Василий Иванович
msgid "Не время сейчас..."
msgstr "Det är inte läge..."

#. p_1_0 msg_266, 1 - Василий Иванович
msgid "Пол-литформацию здесь выстраивать..."
msgstr "Att prata om politik..."

#. p_1_0 msg_267, 1 - Василий Иванович
msgid "Не дело это - плакаты со стен сдирать!"
msgstr "Det är inte vår uppgift att riva ned affischer från väggarna!"

#. p_1_0 msg_268, 0 - Петька
msgid "Мы же не хулиганы."
msgstr "Vi är inga ligister."

#. p_1_0 msg_269, 1 - Василий Иванович
msgid "Нечего тут, Петька, моими руками анархию творить!"
msgstr "Försök inte använda mig för att genomdriva anarki!"
