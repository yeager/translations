#. p_1_0 msg_10, 0 - Петька
msgid "Раз..."
msgstr "Uno ..."

#. p_1_0 msg_11, 0 - Петька
msgid "Раз. Раз. Раз, два, три!"
msgstr "Uno, dos, tres!"

#. p_1_0 msg_12, 0 - Петька
msgid "Проверка!"
msgstr "Mikrofontest!"

#. p_1_0 msg_13, 0 - Петька
msgid "А я еще и петь умею..."
msgstr "Jag kan sjunga också ..."

#. p_1_0 msg_14, 0 - Петька
msgid "Щас спою!"
msgstr "Titta på mig!"

#. p_1_0 msg_15, 0 - Петька
msgid "Ахе-м... Кхе-кхе..."
msgstr "Ahe-m ... *harklar sig*"

#. p_1_0 msg_16, 0 - Петька
msgid "Что-то я сегодня не в голосе..."
msgstr "Jag har ingen röst i dag ..."

#. p_1_0 msg_17, 0 - Петька
msgid "Ну ладно. Как нибудь в другой раз."
msgstr "Äsch, då. En annan gång."

#. p_1_0 msg_19, 0 - Петька
msgid "Что-оо?"
msgstr "Vaaad?"

#. p_1_0 msg_20, 1 - Василий Иванович
msgid "Да за такие шуточки можно и по зубам..."
msgstr "Sådana skämt kan kosta dig tänder ..."

#. p_1_0 msg_21, 0 - Петька
msgid "Не стоит сердить легендарного командира!"
msgstr "Bråka inte med den legendariske befälhavaren!"

#. p_1_0 msg_22, 0 - Петька
msgid "Даже если это всего-навсего Чапаев..."
msgstr "Även om det bara är Tjapajev ..."

#. p_1_0 msg_23, 0 - Петька
msgid "Это Чапаев!"
msgstr "Det är Tjapajev!"

#. p_1_0 msg_24, 0 - Петька
msgid "Мой командир..."
msgstr "Min befälhavare ..."

#. p_1_0 msg_25, 0 - Петька
msgid "Мой лучший друг и товарищ..."
msgstr "Min bästa vän och kamrat ..."

#. p_1_0 msg_26, 0 - Петька
msgid "Мой сэнсей..."
msgstr "Min sensei ..."

#. p_1_0 msg_27, 0 - Петька
msgid "Мой кумир..."
msgstr "Min hjälte ..."

#. p_1_0 msg_28, 0 - Петька
msgid "Мой идол..."
msgstr "Min idol ..."

#. p_1_0 msg_29, 0 - Петька
msgid "Мой Чапай..."
msgstr "Min Tjapaj ..."

#. p_1_0 msg_30, 0 - Петька
msgid "Мой... Мой..."
msgstr "Min ... min ..."

#. p_1_0 msg_31, 0 - Петька
msgid "Мойдодыр!!!"
msgstr "Minkomhitälskling!!!"

#. p_1_0 msg_32, 0 - Петька
msgid "Много раз белые пытались взять Василия Ивановича..."
msgstr "De vita försökte fånga Vasilij Ivanovitj ..."

#. p_1_0 msg_33, 1 - Василий Иванович
msgid "Чего тебе, Петька?"
msgstr "Vad är det, Petka?"

#. p_1_0 msg_34, 1 - Василий Иванович
msgid "Ну?.."
msgstr "Nå? ..."

#. p_1_0 msg_35, 1 - Василий Иванович
msgid "Да?.."
msgstr "Ja? ..."

#. p_1_0 msg_36, 1 - Василий Иванович
msgid "Что ты хотел спросить?"
msgstr "Vad var det du ville fråga?"

#. p_1_0 msg_37, 1 - Василий Иванович
msgid "Не до разговоров сейчас."
msgstr "Jag känner inte för att prata."

#. p_1_0 msg_38, 1 - Василий Иванович
msgid "Отстань!"
msgstr "Låt mig vara!"

#. p_1_0 msg_39, 1 - Василий Иванович
msgid "Хватит базарить... Надо знамя из кичи вынимать!"
msgstr "Nog med prat ... Vi måste få fanan att vaja!"

#. p_1_0 msg_40, 1 - Василий Иванович
msgid "Зачем это мне?"
msgstr "Vad är det här?"

#. p_1_0 msg_41, 1 - Василий Иванович
msgid "Оставь себе, Петр."
msgstr "Ta den, Petka."

#. p_1_0 msg_42, 1 - Василий Иванович
msgid "У меня все есть..."
msgstr "Jag har allt jag behöver."

#. p_1_0 msg_43, 1 - Василий Иванович
msgid "Мне ничего от тебя не нужно..."
msgstr "Jag behöver inget från dig ..."

#. p_1_0 msg_44, 1 - Василий Иванович
msgid "А будет нужно - сам возьму!"
msgstr "Om jag behöver något tar jag det själv!"

#. p_1_0 msg_45, 0 - Петька
msgid "Здесь плавает рыбка."
msgstr "Jag ser en fisk."

#. p_1_0 msg_46, 0 - Петька
msgid "Ее зовут Килька."
msgstr "Den kallas skarpsill."

#. p_1_0 msg_47, 0 - Петька
msgid "Вырастет - будет акула."
msgstr "När den växer upp blir den en haj."

#. p_1_0 msg_48, 0 - Петька
msgid "Будем беляками кормить."
msgstr "Vi matar den med vita soldater."

#. p_1_0 msg_49, 0 - Петька
msgid "Пока не кончатся..."
msgstr "Tills de tar slut ..."

#. p_1_0 msg_50, 0 - Петька
msgid "Ой, что это там на дне блестит?"
msgstr "Vad glänser där på botten?"

#. p_1_0 msg_51, 0 - Петька
msgid "Похоже на ключик..."
msgstr "Ser ut som en nyckel ..."

#. p_1_0 msg_52, 0 - Петька
msgid "Как же я его оттуда достану?"
msgstr "Hur skulle jag kunna nå den?"

#. p_1_0 msg_53, 0 - Петька
msgid "Молчит, как рыба."
msgstr "Tyst som en fisk."

#. p_1_0 msg_54, 0 - Петька
msgid "Хватит бросать что-попало в аквариум."
msgstr "Kasta inte vad som helst i akvariet."

#. p_1_0 msg_55, 1 - Василий Иванович
msgid "Я выпил бы, да для желудка говорят вредно."
msgstr "Jag skulle ta en drink, men de säger att det är dåligt för magen."

#. p_1_0 msg_56, 0 - Петька
msgid "Для ключа нужно подобрать подходящий замок."
msgstr "Vi borde hitta ett lås till just den här nyckeln."

#. p_1_0 msg_57, 0 - Петька
msgid "Я его от Василь Иваныча вчера спрятал."
msgstr "Jag gömde den för Vasilij Ivanovitj i går."

#. p_1_0 msg_58, 0 - Петька
msgid "Он от сундука, где деньги лежат."
msgstr "Den hör till kistan full av pengar."

#. p_1_0 msg_59, 0 - Петька
msgid "Надо бы его взять и поближе разглядеть."
msgstr "Vi borde titta närmare på den."

#. p_1_0 msg_60, 0 - Петька
msgid "Убей, не помню, что это за штука."
msgstr "Fan också, jag har glömt vad den heter."
