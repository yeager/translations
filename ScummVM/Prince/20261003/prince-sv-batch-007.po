#: dialog0020.txt:100703
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Niewinny jak kwiat lilijki, o panie.#E7#B2"
msgstr "ANNAN: Jag är lika ren som en lilja, ers nåd.#E7#B2"

#: dialog0020.txt:100801
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Och, ktoś próbował wyciągnąć sakiewkę|jednemu z kupców, a ten złapał "
"go|za rękę."
msgstr ""
"ANNAN: Åh, någon försökte stjäla en köpmans börs, men köpmannen grep tag i "
"hans hand."

#: dialog0020.txt:100802
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Znaczy, zupełnym przypadkiem złapał|za moją rękę."
msgstr "ANNAN: Och av en ren tillfällighet grep han tag i min hand."

#: dialog0020.txt:100803
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ja się pytam: czy to jest dowód?!#E8#B3"
msgstr "ANNAN: Och jag frågar: Hur bevisar det någonting?!#E8#B3"

#: dialog0020.txt:100901
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Honorem, dobytkiem, moimi kozami..."
msgstr "ANNAN: Jag svär på min heder, mina ägodelar, mina getter ..."

#: dialog0020.txt:100902
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Albo nie, kozami nie."
msgstr "ANNAN: Eller nej, inte mina getter."

#: dialog0020.txt:100903
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: A dlaczego nie?"
msgstr "HJÄLTE: Och varför inte?"

#: dialog0020.txt:100904
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Bo kozy akurat mam."
msgstr "ANNAN: För jag HAR getter."

#: dialog0020.txt:100905
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Rozumiem...#E9"
msgstr "P#HJÄLTE: Jag förstår ...#E9"

#: dialog0020.txt:101001
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Kahem."
msgstr "ANNAN: Hm ..."

#: dialog0020.txt:101002
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nie wpadajmy od razu w skrajności."
msgstr "ANNAN: Låt oss inte gå till överdrift."

#: dialog0020.txt:101003
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Głowa to cenna rzecz."
msgstr "ANNAN: Ett huvud är värdefullt."

#: dialog0020.txt:101004
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Wolałbym postawić coś, co nie jest|mi aż tak potrzebne."
msgstr "ANNAN: Jag satsar hellre något jag har råd att förlora."

#: dialog0020.txt:101005
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Na przykład?..."
msgstr "HJÄLTE: Som till exempel? ..."

#: dialog0020.txt:101006
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Patrząc na wszystkie okoliczności..."
msgstr "ANNAN: Med tanke på omständigheterna ..."

#: dialog0020.txt:101007
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Mogą być moje buty?"
msgstr "ANNAN: Vad sägs om mina skor?"

#: dialog0020.txt:101008
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Przecież nie masz butów."
msgstr "P#HJÄLTE: Du har inga skor."

#: dialog0020.txt:101009
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: No właśnie."
msgstr "ANNAN: Just det."

#: dialog0020.txt:101010
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Rozumiem...#E10"
msgstr "P#HJÄLTE: Jag förstår ...#E10"

#: dialog0020.txt:101101
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: A moje słowo nie wystarczy?!"
msgstr "ANNAN: Och mitt ord räcker inte?!"

#: dialog0020.txt:101102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"P#OTHER: No dobra, może to nie najlepszy dowód,|ale ja naprawdę jestem "
"czysty jak łza!#E11"
msgstr ""
"P#ANNAN: Okej, kanske inte det bästa beviset, men jag säger ju att jag är "
"ren som ett lakan!#E11"

#: dialog0020.txt:101201
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nie śmiem prosić..."
msgstr "ANNAN: Jag skulle inte våga fråga ..."

#: dialog0020.txt:101202
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Pomyślę o tym.#E12#X1"
msgstr "HJÄLTE: Jag ska tänka på saken.#E12#X1"

#: dialog0020.txt:101301
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nie."
msgstr "ANNAN: Nej."

#: dialog0020.txt:101302
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Ale to prowokacja!"
msgstr "P#ANNAN: Det är en provokation!"

#: dialog0020.txt:101303
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Jestem niewinny!#B2"
msgstr "ANNAN: Jag är oskyldig!#B2"

#: dialog0020.txt:101402
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Wszyscy tylko ta logika i logika."
msgstr "ANNAN: Alla ska alltid prata om logik."

#: dialog0020.txt:101403
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Dedukcja i dedukcja."
msgstr "ANNAN: Deduktion och induktion."

#: dialog0020.txt:101404
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: A ja przecież nic nie zrobiłem!#B2"
msgstr "ANNAN: Och jag gjorde ingenting!#B2"

#: dialog0020.txt:101501
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Poważnie?"
msgstr "P#ANNAN: Allvarligt?"

#: dialog0020.txt:101502
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"HERO: Szczerze mówiąc, mój biedny człowieku,|wyglądasz na takiego, który by "
"nawet|muchy nie skrzywdził."
msgstr ""
"HJÄLTE: För att vara ärlig, min gode man, ser du inte ut att kunna göra en "
"fluga förnär."

#: dialog0020.txt:101503
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"HERO: Bez obrazy, ale prędzej ciebie by|okradziono niż ty mógłbyś "
"kogoś|okraść."
msgstr ""
"HJÄLTE: Ta inte illa upp, men jag tror snarare att någon skulle råna dig."

#: dialog0020.txt:101504
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: No, nie przesadzajmy, aż taką ofermą|nie jestem.#E15#B4"
msgstr "ANNAN: Hördu, överdriv inte. Jag är inte så klen.#E15#B4"

#: dialog0020.txt:101601
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: O, to bardzo dobre określenie!"
msgstr "ANNAN: Åh, det är en väldigt bra beskrivning!"

#: dialog0020.txt:101602
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Szkoda, że sam tego nie wymyśliłem."
msgstr "ANNAN: Synd att jag inte kom på den själv."

#: dialog0020.txt:101603
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Zostałem bezczelnie wrobiony!#B2"
msgstr "ANNAN: Jag har blivit skamlöst ditsatt!#B2"

#: dialog0020.txt:101701
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Dziękuję, książę."
msgstr "ANNAN: Tack, min furste."

#: dialog0020.txt:101702
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Od razu widać, że znasz się na ludziach."
msgstr "ANNAN: Du är en god människokännare, det hör jag."

#: dialog0020.txt:101703
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Proszę, uwolnij mnie!"
msgstr "ANNAN: Snälla, släpp mig!"

#: dialog0020.txt:101704
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Zastanowię się nad tym...#X1"
msgstr "HJÄLTE: Jag ska tänka på saken ...#X1"

#: dialog0020.txt:101801
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ja?!"
msgstr "ANNAN: Jag?!"

#: dialog0020.txt:101802
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Chropowate palce?!"
msgstr "ANNAN: Valkiga fingrar?!"

#: dialog0020.txt:101803
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Obrobiłem nimi samego królewskiego doradcę|Keidana, kiedy zagapił się"
" na dziewczyny|z objazdowego cyrku!"
msgstr ""
"ANNAN: Jag rånade kungens rådgivare Keidan själv med de här händerna när han"
" glodde på cirkusflickorna!"

#: dialog0020.txt:101804
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Tylko może nie mów o tym w zamku."
msgstr "ANNAN: Säg bara inte det på slottet."

#: dialog0020.txt:101805
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Nie oparł się nim nawet ten zdzierca|podatkowy Gandar! Zabrałem mu "
"dwakroć|tyle, co on mi!"
msgstr ""
"ANNAN: Till och med den där hjärtlösa skatteindrivaren Gandar! Jag tog "
"dubbelt så mycket av honom som han tog av mig!"

#: dialog0020.txt:101806
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ale nie powtarzaj tego, dobrze?"
msgstr "ANNAN: Behåll det för dig själv, okej?"

#: dialog0020.txt:101807
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: To są palce mistrza, a nie jakieś|tam, tfu, chropowate..."
msgstr "ANNAN: Det här är en mästares fingrar, inga valkiga labbar."

#: dialog0020.txt:101808
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"HERO: Nie wierzę, mówisz tak tylko, bo wstyd|ci odcisków od pracy na polu."
msgstr ""
"HJÄLTE: Kom igen, du skäms bara för att arbetet på fälten gav dig valkar."

#: dialog0020.txt:101809
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Tak?"
msgstr "ANNAN: Jaså?"

#: dialog0020.txt:101810
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: TAK?!?"
msgstr "ANNAN: JASÅ?!?"
