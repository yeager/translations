#: dialog0019.txt:100105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: ...smarkać ludziom na czubki butów i chuchać|im prosto w twarz, kiedy"
" nie myje się zębów."
msgstr ""
"ANNAN: ... spotta på folks skor och blåsa dem i ansiktet när du aldrig "
"borstar tänderna."

#: dialog0019.txt:100106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Bułka z masłem."
msgstr "ANNAN: Busenkelt."

#: dialog0019.txt:100107
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Miałem raczej na myśli pytanie...#B1"
msgstr "HJÄLTE: Jag menade något annat ...#B1"

#: dialog0019.txt:100201
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nie, ale lubię lepić kulki."
msgstr "ANNAN: Nej, men jag gillar att rulla små kulor."

#: dialog0019.txt:100202
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Z nosa, z brudu między palcami,|mnie tam obojętne."
msgstr "ANNAN: Snor, smuts under tånaglarna ... Jag bryr mig inte."

#: dialog0019.txt:100203
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Takie małe hobby."
msgstr "ANNAN: Bara en liten hobby jag har."

#: dialog0019.txt:100204
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Błe!#B0"
msgstr "HJÄLTE: Usch!#B0"

#: dialog0019.txt:100401
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Bo lepiej być fałszywym wyrzutem sumienia|niż prawdziwym wyrzutkiem "
"społeczeństwa."
msgstr ""
"ANNAN: För det är bättre att ångra sig på låtsas än att vara en riktig "
"utstött."

#: dialog0019.txt:100402
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Że co?"
msgstr "P#HJÄLTE: Va?"

#: dialog0019.txt:100403
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ja też nie rozumiem, ale niezłe, nie?#B0"
msgstr ""
"ANNAN: Jag fattar inte heller, men det låter imponerande, eller hur?#B0"

#: dialog0019.txt:100501
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: E tam, kto by chciał bułkę bez masła.#B0"
msgstr "ANNAN: Äsch, orkar inte.#B0"

#: dialog0020.txt:101
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$0: Cóż takiego zrobiłeś, biedaku?"
msgstr "$0: Vad har du gjort, stackars man?"

#: dialog0020.txt:102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$7: Więc powiadasz, nieszczęśliwcze, żeś niewinny?"
msgstr "$7: Så du säger att du är oskyldig?"

#: dialog0020.txt:103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$8: Za cóż konkretnie cię zakuto?"
msgstr "$8: Vad gjorde du egentligen för att hamna i stocken?"

#: dialog0020.txt:104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$1: Widzę, że podglądasz grę kupców?"
msgstr "$1: Iakttar du deras spel?"

#: dialog0020.txt:105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$2: Nie odchodź, zaraz wracam..."
msgstr "$2: Gå ingenstans ..."

#: dialog0020.txt:206
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$3: Naprawdę naprawdę?"
msgstr "$3: Verkligen, verkligen?"

#: dialog0020.txt:207
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$4: Jakoś ci nie wierzę."
msgstr "$4: På något vis tror jag dig inte."

#: dialog0020.txt:208
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$5: Więc jesteś tu bezprawnie?"
msgstr "$5: Så du är här olagligt?"

#: dialog0020.txt:209
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$6: Niezła sztuczka, ale ja się nie nabiorę."
msgstr "$6: Bra försök, men du kan inte lura mig ..."

#: dialog0020.txt:310
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$9: I zaręczasz swoim honorem?"
msgstr "$9: Och du svär på din heder?"

#: dialog0020.txt:311
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$10: I dajesz za to głowę?"
msgstr "$10: Skulle du sätta huvudet på spel för det?"

#: dialog0020.txt:312
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$11: Masz jakiś dowód swojej niewinności?"
msgstr "$11: Har du något bevis på din oskuld?"

#: dialog0020.txt:313
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$12: Chcesz, bym wstawił się za tobą u króla?"
msgstr "$12: Vill du att jag lägger ett gott ord för dig hos kungen?"

#: dialog0020.txt:414
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$13: A był w pobliżu ktoś jeszcze inny?"
msgstr "$13: Var någon annan där?"

#: dialog0020.txt:415
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$14: Szczerze mówiąc, dowód dość trudny do obalenia..."
msgstr "$14: För att vara ärlig är det svårt att motbevisa de där bevisen ..."

#: dialog0020.txt:416
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$15: Faktycznie, to żaden dowód."
msgstr "$15: Du har rätt, det är inget bevis."

#: dialog0020.txt:417
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$16: Czyli zostałeś kozłem ofiarnym?"
msgstr "$16: Så du fick bli syndabock?"

#: dialog0020.txt:518
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$17: Wyglądasz na uosobienie dobroci i łagodności."
msgstr "$17: Du ser ut som själva godheten."

#: dialog0020.txt:519
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$18: Masz zbyt chropowate palce, jak na złodzieja."
msgstr "$18: Dina fingrar är för valkiga för en tjuv."

#: dialog0020.txt:520
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$19: Gdybyś był złodziejem, nie chodziłbyś w łachmanach."
msgstr "$19: Om du var en tjuv skulle du inte bära dessa trasor."

#: dialog0020.txt:100001
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nic, wasza uprzejmość!"
msgstr "ANNAN: Ingenting, ers nåd!"

#: dialog0020.txt:100002
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Jestem niewinny."
msgstr "ANNAN: Jag är oskyldig."

#: dialog0020.txt:100003
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: I - zanim wasza wysokość skomentuje -|wiem, że wszyscy tak mówią..."
msgstr "ANNAN: Och innan ers nåd säger något: jag vet att alla säger det ..."

#: dialog0020.txt:100004
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: ...ale ja naprawdę naprawdę jestem|niewinny!#B1"
msgstr "ANNAN: ... men jag är verkligen, verkligen oskyldig!#B1"

#: dialog0020.txt:100101
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Echhh... Gdybym tylko mógł się przyłączyć..."
msgstr "ANNAN: Öhhh ... Om jag bara kunde vara med ..."

#: dialog0020.txt:100102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: To amatorzy. Ja bym im pokazał, jak się|turla sześcianiki."
msgstr "ANNAN: Amatörer. Jag skulle visa dem hur man rullar en tärning ..."

#: dialog0020.txt:100103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Jakieś małe oszustwo? As z rękawa?"
msgstr "HJÄLTE: Något litet trick? Ess ur ärmen?"

#: dialog0020.txt:100104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Przepraszam, książę, ale nie mogę zdradzać|swoich skromnych "
"tajemnic.#B0"
msgstr ""
"ANNAN: Jag beklagar, ers nåd, men jag kan inte avslöja yrkeshemligheter.#B0"

#: dialog0020.txt:100301
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Naprawdę naprawdę.#E7#E8#B0"
msgstr "ANNAN: Verkligen, verkligen!#E7#E8#B0"

#: dialog0020.txt:100401
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Dlaczego?"
msgstr "ANNAN: Varför?"

#: dialog0020.txt:100402
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Jestem bolesnym przykładem niesprawiedliwości|systemu prawnego "
"naszego państwa oraz|bezwzględności władz!"
msgstr ""
"ANNAN: Jag är ett levande exempel på det här landets rättssystem och de "
"statliga myndigheternas hänsynslöshet!"

#: dialog0020.txt:100403
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: W skrócie, dałem się złapa..."
msgstr "ANNAN: Kort sagt blev jag tagen på bar gärning ..."

#: dialog0020.txt:100404
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Eee... Nastąpiła pomyłka i zamiast|prawdziwego sprawcy złapano "
"mnie.#E7#E8#B0"
msgstr ""
"ANNAN: Öhm ... Det blev en förväxling och de grep mig i stället för den "
"verklige boven.#E7#E8#B0"

#: dialog0020.txt:100501
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Absolutnie."
msgstr "ANNAN: Absolut."

#: dialog0020.txt:100502
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Nigdy te ręce - a łatwo je sobie obejrzeć|w takiej pozycji - nie "
"skalały się|kradzieżą.#E7#E8#B0"
msgstr ""
"ANNAN: Jag skulle aldrig smutsa ner händerna med stöld – och det ser du lätt"
" på dem så här.#E7#E8#B0"

#: dialog0020.txt:100601
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: No cóż, miałem nadzieje, że mój dobry|książę ujmie się za biednym "
"pasterzem,|ale się myliłem..."
msgstr ""
"ANNAN: Jag hoppades att ers nåd skulle förbarma sig över en fattig herde, "
"men jag hade fel ..."

#: dialog0020.txt:100602
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: <chlipanie>#E7#E8#B0"
msgstr "ANNAN: <snyftar>#E7#E8#B0"

#: dialog0020.txt:100701
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Niewinny jak córka moja jedyna..."
msgstr "ANNAN: Jag är lika ren och oskyldig som min enda dotter ..."

#: dialog0020.txt:100702
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: No, to akurat zły przykład."
msgstr "P#ANNAN: Egentligen ett dåligt exempel."
