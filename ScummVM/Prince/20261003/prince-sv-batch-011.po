#: dialog0027.txt:100010
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Pokłóćcie się potem, ja mam tylko|parę pytań...#B0"
msgstr "HJÄLTE: Bråka om det senare. Jag hade bara några frågor.#B0"

#: dialog0027.txt:100101
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Raczej arystokratyczna."
msgstr "ANNAN: Aristokratisk snarare."

#: dialog0027.txt:100102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Zło mnie nie fascynuje, mam inne|inspiracje."
msgstr "ANNAN: Jag är inte intresserad av ondska. Jag föredrar andra saker."

#: dialog0027.txt:100103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Małe, białe sześcianiki. To po pierwsze.|A poza tym duże białe "
"piłeczki z brązowymi|czubeczkami. Mniam!"
msgstr ""
"ANNAN: Till exempel små vita kuber. Och stora vita kulor med bruna spetsar, "
"mums!"

#: dialog0027.txt:100104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Przyznam jednak, że gdy w czasie podróży|mijaliśmy zatopiony w "
"ciemności zamek,|to było dość interesujące."
msgstr ""
"ANNAN: Men jag erkänner att vi passerade ett slott som verkade vara höljt i "
"evigt mörker. Det var rätt intressant."

#: dialog0027.txt:100105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Zatopiony w ciemności?"
msgstr "HJÄLTE: Höljt i mörker, säger du?"

#: dialog0027.txt:100106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Podobno nigdy nad nim nie świeci słońce."
msgstr "ANNAN: De säger att solljuset aldrig når dit."

#: dialog0027.txt:100107
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: A co do bródki..."
msgstr "ANNAN: Och om det där skägget ..."

#: dialog0027.txt:100108
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Diabeł często ukazywany jest jako|arystokrata z kozią bródką."
msgstr "HJÄLTE: Djävulen avbildas ofta som en adelsman med pipskägg."

#: dialog0027.txt:100109
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Poważnie?..."
msgstr "P#ANNAN: Verkligen? ..."

#: dialog0027.txt:100110
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Na rany, nie gadaj tyle, tylko graj."
msgstr "ANNAN2: Herregud, prata inte så mycket, spela vidare."

#: dialog0027.txt:100111
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Starasz się wymigać?"
msgstr "ANNAN2: Försöker du slingra dig ur det?"

#: dialog0027.txt:100112
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nie, ale nudzą mnie gry ze słabym|przeciwnikiem."
msgstr "ANNAN: Nej, men jag är trött på att spela mot en svag motståndare."

#: dialog0027.txt:100113
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Słaba jest twoja wymówka,|starzejesz się."
msgstr "ANNAN2: Dålig ursäkt. Du blir gammal."

#: dialog0027.txt:100114
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"P#OTHER: Książę, przepraszam za mojego|przyjaciela. Cóż to "
"chciałeś|zapytać?...#F1#B0"
msgstr "P#ANNAN: Ursäkta honom, ers nåd. Vad ville ni fråga igen?#F1#B0"

#: dialog0027.txt:100201
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Duży, gładki i gruby przedmiot z obsydianu.|Ale to tylko dla dam, "
"książę."
msgstr ""
"ANNAN: En tjock cylinder av obsidian. Men den är bara för damer, ers nåd."

#: dialog0027.txt:100202
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: A tak poza tym...  Trochę tego, trochę|tamtego. Rupiecie."
msgstr "ANNAN: Annars ... Lite av varje. Saker."

#: dialog0027.txt:100203
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Pamiątki z podróży, różne dziwne|książki, z których nic nie rozumiem."
msgstr "ANNAN: Souvenirer och några märkliga böcker som jag inte förstår."

#: dialog0027.txt:100204
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Mam taką jedną, ponoć bezcenną, ale|w środku są głównie rysunki i "
"jakieś|tajemnicze znaczki."
msgstr ""
"ANNAN: Det finns en som sägs vara ovärderlig. Men den är bara full av roliga"
" teckningar och underliga symboler."

#: dialog0027.txt:100205
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: No, ale to robi wrażenie na klientach."
msgstr "ANNAN: Men kunderna imponeras."

#: dialog0027.txt:100206
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Mam też parę cudownych leczniczych proszków,|starty róg feniksa, "
"złote ozdoby|prymitywnych plemion."
msgstr ""
"ANNAN: Jag har också fantastiska läkepulver, malet fenixhorn och gyllene "
"smycken från primitiva stammar."

#: dialog0027.txt:100207
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Jednym słowem, wszystko co może zainteresować|nowobogackich lub "
"pretensjonalnych szlachetków|czy królewiczów."
msgstr ""
"ANNAN: Kort sagt allt som kan intressera nyrika, högfärdiga adelsmän och "
"småfurstar."

#: dialog0027.txt:100208
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Oczywiście, ty książę jesteś|wyjątkiem."
msgstr "P#ANNAN: Nuvarande sällskap undantaget, förstås."

#: dialog0027.txt:100209
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Kahem, to na czym stanęliśmy?#B0"
msgstr "P#ANNAN: Just det. Var var vi?#B0"

#: dialog0028.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Fru!"
msgstr "ANNAN: Jippie!"

#: dialog0029.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Hopsa!"
msgstr "ANNAN: Woho!"

#: dialog0030.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: No!"
msgstr "ANNAN: Hoppsan!"

#: dialog0031.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Kto chce jeść, ten ma sześć!"
msgstr "ANNAN: Vill du ha mat, ge mig en sexa!"

#: dialog0032.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Będzie wziątko, mam szóściątko!"
msgstr "ANNAN: Kom igen, ge oss en sexa!"

#: dialog0033.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: W porządalu, po szóstalu!"
msgstr "ANNAN: En sexa åt mig och ingen åt dig!"

#: dialog0034.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Kości pieść i mam sześć!"
msgstr "ANNAN: Kyss tärningen så får du en sexa!"

#: dialog0035.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Na początek, trochę szóściątek!"
msgstr "ANNAN: Några sexor att börja med!"

#: dialog0036.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Przed moje oczy szóstka się toczy!"
msgstr "ANNAN: Jag känner att en sexa är på väg!"

#: dialog0037.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Mam na dzieweczki, rzucam szósteczki!"
msgstr "ANNAN: Först en sexa, sedan tjejer!"

#: dialog0038.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Z radości płacze, znowu szóstaczek."
msgstr "ANNAN: Av glädje jag ler, en sexa på tärningen jag ser!"

#: dialog0039.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Się nie wstydzę, szóstkę widzę!"
msgstr "ANNAN: Ingen skam, bara sexor!"

#: dialog0040.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Cholerny oszust!"
msgstr "ANNAN: Förbannade fuskare!"

#: dialog0041.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: To czysty przypadek!"
msgstr "ANNAN: Ren slump!"

#: dialog0042.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: A niech to licho!"
msgstr "ANNAN: Förbaskat!"

#: dialog0043.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: No, to jest oszustwo!"
msgstr "ANNAN: Det där är fusk!"

#: dialog0044.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Przeklęty szczęściarz!"
msgstr "ANNAN: Din lycklige jävel!"

#: dialog0045.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Klasyczny cud!"
msgstr "ANNAN: Ett klassiskt mirakel!"

#: dialog0046.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ale dam ci jeszcze szansę."
msgstr "ANNAN: Jag ger dig en chans till."

#: dialog0047.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ale zaraz sobie odbiję."
msgstr "ANNAN: Och nu ska jag hämnas."

#: dialog0048.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ale i tak wygram."
msgstr "ANNAN: Jag vinner ändå."

#: dialog0049.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Witaj, czarodzieju."
msgstr "HJÄLTE: Var hälsad, trollkarl."

#: dialog0049.txt:3
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: O, bogowie, jaki ja jestem zapracowany,|jaki jestem zapracowany..."
msgstr ""
"ANNAN: Åh, gudar, jag har så mycket arbete att göra, så mycket arbete ..."

#: dialog0049.txt:104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$0: Cóż to za niezwykły sklep..."
msgstr "$0: Vilken fantastisk butik ..."

#: dialog0049.txt:105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$4: A propos miłosnych wywarów..."
msgstr "$4: På tal om kärleksdrycker ..."

#: dialog0049.txt:106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$1: Dlaczego nie przewracasz stron palcami?"
msgstr "$1: Varför vänder ni inte sidan med fingrarna?"
