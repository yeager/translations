#: dialog0023.txt:100509
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: HA HA HA!"
msgstr "ANNAN2: HA HA HA!"

#: dialog0023.txt:100510
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: To ci się udało, książę!"
msgstr "ANNAN2: Den var bra, ers nåd!"

#: dialog0023.txt:100511
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Niech ja skonam..."
msgstr "ANNAN2: Åh, jag dör."

#: dialog0023.txt:100512
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: W porządku, w porządku, nic nie mówiłem.#B0"
msgstr "HJÄLTE: Okej, glöm att jag sa något.#B0"

#: dialog0023.txt:100601
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Ależ książę, wszyscy pamiętamy, jak|udawałeś śmiertelnie rannego w "
"karczmie..."
msgstr ""
"ANNAN: Åh, min furste. Vi minns alla hur ni låtsades vara dödligt sårad på "
"värdshuset ..."

#: dialog0023.txt:100602
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: ...aż nie zaczął cię lizać pies i wydało|się, że to zalewka z "
"czereśni."
msgstr ""
"ANNAN: ... tills en hund slickade ert ”sår” och det visade sig vara "
"körsbärslikör."

#: dialog0023.txt:100603
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Hej, Stefanello, a pamiętasz jak książę|przebrał się za panienkę i "
"poderwał|barda?"
msgstr ""
"ANNAN: Hördu, Stefanello, minns du när fursten klädde ut sig till kvinna och"
" flörtade med skalden?"

#: dialog0023.txt:100604
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Zaraz..."
msgstr "ANNAN2: Vänta ..."

#: dialog0023.txt:100605
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Ach, faktycznie!"
msgstr "ANNAN2: Åååh ja!"

#: dialog0023.txt:100606
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER2: Nigdy nie zapomnę jego miny, jak zbliżył|się nagle by ukraść całusa "
"i zobaczył|zarost!"
msgstr ""
"ANNAN2: Jag glömmer aldrig hans min när han skulle kyssa henne och märkte "
"skäggstubben!"

#: dialog0023.txt:100607
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Myślałem, że nigdy go nie docucimy."
msgstr "ANNAN2: Jag trodde aldrig att han skulle vakna efter det."

#: dialog0023.txt:100608
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Oddech żebraka postawi na nogi nawet|umarłego."
msgstr ""
"ANNAN: Sannerligen. Som tur var kunde tiggarens andedräkt väcka de döda."

#: dialog0023.txt:100609
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Chyba usłyszałem już wystarczająco dużo...#B0"
msgstr "HJÄLTE: Jag tror att jag har hört nog ...#B0"

#: dialog0024.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Witaj, kupcze."
msgstr "HJÄLTE: Var hälsad, köpman."

#: dialog0024.txt:2
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Witaj, książę."
msgstr "ANNAN: Var hälsad, furste."

#: dialog0024.txt:103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$0: Słyszałeś może, drogi człowieku, coś o demonach?"
msgstr "$0: Har ni hört något om demoner, gode herre?"

#: dialog0024.txt:104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$1: Widzę, że mocno pracujesz nad tą zupką..."
msgstr "$1: Jag ser att ni arbetar hårt med den där grytan ..."

#: dialog0024.txt:105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$2: Co właściwie sprzedajesz?"
msgstr "$2: Vad säljer ni egentligen?"

#: dialog0024.txt:106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$3: Nie przeszkadzam, porozmawiamy jeszcze później."
msgstr "$3: Jag ska sluta störa er. Vi talas vid senare."

#: dialog0024.txt:100001
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Przeżyłem z jednym dwadzieścia lat.|To była moja żona."
msgstr "ANNAN: Jag var gift med en i tjugo år."

#: dialog0024.txt:100002
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Podróżując po całym świecie widzieliśmy różne|złe rzeczy, książę, ale"
" zawsze trzymaliśmy się|od nich z daleka."
msgstr ""
"ANNAN: På våra resor runt världen har vi sett många onda ting, men vi höll "
"oss undan."

#: dialog0024.txt:100003
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ta kraina jest spokojna pod rządami|twego ojca."
msgstr "ANNAN: Det här landet är mycket fredligt under er fars styre."

#: dialog0024.txt:100004
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Ale nawet i tu słyszeliśmy po drodze|o starym, przeklętym zamku, w "
"którym|od lat już nie widziano człowieka."
msgstr ""
"ANNAN: Men även här hörde jag om ett gammalt, förbannat slott där ingen "
"människa har satt sin fot på åratal."

#: dialog0024.txt:100005
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Żywego człowieka."
msgstr "ANNAN: Ingen levande människa, åtminstone."

#: dialog0024.txt:100006
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nic więcej nie wiem i nie chciałbym wiedzieć.#F1#B0"
msgstr "ANNAN: Det är allt jag vet och vill veta.#F1#B0"

#: dialog0024.txt:100101
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Wybacz mi, książę, ale twoi poddani nie|potrafią się delektować "
"subtelnościami|prawdziwej kuchni."
msgstr ""
"ANNAN: Jag ber om ursäkt, min furste, men era undersåtar tycks inte kunna "
"uppskatta det verkliga kökets finesser."

#: dialog0024.txt:100102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: A ta zupa bez czosnku po prostu nie|może istnieć!"
msgstr "ANNAN: Och utan vitlök är den här grytan helt enkelt otänkbar!"

#: dialog0024.txt:100103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Czostnek? Cóż to takiego?"
msgstr "HJÄLTE: Vitlök? Vad är det?"

#: dialog0024.txt:100105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Czosnek. Nie \"czostnek\", tylko czosnek."
msgstr "ANNAN: Vitlök, inte ”vitlöck”, bara vitlök."

#: dialog0024.txt:100106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: To taka przyprawa, wygląda jak mała cebulka,|ale cebulki są już "
"passe."
msgstr ""
"ANNAN: Det är en sorts krydda som ser ut som en liten lök, men schalottenlök"
" har fallit ur modet."

#: dialog0024.txt:100107
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Czosnek leczy przeziębienie i ból gardła."
msgstr "ANNAN: Vitlök hjälper mot förkylning och halsont."

#: dialog0024.txt:100108
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Poza tym polecany jest kochankom, którzy chcą|zerwać z partnerem. "
"Działa niezawodnie już po|kilku tygodniach intensywnego zażywania."
msgstr ""
"ANNAN: Dessutom rekommenderas den för älskare som vill göra slut med sin "
"partner. Det fungerar pålitligt efter bara några veckors intensiv "
"användning."

#: dialog0024.txt:100109
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: I najważniejsze: nic nie dodaje tak aromatu|zupie czy mięsu jak "
"szczypta czosnku."
msgstr ""
"ANNAN: Och framför allt: Inget ger kött eller soppor arom som en nypa "
"vitlök."

#: dialog0024.txt:100110
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: I nikt w tym... to jest, w moim|królestwie nie zna czosnku?"
msgstr ""
"HJÄLTE: Och ingen i det här ... öh, i mitt kungarike känner till vitlök?"

#: dialog0024.txt:100111
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Niestety, moda na tę przyprawę jeszcze|nie dotarła do ziem waszej "
"wysokości."
msgstr "ANNAN: Tyvärr inte. Kryddans popularitet har ännu inte nått ert land."

#: dialog0024.txt:100112
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Och, oddałbym brodę za choćby jeden ząbek!#B0"
msgstr "ANNAN: Åh, jag skulle sälja mitt skägg för en enda klyfta!#B0"

#: dialog0024.txt:100201
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Przyprawy, przepisy, a od czasu do czasu|specjalne potrawy na "
"królewskie stoły."
msgstr ""
"ANNAN: Kryddor, recept och ibland särskilda rätter för det kungliga bordet."

#: dialog0024.txt:100202
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Ale przecież wiesz, kosztowałeś wczoraj|mojego jaszczurzego ogona w "
"śliwkach|i pieprzu."
msgstr ""
"ANNAN: Men det vet ni – ni åt min ödlesvans med plommon och peppar så sent "
"som i går."

#: dialog0024.txt:100203
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Er, kahem, jasne, zapomniałem."
msgstr "P#HJÄLTE: Åh ja, öh, självklart. Hur skulle jag kunna glömma det?"

#: dialog0024.txt:100204
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Czyżby nie smakował?..."
msgstr "ANNAN: Inte i er smak? ..."

#: dialog0024.txt:100205
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Nieee, skąąąd, był pyszny!"
msgstr "HJÄLTE: I-inte alls, den var utsökt!"

#: dialog0024.txt:100206
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: To dobrze, bo jak niektórzy goście|zzielenieli, to myślałem, że i "
"książę|będzie wybrzydzał."
msgstr ""
"ANNAN: Åh, bra. Efter att några gäster blev gröna befarade jag att ni också "
"skulle rynka på näsan."

#: dialog0024.txt:100207
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Barbarzyńcy, jeść ogon jaszczurki|bez maczania go w sosie z "
"wilczych|grzybków.#B0"
msgstr ""
"ANNAN: De där barbarerna! Hur kan man äta ödlesvans utan att doppa den i "
"vargsvampssås?#B0"

#: dialog0024.txt:100301
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Kiedy tylko sobie życzysz, książę.#E3"
msgstr "ANNAN: Till er tjänst, min furste.#E3"

#: dialog0025.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Nie chcę wam psuć zabawy, ale..."
msgstr "HJÄLTE: Jag vill inte avbryta ert spel, men ..."

#: dialog0025.txt:102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$0: Te kości to tak z nudów?"
msgstr "$0: Spelar ni tärning för att ni har tråkigt?"

#: dialog0025.txt:103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$4: Chciałbym zagrać z wami."
msgstr "$4: Jag skulle vilja spela med er."

#: dialog0025.txt:104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$1: Jakie towary macie na sprzedaż?"
msgstr "$1: Vilka varor har ni till salu?"

#: dialog0025.txt:105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$2: Czy słyszałeś, a może widziałeś kiedyś... demony?"
msgstr "$2: Har ni någonsin hört talas om några ... demoner?"

#: dialog0025.txt:106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$3: Grajcie dalej."
msgstr "$3: Fortsätt ni."
