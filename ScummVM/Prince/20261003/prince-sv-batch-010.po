#: dialog0025.txt:100001
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nie, z drewna."
msgstr "ANNAN: Nej, av trä."

#: dialog0025.txt:100002
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"P#OTHER: Och, wybacz mi książę, oderwany od gry|nie wiem czasem co plotę."
msgstr "P#ANNAN: Åh, ursäkta. Jag svamlar när spelet distraherar mig."

#: dialog0025.txt:100003
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ano tak sobie turlamy, dzień jak co dzień."
msgstr "ANNAN: Ja, vi kastar bara tärning, som vanligt."

#: dialog0025.txt:100004
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Trochę treningu przed następnym|przystankiem nie zaszkodzi.#E4#B0"
msgstr "ANNAN: Det skadar inte att träna lite till före nästa resmål.#E4#B0"

#: dialog0025.txt:100101
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Szczerze mówiąc wszystkiego po ździebełku,|tyle że Vandrusowi nie "
"chciało się jeszcze|rozpakować plecaka."
msgstr ""
"ANNAN: Lite av varje, ärligt talat. Men Vandrus här var för lat för att "
"packa upp varorna."

#: dialog0025.txt:100102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: \"Raz zagrajmy\", powiedział."
msgstr "ANNAN: ”En enda omgång”, sa han."

#: dialog0025.txt:100103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nałóg jeden."
msgstr "ANNAN: Det är som ett beroende."

#: dialog0025.txt:100104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Co ty bredzisz?"
msgstr "ANNAN2: Vad pratar du om?"

#: dialog0025.txt:100105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Przecież to TY chciałeś grać!"
msgstr "ANNAN2: Det var DIN idé!"

#: dialog0025.txt:100106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: \"Słaby ruch dzisiaj, dawaj kości\", mówiłeś."
msgstr "ANNAN2: ”Lugn dag, ge mig tärningarna”, sa du."

#: dialog0025.txt:100107
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: A że mam miękkie serce, to uległem."
msgstr "ANNAN2: Och jag gick med på det eftersom jag är så snäll."

#: dialog0025.txt:100108
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Niech mnie niedźwiedź pocałuje, co za|kłamstwo w biały dzień!"
msgstr "ANNAN: Åh, kyss en björn! Vilken fräck lögn."

#: dialog0025.txt:100109
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: A kto pierwszy..."
msgstr "ANNAN: Och vem var först ..."

#: dialog0025.txt:100110
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Panowie!"
msgstr "HJÄLTE: Mina herrar!"

#: dialog0025.txt:100111
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Spokojnie."
msgstr "HJÄLTE: Lugn er."

#: dialog0025.txt:100112
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"HERO: Sam sobie obejrzę wasze towary, nie|musicie się tak od razu fatygować."
msgstr "HJÄLTE: Jag tittar på era varor själv. Ni behöver inte besvära er."

#: dialog0025.txt:100113
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Phrmpf."
msgstr "P#ANNAN: Hmpf."

#: dialog0025.txt:100114
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ale milczę tylko z szacunku dla|ciebie, książę.#B0"
msgstr "ANNAN: Av respekt för er, furste, biter jag mig i tungan.#B0"

#: dialog0025.txt:100201
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Że jak? Demona?"
msgstr "ANNAN: Va? En demon?"

#: dialog0025.txt:100202
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Masz zachcianki, książę..."
msgstr "ANNAN: Ni och era infall, ers nåd ..."

#: dialog0025.txt:100203
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Słyszałem plotki o podzielonym na dwie|części straszliwym zamczysku, "
"ale na|szczęście to tylko plotki."
msgstr ""
"ANNAN: Jag hörde visserligen om något fruktansvärt slott som delats i två, "
"men som tur är är det bara ett rykte."

#: dialog0025.txt:100204
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ale sam wiesz, panie, jak to jest z plotkami."
msgstr "ANNAN: Ni vet hur rykten är, ers nåd."

#: dialog0025.txt:100205
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Mówią o buchających ogniem potworach, co włóczą|się nocami i "
"napastują dzieweczki, a potem się|okazuje, że to podpici chłopi wracali z "
"wesela."
msgstr ""
"ANNAN: Man talar om eldspottande monster som stryker omkring om natten och "
"antastar kvinnfolket, men sedan visar det sig vara berusade livegna!"

#: dialog0025.txt:100206
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Jedyny demon jakiego widziałem na własne|oczy to demon hazardu."
msgstr ""
"ANNAN: Den enda demoniska kraft jag någonsin sett i mitt liv är "
"spelberoende."

#: dialog0025.txt:100207
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"P#OTHER: Ale mnie to nie dotyczy, więc czy|mogę już wracać do gry?#F1#B0"
msgstr "P#ANNAN: Inte hos mig förstås. Kan vi fortsätta vårt spel nu?#F1#B0"

#: dialog0025.txt:100301
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Twoja łaska nie zna granic, książę.#E3"
msgstr "ANNAN: Er nåd känner inga gränser, furste.#E3"

#: dialog0025.txt:100401
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ależ!..."
msgstr "ANNAN: Men! ..."

#: dialog0025.txt:100402
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Książę publicznie uprawiający hazard?!"
msgstr "ANNAN: Kungligheter som spelar offentligt?!"

#: dialog0025.txt:100403
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Nie może być!"
msgstr "ANNAN: Otänkbart!"

#: dialog0025.txt:100404
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Kahem, no tak."
msgstr "HJÄLTE: Hm ... Självklart."

#: dialog0025.txt:100405
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Racja."
msgstr "P#HJÄLTE: Just det."

#: dialog0025.txt:100406
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Faktycznie."
msgstr "P#HJÄLTE: Du har rätt."

#: dialog0025.txt:100407
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Jasne."
msgstr "P#HJÄLTE: Naturligtvis."

#: dialog0025.txt:100408
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Tak tylko żartowałem."
msgstr "P#HJÄLTE: Jag bara skämtade."

#: dialog0025.txt:100409
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Twoje poczucie humoru zawsze zapierało|mi dech w piersi, książę...#B0"
msgstr "ANNAN: Ert sinne för humor gör mig mållös, furste ...#B0"

#: dialog0026.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: O w mordę..."
msgstr "ANNAN: Åh, för tusan!"

#: dialog0027.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Ummm... Ja tylko na sekundkę."
msgstr "HJÄLTE: Öhm ... Jag ska bara ..."

#: dialog0027.txt:102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$0: Kto wygrywa?"
msgstr "$0: Vem vinner?"

#: dialog0027.txt:103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$1: Demoniczna bródka..."
msgstr "$1: Djävulskt skägg."

#: dialog0027.txt:104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$2: Jaka jest najciekawsza rzecz, jaką sprzedajesz?"
msgstr "$2: Vad är det mest intressanta ni säljer?"

#: dialog0027.txt:105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$3: Porozmawiamy jeszcze później."
msgstr "$3: Vi pratar senare."

#: dialog0027.txt:100001
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Mistrz."
msgstr "ANNAN: Mästaren."

#: dialog0027.txt:100002
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Moje imię to Vandrus."
msgstr "ANNAN: Jag heter Vandrus."

#: dialog0027.txt:100003
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: No to teraz przedstaw mistrza."
msgstr "ANNAN2: Då får du presentera mästaren för honom."

#: dialog0027.txt:100004
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Bo chyba jeszcze pamiętasz,|jak mi na imię?"
msgstr "ANNAN2: Eller har du redan glömt mitt namn?"

#: dialog0027.txt:100005
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Bardzo śmieszne."
msgstr "P#ANNAN: Mycket roligt."

#: dialog0027.txt:100006
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Przegrywasz prawie każdą rundkę,|i jeszcze masz ochotę na żarty."
msgstr ""
"ANNAN: Du har förlorat nästan varje omgång, men du skämtar fortfarande."

#: dialog0027.txt:100007
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Liczymy tylko gry, w których nie|oszukiwałeś."
msgstr "ANNAN2: Vi räknar bara de spel där du inte fuskade."

#: dialog0027.txt:100008
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: BOGOWIE!"
msgstr "ANNAN: Himmel!"

#: dialog0027.txt:100009
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: PANOWIE!"
msgstr "HJÄLTE: MINA HERRAR!"
