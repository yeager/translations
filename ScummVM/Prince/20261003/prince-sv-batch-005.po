#: dialog0016.txt:100710
msgid ""
"P#OTHER: Na razie jest dwa zero dla słabości, ale|to się wkrótce zmieni!#B0"
msgstr ""
"P#ANNAN: Hittills står det två noll till svagheten, men jag vänder snart på "
"det!#B0"

#: dialog0016.txt:100801
msgid "OTHER: Brbrłełe..."
msgstr "ANNAN: <galet gurglande>"

#: dialog0016.txt:100802
msgid "P#OTHER: No właśnie.#B1"
msgstr "P#ANNAN: Där ser du.#B1"

#: dialog0016.txt:100901
msgid "OTHER: E tam..."
msgstr "ANNAN: Nja ..."

#: dialog0016.txt:100902
msgid "OTHER: To tylko złudzenie."
msgstr "ANNAN: Du inbillar dig."

#: dialog0016.txt:100903
msgid "OTHER: Wszystko przez ten nadmiar..."
msgstr "ANNAN: Det är bara på grund av för mycket ..."

#: dialog0016.txt:100904
msgid "OTHER: ...nadmiar..."
msgstr "ANNAN: ... för mycket ..."

#: dialog0016.txt:100905
msgid "OTHER: ...hmmm..."
msgstr "ANNAN: ... hmm ..."

#: dialog0016.txt:100906
msgid "OTHER: ...nadmiar...#B3"
msgstr "ANNAN: ... för mycket ...#B3"

#: dialog0016.txt:101001
msgid "OTHER: O, świeżego powietrza. Właśnie."
msgstr "ANNAN: Just det, frisk luft! Precis."

#: dialog0016.txt:101002
msgid "OTHER: A więc pustelnik?...#B1"
msgstr "ANNAN: Så, eremiter ...?#B1"

#: dialog0016.txt:101101
msgid "OTHER: Dopingujących może, ale dozwolonych."
msgstr "ANNAN: Narkotika ... Kanske. Men de är lagliga."

#: dialog0016.txt:101102
msgid "OTHER: Co prawda może nie wszędzie..."
msgstr "ANNAN: Tja, kanske inte lagliga överallt ..."

#: dialog0016.txt:101103
msgid "OTHER: No, ale wracajmy do głównego tematu."
msgstr "ANNAN: Hur som helst, låt oss återgå till huvudämnet."

#: dialog0016.txt:101201
msgid "OTHER: E tam, to żaden zgubny nałóg."
msgstr "ANNAN: Nej, det är inte en destruktiv last."

#: dialog0016.txt:101202
msgid "OTHER: W każdej chwili mogę to rzucić."
msgstr "ANNAN: Jag kan sluta när som helst."

#: dialog0016.txt:101203
msgid "OTHER: W końcu robiłem to już tysiące razy."
msgstr "ANNAN: Jag har ju gjort det tusen gånger."

#: dialog0017.txt:1
msgid ""
"OTHER: \"Z przyczyn znanych tylko Naszemu Królewskiemu|Majestatowi, a które "
"publicznie ujawnione|zostać nie mogą...\""
msgstr ""
"ANNAN: ”Av skäl som endast Hans Kungliga Majestät känner till och som inte "
"kan offentliggöras ...”"

#: dialog0017.txt:2
msgid ""
"OTHER: \"...Nasz Syn od dnia dzisiejszego nie może być| uważany za Naszego "
"Syna.\""
msgstr ""
"ANNAN: ”... ska vår son från och med i dag inte längre betraktas som vår "
"son.”"

#: dialog0017.txt:3
msgid ""
"OTHER: \"Niniejszym rozkazujemy wymazać jego imię ze|wszelkich ksiąg i "
"dokumentów, ogłaszamy, iż nie|ma on prawa do Naszej korony i majątku...\""
msgstr ""
"ANNAN: ”Vi beordrar härmed att hans namn ska raderas ur alla böcker och "
"dokument. Vi meddelar att han inte har någon rätt till vår krona och egendom"
" ...”"

#: dialog0017.txt:4
msgid ""
"OTHER: \"...a nawet do przebywania na terenie Królestwa.|Jego imię ma być "
"zapomniane. Nigdy już nie|przyjmiemy go pod nasz dach.\""
msgstr ""
"ANNAN: ”... eller ens att stanna i kungariket. Hans namn ska glömmas. Vi "
"kommer aldrig att ta honom under vårt tak igen.”"

#: dialog0017.txt:5
msgid "OTHER: \"Jego Wysokość Król, ple-ple-ple.\""
msgstr "ANNAN: ”Hans Kungliga Majestät och så vidare.”"

#: dialog0017.txt:6
msgid "OTHER: Thank you, drive through."
msgstr "ANNAN: Tack, kör fram."

#: dialog0018.txt:1
msgid ""
"OTHER: Ciekawe kto wymyślił ten głupi dowcip.|Czego się gapicie? Wracać do "
"roboty,|przecież nic się nie stało!"
msgstr ""
"ANNAN: Jag undrar vem som kom på det här dumma skämtet. Vad stirrar du på? "
"Återgå till arbetet, inget har hänt!"

#: dialog0019.txt:1
msgid "HERO: Ładna dzisiaj pogoda."
msgstr "HJÄLTE: Härligt väder i dag."

#: dialog0019.txt:2
msgid "OTHER: Mhm..."
msgstr "ANNAN: Mhmm ..."

#: dialog0019.txt:3
msgid "HERO: To dobry dzień, by rozpocząć|nowe życie."
msgstr "HJÄLTE: En bra dag att börja ett nytt liv på."

#: dialog0019.txt:4
msgid "OTHER: Jasne..."
msgstr "ANNAN: Visst ..."

#: dialog0019.txt:5
msgid "HERO: Znaleźć pracę."
msgstr "HJÄLTE: Att skaffa E-T-T J-O-B-B."

#: dialog0019.txt:6
msgid "OTHER: Taaa..."
msgstr "ANNAN: Ja, ja ..."

#: dialog0019.txt:7
msgid "P#HERO: P-r-a-c-ę."
msgstr "P#HJÄLTE: E-T-T J-O-B-B."

#: dialog0019.txt:8
msgid "OTHER: Tak tak..."
msgstr "ANNAN: Ja, ja ..."

#: dialog0019.txt:109
msgid "$0: Twój książę mówi do ciebie!"
msgstr "$0: Din furste talar till dig!"

#: dialog0019.txt:110
msgid "$1: Jak zdołałeś upaść tak nisko..."
msgstr "$1: Hur kan du sjunka så lågt ..."

#: dialog0019.txt:111
msgid "$2: Paluszki swędzą, dobry człowieku?"
msgstr "$2: Klåda i handflatorna, min gode man?"

#: dialog0019.txt:112
msgid "$3: Do zobaczenia."
msgstr "$3: Vi ses senare."

#: dialog0019.txt:213
msgid "$4: ...dlaczego tak postępujesz?"
msgstr "$4: ... varför beter du dig så?"

#: dialog0019.txt:214
msgid "$5: ...a nie lepiej spróbować czegoś dokładnie odwrotnego?"
msgstr "$5: ... vill du inte hellre prova något helt annat?"

#: dialog0019.txt:100001
msgid "OTHER: Mhm."
msgstr "ANNAN: Pff."

#: dialog0019.txt:100002
msgid "HERO: Ignorujesz mnie?"
msgstr "HJÄLTE: Ignorerar du mig?"

#: dialog0019.txt:100003
msgid "OTHER: Nie... Nie nie... W ogóle..."
msgstr "ANNAN: Nej ... Nej, nej ... Inte alls ..."

#: dialog0019.txt:100004
msgid "HERO: Dobrze. Porozmawiam z tobą później."
msgstr "HJÄLTE: Okej då, jag pratar med dig senare."

#: dialog0019.txt:100005
msgid "HERO: Teraz mam ważniejsze rzeczy do roboty."
msgstr "HJÄLTE: Det är inte som om jag inte har viktigare saker att göra."

#: dialog0019.txt:100006
msgid "OTHER: Na pewno..."
msgstr "ANNAN: Visst ..."

#: dialog0019.txt:100007
msgid "HERO: Zabić smoka, uratować dziewicę,|zapewnić ciągłość dynastii."
msgstr ""
"HJÄLTE: Du vet, drakar att döda, jungfrur att rädda och se till att vår "
"dynasti lever vidare ..."

#: dialog0019.txt:100009
msgid "HERO: Grhm."
msgstr "HJÄLTE: Grrr ..."

#: dialog0019.txt:100101
msgid "OTHER: To nie takie trudne."
msgstr "ANNAN: Det är inte så svårt, vet du."

#: dialog0019.txt:100102
msgid ""
"OTHER: Trzeba dużo pić, nie przychodzić do pracy,|nie szanować szefa i "
"klientów, napastować|żony notabli..."
msgstr ""
"ANNAN: Du behöver bara dricka mycket, sluta gå till jobbet, behandla din "
"chef och dina kunder respektlöst, trakassera deras fruar …"

#: dialog0019.txt:100103
msgid "HERO: Eee..."
msgstr "HJÄLTE: Öh ..."

#: dialog0019.txt:100104
msgid ""
"OTHER: ...wylegiwać się całymi dniami, nie myć, nie|strzyc, nie czesać, nie "
"zmieniać ubrania|przez tygodnie..."
msgstr ""
"ANNAN: ... lata dig i dagar, inte bada, inte klippa eller kamma håret och "
"inte byta kläder på veckor ..."
