#: dialog0020.txt:101811
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: No to niech książę sprawdzi moje kieszenie."
msgstr "ANNAN: Leta då i mina förbannade fickor."

#: dialog0020.txt:101812
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Twoje kieszenie?"
msgstr "P#HJÄLTE: Dina fickor?"

#: dialog0020.txt:101813
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Bardzo proszę. Moje kieszenie. Zaraz się|okaże, kto tu ma rację."
msgstr "ANNAN: Varsågod – mina fickor. Sedan får vi se vem som har rätt."

#: dialog0020.txt:101814
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: Hmm... No dobra.#D1#X2"
msgstr "P#HJÄLTE: Hm ... Okej då.#D1#X2"

#: dialog0020.txt:101901
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Książę to ma gadane lepsze niż ci kupcy."
msgstr "P#ANNAN: Ers nåd talar bättre än de här försäljarna."

#: dialog0020.txt:101902
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Co racja to racja."
msgstr "ANNAN: Sannerligen."

#: dialog0020.txt:101903
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Więc zostanę uwolniony?"
msgstr "ANNAN: Så, kan jag gå nu?"

#: dialog0020.txt:101904
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Zobaczymy, muszę się zastanowić...#X1"
msgstr "HJÄLTE: Vi får se, jag måste tänka på saken ...#X1"

#: dialog0021.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Wytrychy i fałszywe kości."
msgstr "HJÄLTE: Dyrkar och manipulerade tärningar."

#: dialog0021.txt:2
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"P#HERO: A więc jednak jesteś właściwym człowiekiem|na właściwym miejscu."
msgstr "P#HJÄLTE: Så du är rätt man på rätt plats."

#: dialog0021.txt:3
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Zwracam honor do kieszeni. Nie masz|chropowatych paluchów."
msgstr "HJÄLTE: Jag tar tillbaka allt – dina händer är inte valkiga."

#: dialog0021.txt:4
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Kłaniam się do stóp, książę. I proszę|o zwrot narzędzi pracy."
msgstr ""
"ANNAN: Jag är tacksam, ers nåd. Kan jag få tillbaka mina arbetsredskap?"

#: dialog0021.txt:5
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Co to to nie. Nie mogę przecież|popierać przestępczości!"
msgstr "HJÄLTE: Absolut inte. Jag kan inte godkänna brott."

#: dialog0021.txt:6
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ależ książę!..."
msgstr "ANNAN: Men ..."

#: dialog0021.txt:7
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Co za ironia losu, okraść złodzieja."
msgstr "HJÄLTE: Att råna en tjuv, vilken ironi."

#: dialog0021.txt:8
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"HERO: Mam nadzieję, że to cię czegoś nauczy|i porzucisz ten niecny proceder."
msgstr "HJÄLTE: Jag hoppas att du har lärt dig en värdefull läxa i dag."

#: dialog0021.txt:9
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: <westchnienie>"
msgstr "ANNAN: <suckar>"

#: dialog0022.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Do licha, znowu będę musiał|dorobić nowy komplet."
msgstr "ANNAN: Oj, nu måste jag göra en ny uppsättning igen."

#: dialog0023.txt:1
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Dzień dobry."
msgstr "HJÄLTE: God dag."

#: dialog0023.txt:2
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Dzień dobry, książę. Czym mogę służyć?"
msgstr "ANNAN: God dag, ers nåd. Hur kan jag hjälpa till?"

#: dialog0023.txt:103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$0: Słyszałeś waszmość co mówił herold?"
msgstr "$0: Hörde du stadens utropare?"

#: dialog0023.txt:104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$1: Jak tam interesy?"
msgstr "$1: Hur går affärerna?"

#: dialog0023.txt:105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$2: Czy waszmość znasz jakieś demony?"
msgstr "$2: Känner du till några ... demoner?"

#: dialog0023.txt:106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$3: Ech, nic tam, porozmawiamy później."
msgstr "$3: Hur som helst pratar vi senare."

#: dialog0023.txt:207
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$4: Cóż... No wiesz waszmość..."
msgstr "$4: Tja ... Du vet ..."

#: dialog0023.txt:208
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$5: Nie jestem prawdziwym księciem."
msgstr "$5: Jag är ingen riktig furste."

#: dialog0023.txt:209
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "$6: Dowcip? Były inne?"
msgstr "$6: Skämt? Fanns det andra?"

#: dialog0023.txt:100001
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Tak, wasza wysokość."
msgstr "ANNAN: Ja, ers kungliga höghet."

#: dialog0023.txt:100002
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Tuszę, iż to kolejny dowcip waszej wysokości,|nieprawdaż?#B1"
msgstr ""
"ANNAN: Jag slår vad om att det är ännu ett av era skämt, ers majestät?#B1"

#: dialog0023.txt:100101
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Jak to zawsze u dobrych kupców."
msgstr "ANNAN: Som vanligt för goda köpmän."

#: dialog0023.txt:100102
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Daniny za wysokie, rynek nasycony,|towar nie schodzi."
msgstr ""
"ANNAN: Skatterna är för höga, marknaden är övermättad och varorna säljer "
"inte."

#: dialog0023.txt:100103
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Dzień jak co dzień."
msgstr "ANNAN: En dag som alla andra."

#: dialog0023.txt:100104
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Ale łańcuch waszmość masz fachowy."
msgstr "HJÄLTE: Men ditt halsband ser rätt gediget ut."

#: dialog0023.txt:100105
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Cóż, głodem jeszcze nie przymieram,|ale jak tak dalej pójdzie, to "
"będę musiał|przestać karmić konie kawiorem."
msgstr ""
"ANNAN: Jag svälter inte än, men om det fortsätter så här måste jag sluta ge "
"mina hästar kaviar."

#: dialog0023.txt:100106
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#HERO: No tak, a tego byśmy nie chcieli...#B0"
msgstr "P#HJÄLTE: Just det ... Det vill vi inte. #B0"

#: dialog0023.txt:100201
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Na bogów Południa, książę!"
msgstr "ANNAN: Vid de södra gudarna, furste!"

#: dialog0023.txt:100202
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Co prawda na naszej drodze mijaliśmy jakiś zamek,|w którym ponoć żyją"
" wampiry, ale nigdy w życiu|nie miałem do czynienia z mocami nieczystymi!"
msgstr ""
"ANNAN: Vi passerade visserligen ett slott som sades vara fullt av vampyrer, "
"men jag har aldrig haft att göra med oheliga krafter."

#: dialog0023.txt:100203
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: O ile, oczywiście, odliczymy|poborców podatkowych.#F1#B0"
msgstr "ANNAN: Skatteindrivare räknas förstås inte.#F1#B0"

#: dialog0023.txt:100301
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Zawsze do usług, książę.#E3"
msgstr "ANNAN: Alltid till er tjänst, furste.#E3"

#: dialog0023.txt:100401
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Sprytny i przebiegły. Powinienem|to wiedzieć."
msgstr "HJÄLTE: Listig som en räv, det borde jag ha vetat."

#: dialog0023.txt:100402
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Skarbnik ojca waszej wysokości|też tak uważa."
msgstr "ANNAN: Hans höghets skattmästare håller med."

#: dialog0023.txt:100403
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "HERO: Nie wątpię...#B0"
msgstr "HJÄLTE: Utan tvekan ...#B0"

#: dialog0023.txt:100501
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Ależ oczywiście, oczywiście, książę."
msgstr "ANNAN: Självklart, självklart, furste."

#: dialog0023.txt:100502
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"HERO: Poważnie. Jestem zwykłym chłopakiem,|któremu demon ukradł duszę i "
"przeniósł|ją do ciała znanego wam księcia."
msgstr ""
"HJÄLTE: Jag menar allvar. Jag är bara en vanlig kille vars själ stals av en "
"demon och placerades i er furste."

#: dialog0023.txt:100503
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "P#OTHER: Naiwna bajeczka, książę. Ale może na|damach zrobi wrażenie."
msgstr ""
"P#ANNAN: Vilken charmig saga, furste. Men jag är säker på att den imponerar "
"på damerna."

#: dialog0023.txt:100504
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER: Chyba ci się już wyczerpują pomysły."
msgstr "ANNAN: Du verkar få slut på idéer."

#: dialog0023.txt:100505
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Hej, Stefanello, książę dzisiaj mówi, że|w jego ciele jest dusza "
"demona."
msgstr ""
"ANNAN: Hördu, Stefanello, fursten säger att en demon bor i hans kropp."

#: dialog0023.txt:100506
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid ""
"OTHER: Nie zaraz, że demon ukradł duszę innego|demona i... Ach, tam wszystko"
" mi się|pomyliło."
msgstr ""
"ANNAN: Nej, vänta. En demon stal en annan demons själ och ... Äsch, glöm "
"det."

#: dialog0023.txt:100507
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Co?"
msgstr "ANNAN2: Va?"

#: dialog0023.txt:100508
#, ignore-ellipsis, ignore-end-ellipsis, ignore-same
msgid "OTHER2: Zamiana dusz?"
msgstr "ANNAN2: Byter själar?"
