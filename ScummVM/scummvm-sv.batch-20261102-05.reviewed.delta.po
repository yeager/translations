#: engines/scumm/insane/mortimer/dialogs.cpp:50
#, ignore-ellipsis, ignore-same
msgid "Flight difficulty:"
msgstr "Flygsvårighetsgrad:"

#: engines/scumm/insane/mortimer/dialogs.cpp:51
#, ignore-ellipsis, ignore-same
msgid "Riddle difficulty:"
msgstr "Gåtsvårighetsgrad:"

#: engines/scumm/insane/mortimer/dialogs.cpp:56
#, ignore-ellipsis, ignore-same
msgid "Choose how difficult flying and recovering from crashes should be."
msgstr ""
"Välj hur svårt det ska vara att flyga och återhämta sig efter krascher."

#: engines/scumm/insane/mortimer/dialogs.cpp:59
#, ignore-ellipsis, ignore-same
msgid "Choose the riddle difficulty and the cost and number of guesses."
msgstr "Välj gåtans svårighetsgrad samt kostnad och antal gissningar."

#: engines/scumm/insane/mortimer/dialogs.cpp:62
#, ignore-ellipsis, ignore-same
msgid "Fixed (demo)"
msgstr "Fast (demo)"

#: engines/scumm/insane/mortimer/dialogs.cpp:63
#, ignore-ellipsis, ignore-same
msgid "The demo includes only one set of riddles."
msgstr "Demot innehåller endast en uppsättning gåtor."

#: engines/scumm/insane/mortimer/dialogs.cpp:143
#, ignore-ellipsis, ignore-same
msgid "Please enter a pilot name."
msgstr "Ange ett pilotnamn."

#: engines/scumm/insane/mortimer/dialogs.cpp:143
#, ignore-ellipsis, ignore-same
msgid "Please enter a shorter pilot name."
msgstr "Ange ett kortare pilotnamn."

#: engines/scumm/insane/mortimer/dialogs.cpp:155
#, ignore-ellipsis, ignore-same
msgid "Select pilot"
msgstr "Välj pilot"

#: engines/scumm/insane/mortimer/dialogs.cpp:156
#, ignore-ellipsis, ignore-same
msgid "Progress is saved after each riddle is solved."
msgstr "Framstegen sparas efter varje löst gåta."

#: engines/scumm/insane/mortimer/dialogs.cpp:162
#, ignore-ellipsis, ignore-same
msgid "High Scores"
msgstr "Topplistor"

#: engines/scumm/insane/mortimer/dialogs.cpp:163
#, ignore-ellipsis, ignore-same
msgid "Play Mortimer"
msgstr "Spela Mortimer"

#: engines/scumm/insane/mortimer/mortimer.cpp:76
#, ignore-ellipsis, ignore-same
msgid "Skip cutscene / open menu"
msgstr "Hoppa över mellansekvens / öppna meny"

#: engines/scumm/insane/mortimer/mortimer.cpp:80
#, ignore-ellipsis, ignore-same
msgid "Mouse control"
msgstr "Musstyrning"

#: engines/scumm/insane/mortimer/mortimer.cpp:81
#, ignore-ellipsis, ignore-same
msgid "Joystick control"
msgstr "Styrspaksstyrning"

#: engines/scumm/insane/mortimer/mortimer.cpp:1250
#, ignore-ellipsis, ignore-same
msgid "Could not save the high scores. Please try again."
msgstr "Kunde inte spara topplistorna. Försök igen."

#: engines/scumm/insane/mortimer/mortimer.cpp:1362
#, ignore-ellipsis, ignore-same
msgid "Play again?"
msgstr "Spela igen?"

#: engines/scumm/insane/mortimer/saveload.cpp:49
#, ignore-ellipsis, ignore-same
msgid "Progress is saved automatically when a riddle is solved."
msgstr "Framstegen sparas automatiskt när en gåta löses."

#: engines/scumm/insane/mortimer/saveload.cpp:111
#, ignore-ellipsis, ignore-same
msgid ""
"Could not save your pilot. Progress will be saved again when you finish "
"another riddle or quit."
msgstr ""
"Kunde inte spara din pilot. Framstegen sparas igen när du löser en annan "
"gåta eller avslutar."

#: engines/scumm/insane/mortimer/saveload.cpp:141
#, ignore-ellipsis, ignore-same
msgid ""
"There are no free pilot slots. Delete a saved pilot from the launcher before"
" creating another."
msgstr ""
"Det finns inga lediga pilotplatser. Ta bort en sparad pilot från "
"startprogrammet innan du skapar en ny."

