    },
    {
      "stringId": 137396,
      "source": "User gets greatest rights of all roles assigned to the user or the user's group(s)",
      "target": "Användaren får de största rättigheterna av alla roller som tilldelats användaren eller användarens grupper.",
      "translationId": 2531907,
      "status": 201
    },
    {
      "stringId": 137400,
      "source": "If a user is a member of several groups only the respective rights from the group assigned to the current record are used.",
      "target": "Om en användare är medlem i flera grupper används endast rättigheterna från gruppen som tilldelats den aktuella posten.",
      "translationId": 2531917,
      "status": 201
    },
    {
      "stringId": 137402,
      "source": "User Role Precedence",
      "target": "Användarrollers företräde",
      "translationId": 2531921,
      "status": 201
    },
    {
      "stringId": 137404,
      "source": "If any role is assigned directly to a user that role should take precedence over any group roles.",
      "target": "Om en roll tilldelas direkt till en användare ska den rollen ha företräde framför grupproller.",
      "translationId": 2531911,
      "status": 201
    },
    {
      "stringId": 137406,
      "source": "Group Inheritance Rules",
      "target": "Regler för grupparv",
      "translationId": 2531913,
      "status": 201
    },
    {
      "stringId": 137408,
      "source": "Inherit from Created By User",
      "target": "Ärv från användaren som skapade posten",
      "translationId": 2531909,
      "status": 201
    },
    {
      "stringId": 137410,
      "source": "The record will inherit all the groups assigned to the user who created it.",
      "target": "Posten ärver alla grupper som tilldelats användaren som skapade den.",
      "translationId": 2531915,
      "status": 201
    },
    {
      "stringId": 137412,
      "source": "Inherit from Parent Record",
      "target": "Ärv från överordnad post",
      "translationId": 2531919,
      "status": 201
    },
    {
      "stringId": 137414,
      "source": "e.g. If a case is created for a contact the case will inherit the groups associated with the contact.",
      "target": "Om till exempel ett ärende skapas för en kontakt ärver ärendet grupperna som är kopplade till kontakten.",
      "translationId": 2531923,
      "status": 201
    },
    {
      "stringId": 137416,
      "source": "New User Group Popup",
      "target": "Popup för ny användargrupp",
      "translationId": 2531925,
      "status": 201
    },
    {
      "stringId": 137418,
      "source": "When creating a new user show the SecurityGroups popup to assign the user to a group(s).",
      "target": "Visa SecurityGroups-popupen när en ny användare skapas för att tilldela användaren till grupper.",
      "translationId": 2531927,
      "status": 201
    },
    {
      "stringId": 137420,
      "source": "Inherit from Assigned To User",
      "target": "Ärv från användaren som posten är tilldelad till",
      "translationId": 2531929,
      "status": 201
    },
    {
      "stringId": 137422,
      "source": "The record will inherit all the groups of the user assigned to the record. Other groups assigned to the record will NOT be removed.",
      "target": "Posten ärver alla grupper från användaren som tilldelats posten. Andra grupper som tilldelats posten tas INTE bort.",
      "translationId": 2531937,
      "status": 201
    },
    {
      "stringId": 137424,
      "source": "Use Creator Group Select",
      "target": "Använd val av skapargrupp",
      "translationId": 2531933,
      "status": 201
    },
    {
      "stringId": 137426,
      "source": "When a record is created by a user in more than one group show a group selection panel on the create screen. Otherwise inherit that one group.",
      "target": "När en post skapas av en användare i fler än en grupp visas en gruppvalspanel på skärmen för att skapa posten. Annars ärvs den enda gruppen.",
      "translationId": 2531935,
      "status": 201
    },
    {
      "stringId": 137430,
      "source": "Non-admin users can only assign to users in the same group(s)",
      "target": "Icke-administratörer kan bara tilldela användare i samma grupper.",
      "translationId": 2531931,
      "status": 201
    },
