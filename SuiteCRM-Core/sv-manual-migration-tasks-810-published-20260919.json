  {
    "stringId": 216870,
    "identifier": "$mod_strings['LBL_RUN_MIGRATION_CONFIRMATION']",
    "source": "Are you sure you want to run this migration?",
    "target": "Vill du köra denna migrering?",
    "translationId": 2527905,
    "status": null
  },
  {
    "stringId": 216872,
    "identifier": "$mod_strings['LBL_RERUN_CONFIRMATION']",
    "source": "Are you sure you want to re-run this migration from scratch? All existing items will be removed and the migration will restart.",
    "target": "Vill du köra om denna migrering från början? Alla befintliga poster tas bort och migreringen startar om.",
    "translationId": 2527907,
    "status": null
  },
  {
    "stringId": 216874,
    "identifier": "$mod_strings['LBL_RERUN_SUCCESS']",
    "source": "Migration has been re-queued and will restart from the beginning.",
    "target": "Migreringen har köats på nytt och startar om från början.",
    "translationId": 2527909,
    "status": null
  },
  {
    "stringId": 216876,
    "identifier": "$mod_strings['LBL_DISMISS_CONFIRMATION']",
    "source": "Are you sure you want to dismiss this migration task? This will remove it and all associated data.",
    "target": "Vill du avfärda denna migreringsuppgift? Den tas bort tillsammans med alla associerade data.",
    "translationId": 2527911,
    "status": null
  },
  {
    "stringId": 216878,
    "identifier": "$mod_strings['LBL_DISMISS_SUCCESS']",
    "source": "Migration task dismissed successfully.",
    "target": "Migreringsuppgiften avfärdades.",
    "translationId": 2527913,
    "status": null
  },
  {
    "stringId": 216880,
    "identifier": "$mod_strings['LBL_TYPE_BACKGROUND_HELP']",
    "source": "This migration runs in the background via the message queue worker. It processes items in batches and does not block the UI.",
    "target": "Denna migrering körs i bakgrunden via meddelandeköarbetaren. Den bearbetar poster i batcher och blockerar inte gränssnittet.",
    "translationId": 2527915,
    "status": null
  },
  {
    "stringId": 216882,
    "identifier": "$mod_strings['LBL_TYPE_IMMEDIATE_HELP']",
    "source": "This migration runs immediately when triggered. It processes all items in a single request and may take longer for large datasets.",
    "target": "Denna migrering körs omedelbart när den utlöses. Den bearbetar alla poster i en enda begäran och kan ta längre tid för stora datamängder.",
    "translationId": 2527917,
    "status": null
  },
  {
    "stringId": 216884,
    "identifier": "$mod_strings['LBL_MESSENGER_SETUP']",
    "source": "Background Task Configuration",
    "target": "Konfiguration av bakgrundsuppgift",
    "translationId": 2527919,
    "status": null
  },
  {
    "stringId": 216886,
    "identifier": "$mod_strings['LBL_MESSENGER_SETUP_DESC1']",
    "source": "Migration tasks are processed in the background.",
    "target": "Migreringsuppgifter bearbetas i bakgrunden.",
    "translationId": 2527921,
    "status": null
  },
  {
    "stringId": 216888,
    "identifier": "$mod_strings['LBL_MESSENGER_SETUP_DESC2']",
    "source": "To ensure these tasks complete successfully, please ensure a Symfony Messenger worker is running.",
    "target": "För att uppgifterna ska slutföras måste en Symfony Messenger-arbetare köras.",
    "translationId": 2527923,
    "status": null
  },
  {
    "stringId": 216890,
    "identifier": "$mod_strings['LBL_MESSENGER_SETUP_DESC3']",
    "source": "Without an active worker, tasks will stay in a \"Pending\" state.",
    "target": "Utan en aktiv arbetare blir uppgifterna kvar i tillståndet ”Väntande”.",
    "translationId": 2527925,
    "status": null
  },
  {
