msgid "say duration_exact(86399);"
msgstr "   säg duration_exact(86399);"

#. Description
#: Package: libtime-duration-perl
msgid "will correctly give \"23 hours, 59 minutes, and 59 seconds\","
msgstr "kommer korrekt att ge \"23 timmar, 59 minuter och 59 sekunder\","

#. Description
#: Package: libtime-duration-perl
msgid "say ago(86399);"
msgstr "   säg förut (86399);"

