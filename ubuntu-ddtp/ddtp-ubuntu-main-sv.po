msgstr "bibliotek för att skicka menyer via DBus – GTK-3+-version"

#. Description
#: Package: libdbusmenu-gtk3-4
msgid ""
"This package contains shared libraries to be used by GTK-3+ applications."
msgstr ""
"Detta paket innehåller delade bibliotek som ska användas av "
"GTK-3+-applikationer."

#. Summary
#: Package: libdbusmenu-gtk3-dev
msgid "library for passing menus over DBus - GTK-3+ version development files"
msgstr ""
"bibliotek för överföring av menyer via DBus – GTK-3+ version "
"utvecklingsfiler"

#. Description
#: Package: libdbusmenu-gtk3-dev
msgid ""
"This package contains files that are needed to build GTK-3+ applications."
msgstr ""
