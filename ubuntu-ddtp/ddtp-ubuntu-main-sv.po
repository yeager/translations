msgid "GStreamer core development files"
msgstr "GStreamer-kärnutvecklingsfiler"

#. Description
#: Package: libgstreamer1.0-dev Package: libgstreamer1.0-0 Package:
#: libgstreamer-plugins-extra1.0-dev Package: libgstreamer-plugins-extra1.0-0
#: Package: libgstreamer-plugins-base1.0-dev Package:
#: libgstreamer-plugins-base1.0-0 Package: libgstreamer-gl1.0-0 Package:
#: gstreamer1.0-x Package: gstreamer1.0-tools Package:
