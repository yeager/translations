#: /app/master/src/composables/useListKind.ts:24
msgid "All inventories"
msgstr "Alla förvaringsplatser"

#: /app/master/src/composables/useListKind.ts:25
msgid "Items from every inventory in this house."
msgstr "Varor från alla förvaringsplatser i det här hemmet."

#: /app/master/src/specialVueFakeDummyForL10nScript.js:11283
msgid "Amount of {item} put away in {storage}"
msgstr "Antal {item} som lagts undan i {storage}"

#. TRANSLATORS: Heading of the trip review section where bought items are
#. assigned to inventories (fridge, freezer …).
#: /app/master/src/specialVueFakeDummyForL10nScript.js:11291
msgid "Put away"
msgstr "Lägg undan"

#: /app/master/src/specialVueFakeDummyForL10nScript.js:11292
msgid ""
"Choose where what you bought goes. Each item starts where it usually goes."
msgstr ""
"Välj var dina inköp ska förvaras. Varje vara börjar där den vanligtvis "
"förvaras."

#: /app/master/src/specialVueFakeDummyForL10nScript.js:11295
msgid "Remove from this storage"
msgstr "Ta bort från den här förvaringsplatsen"

#: /app/master/src/specialVueFakeDummyForL10nScript.js:11296
msgid "Add to a storage …"
msgstr "Lägg till på en förvaringsplats …"

#: /app/master/src/specialVueFakeDummyForL10nScript.js:11297
msgid "Not put away"
msgstr "Inte undanlagd"

#: /app/master/src/specialVueFakeDummyForL10nScript.js:11298
msgid "Unknown inventory"
msgstr "Okänd förvaringsplats"

#: /app/master/src/specialVueFakeDummyForL10nScript.js:11706
msgid ""
"Adds \"{item}\" to the list you pick and links it, so it goes back on it "
"when it runs low."
msgstr ""
"Lägger till \"{item}\" i listan du väljer och länkar den, så att den läggs "
"till där igen när lagret är lågt."

#. TRANSLATORS: Title of the dialog that adds an inventory item to a shopping
#. list and links it there.
#: /app/master/src/specialVueFakeDummyForL10nScript.js:11714
msgid "Add to a shopping list"
msgstr "Lägg till i en inköpslista"

#: /app/master/src/specialVueFakeDummyForL10nScript.js:11843
msgid "Add to a shopping list …"
msgstr "Lägg till i en inköpslista …"
