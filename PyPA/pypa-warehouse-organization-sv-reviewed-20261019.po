msgstr ""
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

msgid "This organization account name has already been used. Choose a different organization account name."
msgstr "Det här organisationskontonamnet används redan. Välj ett annat organisationskontonamn."

msgid "You have already submitted an application for that name. Choose a different organization account name."
msgstr "Du har redan skickat in en ansökan för det namnet. Välj ett annat organisationskontonamn."

msgid "Select project"
msgstr "Välj projekt"

msgid "Specify project name"
msgstr "Ange projektnamn"

msgid "Start and end with a letter or numeral containing only ASCII numeric and '.', '_' and '-'."
msgstr "Börja och sluta med en bokstav eller siffra. Endast ASCII-siffror samt '.', '_' och '-' tillåts."

msgid "This project name has already been used. Choose a different project name."
msgstr "Det här projektnamnet används redan. Välj ett annat projektnamn."

msgid "Cannot transfer to Company Organization with inactive billing"
msgstr "Det går inte att överföra till en företagsorganisation med inaktiv fakturering"

msgid "The organization name is too long. Choose a organization name with 100 characters or less."
msgstr "Organisationsnamnet är för långt. Välj ett organisationsnamn med högst 100 tecken."

msgid "The organization URL is too long. Choose a organization URL with 400 characters or less."
msgstr "Organisationens URL är för lång. Välj en organisations-URL med högst 400 tecken."

msgid "The organization URL must start with http:// or https://"
msgstr "Organisationens URL måste börja med http:// eller https://"

msgid "The organization description is too long. Choose a organization description with 400 characters or less."
msgstr "Organisationsbeskrivningen är för lång. Välj en organisationsbeskrivning med högst 400 tecken."

msgid "We don't need to know quite that much :), limit your usage description to 1024 characters or less."
msgstr "Vi behöver inte veta riktigt så mycket. Begränsa användningsbeskrivningen till högst 1024 tecken."

msgid "You have already submitted the maximum number of Organization requests (${count})."
msgstr "Du har redan skickat in det högsta antalet organisationsförfrågningar (${count})."

msgid "Choose a team name with 50 characters or less."
msgstr "Välj ett lagnamn med högst 50 tecken."

msgid "The team name is invalid. Team names cannot start or end with a space, period, underscore, hyphen, or slash. Choose a different team name."
msgstr "Lagnamnet är ogiltigt. Lagnamn får inte börja eller sluta med ett mellanslag, en punkt, ett understreck, ett bindestreck eller ett snedstreck. Välj ett annat lagnamn."

msgid "This team name has already been used. Choose a different team name."
msgstr "Det här lagnamnet används redan. Välj ett annat lagnamn."

msgid "Account details updated"
msgstr "Kontouppgifterna har uppdaterats"

msgid "Email ${email_address} added - check your email for a verification link"
msgstr "E-postadressen ${email_address} har lagts till – kontrollera din e-post efter en verifieringslänk"

msgid "Recovery codes already generated"
msgstr "Återställningskoder har redan skapats"

msgid "Generating new recovery codes will invalidate your existing codes."
msgstr "Om du skapar nya återställningskoder blir dina befintliga koder ogiltiga."
