"Plural-Forms: nplurals=2; plural=n != 1;\n"

msgid "Could not find role invitation."
msgstr "Det gick inte att hitta rollinbjudan."

msgid "Invitation already expired."
msgstr "Inbjudan har redan upphört att gälla."

msgid "Invitation revoked from '${username}'."
msgstr "Inbjudan till '${username}' har återkallats."

msgid "Invalid OAuth state - possible CSRF attack"
msgstr "Ogiltigt OAuth-tillstånd – möjlig CSRF-attack"

msgid "GitHub OAuth failed: ${error}"
msgstr "GitHub OAuth misslyckades: ${error}"

msgid "No authorization code received from GitHub"
msgstr "Ingen auktoriseringskod togs emot från GitHub"

msgid "Successfully connected GitHub account @${username}"
msgstr "GitHub-kontot @${username} har anslutits"

msgid "Failed to connect GitHub account: ${error}"
msgstr "Det gick inte att ansluta GitHub-kontot: ${error}"

msgid "An unexpected error occurred while connecting your GitHub account"
msgstr "Ett oväntat fel uppstod när ditt GitHub-konto anslöts"

msgid "GitLab OAuth failed: ${error}"
msgstr "GitLab OAuth misslyckades: ${error}"

msgid "No authorization code received from GitLab"
msgstr "Ingen auktoriseringskod togs emot från GitLab"

msgid "Successfully connected GitLab account @${username}"
msgstr "GitLab-kontot @${username} har anslutits"

msgid "Failed to connect GitLab account: ${error}"
msgstr "Det gick inte att ansluta GitLab-kontot: ${error}"

msgid "An unexpected error occurred while connecting your GitLab account"
msgstr "Ett oväntat fel uppstod när ditt GitLab-konto anslöts"

msgid "Removed ${service} account @${username}"
msgstr "${service}-kontot @${username} har tagits bort"

msgid "Failed to remove account association"
msgstr "Det gick inte att ta bort kontoanslutningen"

msgid "The trusted publisher could not be constrained"
msgstr "Det gick inte att begränsa den betrodda publiceraren"

msgid "GitHub-based trusted publishing is temporarily disabled. See https://pypi.org/help#admin-intervention for details."
msgstr "Betrodd publicering via GitHub är tillfälligt inaktiverad. Se https://pypi.org/help#admin-intervention för mer information."

msgid "GitLab-based trusted publishing is temporarily disabled. See https://pypi.org/help#admin-intervention for details."
msgstr "Betrodd publicering via GitLab är tillfälligt inaktiverad. Se https://pypi.org/help#admin-intervention för mer information."

msgid "Google-based trusted publishing is temporarily disabled. See https://pypi.org/help#admin-intervention for details."
msgstr "Betrodd publicering via Google är tillfälligt inaktiverad. Se https://pypi.org/help#admin-intervention för mer information."

msgid "ActiveState-based trusted publishing is temporarily disabled. See https://pypi.org/help#admin-intervention for details."
msgstr "Betrodd publicering via ActiveState är tillfälligt inaktiverad. Se https://pypi.org/help#admin-intervention för mer information."
