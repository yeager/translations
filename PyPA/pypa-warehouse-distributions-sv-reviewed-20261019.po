#: warehouse/templates/includes/manage/manage-team-menu.html:2
#, python-format
msgid "Navigation for managing %(team)s"
msgstr "Navigering för hantering av %(team)s"

#: warehouse/templates/includes/packaging/project-description.html:14
msgid "The author of this package has not provided a project description"
msgstr ""
"Författaren till det här paketet har inte angett någon projektbeskrivning"

#: warehouse/templates/includes/packaging/project-files.html:9
#, python-format
msgid "Release files for %(name)s %(version)s"
msgstr "Utgåvefiler för %(name)s %(version)s"

#: warehouse/templates/includes/packaging/project-files.html:11
#, python-format
msgid ""
"For a detailed explanation of source distributions (sdists) and built "
"distributions (wheels), please see the <a href=\"%(href)s\" "
"title=\"%(title)s\" target=\"_blank\" rel=\"noopener\">package formats "
"documentation</a>."
msgstr ""
"En utförlig förklaring av källdistributioner, sdists och byggda "
"distributioner, wheels, finns i <a href=\"%(href)s\" title=\"%(title)s\" "
"target=\"_blank\" rel=\"noopener\">dokumentationen om paketformat</a>."

#: warehouse/templates/includes/packaging/project-files.html:22
#, python-format
msgid ""
"%(count)s file was uploaded more than %(days)s days after the first file in "
"this release."
msgid_plural ""
"%(count)s files were uploaded more than %(days)s days after the first file "
"in this release."
msgstr[0] ""
"%(count)s fil laddades upp mer än %(days)s dagar efter den första filen i "
"utgåvan."
msgstr[1] ""
"%(count)s filer laddades upp mer än %(days)s dagar efter den första filen i "
"utgåvan."

#: warehouse/templates/includes/packaging/project-files.html:27
msgid "We recommend inspecting the release files before installing."
msgstr ""
"Vi rekommenderar att du granskar utgåvefilerna innan du installerar dem."

