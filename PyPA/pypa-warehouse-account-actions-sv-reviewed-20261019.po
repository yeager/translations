msgid "Verify your email to create an API token."
msgstr "Verifiera din e-postadress för att skapa en API-token."

msgid "API Token does not exist."
msgstr "API-token finns inte."

msgid "Invalid credentials. Try again"
msgstr "Ogiltiga inloggningsuppgifter. Försök igen"

msgid "Project deletion temporarily disabled. See https://pypi.org/help#admin-intervention for details."
msgstr "Borttagning av projekt är tillfälligt inaktiverad. Se https://pypi.org/help#admin-intervention för mer information."

msgid "Could not delete project - acknowledge all of the consequences to continue"
msgstr "Det gick inte att ta bort projektet – bekräfta att du är införstådd med samtliga konsekvenser för att fortsätta"

msgid "This release is in quarantine and cannot be modified."
msgstr "Den här utgåvan är i karantän och kan inte ändras."

msgid "Confirm the request"
msgstr "Bekräfta begäran"

msgid "Could not yank release - "
msgstr "Det gick inte att dra tillbaka utgåvan – "

msgid "Could not un-yank release - "
msgstr "Det gick inte att ångra tillbakadragningen av utgåvan – "

msgid "Could not delete release - "
msgstr "Det gick inte att ta bort utgåvan – "

msgid "Could not delete release - acknowledge all of the consequences to continue"
msgstr "Det gick inte att ta bort utgåvan – bekräfta att du är införstådd med samtliga konsekvenser för att fortsätta"

msgid "Could not find file"
msgstr "Det gick inte att hitta filen"

msgid "Could not delete file - "
msgstr "Det gick inte att ta bort filen – "

msgid "Could not delete file - acknowledge all of the consequences to continue"
msgstr "Det gick inte att ta bort filen – bekräfta att du är införstådd med samtliga konsekvenser för att fortsätta"

msgid "Team '${team_name}' already has ${role_name} role for project"
msgstr "Teamet '${team_name}' har redan rollen ${role_name} i projektet"

msgid "User '${username}' already has ${role_name} role for project"
msgstr "Användaren '${username}' har redan rollen ${role_name} i projektet"

msgid "${username} is now ${role} of the '${project_name}' project."
msgstr "${username} har nu rollen ${role} i projektet '${project_name}'."

msgid "User '${username}' does not have a verified primary email address and cannot be added as a ${role_name} for project"
msgstr "Användaren '${username}' har ingen verifierad primär e-postadress och kan inte läggas till som ${role_name} i projektet"

msgid "User '${username}' already has an active invite. Please try again later."
msgstr "Användaren '${username}' har redan en aktiv inbjudan. Försök igen senare."

msgid "Invitation sent to '${username}'"
msgstr "Inbjudan har skickats till '${username}'"
