#: warehouse/templates/includes/packaging/project-release-history.html:87
#, python-format
msgid "Project archived on %(date)s"
msgstr "Projektet arkiverades %(date)s"

#: warehouse/templates/includes/packaging/project-release-history.html:95
#: warehouse/templates/includes/packaging/project-status.html:84
msgid "Pre-release"
msgstr "Förhandsutgåva"

#: warehouse/templates/includes/packaging/project-release-history.html:118
msgid "Yanked reason:"
msgstr "Orsak till tillbakadragandet:"

#: warehouse/templates/includes/packaging/project-security.html:7
msgid "Security for"
msgstr "Säkerhet för"

#: warehouse/templates/includes/packaging/project-status.html:24
#: warehouse/templates/includes/packaging/project-status.html:36
#: warehouse/templates/manage/project/releases.html:25
msgid "Quarantined"
msgstr "Satt i karantän"

#: warehouse/templates/includes/packaging/project-status.html:27
#, python-format
msgid ""
"This project has been <a href=\"%(href)s\">quarantined</a> by PyPI admins. "
"It cannot be installed or modified until a security review is complete."
msgstr ""
"Projektet har <a href=\"%(href)s\">satts i karantän</a> av PyPI:s "
"administratörer. Det kan inte installeras eller ändras förrän "
"säkerhetsgranskningen är klar."

#: warehouse/templates/includes/packaging/project-status.html:39
#, python-format
msgid ""
"This release has been <a href=\"%(href)s\">quarantined</a> by PyPI admins. "
"It cannot be installed or modified until a security review is complete."
msgstr ""
"Utgåvan har <a href=\"%(href)s\">satts i karantän</a> av PyPI:s "
"administratörer. Den kan inte installeras eller ändras förrän "
"säkerhetsgranskningen är klar."

#: warehouse/templates/includes/packaging/project-status.html:42
#: warehouse/templates/includes/packaging/project-status.html:58
#, python-format
msgid "Consider using <a href=\"%(href)s\">release %(version)s</a> instead."
msgstr ""
"Överväg att använda <a href=\"%(href)s\">utgåva %(version)s</a> i stället."

#: warehouse/templates/includes/packaging/project-status.html:55
#, python-format
msgid ""
"This release has been <a href=\"%(href)s\">yanked</a> by its maintainers, "
"and will be ignored by installers, except when explicitly specified."
msgstr ""
"Utgåvan har <a href=\"%(href)s\">dragits tillbaka</a> av dess underhållare "
"och ignoreras av installationsprogram, utom när den anges uttryckligen."

#: warehouse/templates/includes/packaging/project-status.html:62
msgid "Reason given by maintainers:"
msgstr "Underhållarnas angivna orsak:"

#: warehouse/templates/includes/packaging/project-status.html:75
#, python-format
msgid ""
"This project has been <a href=\"%(href)s\">archived</a> by its maintainers, "
"and is no longer receiving any updates."
msgstr ""
"Projektet har <a href=\"%(href)s\">arkiverats</a> av dess underhållare och "
"får inte längre några uppdateringar."
