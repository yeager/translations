#: warehouse/templates/index.html:18
msgid "Test Python package publishing with the Test Python Package Index"
msgstr "Testa publicering av Python-paket med Test Python Package Index"

#: warehouse/templates/index.html:20
msgid "Develop the codebase behind PyPI with the Dev Python Package Index"
msgstr "Utveckla kodbasen bakom PyPI med Dev Python Package Index"

#: warehouse/templates/index.html:22
msgid ""
"Find, install and publish Python packages with the Python Package Index"
msgstr "Hitta, installera och publicera Python-paket med Python Package Index"

#: warehouse/templates/index.html:49
#, python-format
msgid "Or <a href=\"%(href)s\">browse projects</a>"
msgstr "Eller <a href=\"%(href)s\">bläddra bland projekt</a>"

#: warehouse/templates/index.html:52
#, python-format
msgid "Publishing as a team? Use an <a href=\"%(href)s\">organization account</a>"
msgstr ""
"Publicerar ni som ett team? Använd ett <a "
"href=\"%(href)s\">organisationskonto</a>"

