#: warehouse/templates/re-auth.html:5
msgid "Error processing form"
msgstr "Fel vid behandling av formuläret"

#: warehouse/templates/re-auth.html:19
msgid "Confirm password to continue"
msgstr "Bekräfta lösenordet för att fortsätta"

#: warehouse/templates/re-auth.html:77
#, python-format
msgid ""
"<b>Tip:</b> you are about to perform a <a href=\"%(href)s\">sensitive "
"action</a>. If you are not on a personal computer, make sure to log out once"
" you're done with your session. We won't ask you to confirm your password "
"again for the next hour."
msgstr ""
"<b>Tips:</b> Du ska precis utföra en <a href=\"%(href)s\">känslig "
"åtgärd</a>. Om du inte använder en personlig dator ska du logga ut när "
"sessionen är klar. Vi ber dig inte bekräfta lösenordet igen under den "
"närmaste timmen."

#: warehouse/templates/upload.html:12
msgid "This URL is an API endpoint for uploading files to PyPI."
msgstr "Den här URL:en är en API-ändpunkt för att ladda upp filer till PyPI."

#: warehouse/templates/upload.html:14
#, python-format
msgid ""
"For more information on uploading projects to PyPI, visit the <a "
"href=\"%(href)s\" title=\"%(title)s\" target=\"_blank\" "
"rel=\"noopener\">Python Packaging User Guide</a>."
msgstr ""
"Mer information om att ladda upp projekt till PyPI finns i <a "
"href=\"%(href)s\" title=\"%(title)s\" target=\"_blank\" "
"rel=\"noopener\">Python Packaging User Guide</a>."

#: warehouse/templates/upload.html:17
#, python-format
msgid ""
"Otherwise, we suggest you <a href=\"%(href)s\">go to the PyPI homepage</a>."
msgstr ""
"Vi föreslår annars att du <a href=\"%(href)s\">går till PyPI:s "
"startsida</a>."

#: warehouse/templates/accounts/invite-confirmation.html:4
msgid "Confirm Invite"
msgstr "Bekräfta inbjudan"

#: warehouse/templates/accounts/invite-confirmation.html:21
#, python-format
msgid ""
"Would you like to accept this invitation to join '<a "
"href=\"%(project_link)s\">%(project_name)s</a>' as a project %(role_name)s?"
msgstr ""
"Vill du tacka ja till inbjudan att ansluta till ”<a "
"href=\"%(project_link)s\">%(project_name)s</a>” som %(role_name)s för "
"projektet?"

#: warehouse/templates/accounts/invite-confirmation.html:39
#, python-format
msgid ""
"You must first enable <a href=\"%(href)s\">two-factor authentication</a> on "
"your account before accepting an invitation to join a project."
msgstr ""
"Du måste först aktivera <a href=\"%(href)s\">tvåfaktorsautentisering</a> för"
" kontot innan du kan tacka ja till en inbjudan att ansluta till ett projekt."

#: warehouse/templates/accounts/login.html:17
#, python-format
msgid "Log in to %(title)s"
msgstr "Logga in på %(title)s"

#: warehouse/templates/accounts/login.html:37
msgid "Your username"
msgstr "Ditt användarnamn"

#: warehouse/templates/accounts/logout.html:7
#, python-format
msgid "Log out of %(account_name)s"
msgstr "Logga ut från %(account_name)s"

#: warehouse/templates/accounts/organization-invite-confirmation.html:4
msgid "Confirm Organization Invite"
msgstr "Bekräfta organisationsinbjudan"

#: warehouse/templates/accounts/organization-invite-confirmation.html:21
#, python-format
msgid ""
"Would you like to accept this invitation to join '%(organization_name)s' as "
"an organization %(role_name)s?"
msgstr ""
"Vill du tacka ja till inbjudan att ansluta till ”%(organization_name)s” som "
"%(role_name)s för organisationen?"

#: warehouse/templates/accounts/organization-invite-confirmation.html:39
#, python-format
msgid ""
"You must first enable <a href=\"%(href)s\">two-factor authentication</a> on "
"your account before accepting an invitation to join an organization."
msgstr ""
"Du måste först aktivera <a href=\"%(href)s\">tvåfaktorsautentisering</a> för"
" kontot innan du kan tacka ja till en inbjudan att ansluta till en "
"organisation."
