#: warehouse/templates/index.html:100
msgid ""
"PyPI helps you find and install software developed and shared by the Python "
"community."
msgstr ""
"PyPI hjälper dig att hitta och installera programvara som utvecklats och "
"delas av Python-gemenskapen."

#: warehouse/templates/index.html:104
msgid "Learn about installing packages"
msgstr "Läs om att installera paket"

#: warehouse/templates/index.html:107
msgid "Package authors use PyPI to distribute their software."
msgstr "Paketförfattare använder PyPI för att distribuera sin programvara."

#: warehouse/templates/index.html:111
msgid "Learn how to package your Python code for PyPI"
msgstr "Lär dig att paketera Python-kod för PyPI"

#: warehouse/templates/accounts/login.html:5
#: warehouse/templates/accounts/recovery-code.html:5
