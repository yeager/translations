#. :src: bpy.types.UV_OT_pack_islands.shape_method:'AABB'
msgid "Uses bounding boxes"
msgstr "Använder begränsningsboxar"

#. :src: bpy.types.UV_OT_pack_islands.udim_source:'ORIGINAL_AABB'
msgid "Original bounding box"
msgstr "Ursprunglig begränsningsbox"

#. :src: bpy.types.UV_OT_pack_islands.udim_source:'ORIGINAL_AABB'
msgid "Pack to starting bounding box of islands"
msgstr "Packa till öarnas ursprungliga begränsningsbox"

#. :src: bpy.types.UV_OT_select_circle
msgid "Select UV vertices using circle selection"
msgstr "Välj UV-hörnpunkter med cirkelmarkering"

#. :src: bpy.types.UV_OT_select_edge_ring
msgid "Select an edge ring of connected UV vertices"
msgstr "Välj en kantring av sammankopplade UV-hörnpunkter"

#. :src: bpy.types.UV_OT_select_linked
msgid "Select all UV vertices linked to the active UV map"
msgstr "Markera alla UV-hörnpunkter som är kopplade till den aktiva UV-kartan"

#. :src: bpy.types.UV_OT_select_linked_pick
msgid "Select all UV vertices linked under the mouse"
msgstr "Markera alla UV-hörnpunkter som är länkade under musen"

#. :src: bpy.types.UV_OT_select_loop
msgid "Select a loop of connected UV vertices"
msgstr "Välj en slinga av sammankopplade UV-hörnpunkter"

#. :src: bpy.types.UV_OT_select_more
msgid "Select more UV vertices connected to initial selection"
msgstr "Välj fler UV-hörnpunkter som är kopplade till det ursprungliga valet"

#. :src: bpy.types.UV_OT_select_pinned
msgid "Select all pinned UV vertices"
msgstr "Markera alla fästa UV-hörnpunkter"
