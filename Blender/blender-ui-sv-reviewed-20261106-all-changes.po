#. :src: bpy.types.TextCurve.align_x:'FLUSH'
#. :src: bpy.types.GeometryNodeStringToCurves.align_x:'FLUSH'
msgid "Flush"
msgstr "Jämna marginaler"

#. :src: bpy.types.TextCurve.align_x:'FLUSH'
msgid "Align to the left and the right, with equal character spacing"
msgstr "Justera mot vänster och höger marginal med jämnt teckenavstånd"

#. :src: bpy.types.TextCurve.align_y:'TOP'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'TOP'
msgid "Align text to the top"
msgstr "Justera texten mot överkanten"

#. :src: bpy.types.TextCurve.align_y:'CENTER'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'MIDDLE'
msgid "Align text to the middle"
msgstr "Centrera texten vertikalt"

#. :src: bpy.types.TextCurve.align_y:'BOTTOM'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'BOTTOM'
msgid "Align text to the bottom"
msgstr "Justera texten mot nederkanten"

#. :src: bpy.types.TextCurve.follow_curve
msgid "Curve deforming text object"
msgstr "Kurva som deformerar textobjektet"

#. :src: bpy.types.TextCurve.font_bold
msgid "Font Bold"
msgstr "Fetstilt typsnitt"

#. :src: bpy.types.TextCurve.font_bold_italic
msgid "Font Bold Italic"
msgstr "Fetkursivt typsnitt"

#. :src: bpy.types.TextCurve.font_italic
msgid "Font Italic"
msgstr "Kursivt typsnitt"

#. :src: bpy.types.TextCurve.space_character
msgid "Global spacing between characters"
msgstr "Globalt teckenavstånd"

#. :src: bpy.types.Curve.bevel_factor_end
msgid ""
"Define where along the spline the curve geometry ends (0 for the beginning, "
"1 for the end)"
msgstr ""
"Definiera var längs kurvsplinen geometrin slutar (0 för början, 1 för slutet)"

#. :src: bpy.types.Curve.bevel_factor_mapping_end
msgid "End Mapping Type"
msgstr "Mappningstyp för slut"

#. :src: bpy.types.Curve.bevel_factor_mapping_end
msgid "Determine how the geometry end factor is mapped to a spline"
msgstr "Bestäm hur geometrins slutfaktor ska mappas till en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_mapping_end:'RESOLUTION'
#. :src: bpy.types.Curve.bevel_factor_mapping_start:'RESOLUTION'
msgid ""
"Map the geometry factor to the number of subdivisions of a spline (U "
"resolution)"
msgstr ""
"Mappa geometrifaktorn till antalet underindelningar i en kurvspline (U-"
"upplösning)"

#. :src: bpy.types.Curve.bevel_factor_mapping_end:'SPLINE'
#. :src: bpy.types.Curve.bevel_factor_mapping_start:'SPLINE'
msgid "Map the geometry factor to the length of a spline"
msgstr "Mappa geometrifaktorn till längden på en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_mapping_start
msgid "Start Mapping Type"
msgstr "Mappningstyp för start"

#. :src: bpy.types.Curve.bevel_factor_mapping_start
msgid "Determine how the geometry start factor is mapped to a spline"
msgstr "Bestäm hur geometrins startfaktor ska mappas till en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_start
msgid ""
"Define where along the spline the curve geometry starts (0 for the "
"beginning, 1 for the end)"
msgstr ""
"Definiera var längs kurvsplinen geometrin börjar (0 för början, 1 för slutet)"

#. :src: bpy.types.Curve.bevel_mode:'ROUND'
msgid "Use circle for the section of the curve's bevel geometry"
msgstr "Använd en cirkel som tvärsnitt för kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_mode:'OBJECT'
msgid "Use an object for the section of the curve's bevel geometry segment"
msgstr "Använd ett objekt som tvärsnitt för kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.splines
#. :src: bpy.types.MaskLayer.splines
msgid "Splines"
msgstr "Kurvsplines"

#. :src: bpy.types.Curve.splines
msgid "Collection of splines in this curve data object"
msgstr "Samling av kurvsplines i detta kurvdataobjekt"

#. :src: bpy.types.Curve.taper_object
msgid "Curve object name that defines the taper (width)"
msgstr "Namnet på kurvobjektet som definierar avsmalningens bredd"

#. :src: bpy.types.Curve.taper_radius_mode
msgid ""
"Determine how the effective radius of the spline point is computed when a "
"taper object is specified"
msgstr ""
"Bestäm hur den effektiva radien för splinepunkten beräknas när ett "
"avsmalningsobjekt har angetts"

#. :src: bpy.types.Curve.taper_radius_mode:'OVERRIDE'
msgid "Override the radius of the spline point with the taper radius"
msgstr "Åsidosätt splinepunktens radie med avsmalningsradien"

#. :src: bpy.types.Curve.use_deform_bounds
msgid "Bounds Clamp"
msgstr "Begränsa till meshgränser"

#. :src: bpy.types.Curve.use_deform_bounds
msgid "Option for curve-deform: Use the mesh bounds to clamp the deformation"
msgstr ""
"Alternativ för kurvdeformering: begränsa deformeringen till meshens gränser"

#. :src: bpy.types.Curve.use_map_taper
msgid "Map Taper"
msgstr "Mappa avsmalning"

#. :src: bpy.types.Curve.use_map_taper
msgid "Map effect of the taper object to the beveled part of the curve"
msgstr "Mappa avsmalningsobjektets effekt till den avfasade delen av kurvan"

#. :src: bpy.types.Camera.show_composition_center
msgid "Display center composition guide inside the camera view"
msgstr "Visa kompositionsguide för mitten i kameravyn"

#. :src: bpy.types.Camera.show_composition_center_diagonal
msgid "Display diagonal center composition guide inside the camera view"
msgstr "Visa diagonal kompositionsguide för mitten i kameravyn"

#. :src: bpy.types.Camera.show_composition_golden_tria_a
msgid "Golden Triangle A"
msgstr "Gyllene triangeln A"

#. :src: bpy.types.Camera.show_composition_golden_tria_a
msgid "Display golden triangle A composition guide inside the camera view"
msgstr "Visa kompositionsguide för gyllene triangeln A i kameravyn"

#. :src: bpy.types.Camera.show_composition_golden_tria_b
msgid "Golden Triangle B"
msgstr "Gyllene triangeln B"

#. :src: bpy.types.Camera.show_composition_golden_tria_b
msgid "Display golden triangle B composition guide inside the camera view"
msgstr "Visa kompositionsguide för gyllene triangeln B i kameravyn"

#. :src: bpy.types.Camera.show_passepartout
#. :src: bpy.types.View3DOverlay.show_camera_passepartout
msgid "Show Passepartout"
msgstr "Visa passepartout"

#. :src: bpy.types.Camera.show_safe_areas
msgid "Show TV title safe and action safe areas in Camera view"
msgstr "Visa säkra områden för tv-titel och handling i kameravyn"

#. :src: bpy.types.Camera.show_safe_center
msgid "Show Center-Cut Safe Areas"
msgstr "Visa säkra områden för mittbeskärning"

#. :src: bpy.types.Camera.show_sensor
msgid "Show sensor size (film gate) in Camera view"
msgstr "Visa sensorstorleken (filmruta) i kameravyn"

#. :src: bpy.types.Camera.panorama_type:'EQUIRECTANGULAR'
msgid "Spherical camera for environment maps, also known as Lat Long panorama"
msgstr ""
"Sfärisk kamera för miljökartor, även kallad längd- och breddgradspanorama"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_EQUIDISTANT'
msgid "Fisheye Equidistant"
msgstr "Ekvidistant fisköge"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_EQUIDISTANT'
msgid "Ideal for fulldomes, ignore the sensor dimensions"
msgstr "Lämplig för fullkupolprojektioner, ignorerar sensorns mått"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_EQUISOLID'
msgid "Fisheye Equisolid"
msgstr "Ekvisolid fisköge"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_EQUISOLID'
msgid ""
"Similar to most fisheye modern lens, takes sensor dimensions into "
"consideration"
msgstr ""
"Liknar de flesta moderna fiskögeobjektiv och tar hänsyn till sensorns mått"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_LENS_POLYNOMIAL'
msgid "Fisheye Lens Polynomial"
msgstr "Fiskögeobjektivets polynom"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_LENS_POLYNOMIAL'
msgid ""
"Defines the lens projection as polynomial to allow real world camera lenses "
"to be mimicked"
msgstr ""
"Anger objektivets projektion som ett polynom så att verkliga kameraobjektiv "
"kan efterliknas"

#. :src: bpy.types.Camera.panorama_type:'CENTRAL_CYLINDRICAL'
msgid "Central Cylindrical"
msgstr "Centralcylindrisk"

#. :src: bpy.types.Camera.panorama_type:'CENTRAL_CYLINDRICAL'
msgid ""
"Projection onto a virtual cylinder from its center, similar as a rotating "
"panoramic camera"
msgstr ""
"Projektion på en virtuell cylinder från dess mittpunkt, liknande en "
"roterande panoramakamera"

#. :src: bpy.types.Camera.passepartout_alpha
msgid "Passepartout Alpha"
msgstr "Alfa för passepartout"

#. :src: bpy.types.Camera.sensor_fit
msgid "Sensor Fit"
msgstr "Sensoranpassning"

#. :src: bpy.types.Camera.sensor_fit
msgid "Method to fit image and field of view angle inside the sensor"
msgstr "Metod för att anpassa bilden och synfältsvinkeln till sensorn"

#. :src: bpy.types.Camera.sensor_fit:'AUTO'
msgid "Fit to the sensor width or height depending on image resolution"
msgstr "Anpassa till sensorns bredd eller höjd beroende på bildupplösningen"

#. :src: bpy.types.Camera.sensor_fit:'HORIZONTAL'
msgid "Fit to the sensor width"
msgstr "Anpassa till sensorns bredd"

#. :src: bpy.types.Camera.sensor_fit:'VERTICAL'
msgid "Fit to the sensor height"
msgstr "Anpassa till sensorns höjd"

#. :src: bpy.types.Camera.sensor_height
msgid "Vertical size of the image sensor area in millimeters"
msgstr "Bildsensorns vertikala storlek i millimeter"

#. :src: bpy.types.Camera.sensor_width
msgid "Horizontal size of the image sensor area in millimeters"
msgstr "Bildsensorns horisontella storlek i millimeter"

#. :src: bpy.types.Camera.show_limits
msgid "Display the clipping range and focus point on the camera"
msgstr "Visa beskärningsintervallet och fokuspunkten för kameran"

#. :src: bpy.types.Camera.central_cylindrical_range_u_max
#. :src: bpy.types.Camera.longitude_max
msgid "Max Longitude"
msgstr "Största längdgrad"

#. :src: bpy.types.Camera.central_cylindrical_range_u_max
msgid "Maximum Longitude value for the central cylindrical lens"
msgstr "Största längdgradsvärde för den centrala cylindriska linsen"

#. :src: bpy.types.Camera.central_cylindrical_range_u_min
#. :src: bpy.types.Camera.longitude_min
msgid "Min Longitude"
msgstr "Minsta längdgrad"

#. :src: bpy.types.Camera.central_cylindrical_range_u_min
msgid "Minimum Longitude value for the central cylindrical lens"
msgstr "Minsta längdgradsvärde för den centrala cylindriska linsen"

#. :src: bpy.types.Camera.central_cylindrical_range_v_max
msgid "Max Height"
msgstr "Största höjd"

#. :src: bpy.types.Camera.central_cylindrical_range_v_min
msgid "Min Height"
msgstr "Minsta höjd"

#. :src: bpy.types.Camera.clip_end
#. :src: bpy.types.LightProbeSphere.clip_end
#. :src: bpy.types.SpaceView3D.clip_end
#. :src: bpy.types.XrSessionSettings.clip_end
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:21
msgid "Clip End"
msgstr "Beskärningsslut"

#. :src: bpy.types.Camera.clip_end
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:21
msgid "Camera far clipping distance"
msgstr "Kamerans bortre beskärningsavstånd"

#. :src: bpy.types.Camera.clip_start
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:20
msgid "Camera near clipping distance"
msgstr "Kamerans närmaste beskärningsavstånd"

#. :src: bpy.types.Camera.custom_bytecode_hash
msgid "Custom Bytecode Hash"
msgstr "Hash för anpassad bytekod"

#. :src: bpy.types.Camera.custom_bytecode_hash
msgid ""
"Hash of the compiled bytecode of the custom shader, for quick equality "
"checking"
msgstr ""
"Hash för den anpassade shaderns kompilerade bytekod, för snabb "
"likhetskontroll"

#. :src: bpy.types.Camera.custom_shader
msgid "Custom Shader"
msgstr "Anpassad shader"

#. :src: bpy.types.Camera.cycles_custom
msgid "Cycles Custom Camera Settings"
msgstr "Anpassade kamerainställningar för Cycles"

#. :src: bpy.types.Camera.fisheye_fov
msgid "Field of view for the fisheye lens"
msgstr "Synfält för fiskögeobjektivet"

#. :src: bpy.types.Camera.fisheye_lens
msgid "Fisheye Lens"
msgstr "Fiskögeobjektiv"

#. :src: bpy.types.Camera.fisheye_polynomial_k0
msgid "Fisheye Polynomial K0"
msgstr "Fiskögepolynom K0"

#. :src: bpy.types.Camera.fisheye_polynomial_k1
msgid "Fisheye Polynomial K1"
msgstr "Fiskögepolynom K1"

#. :src: bpy.types.Camera.fisheye_polynomial_k2
msgid "Fisheye Polynomial K2"
msgstr "Fiskögepolynom K2"

#. :src: bpy.types.Camera.fisheye_polynomial_k3
msgid "Fisheye Polynomial K3"
msgstr "Fiskögepolynom K3"

#. :src: bpy.types.Camera.fisheye_polynomial_k4
msgid "Fisheye Polynomial K4"
msgstr "Fiskögepolynom K4"

#. :src: bpy.types.Camera.latitude_max
msgid "Max Latitude"
msgstr "Största breddgrad"

#. :src: bpy.types.Camera.latitude_max
msgid "Maximum latitude (vertical angle) for the equirectangular lens"
msgstr ""
"Största breddgrad (vertikal vinkel) för det ekvirektangulära objektivet"

#. :src: bpy.types.Camera.latitude_min
msgid "Min Latitude"
msgstr "Minsta breddgrad"

#. :src: bpy.types.Camera.latitude_min
msgid "Minimum latitude (vertical angle) for the equirectangular lens"
msgstr "Minsta breddgrad (vertikal vinkel) för det ekvirektangulära objektivet"

#. :src: bpy.types.Camera.lens
msgid "Perspective Camera focal length value in millimeters"
msgstr "Perspektivkamerans brännvidd i millimeter"

#. :src: bpy.types.Camera.lens_unit
msgid "Lens Unit"
msgstr "Objektivenhet"

#. :src: bpy.types.Camera.lens_unit
msgid "Unit to edit lens in for the user interface"
msgstr "Enhet som används för att redigera objektivet i användargränssnittet"

#. :src: bpy.types.Camera.lens_unit:'FOV'
msgid "Specify the lens as the field of view's angle"
msgstr "Ange objektivet med synfältets vinkel"

#. :src: bpy.types.Camera.longitude_max
msgid "Maximum longitude (horizontal angle) for the equirectangular lens"
msgstr ""
"Största längdgrad (horisontell vinkel) för det ekvirektangulära objektivet"

#. :src: bpy.types.Camera.longitude_min
msgid "Minimum longitude (horizontal angle) for the equirectangular lens"
msgstr ""
"Minsta längdgrad (horisontell vinkel) för det ekvirektangulära objektivet"

#. :src: bpy.types.CacheFile.frame
msgid ""
"The time to use for looking up the data in the cache file, or to determine "
"which file to use in a file sequence"
msgstr ""
"Bildrutan som används för att slå upp data i cachefilen eller avgöra vilken "
"fil som ska användas i en filsekvens"

#. :src: bpy.types.CacheFile.frame_offset
msgid ""
"Subtracted from the current frame to use for looking up the data in the "
"cache file, or to determine which file to use in a file sequence"
msgstr ""
"Dras av från den aktuella bildrutan när data slås upp i cachefilen eller när "
"en fil väljs ur en filsekvens"

#. :src: bpy.types.CacheFile.is_sequence
#. :src: bpy.types.Volume.is_sequence
msgid "Whether the cache is separated in a series of files"
msgstr "Om cachen är uppdelad i en serie filer"

#. :src: bpy.types.CacheFile.prefetch_cache_size
msgid "Prefetch Cache Size"
msgstr "Storlek på förhandsladdningscache"

#. :src: bpy.types.CacheFile.prefetch_cache_size
msgid ""
"Memory usage limit in megabytes for the Cycles Procedural cache, if the data "
"does not fit within the limit, rendering is aborted"
msgstr ""
"Minnesgräns i megabyte för Cycles Procedural-cachen. Om data inte ryms inom "
"gränsen avbryts renderingen"

#. :src: bpy.types.CacheFile.scale
msgid ""
"Value by which to enlarge or shrink the object with respect to the world's "
"origin (only applicable through a Transform Cache constraint)"
msgstr ""
"Värde som förstorar eller förminskar objektet i förhållande till världens "
"ursprung (gäller endast med en Transform Cache-begränsning)"

#. :src: bpy.types.CacheFile.use_prefetch
msgid "Use Prefetch"
msgstr "Använd förhandsladdning"

#. :src: bpy.types.CacheFile.use_prefetch
msgid ""
"When enabled, the Cycles Procedural will preload animation data for faster "
"updates"
msgstr ""
"När funktionen är aktiverad förladdar Cycles Procedural animationsdata för "
"snabbare uppdateringar"

#. :src: bpy.types.CacheFile.use_render_procedural
msgid ""
"Display boxes in the viewport as placeholders for the objects, Cycles will "
"use a procedural to load the objects during viewport rendering in "
"experimental mode, other render engines will also receive a placeholder and "
"should take care of loading the Alembic data themselves if possible"
msgstr ""
"Visa rutor som platshållare för objekten i visningsområdet. I experimentellt "
"läge använder Cycles en procedur för att läsa in objekten vid rendering i "
"visningsområdet. Andra renderingsmotorer får också en platshållare och bör "
"själva läsa in Alembic-data om möjligt"

#. :src: bpy.types.CacheFile.velocity_unit
#. :src: bpy.types.Volume.velocity_unit
msgid ""
"Define how the velocity vectors are interpreted with regard to time, 'frame' "
"means the delta time is 1 frame, 'second' means the delta time is 1 / FPS"
msgstr ""
"Ange hur hastighetsvektorerna tolkas med avseende på tid. \"Bildruta\" "
"innebär att deltatiden är 1 bildruta och \"Sekund\" innebär 1/FPS"

#. :src: bpy.types.Brush.use_multiplane_scrape_dynamic
msgid ""
"The angle between the planes changes during the stroke to fit the surface "
"under the cursor"
msgstr ""
"Vinkeln mellan planen ändras under penseldraget för att passa ytan under "
"markören"

#. :src: bpy.types.Brush.use_offset_pressure
msgid "Enable tablet pressure sensitivity for offset"
msgstr "Aktivera ritplattans tryckkänslighet för förskjutning"

#. :src: bpy.types.Brush.use_original_normal
msgid "When locked keep using normal of surface where stroke was initiated"
msgstr ""
"När funktionen är låst används fortsatt normalen för ytan där penseldraget "
"startades"

#. :src: bpy.types.Brush.use_original_plane
msgid ""
"When locked keep using the plane origin of surface where stroke was initiated"
msgstr ""
"När funktionen är låst används fortsatt planets ursprung från ytan där "
"penseldraget startades"

#. :src: bpy.types.Brush.use_paint_sculpt
msgid "Use this brush in sculpt mode"
msgstr "Använd denna pensel i skulpteringsläge"

#. :src: bpy.types.Brush.use_paint_uv_sculpt
msgid "Use UV Sculpt"
msgstr "Använd UV-skulptering"

#. :src: bpy.types.Brush.use_paint_uv_sculpt
msgid "Use this brush in UV sculpt mode"
msgstr "Använd den här penseln i UV-skulpteringsläge"

#. :src: bpy.types.Brush.use_paint_vertex
msgid "Use this brush in vertex paint mode"
msgstr "Använd denna pensel i hörnpunktsmålningsläge"

#. :src: bpy.types.Brush.use_persistent
msgid "Sculpt on a persistent layer of the mesh"
msgstr "Skulptera på ett beständigt lager i meshen"

#. :src: bpy.types.Brush.use_plane_trim
msgid "Limit the distance from the offset plane that a vertex can be affected"
msgstr "Begränsa hur långt från förskjutningsplanet en hörnpunkt kan påverkas"

#. :src: bpy.types.Brush.use_pose_ik_anchored
msgid "Keep the position of the last segment in the IK chain fixed"
msgstr "Håll det sista segmentets position i IK-kedjan låst"

#. :src: bpy.types.Brush.use_pressure_area_radius
msgid "Area Radius Pressure"
msgstr "Tryck för områdesradie"

#. :src: bpy.types.Brush.use_pressure_area_radius
msgid "Enable tablet pressure sensitivity for area radius"
msgstr "Aktivera ritplattans tryckkänslighet för områdesradie"

#. :src: bpy.types.Brush.use_pressure_jitter
msgid "Jitter Pressure"
msgstr "Variationstryck"

#. :src: bpy.types.Brush.use_pressure_jitter
msgid "Enable tablet pressure sensitivity for jitter"
msgstr "Aktivera ritplattans tryckkänslighet för variation"

#. :src: bpy.types.Brush.use_pressure_masking:'CUTOFF'
#. :src: bpy.types.BevelModifier.vmesh_method:'CUTOFF'
#. :src: bpy.types.CompositorNodeChromaMatte.threshold
#. :src: bpy.types.MESH_OT_bevel.vmesh_method:'CUTOFF'
msgid "Cutoff"
msgstr "Gränsvärde"

#. :src: bpy.types.Brush.use_pressure_spacing
msgid "Spacing Pressure"
msgstr "Tryck för penselavstånd"

#. :src: bpy.types.Brush.use_pressure_spacing
msgid "Enable tablet pressure sensitivity for spacing"
msgstr "Aktivera ritplattans tryckkänslighet för penselavstånd"

#. :src: bpy.types.Brush.use_primary_overlay
#. :src: bpy.types.Brush.use_secondary_overlay
msgid "Show texture in viewport"
msgstr "Visa textur i visningsområdet"

#. :src: bpy.types.Brush.use_scene_spacing
#: scripts/startup/bl_ui/properties_paint_common.py:525
msgid "Spacing Distance"
msgstr "Avstånd mellan penselavtryck"

#. :src: bpy.types.Brush.use_scene_spacing:'SCENE'
msgid "Calculate brush spacing relative to the scene using the stroke location"
msgstr ""
"Beräkna penselavståndet i förhållande till scenen med hjälp av penseldragets "
"position"

#. :src: bpy.types.Brush.use_smooth_stroke
#. :src: bpy.types.GREASE_PENCIL_OT_stroke_subdivide_smooth.GREASE_PENCIL_OT_stroke_smooth
msgid "Smooth Stroke"
msgstr "Jämnt penseldrag"

#. :src: bpy.types.Brush.use_space_attenuation
msgid "Adjust Strength for Spacing"
msgstr "Justera styrkan efter penselavstånd"

#. :src: bpy.types.Brush.use_space_attenuation
msgid ""
"Automatically adjust strength to give consistent results for different "
"spacings"
msgstr ""
"Justera automatiskt styrkan för att ge konsekventa resultat vid olika "
"penselavstånd"

#. :src: bpy.types.Brush.use_vertex_grease_pencil
msgid "Use this brush in Grease Pencil vertex color mode"
msgstr "Använd den här penseln i Grease Pencil-hörnpunktsfärgläge"

#. :src: bpy.types.Brush.use_wet_persistence_pressure
msgid "Use Pressure for Wet Persistence"
msgstr "Använd tryck för våt beständighet"

#. :src: bpy.types.Brush.use_wet_persistence_pressure
msgid "Use pressure to modulate wet persistence"
msgstr "Använd tryck för att modulera våt beständighet"

#. :src: bpy.types.Brush.weight
msgid "Vertex weight when brush is applied"
msgstr "Hörnpunktsvikt när penseln appliceras"

#. :src: bpy.types.Brush.use_automasking_boundary_edges
#. :src: bpy.types.Sculpt.use_automasking_boundary_edges
msgid "Mesh Boundary Auto-Masking"
msgstr "Automaskering av meshgräns"

#. :src: bpy.types.Brush.use_automasking_boundary_edges
#. :src: bpy.types.Sculpt.use_automasking_boundary_edges
msgid "Do not affect non manifold boundary edges"
msgstr "Påverka inte icke-mångfaldiga gränskanter"

#. :src: bpy.types.Brush.use_automasking_boundary_face_sets
#. :src: bpy.types.Sculpt.use_automasking_boundary_face_sets
msgid "Face Sets Boundary Automasking"
msgstr "Automaskering av ytuppsättningsgräns"

#. :src: bpy.types.Brush.use_automasking_boundary_face_sets
#. :src: bpy.types.Sculpt.use_automasking_boundary_face_sets
msgid "Do not affect vertices that belong to a Face Set boundary"
msgstr "Påverka inte hörnpunkter som tillhör en ytuppsättningsgräns"

#. :src: bpy.types.Brush.use_automasking_cavity
#. :src: bpy.types.Paint.use_cavity
#. :src: bpy.types.Sculpt.use_automasking_cavity
#. :src: bpy.types.VIEW3D_PT_tools_imagepaint_options_cavity
msgid "Cavity Mask"
msgstr "Hålighetsmask"

#. :src: bpy.types.Brush.use_automasking_cavity
#. :src: bpy.types.Sculpt.use_automasking_cavity
msgid "Do not affect vertices on peaks, based on the surface curvature"
msgstr "Påverka inte hörnpunkter vid toppar, utifrån ytans krökning"

#. :src: bpy.types.Brush.use_automasking_cavity_inverted
#. :src: bpy.types.Sculpt.use_automasking_cavity_inverted
msgid "Inverted Cavity Mask"
msgstr "Inverterad hålighetsmask"

#. :src: bpy.types.Brush.use_automasking_cavity_inverted
#. :src: bpy.types.Sculpt.use_automasking_cavity_inverted
msgid "Do not affect vertices within crevices, based on the surface curvature"
msgstr "Påverka inte hörnpunkter i skåror, utifrån ytans krökning"

#. :src: bpy.types.Brush.use_automasking_custom_cavity_curve
#. :src: bpy.types.Sculpt.use_automasking_custom_cavity_curve
msgid "Custom Cavity Curve"
msgstr "Anpassad hålighetskurva"

#. :src: bpy.types.Brush.use_automasking_face_sets
#. :src: bpy.types.Sculpt.use_automasking_face_sets
msgid "Affect only vertices that share Face Sets with the active vertex"
msgstr ""
"Påverka endast hörnpunkter som tillhör samma ytuppsättning som den aktiva "
"hörnpunkten"

#. :src: bpy.types.Brush.use_automasking_start_normal
#. :src: bpy.types.Sculpt.use_automasking_start_normal
msgid "Affect only vertices with a similar normal to where the stroke starts"
msgstr ""
"Påverka endast hörnpunkter med en normal som liknar normalen där "
"penseldraget börjar"

#. :src: bpy.types.Brush.use_automasking_topology
#. :src: bpy.types.Sculpt.use_automasking_topology
msgid "Affect only vertices connected to the active vertex under the brush"
msgstr ""
"Påverka endast hörnpunkter som är topologiskt anslutna till den aktiva "
"hörnpunkten under penseln"

#. :src: bpy.types.Brush.use_automasking_view_normal
#. :src: bpy.types.Sculpt.use_automasking_view_normal
msgid "Affect only vertices with a normal that faces the viewer"
msgstr "Påverka endast hörnpunkter med en normal som vetter mot betraktaren"

#. :src: bpy.types.Brush.use_automasking_view_occlusion
#. :src: bpy.types.Sculpt.use_automasking_view_occlusion
msgid ""
"Only affect vertices that are not occluded by other faces (slower "
"performance)"
msgstr ""
"Påverka endast hörnpunkter som inte täcks av andra ytor (långsammare "
"prestanda)"

#. :src: bpy.types.Brush.use_cloth_collision
msgid "Collide with objects during the simulation"
msgstr "Kollidera med objekt under simuleringen"

#. :src: bpy.types.Brush.use_cloth_pin_simulation_boundary
msgid "Pin Simulation Boundary"
msgstr "Fäst simuleringsgränsen"

#. :src: bpy.types.Brush.use_cloth_pin_simulation_boundary
msgid ""
"Lock the position of the vertices in the simulation falloff area to avoid "
"artifacts and create a softer transition with unaffected areas"
msgstr ""
"Lås hörnpunkternas position i simuleringsområdet för avtagande för att "
"undvika artefakter och skapa en mjukare övergång till opåverkade områden"

#. :src: bpy.types.Brush.use_color_as_displacement
msgid ""
"Handle each pixel color as individual vector for displacement (area plane "
"mapping only)"
msgstr ""
"Hantera varje pixelfärg som en enskild vektor för förskjutning (endast "
"mappning av områdesplan)"

#. :src: bpy.types.Brush.use_connected_only
msgid "Affect only topologically connected elements"
msgstr "Påverka endast topologiskt sammanhängande element"

#. :src: bpy.types.Brush.use_cursor_overlay_override
#. :src: bpy.types.Brush.use_primary_overlay_override
#. :src: bpy.types.Brush.use_secondary_overlay_override
msgid "Don't show overlay during a stroke"
msgstr "Visa inte överlägget under ett penseldrag"

#. :src: bpy.types.Brush.use_curve
msgid ""
"Define the stroke curve with a Bézier curve. Dabs are separated according to "
"spacing."
msgstr ""
"Definiera penseldragskurvan med en Bézier-kurva. Penselavtrycken separeras "
"enligt avståndet."

#. :src: bpy.types.Brush.use_custom_icon
msgid "Set the brush icon from an image file"
msgstr "Ange penselikonen från en bildfil"

#. :src: bpy.types.Brush.use_edge_to_edge
msgid "Edge-to-Edge"
msgstr "Kant till kant"

#. :src: bpy.types.Brush.use_edge_to_edge
msgid "Drag anchor brush from edge-to-edge"
msgstr "Dra den förankrade penseln från kant till kant"

#. :src: bpy.types.Brush.use_frontface
msgid "Use Front-Face"
msgstr "Använd framsidan"

#. :src: bpy.types.Brush.use_frontface
msgid "Brush only affects vertices that face the viewer"
msgstr "Penseln påverkar endast hörnpunkter som vetter mot betraktaren"

#. :src: bpy.types.Brush.use_frontface_falloff
msgid "Use Front-Face Falloff"
msgstr "Använd avtagande för framsidan"

#. :src: bpy.types.Brush.use_frontface_falloff
msgid "Blend brush influence by how much they face the front"
msgstr "Blanda penselns påverkan efter hur mycket hörnpunkterna vetter framåt"

#. :src: bpy.types.Brush.use_grab_active_vertex
msgid "Grab Active Vertex"
msgstr "Flytta aktiv hörnpunkt"

#. :src: bpy.types.Brush.use_grab_active_vertex
msgid ""
"Apply the maximum grab strength to the active vertex instead of the cursor "
"location"
msgstr ""
"Tillämpa maximal flyttstyrka på den aktiva hörnpunkten i stället för på "
"markörens position"

#. :src: bpy.types.Brush.use_grab_silhouette
msgid "Grab Silhouette"
msgstr "Flytta silhuett"

#. :src: bpy.types.Brush.use_grab_silhouette
msgid "Grabs trying to automask the silhouette of the object"
msgstr "Flyttverktyg försöker automatiskt maskera objektets silhuett"

#. :src: bpy.types.Brush.stroke_method
msgctxt "GPencil"
msgid "Stroke Method"
msgstr "Penseldragsmetod"

#. :src: bpy.types.Brush.stroke_method:'DOTS'
msgid "Apply paint on each mouse move step"
msgstr "Applicera färg vid varje steg i musrörelsen"

#. :src: bpy.types.Brush.stroke_method:'DRAG_DOT'
msgctxt "GPencil"
msgid "Drag Dot"
msgstr "Dra punkt"

#. :src: bpy.types.Brush.stroke_method:'SPACE'
#. :src: bpy.types.Brush.use_space
msgctxt "GPencil"
msgid "Space"
msgstr "Avstånd"

#. :src: bpy.types.Brush.stroke_method:'SPACE'
#. :src: bpy.types.Brush.use_space
msgid "Limit brush application to the distance specified by spacing"
msgstr ""
"Begränsa penseltillämpningen till avståndet som anges av inställningen "
"Avstånd"

#. :src: bpy.types.Brush.stroke_method:'AIRBRUSH'
msgctxt "GPencil"
msgid "Airbrush"
msgstr "Sprutpistol"

#. :src: bpy.types.Brush.stroke_method:'AIRBRUSH'
#. :src: bpy.types.Brush.use_airbrush
msgid "Keep applying paint effect while holding mouse (spray)"
msgstr "Fortsätt att applicera färg medan musknappen hålls nedtryckt (spray)"

#. :src: bpy.types.Brush.stroke_method:'ANCHORED'
#. :src: bpy.types.Brush.use_anchor
msgid "Keep the brush anchored to the initial location"
msgstr "Håll penseln förankrad vid startpunkten"

#. :src: bpy.types.Brush.stroke_method:'LINE'
msgctxt "GPencil"
msgid "Line"
msgstr "Linje"

#. :src: bpy.types.Brush.stroke_method:'LINE'
#. :src: bpy.types.Brush.use_line
msgid "Draw a line with dabs separated according to spacing"
msgstr "Rita en linje med penselavtryck med det angivna avståndet mellan dem"

#. :src: bpy.types.Brush.stroke_method:'CURVE'
msgid ""
"Define the stroke curve with a Bézier curve (dabs are separated according to "
"spacing)"
msgstr ""
"Definiera penseldragskurvan med en Bézier-kurva (penselavtrycken separeras "
"enligt avståndet)"

#. :src: bpy.types.Brush.surface_smooth_current_vertex
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_current_vertex
msgid "Per Vertex Displacement"
msgstr "Förskjutning per hörnpunkt"

#. :src: bpy.types.Brush.surface_smooth_current_vertex
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_current_vertex
msgid ""
"How much the position of each individual vertex influences the final result"
msgstr "Hur mycket varje enskild hörnpunkts position påverkar slutresultatet"

#. :src: bpy.types.Brush.surface_smooth_iterations
msgid "Number of smoothing iterations per brush step"
msgstr "Antal utjämningsiterationer per penselsteg"

#. :src: bpy.types.Brush.surface_smooth_shape_preservation
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_shape_preservation
msgid "Shape Preservation"
msgstr "Formbevarande"

#. :src: bpy.types.Brush.texture_overlay_alpha
msgid "Texture Overlay Alpha"
msgstr "Alfa för texturöverlägg"

#. :src: bpy.types.Brush.texture_sample_bias
msgid "Value added to texture samples"
msgstr "Värde som läggs till i texturproven"

#. :src: bpy.types.Brush.tilt_strength_factor
msgid ""
"How much the tilt of the pen will affect the brush. Negative values indicate "
"inverting the tilt directions."
msgstr ""
"Hur mycket pennans lutning påverkar penseln. Negativa värden vänder "
"lutningsriktningen."

#. :src: bpy.types.Brush.tip_roundness
#. :src: Socket name from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Tip Roundness"
msgstr "Spetsens rundhet"

#. :src: bpy.types.Brush.tip_roundness
msgid "Roundness of the brush tip"
msgstr "Penselspetsens rundhet"

#. :src: bpy.types.Brush.tip_scale_x
msgid "Tip Scale X"
msgstr "Spetsskala X"

#. :src: bpy.types.Brush.topology_rake_factor
msgid "Topology Rake"
msgstr "Topologisk krattning"

#. :src: bpy.types.Brush.topology_rake_factor
msgid ""
"Automatically align edges to the brush direction to generate cleaner "
"topology and define sharp features. Best used on low-poly meshes as it has a "
"performance impact."
msgstr ""
"Rikta automatiskt kanterna efter penselns riktning för att skapa en renare "
"topologi och framhäva skarpa detaljer. Fungerar bäst på lågpoly-mesher "
"eftersom det påverkar prestandan."

#. :src: bpy.types.Brush.use_accumulate
msgid "Accumulate stroke daubs on top of each other"
msgstr "Ackumulera penselavtryck ovanpå varandra"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Adaptive Spacing"
msgstr "Adaptivt penselavstånd"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Space daubs according to surface orientation instead of screen space"
msgstr ""
"Placera penselavtryck utifrån ytans riktning i stället för skärmutrymmet"

#. :src: bpy.types.Brush.use_airbrush
msgid "Airbrush"
msgstr "Sprutpistol"

#. :src: bpy.types.Brush.use_alpha
#. :src: bpy.types.PAINT_OT_vertex_color_set.use_alpha
msgid "Affect Alpha"
msgstr "Påverka alfa"

