msgctxt "Brush"
msgid "Draw Sharp"
msgstr "Rita skarpt"

#. :src: bpy.types.Brush.sculpt_tool:'CLAY_THUMB'
msgctxt "Brush"
msgid "Clay Thumb"
msgstr "Lertumme"

#. :src: bpy.types.Brush.sculpt_tool:'BLOB'
msgctxt "Brush"
msgid "Blob"
msgstr "Klump"

#. :src: bpy.types.Brush.sculpt_tool:'MULTIPLANE_SCRAPE'
msgctxt "Brush"
msgid "Multi-plane Scrape"
msgstr "Skrapa i flera plan"

#. :src: bpy.types.Brush.sculpt_tool:'PINCH'
