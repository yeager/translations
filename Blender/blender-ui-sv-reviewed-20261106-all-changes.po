#. :src: bpy.types.Brush.smear_deform_type:'PINCH'
msgctxt "Brush"
msgid "Pinch"
msgstr "Nyp"

#. :src: bpy.types.Brush.sculpt_tool:'TOPOLOGY'
msgctxt "Brush"
msgid "Slide Relax"
msgstr "Glidutjämning"

#. :src: bpy.types.Brush.sculpt_tool:'DRAW_FACE_SETS'
msgctxt "Brush"
msgid "Draw Face Sets"
msgstr "Måla ytuppsättningar"

#. :src: bpy.types.Brush.sculpt_tool:'DISPLACEMENT_ERASER'
msgctxt "Brush"
