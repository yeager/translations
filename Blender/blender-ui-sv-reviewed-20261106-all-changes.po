msgstr "Raderare för Multires-förskjutning"

#. :src: bpy.types.Brush.sculpt_tool:'DISPLACEMENT_SMEAR'
msgctxt "Brush"
msgid "Multires Displacement Smear"
msgstr "Smeta ut Multires-förskjutning"

