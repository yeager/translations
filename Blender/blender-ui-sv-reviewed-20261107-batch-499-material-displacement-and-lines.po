#. :src: bpy.types.Material.displacement_method
msgid "Displacement Method"
msgstr "Förskjutningsmetod"

#. :src: bpy.types.Material.displacement_method
msgid "Method to use for the displacement"
msgstr "Metod att använda för förskjutningen"

#. :src: bpy.types.Material.displacement_method:'BUMP'
msgid "Bump Only"
msgstr "Endast bump"

#. :src: bpy.types.Material.displacement_method:'BUMP'
msgid "Bump mapping to simulate the appearance of displacement"
msgstr "Bumpmappning för att simulera utseendet på förskjutning"

#. :src: bpy.types.Material.displacement_method:'DISPLACEMENT'
msgid "Displacement Only"
msgstr "Endast förskjutning"

#. :src: bpy.types.Material.displacement_method:'DISPLACEMENT'
msgid "Use true displacement of surface only, requires fine subdivision"
msgstr "Använd endast verklig förskjutning av ytan, kräver fin indelning"

#. :src: bpy.types.Material.displacement_method:'BOTH'
msgid "Displacement and Bump"
msgstr "Förskjutning och bump"

#. :src: bpy.types.Material.displacement_method:'BOTH'
msgid "Combination of true displacement and bump mapping for finer detail"
msgstr ""
"Kombination av verklig förskjutning och bumpmappning för finare detaljer"

#. :src: bpy.types.Material.grease_pencil
msgid "Grease Pencil Settings"
msgstr "Inställningar för Grease Pencil"

#. :src: bpy.types.Material.grease_pencil
msgid "Grease Pencil color settings for material"
msgstr "Grease Pencil-färginställningar för materialet"

#. :src: bpy.types.Material.is_grease_pencil
msgid "Is Grease Pencil"
msgstr "Är Grease Pencil"

#. :src: bpy.types.Material.is_grease_pencil
msgid "True if this material has Grease Pencil data"
msgstr "Sant om detta material har Grease Pencil-data"

#. :src: bpy.types.Material.line_color
#. :src: bpy.types.LineStyleAlphaModifier_Material.material_attribute:'LINE'
#. :src: bpy.types.LineStyleColorModifier_Material.material_attribute:'LINE'
#. :src: bpy.types.LineStyleThicknessModifier_Material.material_attribute:'LINE'
msgid "Line Color"
msgstr "Linjefärg"

#. :src: bpy.types.Material.line_color
msgid "Line color used for Freestyle line rendering"
msgstr "Linjefärg som används för Freestyle-linjerendering"

#. :src: bpy.types.Material.line_priority
msgid "Line Priority"
msgstr "Linjeprioritet"

#. :src: bpy.types.Material.line_priority
msgid "The line color of a higher priority is used at material boundaries"
msgstr "Linjefärgen med högre prioritet används vid materialgränser"

#. :src: bpy.types.Material.lineart
msgid "Line Art Settings"
msgstr "Inställningar för linjeteckning"

#. :src: bpy.types.Material.lineart
msgid "Line Art settings for material"
msgstr "Inställningar för linjeteckning för material"

#. :src: bpy.types.Material.max_vertex_displacement
msgid "Max Vertex Displacement"
msgstr "Maximal hörnpunktsförskjutning"

#. :src: bpy.types.Material.max_vertex_displacement
msgid ""
"The max distance a vertex can be displaced. Displacements over this "
"threshold may cause visibility issues."
msgstr ""
"Det maximala avstånd som en hörnpunkt kan förskjutas. Förskjutningar över "
"detta tröskelvärde kan orsaka synlighetsproblem."
