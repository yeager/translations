#. :src: bpy.types.OBJECT_OT_convert.target:'CURVE'
msgid "Curve from Mesh or Text objects"
msgstr "Kurva från mesh- eller textobjekt"

#. :src: bpy.types.OBJECT_OT_convert.target:'MESH'
msgid "Mesh from Curve, Surface, Metaball, Text, or Point Cloud objects"
msgstr "Mesh från kurv-, yt-, metaboll-, text- eller punktmolnsobjekt"

#. :src: bpy.types.OBJECT_OT_convert.target:'POINTCLOUD'
msgid "Point Cloud from Mesh objects"
msgstr "Punktmoln från meshobjekt"

#. :src: bpy.types.OBJECT_OT_convert.target:'GREASEPENCIL'
msgid "Grease Pencil from Curve or Mesh objects"
msgstr "Grease Pencil från kurv- eller meshobjekt"

#. :src: bpy.types.OBJECT_OT_curves_empty_hair_add
msgid "Add an empty curve object to the scene with the selected mesh as surface"
msgstr "Lägg till ett tomt kurvobjekt i scenen med den valda meshen som yta"

#. :src: bpy.types.OBJECT_OT_data_transfer
msgctxt "Operator"
msgid "Transfer Mesh Data"
msgstr "Överför meshdata"

#. :src: bpy.types.OBJECT_OT_data_transfer.use_create
msgid "Add data layers on destination meshes if needed"
msgstr "Lägg till datalager i målmeshar vid behov"

#. :src: bpy.types.OBJECT_OT_datalayout_transfer
msgctxt "Operator"
msgid "Transfer Mesh Data Layout"
msgstr "Överför layout för meshdata"

#. :src: bpy.types.OBJECT_OT_datalayout_transfer
msgid "Transfer layout of data layer(s) from active to selected meshes"
msgstr "Överför datalagrets/datalagrens layout från den aktiva meshen till valda meshar"

#. :src: bpy.types.OBJECT_OT_hook_select
msgid "Select affected vertices on mesh"
msgstr "Välj berörda hörnpunkter i meshen"

#. :src: bpy.types.OBJECT_OT_laplaciandeform_bind
msgid "Bind mesh to system in laplacian deform modifier"
msgstr "Bind meshen till systemet i Laplace-deformeringsmodifieraren"

#. :src: bpy.types.OBJECT_OT_make_single_user.obdata_animation
msgid "Make object data (mesh, curve etc.) animation data local to each object"
msgstr "Gör animationsdata för objektdata (mesh, kurva osv.) lokala för varje objekt"

#. :src: bpy.types.OBJECT_OT_meshdeform_bind
msgctxt "Operator"
msgid "Mesh Deform Bind"
msgstr "Bind meshdeformering"

#. :src: bpy.types.OBJECT_OT_meshdeform_bind
msgid "Bind mesh to cage in mesh deform modifier"
msgstr "Bind meshen till buren i meshdeformeringsmodifieraren"

#. :src: bpy.types.OBJECT_OT_mode_set_with_submode.mesh_select_mode
msgid "Mesh Mode"
msgstr "Meshläge"

#. :src: bpy.types.OBJECT_OT_modifier_apply.merge_customdata
msgid "For mesh objects, merge UV coordinates that share a vertex to account for imprecision in some modifiers"
msgstr "För meshobjekt: slå samman UV-koordinater som delar en hörnpunkt för att kompensera för bristande precision i vissa modifierare"

#. :src: bpy.types.OBJECT_OT_modifier_convert
msgctxt "Operator"
msgid "Convert Particles to Mesh"
msgstr "Konvertera partiklar till mesh"

#. :src: bpy.types.OBJECT_OT_modifier_convert
msgid "Convert particles to a mesh object"
msgstr "Konvertera partiklar till ett meshobjekt"
