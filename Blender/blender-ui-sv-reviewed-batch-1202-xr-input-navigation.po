#. :src: bpy.types.PreferencesInput.ndof_lock_horizon
msgid "NDOF Lock Horizon"
msgstr "NDOF-horisontlåsning"

#. :src: bpy.types.PreferencesInput.ndof_lock_horizon
msgid "Lock Horizon forces the horizon to be kept leveled as it currently is"
msgstr "Horisontlåsning håller horisonten vågrät i dess nuvarande läge"

#. :src: bpy.types.PreferencesInput.ndof_navigation_mode
msgid "NDOF View Navigate"
msgstr "Navigera i NDOF-vyn"

#. :src: bpy.types.PreferencesInput.tablet_api:'WINDOWS_INK'
msgid "Use native Windows Ink API, for modern tablet and pen devices. Requires Windows 8 or newer."
msgstr "Använd Windows Ink-API:t för moderna ritplattor och pennenheter. Kräver Windows 8 eller senare."

#. :src: bpy.types.PreferencesInput.tablet_api:'WINTAB'
msgid "Use Wintab driver for older tablets and Windows versions"
msgstr "Använd Wintab-drivrutinen för äldre ritplattor och Windows-versioner"
