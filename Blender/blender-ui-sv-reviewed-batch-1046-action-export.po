#. :src: bpy.types.EXPORT_SCENE_OT_fbx.bake_anim_force_startend_keying
msgid "Always add a keyframe at start and end of actions for animated channels"
msgstr "Lägg alltid till en nyckelbildruta vid början och slutet av Actioner för animerade kanaler"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.bake_anim_use_all_actions
msgid "Export each action as a separated FBX's AnimStack, instead of global scene animation (note that animated objects will get all actions compatible with them, others will get no animation at all)"
msgstr "Exportera varje Action som en separat FBX-AnimStack i stället för global scenanimering (observera att animerade objekt får alla Actioner som är kompatibla med dem, andra får ingen animering alls)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_single_armature
msgid "Export all actions, bound to a single armature. WARNING: Option does not support exports including multiple armatures"
msgstr "Exportera alla Actioner som är kopplade till en enda armatur. VARNING: Alternativet stöder inte exporter med flera armaturer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIONS'
msgid "Export actions (actives and on NLA tracks) as separate animations"
msgstr "Exportera Actioner (aktiva och på NLA-spår) som separata animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIVE_ACTIONS'
msgid "Active actions merged"
msgstr "Aktiva Actioner sammanfogade"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIVE_ACTIONS'
msgid "All the currently assigned actions become one glTF animation"
msgstr "Alla för närvarande tilldelade Actioner blir en glTF-animation"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'BROADCAST'
msgid "Broadcast actions"
msgstr "Sänd Actioner"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'BROADCAST'
msgid "Broadcast all compatible actions to all objects. Animated objects will get all actions compatible with them, others will get no animation at all"
msgstr "Sänd alla kompatibla Actioner till alla objekt. Animerade objekt får alla Actioner som är kompatibla med dem, andra får ingen animering alls"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animations
msgid "Exports active actions and NLA tracks as glTF animations"
msgstr "Exporterar aktiva Actioner och NLA-spår som glTF-animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_morph_reset_sk_data
msgid "Reset shape keys between each action exported. This is needed when some SK channels are not keyed on some animations"
msgstr "Återställ formnycklar mellan varje exporterad Action. Detta behövs när vissa SK-kanaler inte är nycklade på vissa animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_nla_strips
msgid "When on, multiple actions become part of the same glTF animation if they're pushed onto NLA tracks with the same name. When off, all the currently assigned actions become one glTF animation"
msgstr "När funktionen är aktiverad blir flera Actioner en del av samma glTF-animation om de läggs till i NLA-spår med samma namn. När funktionen är avaktiverad blir alla för närvarande tilldelade Actioner en glTF-animation"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_reset_pose_bones
msgid "Reset pose bones between each action exported. This is needed when some bones are not keyed on some animations"
msgstr "Återställ posben mellan varje exporterad Action. Detta behövs när vissa ben inte är nycklade i vissa animationer"
