#. :src: bpy.types.FCurve.color_mode
msgid "Method used to determine color of F-Curve in Graph Editor"
msgstr "Metod för att bestämma F-kurvans färg i grafredigeraren"

#. :src: bpy.types.FCurve.color_mode:'AUTO_RAINBOW'
msgid "Cycle through the rainbow, trying to give each curve a unique color"
msgstr "Gå igenom regnbågen och försök ge varje kurva en unik färg"

#. :src: bpy.types.FCurve.color_mode:'AUTO_RGB'
msgid "Auto XYZ to RGB"
msgstr "Automatiskt XYZ till RGB"

#. :src: bpy.types.FCurve.color_mode:'AUTO_RGB'
msgid ""
"Use axis colors for transform and color properties, and auto-rainbow for the "
"rest"
msgstr ""
"Använd axelfärger för transformations- och färgegenskaper och automatisk "
"regnbåge för övriga"

#. :src: bpy.types.FCurve.color_mode:'AUTO_YRGB'
msgid "Auto WXYZ to YRGB"
msgstr "Automatiskt WXYZ till YRGB"

#. :src: bpy.types.FCurve.color_mode:'AUTO_YRGB'
msgid ""
"Use axis colors for XYZ parts of transform, and yellow for the 'W' channel"
msgstr ""
"Använd axelfärger för XYZ-delar av transformationen och gult för \"W\"-"
"kanalen"

#. :src: bpy.types.FCurve.color_mode:'CUSTOM'
#. :src: bpy.types.KeyConfig.is_user_defined
#. :src: bpy.types.KeyMap.is_user_modified
#. :src: bpy.types.KeyMapItem.is_user_defined
#. :src: bpy.types.StudioLight.is_user_defined
msgid "User Defined"
msgstr "Användardefinierad"

#. :src: bpy.types.FCurve.color_mode:'CUSTOM'
msgid "Use custom hand-picked color for F-Curve"
msgstr "Använd egen handplockad färg för F-kurvan"

#. :src: bpy.types.FCurve.data_path
msgid "RNA Path to property affected by F-Curve"
msgstr "RNA-sökväg till egenskapen som påverkas av F-kurvan"

#. :src: bpy.types.FCurve.driver
#: source/blender/editors/space_graph/graph_buttons.cc:959
#: source/blender/editors/space_graph/graph_buttons.cc:1482
msgid "Driver"
msgstr "Drivrutin"
