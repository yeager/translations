#. :src: bpy.types.BrushGpencilSettings.use_jitter_pressure
msgid "Use Pressure Jitter"
msgstr "Använd tryckslumpning"

#. :src: bpy.types.BrushGpencilSettings.use_jitter_pressure
msgid "Use tablet pressure for jitter"
msgstr "Använd ritplattans tryck för slumpning"

#. :src: bpy.types.BrushGpencilSettings.use_keep_caps_eraser
msgid "Keep Caps"
msgstr "Behåll ändarna"

#. :src: bpy.types.BrushGpencilSettings.use_keep_caps_eraser
msgid "Keep the caps as they are and don't flatten them when erasing"
msgstr "Behåll ändarna och platta inte till dem vid radering"

#. :src: bpy.types.BrushGpencilSettings.use_material_pin
msgid "Pin Material"
msgstr "Fäst material"

#. :src: bpy.types.BrushGpencilSettings.use_material_pin
msgid "Keep material assigned to brush"
msgstr "Behåll materialet tilldelat till penseln"

#. :src: bpy.types.BrushGpencilSettings.use_pressure
msgid "Use tablet pressure"
msgstr "Använd ritplattans tryck"

#. :src: bpy.types.BrushGpencilSettings.use_settings_outline
#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_OUTLINE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_OUTLINE'
msgid "Convert stroke to outline"
msgstr "Konvertera streck till kontur"

#. :src: bpy.types.BrushGpencilSettings.use_settings_postprocess
msgid "Additional post processing options for new strokes"
msgstr "Ytterligare efterbehandlingsalternativ för nya streck"

#. :src: bpy.types.BrushGpencilSettings.use_strength_pressure
msgid "Use tablet pressure for color strength"
msgstr "Använd ritplattans tryck för färgstyrka"

#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_hue
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_radius
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_sat
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_strength
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_uv
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_val
msgid "Stroke Random"
msgstr "Slumpning per streck"

#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_hue
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_radius
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_sat
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_strength
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_uv
#. :src: bpy.types.BrushGpencilSettings.use_stroke_random_val
msgid "Use randomness at stroke level"
msgstr "Använd slumpning på strecknivå"

#. :src: bpy.types.BrushGpencilSettings.use_trim
msgid "Trim Stroke Ends"
msgstr "Trimma streckändar"

#. :src: bpy.types.BrushGpencilSettings.use_trim
msgid "Trim intersecting stroke ends"
msgstr "Trimma korsande streckändar"

#. :src: bpy.types.BrushGpencilSettings.uv_random
msgid "UV Random"
msgstr "UV-slumpning"

#. :src: bpy.types.BrushGpencilSettings.vertex_color_factor
msgid "Vertex Color Factor"
msgstr "Hörnpunktsfärgfaktor"

#. :src: bpy.types.BrushGpencilSettings.vertex_color_factor
msgid "Factor used to mix vertex color to get final color"
msgstr "Faktor som används för att blanda hörnpunktsfärgen för att få den slutliga färgen"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode
msgid "Mode Type"
msgstr "Lägestyp"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode
msgid "Defines how vertex color affect to the strokes"
msgstr "Anger hur hörnpunktsfärgen påverkar strecken"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'STROKE'
msgid "Vertex Color affects to Stroke only"
msgstr "Hörnpunktsfärg påverkar endast streck"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'FILL'
msgid "Vertex Color affects to Fill only"
msgstr "Hörnpunktsfärg påverkar endast fyllning"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'BOTH'
msgid "Vertex Color affects to Stroke and Fill"
msgstr "Hörnpunktsfärg påverkar streck och fyllning"
