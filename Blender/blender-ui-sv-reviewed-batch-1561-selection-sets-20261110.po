#. :src: bpy.types.POSE_MT_selection_set_create
msgid "Choose Selection Set"
msgstr "Välj urvalsuppsättning"

#. :src: bpy.types.POSE_OT_selection_set_paste
msgid "Add new Selection Set(s) from the clipboard"
msgstr "Lägg till nya urvalsuppsättningar från urklippet"

#. :src: bpy.types.POSE_OT_selection_set_remove
msgid "Remove a Selection Set from this Armature"
msgstr "Ta bort en urvalsuppsättning från denna armatur"

#. :src: bpy.types.POSE_OT_selection_set_remove_bones
msgid "Remove the selected bones from all Selection Sets"
msgstr "Ta bort de markerade benen från alla urvalsuppsättningar"

#. :src: bpy.types.POSE_OT_selection_set_select
msgid "Select the bones from this Selection Set"
msgstr "Välj benen från denna urvalsuppsättning"

#. :src: bpy.types.POSE_OT_selection_set_select.selection_set_index
msgid "Selection Set Index"
msgstr "Index för urvalsuppsättning"

#. :src: bpy.types.POSE_OT_selection_set_select.selection_set_index
msgid "Which Selection Set to select; -1 uses the active Selection Set"
msgstr ""
"Vilken urvalsuppsättning som ska väljas; -1 använder den aktiva "
"urvalsuppsättningen"

#. :src: bpy.types.POSE_OT_selection_set_unassign
msgid "Remove selected bones from Selection Set"
msgstr "Ta bort markerade ben från urvalsuppsättningen"

#: scripts/startup/bl_operators/bone_selection_sets.py:292
msgid "Copied Selection Set(s) to clipboard"
msgstr "Kopierade urvalsuppsättningar till urklippet"

#: scripts/startup/bl_operators/bone_selection_sets.py:308
msgid "The clipboard does not contain a Selection Set"
msgstr "Urklippet innehåller ingen urvalsuppsättning"

#: scripts/startup/bl_ui/properties_data_armature.py:397
msgctxt "Operator"
msgid "New Selection Set"
msgstr "Ny urvalsuppsättning"

#. :src: bpy.types.POSE_MT_selection_sets_context_menu
msgid "Selection Sets Specials"
msgstr "Särskilda åtgärder för urvalsuppsättningar"

#: scripts/startup/bl_ui/space_view3d.py:1884
msgid "Bone Selection Set"
msgstr "Benurvalsuppsättning"

#. :src: bpy.types.POSE_MT_selection_sets_select
msgid "Select Selection Set"
msgstr "Välj urvalsuppsättning"

#. :src: bpy.types.POSE_OT_selection_set_select
msgctxt "Operator"
msgid "Select Selection Set"
msgstr "Välj urvalsuppsättning"

#. :src: bpy.types.POSE_OT_selection_set_assign
msgid "Add selected bones to Selection Set"
msgstr "Lägg till markerade ben i urvalsuppsättningen"

#. :src: bpy.types.POSE_OT_selection_set_copy
msgid "Copy the selected Selection Set(s) to the clipboard"
msgstr "Kopiera markerade urvalsuppsättningar till urklippet"

#. :src: bpy.types.POSE_OT_selection_set_delete_all
msgid "Remove all Selection Sets from this Armature"
msgstr "Ta bort alla urvalsuppsättningar från denna armatur"

#. :src: bpy.types.POSE_OT_selection_set_deselect
msgid "Remove Selection Set bones from current selection"
msgstr "Ta bort ben i urvalsuppsättning från aktuell markering"

#. :src: bpy.types.POSE_OT_selection_set_move
msgid "Move the active Selection Set up/down the list of sets"
msgstr ""
"Flytta den aktiva urvalsuppsättningen uppåt/nedåt i listan över uppsättningar"

#. :src: bpy.types.POSE_OT_selection_set_move.direction
msgid "Direction to move the active Selection Set: UP (default) or DOWN"
msgstr ""
"Riktning för att flytta den aktiva urvalsuppsättningen: UPP (standard) eller "
"NER"
