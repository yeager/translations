#. :src: bpy.types.TextCurve.align_x:'FLUSH'
#. :src: bpy.types.GeometryNodeStringToCurves.align_x:'FLUSH'
msgid "Flush"
msgstr "Jämna marginaler"

#. :src: bpy.types.TextCurve.align_x:'FLUSH'
msgid "Align to the left and the right, with equal character spacing"
msgstr "Justera mot vänster och höger marginal med jämnt teckenavstånd"

#. :src: bpy.types.TextCurve.align_y:'TOP'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'TOP'
msgid "Align text to the top"
msgstr "Justera texten mot överkanten"

#. :src: bpy.types.TextCurve.align_y:'CENTER'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'MIDDLE'
msgid "Align text to the middle"
msgstr "Centrera texten vertikalt"

#. :src: bpy.types.TextCurve.align_y:'BOTTOM'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'BOTTOM'
msgid "Align text to the bottom"
msgstr "Justera texten mot nederkanten"

#. :src: bpy.types.TextCurve.follow_curve
msgid "Curve deforming text object"
msgstr "Kurva som deformerar textobjektet"

#. :src: bpy.types.TextCurve.font_bold
msgid "Font Bold"
msgstr "Fetstilt typsnitt"

#. :src: bpy.types.TextCurve.font_bold_italic
msgid "Font Bold Italic"
msgstr "Fetkursivt typsnitt"

#. :src: bpy.types.TextCurve.font_italic
msgid "Font Italic"
msgstr "Kursivt typsnitt"

#. :src: bpy.types.TextCurve.space_character
msgid "Global spacing between characters"
msgstr "Globalt teckenavstånd"
