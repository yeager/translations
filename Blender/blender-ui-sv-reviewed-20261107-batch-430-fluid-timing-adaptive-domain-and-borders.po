#. :src: bpy.types.RigidBodyWorld.time_scale
#: scripts/startup/bl_ui/properties_physics_fluid.py:167
msgid "Time Scale"
msgstr "Tidsskala"

#. :src: bpy.types.FluidDomainSettings.time_scale
msgid "Adjust simulation speed"
msgstr "Justera simuleringshastigheten"

#. :src: bpy.types.FluidDomainSettings.timesteps_max
msgid "Maximum number of simulation steps to perform for one frame"
msgstr "Maximalt antal simuleringssteg som ska utföras för en bildruta"

#. :src: bpy.types.FluidDomainSettings.timesteps_min
msgid "Minimum number of simulation steps to perform for one frame"
msgstr "Minsta antal simuleringssteg som ska utföras för en bildruta"

#. :src: bpy.types.FluidDomainSettings.use_adaptive_domain
#. :src: bpy.types.PHYSICS_PT_adaptive_domain
msgid "Adaptive Domain"
msgstr "Adaptiv domän"

#. :src: bpy.types.FluidDomainSettings.use_adaptive_domain
msgid "Adapt simulation resolution and size to fluid"
msgstr "Anpassa simuleringens upplösning och storlek till vätskan"

#. :src: bpy.types.FluidDomainSettings.use_adaptive_timesteps
msgid "Adaptive Time Steps"
msgstr "Adaptiva tidssteg"

#. :src: bpy.types.FluidDomainSettings.use_adaptive_timesteps
msgid ""
"Automatically decide when to perform multiple simulation steps per frame"
msgstr "Avgör automatiskt när flera simuleringssteg ska utföras per bildruta"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_back
msgid "Enable collisions with back domain border"
msgstr "Aktivera kollisioner med den bakre domängränsen"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_bottom
msgid "Enable collisions with bottom domain border"
msgstr "Aktivera kollisioner med den nedre domängränsen"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_left
msgid "Enable collisions with left domain border"
msgstr "Aktivera kollisioner med den vänstra domängränsen"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_right
msgid "Enable collisions with right domain border"
msgstr "Aktivera kollisioner med den högra domängränsen"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_top
msgid "Enable collisions with top domain border"
msgstr "Aktivera kollisioner med den övre domängränsen"
