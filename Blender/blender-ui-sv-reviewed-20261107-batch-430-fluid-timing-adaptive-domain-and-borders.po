#. :src: bpy.types.FluidDomainSettings.time_scale
#. :src: bpy.types.CURVE_OT_extrude.mode:'TIME_SCALE'
#. :src: bpy.types.GRAPH_OT_duplicate.mode:'TIME_SCALE'
