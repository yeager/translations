msgstr "Beräkna medelvärde av spår"

#. :src: bpy.types.CLIP_OT_average_tracks
msgid "Average selected tracks into active"
msgstr "Beräkna medelvärdet av de valda spåren i det aktiva spåret"

#. :src: bpy.types.CACHEFILE_OT_layer_move.direction
msgid "Direction to move the active layer towards"
msgstr "Riktning som det aktiva lagret ska flyttas åt"

#. :src: bpy.types.BUTTONS_OT_context_menu
msgid "Display properties editor context_menu"
msgstr "Visa egenskapsredigerarens kontextmeny"

#. :src: bpy.types.BUTTONS_OT_toggle_pin
msgid "Keep the current data-block displayed"
msgstr "Behåll det aktuella datablocket synligt"

#. :src: bpy.types.CACHEFILE_OT_reload
