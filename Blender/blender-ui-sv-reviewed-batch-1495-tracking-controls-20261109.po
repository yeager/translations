#. :src: bpy.types.CLIP_OT_apply_solution_scale
msgctxt "Operator"
msgid "Apply Solution Scale"
msgstr "Tillämpa lösningens skala"

#. :src: bpy.types.CLIP_OT_apply_solution_scale
msgid ""
"Apply scale on solution itself to make distance between selected tracks "
"equals to desired"
msgstr ""
"Tillämpa lösningens skala så att avståndet mellan de valda spåren blir det "
"önskade"

#. :src: bpy.types.CLIP_OT_average_tracks
