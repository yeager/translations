#. :src: bpy.types.Driver
msgid "Driver for the value of a setting based on an external value"
msgstr "Drivrutin som styr värdet för en inställning utifrån ett externt värde"

#. :src: bpy.types.Driver.expression
msgid "Expression"
msgstr "Uttryck"

#. :src: bpy.types.Driver.is_simple_expression
msgid "Simple Expression"
msgstr "Enkelt uttryck"

#. :src: bpy.types.Driver.is_simple_expression
msgid ""
"The scripted expression can be evaluated without using the full Python "
"interpreter"
msgstr ""
"Det skriptade uttrycket kan utvärderas utan att använda hela Python-tolken"

#. :src: bpy.types.Driver.is_valid
#. :src: bpy.types.Sound.channels:'INVALID'
#: source/blender/editors/util/numinput.cc:121
msgid "Invalid"
msgstr "Ogiltig"

#. :src: bpy.types.Driver.is_valid
msgid "Driver could not be evaluated in past, so should be skipped"
msgstr "Drivrutinen kunde inte utvärderas tidigare och bör därför hoppas över"

#. :src: bpy.types.Driver.type
msgid "Driver type"
msgstr "Drivrutinstyp"

#. :src: bpy.types.Driver.type:'AVERAGE'
msgid "Averaged Value"
msgstr "Genomsnittsvärde"

#. :src: bpy.types.Driver.type:'SUM'
msgid "Sum Values"
msgstr "Summa av värden"

#. :src: bpy.types.Driver.type:'SCRIPTED'
msgid "Scripted Expression"
msgstr "Skriptat uttryck"
