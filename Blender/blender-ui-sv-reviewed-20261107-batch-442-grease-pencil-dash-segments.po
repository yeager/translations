#. :src: bpy.types.GreasePencilDashModifierSegment
msgid "Dash Modifier Segment"
msgstr "Streckmodifierarsegment"

#. :src: bpy.types.GreasePencilDashModifierSegment
#. :src: bpy.types.GreasePencilTimeModifierSegment
msgid "Configuration for a single dash segment"
msgstr "Inställningar för ett enskilt segment"

#. :src: bpy.types.GreasePencilDashModifierSegment.dash
msgid ""
"The number of consecutive points from the original stroke to include in this "
"segment"
msgstr ""
"Antalet på varandra följande punkter från det ursprungliga strecket som ska "
"ingå i detta segment"

#. :src: bpy.types.GreasePencilDashModifierSegment.gap
msgid "Gap"
msgstr "Mellanrum"

#. :src: bpy.types.GreasePencilDashModifierSegment.gap
msgid "The number of points skipped after this segment"
msgstr "Antalet punkter som hoppas över efter detta segment"

#. :src: bpy.types.GreasePencilDashModifierSegment.material_index
#. :src: bpy.types.ParticleSettings.material
#. :src: bpy.types.MeshLoopTriangle.material_index
#. :src: bpy.types.MeshPolygon.material_index
#. :src: bpy.types.BevelModifier.material
#. :src: bpy.types.GreasePencilEnvelopeModifier.mat_nr
#. :src: bpy.types.GeometryNodeInputMaterialIndex
#. :src: bpy.types.MESH_OT_bevel.material
#. :src: bpy.types.RenderLayer.use_pass_material_index
#. :src: bpy.types.Spline.material_index
#. :src: bpy.types.TextCharacterFormat.material_index
#. :src: bpy.types.ViewLayer.use_pass_material_index
#: source/blender/nodes/geometry/nodes/node_geo_input_material_index.cc:10
#: source/blender/nodes/geometry/nodes/node_geo_set_material_index.cc:22
#: source/blender/nodes/shader/nodes/node_shader_object_info.cc:16
msgid "Material Index"
msgstr "Materialindex"

#. :src: bpy.types.GreasePencilDashModifierSegment.material_index
msgid ""
"Use this index on generated segment. -1 means using the existing material."
msgstr ""
"Använd detta index för det genererade segmentet. -1 innebär att det "
"befintliga materialet används."

#. :src: bpy.types.GreasePencilDashModifierSegment.name
#. :src: bpy.types.GreasePencilTimeModifierSegment.name
msgid "Name of the dash segment"
msgstr "Namn på strecksegmentet"

#. :src: bpy.types.GreasePencilDashModifierSegment.opacity
msgid "The factor to apply to the original point's opacity for the new points"
msgstr ""
"Den faktor som ska tillämpas på den ursprungliga punktens opacitet för de "
"nya punkterna"

#. :src: bpy.types.GreasePencilDashModifierSegment.radius
msgid "The factor to apply to the original point's radius for the new points"
msgstr ""
"Den faktor som ska tillämpas på den ursprungliga punktens radie för de nya "
"punkterna"

#. :src: bpy.types.GreasePencilDashModifierSegment.use_cyclic
msgid "Enable cyclic on individual stroke dashes"
msgstr "Aktivera cykliskt läge för enskilda strecksegment"

#. :src: bpy.types.GreasePencilDrawing
msgid "Grease Pencil Drawing"
msgstr "Grease Pencil-ritning"

#. :src: bpy.types.GreasePencilDrawing
#. :src: bpy.types.GreasePencilFrame.drawing
msgid "A Grease Pencil drawing"
msgstr "En Grease Pencil-ritning"
