#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:94
msgid "Specifies if tone mapping operates on the entire image or per pixel, 0 means the entire image, 1 means it is per pixel, and values in between blends between both"
msgstr "Anger om tonmappningen tillämpas på hela bilden eller per pixel. 0 innebär hela bilden, 1 per pixel och mellanliggande värden blandar de två"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:103
msgid "Specifies if tone mapping operates on the luminance or on each channel independently, 0 means it uses luminance, 1 means it is per channel, and values in between blends between both"
msgstr "Anger om tonmappningen tillämpas på luminansen eller på varje kanal separat. 0 innebär luminans, 1 enskilda kanaler och mellanliggande värden blandar de två"

#: source/blender/nodes/composite/nodes/node_composite_vector_blur.cc:56
msgid "Time between shutter opening and closing in frames"
msgstr "Tiden mellan att slutaren öppnas och stängs, i bildrutor"

#: source/blender/render/intern/engine.cc:1071
msgid "Failed allocate render result, out of memory"
msgstr "Det gick inte att allokera renderingsresultatet: slut på minne"
