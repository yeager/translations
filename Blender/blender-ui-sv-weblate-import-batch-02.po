msgstr "Delar streckpunkten vid skärningslassot"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected
#: scripts/startup/bl_ui/space_view3d.py:1360
msgctxt "Operator"
msgid "Curve Edge Loops Between Selected"
msgstr "Kurvslingor mellan valda kanter"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected
msgid ""
"Fits the unselected edge loops to a curve defined by the selected vertices"
msgstr ""
"Anpassar de omarkerade kantringarna till en kurva som definieras av "
"markerade hörn"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation
msgid "Clamp Elevation"
msgstr "Begränsa höjd"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation
msgid ""
"Restrictions on how the vertices can be moved (wire edges are not supported)"
msgstr "Begränsningar av hur hörnen kan flyttas (trådkanter stöds inte)"

#. :src:
#. bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation:'NONE'
msgid "No restrictions on vertex movement"
msgstr "Inga begränsningar för hörnens rörelse"

#. :src:
#. bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation:'RAISE'
msgid "Only Raise"
msgstr "Endast höjning"

#. :src:
#. bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation:'RAISE'
msgid "Only allow extrusions"
msgstr "Tillåt endast extruderingar"

#. :src:
#. bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation:'LOWER'
msgid "Only Lower"
msgstr "Endast sänkning"

#. :src:
#. bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation:'LOWER'
msgid "Only allow indentation"
msgstr "Tillåt endast indragning"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.extend_loop
msgid "Extend Loop"
msgstr "Utöka slinga"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.extend_loop
msgid ""
"Extends the tool to work beyond the boundaries of the selected vertices"
msgstr ""
"Utökar verktyget så att det fungerar utanför gränserna för markerade hörn"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.factor
msgid "Curving factor"
msgstr "Krökningsfaktor"

#. :src:
#. bpy.types.MESH_OT_curve_edge_loops_between_selected.interpolation:'LINEAR'
msgid "Simple and fast linear algorithm"
msgstr "Enkel och snabb linjär algoritm"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.regular
msgid "Distribute vertices at constant distances along the curve"
msgstr "Fördela hörn med konstant avstånd längs kurvan"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation
#. :src: scripts/startup/bl_ui/space_view3d.py:1361
msgctxt "Operator"
msgid "Fit Edge Loops To Annotation"
msgstr "Anpassa kantringar till anteckning"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation
msgid "Stretch selected vertices to active stroke"
msgstr "Sträck markerade hörn till aktivt streck"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.delete_strokes
msgid "Delete Strokes"
msgstr "Ta bort streck"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.delete_strokes
msgid "Remove strokes if they have been used"
msgstr "Ta bort streck när de har använts"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.factor
msgid "Annotation factor"
msgstr "Anteckningsfaktor"
