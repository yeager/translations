#. :src: bpy.types.EXTENSIONS_OT_package_asset_library_disable
msgid ""
"Disable this asset library in Preferences (keeps the entry for re-enabling "
"later)"
msgstr ""
"Inaktivera detta tillgångsbibliotek i Inställningar (behåller posten så att "
"den kan återaktiveras senare)"

#. :src: bpy.types.EXTENSIONS_OT_package_asset_library_disable
msgctxt "Operator"
msgid "Disable asset library extension"
msgstr "Inaktivera tillägg för tillgångsbibliotek"

