#. :src: bpy.types.COLLECTION_OT_importer_remove
msgid ""
"Remove Collection Importer (does not delete any of the imported data in the "
"collection, if any)"
msgstr ""
"Ta bort samlingsimporteraren (tar inte bort importerade data i samlingen, om"
" sådana finns)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.collection_center_mode
msgid "Collection Center"
msgstr "Samlingscentrum"

