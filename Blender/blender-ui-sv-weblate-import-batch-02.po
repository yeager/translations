#. bpy.types.EXPORT_SCENE_OT_gltf.collection_center_mode:'OBJECT_POSITION'
msgid "Object Position"
msgstr "Objektposition"

#. :src:
#. bpy.types.EXPORT_SCENE_OT_gltf.collection_center_mode:'OBJECT_POSITION'
