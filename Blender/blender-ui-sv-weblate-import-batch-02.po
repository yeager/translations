msgstr "Exportera med samlingens instansförskjutning som scenursprung"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.collection_center_object
msgid "Center Object"
msgstr "Centrera objekt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.collection_center_object
msgid "Object to use as exported scene origin"
msgstr "Objekt att använda som den exporterade scenens ursprung"

