#. :src: bpy.types.WM_OT_tool_set_by_id_hold
msgid ""
"Set the tool by name while the key is held, restoring the previous tool on "
"release (for key-maps)"
msgstr ""
"Ange verktyget efter namn medan tangenten hålls ned och återställ föregående"
" verktyg när den släpps (för tangentmappningar)"

#. :src: bpy.types.WM_OT_tool_set_by_id_hold
msgctxt "Operator"
msgid "Set Tool by Name (Hold)"
msgstr "Välj verktyg efter namn (håll ned)"

#. :src: bpy.types.ANIM_OT_world_space_copy
msgctxt "Operator"
msgid "Copy World Space Range"
msgstr "Kopiera intervall i världskoordinater"

#. :src: bpy.types.ANIM_OT_world_space_copy
msgid "Copy animation from selected elements to the clipboard"
msgstr "Kopiera animering från valda element till urklipp"

#. :src: bpy.types.ANIM_OT_world_space_copy.end
msgid "End frame to copy from"
msgstr "Slutbildruta att kopiera från"

#. :src: bpy.types.ANIM_OT_world_space_copy.range_mode
msgid "Range Mode"
msgstr "Intervalläge"

#. :src: bpy.types.ANIM_OT_world_space_copy.range_mode
msgid "Determines which range should be copied"
msgstr "Anger vilket intervall som ska kopieras"

#. :src: bpy.types.ANIM_OT_world_space_copy.range_mode:'CUSTOM'
msgid "Use the range provided in the operator properties"
msgstr "Använd intervallet som anges i operatörsegenskaperna"

#. :src: bpy.types.ANIM_OT_world_space_copy.range_mode:'PLAYBACK'
msgid "Playback Range"
msgstr "Uppspelningsintervall"

#. :src: bpy.types.ANIM_OT_world_space_copy.range_mode:'PLAYBACK'
msgid "Use the playback range of the scene"
msgstr "Använd scenens uppspelningsintervall"

#. :src: bpy.types.ANIM_OT_world_space_copy.start
msgid "Start frame to copy from"
msgstr "Startbildruta att kopiera från"

#. :src: bpy.types.ANIM_OT_world_space_paste
msgctxt "Operator"
msgid "Paste World Space"
msgstr "Klistra in i världsrymden"

#. :src: bpy.types.ANIM_OT_world_space_paste
msgid "Paste the animation from the clipboard to selected elements"
msgstr "Klistra in animation från urklippet på valda element"

#. :src: bpy.types.ANIM_OT_world_space_paste.offset:'NONE'
msgid "Paste data to the same frames they were copied from"
msgstr "Klistra in data i samma bildrutor som de kopierades från"

#. :src: bpy.types.ANIM_OT_world_space_paste.offset:'START'
msgid "Start at Current Frame"
msgstr "Börja vid aktuell bildruta"

#. :src: bpy.types.ANIM_OT_world_space_paste.offset:'START'
msgid "Paste data starting at current frame"
msgstr "Klistra in data från den aktuella bildrutan"

