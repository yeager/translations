#. :src: bpy.types.GeometryNodeGetGridNames
msgid "Get Grid Names"
msgstr "Hämta rutnätsnamn"

#. :src: bpy.types.GeometryNodeGetGridNames
msgid ""
"Retrieves the names of all grids stored in a volume as a list of strings"
msgstr ""
"Hämtar namnen på alla rutnät som lagras i en volym som en lista med strängar"

#. :src: bpy.types.GeometryNodeGridSolvePoisson
msgid "Grid Solve Poisson"
msgstr "Lös Poisson-ekvationen för rutnät"

#. :src: bpy.types.GeometryNodeGridSolvePoisson
msgid ""
"Solve the Poisson equation for a scalar field. Computes a grid whose "
"Laplacian equals the input scalar grid."
msgstr ""
"Lös Poisson-ekvationen för ett skalärt fält. Beräknar ett rutnät vars "
"Laplaceoperator motsvarar indata från det skalära rutnätet."

