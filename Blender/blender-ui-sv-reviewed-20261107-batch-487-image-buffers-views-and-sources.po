#. :src: bpy.types.RenderSettings.use_multiview
msgid "Multiple Views"
msgstr "Flera vyer"

#. :src: bpy.types.Image.is_multiview
msgid "Image has more than one view"
msgstr "Bilden har mer än en vy"

#. :src: bpy.types.Image.is_stereo_3d
