#: scripts/startup/bl_ui/properties_output.py:440
msgid "Pixels"
msgstr "Bildpunkter"

#. :src: bpy.types.Image.pixels
msgid "Image buffer pixels in floating-point values"
msgstr "Bildbuffertens bildpunkter som flyttalsvärden"

#. :src: bpy.types.Image.render_slots
#. :src: bpy.types.IMAGE_PT_render_slots
msgid "Render Slots"
msgstr "Renderingsplatser"

