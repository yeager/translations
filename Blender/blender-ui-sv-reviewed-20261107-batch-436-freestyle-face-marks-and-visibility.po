#. :src: bpy.types.FreestyleLineSet.face_mark_condition
msgid "Face Mark Condition"
msgstr "Villkor för ytmarkering"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition
msgid "Specify a feature edge selection condition based on face marks"
msgstr "Ange ett urvalsvillkor för funktionskanter baserat på ytmarkeringar"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition:'ONE'
msgid "One Face"
msgstr "En yta"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition:'ONE'
msgid "Select a feature edge if either of its adjacent faces is marked"
msgstr "Välj en funktionskant om någon av dess angränsande ytor är markerad"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition:'BOTH'
msgid "Both Faces"
msgstr "Båda ytorna"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition:'BOTH'
msgid "Select a feature edge if both of its adjacent faces are marked"
msgstr "Välj en funktionskant om båda dess angränsande ytor är markerade"

#. :src: bpy.types.FreestyleLineSet.face_mark_negation
msgid "Face Mark Negation"
msgstr "Ytmarkeringsnegation"

#. :src: bpy.types.FreestyleLineSet.face_mark_negation
msgid ""
"Specify either inclusion or exclusion of feature edges selected by face marks"
msgstr ""
"Ange om funktionskanter som valts med ytmarkeringar ska inkluderas eller "
"uteslutas"

#. :src: bpy.types.FreestyleLineSet.face_mark_negation:'INCLUSIVE'
msgid "Select feature edges satisfying the given face mark conditions"
msgstr ""
"Välj funktionskanter som uppfyller de angivna villkoren för ytmarkering"

#. :src: bpy.types.FreestyleLineSet.face_mark_negation:'EXCLUSIVE'
msgid "Select feature edges not satisfying the given face mark conditions"
msgstr ""
"Välj funktionskanter som inte uppfyller de angivna villkoren för ytmarkering"

#. :src: bpy.types.FreestyleLineSet.linestyle
msgid "Line style settings"
msgstr "Inställningar för linjestil"

#. :src: bpy.types.FreestyleLineSet.name
msgid "Line Set Name"
msgstr "Linjeuppsättningens namn"

#. :src: bpy.types.FreestyleLineSet.name
msgid "Line set name"
msgstr "Linjeuppsättningens namn"

#. :src: bpy.types.FreestyleLineSet.qi_end
msgid "Last QI value of the QI range"
msgstr "Sista QI-värdet i QI-intervallet"

#. :src: bpy.types.FreestyleLineSet.qi_start
msgid "First QI value of the QI range"
msgstr "Första QI-värdet i QI-intervallet"

#. :src: bpy.types.FreestyleLineSet.select_border
msgid "Select border edges (open mesh edges)"
msgstr "Välj gränskanter (öppna meshkanter)"

#. :src: bpy.types.FreestyleLineSet.select_by_collection
msgid "Selection by Collection"
msgstr "Urval efter samling"

#. :src: bpy.types.FreestyleLineSet.select_by_collection
msgid "Select feature edges based on a collection of objects"
msgstr "Välj funktionskanter baserat på en samling objekt"

#. :src: bpy.types.FreestyleLineSet.select_by_edge_types
msgid "Selection by Edge Types"
msgstr "Urval efter kanttyper"

#. :src: bpy.types.FreestyleLineSet.select_by_edge_types
msgid "Select feature edges based on edge types"
msgstr "Välj funktionskanter baserat på kanttyper"

#. :src: bpy.types.FreestyleLineSet.select_by_face_marks
msgid "Selection by Face Marks"
msgstr "Urval med ytmarkeringar"

#. :src: bpy.types.FreestyleLineSet.select_by_face_marks
msgid "Select feature edges by face marks"
msgstr "Välj funktionskanter med hjälp av ytmarkeringar"

#. :src: bpy.types.FreestyleLineSet.select_by_image_border
msgid "Selection by Image Border"
msgstr "Urval efter bildkant"

#. :src: bpy.types.FreestyleLineSet.select_by_image_border
msgid "Select feature edges by image border (less memory consumption)"
msgstr "Välj funktionskanter efter bildkant (mindre minnesförbrukning)"

#. :src: bpy.types.FreestyleLineSet.select_by_visibility
msgid "Selection by Visibility"
msgstr "Urval efter synlighet"

#. :src: bpy.types.FreestyleLineSet.select_by_visibility
msgid "Select feature edges based on visibility"
msgstr "Välj funktionskanter baserat på synlighet"

#. :src: bpy.types.FreestyleLineSet.select_contour
msgid "Select contours (outer silhouettes of each object)"
msgstr "Välj konturer (yttre silhuetter av varje objekt)"

#. :src: bpy.types.FreestyleLineSet.select_crease
msgid ""
"Select crease edges (those between two faces making an angle smaller than "
"the Crease Angle)"
msgstr ""
"Välj veckkanter (de mellan två ytor som bildar en vinkel som är mindre än "
"veckvinkeln)"

#. :src: bpy.types.FreestyleLineSet.select_edge_mark
msgid "Select edge marks (edges annotated by Freestyle edge marks)"
msgstr ""
"Välj kantmarkeringar (kanter som markerats med Freestyle-kantmarkeringar)"

#. :src: bpy.types.FreestyleLineSet.select_external_contour
msgid ""
"Select external contours (outer silhouettes of occluding and occluded "
"objects)"
msgstr ""
"Välj externa konturer (yttre silhuetter av skymmande och skymda objekt)"

#. :src: bpy.types.FreestyleLineSet.select_material_boundary
msgid "Select edges at material boundaries"
msgstr "Välj kanter vid materialgränser"

#. :src: bpy.types.FreestyleLineSet.select_ridge_valley
msgid ""
"Select ridges and valleys (boundary lines between convex and concave areas "
"of surface)"
msgstr ""
"Välj åsar och dalar (gränslinjer mellan konvexa och konkava områden på ytan)"

#. :src: bpy.types.FreestyleLineSet.select_silhouette
msgid "Select silhouettes (edges at the boundary of visible and hidden faces)"
msgstr "Välj silhuetter (kanter vid gränsen mellan synliga och dolda ytor)"

#. :src: bpy.types.FreestyleLineSet.select_suggestive_contour
msgid "Select suggestive contours (almost silhouette/contour edges)"
msgstr "Välj suggestiva konturer (nästan silhuett/konturkanter)"

#. :src: bpy.types.FreestyleLineSet.show_render
msgid "Enable or disable this line set during stroke rendering"
msgstr ""
"Aktivera eller inaktivera den här linjeuppsättningen vid streckrendering"

#. :src: bpy.types.FreestyleLineSet.visibility
#. :src: bpy.types.OUTLINER_MT_collection_visibility
#. :src: bpy.types.COLLECTION_PT_collection_flags
#. :src: bpy.types.CYCLES_OBJECT_PT_visibility
#. :src: bpy.types.DATA_PT_lightprobe_visibility
#. :src: bpy.types.OBJECT_PT_visibility
#. :src: bpy.types.VIEWLAYER_PT_freestyle_lineset_visibilty
msgid "Visibility"
msgstr "Synlighet"

#. :src: bpy.types.FreestyleLineSet.visibility
msgid "Determine how to use visibility for feature edge selection"
msgstr "Bestäm hur synlighet ska användas för urval av funktionskanter"

#. :src: bpy.types.FreestyleLineSet.visibility:'VISIBLE'
msgid "Select visible feature edges"
msgstr "Välj synliga funktionskanter"

#. :src: bpy.types.FreestyleLineSet.visibility:'HIDDEN'
#. :src: bpy.types.Property.is_hidden
msgid "Hidden"
msgstr "Dold"

#. :src: bpy.types.FreestyleLineSet.visibility:'HIDDEN'
msgid "Select hidden feature edges"
msgstr "Välj dolda funktionskanter"

#. :src: bpy.types.FreestyleLineSet.visibility:'RANGE'
msgid "Quantitative Invisibility"
msgstr "Kvantitativ osynlighet"

#. :src: bpy.types.FreestyleLineSet.visibility:'RANGE'
msgid ""
"Select feature edges within a range of quantitative invisibility (QI) values"
msgstr ""
"Välj funktionskanter inom ett intervall av kvantitativa osynlighetsvärden "
"(QI)"
