#: scripts/startup/bl_operators/geometry_nodes.py:234
msgid "Node group must have a geometry output"
msgstr "Nodgruppen måste ha geometriutdata"

#: scripts/startup/bl_ui/properties_strip.py:170
msgid "Node group must have an output."
msgstr "Nodgruppen måste ha ett utdatauttag."

#: scripts/startup/bl_ui/properties_strip.py:176
msgid "The first node group output must have the Color type."
msgstr "Det första nodgruppsutdatauttaget måste ha typen färg."

#: scripts/startup/bl_ui/properties_strip.py:158
msgid "Node group must have at least {:d} Color input(s)."
msgstr "Nodgruppen måste ha minst {:d} färgindata."

#: source/blender/editors/object/object_relations.cc:3145
msgid "The node group must have a geometry output socket"
msgstr "Nodgruppen måste ha ett geometriutdatauttag"

#: source/blender/editors/object/object_relations.cc:3151
msgid "The first output must be a geometry socket"
msgstr "Det första utdatauttaget måste vara ett geometriuttag"

#: source/blender/makesrna/intern/rna_nodetree.cc:1529
msgid "Same input/output direction of sockets"
msgstr "Samma indata-/utdatariktning för uttagen"

#: source/blender/makesrna/intern/rna_nodetree.cc:2901
msgid "Output sockets cannot be multi-input"
msgstr "Utdatauttag kan inte vara fleringångsuttag"

#: source/blender/modifiers/intern/MOD_nodes.cc:1750
msgid "Node group must have an output socket"
msgstr "Nodgruppen måste ha ett utdatauttag"
