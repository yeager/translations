#. :src: bpy.types.ParticleSettings.effect_hair
msgid "Hair stiffness for effectors"
msgstr "Hårstyvhet för effektorer"

#. :src: bpy.types.ParticleSettings.effector_amount
msgid "Effector Number"
msgstr "Effektornummer"

#. :src: bpy.types.ParticleSettings.effector_amount
msgid "How many particles are effectors (0 is all particles)"
msgstr "Hur många partiklar är effektorer (0 är alla partiklar)"

#. :src: bpy.types.ParticleSettings.emit_from
msgid "Emit From"
msgstr "Sänd ut från"

#. :src: bpy.types.ParticleSettings.emit_from
msgid "Where to emit particles from"
msgstr "Varifrån partiklar ska sändas ut"

#. :src: bpy.types.ParticleSettings.factor_random
msgid "Give the starting velocity a random variation"
msgstr "Ge starthastigheten en slumpmässig variation"

#. :src: bpy.types.ParticleSettings.fluid
#. :src: bpy.types.SPHFluidSettings
msgid "SPH Fluid Settings"
msgstr "Inställningar för SPH-vätska"

#. :src: bpy.types.ParticleSettings.force_field_1
msgid "Force Field 1"
msgstr "Kraftfält 1"

#. :src: bpy.types.ParticleSettings.force_field_2
msgid "Force Field 2"
msgstr "Kraftfält 2"

#. :src: bpy.types.ParticleSettings.frame_end
msgid "Frame number to stop emitting particles"
msgstr "Bildrutenummer för att sluta sända ut partiklar"

#. :src: bpy.types.ParticleSettings.frame_start
msgid "Frame number to start emitting particles"
msgstr "Bildrutenummer för att börja sända ut partiklar"

#. :src: bpy.types.ParticleSettings.grid_random
msgid "Grid Randomness"
msgstr "Slumpmässighet i nätet"

#. :src: bpy.types.ParticleSettings.grid_random
msgid "Add random offset to the grid locations"
msgstr "Lägg till slumpmässig förskjutning till rutnätets platser"

#. :src: bpy.types.ParticleSettings.grid_resolution
msgid "The resolution of the particle grid"
msgstr "Upplösningen på partikelgallret"

#. :src: bpy.types.ParticleSettings.hair_length
#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
msgid "Hair Length"
msgstr "Hårets längd"

#. :src: bpy.types.ParticleSettings.hair_length
msgid "Length of the hair"
msgstr "Hårets längd"

#. :src: bpy.types.ParticleSettings.hair_step
msgid "Number of hair segments"
msgstr "Antal hårsegment"

#. :src: bpy.types.ParticleSettings.hexagonal_grid
msgid "Hexagonal Grid"
msgstr "Hexagonalt rutnät"

#. :src: bpy.types.ParticleSettings.hexagonal_grid
msgid "Create the grid in a hexagonal pattern"
msgstr "Skapa rutnätet i ett hexagonalt mönster"

#. :src: bpy.types.ParticleSettings.instance_collection
msgid "Show objects in this collection in place of particles"
msgstr "Visa objekt i denna samling i stället för partiklar"

#. :src: bpy.types.ParticleSettings.instance_object
msgid "Show this object in place of particles"
msgstr "Visa detta objekt i stället för partiklar"

#. :src: bpy.types.ParticleSettings.instance_weights
msgid "Instance Collection Weights"
msgstr "Instanssamlingsvikter"

#. :src: bpy.types.ParticleSettings.instance_weights
msgid "Weights for all of the objects in the instance collection"
msgstr "Vikter för alla objekt i instanssamlingen"

#. :src: bpy.types.ParticleSettings.integrator
#. :src: bpy.types.PARTICLE_PT_physics_integration
msgid "Integration"
msgstr "Integrering"

#. :src: bpy.types.ParticleSettings.integrator
msgid ""
"Algorithm used to calculate physics, from the fastest to the most stable and "
"accurate: Midpoint, Euler, Verlet, RK4"
msgstr ""
"Algoritm som används för att beräkna fysik, från den snabbaste till den mest "
"stabila och exakta: Mittpunkt, Euler, Verlet, RK4"

#. :src: bpy.types.ParticleSettings.integrator:'EULER'
#. :src: bpy.types.FunctionNodeRotateEuler.rotation_type:'EULER'
#. :src: bpy.types.ShaderNodeVectorRotate.rotation_type:'EULER_XYZ'
#: source/blender/nodes/function/nodes/node_fn_euler_to_rotation.cc:16
#: source/blender/nodes/function/nodes/node_fn_rotation_to_euler.cc:17
msgid "Euler"
msgstr "Euler"

#. :src: bpy.types.ParticleSettings.integrator:'VERLET'
msgid "Verlet"
msgstr "Verlet"

#. :src: bpy.types.ParticleSettings.integrator:'MIDPOINT'
#. :src: bpy.types.GeometryNodeStringToCurves.pivot_mode:'MIDPOINT'
msgid "Midpoint"
msgstr "Mittpunkt"

#. :src: bpy.types.ParticleSettings.integrator:'RK4'
msgid "RK4"
msgstr "RK4"

#. :src: bpy.types.ParticleSettings.invert_grid
msgid "Invert Grid"
msgstr "Invertera rutnätet"

#. :src: bpy.types.ParticleSettings.invert_grid
msgid "Invert what is considered object and what is not"
msgstr "Invertera vad som betraktas som objekt och vad som inte gör det"

#. :src: bpy.types.ParticleSettings.is_fluid
msgid "Particles were created by a fluid simulation"
msgstr "Partiklarna skapades genom en vätskesimulering"

#. :src: bpy.types.ParticleSettings.jitter_factor
msgid "Amount of jitter applied to the sampling"
msgstr "Mängden slumpvariation som tillämpas på samplingen"

#. :src: bpy.types.ParticleSettings.keyed_loops
msgid "Loop Count"
msgstr "Antal slingor"

#. :src: bpy.types.ParticleSettings.keyed_loops
msgid "Number of times the keys are looped"
msgstr "Antal gånger nycklarna upprepas"

#. :src: bpy.types.ParticleSettings.keys_step
msgid "Keys Step"
msgstr "Steg mellan nycklar"
