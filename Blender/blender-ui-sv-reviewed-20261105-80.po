msgstr "Övre baslinje"

#. :src: bpy.types.TextCurve.align_y:'BOTTOM_BASELINE'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'BOTTOM_BASELINE'
msgid "Bottom Baseline"
msgstr "Nedre baslinje"

#. :src: bpy.types.TextCurve.body
msgid "Body Text"
msgstr "Brödtext"

#. :src: bpy.types.TextCurve.body_format
