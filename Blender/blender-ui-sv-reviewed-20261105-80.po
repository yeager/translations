#. :src: bpy.types.FreestyleLineStyle
msgid "Freestyle Line Style"
msgstr "Freestyle-linjestil"

#. :src: bpy.types.FreestyleLineStyle.alpha
#. :src: bpy.types.LineStyleAlphaModifier_Material.material_attribute:'ALPHA'
#. :src: bpy.types.LineStyleColorModifier_Material.material_attribute:'ALPHA'
#. :src: bpy.types.LineStyleThicknessModifier_Material.material_attribute:'ALPHA'
msgid "Alpha Transparency"
msgstr "Alfatransparens"

#. :src: bpy.types.FreestyleLineStyle.caps
#: source/blender/modifiers/intern/MOD_array.cc:1063
msgid "Caps"
msgstr "Ändlock"

#. :src: bpy.types.FreestyleLineStyle.caps:'BUTT'
msgid "Butt cap (flat)"
msgstr "Stumt ändlock (platt)"

#. :src: bpy.types.FreestyleLineStyle.caps:'ROUND'
msgid "Round cap (half-circle)"
msgstr "Runt ändlock (halvcirkel)"

#. :src: bpy.types.FreestyleLineStyle.chaining:'SKETCHY'
msgid "Sketchy chaining with a multiple touch"
msgstr "Skissartad kedjning med flera beröringar"

#. :src: bpy.types.FreestyleLineStyle.dash1
#: scripts/startup/bl_ui/properties_freestyle.py:652
#: scripts/startup/bl_ui/properties_freestyle.py:758
msgid "Dash 1"
msgstr "Streck 1"

#. :src: bpy.types.FreestyleLineStyle.dash2
msgid "Dash 2"
msgstr "Streck 2"

#. :src: bpy.types.FreestyleLineStyle.dash3
msgid "Dash 3"
msgstr "Streck 3"

#. :src: bpy.types.FreestyleLineStyle.gap1
#: scripts/startup/bl_ui/properties_freestyle.py:656
#: scripts/startup/bl_ui/properties_freestyle.py:762
msgid "Gap 1"
msgstr "Mellanrum 1"

#. :src: bpy.types.FreestyleLineStyle.gap2
msgid "Gap 2"
msgstr "Mellanrum 2"

#. :src: bpy.types.FreestyleLineStyle.gap3
msgid "Gap 3"
msgstr "Mellanrum 3"

#. :src: bpy.types.FreestyleLineStyle.geometry_modifiers
#. :src: bpy.types.LineStyleGeometryModifiers
msgid "Geometry Modifiers"
msgstr "Geometrimodifierare"

#. :src: bpy.types.FreestyleLineStyle.geometry_modifiers
msgid "List of stroke geometry modifiers"
msgstr "Lista över streckgeometrimodifierare"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'MEAN'
msgid ""
"The value computed for the chain is the mean of the values obtained for "
"chain vertices"
msgstr ""
"Det värde som beräknas för kedjan är medelvärdet av de värden som erhålls "
"för kedjans hörnpunkter"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'MIN'
msgid ""
"The value computed for the chain is the minimum of the values obtained for "
"chain vertices"
msgstr ""
"Det värde som beräknas för kedjan är det lägsta av de värden som erhålls för "
"kedjans hörnpunkter"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'FIRST'
msgid ""
"The value computed for the chain is the value obtained for the first chain "
"vertex"
msgstr ""
"Det värde som beräknas för kedjan är det värde som erhålls för kedjans "
"första hörnpunkt"

#. :src: bpy.types.FreestyleLineStyle.material_boundary
msgid "If true, chains of feature edges are split at material boundaries"
msgstr "Om alternativet är aktiverat delas funktionskanter vid materialgränser"

#. :src: bpy.types.FreestyleLineStyle.panel:'STROKES'
msgid "Show the panel for stroke construction"
msgstr "Visa panelen för streckkonstruktion"

#. :src: bpy.types.FreestyleLineStyle.panel:'GEOMETRY'
msgid "Show the panel for stroke geometry options"
msgstr "Visa panelen för alternativ för streckgeometri"

#. :src: bpy.types.FreestyleLineStyle.panel:'TEXTURE'
msgid "Show the panel for stroke texture options"
msgstr "Visa panelen för alternativ för strecktextur"

#. :src: bpy.types.FreestyleLineStyle.rounds
#. :src: bpy.types.LineStyleGeometryModifier_Blueprint.rounds
msgid "Rounds"
msgstr "Rundor"

#. :src: bpy.types.FreestyleLineStyle.rounds
msgid "Number of rounds in a sketchy multiple touch"
msgstr "Antal rundor vid skissartad kedjning med flera beröringar"

#. :src: bpy.types.FreestyleLineStyle.sort_key
msgid "Sort Key"
msgstr "Sorteringsnyckel"

#. :src: bpy.types.FreestyleLineStyle.sort_key
msgid "Select the sort key to determine the stacking order of chains"
msgstr "Välj sorteringsnyckel för att bestämma kedjornas staplingsordning"

