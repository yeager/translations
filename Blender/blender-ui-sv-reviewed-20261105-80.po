#. :src: bpy.types.GeometryNodeStringToCurves.overflow:'OVERFLOW'
#: scripts/startup/bl_ui/properties_data_curve.py:413
msgid "Overflow"
msgstr "Överflöde"

#. :src: bpy.types.TextCurve.overflow:'TRUNCATE'
msgid "Truncate the text that would go outside the text boxes"
msgstr "Korta av text som skulle hamna utanför textrutorna"

