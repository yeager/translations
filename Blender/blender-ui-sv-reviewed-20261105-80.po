#. :src: bpy.types.Curve.use_fill_caps
msgid "Fill caps for beveled curves"
msgstr "Fyll ändarna på avfasade kurvor"

#. :src: bpy.types.Curve.use_map_taper
msgid "Map Taper"
msgstr "Kartlägg avsmalning"

#. :src: bpy.types.Curve.use_path
msgid "Enable the curve to become a translation path"
msgstr "Gör det möjligt att använda kurvan som förflyttningsbana"

#. :src: bpy.types.Curve.use_path_clamp
msgid ""
"Clamp the curve path children so they can't travel past the start/end point "
"of the curve"
msgstr ""
"Begränsa objekten som följer kurvbanan så att de inte kan färdas förbi "
"kurvans start- eller slutpunkt"

#. :src: bpy.types.Curve.use_stretch
msgid "Option for curve-deform: make deformed child stretch along entire path"
msgstr ""
"Alternativ för kurvdeformering: gör att det deformerade underordnade "
"objektet sträcker sig längs hela banan"

#. :src: bpy.types.SurfaceCurve
msgid "Curve data-block used for storing surfaces"
msgstr "Kurvdatablock som används för att lagra ytor"

#. :src: bpy.types.TextCurve
msgid "Curve data-block used for storing text"
msgstr "Kurvdatablock som används för att lagra text"

#. :src: bpy.types.TextCurve.align_x:'JUSTIFY'
msgid "Align to the left and the right"
msgstr "Justera mot vänster och höger kant"

#. :src: bpy.types.TextCurve.align_y:'TOP_BASELINE'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'TOP_BASELINE'
