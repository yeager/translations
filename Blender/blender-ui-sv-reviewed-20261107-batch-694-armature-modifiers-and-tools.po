#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_ARMATURE'
#. :src: bpy.types.GreasePencilArmatureModifier
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_ARMATURE'
msgid "Deform stroke points using armature object"
msgstr "Deformera streckpunkter med hjälp av ett armaturobjekt"

#. :src: bpy.types.Modifier.type:'ARMATURE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'ARMATURE'
msgid "Deform the shape using an armature object"
msgstr "Deformera formen med hjälp av ett armaturobjekt"

#. :src: bpy.types.Modifier.type:'MASK'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MASK'
msgid "Dynamically hide vertices based on a vertex group or armature"
msgstr "Dölj hörnpunkter dynamiskt baserat på en hörnpunktsgrupp eller armatur"

#. :src: bpy.types.ToolSettings.anim_mirror_object
msgid ""
"Object to mirror over. Leave empty and name a bone to always mirror over "
"that bone of the active armature"
msgstr ""
"Objekt att spegla över. Lämna tomt och namnge ett ben för att alltid spegla "
"över det benet på den aktiva armaturen"

#. :src: bpy.types.Itasc.translate_root_bones
msgid "Translate root (i.e. parentless) bones to the armature origin"
msgstr ""
"Förflytta rotben (dvs. ben utan överordnade ben) till armaturens ursprung"
