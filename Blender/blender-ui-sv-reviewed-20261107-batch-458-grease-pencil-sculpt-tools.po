#. :src: bpy.types.Brush.gpencil_sculpt_tool:'RANDOMIZE'
msgid "Introduce jitter/randomness into strokes"
msgstr "Inför slumpmässighet i streck"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'GRAB'
msgctxt "GPencil"
msgid "Grab"
msgstr "Dra"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'GRAB'
msgid "Translate the set of points initially within the brush circle"
msgstr ""
"Flytta uppsättningen punkter som ursprungligen ligger inom penselcirkeln"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'PUSH'
msgctxt "GPencil"
msgid "Push"
msgstr "Tryck"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'PUSH'
msgid "Move points out of the way, as if combing them"
msgstr "Flytta punkterna ur vägen, som om du kammade dem"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'TWIST'
msgctxt "GPencil"
msgid "Twist"
msgstr "Vridning"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'TWIST'
msgid "Rotate points around the midpoint of the brush"
msgstr "Rotera punkterna runt penselns mittpunkt"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'PINCH'
msgctxt "GPencil"
msgid "Pinch"
msgstr "Nyp"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'PINCH'
msgid "Pull points towards the midpoint of the brush"
msgstr "Dra punkterna mot penselns mittpunkt"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'CLONE'
msgid "Paste copies of the strokes stored on the internal clipboard"
msgstr "Klistra in kopior av penseldrag som lagras i det interna urklippet"

#. :src: bpy.types.Brush.gpencil_settings
msgid "Gpencil Settings"
msgstr "Inställningar för Grease Pencil"

#. :src: bpy.types.Brush.gpencil_tool
#. :src: bpy.types.Brush.image_tool
#. :src: bpy.types.Brush.sculpt_tool
msgctxt "Brush"
msgid "Brush Type"
msgstr "Penseltyp"

#. :src: bpy.types.Brush.gpencil_tool:'TINT'
msgctxt "Brush"
msgid "Tint"
msgstr "Tona"

#. :src: bpy.types.Brush.gpencil_tool:'TINT'
msgid "The brush is of type used for tinting strokes"
msgstr "Penseln är av den typ som används för toning av streck"

#. :src: bpy.types.Brush.gpencil_vertex_tool
#. :src: bpy.types.Brush.gpencil_weight_tool
#. :src: bpy.types.Brush.vertex_tool
#. :src: bpy.types.Brush.weight_tool
#. :src: bpy.types.WM_OT_tool_set_by_brush_type.brush_type
#. :src: bpy.types.WorkSpaceTool.brush_type
msgid "Brush Type"
msgstr "Penseltyp"

#. :src: bpy.types.Brush.gpencil_vertex_tool:'DRAW'
#. :src: bpy.types.Brush.vertex_tool:'DRAW'
#. :src: bpy.types.Brush.weight_tool:'DRAW'
#. :src: bpy.types.Menu
#. :src: bpy.types.VIEW3D_MT_paint_grease_pencil
#. :src: bpy.types.Panel
#. :src: bpy.types.VIEW3D_PT_greasepencil_draw_context_menu
#. :src: Asset catalog from blender_assets.cats.txt
#: source/blender/editors/gpencil_legacy/annotate_paint.cc:1959
#: source/blender/editors/gpencil_legacy/annotate_paint.cc:1963
msgid "Draw"
msgstr "Rita"

#. :src: bpy.types.Brush.gpencil_vertex_tool:'DRAW'
msgid "Paint a color on stroke points"
msgstr "Måla en färg på streckpunkter"

#. :src: bpy.types.Brush.gpencil_vertex_tool:'BLUR'
#. :src: bpy.types.Brush.gpencil_weight_tool:'BLUR'
#. :src: bpy.types.Brush.vertex_tool:'BLUR'
#. :src: bpy.types.Brush.weight_tool:'BLUR'
#. :src: bpy.types.NODE_MT_category_compositor_filter_blur
#. :src: bpy.types.CompositorNodeBlur
#. :src: bpy.types.SCULPT_OT_mask_from_cavity.blur_steps
#. :src: bpy.types.ShaderFxRim.blur
#. :src: bpy.types.ShaderFxShadow.blur
#. :src: bpy.types.View3DShading.studiolight_background_blur
#: scripts/startup/bl_ui/properties_data_lightprobe.py:157
#: scripts/startup/bl_ui/properties_paint_common.py:1246
#: scripts/startup/bl_ui/space_sequencer.py:1836
#: scripts/startup/bl_ui/space_view3d.py:8758
#: source/blender/shader_fx/intern/FX_shader_blur.cc:64
msgid "Blur"
msgstr "Oskärpa"

#. :src: bpy.types.Brush.gpencil_vertex_tool:'BLUR'
msgid "Smooth out the colors of adjacent stroke points"
msgstr "Jämna ut färgerna på intilliggande streckpunkter"

#. :src: bpy.types.Brush.gpencil_vertex_tool:'AVERAGE'
msgid "Smooth out colors with the average color under the brush"
msgstr "Jämna ut färger med den genomsnittliga färgen under penseln"

#. :src: bpy.types.Brush.gpencil_vertex_tool:'SMEAR'
#. :src: bpy.types.Brush.gpencil_weight_tool:'SMEAR'
#. :src: bpy.types.Brush.vertex_tool:'SMEAR'
#. :src: bpy.types.Brush.weight_tool:'SMEAR'
msgid "Smear"
msgstr "Smeta"

#. :src: bpy.types.Brush.gpencil_vertex_tool:'SMEAR'
msgid "Smudge colors by grabbing and dragging them"
msgstr "Smeta ut färger genom att flytta dem"

#. :src: bpy.types.Brush.gpencil_vertex_tool:'REPLACE'
msgid "Replace the color of stroke points that already have a color applied"
msgstr "Ersätt färgen på streckpunkter som redan har färg"

#. :src: bpy.types.Brush.gpencil_weight_tool:'WEIGHT'
msgid "Paint weight in active vertex group"
msgstr "Måla vikt i aktiv hörnpunktsgrupp"

#. :src: bpy.types.Brush.gpencil_weight_tool:'BLUR'
msgid "Blur weight in active vertex group"
msgstr "Jämna ut vikt i aktiv hörnpunktsgrupp"

#. :src: bpy.types.Brush.gpencil_weight_tool:'AVERAGE'
msgid "Average weight in active vertex group"
msgstr "Genomsnittlig vikt i aktiv hörnpunktsgrupp"

#. :src: bpy.types.Brush.gpencil_weight_tool:'SMEAR'
msgid "Smear weight in active vertex group"
msgstr "Smeta ut vikt i aktiv hörnpunktsgrupp"
