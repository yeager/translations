#. :src: bpy.types.ActionConstraint.action_slot
#. :src: bpy.types.NlaStrip.action_slot
msgid "The slot identifies which sub-set of the Action is considered to be for this strip, and its name is used to find the right slot when assigning another Action"
msgstr "Action-slotten identifierar vilken delmängd av Actionen som hör till den här remsan. Namnet används för att hitta rätt Action-slot när en annan Action tilldelas"

#. :src: bpy.types.ActionConstraint.action_suitable_slots
#. :src: bpy.types.NlaStrip.action_suitable_slots
msgid "The list of action slots suitable for this NLA strip"
msgstr "Listan över Action-slotar som lämpar sig för denna NLA-remsa"

#. :src: bpy.types.ActionConstraint.last_slot_identifier
msgid "The identifier of the most recently assigned action slot. The slot identifies which sub-set of the Action is considered to be for this constraint, and its identifier is used to find the right slot when assigning an Action."
msgstr "Identifieraren för den senast tilldelade Action-slotten. Action-slotten anger vilken delmängd av Actionen som avses för denna begränsning, och dess identifierare används för att hitta rätt Action-slot när en Action tilldelas."

#. :src: bpy.types.ActionSlot.action
msgid "Action to apply to the rig via constraints"
msgstr "Action som ska tillämpas på riggen via begränsningar"

#. :src: bpy.types.ActionSlot.action_slot_ui
msgid "Slot of the Action to use for the Action Constraints"
msgstr "Action-slot för Actionen som ska användas för Action-begränsningarna"

#. :src: bpy.types.ActionSlot.enabled
msgid "Create constraints for this action on the generated rig"
msgstr "Skapa begränsningar för denna Action på den genererade riggen"

#. :src: bpy.types.ActionSlot.frame_end
msgid "Last frame of the action's timeline"
msgstr "Sista bildrutan på Actionens tidslinje"

#. :src: bpy.types.SpaceDopeSheetEditor.mode:'ACTION'
#. :src: bpy.types.SpaceDopeSheetEditor.ui_mode:'ACTION'
msgid "Action Editor"
msgstr "Action-redigerare"

#. :src: bpy.types.SpaceDopeSheetEditor.mode:'ACTION'
#. :src: bpy.types.SpaceDopeSheetEditor.ui_mode:'ACTION'
msgid "Edit keyframes in active object's Object-level action"
msgstr "Redigera nyckelbildrutor i det aktiva objektets Action på objektnivå"

#: source/blender/makesrna/intern/rna_constraint.cc:726
msgid "Could not assign action %s to Action Constraint %s"
msgstr "Kunde inte tilldela Actionen %s till Action-begränsningen %s"
