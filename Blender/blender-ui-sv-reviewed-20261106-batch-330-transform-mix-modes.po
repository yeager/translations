#. :src: bpy.types.TransformConstraint.mix_mode
msgid "Location Mix Mode"
msgstr "Blandningsläge för position"

#. :src: bpy.types.TransformConstraint.mix_mode
msgid "Specify how to combine the new location with original"
msgstr "Ange hur den nya positionen ska kombineras med den ursprungliga"

#. :src: bpy.types.TransformConstraint.mix_mode:'REPLACE'
#. :src: bpy.types.TransformConstraint.mix_mode_rot:'REPLACE'
#. :src: bpy.types.TransformConstraint.mix_mode_scale:'REPLACE'
msgid "Replace component values"
msgstr "Ersätt komponentvärden"

#. :src: bpy.types.TransformConstraint.mix_mode:'ADD'
#. :src: bpy.types.TransformConstraint.mix_mode_rot:'ADD'
msgid "Add component values together"
msgstr "Addera komponentvärdena"

#. :src: bpy.types.TransformConstraint.mix_mode_rot
msgid "Rotation Mix Mode"
msgstr "Blandningsläge för rotation"

#. :src: bpy.types.TransformConstraint.mix_mode_rot
msgid "Specify how to combine the new rotation with original"
msgstr "Ange hur den nya rotationen ska kombineras med den ursprungliga"

#. :src: bpy.types.TransformConstraint.mix_mode_rot:'BEFORE'
msgid "Apply new rotation before original, as if it was on a parent"
msgstr ""
"Tillämpa den nya rotationen före originalet, som om den tillämpades på ett "
"överordnat objekt"

#. :src: bpy.types.TransformConstraint.mix_mode_rot:'AFTER'
msgid "Apply new rotation after original, as if it was on a child"
msgstr ""
"Tillämpa den nya rotationen efter originalet, som om den tillämpades på ett "
"underordnat objekt"

#. :src: bpy.types.TransformConstraint.mix_mode_scale
msgid "Scale Mix Mode"
msgstr "Blandningsläge för skala"

#. :src: bpy.types.TransformConstraint.mix_mode_scale
msgid "Specify how to combine the new scale with original"
msgstr "Ange hur den nya skalan ska kombineras med den ursprungliga"

#. :src: bpy.types.TransformConstraint.mix_mode_scale:'MULTIPLY'
msgid "Multiply component values together"
msgstr "Multiplicera komponentvärden"
