#. :src: bpy.types.Bone.head_local
msgid "Armature-Relative Head"
msgstr "Huvud relativt riggskelettet"

#. :src: bpy.types.Bone.head_local
msgid "Location of head end of the bone relative to armature"
msgstr "Placering av benets huvudände i förhållande till riggskelettet"

#. :src: bpy.types.Bone.head_radius
#. :src: bpy.types.EditBone.head_radius
msgid "Envelope Head Radius"
msgstr "Kuvertets huvudradie"

#. :src: bpy.types.Bone.head_radius
#. :src: bpy.types.EditBone.head_radius
msgid "Radius of head of bone (for Envelope deform only)"
msgstr "Radie för benets huvud (endast för kuvertdeformering)"

#. :src: bpy.types.Bone.inherit_scale:'FULL'
#. :src: bpy.types.EditBone.inherit_scale:'FULL'
msgid "Inherit all effects of parent scaling"
msgstr "Ärv alla effekter av den överordnades skalning"

#. :src: bpy.types.Bone.inherit_scale:'FIX_SHEAR'
#. :src: bpy.types.EditBone.inherit_scale:'FIX_SHEAR'
msgid "Fix Shear"
msgstr "Korrigera skjuvning"

#. :src: bpy.types.Bone.inherit_scale:'FIX_SHEAR'
#. :src: bpy.types.EditBone.inherit_scale:'FIX_SHEAR'
msgid ""
"Inherit scaling, but remove shearing of the child in the rest orientation"
msgstr ""
"Ärv skalning, men ta bort skjuvningen av det underordnade benet i "
"viloorienteringen"

#. :src: bpy.types.Bone.inherit_scale:'ALIGNED'
#. :src: bpy.types.EditBone.inherit_scale:'ALIGNED'
msgid ""
"Rotate non-uniform parent scaling to align with the child, applying parent X "
"scale to child X axis, and so forth"
msgstr ""
"Rotera den överordnades ojämna skalning så att den anpassas till det "
"underordnade benet; tillämpa den överordnades X-skala på det underordnade "
"benets X-axel och så vidare"

#. :src: bpy.types.Bone.inherit_scale:'AVERAGE'
#. :src: bpy.types.EditBone.inherit_scale:'AVERAGE'
msgid ""
"Inherit uniform scaling representing the overall change in the volume of the "
"parent"
msgstr ""
"Ärv en enhetlig skalning som motsvarar den överordnades totala "
"volymförändring"

#. :src: bpy.types.Bone.inherit_scale:'NONE'
#. :src: bpy.types.EditBone.inherit_scale:'NONE'
msgid "Completely ignore parent scaling"
msgstr "Ignorera den överordnades skalning helt"

#. :src: bpy.types.Bone.inherit_scale:'NONE_LEGACY'
#. :src: bpy.types.EditBone.inherit_scale:'NONE_LEGACY'
msgid "None (Legacy)"
msgstr "Ingen (äldre)"

#. :src: bpy.types.Bone.inherit_scale:'NONE_LEGACY'
#. :src: bpy.types.EditBone.inherit_scale:'NONE_LEGACY'
msgid ""
"Ignore parent scaling without compensating for parent shear. Replicates the "
"effect of disabling the original Inherit Scale checkbox."
msgstr ""
"Ignorera den överordnades skalning utan att kompensera för dess skjuvning. "
"Återskapar effekten av att avmarkera den ursprungliga kryssrutan Ärva "
"skalning."

#. :src: bpy.types.Bone.matrix_local
msgid "Bone Armature-Relative Matrix"
msgstr "Benmatris relativ till riggskelettet"

#. :src: bpy.types.Bone.matrix_local
msgid "4×4 bone matrix relative to armature"
msgstr "4×4-benmatris relativ till riggskelettet"

#. :src: bpy.types.Bone.parent
msgid "Parent bone (in same Armature)"
msgstr "Överordnat ben (i samma armatur)"

#. :src: bpy.types.Bone.show_wire
#. :src: bpy.types.EditBone.show_wire
#. :src: bpy.types.Object.show_wire
msgid "Display Wire"
msgstr "Visa trådram"

#. :src: bpy.types.Bone.show_wire
#. :src: bpy.types.EditBone.show_wire
msgid ""
"Bone is always displayed in wireframe regardless of viewport shading mode "
"(useful for non-obstructive custom bone shapes)"
msgstr ""
"Benet visas alltid som trådram oavsett skuggningsläge i vyporten (användbart "
"för anpassade benformer som inte skymmer)"

#. :src: bpy.types.Bone.tail
msgid "Location of tail end of the bone relative to its parent"
msgstr "Placering av benets svansände i förhållande till det överordnade benet"

#. :src: bpy.types.Bone.tail_local
msgid "Armature-Relative Tail"
msgstr "Svans relativt riggskelettet"

#. :src: bpy.types.Bone.tail_local
msgid "Location of tail end of the bone relative to armature"
msgstr "Placering av benets svansände i förhållande till riggskelettet"

#. :src: bpy.types.Bone.tail_radius
#. :src: bpy.types.EditBone.tail_radius
msgid "Radius of tail of bone (for Envelope deform only)"
msgstr "Radie för benets svans (endast för kuvertdeformering)"

#. :src: bpy.types.Bone.use_connect
#. :src: bpy.types.EditBone.use_connect
msgid "When bone has a parent, bone's head is stuck to the parent's tail"
msgstr ""
"När benet har ett överordnat ben sitter dess huvud fast vid det överordnade "
"benets svans"

#. :src: bpy.types.Bone.use_cyclic_offset
#. :src: bpy.types.EditBone.use_cyclic_offset
msgid ""
"When bone doesn't have a parent, it receives cyclic offset effects "
"(Deprecated)"
msgstr ""
"När benet inte har något överordnat ben får det effekter av cyklisk "
"förskjutning (föråldrat)"

#. :src: bpy.types.Bone.use_deform
#. :src: bpy.types.EditBone.use_deform
msgid "Enable Bone to deform geometry"
msgstr "Låt benet deformera geometrin"

#. :src: bpy.types.Bone.use_endroll_as_inroll
#. :src: bpy.types.EditBone.use_endroll_as_inroll
msgid "Inherit End Roll"
msgstr "Ärv utrullning"

#. :src: bpy.types.Bone.use_endroll_as_inroll
#. :src: bpy.types.EditBone.use_endroll_as_inroll
msgid "Add Roll Out of the Start Handle bone to the Roll In value"
msgstr "Lägg till starthandtagsbenets utrullning till inrullningsvärdet"

#. :src: bpy.types.Bone.use_envelope_multiply
#. :src: bpy.types.EditBone.use_envelope_multiply
msgid "Multiply Vertex Group with Envelope"
msgstr "Multiplicera hörnpunktsgrupp med kuvert"

#. :src: bpy.types.Bone.use_envelope_multiply
#. :src: bpy.types.EditBone.use_envelope_multiply
msgid ""
"When deforming bone, multiply effects of Vertex Group weights with Envelope "
"influence"
msgstr ""
"Vid bendeformering multipliceras hörnpunktsgruppens vikter med kuvertets "
"inflytande"

#. :src: bpy.types.Bone.use_inherit_rotation
#. :src: bpy.types.EditBone.use_inherit_rotation
msgid "Bone inherits rotation or scale from parent bone"
msgstr "Benet ärver rotation eller skalning från det överordnade benet"

#. :src: bpy.types.Bone.use_local_location
#. :src: bpy.types.EditBone.use_local_location
msgid "Bone location is set in local space"
msgstr "Benets position anges i lokal rymd"

#. :src: bpy.types.Bone.use_relative_parent
#. :src: bpy.types.EditBone.use_relative_parent
msgid "Relative Parenting"
msgstr "Relativ överordning"

#. :src: bpy.types.Bone.use_relative_parent
#. :src: bpy.types.EditBone.use_relative_parent
msgid "Object children will use relative transform, like deform"
msgstr ""
"Underordnade objekt använder relativ transformering, som vid deformering"

#. :src: bpy.types.Bone.use_scale_easing
#. :src: bpy.types.EditBone.use_scale_easing
msgid "Scale Easing"
msgstr "Skalutjämning"

#. :src: bpy.types.Bone.use_scale_easing
#. :src: bpy.types.EditBone.use_scale_easing
msgid "Multiply the final easing values by the Scale In/Out Y factors"
msgstr ""
"Multiplicera de slutliga utjämningsvärdena med Y-faktorerna för Skala in/ut"

#. :src: bpy.types.BoneCollection
msgid "Bone collection in an Armature data-block"
msgstr "Bensamling i ett armaturdatablock"

#. :src: bpy.types.BoneCollection.bones
msgid ""
"Bones assigned to this bone collection. In armature edit mode this will "
"always return an empty list of bones, as the bone collection memberships are "
"only synchronized when exiting edit mode."
msgstr ""
"Ben som är tilldelade denna bensamling. I armaturens redigeringsläge "
"returneras alltid en tom benlista, eftersom medlemskap i bensamlingar "
"synkroniseras först när redigeringsläget avslutas."

#. :src: bpy.types.BoneCollection.child_number
msgid "Child Number"
msgstr "Underordningsnummer"

#. :src: bpy.types.BoneCollection.child_number
msgid ""
"Index of this collection into its parent's list of children. Note that "
"finding this index requires a scan of all the bone collections, so do access "
"this with care."
msgstr ""
"Den här samlingens index i den överordnade samlingens lista över "
"underordnade. Att hitta indexet kräver en genomsökning av alla bensamlingar, "
"så använd det med försiktighet."
