#. :src: bpy.types.ParticleSettingsTextureSlot.kink_amp_factor
msgid "Kink Amplitude Factor"
msgstr "Krusningsamplitudfaktor"

#. :src: bpy.types.ParticleSettingsTextureSlot.kink_amp_factor
msgid "Amount texture affects child kink amplitude"
msgstr "I vilken grad texturen påverkar barnpartiklars krusningsamplitud"

#. :src: bpy.types.ParticleSettingsTextureSlot.kink_freq_factor
msgid "Kink Frequency Factor"
msgstr "Krusningsfrekvensfaktor"

#. :src: bpy.types.ParticleSettingsTextureSlot.kink_freq_factor
msgid "Amount texture affects child kink frequency"
msgstr "I vilken grad texturen påverkar barnpartiklars krusningsfrekvens"

#. :src: bpy.types.ParticleSettingsTextureSlot.use_map_damp
msgid "Affect the particle velocity damping"
msgstr "Påverka partikelhastighetens dämpning"

#. :src: bpy.types.ParticleSettingsTextureSlot.use_map_density
msgid "Affect the density of the particles"
msgstr "Påverka partiklarnas densitet"

#. :src: bpy.types.ParticleSettingsTextureSlot.use_map_kink_amp
msgid "Kink Amplitude"
msgstr "Krusningsamplitud"

#. :src: bpy.types.ParticleSettingsTextureSlot.use_map_kink_amp
msgid "Affect the child kink amplitude"
msgstr "Påverka barnpartiklars krusningsamplitud"

#. :src: bpy.types.ParticleSettingsTextureSlot.use_map_kink_freq
msgid "Kink Frequency"
msgstr "Krusningsfrekvens"

#. :src: bpy.types.ParticleSettingsTextureSlot.use_map_kink_freq
msgid "Affect the child kink frequency"
msgstr "Påverka barnpartiklars krusningsfrekvens"

#. :src: bpy.types.ParticleSettingsTextureSlot.use_map_life
