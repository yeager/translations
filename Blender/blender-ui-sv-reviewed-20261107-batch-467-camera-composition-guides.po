#. :src: bpy.types.Camera.show_composition_center
msgid "Display center composition guide inside the camera view"
msgstr "Visa en kompositionsguide i mitten av kameravyn"

#. :src: bpy.types.Camera.show_composition_center_diagonal
msgid "Center Diagonal"
msgstr "Mittdiagonal"

#. :src: bpy.types.Camera.show_composition_center_diagonal
msgid "Display diagonal center composition guide inside the camera view"
msgstr "Visa en diagonal kompositionsguide i mitten av kameravyn"

#. :src: bpy.types.Camera.show_composition_golden
msgid "Golden Ratio"
msgstr "Gyllene snittet"

#. :src: bpy.types.Camera.show_composition_golden
msgid "Display golden ratio composition guide inside the camera view"
msgstr "Visa kompositionsguiden för det gyllene snittet i kameravyn"

#. :src: bpy.types.Camera.show_composition_golden_tria_a
msgid "Golden Triangle A"
msgstr "Gyllene triangeln A"

#. :src: bpy.types.Camera.show_composition_golden_tria_a
msgid "Display golden triangle A composition guide inside the camera view"
msgstr "Visa kompositionsguide för gyllene triangeln A i kameravyn"

#. :src: bpy.types.Camera.show_composition_golden_tria_b
msgid "Golden Triangle B"
msgstr "Gyllene triangeln B"

#. :src: bpy.types.Camera.show_composition_golden_tria_b
msgid "Display golden triangle B composition guide inside the camera view"
msgstr "Visa kompositionsguide för gyllene triangeln B i kameravyn"

#. :src: bpy.types.Camera.show_composition_harmony_tri_a
msgid "Harmonious Triangle A"
msgstr "Harmonisk triangel A"

#. :src: bpy.types.Camera.show_composition_harmony_tri_a
msgid "Display harmony A composition guide inside the camera view"
msgstr "Visa kompositionsguiden för harmonisk triangel A i kameravyn"

#. :src: bpy.types.Camera.show_composition_harmony_tri_b
msgid "Harmonious Triangle B"
msgstr "Harmonisk triangel B"

#. :src: bpy.types.Camera.show_composition_harmony_tri_b
msgid "Display harmony B composition guide inside the camera view"
msgstr "Visa kompositionsguiden för harmonisk triangel B i kameravyn"

#. :src: bpy.types.Camera.show_composition_thirds
msgid "Thirds"
msgstr "Tredjedelsregeln"

#. :src: bpy.types.Camera.show_composition_thirds
msgid "Display rule of thirds composition guide inside the camera view"
msgstr "Visa kompositionsguide för tredjedelsregeln i kameravyn"

#. :src: bpy.types.Camera.show_limits
msgid "Show Limits"
msgstr "Visa gränser"

#. :src: bpy.types.Camera.show_limits
msgid "Display the clipping range and focus point on the camera"
msgstr "Visa beskärningsintervallet och fokuspunkten för kameran"

#. :src: bpy.types.Camera.show_mist
msgid "Show Mist"
msgstr "Visa dimma"

#. :src: bpy.types.Camera.show_mist
msgid "Display a line from the Camera to indicate the mist area"
msgstr "Visa en linje från kameran för att markera dimområdet"

#. :src: bpy.types.Camera.show_name
#. :src: bpy.types.SequencerTimelineOverlay.show_strip_name
msgid "Show Name"
msgstr "Visa namn"

#. :src: bpy.types.Camera.show_name
msgid "Show the active Camera's name in Camera view"
msgstr "Visa den aktiva kamerans namn i kameravyn"

#. :src: bpy.types.Camera.show_passepartout
#. :src: bpy.types.View3DOverlay.show_camera_passepartout
msgid "Show Passepartout"
msgstr "Visa passepartout"

#. :src: bpy.types.Camera.show_passepartout
msgid "Show a darkened overlay outside the image area in Camera view"
msgstr "Visa en mörkare överlagring utanför bildområdet i kameravyn"

#. :src: bpy.types.Camera.show_safe_areas
msgid "Show Safe Areas"
msgstr "Visa säkra områden"

#. :src: bpy.types.Camera.show_safe_areas
msgid "Show TV title safe and action safe areas in Camera view"
msgstr "Visa säkra marginaler för text och bildinnehåll i kameravyn"

#. :src: bpy.types.Camera.show_safe_center
msgid "Show Center-Cut Safe Areas"
msgstr "Visa säkra områden för mittbeskärning"

#. :src: bpy.types.Camera.show_safe_center
#. :src: bpy.types.SequencerPreviewOverlay.show_safe_center
msgid "Show safe areas to fit content in a different aspect ratio"
msgstr ""
"Visa säkra områden för att anpassa innehåll till ett annat bildförhållande"

#. :src: bpy.types.Camera.show_sensor
msgid "Show Sensor Size"
msgstr "Visa sensorstorlek"

#. :src: bpy.types.Camera.show_sensor
msgid "Show sensor size (film gate) in Camera view"
msgstr "Visa sensorstorleken (filmruta) i kameravyn"
