#. :src: bpy.types.SCULPT_OT_uv_sculpt_relax
msgctxt "Operator"
msgid "Relax UVs"
msgstr "Jämna ut UV:er"

#. :src: bpy.types.SCULPT_OT_uv_sculpt_relax
msgid "Relax UVs"
msgstr "Jämna ut UV:er"

#. :src: bpy.types.SCULPT_OT_uv_sculpt_relax.relax_method
msgid "Relax Method"
msgstr "Utjämningsmetod"

#. :src: bpy.types.SCULPT_OT_uv_sculpt_relax.relax_method
msgid "Algorithm used for UV relaxation"
msgstr "Algoritm som används för UV-utjämning"

#. :src: bpy.types.SCULPT_OT_uv_sculpt_relax.relax_method:'LAPLACIAN'
msgid "Use Laplacian method for relaxation"
msgstr "Använd Laplace-metoden för utjämning"

#. :src: bpy.types.SCULPT_OT_uv_sculpt_relax.relax_method:'HC'
msgid "Use HC method for relaxation"
msgstr "Använd HC-metoden för utjämning"

#. :src: bpy.types.SCULPT_OT_uv_sculpt_relax.relax_method:'COTAN'
msgid ""
"Use Geometry (cotangent) relaxation, making UVs follow the underlying 3D "
"geometry"
msgstr ""
"Använd geometrisk utjämning (kotangentutjämning), så att UV:erna följer den "
"underliggande 3D-geometrin"

#. :src: bpy.types.SEQUENCER_OT_box_blade
msgctxt "Operator"
msgid "Box Blade"
msgstr "Rutskärning"

#. :src: bpy.types.SEQUENCER_OT_box_blade.remove_gaps
msgid ""
"In box blade mode, close gaps between cut strips, rippling later strips on "
"the same channel"
msgstr ""
"I rutskärningsläget, stäng luckor mellan skurna remsor och skjut "
"efterföljande remsor på samma kanal"

