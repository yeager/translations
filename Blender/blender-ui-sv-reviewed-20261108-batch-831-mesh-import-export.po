#. :src: bpy.types.MultiresModifier.use_custom_normals
#. :src: bpy.types.SubsurfModifier.use_custom_normals
msgid "Interpolates existing custom normals to resulting mesh"
msgstr "Interpolerar befintliga anpassade normaler till resulterande mesh"

#. :src: bpy.types.IMPORT_SCENE_OT_gltf.import_point_as_pointcloud
msgid "Import mesh with only POINTS primitives as Point Cloud objects"
msgstr "Importera mesh med endast POINTS-primitiver som punktmolnsobjekt"

#. :src: bpy.types.IMPORT_SCENE_OT_gltf.import_unused_materials
msgid "Import materials & Images not assigned to any mesh"
msgstr "Importera material och bilder som inte är tilldelade någon mesh"

#. :src: bpy.types.MESH_OT_normals_make_consistent
msgid "Make face and vertex normals point either outside or inside the mesh"
msgstr ""
"Gör så att yt- och hörnpunktsnormaler pekar antingen utåt eller inåt i meshen"

#. :src: bpy.types.OBJECT_OT_make_single_user.obdata_animation
msgid "Make object data (mesh, curve etc.) animation data local to each object"
msgstr ""
"Gör animationsdata för objektdata (mesh, kurva osv.) lokala för varje objekt"

#. :src: bpy.types.WM_OT_usd_export.export_mesh_colors
msgid "Include mesh color attributes in the export"
msgstr "Inkludera meshens färgattribut i exporten"

#. :src: bpy.types.WM_OT_usd_export.export_normals
msgid "Include normals of exported meshes in the export"
msgstr "Inkludera normaler för exporterade mesh i exporten"

#. :src: bpy.types.Sculpt.detail_refine_method
msgid "In dynamic-topology mode, how to add or remove mesh detail"
msgstr ""
"I läget för dynamisk topologi, hur meshdetaljer ska läggas till eller tas "
"bort"

msgid "Object '%s' has no evaluated mesh or curves data"
msgstr "Objektet ”%s” har inga utvärderade mesh- eller kurvdata"

msgid ""
"Mirror the active shape key along the local X axis using topology based "
"mirroring\n"
"(for when both sides of mesh have matching, unique topology)"
msgstr ""
"Spegla den aktiva formnyckeln längs den lokala X-axeln med topologibaserad "
"spegling\n"
"(när båda sidor av meshen har matchande och unik topologi)"

msgid ""
"For meshes, outputs normals without custom normal attributes taken into "
"account"
msgstr "För mesh genereras normaler utan att anpassade normalattribut beaktas"

msgid "No mesh in active object"
msgstr "Det aktiva objektet saknar mesh"
