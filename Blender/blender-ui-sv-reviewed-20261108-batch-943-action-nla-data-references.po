#. :src: bpy.types.ACTION_OT_stash
msgid "Store this action in the NLA stack as a non-contributing strip for later use"
msgstr "Lagra den här Actionen i NLA-stacken som en icke-inverkande remsa för senare användning"

#. :src: bpy.types.ACTION_OT_stash.create_new
msgid "Create a new action once the existing one has been safely stored"
msgstr "Skapa en ny Action när den befintliga har sparats på ett säkert sätt"

#. :src: bpy.types.ACTION_OT_stash_and_create
msgid "Store this action in the NLA stack as a non-contributing strip for later use, and create a new action"
msgstr "Lagra den här Actionen i NLA-stacken som en icke-inverkande remsa för senare användning och skapa en ny Action"

#. :src: bpy.types.ANIM_OT_clear_useless_actions.only_unused
msgid "Only unused (Fake User only) actions get considered"
msgstr "Endast oanvända Actioner med falsk användare beaktas"

#. :src: bpy.types.ANIM_OT_merge_animation
msgid "Merge the animation of the selected objects into the action of the active object. Actions are not deleted by this, but might end up with zero users"
msgstr "Slå ihop animeringen av de valda objekten med det aktiva objektets Action. Actioner raderas inte av detta, men kan sluta med noll användare"

#. :src: bpy.types.ANIM_OT_replace_action_duplicate
msgid "Duplicates the action of the active object and swaps all users of that action to that duplicate"
msgstr "Duplicerar det aktiva objektets Action och byter alla användare av den Actionen till dubbletten"

#. :src: bpy.types.ANIM_OT_replace_action_new
msgid "Swap all users of one action to a new action. This ignores the NLA and Action Constraints"
msgstr "Byt alla användare av en Action till en ny Action. Detta ignorerar NLA och Action-begränsningar"

#. :src: bpy.types.ANIM_OT_slot_channels_move_to_new_action
msgid "Move the selected slots into a newly created action"
msgstr "Flytta de valda slotarna till en nyskapad Action"

#. :src: bpy.types.NLA_OT_action_pushdown
msgid "Push action down onto the top of the NLA stack as a new strip"
msgstr "Flytta ned Actionen överst i NLA-stacken som en ny remsa"

#. :src: bpy.types.NLA_OT_bake.use_current_action
msgid "Bake animation into current action, instead of creating a new one (useful for baking only part of bones in an armature)"
msgstr "Baka animeringen i den aktuella Actionen i stället för att skapa en ny (användbart när bara en del av benen i en armatur ska bakas)"

#. :src: bpy.types.NLA_OT_duplicate.linked
msgid "When duplicating strips, assign new copies of the actions they use"
msgstr "När du duplicerar remsor tilldelas nya kopior av de Actioner de använder"

#. :src: bpy.types.NLA_OT_make_single_user
msgid "Make linked action local to each strip"
msgstr "Gör den länkade Actionen lokal för varje remsa"

#. :src: bpy.types.NLA_OT_tweakmode_enter
msgid "Enter tweaking mode for the action referenced by the active strip to edit its keyframes"
msgstr "Gå in i justeringsläget för den Action som den aktiva remsan refererar till för att redigera dess nyckelbildrutor"

#. :src: bpy.types.NLA_OT_tweakmode_exit
msgid "Exit tweaking mode for the action referenced by the active strip"
msgstr "Avsluta justeringsläget för den Action som den aktiva remsan refererar till"

#. :src: bpy.types.OUTLINER_OT_action_set
msgid "Change the active action used"
msgstr "Ändra den aktiva Action som används"
