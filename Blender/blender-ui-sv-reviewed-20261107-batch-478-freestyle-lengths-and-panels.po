#. :src: bpy.types.FreestyleLineStyle.length_max
#: scripts/startup/bl_ui/properties_freestyle.py:719
msgid "Max 2D Length"
msgstr "Max 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.length_max
msgid "Maximum curvilinear 2D length for the selection of chains"
msgstr "Maximal kurvlinjär 2D-längd för urvalet av kedjor"

#. :src: bpy.types.FreestyleLineStyle.length_min
#: scripts/startup/bl_ui/properties_freestyle.py:713
msgid "Min 2D Length"
msgstr "Min 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.length_min
msgid "Minimum curvilinear 2D length for the selection of chains"
msgstr "Minsta kurvlinjära 2D-längd för val av kedjor"

#. :src: bpy.types.FreestyleLineStyle.material_boundary
msgid "If true, chains of feature edges are split at material boundaries"
msgstr ""
"Om alternativet är aktiverat delas kedjor av funktionskanter vid "
"materialgränser"

#. :src: bpy.types.FreestyleLineStyle.panel
#. :src: bpy.types.NodeTreeInterfaceItem.item_type:'PANEL'
#: source/blender/editors/interface/interface_context_menu.cc:1441
msgid "Panel"
msgstr "Panel"

#. :src: bpy.types.FreestyleLineStyle.panel
msgid "Select the property panel to be shown"
msgstr "Välj den egenskapspanel som ska visas"

#. :src: bpy.types.FreestyleLineStyle.panel:'STROKES'
msgid "Show the panel for stroke construction"
msgstr "Visa panelen för streckkonstruktion"

#. :src: bpy.types.FreestyleLineStyle.panel:'COLOR'
msgid "Show the panel for line color options"
msgstr "Visa panelen för alternativ för linjefärg"

#. :src: bpy.types.FreestyleLineStyle.panel:'ALPHA'
msgid "Show the panel for alpha transparency options"
msgstr "Visa panelen för alternativ för alfagenomskinlighet"

#. :src: bpy.types.FreestyleLineStyle.panel:'THICKNESS'
