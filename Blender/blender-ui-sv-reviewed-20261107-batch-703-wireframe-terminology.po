#. :src: bpy.types.Bone.show_wire
#. :src: bpy.types.EditBone.show_wire
msgid "Bone is always displayed in wireframe regardless of viewport shading mode (useful for non-obstructive custom bone shapes)"
msgstr "Benet visas alltid som trådram oavsett visningsområdets skuggningsläge (användbart för anpassade benformer som inte skymmer)"

#. :src: bpy.types.View3DOverlay.wireframe_opacity
msgid "Wireframe Opacity"
msgstr "Trådramens opacitet"

#. :src: bpy.types.VolumeDisplay.wireframe_type:'NONE'
msgid "Don't display volume in wireframe mode"
msgstr "Visa inte volym i trådramläge"
