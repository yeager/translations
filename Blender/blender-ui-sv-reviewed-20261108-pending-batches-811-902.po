msgstr "Blås upp meshen"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'RELAX'
msgid "Relax mesh"
msgstr "Slappna av mesh"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'SURFACE_SMOOTH'
