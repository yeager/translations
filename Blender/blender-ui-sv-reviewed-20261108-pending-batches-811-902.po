#. :src: bpy.types.SCULPT_OT_trim_lasso_gesture.trim_mode:'JOIN'
#. :src: bpy.types.SCULPT_OT_trim_line_gesture.trim_mode:'JOIN'
#. :src: bpy.types.SCULPT_OT_trim_polyline_gesture.trim_mode:'JOIN'
msgid ""
"Join the new mesh as separate geometry, without performing any boolean "
