msgid "Frames"
msgstr "Bildrutor"

#. :src: bpy.types.GPencilLayer.frames
msgid "Sketches for this layer on different frames"
msgstr "Skisser för detta lager på olika bildrutor"

#. :src: bpy.types.GPencilLayer.is_ruler
msgid "This is a special ruler layer"
msgstr "Detta är ett särskilt linjallager"

#. :src: bpy.types.GPencilLayer.lock
msgid "Protect layer from further editing and/or frame changes"
msgstr "Skydda lagret från ytterligare redigering och/eller bildruteändringar"

#. :src: bpy.types.GPencilLayer.lock_frame
#. :src: bpy.types.GreasePencilLayer.lock_frame
msgid "Lock current frame displayed by layer"
msgstr "Lås den aktuella bildrutan som visas av lagret"

#. :src: bpy.types.GPencilLayer.thickness
#. :src: bpy.types.ToolSettings.annotation_thickness
msgid "Thickness of annotation strokes"
msgstr "Anteckningsstreckens tjocklek"

#. :src: bpy.types.GPencilLayer.use_annotation_onion_skinning
msgid "Display annotation onion skins before and after the current frame"
msgstr "Visa anteckningens lökskal före och efter den aktuella bildrutan"
