msgid "Active Frame"
msgstr "Aktiv bildruta"

#. :src: bpy.types.GPencilLayer.active_frame
msgid "Frame currently being displayed for this layer"
msgstr "Bildrutan som för närvarande visas för detta lager"

#. :src: bpy.types.GPencilLayer.annotation_onion_after_color
#. :src: bpy.types.GreasePencilv3.after_color
msgid "Base color for ghosts after the active frame"
msgstr "Basfärg för lökskal efter den aktiva bildrutan"

#. :src: bpy.types.GPencilLayer.annotation_onion_after_range
