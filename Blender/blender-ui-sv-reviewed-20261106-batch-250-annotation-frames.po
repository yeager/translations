msgid "Custom Onion Skin Colors"
msgstr "Anpassade färger för lökskalning"

#. :src: bpy.types.GPencilLayer.annotation_onion_use_custom_color
msgid "Use custom colors for onion skinning instead of the theme"
msgstr "Använd anpassade färger för lökskalning i stället för temat"

#. :src: bpy.types.GPencilLayer.annotation_opacity
msgid "Annotation Layer Opacity"
msgstr "Anteckningslagrets opacitet"

