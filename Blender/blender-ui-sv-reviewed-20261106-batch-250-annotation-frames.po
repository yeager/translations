#: scripts/startup/bl_ui/properties_data_grease_pencil.py:380
msgid "Frames After"
msgstr "Bildrutor efter"

#. :src: bpy.types.GPencilLayer.annotation_onion_before_color
#. :src: bpy.types.GreasePencilv3.before_color
msgid "Base color for ghosts before the active frame"
msgstr "Basfärg för lökskal före den aktiva bildrutan"

#. :src: bpy.types.GPencilLayer.annotation_onion_before_range
#. :src: bpy.types.GreasePencilv3.ghost_before_range
#: scripts/startup/bl_ui/properties_data_grease_pencil.py:379
