#. :src: bpy.types.ParticleSettings.kink
msgid "Type of periodic offset on the path"
msgstr "Typ av periodisk förskjutning på banan"

#. :src: bpy.types.ParticleSettings.kink:'NO'
msgctxt "ParticleSettings"
msgid "Nothing"
msgstr "Ingenting"

#. :src: bpy.types.ParticleSettings.kink:'SPIRAL'
msgctxt "ParticleSettings"
msgid "Spiral"
msgstr "Spiral"

#. :src: bpy.types.ParticleSettings.kink_amplitude_clump
msgid "Amplitude Clump"
msgstr "Klumpningsamplitud"

#. :src: bpy.types.ParticleSettings.kink_amplitude_clump
msgid "How much clump affects kink amplitude"
msgstr "Hur mycket klumpning påverkar nyckens amplitud"

#. :src: bpy.types.ParticleSettings.kink_amplitude_random
msgid "Amplitude Random"
msgstr "Slumpmässig amplitud"

#. :src: bpy.types.ParticleSettings.kink_amplitude_random
msgid "Random variation of the amplitude"
msgstr "Slumpmässig variation av amplituden"

#. :src: bpy.types.ParticleSettings.kink_axis_random
msgid "Axis Random"
msgstr "Slumpmässig axel"

#. :src: bpy.types.ParticleSettings.kink_axis_random
msgid "Random variation of the orientation"
msgstr "Slumpmässig variation av orienteringen"

#. :src: bpy.types.ParticleSettings.kink_extra_steps
msgid "Extra Steps"
msgstr "Extra steg"

#. :src: bpy.types.ParticleSettings.kink_extra_steps
msgid "Extra steps for resolution of special kink features"
msgstr "Extra steg för upplösning av särskilda nyckelegenskaper"

#. :src: bpy.types.ParticleSettings.kink_flat
msgid "Flatness"
msgstr "Planhet"

#. :src: bpy.types.ParticleSettings.kink_flat
msgid "How flat the hairs are"
msgstr "Hur platta hårstråna är"

#. :src: bpy.types.ParticleSettings.length_random
msgid "Random Length"
msgstr "Slumpmässig längd"

#. :src: bpy.types.ParticleSettings.length_random
msgid "Give path length a random variation"
msgstr "Ge väglängden en slumpmässig variation"

#. :src: bpy.types.ParticleSettings.lifetime
#. :src: bpy.types.WaveModifier.lifetime
#. :src: bpy.types.Particle.lifetime
#: source/blender/nodes/shader/nodes/node_shader_particle_info.cc:13
msgid "Lifetime"
msgstr "Livslängd"

#. :src: bpy.types.ParticleSettings.lifetime
msgid "Life span of the particles"
msgstr "Partiklarnas livslängd"

#. :src: bpy.types.ParticleSettings.lifetime_random
msgid "Give the particle life a random variation"
msgstr "Ge partiklarnas livslängd en slumpmässig variation"

#. :src: bpy.types.ParticleSettings.line_length_head
msgid "Length of the line's head"
msgstr "Längd på linjens början"

#. :src: bpy.types.ParticleSettings.line_length_tail
msgid "Length of the line's tail"
msgstr "Längd på linjens slut"

#. :src: bpy.types.ParticleSettings.lock_boids_to_surface
msgid "Boids 2D"
msgstr "Boids 2D"

#. :src: bpy.types.ParticleSettings.lock_boids_to_surface
msgid "Constrain boids to a surface"
msgstr "Begränsa boider till en yta"

#. :src: bpy.types.ParticleSettings.mass
#. :src: bpy.types.RigidBodyObject.mass
#. :src: bpy.types.SoftBodySettings.mass
#: scripts/startup/bl_ui/properties_scene.py:80
msgid "Mass"
msgstr "Massa"

#. :src: bpy.types.ParticleSettings.mass
msgid "Mass of the particles"
msgstr "Partiklarnas massa"

#. :src: bpy.types.ParticleSettings.material
msgid "Index of material slot used for rendering particles"
msgstr "Index för materialplatsen som används för rendering av partiklar"

#. :src: bpy.types.ParticleSettings.material_slot
#. :src: bpy.types.MaterialSlot
#. :src: bpy.types.GREASE_PENCIL_OT_set_material.slot
msgid "Material Slot"
msgstr "Materialplats"

#. :src: bpy.types.ParticleSettings.material_slot
msgid "Material slot used for rendering particles"
msgstr "Materialplats som används för rendering av partiklar"

#. :src: bpy.types.ParticleSettings.normal_factor
msgid "Let the surface normal give the particle a starting velocity"
msgstr "Låt ytnormalen ge partikeln en starthastighet"

#. :src: bpy.types.ParticleSettings.object_align_factor
msgid "Object Aligned"
msgstr "Objektinriktad"

#. :src: bpy.types.ParticleSettings.object_align_factor
msgid ""
"Let the emitter object orientation give the particle a starting velocity"
msgstr "Låt emitterobjektets orientering ge partikeln en starthastighet"

#. :src: bpy.types.ParticleSettings.object_factor
msgid "Object Velocity"
msgstr "Objektets hastighet"

#. :src: bpy.types.ParticleSettings.object_factor
msgid "Let the object give the particle a starting velocity"
msgstr "Låt objektet ge partikeln en starthastighet"

#. :src: bpy.types.ParticleSettings.particle_factor
msgid "Let the target particle give the particle a starting velocity"
msgstr "Låt målpartikeln ge partikeln en starthastighet"

#. :src: bpy.types.ParticleSettings.particle_size
msgid "The size of the particles"
msgstr "Partiklarnas storlek"

#. :src: bpy.types.ParticleSettings.path_end
#. :src: bpy.types.CLIP_OT_frame_jump.position:'PATHEND'
msgid "Path End"
msgstr "Banans slut"

#. :src: bpy.types.ParticleSettings.path_end
msgid "End time of path"
msgstr "Sluttid för banan"

#. :src: bpy.types.ParticleSettings.path_start
#. :src: bpy.types.CLIP_OT_frame_jump.position:'PATHSTART'
msgid "Path Start"
msgstr "Banans början"

#. :src: bpy.types.ParticleSettings.path_start
msgid "Starting time of path"
msgstr "Starttid för banan"

#. :src: bpy.types.ParticleSettings.phase_factor
msgid "Rotation around the chosen orientation axis"
msgstr "Rotation runt den valda orienteringsaxeln"

#. :src: bpy.types.ParticleSettings.phase_factor_random
msgid "Random Phase"
msgstr "Slumpmässig fas"

#. :src: bpy.types.ParticleSettings.phase_factor_random
msgid "Randomize rotation around the chosen orientation axis"
msgstr "Slumpmässig rotation runt den valda orienteringsaxeln"

#. :src: bpy.types.ParticleSettings.physics_type
msgid "Physics Type"
msgstr "Fysiktyp"

#. :src: bpy.types.ParticleSettings.physics_type
msgid "Particle physics type"
msgstr "Typ av partikelfysik"

#. :src: bpy.types.ParticleSettings.physics_type:'NEWTON'
msgid "Newtonian"
msgstr "Newtonsk"

#. :src: bpy.types.ParticleSettings.physics_type:'KEYED'
msgid "Keyed"
msgstr "Nycklad"

#. :src: bpy.types.ParticleSettings.radius_scale
msgid "Diameter Scale"
msgstr "Diameterskala"

#. :src: bpy.types.ParticleSettings.radius_scale
msgid "Multiplier of diameter properties"
msgstr "Multiplikator för diameteregenskaperna"

#. :src: bpy.types.ParticleSettings.react_event
msgid "React On"
msgstr "Reagera på"

#. :src: bpy.types.ParticleSettings.react_event
msgid "The event of target particles to react on"
msgstr "Händelsen hos målpartiklar som ska utlösa en reaktion"

#. :src: bpy.types.ParticleSettings.react_event:'DEATH'
msgid "Death"
msgstr "Död"

#. :src: bpy.types.ParticleSettings.reactor_factor
msgid "Reactor"
msgstr "Reaktor"

#. :src: bpy.types.ParticleSettings.reactor_factor
msgid ""
"Let the vector away from the target particle's location give the particle a "
"starting velocity"
msgstr ""
"Låt vektorn bort från målpartikelns plats ge partikeln en starthastighet"

#. :src: bpy.types.ParticleSettings.render_step
msgid "How many steps paths are rendered with (power of 2)"
msgstr "Antal steg som banorna renderas med (potens av 2)"

#. :src: bpy.types.ParticleSettings.render_type
msgid "Particle Rendering"
msgstr "Partikelrendering"

#. :src: bpy.types.ParticleSettings.render_type
msgid "How particles are rendered"
msgstr "Hur partiklar renderas"

#. :src: bpy.types.ParticleSettings.rendered_child_count
msgid "Rendered Children"
msgstr "Renderade barnpartiklar"

#. :src: bpy.types.ParticleSettings.rendered_child_count
msgid "Number of children per parent for rendering"
msgstr "Antal barnpartiklar per förälder för rendering"

#. :src: bpy.types.ParticleSettings.root_radius
msgid "Root Diameter"
msgstr "Rotdiameter"

#. :src: bpy.types.ParticleSettings.root_radius
msgid "Strand diameter width at the root"
msgstr "Stråets diameter vid roten"

#. :src: bpy.types.ParticleSettings.rotation_factor_random
#. :src: Socket name from node group Roll Hair Curves, file procedural_hair_node_assets.blend
msgid "Random Orientation"
msgstr "Slumpmässig orientering"

#. :src: bpy.types.ParticleSettings.rotation_factor_random
msgid "Randomize particle orientation"
msgstr "Slumpmässig orientering av partikeln"

#. :src: bpy.types.ParticleSettings.rotation_mode
msgid "Orientation Axis"
msgstr "Orienteringsaxel"

#. :src: bpy.types.ParticleSettings.rotation_mode
msgid "Particle orientation axis (does not affect Explode modifier's results)"
msgstr ""
"Partikelorienteringsaxel (påverkar inte Explode-modifierarens resultat)"

#. :src: bpy.types.ParticleSettings.rotation_mode:'NOR_TAN'
msgid "Normal-Tangent"
msgstr "Normal-tangent"

#. :src: bpy.types.ParticleSettings.rotation_mode:'VEL'
msgid "Velocity / Hair"
msgstr "Hastighet/hår"
