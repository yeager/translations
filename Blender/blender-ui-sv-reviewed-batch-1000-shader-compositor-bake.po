#. :src: bpy.types.ShaderNodeShaderToRGB
msgid "Shader to RGB"
msgstr "Shader till RGB"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_delete_single
msgctxt "Operator"
msgid "Delete Geometry Node Bake"
msgstr "Ta bort geometrinodsbakning"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_delete_single
msgid "Delete baked data of a single bake node or simulation"
msgstr "Ta bort bakade data från en enskild bakningsnod eller simulering"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_pack_single
msgctxt "Operator"
msgid "Pack Geometry Node Bake"
msgstr "Packa geometrinodsbakning"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_pack_single
msgid "Pack baked data from disk into the .blend file"
msgstr "Packa bakade data från disken i .blend-filen"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_single
msgctxt "Operator"
msgid "Bake Geometry Node"
msgstr "Baka geometrinod"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_single
msgid "Bake a single bake node or simulation"
msgstr "Baka en enskild bakningsnod eller simulering"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_unpack_single
msgctxt "Operator"
msgid "Unpack Geometry Node Bake"
msgstr "Packa upp geometrinodsbakning"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_unpack_single
msgid "Unpack baked data from the .blend file to disk"
msgstr "Packa upp bakade data från .blend-filen till disken"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_unpack_single.method:'USE_LOCAL'
msgid "Use bake from current directory (create when necessary)"
msgstr "Använd bakning från aktuell katalog (skapa vid behov)"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_unpack_single.method:'WRITE_LOCAL'
msgid "Write bake to current directory (overwrite existing bake)"
msgstr "Skriv bakning till aktuell katalog (skriv över befintlig bakning)"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_unpack_single.method:'USE_ORIGINAL'
msgid "Use bake in original location (create when necessary)"
msgstr "Använd bakning på ursprunglig plats (skapa vid behov)"

#. :src: bpy.types.OBJECT_OT_geometry_node_bake_unpack_single.method:'WRITE_ORIGINAL'
msgid "Write bake to original location (overwrite existing file)"
msgstr "Skriv bakning på ursprunglig plats (skriv över befintlig fil)"

#. :src: bpy.types.PreferencesSystem.gpu_shader_workers
msgid "Number of shader compilation threads or subprocesses, clamped at the max threads supported by the CPU (requires restarting Blender for changes to take effect). A higher number increases the RAM usage while reducing compilation time. A value of 0 will use automatic configuration. (OpenGL only)"
msgstr "Antal trådar eller underprocesser för shaderkompilering, begränsat till det högsta antal trådar som stöds av CPU:n (Blender måste startas om för att ändringarna ska börja gälla). Ett högre antal ökar RAM-användningen och minskar kompileringstiden. Värdet 0 använder automatisk konfiguration. (Endast OpenGL)"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes
msgid "Passes used by the denoiser to distinguish noise from shader and geometry detail"
msgstr "Pass som används av brusreduceraren för att skilja brus från shader- och geometridetaljer"
