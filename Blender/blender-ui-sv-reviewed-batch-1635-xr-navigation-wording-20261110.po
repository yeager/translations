#. :src: bpy.types.XrActionMapItem.type:'POSE'
#. :src: bpy.types.XrEventData.type:'POSE'
msgid "3D pose action, representing a controller's location and rotation"
msgstr ""
"3D-åtgärd för pose som representerar en kontrolls position och rotation"

#. :src: bpy.types.XrEventData.user_path
msgid "User path of the action. E.g. \"/user/hand/left\""
msgstr "Användarväg för åtgärden. T.ex. \"/user/hand/left\""

#. :src: bpy.types.XrNavigation.snap_turn
msgid ""
"Instantly rotates the camera by a fixed angle instead of smoothly turning"
msgstr ""
"Roterar kameran omedelbart med en fast vinkel i stället för att svänga mjukt"

#. :src: bpy.types.XrSessionSettings.base_pose_type
msgid "Base Pose Type"
msgstr "Basposetyp"

#. :src: bpy.types.XrSessionSettings.clip_end
msgid "VR viewport far clipping distance"
msgstr "Fjärrklippningsavstånd för VR-vyport"

#. :src: bpy.types.XrSessionSettings.clip_start
msgid "VR viewport near clipping distance"
msgstr "Närklippningsavstånd för VR-vyport"
