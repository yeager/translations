#. :src: bpy.types.DopeSheet
msgid "Settings for filtering the channels shown in animation editors"
msgstr ""
"Inställningar för att filtrera kanalerna som visas i animationsredigerare"

#. :src: bpy.types.DopeSheet.filter_collection
msgid "Filtering Collection"
msgstr "Filtreringssamling"

#. :src: bpy.types.DopeSheet.filter_collection
msgid "Collection that included object should be a member of"
msgstr "Samling som det inkluderade objektet ska tillhöra"

#. :src: bpy.types.DopeSheet.filter_fcurve_name
msgid "F-Curve Name Filter"
msgstr "Namnfilter för F-kurvor"

#. :src: bpy.types.DopeSheet.filter_fcurve_name
msgid "F-Curve live filtering string"
msgstr "Sträng för direktfiltrering av F-kurvor"

#. :src: bpy.types.DopeSheet.filter_text
msgid "Name Filter"
msgstr "Namnfilter"

#. :src: bpy.types.DopeSheet.show_armatures
msgid "Display Armature"
msgstr "Visa armatur"

#. :src: bpy.types.DopeSheet.show_armatures
msgid "Include visualization of armature related animation data"
msgstr "Visa även armaturrelaterade animeringsdata"

#. :src: bpy.types.DopeSheet.show_cache_files
msgid "Display Cache Files"
msgstr "Visa cachefiler"

#. :src: bpy.types.DopeSheet.show_cache_files
msgid "Include visualization of cache file related animation data"
msgstr "Visa även animeringsdata relaterade till cachefiler"

#. :src: bpy.types.DopeSheet.show_cameras
msgid "Display Camera"
msgstr "Visa kamera"

#. :src: bpy.types.DopeSheet.show_cameras
msgid "Include visualization of camera related animation data"
msgstr "Visa även kamerarelaterade animeringsdata"

#. :src: bpy.types.DopeSheet.show_curves
msgid "Display Curve"
msgstr "Visa kurva"

#. :src: bpy.types.DopeSheet.show_curves
msgid "Include visualization of curve related animation data"
msgstr "Visa även kurvrelaterade animeringsdata"

#. :src: bpy.types.DopeSheet.show_datablock_filters
msgid "Show Data-Block Filters"
msgstr "Visa filter för datablock"

#. :src: bpy.types.DopeSheet.show_datablock_filters
msgid ""
"Show options for whether channels related to certain types of data are "
"included"
msgstr ""
"Visa alternativ för om kanaler som hör till vissa datatyper ska inkluderas"
