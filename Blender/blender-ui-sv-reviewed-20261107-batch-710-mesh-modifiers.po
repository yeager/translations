msgid "Mesh"
msgstr "Mesh"

#. :src: bpy.types.BakeSettings.use_lores_mesh
msgid "Calculate heights against unsubdivided low resolution mesh"
msgstr "Beräkna höjder mot ett lågupplöst mesh utan underindelning"

#. :src: bpy.types.Mesh.texture_mesh
msgid "Use another mesh for texture indices (vertex indices must be aligned)"
msgstr "Använd en annan mesh för texturindex (hörnpunktsindex måste vara justerade)"

#. :src: bpy.types.MeshSkinVertexLayer
msgid "Mesh Skin Vertex Layer"
msgstr "Meshens Skin-hörnpunktslager"

#. :src: bpy.types.Modifier.type:'BEVEL'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BEVEL'
msgid "Generate sloped corners by adding geometry to the mesh's edges or vertices"
msgstr "Skapa avfasade hörn genom att lägga till geometri till meshens kanter eller hörnpunkter"

#. :src: bpy.types.Modifier.type:'MULTIRES'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MULTIRES'
msgid "Subdivide the mesh in a way that allows editing the higher subdivision levels"
msgstr "Dela upp meshen på ett sätt som gör det möjligt att redigera de högre indelningsnivåerna"

#. :src: bpy.types.Modifier.type:'MESH_DEFORM'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_DEFORM'
msgid "Deform using a different mesh, which acts as a deformation cage"
msgstr "Deformera med hjälp av en annan mesh, som fungerar som en deformationsbur"

#. :src: bpy.types.Modifier.type:'SMOOTH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SMOOTH'
msgid "Smooth the mesh by flattening the angles between adjacent faces"
msgstr "Jämna ut meshen genom att platta till vinklarna mellan intilliggande ytor"

#. :src: bpy.types.Modifier.type:'CORRECTIVE_SMOOTH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'CORRECTIVE_SMOOTH'
msgid "Smooth the mesh while still preserving the volume"
msgstr "Jämna ut meshen samtidigt som volymen bevaras"

#. :src: bpy.types.Modifier.type:'SURFACE_DEFORM'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SURFACE_DEFORM'
msgid "Transfer motion from another mesh"
msgstr "Överför rörelse från en annan mesh"

#. :src: bpy.types.Modifier.type:'WARP'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'WARP'
msgid "Warp parts of a mesh to a new location in a very flexible way thanks to 2 specified objects"
msgstr "Förvräng delar av en mesh till en ny plats på ett mycket flexibelt sätt med hjälp av två angivna objekt"

#. :src: bpy.types.Modifier.type:'PARTICLE_INSTANCE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'PARTICLE_INSTANCE'
msgid "Duplicate mesh at the location of particles"
msgstr "Duplicera mesh på partiklarnas position"

#. :src: bpy.types.BevelModifier.vmesh_method
msgid "The method to use to create the mesh at intersections"
msgstr "Metoden som ska användas för att skapa meshen vid korsningar"

#. :src: bpy.types.BuildModifier.use_reverse
msgid "Deconstruct the mesh instead of building it"
msgstr "Demontera meshen i stället för att bygga den"

#. :src: bpy.types.DisplaceModifier.direction:'RGB_TO_XYZ'
msgid "Use the texture's RGB values to displace the mesh in the XYZ direction"
msgstr "Använd texturens RGB-värden för att förskjuta meshen i XYZ-riktningen"

#. :src: bpy.types.ExplodeModifier.show_alive
msgid "Show mesh when particles are alive"
msgstr "Visa mesh när partiklarna är aktiva"

#. :src: bpy.types.ExplodeModifier.show_dead
msgid "Show mesh when particles are dead"
msgstr "Visa mesh när partiklarna är döda"
