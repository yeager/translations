#. :src: bpy.types.GreasePencilFrame.keyframe_type:'EXTREME'
#. :src: bpy.types.GreasePencil.onion_keyframe_type:'EXTREME'
msgid "An 'extreme' pose, or some other purpose as needed"
msgstr "Ett ytterläge eller något annat ändamål efter behov"

#. :src: bpy.types.Material.alpha_threshold
msgid "A pixel is rendered only if its alpha value is above this threshold"
msgstr ""
"En pixel renderas endast om dess alfavärde ligger över denna klipptröskel"

#. :src: bpy.types.World.use_eevee_finite_volume
msgid ""
"The world's volume used to be rendered by EEVEE Legacy. Conversion is needed"
" for it to render properly."
msgstr ""
"Världens volym renderades tidigare av EEVEE Legacy. Konvertering krävs för "
"att den ska renderas korrekt."

#. :src: bpy.types.Keyframe.type:'EXTREME'
#. :src: bpy.types.ACTION_OT_keyframe_type.type:'EXTREME'
#. :src: bpy.types.ACTION_OT_select_by_type.type:'EXTREME'
#. :src: bpy.types.ToolSettings.keyframe_type:'EXTREME'
msgid "An \"extreme\" pose, or some other purpose as needed"
msgstr "Ett ytterläge eller något annat ändamål efter behov"

#. :src: bpy.types.ShaderNodeAttribute.attribute_type:'LIGHT'
msgid "The attribute is associated with the Light that is being rendered"
msgstr "Attributet är associerat med ljuset som renderas"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff
msgid "Method for rendering subsurface scattering"
msgstr "Metod för rendering av underytsspridning"

#: scripts/startup/bl_ui/space_userpref.py:662
msgid "Auto-Keyframing"
msgstr "Automatisk nyckelbildsättning"

#: source/blender/editors/armature/pose_transform.cc:418
msgid "Cannot apply pose to lib-linked armature"
msgstr "Det går inte att tillämpa posen på en bibliotekslänkad armatur"

#: source/blender/editors/render/render_preview.cc:2223
