#. :src: bpy.types.ActionChannelbag
msgid "Collection of animation channels, typically associated with an action slot"
msgstr "Samling av animationskanaler som vanligtvis är kopplade till en Action-slot"

#. :src: bpy.types.ActionChannelbagFCurves
msgid "Collection of F-Curves for a specific action slot, on a specific strip"
msgstr "Samling av F-kurvor för en specifik Action-slot i en specifik remsa"

#. :src: bpy.types.ActionChannelbags
msgid "Animation Channels for Slots"
msgstr "Animationskanaler för Action-slotar"

#. :src: bpy.types.ActionSlot.select
msgid "Selection state of the slot"
msgstr "Markeringsstatus för Action-slotten"

#. :src: bpy.types.ActionSlot.show_expanded
msgid "Expanded state of the slot"
msgstr "Utfällningsstatus för Action-slotten"

#. :src: bpy.types.ActionSlots
msgid "Collection of action slots"
msgstr "Samling av Action-slotar"

#. :src: bpy.types.ActionSlots.active
msgid "Active Slot"
msgstr "Aktiv Action-slot"

#. :src: bpy.types.ActionSlots.active
msgid "Active slot for this action"
msgstr "Aktiv Action-slot för denna Action"

#. :src: bpy.types.ActionKeyframeStrip
msgid "Strip with a set of F-Curves for each action slot"
msgstr "Remsa med en uppsättning F-kurvor för varje Action-slot"

#. :src: bpy.types.NlaStrip.action_slot_handle
#. :src: bpy.types.AnimData.action_slot_handle
msgid "Action Slot Handle"
msgstr "Handtag för Action-slot"

#. :src: bpy.types.AnimData.action_slot_handle_tweak_storage
msgid "Tweak Mode Action Slot Storage"
msgstr "Lagring av Action-slot i justeringsläge"

#. :src: bpy.types.AnimData.action_slot_handle_tweak_storage
msgid "Storage to temporarily hold the main action slot while in tweak mode"
msgstr "Lagring för att tillfälligt behålla huvud-Action-slotten i justeringsläge"

#. :src: bpy.types.AnimData.action_suitable_slots
msgid "The list of slots in this animation data-block"
msgstr "Listan över Action-slotar i detta animationsdatablock"

#. :src: bpy.types.NlaStrip.last_slot_identifier
#. :src: bpy.types.AnimData.last_slot_identifier
msgid "Last Action Slot Identifier"
msgstr "Identifierare för den senast tilldelade Action-slotten"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_action_all
msgid "All Action Keyframes"
msgstr "Alla Action-nyckelbildrutor"

#. :src: bpy.types.NlaStrip.action_suitable_slots
msgid "The list of action slots suitable for this NLA strip"
msgstr "Listan över Action-slotar som lämpar sig för denna NLA-remsa"

#. :src: bpy.types.ActionConstraint.mix_mode:'REPLACE'
msgid "Replace the original transformation with the action channels"
msgstr "Ersätt den ursprungliga transformeringen med Action-kanalerna"

#. :src: bpy.types.Action.is_empty
msgid "False when there is any Layer, Slot, or legacy F-Curve"
msgstr "Falskt om det finns ett lager, en Action-slot eller en äldre F-kurva"

#. :src: bpy.types.Action.slots
msgid "The list of slots in this Action"
msgstr "Listan över Action-slotar i denna Action"

#. :src: bpy.types.KeyingSetPath.group
msgid "Name of Action Group to assign setting(s) for this path to"
msgstr "Namn på Action-gruppen som inställningarna för den här sökvägen ska tilldelas"

#. :src: bpy.types.NlaStrip.use_sync_length
#. :src: bpy.types.NLA_OT_action_sync_length
msgid "Sync Action Length"
msgstr "Synkronisera Action-längd"

#. :src: bpy.types.NLA_OT_action_sync_length
msgctxt "Operator"
msgid "Sync Action Length"
msgstr "Synkronisera Action-längd"
