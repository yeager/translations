#. :src: bpy.types.Material
msgid ""
"Material data-block to define the appearance of geometric objects for "
"rendering"
msgstr ""
"Materialdatablock som bestämmer hur geometriska objekt ser ut vid rendering"

#. :src: bpy.types.Material.alpha_threshold
msgid "Clip Threshold"
msgstr "Klipptröskel"

#. :src: bpy.types.Material.alpha_threshold
msgid "A pixel is rendered only if its alpha value is above this threshold"
msgstr ""
"En pixel återges endast om dess alfavärde ligger över denna klipptröskel"

#. :src: bpy.types.Material.blend_method
msgctxt "Material"
msgid "Blend Mode"
msgstr "Blandningsläge"

#. :src: bpy.types.Material.blend_method
msgid ""
"Blend Mode for Transparent Faces (Deprecated: use 'surface_render_method')"
msgstr ""
"Blandningsläge för genomskinliga ytor (föråldrad: använd "
"'surface_render_method')"

#. :src: bpy.types.Material.blend_method:'OPAQUE'
msgctxt "Material"
msgid "Opaque"
msgstr "Ogenomskinlig"

#. :src: bpy.types.Material.blend_method:'OPAQUE'
msgid "Render surface without transparency"
msgstr "Rendera yta utan transparens"

#. :src: bpy.types.Material.blend_method:'CLIP'
msgctxt "Material"
msgid "Alpha Clip"
msgstr "Alfaklippning"

#. :src: bpy.types.Material.blend_method:'CLIP'
msgid "Use the alpha threshold to clip the visibility (binary visibility)"
msgstr "Använd alfatröskeln för att klippa synligheten (binär synlighet)"

#. :src: bpy.types.Material.blend_method:'HASHED'
msgctxt "Material"
msgid "Alpha Hashed"
msgstr "Hashad alfa"

#. :src: bpy.types.Material.blend_method:'HASHED'
msgid ""
"Use noise to dither the binary visibility (works well with multi-samples)"
msgstr ""
"Använd brus för att dithra den binära synligheten (fungerar bra med "
"multisampling)"

#. :src: bpy.types.Material.blend_method:'BLEND'
msgctxt "Material"
msgid "Alpha Blend"
msgstr "Alfablandning"

#. :src: bpy.types.Material.blend_method:'BLEND'
msgid "Render polygon transparent, depending on alpha channel of the texture"
msgstr "Gör polygonen transparent, beroende på texturens alfakanal"

#. :src: bpy.types.Material.cycles
msgid "Cycles Material Settings"
msgstr "Cycles-materialinställningar"

#. :src: bpy.types.Material.cycles
msgid "Cycles material settings"
msgstr "Cycles-materialinställningar"
