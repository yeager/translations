#. :src: bpy.types.NlaStrip.use_sync_length
msgid ""
"Update range of frames referenced from action after tweaking strip and its "
"keyframes"
msgstr ""
"Uppdatera intervallet med bildrutor som refereras från åtgärden efter att "
"remsan och dess nyckelbildrutor har justerats"

#. :src: bpy.types.NlaStripFCurves
msgid "NLA-Strip F-Curves"
msgstr "NLA-remsans F-kurvor"

#. :src: bpy.types.NlaStripFCurves
msgid "Collection of NLA strip F-Curves"
msgstr "Samling av F-kurvor för NLA-remsor"

#. :src: bpy.types.NlaTrack
msgid "NLA Track"
msgstr "NLA-spår"

#. :src: bpy.types.NlaTrack.active
msgid "NLA Track is active"
msgstr "NLA-spåret är aktivt"

#. :src: bpy.types.NlaTrack.is_override_data
msgid "Override Track"
msgstr "Åsidosatt spår"

#. :src: bpy.types.NlaTrack.lock
msgid "NLA Track is locked"
msgstr "NLA-spåret är låst"

#. :src: bpy.types.NlaTrack.mute
msgid "Disable NLA Track evaluation"
msgstr "Inaktivera utvärdering av NLA-spår"

#. :src: bpy.types.NlaTrack.select
msgid "NLA Track is selected"
msgstr "NLA-spåret är valt"

#. :src: bpy.types.NlaTracks.active
msgid "Active NLA Track"
msgstr "Aktivt NLA-spår"

#. :src: bpy.types.Node.color_tag
msgid "Node header color tag"
msgstr "Färgmarkering för nodhuvud"

#. :src: bpy.types.Node.dimensions
msgid "Absolute bounding box dimensions of the node"
msgstr "Absoluta dimensioner för nodens begränsningsruta"

#. :src: bpy.types.Node.location_absolute
msgid "Absolute Location"
msgstr "Absolut position"

#. :src: bpy.types.Node.location_absolute
msgid "Location of the node in the entire canvas"
msgstr "Nodens position på hela arbetsytan"

#. :src: bpy.types.Node.parent
msgid "Parent this node is attached to"
msgstr "Överordnad nod som den här noden är kopplad till"

#. :src: bpy.types.Node.select
msgid "Node selection state"
msgstr "Nodens valstatus"

#. :src: bpy.types.CompositorNode
msgid "Compositor Node"
msgstr "Kompositörsnod"

#. :src: bpy.types.CompositorNodeAlphaOver.use_premultiply
#. :src: bpy.types.CompositorNodeBrightContrast.use_premultiply
msgid "Convert Premultiplied"
msgstr "Konvertera förmultiplicerad"

#. :src: bpy.types.CompositorNodeBlur.use_extended_bounds
#. :src: bpy.types.CompositorNodeBokehBlur.use_extended_bounds
msgid "Extend bounds of the input image to fully fit blurred image"
msgstr "Utöka ingångsbildens gränser så att den oskarpa bilden får plats helt"

#. :src: bpy.types.CompositorNodeBlur.use_gamma_correction
msgid "Apply filter on gamma corrected values"
msgstr "Använd filtret på gammakorrigerade värden"

#. :src: bpy.types.CompositorNodeBokehBlur
msgid "Bokeh Blur"
msgstr "Bokeh-oskärpa"

#. :src: bpy.types.CompositorNodeBokehBlur
msgid ""
"Generate a bokeh type blur similar to Defocus. Unlike defocus an in-focus "
"region is defined in the compositor"
msgstr ""
"Skapa en bokeh-oskärpa som liknar Defocus. Till skillnad från Defocus "
"definieras ett område i fokus i kompositören"

#. :src: bpy.types.CompositorNodeBokehImage
msgid "Generate image with bokeh shape for use with the Bokeh Blur filter node"
msgstr "Skapa en bild med bokehform för användning med filternoden Bokeh Blur"

#. :src: bpy.types.CompositorNodeBokehImage.angle
msgid "Angle of the bokeh. (Deprecated: Use Angle input instead)"
msgstr "Bokehns vinkel. (Föråldrad: Använd Angle-ingången i stället)"

#. :src: bpy.types.CompositorNodeBokehImage.catadioptric
msgid ""
"Level of catadioptric of the bokeh. (Deprecated: Use Catadioptric Size input "
"instead)"
msgstr ""
"Bokehns katadioptrinivå. (Föråldrad: Använd inmatningen Catadioptric Size i "
"stället)"

#. :src: bpy.types.CompositorNodeBoxMask
msgid "Box Mask"
msgstr "Rektangulär mask"

#. :src: bpy.types.CompositorNodeBoxMask
msgid "Create rectangular mask suitable for use as a simple matte"
msgstr "Skapa en rektangulär mask som kan användas som en enkel matta"

#. :src: bpy.types.CompositorNodeBoxMask.mask_height
msgid "Height of the box. (Deprecated: Use Size input instead.)"
msgstr "Höjd på rutan. (Föråldrad: Använd Size input i stället.)"

#. :src: bpy.types.CompositorNodeBoxMask.rotation
msgid "Rotation angle of the box. (Deprecated: Use Rotation input instead.)"
msgstr "Rutans rotationsvinkel. (Föråldrad: Använd Rotation input i stället.)"

#. :src: bpy.types.CompositorNodeBoxMask.y
msgid ""
"Y position of the middle of the box. (Deprecated: Use Position input "
"instead.)"
msgstr ""
"Y-position för rutans mitt. (Föråldrad: Använd inmatningen Position i "
"stället.)"

#. :src: bpy.types.CompositorNodeChannelMatte.limit_max
msgid ""
"Values higher than this setting are 100% opaque. (Deprecated: Use Maximum "
"input instead.)"
msgstr ""
"Värden över denna inställning är 100 % opaka. (Föråldrad: Använd Maximum "
"input i stället.)"

#. :src: bpy.types.CompositorNodeChannelMatte.limit_min
msgid ""
"Values lower than this setting are 100% keyed. (Deprecated: Use Minimum "
"input instead.)"
msgstr ""
"Värden under denna inställning är 100 % frilagda. (Föråldrad: Använd Minimum "
"input i stället.)"

#. :src: bpy.types.CompositorNodeChromaMatte
msgid "Create matte based on chroma values"
msgstr "Skapa en matta baserad på kromvärden"

#. :src: bpy.types.CompositorNodeChromaMatte.gain
msgid "Alpha falloff. (Deprecated: Use Minimum input instead.)"
msgstr "Alfaavtagande. (Föråldrad: Använd Minimum input i stället.)"

#. :src: bpy.types.CompositorNodeChromaMatte.lift
msgid "Alpha lift. (Deprecated: Unused.)"
msgstr "Alfalyft. (Föråldrad: Oanvänd.)"

#. :src: bpy.types.CompositorNodeChromaMatte.shadow_adjust
msgid "Shadow Adjust"
msgstr "Skuggjustering"

#. :src: bpy.types.CompositorNodeColorBalance.correction_method:'OFFSET_POWER_SLOPE'
#. :src: bpy.types.StripColorBalanceData.correction_method:'OFFSET_POWER_SLOPE'
msgid "ASC-CDL standard color correction"
msgstr "ASC-CDL-standardfärgkorrigering"

#. :src: bpy.types.CompositorNodeColorBalance.correction_method:'WHITEPOINT'
msgid "Chromatic adaption from a different white point"
msgstr "Kromatisk anpassning från en annan vitpunkt"

#. :src: bpy.types.CompositorNodeColorBalance.gain
#. :src: bpy.types.CompositorNodeColorBalance.slope
#. :src: bpy.types.StripColorBalanceData.slope
msgid "Correction for highlights"
msgstr "Korrigering av högdagrar"

#. :src: bpy.types.CompositorNodeColorBalance.input_temperature
msgid "Input Temperature"
msgstr "Indatatemperatur"

#. :src: bpy.types.CompositorNodeColorBalance.input_tint
msgid "Input Tint"
msgstr "Indatanyans"

#. :src: bpy.types.CompositorNodeColorBalance.input_whitepoint
msgid "Input White Point"
msgstr "Indatavitpunkt"

#. :src: bpy.types.CompositorNodeColorBalance.lift
msgid "Correction for shadows"
msgstr "Korrigering av skuggor"

#. :src: bpy.types.CompositorNodeColorBalance.output_whitepoint
msgid "Output White Point"
msgstr "Utdatavitpunkt"

#. :src: bpy.types.CompositorNodeColorCorrection.highlights_contrast
msgid "Highlights Contrast"
msgstr "Högdagerkontrast"

#. :src: bpy.types.CompositorNodeColorCorrection.highlights_gain
msgid "Highlights Gain"
msgstr "Högdagerförstärkning"

#. :src: bpy.types.CompositorNodeColorCorrection.highlights_gamma
msgid "Highlights Gamma"
msgstr "Högdagergamma"

#. :src: bpy.types.CompositorNodeColorCorrection.highlights_lift
msgid "Highlights Lift"
msgstr "Högdagerlyft"

#. :src: bpy.types.CompositorNodeColorCorrection.highlights_saturation
msgid "Highlights Saturation"
msgstr "Högdagermättnad"

#. :src: bpy.types.CompositorNodeColorCorrection.midtones_contrast
msgid "Midtones Contrast"
msgstr "Mellantonkontrast"

#. :src: bpy.types.CompositorNodeColorCorrection.midtones_end
#: source/blender/nodes/composite/nodes/node_composite_colorcorrection.cc:174
msgid "Midtones End"
msgstr "Mellantonslut"

#. :src: bpy.types.CompositorNodeColorCorrection.midtones_gain
msgid "Midtones Gain"
msgstr "Mellantonförstärkning"
