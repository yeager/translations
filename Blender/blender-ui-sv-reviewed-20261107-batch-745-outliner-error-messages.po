#: source/blender/editors/object/object_relations.cc:2733
msgid "Too many potential root collections (%d) for the override hierarchy, please use the Outliner instead"
msgstr "För många möjliga rotsamlingar (%d) för åsidosättningshierarkin. Använd Outliner i stället"

#: source/blender/editors/space_outliner/outliner_tools.cc:351
msgid "Cannot unlink texture '%s'. It's not clear which Freestyle line style it should be unlinked from, there's no Freestyle line style as parent in the Outliner tree"
msgstr "Det går inte att koppla bort texturen ”%s”. Det är oklart från vilken Freestyle-linjestil den ska kopplas bort, eftersom det saknas en överordnad Freestyle-linjestil i Outliner-trädet"

#: source/blender/editors/space_outliner/outliner_tools.cc:393
msgid "Cannot unlink collection '%s'. It's not clear which scene, collection or instance empties it should be unlinked from, there's no scene, collection or instance empties as parent in the Outliner tree"
msgstr "Det går inte att koppla bort samlingen ”%s”. Det är oklart från vilken scen, samling eller instanstom den ska kopplas bort, eftersom det saknas en överordnad scen, samling eller instanstom i Outliner-trädet"

#: source/blender/editors/space_outliner/outliner_tools.cc:444
msgid "Cannot unlink object '%s'. It's not clear which collection or scene it should be unlinked from, there's no collection or scene as parent in the Outliner tree"
msgstr "Det går inte att koppla bort objektet ”%s”. Det är oklart från vilken samling eller scen det ska kopplas bort, eftersom det saknas en överordnad samling eller scen i Outliner-trädet"

#: source/blender/editors/space_outliner/outliner_tools.cc:537
msgid "Cannot unlink world '%s'. It's not clear which scene it should be unlinked from, there's no scene as parent in the Outliner tree"
msgstr "Det går inte att koppla bort världen ”%s”. Det är oklart från vilken scen den ska kopplas bort, eftersom det saknas en överordnad scen i Outliner-trädet"
