#. :src: bpy.types.MeshSkinVertex.use_loose
msgid "If vertex has multiple adjacent edges, it is hulled to them directly"
msgstr "Om en hörnpunkt har flera angränsande kanter ansluts den direkt till dem"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation:'NONE'
msgid "No restrictions on vertex movement"
msgstr "Inga begränsningar för hörnpunkternas rörelse"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.method:'PROJECT'
msgid "Project vertices onto the stroke using vertex normals and connected edges. Requires more exact annotation placement, otherwise it may do nothing"
msgstr "Projicera hörnpunkterna på strecket med hjälp av hörnpunktsnormaler och anslutna kanter. Kräver mer exakt placering av anteckningen, annars kanske inget händer"

#. :src: Socket description from node group Cloth Dynamics (Experimental), file geometry_nodes_dynamics_assets.blend
#. :src: Socket description from node group Hair Dynamics, file geometry_nodes_dynamics_assets.blend
msgid "Friction coefficient for each vertex."
msgstr "Friktionskoefficient för varje hörnpunkt."

#. :src: Socket description from node group Cloth Dynamics (Experimental), file geometry_nodes_dynamics_assets.blend
msgid "Mass assigned to each vertex in the solver."
msgstr "Massa som tilldelas varje hörnpunkt i lösaren."
