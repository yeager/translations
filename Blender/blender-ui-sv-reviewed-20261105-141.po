#. :src: bpy.types.Bone
msgid "Bone in an Armature data-block"
msgstr "Ben i ett armaturdatablock"

#. :src: bpy.types.Bone.bbone_curveinx
#. :src: bpy.types.EditBone.bbone_curveinx
#. :src: bpy.types.PoseBone.bbone_curveinx
msgid "X-axis handle offset for start of the B-Bone's curve, adjusts curvature"
msgstr ""
"Förskjutning av X-axelhandtaget vid början av B-Bone-kurvan; justerar "
"krökningen"

#. :src: bpy.types.Bone.bbone_curveinz
#. :src: bpy.types.EditBone.bbone_curveinz
#. :src: bpy.types.PoseBone.bbone_curveinz
msgid "Z-axis handle offset for start of the B-Bone's curve, adjusts curvature"
msgstr ""
"Förskjutning av Z-axelhandtaget vid början av B-Bone-kurvan; justerar "
"krökningen"

#. :src: bpy.types.Bone.bbone_curveoutx
#. :src: bpy.types.EditBone.bbone_curveoutx
#. :src: bpy.types.PoseBone.bbone_curveoutx
msgid "X-axis handle offset for end of the B-Bone's curve, adjusts curvature"
msgstr ""
"Förskjutning av X-axelhandtaget vid slutet av B-Bone-kurvan; justerar "
"krökningen"

#. :src: bpy.types.Bone.bbone_curveoutz
#. :src: bpy.types.EditBone.bbone_curveoutz
#. :src: bpy.types.PoseBone.bbone_curveoutz
msgid "Z-axis handle offset for end of the B-Bone's curve, adjusts curvature"
msgstr ""
"Förskjutning av Z-axelhandtaget vid slutet av B-Bone-kurvan; justerar "
"krökningen"

#. :src: bpy.types.Bone.bbone_custom_handle_end
#. :src: bpy.types.EditBone.bbone_custom_handle_end
#. :src: bpy.types.PoseBone.bbone_custom_handle_end
msgid "B-Bone End Handle"
msgstr "B-Bone-sluthandtag"

#. :src: bpy.types.Bone.bbone_custom_handle_start
#. :src: bpy.types.EditBone.bbone_custom_handle_start
#. :src: bpy.types.PoseBone.bbone_custom_handle_start
msgid "B-Bone Start Handle"
msgstr "B-Bone-starthandtag"

#. :src: bpy.types.Bone.bbone_easein
#. :src: bpy.types.EditBone.bbone_easein
#. :src: bpy.types.PoseBone.bbone_easein
#: scripts/startup/bl_ui/properties_data_bone.py:166
msgctxt "Armature"
msgid "Ease In"
msgstr "Utjämning in"

#. :src: bpy.types.Bone.bbone_easein
#. :src: bpy.types.EditBone.bbone_easein
#. :src: bpy.types.PoseBone.bbone_easein
msgid "Length of first Bézier Handle (for B-Bones only)"
msgstr "Längd på det första Bézier-handtaget (endast för B-Bones)"

#. :src: bpy.types.Bone.bbone_easeout
#. :src: bpy.types.EditBone.bbone_easeout
#. :src: bpy.types.PoseBone.bbone_easeout
msgctxt "Armature"
msgid "Ease Out"
msgstr "Utjämning ut"

#. :src: bpy.types.Bone.bbone_easeout
#. :src: bpy.types.EditBone.bbone_easeout
#. :src: bpy.types.PoseBone.bbone_easeout
msgid "Length of second Bézier Handle (for B-Bones only)"
msgstr "Längd på det andra Bézier-handtaget (endast för B-Bones)"

#. :src: bpy.types.Bone.bbone_handle_type_end
#. :src: bpy.types.EditBone.bbone_handle_type_end
msgid "B-Bone End Handle Type"
msgstr "Typ av B-Bone-sluthandtag"

#. :src: bpy.types.Bone.bbone_handle_type_end
#. :src: bpy.types.EditBone.bbone_handle_type_end
msgid "Selects how the end handle of the B-Bone is computed"
msgstr "Väljer hur B-Bone-sluthandtaget beräknas"

#. :src: bpy.types.Bone.bbone_handle_type_end:'TANGENT'
#. :src: bpy.types.Bone.bbone_handle_type_start:'TANGENT'
#. :src: bpy.types.EditBone.bbone_handle_type_end:'TANGENT'
#. :src: bpy.types.EditBone.bbone_handle_type_start:'TANGENT'
msgid ""
"Use the orientation of the specified bone to compute the handle, ignoring "
"the location"
msgstr ""
"Använd det angivna benets orientering för att beräkna handtaget och ignorera "
"positionen"

#. :src: bpy.types.Bone.bbone_handle_type_start
#. :src: bpy.types.EditBone.bbone_handle_type_start
msgid "B-Bone Start Handle Type"
msgstr "Typ av B-Bone-starthandtag"

#. :src: bpy.types.Bone.bbone_handle_type_start
#. :src: bpy.types.EditBone.bbone_handle_type_start
msgid "Selects how the start handle of the B-Bone is computed"
msgstr "Väljer hur B-Bone-starthandtaget beräknas"

#. :src: bpy.types.Bone.bbone_handle_use_ease_end
#. :src: bpy.types.EditBone.bbone_handle_use_ease_end
msgid "End Handle Ease"
msgstr "Utjämning för sluthandtag"

#. :src: bpy.types.Bone.bbone_handle_use_ease_start
#. :src: bpy.types.EditBone.bbone_handle_use_ease_start
msgid "Start Handle Ease"
msgstr "Utjämning för starthandtag"

#. :src: bpy.types.Bone.bbone_mapping_mode
#. :src: bpy.types.EditBone.bbone_mapping_mode
msgid "B-Bone Vertex Mapping Mode"
msgstr "Mappningsläge för B-Bone-hörnpunkter"

#. :src: bpy.types.Bone.bbone_mapping_mode
#. :src: bpy.types.EditBone.bbone_mapping_mode
msgid ""
"Selects how the vertices are mapped to B-Bone segments based on their "
"position"
msgstr ""
"Väljer hur hörnpunkterna mappas till B-Bone-segment utifrån sin position"

#. :src: bpy.types.Bone.bbone_mapping_mode:'STRAIGHT'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'STRAIGHT'
msgid ""
"Fast mapping that is good for most situations, but ignores the rest pose "
"curvature of the B-Bone"
msgstr ""
"Snabb mappning som fungerar bra i de flesta situationer men ignorerar B-Bone-"
"kurvans krökning i viloposen"

#. :src: bpy.types.Bone.bbone_mapping_mode:'CURVED'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'CURVED'
#. :src: bpy.types.CompositorNodeVecBlur.use_curved
msgid "Curved"
msgstr "Böjd"

#. :src: bpy.types.Bone.bbone_mapping_mode:'CURVED'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'CURVED'
msgid ""
"Slower mapping that gives better deformation for B-Bones that are sharply "
"curved in rest pose"
msgstr ""
"Långsammare mappning som ger bättre deformering för B-Bones som är kraftigt "
"böjda i viloposen"

#. :src: bpy.types.Bone.bbone_rollin
#. :src: bpy.types.EditBone.bbone_rollin
#. :src: bpy.types.PoseBone.bbone_rollin
#: scripts/startup/bl_ui/properties_data_bone.py:155
msgid "Roll In"
msgstr "Inrullning"

#. :src: bpy.types.Bone.bbone_rollin
#. :src: bpy.types.EditBone.bbone_rollin
#. :src: bpy.types.PoseBone.bbone_rollin
msgid "Roll offset for the start of the B-Bone, adjusts twist"
msgstr "Rullningsförskjutning för början av B-Bone; justerar vridningen"

#. :src: bpy.types.Bone.bbone_rollout
#. :src: bpy.types.EditBone.bbone_rollout
#. :src: bpy.types.PoseBone.bbone_rollout
msgid "Roll Out"
msgstr "Utrullning"

#. :src: bpy.types.Bone.bbone_rollout
#. :src: bpy.types.EditBone.bbone_rollout
#. :src: bpy.types.PoseBone.bbone_rollout
msgid "Roll offset for the end of the B-Bone, adjusts twist"
msgstr "Rullningsförskjutning för slutet av B-Bone; justerar vridningen"
