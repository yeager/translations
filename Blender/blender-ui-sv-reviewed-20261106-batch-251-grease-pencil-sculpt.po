#: scripts/startup/bl_ui/space_view3d_toolbar.py:106
#: scripts/startup/bl_ui/space_view3d_toolbar.py:1167
msgid "Radial"
msgstr "Radiell"

#. :src: bpy.types.GPencilSculptGuide.use_snapping
msgid "Enable snapping to guides angle or spacing options"
msgstr "Aktivera snäppning efter guidernas vinkel- eller avståndsalternativ"

#. :src: bpy.types.GPencilSculptSettings
msgid "GPencil Sculpt Settings"
msgstr "Skulpteringsinställningar för Grease Pencil"

#. :src: bpy.types.GPencilSculptSettings
msgid "General properties for Grease Pencil stroke sculpting tools"
msgstr "Allmänna egenskaper för skulpteringsverktyg för Grease Pencil-streck"

#. :src: bpy.types.GPencilSculptSettings.intersection_threshold
msgid "Threshold for stroke intersections"
msgstr "Tröskelvärde för streckkorsningar"

#. :src: bpy.types.GPencilSculptSettings.lock_axis:'VIEW'
msgid "Align strokes to current view plane"
msgstr "Justera strecken mot aktuellt vyplan"

#. :src: bpy.types.GPencilSculptSettings.lock_axis:'CURSOR'
msgid "Align strokes to current 3D cursor orientation"
msgstr "Justera strecken efter den aktuella 3D-markörens orientering"

#. :src: bpy.types.GPencilSculptSettings.multiframe_falloff_curve
msgid "Custom curve to control falloff of brush effect by Grease Pencil frames"
msgstr ""
"Anpassad kurva för att styra penselns avtagande över Grease Pencil-bildrutor"

#. :src: bpy.types.GPencilSculptSettings.thickness_primitive_curve
msgid "Custom curve to control primitive thickness"
msgstr "Anpassad kurva för att styra tjockleken på primitivet"

#. :src: bpy.types.GPencilSculptSettings.use_automasking_layer_active
#. :src: bpy.types.GPencilSculptSettings.use_automasking_layer_stroke
msgid "Auto-Masking Layer"
msgstr "Automaskering av lager"

#. :src: bpy.types.GPencilSculptSettings.use_automasking_material_active
#. :src: bpy.types.GPencilSculptSettings.use_automasking_material_stroke
msgid "Auto-Masking Material"
msgstr "Automaskering av material"

#. :src: bpy.types.GPencilSculptSettings.use_automasking_stroke
msgid "Auto-Masking Strokes"
msgstr "Automaskering av streck"

#. :src: bpy.types.GPencilSculptSettings.use_multiframe_falloff
msgid "Use Falloff"
msgstr "Använd avtagande"

#. :src: bpy.types.GPencilSculptSettings.use_multiframe_falloff
msgid ""
"Use falloff effect when edit in multiframe mode to compute brush effect by "
"frame"
msgstr ""
"Använd avtagandeeffekten vid redigering i flerbildsläge för att beräkna "
"penselns påverkan per bildruta"

#. :src: bpy.types.GPencilSculptSettings.use_scale_thickness
msgid "Scale Stroke Thickness"
msgstr "Skala strecktjocklek"

#. :src: bpy.types.GPencilSculptSettings.use_scale_thickness
msgid "Scale the stroke thickness when transforming strokes"
msgstr "Skala strecktjockleken när streck transformeras"

#. :src: bpy.types.GPencilSculptSettings.use_thickness_curve
msgid "Use curve to define primitive stroke thickness"
msgstr "Använd en kurva för att ange den primitiva strecktjockleken"

#. :src: bpy.types.GPencilStroke
msgid "Annotation Stroke"
msgstr "Anteckningsstreck"

#. :src: bpy.types.GPencilStroke.points
msgid "Stroke Points"
msgstr "Streckpunkter"

#. :src: bpy.types.GPencilStroke.points
msgid "Stroke data points"
msgstr "Streckets datapunkter"

#. :src: bpy.types.GPencilStrokePoint
msgid "Annotation Stroke Point"
msgstr "Anteckningsstreckpunkt"

#. :src: bpy.types.GPencilStrokePoint
msgid "Data point for freehand stroke curve"
msgstr "Datapunkt för frihandsstreckets kurva"
