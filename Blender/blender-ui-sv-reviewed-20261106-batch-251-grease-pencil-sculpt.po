#. :src: bpy.types.GPencilSculptGuide
msgid "Grease Pencil Sculpt Guide"
msgstr "Skulpteringsguide för Grease Pencil"

#. :src: bpy.types.GPencilSculptGuide.spacing
msgid "Guide spacing"
msgstr "Avstånd mellan guider"

#. :src: bpy.types.GPencilSculptGuide.type:'RADIAL'
#. :src: bpy.types.Brush.cloth_force_falloff_type:'RADIAL'
#. :src: bpy.types.Brush.gradient_fill_mode:'RADIAL'
#. :src: bpy.types.BlendTexture.progression:'RADIAL'
