msgstr "Färghantering för visningsenheten"

#. :src: bpy.types.ColorManagedDisplaySettings.display_device
msgid "Display Device"
msgstr "Visningsenhet"

#. :src: bpy.types.ColorManagedDisplaySettings.display_device
