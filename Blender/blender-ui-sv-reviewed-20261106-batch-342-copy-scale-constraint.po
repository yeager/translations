#. :src: bpy.types.CopyScaleConstraint
msgid "Copy Scale Constraint"
msgstr "Kopiera skala-begränsning"

#. :src: bpy.types.CopyScaleConstraint.power
msgctxt "Constraint"
msgid "Power"
msgstr "Potens"

#. :src: bpy.types.CopyScaleConstraint.power
msgid "Raise the target's scale to the specified power"
msgstr "Upphöj målskalan till den angivna potensen"

#. :src: bpy.types.CopyScaleConstraint.use_add
msgctxt "Constraint"
msgid "Additive"
msgstr "Additiv"

#. :src: bpy.types.CopyScaleConstraint.use_add
msgid ""
"Use addition instead of multiplication to combine scale (2.7 compatibility)"
msgstr ""
"Använd addition i stället för multiplikation för att kombinera skalan (2,7-"
"kompatibilitet)"

#. :src: bpy.types.CopyScaleConstraint.use_make_uniform
msgid "Make Uniform"
msgstr "Gör enhetlig"

#. :src: bpy.types.CopyScaleConstraint.use_make_uniform
msgid ""
"Redistribute the copied change in volume equally between the three axes of "
"the owner"
msgstr ""
"Omfördela den kopierade volymförändringen lika mellan ägarens tre axlar"

#. :src: bpy.types.CopyScaleConstraint.use_offset
msgid "Combine original scale with copied scale"
msgstr "Kombinera originalskalan med den kopierade skalan"
