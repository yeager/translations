#. :src: bpy.types.VolumeGrids
msgid "3D volume grids"
msgstr "3D-volymrutnät"

#. :src: bpy.types.Volume.render
msgid "Volume render settings for 3D viewport"
msgstr "Inställningar för volymrendering i 3D-vyporten"

#. :src: bpy.types.World.mist_settings
msgid "World mist settings"
msgstr "Diminställningar för världen"

#. :src: bpy.types.World.node_tree
msgid "Node tree for node based worlds"
msgstr "Nodträd för nodbaserade världar"

#. :src: bpy.types.World.probe_resolution
msgid "Resolution when baked to a texture"
msgstr "Upplösning vid bakning till en textur"

#. :src: bpy.types.World.sun_angle
msgid "Sun Angle"
msgstr "Solvinkel"

#. :src: bpy.types.World.sun_shadow_maximum_resolution
msgid ""
"Maximum size of a shadow map pixel. Higher values use less memory at the "
"cost of shadow quality."
msgstr ""
"Maximal storlek på en pixel i skuggkartan. Högre värden använder mindre "
"minne på bekostnad av skuggans kvalitet."

#. :src: bpy.types.World.sun_threshold
msgid "Sun Threshold"
msgstr "Soltröskel"

#. :src: bpy.types.World.use_eevee_finite_volume
msgid "Finite Volume"
msgstr "Ändlig volym"

#. :src: bpy.types.World.use_eevee_finite_volume
msgid ""
"The world's volume used to be rendered by EEVEE Legacy. Conversion is needed "
"for it to render properly."
msgstr ""
"Världens volym brukade återges av EEVEE Legacy. Konvertering behövs för att "
"den ska återges korrekt."

#. :src: bpy.types.World.use_sun_shadow
#. :src: bpy.types.GreasePencilLineartModifier.use_shadow
msgid "Use Shadow"
msgstr "Använd skugga"

#. :src: bpy.types.World.use_sun_shadow
msgid "Enable sun shadow casting"
msgstr "Aktivera skuggkastning från solen"

