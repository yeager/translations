#. :src: bpy.types.Volume
msgid "Volume data-block for 3D volume grids"
msgstr "Volymdatablock för 3D-volymrutnät"

#. :src: bpy.types.Volume.display
msgid "Volume display settings for 3D viewport"
msgstr "Inställningar för volymvisning i 3D-vyporten"

#. :src: bpy.types.Volume.filepath
msgid "Volume file used by this Volume data-block"
msgstr "Volymfil som används av detta volymdatablock"

