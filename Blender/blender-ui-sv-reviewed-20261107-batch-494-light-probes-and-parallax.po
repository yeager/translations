#. :src: bpy.types.LightProbe
msgid "Light Probe data-block for lighting capture objects"
msgstr "Ljussonddatablock för objekt som fångar belysning"

#. :src: bpy.types.LightProbe.clip_start
msgid "Probe clip start, below which objects will not appear in reflections"
msgstr "Sondens klippstart, under vilken objekt inte visas i reflektioner"

#. :src: bpy.types.LightProbe.data_display_size
msgid "Display Data Size"
msgstr "Storlek på visningsdata"

#. :src: bpy.types.LightProbe.data_display_size
msgid "Viewport display size of the sampled data"
msgstr "Storlek i 3D-vyn för samplade data"

#. :src: bpy.types.LightProbe.influence_distance
msgid "Influence Distance"
msgstr "Påverkansavstånd"

#. :src: bpy.types.LightProbe.influence_distance
msgid "Influence distance of the probe"
msgstr "Sondens påverkansavstånd"

#. :src: bpy.types.LightProbe.invert_visibility_collection
msgid "Invert Collection"
msgstr "Inverterad kollektion"

#. :src: bpy.types.LightProbe.invert_visibility_collection
msgid "Invert visibility collection (Deprecated)"
msgstr "Invertera synlighetssamling (Föråldrad)"

#. :src: bpy.types.LightProbe.show_clip
msgid "Show the clipping distances in the 3D view"
msgstr "Visa klippavstånden i 3D-vyn"

#. :src: bpy.types.LightProbe.show_data
msgid "Display Data (Deprecated)"
msgstr "Visa data (föråldrad)"

#. :src: bpy.types.LightProbe.show_data
msgid "Deprecated, use use_data_display instead"
msgstr "Föråldrad, använd use_data_display i stället"

#. :src: bpy.types.LightProbe.show_influence
msgid "Show the influence volume in the 3D view"
msgstr "Visa påverkansvolymen i 3D-vyn"

#. :src: bpy.types.LightProbe.type
msgid "Type of light probe"
msgstr "Typ av ljussond"

#. :src: bpy.types.LightProbe.type:'SPHERE'
#. :src: bpy.types.LightProbeSphere
#. :src: bpy.types.OBJECT_OT_lightprobe_add.type:'SPHERE'
msgid ""
"Light probe that captures precise lighting from all directions at a single "
"point in space"
msgstr ""
"Ljussond som fångar exakt belysning från alla riktningar vid en enda punkt i "
"rymden"

#. :src: bpy.types.LightProbe.type:'PLANE'
#. :src: bpy.types.LightProbePlane
#. :src: bpy.types.OBJECT_OT_lightprobe_add.type:'PLANE'
msgid ""
"Light probe that captures incoming light from a single direction on a plane"
msgstr ""
"Ljussond som fångar upp inkommande ljus från en enda riktning på ett plan"

#. :src: bpy.types.LightProbe.type:'VOLUME'
#. :src: bpy.types.LightProbeVolume
#. :src: bpy.types.OBJECT_OT_lightprobe_add.type:'VOLUME'
msgid "Light probe that captures low frequency lighting inside a volume"
msgstr "Ljussond som fångar upp lågfrekvent belysning inuti en volym"

#. :src: bpy.types.LightProbe.use_data_display
msgid "Display Data"
msgstr "Visa data"

#. :src: bpy.types.LightProbe.use_data_display
msgid "Display sampled data in the viewport to debug captured light"
msgstr "Visa samplade data i visningsfönstret för att felsöka uppfångat ljus"

#. :src: bpy.types.LightProbe.visibility_bleed_bias
msgid "Visibility Bleed Bias"
msgstr "Förskjutning för synlighetsläckage"

#. :src: bpy.types.LightProbe.visibility_bleed_bias
msgid "Bias for reducing light-bleed on variance shadow maps (Deprecated)"
msgstr "Förskjutning som minskar ljusläckage i variansskuggkartor (föråldrad)"

#. :src: bpy.types.LightProbe.visibility_blur
msgid "Visibility Blur"
msgstr "Oskärpa i synlighet"

#. :src: bpy.types.LightProbe.visibility_blur
msgid "Filter size of the visibility blur (Deprecated)"
msgstr "Filterstorlek för synlighetsoskärpa (Föråldrad)"

#. :src: bpy.types.LightProbe.visibility_buffer_bias
msgid "Visibility Bias"
msgstr "Synlighetsförskjutning"

#. :src: bpy.types.LightProbe.visibility_buffer_bias
msgid "Bias for reducing self shadowing (Deprecated)"
msgstr "Förskjutning som minskar självskuggning (föråldrad)"

#. :src: bpy.types.LightProbe.visibility_collection
msgid "Visibility Collection"
msgstr "Samling för synlighet"

#. :src: bpy.types.LightProbe.visibility_collection
msgid "Restrict objects visible for this probe (Deprecated)"
msgstr "Begränsa objekt som är synliga för denna sond (Föråldrad)"

#. :src: bpy.types.LightProbePlane
msgid "Planar Probe"
msgstr "Plan ljussond"

#. :src: bpy.types.LightProbeSphere
msgid "Spherical Probe"
msgstr "Sfärisk ljussond"

#. :src: bpy.types.LightProbeSphere.clip_end
msgid "Probe clip end, beyond which objects will not appear in reflections"
msgstr "Sondens klippslut, bortom vilket objekt inte visas i reflektioner"

#. :src: bpy.types.LightProbeSphere.falloff
msgid "Control how fast the probe influence decreases"
msgstr "Styr hur snabbt sondens påverkan minskar"

#. :src: bpy.types.LightProbeSphere.influence_type
msgid "Type of influence volume"
msgstr "Typ av påverkansvolym"

#. :src: bpy.types.LightProbeSphere.parallax_distance
msgid "Parallax Radius"
msgstr "Parallaxradie"

#. :src: bpy.types.LightProbeSphere.parallax_distance
msgid "Lowest corner of the parallax bounding box"
msgstr "Lägsta hörnet av parallaxens avgränsningsbox"

#. :src: bpy.types.LightProbeSphere.parallax_type
msgid "Type of parallax volume"
msgstr "Typ av parallaxvolym"

#. :src: bpy.types.LightProbeSphere.show_parallax
msgid "Parallax"
msgstr "Parallax"

#. :src: bpy.types.LightProbeSphere.show_parallax
msgid "Show the parallax correction volume in the 3D view"
msgstr "Visa volymen för parallaxkorrigering i 3D-vyn"

#. :src: bpy.types.LightProbeSphere.use_custom_parallax
msgid "Use Custom Parallax"
msgstr "Använd anpassad parallax"

#. :src: bpy.types.LightProbeSphere.use_custom_parallax
msgid "Enable custom settings for the parallax correction volume"
msgstr "Aktivera anpassade inställningar för parallaxkorrigeringsvolymen"
