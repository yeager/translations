#. :src: bpy.types.FCurve
#. :src: bpy.types.GRAPH_MT_context_menu
msgid "F-Curve"
msgstr "F-kurva"

#. :src: bpy.types.FCurve
msgid "F-Curve defining values of a period of time"
msgstr "F-kurva som definierar värden över en tidsperiod"

#. :src: bpy.types.FCurve.array_index
#. :src: bpy.types.KeyingSetPath.array_index
msgid "RNA Array Index"
msgstr "Index för RNA-array"

#. :src: bpy.types.FCurve.array_index
msgid "Index to the specific property affected by F-Curve if applicable"
msgstr ""
"Index till den specifika egenskap som påverkas av F-kurvan, om tillämpligt"

#. :src: bpy.types.FCurve.auto_smoothing
msgid "Auto Handle Smoothing"
msgstr "Automatisk utjämning av handtag"

#. :src: bpy.types.FCurve.auto_smoothing
msgid "Algorithm used to compute automatic handles"
msgstr "Algoritm som används för att beräkna automatiska handtag"

#. :src: bpy.types.FCurve.auto_smoothing:'NONE'
#. :src: bpy.types.PreferencesEdit.fcurve_new_auto_smoothing:'NONE'
msgid "Automatic handles only take immediately adjacent keys into account"
msgstr ""
"Automatiska handtag tar endast hänsyn till omedelbart intilliggande "
"nyckelbildrutor"

#. :src: bpy.types.FCurve.auto_smoothing:'CONT_ACCEL'
#. :src: bpy.types.PreferencesEdit.fcurve_new_auto_smoothing:'CONT_ACCEL'
msgid "Continuous Acceleration"
msgstr "Kontinuerlig acceleration"

#. :src: bpy.types.FCurve.auto_smoothing:'CONT_ACCEL'
#. :src: bpy.types.PreferencesEdit.fcurve_new_auto_smoothing:'CONT_ACCEL'
msgid ""
"Automatic handles are adjusted to avoid jumps in acceleration, resulting in "
"smoother curves. However, key changes may affect interpolation over a larger "
"stretch of the curve."
msgstr ""
"Automatiska handtag justeras för att undvika hopp i accelerationen, vilket "
"resulterar i mjukare kurvor. Nyckeländringar kan dock påverka "
"interpoleringen över en större del av kurvan."

#. :src: bpy.types.FCurve.color
msgid "Color of the F-Curve in the Graph Editor"
msgstr "F-kurvans färg i grafredigeraren"
