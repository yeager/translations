#. :src: bpy.types.BakeSettings
#. :src: bpy.types.RenderSettings.bake
msgid "Bake Data"
msgstr "Bakningsdata"

#. :src: bpy.types.BakeSettings
msgid "Bake data for a Scene data-block"
msgstr "Bakningsdata för ett scendatablock"

#. :src: bpy.types.BakeSettings.cage_extrusion
#. :src: bpy.types.OBJECT_OT_bake.cage_extrusion
msgid "Cage Extrusion"
msgstr "Bursextrudering"

#. :src: bpy.types.BakeSettings.cage_extrusion
msgid ""
"Inflate the active object by the specified distance for baking. This helps "
"matching to points nearer to the outside of the selected object meshes."
msgstr ""
"Utvidga det aktiva objektet med det angivna avståndet för bakning. Detta "
"underlättar matchningen mot punkter närmare utsidan av de valda objektens "
"mesh."

#. :src: bpy.types.BakeSettings.cage_object
#. :src: bpy.types.OBJECT_OT_bake.cage_object
msgid "Cage Object"
msgstr "Burobjekt"

#. :src: bpy.types.BakeSettings.cage_object
msgid ""
"Object to use as cage instead of calculating the cage from the active object "
"with cage extrusion"
msgstr ""
"Objekt som används som bur i stället för att beräkna buren från det aktiva "
"objektet med bursextrudering"

#. :src: bpy.types.BakeSettings.height
msgid "Vertical dimension of the baking map"
msgstr "Bakningskartans höjd"

#. :src: bpy.types.BakeSettings.margin
#. :src: bpy.types.OBJECT_OT_bake.margin
#. :src: bpy.types.RenderSettings.bake_margin
msgid "Extends the baked result as a post process filter"
msgstr "Utökar bakningsresultatet med ett efterbehandlingsfilter"

#. :src: bpy.types.BakeSettings.margin_type:'EXTEND'
#. :src: bpy.types.OBJECT_OT_bake.margin_type:'EXTEND'
#. :src: bpy.types.RenderSettings.bake_margin_type:'EXTEND'
msgid "Extend border pixels outwards"
msgstr "Utöka kantpixlarna utåt"

#. :src: bpy.types.BakeSettings.max_ray_distance
#. :src: bpy.types.OBJECT_OT_bake.max_ray_distance
msgid "Max Ray Distance"
msgstr "Maximalt strålavstånd"

#. :src: bpy.types.BakeSettings.max_ray_distance
msgid ""
"The maximum ray distance for matching points between the active and selected "
"objects. If zero, there is no limit."
msgstr ""
"Maximalt strålavstånd för att matcha punkter mellan det aktiva och de valda "
"objekten. Om värdet är noll finns ingen gräns."

