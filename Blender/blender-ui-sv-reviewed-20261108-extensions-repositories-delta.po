#. :src: bpy.types.UserAssetLibrary.extension_id
msgid "Identifier of the extension defining this asset library (repository module and package ID), empty for user defined libraries"
msgstr "Identifierare för tillägget som definierar detta resursbibliotek, med förrådsmodul och paketidentifierare. Tomt för användardefinierade bibliotek"

#. :src: bpy.types.UserExtensionRepo.enabled
msgid "Enable the repository"
msgstr "Aktivera tilläggsförrådet"

#. :src: bpy.types.UserExtensionRepo.show_expanded
msgid "Show the asset libraries of this repository in the preferences"
msgstr "Visa resursbiblioteken från detta tilläggsförråd i inställningarna"

#. :src: bpy.types.UserExtensionRepo.source
msgid "Select if the repository is in a user managed or system provided directory"
msgstr "Välj om tilläggsförrådet finns i en användarhanterad eller systemtillhandahållen katalog"

#. :src: bpy.types.UserExtensionRepo.use_remote_url
msgid "Synchronize the repository with a remote URL"
msgstr "Synkronisera tilläggsförrådet med en fjärr-URL"

msgid "Refresh the list of extensions for the active repository"
msgstr "Uppdatera listan över tillägg för det aktiva tilläggsförrådet"

msgid "Upgrade all the extensions to their latest version for the active repository"
msgstr "Uppgradera alla tillägg till den senaste versionen för det aktiva tilläggsförrådet"

msgid "There must be at least one user repository set to install extensions into"
msgstr "Det måste finnas minst ett användartilläggsförråd där tillägg kan installeras"

msgid "The active repository has invalid settings"
msgstr "Det aktiva tilläggsförrådet har ogiltiga inställningar"

msgid "Defined by the extension repository"
msgstr "Definieras av tilläggsförrådet"
