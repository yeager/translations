msgid "%sAction"
msgstr "%sAction"

#: source/blender/editors/animation/anim_asset_ops.cc:839
msgid "Could not load Action for the active asset"
msgstr "Det gick inte att läsa in Actionen för den aktiva resursen"

#: source/blender/editors/animation/anim_asset_ops.cc:541
msgid "Action is not editable"
msgstr "Actionen kan inte redigeras"

#: source/blender/editors/animation/anim_channels_edit.cc:5278
msgid "None of the selected channels is an Action Slot"
msgstr "Ingen av de valda kanalerna är en Action-slot"

#: source/blender/editors/animation/anim_ops.cc:1493
msgid "Replace Action"
msgstr "Ersätt Action"

#: source/blender/editors/animation/anim_ops.cc:1551
#: source/blender/editors/animation/anim_ops.cc:1616
msgid "Invalid UID for old Action"
msgstr "Ogiltigt UID för gammal Action"

#: source/blender/editors/animation/anim_ops.cc:1456
msgid "Invalid old/new Action pair ('%s' / '%s')"
msgstr "Ogiltigt gammalt/nytt Action-par (”%s” / ”%s”)"

#: source/blender/editors/animation/anim_ops.cc:1464
msgid "Cannot replace Action with itself ('%s')"
msgstr "Det går inte att ersätta Actionen med sig själv (”%s”)"

#: source/blender/editors/space_nla/nla_buttons.cc:664
msgid "Action Clip"
msgstr "Action-klipp"

#: source/blender/makesrna/intern/rna_action.cc:222
msgid "This slot does not belong to this Action"
msgstr "Denna Action-slot tillhör inte denna Action"

#: source/blender/makesrna/intern/rna_action.cc:253
msgid "An Action may not have more than one layer"
msgstr "En Action får inte ha mer än ett lager"

#: source/blender/makesrna/intern/rna_action.cc:271
msgid "This layer does not belong to this Action"
msgstr "Detta lager tillhör inte denna Action"

#: source/blender/makesrna/intern/rna_action.cc:327
msgid "Action slot display names cannot be empty"
msgstr "Visningsnamn för Action-slotar får inte vara tomma"

#: source/blender/makesrna/intern/rna_action.cc:341
msgid "Action slot identifiers should be at least three characters"
msgstr "Identifierare för Action-slotar ska innehålla minst tre tecken"

#: source/blender/makesrna/intern/rna_animation.cc:306
#: source/blender/makesrna/intern/rna_animation.cc:392
msgid "Cannot set slot without an assigned Action."
msgstr "Det går inte att ange Action-slot utan en tilldelad Action."

#: source/blender/makesrna/intern/rna_animation.cc:368
msgid "This slot (%s) does not belong to the assigned Action"
msgstr "Denna Action-slot (%s) tillhör inte den tilldelade Actionen"
