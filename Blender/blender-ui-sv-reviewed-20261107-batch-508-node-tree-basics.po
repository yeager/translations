msgid ""
"Undefined type of nodes (can happen e.g. when a linked node tree goes "
"missing)"
msgstr ""
"Odefinierad typ av noder (kan t.ex. inträffa när ett länkat nodträd "
"försvinner)"

#. :src: bpy.types.NodeTree.type:'CUSTOM'
msgid "Custom nodes"
