#. :src: bpy.types.NodeTree.default_group_node_width
msgid "Default Group Node Width"
msgstr "Standardbredd för gruppnoder"

#. :src: bpy.types.NodeTree.default_group_node_width
msgid "The width for newly created group nodes"
msgstr "Bredden för nyskapade gruppnoder"

#. :src: bpy.types.NodeTree.description
msgid "Description of the node tree"
msgstr "Beskrivning av nodträdet"

