#. :src: bpy.types.NodeTree
msgid ""
"Node tree consisting of linked nodes used for shading, textures and "
"compositing"
msgstr ""
"Nodträd med sammanlänkade noder för skuggning, texturer och komposition"

#. :src: bpy.types.NodeTree.bl_label
msgid "The node tree label"
msgstr "Nodträdets etikett"

#. :src: bpy.types.NodeTree.bl_use_group_interface
msgid "Use Group Interface"
msgstr "Använd gruppgränssnitt"

#. :src: bpy.types.NodeTree.bl_use_group_interface
msgid "Determines the visibility of some UI elements related to node groups"
msgstr ""
"Bestämmer synligheten för vissa UI-element som är relaterade till nodgrupper"

#. :src: bpy.types.NodeTree.color_tag
#. :src: bpy.types.Node.color_tag
#. :src: bpy.types.GREASE_PENCIL_OT_layer_group_color_tag.color_tag
