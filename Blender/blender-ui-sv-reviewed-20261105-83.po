#. :src: bpy.types.LightProbeVolume.dilation_radius
msgid "Dilation Radius"
msgstr "Utvidgningsradie"

#. :src: bpy.types.LightProbeVolume.dilation_radius
msgid ""
"Radius in grid sample to search valid grid samples to copy into invalid grid "
"samples"
msgstr ""
"Radie inom rutnätsprovet för att söka efter giltiga rutnätsprov att kopiera "
"till ogiltiga rutnätsprov"

#. :src: bpy.types.LightProbeVolume.dilation_threshold
msgid "Dilation Threshold"
msgstr "Utvidgningströskel"

#. :src: bpy.types.LightProbeVolume.dilation_threshold
msgid ""
"Ratio of front-facing surface hits under which a grid sample will reuse "
"neighbors grid sample lighting"
msgstr ""
"Förhållande mellan träffar på framåtvända ytor under vilket ett rutnätsprov "
"återanvänder belysningen från angränsande rutnätsprov"

#. :src: bpy.types.LightProbeVolume.escape_bias
msgid "Search Distance"
msgstr "Sökavstånd"

#. :src: bpy.types.LightProbeVolume.facing_bias
msgid "Facing Bias"
msgstr "Riktningsförskjutning"

#. :src: bpy.types.LightProbeVolume.facing_bias
msgid "Smoother irradiance interpolation but introduce light bleeding"
msgstr "Ger jämnare interpolering av irradians, men kan orsaka ljusläckage"

#. :src: bpy.types.LightProbeVolume.intensity
msgid "Modify the intensity of the lighting captured by this probe"
msgstr "Ändra intensiteten hos belysningen som fångas av denna ljussond"

#. :src: bpy.types.LightProbeVolume.normal_bias
msgid "Normal Bias"
msgstr "Normalförskjutning"

#. :src: bpy.types.LightProbeVolume.surfel_density
msgid "Surfel Resolution"
msgstr "Surfelupplösning"

#. :src: bpy.types.LightProbeVolume.surfel_density
msgid ""
"Number of surfels to spawn in one local unit distance (higher values improve "
"quality)"
msgstr ""
"Antal surfelar per lokal längdenhet (högre värden förbättrar kvaliteten)"

#. :src: bpy.types.LightProbeVolume.view_bias
msgid "View Bias"
msgstr "Visningsförskjutning"

#. :src: bpy.types.Mask
msgid "Mask data-block defining mask for compositing"
msgstr "Maskdatablock som definierar en mask för komposition"

#. :src: bpy.types.Mask.frame_end
msgid "Final frame of the mask (used for sequencer)"
msgstr "Maskens sista bildruta (används för sekvensredigeraren)"

#. :src: bpy.types.Mask.frame_start
msgid "First frame of the mask (used for sequencer)"
msgstr "Maskens första bildruta (används för sekvensredigeraren)"

#. :src: bpy.types.Material.blend_method:'OPAQUE'
msgctxt "Material"
msgid "Opaque"
msgstr "Ogenomskinlig"

#. :src: bpy.types.Material.blend_method:'CLIP'
msgctxt "Material"
msgid "Alpha Clip"
msgstr "Alfaklippning"

#. :src: bpy.types.Material.blend_method:'HASHED'
msgctxt "Material"
msgid "Alpha Hashed"
msgstr "Hashad alfa"

#. :src: bpy.types.Material.blend_method:'HASHED'
msgid ""
"Use noise to dither the binary visibility (works well with multi-samples)"
msgstr ""
"Använd brus för att dithra den binära synligheten (fungerar bra med flera "
"prov)"

#. :src: bpy.types.Material.cycles
msgid "Cycles Material Settings"
msgstr "Cycles-materialinställningar"

#. :src: bpy.types.Material.cycles
msgid "Cycles material settings"
msgstr "Cycles-materialinställningar"

#. :src: bpy.types.Material.grease_pencil
msgid "Grease Pencil Settings"
msgstr "Inställningar för Grease Pencil"

#. :src: bpy.types.Material.line_color
msgid "Line color used for Freestyle line rendering"
msgstr "Linjefärg som används för Freestyle-linjerendering"

#. :src: bpy.types.Material.max_vertex_displacement
msgid "Max Vertex Displacement"
msgstr "Maximal hörnpunktsförskjutning"

#. :src: bpy.types.Material.max_vertex_displacement
msgid ""
"The max distance a vertex can be displaced. Displacements over this "
"threshold may cause visibility issues."
msgstr ""
"Det maximala avstånd som en hörnpunkt kan förskjutas. Förskjutningar över "
"detta tröskelvärde kan orsaka synlighetsproblem."

#. :src: bpy.types.Material.metallic
msgid "Amount of mirror reflection for raytrace"
msgstr "Mängd spegelreflektion för strålspårning"

#. :src: bpy.types.Material.paint_active_slot
msgid "Active Paint Texture Index"
msgstr "Index för aktiv målningsstruktur"

#. :src: bpy.types.Material.paint_active_slot
msgid "Index of active texture paint slot"
msgstr "Index för aktiv texturmålningsplats"

#. :src: bpy.types.Material.paint_clone_slot
msgid "Clone Paint Texture Index"
msgstr "Index för klonmålningsstruktur"

#. :src: bpy.types.Material.paint_clone_slot
msgid "Index of clone texture paint slot"
msgstr "Index för klontexturmålningsplats"

#. :src: bpy.types.Material.preview_render_type
msgctxt "Material"
msgid "Preview Render Type"
msgstr "Typ av förhandsgranskningsrendering"

#. :src: bpy.types.Material.preview_render_type
msgid "Type of preview render"
msgstr "Typ av förhandsgranskningsrendering"

#. :src: bpy.types.Material.show_transparent_back
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.show_transparent_back
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.show_transparent_back
msgid "Show Backface"
msgstr "Visa baksida"

#. :src: bpy.types.Material.specular_intensity
#. :src: bpy.types.NWPrincipledPreferences.specular
#: scripts/startup/bl_ui/properties_material.py:183
#: scripts/startup/bl_ui/properties_view_layer.py:128
#: scripts/startup/bl_ui/space_userpref.py:2765
#: source/blender/nodes/shader/nodes/node_shader_bsdf_principled.cc:132
#: source/blender/nodes/shader/nodes/node_shader_eevee_specular.cc:11
msgid "Specular"
msgstr "Spekulär"

#. :src: bpy.types.Material.specular_intensity
msgid "How intense (bright) the specular reflection is"
msgstr "Hur intensiv den spekulära reflektionen är"

#. :src: bpy.types.Material.surface_render_method
msgid "Surface Render Method"
msgstr "Ytans renderingsmetod"

#. :src: bpy.types.Material.surface_render_method:'DITHERED'
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.render_method:'DITHERED'
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.render_method:'DITHERED'
msgid "Dithered"
msgstr "Dithrad"

#. :src: bpy.types.Material.surface_render_method:'DITHERED'
msgid ""
"Allows for grayscale hashed transparency, and compatible with render passes "
"and raytracing. Also known as deferred rendering."
msgstr ""
"Ger möjlighet till hashad transparens i gråskala och är kompatibel med "
"renderingspass och strålspårning. Kallas även uppskjuten rendering."

#. :src: bpy.types.Material.surface_render_method:'BLENDED'
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.render_method:'BLENDED'
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.render_method:'BLENDED'
msgid "Blended"
msgstr "Blandad"

#. :src: bpy.types.Material.surface_render_method:'BLENDED'
msgid ""
"Allows for colored transparency, but incompatible with render passes and "
"raytracing. Also known as forward rendering."
msgstr ""
"Ger möjlighet till färgad transparens, men är inkompatibel med "
"renderingspass och strålspårning. Kallas även framåtriktad rendering."

#. :src: bpy.types.Material.texture_paint_images
msgid "Texture Slot Images"
msgstr "Bilder i texturplatser"

#. :src: bpy.types.Material.texture_paint_slots
#. :src: bpy.types.LineStyleTextureSlots
#. :src: bpy.types.VIEW3D_PT_slots_projectpaint
#. :src: bpy.types.ParticleSettingsTextureSlots
#: scripts/startup/bl_ui/space_view3d_toolbar.py:587
msgid "Texture Slots"
msgstr "Texturplatser"

#. :src: bpy.types.Material.thickness_mode
#. :src: bpy.types.SolidifyModifier.nonmanifold_thickness_mode
#: source/blender/modifiers/intern/MOD_solidify.cc:91
msgid "Thickness Mode"
msgstr "Tjockleksläge"

#. :src: bpy.types.Material.use_backface_culling
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.use_backface_culling
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.use_backface_culling
#. :src: bpy.types.ToolSettings.use_snap_backface_culling
#. :src: bpy.types.View3DShading.show_backface_culling
#: scripts/startup/bl_ui/properties_material.py:256
#: scripts/startup/bl_ui/space_view3d_toolbar.py:1423
msgid "Backface Culling"
msgstr "Baksidesgallring"

#. :src: bpy.types.Material.use_backface_culling
#. :src: bpy.types.View3DShading.show_backface_culling
msgid "Use back face culling to hide the back side of faces"
msgstr "Använd baksidesgallring för att dölja ytornas baksidor"

#. :src: bpy.types.Material.use_backface_culling_lightprobe_volume
msgid "Light Probe Volume Backface Culling"
msgstr "Baksidesgallring för volymljussond"

#. :src: bpy.types.Material.use_backface_culling_lightprobe_volume
msgid ""
"Consider material single sided for light probe volume capture. Additionally "
"helps rejecting probes inside the object to avoid light leaks."
msgstr ""
"Betrakta materialet som enkelsidigt när volymljussonden fångar in data. Det "
"hjälper även till att avvisa sonder inuti objektet och undvika ljusläckage."

#. :src: bpy.types.Material.use_backface_culling_shadow
msgid "Shadow Backface Culling"
msgstr "Baksidesgallring för skuggor"

#. :src: bpy.types.Material.use_backface_culling_shadow
msgid "Use back face culling when casting shadows"
msgstr "Använd baksidesgallring när skuggor kastas"

#. :src: bpy.types.Material.use_nodes
msgid "Use shader nodes to render the material"
msgstr "Använd shadernoder för att rendera materialet"

#. :src: bpy.types.Material.use_raytrace_refraction
#. :src: bpy.types.Material.use_screen_refraction
msgid "Raytrace Transmission"
msgstr "Strålspårad transmission"

#. :src: bpy.types.Material.use_raytrace_refraction
msgid ""
"Use raytracing to determine transmitted color instead of using only light "
"probes. This prevents the surface from contributing to the lighting of "
"surfaces not using this setting."
msgstr ""
"Använd strålspårning för att bestämma den överförda färgen i stället för att "
"bara använda ljussonder. Detta förhindrar att ytan bidrar till belysningen "
"av ytor som inte använder denna inställning."

#. :src: bpy.types.Material.use_transparency_overlap
msgid "Use Transparency Overlap"
msgstr "Använd överlappande transparens"

#. :src: bpy.types.Material.volume_intersection_method
msgid "Volume Intersection Method"
msgstr "Volymskärningsmetod"

#. :src: bpy.types.Mesh
msgid "Mesh data-block defining geometric surfaces"
msgstr "Mesh-datablock som definierar geometriska ytor"

#. :src: bpy.types.Mesh.edges
msgid "Edges of the mesh"
msgstr "Meshens kanter"

#. :src: bpy.types.Mesh.has_custom_normals
msgid "True if there are custom split normals data in this mesh"
msgstr "Sant om det finns anpassade data för delade normaler i detta mesh"

#. :src: bpy.types.Mesh.loop_triangles
msgid "Loop Triangles"
msgstr "Looptrianglar"

#. :src: bpy.types.Mesh.loops
msgid "Loops of the mesh (face corners)"
msgstr "Meshens loopar (ythörn)"

#. :src: bpy.types.Mesh.normals_domain
msgid "Normal Domain"
msgstr "Normaldomän"

#. :src: bpy.types.Mesh.remesh_mode:'VOXEL'
msgid "Use the voxel remesher"
msgstr "Använd voxel-ommesharen"

#. :src: bpy.types.Mesh.remesh_mode:'QUAD'
msgid "Use the quad remesher"
msgstr "Använd quad-ommesharen"

#. :src: bpy.types.Mesh.skin_vertices
msgid "Skin Vertices"
msgstr "Skin-hörnpunkter"

#. :src: bpy.types.Mesh.skin_vertices
msgid "All skin vertices"
msgstr "Alla Skin-hörnpunkter"

#. :src: bpy.types.Mesh.texco_mesh
msgid "Texture Space Mesh"
msgstr "Mesh för texturutrymme"

#. :src: bpy.types.Mesh.texco_mesh
msgid "Derive texture coordinates from another mesh"
msgstr "Härled texturkoordinater från ett annat mesh"

#. :src: bpy.types.Mesh.texture_mesh
msgid "Texture Mesh"
msgstr "Texturmesh"

#. :src: bpy.types.Mesh.total_edge_sel
msgid "Selected Edge Total"
msgstr "Antal markerade kanter"

#. :src: bpy.types.Mesh.total_face_sel
msgid "Selected Face Total"
msgstr "Antal markerade ytor"

#. :src: bpy.types.Mesh.total_vert_sel
msgid "Selected Vertex Total"
msgstr "Antal markerade hörnpunkter"

#. :src: bpy.types.Mesh.total_vert_sel
msgid "Selected vertex count in editmode"
msgstr "Antal markerade hörnpunkter i redigeringsläge"

#. :src: bpy.types.Mesh.use_mirror_topology
#. :src: bpy.types.OBJECT_OT_shape_key_mirror.use_topology
#. :src: bpy.types.OBJECT_OT_vertex_group_mirror.use_topology
msgid "Topology Mirror"
msgstr "Topologispegling"

#. :src: bpy.types.Mesh.use_mirror_vertex_groups
#. :src: bpy.types.MirrorModifier.use_mirror_vertex_groups
msgid "Mirror Vertex Groups"
msgstr "Spegla hörnpunktsgrupper"

#. :src: bpy.types.Mesh.use_mirror_vertex_groups
msgid ""
"Mirror the left/right vertex groups when painting. The symmetry axis is "
"determined by the symmetry settings."
msgstr ""
"Spegla vänster/höger-hörnpunktsgrupperna vid målning. Symmetriaxeln bestäms "
"av symmetriinställningarna."

#. :src: bpy.types.Mesh.use_paint_bone_selection
msgid "Bone Selection"
msgstr "Benmarkering"

#. :src: bpy.types.Mesh.use_paint_mask
msgid "Paint Mask"
msgstr "Målningsmask"

#. :src: bpy.types.Mesh.use_paint_mask
msgid "Face selection masking for painting"
msgstr "Maskering med ytmarkering för målning"

#. :src: bpy.types.Mesh.use_paint_mask_vertex
msgid "Vertex Selection"
msgstr "Hörnpunktsmarkering"

#. :src: bpy.types.Mesh.use_paint_mask_vertex
msgid "Vertex selection masking for painting"
msgstr "Maskering med hörnpunktsmarkering för målning"
