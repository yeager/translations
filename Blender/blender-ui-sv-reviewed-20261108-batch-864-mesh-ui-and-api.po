#. :src: bpy.types.MESH_OT_bevel.vmesh_method
msgid "The method to use to create meshes at intersections"
msgstr "Metod för att skapa mesh vid skärningspunkter"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.seed
msgid ""
"Random seed to use with the solver. Different seeds will cause the remesher "
"to come up with different quad layouts on the mesh"
msgstr ""
"Slumpfrö att använda med lösaren. Olika frön får ommeshningsverktyget att "
"skapa olika fyrhörningslayouter i meshen"

#. :src: bpy.types.UV_OT_project_from_view
msgid "Project the UV vertices of the mesh as seen in current 3D view"
msgstr "Projicera UV-hörnpunkterna i meshen som de visas i den aktuella 3D-vyn"

#. :src: bpy.types.UV_OT_sphere_project
msgid "Project the UV vertices of the mesh over the curved surface of a sphere"
msgstr "Projicera UV-hörnpunkterna i meshen över den böjda ytan på en sfär"

#. :src: bpy.types.WM_OT_usd_export.export_armatures
msgid ""
"Export armatures and meshes with armature modifiers as USD skeletons and "
"skinned meshes"
msgstr ""
"Exportera armaturer och mesh med armaturmodifierare som USD-skelett och "
"skinnade mesh"

#. :src: bpy.types.WM_OT_usd_export.export_subdivision:'BEST_MATCH'
msgid ""
"Scheme = Catmull-Clark, when possible. Reverts to exporting the subdivided "
"mesh for the Simple subdivision type"
msgstr ""
"Schema = Catmull-Clark när det är möjligt. Återgå till export av den "
"underindelade meshen för underindelningstypen Simple"

#. :src: bpy.types.WM_OT_usd_export.export_uvmaps
msgid "Include all mesh UV maps in the export"
msgstr "Inkludera alla UV-kartor för mesh i exporten"

#. :src: bpy.types.WM_OT_usd_export.triangulate_meshes
msgid "Triangulate meshes during export"
msgstr "Triangulera mesh under export"

#. :src: bpy.types.Paint.use_cavity
msgid "Mask painting according to mesh geometry cavity"
msgstr "Maskmålning utifrån håligheter i meshgeometrin"

#. :src: bpy.types.Sculpt.detail_refine_method:'SUBDIVIDE'
msgid "Subdivide long edges to add mesh detail where needed"
msgstr "Dela upp långa kanter för att lägga till meshdetaljer där det behövs"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'FRONT'
msgid ""
"Treat only front side of the surface as a light, usually for closed meshes "
"whose interior is not visible"
msgstr ""
"Behandla bara ytans framsida som en ljuskälla, vanligtvis för slutna mesh "
"vars insida inte är synlig"

#. :src: bpy.types.RigidBodyObject.mesh_source
msgid "Source of the mesh used to create collision shape"
msgstr "Källa till meshen som används för att skapa kollisionsformen"

#. :src: bpy.types.ToolSettings.mesh_select_mode
msgid "Which mesh elements selection works on"
msgstr "Vilka meshelement urvalet fungerar på"

#. :src: bpy.types.ToolSettings.uv_sticky_select_mode:'SHARED_LOCATION'
msgid "Select UVs that are at the same location and share a mesh vertex"
msgstr "Välj UV:er som finns på samma plats och delar en mesh-hörnpunkt"

#. :src: bpy.types.ToolSettings.uv_sticky_select_mode:'SHARED_VERTEX'
msgid ""
"Select UVs that share a mesh vertex, whether or not they are at the same "
"location"
msgstr ""
"Välj UV:er som delar en mesh-hörnpunkt, oavsett om de finns på samma plats "
"eller inte"

#. :src: bpy.types.View3DOverlay.retopology_offset
msgid "Offset used to draw edit mesh in front of other geometry"
msgstr ""
"Förskjutning som används för att rita redigeringsmesh framför annan geometri"

#. :src: bpy.types.View3DOverlay.show_retopology
msgid ""
"Hide the solid mesh and offset the overlay towards the view. Selection is "
"occluded by inactive geometry, unless X-Ray is enabled"
msgstr ""
"Dölj den solida meshen och förskjut överlägget mot vyn. Urvalet skymmer "
"inaktiv geometri om inte röntgen är aktiverad"

#. :src: bpy.types.View3DOverlay.show_statvis
msgid "Display statistical information about the mesh"
msgstr "Visa statistisk information om meshen"

#. :src: KM_HIERARCHY.VIEW_3D.EMPTY:'SET_USE_SELECTED'
msgid "Select new active mesh element and use its location"
msgstr "Välj ett nytt aktivt meshelement och använd dess placering"

#: source/blender/editors/mesh/editmesh_loopcut.cc:397
msgid "Loop cut does not work well on deformed edit mesh display"
msgstr ""
"Kantslingeskärning fungerar inte bra på deformerad redigeringsmeshvisning"

#: source/blender/editors/mesh/meshtools.cc:144
msgid "No additional selected meshes with equal vertex count to join"
msgstr "Inga ytterligare valda mesh med samma antal hörnpunkter att sammanfoga"

#: source/blender/editors/object/object_bake_api.cc:462
msgid "Object \"%s\" is not a mesh"
msgstr "Objektet ”%s” är inte ett mesh"

#: source/blender/editors/object/object_bake_api.cc:650
msgid ""
"Object \"%s\" is not a mesh or cannot be converted to a mesh (Curve, Text, "
"Surface or Metaball)"
msgstr ""
"Objektet ”%s” är inte ett mesh eller kan inte konverteras till ett mesh "
"(kurva, text, yta eller metaboll)"

#: source/blender/editors/object/object_modifier.cc:1067
msgid "Modifier cannot be applied to a mesh with shape keys"
msgstr "Modifieraren kan inte tillämpas på ett mesh med formnycklar"

#: source/blender/editors/object/object_remesh.cc:134
msgid "Voxel remesher failed to create mesh"
msgstr "Voxelommesharen kunde inte skapa mesh"

#: source/blender/editors/object/object_vgroup.cc:3471
msgid "No meshes with vertex groups found"
msgstr "Inga mesh med hörnpunktsgrupper hittades"

#: source/blender/editors/sculpt_paint/curves/sculpt_brush.cc:405
msgid "Original surface mesh is empty"
msgstr "Originalytans mesh är tom"

#: source/blender/editors/sculpt_paint/mesh/sculpt_trim.cc:624
msgid "Solver requires a manifold mesh"
msgstr "Lösaren kräver ett manifold-mesh"

#: source/blender/editors/uvedit/uvedit_unwrap_ops.cc:2887
msgid ""
"Object has non-uniform scale, unwrap will operate on a non-scaled version of "
"the mesh"
msgstr ""
"Objektet har icke-enhetlig skala; uppackning fungerar på en oskalad version "
"av meshen"

#: source/blender/editors/uvedit/uvedit_unwrap_ops.cc:2896
msgid ""
"Object has negative scale, unwrap will operate on a non-flipped version of "
"the mesh"
msgstr ""
"Objektet har negativ skala; uppackning fungerar på en ovänd version av meshen"

#: source/blender/geometry/intern/realize_instances.cc:2021
msgid "Realized mesh has too many elements."
msgstr "Den realiserade meshen har för många element."

#: source/blender/io/alembic/intern/abc_reader_mesh.cc:568
msgid "Invalid mesh; more detail on the console"
msgstr "Ogiltig mesh; mer information finns i konsolen"

#: source/blender/io/alembic/intern/abc_reader_mesh.cc:599
msgid ""
"Topology has changed, perhaps by triangulating the mesh. Only vertices will "
"be read!"
msgstr ""
"Topologin har ändrats, kanske genom triangulering av meshen. Endast "
"hörnpunkter kommer att läsas!"

#: source/blender/io/usd/intern/usd_reader_mesh.cc:1024
msgid "Fixed mesh for prim: %s"
msgstr "Korrigerad mesh för prim: %s"

#: source/blender/io/usd/intern/usd_writer_mesh.cc:491
msgid "USD export: Simple subdivision not supported, exporting subdivided mesh"
msgstr ""
"USD-export: Enkel underindelning stöds inte; exporterar underindelad mesh"

#: source/blender/makesrna/intern/rna_object_api.cc:554
msgid "Object should be of mesh type"
msgstr "Objektet ska ha meshtyp"

#: source/blender/makesrna/intern/rna_object_api.cc:561
msgid "No vertex groups assigned to mesh"
msgstr "Inga hörnpunktsgrupper har tilldelats meshen"

#: source/blender/modifiers/intern/MOD_correctivesmooth.cc:627
msgid "Object is not a mesh"
msgstr "Objektet är inte ett mesh"

#: source/blender/modifiers/intern/MOD_skin.cc:2024
msgid ""
"No valid root vertex found (you need one per mesh island you want to skin)"
msgstr ""
"Ingen giltig rothörnpunkt hittades (en behövs per meshö som ska förses med "
"skal)"

#: source/blender/nodes/geometry/nodes/node_geo_curve_to_mesh.cc:27
msgid "Curve to convert to a mesh using the given profile"
msgstr ""
"Kurva som ska konverteras till ett mesh med hjälp av den angivna profilen"
