#. :src: bpy.types.MetaBall
msgid "Metaball data-block to define blobby surfaces"
msgstr "Metabolldatablock för att definiera sammanflytande ytor"

#. :src: bpy.types.MetaBall.elements
msgid "Metaball elements"
msgstr "Metaball-element"

#. :src: bpy.types.MetaBall.render_resolution
#. :src: bpy.types.CompositorNodeScale.space:'RENDER_SIZE'
msgid "Render Size"
msgstr "Renderingens storlek"

#. :src: bpy.types.MetaBall.render_resolution
msgid "Polygonization resolution in rendering"
msgstr "Polygoniseringsupplösning vid rendering"

#. :src: bpy.types.MetaBall.resolution
msgid "Polygonization resolution in the 3D viewport"
msgstr "Polygoniseringsupplösning i 3D-vyn"

#. :src: bpy.types.MetaBall.threshold
msgid "Influence of metaball elements"
msgstr "Påverkan av metaballelement"

#. :src: bpy.types.MetaBall.update_method
msgid "Update"
msgstr "Uppdatera"

#. :src: bpy.types.MetaBall.update_method
msgid "Metaball edit update behavior"
msgstr "Uppdateringsbeteende vid redigering av metabollar"

#. :src: bpy.types.MetaBall.update_method:'UPDATE_ALWAYS'
msgid "While editing, update metaball always"
msgstr "Uppdatera alltid metabollen vid redigering"

#. :src: bpy.types.MetaBall.update_method:'HALFRES'
msgid "While editing, update metaball in half resolution"
msgstr "Uppdatera metabollen med halv upplösning vid redigering"

#. :src: bpy.types.MetaBall.update_method:'FAST'
msgid "While editing, update metaball without polygonization"
msgstr "Uppdatera metabollen utan polygonisering vid redigering"

#. :src: bpy.types.MetaBall.update_method:'NEVER'
msgid "While editing, don't update metaball at all"
msgstr "Uppdatera inte metabollen alls vid redigering"
