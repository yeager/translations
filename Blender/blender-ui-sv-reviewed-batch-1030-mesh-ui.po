#. :src: bpy.types.ToolSettings.statvis
msgid "Mesh Statistics Visualization"
msgstr "Visualisering av meshstatistik"

#. :src: bpy.types.ToolSettings.use_uv_select_sync
msgid "Keep UV and edit mode mesh selection in sync"
msgstr "Håll UV-val och meshval i redigeringsläge synkroniserade"

#. :src: bpy.types.ToolSettings.uv_sticky_select_mode:'SHARED_LOCATION'
msgid "Select UVs that are at the same location and share a mesh vertex"
msgstr "Välj UV:er som finns på samma plats och delar en meshhörnpunkt"

#. :src: bpy.types.ToolSettings.uv_sticky_select_mode:'SHARED_VERTEX'
msgid ""
"Select UVs that share a mesh vertex, whether or not they are at the same "
"location"
msgstr ""
"Välj UV:er som delar en meshhörnpunkt, oavsett om de finns på samma plats "
"eller inte"

#. :src: bpy.types.View3DOverlay.retopology_offset
msgid "Offset used to draw edit mesh in front of other geometry"
msgstr ""
"Förskjutning som används för att rita redigeringsmesh framför annan geometri"

#. :src: bpy.types.View3DOverlay.show_statvis
msgid "Mesh Analysis"
msgstr "Meshanalys"

