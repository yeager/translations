#. :src: bpy.types.FluidDomainSettings.adapt_margin
msgid "Margin added around fluid to minimize boundary interference"
msgstr ""
"Marginal som läggs till runt vätskan för att minska påverkan från gränserna"

#. :src: bpy.types.FluidDomainSettings.adapt_threshold
msgid ""
"Minimum amount of fluid a cell can contain before it is considered empty"
msgstr "Minsta vätskemängd som en cell kan innehålla innan den räknas som tom"

#. :src: bpy.types.FluidDomainSettings.additional_res
msgid "Additional"
msgstr "Ytterligare"

#. :src: bpy.types.FluidDomainSettings.additional_res
msgid "Maximum number of additional cells"
msgstr "Maximalt antal ytterligare celler"

#. :src: bpy.types.FluidDomainSettings.alpha
#: scripts/startup/bl_ui/properties_physics_fluid.py:361
msgid "Buoyancy Density"
msgstr "Flytkraft från densitet"

#. :src: bpy.types.FluidDomainSettings.alpha
msgid ""
"Buoyant force based on smoke density (higher value results in faster rising "
"smoke)"
msgstr ""
"Flytkraft baserad på rökens densitet (högre värde får röken att stiga "
"snabbare)"

#. :src: bpy.types.FluidDomainSettings.beta
msgid "Buoyancy Heat"
msgstr "Flytkraft från värme"

#. :src: bpy.types.FluidDomainSettings.beta
msgid ""
"Buoyant force based on smoke heat (higher value results in faster rising "
"smoke)"
msgstr ""
"Flytkraft baserad på rökens värme (högre värde får röken att stiga snabbare)"

#. :src: bpy.types.FluidDomainSettings.burning_rate
msgid "Speed of the burning reaction (higher value results in smaller flames)"
msgstr "Förbränningsreaktionens hastighet (högre värde ger mindre lågor)"

#. :src: bpy.types.FluidDomainSettings.cache_data_format
msgid "Select the file format to be used for caching volumetric data"
msgstr "Välj filformat för cachelagring av volymdata"

#. :src: bpy.types.FluidDomainSettings.cache_data_format:'UNI'
#. :src: bpy.types.FluidDomainSettings.cache_mesh_format:'UNI'
#. :src: bpy.types.FluidDomainSettings.cache_noise_format:'UNI'
#. :src: bpy.types.FluidDomainSettings.cache_particle_format:'UNI'
#: source/blender/makesrna/intern/rna_fluid.cc:594
#: source/blender/makesrna/intern/rna_fluid.cc:635
msgid "Uni Cache"
msgstr "Uni Cache"

#. :src: bpy.types.FluidDomainSettings.cache_data_format:'OPENVDB'
#. :src: bpy.types.FluidDomainSettings.cache_mesh_format:'OPENVDB'
#. :src: bpy.types.FluidDomainSettings.cache_noise_format:'OPENVDB'
#. :src: bpy.types.FluidDomainSettings.cache_particle_format:'OPENVDB'
#: source/blender/makesrna/intern/rna_fluid.cc:601
msgid "OpenVDB"
msgstr "OpenVDB"

#. :src: bpy.types.FluidDomainSettings.cache_frame_end
msgid "Frame on which the simulation stops (last frame baked)"
msgstr "Bildrutan där simuleringen slutar (sista bakade bildrutan)"

#. :src: bpy.types.FluidDomainSettings.cache_frame_start
msgid "Frame on which the simulation starts (first frame baked)"
msgstr "Bildruta där simuleringen startar (första bakade bildrutan)"

#. :src: bpy.types.FluidDomainSettings.cache_mesh_format
msgid "Select the file format to be used for caching surface data"
msgstr "Välj filformat för cachelagring av ytdata"

#. :src: bpy.types.FluidDomainSettings.cache_noise_format
msgid "Select the file format to be used for caching noise data"
msgstr "Välj filformat för cachelagring av brusdata"

#. :src: bpy.types.FluidDomainSettings.cache_particle_format
msgid "Select the file format to be used for caching particle data"
msgstr "Välj filformat för cachelagring av partikeldata"

#. :src: bpy.types.FluidDomainSettings.cache_resumable
msgid ""
"Additional data will be saved so that the bake jobs can be resumed after "
"pausing. Because more data will be written to disk it is recommended to "
"avoid enabling this option when baking at high resolutions."
msgstr ""
"Ytterligare data sparas så att bakningsjobben kan återupptas efter en paus. "
"Eftersom mer data skrivs till disken rekommenderas att du inte aktiverar "
"alternativet vid bakning i hög upplösning."
