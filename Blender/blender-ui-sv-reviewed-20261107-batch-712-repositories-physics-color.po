msgid "Color ramp used to change line color"
msgstr "Färggradient som används för att ändra linjefärg"

#. :src: bpy.types.LineStyleColorModifier_Material.use_ramp
msgid "Use color ramp to map the BW average into an RGB color"
msgstr "Använd en färggradient för att mappa BW-medelvärdet till en RGB-färg"

#. :src: bpy.types.USERPREF_MT_extensions_active_repo
msgid "Active Repository"
msgstr "Aktivt förråd"

#. :src: bpy.types.CompositorNodeConvertToDisplay
msgid "Convert from scene linear to display color space, with a view transform and look for tone mapping"
msgstr "Konvertera från scenlinjär färgrymd till visningsfärgrymd med visningstransformering och utseende för tonmappning"

#. :src: bpy.types.CompositorNodeConvertToDisplay.view_settings
msgid "Color management view transform settings"
msgstr "Inställningar för färghanteringens visningstransformering"

#. :src: bpy.types.EXTENSIONS_OT_package_install_files
msgid "Install extensions from files into a locally managed repository"
msgstr "Installera tillägg från filer i ett lokalt hanterat förråd"

#. :src: bpy.types.EXTENSIONS_OT_package_upgrade_all.use_active_only
msgid "Only upgrade the active repository"
msgstr "Uppgradera endast det aktiva förrådet"

#. :src: bpy.types.EXTENSIONS_OT_repo_refresh_all.use_active_only
msgid "Only refresh the active repository"
msgstr "Uppdatera endast det aktiva förrådet"

#. :src: bpy.types.EXTENSIONS_OT_repo_sync_all.use_active_only
msgid "Only sync the active repository"
msgstr "Synkronisera endast det aktiva förrådet"

#. :src: bpy.types.PREFERENCES_OT_extension_repo_add
msgid "Add a new repository used to store extensions"
msgstr "Lägg till ett nytt förråd som används för att lagra tillägg"

#. :src: bpy.types.SCREEN_OT_userpref_show.section:'EXTENSIONS'
#. :src: bpy.types.Preferences.active_section:'EXTENSIONS'
msgid "Browse, install and manage extensions from remote and local repositories"
msgstr "Bläddra, installera och hantera tillägg från fjärr- och lokala förråd"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.set_view_transform
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.set_view_transform
msgid "Set appropriate view transform based on media color space"
msgstr "Ställ in lämplig visningstransformering baserat på mediets färgrymd"

