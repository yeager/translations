msgid "Softbody goal weight"
msgstr "Målvikt för mjuk kropp"

#. :src: bpy.types.ClothSettings.shrink_min
msgid "Factor by which to shrink cloth"
msgstr "Faktor för att krympa tyget"

#. :src: bpy.types.ColorManagedInputColorspaceSettings.name:'ACES 1.3 sRGB'
#. :src: bpy.types.ColorManagedSequencerColorspaceSettings.name:'ACES 1.3 sRGB'
#. :src: bpy.types.CompositorNodeConvertColorSpace.from_color_space:'ACES 1.3 sRGB'
#. :src: bpy.types.CompositorNodeConvertColorSpace.to_color_space:'ACES 1.3 sRGB'
msgid "ACES 1.3 view transform for sRGB. May be used to convert backplates or matte paintings to the working space."
msgstr "ACES 1.3-visningstransformering för sRGB. Kan användas för att konvertera bakgrunder eller mattmålningar till arbetsfärgrymden."

#. :src: bpy.types.ColorManagedInputColorspaceSettings.name:'ACES 2.0 sRGB'
