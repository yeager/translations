#. :src: bpy.types.ColorManagedViewSettings.is_hdr
msgid "The display and view transform supports high dynamic range colors"
msgstr "Visningsenheten och visningstransformeringen stöder färger med högt dynamiskt omfång"

#. :src: bpy.types.ColorManagedViewSettings.support_emulation
msgid "The display and view transform supports automatic emulation for another display device, using the display color spaces mechanism in OpenColorIO v2 configurations"
msgstr "Visningsenheten och visningstransformeringen stöder automatisk emulering av en annan visningsenhet med visningsfärgrymder i OpenColorIO v2-konfigurationer"

#. :src: bpy.types.WindowManager.extension_repo_filter
msgid "Filter by Repository"
msgstr "Filtrera efter förråd"

#. :src: bpy.types.WindowManager.extension_repo_filter
msgid "Filter extensions by repository"
msgstr "Filtrera tillägg efter förråd"

#. :src: bpy.types.WindowManager.extension_use_filter
msgid "Filter Extensions by Tags & Repository"
msgstr "Filtrera tillägg efter taggar och förråd"

#. :src: bpy.types.LineStyleColorModifier_AlongStroke.color_ramp
#. :src: bpy.types.LineStyleColorModifier_CreaseAngle.color_ramp
#. :src: bpy.types.LineStyleColorModifier_Curvature_3D.color_ramp
#. :src: bpy.types.LineStyleColorModifier_DistanceFromCamera.color_ramp
#. :src: bpy.types.LineStyleColorModifier_DistanceFromObject.color_ramp
