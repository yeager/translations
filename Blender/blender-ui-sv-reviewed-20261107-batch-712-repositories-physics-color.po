msgstr "AgX-visningstransformering för sRGB. Kan användas för att konvertera bakgrunder eller mattmålningar till arbetsfärgrymden."

#. :src: bpy.types.ColorManagedInputColorspaceSettings.name:'Filmic sRGB'
#. :src: bpy.types.ColorManagedSequencerColorspaceSettings.name:'Filmic sRGB'
#. :src: bpy.types.CompositorNodeConvertColorSpace.from_color_space:'Filmic sRGB'
#. :src: bpy.types.CompositorNodeConvertColorSpace.to_color_space:'Filmic sRGB'
msgid "Filmic view transform for sRGB. May be used to convert backplates or matte paintings to the working space."
msgstr "Filmic-visningstransformering för sRGB. Kan användas för att konvertera bakgrunder eller mattmålningar till arbetsfärgrymden."

#. :src: bpy.types.ColorManagedInputColorspaceSettings.name:'Khronos PBR Neutral sRGB'
#. :src: bpy.types.ColorManagedSequencerColorspaceSettings.name:'Khronos PBR Neutral sRGB'
#. :src: bpy.types.CompositorNodeConvertColorSpace.from_color_space:'Khronos PBR Neutral sRGB'
