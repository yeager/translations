#: ../../manual/editors/preferences/interface.rst:125
msgid "Color Picker Type"
msgstr "Typ av färgväljare"

#: ../../manual/editors/preferences/interface.rst:126
msgid "Choose which type of :term:`Color Space` you prefer for the :doc:`Color picker </interface/controls/templates/color_picker>`. It will show when clicking :kbd:`LMB` on any color field."
msgstr "Välj vilken :term:`färgrymd` du föredrar för :doc:`färgväljaren </interface/controls/templates/color_picker>`. Den visas när du klickar med :kbd:`LMB` på ett färgfält."

#: ../../manual/editors/preferences/interface.rst:130
msgid "Color Picker types."
msgstr "Typer av färgväljare."

#: ../../manual/editors/preferences/interface.rst:134
msgid "Circle HSV."
msgstr "Cirkel (HSV)."

#: ../../manual/editors/preferences/interface.rst:138
msgid "Circle HSL."
msgstr "Cirkel (HSL)."

#: ../../manual/editors/preferences/interface.rst:144
msgid "Square (SV + H)."
msgstr "Kvadrat (SV + H)."

#: ../../manual/editors/preferences/interface.rst:148
msgid "Square (HS + V)."
msgstr "Kvadrat (HS + V)."

#: ../../manual/editors/preferences/interface.rst:152
msgid "Square (HV + S)."
msgstr "Kvadrat (HV + S)."

#: ../../manual/editors/preferences/interface.rst:156
msgid "Header Position"
msgstr "Sidhuvudets position"

#: ../../manual/editors/preferences/interface.rst:157
msgid "The default header position when opening a new editor."
msgstr "Standardpositionen för sidhuvudet när en ny redigerare öppnas."

#: ../../manual/editors/preferences/interface.rst
msgid "Keep Existing"
msgstr "Behåll befintlig"

#: ../../manual/editors/preferences/interface.rst:160
msgid "Uses top for most editor types and the positions saved in the start-up file."
msgstr "Använder överkant för de flesta redigerartyper och de positioner som sparats i startfilen."

#: ../../manual/editors/preferences/interface.rst
msgid "Top/Bottom"
msgstr "Överst/nederst"

#: ../../manual/editors/preferences/interface.rst:162
msgid "Always positions the header at the top or the bottom of the editor."
msgstr "Placerar alltid sidhuvudet överst eller nederst i redigeraren."

#: ../../manual/editors/preferences/interface.rst:166
msgid "Factor Display Type"
msgstr "Visningstyp för faktor"

#: ../../manual/editors/preferences/interface.rst:167
msgid "How factor value types are displayed in the user interface."
msgstr "Hur faktorvärden visas i användargränssnittet."

#: ../../manual/editors/preferences/interface.rst:169
msgid "Values are displayed as float numbers between 0.0 and 1.0."
msgstr "Värdena visas som flyttal mellan 0,0 och 1,0."

#: ../../manual/editors/preferences/interface.rst
msgid "Percentage"
msgstr "Procent"

#: ../../manual/editors/preferences/interface.rst:170
msgid "Values are expressed as a percentage between 0 and 100."
msgstr "Värdena uttrycks som procent mellan 0 och 100."
