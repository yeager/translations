#. :src: bpy.types.ID.override_library
#. :src: bpy.types.Menu
#. :src: bpy.types.OUTLINER_MT_liboverride
#. :src: bpy.types.VIEW3D_MT_object_liboverride
msgid "Library Override"
msgstr "Biblioteksåsidosättning"

#. :src: bpy.types.BlendImportContextItem.library_override_id
msgid "The library override of the linked ID. None until it has been created"
msgstr "Biblioteksåsidosättningen för det länkade ID:t. Den saknas tills den har skapats"

#. :src: bpy.types.IDOverrideLibrary.is_in_hierarchy
msgid "Whether this library override is defined as part of a library hierarchy, or as a single, isolated and autonomous override"
msgstr "Anger om denna biblioteksåsidosättning ingår i en bibliotekshierarki eller är en enskild, isolerad och autonom åsidosättning"

#. :src: bpy.types.IDOverrideLibrary.is_system_override
msgid "Whether this library override exists only for the override hierarchy, or if it is actually editable by the user"
msgstr "Anger om denna biblioteksåsidosättning endast finns för åsidosättningshierarkin eller om användaren faktiskt kan redigera den"
