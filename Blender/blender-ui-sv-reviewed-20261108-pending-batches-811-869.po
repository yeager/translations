#: source/blender/blenkernel/intern/data_transfer.cc:1516
msgid ""
"Source and destination meshes do not have the same number of vertices, "
"'Topology' mapping cannot be used in this case"
msgstr ""
"Käll- och målmesh har inte samma antal hörnpunkter; topologikartläggning kan "
"därför inte användas i detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1523
#: source/blender/blenkernel/intern/data_transfer.cc:1680
#: source/blender/blenkernel/intern/data_transfer.cc:1758
msgid ""
"Source mesh does not have any edges, none of the 'Edge' mappings can be used "
"in this case"
msgstr ""
"Källmeshen saknar kanter; ingen av ”Edge”-mappningarna kan därför användas i "
"detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1530
#: source/blender/blenkernel/intern/data_transfer.cc:1603
msgid ""
"Source mesh does not have any faces, none of the 'Face' mappings can be used "
"in this case"
msgstr ""
"Källmeshen saknar ytor; ingen av ”Face”-mappningarna kan därför användas i "
"detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1537
msgid ""
"Source or destination meshes do not have any vertices, cannot transfer "
"vertex data"
msgstr ""
"Käll- eller målmeshen saknar hörnpunkter och kan inte överföra hörnpunktsdata"

#: source/blender/blenkernel/intern/data_transfer.cc:1596
msgid ""
"Source and destination meshes do not have the same number of edges, "
"'Topology' mapping cannot be used in this case"
msgstr ""
"Käll- och målmesh har inte samma antal kanter, därför kan inte "
"topologikartläggning användas i detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1610
msgid ""
"Source or destination meshes do not have any edges, cannot transfer edge data"
msgstr "Käll- eller målmeshen saknar kanter och kan inte överföra kantdata"

#: source/blender/blenkernel/intern/data_transfer.cc:1673
msgid ""
"Source and destination meshes do not have the same number of face corners, "
"'Topology' mapping cannot be used in this case"
msgstr ""
"Käll- och målmesh har inte samma antal ythörn; topologikartläggning kan "
"därför inte användas i detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1687
msgid ""
"Source or destination meshes do not have any faces, cannot transfer corner "
"data"
msgstr "Käll- eller målmeshen saknar ytor och kan inte överföra hörndata"

#: source/blender/blenkernel/intern/data_transfer.cc:1751
msgid ""
"Source and destination meshes do not have the same number of faces, "
"'Topology' mapping cannot be used in this case"
msgstr ""
"Käll- och målmesh har inte samma antal ytor; topologikartläggning kan därför "
"inte användas i detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1765
msgid ""
"Source or destination meshes do not have any faces, cannot transfer face data"
msgstr "Käll- eller målmeshen saknar ytor och kan inte överföra ytdata"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh
msgid ""
"Create a new quad based mesh using the surface data of the current mesh. All "
"data layers will be lost"
msgstr ""
"Skapa en ny fyrhörningsbaserad mesh med ytdata från den aktuella meshen. "
"Alla datalager går förlorade"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode
msgid "How to specify the amount of detail for the new mesh"
msgstr "Hur detaljnivån för den nya meshen ska anges"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'RATIO'
msgid "Specify target number of faces relative to the current mesh"
msgstr "Ange målantalet ytor i förhållande till den aktuella meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'EDGE'
msgid "Input target edge length in the new mesh"
msgstr "Ange målkantlängd i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'FACES'
msgid "Input target number of faces in the new mesh"
msgstr "Ange målantalet ytor i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.preserve_attributes
msgid "Reproject attributes onto the new mesh"
msgstr "Reprojektera attribut på den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.smooth_normals
msgid "Set the output mesh normals to smooth"
msgstr "Ange att normalerna för utdata-meshen ska vara jämna"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_edge_length
msgid "Target edge length in the new mesh"
msgstr "Målkantlängd i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_faces
msgid "Approximate number of faces (quads) in the new mesh"
msgstr "Ungefärligt antal ytor (fyrkanter) i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_ratio
msgid "Relative number of faces compared to the current mesh"
msgstr "Relativt antal ytor jämfört med den aktuella meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_mesh_symmetry
msgid "Generates a symmetrical mesh using the mesh symmetry configuration"
msgstr "Genererar en symmetrisk mesh med meshens symmetrikonfiguration"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_boundary
msgid "Try to preserve mesh boundary on the mesh"
msgstr "Försök bevara meshgränsen på meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_sharp
msgid "Try to preserve sharp features on the mesh"
msgstr "Försök att bevara skarpa detaljer på meshen"

#. :src: bpy.types.OBJECT_OT_surfacedeform_bind
msgid "Bind mesh to target in surface deform modifier"
msgstr "Bind meshen till målet i ytdeformeringsmodifieraren"

#. :src: bpy.types.OBJECT_OT_voxel_remesh
msgid ""
"Calculates a new manifold mesh based on the volume of the current mesh. All "
"data layers will be lost"
msgstr ""
"Beräknar ett nytt manifold-mesh utifrån volymen av den aktuella meshen. Alla "
"datalager går förlorade"

#: scripts/startup/bl_operators/object.py:523
msgid "Expected one other selected mesh object to copy from"
msgstr "Förväntade ett annat markerat meshobjekt att kopiera från"

#: scripts/startup/bl_operators/object.py:529
msgid "Both objects must be meshes"
msgstr "Båda objekten måste vara meshobjekt"

#: scripts/startup/bl_operators/object_quick_effects.py:99
#: scripts/startup/bl_operators/object_quick_effects.py:461
#: scripts/startup/bl_operators/object_quick_effects.py:563
#: scripts/startup/bl_operators/object_quick_effects.py:293
msgid "Select at least one mesh object"
msgstr "Välj minst ett meshobjekt"

#: scripts/startup/bl_operators/object_quick_effects.py:279
#: source/blender/editors/mesh/mesh_join.cc:535
msgid "Active object is not a mesh"
msgstr "Det aktiva objektet är inte ett meshobjekt"

#: scripts/startup/bl_operators/object_quick_effects.py:289
msgid "Select two mesh objects"
msgstr "Välj två meshobjekt"

#: scripts/startup/bl_operators/uvcalc_lightmap.py:576
msgid "No mesh object"
msgstr "Inget meshobjekt"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:619
msgid "Add cube to mesh interactively"
msgstr "Lägg interaktivt till en kub i meshen"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:647
msgid "Add cone to mesh interactively"
msgstr "Lägg interaktivt till en kon i meshen"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:675
msgid "Add cylinder to mesh interactively"
msgstr "Lägg interaktivt till en cylinder i meshen"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:703
#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:731
#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:758
msgid "Add sphere to mesh interactively"
msgstr "Lägg interaktivt till en sfär i meshen"

#: source/blender/blenkernel/intern/dynamicpaint.cc:2856
msgid "Canvas mesh not updated"
msgstr "Dukmeshen uppdaterades inte"

#: source/blender/blenkernel/intern/rigidbody.cc:1485
msgid "Cannot add Rigid Body to non mesh object"
msgstr ""
"Det går inte att lägga till Rigid Body till ett objekt som inte är ett "
"meshobjekt"

#: source/blender/editors/curves/intern/curves_ops.cc:138
msgid "Curves must have a mesh surface object set"
msgstr "Kurvor måste ha ett meshobjekt inställt som yta"

#: source/blender/editors/mesh/editmesh_select.cc:89
msgid "An edit-mesh with vertex or edge selection mode is required"
msgstr "En redigeringsmesh med val av hörnpunkt eller kant krävs"

#: source/blender/editors/mesh/editmesh_tools.cc:8572
msgid "Select and use mesh item"
msgstr "Välj och använd meshelement"

#. :src: bpy.types.SCULPT_OT_cloth_filter
msgid "Applies a cloth simulation deformation to the entire mesh"
msgstr "Tillämpa en tygsimuleringsdeformering på hela meshen"

#. :src: bpy.types.SCULPT_OT_cloth_filter.type
#. :src: bpy.types.SCULPT_OT_mesh_filter.type
msgid "Operation that is going to be applied to the mesh"
msgstr "Åtgärd som ska tillämpas på meshen"

#. :src: bpy.types.SCULPT_OT_cloth_filter.type:'SCALE'
msgid "Scales the mesh as a soft body using the origin of the object as scale"
msgstr ""
"Skalerar meshen som en mjuk kropp med hjälp av objektets ursprung som skala"

#. :src: bpy.types.SCULPT_OT_detail_flood_fill
msgid "Flood fill the mesh with the selected detail setting"
msgstr "Fyll meshen med den valda detaljinställningen"

#. :src: bpy.types.SCULPT_OT_dynamic_topology_toggle
msgid "Dynamic topology alters the mesh topology while sculpting"
msgstr "Dynamisk topologi ändrar meshtopologin under skulpteringen"

#. :src: bpy.types.SCULPT_OT_expand.max_geodesic_move_preview
msgid ""
"Maximum number of vertices in the mesh for using geodesic falloff when "
"moving the origin of expand. If the total number of vertices is greater than "
"this value, the falloff will be set to spherical when moving"
msgstr ""
"Maximalt antal hörnpunkter i meshen för att använda geodetisk avklingning "
"när utökningens ursprung flyttas. Om det totala antalet hörnpunkter är "
"större än detta värde blir avklingningen sfärisk vid flyttning"

#. :src: bpy.types.SCULPT_OT_face_set_edit.mode:'GROW'
msgid "Grows the face set boundary by one face based on mesh topology"
msgstr "Utökar ytuppsättningsgränsen med en yta utifrån meshtopologin"

#. :src: bpy.types.SCULPT_OT_face_set_edit.mode:'SHRINK'
msgid "Shrinks the face set boundary by one face based on mesh topology"
msgstr "Minskar ytuppsättningsgränsen med en yta utifrån meshtopologin"

#. :src: bpy.types.SCULPT_OT_face_set_extract
msgid "Create a new mesh object from the selected face set"
msgstr "Skapa ett nytt meshobjekt från den valda ytuppsättningen"

#. :src: bpy.types.SCULPT_OT_face_set_extract.apply_shrinkwrap
#. :src: bpy.types.SCULPT_OT_paint_mask_extract.apply_shrinkwrap
msgid "Project the extracted mesh into the original sculpt"
msgstr "Projicera den extraherade meshen på den ursprungliga skulpturen"

#. :src: bpy.types.SCULPT_OT_face_set_extract.smooth_iterations
#. :src: bpy.types.SCULPT_OT_paint_mask_extract.smooth_iterations
msgid "Smooth iterations applied to the extracted mesh"
msgstr "Utjämningsiterationer som tillämpas på den extraherade meshen"

#. :src: bpy.types.SCULPT_OT_face_sets_init
msgid "Initializes all face sets in the mesh"
msgstr "Initierar alla ytuppsättningar i meshen"

#. :src: bpy.types.SCULPT_OT_face_sets_init.mode:'LOOSE_PARTS'
msgid "Create a face set per loose part in the mesh"
msgstr "Skapa en ytuppsättning per lös del i meshen"

#. :src: bpy.types.SCULPT_OT_mask_from_boundary.boundary_mode:'MESH'
msgid "Calculate the boundary mask based on disconnected mesh topology islands"
msgstr "Beräkna gränsmasken baserat på frånkopplade meshöar"

#. :src: bpy.types.SCULPT_OT_mask_init
msgid "Creates a new mask for the entire mesh"
msgstr "Skapar en ny mask för hela meshen"

#. :src: bpy.types.SCULPT_OT_mesh_filter
msgid "Applies a filter to modify the current mesh"
msgstr "Tillämpar ett filter för att ändra den aktuella meshen"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'SMOOTH'
msgid "Smooth mesh"
msgstr "Jämna ut mesh"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'SCALE'
msgid "Scale mesh"
msgstr "Skala mesh"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'INFLATE'
msgid "Inflate mesh"
msgstr "Blås upp mesh"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'RELAX'
msgid "Relax mesh"
msgstr "Relaxa mesh"

#. :src: bpy.types.MESH_OT_customdata_face_sets_clear
msgid "Clear sculpt face set data from the mesh"
msgstr "Rensa data för skulpteringsytuppsättning från meshen"

#. :src: bpy.types.MESH_OT_customdata_mask_clear
msgid "Clear vertex sculpt masking data from the mesh"
msgstr "Rensa data för skulpteringsmaskering av hörnpunkter från meshen"

#. :src: bpy.types.MESH_OT_delete.type
msgid "Method used for deleting mesh data"
msgstr "Metod som används för att radera meshdata"

#. :src: bpy.types.MESH_OT_duplicate_move
msgid "Duplicate mesh and move"
msgstr "Duplicera mesh och flytta"

#. :src: bpy.types.MESH_OT_loopcut_slide
msgid "Cut mesh loop and slide it"
msgstr "Skär meshslingan och skjut den"

#. :src: bpy.types.MESH_OT_loopcut_slide.TRANSFORM_OT_edge_slide
#. :src: bpy.types.MESH_OT_offset_edge_loops_slide.TRANSFORM_OT_edge_slide
#. :src: bpy.types.TRANSFORM_OT_edge_slide
msgid "Slide an edge loop along a mesh"
msgstr "Skjut en kantslinga längs meshen"

#. :src: bpy.types.MESH_OT_normals_make_consistent
msgid "Make face and vertex normals point either outside or inside the mesh"
msgstr ""
"Gör så att yt- och hörnpunktsnormaler pekar antingen utåt eller inåt i meshen"

#. :src: bpy.types.MESH_OT_primitive_circle_add
msgid "Construct a circle mesh"
msgstr "Konstruera ett cirkelmesh"

#. :src: bpy.types.MESH_OT_primitive_cone_add
msgid "Construct a conic mesh"
msgstr "Konstruera ett konmesh"

#. :src: bpy.types.MESH_OT_primitive_cube_add
msgid "Construct a cube mesh that consists of six square faces"
msgstr "Konstruera ett kubmesh som består av sex kvadratiska ytor"

#. :src: bpy.types.MESH_OT_primitive_cube_add_gizmo
msgid "Construct a cube mesh"
msgstr "Konstruera ett kubmesh"

#. :src: bpy.types.MESH_OT_primitive_cylinder_add
msgid "Construct a cylinder mesh"
msgstr "Konstruera ett cylindermesh"

#. :src: bpy.types.MESH_OT_primitive_grid_add
msgid "Construct a subdivided plane mesh"
msgstr "Konstruera ett underindelat meshplan"

#. :src: bpy.types.MESH_OT_primitive_ico_sphere_add
msgid "Construct a spherical mesh that consists of equally sized triangles"
msgstr "Konstruera ett sfäriskt mesh som består av trianglar av samma storlek"

#. :src: bpy.types.MESH_OT_primitive_monkey_add
msgid "Construct a Suzanne mesh"
msgstr "Konstruera ett Suzanne-mesh"

#. :src: bpy.types.MESH_OT_primitive_plane_add
msgid "Construct a filled planar mesh with 4 vertices"
msgstr "Konstruera ett fyllt meshplan med fyra hörnpunkter"

#. :src: bpy.types.MESH_OT_primitive_quad_sphere_add
msgid ""
"Construct a spherical mesh from a subdivided cube, consisting entirely of "
"four-sided faces"
msgstr ""
"Skapa ett sfäriskt mesh från en underindelad kub som helt består av "
"fyrsidiga ytor"

#. :src: bpy.types.MESH_OT_primitive_uv_sphere_add
msgid ""
"Construct a spherical mesh with quad faces, except for triangle faces at the "
"top and bottom"
msgstr ""
"Konstruera ett sfäriskt mesh med fyrkantiga ytor, förutom triangulära ytor "
"längst upp och längst ner"

#. :src: bpy.types.MESH_OT_reorder_vertices_spatial
msgid ""
"Reorder mesh faces and vertices based on their spatial position for better "
"BVH building and sculpting performance."
msgstr ""
"Ordna om meshytor och hörnpunkter utifrån deras rumsliga position för bättre "
"BVH-byggande och skulpteringsprestanda."

#. :src: bpy.types.MESH_OT_select_axis
msgid "Select all data in the mesh on a single axis"
msgstr "Markera alla data i meshen på en enda axel"

#. :src: bpy.types.MESH_OT_select_mirror
msgid "Select mesh items at mirrored locations"
msgstr "Markera meshelement på speglade platser"

#. :src: bpy.types.MESH_OT_separate
msgid "Separate selected geometry into a new mesh"
msgstr "Separera vald geometri till en ny mesh"

#. :src: bpy.types.MESH_OT_vertices_smooth.repeat
msgid "Number of times to smooth the mesh"
msgstr "Antal gånger meshen ska jämnas ut"

#. :src: bpy.types.MESH_OT_vertices_smooth_laplacian.repeat
msgid "Number of iterations to smooth the mesh"
msgstr "Antal iterationer för att jämna ut meshen"

#. :src: bpy.types.MESH_OT_bevel.vmesh_method
msgid "The method to use to create meshes at intersections"
msgstr "Metod för att skapa mesh vid skärningspunkter"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.seed
msgid ""
"Random seed to use with the solver. Different seeds will cause the remesher "
"to come up with different quad layouts on the mesh"
msgstr ""
"Slumpfrö att använda med lösaren. Olika frön får ommeshningsverktyget att "
"skapa olika fyrhörningslayouter i meshen"

#. :src: bpy.types.UV_OT_project_from_view
msgid "Project the UV vertices of the mesh as seen in current 3D view"
msgstr "Projicera UV-hörnpunkterna i meshen som de visas i den aktuella 3D-vyn"

#. :src: bpy.types.UV_OT_sphere_project
msgid "Project the UV vertices of the mesh over the curved surface of a sphere"
msgstr "Projicera UV-hörnpunkterna i meshen över den böjda ytan på en sfär"

#. :src: bpy.types.WM_OT_usd_export.export_armatures
msgid ""
"Export armatures and meshes with armature modifiers as USD skeletons and "
"skinned meshes"
msgstr ""
"Exportera armaturer och mesh med armaturmodifierare som USD-skelett och "
"skinnade mesh"

#. :src: bpy.types.WM_OT_usd_export.export_subdivision:'BEST_MATCH'
msgid ""
"Scheme = Catmull-Clark, when possible. Reverts to exporting the subdivided "
"mesh for the Simple subdivision type"
msgstr ""
"Schema = Catmull-Clark när det är möjligt. Återgå till export av den "
"underindelade meshen för underindelningstypen Simple"

#. :src: bpy.types.WM_OT_usd_export.export_uvmaps
msgid "Include all mesh UV maps in the export"
msgstr "Inkludera alla UV-kartor för mesh i exporten"

#. :src: bpy.types.WM_OT_usd_export.triangulate_meshes
msgid "Triangulate meshes during export"
msgstr "Triangulera mesh under export"

#. :src: bpy.types.Paint.use_cavity
msgid "Mask painting according to mesh geometry cavity"
msgstr "Maskmålning utifrån håligheter i meshgeometrin"

#. :src: bpy.types.Sculpt.detail_refine_method:'SUBDIVIDE'
msgid "Subdivide long edges to add mesh detail where needed"
msgstr "Dela upp långa kanter för att lägga till meshdetaljer där det behövs"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'FRONT'
msgid ""
"Treat only front side of the surface as a light, usually for closed meshes "
"whose interior is not visible"
msgstr ""
"Behandla bara ytans framsida som en ljuskälla, vanligtvis för slutna mesh "
"vars insida inte är synlig"

#. :src: bpy.types.RigidBodyObject.mesh_source
msgid "Source of the mesh used to create collision shape"
msgstr "Källa till meshen som används för att skapa kollisionsformen"

#. :src: bpy.types.ToolSettings.mesh_select_mode
msgid "Which mesh elements selection works on"
msgstr "Vilka meshelement urvalet fungerar på"

#. :src: bpy.types.ToolSettings.uv_sticky_select_mode:'SHARED_LOCATION'
msgid "Select UVs that are at the same location and share a mesh vertex"
msgstr "Välj UV:er som finns på samma plats och delar en mesh-hörnpunkt"

#. :src: bpy.types.ToolSettings.uv_sticky_select_mode:'SHARED_VERTEX'
msgid ""
"Select UVs that share a mesh vertex, whether or not they are at the same "
"location"
msgstr ""
"Välj UV:er som delar en mesh-hörnpunkt, oavsett om de finns på samma plats "
"eller inte"

#. :src: bpy.types.View3DOverlay.retopology_offset
msgid "Offset used to draw edit mesh in front of other geometry"
msgstr ""
"Förskjutning som används för att rita redigeringsmesh framför annan geometri"

#. :src: bpy.types.View3DOverlay.show_retopology
msgid ""
"Hide the solid mesh and offset the overlay towards the view. Selection is "
"occluded by inactive geometry, unless X-Ray is enabled"
msgstr ""
"Dölj den solida meshen och förskjut överlägget mot vyn. Urvalet skymmer "
"inaktiv geometri om inte röntgen är aktiverad"

#. :src: bpy.types.View3DOverlay.show_statvis
msgid "Display statistical information about the mesh"
msgstr "Visa statistisk information om meshen"

#. :src: KM_HIERARCHY.VIEW_3D.EMPTY:'SET_USE_SELECTED'
msgid "Select new active mesh element and use its location"
msgstr "Välj ett nytt aktivt meshelement och använd dess placering"

#: source/blender/editors/mesh/editmesh_loopcut.cc:397
msgid "Loop cut does not work well on deformed edit mesh display"
msgstr ""
"Kantslingeskärning fungerar inte bra på deformerad redigeringsmeshvisning"

#: source/blender/editors/mesh/meshtools.cc:144
msgid "No additional selected meshes with equal vertex count to join"
msgstr "Inga ytterligare valda mesh med samma antal hörnpunkter att sammanfoga"

#: source/blender/editors/object/object_bake_api.cc:462
msgid "Object \"%s\" is not a mesh"
msgstr "Objektet ”%s” är inte ett mesh"

#: source/blender/editors/object/object_bake_api.cc:650
msgid ""
"Object \"%s\" is not a mesh or cannot be converted to a mesh (Curve, Text, "
"Surface or Metaball)"
msgstr ""
"Objektet ”%s” är inte ett mesh eller kan inte konverteras till ett mesh "
"(kurva, text, yta eller metaboll)"

#: source/blender/editors/object/object_modifier.cc:1067
msgid "Modifier cannot be applied to a mesh with shape keys"
msgstr "Modifieraren kan inte tillämpas på ett mesh med formnycklar"

#: source/blender/editors/object/object_remesh.cc:134
msgid "Voxel remesher failed to create mesh"
msgstr "Voxelommesharen kunde inte skapa mesh"

#: source/blender/editors/object/object_vgroup.cc:3471
msgid "No meshes with vertex groups found"
msgstr "Inga mesh med hörnpunktsgrupper hittades"

#: source/blender/editors/sculpt_paint/curves/sculpt_brush.cc:405
msgid "Original surface mesh is empty"
msgstr "Originalytans mesh är tom"

#: source/blender/editors/sculpt_paint/mesh/sculpt_trim.cc:624
msgid "Solver requires a manifold mesh"
msgstr "Lösaren kräver ett manifold-mesh"

#: source/blender/editors/uvedit/uvedit_unwrap_ops.cc:2887
msgid ""
"Object has non-uniform scale, unwrap will operate on a non-scaled version of "
"the mesh"
msgstr ""
"Objektet har icke-enhetlig skala; uppackning fungerar på en oskalad version "
"av meshen"

#: source/blender/editors/uvedit/uvedit_unwrap_ops.cc:2896
msgid ""
"Object has negative scale, unwrap will operate on a non-flipped version of "
"the mesh"
msgstr ""
"Objektet har negativ skala; uppackning fungerar på en ovänd version av meshen"

#: source/blender/geometry/intern/realize_instances.cc:2021
msgid "Realized mesh has too many elements."
msgstr "Den realiserade meshen har för många element."

#: source/blender/io/alembic/intern/abc_reader_mesh.cc:568
msgid "Invalid mesh; more detail on the console"
msgstr "Ogiltig mesh; mer information finns i konsolen"

#: source/blender/io/alembic/intern/abc_reader_mesh.cc:599
msgid ""
"Topology has changed, perhaps by triangulating the mesh. Only vertices will "
"be read!"
msgstr ""
"Topologin har ändrats, kanske genom triangulering av meshen. Endast "
"hörnpunkter kommer att läsas!"

#: source/blender/io/usd/intern/usd_reader_mesh.cc:1024
msgid "Fixed mesh for prim: %s"
msgstr "Korrigerad mesh för prim: %s"

#: source/blender/io/usd/intern/usd_writer_mesh.cc:491
msgid "USD export: Simple subdivision not supported, exporting subdivided mesh"
msgstr ""
"USD-export: Enkel underindelning stöds inte; exporterar underindelad mesh"

#: source/blender/makesrna/intern/rna_object_api.cc:554
msgid "Object should be of mesh type"
msgstr "Objektet ska ha meshtyp"

#: source/blender/makesrna/intern/rna_object_api.cc:561
msgid "No vertex groups assigned to mesh"
msgstr "Inga hörnpunktsgrupper har tilldelats meshen"

#: source/blender/modifiers/intern/MOD_correctivesmooth.cc:627
msgid "Object is not a mesh"
msgstr "Objektet är inte ett mesh"

#: source/blender/modifiers/intern/MOD_skin.cc:2024
msgid ""
"No valid root vertex found (you need one per mesh island you want to skin)"
msgstr ""
"Ingen giltig rothörnpunkt hittades (en behövs per meshö som ska förses med "
"skal)"

#: source/blender/nodes/geometry/nodes/node_geo_curve_to_mesh.cc:27
msgid "Curve to convert to a mesh using the given profile"
msgstr ""
"Kurva som ska konverteras till ett mesh med hjälp av den angivna profilen"

#. :src: bpy.types.BakeSettings.use_lores_mesh
msgid "Calculate heights against unsubdivided low resolution mesh"
msgstr "Beräkna höjder mot ett lågupplöst mesh utan underindelning"

#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND_REUSE'
msgid ""
"Import the asset as copied data-block while avoiding multiple copies of "
"nested, typically heavy data. For example the textures of a material asset, "
"or the mesh of an object asset, don't have to be copied every time this "
"asset is imported. The instances of the asset share the data instead"
msgstr ""
"Importera tillgången som ett kopierat datablock men undvik flera kopior av "
"nästlade, vanligtvis tunga data. Texturer i en materialtillgång eller meshen "
"i en objekttillgång behöver exempelvis inte kopieras vid varje import. "
"Tillgångsinstanserna delar i stället data"

#. :src: bpy.types.FluidFlowSettings.surface_distance
msgid ""
"Height (in domain grid units) of fluid emission above the mesh surface. "
"Higher values result in emission further away from the mesh surface. If this "
"value and the emitter size are smaller than the domain grid unit, fluid will "
"not be created"
msgstr ""
"Höjd, i domänrutnätsenheter, för vätskeemission ovanför meshytan. Högre "
"värden ger emission längre från meshytan. Om värdet och emitterarens storlek "
"är mindre än domänrutnätsenheten skapas ingen vätska"

#. :src: bpy.types.Mesh.has_custom_normals
msgid "True if there is custom normal data for this mesh"
msgstr "Sant om denna mesh har anpassade normaldata"

#. :src: bpy.types.Mesh.texture_mesh
msgid "Use another mesh for texture indices (vertex indices must be aligned)"
msgstr ""
"Använd en annan mesh för texturindex (hörnpunktsindex måste vara justerade)"

#. :src: bpy.types.LineStyleColorModifier_Curvature_3D
msgid "Change line color based on the radial curvature of 3D mesh surfaces"
msgstr "Ändra linjefärg baserat på den radiella krökningen hos 3D-meshytor"

#. :src: bpy.types.MeshAutomaskingSettings
msgid "Automasking settings for mesh painting & sculpting."
msgstr "Inställningar för automatisk maskning vid meshmålning och skulptering."

#. :src: bpy.types.MeshLoopTriangle.polygon_index
msgid "Index of mesh face that the triangle is a part of"
msgstr "Index för meshytan som triangeln är en del av"

#. :src: bpy.types.MeshSkinVertex.use_root
msgid ""
"Vertex is a root for rotation calculations and armature generation, setting "
"this flag does not clear other roots in the same mesh island"
msgstr ""
"Hörnpunkten är en rot för rotationsberäkningar och armaturgenerering. Om "
"denna flagga anges rensas inte andra rötter på samma meshö"

#. :src: bpy.types.Modifier.type:'MESH_SEQUENCE_CACHE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_SEQUENCE_CACHE'
msgid "Deform the mesh or curve using an external mesh cache in Alembic format"
msgstr ""
"Deformera meshen eller kurvan med hjälp av en extern meshcache i Alembic-"
"format"

#. :src: bpy.types.Modifier.type:'BEVEL'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BEVEL'
msgid ""
"Generate sloped corners by adding geometry to the mesh's edges or vertices"
msgstr ""
"Skapa avfasade hörn genom att lägga till geometri till meshens kanter eller "
"hörnpunkter"

#. :src: bpy.types.Modifier.type:'BUILD'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BUILD'
msgid ""
"Cause the faces of the mesh object to appear or disappear one after the "
"other over time"
msgstr ""
"Få ytorna på nätobjektet att visas eller försvinna en efter en över tid"

#. :src: bpy.types.Modifier.type:'MULTIRES'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MULTIRES'
msgid ""
"Subdivide the mesh in a way that allows editing the higher subdivision levels"
msgstr ""
"Dela upp meshen på ett sätt som gör det möjligt att redigera de högre "
"indelningsnivåerna"

#. :src: bpy.types.Modifier.type:'REMESH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'REMESH'
msgid "Generate new mesh topology based on the current shape"
msgstr "Skapa ny meshtopologi baserad på den aktuella formen"

#. :src: bpy.types.Modifier.type:'SCREW'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SCREW'
msgid "Lathe around an axis, treating the input mesh as a profile"
msgstr "Svarva runt en axel och behandla ingångsmeshen som en profil"

#. :src: bpy.types.Modifier.type:'MESH_DEFORM'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_DEFORM'
msgid "Deform using a different mesh, which acts as a deformation cage"
msgstr ""
"Deformera med hjälp av en annan mesh, som fungerar som en deformationsbur"

#. :src: bpy.types.Modifier.type:'SMOOTH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SMOOTH'
msgid "Smooth the mesh by flattening the angles between adjacent faces"
msgstr ""
"Jämna ut meshen genom att platta till vinklarna mellan intilliggande ytor"

#. :src: bpy.types.Modifier.type:'CORRECTIVE_SMOOTH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'CORRECTIVE_SMOOTH'
msgid "Smooth the mesh while still preserving the volume"
msgstr "Jämna ut meshen samtidigt som volymen bevaras"

#. :src: bpy.types.Modifier.type:'LAPLACIANSMOOTH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'LAPLACIANSMOOTH'
msgid "Reduce the noise on a mesh surface with minimal changes to its shape"
msgstr "Minska bruset på en meshyta med minimala förändringar av dess form"

#. :src: bpy.types.Modifier.type:'SURFACE_DEFORM'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SURFACE_DEFORM'
msgid "Transfer motion from another mesh"
msgstr "Överför rörelse från en annan mesh"

#. :src: bpy.types.Modifier.type:'WARP'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'WARP'
msgid ""
"Warp parts of a mesh to a new location in a very flexible way thanks to 2 "
"specified objects"
msgstr ""
"Förvräng delar av en mesh till en ny plats på ett mycket flexibelt sätt med "
"hjälp av två angivna objekt"

#. :src: bpy.types.Modifier.type:'EXPLODE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'EXPLODE'
msgid "Break apart the mesh faces and let them follow particles"
msgstr "Dela upp meshytorna och låt dem följa partiklarna"

#. :src: bpy.types.Modifier.type:'PARTICLE_INSTANCE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'PARTICLE_INSTANCE'
msgid "Duplicate mesh at the location of particles"
msgstr "Duplicera mesh på partiklarnas position"

#. :src: bpy.types.BevelModifier.vmesh_method
msgid "The method to use to create the mesh at intersections"
msgstr "Metoden som ska användas för att skapa meshen vid korsningar"

#. :src: bpy.types.BooleanModifier.collection
msgid "Use mesh objects in this collection for Boolean operation"
msgstr "Använd meshobjekt i denna samling för boolesk operation"

#. :src: bpy.types.BooleanModifier.operand_type:'OBJECT'
msgid "Use a mesh object as the operand for the Boolean operation"
msgstr "Använd ett meshobjekt som operand för den booleska operationen"

#. :src: bpy.types.BooleanModifier.operand_type:'COLLECTION'
msgid ""
"Use a collection of mesh objects as the operand for the Boolean operation"
msgstr "Använd en samling meshobjekt som operand för den booleska operationen"

#. :src: bpy.types.IMPORT_SCENE_OT_fbx.decal_offset
msgid "Displace geometry of alpha meshes"
msgstr "Förskjut geometrin för alfamesh"

#. :src: bpy.types.IMPORT_SCENE_OT_gltf.guess_original_bind_pose
msgid ""
"Try to guess the original bind pose for skinned meshes from the inverse bind "
"matrices. When off, use default/rest pose as bind pose"
msgstr ""
"Försök att gissa den ursprungliga bindningsställningen för skinnade mesh "
"utifrån inversa bindningsmatriser. När detta är avstängt används standard-/"
"viloställningen som bindningsställning"

#. :src: bpy.types.IMPORT_SCENE_OT_gltf.import_point_as_pointcloud
msgid "Import mesh with only POINTS primitives as Point Cloud objects"
msgstr "Importera mesh med endast POINTS-primitiver som punktmolnsobjekt"

#. :src: bpy.types.IMPORT_SCENE_OT_gltf.import_unused_materials
msgid "Import materials & Images not assigned to any mesh"
msgstr "Importera material och bilder som inte är tilldelade någon mesh"

#. :src: bpy.types.WM_OT_usd_import.read_mesh_attributes
msgid "Read USD Primvars as mesh attributes"
msgstr "Läs USD Primvars som meshattribut"

#. :src: bpy.types.WM_OT_usd_import.read_mesh_colors
msgid "Read mesh color attributes"
msgstr "Läs meshens färgattribut"

#. :src: bpy.types.WM_OT_usd_import.read_mesh_uvs
msgid "Read mesh UV coordinates"
msgstr "Läs UV-koordinater för mesh"

msgid "STL Import: Failed to import mesh from file '%s'"
msgstr "STL-import: Det gick inte att importera meshen från filen ”%s”"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.object_types:'OTHER'
msgid "Other geometry types, like curve, meta-ball, etc. (converted to meshes)"
msgstr ""
"Andra geometrityper, såsom kurvor, metabollar etc. (konverterade till mesh)"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_mesh_modifiers
msgid ""
"Apply modifiers to mesh objects (except Armature ones) - WARNING: prevents "
"exporting shape keys"
msgstr ""
"Tillämpa modifierare på meshobjekt (utom armaturmodifierare) – VARNING: "
"förhindrar export av formnycklar"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_tspace
msgid ""
"Add binormal and tangent vectors, together with normal they form the tangent "
"space (will only work correctly with tris/quads only meshes!)"
msgstr ""
"Lägg till binormaler och tangentvektorer; tillsammans med normaler bildar de "
"tangentrymden (fungerar endast korrekt med mesh som enbart består av "
"trianglar/fyrhörningar)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_all_vertex_colors
msgid ""
"Export all vertex colors, even if not used by any material. If no Vertex "
"Color is used in the mesh materials, a fake COLOR_0 will be created, in "
"order to keep material unchanged"
msgstr ""
"Exportera alla hörnpunktsfärger, även om de inte används av något material. "
"Om ingen hörnpunktsfärg används i meshmaterialen skapas en falsk COLOR_0 för "
"att materialet ska förbli oförändrat"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_apply
msgid ""
"Apply modifiers (excluding Armatures) to mesh objects -WARNING: prevents "
"exporting shape keys"
msgstr ""
"Tillämpa modifierare (utom armaturmodifierare) på meshobjekt – VARNING: "
"förhindrar export av formnycklar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_mesh_compression_enable
msgid "Compress mesh using Draco"
msgstr "Komprimera mesh med Draco"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_kn
msgid ""
"Restrict some optimization to keep named nodes and meshes attached to named "
"nodes so that named nodes can be transformed externally"
msgstr ""
"Begränsa viss optimering för att behålla namngivna noder och mesh kopplade "
"till namngivna noder så att namngivna noder kan transformeras externt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_si
msgid "Simplify meshes targeting triangle count ratio"
msgstr "Förenkla mesh utifrån målantalet trianglar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_slb
msgid ""
"Lock border vertices during simplification to avoid gaps on connected meshes"
msgstr ""
"Lås gränshörn under förenkling för att undvika luckor i sammankopplade mesh"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_materials:'PLACEHOLDER'
msgid ""
"Do not export materials, but write multiple primitive groups per mesh, "
"keeping material slot information"
msgstr ""
"Exportera inte material, utan skriv flera primitivgrupper per mesh och "
"behåll materialplatsinformation"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_materials:'NONE'
msgid ""
"Do not export materials, and combine mesh primitive groups, losing material "
"slot information"
msgstr ""
"Exportera inte material och kombinera meshens primitivgrupper, vilket leder "
"till förlust av materialplatsinformation"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_meshopt_compression_enable
msgid "Compress mesh using Meshopt"
msgstr "Komprimera mesh med Meshopt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_meshopt_extension:'EXT_meshopt_compression'
msgid "Use EXT_meshopt_compression extension for mesh compression"
msgstr "Använd tillägget EXT_meshopt_compression för meshkomprimering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_meshopt_extension:'KHR_meshopt_compression'
msgid "Use KHR_meshopt_compression extension for mesh compression"
msgstr "Använd tillägget KHR_meshopt_compression för meshkomprimering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_normals
msgid "Export vertex normals with meshes"
msgstr "Exportera hörnpunktsnormaler med mesh"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_tangents
msgid "Export vertex tangents with meshes"
msgstr "Exportera hörnpunktstangenter med mesh"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_texcoords
msgid "Export UVs (texture coordinates) with meshes"
msgstr "Exportera UV-koordinater (texturkoordinater) med mesh"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_use_gltfpack
msgid "Use gltfpack to simplify the mesh and/or compress its textures"
msgstr ""
"Använd gltfpack för att förenkla meshen och/eller komprimera dess texturer"

#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.delete_ref
msgid "Delete empty image object once mesh plane is created"
msgstr "Ta bort tomt bildobjekt när meshplanet har skapats"

#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.name_from
msgid "Name for new mesh object and material"
msgstr "Namn på nytt meshobjekt och material"

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'FREE'
msgid ""
"Store custom normals as simple vectors in the local space of the mesh. "
"Values are not necessarily updated automatically later on as the mesh is "
"deformed."
msgstr ""
"Lagra anpassade normaler som enkla vektorer i meshens lokala rum. Värdena "
"uppdateras inte nödvändigtvis automatiskt senare när meshen deformeras."

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'TANGENT_SPACE'
msgid ""
"Store normals in a deformation dependent custom transformation space. This "
"method is slower, but can be better when subsequent operations change the "
"mesh without handling normals specifically."
msgstr ""
"Lagra normaler i ett deformationsberoende anpassat transformationsrum. "
"Metoden är långsammare, men kan vara bättre när efterföljande operationer "
"ändrar meshen utan att hantera normaler specifikt."

#. :src: bpy.types.GeometryNodeSetShadeSmooth
msgid ""
"Control the smoothness of mesh normals around each face by changing the "
"\"shade smooth\" attribute"
msgstr ""
"Styr jämnheten för meshnormaler runt varje yta genom att ändra attributet "
"”shade smooth”"

#. :src: bpy.types.GeometryNodeSplitEdges
msgid "Duplicate mesh edges and break connections with the surrounding faces"
msgstr "Duplicera meshkanter och bryt anslutningar till omgivande ytor"

#. :src: bpy.types.GeometryNodeSubdivideMesh
msgid ""
"Divide mesh faces into smaller ones without changing the shape or volume, "
"using linear interpolation to place the new vertices"
msgstr ""
"Dela meshytor i mindre ytor utan att ändra form eller volym, med linjär "
"interpolering för att placera de nya hörnpunkterna"

#. :src: bpy.types.GeometryNodeSubdivisionSurface
msgid ""
"Divide mesh faces to form a smooth surface, using the Catmull-Clark "
"subdivision method"
msgstr ""
"Dela meshytor för att skapa en jämn yta med Catmull-Clark-metoden för "
"underindelning"

#. :src: bpy.types.GeometryNodeToolSetSelection.selection_type:'FLOAT'
msgid ""
"Store floating point selection values. For mesh geometry, stored inverted as "
"the sculpt mode mask"
msgstr ""
"Lagra urvalsvärden som flyttal. För meshgeometri lagras de inverterat som "
"mask för skulpturläge"

#. :src: bpy.types.GeometryNodeTriangulate
msgid "Convert all faces in a mesh to triangular faces"
msgstr "Konvertera alla ytor i en mesh till triangulära ytor"

#. :src: bpy.types.ShaderNodeAttribute.attribute_type:'OBJECT'
msgid ""
"The attribute is associated with the object or mesh data-block itself, and "
"its value is uniform"
msgstr ""
"Attributet är associerat med själva objektet eller meshdatablocket och "
"värdet är enhetligt"

#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes
msgid "Create mesh plane(s) from image files with the appropriate aspect ratio"
msgstr "Skapa meshplan från bildfiler med lämpligt bildförhållande"

#. :src: bpy.types.MESH_OT_primitive_torus_add
msgid "Construct a torus mesh"
msgstr "Konstruera en torusmesh"

#. :src: bpy.types.SCENE_OT_freestyle_fill_range_by_selection
msgid ""
"Fill the Range Min/Max entries by the min/max distance between selected mesh "
"objects and the source object (either a user-specified object or the active "
"camera)"
msgstr ""
"Fyll i Min-/Max-fälten med minimi-/maximiavståndet mellan valda meshobjekt "
"och källobjektet (antingen ett användardefinierat objekt eller den aktiva "
"kameran)"

#. :src: bpy.types.WM_OT_context_cycle_array
msgid ""
"Set a context array value (useful for cycling the active mesh edit mode)"
msgstr ""
"Ställ in ett kontextmatrisvärde (användbart för att växla mellan aktiva "
"meshredigeringslägen)"

#. :src: bpy.types.CURVES_OT_snap_curves_to_surface
msgid "Move curves so that the first point is exactly on the surface mesh"
msgstr "Flytta kurvorna så att den första punkten ligger exakt på ytmeshen"

#. :src: bpy.types.CURVES_OT_snap_curves_to_surface.attach_mode:'DEFORM'
msgid ""
"Re-attach curves to a deformed surface using the existing attachment "
"information. This only works when the topology of the surface mesh has not "
"changed"
msgstr ""
"Fäst kurvorna på nytt på en deformerad yta med hjälp av befintlig "
"fästinformation. Detta fungerar endast om ytmeshens topologi inte har ändrats"

#. :src: bpy.types.GeometryNodeBoundBox
msgid ""
"Calculate the limits of a geometry's positions and generate a box mesh with "
"those dimensions"
msgstr ""
"Beräkna gränserna för positionerna i en geometri och skapa en kubmesh med "
"dessa dimensioner"

#. :src: bpy.types.GeometryNodeClusterByConnected
msgid ""
"Group mesh vertices connected by edges when they are within a specified "
"distance"
msgstr ""
"Gruppera meshhörnpunkter som är anslutna med kanter när de ligger inom ett "
"angivet avstånd"

#. :src: bpy.types.GeometryNodeDeformCurvesOnSurface
msgid ""
"Translate and rotate curves based on changes between the object's original "
"and evaluated surface mesh"
msgstr ""
"Förskjut och rotera kurvor baserat på förändringar mellan objektets "
"ursprungliga och utvärderade ytmeshen"

#. :src: bpy.types.GeometryNodeDeleteGeometry.mode
msgid "Which parts of the mesh component to delete"
msgstr "Vilka delar av meshkomponenten som ska tas bort"

#. :src: bpy.types.GeometryNodeDistributePointsOnFaces
msgid "Generate points spread out on the surface of a mesh"
msgstr "Generera punkter utspridda på ytan av en mesh"

#. :src: bpy.types.GeometryNodeEdgePathsToCurves
msgid "Output curves following paths across mesh edges"
msgstr "Mata ut kurvor som följer banor över meshkanter"

#. :src: bpy.types.GeometryNodeEdgePathsToSelection
msgid "Output a selection of edges by following paths across mesh edges"
msgstr "Mata ut ett urval av kanter genom att följa banor över meshkanter"

#. :src: bpy.types.GeometryNodeInputMeshFaceArea
msgid "Calculate the surface area of a mesh's faces"
msgstr "Beräkna ytarean för meshens ytor"

#. :src: bpy.types.GeometryNodeInputMeshIsland
msgid "Retrieve information about separate connected regions in a mesh"
msgstr "Hämta information om separata sammanhängande regioner i en mesh"

#. :src: bpy.types.GeometryNodeInputShortestEdgePaths
msgid ""
"Find the shortest paths along mesh edges to selected end vertices, with "
"customizable cost per edge"
msgstr ""
"Hitta de kortaste banorna längs meshkanterna till valda sluthörnpunkter med "
"anpassningsbar kostnad per kant"

#. :src: bpy.types.GeometryNodeMeshCone
msgid "Generate a cone mesh"
msgstr "Skapa en konmesh"

#. :src: bpy.types.GeometryNodeMeshCube
msgid "Generate a cuboid mesh with variable side lengths and subdivisions"
msgstr "Skapa en kubmesh med variabla sidolängder och underindelningar"

#. :src: bpy.types.GeometryNodeMeshCylinder
msgid "Generate a cylinder mesh"
msgstr "Skapa en cylindermesh"

#. :src: bpy.types.GeometryNodeMeshGrid
msgid "Generate a planar mesh on the XY plane"
msgstr "Skapa en plan mesh på XY-planet"

#. :src: bpy.types.GeometryNodeMeshIcoSphere
msgid "Generate a spherical mesh that consists of equally sized triangles"
msgstr "Skapa en sfärisk mesh av trianglar med samma storlek"

#. :src: bpy.types.GeometryNodeMeshToCurve
msgid "Generate a curve from a mesh"
msgstr "Skapa en kurva från en mesh"

#. :src: bpy.types.GeometryNodeMeshUVSphere
msgid ""
"Generate a spherical mesh with quads, except for triangles at the top and "
"bottom"
msgstr ""
"Skapa en sfärisk mesh med fyrhörningar, utom trianglar vid topp och botten"

#. :src: bpy.types.GeometryNodeSampleNearestSurface
msgid ""
"Calculate the interpolated value of a mesh attribute on the closest point of "
"its surface"
msgstr ""
"Beräkna det interpolerade värdet för ett meshattribut på den närmaste "
"punkten på dess yta"

#. :src: bpy.types.GeometryNodeSampleUVSurface
msgid ""
"Calculate the interpolated values of a mesh attribute at a UV coordinate"
msgstr ""
"Beräkna de interpolerade värdena för ett meshattribut vid en UV-koordinat"

#. :src: bpy.types.GeometryNodeSetMeshNormal
msgid "Store a normal vector for each mesh element"
msgstr "Lagra en normalvektor för varje meshelement"

#. :src: bpy.types.MaskModifier
msgid "Mask modifier to hide parts of the mesh"
msgstr "Maskmodifierare för att dölja delar av meshen"

#. :src: bpy.types.MeshCacheModifier.deform_mode:'INTEGRATE'
msgid ""
"Integrate deformation from this modifier's input with the mesh-cache "
"coordinates (useful for shape keys)"
msgstr ""
"Integrera deformation från denna modifierares indata med "
"meshcachekoordinaterna (användbart för formnycklar)"

#. :src: bpy.types.MeshDeformModifier
msgid "Mesh deformation modifier to deform with other meshes"
msgstr "Modifierare för meshdeformering med andra meshar"

#. :src: bpy.types.MeshToVolumeModifier.interior_band_width
msgid "Width of the gradient inside of the mesh"
msgstr "Bredden på gradienten inuti meshen"

#. :src: bpy.types.MirrorModifier.use_bisect_axis
msgid "Cuts the mesh across the mirror plane"
msgstr "Skär meshen tvärs över spegelplanet"

#. :src: bpy.types.MultiresModifier
msgid "Multiresolution mesh modifier"
msgstr "Flerupplösningsmodifierare för mesh"

#. :src: bpy.types.MultiresModifier.use_creases
#. :src: bpy.types.SubsurfModifier.use_creases
msgid "Use mesh crease information to sharpen edges or corners"
msgstr "Använd information om meshveck för att skärpa kanter eller hörn"

#. :src: bpy.types.MultiresModifier.use_custom_normals
#. :src: bpy.types.SubsurfModifier.use_custom_normals
msgid "Interpolates existing custom normals to resulting mesh"
msgstr ""
"Interpolerar befintliga anpassade normaler till den resulterande meshen"

#. :src: bpy.types.MultiresModifier.use_sculpt_base_mesh
msgid ""
"Make Sculpt Mode tools deform the base mesh while previewing the "
"displacement of higher subdivision levels"
msgstr ""
"Låt verktygen i skulpteringsläget deformera basmeshen medan förskjutningen "
"av högre underindelningsnivåer förhandsgranskas"

#. :src: bpy.types.ParticleInstanceModifier.space
msgid "Space to use for copying mesh data"
msgstr "Koordinatutrymme som används för kopiering av meshdata"

#. :src: bpy.types.RemeshModifier
msgid ""
"Generate a new surface with regular topology that follows the shape of the "
"input mesh"
msgstr ""
"Skapa en ny yta med regelbunden topologi som följer formen på indatameshen"

#. :src: bpy.types.RemeshModifier.mode:'SHARP'
msgid ""
"Output a surface that reproduces sharp edges and corners from the input mesh"
msgstr "Skapa en yta som återger skarpa kanter och hörn från indatameshen"

#. :src: bpy.types.RemeshModifier.mode:'VOXEL'
msgid "Output a mesh corresponding to the volume of the original mesh"
msgstr "Skapa en mesh som motsvarar volymen hos den ursprungliga meshen"

#. :src: bpy.types.ScrewModifier.use_normal_calculate
msgid "Calculate the order of edges (needed for meshes, but not curves)"
msgstr "Beräkna ordningen på kanter (behövs för meshar, men inte kurvor)"

#. :src: bpy.types.SimpleDeformModifier.deform_method:'BEND'
msgid "Bend the mesh over the Z axis of the modifier space"
msgstr "Böj meshen över modifieringsutrymmets Z-axel"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'EXTRUDE'
msgid "Output a solidified version of a mesh by simple extrusion"
msgstr "Skapa en solidifierad version av en mesh med enkel extrudering"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'NON_MANIFOLD'
msgid ""
"Output a manifold mesh even if the base mesh is non-manifold, where edges "
"have 3 or more connecting faces. This method is slower."
msgstr ""
"Skapa en manifold-mesh även om basmeshen inte är manifold, där kanterna har "
"tre eller fler anslutande ytor. Denna metod är långsammare."

#. :src: bpy.types.SubsurfModifier.adaptive_space
msgid "How to adaptively subdivide the mesh"
msgstr "Hur meshen ska delas upp adaptivt"

#. :src: bpy.types.SubsurfModifier.adaptive_space:'OBJECT'
msgid ""
"Subdivide to reach a specified edge length in object space. This is required "
"to use adaptive subdivision for instanced meshes"
msgstr ""
"Dela upp för att nå en angiven kantlängd i objektrymden. Detta krävs för att "
"använda adaptiv underindelning för instansierade meshar"

#. :src: bpy.types.SubsurfModifier.use_adaptive_subdivision
msgid "Adaptively subdivide mesh based on camera distance"
msgstr "Dela upp meshen adaptivt utifrån kameraavståndet"

#. :src: bpy.types.SurfaceDeformModifier.is_bound
msgid "Whether geometry has been bound to target mesh"
msgstr "Om geometrin har kopplats till målmeshen"

#. :src: bpy.types.VolumeToMeshModifier.grid_name
msgid "Grid in the volume object that is converted to a mesh"
msgstr "Rutnätet i volymobjektet som konverteras till en mesh"

#. :src: bpy.types.VolumeToMeshModifier.threshold
msgid "Voxels with a larger value are inside the generated mesh"
msgstr "Voxlar med ett högre värde ligger inuti den genererade meshen"

#. :src: bpy.types.GreasePencilShrinkwrapModifier
msgid "Shrink wrapping modifier to shrink wrap an object to a target"
msgstr "Shrinkwrap-modifierare som anpassar ett objekt tätt över ett mål"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.auxiliary_target
#. :src: bpy.types.ShrinkwrapModifier.auxiliary_target
msgid "Additional mesh target to shrink to"
msgstr "Ytterligare målmesh som objektet kan anpassas tätt till"

#. :src: bpy.types.ShrinkwrapModifier
msgid "Shrink wrapping modifier to shrink wrap and object to a target"
msgstr "Shrinkwrap-modifierare som anpassar ett objekt tätt över ett mål"

#. :src: bpy.types.RIGIDBODY_OT_shape_change.type:'CONVEX_HULL'
#. :src: bpy.types.RigidBodyObject.collision_shape:'CONVEX_HULL'
