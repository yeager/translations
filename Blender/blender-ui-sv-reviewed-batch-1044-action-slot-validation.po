#: source/blender/makesrna/intern/rna_action.cc:535
msgid "A channelbag for this slot already exists"
msgstr "Det finns redan en kanalsamling för denna Action-slot"

#: source/blender/makesrna/intern/rna_action.cc:579
msgid "Slot cannot be None"
msgstr "Action-slot kan inte vara None"

#: source/blender/makesrna/intern/rna_action.cc:846
msgid "Cannot return channelbag when slot is None"
msgstr "Det går inte att returnera kanalsamling när Action-slot är None"

#: source/blender/makesrna/intern/rna_action.cc:203
msgid "Invalid slot name '%s': name must not be empty."
msgstr "Ogiltigt Action-slotnamn ”%s”: namnet får inte vara tomt."

#: source/blender/makesrna/intern/rna_action.cc:352
msgid "Attempted to set slot identifier to \"%s\", but the type prefix does not match the slot's 'target_id_type' \"%s\". Setting to \"%s\" instead."
msgstr "Försökte ange Action-slotidentifieraren till ”%s”, men typprefixet stämmer inte överens med Action-slottens 'target_id_type' ”%s”. Anger i stället ”%s”."

#: source/blender/makesrna/intern/rna_animation.cc:374
msgid "This slot (%s) is not suitable for this data-block type (%c%c)"
msgstr "Denna Action-slot (%s) är inte lämplig för denna datablocktyp (%c%c)"

#: source/blender/makesrna/intern/rna_animation.cc:300
msgid "This slot is not suitable for this data-block type (%c%c)"
msgstr "Denna Action-slot är inte lämplig för denna datablocktyp (%c%c)"
