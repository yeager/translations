#. :src: bpy.types.GeometryNodeUVPackIslands
msgid "Pack UV Islands"
msgstr "Packa UV-öar"

#. :src: bpy.types.GeometryNodeVertexOfCorner
msgid "Retrieve the vertex each face corner is attached to"
msgstr "Hämta den hörnpunkt som varje ythörn är kopplat till"

#. :src: bpy.types.GeometryNodeViewportTransform
msgid "Retrieve the view direction and location of the 3D viewport"
msgstr "Hämta vyriktning och position för 3D-vyporten"

#. :src: bpy.types.GeometryNodeVolumeToMesh
msgid "Generate a mesh on the \"surface\" of a volume"
msgstr "Generera en mesh på \"ytan\" av en volym"

#. :src: bpy.types.NodeGroupOutput
#: scripts/startup/bl_operators/geometry_nodes.py:31
msgid "Group Output"
msgstr "Grupputdata"

#. :src: bpy.types.NodeGroupOutput
msgid "Output data from inside of a node group"
msgstr "Mata ut data från insidan av en nodgrupp"

#. :src: bpy.types.NodeGroupOutput.is_active_output
#. :src: bpy.types.ShaderNodeOutputLight.is_active_output
#. :src: bpy.types.ShaderNodeOutputLineStyle.is_active_output
#. :src: bpy.types.ShaderNodeOutputMaterial.is_active_output
#. :src: bpy.types.ShaderNodeOutputWorld.is_active_output
msgid "Active Output"
msgstr "Aktiv utdata"

#. :src: bpy.types.NodeGroupOutput.is_active_output
msgid "True if this node is used as the active group output"
msgstr "Sant om denna nod används som aktiv grupputdata"

#. :src: bpy.types.NodeReroute
msgid ""
"A single-socket organization tool that supports one input and multiple "
"outputs"
msgstr ""
"Ett organiseringsverktyg med ett enda uttag som stöder en indata och flera "
"utdata"

#. :src: bpy.types.NodeReroute.socket_idname
msgid "Type of socket"
msgstr "Uttagstyp"

#. :src: bpy.types.ShaderNodeBsdfHair.component:'Transmission'
msgid "The light that passes through the hair and exits on the other side"
msgstr "Ljuset som passerar genom håret och kommer ut på andra sidan"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.model
msgid "Select from Chiang or Huang model"
msgstr "Välj mellan Chiang- och Huang-modellen"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.model:'CHIANG'
msgid ""
"Near-field hair scattering model by Chiang et al. 2016, suitable for close-"
"up looks, but is more noisy when viewing from a distance."
msgstr ""
"Närfältsmodell för hårspridning av Chiang et al. 2016, lämplig för närbilder "
"men mer brusig på avstånd."

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization
msgid "Select the shader's color parametrization"
msgstr "Välj shaderns färgparametrisering"

#. :src: bpy.types.ShaderNodeBsdfMetallic.fresnel_type
msgid "Fresnel Type"
msgstr "Fresnel-typ"

#. :src: bpy.types.ShaderNodeBsdfMetallic.fresnel_type:'F82'
msgid "F82 Tint"
msgstr "F82-färgton"

#. :src: bpy.types.ShaderNodeBsdfPrincipled
msgid "Principled BSDF"
msgstr "Principiell BSDF"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method
msgid "Subsurface Method"
msgstr "Underytsspridningsmetod"

#. :src: bpy.types.ShaderNodeBsdfRefraction
msgid "Refraction BSDF"
msgstr "Refraktions-BSDF"

#. :src: bpy.types.ShaderNodeBsdfSheen.distribution:'ASHIKHMIN'
msgid "Classic Ashikhmin velvet (legacy model)"
msgstr "Klassisk Ashikhmin-sammet (äldre modell)"

#. :src: bpy.types.ShaderNodeBsdfTranslucent
msgid "Lambertian diffuse transmission"
msgstr "Lambertisk diffus transmission"

#. :src: bpy.types.ShaderNodeClamp
msgid "Clamp a value between a minimum and a maximum"
msgstr "Begränsa ett värde mellan ett minimum och ett maximum"

#. :src: bpy.types.ShaderNodeClamp.clamp_type
msgid "Clamp Type"
msgstr "Begränsningstyp"

#. :src: bpy.types.ShaderNodeClamp.clamp_type:'MINMAX'
msgid "Min Max"
msgstr "Min/max"

#. :src: bpy.types.ShaderNodeCustomGroup
msgid "Shader Custom Group"
msgstr "Anpassad shadergrupp"

#. :src: bpy.types.ShaderNodeCustomGroup
msgid "Custom Shader Group Node for Python nodes"
msgstr "Anpassad shadergruppsnod för Python-noder"

#. :src: bpy.types.ShaderNodeDisplacement.space:'OBJECT'
#. :src: bpy.types.ShaderNodeNormalMap.space:'OBJECT'
#. :src: bpy.types.ShaderNodeTexPointDensity.space:'OBJECT'
#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'OBJECT'
#. :src: Socket name from node group Displace Hair Curves, file procedural_hair_node_assets.blend
msgid "Object Space"
msgstr "Objektrymd"

#. :src: bpy.types.ShaderNodeEeveeSpecular
msgid "Specular BSDF"
msgstr "Spekulär BSDF"

#. :src: bpy.types.ShaderNodeFloatCurve
msgid "Map an input float to a curve and outputs a float value"
msgstr "Mappa ett indataflyttal till en kurva och returnera ett flyttalsvärde"

#. :src: bpy.types.ShaderNodeLayerWeight
msgid "Layer Weight"
msgstr "Lagervikt"

#. :src: bpy.types.ShaderNodeLightFalloff
msgid "Light Falloff"
msgstr "Ljusavtagande"

#. :src: bpy.types.ShaderNodeMapping
msgid "Transform the input vector by applying translation, rotation, and scale"
msgstr ""
"Transformera indatavektorn genom att tillämpa förskjutning, rotation och "
"skala"

#. :src: bpy.types.ShaderNodeMix.clamp_result
msgid "Clamp Result"
msgstr "Begränsa resultat"

#. :src: bpy.types.ShaderNodeMix.factor_mode
msgid "Factor Mode"
msgstr "Faktorläge"

#. :src: bpy.types.ShaderNodeMixRGB
msgid "Mix two input colors"
msgstr "Blanda två indatafärger"

#. :src: bpy.types.ShaderNodeNormalMap.space:'TANGENT'
msgid "Tangent space normal mapping"
msgstr "Normalkartläggning i tangentrymd"

#. :src: bpy.types.ShaderNodeNormalMap.space:'OBJECT'
msgid "Object space normal mapping"
msgstr "Normalkartläggning i objektrymd"
