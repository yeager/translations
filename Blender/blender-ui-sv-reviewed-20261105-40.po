#. :src: bpy.types.BoneCollection.is_editable
msgid "This collection is owned by a local Armature, or was added via a library override in the current blend file"
msgstr "Samlingen ägs av ett lokalt riggskelett eller lades till med en biblioteksöverskrivning i aktuell blend-fil"

#. :src: bpy.types.BoneCollection.is_expanded
msgid "This bone collection is expanded in the bone collections tree view"
msgstr "Den här bensamlingen är expanderad i trädvyn för bensamlingar"

#. :src: bpy.types.BoneCollection.is_local_override
msgid "Is Local Override"
msgstr "Är lokal överskrivning"

#. :src: bpy.types.BoneCollection.is_local_override
msgid "This collection was added via a library override in the current blend file"
msgstr "Samlingen lades till med en biblioteksöverskrivning i aktuell blend-fil"

#. :src: bpy.types.BoneCollection.is_solo
msgid "Show only this bone collection, and others also marked as 'solo'"
msgstr "Visa endast denna bensamling och andra som också är markerade som 'solo'"

#. :src: bpy.types.BoneCollection.is_visible
msgid "Bones in this collection will be visible in pose/object mode"
msgstr "Ben i denna samling syns i pose-/objektläge"

#. :src: bpy.types.BoneCollection.is_visible_ancestors
msgid "Ancestors Effectively Visible"
msgstr "Överordnade är synliga"

#. :src: bpy.types.BoneCollection.is_visible_ancestors
msgid "True when all of the ancestors of this bone collection are marked as visible; always True for root bone collections"
msgstr "Sant när alla överordnade bensamlingar är synliga; alltid sant för rotbensamlingar"

#. :src: bpy.types.BoneCollection.is_visible_effectively
msgid "Effective Visibility"
msgstr "Effektiv synlighet"

#. :src: bpy.types.BoneCollection.is_visible_effectively
msgid "Whether this bone collection is effectively visible in the viewport. This is True when this bone collection and all of its ancestors are visible, or when it is marked as 'solo'."
msgstr "Anger om denna bensamling faktiskt syns i visningsområdet. Sant när denna samling och alla överordnade är synliga eller när den är markerad som 'solo'."

#. :src: bpy.types.BoneCollection.name
msgid "Unique within the Armature"
msgstr "Unik inom riggskelettet"

#. :src: bpy.types.BoneCollection.parent
msgid "Parent bone collection. Note that accessing this requires a scan of all the bone collections to find the parent."
msgstr "Överordnad bensamling. För åtkomst krävs en genomsökning av alla bensamlingar för att hitta den överordnade."
