msgid "Panel States"
msgstr "Paneltillstånd"

msgid "Expansion state of each panel in the node"
msgstr "Expansionsstatus för varje panel i noden"

msgid "Parent this node is attached to, e.g. a Frame node"
msgstr "Överordnad nod som den här noden är kopplad till, t.ex. en Frame-nod"

msgid ""
"Whether the node options are visible, e.g. the selected data-block of a node"
" group node"
msgstr ""
"Om nodalternativen är synliga, till exempel det valda datablocket för en "
"nodgruppsnod"

msgid "Display node in viewport textured shading mode"
msgstr "Visa noden i visningsfönstrets texturerade skuggningsläge"

msgid "Compositor Node"
msgstr "Kompositornod"

msgid "Blank Image"
msgstr "Tom bild"

msgid ""
"Generate image with bokeh shape for use with the Bokeh Blur filter node"
msgstr ""
"Skapa en bild med bokeh-form för användning med filternoden Bokeh Blur."

msgid "Input White Point"
msgstr "Ingångsvitpunkt"

msgid "Output White Point"
msgstr "Utgångsvitpunkt"

msgid "Use HSV (Hue, Saturation, Value) color processing"
msgstr "Använd HSV-färgbehandling (nyans, mättnad, värde)"

msgid "Use HSL (Hue, Saturation, Lightness) color processing"
msgstr "Använd HSL-färgbehandling (nyans, mättnad, ljushet)"

msgctxt "Color Management"
msgid "From"
msgstr "Från"

