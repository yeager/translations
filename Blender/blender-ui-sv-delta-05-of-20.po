msgid "To"
msgstr "Till"

msgid "Color management display device settings"
msgstr "Inställningar för färghanteringens visningsenhet"

msgid "Color management view transform settings"
msgstr "Inställningar för färghanteringens vyomvandling"

msgid "Plane warp transformation using explicit corner values"
msgstr "Planförvrängning med hjälp av explicita hörnvärden"

msgid "Deprecated. Use Cryptomatte Node instead"
msgstr "Föråldrad. Använd Cryptomatte-nod i stället."

msgid "Use Material layer"
msgstr "Använd materiallager"

msgid "Compositor Custom Group"
msgstr "Anpassad kompositorgrupp"

msgid "Max Blur"
msgstr "Maximal oskärpa"

msgid "Heptagonal"
msgstr "Sjukantig"

msgid ""
"Scene from which to select the active camera (render scene if undefined)"
msgstr ""
"Scen från vilken den aktiva kameran ska väljas (renderingsscen om "
"odefinierad)"

msgid "Denoise renders from Cycles and other ray tracing renderers"
msgstr ""
"Brusreducera renderingar från Cycles och andra strålspårningsrenderare"

msgid "Difference Key"
msgstr "Skillnadsnyckel"

msgid "Distance Key"
msgstr "Avståndsnyckel"

