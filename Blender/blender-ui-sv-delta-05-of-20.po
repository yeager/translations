msgstr "Hämta synligheten för Grease Pencil-streck"

msgid "Grease Pencil to Curves"
msgstr "Grease Pencil till kurvor"

msgid "Deactivate Voxels"
msgstr "Inaktivera voxlar"

msgid "Deactivate selected voxels and tiles"
msgstr "Inaktivera markerade voxlar och rutor"

msgid "Grid Topology Boolean"
msgstr "Boolesk rutnätstopologi"

msgid "Combine the topology of multiple grids"
msgstr "Kombinera topologin för flera rutnät"

msgid "Output a font"
msgstr "Mata ut ett typsnitt"

msgid "Instance Reference"
msgstr "Instansreferens"

msgid "Output the reference index of the instance"
msgstr "Mata ut instansens referensindex"

msgid "Mesh Island"
msgstr "Nätö"

