msgstr "Ta bort tecken från början och slutet av en sträng"

msgid "Grease Pencil component containing layers and curves data"
msgstr "Grease Pencil-komponent som innehåller lager- och kurvdata"

msgid "Volume component containing volume grids"
msgstr "Volymkomponent som innehåller volymrutnät"

msgid "Closure to List"
msgstr "Closure till lista"

msgid "Cluster by Connected"
msgstr "Kluster efter anslutning"

msgid ""
"Group mesh vertices connected by edges when they are within a specified "
"distance"
msgstr ""
"Gruppera meshhörn som är anslutna med kanter när de är inom ett angivet "
"avstånd"

msgid "Cluster by Distance"
msgstr "Klustring efter avstånd"

msgid "Group elements into integer IDs based on proximity of vector values"
msgstr "Gruppera element i heltals-ID:n utifrån närheten mellan vektorvärden"

msgid ""
"Retrieve a collection's object and collection children, in a name-based "
"order"
msgstr "Hämta en samlings objekt och underordnade samlingar i namnordning"

msgid "Combine List"
msgstr "Kombinera lista"

msgid "Combine an arbitrary number of values into a list"
msgstr "Kombinera ett godtyckligt antal värden till en lista"

msgid "Corners of Vertex"
msgstr "Hörn för hörn"

msgid "Curves to Grease Pencil"
msgstr "Kurvor till Grease Pencil"

msgid "Only Faces"
msgstr "Endast ytor"

msgid "Edges of Vertex"
msgstr "Kanter för hörn"

msgid "Retrieve the face each face corner is part of"
msgstr "Hämta ytan som varje ythörn tillhör"

msgid "Filter List"
msgstr "Filtrera lista"

msgid "Remove items from a list"
msgstr "Ta bort objekt från en lista"

msgid "Flip Faces"
msgstr "Vänd ytor"

msgid "Geometry Materials"
msgstr "Geometrimaterial"

msgid "Get a list of the materials used by a geometry component"
msgstr "Hämta en lista över material som används av en geometrikomponent"

msgid ""
"Convert each input geometry into an instance, which can be much faster than "
"the Join Geometry node when the inputs are large"
msgstr ""
"Konvertera varje ingångsgeometri till en instans, vilket kan vara mycket "
"snabbare än noden Sammanfoga geometri när ingångarna är stora."

msgid "Get Attribute Names"
msgstr "Hämta attributnamn"

msgid "Retrieves attribute names as a list of strings"
msgstr "Hämtar attributnamn som en lista med strängar"

msgid "Get Geometry Component"
msgstr "Hämta geometrikomponent"

msgid "Get a single component of a geometry"
msgstr "Hämta en enskild komponent av en geometri"

msgid "Retrieve the color of Grease Pencil points and fills"
msgstr "Hämta färgen för Grease Pencil-punkter och fyllningar"

msgid "Grease Pencil Draw Time"
msgstr "Rittid för Grease Pencil"

