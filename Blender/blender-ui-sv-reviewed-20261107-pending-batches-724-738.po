msgctxt "Operator"
msgid "Add Action Strip"
msgstr "Lägg till Action-remsa"

#. :src: bpy.types.NLA_OT_actionclip_add
msgid ""
"Add an Action-Clip strip (i.e. an NLA Strip referencing an Action) to the "
"active track"
msgstr ""
"Lägg till en Action-clippremsa (en NLA-remsa som refererar till en Action) i "
"det aktiva spåret"

