#. :src: bpy.types.CompositorNodeDilateErode.mode
msgid "Growing/shrinking mode"
msgstr "Utvidgnings-/krympningsläge"

#. :src: bpy.types.CompositorNodeEllipseMask
msgid ""
"Create elliptical mask suitable for use as a simple matte or vignette mask"
msgstr ""
"Skapa en elliptisk mask som kan användas som en enkel matta eller vinjettmask"

#. :src: bpy.types.CompositorNodeFilter.filter_type:'SHARPEN'
msgid "Box Sharpen"
msgstr "Rutskärpning"

#. :src: bpy.types.CompositorNodeGamma
msgid "Apply gamma correction"
msgstr "Tillämpa gammakorrigering"

#. :src: bpy.types.CompositorNodeGlare
msgid "Add lens flares, fog and glows around bright parts of the image"
msgstr "Lägg till linsreflexer, dimma och glöd runt bildens ljusa delar"

#. :src: bpy.types.CompositorNodeGlare.angle_offset
msgid "Streak angle offset. (Deprecated: Use Streaks Angle input instead)"
msgstr ""
"Förskjutning av streckens vinkel. (Föråldrad: Använd Streaks Angle input i "
"stället)"

#. :src: bpy.types.CompositorNodeGlare.fade
msgid "Streak fade-out factor. (Deprecated: Use Fade input instead)"
msgstr "Uttoningsfaktor för streck. (Föråldrad: Använd Fade-ingång i stället)"

#. :src: bpy.types.CompositorNodeGlare.glare_type:'FOG_GLOW'
#: source/blender/nodes/composite/nodes/node_composite_glare.cc:241
msgid "Fog Glow"
msgstr "Dimljus"

#. :src: bpy.types.CompositorNodeGlare.streaks
msgid "Total number of streaks. (Deprecated: Use Streaks input instead)"
msgstr "Totalt antal streck. (Föråldrad: Använd inmatningen Streaks i stället)"

#. :src: bpy.types.CompositorNodeGlare.use_rotate_45
msgid "Rotate 45°"
msgstr "Rotera 45°"

#. :src: bpy.types.CompositorNodeHueCorrect
#. :src: bpy.types.StripModifier.type:'HUE_CORRECT'
msgid "Hue Correct"
msgstr "Korrigera färgton"

#. :src: bpy.types.CompositorNodeHueSat
#. :src: bpy.types.ShaderNodeHueSaturation
msgid "Apply a color transformation in the HSV color model"
msgstr "Tillämpa en färgomvandling i HSV-färgmodellen"

#. :src: bpy.types.CompositorNodeIDMask
msgid "Create a matte from an object or material index pass"
msgstr "Skapa en matta från ett objekt- eller materialindexpass"

#. :src: bpy.types.CompositorNodeIDMask.index
msgid ""
"Pass index number to convert to alpha. (Deprecated: Use Index input instead.)"
msgstr ""
"Indexnumret för passet som ska konverteras till alfa. (Föråldrad: Använd "
"Index-ingång i stället.)"

#. :src: bpy.types.CompositorNodeIDMask.use_antialiasing
msgid ""
"Apply an anti-aliasing filter to the mask. (Deprecated: Use Anti-Aliasing "
"input instead.)"
msgstr ""
"Tillämpa ett kantutjämningsfilter på masken. (Föråldrad: Använd Anti-"
"Aliasing input i stället.)"

#. :src: bpy.types.CompositorNodeImage
msgid "Input image or movie file"
msgstr "Indatabild eller filmfil"

#. :src: bpy.types.CompositorNodeImage.use_straight_alpha_output
msgid "Straight Alpha Output"
msgstr "Utdata med rak alfa"

#. :src: bpy.types.CompositorNodeImage.use_straight_alpha_output
msgid "Put node output buffer to straight alpha instead of premultiplied"
msgstr ""
"Sätt nodens utdatabuffert till rak alfa i stället för förmultiplicerad alfa"

#. :src: bpy.types.CompositorNodeInvert
msgid "Invert colors, producing a negative"
msgstr "Invertera färger och skapa ett negativ"

#. :src: bpy.types.CompositorNodeKeying
msgid ""
"Perform both chroma keying (to remove the backdrop) and despill (to correct "
"color cast from the backdrop)"
msgstr ""
"Utför både färgnyckling (för att ta bort bakgrunden) och undertryck "
"färgspill (för att korrigera färgstick från bakgrunden)"

#. :src: bpy.types.CompositorNodeKeying.feather_distance
msgid "Feather Distance"
msgstr "Uttoningsavstånd"

#. :src: bpy.types.CompositorNodeKeying.feather_falloff
msgctxt "Curve"
msgid "Feather Falloff"
msgstr "Uttoningsavtagande"

#. :src: bpy.types.CompositorNodeKuwahara
msgid ""
"Apply smoothing filter that preserves edges, for stylized and painterly "
"effects"
msgstr ""
"Tillämpa ett utjämningsfilter som bevarar kanter för stiliserade och "
"måleriska effekter"

#. :src: bpy.types.CompositorNodeKuwahara.eccentricity
#: scripts/startup/bl_ui/properties_texture.py:419
#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:60
msgid "Eccentricity"
msgstr "Excentricitet"

#. :src: bpy.types.CompositorNodeKuwahara.uniformity
#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:44
msgid "Uniformity"
msgstr "Likformighet"

#. :src: bpy.types.CompositorNodeKuwahara.use_high_precision
#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:69
msgid "High Precision"
msgstr "Hög precision"

#. :src: bpy.types.CompositorNodeLensdist.distortion_type:'RADIAL'
msgid ""
"Radially distorts the image to create a barrel or a Pincushion distortion"
msgstr ""
"Förvränger bilden radiellt för att skapa en tunnformig eller kuddformig "
"förvrängning"

#. :src: bpy.types.CompositorNodeLensdist.distortion_type:'HORIZONTAL'
msgid ""
"Horizontally distorts the image to create a channel/color shifting effect"
msgstr ""
"Förvränger bilden horisontellt för att skapa en kanal- eller "
"färgskiftningseffekt"

#. :src: bpy.types.CompositorNodeLensdist.use_jitter
msgid ""
"Enable/disable jittering (faster, but also noisier). (Deprecated: Use Jitter "
"input instead.)"
msgstr ""
"Aktivera/inaktivera jitter (snabbare men även mer brusig). (Föråldrad: "
"Använd Jitter-ingång i stället.)"

#. :src: bpy.types.CompositorNodeLumaMatte
msgid "Luminance Key"
msgstr "Luminansnyckling"

#. :src: bpy.types.CompositorNodeLumaMatte
msgid "Create a matte based on luminance (brightness) difference"
msgstr "Skapa en matta baserad på skillnaden i luminans (ljusstyrka)"

#. :src: bpy.types.CompositorNodeLumaMatte.limit_max
msgid "Values higher than this setting are 100% opaque"
msgstr "Värden över denna inställning är 100 % opaka"

#. :src: bpy.types.CompositorNodeLumaMatte.limit_min
msgid "Values lower than this setting are 100% keyed"
msgstr "Värden under denna inställning är 100 % frilagda"

#. :src: bpy.types.CompositorNodeMapRange.use_clamp
msgid "Clamp the result of the node to the target range"
msgstr "Begränsa nodens resultat till målintervallet"

#. :src: bpy.types.CompositorNodeMapUV
msgid "Map UV"
msgstr "UV-mappning"

#. :src: bpy.types.CompositorNodeMapValue
msgid "Map Value"
msgstr "Mappa värde"

#. :src: bpy.types.CompositorNodeMapValue.use_min
#: scripts/startup/bl_ui/properties_physics_field.py:314
msgid "Use Minimum"
msgstr "Använd minimum"

#. :src: bpy.types.CompositorNodeMask.size_source
msgid "Size Source"
msgstr "Storlekskälla"

#. :src: bpy.types.CompositorNodeMask.size_source
msgid "Where to get the mask size from for aspect/size information"
msgstr ""
"Varifrån maskens storlek hämtas för bildförhållande- och storleksinformation"

#. :src: bpy.types.CompositorNodeMask.use_feather
msgid ""
"Use feather information from the mask. (Deprecated: Use Feather input "
"instead.)"
msgstr ""
"Använd uttoningsinformation från masken. (Föråldrad: Använd Feather input i "
"stället.)"

#. :src: bpy.types.CompositorNodeMath
#. :src: bpy.types.ShaderNodeMath
msgid "Perform math operations"
msgstr "Utför matematiska operationer"

#. :src: bpy.types.CompositorNodeMath.operation:'MULTIPLY'
#. :src: bpy.types.FunctionNodeIntegerMath.operation:'MULTIPLY'
#. :src: bpy.types.ShaderNodeMath.operation:'MULTIPLY'
#. :src: bpy.types.ShaderNodeVectorMath.operation:'MULTIPLY'
#. :src: bpy.types.TextureNodeMath.operation:'MULTIPLY'
#. :src: bpy.types.NODE_OT_nw_batch_change.operation:'MULTIPLY'
#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'MULTIPLY'
msgctxt "NodeTree"
msgid "Multiply"
msgstr "Multiplicera"
