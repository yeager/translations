msgid "Add Rest Position"
msgstr "Lägg till viloposition"

#. :src: bpy.types.Object.add_rest_position_attribute
msgid ""
"Add a \"rest_position\" attribute that is a copy of the position attribute "
"before shape keys and modifiers are evaluated"
msgstr ""
"Lägg till ett \"rest_position\"-attribut som är en kopia av "
"positionsattributet innan formnycklar och modifierare utvärderas"

