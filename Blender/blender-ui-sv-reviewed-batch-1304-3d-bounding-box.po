#. :src: bpy.types.OBJECT_OT_align.bb_quality
msgid "Enables high quality but slow calculation of the bounding box for perfect results on complex shape meshes with rotation/scale"
msgstr "Aktiverar högkvalitativ men långsam beräkning av begränsningsboxen för perfekta resultat på komplexa polygonmaskor med rotation eller skalning"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_GEOMETRY'
msgid "Calculate the center of geometry based on the current pivot point (median, otherwise bounding box)"
msgstr "Beräkna geometrins centrum utifrån den aktuella vridningspunkten (median, annars begränsningsbox)"

#: source/blender/nodes/geometry/nodes/node_geo_bounding_box.cc:15
msgid "Geometry to compute the bounding box of. Instances have to be realized before the full bounding box can be computed"
msgstr "Geometri vars begränsningsbox ska beräknas. Instanser måste realiseras innan den fullständiga begränsningsboxen kan beräknas"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:84
#: source/blender/nodes/geometry/nodes/node_geo_volume_cube.cc:132
msgid "Bounding box volume must be greater than 0"
msgstr "Begränsningsboxens volym måste vara större än 0"
