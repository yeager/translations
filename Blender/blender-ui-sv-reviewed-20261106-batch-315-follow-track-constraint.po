#. :src: bpy.types.FollowTrackConstraint
msgid "Follow Track Constraint"
msgstr "Följ spår-begränsning"

#. :src: bpy.types.FollowTrackConstraint.depth_object
msgid ""
"Object used to define depth in camera space by projecting onto surface of "
"this object"
msgstr ""
"Objekt som används för att definiera djup i kamerarummet genom att projicera "
"på det här objektets yta"

#. :src: bpy.types.FollowTrackConstraint.frame_method
msgid "How the footage fits in the camera frame"
msgstr "Hur bildmaterialet passar i kameraramen"

#. :src: bpy.types.FollowTrackConstraint.object
msgid "Movie tracking object to follow (if empty, camera object is used)"
msgstr ""
"Filmspårningsobjekt som ska följas (om det saknas används kameraobjektet)"

#. :src: bpy.types.FollowTrackConstraint.track
msgid "Movie tracking track to follow"
msgstr "Filmspår som ska följas"

#. :src: bpy.types.FollowTrackConstraint.use_undistorted_position
msgid "Parent to undistorted position of 2D track"
msgstr ""
"Skapa en föräldrarelation till den distorsionskorrigerade positionen för 2D-"
"spåret"

#. :src: bpy.types.Constraint.type:'FOLLOW_TRACK'
#. :src: bpy.types.POSE_OT_constraint_add.type:'FOLLOW_TRACK'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'FOLLOW_TRACK'
#: source/blender/blenkernel/intern/constraint.cc:5188
msgid "Follow Track"
msgstr "Följ spår"

#. :src: bpy.types.FollowTrackConstraint
msgid "Lock motion to the target motion track"
msgstr "Lås rörelsen till målets rörelsespår"

#. :src: bpy.types.FollowTrackConstraint.use_3d_position
msgid "3D Position"
msgstr "3D-position"

#. :src: bpy.types.FollowTrackConstraint.use_undistorted_position
#. :src: bpy.types.CompositorNodeMovieDistortion.distortion_type:'UNDISTORT'
msgid "Undistort"
msgstr "Korrigera distorsion"
