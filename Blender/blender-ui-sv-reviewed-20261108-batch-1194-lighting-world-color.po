#. :src: bpy.types.CyclesObjectSettings.ao_distance
#: scripts/addons_core/cycles/ui.py:680
msgid "AO Distance"
msgstr "AO-avstånd"

#. :src: bpy.types.CyclesMaterialSettings.use_bump_map_correction
msgid ""
"Apply corrections to solve shadow terminator artifacts caused by bump mapping"
msgstr ""
"Tillämpa korrigeringar för att åtgärda artefakter från skuggterminatorn som "
"orsakas av bumpmappning"

#. :src: bpy.types.CyclesMaterialSettings.use_bump_map_correction
msgid "Bump Map Correction"
msgstr "Korrigering av bumpmappning"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_caster
msgid "Cast Shadow Caustics"
msgstr "Kasta skuggkaustik"

#. :src: bpy.types.WorldMistSettings.depth
msgid "Distance over which the mist effect fades in"
msgstr "Avstånd över vilket dimmeffekten tonas in"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling
msgctxt "Light"
msgid "Emission Sampling"
msgstr "Emissionsprovtagning"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'EQUIANGULAR'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'EQUIANGULAR'
msgid "Equiangular"
msgstr "Likvinklig"

#. :src: bpy.types.CyclesLightSettings.is_portal
msgid "Is Portal"
msgstr "Är portal"

#. :src: bpy.types.WorldLighting
msgid "Lighting for a World data-block"
msgstr "Belysning för ett världsdatablock"

#. :src: bpy.types.WorldMistSettings
msgid "Mist settings for a World data-block"
msgstr "Dimmainställningar för ett världsdatablock"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_receiver
msgid "Receive Shadow Caustics"
msgstr "Ta emot skuggkaustik"

#. :src: bpy.types.CyclesLightSettings.is_caustics_light
#. :src: bpy.types.CyclesWorldSettings.is_caustics_light
#: scripts/addons_core/cycles/ui.py:1765 scripts/addons_core/cycles/ui.py:1567
msgid "Shadow Caustics"
msgstr "Skuggkaustik"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'EQUIANGULAR'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'EQUIANGULAR'
msgid ""
"Use equiangular sampling, best for volumes with low density with light "
"inside or near the volume"
msgstr ""
"Använd likvinklig provtagning, bäst för volymer med låg densitet och ljus "
"inuti eller nära volymen"

#. :src: bpy.types.WorldMistSettings.falloff:'QUADRATIC'
msgid "Use quadratic progression"
msgstr "Använd kvadratisk progression"
