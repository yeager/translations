#. :src: bpy.types.GeometryNodeMeshBoolean
msgid "Mesh Boolean"
msgstr "Boolesk mesh"

#. :src: bpy.types.GeometryNodeMeshCone
msgid "Generate a cone mesh"
msgstr "Skapa en konisk mesh"

#. :src: bpy.types.GeometryNodeMeshCylinder
msgid "Generate a cylinder mesh"
msgstr "Skapa en cylindrisk mesh"

#. :src: bpy.types.GeometryNodeSampleNearestSurface
msgid "Calculate the interpolated value of a mesh attribute on the closest point of its surface"
msgstr "Beräkna det interpolerade värdet för ett meshattribut på den närmaste punkten på dess yta"

#. :src: bpy.types.GeometryNodeSampleUVSurface
msgid "Calculate the interpolated values of a mesh attribute at a UV coordinate"
msgstr "Beräkna de interpolerade värdena för ett meshattribut vid en UV-koordinat"

#. :src: bpy.types.GeometryNodeSetMeshNormal
msgid "Store a normal vector for each mesh element"
msgstr "Lagra en normalvektor för varje meshelement"

#. :src: bpy.types.GeometryNodeSetShadeSmooth
msgid "Control the smoothness of mesh normals around each face by changing the \"shade smooth\" attribute"
msgstr "Styr jämnheten för meshnormaler runt varje yta genom att ändra attributet ”shade smooth”"

#. :src: bpy.types.GeometryNodeToolSetSelection.selection_type:'FLOAT'
msgid "Store floating point selection values. For mesh geometry, stored inverted as the sculpt mode mask"
msgstr "Lagra urvalsvärden som flyttal. För meshgeometri lagras de inverterat som mask för skulpturläge"

#. :src: bpy.types.ShaderNodeAttribute.attribute_type:'OBJECT'
msgid "The attribute is associated with the object or mesh data-block itself, and its value is uniform"
msgstr "Attributet är associerat med själva objektet eller meshdatablocket och värdet är enhetligt"

#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes
msgid "Create mesh plane(s) from image files with the appropriate aspect ratio"
msgstr "Skapa meshplan från bildfiler med lämpligt bildförhållande"

#. :src: bpy.types.MESH_OT_primitive_torus_add
msgid "Construct a torus mesh"
msgstr "Konstruera en torusmesh"
