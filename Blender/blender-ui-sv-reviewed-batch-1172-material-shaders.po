#. :src: bpy.types.ShaderNodeBsdfSheen
msgid "Sheen BSDF"
msgstr "Fiberlyster-BSDF"

#. :src: bpy.types.ShaderNodeBsdfSheen.distribution
msgid "Sheen shading model"
msgstr "Fiberlysterskuggningsmodell"

#. :src: bpy.types.WM_OT_obj_export.export_pbr_extensions
msgid "Export MTL library using PBR extensions (roughness, metallic, sheen, coat, anisotropy, transmission)"
msgstr "Exportera MTL-bibliotek med PBR-tillägg (grovhet, metallisk, fiberlyster, beläggning, anisotropi, transmission)"

#: source/blender/nodes/shader/nodes/node_shader_bsdf_principled.cc:290
msgid "Intensity of the sheen layer, which simulates very small fibers on the surface"
msgstr "Fiberlystrets intensitet, som simulerar mycket små fibrer på ytan"

#: source/blender/nodes/shader/nodes/node_shader_bsdf_principled.cc:299
msgid "Roughness of the sheen layer. Low and high roughness values produce fuzzy or dusty appearance, respectively"
msgstr "Fiberlystrets grovhet. Låga respektive höga grovhetsvärden ger ett luddigt respektive dammigt utseende"

#: source/blender/nodes/shader/nodes/node_shader_bsdf_principled.cc:307
msgid "Color of the sheen reflection"
msgstr "Fiberlysterreflektionens färg"

#: source/blender/nodes/shader/nodes/node_shader_bsdf_principled.cc:315
msgid "Color of light emission from the surface"
msgstr "Emissionsfärg från ytan"

#: source/blender/nodes/shader/nodes/node_shader_bsdf_principled.cc:283
msgid "Sheen"
msgstr "Fiberlyster"

#: source/blender/nodes/shader/nodes/node_shader_bump.cc:44
msgid "Filter width in pixels, used to compute the bump mapping direction. For most textures the default value of 0.1 enables subpixel filtering for stable results. For stepwise textures a larger filter width can be used to get a bevel like effect on the edges"
msgstr "Filterbredd i pixlar som används för att beräkna riktningen för bumpmappning. För de flesta texturer aktiverar standardvärdet 0,1 subpixelfiltrering för stabila resultat. För stegvisa texturer kan en större filterbredd användas för att få en fasliknande effekt på kanterna"

#: source/blender/nodes/shader/nodes/node_shader_vector_transform.cc:29
msgid "Vector, point, or normal which will be used for conversion between spaces"
msgstr "Vektor, punkt eller normal som ska användas för omvandling mellan koordinatrymder"
