#. :src: bpy.types.LineStyleColorModifier_Curvature_3D
msgid "Change line color based on the radial curvature of 3D mesh surfaces"
msgstr "Ändra linjefärg baserat på den radiella krökningen hos 3D-meshytor"

#. :src: bpy.types.GeometryNodeSplitEdges
msgid "Duplicate mesh edges and break connections with the surrounding faces"
msgstr "Duplicera meshkanter och bryt anslutningar till omgivande ytor"

#. :src: bpy.types.MESH_OT_duplicate_move
msgid "Duplicate mesh and move"
msgstr "Duplicera meshen och flytta"

#. :src: bpy.types.PAINT_OT_visibility_filter
msgid "Edit the visibility of the current mesh"
msgstr "Redigera synligheten för den aktuella meshen"

#. :src: bpy.types.PARTICLE_OT_connect_hair
msgid "Connect hair to the emitter mesh"
msgstr "Anslut håret till emittermeshen"

#. :src: bpy.types.PARTICLE_OT_connect_hair.all
msgid "Connect all hair systems to the emitter mesh"
msgstr "Anslut alla hårsystem till emittermeshen"

#. :src: bpy.types.SCULPT_OT_mask_from_boundary.boundary_mode:'MESH'
msgid "Calculate the boundary mask based on disconnected mesh topology islands"
msgstr "Beräkna gränsmasken baserat på frånkopplade topologiöar i meshen"

#. :src: bpy.types.Sculpt.detail_refine_method:'COLLAPSE'
msgid "Collapse short edges to remove mesh detail where possible"
msgstr "Fäll ihop korta kanter för att ta bort meshdetaljer där det är möjligt"

msgid "Canvas mesh not updated"
msgstr "Dukmeshen uppdaterades inte"

msgid "Click on the mesh to set the detail"
msgstr "Klicka på meshen för att ställa in detaljerna"

msgid "Emit fluid from mesh surface or volume"
msgstr "Avge vätska från meshens yta eller volym"

#. :src: Socket description from node group Cloth Dynamics (Experimental), file geometry_nodes_dynamics_assets.blend
msgid "Enable dynamic tearing of the mesh."
msgstr "Aktiverar dynamisk sönderrivning av meshen."
