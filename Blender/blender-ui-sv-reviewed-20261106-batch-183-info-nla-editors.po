#. :src: bpy.types.SpaceInfo
msgid "Space Info"
msgstr "Informationsområde"

#. :src: bpy.types.SpaceInfo
msgid "Info space data"
msgstr "Områdesdata för informationsredigeraren"

#. :src: bpy.types.SpaceInfo.show_report_debug
msgid "Show Debug"
msgstr "Visa felsökning"

#. :src: bpy.types.SpaceInfo.show_report_debug
msgid "Display debug reporting info"
msgstr "Visa information om felsökningsrapporter"

#. :src: bpy.types.SpaceInfo.show_report_error
msgid "Show Error"
msgstr "Visa fel"

#. :src: bpy.types.SpaceInfo.show_report_error
msgid "Display error text"
msgstr "Visa feltext"

#. :src: bpy.types.SpaceInfo.show_report_info
msgid "Show Info"
msgstr "Visa information"

#. :src: bpy.types.SpaceInfo.show_report_info
msgid "Display general information"
msgstr "Visa allmän information"

#. :src: bpy.types.SpaceInfo.show_report_operator
msgid "Show Operator"
msgstr "Visa operatör"

#. :src: bpy.types.SpaceInfo.show_report_operator
msgid "Display the operator log"
msgstr "Visa operatörsloggen"

#. :src: bpy.types.SpaceInfo.show_report_warning
msgid "Show Warn"
msgstr "Visa varning"

#. :src: bpy.types.SpaceInfo.show_report_warning
msgid "Display warnings"
msgstr "Visa varningar"

#. :src: bpy.types.SpaceNLA
msgid "Space Nla Editor"
msgstr "NLA-redigerarens område"

#. :src: bpy.types.SpaceNLA
msgid "NLA editor space data"
msgstr "Områdesdata för NLA-redigeraren"

#. :src: bpy.types.SpaceNLA.show_local_markers
msgid "Show Local Markers"
msgstr "Visa lokala markörer"

#. :src: bpy.types.SpaceNLA.show_local_markers
msgid ""
"Show action-local markers on the strips, useful when synchronizing timing "
"across strips"
msgstr ""
"Visa åtgärdslokala markörer på remsorna, vilket är användbart vid "
"synkronisering av tidpunkter mellan remsor"

#. :src: bpy.types.SpaceNLA.show_strip_curves
msgid "Show Control F-Curves"
msgstr "Visa kontroll-F-kurvor"

#. :src: bpy.types.SpaceNLA.show_strip_curves
msgid "Show influence F-Curves on strips"
msgstr "Visa påverkans-F-kurvor på remsor"

#. :src: bpy.types.SpaceNLA.use_realtime_update
msgid ""
"When transforming strips, changes to the animation data are flushed to other "
"views"
msgstr ""
"När du transformerar remsor skickas ändringar i animationsdata till andra "
"vyer"
