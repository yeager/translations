#. :src: bpy.types.CompositorNodeSequencerStripInfo
msgid "Sequencer Strip Info"
msgstr "Information om remsor i sekvensredigeraren"

#. :src: bpy.types.USERPREF_PT_theme_strip_colors
msgid "Sequencer Strip Color Tags"
msgstr "Färgetiketter för remsor i sekvensredigeraren"

#. :src: bpy.types.RenderSettings.use_sequencer
msgid ""
"Process the render (and composited) result through the video sequence editor "
"pipeline, if sequencer strips exist"
msgstr ""
"Bearbeta renderingsresultatet (och det kompositerade resultatet) genom "
"bearbetningskedjan i videosekvensredigeraren, om remsor finns där"

#. :src: bpy.types.StripModifier.input_mask_type:'STRIP'
msgid "Use sequencer strip as mask input"
msgstr "Använd en remsa i sekvensredigeraren som maskindata"

#: source/blender/makesrna/intern/rna_space.cc:3033
msgid "Edit compositing node group for Sequencer strip modifiers"
msgstr ""
"Redigera kompositeringsnodgrupp för modifierare av remsor i sekvensredigeraren"
