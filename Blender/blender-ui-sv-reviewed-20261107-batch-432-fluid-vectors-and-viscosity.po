msgid "Display Type"
msgstr "Visningstyp"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'NEEDLE'
msgid "Needle"
msgstr "Nål"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'NEEDLE'
msgid "Display vectors as needles"
msgstr "Visa vektorer som nålar"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'STREAMLINE'
msgid "Display vectors as streamlines"
msgstr "Visa vektorer som strömlinjer"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'MAC'
msgid "Display vector field as MAC grid"
msgstr "Visa vektorfält som MAC-rutnät"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FLUID_VELOCITY'
msgid "Fluid Velocity"
msgstr "Vätskehastighet"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FLUID_VELOCITY'
msgid "Velocity field of the fluid domain"
msgstr "Hastighetsfält för vätskedomänen"

#. :src: bpy.types.FluidDomainSettings.vector_field:'GUIDE_VELOCITY'
msgid "Guide Velocity"
msgstr "Styrhastighet"

#. :src: bpy.types.FluidDomainSettings.vector_field:'GUIDE_VELOCITY'
msgid "Guide velocity field of the fluid domain"
msgstr "Styrhastighetsfältet i vätskedomänen"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FORCE'
msgid "Force field of the fluid domain"
msgstr "Kraftfält för vätskedomänen"

#. :src: bpy.types.FluidDomainSettings.vector_scale
msgid "Multiplier for scaling the vectors"
msgstr "Multiplikator för skalning av vektorerna"

#. :src: bpy.types.FluidDomainSettings.vector_scale_with_magnitude
msgid "Magnitude"
msgstr "Belopp"

#. :src: bpy.types.FluidDomainSettings.vector_scale_with_magnitude
msgid "Scale vectors with their magnitudes"
msgstr "Skala vektorer efter deras belopp"

#. :src: bpy.types.FluidDomainSettings.velocity_scale
#. :src: bpy.types.Volume.velocity_scale
#. :src: bpy.types.MeshSequenceCacheModifier.velocity_scale
msgid "Velocity Scale"
msgstr "Hastighetsskala"

#. :src: bpy.types.FluidDomainSettings.velocity_scale
#. :src: bpy.types.Volume.velocity_scale
msgid "Factor to control the amount of motion blur"
msgstr "Faktor för att kontrollera mängden rörelseoskärpa"

#. :src: bpy.types.FluidDomainSettings.viscosity_base
msgid "Viscosity Base"
msgstr "Viskositetsbas"

#. :src: bpy.types.FluidDomainSettings.viscosity_base
msgid ""
"Viscosity setting: value that is multiplied by 10 to the power of "
"(exponent*-1)"
msgstr ""
"Viskositetsinställning: ett värde som multipliceras med 10 upphöjt till "
"(exponent * -1)"

#. :src: bpy.types.FluidDomainSettings.viscosity_exponent
msgid "Viscosity Exponent"
msgstr "Exponent för viskositet"

#. :src: bpy.types.FluidDomainSettings.viscosity_exponent
msgid ""
"Negative exponent for the viscosity value (to simplify entering small values "
"e.g. 5*10^-6)"
msgstr ""
"Negativ exponent för viskositetsvärdet (för att förenkla inmatning av små "
"värden, t.ex. 5*10^-6)"

#. :src: bpy.types.FluidDomainSettings.viscosity_value
msgid ""
"Viscosity of liquid (higher values result in more viscous fluids, a value of "
"0 will still apply some viscosity)"
msgstr ""
"Vätskans viskositet (högre värden ger mer trögflytande vätskor, ett värde på "
"0 ger fortfarande viss viskositet)"

#. :src: bpy.types.FluidDomainSettings.vorticity
msgid "Amount of turbulence and rotation in smoke"
msgstr "Mängd turbulens och rotation i rök"
