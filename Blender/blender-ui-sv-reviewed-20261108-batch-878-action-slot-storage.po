#. :src: bpy.types.AnimData.action_slot_handle
#. :src: bpy.types.ActionConstraint.action_slot_handle
#. :src: bpy.types.NlaStrip.action_slot_handle
msgid "Action Slot Handle"
msgstr "Handtag för Action-slot"

#. :src: bpy.types.AnimData.action_slot_handle_tweak_storage
msgid "Tweak Mode Action Slot Storage"
msgstr "Lagring för Action-slot i justeringsläge"

#. :src: bpy.types.AnimData.action_slot_handle_tweak_storage
msgid "Storage to temporarily hold the main action slot while in tweak mode"
msgstr ""
"Lagring för att tillfälligt behålla huvud-Action-slotten i justeringsläge"

#. :src: bpy.types.AnimData.action_suitable_slots
msgid "The list of slots in this animation data-block"
msgstr "Listan över Action-slotar i det här animationsdatablocket"

#. :src: bpy.types.AnimData.last_slot_identifier
#. :src: bpy.types.ActionConstraint.last_slot_identifier
#. :src: bpy.types.NlaStrip.last_slot_identifier
msgid "Last Action Slot Identifier"
msgstr "Identifierare för den senast tilldelade Action-slotten"

#. :src: bpy.types.ActionConstraint.action_suitable_slots
#. :src: bpy.types.NlaStrip.action_suitable_slots
msgid "The list of action slots suitable for this NLA strip"
msgstr "Listan över Action-slotar som lämpar sig för denna NLA-remsa"

#. :src: bpy.types.ANIM_OT_slot_new_for_id
msgid "Create a new action slot for this data-block, to hold its animation"
msgstr ""
"Skapa en ny Action-slot för detta datablock för att lagra dess animering"

#. :src: bpy.types.ANIM_OT_slot_unassign_from_constraint
msgid "Un-assign the action slot from this constraint"
msgstr "Ta bort tilldelningen av Action-slotten från denna begränsning"

#. :src: bpy.types.ANIM_OT_slot_unassign_from_id
msgid ""
"Un-assign the action slot, effectively making this data-block non-animated"
msgstr ""
"Ta bort tilldelningen av Action-slotten, vilket innebär att detta datablock "
"inte längre animeras"

#. :src: bpy.types.ANIM_OT_slot_unassign_from_nla_strip
msgid ""
"Un-assign the action slot from this NLA strip, effectively making it non-"
"animated"
msgstr ""
"Ta bort tilldelningen av Action-slotten från denna NLA-remsa, vilket innebär "
"att den inte längre animeras"
