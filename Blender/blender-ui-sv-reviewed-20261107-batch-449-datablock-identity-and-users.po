#. :src: bpy.types.ID.name
msgid "Unique data-block ID name (within a same type and library)"
msgstr "Unikt ID-namn för datablock (inom samma typ och bibliotek)"

#. :src: bpy.types.ID.name_full
msgid "Unique data-block ID name, including library one is any"
msgstr "Unikt ID-namn för datablock, inklusive biblioteket om ett sådant finns"

#. :src: bpy.types.ID.original
msgid "Original ID"
msgstr "Ursprungligt ID"

#. :src: bpy.types.ID.original
msgid ""
"Actual data-block from .blend file (Main database) that generated that "
"evaluated one"
msgstr ""
"Det datablock i .blend-filen (huvuddatabasen) som skapade den utvärderade "
"varianten"

#. :src: bpy.types.ID.override_library
#. :src: bpy.types.Menu
#. :src: bpy.types.OUTLINER_MT_liboverride
#. :src: bpy.types.VIEW3D_MT_object_liboverride
#: source/blender/editors/interface/interface_context_menu.cc:1128
#: source/blender/editors/interface/interface_ops.cc:1024
msgid "Library Override"
msgstr "Biblioteksåsidosättning"

#. :src: bpy.types.ID.override_library
msgid "Library override data"
msgstr "Data för biblioteksåsidosättning"

#. :src: bpy.types.ID.preview
msgid ""
"Preview image and icon of this data-block (always None if not supported for "
"this type of data)"
msgstr ""
"Förhandsgranskningsbild och ikon för detta datablock (alltid None om det "
"inte stöds för denna typ av data)"

