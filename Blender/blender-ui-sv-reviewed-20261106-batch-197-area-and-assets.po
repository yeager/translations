#. :src: bpy.types.ArmatureConstraintTargets
msgid "Armature Deform Constraint Targets"
msgstr "Mål för begränsningar vid armaturdeformering"

#. :src: bpy.types.ArmatureConstraintTargets
msgid "Collection of target bones and weights"
msgstr "Samling av målben och vikter"

#. :src: bpy.types.ArmatureEditBones
msgid "Armature EditBones"
msgstr "Armaturens redigeringsben"

#. :src: bpy.types.ArmatureEditBones
msgid "Collection of armature edit bones"
msgstr "Samling av armaturens redigeringsben"

#. :src: bpy.types.ArmatureEditBones.active
msgid "Active EditBone"
msgstr "Aktivt redigeringsben"

#. :src: bpy.types.ArmatureEditBones.active
msgid "Armatures active edit bone"
msgstr "Armaturens aktiva redigeringsben"

#. :src: bpy.types.AssetLibraryCollection
msgid "User Asset Libraries"
msgstr "Användarresursbibliotek"

#. :src: bpy.types.AssetLibraryCollection
msgid "Collection of user asset libraries"
msgstr "Samling av användarresursbibliotek"

#. :src: bpy.types.AssetLibraryReference
msgid "Asset Library Reference"
msgstr "Referens till resursbibliotek"

#. :src: bpy.types.AssetLibraryReference
msgid "Identifier to refer to the asset library"
msgstr "Identifierare som refererar till resursbiblioteket"

#. :src: bpy.types.AssetMetaData
#. :src: bpy.types.FileSelectEntry.asset_data
#. :src: bpy.types.ID.asset_data
msgid "Asset Data"
msgstr "Tillgångsdata"

#. :src: bpy.types.AssetMetaData
msgid "Additional data stored for an asset data-block"
msgstr "Ytterligare data som lagras för ett tillgångsdatablock"

#. :src: bpy.types.AssetMetaData.active_tag
msgid "Index of the tag set for editing"
msgstr "Index för den tagg som är inställd för redigering"

#. :src: bpy.types.AssetMetaData.catalog_id
msgid ""
"Identifier for the asset's catalog, used by Blender to look up the asset's "
"catalog path. Must be a UUID according to RFC4122."
msgstr ""
"Identifierare för tillgångens katalog. Blender använder den för att slå upp "
"tillgångens katalogsökväg. Måste vara en UUID enligt RFC 4122."

#. :src: bpy.types.AssetMetaData.catalog_simple_name
msgid "Catalog Simple Name"
msgstr "Katalogens enkla namn"

#. :src: bpy.types.AssetMetaData.copyright
msgid ""
"Copyright notice for this asset. An empty copyright notice does not "
"necessarily indicate that this is copyright-free. Contact the author if any "
"clarification is needed."
msgstr ""
"Upphovsrättsmeddelande för denna tillgång. Ett tomt meddelande betyder inte "
"nödvändigtvis att den är fri från upphovsrätt. Kontakta skaparen om något "
"behöver klargöras."

#. :src: bpy.types.AssetMetaData.license
msgid ""
"The type of license this asset is distributed under. An empty license name "
"does not necessarily indicate that this is free of licensing terms. Contact "
"the author if any clarification is needed."
msgstr ""
"Typ av licens som denna tillgång distribueras under. Ett tomt licensnamn "
"betyder inte nödvändigtvis att den är fri från licensvillkor. Kontakta "
"skaparen om något behöver klargöras."

#. :src: bpy.types.AssetRepresentation
msgid "Asset Representation"
msgstr "Tillgångsrepresentation"

#. :src: bpy.types.AssetRepresentation
msgid ""
"Information about an entity that makes it possible for the asset system to "
"deal with the entity as asset"
msgstr ""
"Information om en enhet som gör det möjligt för tillgångssystemet att "
"hantera enheten som en tillgång"

#. :src: bpy.types.AssetShelf
msgid "Regions for quick access to assets"
msgstr "Områden för snabb åtkomst till tillgångar"

#. :src: bpy.types.AssetShelf.asset_library_reference
#. :src: bpy.types.FileAssetSelectParams.asset_library_reference
#. :src: bpy.types.WorkSpace.asset_library_reference
#. :src: bpy.types.UserAssetLibrary
msgid "Asset Library"
msgstr "Resursbibliotek"

#. :src: bpy.types.AssetShelf.asset_library_reference
msgid "Choose the asset library to display assets from"
msgstr "Välj ett resursbibliotek att visa tillgångar från"

#. :src: bpy.types.AssetShelf.asset_library_reference:'ALL'
#. :src: bpy.types.AssetWeakReference.asset_library_type:'ALL'
#. :src: bpy.types.FileAssetSelectParams.asset_library_reference:'ALL'
#. :src: bpy.types.WorkSpace.asset_library_reference:'ALL'
#. :src: bpy.types.BRUSH_OT_asset_activate.asset_library_type:'ALL'
#. :src: bpy.types.GEOMETRY_OT_execute_node_group.asset_library_type:'ALL'
#. :src: bpy.types.NODE_OT_add_group_asset.asset_library_type:'ALL'
#. :src: bpy.types.OBJECT_OT_modifier_add_node_group.asset_library_type:'ALL'
msgid "Show assets from all of the listed asset libraries"
msgstr "Visa tillgångar från alla de listade resursbiblioteken"

#. :src: bpy.types.AssetShelf.asset_library_reference:'CUSTOM'
#. :src: bpy.types.AssetWeakReference.asset_library_type:'CUSTOM'
#. :src: bpy.types.FileAssetSelectParams.asset_library_reference:'CUSTOM'
#. :src: bpy.types.WorkSpace.asset_library_reference:'CUSTOM'
#. :src: bpy.types.BRUSH_OT_asset_activate.asset_library_type:'CUSTOM'
#. :src: bpy.types.GEOMETRY_OT_execute_node_group.asset_library_type:'CUSTOM'
#. :src: bpy.types.NODE_OT_add_group_asset.asset_library_type:'CUSTOM'
#. :src: bpy.types.OBJECT_OT_modifier_add_node_group.asset_library_type:'CUSTOM'
msgid "Show assets from the asset libraries configured in the Preferences"
msgstr ""
"Visa tillgångar från de resursbibliotek som har konfigurerats i Inställningar"

#. :src: bpy.types.AssetShelf.bl_activate_operator
msgid "Activate Operator"
msgstr "Aktiveringsoperator"

#. :src: bpy.types.AssetShelf.bl_activate_operator
msgid ""
"Operator to call when activating an item with asset reference properties"
msgstr ""
"Operator som ska anropas när ett objekt med tillgångsreferensegenskaper "
"aktiveras"

#. :src: bpy.types.AssetShelf.bl_default_preview_size
msgid "Default Preview Size"
msgstr "Standardstorlek för förhandsvisning"

#. :src: bpy.types.AssetShelf.bl_default_preview_size
msgid "Default size of the asset preview thumbnails in pixels"
msgstr "Standardstorlek för tillgångarnas förhandsvisningsminiatyrer i pixlar"

#. :src: bpy.types.AssetShelf.bl_idname
msgid ""
"If this is set, the asset gets a custom ID, otherwise it takes the name of "
"the class used to define the asset (for example, if the class name is "
"\"OBJECT_AST_hello\", and bl_idname is not set by the script, then bl_idname "
"= \"OBJECT_AST_hello\")"
msgstr ""
"Om detta är inställt får tillgången ett eget ID, annars får den namnet på "
"den klass som används för att definiera tillgången (om klassnamnet t.ex. är "
"\"OBJECT_AST_hello\" och bl_idname inte är inställt av skriptet, blir "
"bl_idname = \"OBJECT_AST_hello\")"

#. :src: bpy.types.AssetShelf.bl_options:'NO_ASSET_DRAG'
msgid "No Asset Dragging"
msgstr "Ingen dragning av tillgångar"

#. :src: bpy.types.AssetShelf.bl_options:'NO_ASSET_DRAG'
msgid ""
"Disable the default asset dragging on drag events. Useful for implementing "
"custom dragging via custom key-map items."
msgstr ""
"Inaktivera standarddragning av tillgångar vid draghändelser. Användbart för "
"att implementera anpassad dragning via anpassade tangentmappningsposter."

#. :src: bpy.types.AssetShelf.bl_options:'DEFAULT_VISIBLE'
msgid "Visible by Default"
msgstr "Synlig som standard"

#. :src: bpy.types.AssetShelf.bl_options:'DEFAULT_VISIBLE'
msgid ""
"Unhide the asset shelf when it's available for the first time, otherwise it "
"will be hidden"
msgstr ""
"Visa tillgångshyllan när den blir tillgänglig första gången, annars är den "
"dold"

#. :src: bpy.types.AssetShelf.bl_options:'STORE_ENABLED_CATALOGS_IN_PREFERENCES'
msgid "Store Enabled Catalogs in Preferences"
msgstr "Lagra aktiverade kataloger i Inställningar"

#. :src: bpy.types.AssetShelf.bl_options:'STORE_ENABLED_CATALOGS_IN_PREFERENCES'
msgid ""
"Store the shelf's enabled catalogs in the preferences rather than the local "
"asset shelf settings"
msgstr ""
"Lagra hyllans aktiverade kataloger i inställningarna i stället för i hyllans "
"lokala inställningar"

#. :src: bpy.types.AssetShelf.bl_space_type
#. :src: bpy.types.GizmoGroup.bl_space_type
#. :src: bpy.types.KeyMap.space_type
#. :src: bpy.types.WorkSpaceTool.space_type
msgid "Space Type"
msgstr "Redigerarlägestyp"

#. :src: bpy.types.AssetShelf.bl_space_type
msgid "The space where the asset shelf is going to be used in"
msgstr "Det redigerarläge där tillgångshyllan ska användas"

#. :src: bpy.types.AssetShelf.preview_size
#: scripts/startup/bl_ui/space_filebrowser.py:616
msgid "Preview Size"
msgstr "Förhandsvisningsstorlek"

#. :src: bpy.types.AssetShelf.search_filter
#. :src: bpy.types.SpaceOutliner.filter_text
#. :src: bpy.types.SpaceProperties.search_filter
msgid "Display Filter"
msgstr "Visningsfilter"

#. :src: bpy.types.AssetShelf.search_filter
msgid "Filter assets by name"
msgstr "Filtrera tillgångar efter namn"

#. :src: bpy.types.AssetShelf.show_names
msgid ""
"Show the asset name together with the preview. Otherwise only the preview "
"will be visible."
msgstr ""
"Visa tillgångens namn tillsammans med förhandsvisningen. Annars visas bara "
"förhandsvisningen."

#. :src: bpy.types.AssetWeakReference
msgid "Asset Weak Reference"
msgstr "Svag tillgångsreferens"

#. :src: bpy.types.AssetWeakReference
msgid "Weak reference to some asset"
msgstr "Svag referens till en tillgång"
