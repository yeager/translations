#. :src: bpy.types.BrushGpencilSettings.simplify_pixel_threshold
msgid ""
"Threshold in screen space used for the simplify algorithm. Points within "
"this threshold are treated as if they were in a straight line."
msgstr ""
"Tröskelvärde i skärmrymden för förenklingsalgoritmen. Punkter inom "
"tröskelvärdet behandlas som om de låg på en rak linje."

#. :src: bpy.types.ASSET_OT_screenshot_preview.p1
msgid "First point of the screenshot in screenspace"
msgstr "Första punkten på skärmdumpen i skärmrymden"

#. :src: bpy.types.ASSET_OT_screenshot_preview.p2
msgid "Second point of the screenshot in screenspace"
msgstr "Andra punkten på skärmdumpen i skärmrymden"

