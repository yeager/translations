#. :src: bpy.types.FollowTrackConstraint.depth_object
msgid ""
"Object used to define depth in camera space by projecting onto surface of "
"this object"
msgstr ""
"Objekt som används för att definiera djup i kamerarymden genom att projicera "
"på det här objektets yta"

#. :src: bpy.types.MeshCacheModifier.deform_mode:'OVERWRITE'
msgid "Replace vertex coordinates with cached values"
msgstr "Ersätt hörnpunktskoordinater med cachelagrade värden"

#. :src: bpy.types.IMAGE_OT_read_viewlayers
msgctxt "Operator"
msgid "Open Cached Render"
msgstr "Öppna cachelagrad rendering"

#. :src: bpy.types.OBJECT_OT_lightprobe_cache_free
msgid "Delete cached indirect lighting"
msgstr "Ta bort cachelagrad indirekt belysning"

#. :src: bpy.types.OBJECT_OT_simulation_nodes_cache_delete
msgctxt "Operator"
msgid "Delete Cached Simulation"
msgstr "Ta bort cachelagrad simulering"

#. :src: bpy.types.OBJECT_OT_simulation_nodes_cache_delete
msgid "Delete cached/baked simulations in geometry nodes modifiers"
msgstr "Ta bort cachelagrade/bakade simuleringar i geometrinodmodifierare"

#. :src: bpy.types.PointCache.frame_step
#. :src: bpy.types.PointCacheItem.frame_step
msgid "Number of frames between cached frames"
msgstr "Antal bildrutor mellan cachelagrade bildrutor"
