msgid "'Integrate' only valid for Mesh objects"
msgstr "”Integrera” gäller endast för meshobjekt"

msgid "Active object is not a mesh"
msgstr "Det aktiva objektet är inte ett meshobjekt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_apply
msgid ""
"Apply modifiers (excluding Armatures) to mesh objects -WARNING: prevents "
"exporting shape keys"
msgstr ""
"Tillämpa modifierare (utom armaturmodifierare) på meshobjekt – VARNING: "
"förhindrar export av formnycklar"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_mesh_modifiers
msgid ""
"Apply modifiers to mesh objects (except Armature ones) - WARNING: prevents "
"exporting shape keys"
msgstr ""
"Tillämpa modifierare på meshobjekt (utom armaturmodifierare) – VARNING: "
"förhindrar export av formnycklar"

msgid "Baking of multires data only works with an active mesh object"
msgstr "Beräkning av multires-data fungerar bara med ett aktivt meshobjekt"

msgid "Both objects must be meshes"
msgstr "Båda objekten måste vara meshobjekt"

msgid "Cannot execute, the selected collection contains non mesh objects"
msgstr ""
"Det går inte att utföra; den valda samlingen innehåller objekt som inte är "
"meshobjekt"

#. :src: bpy.types.OBJECT_OT_modifier_convert
msgid "Convert particles to a mesh object"
msgstr "Konvertera partiklar till ett meshobjekt"

msgid "Curves must have a mesh surface object set"
msgstr "Kurvor måste ha ett meshobjekt som yta angivet"

#. :src: bpy.types.SCENE_OT_freestyle_fill_range_by_selection
msgid ""
"Fill the Range Min/Max entries by the min/max distance between selected mesh "
"objects and the source object (either a user-specified object or the active "
"camera)"
msgstr ""
"Fyll i Min-/Max-fälten med minimi-/maximiavståndet mellan valda meshobjekt "
"och källobjektet (antingen ett användardefinierat objekt eller den aktiva "
"kameran)"

#. :src: bpy.types.OBJECT_OT_modifier_apply.merge_customdata
msgid ""
"For mesh objects, merge UV coordinates that share a vertex to account for "
"imprecision in some modifiers"
msgstr ""
"För meshobjekt, slå samman UV-koordinater som delar en hörnpunkt för att "
"kompensera för bristande precision i vissa modifierare"

#. :src: bpy.types.GreasePencilLineartModifier.source_vertex_group
msgid ""
"Match the beginning of vertex group names from mesh objects, match all when "
"left empty"
msgstr ""
"Matcha början av hörnpunktsgruppsnamn från meshobjekt; matcha alla när "
"fältet lämnas tomt"

#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.name_from
msgid "Name for new mesh object and material"
msgstr "Namn på nytt meshobjekt och material"

msgid "No active mesh object"
msgstr "Inget aktivt meshobjekt"

msgid "No valid target mesh"
msgstr "Ingen giltig målmesh"

#. :src: bpy.types.UV_OT_smart_project
msgid "Projection unwraps the selected faces of mesh objects"
msgstr "Projektionen vecklar ut markerade ytor på meshobjekt"

msgid "Second selected mesh object required to copy shape from"
msgstr "Ett andra valt meshobjekt krävs för att kopiera formen"

msgid "Skipping '{:s}', not a mesh"
msgstr "Hoppar över ”{:s}” eftersom det inte är ett meshobjekt"
