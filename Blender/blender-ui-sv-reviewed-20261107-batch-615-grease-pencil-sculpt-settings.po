#. :src: bpy.types.GPencilSculptSettings
msgid "GPencil Sculpt Settings"
msgstr "Skulpteringsinställningar för Grease Pencil"

#. :src: bpy.types.GPencilSculptSettings
msgid "General properties for Grease Pencil stroke sculpting tools"
msgstr "Allmänna egenskaper för skulpteringsverktyg för Grease Pencil-streck"

#. :src: bpy.types.GPencilSculptSettings.intersection_threshold
msgid "Threshold for stroke intersections"
msgstr "Tröskelvärde för streckkorsningar"

#. :src: bpy.types.GPencilSculptSettings.lock_axis
msgid "Lock Axis"
msgstr "Lås axel"

#. :src: bpy.types.GPencilSculptSettings.lock_axis:'VIEW'
msgid "Align strokes to current view plane"
msgstr "Rikta strecken mot aktuellt vyplan"

#. :src: bpy.types.GPencilSculptSettings.lock_axis:'AXIS_Y'
msgid "Front (X-Z)"
msgstr "Fram (X-Z)"

#. :src: bpy.types.GPencilSculptSettings.lock_axis:'AXIS_X'
msgid "Side (Y-Z)"
msgstr "Sida (Y-Z)"

#. :src: bpy.types.GPencilSculptSettings.lock_axis:'AXIS_Z'
msgid "Top (X-Y)"
msgstr "Topp (X-Y)"

#. :src: bpy.types.GPencilSculptSettings.lock_axis:'CURSOR'
msgid "Align strokes to current 3D cursor orientation"
msgstr "Rikta strecken efter den aktuella 3D-markörens orientering"

#. :src: bpy.types.GPencilSculptSettings.multiframe_falloff_curve
msgid "Custom curve to control falloff of brush effect by Grease Pencil frames"
msgstr ""
"Anpassad kurva för att styra penselns avtagande över Grease Pencil-bildrutor"

#. :src: bpy.types.GPencilSculptSettings.thickness_primitive_curve
msgid "Custom curve to control primitive thickness"
msgstr "Anpassad kurva för att styra tjockleken på primitivet"
