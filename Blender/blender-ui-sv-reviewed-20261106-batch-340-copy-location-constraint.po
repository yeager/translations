msgstr "Följ B-Bone-segmentens form när benhuvuds-/benspetspositionen beräknas"

#. :src: bpy.types.CopyLocationConstraint.use_offset
msgid "Add original location into copied location"
msgstr "Lägg till den ursprungliga positionen i den kopierade positionen"
