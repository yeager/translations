#. :src: bpy.types.AnimViz.motion_path
msgid "Motion Path settings for visualization"
msgstr "Inställningar för rörelsebanor vid visualisering"

#. :src: bpy.types.AnimVizMotionPaths
msgid "Motion Path Settings"
msgstr "Inställningar för rörelsebanor"

#. :src: bpy.types.AnimVizMotionPaths
msgid "Motion Path settings for animation visualization"
msgstr "Inställningar för rörelsebanor vid animationsvisualisering"

#. :src: bpy.types.AnimVizMotionPaths.bake_location
#. :src: bpy.types.POSE_OT_paths_calculate.bake_location
msgid "Bake Location"
msgstr "Beräkningsposition"

#. :src: bpy.types.AnimVizMotionPaths.bake_location
msgid "When calculating Bone Paths, use Head or Tips"
msgstr "När benbanor beräknas, använd benhuvuden eller benspetsar"

#. :src: bpy.types.AnimVizMotionPaths.bake_location:'HEADS'
#. :src: bpy.types.POSE_OT_paths_calculate.bake_location:'HEADS'
msgid "Heads"
msgstr "Benhuvuden"

#. :src: bpy.types.AnimVizMotionPaths.bake_location:'HEADS'
#. :src: bpy.types.POSE_OT_paths_calculate.bake_location:'HEADS'
msgid "Calculate bone paths from heads"
msgstr "Beräkna benbanor från benhuvudena"

#. :src: bpy.types.AnimVizMotionPaths.bake_location:'TAILS'
#. :src: bpy.types.POSE_OT_paths_calculate.bake_location:'TAILS'
msgid "Tails"
msgstr "Benspetsar"

#. :src: bpy.types.AnimVizMotionPaths.bake_location:'TAILS'
#. :src: bpy.types.POSE_OT_paths_calculate.bake_location:'TAILS'
msgid "Calculate bone paths from tails"
msgstr "Beräkna benbanor från benspetsarna"

#. :src: bpy.types.AnimVizMotionPaths.frame_after
msgid ""
"Number of frames to show after the current frame (only for 'Around Frame' "
"Onion-skinning method)"
msgstr ""
"Antal bildrutor som ska visas efter den aktuella bildrutan (endast för "
"lökskalningsmetoden \"Around Frame\")"

#. :src: bpy.types.AnimVizMotionPaths.frame_before
msgid ""
"Number of frames to show before the current frame (only for 'Around Frame' "
"Onion-skinning method)"
msgstr ""
"Antal bildrutor som ska visas före den aktuella bildrutan (endast för "
"lökskalningsmetoden \"Around Frame\")"

#. :src: bpy.types.AnimVizMotionPaths.frame_end
msgid ""
"End frame of range of paths to display/calculate (not for 'Around Frame' "
"Onion-skinning method)"
msgstr ""
"Slutbildruta för intervallet av banor som ska visas eller beräknas (inte för "
"lökskalningsmetoden \"Around Frame\")"

#. :src: bpy.types.AnimVizMotionPaths.frame_start
msgid ""
"Starting frame of range of paths to display/calculate (not for 'Around "
"Frame' Onion-skinning method)"
msgstr ""
"Startbildruta för intervallet av banor som ska visas eller beräknas (inte "
"för lökskalningsmetoden \"Around Frame\")"

#. :src: bpy.types.AnimVizMotionPaths.frame_step
msgid ""
"Number of frames between paths shown (not for 'On Keyframes' Onion-skinning "
"method)"
msgstr ""
"Antal bildrutor mellan visade banor (inte för lökskalningsmetoden \"On "
"Keyframes\")"

#. :src: bpy.types.AnimVizMotionPaths.has_motion_paths
msgid "Has Motion Paths"
msgstr "Har rörelsebanor"

#. :src: bpy.types.AnimVizMotionPaths.has_motion_paths
msgid "Are there any bone paths that will need updating (read-only)"
msgstr ""
"Finns det några benbanor som kommer att behöva uppdateras (skrivskyddad)"

#. :src: bpy.types.AnimVizMotionPaths.range
msgid "Paths Range"
msgstr "Intervall för banor"

#. :src: bpy.types.AnimVizMotionPaths.range
msgid "Type of range to calculate for Motion Paths"
msgstr "Typ av intervall som ska beräknas för rörelsebanor"

#. :src: bpy.types.AnimVizMotionPaths.range:'KEYS_ALL'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'KEYS_ALL'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'KEYS_ALL'
msgid "All Keys"
msgstr "Alla nyckelbildrutor"

#. :src: bpy.types.AnimVizMotionPaths.range:'KEYS_ALL'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'KEYS_ALL'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'KEYS_ALL'
msgid "From the first keyframe to the last"
msgstr "Från den första nyckelbildrutan till den sista"

#. :src: bpy.types.AnimVizMotionPaths.range:'KEYS_SELECTED'
#. :src: bpy.types.OBJECT_OT_paste_transform.method:'EXISTING_KEYS'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'KEYS_SELECTED'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'KEYS_SELECTED'
msgid "Selected Keys"
msgstr "Markerade nyckelbildrutor"

#. :src: bpy.types.AnimVizMotionPaths.range:'KEYS_SELECTED'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'KEYS_SELECTED'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'KEYS_SELECTED'
msgid "From the first selected keyframe to the last"
msgstr "Från den första markerade nyckelbildrutan till den sista"

#. :src: bpy.types.AnimVizMotionPaths.range:'SCENE'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'SCENE'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'SCENE'
msgid "Scene Frame Range"
msgstr "Scenens bildruteintervall"

#. :src: bpy.types.AnimVizMotionPaths.range:'SCENE'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'SCENE'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'SCENE'
msgid "The entire Scene / Preview range"
msgstr "Hela scen-/förhandsgranskningsområdet"

#. :src: bpy.types.AnimVizMotionPaths.range:'MANUAL'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'MANUAL'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'MANUAL'
msgid "Manual Range"
msgstr "Manuellt intervall"

#. :src: bpy.types.AnimVizMotionPaths.range:'MANUAL'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'MANUAL'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'MANUAL'
msgid "Manually determined frame range"
msgstr "Manuellt angivet bildruteintervall"

#. :src: bpy.types.AnimVizMotionPaths.show_frame_numbers
msgid "Show frame numbers on Motion Paths"
msgstr "Visa bildrutenummer på rörelsebanor"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_action_all
msgid ""
"For bone motion paths, search whole Action for keyframes instead of in group "
"with matching name only (is slower)"
msgstr ""
"För rörelsebanor för ben söker du efter nyckelbildrutor i hela åtgärden i "
"stället för endast i en grupp med matchande namn (går långsammare)"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_highlight
msgid "Highlight Keyframes"
msgstr "Markera nyckelbildrutor"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_highlight
msgid "Emphasize position of keyframes on Motion Paths"
msgstr "Betona nyckelbildrutornas position på rörelsebanorna"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_numbers
msgid "Show Keyframe Numbers"
msgstr "Visa nyckelbildrutenummer"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_numbers
msgid "Show frame numbers of Keyframes on Motion Paths"
msgstr "Visa bildrutenummer för nyckelbildrutor på rörelsebanor"

#. :src: bpy.types.AnimVizMotionPaths.type
msgid "Paths Type"
msgstr "Bantyp"

#. :src: bpy.types.AnimVizMotionPaths.type
msgid "Type of range to show for Motion Paths"
msgstr "Typ av intervall som ska visas för rörelsebanor"
