#. :src: bpy.types.Bone.use_envelope_multiply
#. :src: bpy.types.EditBone.use_envelope_multiply
msgid "Multiply Vertex Group with Envelope"
msgstr "Multiplicera hörnpunktsgrupp med kuvert"

#. :src: bpy.types.Bone.use_envelope_multiply
#. :src: bpy.types.EditBone.use_envelope_multiply
msgid ""
"When deforming bone, multiply effects of Vertex Group weights with Envelope "
"influence"
msgstr ""
"Vid bendeformering multipliceras hörnpunktsgruppens vikter med kuvertets "
"inflytande"

#. :src: bpy.types.Bone.use_inherit_rotation
#. :src: bpy.types.EditBone.use_inherit_rotation
msgid "Bone inherits rotation or scale from parent bone"
msgstr "Benet ärver rotation eller skalning från det överordnade benet"

#. :src: bpy.types.Bone.use_relative_parent
#. :src: bpy.types.EditBone.use_relative_parent
msgid "Relative Parenting"
msgstr "Relativ överordning"

#. :src: bpy.types.Bone.use_relative_parent
#. :src: bpy.types.EditBone.use_relative_parent
msgid "Object children will use relative transform, like deform"
msgstr ""
"Underordnade objekt använder relativ transformering, som vid deformering"

#. :src: bpy.types.Bone.use_scale_easing
#. :src: bpy.types.EditBone.use_scale_easing
msgid "Scale Easing"
msgstr "Skalutjämning"

#. :src: bpy.types.Bone.use_scale_easing
#. :src: bpy.types.EditBone.use_scale_easing
msgid "Multiply the final easing values by the Scale In/Out Y factors"
msgstr ""
"Multiplicera de slutliga utjämningsvärdena med Y-faktorerna för Skala in/ut"

#. :src: bpy.types.BoneCollection
msgid "Bone collection in an Armature data-block"
msgstr "Bensamling i ett armaturdatablock"

#. :src: bpy.types.BoneCollection.bones
msgid ""
"Bones assigned to this bone collection. In armature edit mode this will "
"always return an empty list of bones, as the bone collection memberships are "
"only synchronized when exiting edit mode."
msgstr ""
"Ben som är tilldelade denna bensamling. I armaturens redigeringsläge "
"returneras alltid en tom benlista, eftersom medlemskap i bensamlingar "
"synkroniseras först när redigeringsläget avslutas."

#. :src: bpy.types.BoneCollection.child_number
msgid "Child Number"
msgstr "Underordningsnummer"

#. :src: bpy.types.BoneCollection.child_number
msgid ""
"Index of this collection into its parent's list of children. Note that "
"finding this index requires a scan of all the bone collections, so do access "
"this with care."
msgstr ""
"Den här samlingens index i den överordnade samlingens lista över "
"underordnade. Att hitta indexet kräver en genomsökning av alla bensamlingar, "
"så använd det med försiktighet."

#. :src: bpy.types.BoneCollection.index
msgid ""
"Index of this bone collection in the armature.collections_all array. Note "
"that finding this index requires a scan of all the bone collections, so do "
"access this with care."
msgstr ""
"Index för den här bensamlingen i arrayen armature.collections_all. Observera "
"att det krävs en genomgång av alla bensamlingar för att hitta indexet, så "
"använd det med försiktighet."

#. :src: bpy.types.BoneCollection.is_editable
msgid ""
"This collection is owned by a local Armature, or was added via a library "
"override in the current blend file"
msgstr ""
"Den här samlingen ägs av en lokal armatur eller har lagts till via en "
"biblioteksåsidosättning i den aktuella blendfilen"

#. :src: bpy.types.BoneCollection.is_expanded
msgid "This bone collection is expanded in the bone collections tree view"
msgstr "Den här bensamlingen är expanderad i trädvyn för bensamlingar"

#. :src: bpy.types.BoneCollection.is_local_override
msgid "Is Local Override"
msgstr "Är en lokal åsidosättning"

#. :src: bpy.types.BoneCollection.is_local_override
msgid ""
"This collection was added via a library override in the current blend file"
msgstr ""
"Den här samlingen har lagts till via en biblioteksåsidosättning i den "
"aktuella blendfilen"

#. :src: bpy.types.BoneCollection.is_solo
msgid "Show only this bone collection, and others also marked as 'solo'"
msgstr ""
"Visa endast den här bensamlingen och andra som också är markerade som ”solo”"

#. :src: bpy.types.BoneCollection.is_visible
msgid "Bones in this collection will be visible in pose/object mode"
msgstr "Ben i den här samlingen visas i poserings- och objektläge"

#. :src: bpy.types.BoneCollection.is_visible_ancestors
msgid "Ancestors Effectively Visible"
msgstr "Överordnade samlingar är effektivt synliga"

#. :src: bpy.types.BoneCollection.is_visible_ancestors
msgid ""
"True when all of the ancestors of this bone collection are marked as "
"visible; always True for root bone collections"
msgstr ""
"Sant när alla överordnade samlingar till den här bensamlingen är markerade "
"som synliga; alltid sant för rotbensamlingar"

#. :src: bpy.types.BoneCollection.is_visible_effectively
msgid ""
"Whether this bone collection is effectively visible in the viewport. This is "
"True when this bone collection and all of its ancestors are visible, or when "
"it is marked as 'solo'."
msgstr ""
"Anger om den här bensamlingen är effektivt synlig i vyporten. Detta är sant "
"när bensamlingen och alla överordnade samlingar är synliga eller när den är "
"markerad som ”solo”."

#. :src: bpy.types.BoneCollection.parent
msgid ""
"Parent bone collection. Note that accessing this requires a scan of all the "
"bone collections to find the parent."
msgstr ""
"Överordnad bensamling. Observera att åtkomst till den kräver en genomsökning "
"av alla bensamlingar för att hitta den överordnade samlingen."

#. :src: bpy.types.BoneCollection.rigify_color_set_id
msgid "Color Set ID"
msgstr "ID för färguppsättning"

#. :src: bpy.types.BoneCollection.rigify_sel_set
msgid "Add Selection Set for this collection"
msgstr "Lägg till urvalsuppsättning för den här samlingen"

#. :src: bpy.types.BoneCollection.rigify_ui_row
msgid "UI Row"
msgstr "UI-rad"

#. :src: bpy.types.BoneCollection.rigify_ui_row
msgid ""
"If not zero, row of the UI panel where the button for this collection is "
"shown"
msgstr ""
"Om värdet inte är noll är detta raden i UI-panelen där knappen för den här "
"samlingen visas"

#. :src: bpy.types.BoneCollection.rigify_ui_title
#. :src: bpy.types.BoneCollection.rigify_ui_title_name
msgid "UI Title"
msgstr "UI-titel"

#. :src: bpy.types.BoneCollectionMemberships
msgid "Bone Collection Memberships"
msgstr "Medlemskap i bensamlingar"

#. :src: bpy.types.BoneCollections
msgid "Armature Bone Collections"
msgstr "Armaturens bensamlingar"

#. :src: bpy.types.BoneCollections
msgid "The Bone Collections of this Armature"
msgstr "Den här armaturens bensamlingar"

#. :src: bpy.types.BoneCollections.active
msgid "Armature's active bone collection"
msgstr "Armaturens aktiva bensamling"

#. :src: bpy.types.BoneCollections.active_index
msgid "Active Collection Index"
msgstr "Index för aktiv bensamling"

#. :src: bpy.types.BoneCollections.active_name
msgid "Active Collection Name"
msgstr "Namn på aktiv bensamling"

#. :src: bpy.types.BoneCollections.active_name
msgid ""
"The name of the Armature's active bone collection; empty when there is no "
"active collection"
msgstr ""
"Namnet på armaturens aktiva bensamling; tomt när ingen samling är aktiv"

#. :src: bpy.types.BoneCollections.is_solo_active
msgid "Solo Active"
msgstr "Sololäge aktivt"

#. :src: bpy.types.BoneCollections.is_solo_active
msgid ""
"Read-only flag that indicates there is at least one bone collection marked "
"as 'solo'"
msgstr ""
"Skrivskyddad flagga som anger att minst en bensamling är markerad som ”solo”"

#. :src: bpy.types.BoolAttributeValue
msgid "Bool Attribute Value"
msgstr "Booleskt attributvärde"

#. :src: bpy.types.BoolAttributeValue
msgid "Bool value in geometry attribute"
msgstr "Booleskt värde i geometriattribut"

#. :src: bpy.types.BrushCurvesSculptSettings
msgid "Curves Sculpt Brush Settings"
msgstr "Inställningar för kurvskulpteringspensel"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_length
msgid ""
"Length of newly added curves when it is not interpolated from other curves"
msgstr ""
"Längd på nyligen tillagda kurvor när längden inte interpoleras från andra "
"kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_radius
msgid ""
"Radius of newly added curves when it is not interpolated from other curves"
msgstr ""
"Radie för nyligen tillagda kurvor när den inte interpoleras från andra kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.density_add_attempts
msgid "Density Add Attempts"
msgstr "Antal försök att öka tätheten"

#. :src: bpy.types.BrushCurvesSculptSettings.density_mode
msgctxt "Operator"
msgid "Density Mode"
msgstr "Täthetsläge"

#. :src: bpy.types.BrushCurvesSculptSettings.minimum_distance
msgid "Goal distance between curve roots for the Density brush"
msgstr "Målavstånd mellan kurvornas rotpunkter för täthetspenseln"

#. :src: bpy.types.BrushCurvesSculptSettings.use_point_count_interpolate
msgid "Use the number of points from the curves in close proximity"
msgstr "Använd antalet punkter från närliggande kurvor"

#. :src: bpy.types.BrushGpencilSettings
msgid "Grease Pencil Brush Settings"
msgstr "Inställningar för Grease Pencil-pensel"

#. :src: bpy.types.BrushGpencilSettings.angle_factor
msgid ""
"Reduce brush thickness by this factor when stroke is perpendicular to "
"'Angle' direction"
msgstr ""
"Minska penseltjockleken med denna faktor när penseldraget är vinkelrätt mot "
"riktningen som anges av Vinkel"

#. :src: bpy.types.BrushCurvesSculptSettings.use_uniform_scale
#. :src: Socket name from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Scale Uniform"
msgstr "Skala jämnt"

#. :src: bpy.types.BrushCurvesSculptSettings.use_uniform_scale
msgid ""
"Grow or shrink curves by changing their size uniformly instead of using "
"trimming or extrapolation"
msgstr ""
"Förläng eller förkorta kurvor genom att ändra deras storlek jämnt i stället "
"för att använda trimning eller extrapolering"

#. :src: bpy.types.BlenderRNA
msgid "Blender RNA"
msgstr "Blender-RNA"

#. :src: bpy.types.BlenderRNA
msgid "Blender RNA structure definitions"
msgstr "Strukturdefinitioner för Blender-RNA"

#. :src: bpy.types.BlenderRNA.structs
msgid "Structs"
msgstr "Strukturer"

#. :src: bpy.types.BoidRule
msgid "Boid Rule"
msgstr "Boidregel"

#. :src: bpy.types.BoidRule.name
msgid "Boid rule name"
msgstr "Namn på boidregel"

#. :src: bpy.types.BoidRule.type:'GOAL'
#. :src: bpy.types.BOID_OT_rule_add.type:'GOAL'
msgid "Go to assigned object or loudest assigned signal source"
msgstr ""
"Gå till det tilldelade objektet eller den tilldelade signalkälla med "
"starkast signal"

#. :src: bpy.types.BoidRule.type:'AVOID'
#. :src: bpy.types.BOID_OT_rule_add.type:'AVOID'
msgid "Get away from assigned object or loudest assigned signal source"
msgstr ""
"Avlägsna dig från det tilldelade objektet eller den tilldelade signalkälla "
"med starkast signal"

#. :src: bpy.types.BoidRule.type:'AVOID_COLLISION'
#. :src: bpy.types.BoidRuleAvoidCollision
#. :src: bpy.types.BOID_OT_rule_add.type:'AVOID_COLLISION'
msgid "Avoid Collision"
msgstr "Undvik kollisioner"

#. :src: bpy.types.BoidRule.type:'AVOID_COLLISION'
#. :src: bpy.types.BOID_OT_rule_add.type:'AVOID_COLLISION'
msgid ""
"Maneuver to avoid collisions with other boids and deflector objects in near "
"future"
msgstr ""
"Manövrera för att undvika kollisioner med andra boider och deflektorobjekt "
"inom kort"

#. :src: bpy.types.BoidRule.type:'SEPARATE'
#. :src: bpy.types.BOID_OT_rule_add.type:'SEPARATE'
msgid "Keep from going through other boids"
msgstr "Undvik att passera genom andra boider"

#. :src: bpy.types.BoidRule.type:'FLOCK'
#. :src: bpy.types.BOID_OT_rule_add.type:'FLOCK'
msgid "Move to center of neighbors and match their velocity"
msgstr "Rör dig mot grannarnas mittpunkt och anpassa hastigheten efter deras"

#. :src: bpy.types.BoidRule.type:'FOLLOW_LEADER'
#. :src: bpy.types.BoidRuleFollowLeader
#. :src: bpy.types.BOID_OT_rule_add.type:'FOLLOW_LEADER'
msgid "Follow Leader"
msgstr "Följ ledaren"

#. :src: bpy.types.BoidRule.type:'FOLLOW_LEADER'
#. :src: bpy.types.BOID_OT_rule_add.type:'FOLLOW_LEADER'
msgid "Follow a boid or assigned object"
msgstr "Följ en boid eller ett tilldelat objekt"

#. :src: bpy.types.BoidRule.type:'AVERAGE_SPEED'
#. :src: bpy.types.BOID_OT_rule_add.type:'AVERAGE_SPEED'
msgid "Maintain speed, flight level or wander"
msgstr "Behåll hastighet, flyghöjd eller vandra"

#. :src: bpy.types.BoidRule.type:'FIGHT'
#. :src: bpy.types.BoidRuleFight
#. :src: bpy.types.BOID_OT_rule_add.type:'FIGHT'
msgid "Fight"
msgstr "Slåss"

#. :src: bpy.types.BoidRule.type:'FIGHT'
#. :src: bpy.types.BOID_OT_rule_add.type:'FIGHT'
msgid "Go to closest enemy and attack when in range"
msgstr "Gå till närmaste fiende och attackera när du är inom räckhåll"

#. :src: bpy.types.BoidRule.use_in_air
msgid "In Air"
msgstr "I luften"

#. :src: bpy.types.BoidRule.use_in_air
msgid "Use rule when boid is flying"
msgstr "Använd regel när boid flyger"

#. :src: bpy.types.BoidRule.use_on_land
msgid "On Land"
msgstr "På land"

#. :src: bpy.types.BoidRule.use_on_land
msgid "Use rule when boid is on land"
msgstr "Använd regel när boid är på land"

#. :src: bpy.types.BoidRuleAverageSpeed.level
msgid "How much velocity's z-component is kept constant"
msgstr "Hur mycket hastighetens z-komponent hålls konstant"

#. :src: bpy.types.BoidRuleAverageSpeed.speed
msgid "Percentage of maximum speed"
msgstr "Procent av maximal hastighet"

#. :src: bpy.types.BoidRuleAverageSpeed.wander
msgid "Wander"
msgstr "Vandra"

#. :src: bpy.types.BoidRuleAverageSpeed.wander
msgid "How fast velocity's direction is randomized"
msgstr "Hur snabbt hastighetens riktning slumpas"

#. :src: bpy.types.BoidRuleAvoid.fear_factor
msgid "Fear Factor"
msgstr "Rädslofaktor"

#. :src: bpy.types.BoidRuleAvoid.fear_factor
msgid "Avoid object if danger from it is above this threshold"
msgstr "Undvik objektet om faran från det ligger över denna tröskel"

#. :src: bpy.types.BoidRuleAvoid.object
msgid "Object to avoid"
msgstr "Objekt att undvika"

#. :src: bpy.types.BoidRuleAvoid.use_predict
#. :src: bpy.types.BoidRuleGoal.use_predict
msgid "Predict"
msgstr "Förutse"

#. :src: bpy.types.BoidRuleAvoid.use_predict
#. :src: bpy.types.BoidRuleGoal.use_predict
msgid "Predict target movement"
msgstr "Förutse målets rörelse"

#. :src: bpy.types.BoidRuleAvoidCollision.look_ahead
msgid "Look Ahead"
msgstr "Se framåt"

#. :src: bpy.types.BoidRuleAvoidCollision.look_ahead
msgid "Time to look ahead in seconds"
msgstr "Tid att se framåt i sekunder"

#. :src: bpy.types.BoidRuleAvoidCollision.use_avoid
#. :src: bpy.types.ParticleSettings.physics_type:'BOIDS'
msgid "Boids"
msgstr "Boider"

#. :src: bpy.types.BoidRuleAvoidCollision.use_avoid
msgid "Avoid collision with other boids"
msgstr "Undvik kollision med andra boider"

#. :src: bpy.types.BoidRuleAvoidCollision.use_avoid_collision
msgid "Deflectors"
msgstr "Deflektorer"

#. :src: bpy.types.BoidRuleAvoidCollision.use_avoid_collision
msgid "Avoid collision with deflector objects"
msgstr "Undvik kollision med deflektorobjekt"

#. :src: bpy.types.BoidRuleFight.distance
msgid "Fight Distance"
msgstr "Stridsavstånd"

#. :src: bpy.types.BoidRuleFight.distance
msgid "Attack boids at max this distance"
msgstr "Attackera boider på högst detta avstånd"

#. :src: bpy.types.BoidRuleFight.flee_distance
msgid "Flee Distance"
msgstr "Flyktavstånd"

#. :src: bpy.types.BoidRuleFight.flee_distance
msgid "Flee to this distance"
msgstr "Fly till detta avstånd"

#. :src: bpy.types.BoidRuleFollowLeader.distance
msgid "Distance behind leader to follow"
msgstr "Avstånd bakom ledaren att följa på"

#. :src: bpy.types.BoidRuleFollowLeader.object
msgid "Follow this object instead of a boid"
msgstr "Följ detta objekt i stället för en boid"

#. :src: bpy.types.BoidRuleFollowLeader.queue_count
msgid "Queue Size"
msgstr "Köstorlek"

#. :src: bpy.types.BoidRuleFollowLeader.queue_count
msgid "How many boids in a line"
msgstr "Antal boider i en rad"

#. :src: bpy.types.BoidRuleFollowLeader.use_line
msgid "Follow leader in a line"
msgstr "Följ ledaren i en rad"

#. :src: bpy.types.BoidSettings
#. :src: bpy.types.ParticleSettings.boids
msgid "Boid Settings"
msgstr "Boidinställningar"

#. :src: bpy.types.BoidSettings
msgid "Settings for boid physics"
msgstr "Inställningar för boidfysik"

#. :src: bpy.types.BoidSettings.accuracy
#. :src: bpy.types.SOUND_OT_mixdown.accuracy
#. :src: bpy.types.Scopes.accuracy
msgid "Accuracy"
msgstr "Precision"

#. :src: bpy.types.BoidSettings.accuracy
msgid "Accuracy of attack"
msgstr "Noggrannhet i anfallet"

#. :src: bpy.types.BoidSettings.active_boid_state
#. :src: bpy.types.BoidState.active_boid_rule
msgid "Active Boid Rule"
msgstr "Aktiv boidregel"

#. :src: bpy.types.BoidSettings.active_boid_state_index
msgid "Active Boid State Index"
msgstr "Index för aktivt boidtillstånd"

#. :src: bpy.types.BoidSettings.aggression
msgid "Aggression"
msgstr "Aggressivitet"

#. :src: bpy.types.BoidSettings.aggression
msgid "Boid will fight this times stronger enemy"
msgstr "Boiden slåss mot fiender som är så här många gånger starkare"

#. :src: bpy.types.BoidSettings.air_acc_max
msgid "Max Air Acceleration"
msgstr "Maximal acceleration i luften"

#. :src: bpy.types.BoidSettings.air_acc_max
