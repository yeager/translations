msgstr "Objekt i blendfilimportkontext"

#. :src: bpy.types.BlendImportContextItems
msgid "Collection of blendfile import context items"
msgstr "Samling av objekt i blendfilimportkontext"

#. :src: bpy.types.BlendImportContextLibraries
