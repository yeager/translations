#. :src: bpy.types.FreestyleLineStyle.length_max
msgid "Maximum curvilinear 2D length for the selection of chains"
msgstr "Maximal kurvlinjär 2D-längd för urvalet av kedjor"

#. :src: bpy.types.FreestyleLineStyle.thickness_position
msgid "Thickness Position"
msgstr "Tjockleksplacering"

#. :src: bpy.types.FreestyleLineStyle.thickness_position
msgid ""
"Thickness position of silhouettes and border edges (applicable when plain "
"chaining is used with the Same Object option)"
msgstr ""
"Tjockleksplacering för silhuetter och gränskanter (gäller när enkel kedjning "
"används med alternativet Samma objekt)"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'CENTER'
msgid "Silhouettes and border edges are centered along stroke geometry"
msgstr "Silhuetter och gränskanter är centrerade längs streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'INSIDE'
msgid "Silhouettes and border edges are drawn inside of stroke geometry"
msgstr "Silhuetter och gränskanter ritas inuti streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'OUTSIDE'
msgid "Silhouettes and border edges are drawn outside of stroke geometry"
msgstr "Silhuetter och gränskanter ritas utanför streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'RELATIVE'
msgid "Silhouettes and border edges are shifted by a user-defined ratio"
msgstr ""
"Silhuetter och gränskanter förskjuts med ett användardefinierat förhållande"

#. :src: bpy.types.FreestyleLineStyle.use_angle_max
msgid "Use Max 2D Angle"
msgstr "Använd maximal 2D-vinkel"

#. :src: bpy.types.FreestyleLineStyle.use_angle_min
msgid "Use Min 2D Angle"
msgstr "Använd minimal 2D-vinkel"
