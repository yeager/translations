#. :src: bpy.types.ParticleSettings.use_modifier_stack
msgid "Use Modifier Stack"
msgstr "Använd modifieringsstapel"

#. :src: bpy.types.ParticleSettings.use_modifier_stack
msgid ""
"Emit particles from mesh with modifiers applied (must use same subdivision "
"surface level for viewport and render for correct results)"
msgstr ""
"Sänd ut partiklar från mesh med tillämpade modifierare (samma "
"underindelningsnivå måste användas i 3D-vyn och vid rendering för korrekta "
"resultat)"

#. :src: bpy.types.ParticleSettings.use_multiply_size_mass
msgid "Mass from Size"
msgstr "Massa från storlek"

#. :src: bpy.types.ParticleSettings.use_multiply_size_mass
msgid "Multiply mass by particle size"
msgstr "Multiplicera massa med partikelstorlek"

#. :src: bpy.types.ParticleSettings.use_parent_particles
msgctxt "ParticleSettings"
msgid "Parents"
msgstr "Föräldrar"

#. :src: bpy.types.ParticleSettings.use_roughness_curve
msgid "Use Roughness Curve"
msgstr "Använd grovhetskurva"

#. :src: bpy.types.ParticleSettings.use_roughness_curve
msgid "Use a curve to define roughness"
msgstr "Använd en kurva för att definiera grovhet"

#. :src: bpy.types.ParticleSettings.use_scale_instance
msgid "Use object's scale for duplication"
msgstr "Använd objektets skala för duplicering"

#. :src: bpy.types.ParticleSettings.use_self_effect
msgid "Self Effect"
msgstr "Egenpåverkan"

#. :src: bpy.types.ParticleSettings.use_self_effect
msgid "Particle effectors affect themselves"
msgstr "Partikeleffektorer påverkar sig själva"

#. :src: bpy.types.ParticleSettings.use_size_deflect
msgid "Size Deflect"
msgstr "Storleksavböjning"

#. :src: bpy.types.ParticleSettings.use_size_deflect
msgid "Use particle's size in deflection"
msgstr "Använd partikelns storlek i avböjningen"

#. :src: bpy.types.ParticleSettings.use_strand_primitive
msgid "Strand Render"
msgstr "Strårendering"

#. :src: bpy.types.ParticleSettings.use_strand_primitive
msgid "Use the strand primitive for rendering"
msgstr "Använd stråprimitiven för rendering"

#. :src: bpy.types.ParticleSettings.use_twist_curve
msgid "Use Twist Curve"
msgstr "Använd vridningskurva"

#. :src: bpy.types.ParticleSettings.use_twist_curve
msgid "Use a curve to define twist"
msgstr "Använd en kurva för att definiera vridningen"

#. :src: bpy.types.ParticleSettings.use_velocity_length
msgid "Multiply line length by particle speed"
msgstr "Multiplicera linjelängden med partikelhastigheten"

#. :src: bpy.types.ParticleSettings.use_whole_collection
msgid "Whole Collection"
msgstr "Hela samlingen"

#. :src: bpy.types.ParticleSettings.use_whole_collection
msgid "Use whole collection at once"
msgstr "Använd hela samlingen på en gång"

#. :src: bpy.types.ParticleSettings.userjit
#: scripts/startup/bl_ui/properties_particle.py:350
msgid "Particles/Face"
msgstr "Partiklar/yta"

#. :src: bpy.types.ParticleSettings.userjit
msgid "Emission locations per face (0 = automatic)"
msgstr "Utsläppsplatser per yta (0 = automatisk)"

#. :src: bpy.types.ParticleSettings.virtual_parents
msgid "Virtual Parents"
msgstr "Virtuella föräldrar"

#. :src: bpy.types.ParticleSettings.virtual_parents
msgid "Relative amount of virtual parents"
msgstr "Relativ mängd virtuella föräldrar"
