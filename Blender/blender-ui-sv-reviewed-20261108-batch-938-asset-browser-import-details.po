#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility
msgid "Which assets to show based on catalog filter"
msgstr "Välj vilka resurser som visas utifrån katalogfiltret"

#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND'
msgid ""
"Import the asset as copied data-block, with no link to the original asset "
"data-block"
msgstr "Importera resursen som ett kopierat datablock utan länk till ursprungligt datablock"

#. :src: bpy.types.ASSETBROWSER_MT_asset_rename
#: source/blender/editors/asset/intern/asset_ops.cc:1899
msgid "Rename Asset"
msgstr "Byt namn på resurs"

#. :src: bpy.types.ASSET_OT_external_asset_rename
msgctxt "Operator"
msgid "Rename Asset"
msgstr "Byt namn på resurs"

#. :src: bpy.types.POSELIB_OT_create_pose_asset
msgid "Create a new asset from the selected bones in the scene"
msgstr "Skapa en ny resurs från de valda benen i scenen"

#. :src: bpy.types.AssetMetaData.copyright
msgid ""
"Copyright notice for this asset. An empty copyright notice does not "
"necessarily indicate that this is copyright-free. Contact the author if any "
"clarification is needed."
msgstr ""
"Upphovsrättsmeddelande för den här resursen. Ett tomt meddelande betyder "
"inte nödvändigtvis att den är fri från upphovsrätt. Kontakta skaparen om "
"något behöver klargöras."

#. :src: bpy.types.AssetMetaData.license
msgid ""
"The type of license this asset is distributed under. An empty license name "
"does not necessarily indicate that this is free of licensing terms. Contact "
"the author if any clarification is needed."
msgstr ""
"Typ av licens som den här resursen distribueras under. Ett tomt licensnamn "
"betyder inte nödvändigtvis att den är fri från licensvillkor. Kontakta "
"skaparen om något behöver klargöras."
