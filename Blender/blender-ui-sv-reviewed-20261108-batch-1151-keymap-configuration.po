#. :src: bpy.types.KeyConfig.is_user_defined
msgid "Indicates that a keyconfig was defined by the user"
msgstr "Anger att en tangentkonfiguration har definierats av användaren"

#. :src: bpy.types.KeyConfig.keymaps
msgid "Key maps configured as part of this configuration"
msgstr "Tangentmappningar som ingår i den här konfigurationen"

#. :src: bpy.types.KeyConfig.name
msgid "Name of the key configuration"
msgstr "Namn på tangentkonfigurationen"

#. :src: bpy.types.KeyConfigurations
msgid "KeyConfigs"
msgstr "Tangentkonfigurationer"

#. :src: bpy.types.KeyConfigurations
msgid "Collection of KeyConfigs"
msgstr "Samling av tangentkonfigurationer"

#. :src: bpy.types.KeyConfigurations.active
msgid "Active key configuration (preset)"
msgstr "Aktiv tangentkonfiguration (förinställning)"

#. :src: bpy.types.KeyConfigurations.addon
msgid "Add-on Key Configuration"
msgstr "Tangentkonfiguration för tillägg"

#. :src: bpy.types.KeyConfigurations.addon
msgid ""
"Key configuration that can be extended by add-ons, and is added to the "
"active configuration when handling events"
msgstr ""
"Tangentkonfiguration som kan utökas med tillägg och som läggs till i den "
"aktiva konfigurationen när händelser hanteras"

#. :src: bpy.types.KeyConfigurations.default
msgid "Default Key Configuration"
msgstr "Standardtangentkonfiguration"

#. :src: bpy.types.KeyConfigurations.default
msgid "Default builtin key configuration"
msgstr "Inbyggd standardtangentkonfiguration"

#. :src: bpy.types.KeyConfigurations.user
msgid "User Key Configuration"
msgstr "Användartangentkonfiguration"

#. :src: bpy.types.KeyConfigurations.user
msgid ""
"Final key configuration that combines keymaps from the active and add-on "
"configurations, and can be edited by the user"
msgstr ""
"Den slutliga tangentkonfigurationen kombinerar tangentmappningar från den "
"aktiva konfigurationen och tilläggskonfigurationen och kan redigeras av "
"användaren"

#. :src: bpy.types.KeyMap.is_modal
msgid "Modal Keymap"
msgstr "Modal tangentmappning"

#. :src: bpy.types.KeyMap.is_modal
msgid ""
"Indicates that a keymap is used for translate modal events for an operator"
msgstr ""
"Anger att en tangentmappning används för att översätta modala händelser för "
"en operator"

#. :src: bpy.types.KeyMap.is_user_modified
msgid "Keymap is defined by the user"
msgstr "Tangentmappningen definieras av användaren"

#. :src: bpy.types.EXTENSIONS_OT_package_show_settings
msgctxt "Operator"
msgid "Show Settings"
msgstr "Visa inställningar"

#. :src: bpy.types.PREFERENCES_OT_studiolight_copy_settings
msgctxt "Operator"
msgid "Copy Studio Light Settings"
msgstr "Kopiera inställningar för studioljus"

#. :src: bpy.types.ActionSlot.show_action_a
#. :src: bpy.types.ActionSlot.show_action_b
msgid "Show Settings"
msgstr "Visa inställningar"
