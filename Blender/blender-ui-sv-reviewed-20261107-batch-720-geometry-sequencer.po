#. :src: bpy.types.NodeSocketGeometry
msgid "Geometry Node Socket"
msgstr "Geometrinoduttag"

#. :src: bpy.types.NodeTreeInterfaceSocket.attribute_domain
msgid "Attribute domain used by the geometry nodes modifier to create an attribute output"
msgstr "Attributdomän som geometrinodmodifieraren använder för att skapa en attribututdata"

#. :src: bpy.types.NodesModifierWarning
msgid "Warning created during evaluation of a geometry nodes modifier"
msgstr "Varning skapades under utvärdering av en geometrinodmodifierare"

#: scripts/addons_core/io_scene_gltf2/blender/exp/material/extensions/anisotropy.py:48
msgid "Geometry Nodes Instances (Experimental)"
msgstr "Geometrinodinstanser (experimentellt)"

#. :src: bpy.types.NODE_OT_connect_to_output
msgid "Run in Geometry Nodes Editor"
msgstr "Kör i geometrinodredigeraren"

#. :src: bpy.types.NODE_OT_select.clear_viewer
msgid "Deactivate geometry nodes viewer when clicking in empty space"
msgstr "Inaktivera visningsnoden för geometrinoder när du klickar i tomt utrymme"

#. :src: bpy.types.OBJECT_OT_simulation_nodes_cache_bake
msgid "Bake simulations in geometry nodes modifiers"
msgstr "Baka simuleringar i geometrinodmodifierare"

#. :src: bpy.types.OBJECT_OT_simulation_nodes_cache_delete
msgid "Delete cached/baked simulations in geometry nodes modifiers"
msgstr "Ta bort cachade/bakade simuleringar i geometrinodmodifierare"

#: source/blender/nodes/shader/node_shader_util.cc:48
msgid "Not a shader or geometry node tree"
msgstr "Inte ett shader- eller geometrinodträd"

#: source/blender/nodes/shader/node_shader_util.cc:59
msgid "Not a shader, geometry, or compositor node tree"
msgstr "Inte ett shader-, geometrinod- eller kompositionsnodträd"

#. :src: bpy.types.RENDER_OT_opengl.sequencer
msgid "Render using the sequencer's OpenGL display"
msgstr "Rendera med sekvensredigerarens OpenGL-visning"

#. :src: bpy.types.RENDER_OT_render.use_sequencer_scene
msgid "Render the sequencer scene instead of the active scene"
msgstr "Rendera sekvensredigerarens scen i stället för den aktiva scenen"

#. :src: bpy.types.SCENE_OT_new_sequencer_scene
msgid "Add new scene to be used by the sequencer"
msgstr "Lägg till ny scen som ska användas av sekvensredigeraren"

#. :src: bpy.types.SEQUENCER_OT_delete
msgid "Delete selected strips from the sequencer"
msgstr "Ta bort markerade remsor från sekvensredigeraren"

#. :src: bpy.types.SEQUENCER_OT_effect_strip_add
msgid "Add an effect to the sequencer, most are applied on top of existing strips"
msgstr "Lägg till en effekt i sekvensredigeraren; de flesta tillämpas ovanpå befintliga remsor"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add
msgid "Add an image or image sequence to the sequencer"
msgstr "Lägg till en bild eller bildsekvens till sekvensredigeraren"

#. :src: bpy.types.SEQUENCER_OT_mask_strip_add
msgid "Add a mask strip to the sequencer"
msgstr "Lägg till en maskremsa i sekvensredigeraren"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add
msgid "Add a movie strip to the sequencer"
msgstr "Lägg till en filmremsa i sekvensredigeraren"

#. :src: bpy.types.SEQUENCER_OT_refresh_all
msgctxt "Operator"
msgid "Refresh Sequencer"
msgstr "Uppdatera sekvensredigeraren"

#. :src: bpy.types.SEQUENCER_OT_reload
msgid "Reload strips in the sequencer"
msgstr "Ladda om remsor i sekvensredigeraren"
