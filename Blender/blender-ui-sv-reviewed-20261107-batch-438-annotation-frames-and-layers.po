#. :src: bpy.types.GPencilFrame
msgid "Annotation Frame"
msgstr "Anteckningsbildruta"

#. :src: bpy.types.GPencilFrame
msgid "Collection of related sketches on a particular frame"
msgstr "Samling av relaterade skisser på en viss bildruta"

#. :src: bpy.types.GPencilFrame.frame_number
#. :src: bpy.types.GreasePencilFrame.frame_number
#. :src: bpy.types.GRAPH_OT_click_insert.frame
#. :src: bpy.types.SpeedControlStrip.speed_control:'FRAME_NUMBER'
#. :src: bpy.types.SpeedControlStrip.speed_frame_number
msgid "Frame Number"
msgstr "Bildrutenummer"

#. :src: bpy.types.GPencilFrame.frame_number
msgid "The frame on which this sketch appears"
msgstr "Bildrutan där denna skiss visas"

#. :src: bpy.types.GPencilFrame.select
msgid "Frame is selected for editing in the Dope Sheet"
msgstr "Bildrutan är markerad för redigering i Dope Sheet"

#. :src: bpy.types.GPencilFrame.strokes
msgid "Freehand curves defining the sketch on this frame"
msgstr "Frihandskurvor som definierar skissen på denna bildruta"

#. :src: bpy.types.GPencilFrames
msgid "Annotation Frames"
msgstr "Anteckningsbildrutor"

#. :src: bpy.types.GPencilFrames
msgid "Collection of annotation frames"
msgstr "Samling av anteckningsbildrutor"

#. :src: bpy.types.GPencilInterpolateSettings
msgid "Grease Pencil Interpolate Settings"
msgstr "Interpoleringsinställningar för Grease Pencil"

#. :src: bpy.types.GPencilInterpolateSettings
#. :src: bpy.types.ToolSettings.gpencil_interpolate
msgid "Settings for Grease Pencil interpolation tools"
msgstr "Inställningar för Grease Pencils interpolationsverktyg"

#. :src: bpy.types.GPencilInterpolateSettings.interpolation_curve
msgid "Interpolation Curve"
msgstr "Interpolationskurva"

#. :src: bpy.types.GPencilInterpolateSettings.interpolation_curve
msgid ""
"Custom curve to control 'sequence' interpolation between Grease Pencil frames"
msgstr ""
"Anpassad kurva för att styra \"sekvens\"-interpolering mellan Grease Pencil-"
"bildrutor"

#. :src: bpy.types.GPencilLayer
msgid "Annotation Layer"
msgstr "Anteckningslager"

#. :src: bpy.types.GPencilLayer
msgid "Collection of related sketches"
msgstr "Samling av relaterade skisser"

#. :src: bpy.types.GPencilLayer.active_frame
#. :src: bpy.types.GREASE_PENCIL_OT_delete_frame.type:'ACTIVE_FRAME'
#. :src: bpy.types.GREASE_PENCIL_OT_layer_duplicate_object.mode:'ACTIVE'
msgid "Active Frame"
msgstr "Aktiv bildruta"

#. :src: bpy.types.GPencilLayer.active_frame
msgid "Frame currently being displayed for this layer"
msgstr "Bildrutan som för närvarande visas för detta lager"

#. :src: bpy.types.GPencilLayer.annotation_hide
msgid "Set annotation Visibility"
msgstr "Ange synlighet för anteckningar"

#. :src: bpy.types.GPencilLayer.annotation_onion_after_color
#. :src: bpy.types.GreasePencilv3.after_color
msgid "After Color"
msgstr "Färg efter"

#. :src: bpy.types.GPencilLayer.annotation_onion_after_color
#. :src: bpy.types.GreasePencilv3.after_color
msgid "Base color for ghosts after the active frame"
msgstr "Basfärg för lökskal efter den aktiva bildrutan"

#. :src: bpy.types.GPencilLayer.annotation_onion_after_range
#. :src: bpy.types.GreasePencilv3.ghost_after_range
#: scripts/startup/bl_ui/properties_data_grease_pencil.py:380
msgid "Frames After"
msgstr "Bildrutor efter"

#. :src: bpy.types.GPencilLayer.annotation_onion_after_range
msgid "Maximum number of frames to show after current frame"
msgstr "Maximalt antal bildrutor som ska visas efter aktuell bildruta"

#. :src: bpy.types.GPencilLayer.annotation_onion_before_color
#. :src: bpy.types.GreasePencilv3.before_color
msgid "Before Color"
msgstr "Färg före"

#. :src: bpy.types.GPencilLayer.annotation_onion_before_color
#. :src: bpy.types.GreasePencilv3.before_color
msgid "Base color for ghosts before the active frame"
msgstr "Basfärg för lökskal före den aktiva bildrutan"

#. :src: bpy.types.GPencilLayer.annotation_onion_before_range
#. :src: bpy.types.GreasePencilv3.ghost_before_range
#: scripts/startup/bl_ui/properties_data_grease_pencil.py:379
msgid "Frames Before"
msgstr "Bildrutor före"

#. :src: bpy.types.GPencilLayer.annotation_onion_before_range
msgid "Maximum number of frames to show before current frame"
msgstr "Maximalt antal bildrutor som ska visas före aktuell bildruta"

#. :src: bpy.types.GPencilLayer.annotation_onion_use_custom_color
msgid "Custom Onion Skin Colors"
msgstr "Anpassade färger för lökskalning"

#. :src: bpy.types.GPencilLayer.annotation_onion_use_custom_color
msgid "Use custom colors for onion skinning instead of the theme"
msgstr "Använd anpassade färger för lökskalning i stället för temat"

#. :src: bpy.types.GPencilLayer.annotation_opacity
msgid "Annotation Layer Opacity"
msgstr "Anteckningslagrets opacitet"

#. :src: bpy.types.GPencilLayer.color
msgid "Color for all strokes in this layer"
msgstr "Färg för alla streck i detta lager"

#. :src: bpy.types.GPencilLayer.frames
msgid "Sketches for this layer on different frames"
msgstr "Skisser för detta lager på olika bildrutor"

#. :src: bpy.types.GPencilLayer.is_ruler
msgid "Ruler"
msgstr "Linjal"

#. :src: bpy.types.GPencilLayer.is_ruler
msgid "This is a special ruler layer"
msgstr "Detta är ett särskilt linjallager"

#. :src: bpy.types.GPencilLayer.lock
#. :src: bpy.types.GreasePencilTreeNode.lock
#. :src: bpy.types.IDOverrideLibraryPropertyOperation.flag:'LOCKED'
#. :src: bpy.types.MaterialGPencilStyle.lock
#. :src: bpy.types.NlaTrack.lock
#: scripts/startup/bl_ui/properties_grease_pencil_common.py:359
msgid "Locked"
msgstr "Låst"

#. :src: bpy.types.GPencilLayer.lock
msgid "Protect layer from further editing and/or frame changes"
msgstr "Skydda lagret från ytterligare redigering och/eller bildruteändringar"

#. :src: bpy.types.GPencilLayer.lock_frame
#. :src: bpy.types.GreasePencilLayer.lock_frame
msgid "Lock current frame displayed by layer"
msgstr "Lås den aktuella bildrutan som visas av lagret"

#. :src: bpy.types.GPencilLayer.select
#. :src: bpy.types.MaskLayer.select
msgid "Layer is selected for editing in the Dope Sheet"
msgstr "Lagret är valt för redigering i Dope Sheet"

#. :src: bpy.types.GPencilLayer.show_in_front
msgid "Make the layer display in front of objects"
msgstr "Gör så att lagret visas framför objekt"

#. :src: bpy.types.GPencilLayer.thickness
#. :src: bpy.types.ToolSettings.annotation_thickness
msgid "Thickness of annotation strokes"
msgstr "Anteckningsstreckens tjocklek"
