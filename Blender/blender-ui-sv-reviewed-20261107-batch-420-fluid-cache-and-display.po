#. :src: bpy.types.FluidDomainSettings.cache_type:'REPLAY'
msgid "Replay"
msgstr "Uppspelning"

#. :src: bpy.types.FluidDomainSettings.cache_type:'MODULAR'
msgid "Modular"
msgstr "Modulär"

#. :src: bpy.types.FluidDomainSettings.cache_type:'MODULAR'
msgid "Bake every stage of the simulation separately"
msgstr "Baka varje steg i simuleringen separat"

#. :src: bpy.types.FluidDomainSettings.cache_type:'ALL'
msgid "Bake all simulation settings at once"
msgstr "Baka alla simuleringsinställningar på en gång"

#. :src: bpy.types.FluidDomainSettings.cell_size
msgid "Cell Size"
msgstr "Cellstorlek"

#. :src: bpy.types.FluidDomainSettings.cfl_condition
msgid "CFL"
msgstr "CFL"

#. :src: bpy.types.FluidDomainSettings.clipping
#. :src: bpy.types.LightProbe.show_clip
#. :src: bpy.types.VolumeRender.clipping
msgid "Clipping"
msgstr "Klippning"

#. :src: bpy.types.FluidDomainSettings.clipping
#. :src: bpy.types.VolumeRender.clipping
msgid ""
"Value under which voxels are considered empty space to optimize rendering"
msgstr ""
"Värde under vilket voxlar betraktas som tomt utrymme för att optimera "
"renderingen"

#. :src: bpy.types.FluidDomainSettings.color_ramp_field
msgid "Simulation field to color map"
msgstr "Simuleringsfält som färgkartläggs"

#. :src: bpy.types.FluidDomainSettings.color_ramp_field_scale
msgid "Multiplier for scaling the selected field to color map"
msgstr "Multiplikator för att skala det valda fältet för färgkartan"

#. :src: bpy.types.FluidDomainSettings.delete_in_obstacle
msgid "Delete fluid inside obstacles"
msgstr "Ta bort vätska inuti hinder"

#. :src: bpy.types.FluidDomainSettings.density_grid
msgid "Smoke density grid"
msgstr "Rökdensitetsrutnät"

#. :src: bpy.types.FluidDomainSettings.display_interpolation
msgid "Interpolation method to use for smoke/fire volumes in solid mode"
msgstr "Interpolationsmetod som används för rök- och eldvolymer i solid-läge"

#. :src: bpy.types.FluidDomainSettings.display_interpolation:'LINEAR'
#. :src: bpy.types.CyclesMaterialSettings.volume_interpolation:'LINEAR'
#. :src: bpy.types.CyclesWorldSettings.volume_interpolation:'LINEAR'
#. :src: bpy.types.VolumeDisplay.interpolation_method:'LINEAR'
msgid "Good smoothness and speed"
msgstr "Bra utjämning och hög hastighet"

#. :src: bpy.types.FluidDomainSettings.display_interpolation:'CUBIC'
#. :src: bpy.types.GeometryNodeImageTexture.interpolation:'Cubic'
#. :src: bpy.types.ShaderNodeTexEnvironment.interpolation:'Cubic'
#. :src: bpy.types.ShaderNodeTexImage.interpolation:'Cubic'
#. :src: bpy.types.ShaderNodeTexPointDensity.interpolation:'Cubic'
#. :src: bpy.types.CyclesMaterialSettings.volume_interpolation:'CUBIC'
#. :src: bpy.types.CyclesWorldSettings.volume_interpolation:'CUBIC'
#. :src: bpy.types.VolumeDisplay.interpolation_method:'CUBIC'
msgid "Cubic"
msgstr "Kubisk"

#. :src: bpy.types.FluidDomainSettings.display_interpolation:'CUBIC'
#. :src: bpy.types.CyclesMaterialSettings.volume_interpolation:'CUBIC'
#. :src: bpy.types.CyclesWorldSettings.volume_interpolation:'CUBIC'
#. :src: bpy.types.VolumeDisplay.interpolation_method:'CUBIC'
msgid "Smoothed high quality interpolation, but slower"
msgstr "Utjämnad interpolation med hög kvalitet, men långsammare"
