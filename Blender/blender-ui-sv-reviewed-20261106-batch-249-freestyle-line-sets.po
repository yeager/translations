#. :src: bpy.types.FreestyleLineSet.collection
msgid "A collection of objects based on which feature edges are selected"
msgstr "En samling objekt vars funktionskanter väljs"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination
msgid ""
"Specify a logical combination of selection conditions on feature edge types"
msgstr "Ange en logisk kombination av urvalsvillkor för funktionskantstyper"

#. :src: bpy.types.FreestyleLineSet.exclude_border
#. :src: bpy.types.FreestyleLineSet.select_border
msgid "Border"
msgstr "Gräns"

#. :src: bpy.types.FreestyleLineSet.exclude_border
msgid "Exclude border edges"
msgstr "Uteslut gränskanter"

#. :src: bpy.types.FreestyleLineSet.exclude_contour
#. :src: bpy.types.FreestyleLineSet.select_contour
#. :src: bpy.types.GreasePencilLineartModifier.silhouette_filtering:'NONE'
msgid "Contour"
msgstr "Kontur"

#. :src: bpy.types.FreestyleLineSet.exclude_ridge_valley
#. :src: bpy.types.FreestyleLineSet.select_ridge_valley
msgid "Ridge & Valley"
msgstr "Åsar och dalar"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition
msgid "Face Mark Condition"
msgstr "Villkor för ytmarkering"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition
msgid "Specify a feature edge selection condition based on face marks"
msgstr "Ange ett urvalsvillkor för funktionskanter baserat på ytmarkeringar"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition:'ONE'
msgid "One Face"
msgstr "En yta"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition:'ONE'
msgid "Select a feature edge if either of its adjacent faces is marked"
msgstr "Välj en funktionskant om någon av dess angränsande ytor är markerad"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition:'BOTH'
msgid "Both Faces"
msgstr "Båda ytorna"

#. :src: bpy.types.FreestyleLineSet.face_mark_condition:'BOTH'
msgid "Select a feature edge if both of its adjacent faces are marked"
msgstr "Välj en funktionskant om båda dess angränsande ytor är markerade"

#. :src: bpy.types.FreestyleLineSet.face_mark_negation
msgid "Face Mark Negation"
msgstr "Ytmarkeringsnegation"

#. :src: bpy.types.FreestyleLineSet.face_mark_negation
msgid ""
"Specify either inclusion or exclusion of feature edges selected by face marks"
msgstr ""
"Ange om funktionskanter som valts med ytmarkeringar ska inkluderas eller "
"uteslutas"

#. :src: bpy.types.FreestyleLineSet.face_mark_negation:'INCLUSIVE'
msgid "Select feature edges satisfying the given face mark conditions"
msgstr ""
"Välj funktionskanter som uppfyller de angivna villkoren för ytmarkering"

#. :src: bpy.types.FreestyleLineSet.face_mark_negation:'EXCLUSIVE'
msgid "Select feature edges not satisfying the given face mark conditions"
msgstr ""
"Välj funktionskanter som inte uppfyller de angivna villkoren för ytmarkering"

#. :src: bpy.types.FreestyleLineSet.select_border
msgid "Select border edges (open mesh edges)"
msgstr "Välj gränskanter (öppna meshkanter)"

#. :src: bpy.types.FreestyleLineSet.select_by_face_marks
msgid "Select feature edges by face marks"
msgstr "Välj funktionskanter med hjälp av ytmarkeringar"

#. :src: bpy.types.FreestyleLineSet.show_render
msgid "Enable or disable this line set during stroke rendering"
msgstr ""
"Aktivera eller inaktivera den här linjeuppsättningen vid streckrendering"

#. :src: bpy.types.FreestyleSettings
msgid "Freestyle settings for a ViewLayer data-block"
msgstr "Freestyle-inställningar för ett visningslagerdatablock"

#. :src: bpy.types.FreestyleSettings.as_render_pass
msgid ""
"Renders Freestyle output to a separate pass instead of overlaying it on the "
"Combined pass"
msgstr ""
"Renderar Freestyle-utdata i ett separat pass i stället för att överlagra det "
"på Combined-passet"

#. :src: bpy.types.FreestyleSettings.use_ridges_and_valleys
msgid "Enable ridges and valleys"
msgstr "Aktivera åsar och dalar"

#. :src: bpy.types.FreestyleSettings.use_smoothness
msgid "Face Smoothness"
msgstr "Ytjämnhet"

#. :src: bpy.types.FreestyleSettings.use_smoothness
msgid "Take face smoothness into account in view map calculation"
msgstr "Ta hänsyn till ytjämnheten vid beräkning av vykartan"
