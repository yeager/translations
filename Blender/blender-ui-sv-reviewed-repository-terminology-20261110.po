#. :src: bpy.types.UI_AP_i18n_settings.FRIBIDI_LIB
msgid ""
"The FriBidi C compiled library (.so under Linux, .dll under windows...), "
"you’ll likely have to edit it if you’re under Windows, e.g. using the one "
"included in Blender libraries repository"
msgstr ""
"Det kompilerade C-biblioteket FriBidi (.so i Linux, .dll i Windows …). I "
"Windows behöver du sannolikt redigera den här inställningen, till exempel "
"med versionen som ingår i Blenders biblioteksförråd"

#. :src: bpy.types.EXTENSIONS_OT_repo_lock_all
msgid "Lock repositories - to test locking"
msgstr "Lås förråd för att testa låsning"

#. :src: bpy.types.EXTENSIONS_OT_repo_lock_all
msgctxt "Operator"
msgid "Lock All Repositories (Testing)"
msgstr "Lås alla förråd (testning)"

#. :src: bpy.types.EXTENSIONS_OT_repo_unlock
msgid "Remove the repository file-system lock"
msgstr "Ta bort låset på förrådets filsystem"

#. :src: bpy.types.EXTENSIONS_OT_repo_unlock_all
msgid "Unlock repositories - to test unlocking"
msgstr "Lås upp förråd för att testa upplåsning"

#. :src: bpy.types.EXTENSIONS_OT_repo_unlock_all
msgctxt "Operator"
msgid "Unlock All Repositories (Testing)"
msgstr "Lås upp alla förråd (testning)"

#. :src: bpy.types.UI_OT_i18n_cleanuptranslation_work_repo
