msgstr "Uppdatera Blenders i18n-förråd"

#. :src: bpy.types.UI_OT_i18n_updatetranslation_work_repo
msgid "Update i18n working repository (po files)"
msgstr "Uppdatera i18n-arbetsförrådet (PO-filer)"

#. :src: bpy.types.UI_OT_i18n_updatetranslation_work_repo
msgctxt "Operator"
msgid "Update I18n Work Repository"
msgstr "Uppdatera I18n-arbetsförrådet"

#. :src: bpy.types.PREFERENCES_OT_asset_library_add.type:'REMOTE'
#. :src: bpy.types.PROJECT_OT_asset_library_add.type:'REMOTE'
msgid ""
"Add an asset library referencing a remote repository with support for "
"listing and updating asset libraries"
msgstr ""
"Lägg till ett resursbibliotek som refererar till ett fjärrförråd och stöder "
"listning och uppdatering av resursbibliotek"

#. :src: bpy.types.USERPREF_PT_extensions_filter
