#. :src: bpy.types.NODE_OT_add_group_input_node
msgctxt "Operator"
msgid "Add Group Input Node"
msgstr "Lägg till gruppindatanod"

#. :src: bpy.types.NODE_OT_add_group_input_node
msgid "Add a Group Input node with selected sockets to the current node editor"
msgstr ""
"Lägg till en gruppindatanod med valda uttag i den aktuella nodredigeraren"

#. :src: bpy.types.NODE_OT_cryptomatte_layer_add
msgid "Add a new input layer to a Cryptomatte node"
msgstr "Lägg till ett nytt indatalager i en Cryptomatte-nod"

#. :src: bpy.types.BrushGpencilSettings.use_auto_remove_fill_guides
msgid "Automatically remove fill guide strokes after fill operation"
msgstr "Ta bort fyllningshjälplinjers streck automatiskt efter fyllningen"

#. :src: bpy.types.WM_OT_call_asset_shelf_popover
msgctxt "Operator"
msgid "Call Asset Shelf Popover"
msgstr "Öppna resurshylla i popupfönster"

msgid ""
"Cannot pair zone input node %s with %s because it does not have the same "
"zone type"
msgstr ""
"Det går inte att para ihop zonindatanoden %s med %s eftersom de inte har "
"samma zontyp"

#. :src: bpy.types.NodeClosureInputItem
msgid "Closure Input Item"
msgstr "Slutningsindataobjekt"

#. :src: bpy.types.NodeClosureInputItems
msgid "Closure Input Items"
msgstr "Slutningsindataobjekt"

#. :src: bpy.types.NodeClosureOutputItem
msgid "Closure Output Item"
msgstr "Slutningsutdataobjekt"

#. :src: bpy.types.NodeClosureOutputItems
msgid "Closure Output Items"
msgstr "Slutningsutdataobjekt"

#. :src: bpy.types.NodeCompositorFileOutputItems
msgid "Collection of file output items"
msgstr "Samling av filutdataobjekt"

#. :src: bpy.types.Image.source:'VIEWER'
msgid "Compositing node viewer"
msgstr "Visningsnod för komposition"

#. :src: bpy.types.AnnotationStroke.display_mode
msgid "Coordinate space that stroke is in"
msgstr "Koordinatrymd för strecket"

#. :src: bpy.types.BrushGpencilSettings.show_lasso
msgid "Display fill color while drawing the stroke"
msgstr "Visa fyllningsfärgen medan strecket ritas"

#. :src: bpy.types.NodeTreeInterfaceSocket.hide_in_modifier
msgid "Don't show the input value in the geometry nodes modifier interface"
msgstr "Visa inte indatavärdet i modifieringsgränssnittet för geometrinoder"

#. :src: bpy.types.NodeCompositorFileOutputItem
msgid "File Output Item"
msgstr "Filutdataobjekt"

#. :src: bpy.types.TextureNodeTexture.node_output
msgid "For node-based textures, which output node to use"
msgstr "För nodbaserade texturer, vilken utdatanod som ska användas"

#. :src: bpy.types.Brush.jitter_unit
msgid "Jitter in screen space or relative to brush size"
msgstr "Variation i skärmrymden eller i förhållande till penselstorleken"

#. :src: bpy.types.Brush.jitter_unit:'VIEW'
msgid "Jittering happens in screen space, in pixels"
msgstr "Variationen sker i skärmrymden, i pixlar"

#. :src: bpy.types.NODE_OT_join_nodes
msgid "Merge selected group input nodes into one if possible"
msgstr "Slå ihop valda gruppindatanoder till en om möjligt"

#. :src: bpy.types.BrushGpencilSettings.stroke_type
msgid "Mode to use when creating strokes"
msgstr "Läge att använda när streck skapas"

msgid "Node group must have a group output node"
msgstr "Nodgruppen måste ha en grupputdatanod"

#. :src: bpy.types.WM_OT_debug_menu
msgid "Open a popup to set the debug level"
msgstr "Öppna ett popupfönster för att ange felsökningsnivån"

#. :src: bpy.types.WM_OT_call_asset_shelf_popover
msgid "Open a predefined asset shelf in a popup"
msgstr "Öppna en fördefinierad resurshylla i ett popupfönster"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'STROKE'
msgid "Painting affects only strokes, not fills"
msgstr "Målning påverkar endast streck, inte fyllningar"

#. :src: bpy.types.WM_OT_save_mainfile.show_save_modified_images_dialog
msgid ""
"Show a popup dialog to save modified images before saving the blend file"
msgstr ""
"Visa ett popupfönster för att spara ändrade bilder innan blend-filen sparas"

#. :src: bpy.types.NodeSocket.is_inactive
msgid ""
"Socket is grayed out because it has been detected to not have any effect on "
"the output"
msgstr ""
"Uttaget är gråmarkerat eftersom det har konstaterats att det inte har någon "
"effekt på nodutdata"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Space daubs according to surface orientation instead of screen space"
msgstr "Placera penselavtryck utifrån ytans riktning i stället för skärmrymden"

#. :src: bpy.types.BrushGpencilSettings.stroke_type
msgctxt "GPencil"
msgid "Stroke Mode"
msgstr "Streckläge"

#. :src: bpy.types.AnnotationStroke.display_mode:'2DIMAGE'
msgid "Stroke is in 2D image/UV space"
msgstr "Strecket är i 2D-bild-/UV-rymden"

#. :src: bpy.types.AnnotationStroke.display_mode:'2DSPACE'
msgid "Stroke is in 2D space, locked to the camera view"
msgstr "Strecket är i 2D-rymden och låst till kameravyn"

#. :src: bpy.types.AnnotationStroke.display_mode:'3DSPACE'
msgid "Stroke is in 3D space"
msgstr "Strecket är i 3D-rymden"

#. :src: bpy.types.BrushGpencilSettings.caps_type
msgid "The shape of the start and end of the stroke"
msgstr "Formen på streckets början och slut"

#. :src: bpy.types.AssetShelf.bl_space_type
msgid ""
"The space where the asset shelf will show up in. Ignored for popup asset "
"shelves which can be displayed in any space."
msgstr ""
"Arbetsytan där resurshyllan visas. Ignoreras för resurshyllor i "
"popupfönster, som kan visas i alla arbetsytor."

msgid ""
"This node should be linked to the group output node, optionally through "
"switch nodes."
msgstr ""
"Den här noden bör länkas till gruppens utdatanod, eventuellt genom "
"växlarnoder."

#. :src: bpy.types.Image.source:'VIEWER'
msgctxt "Image"
msgid "Viewer"
msgstr "Visningsnod"

#. :src: bpy.types.WireframeModifier
msgid "Wireframe effect modifier"
msgstr "Modifierare för trådramseffekt"

#. :src: bpy.types.GeometryNodeForeachGeometryElementInput.paired_output
#. :src: bpy.types.GeometryNodeRepeatInput.paired_output
#. :src: bpy.types.GeometryNodeSimulationInput.paired_output
#. :src: bpy.types.NodeClosureInput.paired_output
msgid "Zone output node that this input node is paired with"
msgstr "Zonutdatanod som denna indatanod är kopplad till"
