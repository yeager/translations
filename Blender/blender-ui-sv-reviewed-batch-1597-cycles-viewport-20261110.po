#. :src: bpy.types.CyclesRenderSettings.preview_dicing_rate
msgid "Viewport Dicing Rate"
msgstr "Indelningsgrad för vyport"

#. :src: bpy.types.CyclesRenderSettings.preview_dicing_rate
msgid "Multiplier for per object adaptive subdivision size in the viewport"
msgstr ""
"Multiplikator för adaptiv underindelningsstorlek per objekt i vyporten"

#. :src: bpy.types.CyclesRenderSettings.preview_samples
#. :src: bpy.types.SceneEEVEE.taa_samples
msgid "Viewport Samples"
msgstr "Sampel för vyport"

#. :src: bpy.types.CyclesRenderSettings.preview_samples
msgid "Number of samples to render in the viewport, unlimited if 0"
msgstr "Antal sampel som ska renderas i vyporten, obegränsat om 0"

#. :src: bpy.types.CyclesRenderSettings.preview_scrambling_distance
msgid "Scrambling Distance viewport"
msgstr "Blandningsavstånd för vyport"

#. :src: bpy.types.CyclesRenderSettings.preview_scrambling_distance
msgid ""
"Uses the Scrambling Distance value for the viewport. Faster but may flicker"
msgstr ""
"Använder värdet för blandningsavstånd för vyporten. Snabbare men kan flimra"

#. :src: bpy.types.CyclesRenderSettings.texture_limit
msgid "Viewport Texture Limit"
msgstr "Texturgräns för vyport"

#. :src: bpy.types.CyclesRenderSettings.texture_limit
msgid "Limit texture size used by viewport rendering"
msgstr "Begränsa texturstorleken som används vid rendering i vyporten"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution
msgid "Viewport Texture Resolution"
msgstr "Texturupplösning i vyport"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution
msgid "Scale factor for texture resolution used by viewport rendering"
msgstr ""
"Skalfaktor för texturupplösningen som används vid rendering i vyporten"

#. :src: bpy.types.CyclesRenderSettings.use_fast_gi
msgid ""
"Approximate diffuse indirect light with background tinted ambient occlusion."
" This provides fast alternative to full global illumination, for interactive"
" viewport rendering or final renders with reduced quality"
msgstr ""
"Approximerar diffust indirekt ljus med bakgrundsfärgad omgivningsocklusion. "
"Detta ger ett snabbt alternativ till fullständig global belysning, för "
"interaktiv rendering i vyporten eller slutrenderingar med lägre kvalitet"
