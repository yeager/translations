#. :src: bpy.types.Brush.stencil_dimension
msgid "Dimensions of stencil in viewport"
msgstr "Mått på schablonen i visningsområdet"

#. :src: bpy.types.Brush.stencil_pos
msgid "Stencil Position"
msgstr "Schablonposition"

#. :src: bpy.types.Brush.stencil_pos
msgid "Position of stencil in viewport"
msgstr "Schablonens position i visningsområdet"

#. :src: bpy.types.Brush.strength
#. :src: bpy.types.UnifiedPaintSettings.strength
msgid "How powerful the effect of the brush is when applied"
msgstr "Hur stark penselns effekt är när den tillämpas"

#. :src: bpy.types.Brush.stroke_method
msgctxt "GPencil"
msgid "Stroke Method"
msgstr "Penseldragsmetod"

#. :src: bpy.types.Brush.stroke_method:'DOTS'
msgctxt "GPencil"
msgid "Dots"
msgstr "Punkter"

#. :src: bpy.types.Brush.stroke_method:'DOTS'
msgid "Apply paint on each mouse move step"
msgstr "Applicera färg vid varje steg i musrörelsen"

#. :src: bpy.types.Brush.stroke_method:'DRAG_DOT'
msgctxt "GPencil"
msgid "Drag Dot"
msgstr "Dra punkt"

#. :src: bpy.types.Brush.stroke_method:'DRAG_DOT'
msgid "Allows a single dot to be carefully positioned"
msgstr "Gör det möjligt att placera en enda punkt noggrant"

#. :src: bpy.types.Brush.stroke_method:'SPACE'
#. :src: bpy.types.Brush.use_space
msgctxt "GPencil"
msgid "Space"
msgstr "Avstånd"

#. :src: bpy.types.Brush.stroke_method:'SPACE'
#. :src: bpy.types.Brush.use_space
msgid "Limit brush application to the distance specified by spacing"
msgstr ""
"Begränsa penseltillämpningen till avståndet som anges av inställningen "
"Avstånd"

#. :src: bpy.types.Brush.stroke_method:'AIRBRUSH'
msgctxt "GPencil"
msgid "Airbrush"
msgstr "Sprutpistol"

#. :src: bpy.types.Brush.stroke_method:'AIRBRUSH'
#. :src: bpy.types.Brush.use_airbrush
msgid "Keep applying paint effect while holding mouse (spray)"
msgstr "Fortsätt att applicera färg medan musknappen hålls nedtryckt (spray)"

#. :src: bpy.types.Brush.stroke_method:'ANCHORED'
msgctxt "GPencil"
msgid "Anchored"
msgstr "Förankrad"

#. :src: bpy.types.Brush.stroke_method:'ANCHORED'
#. :src: bpy.types.Brush.use_anchor
msgid "Keep the brush anchored to the initial location"
msgstr "Håll penseln förankrad vid startpunkten"

#. :src: bpy.types.Brush.stroke_method:'LINE'
msgctxt "GPencil"
msgid "Line"
msgstr "Linje"

#. :src: bpy.types.Brush.stroke_method:'LINE'
#. :src: bpy.types.Brush.use_line
msgid "Draw a line with dabs separated according to spacing"
msgstr "Rita en linje med penselavtryck med det angivna avståndet mellan dem"

#. :src: bpy.types.Brush.stroke_method:'CURVE'
msgctxt "GPencil"
msgid "Curve"
msgstr "Kurva"

#. :src: bpy.types.Brush.stroke_method:'CURVE'
msgid ""
"Define the stroke curve with a Bézier curve (dabs are separated according to "
"spacing)"
msgstr ""
"Definiera penseldragskurvan med en Bézier-kurva (penselavtrycken separeras "
"enligt avståndet)"

#. :src: bpy.types.Brush.surface_smooth_current_vertex
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_current_vertex
msgid "Per Vertex Displacement"
msgstr "Förskjutning per hörnpunkt"

#. :src: bpy.types.Brush.surface_smooth_current_vertex
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_current_vertex
msgid ""
"How much the position of each individual vertex influences the final result"
msgstr "Hur mycket varje enskild hörnpunkts position påverkar slutresultatet"

#. :src: bpy.types.Brush.surface_smooth_iterations
msgid "Number of smoothing iterations per brush step"
msgstr "Antal utjämningsiterationer per penselsteg"

#. :src: bpy.types.Brush.surface_smooth_shape_preservation
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_shape_preservation
msgid "Shape Preservation"
msgstr "Formbevarande"

#. :src: bpy.types.Brush.surface_smooth_shape_preservation
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_shape_preservation
msgid "How much of the original shape is preserved when smoothing"
msgstr "Hur mycket av den ursprungliga formen som bevaras vid utjämning"

#. :src: bpy.types.Brush.texture_overlay_alpha
msgid "Texture Overlay Alpha"
msgstr "Alfa för texturöverlägg"

#. :src: bpy.types.Brush.texture_sample_bias
msgid "Texture Sample Bias"
msgstr "Förskjutning av texturprov"

#. :src: bpy.types.Brush.texture_sample_bias
msgid "Value added to texture samples"
msgstr "Värde som läggs till i texturproven"

#. :src: bpy.types.Brush.tilt_strength_factor
msgid "Tilt Strength"
msgstr "Lutningsstyrka"

#. :src: bpy.types.Brush.tilt_strength_factor
msgid ""
"How much the tilt of the pen will affect the brush. Negative values indicate "
"inverting the tilt directions."
msgstr ""
"Hur mycket pennans lutning påverkar penseln. Negativa värden vänder "
"lutningsriktningen."

#. :src: bpy.types.Brush.tip_roundness
#. :src: Socket name from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Tip Roundness"
msgstr "Spetsens rundhet"

#. :src: bpy.types.Brush.tip_roundness
msgid "Roundness of the brush tip"
msgstr "Penselspetsens rundhet"

#. :src: bpy.types.Brush.tip_scale_x
msgid "Tip Scale X"
msgstr "Spetsskala X"

#. :src: bpy.types.Brush.tip_scale_x
msgid "Scale of the brush tip in the X axis"
msgstr "Skala för penselspetsen i X-axeln"

#. :src: bpy.types.Brush.topology_rake_factor
msgid "Topology Rake"
msgstr "Topologisk krattning"

#. :src: bpy.types.Brush.topology_rake_factor
msgid ""
"Automatically align edges to the brush direction to generate cleaner "
"topology and define sharp features. Best used on low-poly meshes as it has a "
"performance impact."
msgstr ""
"Rikta automatiskt kanterna efter penselns riktning för att skapa en renare "
"topologi och framhäva skarpa detaljer. Fungerar bäst på lågpoly-mesher "
"eftersom det påverkar prestandan."

#. :src: bpy.types.Brush.unprojected_radius
#. :src: bpy.types.UnifiedPaintSettings.unprojected_radius
msgid "Unprojected Radius"
msgstr "Oprojicerad radie"

#. :src: bpy.types.Brush.unprojected_radius
#. :src: bpy.types.UnifiedPaintSettings.unprojected_radius
msgid "Radius of brush in Blender units"
msgstr "Radie för pensel i Blender-enheter"

#. :src: bpy.types.Brush.use_accumulate
#. :src: bpy.types.GRAPH_OT_sound_to_samples.use_accumulate
msgid "Accumulate"
msgstr "Ackumulera"

#. :src: bpy.types.Brush.use_accumulate
msgid "Accumulate stroke daubs on top of each other"
msgstr "Ackumulera penselavtryck ovanpå varandra"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Adaptive Spacing"
msgstr "Adaptivt penselavstånd"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Space daubs according to surface orientation instead of screen space"
msgstr ""
"Placera penselavtryck utifrån ytans riktning i stället för skärmutrymmet"

#. :src: bpy.types.Brush.use_airbrush
msgid "Airbrush"
msgstr "Sprutpistol"
