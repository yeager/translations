msgstr "Kopiera valda nyckelrutor till det interna urklippet"

#. :src: bpy.types.CLIP_OT_copy_tracks
msgid "Copy the selected tracks to the internal clipboard"
msgstr "Kopiera de valda spåren till det interna urklippet"

#. :src: bpy.types.CLIP_OT_paste_tracks
msgid "Paste tracks from the internal clipboard"
msgstr "Klistra in spår från det interna urklippet"

