#. :src: bpy.types.DopeSheet.show_modifiers
msgid "Display Modifier Data"
msgstr "Visa modifieringsdata"

#. :src: bpy.types.DopeSheet.show_modifiers
msgid ""
"Include visualization of animation data related to data-blocks linked to "
"modifiers"
msgstr ""
"Visa även animeringsdata för datablock som är kopplade till modifierare"

#. :src: bpy.types.DopeSheet.show_movieclips
msgid "Display Movie Clips"
msgstr "Visa filmklipp"

#. :src: bpy.types.DopeSheet.show_movieclips
msgid "Include visualization of movie clip related animation data"
msgstr "Visa även filmklippsrelaterade animeringsdata"

#. :src: bpy.types.DopeSheet.show_nodes
msgid "Display Node"
msgstr "Visa nod"

#. :src: bpy.types.DopeSheet.show_nodes
msgid "Include visualization of node related animation data"
msgstr "Visa även nodrelaterade animeringsdata"

#. :src: bpy.types.DopeSheet.show_only_errors
msgid "Only Show Errors"
msgstr "Visa endast fel"

#. :src: bpy.types.DopeSheet.show_only_errors
msgid "Only include F-Curves and drivers that are disabled or have errors"
msgstr "Visa endast F-kurvor och drivrutiner som är inaktiverade eller har fel"

#. :src: bpy.types.DopeSheet.show_only_selected
#. :src: bpy.types.Scene.show_keys_from_selected_only
#. :src: bpy.types.MovieTrackingDopesheet.show_only_selected
#. :src: bpy.types.SpaceClipEditor.show_graph_only_selected
msgid "Only Show Selected"
msgstr "Visa endast valda"

#. :src: bpy.types.DopeSheet.show_only_selected
#. :src: bpy.types.Scene.show_keys_from_selected_only
#. :src: bpy.types.MovieTrackingDopesheet.show_only_selected
#. :src: bpy.types.SpaceClipEditor.show_graph_only_selected
msgid "Only include channels relating to selected objects and data"
msgstr "Visa endast kanaler som hör till valda objekt och data"
