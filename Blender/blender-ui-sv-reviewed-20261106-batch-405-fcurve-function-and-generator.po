#. :src: bpy.types.FModifierFunctionGenerator.amplitude
#. :src: bpy.types.FieldSettings.guide_kink_amplitude
#. :src: bpy.types.ParticleSettings.kink_amplitude
#. :src: bpy.types.Keyframe.amplitude
#. :src: bpy.types.LineStyleAlphaModifier_Noise.amplitude
#. :src: bpy.types.LineStyleColorModifier_Noise.amplitude
#. :src: bpy.types.LineStyleGeometryModifier_PerlinNoise1D.amplitude
#. :src: bpy.types.LineStyleGeometryModifier_PerlinNoise2D.amplitude
#. :src: bpy.types.LineStyleGeometryModifier_SinusDisplacement.amplitude
#. :src: bpy.types.LineStyleGeometryModifier_SpatialNoise.amplitude
#. :src: bpy.types.LineStyleThicknessModifier_Noise.amplitude
#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.amplitude
#. :src: bpy.types.ShaderFxShadow.amplitude
#. :src: bpy.types.ShaderFxWave.amplitude
#: scripts/startup/bl_ui/properties_particle.py:1916
msgid "Amplitude"
msgstr "Amplitud"

#. :src: bpy.types.FModifierFunctionGenerator.amplitude
msgid "Scale factor determining the maximum/minimum values"
msgstr "Skalfaktor som bestämmer maximi-/minimivärdena"

#. :src: bpy.types.FModifierFunctionGenerator.function_type
msgid "Type of built-in function to use"
msgstr "Typ av inbyggd funktion som ska användas"

#. :src: bpy.types.FModifierFunctionGenerator.function_type:'SIN'
#. :src: bpy.types.WoodTexture.noise_basis_2:'SIN'
#. :src: bpy.types.ShaderNodeTexWave.wave_profile:'SIN'
msgid "Sine"
msgstr "Sinus"

#. :src: bpy.types.FModifierFunctionGenerator.function_type:'COS'
msgid "Cosine"
msgstr "Cosinus"

#. :src: bpy.types.FModifierFunctionGenerator.function_type:'SQRT'
msgid "Square Root"
msgstr "Kvadratrot"

#. :src: bpy.types.FModifierFunctionGenerator.function_type:'LN'
msgid "Natural Logarithm"
msgstr "Naturlig logaritm"

#. :src: bpy.types.FModifierFunctionGenerator.function_type:'SINC'
msgid "Normalized Sine"
msgstr "Normaliserad sinuskurva"

#. :src: bpy.types.FModifierFunctionGenerator.function_type:'SINC'
msgid "sin(x) / x"
msgstr "sin(x) / x"

#. :src: bpy.types.FModifierFunctionGenerator.phase_multiplier
msgid "Phase Multiple"
msgstr "Fasmultiplikator"

#. :src: bpy.types.FModifierFunctionGenerator.phase_multiplier
msgid "Scale factor determining the 'speed' of the function"
msgstr "Skalfaktor som bestämmer funktionens hastighet"

#. :src: bpy.types.FModifierFunctionGenerator.phase_offset
#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:45
msgid "Phase Offset"
msgstr "Fasförskjutning"

#. :src: bpy.types.FModifierFunctionGenerator.phase_offset
msgid "Constant factor to offset time by for function"
msgstr "Konstant faktor som tidsförskjuter funktionen"

#. :src: bpy.types.FModifierFunctionGenerator.use_additive
#. :src: bpy.types.FModifierGenerator.use_additive
#. :src: bpy.types.FieldSettings.use_guide_path_add
#. :src: bpy.types.GRAPH_OT_sound_to_samples.use_additive
msgid "Additive"
msgstr "Additiv"

#. :src: bpy.types.FModifierFunctionGenerator.use_additive
#. :src: bpy.types.FModifierGenerator.use_additive
msgid ""
"Values generated by this modifier are applied on top of the existing values "
"instead of overwriting them"
msgstr ""
"Värden som genereras av denna modifierare läggs till de befintliga värdena i "
"stället för att skriva över dem"

#. :src: bpy.types.FModifierFunctionGenerator.value_offset
#. :src: bpy.types.GRAPH_OT_paste.value_offset
msgid "Value Offset"
msgstr "Värdeförskjutning"

#. :src: bpy.types.FModifierFunctionGenerator.value_offset
msgid "Constant factor to offset values by"
msgstr "Konstant faktor som förskjuter värdena"

#. :src: bpy.types.FModifierGenerator
msgid "Generator F-Modifier"
msgstr "Generatormodifierare"

#. :src: bpy.types.FModifierGenerator
msgid "Deterministically generate values for the modified F-Curve"
msgstr ""
"Generera värden för den modifierade F-kurvan på ett deterministiskt sätt"

#. :src: bpy.types.FModifierGenerator.coefficients
msgid "Coefficients"
msgstr "Koefficienter"

#. :src: bpy.types.FModifierGenerator.coefficients
msgid "Coefficients for 'x' (starting from lowest power of x^0)"
msgstr "Koefficienter för \"x\" (med början från lägsta potensen av x^0)"

#. :src: bpy.types.FModifierGenerator.mode
msgid "Type of generator to use"
msgstr "Typ av generator som ska användas"

#. :src: bpy.types.FModifierGenerator.mode:'POLYNOMIAL'
msgid "Expanded Polynomial"
msgstr "Expanderat polynom"

#. :src: bpy.types.FModifierGenerator.mode:'POLYNOMIAL_FACTORISED'
msgid "Factorized Polynomial"
msgstr "Faktoriserat polynom"

#. :src: bpy.types.FModifierGenerator.poly_order
msgid "Polynomial Order"
msgstr "Polynomgrad"

#. :src: bpy.types.FModifierGenerator.poly_order
msgid ""
"The highest power of 'x' for this polynomial (number of coefficients - 1)"
msgstr ""
"Den högsta potensen av \"x\" för detta polynom (antal koefficienter - 1)"

#. :src: bpy.types.FModifierLimits
msgid "Limit F-Modifier"
msgstr "Begränsningsmodifierare"

#. :src: bpy.types.FModifierLimits
msgid "Limit the time/value ranges of the modified F-Curve"
msgstr "Begränsa tids-/värdeintervallen för den modifierade F-kurvan"
