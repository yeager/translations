#. :src: bpy.types.DriverTarget.context_property:'ACTIVE_VIEW_LAYER'
#. :src: bpy.types.Window.view_layer
msgid "Active View Layer"
msgstr "Aktivt visningslager"

#. :src: bpy.types.ViewLayer.has_export_collections
msgid "At least one Collection in this View Layer has an exporter"
msgstr "Minst en samling i detta visningslager har en exportör"

msgid "Clipping works in Wireframe and Solid viewport shading only"
msgstr ""
"Klippning fungerar endast med skuggningslägena trådram och solid i 3D-"
"vyporten"

#. :src: bpy.types.DriverTarget.context_property:'ACTIVE_VIEW_LAYER'
msgid "Currently evaluating view layer"
msgstr "Visningslagret som utvärderas"

#. :src: bpy.types.ViewLayer.cycles
msgid "Cycles ViewLayer Settings"
msgstr "Cycles-inställningar för visningslager"

#. :src: bpy.types.ViewLayer.material_override
msgid "Material to override all other materials in this view layer"
msgstr "Material som åsidosätter alla andra material i detta visningslager"

#. :src: bpy.types.ViewLayer.samples
msgid ""
"Override number of render samples for this view layer, 0 will use the scene "
"setting"
msgstr ""
"Åsidosätt antalet renderingssampler för detta visningslager. 0 använder "
"sceninställningen"

#. :src: bpy.types.ViewLayer.layer_collection
msgid ""
"Root of collections hierarchy of this view layer, its 'collection' pointer "
"property is the same as the scene's master collection"
msgstr ""
"Roten för samlingshierarkin i detta visningslager. Dess \"collection\"-"
"pekare är samma som scenens huvudsamling"

#. :src: bpy.types.Window.view_layer
msgid "The active workspace view layer showing in the window"
msgstr "Arbetsytans aktiva visningslager som visas i fönstret"

#. :src: bpy.types.WireframeModifier
msgid "Wireframe effect modifier"
msgstr "Modifierare för trådramseffekt"
