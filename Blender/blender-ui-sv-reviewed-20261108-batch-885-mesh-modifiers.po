#. :src: bpy.types.MaskModifier
msgid "Mask modifier to hide parts of the mesh"
msgstr "Maskmodifierare för att dölja delar av meshen"

#. :src: bpy.types.VolumeToMeshModifier.threshold
msgid "Voxels with a larger value are inside the generated mesh"
msgstr "Voxlar med ett högre värde ligger inuti den genererade meshen"

#. :src: bpy.types.MeshDeformModifier
msgid "Mesh deformation modifier to deform with other meshes"
msgstr "Modifierare för meshdeformation med andra meshar"

#. :src: bpy.types.MeshToVolumeModifier.interior_band_width
#: source/blender/nodes/geometry/nodes/node_geo_mesh_to_density_grid.cc:32
#: source/blender/nodes/geometry/nodes/node_geo_mesh_to_volume.cc:64
msgid "Width of the gradient inside of the mesh"
msgstr "Bredden på gradienten inuti meshen"

#. :src: bpy.types.MirrorModifier.use_bisect_axis
msgid "Cuts the mesh across the mirror plane"
msgstr "Skär meshen tvärs över spegelplanet"

#. :src: bpy.types.MultiresModifier.use_custom_normals
#. :src: bpy.types.SubsurfModifier.use_custom_normals
msgid "Interpolates existing custom normals to resulting mesh"
msgstr "Interpolerar befintliga anpassade normaler till den resulterande meshen"

#. :src: bpy.types.ParticleInstanceModifier.space
msgid "Space to use for copying mesh data"
msgstr "Koordinatutrymme som används för kopiering av meshdata"

#. :src: bpy.types.SubsurfModifier.adaptive_space
msgid "How to adaptively subdivide the mesh"
msgstr "Hur meshen ska delas upp adaptivt"

#. :src: bpy.types.SubsurfModifier.use_adaptive_subdivision
msgid "Adaptively subdivide mesh based on camera distance"
msgstr "Dela upp meshen adaptivt utifrån kameraavståndet"

#. :src: bpy.types.SurfaceDeformModifier.is_bound
msgid "Whether geometry has been bound to target mesh"
msgstr "Om geometrin har kopplats till målmeshen"
