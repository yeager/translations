#. :src: bpy.types.GeometryNodeFillCurve
msgid ""
"Generate a mesh on the XY plane with faces on the inside of input curves"
msgstr "Generera en mesh på XY-planet med ytor på insidan av indatakurvorna"

#. :src: bpy.types.GeometryNodeFilletCurve
msgid "Fillet Curve"
msgstr "Avrunda kurva"

#. :src: bpy.types.GeometryNodeFilletCurve.mode
msgid "How to choose number of vertices on fillet"
msgstr "Hur antalet hörnpunkter för avrundningen ska väljas"

#. :src: bpy.types.GeometryNodeFlipFaces
msgid "Flip Faces"
msgstr "Vänd ytor"

#. :src: bpy.types.GeometryNodeFlipFaces
msgid ""
"Reverse the order of the vertices and edges of selected faces, flipping "
"their normal direction"
msgstr ""
"Vänd om ordningen på hörnpunkterna och kanterna för markerade ytor och vänd "
"deras normalriktning"

#. :src: bpy.types.GeometryNodeForeachGeometryElementOutput.active_main_index
msgid "Active Main Item Index"
msgstr "Index för aktivt huvudelement"

#. :src: bpy.types.GeometryNodeForeachGeometryElementOutput.inspection_index
#. :src: bpy.types.GeometryNodeRepeatOutput.inspection_index
msgid ""
"Iteration index that is used by inspection features like the viewer node or "
"socket inspection"
msgstr ""
"Iterationsindex som används av inspektionsfunktioner som visarnoden eller "
"uttagsinspektion"

#. :src: bpy.types.GeometryNodeGeometryToInstance
msgid ""
"Convert each input geometry into an instance, which can be much faster than "
"the Join Geometry node when the inputs are large"
msgstr ""
"Konvertera varje indatageometri till en instans, vilket kan vara mycket "
"snabbare än noden Sammanfoga geometri när indata är stora"

#. :src: bpy.types.GeometryNodeGetNamedGrid
msgid "Get Named Grid"
msgstr "Hämta namngivet rutnät"

#. :src: bpy.types.GeometryNodeGetNamedGrid
msgid "Get volume grid from a volume geometry with the specified name"
msgstr "Hämta volymrutnät från en volymgeometri med angivet namn"

#. :src: bpy.types.GeometryNodeGetNamedGrid.data_type
#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type
msgid "Type of grid data"
msgstr "Typ av rutnätsdata"

#. :src: bpy.types.GeometryNodeGizmoLinear.draw_style
msgctxt "NodeTree"
msgid "Draw Style"
msgstr "Ritstil"

#. :src: bpy.types.GeometryNodeGizmoLinear.draw_style:'CROSS'
msgctxt "NodeTree"
msgid "Cross"
msgstr "Kors"

#. :src: bpy.types.GeometryNodeGizmoTransform
msgid "Transform Gizmo"
msgstr "Transformationsgizmo"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_rotation_x
msgid "Use Rotation X"
msgstr "Använd X-rotation"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_rotation_y
msgid "Use Rotation Y"
msgstr "Använd Y-rotation"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_rotation_z
msgid "Use Rotation Z"
msgstr "Använd Z-rotation"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_scale_x
msgid "Use Scale X"
msgstr "Använd X-skala"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_scale_y
msgid "Use Scale Y"
msgstr "Använd Y-skala"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_scale_z
msgid "Use Scale Z"
msgstr "Använd Z-skala"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_translation_x
msgid "Use Translation X"
msgstr "Använd X-förskjutning"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_translation_y
msgid "Use Translation Y"
msgstr "Använd Y-förskjutning"

#. :src: bpy.types.GeometryNodeGizmoTransform.use_translation_z
msgid "Use Translation Z"
msgstr "Använd Z-förskjutning"

#. :src: bpy.types.GeometryNodeGreasePencilToCurves
msgid "Grease Pencil to Curves"
msgstr "Grease Pencil till kurvor"

#. :src: bpy.types.GeometryNodeGridToMesh
msgid "Grid to Mesh"
msgstr "Rutnät till mesh"

#. :src: bpy.types.GeometryNodeGridToMesh
msgid "Generate a mesh on the \"surface\" of a volume grid"
msgstr "Generera en mesh på \"ytan\" av ett volymrutnät"

#. :src: bpy.types.GeometryNodeImageTexture.interpolation:'Closest'
#. :src: bpy.types.ShaderNodeTexEnvironment.interpolation:'Closest'
#. :src: bpy.types.ShaderNodeTexImage.interpolation:'Closest'
#. :src: bpy.types.ShaderNodeTexPointDensity.interpolation:'Closest'
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.interpolation:'Closest'
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.interpolation:'Closest'
#. :src: bpy.types.ImagePaint.interpolation:'CLOSEST'
msgid "No interpolation (sample closest texel)"
msgstr "Ingen interpolering (provta närmaste texel)"

#. :src: bpy.types.GeometryNodeImportOBJ
msgid "Import OBJ"
msgstr "Importera OBJ"

#. :src: bpy.types.GeometryNodeImportPLY
msgid "Import PLY"
msgstr "Importera PLY"

#. :src: bpy.types.GeometryNodeImportSTL
msgid "Import STL"
msgstr "Importera STL"

#. :src: bpy.types.GeometryNodeImportSTL
msgid "Import a mesh from an STL file"
msgstr "Importera en mesh från en STL-fil"

#. :src: bpy.types.GeometryNodeImportText
msgid "Import Text"
msgstr "Importera text"

#. :src: bpy.types.GeometryNodeIndexOfNearest
#: source/blender/nodes/geometry/nodes/node_geo_index_of_nearest.cc:60
msgid "Index of Nearest"
msgstr "Index för närmaste"

#. :src: bpy.types.GeometryNodeIndexOfNearest
msgid ""
"Find the nearest element in a group. Similar to the \"Sample Nearest\" node"
msgstr ""
"Hitta det närmaste elementet i en grupp. Liknar noden \"Provta närmaste\""

#. :src: bpy.types.GeometryNodeInputCollection
msgid "Output a single collection"
msgstr "Mata ut en enskild samling"

#. :src: bpy.types.GeometryNodeInputCurveTilt
msgid "Curve Tilt"
msgstr "Kurvlutning"

#. :src: bpy.types.GeometryNodeInputImage
msgid "Input an image data-block"
msgstr "Mata in ett bilddatablock"

#. :src: bpy.types.GeometryNodeInputInstanceBounds
msgid "Instance Bounds"
msgstr "Instansgränser"

#. :src: bpy.types.GeometryNodeInputInstanceRotation
msgid "Instance Rotation"
msgstr "Instansrotation"

#. :src: bpy.types.GeometryNodeInputInstanceScale
msgid "Instance Scale"
msgstr "Instansskala"

#. :src: bpy.types.GeometryNodeInputMaterial
msgid "Output a single material"
msgstr "Mata ut ett enskilt material"

#. :src: bpy.types.GeometryNodeInputMeshEdgeAngle
msgid "The angle between the normals of connected manifold faces"
msgstr "Vinkeln mellan normalerna på anslutna manifoldytor"

#. :src: bpy.types.GeometryNodeInputMeshEdgeNeighbors
msgid "Edge Neighbors"
msgstr "Kantgrannar"

#. :src: bpy.types.GeometryNodeInputMeshEdgeVertices
msgid "Edge Vertices"
msgstr "Kanthörnpunkter"

#. :src: bpy.types.GeometryNodeInputMeshEdgeVertices
msgid "Retrieve topology information relating to each edge of a mesh"
msgstr "Hämta topologiinformation för varje kant i en mesh"

#. :src: bpy.types.GeometryNodeInputMeshFaceIsPlanar
msgid "Is Face Planar"
msgstr "Är ytan plan"

#. :src: bpy.types.GeometryNodeInputMeshFaceNeighbors
msgid "Face Neighbors"
msgstr "Ytgrannar"

#. :src: bpy.types.GeometryNodeInputMeshFaceNeighbors
msgid "Retrieve topology information relating to each face of a mesh"
msgstr "Hämta topologiinformation för varje yta i en mesh"

#. :src: bpy.types.GeometryNodeInputMeshVertexNeighbors
msgid "Vertex Neighbors"
msgstr "Hörnpunktsgrannar"

#. :src: bpy.types.GeometryNodeInputMeshVertexNeighbors
msgid "Retrieve topology information relating to each vertex of a mesh"
msgstr "Hämta topologiinformation för varje hörnpunkt i en mesh"

#. :src: bpy.types.GeometryNodeInputNamedLayerSelection
msgid "Named Layer Selection"
msgstr "Namngivet lagerurval"

#. :src: bpy.types.GeometryNodeInputNamedLayerSelection
msgid "Output a selection of a Grease Pencil layer"
msgstr "Mata ut ett urval av ett Grease Pencil-lager"

#. :src: bpy.types.GeometryNodeInputObject
msgid "Output a single object"
msgstr "Mata ut ett enskilt objekt"

#. :src: bpy.types.GeometryNodeInputShadeSmooth
msgid "Is Face Smooth"
msgstr "Är ytan slät"

#. :src: bpy.types.GeometryNodeInputSplineCyclic
msgid "Is Spline Cyclic"
msgstr "Är splinen cyklisk"

#. :src: bpy.types.GeometryNodeInputTangent
msgid "Curve Tangent"
msgstr "Kurvtangent"

#. :src: bpy.types.GeometryNodeInstanceTransform
#: source/blender/makesrna/intern/rna_node_tree_interface.cc:468
msgid "Instance Transform"
msgstr "Instanstransformation"

#. :src: bpy.types.GeometryNodeIsViewport
#: source/blender/nodes/geometry/nodes/node_geo_is_viewport.cc:12
msgid "Is Viewport"
msgstr "Är vyport"

#. :src: bpy.types.GeometryNodeIsViewport
msgid ""
"Retrieve whether the nodes are being evaluated for the viewport rather than "
"the final render"
msgstr ""
"Kontrollera om noderna utvärderas för vyporten i stället för den slutliga "
"renderingen"

#. :src: bpy.types.GeometryNodeMaterialSelection
msgid "Provide a selection of faces that use the specified material"
msgstr "Tillhandahåll ett urval av ytor som använder det angivna materialet"

#. :src: bpy.types.GeometryNodeMenuSwitch
msgid "Select from multiple inputs by name"
msgstr "Välj bland flera indata efter namn"

#. :src: bpy.types.GeometryNodeMenuSwitch.active_item
msgid "Active Item"
msgstr "Aktivt element"

#. :src: bpy.types.GeometryNodeMenuSwitch.active_item
#. :src: bpy.types.NodeTreeInterface.active
msgid "Active item"
msgstr "Aktivt element"

#. :src: bpy.types.GeometryNodeMergeByDistance
msgid "Merge vertices or points within a given distance"
msgstr "Sammanfoga hörnpunkter eller punkter inom ett givet avstånd"

#. :src: bpy.types.GeometryNodeMergeByDistance.mode:'CONNECTED'
msgid ""
"Only merge mesh vertices along existing edges. This method can be much faster"
msgstr ""
"Sammanfoga endast mesh-hörnpunkter längs befintliga kanter. Denna metod kan "
"vara mycket snabbare"

#. :src: bpy.types.GeometryNodeMergeLayers
msgid "Join groups of Grease Pencil layers into one"
msgstr "Slå samman grupper av Grease Pencil-lager till en grupp"

#. :src: bpy.types.GeometryNodeMeshBoolean
msgid "Cut, subtract, or join multiple mesh inputs"
msgstr "Skär, subtrahera eller sammanfoga flera mesh-indata"

#. :src: bpy.types.GeometryNodeMeshFaceSetBoundaries
#: source/blender/nodes/geometry/nodes/node_geo_mesh_face_group_boundaries.cc:32
msgid "Face Group Boundaries"
msgstr "Ytgruppsgränser"

#. :src: bpy.types.GeometryNodeMeshFaceSetBoundaries
msgid ""
"Find edges on the boundaries between groups of faces with the same ID value"
msgstr "Hitta kanter på gränserna mellan grupper av ytor med samma ID-värde"

#. :src: bpy.types.GeometryNodeMeshLine
msgid "Generate vertices in a line and connect them with edges"
msgstr "Generera hörnpunkter i en linje och koppla ihop dem med kanter"

#. :src: bpy.types.GeometryNodeMeshLine.count_mode:'TOTAL'
msgid "Specify the total number of vertices"
msgstr "Ange det totala antalet hörnpunkter"

#. :src: bpy.types.GeometryNodeMeshLine.mode:'OFFSET'
msgid "Specify the offset from one vertex to the next"
msgstr "Ange förskjutningen från en hörnpunkt till nästa"

#. :src: bpy.types.GeometryNodeMeshToCurve.mode:'EDGES'
msgid ""
"Convert mesh edges to curve segments. Attributes are propagated to curve "
"points."
msgstr ""
"Konvertera mesh-kanter till kurvsegment. Attributen överförs till "
"kurvpunkterna."

#. :src: bpy.types.GeometryNodeMeshToCurve.mode:'FACES'
msgid ""
"Convert each mesh face to a cyclic curve. Face attributes are propagated to "
"curves."
msgstr ""
"Konvertera varje meshyta till en cyklisk kurva. Ytattributen överförs till "
"kurvorna."

#. :src: bpy.types.GeometryNodeMeshToDensityGrid
msgid "Create a filled volume grid from a mesh"
msgstr "Skapa ett volymrutnät med fyllning från en mesh"

#. :src: bpy.types.GeometryNodeMeshToPoints
msgid "Generate a point cloud from a mesh's vertices"
msgstr "Generera ett punktmoln från en meshs hörnpunkter"

#. :src: bpy.types.GeometryNodeMeshToPoints.mode:'VERTICES'
msgid "Create a point in the point cloud for each selected vertex"
msgstr "Skapa en punkt i punktmolnet för varje vald hörnpunkt"

#. :src: bpy.types.GeometryNodeMeshToSDFGrid
msgid "Mesh to SDF Grid"
msgstr "Mesh till SDF-rutnät"

#. :src: bpy.types.GeometryNodeMeshToSDFGrid
msgid "Create a signed distance volume grid from a mesh"
msgstr "Skapa ett volymrutnät med signerat avstånd från en mesh"

#. :src: bpy.types.GeometryNodeMeshToVolume
msgid "Create a fog volume with the shape of the input mesh's surface"
msgstr "Skapa en dimvolym med formen av indatameshens yta"

#. :src: bpy.types.GeometryNodeOffsetCornerInFace
#: source/blender/nodes/geometry/nodes/node_geo_mesh_topology_offset_corner_in_face.cc:29
msgid "Offset Corner in Face"
msgstr "Förskjut hörn i yta"

#. :src: bpy.types.GeometryNodeOffsetCornerInFace
msgid "Retrieve corners in the same face as another"
msgstr "Hämta hörn på samma yta som ett annat"

#. :src: bpy.types.GeometryNodeOffsetPointInCurve
msgid "Offset a control point index within its curve"
msgstr "Förskjut en styrpunkts index inom dess kurva"

#. :src: bpy.types.GeometryNodePointsOfCurve
msgid "Points of Curve"
msgstr "Punkter på kurva"

#. :src: bpy.types.GeometryNodePointsOfCurve
msgid "Retrieve a point index within a curve"
msgstr "Hämta ett punktindex i en kurva"

#. :src: bpy.types.GeometryNodePointsToSDFGrid
msgid "Points to SDF Grid"
msgstr "Punkter till SDF-rutnät"

#. :src: bpy.types.GeometryNodePointsToSDFGrid
msgid "Create a signed distance volume grid from points"
msgstr "Skapa ett volymrutnät med signerat avstånd från punkter"

#. :src: bpy.types.GeometryNodePointsToVertices
msgid "Points to Vertices"
msgstr "Punkter till hörnpunkter"

#. :src: bpy.types.GeometryNodePointsToVertices
msgid "Generate a mesh vertex for each point cloud point"
msgstr "Generera en mesh-hörnpunkt för varje punkt i punktmolnet"

#. :src: bpy.types.GeometryNodeProximity
msgid "Geometry Proximity"
msgstr "Geometrisk närhet"

#. :src: bpy.types.GeometryNodeProximity
msgid "Compute the closest location on the target geometry"
msgstr "Beräkna den närmaste positionen på målgeometrin"

#. :src: bpy.types.GeometryNodeProximity.target_element:'FACES'
msgid "Calculate the proximity to the target's faces"
msgstr "Beräkna närheten till målets ytor"

#. :src: bpy.types.GeometryNodeRaycast.mapping:'NEAREST'
msgid "Use the attribute value of the closest mesh element"
msgstr "Använd attributvärdet för det närmaste meshelementet"

#. :src: bpy.types.GeometryNodeRemoveAttribute
msgid "Remove Named Attribute"
msgstr "Ta bort namngivet attribut"

#. :src: bpy.types.GeometryNodeRemoveAttribute
msgid ""
"Delete an attribute with a specified name from a geometry. Typically used to "
"optimize performance"
msgstr ""
"Ta bort ett attribut med ett angivet namn från en geometri. Används oftast "
"för att optimera prestanda"
