#. :src: bpy.types.FluidDomainSettings.simulation_method
msgid "Simulation Method"
msgstr "Simuleringsmetod"

#. :src: bpy.types.FluidDomainSettings.simulation_method
msgid "Change the underlying simulation method"
msgstr "Ändra den underliggande simuleringsmetoden"

#. :src: bpy.types.FluidDomainSettings.simulation_method:'FLIP'
msgid "Use FLIP as the simulation method (more splashy behavior)"
msgstr "Använd FLIP som simuleringsmetod (ger mer stänk)"

#. :src: bpy.types.FluidDomainSettings.simulation_method:'APIC'
msgid "APIC"
msgstr "APIC"

#. :src: bpy.types.FluidDomainSettings.simulation_method:'APIC'
msgid "Use APIC as the simulation method (more energetic and stable behavior)"
msgstr "Använd APIC som simuleringsmetod (mer energiskt och stabilt beteende)"

#. :src: bpy.types.FluidDomainSettings.slice_axis:'AUTO'
#. :src: bpy.types.VolumeDisplay.slice_axis:'AUTO'
msgid "Adjust slice direction according to the view direction"
msgstr "Justera skivriktningen efter visningsriktningen"

#. :src: bpy.types.FluidDomainSettings.slice_axis:'X'
#. :src: bpy.types.VolumeDisplay.slice_axis:'X'
msgid "Slice along the X axis"
msgstr "Skiva längs X-axeln"

#. :src: bpy.types.FluidDomainSettings.slice_axis:'Y'
#. :src: bpy.types.VolumeDisplay.slice_axis:'Y'
msgid "Slice along the Y axis"
msgstr "Skiva längs Y-axeln"

#. :src: bpy.types.FluidDomainSettings.slice_axis:'Z'
#. :src: bpy.types.VolumeDisplay.slice_axis:'Z'
msgid "Slice along the Z axis"
msgstr "Skiva längs Z-axeln"

#. :src: bpy.types.FluidDomainSettings.slice_depth
#. :src: bpy.types.VolumeDisplay.slice_depth
msgid "Position of the slice"
msgstr "Skivans position"

#. :src: bpy.types.FluidDomainSettings.slice_per_voxel
msgid "Slice Per Voxel"
msgstr "Skivor per voxel"

#. :src: bpy.types.FluidDomainSettings.slice_per_voxel
msgid "How many slices per voxel should be generated"
msgstr "Hur många skivor per voxel ska genereras"

#. :src: bpy.types.FluidDomainSettings.sndparticle_boundary
#: scripts/startup/bl_ui/properties_physics_fluid.py:998
msgid "Particles in Boundary"
msgstr "Partiklar vid gränsen"

#. :src: bpy.types.FluidDomainSettings.sndparticle_boundary
msgid "How particles that left the domain are treated"
msgstr "Hur partiklar som lämnat domänen behandlas"

#. :src: bpy.types.FluidDomainSettings.sndparticle_boundary:'DELETE'
msgid "Delete secondary particles that are inside obstacles or left the domain"
msgstr "Ta bort sekundära partiklar som är i hinder eller har lämnat domänen"

#. :src: bpy.types.FluidDomainSettings.sndparticle_boundary:'PUSHOUT'
msgid "Push Out"
msgstr "Tryck ut"

#. :src: bpy.types.FluidDomainSettings.sndparticle_boundary:'PUSHOUT'
msgid "Push secondary particles that left the domain back into the domain"
msgstr "Tryck tillbaka sekundära partiklar som lämnat domänen in i domänen"
