#. :src: bpy.types.Light.use_nodes
msgid "Use shader nodes to render the light"
msgstr "Använd shadernoder för att rendera ljuset"

#. :src: bpy.types.NODE_OT_nw_lazy_mix
msgid "Add a Mix RGB/Shader node by interactively drawing lines between nodes"
msgstr "Lägg till en Mix RGB/shadernod genom att interaktivt rita linjer mellan noderna"

#. :src: bpy.types.LineStyleColorModifier_Noise.color_ramp
#. :src: bpy.types.LineStyleColorModifier_Tangent.color_ramp
msgid "Color ramp used to change line color"
msgstr "Färggradient som används för att ändra linjefärg"

#. :src: bpy.types.LineStyleColorModifier_Material.use_ramp
msgid "Use color ramp to map the BW average into an RGB color"
msgstr "Använd en färggradient för att färgkartlägga BW-medelvärdet till en RGB-färg"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff
msgid "Method for rendering subsurface scattering"
msgstr "Metod för att återge underytsspridning"

#. :src: bpy.types.OBJECT_OT_bake.pass_filter
msgid "Filter to combined, diffuse, glossy, transmission and subsurface passes"
msgstr "Filtrera till kombinerade, diffusa, glansiga, transmissions- och underytsspridningspass"

#. :src: bpy.types.RenderSettings.compositor_denoise_device
msgid "Compositor Denoise Node Device"
msgstr "Enhet för brusreduceringsnod i kompositören"

#. :src: bpy.types.RenderSettings.compositor_denoise_device
msgid "The device to use to process the denoise nodes in the compositor"
msgstr "Enheten som ska användas för att bearbeta brusreduceringsnoderna i kompositören"

#. :src: bpy.types.RenderSettings.compositor_denoise_device:'AUTO'
msgid "Use the same device used by the compositor to process the denoise node"
msgstr "Använd samma enhet som kompositören använder för att bearbeta brusreduceringsnoden"

#. :src: bpy.types.Attribute
#. :src: bpy.types.SpreadsheetSpace
msgid "Mesh edge"
msgstr "Meshkant"

#. :src: bpy.types.Attribute
#. :src: bpy.types.SpreadsheetSpace
msgid "Mesh face"
msgstr "Meshyta"

#. :src: bpy.types.Attribute
#. :src: bpy.types.SpreadsheetSpace
msgid "Mesh face corner"
msgstr "Meshythörn"

#. :src: bpy.types.BakeSettings.use_lores_mesh
msgid "Low Resolution Mesh"
msgstr "Lågupplöst mesh"

#. :src: bpy.types.BakeSettings.use_lores_mesh
msgid "Calculate heights against unsubdivided low resolution mesh"
msgstr "Beräkna höjder mot en lågupplöst mesh utan underindelning"

#. :src: bpy.types.Mesh.has_custom_normals
msgid "True if there is custom normal data for this mesh"
msgstr "Sant om meshen har anpassade normaldata"

#. :src: bpy.types.Mesh.texture_mesh
msgid "Use another mesh for texture indices (vertex indices must be aligned)"
msgstr "Använd en annan mesh för texturindex (hörnpunktsindex måste vara justerade)"

#. :src: bpy.types.MeshSkinVertexLayer
msgid "Mesh Skin Vertex Layer"
msgstr "Meshens Skin-hörnpunktslager"
