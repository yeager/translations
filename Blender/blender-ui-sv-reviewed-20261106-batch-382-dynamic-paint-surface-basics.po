#. :src: bpy.types.DynamicPaintSurface
msgid "A canvas surface layer"
msgstr "Ett lager på Dynamic Paint-duken"

#. :src: bpy.types.DynamicPaintSurface.brush_collection
msgid "Brush Collection"
msgstr "Penselsamling"

#. :src: bpy.types.DynamicPaintSurface.brush_collection
msgid "Only use brush objects from this collection"
msgstr "Använd endast penselobjekt från denna samling"

#. :src: bpy.types.DynamicPaintSurface.brush_influence_scale
msgid "Influence Scale"
msgstr "Påverkansskala"

#. :src: bpy.types.DynamicPaintSurface.brush_influence_scale
msgid "Adjust influence brush objects have on this surface"
msgstr "Justera penselobjektens påverkan på den här ytan"

#. :src: bpy.types.DynamicPaintSurface.brush_radius_scale
msgid "Radius Scale"
msgstr "Radieskala"

#. :src: bpy.types.DynamicPaintSurface.brush_radius_scale
msgid "Adjust radius of proximity brushes or particles for this surface"
msgstr "Justera radien för närhetspenslar eller partiklar på den här ytan"

#. :src: bpy.types.DynamicPaintSurface.color_dry_threshold
msgid "Color Dry"
msgstr "Färgtorkning"

#. :src: bpy.types.DynamicPaintSurface.color_dry_threshold
msgid "The wetness level when colors start to shift to the background"
msgstr "Våthetsnivån då färgerna börjar övergå till bakgrunden"

#. :src: bpy.types.DynamicPaintSurface.color_spread_speed
msgid "Color Spread"
msgstr "Färgspridning"
