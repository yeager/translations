#. :src: bpy.types.SceneEEVEE.motion_blur_depth_scale
msgid "Bleeding Bias"
msgstr "Läckageförskjutning"

#. :src: bpy.types.SceneEEVEE.motion_blur_max
msgid "Maximum blur distance a pixel can spread over"
msgstr "Maximalt avstånd som oskärpan från en pixel kan spridas över"

#. :src: bpy.types.SceneEEVEE.use_shadow_jitter_viewport
msgid "Jittered Shadows (Viewport)"
msgstr "Jitterade skuggor (vyport)"

#. :src: bpy.types.SceneEEVEE.use_shadow_jitter_viewport
msgid ""
"Enable jittered shadows on the viewport. (Jittered shadows are always "
"enabled for final renders)."
msgstr ""
"Aktivera jitterade skuggor i vyporten. Jitterade skuggor är alltid "
"aktiverade vid slutrendering."

#. :src: bpy.types.SceneEEVEE.use_taa_reprojection
msgid "Viewport Denoising"
msgstr "Brusreducering i vyport"
