msgid "Bake ID"
msgstr "Baknings-ID"

#. :src: bpy.types.NodesModifierBake.bake_id
msgid ""
"Identifier for this bake which remains unchanged even when the bake node is "
"renamed, grouped or ungrouped"
msgstr ""
"Identifierare för denna bakning som förblir oförändrad även när "
"bakningsnoden byter namn, grupperas eller avgrupperas"

#. :src: bpy.types.NodesModifierBake.bake_mode:'ANIMATION'
msgid "Bake a frame range"
msgstr "Baka ett bildruteintervall"

#. :src: bpy.types.NodesModifierBake.bake_mode:'STILL'
msgid "Still"
msgstr "Stillbild"

#. :src: bpy.types.NodesModifierBake.bake_mode:'STILL'
