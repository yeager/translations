#. :src: bpy.types.Gizmo
msgctxt "Operator"
msgid "Gizmo"
msgstr "Gizmo"

#. :src: bpy.types.Gizmo
#. :src: bpy.types.Gizmos
msgid "Collection of gizmos"
msgstr "Samling av gizmor"

#. :src: bpy.types.Gizmo.group
msgid "Gizmo group this gizmo is a member of"
msgstr "Gizmogrupp som denna gizmo tillhör"

#. :src: bpy.types.Gizmo.hide_keymap
msgid "Hide Keymap"
msgstr "Dölj tangentmappning"

#. :src: bpy.types.Gizmo.hide_keymap
msgid "Ignore the key-map for this gizmo"
msgstr "Ignorera tangentmappningen för den här gizmon"

#. :src: bpy.types.Gizmo.hide_select
msgid "Hide Select"
msgstr "Dölj markering"

#. :src: bpy.types.Gizmo.is_highlight
#. :src: bpy.types.Gizmo.is_modal
msgid "Highlight"
msgstr "Framhäv"

#. :src: bpy.types.Gizmo.line_width
#: scripts/startup/bl_ui/space_userpref.py:213
msgid "Line Width"
msgstr "Linjetjocklek"

#. :src: bpy.types.Gizmo.matrix_basis
#. :src: bpy.types.PoseBone.matrix_basis
msgid "Basis Matrix"
msgstr "Basmatris"

#. :src: bpy.types.Gizmo.matrix_offset
msgid "Offset Matrix"
msgstr "Förskjutningsmatris"

#. :src: bpy.types.Gizmo.matrix_space
msgid "Space Matrix"
msgstr "Rymdmatris"

#. :src: bpy.types.Gizmo.matrix_world
msgid "Final World Matrix"
msgstr "Slutlig världsmatris"

#. :src: bpy.types.Gizmo.scale_basis
msgid "Scale Basis"
msgstr "Skalbas"

#. :src: bpy.types.Gizmo.select_bias
msgid "Select Bias"
msgstr "Urvalsförskjutning"

#. :src: bpy.types.Gizmo.select_bias
msgid "Depth bias used for selection"
msgstr "Djupförskjutning som används för urval"

#. :src: bpy.types.Gizmo.use_draw_hover
msgid "Show Hover"
msgstr "Visa när pekaren hålls över"

#. :src: bpy.types.Gizmo.use_draw_modal
msgid "Show Active"
msgstr "Visa som aktiv"

#. :src: bpy.types.Gizmo.use_draw_modal
msgid "Show while dragging"
msgstr "Visa när du drar"

#. :src: bpy.types.Gizmo.use_draw_offset_scale
#. :src: bpy.types.MESH_OT_extrude_repeat.scale_offset
msgid "Scale Offset"
msgstr "Skala förskjutningen"

#. :src: bpy.types.Gizmo.use_draw_offset_scale
msgid "Scale the offset matrix (use to apply screen-space offset)"
msgstr ""
"Skala förskjutningsmatrisen (används för att tillämpa förskjutning i "
"skärmrymden)"

#. :src: bpy.types.Gizmo.use_draw_scale
msgid "Use scale when calculating the matrix"
msgstr "Använd skala när du beräknar matrisen"

#. :src: bpy.types.Gizmo.use_draw_value
msgid "Show Value"
msgstr "Visa värde"

#. :src: bpy.types.Gizmo.use_draw_value
msgid "Show an indicator for the current value while dragging"
msgstr "Visa en indikator för det aktuella värdet medan du drar"

#. :src: bpy.types.Gizmo.use_event_handle_all
msgid "Handle All Events"
msgstr "Hantera alla händelser"

#. :src: bpy.types.Gizmo.use_event_handle_all
msgid ""
"When highlighted, do not pass events through to be handled by other keymaps"
msgstr ""
"När den är framhävd ska händelser inte skickas vidare för hantering av andra "
"tangentmappningar"

#. :src: bpy.types.Gizmo.use_grab_cursor
#. :src: bpy.types.OperatorOptions.is_grab_cursor
msgid "Grab Cursor"
msgstr "Ta tag i markören"

#. :src: bpy.types.Gizmo.use_operator_tool_properties
msgid "Tool Property Init"
msgstr "Initiera verktygsegenskaper"

#. :src: bpy.types.Gizmo.use_operator_tool_properties
msgid ""
"Merge active tool properties on activation (does not overwrite existing)"
msgstr ""
"Sammanfoga aktiva verktygsegenskaper vid aktivering (skriver inte över "
"befintliga)"

#. :src: bpy.types.Gizmo.use_select_background
msgid "Select Background"
msgstr "Välj bakgrund"

#. :src: bpy.types.Gizmo.use_select_background
msgid "Don't write into the depth buffer"
msgstr "Skriv inte i djupbufferten"

#. :src: bpy.types.Gizmo.use_tooltip
msgid "Use Tooltip"
msgstr "Använd verktygstips"

#. :src: bpy.types.Gizmo.use_tooltip
msgid "Use tooltips when hovering over this gizmo"
msgstr "Använd verktygstips när du håller muspekaren över denna gizmo"
