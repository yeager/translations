#. :src: bpy.types.FileAssetSelectParams.import_method:'FOLLOW_PREFS'
msgid ""
"Use the import method set in the Preferences for this asset library, don't "
"override it for this Asset Browser"
msgstr ""
"Använd importmetoden i inställningarna för resursbiblioteket och "
"åsidosätt den inte i resursbläddraren"

#. :src: bpy.types.BlenderProject.active_asset_library
msgid "Index of the asset library being edited in the Project Settings UI"
msgstr ""
"Index för resursbiblioteket som redigeras i projektinställningarnas "
"gränssnitt"

#. :src: bpy.types.FileAssetSelectIDFilter
#. :src: bpy.types.FileAssetSelectParams.filter_asset_id
msgid "Which asset types to show/hide, when browsing an asset library"
msgstr ""
"Vilka tillgångstyper som visas eller döljs vid bläddring i ett "
"resursbibliotek"

#. :src: bpy.types.WindowManager.extension_type:'ASSET_LIBRARY'
msgid "Only show asset libraries"
msgstr "Visa endast resursbibliotek"

#. :src: bpy.types.EXTENSIONS_OT_package_asset_library_disable
msgid ""
"Disable this asset library in Preferences (keeps the entry for re-enabling "
"later)"
msgstr ""
"Inaktivera detta resursbibliotek i Inställningar (behåller posten så att "
"den kan återaktiveras senare)"

#. :src: bpy.types.EXTENSIONS_OT_package_asset_library_disable
msgctxt "Operator"
msgid "Disable asset library extension"
msgstr "Inaktivera tillägg för resursbibliotek"

#. :src: bpy.types.EXTENSIONS_OT_package_asset_library_enable
msgid "Enable this asset library in Preferences"
msgstr "Aktivera detta resursbibliotek i Inställningar"

#. :src: bpy.types.EXTENSIONS_OT_package_asset_library_enable
msgctxt "Operator"
msgid "Enable asset library extension"
msgstr "Aktivera tillägg för resursbibliotek"

#. :src: bpy.types.EXTENSIONS_OT_package_asset_library_show
msgid "Show this asset library in Preferences"
msgstr "Visa detta resursbibliotek i Inställningar"

#. :src: bpy.types.EXTENSIONS_OT_package_asset_library_show
msgctxt "Operator"
msgid "Show asset library extension"
msgstr "Visa tillägg för resursbibliotek"

#. :src: bpy.types.PREFERENCES_OT_asset_library_add.auth_token
#. :src: bpy.types.UserAssetLibrary.auth_token
msgid "Personal authentication token, may be required by some asset libraries"
msgstr ""
"Personlig autentiseringstoken som kan krävas av vissa resursbibliotek"

#. :src: bpy.types.UserAssetLibrary.extension_id
msgid ""
"Identifier of the extension defining this asset library (repository module "
"and package ID), empty for user defined libraries"
msgstr ""
"Identifierare för tillägget som definierar detta resursbibliotek, med "
"förvarsmodul och paketidentifierare. Tomt för användardefinierade bibliotek"

#. :src: bpy.types.PreferencesAssetLibrary
msgid ""
"An asset library defined in the Preferences, available whatever project or "
"blend file is open"
msgstr ""
"Ett resursbibliotek som definieras i inställningarna och är tillgängligt "
"oavsett vilket projekt eller vilken blend-fil som är öppen"

#. :src: bpy.types.UserExtensionRepo.show_expanded
msgid "Show the asset libraries of this repository in the preferences"
msgstr "Visa resursbiblioteken från detta förvar i inställningarna"

#. :src: bpy.types.UserExtensionRepo.use_access_token_for_asset_libraries
msgid "Access Token for Asset Libraries"
msgstr "Åtkomsttoken för resursbibliotek"

#: scripts/addons_core/bl_pkg/bl_extension_ops.py:65
msgid "Enable Asset Library"
msgstr "Aktivera resursbibliotek"

#: scripts/startup/bl_operators/project.py:767
msgid "Cannot create an asset library with an empty directory path."
msgstr ""
"Det går inte att skapa ett resursbibliotek med en tom katalogsökväg."

#. :src:
#. source/blender/editors/space_userpref/userpref_asset_libraries_list.cc:310
msgid "Edit Project asset libraries in Project Settings."
msgstr "Redigera projektets resursbibliotek i projektinställningarna."
