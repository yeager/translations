#. :src: bpy.types.FluidDomainSettings.sndparticle_boundary:'PUSHOUT'
msgid "Push secondary particles that left the domain back into the domain"
msgstr "Tryck tillbaka sekundära partiklar som lämnat domänen in i den"

#. :src: bpy.types.FluidDomainSettings.sndparticle_bubble_buoyancy
#: scripts/startup/bl_ui/properties_physics_fluid.py:993
msgid "Bubble Buoyancy"
msgstr "Bubblornas flytkraft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_bubble_drag
#: scripts/startup/bl_ui/properties_physics_fluid.py:994
msgid "Bubble Drag"
msgstr "Bubbelmotstånd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_energy
msgid "Maximum Kinetic Energy Potential"
msgstr "Maximal potential för rörelseenergi"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_energy
msgid ""
"Upper clamping threshold that indicates the fluid speed where cells no "
"longer emit more particles (higher value results in generally less particles)"
msgstr ""
"Övre begränsningströskel som anger den vätskehastighet där cellerna inte "
"längre avger partiklar (högre värde ger vanligen färre partiklar)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_energy
msgid "Minimum Kinetic Energy Potential"
msgstr "Minimal potential för rörelseenergi"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_energy
msgid ""
"Lower clamping threshold that indicates the fluid speed where cells start to "
"emit particles (lower values result in generally more particles)"
msgstr ""
"Nedre begränsningströskel som anger den vätskehastighet där cellerna börjar "
"avge partiklar (lägre värde ger vanligen fler partiklar)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_radius
#: scripts/startup/bl_ui/properties_physics_fluid.py:978
msgid "Potential Radius"
msgstr "Potentialradie"

#. :src: bpy.types.FluidDomainSettings.surface_tension
msgid ""
"Surface tension of liquid (higher value results in greater hydrophobic "
"behavior)"
msgstr "Vätskans ytspänning (högre värde ger mer hydrofobt beteende)"

#. :src: bpy.types.FluidDomainSettings.use_guide
msgid "Use Guiding"
msgstr "Använd styrning"

#. :src: bpy.types.FluidDomainSettings.use_spray_particles
#: scripts/startup/bl_ui/properties_physics_fluid.py:946
msgid "Spray"
msgstr "Spray"

#. :src: bpy.types.FluidDomainSettings.vector_field:'GUIDE_VELOCITY'
msgid "Guide velocity field of the fluid domain"
msgstr "Styrhastighetsfältet i vätskedomänen"

#. :src: bpy.types.FluidDomainSettings.viscosity_base
msgid "Viscosity Base"
msgstr "Viskositetsbas"

#. :src: bpy.types.FluidEffectorSettings.effector_type:'COLLISION'
#. :src: bpy.types.ParticleSettings.react_event:'COLLIDE'
#. :src: bpy.types.Modifier.type:'COLLISION'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'COLLISION'
#. :src: bpy.types.PHYSICS_PT_collision
#: scripts/startup/bl_ui/properties_physics_softbody.py:254
#: source/blender/editors/sculpt_paint/grease_pencil_draw_ops.cc:1086
#: source/blender/modifiers/intern/MOD_collision.cc:275
msgid "Collision"
msgstr "Kollision"

#. :src: bpy.types.FluidEffectorSettings.effector_type:'GUIDE'
msgid "Create guide object"
msgstr "Skapa styrningsobjekt"

#. :src: bpy.types.FluidEffectorSettings.guide_mode
msgid "Guiding mode"
msgstr "Styrningsläge"

#. :src: bpy.types.FluidEffectorSettings.guide_mode
msgid "How to create guiding velocities"
msgstr "Hur styrhastigheter skapas"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'MAXIMUM'
#. :src: bpy.types.Screen.show_fullscreen
msgid "Maximize"
msgstr "Maximera"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'OVERRIDE'
