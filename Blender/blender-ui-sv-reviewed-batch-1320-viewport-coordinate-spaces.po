#: source/blender/nodes/geometry/nodes/node_geo_mouse_position.cc:11
msgid "The region-space mouse X location, in pixels, increasing from 0 at the left"
msgstr "Musens X-position i regionens koordinatsystem, i pixlar, räknat från 0 vid vänsterkanten"

#: source/blender/nodes/geometry/nodes/node_geo_mouse_position.cc:13
msgid "The region-space mouse Y location, in pixels, increasing from 0 at the bottom"
msgstr "Musens Y-position i regionens koordinatsystem, i pixlar, räknat från 0 vid nederkanten"

#: source/blender/nodes/geometry/nodes/node_geo_viewport_transform.cc:11
msgid "Transforms points in view space to region space (\"clip space\" or \"normalized device coordinates\")"
msgstr "Transformerar punkter från visningsrymd till regionrymd (”klipprymd” eller ”normaliserade enhetskoordinater”)"

#: source/blender/nodes/geometry/nodes/node_geo_viewport_transform.cc:15
msgid "Transforms points from object space to view space using the viewport's location and rotation"
msgstr "Transformerar punkter från objektrymd till visningsrymd med visningsområdets placering och rotation"

