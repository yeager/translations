#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND_REUSE'
msgid ""
"Import the asset as copied data-block while avoiding multiple copies of "
"nested, typically heavy data. For example the textures of a material asset, "
"or the mesh of an object asset, don't have to be copied every time this "
"asset is imported. The instances of the asset share the data instead"
msgstr ""
"Importera resursen som ett kopierat datablock men undvik flera kopior av "
"nästlade, vanligtvis tunga data. Texturer i en materialresurs eller meshen i "
"en objektresurs behöver exempelvis inte kopieras vid varje import. "
"Resursinstanserna delar i stället data"

#. :src: bpy.types.ID.asset_data
msgid "Additional data for an asset data-block"
msgstr "Ytterligare data för ett resursdatablock"

#. :src: bpy.types.ID.is_editable
msgid ""
"This data-block is editable in the user interface. Linked data-blocks are "
"not editable, except if they were loaded as editable assets."
msgstr ""
"Datablocket kan redigeras i användargränssnittet. Länkade datablock kan inte "
"redigeras, utom om de har lästs in som redigerbara resurser."

#. :src: bpy.types.ASSET_OT_external_asset_rename
msgid ""
"Change the name of this asset. Note that this cannot be un-done via the undo "
"system"
msgstr ""
"Byt namn på denna resurs. Observera att åtgärden inte kan ångras via "
"ångringssystemet"

#. :src: bpy.types.POSELIB_OT_create_pose_asset
msgid "Create a new asset from the selected bones in the scene"
msgstr "Skapa en ny resurs från de valda benen i scenen"

#. :src: bpy.types.BlendImportContext.options:'APPEND_ASSET_DATA_CLEAR'
msgid "Clear the asset data on append (it is always kept for linked data)"
msgstr "Rensa resursdata vid inklistring (den behålls alltid för länkade data)"

#, c-format
msgid "Could not remove old asset file: %s"
msgstr "Kunde inte ta bort den gamla resursfilen: %s"

msgid ""
"Error reading asset listing file entry, skipping. Reason: found a file "
"without 'path' field"
msgstr ""
"Fel vid läsning av filpost i resurslistan; hoppar över. Orsak: en fil utan "
"fältet 'path' hittades"

#, python-brace-format
msgid ""
"Error reading asset listing file entry, skipping. Reason: found a file "
"({:s}) without 'hash' field"
msgstr ""
"Fel vid läsning av filpost i resurslistan; hoppar över. Orsak: filen ({:s}) "
"saknar fältet 'hash'"

#, python-brace-format
msgid ""
"Error reading asset listing file entry, skipping. Reason: found a file "
"({:s}) without 'size_in_bytes' field"
msgstr ""
"Fel vid läsning av filpost i resurslistan; hoppar över. Orsak: filen ({:s}) "
"saknar fältet 'size_in_bytes'"

msgid "Asset downloading requires Python"
msgstr "Hämtning av resurser kräver Python"

msgid "Cancel all asset downloads"
msgstr "Avbryt alla resurshämtningar"

msgid "Asset file is not editable"
msgstr "Resursfilen kan inte redigeras"

#, c-format
msgid ""
"Asset listing does not indicate where the file should be downloaded to, for "
"asset '%s'"
msgstr "Resurslistan anger inte var filen ska hämtas för resursen '%s'"

msgid "No assets found."
msgstr "Inga resurser hittades."

msgid ""
"Only assets from the current file or asset system files (.asset.blend) can "
"be moved between catalogs"
msgstr ""
"Endast resurser från den aktuella filen eller resurssystemfiler "
"(.asset.blend) kan flyttas mellan kataloger"

msgid "No selected asset."
msgstr "Ingen markerad resurs."

msgid "Asset is local to this file and can be renamed directly."
msgstr "Resursen är lokal i den här filen och kan byta namn direkt."

msgid "Asset cannot be modified from this file."
msgstr "Resursen kan inte ändras från den här filen."

msgid "No assets in this catalog."
msgstr "Inga resurser i den här katalogen."

msgid "Asset Catalogs"
msgstr "Resurskataloger"
