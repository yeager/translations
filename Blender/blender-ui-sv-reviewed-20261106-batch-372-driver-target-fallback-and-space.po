#. :src: bpy.types.DriverTarget.fallback_value
msgid "The value to use if the data path can't be resolved"
msgstr "Det värde som ska användas om datasökvägen inte kan lösas"

#. :src: bpy.types.DriverTarget.id
msgid ""
"ID-block that the specific property used can be found from (id_type property "
"must be set first)"
msgstr ""
"ID-datablock som innehåller den använda egenskapen (attributet id_type måste "
"anges först)"

#. :src: bpy.types.DriverTarget.id_type
#. :src: bpy.types.KeyingSetPath.id_type
#. :src: bpy.types.MaskParent.id_type
msgid "Type of ID-block that can be used"
msgstr "Typ av ID-datablock som kan användas"

#. :src: bpy.types.DriverTarget.is_fallback_used
msgid "Is Fallback Used"
msgstr "Används reservvärde"

#. :src: bpy.types.DriverTarget.is_fallback_used
msgid ""
"Indicates that the most recent variable evaluation used the fallback value"
msgstr "Anger att den senaste variabelutvärderingen använde reservvärdet"

#. :src: bpy.types.DriverTarget.rotation_mode
msgid "Mode for calculating rotation channel values"
msgstr "Läge för att beräkna rotationskanalernas värden"

#. :src: bpy.types.DriverTarget.transform_space
#. :src: bpy.types.DriverTarget.transform_space:'TRANSFORM_SPACE'
#. :src: bpy.types.GeometryNodeCollectionInfo.transform_space
#. :src: bpy.types.GeometryNodeObjectInfo.transform_space
#. :src: bpy.types.ActionSlot.target_space
msgid "Transform Space"
msgstr "Transformationsrymd"

#. :src: bpy.types.DriverTarget.transform_space
msgid "Space in which transforms are used"
msgstr "Rymden där transformationer används"

#. :src: bpy.types.DriverTarget.transform_space:'WORLD_SPACE'
msgid "Transforms include effects of parenting/restpose and constraints"
msgstr ""
"Transformationerna omfattar effekterna av föräldraskap, viloposition och "
"begränsningar"

#. :src: bpy.types.DriverTarget.transform_space:'TRANSFORM_SPACE'
msgid "Transforms don't include parenting/restpose or constraints"
msgstr ""
"Transformationerna omfattar inte föräldraskap, viloposition eller "
"begränsningar"
