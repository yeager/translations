#. :src: bpy.types.VertexWeightMixModifier.default_weight_a
msgid "Default weight a vertex will have if it is not in the first A vgroup"
msgstr "Standardvikt som en hörnpunkt får om den inte finns i hörnpunktsgrupp A"

#. :src: bpy.types.VertexWeightMixModifier.default_weight_b
msgid "Default weight a vertex will have if it is not in the second B vgroup"
msgstr "Standardvikt som en hörnpunkt får om den inte finns i hörnpunktsgrupp B"

#. :src: bpy.types.VertexWeightMixModifier.mix_mode:'MIN'
msgid "Minimum of VGroup A's and VGroup B's weights"
msgstr "Det lägsta värdet av vikterna i hörnpunktsgrupp A och hörnpunktsgrupp B"

#. :src: bpy.types.VertexWeightMixModifier.mix_mode:'MAX'
msgid "Maximum of VGroup A's and VGroup B's weights"
msgstr "Det högsta värdet av vikterna i hörnpunktsgrupp A och hörnpunktsgrupp B"

#. :src: bpy.types.VertexWeightProximityModifier.target
msgid "Object to calculate vertices distances from"
msgstr "Objekt som avståndet till hörnpunkterna ska beräknas från"
