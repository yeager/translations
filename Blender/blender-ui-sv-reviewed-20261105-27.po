#. :src: bpy.types.FileAssetSelectParams
msgid "Settings for the file selection in Asset Browser mode"
msgstr "Inställningar för filval i resursbläddrarläget"

#. :src: bpy.types.ASSET_OT_mark
msgid "Enable easier reuse of selected data-blocks through the Asset Browser, with the help of customizable metadata (like previews, descriptions and tags)"
msgstr "Möjliggör enklare återanvändning av markerade datablock via resursbläddraren med hjälp av anpassningsbar metadata, som förhandsgranskningar, beskrivningar och taggar"

#. :src: bpy.types.ASSET_OT_mark_single
msgid "Enable easier reuse of a data-block through the Asset Browser, with the help of customizable metadata (like previews, descriptions and tags)"
msgstr "Möjliggör enklare återanvändning av ett datablock via resursbläddraren med hjälp av anpassningsbar metadata, som förhandsgranskningar, beskrivningar och taggar"

#. :src: bpy.types.PREFERENCES_OT_asset_library_add
msgid "Add a directory to be used by the Asset Browser as source of assets"
msgstr "Lägg till en katalog som resursbläddraren kan använda som källa för tillgångar"

#. :src: bpy.types.PREFERENCES_OT_asset_library_remove
msgid "Remove a path to a .blend file, so the Asset Browser will not attempt to show it anymore"
msgstr "Ta bort en sökväg till en .blend-fil så att resursbläddraren inte längre försöker visa den"

#. :src: bpy.types.USERPREF_PT_theme_file_browser
#. :src: bpy.types.Theme.theme_area:'FILE_BROWSER'
msgid "File/Asset Browser"
msgstr "Fil- och resursbläddrare"

#. :src: bpy.types.PreferencesExperimental.show_asset_debug_info
msgid "Enable some extra fields in the Asset Browser to aid in debugging"
msgstr "Aktivera några extra fält i resursbläddraren för att underlätta felsökning"

#. :src: bpy.types.PreferencesExperimental.use_extended_asset_browser
msgid "Extended Asset Browser"
msgstr "Utökad resursbläddrare"

#. :src: bpy.types.PreferencesExperimental.use_extended_asset_browser
msgid "Enable Asset Browser editor and operators to manage regular data-blocks as assets, not just poses"
msgstr "Gör det möjligt för redigeraren och operatörerna i resursbläddraren att hantera vanliga datablock som tillgångar, inte bara poseringar"

#. :src: bpy.types.SpaceFileBrowser.browse_mode:'ASSETS'
msgid "Asset Browser"
msgstr "Resursbläddrare"

#. :src: bpy.types.UserAssetLibrary
msgid "Settings to define a reusable library for Asset Browsers to use"
msgstr "Inställningar för att definiera ett återanvändbart resursbibliotek som resursbläddrare kan använda"
