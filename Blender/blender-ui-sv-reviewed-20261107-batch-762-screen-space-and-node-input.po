#. :src: bpy.types.Brush.jitter_unit
msgid "Jitter in screen space or relative to brush size"
msgstr "Variation i skärmrymden eller i förhållande till penselstorleken"

#. :src: bpy.types.Brush.jitter_unit:'VIEW'
msgid "Jittering happens in screen space, in pixels"
msgstr "Variationen sker i skärmrymden, i pixlar"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Space daubs according to surface orientation instead of screen space"
msgstr "Placera penselavtryck utifrån ytans riktning i stället för skärmrymden"

#. :src: bpy.types.NodeTreeInterfaceSocket.hide_in_modifier
msgid "Don't show the input value in the geometry nodes modifier interface"
msgstr "Visa inte indatavärdet i modifieringsgränssnittet för geometrinoder"

#. :src: bpy.types.NodeSocket.is_inactive
msgid "Socket is grayed out because it has been detected to not have any effect on the output"
msgstr "Uttaget är gråmarkerat eftersom det har konstaterats att det inte har någon effekt på nodutdata"
