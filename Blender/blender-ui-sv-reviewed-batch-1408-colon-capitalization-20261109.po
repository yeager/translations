msgid "Target along length of bone: Head is 0, Tail is 1"
msgstr "Mål längs benets längd: benhuvudet är 0, benspetsen är 1"

msgid "Value: must be 'NOTHING' for motion"
msgstr "Värde: måste vara ”NOTHING” för rörelse"

msgid "Value: must be 'PRESS' when unicode is set"
msgstr "Värde: måste vara ”PRESS” när unicode är angivet"

msgid "Value: must be 'PRESS/RELEASE' for keyboard/buttons"
msgstr "Värde: måste vara ”PRESS/RELEASE” för tangentbord/knappar"

msgid "Value: only 'PRESS/RELEASE/NOTHING' are supported"
msgstr "Värde: endast ”PRESS/RELEASE/NOTHING” stöds"
