msgid "Type of curve to use for new strokes"
msgstr "Typ av kurva att använda för nya streck"

#. :src: bpy.types.CurvePaintSettings.curve_type:'BEZIER'
#. :src: bpy.types.GeometryNodeCurveSplineType.spline_type:'BEZIER'
