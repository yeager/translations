#. :src: bpy.types.Mesh
msgid "Mesh data-block defining geometric surfaces"
msgstr "Mesh-datablock som definierar geometriska ytor"

#. :src: bpy.types.Mesh.corner_normals
msgid "Corner Normals"
msgstr "Hörnnormaler"

#. :src: bpy.types.Mesh.corner_normals
msgid ""
"The \"slit\" normal direction of each face corner, influenced by vertex "
"normals, sharp faces, sharp edges, and custom normals. May be empty."
msgstr ""
"Den \"delade\" normalriktningen för varje ythörn, påverkad av "
"hörnpunktsnormaler, skarpa ytor, skarpa kanter och anpassade normaler. Kan "
"vara tom."

#. :src: bpy.types.Mesh.edges
#. :src: bpy.types.BevelModifier.affect:'EDGES'
#. :src: bpy.types.GeometryNodeExtrudeMesh.mode:'EDGES'
#. :src: bpy.types.GeometryNodeMeshToCurve.mode:'EDGES'
#. :src: bpy.types.GeometryNodeMeshToPoints.mode:'EDGES'
#. :src: bpy.types.GeometryNodeProximity.target_element:'EDGES'
#. :src: bpy.types.MESH_OT_bevel.affect:'EDGES'
#. :src: bpy.types.MESH_OT_delete.type:'EDGE'
#. :src: bpy.types.MESH_OT_delete_loose.use_edges
#. :src: bpy.types.MESH_OT_sort_elements.elements:'EDGE'
#. :src: bpy.types.PHYSICS_PT_softbody_edge
#: source/blender/editors/space_info/info_stats.cc:837
#: source/blender/editors/uvedit/uvedit_ops.cc:1948
#: source/blender/editors/uvedit/uvedit_smart_stitch.cc:281
#: source/blender/nodes/composite/nodes/node_composite_keying.cc:38
#: source/blender/nodes/composite/nodes/node_composite_keying.cc:84
msgid "Edges"
msgstr "Kanter"

#. :src: bpy.types.Mesh.edges
msgid "Edges of the mesh"
msgstr "Meshens kanter"

#. :src: bpy.types.Mesh.has_custom_normals
msgid "Has Custom Normals"
msgstr "Har anpassade normaler"

#. :src: bpy.types.Mesh.has_custom_normals
msgid "True if there are custom split normals data in this mesh"
msgstr "Sant om denna mesh innehåller data för anpassade delade normaler"

#. :src: bpy.types.Mesh.loop_triangle_polygons
msgid "Triangle Faces"
msgstr "Triangelytor"

#. :src: bpy.types.Mesh.loop_triangle_polygons
msgid "The face index for each loop triangle"
msgstr "Ytindexet för varje looptriangel"

#. :src: bpy.types.Mesh.loop_triangles
msgid "Loop Triangles"
msgstr "Looptrianglar"

#. :src: bpy.types.Mesh.loop_triangles
#. :src: bpy.types.MeshLoopTriangles
msgid "Tessellation of mesh polygons into triangles"
msgstr "Tessellering av meshpolygoner till trianglar"

#. :src: bpy.types.Mesh.loops
msgid "Loops of the mesh (face corners)"
msgstr "Meshloopar (ythörn)"

#. :src: bpy.types.Mesh.normals_domain
msgid "Normal Domain"
msgstr "Normaldomän"

#. :src: bpy.types.Mesh.normals_domain
msgid ""
"The attribute domain that gives enough information to represent the mesh's "
"normals"
msgstr ""
"Attributdomänen som ger tillräckligt med information för att representera "
"mesh-normalerna"

#. :src: bpy.types.Mesh.normals_domain:'CORNER'
#. :src: bpy.types.SpaceUVEditor.pixel_round_mode:'CORNER'
msgid "Corner"
msgstr "Hörn"

#. :src: bpy.types.Mesh.polygon_normals
msgid "Polygon Normals"
msgstr "Polygonnormer"

#. :src: bpy.types.Mesh.polygon_normals
msgid ""
"The normal direction of each face, defined by the winding order and position "
"of its vertices"
msgstr ""
"Den normala riktningen för varje yta, definierad av lindningsordningen och "
"positionen för dess hörn"

#. :src: bpy.types.Mesh.polygons
#: source/blender/editors/io/io_alembic.cc:223
#: source/blender/editors/io/io_usd.cc:519
msgid "Polygons"
msgstr "Polygoner"

#. :src: bpy.types.Mesh.polygons
msgid "Polygons of the mesh"
msgstr "Meshens polygoner"
