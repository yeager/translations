#. :src: bpy.types.ThemeUserInterface.icon_autokey
msgid "Auto Keying Indicator"
msgstr "Indikator för automatisk nyckelbildsättning"

#. :src: bpy.types.ThemeUserInterface.icon_autokey
msgid "Color of Auto Keying indicator when enabled"
msgstr ""
"Färg på indikatorn för automatisk nyckelbildsättning när den är aktiverad"

#. :src: bpy.types.ToolSettings.auto_keying_mode
msgid "Auto-Keying Mode"
msgstr "Läge för automatisk nyckelbildsättning"

#. :src: bpy.types.ToolSettings.auto_keying_mode
