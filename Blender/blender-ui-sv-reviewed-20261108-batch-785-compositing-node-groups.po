#. :src: bpy.types.NODE_OT_duplicate_compositing_modifier_node_group
#. :src: bpy.types.NODE_OT_duplicate_compositing_node_group
msgid "Duplicate the currently assigned compositing node group."
msgstr "Duplicera den för närvarande tilldelade kompositionsnodgruppen."

#. :src: bpy.types.NODE_OT_new_compositor_sequencer_node_group
msgid "Create a new compositor node group for sequencer"
msgstr "Skapa en ny kompositionsnodgrupp för sekvenseraren"

#. :src: bpy.types.SCENE_OT_new_compositor_effect_node_group
msgid "Create a new compositor node group and assign it to the scene effect"
msgstr "Skapa en ny kompositionsnodgrupp och tilldela den till sceneffekten"

#: source/blender/makesrna/intern/rna_scene.cc:1281
msgid "Node tree '%s' is not a compositing node group."
msgstr "Nodträdet ”%s” är inte en kompositionsnodgrupp."

#: source/blender/makesrna/intern/rna_space.cc:3033
msgid "Edit compositing node group for Sequencer strip modifiers"
msgstr "Redigera kompositionsnodgrupp för modifierare av sekvenserarremsor"
