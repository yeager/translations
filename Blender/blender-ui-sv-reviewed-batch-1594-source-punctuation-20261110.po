#. :src: bpy.types.Texture.type:'BLEND'
msgid "Procedural - create a ramp texture"
msgstr "Procedurmässig - skapa en toningstextur"

#. :src: bpy.types.Texture.type:'CLOUDS'
msgid "Procedural - create a cloud-like fractal noise texture"
msgstr "Procedurmässig - skapa en molnliknande fraktal brusstruktur"

#. :src: bpy.types.Texture.type:'DISTORTED_NOISE'
msgid "Procedural - noise texture distorted by two noise algorithms"
msgstr "Procedurmässig - brusstruktur som förvrängs av två brusalgoritmer"

#. :src: bpy.types.Texture.type:'MAGIC'
msgid "Procedural - color texture based on trigonometric functions"
msgstr "Procedurmässig - färgtextur baserad på trigonometriska funktioner"

#. :src: bpy.types.Texture.type:'MARBLE'
msgid "Procedural - marble-like noise texture with wave generated bands"
msgstr "Procedurmässig - marmorliknande brusstruktur med våggenererade band"

#. :src: bpy.types.Texture.type:'MUSGRAVE'
msgid "Procedural - highly flexible fractal noise texture"
msgstr "Procedurmässig - mycket flexibel fraktal brusstruktur"

#. :src: bpy.types.Texture.type:'NOISE'
msgid ""
"Procedural - random noise, gives a different result every time, for every "
"frame, for every pixel"
msgstr ""
"Procedurmässig - slumpmässigt brus som ger ett annat resultat varje gång, "
"för varje bildruta och varje pixel"

#. :src: bpy.types.Texture.type:'STUCCI'
msgid "Procedural - create a fractal noise texture"
msgstr "Procedurmässig - skapa en fraktal brusstruktur"

#. :src: bpy.types.Texture.type:'VORONOI'
msgid "Procedural - create cell-like patterns based on Worley noise"
msgstr "Procedurmässig - skapa celliknande mönster baserade på Worley-brus"

#. :src: bpy.types.Texture.type:'WOOD'
msgid "Procedural - wave generated bands or rings, with optional noise"
msgstr "Procedurmässig - våggenererade band eller ringar, med valfritt brus"

#. :src: bpy.types.CloudsTexture.noise_basis:'BLENDER_ORIGINAL'
#. :src: bpy.types.DistortedNoiseTexture.noise_basis:'BLENDER_ORIGINAL'
