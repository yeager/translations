#. :src: bpy.types.StucciTexture.noise_basis:'VORONOI_F2'
#. :src: bpy.types.WoodTexture.noise_basis:'VORONOI_F2'
msgid ""
"Noise algorithm - Voronoi F2: Returns distance to the 2nd closest feature "
"point"
msgstr ""
"Brusalgoritm - Voronoi F2: returnerar avståndet till den näst närmaste "
"egenskapspunkten"

#. :src: bpy.types.CloudsTexture.noise_basis:'VORONOI_F3'
#. :src: bpy.types.DistortedNoiseTexture.noise_basis:'VORONOI_F3'
#. :src: bpy.types.DistortedNoiseTexture.noise_distortion:'VORONOI_F3'
#. :src: bpy.types.MarbleTexture.noise_basis:'VORONOI_F3'
#. :src: bpy.types.MusgraveTexture.noise_basis:'VORONOI_F3'
#. :src: bpy.types.StucciTexture.noise_basis:'VORONOI_F3'
#. :src: bpy.types.WoodTexture.noise_basis:'VORONOI_F3'
msgid ""
"Noise algorithm - Voronoi F3: Returns distance to the 3rd closest feature "
"point"
msgstr ""
"Brusalgoritm - Voronoi F3: returnerar avståndet till den tredje närmaste "
"egenskapspunkten"

#. :src: bpy.types.CloudsTexture.noise_basis:'VORONOI_F4'
#. :src: bpy.types.DistortedNoiseTexture.noise_basis:'VORONOI_F4'
#. :src: bpy.types.DistortedNoiseTexture.noise_distortion:'VORONOI_F4'
#. :src: bpy.types.MarbleTexture.noise_basis:'VORONOI_F4'
#. :src: bpy.types.MusgraveTexture.noise_basis:'VORONOI_F4'
#. :src: bpy.types.StucciTexture.noise_basis:'VORONOI_F4'
#. :src: bpy.types.WoodTexture.noise_basis:'VORONOI_F4'
msgid ""
"Noise algorithm - Voronoi F4: Returns distance to the 4th closest feature "
"point"
msgstr ""
"Brusalgoritm - Voronoi F4: returnerar avståndet till den fjärde närmaste "
"egenskapspunkten"

#. :src: bpy.types.CloudsTexture.noise_basis:'VORONOI_F2_F1'
#. :src: bpy.types.DistortedNoiseTexture.noise_basis:'VORONOI_F2_F1'
#. :src: bpy.types.DistortedNoiseTexture.noise_distortion:'VORONOI_F2_F1'
#. :src: bpy.types.MarbleTexture.noise_basis:'VORONOI_F2_F1'
#. :src: bpy.types.MusgraveTexture.noise_basis:'VORONOI_F2_F1'
#. :src: bpy.types.StucciTexture.noise_basis:'VORONOI_F2_F1'
#. :src: bpy.types.WoodTexture.noise_basis:'VORONOI_F2_F1'
msgid "Noise algorithm - Voronoi F1-F2"
msgstr "Brusalgoritm - Voronoi F1-F2"

#. :src: bpy.types.CloudsTexture.noise_basis:'VORONOI_CRACKLE'
#. :src: bpy.types.DistortedNoiseTexture.noise_basis:'VORONOI_CRACKLE'
#. :src: bpy.types.DistortedNoiseTexture.noise_distortion:'VORONOI_CRACKLE'
#. :src: bpy.types.MarbleTexture.noise_basis:'VORONOI_CRACKLE'
#. :src: bpy.types.MusgraveTexture.noise_basis:'VORONOI_CRACKLE'
#. :src: bpy.types.StucciTexture.noise_basis:'VORONOI_CRACKLE'
#. :src: bpy.types.WoodTexture.noise_basis:'VORONOI_CRACKLE'
msgid ""
"Noise algorithm - Voronoi Crackle: Voronoi tessellation with sharp edges"
msgstr "Brusalgoritm - spräckande Voronoi: tessellering med skarpa kanter"

#. :src: bpy.types.CloudsTexture.noise_basis:'CELL_NOISE'
#. :src: bpy.types.DistortedNoiseTexture.noise_basis:'CELL_NOISE'
#. :src: bpy.types.DistortedNoiseTexture.noise_distortion:'CELL_NOISE'
#. :src: bpy.types.MarbleTexture.noise_basis:'CELL_NOISE'
#. :src: bpy.types.MusgraveTexture.noise_basis:'CELL_NOISE'
#. :src: bpy.types.StucciTexture.noise_basis:'CELL_NOISE'
#. :src: bpy.types.WoodTexture.noise_basis:'CELL_NOISE'
msgid "Noise algorithm - Cell Noise: Square cell tessellation"
msgstr "Brusalgoritm - cellbrus: kvadratisk celltessellering"

#. :src: bpy.types.KeyingSet.use_insertkey_needed
#. :src: bpy.types.KeyingSetPath.use_insertkey_needed
msgid "Insert Keyframes - Only Needed"
msgstr "Infoga nyckelbildrutor - endast vid behov"

#. :src: bpy.types.KeyingSet.use_insertkey_override_needed
#. :src: bpy.types.KeyingSetPath.use_insertkey_override_needed
msgid "Override Insert Keyframes Default- Only Needed"
msgstr ""
"Åsidosätt standardinställningen för Infoga nyckelbildrutor - endast vid "
"behov"

#. :src: bpy.types.KeyingSet.use_insertkey_override_visual
#. :src: bpy.types.KeyingSetPath.use_insertkey_override_visual
msgid "Override Insert Keyframes Default - Visual"
msgstr "Åsidosätt standardinställningen för Infoga nyckelbildrutor - visuellt"

#. :src: bpy.types.KeyingSet.use_insertkey_visual
#. :src: bpy.types.KeyingSetPath.use_insertkey_visual
msgid "Insert Keyframes - Visual"
msgstr "Infoga nyckelbildrutor - visuellt"

#. :src: bpy.types.OceanModifier.spectrum:'TEXEL_MARSEN_ARSLOE'
msgid "Use for shallow water ('JONSWAP', 'TMA' - Texel-Marsen-Arsloe method)"
msgstr "Används för grunt vatten (JONSWAP, TMA - Texel-Marsen-Arsloe-metoden)"

#. :src: bpy.types.OceanModifier.use_normals
msgid ""
"Output normals for bump mapping - disabling can speed up performance if it's"
" not needed"
msgstr ""
"Utdata för normaler vid bumpmappning - avaktivering kan förbättra prestandan"
" om det inte behövs"

#. :src: bpy.types.CompositorNodeCombineColor.mode:'YCC'
#. :src: bpy.types.CompositorNodeSeparateColor.mode:'YCC'
msgid ""
"Use YCbCr (Y - luma, Cb - blue-difference chroma, Cr - red-difference "
"chroma) color processing"
msgstr ""
"Använd YCbCr (Y - luminans, Cb - blådifferenskrominans, Cr - "
"röddifferenskrominans)-färgbehandling"

#. :src: bpy.types.CompositorNodeCombineColor.mode:'YUV'
#. :src: bpy.types.CompositorNodeSeparateColor.mode:'YUV'
msgid "Use YUV (Y - luma, U V - chroma) color processing"
msgstr "Använd YUV (Y - luminans, U/V - krominans)-färgbehandling"

#. :src: bpy.types.CompositorNodeNormalize
msgid ""
"Map values to 0 to 1 range, based on the minimum and maximum pixel values"
msgstr ""
"Avbilda värden till intervallet 0-1 utifrån pixelvärdenas minimi- och "
"maximivärden"

#. :src: bpy.types.ShaderNodeMath.use_clamp
#. :src: bpy.types.ShaderNodeMixRGB.use_clamp
#. :src: bpy.types.ShaderNodeOutputLineStyle.use_clamp
#. :src: bpy.types.TextureNodeMath.use_clamp
#. :src: bpy.types.TextureNodeMixRGB.use_clamp
msgid "Clamp result of the node to 0.0 to 1.0 range"
msgstr "Begränsa nodens resultat till intervallet 0,0-1,0"

#. :src: bpy.types.ShaderNodeTexNoise.normalize
msgid "Normalize outputs to 0.0 to 1.0 range"
msgstr "Normalisera utdata till intervallet 0,0-1,0"

#. :src: bpy.types.ShaderNodeTexVoronoi.normalize
msgid "Normalize output Distance to 0.0 to 1.0 range"
msgstr "Normalisera utdataavståndet till intervallet 0,0-1,0"

#. :src: bpy.types.EXTENSIONS_OT_repo_unlock_all
msgid "Unlock repositories - to test unlocking"
msgstr "Lås upp arkiv - för att testa upplåsning"

#. :src: bpy.types.RIGIFY_OT_rotation_pole
msgctxt "Operator"
msgid "Rotation - Pole toggle"
msgstr "Rotation - polväxlare"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_mesh_modifiers
msgid ""
"Apply modifiers to mesh objects (except Armature ones) - WARNING: prevents "
"exporting shape keys"
msgstr ""
"Tillämpa modifierare på meshobjekt (utom armaturer); VARNING: förhindrar "
"export av formnycklar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_apply
msgid ""
"Apply modifiers (excluding Armatures) to mesh objects -WARNING: prevents "
"exporting shape keys"
msgstr ""
"Tillämpa modifierare (utom armaturer) på meshobjekt; VARNING: förhindrar "
"export av formnycklar"

#. :src: bpy.types.Sculpt.constant_detail_resolution
msgid ""
"Maximum edge length for dynamic topology sculpting (as divisor of Blender "
"unit - higher value means smaller edge length)"
msgstr ""
"Maximal kantlängd för skulptering med dynamisk topologi (som delare av "
"Blender-enheten; högre värde innebär kortare kanter)"

#. :src: bpy.types.PreferencesEdit.use_insertkey_xyz_to_rgb
msgid "New F-Curve Colors - XYZ to RGB"
msgstr "Nya F-kurvfärger: XYZ till RGB"

#. :src: bpy.types.PreferencesInput.use_emulate_numpad
msgid "Main 1 to 0 keys act as the numpad ones (useful for laptops)"
msgstr ""
"Tangenterna 1-0 på huvudtangentbordet fungerar som på det numeriska "
"tangentbordet (praktiskt på bärbara datorer)"

#. :src: bpy.types.PreferencesSystem.audio_device:'None'
msgid "No device - there will be no audio output"
msgstr "Ingen enhet, ingen ljudutgång"

#. :src: bpy.types.PreferencesView.language:'hr'
#. :src: Languages’ labels from _bl_i18n_utils/settings.py
msgid "Croatian - Hrvatski"
msgstr "Kroatiska - Hrvatski"

#. :src: bpy.types.PreferencesView.language:'sw'
#. :src: Languages’ labels from _bl_i18n_utils/settings.py
msgid "Swahili - Kiswahili"
msgstr "Swahili - Kiswahili"

#. :src: bpy.types.PreferencesView.timecode_style:'SMPTE_COMPACT'
msgid ""
"SMPTE timecode showing minutes, seconds, and frames only - hours are also "
"shown if necessary, but not by default"
msgstr ""
"SMPTE-tidskod som endast visar minuter, sekunder och bildrutor - timmar "
"visas också vid behov, men inte som standard"

#. :src: bpy.types.RenderSettings.pixel_aspect_x
msgid "Horizontal aspect ratio - for anamorphic or non-square pixel output"
msgstr ""
"Horisontellt bildförhållande - för anamorfisk eller icke-kvadratisk "
"pixelutmatning"

