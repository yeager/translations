#. :src: bpy.types.AnimData.drivers
#. :src: bpy.types.AnimDataDrivers
#. :src: bpy.types.SpaceGraphEditor.mode:'DRIVERS'
#: source/blender/editors/animation/anim_channels_defines.cc:1624
#: source/blender/editors/space_outliner/tree/tree_element_driver.cc:28
msgid "Drivers"
msgstr "Drivrutiner"

#. :src: bpy.types.AnimData.drivers
msgid "The Drivers/Expressions for this data-block"
msgstr "Drivrutinerna/uttrycken för detta datablock"

#. :src: bpy.types.AnimDataDrivers
msgid "Collection of Driver F-Curves"
msgstr "Samling av F-kurvor för drivrutiner"

#. :src: bpy.types.DopeSheet.show_driver_fallback_as_error
msgid ""
"Include drivers that relied on any fallback values for their evaluation in "
"the Only Show Errors filter, even if the driver evaluation succeeded"
msgstr ""
"Inkludera drivrutiner som förlitade sig på reservvärden för sin utvärdering "
"i filtret Visa endast fel, även om drivrutinsutvärderingen lyckades"

#. :src: bpy.types.Driver.is_valid
msgid "Driver could not be evaluated in past, so should be skipped"
msgstr "Drivrutinen kunde inte utvärderas tidigare och bör därför utelämnas"

#. :src: bpy.types.Driver.type
msgid "Driver type"
msgstr "Drivrutinstyp"

#. :src: bpy.types.Driver.use_self
msgid ""
"Include a 'self' variable in the name-space, so drivers can easily reference "
"the data being modified (object, bone, etc...)"
msgstr ""
"Inkludera en \"self\"-variabel i namnrymden så att drivrutiner enkelt kan "
"referera till de data som ändras (objekt, ben osv.)"

#. :src: bpy.types.DriverTarget
msgid "Driver Target"
msgstr "Drivrutinsmål"

#. :src: bpy.types.DriverTarget
msgid "Source of input values for driver variables"
msgstr "Källa till ingångsvärden för drivrutinsvariabler"

#. :src: bpy.types.DriverTarget.transform_type
#. :src: bpy.types.DriverVariable.type
msgid "Driver variable type"
msgstr "Drivrutinsvariabeltyp"

#. :src: bpy.types.DriverVariable
msgid "Driver Variable"
msgstr "Drivrutinsvariabel"

#. :src: bpy.types.DriverVariable
msgid "Variable from some source/target for driver relationship"
msgstr "Variabel från en källa eller ett mål för drivrutinsrelationen"

#. :src: bpy.types.DriverVariable.is_name_valid
msgid "Is this a valid name for a driver variable"
msgstr "Är detta ett giltigt namn för en drivrutinsvariabel"

#. :src: bpy.types.FCurve.driver
#: source/blender/editors/space_graph/graph_buttons.cc:959
#: source/blender/editors/space_graph/graph_buttons.cc:1482
msgid "Driver"
msgstr "Drivrutin"

#. :src: bpy.types.FCurve.driver
msgid "Channel Driver (only set for Driver F-Curves)"
msgstr "Kanaldrivrutin (anges endast för F-kurvor med drivrutin)"

#. :src: bpy.types.ANIM_OT_driver_button_add
#: source/blender/editors/interface/interface_context_menu.cc:809
msgctxt "Operator"
msgid "Add Driver"
msgstr "Lägg till drivrutin"

#. :src: bpy.types.ANIM_OT_driver_button_add
msgid "Add driver for the property under the cursor"
msgstr "Lägg till en drivrutin för egenskapen under markören"

#. :src: bpy.types.GRAPH_OT_driver_variables_copy
msgid "Copy the driver variables of the active driver"
msgstr "Kopiera drivrutinsvariablerna för den aktiva drivrutinen"

#. :src: bpy.types.GRAPH_OT_driver_variables_paste
msgid "Add copied driver variables to the active driver"
msgstr "Lägg till kopierade drivrutinsvariabler i den aktiva drivrutinen"

#. :src: bpy.types.OUTLINER_OT_animdata_operation.type:'CLEAR_DRIVERS'
msgid "Clear Drivers"
msgstr "Rensa drivrutiner"
