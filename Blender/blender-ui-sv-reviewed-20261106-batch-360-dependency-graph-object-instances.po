#. :src: bpy.types.DepsgraphObjectInstance
msgid "Dependency Graph Object Instance"
msgstr "Objektinstans i beroendegrafen"

#. :src: bpy.types.DepsgraphObjectInstance
msgid ""
"Extended information about dependency graph object iterator (Warning: All "
"data here is 'evaluated' one, not original .blend IDs)"
msgstr ""
"Utökad information om objektiteratorn i beroendegrafen (Varning: Alla data "
"här är utvärderade, inte ursprungliga .blend-ID:n)"

#. :src: bpy.types.DepsgraphObjectInstance.instance_object
#. :src: bpy.types.ParticleSettings.instance_object
#: scripts/startup/bl_ui/properties_particle.py:1523
msgid "Instance Object"
msgstr "Instansobjekt"

#. :src: bpy.types.DepsgraphObjectInstance.instance_object
msgid "Evaluated object which is being instanced by this iterator"
msgstr "Utvärderat objekt som instansieras av denna iterator"

#. :src: bpy.types.DepsgraphObjectInstance.is_instance
msgid "Is Instance"
msgstr "Är instans"

#. :src: bpy.types.DepsgraphObjectInstance.is_instance
msgid "Denotes if the object is generated by another object"
msgstr "Anger om objektet genereras av ett annat objekt"

#. :src: bpy.types.DepsgraphObjectInstance.matrix_world
msgid "Generated Matrix"
msgstr "Genererad matris"

#. :src: bpy.types.DepsgraphObjectInstance.matrix_world
msgid "Generated transform matrix in world space"
msgstr "Genererad transformationsmatris i världsrymden"

#. :src: bpy.types.DepsgraphObjectInstance.object
msgid "Evaluated object the iterator points to"
msgstr "Utvärderat objekt som iteratorn pekar på"

#. :src: bpy.types.DepsgraphObjectInstance.orco
#. :src: bpy.types.WM_OT_alembic_export.orcos
msgid "Generated Coordinates"
msgstr "Genererade koordinater"

#. :src: bpy.types.DepsgraphObjectInstance.orco
msgid "Generated coordinates in parent object space"
msgstr "Genererade koordinater i det överordnade objektets koordinatrymd"

#. :src: bpy.types.DepsgraphObjectInstance.parent
msgid "If the object is an instance, the parent object that generated it"
msgstr "Om objektet är en instans, det överordnade objektet som genererade det"

#. :src: bpy.types.DepsgraphObjectInstance.particle_system
msgid "Evaluated particle system that this object was instanced from"
msgstr "Utvärderat partikelsystem som detta objekt instanserades från"

#. :src: bpy.types.DepsgraphObjectInstance.persistent_id
msgid "Persistent ID"
msgstr "Beständigt ID"

#. :src: bpy.types.DepsgraphObjectInstance.persistent_id
msgid ""
"Persistent identifier for inter-frame matching of objects with motion blur"
msgstr ""
"Beständig identifierare för matchning mellan bilder av objekt med "
"rörelseoskärpa"

#. :src: bpy.types.DepsgraphObjectInstance.random_id
msgid "Instance Random ID"
msgstr "Instansens slumpmässiga ID"

#. :src: bpy.types.DepsgraphObjectInstance.random_id
msgid "Random id for this instance, typically for randomized shading"
msgstr ""
"Slumpmässigt ID för denna instans, vanligtvis för slumpmässig skuggning"

#. :src: bpy.types.DepsgraphObjectInstance.show_particles
msgid "Show Particles"
msgstr "Visa partiklar"

#. :src: bpy.types.DepsgraphObjectInstance.show_particles
msgid "Particles part of the object should be visible in the render"
msgstr "Partiklar som är en del av objektet ska vara synliga i renderingen"

#. :src: bpy.types.DepsgraphObjectInstance.show_self
msgid "Show Self"
msgstr "Visa objektet"

#. :src: bpy.types.DepsgraphObjectInstance.show_self
msgid "The object geometry itself should be visible in the render"
msgstr "Själva objektgeometrin ska vara synlig i renderingen"

#. :src: bpy.types.DepsgraphObjectInstance.uv
#. :src: bpy.types.WM_OT_alembic_export.uvs
#. :src: bpy.types.WM_OT_usd_import.read_mesh_uvs
#: source/blender/editors/io/io_obj.cc:149
#: source/blender/editors/io/io_ply_ops.cc:131
msgid "UV Coordinates"
msgstr "UV-koordinater"

#. :src: bpy.types.DepsgraphObjectInstance.uv
msgid "UV coordinates in parent object space"
msgstr "UV-koordinater i det överordnade objektets koordinatrymd"
