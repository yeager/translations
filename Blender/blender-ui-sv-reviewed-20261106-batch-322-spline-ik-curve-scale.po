#. :src: bpy.types.SplineIKConstraint.use_curve_radius
msgid "Use Curve Radius"
msgstr "Använd kurvradie"

#. :src: bpy.types.SplineIKConstraint.use_curve_radius
msgid ""
"Average radius of the endpoints is used to tweak the X and Z Scaling of the "
"bones, on top of XZ Scale mode"
msgstr ""
"Den genomsnittliga radien för ändpunkterna används för att justera X- och Z-"
"skalningen av benen, utöver XZ-skalningsläget"

#. :src: bpy.types.SplineIKConstraint.use_even_divisions
msgid "Even Divisions"
msgstr "Jämn fördelning"

#. :src: bpy.types.SplineIKConstraint.use_even_divisions
msgid "Ignore the relative lengths of the bones when fitting to the curve"
msgstr "Ignorera benens relativa längder när du anpassar dem till kurvan"

#. :src: bpy.types.SplineIKConstraint.use_original_scale
msgid "Use Original Scale"
msgstr "Använd ursprunglig skala"

#. :src: bpy.types.SplineIKConstraint.use_original_scale
msgid "Apply volume preservation over the original scaling"
msgstr "Tillämpa volymbevarande över den ursprungliga skalningen"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode
msgid "XZ Scale Mode"
msgstr "XZ-skalaläge"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode
msgid ""
"Method used for determining the scaling of the X and Z axes of the bones"
msgstr "Metod som används för att bestämma skalningen av benens X- och Z-axlar"
