#. :src: bpy.types.NODE_OT_mute_toggle
msgctxt "Operator"
msgid "Toggle Node Mute"
msgstr "Växla avstängning för noder"

#. :src: bpy.types.NODE_OT_mute_toggle
msgid "Toggle muting of selected nodes"
msgstr "Växla avstängning av markerade noder"

#. :src: bpy.types.NODE_OT_nw_add_reroutes
msgid "Add Reroutes to outputs"
msgstr "Lägg till omdirigeringar på utdata"

#. :src: bpy.types.NODE_OT_nw_add_reroutes
msgid "Add Reroute Nodes and link them to outputs of selected nodes"
msgstr "Lägg till omdirigeringsnoder och länka dem till utdata från markerade noder"

#. :src: bpy.types.NODE_OT_output_file_add_socket
msgctxt "Operator"
msgid "Add File Node Socket"
msgstr "Lägg till uttag i filnod"

#. :src: bpy.types.NODE_OT_output_file_move_active_socket
msgctxt "Operator"
msgid "Move File Node Socket"
msgstr "Flytta uttag i filnod"

#. :src: bpy.types.NODE_OT_output_file_remove_active_socket
msgctxt "Operator"
msgid "Remove File Node Socket"
msgstr "Ta bort uttag i filnod"

#. :src: bpy.types.GeometryNodeSampleGridIndex.data_type
msgid "Node socket data type"
msgstr "Datatyp för noduttag"

#. :src: bpy.types.NODE_OT_add_simulation_zone
msgid "Add simulation zone input and output nodes to the active tree"
msgstr "Lägg till simuleringszonens in- och utdatanoder i det aktiva nodträdet"

#. :src: bpy.types.NODE_OT_collapse_hide_unused_toggle
msgid "Toggle collapsed nodes and hide unused sockets"
msgstr "Växla hopfällda noder och dölj oanvända uttag"

#. :src: bpy.types.NODE_OT_join
msgctxt "Operator"
msgid "Join Nodes"
msgstr "Sammanfoga noder"

#. :src: bpy.types.NODE_OT_link
msgctxt "Operator"
msgid "Link Nodes"
msgstr "Länka noder"

