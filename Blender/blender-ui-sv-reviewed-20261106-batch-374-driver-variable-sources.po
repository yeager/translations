#. :src: bpy.types.DriverVariable.name
msgid ""
"Name to use in scripted expressions/functions (no spaces or dots are "
"allowed, and must start with a letter)"
msgstr ""
"Namn som används i skriptade uttryck och funktioner (mellanslag och punkter "
"är inte tillåtna, och namnet måste börja med en bokstav)"

#. :src: bpy.types.DriverVariable.targets
msgid "Sources of input data for evaluating this variable"
msgstr "Källor till indata som används för att utvärdera variabeln"

#. :src: bpy.types.DriverVariable.type:'SINGLE_PROP'
msgid "Use the value from some RNA property"
msgstr "Använd värdet från en RNA-egenskap"

#. :src: bpy.types.DriverVariable.type:'TRANSFORMS'
msgid "Final transformation value of object or bone"
msgstr "Objektets eller benets slutliga transformationsvärde"

#. :src: bpy.types.DriverVariable.type:'ROTATION_DIFF'
msgid "Rotational Difference"
msgstr "Rotationsskillnad"

#. :src: bpy.types.DriverVariable.type:'ROTATION_DIFF'
msgid "Use the angle between two bones"
msgstr "Använd vinkeln mellan två ben"

#. :src: bpy.types.DriverVariable.type:'LOC_DIFF'
msgid "Distance between two bones or objects"
msgstr "Avstånd mellan två ben eller objekt"

#. :src: bpy.types.DriverVariable.type:'CONTEXT_PROP'
msgid ""
"Use the value from some RNA property within the current evaluation context"
msgstr ""
"Använd värdet från en RNA-egenskap i det aktuella utvärderingssammanhanget"
