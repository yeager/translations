msgid "Compression"
msgstr "Kompression"

#. :src: bpy.types.FluidDomainSettings.openvdb_cache_compress_type
#. :src: bpy.types.PointCache.compression
#. :src: bpy.types.PointCacheItem.compression
msgid "Compression method to be used"
msgstr "Komprimeringsmetod som ska användas"

#. :src: bpy.types.FluidDomainSettings.openvdb_cache_compress_type:'ZIP'
#. :src: bpy.types.PointCache.compression:'HEAVY'
#. :src: bpy.types.PointCacheItem.compression:'HEAVY'
msgid "Effective but slow compression"
msgstr "Effektiv men långsam komprimering"

#. :src: bpy.types.FluidDomainSettings.openvdb_cache_compress_type:'BLOSC'
msgid "Blosc"
msgstr "Blosc"

#. :src: bpy.types.FluidDomainSettings.openvdb_data_depth
msgid "Data Depth"
msgstr "Datadjup"

#. :src: bpy.types.FluidDomainSettings.openvdb_data_depth
msgid ""
"Bit depth for fluid particles and grids (lower bit values reduce file size)"
msgstr ""
"Bitdjup för vätskepartiklar och rutnät (lägre bitvärden minskar filstorleken)"

#. :src: bpy.types.FluidDomainSettings.particle_band_width
msgid ""
"Particle (narrow) band width (higher value results in thicker band and more "
"particles)"
msgstr ""
"Bredd för partiklarnas smala band (högre värde ger tjockare band och fler "
"partiklar)"

#. :src: bpy.types.FluidDomainSettings.particle_max
msgid ""
"Maximum number of particles per cell (ensures that each cell has at most "
"this amount of particles)"
msgstr ""
"Maximalt antal partiklar per cell (säkerställer att varje cell har högst "
"detta antal partiklar)"

#. :src: bpy.types.FluidDomainSettings.particle_min
msgid ""
"Minimum number of particles per cell (ensures that each cell has at least "
"this amount of particles)"
msgstr ""
"Minsta antal partiklar per cell (säkerställer att varje cell har minst detta "
"antal partiklar)"

#. :src: bpy.types.FluidDomainSettings.particle_number
msgid "Particle number factor (higher value results in more particles)"
msgstr "Partikelantalsfaktor (högre värde ger fler partiklar)"

#. :src: bpy.types.FluidDomainSettings.particle_radius
msgid ""
"Particle radius factor. Increase this value if the simulation appears to "
"leak volume, decrease it if the simulation seems to gain volume."
msgstr ""
"Partikelradiefaktor. Öka värdet om simuleringen verkar läcka volym och "
"minska det om simuleringen verkar öka i volym."

#. :src: bpy.types.FluidDomainSettings.particle_randomness
#: scripts/startup/bl_ui/properties_freestyle.py:1163
#: scripts/startup/bl_ui/properties_physics_fluid.py:506
#: source/blender/nodes/shader/nodes/node_shader_tex_voronoi.cc:61
msgid "Randomness"
msgstr "Slumpmässighet"

#. :src: bpy.types.FluidDomainSettings.particle_randomness
msgid "Randomness factor for particle sampling"
msgstr "Slumpfaktor för partikelprovtagning"

#. :src: bpy.types.FluidDomainSettings.particle_scale
msgid "Particle scale"
msgstr "Partikelskala"

#. :src: bpy.types.FluidDomainSettings.particle_scale
msgid ""
"The particle simulation is scaled up by this factor (compared to the base "
"resolution of the domain)"
msgstr ""
"Partikelsimuleringen skalas upp med denna faktor (jämfört med domänens "
"basupplösning)"

#. :src: bpy.types.FluidDomainSettings.resolution_max
msgid "Maximum Resolution"
msgstr "Maximal upplösning"

#. :src: bpy.types.FluidDomainSettings.resolution_max
msgid ""
"Resolution used for the fluid domain. Value corresponds to the longest "
"domain side (resolution for other domain sides is calculated automatically)."
msgstr ""
"Upplösning som används för vätskedomänen. Värdet motsvarar den längsta "
"domänsidan (upplösningen för andra domänsidor beräknas automatiskt)."

#. :src: bpy.types.FluidDomainSettings.show_gridlines
msgid "Gridlines"
msgstr "Rutnätslinjer"

#. :src: bpy.types.FluidDomainSettings.show_gridlines
msgid "Show gridlines"
msgstr "Visa rutnätslinjer"

#. :src: bpy.types.FluidDomainSettings.show_velocity
msgid "Visualize vector fields"
msgstr "Visualisera vektorfält"
