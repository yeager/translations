#. :src: bpy.types.ParticleSettings.use_clump_curve
msgid "Use Clump Curve"
msgstr "Använd klumpningskurva"

#. :src: bpy.types.ParticleSettings.use_clump_curve
msgid "Use a curve to define clump tapering"
msgstr "Använd en kurva för att definiera avsmalning för klumpning"

#. :src: bpy.types.ParticleSettings.use_clump_noise
msgid "Use Clump Noise"
msgstr "Använd klumpbrus"

#. :src: bpy.types.ParticleSettings.use_clump_noise
msgid "Create random clumps around the parent"
msgstr "Skapa slumpmässig klumpning kring föräldern"

#. :src: bpy.types.ParticleSettings.use_collection_count
#. :src: bpy.types.PARTICLE_PT_render_collection_use_count
msgid "Use Count"
msgstr "Använd antal"

#. :src: bpy.types.ParticleSettings.use_collection_count
msgid "Use object multiple times in the same collection"
msgstr "Använd objektet flera gånger i samma samling"

#. :src: bpy.types.ParticleSettings.use_collection_pick_random
msgid "Pick Random"
msgstr "Välj slumpmässigt"

#. :src: bpy.types.ParticleSettings.use_collection_pick_random
msgid "Pick objects from collection randomly"
msgstr "Välj objekt slumpmässigt från samlingen"

#. :src: bpy.types.ParticleSettings.use_dead
msgid "Died"
msgstr "Dog"

#. :src: bpy.types.ParticleSettings.use_dead
msgid "Show particles after they have died"
msgstr "Visa partiklar efter att de har dött"

#. :src: bpy.types.ParticleSettings.use_die_on_collision
msgid "Die on Hit"
msgstr "Dö på träff"

#. :src: bpy.types.ParticleSettings.use_die_on_collision
msgid "Particles die when they collide with a deflector object"
msgstr "Partiklar dör när de kolliderar med ett deflektorobjekt"

#. :src: bpy.types.ParticleSettings.use_dynamic_rotation
msgid "Particle rotations are affected by collisions and effectors"
msgstr "Partikelrotationer påverkas av kollisioner och effektorer"

#. :src: bpy.types.ParticleSettings.use_emit_random
msgid "Emit in random order of elements"
msgstr "Sänd ut från elementen i slumpmässig ordning"

#. :src: bpy.types.ParticleSettings.use_even_distribution
msgid "Even Distribution"
msgstr "Jämn fördelning"

#. :src: bpy.types.ParticleSettings.use_even_distribution
msgid "Use even distribution from faces based on face areas or edge lengths"
msgstr ""
"Använd jämn fördelning från ytor baserat på ytornas area eller kantlängder"

#. :src: bpy.types.ParticleSettings.use_global_instance
msgid "Use object's global coordinates for duplication"
msgstr "Använd objektets globala koordinater för duplicering"

#. :src: bpy.types.ParticleSettings.use_hair_bspline
msgid "Interpolate hair using B-Splines"
msgstr "Interpolera hår med hjälp av B-Splines"
