#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_mesh_modifiers
msgid "Apply modifiers to mesh objects (except Armature ones) - WARNING: prevents exporting shape keys"
msgstr "Tillämpa modifierare på meshobjekt (utom armaturer) – VARNING: förhindrar export av formnycklar"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_tspace
msgid "Add binormal and tangent vectors, together with normal they form the tangent space (will only work correctly with tris/quads only meshes!)"
msgstr "Lägg till binormaler och tangentvektorer; tillsammans med normaler bildar de tangentrymden (fungerar endast korrekt med meshar som enbart består av trianglar/fyrhörningar)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_apply
msgid "Apply modifiers (excluding Armatures) to mesh objects -WARNING: prevents exporting shape keys"
msgstr "Tillämpa modifierare (utom armaturer) på meshobjekt – VARNING: förhindrar export av formnycklar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_mesh_compression_enable
msgid "Compress mesh using Draco"
msgstr "Komprimera mesh med Draco"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_kn
msgid "Restrict some optimization to keep named nodes and meshes attached to named nodes so that named nodes can be transformed externally"
msgstr "Begränsa viss optimering för att behålla namngivna noder och meshar kopplade till namngivna noder så att namngivna noder kan transformeras externt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_si
msgid "Simplify meshes targeting triangle count ratio"
msgstr "Förenkla meshar mot ett målförhållande för antalet trianglar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_materials:'PLACEHOLDER'
msgid "Do not export materials, but write multiple primitive groups per mesh, keeping material slot information"
msgstr "Exportera inte material, utan skriv flera primitivgrupper per mesh och behåll materialplatsinformationen"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_materials:'NONE'
msgid "Do not export materials, and combine mesh primitive groups, losing material slot information"
msgstr "Exportera inte material och kombinera meshens primitivgrupper, vilket leder till förlust av materialplatsinformation"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_meshopt_compression_enable
msgid "Compress mesh using Meshopt"
msgstr "Komprimera mesh med Meshopt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_use_gltfpack
msgid "Use gltfpack to simplify the mesh and/or compress its textures"
msgstr "Använd gltfpack för att förenkla meshen och/eller komprimera dess texturer"

#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.name_from
msgid "Name for new mesh object and material"
msgstr "Namn på nytt meshobjekt och material"

#. :src: bpy.types.IMPORT_SCENE_OT_gltf.import_point_as_pointcloud
msgid "Import mesh with only POINTS primitives as Point Cloud objects"
msgstr "Importera mesh med endast POINTS-primitiver som punktmolnsobjekt"
