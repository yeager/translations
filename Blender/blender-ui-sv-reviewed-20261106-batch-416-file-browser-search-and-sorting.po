#. :src: bpy.types.FileSelectParams.filter_glob
msgid ""
"UNIX shell-like filename patterns matching, supports wildcards ('*') and "
"list of patterns separated by ';'"
msgstr ""
"Matchning mot Unix-skal-liknande filnamnsmönster med stöd för jokertecknet "
"('*') och en lista med mönster avgränsade med ';'"

#. :src: bpy.types.FileSelectParams.filter_id
msgid "Filter ID Types"
msgstr "Filtrera ID-typer"

#. :src: bpy.types.FileSelectParams.filter_search
msgid "Name or Tag Filter"
msgstr "Namn- eller etikettsfilter"

#. :src: bpy.types.FileSelectParams.list_column_size
msgid "The width of columns in horizontal list views"
msgstr "Bredden på kolumnerna i horisontella listvyer"

#. :src: bpy.types.FileSelectParams.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.CLIP_OT_open.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.NODE_OT_add_image.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.OBJECT_OT_empty_image_add.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.SEQUENCER_OT_image_strip_add.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.SEQUENCER_OT_sound_strip_add.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.TEXT_OT_open.sort_method:'ASSET_CATALOG'
msgid "Asset Catalog"
msgstr "Resurskatalog"

#. :src: bpy.types.FileSelectParams.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.CLIP_OT_open.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.NODE_OT_add_image.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.OBJECT_OT_empty_image_add.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.SEQUENCER_OT_image_strip_add.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.SEQUENCER_OT_sound_strip_add.sort_method:'ASSET_CATALOG'
#. :src: bpy.types.TEXT_OT_open.sort_method:'ASSET_CATALOG'
msgid ""
"Sort the asset list so that assets in the same catalog are kept together. "
"Within a single catalog, assets are ordered by name. The catalogs are in "
"order of the flattened catalog hierarchy."
msgstr ""
"Sortera resurslistan så att resurser i samma katalog hålls ihop. Inom varje "
"katalog sorteras resurserna efter namn. Katalogerna ordnas efter den "
"plattade kataloghierarkin."

#. :src: bpy.types.FileSelectParams.use_filter_asset_only
msgid "Hide .blend files items that are not data-blocks with asset metadata"
msgstr "Dölj poster i .blend-filer som inte är datablock med resursmetadata"

#. :src: bpy.types.FileSelectParams.use_filter_blendid
msgid "Show .blend files items (objects, materials, etc.)"
msgstr "Visa poster i .blend-filer (objekt, material osv.)"
