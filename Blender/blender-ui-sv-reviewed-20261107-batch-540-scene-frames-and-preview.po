#. :src: bpy.types.Scene.frame_current
msgid "Current frame, to update animation data from Python frame_set() instead"
msgstr ""
"Aktuell bildruta; använd i stället Python frame_set() för att uppdatera "
"animationsdata"

#. :src: bpy.types.Scene.frame_current_final
msgid "Current Frame Final"
msgstr "Aktuell slutlig bildruta"

#. :src: bpy.types.Scene.frame_current_final
msgid "Current frame with subframe and time remapping applied"
msgstr "Aktuell bildruta med delbildruta och tidsomappning tillämpade"

#. :src: bpy.types.Scene.frame_end
msgid "Final frame of the playback/rendering range"
msgstr "Sista bildrutan i uppspelnings-/renderingsområdet"

#. :src: bpy.types.Scene.frame_float
#. :src: bpy.types.Scene.frame_subframe
msgid "Current Subframe"
msgstr "Aktuell delbildruta"

#. :src: bpy.types.Scene.frame_preview_end
msgid "Preview Range End Frame"
msgstr "Slutbildruta för förhandsgranskningsintervallet"

#. :src: bpy.types.Scene.frame_preview_end
msgid "Alternative end frame for UI playback"
msgstr "Alternativ slutbildruta för uppspelning i gränssnittet"

#. :src: bpy.types.Scene.frame_preview_start
msgid "Preview Range Start Frame"
msgstr "Startbildruta för förhandsgranskningsintervallet"

#. :src: bpy.types.Scene.frame_preview_start
msgid "Alternative start frame for UI playback"
msgstr "Alternativ startbildruta för uppspelning i gränssnittet"

#. :src: bpy.types.Scene.frame_start
msgid "First frame of the playback/rendering range"
msgstr "Första bildrutan i uppspelnings-/renderingsområdet"

#. :src: bpy.types.Scene.frame_step
msgid ""
"Number of frames to skip forward while rendering/playing back each frame"
msgstr ""
"Antal bildrutor att hoppa framåt vid rendering/uppspelning av varje bildruta"

#. :src: bpy.types.Scene.gravity
msgid "Constant acceleration in a given direction"
msgstr "Konstant acceleration i en given riktning"
