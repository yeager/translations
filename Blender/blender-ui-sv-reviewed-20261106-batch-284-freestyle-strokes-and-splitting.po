#. :src: bpy.types.FreestyleLineStyle.caps:'BUTT'
msgid "Butt"
msgstr "Stumt"

#. :src: bpy.types.FreestyleLineStyle.dash1
msgid "Length of the 1st dash for dashed lines"
msgstr "Längd på första strecket i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.dash2
msgid "Length of the 2nd dash for dashed lines"
msgstr "Längd på andra strecket i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.dash3
msgid "Length of the 3rd dash for dashed lines"
msgstr "Längd på tredje strecket i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.gap1
msgid "Length of the 1st gap for dashed lines"
msgstr "Längd på första mellanrummet i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.gap2
msgid "Length of the 2nd gap for dashed lines"
msgstr "Längd på andra mellanrummet i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.gap3
msgid "Length of the 3rd gap for dashed lines"
msgstr "Längd på tredje mellanrummet i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'MAX'
msgid ""
"The value computed for the chain is the maximum of the values obtained for "
"chain vertices"
msgstr ""
"Det värde som beräknas för kedjan är det högsta av de värden som erhålls för "
"kedjans hörnpunkter"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'LAST'
msgid ""
"The value computed for the chain is the value obtained for the last chain "
"vertex"
msgstr ""
"Det värde som beräknas för kedjan är det värde som erhålls för kedjans sista "
"hörnpunkt"

#. :src: bpy.types.FreestyleLineStyle.split_dash1
msgid "Split Dash 1"
msgstr "Delningsstreck 1"

#. :src: bpy.types.FreestyleLineStyle.split_dash1
msgid "Length of the 1st dash for splitting"
msgstr "Längd på första strecket vid delning"

#. :src: bpy.types.FreestyleLineStyle.split_dash2
