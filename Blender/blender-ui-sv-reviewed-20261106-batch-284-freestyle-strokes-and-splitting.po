msgstr "Längd på andra strecket vid delning"

#. :src: bpy.types.FreestyleLineStyle.split_dash3
msgid "Split Dash 3"
msgstr "Delningsstreck 3"

#. :src: bpy.types.FreestyleLineStyle.split_dash3
msgid "Length of the 3rd dash for splitting"
msgstr "Längd på tredje strecket vid delning"

#. :src: bpy.types.FreestyleLineStyle.split_gap1
msgid "Split Gap 1"
msgstr "Delningsmellanrum 1"

#. :src: bpy.types.FreestyleLineStyle.split_gap1
msgid "Length of the 1st gap for splitting"
msgstr "Längd på första mellanrummet vid delning"

#. :src: bpy.types.FreestyleLineStyle.split_gap2
msgid "Split Gap 2"
msgstr "Delningsmellanrum 2"

#. :src: bpy.types.FreestyleLineStyle.split_gap2
msgid "Length of the 2nd gap for splitting"
msgstr "Längd på andra mellanrummet vid delning"

#. :src: bpy.types.FreestyleLineStyle.split_gap3
