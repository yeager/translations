#: source/blender/editors/object/object_transform.cc:1179
msgid ""
"Warning: Multiple objects share the same data.\n"
"Make single user and then apply transformations?"
msgstr ""
"Varning: Flera objekt delar samma data.\n"
"Gör data till enskild användare och tillämpa sedan transformeringarna?"

#: source/blender/editors/object/object_transform.cc:762
msgid "Text objects can only have their scale applied: \"%s\""
msgstr "Textobjekt kan endast ha sin skala tillämpad: ”%s”"

#: source/blender/editors/object/object_volume.cc:103
msgid "Volume \"%s\" contains points, only voxel grids are supported"
msgstr "Volymen ”%s” innehåller punkter, endast voxelrutnät stöds"
