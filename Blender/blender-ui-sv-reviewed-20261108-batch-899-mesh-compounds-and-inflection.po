#. :src: bpy.types.DynamicPaintSurface.displace_factor
msgid "Strength of displace when applied to the mesh"
msgstr "Förskjutningens styrka när den tillämpas på meshen"

#. :src: bpy.types.Object.show_all_edges
msgid "Display all edges for mesh objects"
msgstr "Visa alla kanter för meshobjekt"

#. :src: bpy.types.Object.use_mesh_mirror_x
msgid "Enable mesh symmetry in the X axis"
msgstr "Aktivera meshsymmetri i X-axeln"

#. :src: bpy.types.Object.use_mesh_mirror_y
msgid "Enable mesh symmetry in the Y axis"
msgstr "Aktivera meshsymmetri i Y-axeln"

#. :src: bpy.types.Object.use_mesh_mirror_z
msgid "Enable mesh symmetry in the Z axis"
msgstr "Aktivera meshsymmetri i Z-axeln"

#. :src: bpy.types.GeometryNodeMeshToCurve.mode:'EDGES'
msgid ""
"Convert mesh edges to curve segments. Attributes are propagated to curve "
"points."
msgstr ""
"Konvertera meshkanter till kurvsegment. Attributen överförs till "
"kurvpunkterna."

#. :src: bpy.types.GeometryNodePointsToVertices
msgid "Generate a mesh vertex for each point cloud point"
msgstr "Generera en meshhörnpunkt för varje punkt i punktmolnet"

#. :src: bpy.types.Mesh.normals_domain
msgid ""
"The attribute domain that gives enough information to represent the mesh's "
"normals"
msgstr ""
"Attributdomänen som ger tillräckligt med information för att representera "
"meshnormalerna"

#. :src: bpy.types.GeometryNodeMeshToPoints
msgid "Generate a point cloud from a mesh's vertices"
msgstr "Generera ett punktmoln från meshens hörnpunkter"
