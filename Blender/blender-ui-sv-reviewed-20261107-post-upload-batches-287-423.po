msgstr "Använd ett maximalt avstånd för att fältet ska fungera"

#. :src: bpy.types.FieldSettings.use_min_distance
#. :src: bpy.types.FieldSettings.use_radial_min
msgid "Use Min"
msgstr "Använd min"

#. :src: bpy.types.FieldSettings.use_min_distance
msgid "Use a minimum distance for the field's falloff"
msgstr "Använd ett minsta avstånd för fältets avtagande"

#. :src: bpy.types.FieldSettings.use_multiple_springs
