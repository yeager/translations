#. :src: bpy.types.FieldSettings.type
msgid "Type of field"
msgstr "Typ av fält"

#. :src: bpy.types.FieldSettings.type:'BOID'
msgid "Create a force that acts as a boid's predators or target"
msgstr "Skapa en kraft som fungerar som en boids rovdjur eller mål"

#. :src: bpy.types.FieldSettings.type:'CHARGE'
msgid ""
"Spherical forcefield based on the charge of particles, only influences other "
"charge force fields"
msgstr ""
"Sfäriskt kraftfält baserat på partiklarnas laddning som endast påverkar "
"andra laddade kraftfält"

#. :src: bpy.types.FieldSettings.type:'GUIDE'
msgid "Create a force along a curve object"
msgstr "Skapa en kraft längs ett kurvobjekt"

#. :src: bpy.types.FieldSettings.type:'DRAG'
msgid "Create a force that dampens motion"
msgstr "Skapa en kraft som dämpar rörelsen"

#. :src: bpy.types.FieldSettings.type:'FLUID_FLOW'
msgid "Create a force based on fluid simulation velocities"
msgstr "Skapa en kraft baserad på vätskesimuleringens hastigheter"

#. :src: bpy.types.FieldSettings.type:'FORCE'
msgid "Radial field toward the center of object"
msgstr "Radialt fält mot objektets mittpunkt"

#. :src: bpy.types.FieldSettings.type:'HARMONIC'
msgid ""
"The source of this force field is the zero point of a harmonic oscillator"
msgstr "Källan till detta kraftfält är nollpunkten för en harmonisk oscillator"

#. :src: bpy.types.FieldSettings.type:'LENNARDJ'
msgid "Forcefield based on the Lennard-Jones potential"
msgstr "Kraftfält baserat på Lennard-Jones-potentialen"

#. :src: bpy.types.FieldSettings.type:'MAGNET'
msgid "Forcefield depends on the speed of the particles"
msgstr "Kraftfältet beror på partiklarnas hastighet"

#. :src: bpy.types.FieldSettings.type:'TEXTURE'
msgid "Force field based on a texture"
msgstr "Kraftfält baserat på en textur"

#. :src: bpy.types.FieldSettings.type:'TURBULENCE'
msgid "Create turbulence with a noise field"
msgstr "Skapa turbulens med ett brusfält"

#. :src: bpy.types.FieldSettings.type:'VORTEX'
msgid "Spiraling force that twists the force object's local Z axis"
msgstr "Spiralformad kraft som vrider kraftobjektets lokala Z-axel"

#. :src: bpy.types.FieldSettings.type:'WIND'
msgid "Constant force along the force object's local Z axis"
msgstr "Konstant kraft längs kraftobjektets lokala Z-axel"

#. :src: bpy.types.FieldSettings.use_2d_force
msgid "2D"
msgstr "2D"

#. :src: bpy.types.FieldSettings.use_2d_force
msgid "Apply force only in 2D"
msgstr "Tillämpa kraft endast i 2D"

#. :src: bpy.types.FieldSettings.use_absorption
