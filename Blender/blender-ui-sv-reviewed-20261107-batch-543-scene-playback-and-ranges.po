#. :src: bpy.types.Scene.sync_mode:'FRAME_DROP'
msgid "Frame Dropping"
msgstr "Hoppa över bildrutor"

#. :src: bpy.types.Scene.sync_mode:'FRAME_DROP'
msgid "Drop frames if playback is too slow"
msgstr "Hoppa över bildrutor om uppspelningen är för långsam"

#. :src: bpy.types.Scene.sync_mode:'AUDIO_SYNC'
msgid "Sync to audio playback, dropping frames"
msgstr "Synkronisera med ljuduppspelningen och hoppa över bildrutor"

#. :src: bpy.types.Scene.transform_orientation_slots
msgid "Transform Orientation Slots"
msgstr "Platser för transformeringsorientering"

#. :src: bpy.types.Scene.unit_settings
#. :src: bpy.types.UnitSettings
msgid "Unit Settings"
msgstr "Enhetsinställningar"

#. :src: bpy.types.Scene.unit_settings
msgid "Unit editing settings"
msgstr "Inställningar för enhetsredigering"

#. :src: bpy.types.Scene.use_audio
msgid "Play Audio"
msgstr "Spela upp ljud"

#. :src: bpy.types.Scene.use_audio
msgid "Play back of audio from Sequence Editor, otherwise mute audio"
msgstr "Spela upp ljud från sekvensredigeraren, annars tysta ljudet"

#. :src: bpy.types.Scene.use_custom_simulation_range
msgid "Custom Simulation Range"
msgstr "Anpassat simuleringsintervall"

#. :src: bpy.types.Scene.use_custom_simulation_range
msgid ""
"Use a simulation range that is different from the scene range for simulation "
"nodes that don't override the frame range themselves"
msgstr ""
"Använd ett simuleringsintervall som skiljer sig från scenintervallet för "
"simuleringsnoder som inte själva åsidosätter bildruteintervallet"

#. :src: bpy.types.Scene.use_gravity
msgid "Global Gravity"
msgstr "Global tyngdkraft"

#. :src: bpy.types.Scene.use_gravity
msgid "Use global gravity for all dynamics"
msgstr "Använd global gravitation för all dynamik"

#. :src: bpy.types.Scene.use_nodes
msgid "Enable the compositing node tree"
msgstr "Aktivera kompositionsnodträdet"

#. :src: bpy.types.Scene.use_preview_range
#. :src: bpy.types.ANIM_OT_channel_view_pick.use_preview_range
#. :src: bpy.types.ANIM_OT_channels_view_selected.use_preview_range
msgid "Use Preview Range"
msgstr "Använd förhandsgranskningsintervall"

#. :src: bpy.types.Scene.use_preview_range
msgid ""
"Use an alternative start/end frame range for animation playback and view "
"renders"
msgstr ""
"Använd ett alternativt start-/slutbildruteintervall för uppspelning av "
"animeringar och visning av renderingar"

#. :src: bpy.types.Scene.use_stamp_note
#. :src: bpy.types.RenderSettings.use_stamp_note
msgid "Stamp Note"
msgstr "Stämpelanteckning"

#. :src: bpy.types.Scene.use_stamp_note
msgid "User defined note for the render stamping"
msgstr "Användardefinierad anteckning för renderingsstämpling"

#. :src: bpy.types.Scene.view_settings
#. :src: bpy.types.ImageFormatSettings.view_settings
msgid "Color management settings applied on image before saving"
msgstr "Färghanteringsinställningar som tillämpas på bilden innan den sparas"
