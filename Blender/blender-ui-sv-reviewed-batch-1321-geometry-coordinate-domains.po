#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:26
msgid "Minimum boundary of the grid (world space)"
msgstr "Rutnätets minsta gräns (världsrymd)"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:29
msgid "Maximum boundary of the grid (world space)"
msgstr "Rutnätets största gräns (världsrymd)"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:47
msgid "Minimum coordinate in X axis (grid index space)"
msgstr "Minsta koordinat längs X-axeln (rutnätsindexrymd)"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:50
msgid "Minimum coordinate in Y axis (grid index space)"
msgstr "Minsta koordinat längs Y-axeln (rutnätsindexrymd)"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:53
msgid "Minimum coordinate in Z axis (grid index space)"
msgstr "Minsta koordinat längs Z-axeln (rutnätsindexrymd)"

#: source/blender/nodes/geometry/nodes/node_geo_grid_to_points.cc:51
#: source/blender/nodes/geometry/nodes/node_geo_input_voxel_index.cc:16
msgid "X coordinate of the voxel in index space, or the minimum X coordinate of a tile"
msgstr "X-koordinaten för voxeln i indexrymd, eller den minsta X-koordinaten för en ruta"

#: source/blender/nodes/geometry/nodes/node_geo_grid_to_points.cc:53
#: source/blender/nodes/geometry/nodes/node_geo_input_voxel_index.cc:20
msgid "Y coordinate of the voxel in index space, or the minimum Y coordinate of a tile"
msgstr "Y-koordinaten för voxeln i indexrymd, eller den minsta Y-koordinaten för en ruta"

#: source/blender/nodes/geometry/nodes/node_geo_grid_to_points.cc:55
#: source/blender/nodes/geometry/nodes/node_geo_input_voxel_index.cc:24
msgid "Z coordinate of the voxel in index space, or the minimum Z coordinate of a tile"
msgstr "Z-koordinaten för voxeln i indexrymd, eller den minsta Z-koordinaten för en ruta"

#: source/blender/nodes/geometry/nodes/node_geo_input_curve_handles.cc:15
msgid "Output the handle positions relative to the corresponding control point instead of in the local space of the geometry"
msgstr "Mata ut handtagens positioner relativt motsvarande kontrollpunkt i stället för i geometrins lokala koordinatrymd"

#: source/blender/nodes/geometry/nodes/node_geo_tool_3d_cursor.cc:14
msgid "The location of the scene's 3D cursor, in the local space of the modified object"
msgstr "Placeringen av scenens 3D-markör i det modifierade objektets lokala koordinatrymd"

#: source/blender/nodes/geometry/nodes/node_geo_tool_3d_cursor.cc:17
msgid "The rotation of the scene's 3D cursor, in the local space of the modified object"
msgstr "Rotationen av scenens 3D-markör i det modifierade objektets lokala koordinatrymd"

