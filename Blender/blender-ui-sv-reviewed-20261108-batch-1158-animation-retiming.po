#. :src: bpy.types.GreasePencilFrame.select
msgid "Frame Selection in the Dope Sheet"
msgstr "Bildrutemarkering i dopebladet"

#. :src: bpy.types.Scene.is_nla_tweakmode
msgid "NLA Tweak Mode"
msgstr "NLA-justeringsläge"

#. :src: bpy.types.KeyingSet.use_insertkey_needed
#. :src: bpy.types.KeyingSetPath.use_insertkey_needed
msgid "Only insert keyframes where they're needed in the relevant F-Curves"
msgstr "Infoga endast nyckelbildrutor där de behövs i de relevanta F-kurvorna"

#. :src: bpy.types.KeyingSet.use_insertkey_override_needed
#. :src: bpy.types.KeyingSetPath.use_insertkey_override_needed
msgid ""
"Override default setting to only insert keyframes where they're needed in "
"the relevant F-Curves"
msgstr ""
"Åsidosätt standardinställningen för att bara infoga nyckelbildrutor där de "
"behövs i de relevanta F-kurvorna"

#. :src: bpy.types.Available
msgid "Insert a keyframe on each of the already existing F-Curves"
msgstr ""
"Infoga en nyckelbildruta på var och en av de redan befintliga F-kurvorna"

#. :src: bpy.types.KeyingSetPath.group
msgid "Name of Action Group to assign setting(s) for this path to"
msgstr ""
"Namn på Action-grupp att tilldela inställningar för den här sökvägen till"

#. :src: bpy.types.ANIM_MT_keyframe_insert_pie
msgid "Keyframe Insert Pie"
msgstr "Cirkelmeny för att infoga nyckelbildruta"

#. :src: bpy.types.MovieTrackingMarker.co
msgid "Marker position at frame in normalized coordinates"
msgstr "Markörens position vid bildrutan i normaliserade koordinater"

#. :src: bpy.types.MovieTrackingObject.keyframe_a
