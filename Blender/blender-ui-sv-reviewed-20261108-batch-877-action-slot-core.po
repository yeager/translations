#. :src: bpy.types.ActionChannelbags
msgid "Animation Channels for Slots"
msgstr "Animationskanaler för Action-slotar"

#. :src: bpy.types.ActionChannelbags
msgid ""
"For each action slot, a list of animation channels that are meant for that "
"slot"
msgstr ""
"För varje Action-slot finns en lista över animationskanaler avsedda för den"

#. :src: bpy.types.ActionSlot.select
msgid "Selection state of the slot"
msgstr "Markeringsstatus för Action-slotten"

#. :src: bpy.types.ActionSlot.show_expanded
msgid "Expanded state of the slot"
msgstr "Utfällningsstatus för Action-slotten"

#. :src: bpy.types.ActionSlot.target_id_type
msgid ""
"Type of data-block that this slot is intended to animate; can be set when "
"'UNSPECIFIED' but is otherwise read-only"
msgstr ""
"Datablockstypen som Action-slotten är avsedd att animera. Kan ställas in när "
"den är ”UNSPECIFIED”, men är annars skrivskyddad"

#. :src: bpy.types.ActionSlot.target_id_type:'UNSPECIFIED'
msgid ""
"Not yet specified. When this slot is first assigned to a data-block, this "
"will be set to the type of that data-block"
msgstr ""
"Inte angiven ännu. När Action-slotten först tilldelas ett datablock ställs "
"den in på datablockets typ"

#. :src: bpy.types.ActionSlots
msgid "Collection of action slots"
msgstr "Samling av Action-slotar"

#. :src: bpy.types.ActionSlots.active
msgid "Active Slot"
msgstr "Aktiv Action-slot"

#. :src: bpy.types.ActionSlots.active
msgid "Active slot for this action"
msgstr "Aktiv Action-slot för den här Actionen"

#. :src: bpy.types.ActionStrip.type:'KEYFRAME'
#. :src: bpy.types.ActionKeyframeStrip
msgid "Strip with a set of F-Curves for each action slot"
msgstr "Remsa med en uppsättning F-kurvor för varje Action-slot"
