#. :src: bpy.types.CurvePaintSettings.radius_max
#. :src: bpy.types.CurvePaintSettings.radius_taper_end
msgid "Radius Max"
msgstr "Största radie"

#. :src: bpy.types.CurvePaintSettings.radius_max
msgid ""
"Radius to use when the maximum pressure is applied (or when a tablet isn't "
"used)"
msgstr ""
"Radie som ska användas när det maximala trycket appliceras (eller när en "
"surfplatta inte används)"

#. :src: bpy.types.CurvePaintSettings.radius_min
#. :src: bpy.types.CurvePaintSettings.radius_taper_start
#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:1203
msgid "Radius Min"
msgstr "Minsta radie"

#. :src: bpy.types.CurvePaintSettings.radius_min
msgid ""
"Minimum radius when the minimum pressure is applied (also the minimum when "
"tapering)"
msgstr "Minsta radie när minsta tryck används (även vid avsmalning)"

#. :src: bpy.types.CurvePaintSettings.radius_taper_end
#. :src: bpy.types.CurvePaintSettings.radius_taper_start
msgid "Taper factor for the radius of each point along the curve"
msgstr "Avsmalningsfaktor för radien vid varje punkt längs kurvan"

#. :src: bpy.types.CurvePaintSettings.surface_offset
msgid "Offset the stroke from the surface"
msgstr "Förskjut strecket från ytan"

#. :src: bpy.types.CurvePaintSettings.surface_plane
msgid "Plane for projected stroke"
msgstr "Plan för det projicerade strecket"

#. :src: bpy.types.CurvePaintSettings.surface_plane:'NORMAL_VIEW'
msgid "Normal to Surface"
msgstr "Normal mot ytan"

#. :src: bpy.types.CurvePaintSettings.surface_plane:'NORMAL_VIEW'
msgid "Draw in a plane perpendicular to the surface"
msgstr "Rita i ett plan vinkelrätt mot ytan"

#. :src: bpy.types.CurvePaintSettings.surface_plane:'NORMAL_SURFACE'
msgid "Tangent to Surface"
msgstr "Tangent mot ytan"

#. :src: bpy.types.CurvePaintSettings.surface_plane:'NORMAL_SURFACE'
msgid "Draw in the surface plane"
msgstr "Rita i ytplanet"
