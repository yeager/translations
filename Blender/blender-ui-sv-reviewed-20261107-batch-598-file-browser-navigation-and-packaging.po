#. :src: bpy.types.FILE_OT_filepath_drop
msgctxt "Operator"
msgid "File Selector Drop"
msgstr "Släpp i filväljaren"

#. :src: bpy.types.FILE_OT_find_missing_files
msgctxt "Operator"
msgid "Find Missing Files"
msgstr "Sök efter saknade filer"

#. :src: bpy.types.FILE_OT_find_missing_files
msgid "Try to find missing external files"
msgstr "Försök att hitta saknade externa filer"

#. :src: bpy.types.FILE_OT_hidedot
msgctxt "Operator"
msgid "Toggle Hide Dot Files"
msgstr "Växla visning av punktfiler"

#. :src: bpy.types.FILE_OT_highlight
msgctxt "Operator"
msgid "Highlight File"
msgstr "Markera fil"

#. :src: bpy.types.FILE_OT_highlight
msgid "Highlight selected file(s)"
msgstr "Markera vald(a) fil(er)"

#. :src: bpy.types.FILE_OT_make_paths_absolute
msgctxt "Operator"
msgid "Make Paths Absolute"
msgstr "Gör sökvägar absoluta"

#. :src: bpy.types.FILE_OT_make_paths_absolute
msgid "Make all paths to external files absolute"
msgstr "Gör alla sökvägar till externa filer absoluta"

#. :src: bpy.types.FILE_OT_make_paths_relative
msgctxt "Operator"
msgid "Make Paths Relative"
msgstr "Gör sökvägar relativa"

#. :src: bpy.types.FILE_OT_make_paths_relative
msgid "Make all paths to external files relative to current .blend"
msgstr ""
"Gör alla sökvägar till externa filer relativa till den aktuella .blend-filen"

#. :src: bpy.types.FILE_OT_mouse_execute
msgctxt "Operator"
msgid "Execute File"
msgstr "Utför filåtgärd"

#. :src: bpy.types.FILE_OT_mouse_execute
msgid ""
"Perform the current execute action for the file under the cursor (e.g. open "
"the file)"
msgstr ""
"Utför den aktuella åtgärden för filen under markören (t.ex. öppna filen)"

#. :src: bpy.types.FILE_OT_next
msgctxt "Operator"
msgid "Next Folder"
msgstr "Nästa mapp"

#. :src: bpy.types.FILE_OT_next
msgid "Move to next folder"
msgstr "Flytta till nästa mapp"

#. :src: bpy.types.FILE_OT_pack_all
msgctxt "Operator"
msgid "Pack Resources"
msgstr "Packa resurser"

#. :src: bpy.types.FILE_OT_pack_all
msgid "Pack all used external files into this .blend"
msgstr "Packa alla använda externa filer i den här .blend-filen"

#. :src: bpy.types.FILE_OT_pack_libraries
msgctxt "Operator"
msgid "Pack Linked Libraries"
msgstr "Packa länkade bibliotek"

#. :src: bpy.types.FILE_OT_pack_libraries
msgid ""
"Store all data-blocks linked from other .blend files in the current .blend "
"file. Library references are preserved so the linked data-blocks can be "
"unpacked again"
msgstr ""
"Lagra alla datablock som länkats från andra .blend-filer i den "
"aktuella .blend-filen. Biblioteksreferenserna bevaras så att de länkade "
"datablocken kan packas upp igen"

#. :src: bpy.types.FILE_OT_parent
msgctxt "Operator"
msgid "Parent Directory"
msgstr "Överordnad katalog"

#. :src: bpy.types.FILE_OT_parent
msgid "Move to parent directory"
msgstr "Flytta till överordnad katalog"

#. :src: bpy.types.FILE_OT_previous
msgctxt "Operator"
msgid "Previous Folder"
msgstr "Föregående mapp"

#. :src: bpy.types.FILE_OT_previous
msgid "Move to previous folder"
msgstr "Flytta till föregående mapp"

#. :src: bpy.types.FILE_OT_rename
msgctxt "Operator"
msgid "Rename File or Directory"
msgstr "Byt namn på fil eller katalog"

#. :src: bpy.types.FILE_OT_rename
msgid "Rename file or file directory"
msgstr "Byt namn på fil eller katalog"

#. :src: bpy.types.FILE_OT_report_missing_files
msgctxt "Operator"
msgid "Report Missing Files"
msgstr "Rapportera saknade filer"

#. :src: bpy.types.FILE_OT_report_missing_files
msgid "Report all missing external files"
msgstr "Rapportera alla saknade externa filer"

#. :src: bpy.types.FILE_OT_reset_recent
msgctxt "Operator"
msgid "Reset Recent"
msgstr "Återställ senaste"

#. :src: bpy.types.FILE_OT_reset_recent
msgid "Reset recent files"
msgstr "Återställ senaste filer"
