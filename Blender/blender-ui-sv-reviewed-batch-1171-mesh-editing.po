#. :src: bpy.types.BevelModifier.affect
#. :src: bpy.types.MESH_OT_bevel.affect
msgid "Affect edges or vertices"
msgstr "Påverkar kanter eller hörnpunkter"

#. :src: bpy.types.MESH_OT_bevel.clamp_overlap
msgid "Do not allow beveled edges/vertices to overlap each other"
msgstr "Låt inte fasade kanter/hörnpunkter överlappa varandra"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected
msgid "Fits the unselected edge loops to a curve defined by the selected vertices"
msgstr "Anpassar de omarkerade kantringarna till en kurva som definieras av markerade hörnpunkter"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.clamp_elevation
msgid "Restrictions on how the vertices can be moved (wire edges are not supported)"
msgstr "Begränsningar av hur hörnpunkterna kan flyttas (trådkanter stöds inte)"

#. :src: bpy.types.MESH_OT_curve_edge_loops_between_selected.regular
msgid "Distribute vertices at constant distances along the curve"
msgstr "Fördela hörnpunkter med konstant avstånd längs kurvan"

#. :src: bpy.types.MESH_OT_delete_loose
msgid "Delete loose vertices, edges or faces"
msgstr "Ta bort lösa hörnpunkter, kanter eller ytor"

#. :src: bpy.types.MESH_OT_delete_loose.use_verts
msgid "Remove loose vertices"
msgstr "Ta bort lösa hörnpunkter"

#. :src: bpy.types.MESH_OT_dissolve_edges.use_preserve_quads
#. :src: bpy.types.MESH_OT_dissolve_mode.use_preserve_quads
msgid "When dissolving the edge between two triangles, don't dissolve vertices"
msgstr "När kanten mellan två trianglar löses upp ska hörnpunkterna inte lösas upp"

#. :src: bpy.types.MESH_OT_dissolve_limited
msgid "Dissolve selected edges and vertices, limited by the angle of surrounding geometry"
msgstr "Lös upp valda kanter och hörnpunkter, begränsat av vinkeln på omgivande geometri"

#. :src: bpy.types.MESH_OT_dissolve_limited.use_dissolve_boundaries
msgid "Dissolve all vertices in between face boundaries"
msgstr "Lös upp alla hörnpunkter mellan ytgränserna"

#. :src: bpy.types.MESH_OT_dissolve_verts
msgid "Dissolve vertices, merge edges and faces"
msgstr "Lös upp hörnpunkter, slå ihop kanter och ytor"

#. :src: bpy.types.MESH_OT_hide
msgid "Hide (un)selected vertices, edges or faces"
msgstr "Dölj (av)markerade hörnpunkter, kanter eller ytor"
