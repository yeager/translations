#. :src: bpy.types.FModifierNoise.lacunarity
#. :src: bpy.types.MusgraveTexture.lacunarity
#: source/blender/nodes/shader/nodes/node_shader_tex_noise.cc:43
#: source/blender/nodes/shader/nodes/node_shader_tex_voronoi.cc:44
#: source/blender/nodes/texture/nodes/node_texture_proc.cc:204
msgid "Lacunarity"
msgstr "Lacunaritet"

#. :src: bpy.types.FModifierNoise.lacunarity
msgid ""
"Gap between successive frequencies. Depth needs to be greater than 0 for "
"this to have an effect"
msgstr ""
"Avstånd mellan på varandra följande frekvenser. Djupet måste vara större än "
"0 för att detta ska ha någon effekt"

