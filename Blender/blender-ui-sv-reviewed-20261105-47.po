#. :src: bpy.types.BrushGpencilSettings.pen_jitter
#. :src: bpy.types.Brush.jitter
#. :src: bpy.types.Brush.jitter_absolute
msgctxt "Brush"
msgid "Jitter"
msgstr "Slumpning"

#. :src: bpy.types.BrushGpencilSettings.pen_jitter
msgid "Jitter factor of brush radius for new strokes"
msgstr "Slumpningsfaktor för penselradien vid nya streck"

#. :src: bpy.types.BrushGpencilSettings.pen_smooth_factor
msgctxt "Amount"
msgid "Smooth"
msgstr "Utjämning"

#. :src: bpy.types.BrushGpencilSettings.pen_smooth_factor
msgid "Amount of smoothing to apply after finish newly created strokes, to reduce jitter/noise"
msgstr "Mängd utjämning som ska tillämpas efter att nya streck har skapats för att minska slumpning och brus"

#. :src: bpy.types.BrushGpencilSettings.pen_smooth_steps
#. :src: bpy.types.GREASE_PENCIL_OT_interpolate.smooth_steps
#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.smooth_steps
msgid "Number of times to smooth newly created strokes"
msgstr "Antal gånger nya streck ska jämnas ut"

#. :src: bpy.types.BrushGpencilSettings.pen_subdivision_steps
msgid "Subdivision Steps"
msgstr "Underindelningssteg"

#. :src: bpy.types.BrushGpencilSettings.pen_subdivision_steps
msgid "Number of times to subdivide newly created strokes, for less jagged strokes"
msgstr "Antal gånger nya streck ska underindelas för att bli mindre taggiga"

#. :src: bpy.types.BrushGpencilSettings.pin_draw_mode
msgid "Pin Mode"
msgstr "Fäst läge"

#. :src: bpy.types.BrushGpencilSettings.pin_draw_mode
msgid "Pin the mode to the brush"
msgstr "Fäst läget vid penseln"

#. :src: bpy.types.BrushGpencilSettings.random_hue_factor
msgid "Random factor to modify original hue"
msgstr "Slumpfaktor för att ändra den ursprungliga nyansen"

#. :src: bpy.types.BrushGpencilSettings.random_pressure
msgid "Pressure Randomness"
msgstr "Tryckslumpning"

#. :src: bpy.types.BrushGpencilSettings.random_pressure
msgid "Randomness factor for pressure in new strokes"
msgstr "Slumpfaktor för trycket i nya streck"

#. :src: bpy.types.BrushGpencilSettings.random_strength
msgid "Strength Randomness"
msgstr "Styrkeslumpning"

#. :src: bpy.types.BrushGpencilSettings.random_strength
msgid "Randomness factor strength in new strokes"
msgstr "Slumpfaktor för styrkan i nya streck"

#. :src: bpy.types.BrushGpencilSettings.show_fill_extend
msgid "Show help lines for stroke extension"
msgstr "Visa hjälplinjer för streckförlängning"

#. :src: bpy.types.BrushGpencilSettings.simplify_factor
msgid "Factor of Simplify using adaptive algorithm"
msgstr "Faktor för förenkling med adaptiv algoritm"

#. :src: bpy.types.BrushGpencilSettings.use_collide_strokes
msgid "Strokes Collision"
msgstr "Streckkollision"

#. :src: bpy.types.BrushGpencilSettings.use_edit_thickness
msgid "Affect Thickness"
msgstr "Påverka tjockleken"

#. :src: bpy.types.BrushGpencilSettings.use_edit_thickness
msgid "The brush affects the thickness of the point"
msgstr "Penseln påverkar punktens tjocklek"
