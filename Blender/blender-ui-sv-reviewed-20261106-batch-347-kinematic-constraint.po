#. :src: bpy.types.KinematicConstraint
msgid "Kinematic Constraint"
msgstr "Kinematisk begränsning"

#. :src: bpy.types.KinematicConstraint.chain_count
#. :src: bpy.types.SplineIKConstraint.chain_count
msgid "Chain Length"
msgstr "Kedjelängd"

#. :src: bpy.types.KinematicConstraint.chain_count
msgid "How many bones are included in the IK effect - 0 uses all bones"
msgstr "Hur många ben som ingår i IK-effekten – 0 använder alla ben"

#. :src: bpy.types.KinematicConstraint.distance
#. :src: bpy.types.LimitDistanceConstraint.distance
msgid "Radius of limiting sphere"
msgstr "Begränsningssfärens radie"

#. :src: bpy.types.KinematicConstraint.ik_type
msgid "IK Type"
msgstr "IK-typ"

#. :src: bpy.types.KinematicConstraint.ik_type:'COPY_POSE'
msgid "Copy Pose"
msgstr "Kopiera pose"

#. :src: bpy.types.KinematicConstraint.iterations
msgid "Maximum number of solving iterations"
msgstr "Maximalt antal lösningsiterationer"

#. :src: bpy.types.KinematicConstraint.limit_mode
#. :src: bpy.types.LimitDistanceConstraint.limit_mode
msgid "Limit Mode"
msgstr "Begränsningsläge"

#. :src: bpy.types.KinematicConstraint.limit_mode
#. :src: bpy.types.LimitDistanceConstraint.limit_mode
msgid "Distances in relation to sphere of influence to allow"
msgstr "Tillåtna avstånd i förhållande till inflytandesfären"

#. :src: bpy.types.KinematicConstraint.limit_mode:'LIMITDIST_INSIDE'
#. :src: bpy.types.LimitDistanceConstraint.limit_mode:'LIMITDIST_INSIDE'
#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'INSIDE'
#. :src: bpy.types.FreestyleLineStyle.thickness_position:'INSIDE'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'INSIDE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'INSIDE'
#. :src: bpy.types.ShaderNodeAmbientOcclusion.inside
#. :src: bpy.types.MESH_OT_normals_make_consistent.inside
msgid "Inside"
msgstr "Inuti"

#. :src: bpy.types.KinematicConstraint.limit_mode:'LIMITDIST_INSIDE'
#. :src: bpy.types.LimitDistanceConstraint.limit_mode:'LIMITDIST_INSIDE'
msgid ""
"The object is constrained inside a virtual sphere around the target object, "
"with a radius defined by the limit distance"
msgstr ""
"Objektet begränsas till insidan av en virtuell sfär runt målobjektet, med en "
"radie som definieras av begränsningsavståndet"

#. :src: bpy.types.KinematicConstraint.limit_mode:'LIMITDIST_OUTSIDE'
#. :src: bpy.types.LimitDistanceConstraint.limit_mode:'LIMITDIST_OUTSIDE'
#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'OUTSIDE'
#. :src: bpy.types.FreestyleLineStyle.thickness_position:'OUTSIDE'
#. :src: bpy.types.Lattice.use_outside
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'OUTSIDE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'OUTSIDE'
#. :src: bpy.types.PAINT_OT_hide_show.area:'OUTSIDE'
#. :src: bpy.types.PAINT_OT_hide_show_lasso_gesture.area:'OUTSIDE'
#. :src: bpy.types.PAINT_OT_hide_show_line_gesture.area:'OUTSIDE'
#. :src: bpy.types.PAINT_OT_hide_show_polyline_gesture.area:'OUTSIDE'
msgid "Outside"
msgstr "Utanför"

#. :src: bpy.types.KinematicConstraint.limit_mode:'LIMITDIST_OUTSIDE'
#. :src: bpy.types.LimitDistanceConstraint.limit_mode:'LIMITDIST_OUTSIDE'
msgid ""
"The object is constrained outside a virtual sphere around the target object, "
"with a radius defined by the limit distance"
msgstr ""
"Objektet begränsas utanför en virtuell sfär runt målobjektet, med en radie "
"som definieras av begränsningsavståndet"

#. :src: bpy.types.KinematicConstraint.limit_mode:'LIMITDIST_ONSURFACE'
#. :src: bpy.types.LimitDistanceConstraint.limit_mode:'LIMITDIST_ONSURFACE'
#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'ON_SURFACE'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'ON_SURFACE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'ON_SURFACE'
msgid "On Surface"
msgstr "På ytan"

#. :src: bpy.types.KinematicConstraint.limit_mode:'LIMITDIST_ONSURFACE'
#. :src: bpy.types.LimitDistanceConstraint.limit_mode:'LIMITDIST_ONSURFACE'
msgid ""
"The object is constrained on the surface of a virtual sphere around the "
"target object, with a radius defined by the limit distance"
msgstr ""
"Objektet begränsas till ytan av en virtuell sfär runt målobjektet, med en "
"radie som definieras av begränsningsavståndet"

#. :src: bpy.types.KinematicConstraint.orient_weight
msgid "Orientation Weight"
msgstr "Orienteringsvikt"

#. :src: bpy.types.KinematicConstraint.orient_weight
msgid "For Tree-IK: Weight of orientation control for this target"
msgstr "För Tree-IK: Vikt för orienteringskontroll för detta mål"

#. :src: bpy.types.KinematicConstraint.pole_angle
msgid "Pole Angle"
msgstr "Polvinkel"

#. :src: bpy.types.KinematicConstraint.pole_angle
msgid "Pole rotation offset"
msgstr "Polens rotationsförskjutning"

#. :src: bpy.types.KinematicConstraint.pole_subtarget
msgid "Pole Sub-Target"
msgstr "Polens delmål"

#. :src: bpy.types.KinematicConstraint.pole_target
msgid "Pole Target"
msgstr "Polmål"

#. :src: bpy.types.KinematicConstraint.pole_target
msgid "Object for pole rotation"
msgstr "Objekt för polrotation"

#. :src: bpy.types.KinematicConstraint.reference_axis
msgid "Axis Reference"
msgstr "Axelreferens"

#. :src: bpy.types.KinematicConstraint.reference_axis
msgid "Constraint axis Lock options relative to Bone or Target reference"
msgstr ""
"Låsalternativ för begränsningsaxel i förhållande till ben- eller målreferens"

#. :src: bpy.types.KinematicConstraint.use_location
msgid "Chain follows position of target"
msgstr "Kedjan följer målets position"

#. :src: bpy.types.KinematicConstraint.use_rotation
msgid "Chain follows rotation of target"
msgstr "Kedjan följer målets rotation"

#. :src: bpy.types.KinematicConstraint.use_stretch
msgid "Enable IK Stretching"
msgstr "Aktivera IK-sträckning"

#. :src: bpy.types.KinematicConstraint.use_tail
#. :src: bpy.types.RigifyParameters.use_tail
msgid "Use Tail"
msgstr "Använd benspets"

#. :src: bpy.types.KinematicConstraint.use_tail
msgid "Include bone's tail as last element in chain"
msgstr "Inkludera benets spets som sista element i kedjan"

#. :src: bpy.types.KinematicConstraint.weight
msgid "For Tree-IK: Weight of position control for this target"
msgstr "För Tree-IK: Vikt för positionskontroll för detta mål"
