msgstr "JPEG"

#. :src: bpy.types.Image.file_format:'WEBP'
#. :src: bpy.types.ImageFormatSettings.file_format:'WEBP'
msgid "Output image in WebP format"
msgstr "Resultatbild i WebP-format"

#. :src: bpy.types.Image.has_data
msgid "True if the image data is loaded into memory"
msgstr "Sant om bilddata har lästs in i minnet"

