#. :src: bpy.types.FreestyleLineStyle.sort_key:'DISTANCE_FROM_CAMERA'
msgid "Sort by distance from camera (closer lines lie on top of further lines)"
msgstr ""
"Sortera efter avstånd från kameran (närmare linjer hamnar ovanpå mer "
"avlägsna linjer)"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'2D_LENGTH'
#: scripts/startup/bl_ui/properties_freestyle.py:616
msgid "2D Length"
msgstr "2D-längd"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_X'
msgid "Projected X"
msgstr "Projicerad X"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_Y'
msgid "Projected Y"
msgstr "Projicerad Y"

#. :src: bpy.types.FreestyleLineStyle.split_length
msgid "Split Length"
msgstr "Delningslängd"

#. :src: bpy.types.FreestyleLineStyle.split_length
msgid "Curvilinear 2D length for chain splitting"
msgstr "Kurvlinjär 2D-längd för kedjedelning"

#. :src: bpy.types.FreestyleLineStyle.texture_slots
#. :src: bpy.types.Material.texture_paint_slots
#. :src: bpy.types.ParticleSettings.texture_slots
msgid "Texture slots defining the mapping and influence of textures"
msgstr "Texturplatser som definierar texturernas kartläggning och påverkan"

#. :src: bpy.types.FreestyleLineStyle.texture_spacing
msgid "Spacing for textures along stroke length"
msgstr "Avstånd för texturer längs streckets längd"

#. :src: bpy.types.FreestyleLineStyle.thickness_position
msgid "Thickness Position"
msgstr "Tjockleksposition"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'CENTER'
msgid "Silhouettes and border edges are centered along stroke geometry"
msgstr "Silhuetter och kantkanter är centrerade längs streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'INSIDE'
msgid "Silhouettes and border edges are drawn inside of stroke geometry"
msgstr "Silhuetter och kantlinjer ritas inuti streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'OUTSIDE'
msgid "Silhouettes and border edges are drawn outside of stroke geometry"
msgstr "Silhuetter och kantlinjer ritas utanför streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_ratio
msgid "Thickness Ratio"
msgstr "Tjockleksförhållande"

#. :src: bpy.types.FreestyleLineStyle.thickness_ratio
msgid ""
"A number between 0 (inside) and 1 (outside) specifying the relative position "
"of stroke thickness"
msgstr ""
"Ett tal mellan 0 (insida) och 1 (utsida) som anger den relativa positionen "
"för strecktjockleken"

#. :src: bpy.types.FreestyleLineStyle.use_same_object
msgid "If true, only feature edges of the same object are joined"
msgstr ""
"Om alternativet är aktiverat sammanfogas endast funktionskanter från samma "
"objekt"

#. :src: bpy.types.FreestyleLineStyle.use_sorting
msgid "Arrange the stacking order of strokes"
msgstr "Ordna streckens staplingsordning"

#. :src: bpy.types.FreestyleLineStyle.use_split_length
msgid "Use Split Length"
msgstr "Använd delningslängd"

#. :src: bpy.types.FreestyleLineStyle.use_split_length
msgid "Enable chain splitting by curvilinear 2D length"
msgstr "Aktivera kedjedelning med kurvlinjär 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_split_pattern
msgid "Enable chain splitting by dashed line patterns"
msgstr "Aktivera kedjedelning med streckade linjemönster"

#. :src: bpy.types.GreasePencilv3
#. :src: bpy.types.NodeTree.grease_pencil
msgid "Grease Pencil data-block"
msgstr "Grease Pencil-datablock"

#. :src: bpy.types.GreasePencilv3.layer_groups
msgid "Layer Groups"
msgstr "Lagergrupper"

#. :src: bpy.types.GreasePencilv3.layer_groups
msgid "Grease Pencil layer groups"
msgstr "Grease Pencil-lagergrupper"

#. :src: bpy.types.GreasePencilv3.layers
msgid "Grease Pencil layers"
msgstr "Grease Pencil-lager"

#. :src: bpy.types.GreasePencilv3.onion_factor
msgid "Onion Opacity"
msgstr "Opacitet för lökskal"

#. :src: bpy.types.GreasePencilv3.onion_factor
msgid "Change fade opacity of displayed onion frames"
msgstr "Ändra opaciteten för visade lökskalsbildrutor"

#. :src: bpy.types.GreasePencilv3.onion_keyframe_type
msgctxt "GPencil"
msgid "Filter by Type"
msgstr "Filtrera efter typ"

#. :src: bpy.types.GreasePencilv3.onion_keyframe_type
msgid "Type of keyframe (for filtering)"
msgstr "Nyckelbildrutetyp (för filtrering)"

#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'ALL'
msgid "Include all Keyframe types"
msgstr "Inkludera alla nyckelbildrutetyper"

#. :src: bpy.types.GreasePencilv3.onion_mode
msgid "Mode to display frames"
msgstr "Läge för att visa bildrutor"

#. :src: bpy.types.GreasePencilv3.onion_mode:'ABSOLUTE'
msgid "Frames in absolute range of the scene frame"
msgstr "Bildrutor inom scenbildrutans absoluta intervall"

#. :src: bpy.types.GreasePencilv3.onion_mode:'RELATIVE'
msgid "Frames in relative range of the Grease Pencil keyframes"
msgstr "Bildrutor inom Grease Pencil-nyckelbildrutornas relativa intervall"

#. :src: bpy.types.GreasePencilv3.onion_mode:'SELECTED'
msgid "Only selected keyframes"
msgstr "Endast markerade nyckelbildrutor"

#. :src: bpy.types.GreasePencilv3.stroke_depth_order
#. :src: bpy.types.OBJECT_OT_grease_pencil_add.stroke_depth_order
#: scripts/startup/bl_ui/properties_data_grease_pencil.py:439
msgid "Stroke Depth Order"
msgstr "Streckens djupordning"

#. :src: bpy.types.Image.alpha_mode:'CHANNEL_PACKED'
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.alpha_mode:'CHANNEL_PACKED'
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.alpha_mode:'CHANNEL_PACKED'
msgid "Channel Packed"
msgstr "Kanalpackning"

#. :src: bpy.types.Image.bindcode
msgid "OpenGL bindcode"
msgstr "OpenGL-bindningskod"

#. :src: bpy.types.Image.display_aspect
#. :src: bpy.types.MovieClip.display_aspect
msgid "Display Aspect"
msgstr "Visningsbildförhållande"

#. :src: bpy.types.Image.display_aspect
msgid "Display Aspect for this image, does not affect rendering"
msgstr "Visningsbildförhållande för den här bilden påverkar inte renderingen"

#. :src: bpy.types.Image.file_format:'JPEG'
#. :src: bpy.types.ImageFormatSettings.file_format:'JPEG'
