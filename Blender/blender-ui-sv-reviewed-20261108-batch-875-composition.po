#: source/blender/makesrna/intern/rna_scene.cc:1281
msgid "Node tree '%s' is not a compositing node group."
msgstr "Nodträdet ”%s” är inte en kompositionsnodgrupp."

#: source/blender/makesrna/intern/rna_space.cc:3028
msgid "Edit compositor node group for the active scene compositor effect"
msgstr ""
"Redigera kompositorns nodgrupp för den aktiva scenens kompositionseffekt"

#: source/blender/makesrna/intern/rna_space.cc:3033
msgid "Edit compositing node group for Sequencer strip modifiers"
msgstr "Redigera kompositionsnodgrupp för modifierare av sekvenserarremsor"

#: source/blender/nodes/composite/nodes/node_composite_cryptomatte.cc:624
msgid ""
"The Cryptomatte node in render mode is only supported for scene compositing"
msgstr "Cryptomatte-noden i renderingsläge stöds endast för scenkomposition"

#: source/blender/nodes/composite/nodes/node_composite_file_output.cc:404
msgid "The File Output node is only supported for scene compositing"
msgstr "File Output-noden stöds endast för scenkomposition"

#: source/blender/nodes/composite/nodes/node_composite_render_layers.cc:247
msgid "The Render Layers node is only supported for scene compositing"
msgstr "Render Layers-noden stöds endast för scenkomposition"

#: source/blender/nodes/composite/nodes/node_composite_strip_info.cc:84
msgid "The Strip Info node is only supported for sequencer compositing"
msgstr "Strip Info-noden stöds endast för sekvenserarkomposition"
