#. :src: bpy.types.OUTLINER_OT_parent_clear
msgid "Drag to clear parent in Outliner"
msgstr "Dra för att rensa förälder i Outliner"

#. :src: bpy.types.OUTLINER_OT_parent_drop
msgid "Drag to parent in Outliner"
msgstr "Dra för att ange förälder i Outliner"

#. :src: bpy.types.OUTLINER_OT_scene_drop
msgid "Drag object to scene in Outliner"
msgstr "Dra objektet till scenen i Outliner"

#. :src: bpy.types.OUTLINER_OT_scene_operation
msgctxt "Operator"
msgid "Outliner Scene Operation"
msgstr "Scenåtgärd i Outliner"

#. :src: bpy.types.OUTLINER_OT_select_all
msgid "Toggle the Outliner selection of items"
msgstr "Växla markering av objekt i Outliner"

#. :src: bpy.types.UI_OT_eyedropper_bone
msgid "Sample a bone from the 3D View or the Outliner to store in a property"
msgstr "Välj ett ben från 3D-vyn eller Outliner för att lagra i en egenskap"

#. :src: bpy.types.SpaceOutliner.scroll_to_active
msgid ""
"Scroll the active item into view when it changes outside of the outliner"
msgstr "Rulla fram den aktiva posten när den ändras utanför Outliner"

#. :src: bpy.types.SpaceOutliner.sort_method
msgid "Sorting method for Outliner elements"
msgstr "Sorteringsmetod för element i Outliner"

#. :src: bpy.types.SpaceProperties.outliner_sync
msgid "Outliner Sync"
msgstr "Outliner-synkronisering"

#. :src: bpy.types.SpaceProperties.outliner_sync
msgid "Change to the corresponding tab when outliner data icons are clicked"
msgstr "Växla till motsvarande flik när du klickar på dataikoner i Outliner"

#. :src: bpy.types.SpaceProperties.outliner_sync:'ALWAYS'
msgid "Always change tabs when clicking an icon in an outliner"
msgstr "Byt alltid flik när du klickar på en ikon i Outliner"

#. :src: bpy.types.SpaceProperties.outliner_sync:'NEVER'
msgid "Never change tabs when clicking an icon in an outliner"
msgstr "Ändra aldrig flikar när du klickar på en ikon i Outliner"

#. :src: bpy.types.SpaceProperties.outliner_sync:'AUTO'
msgid "Change tabs only when this editor shares a border with an outliner"
msgstr "Byt flik endast när den här redigeraren delar kant med Outliner"

#. :src: bpy.types.ThemeOutliner
msgid "Theme Outliner"
msgstr "Tema för Outliner"

#. :src: bpy.types.ThemeOutliner
msgid "Theme settings for the Outliner"
msgstr "Temainställningar för Outliner"

msgid "Sync with Outliner"
msgstr "Synkronisera med Outliner"

msgid "Can only pick from the 3D viewport or the outliner"
msgstr "Det går bara att välja från 3D-visningsområdet eller Outliner"

msgid "Expected an active Outliner"
msgstr "Förväntade en aktiv Outliner"

msgid "Expected an Outliner region"
msgstr "Förväntade en Outliner-region"

msgid "Strip names are not editable from the Outliner"
msgstr "Remsnamn kan inte redigeras från Outliner"

