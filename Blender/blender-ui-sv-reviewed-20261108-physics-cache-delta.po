#: source/blender/editors/object/object_bake_simulation.cc:1011
msgid "Cannot determine bake location on disk. Falling back to packed bake."
msgstr "Det går inte att fastställa bakningsplatsen på disken. Faller tillbaka till packad bakning."

#: source/blender/editors/object/object_bake_simulation.cc:769
#, c-format
msgid "Bake directory of object %s, modifier %s is empty, setting default path"
msgstr "Bakningskatalogen för objektet %s, modifieraren %s, är tom. Anger standardsökväg"

#: source/blender/editors/physics/dynamicpaint_ops.cc:478
msgid "Bake failed: no Dynamic Paint modifier found"
msgstr "Bakningen misslyckades: ingen Dynamic Paint-modifierare hittades"

#: source/blender/editors/physics/dynamicpaint_ops.cc:502
msgid "Baking Dynamic Paint..."
msgstr "Bakar Dynamic Paint..."

#: source/blender/editors/physics/physics_fluid.cc:682
msgid "Bake free failed: no Fluid modifier found"
msgstr "Det gick inte att rensa data: ingen vätskemodifierare hittades"

#: source/blender/editors/physics/physics_fluid.cc:687
msgid "Bake free failed: invalid domain"
msgstr "Det gick inte att rensa data: ogiltig domän"

#: source/blender/editors/physics/physics_fluid.cc:635
msgid "Freeing fluid..."
msgstr "Rensar vätskedata..."

#: source/blender/editors/physics/physics_pointcache.cc:55
msgid "Library override data-blocks only support Disk Cache storage"
msgstr "Biblioteksåsidosatta datablock stöder endast diskcachelagring"
