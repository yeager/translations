#. :src: bpy.types.MaskModifier
msgid "Mask modifier to hide parts of the mesh"
msgstr "Maskmodifierare för att dölja delar av meshen"

#. :src: bpy.types.MeshCacheModifier.deform_mode:'INTEGRATE'
msgid ""
"Integrate deformation from this modifier's input with the mesh-cache "
"coordinates (useful for shape keys)"
msgstr ""
"Integrera deformation från denna modifierares indata med "
"meshcachekoordinaterna (användbart för formnycklar)"

#. :src: bpy.types.MeshDeformModifier
msgid "Mesh deformation modifier to deform with other meshes"
msgstr "Modifierare för meshdeformering med andra meshar"

#. :src: bpy.types.MeshToVolumeModifier.interior_band_width
msgid "Width of the gradient inside of the mesh"
msgstr "Bredden på gradienten inuti meshen"

#. :src: bpy.types.MirrorModifier.use_bisect_axis
msgid "Cuts the mesh across the mirror plane"
msgstr "Skär meshen tvärs över spegelplanet"

#. :src: bpy.types.MultiresModifier
msgid "Multiresolution mesh modifier"
msgstr "Flerupplösningsmodifierare för mesh"

#. :src: bpy.types.MultiresModifier.use_creases
#. :src: bpy.types.SubsurfModifier.use_creases
msgid "Use mesh crease information to sharpen edges or corners"
msgstr "Använd information om meshveck för att skärpa kanter eller hörn"

#. :src: bpy.types.MultiresModifier.use_custom_normals
#. :src: bpy.types.SubsurfModifier.use_custom_normals
msgid "Interpolates existing custom normals to resulting mesh"
msgstr ""
"Interpolerar befintliga anpassade normaler till den resulterande meshen"

#. :src: bpy.types.MultiresModifier.use_sculpt_base_mesh
msgid ""
"Make Sculpt Mode tools deform the base mesh while previewing the "
"displacement of higher subdivision levels"
msgstr ""
"Låt verktygen i skulpteringsläget deformera basmeshen medan förskjutningen "
"av högre underindelningsnivåer förhandsgranskas"

#. :src: bpy.types.ParticleInstanceModifier.space
msgid "Space to use for copying mesh data"
msgstr "Koordinatutrymme som används för kopiering av meshdata"

#. :src: bpy.types.RemeshModifier
msgid ""
"Generate a new surface with regular topology that follows the shape of the "
"input mesh"
msgstr ""
"Skapa en ny yta med regelbunden topologi som följer formen på indatameshen"

#. :src: bpy.types.RemeshModifier.mode:'SHARP'
msgid ""
"Output a surface that reproduces sharp edges and corners from the input mesh"
msgstr "Skapa en yta som återger skarpa kanter och hörn från indatameshen"

#. :src: bpy.types.RemeshModifier.mode:'VOXEL'
msgid "Output a mesh corresponding to the volume of the original mesh"
msgstr "Skapa en mesh som motsvarar volymen hos den ursprungliga meshen"

#. :src: bpy.types.ScrewModifier.use_normal_calculate
msgid "Calculate the order of edges (needed for meshes, but not curves)"
msgstr "Beräkna ordningen på kanter (behövs för meshar, men inte kurvor)"

#. :src: bpy.types.SimpleDeformModifier.deform_method:'BEND'
msgid "Bend the mesh over the Z axis of the modifier space"
msgstr "Böj meshen över modifieringsutrymmets Z-axel"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'EXTRUDE'
msgid "Output a solidified version of a mesh by simple extrusion"
msgstr "Skapa en solidifierad version av en mesh med enkel extrudering"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'NON_MANIFOLD'
msgid ""
"Output a manifold mesh even if the base mesh is non-manifold, where edges "
"have 3 or more connecting faces. This method is slower."
msgstr ""
"Skapa en manifold-mesh även om basmeshen inte är manifold, där kanterna har "
"tre eller fler anslutande ytor. Denna metod är långsammare."

#. :src: bpy.types.SubsurfModifier.adaptive_space
msgid "How to adaptively subdivide the mesh"
msgstr "Hur meshen ska delas upp adaptivt"

#. :src: bpy.types.SubsurfModifier.adaptive_space:'OBJECT'
msgid ""
"Subdivide to reach a specified edge length in object space. This is required "
"to use adaptive subdivision for instanced meshes"
msgstr ""
"Dela upp för att nå en angiven kantlängd i objektrymden. Detta krävs för att "
"använda adaptiv underindelning för instansierade meshar"

#. :src: bpy.types.SubsurfModifier.use_adaptive_subdivision
msgid "Adaptively subdivide mesh based on camera distance"
msgstr "Dela upp meshen adaptivt utifrån kameraavståndet"

#. :src: bpy.types.SurfaceDeformModifier.is_bound
msgid "Whether geometry has been bound to target mesh"
msgstr "Om geometrin har kopplats till målmeshen"

#. :src: bpy.types.VolumeToMeshModifier.grid_name
msgid "Grid in the volume object that is converted to a mesh"
msgstr "Rutnätet i volymobjektet som konverteras till en mesh"

#. :src: bpy.types.VolumeToMeshModifier.threshold
msgid "Voxels with a larger value are inside the generated mesh"
msgstr "Voxlar med ett högre värde ligger inuti den genererade meshen"
