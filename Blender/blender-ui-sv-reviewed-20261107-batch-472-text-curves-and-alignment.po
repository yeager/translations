#. :src: bpy.types.SurfaceCurve
msgid "Surface Curve"
msgstr "Ytkurva"

#. :src: bpy.types.SurfaceCurve
msgid "Curve data-block used for storing surfaces"
msgstr "Kurvdatablock som används för att lagra ytor"

#. :src: bpy.types.TextCurve
msgid "Text Curve"
msgstr "Textkurva"

#. :src: bpy.types.TextCurve
msgid "Curve data-block used for storing text"
msgstr "Kurvdatablock som används för att lagra text"

#. :src: bpy.types.TextCurve.active_textbox
msgid "Active Text Box"
msgstr "Aktiv textruta"

#. :src: bpy.types.TextCurve.align_x
#. :src: bpy.types.GeometryNodeStringToCurves.align_x
msgid "Horizontal Alignment"
msgstr "Horisontell justering"

#. :src: bpy.types.TextCurve.align_x
#. :src: bpy.types.GeometryNodeStringToCurves.align_x
msgid "Text horizontal alignment from the object or text box center"
msgstr ""
"Horisontell justering av texten utifrån objektets eller textrutans mitt"

#. :src: bpy.types.TextCurve.align_x:'JUSTIFY'
msgid "Align to the left and the right"
msgstr "Justera mot både vänster och höger kant"

#. :src: bpy.types.TextCurve.align_x:'FLUSH'
#. :src: bpy.types.GeometryNodeStringToCurves.align_x:'FLUSH'
msgid "Flush"
msgstr "Jämna marginaler"

#. :src: bpy.types.TextCurve.align_x:'FLUSH'
msgid "Align to the left and the right, with equal character spacing"
msgstr "Justera mot vänster och höger kant med jämnt teckenavstånd"

#. :src: bpy.types.TextCurve.align_y
#. :src: bpy.types.GeometryNodeStringToCurves.align_y
msgid "Vertical Alignment"
msgstr "Vertikal justering"

#. :src: bpy.types.TextCurve.align_y
#. :src: bpy.types.GeometryNodeStringToCurves.align_y
msgid "Text vertical alignment from the object center"
msgstr "Vertikal justering av texten utifrån objektets mittpunkt"

#. :src: bpy.types.TextCurve.align_y:'TOP'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'TOP'
msgid "Align text to the top"
msgstr "Justera texten mot överkanten"

#. :src: bpy.types.TextCurve.align_y:'TOP_BASELINE'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'TOP_BASELINE'
msgid "Top Baseline"
msgstr "Övre baslinje"

#. :src: bpy.types.TextCurve.align_y:'TOP_BASELINE'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'TOP_BASELINE'
msgid "Align text to the top line's baseline"
msgstr "Justera texten till den översta radens baslinje"

#. :src: bpy.types.TextCurve.align_y:'CENTER'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'MIDDLE'
#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_arc.cc:41
#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_quadratic_bezier.cc:21
msgid "Middle"
msgstr "Mitten"

#. :src: bpy.types.TextCurve.align_y:'CENTER'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'MIDDLE'
msgid "Align text to the middle"
msgstr "Centrera texten vertikalt"

#. :src: bpy.types.TextCurve.align_y:'BOTTOM_BASELINE'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'BOTTOM_BASELINE'
msgid "Bottom Baseline"
msgstr "Nedre baslinje"

#. :src: bpy.types.TextCurve.align_y:'BOTTOM_BASELINE'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'BOTTOM_BASELINE'
msgid "Align text to the bottom line's baseline"
msgstr "Justera texten till den nedre linjens baslinje"

#. :src: bpy.types.TextCurve.align_y:'BOTTOM'
#. :src: bpy.types.GeometryNodeStringToCurves.align_y:'BOTTOM'
msgid "Align text to the bottom"
msgstr "Justera texten mot nederkanten"
