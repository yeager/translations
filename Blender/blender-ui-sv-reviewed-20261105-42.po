#. :src: bpy.types.BoneColor
msgid "Theme color or custom color of a bone"
msgstr "Temafärg eller anpassad färg för ett ben"

#. :src: bpy.types.BoneColor.custom
msgid "The custom bone colors, used when palette is 'CUSTOM'"
msgstr "De anpassade benfärgerna som används när paletten är 'CUSTOM'"

#. :src: bpy.types.BoneColor.is_custom
msgid "Use Custom Color"
msgstr "Använd anpassad färg"

#. :src: bpy.types.BoneColor.is_custom
msgid "A color palette is user-defined, instead of using a theme-defined one"
msgstr "Färgpaletten är användardefinierad i stället för temadefinierad"
