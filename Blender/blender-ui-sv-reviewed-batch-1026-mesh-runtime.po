#: source/blender/blenkernel/intern/rigidbody.cc:1485
msgid "Cannot add Rigid Body to non mesh object"
msgstr "Det går inte att lägga till Rigid Body till ett objekt som inte är ett meshobjekt"

#: source/blender/editors/mesh/editmesh_loopcut.cc:397
msgid "Loop cut does not work well on deformed edit mesh display"
msgstr "Kantslingeskärning fungerar inte bra på deformerad meshredigeringsvisning"

#: source/blender/editors/sculpt_paint/mesh/paint_image_proj.cc:6506
msgid "Could not get valid evaluated mesh"
msgstr "Det gick inte att få en giltig utvärderad mesh"

#: source/blender/editors/object/object_remesh.cc:117
msgid "Voxel remesher cannot run with a voxel size of 0.0"
msgstr "Voxelommesharen kan inte köras med voxelstorleken 0,0"

#: source/blender/editors/transform/transform_mode_shrink_fatten.cc:184
msgid "'Shrink/Fatten' meshes is only supported in edit mode"
msgstr "”Krymp/förstora” av meshar stöds endast i redigeringsläge"

#: source/blender/editors/uvedit/uvedit_ops.cc:2866
msgid "%d duplicates found in %d mesh(es), mirror may be incomplete"
msgstr "%d dubbletter hittades i %d meshar, speglingen kan vara ofullständig"

#: source/blender/io/alembic/intern/abc_reader_mesh.cc:568
msgid "Invalid mesh; more detail on the console"
msgstr "Ogiltig mesh; mer information finns i konsolen"

#: source/blender/io/alembic/intern/abc_reader_mesh.cc:916
#: source/blender/io/alembic/intern/abc_reader_mesh.cc:1227
msgid "Error reading mesh sample; more detail on the console"
msgstr "Fel vid läsning av meshprov; mer information finns i konsolen"

#: source/blender/io/usd/intern/usd_reader_mesh.cc:1024
msgid "Fixed mesh for prim: %s"
msgstr "Korrigerad mesh för prim: %s"

#: source/blender/io/usd/intern/usd_skel_convert.cc:1152
msgid "%s: Error creating deform group data for mesh %s"
msgstr "%s: Fel vid skapande av deformationsgruppdata för mesh %s"

#: source/blender/io/usd/intern/usd_writer_mesh.cc:491
msgid "USD export: Simple subdivision not supported, exporting subdivided mesh"
msgstr "USD-export: Enkel underindelning stöds inte; exporterar underindelad mesh"

#: source/blender/makesrna/intern/rna_object_api.cc:554
msgid "Object should be of mesh type"
msgstr "Objektet ska ha meshtyp"

#: source/blender/makesrna/intern/rna_object_api.cc:616
msgid "Object '%s' has no evaluated mesh data"
msgstr "Objektet ”%s” har inga utvärderade meshdata"

#: source/blender/modifiers/intern/MOD_correctivesmooth.cc:627
msgid "Object is not a mesh"
msgstr "Objektet är inte en mesh"

#: source/blender/nodes/geometry/nodes/node_geo_boolean.cc:32
msgid "Base mesh to subtract geometry from"
msgstr "Basmesh att subtrahera geometri från"

#: source/blender/nodes/geometry/nodes/node_geo_bounding_box.cc:25
msgid "A cube mesh enclosing the input geometry"
msgstr "En kubmesh som omsluter indatageometrin"

#: source/blender/nodes/geometry/nodes/node_geo_curve_to_mesh.cc:27
msgid "Curve to convert to a mesh using the given profile"
msgstr "Kurva som ska konverteras till en mesh med hjälp av den angivna profilen"

#: source/blender/nodes/geometry/nodes/node_geo_deform_curves_on_surface.cc:260
msgid "Surface has no mesh"
msgstr "Ytan har ingen mesh"

#: source/blender/nodes/geometry/nodes/node_geo_points_to_vertices.cc:20
msgid "Points that are converted to vertices in a mesh"
msgstr "Punkter som konverteras till hörnpunkter i en mesh"

#: source/blender/nodes/geometry/nodes/node_geo_realize_instances.cc:44
msgid "Preserve the apparent face orientation of mirrored mesh instances"
msgstr "Bevara den synliga ytorienteringen för speglade meshinstanser"

#: source/blender/nodes/geometry/nodes/node_geo_subdivision_surface.cc:212
msgid "Subdivision result mesh is too large for uniform subdivision"
msgstr "Underindelningsresultatets mesh är för stor för enhetlig underindelning"

#: source/blender/nodes/geometry/nodes/node_geo_uv_unwrap.cc:20
msgid "This method gives a good 2D representation of a mesh"
msgstr "Denna metod ger en bra 2D-representation av en mesh"

#: source/blender/nodes/geometry/nodes/node_geo_volume_to_mesh.cc:49
msgid "Volume to convert to a mesh"
msgstr "Volym att konvertera till en mesh"

#: source/blender/nodes/shader/nodes/node_shader_vertex_color.cc:48
msgid "No mesh in active object"
msgstr "Det aktiva objektet saknar mesh"
