msgstr "Linjär med begränsning"

#. :src: bpy.types.Scene.audio_distance_model:'LINEAR_CLAMPED'
msgid "Linear distance model with clamping"
msgstr "Linjär avståndsmodell med begränsning"

#. :src: bpy.types.Scene.audio_distance_model:'EXPONENT'
msgid "Exponential"
msgstr "Exponentiell"

#. :src: bpy.types.Scene.audio_distance_model:'EXPONENT'
