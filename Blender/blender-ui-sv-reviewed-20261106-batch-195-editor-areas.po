#. :src: bpy.types.Area
msgid "Area in a subdivided screen, containing an editor"
msgstr "Område på en uppdelad skärm som innehåller en redigerare"

#. :src: bpy.types.Area.height
msgid "Area height"
msgstr "Områdets höjd"

#. :src: bpy.types.Area.show_menus
msgid "Show menus in the header"
msgstr "Visa menyer i rubriken"

#. :src: bpy.types.Area.spaces
msgid "Spaces"
msgstr "Redigerarlägen"

#. :src: bpy.types.Area.spaces
msgid ""
"Spaces contained in this area, the first being the active space (NOTE: "
"Useful for example to restore a previously used 3D view space in a certain "
"area to get the old view orientation)"
msgstr ""
"Redigerarlägen i det här området; det första är det aktiva redigerarläget "
"(OBS: Kan till exempel användas för att återställa en tidigare använd 3D-vy "
"i ett visst område med dess gamla vyorientering)"

