msgstr "Tillåt att linjer som genereras av när-/fjärrbeskärningsplanet visas"

#. :src: bpy.types.ShaderNodeCustomGroup
msgid "Custom Shader Group Node for Python nodes"
msgstr "Anpassad shadergruppsnod för Python-noder"

#. :src: bpy.types.PREFERENCES_OT_asset_library_add.type:'REMOTE'
