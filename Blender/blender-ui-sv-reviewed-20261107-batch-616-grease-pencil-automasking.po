#. :src: bpy.types.GPencilSculptSettings.use_automasking_layer_active
#. :src: bpy.types.GPencilSculptSettings.use_automasking_layer_stroke
msgid "Auto-Masking Layer"
msgstr "Automaskering av lager"

#. :src: bpy.types.GPencilSculptSettings.use_automasking_layer_active
msgid "Affect only the Active Layer"
msgstr "Påverkar endast det aktiva lagret"

#. :src: bpy.types.GPencilSculptSettings.use_automasking_layer_stroke
#. :src: bpy.types.GPencilSculptSettings.use_automasking_material_stroke
#. :src: bpy.types.GPencilSculptSettings.use_automasking_stroke
msgid "Affect only strokes below the cursor"
msgstr "Påverkar endast streck under markören"

#. :src: bpy.types.GPencilSculptSettings.use_automasking_material_active
#. :src: bpy.types.GPencilSculptSettings.use_automasking_material_stroke
msgid "Auto-Masking Material"
msgstr "Automaskering av material"

#. :src: bpy.types.GPencilSculptSettings.use_automasking_material_active
msgid "Affect only the Active Material"
msgstr "Påverkar endast det aktiva materialet"

#. :src: bpy.types.GPencilSculptSettings.use_automasking_stroke
msgid "Auto-Masking Strokes"
msgstr "Automaskering av streck"

#. :src: bpy.types.GPencilSculptSettings.use_multiframe_falloff
msgid "Use Falloff"
msgstr "Använd avtagande"

#. :src: bpy.types.GPencilSculptSettings.use_multiframe_falloff
msgid ""
"Use falloff effect when edit in multiframe mode to compute brush effect by "
"frame"
msgstr ""
"Använd avtagandeeffekten vid redigering i flerbildsläge för att beräkna "
"penselns påverkan per bildruta"

#. :src: bpy.types.GPencilSculptSettings.use_scale_thickness
msgid "Scale Stroke Thickness"
msgstr "Skala strecktjocklek"

#. :src: bpy.types.GPencilSculptSettings.use_scale_thickness
msgid "Scale the stroke thickness when transforming strokes"
msgstr "Skala strecktjockleken när streck transformeras"

#. :src: bpy.types.GPencilSculptSettings.use_thickness_curve
msgid "Use Curve"
msgstr "Använd kurva"

#. :src: bpy.types.GPencilSculptSettings.use_thickness_curve
msgid "Use curve to define primitive stroke thickness"
msgstr "Använd en kurva för att ange den primitiva strecktjockleken"
