#. :src: bpy.types.CompositorNodeColorMatte
msgid "Color Key"
msgstr "Färgnyckling"

#. :src: bpy.types.CompositorNodeColorMatte
msgid "Create matte using a given color, for green or blue screen footage"
msgstr ""
"Skapa en matta med en angiven färg för filmmaterial med grön eller blå "
"bakgrund"

#. :src: bpy.types.CompositorNodeColorSpill.channel:'R'
msgid "Red spill suppression"
msgstr "Undertryck rött färgspill"

#. :src: bpy.types.CompositorNodeColorSpill.channel:'G'
msgid "Green spill suppression"
msgstr "Undertryck grönt färgspill"

#. :src: bpy.types.CompositorNodeColorSpill.channel:'B'
msgid "Blue spill suppression"
msgstr "Undertryck blått färgspill"

#. :src: bpy.types.CompositorNodeCombineColor.mode:'HSL'
#. :src: bpy.types.CompositorNodeSeparateColor.mode:'HSL'
#. :src: bpy.types.FunctionNodeCombineColor.mode:'HSL'
#. :src: bpy.types.FunctionNodeSeparateColor.mode:'HSL'
#. :src: bpy.types.ShaderNodeCombineColor.mode:'HSL'
#. :src: bpy.types.ShaderNodeSeparateColor.mode:'HSL'
#. :src: bpy.types.TextureNodeCombineColor.mode:'HSL'
#. :src: bpy.types.TextureNodeSeparateColor.mode:'HSL'
msgid "Use HSL (Hue, Saturation, Lightness) color processing"
msgstr "Använd HSL-färgbehandling (nyans, mättnad, ljushet)"

#. :src: bpy.types.CompositorNodeCombineColor.mode:'YCC'
#. :src: bpy.types.CompositorNodeSeparateColor.mode:'YCC'
msgid ""
"Use YCbCr (Y - luma, Cb - blue-difference chroma, Cr - red-difference "
"chroma) color processing"
msgstr ""
"Använd YCbCr (Y – luminans, Cb – blådifferenskrominans, Cr – "
"röddifferenskrominans)-färgbehandling"

#. :src: bpy.types.CompositorNodeCombineColor.mode:'YUV'
#. :src: bpy.types.CompositorNodeSeparateColor.mode:'YUV'
msgid "Use YUV (Y - luma, U V - chroma) color processing"
msgstr "Använd YUV (Y – luminans, U/V – krominans)-färgbehandling"

#. :src: bpy.types.CompositorNodeComposite
msgid "Final render output"
msgstr "Slutliga renderingsutdata"

#. :src: bpy.types.CompositorNodeCrop.use_crop_size
msgid "Crop Image Size"
msgstr "Beskär bildstorleken"

#. :src: bpy.types.CompositorNodeCryptomatte
msgid "Deprecated. Use Cryptomatte Node instead"
msgstr "Föråldrad. Använd Cryptomatte-noden i stället"

#. :src: bpy.types.CompositorNodeCryptomatte.add
#. :src: bpy.types.CompositorNodeCryptomatteV2.add
msgid ""
"Add object or material to matte, by picking a color from the Pick output"
msgstr ""
"Lägg till objekt eller material i mattan genom att välja en färg från Pick-"
"utdata"

#. :src: bpy.types.CompositorNodeCryptomatte.matte_id
#. :src: bpy.types.CompositorNodeCryptomatteV2.matte_id
msgid "Matte Objects"
msgstr "Objekt i mattan"

#. :src: bpy.types.CompositorNodeCryptomatte.matte_id
#. :src: bpy.types.CompositorNodeCryptomatteV2.matte_id
msgid "List of object and material crypto IDs to include in matte"
msgstr "Lista över crypto-ID:n för objekt och material som ska ingå i mattan"

#. :src: bpy.types.CompositorNodeCryptomatteV2.entries
msgid "Mattes"
msgstr "Mattor"

#. :src: bpy.types.CompositorNodeCryptomatteV2.has_views
#. :src: bpy.types.CompositorNodeImage.has_views
msgid "Has View"
msgstr "Har vy"

#. :src: bpy.types.CompositorNodeCryptomatteV2.layer_name
msgid "Cryptomatte Layer"
msgstr "Cryptomatte-lager"

#. :src: bpy.types.CompositorNodeCryptomatteV2.layer_name:'CryptoMaterial'
msgid "Use Material layer"
msgstr "Använd materiallager"

#. :src: bpy.types.CompositorNodeCryptomatteV2.layer_name:'CryptoAsset'
msgid "Use Asset layer"
msgstr "Använd resurslager"

#. :src: bpy.types.CompositorNodeCryptomatteV2.source
msgid "Where the Cryptomatte passes are loaded from"
msgstr "Varifrån Cryptomatte-passen läses in"

#. :src: bpy.types.CompositorNodeCustomGroup
msgid "Compositor Custom Group"
msgstr "Anpassad kompositörsgrupp"

#. :src: bpy.types.CompositorNodeCustomGroup
msgid "Custom Compositor Group Node for Python nodes"
msgstr "Anpassad kompositörsgruppsnod för Python-noder"

#. :src: bpy.types.CompositorNodeDBlur
msgid "Blur an image along a direction"
msgstr "Gör en bild oskarp längs en riktning"

#. :src: bpy.types.CompositorNodeDefocus.angle
msgid "Bokeh shape rotation offset"
msgstr "Rotationsförskjutning för bokehform"

#. :src: bpy.types.CompositorNodeDefocus.bokeh:'OCTAGON'
msgid "Octagonal"
msgstr "Åttakantig"

#. :src: bpy.types.CompositorNodeDenoise.quality
msgid "Denoising quality"
msgstr "Brusreduceringskvalitet"

#. :src: bpy.types.CompositorNodeDenoise.quality:'FAST'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'FAST'
#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality:'FAST'
msgid "High perfomance"
msgstr "Hög prestanda"

#. :src: bpy.types.CompositorNodeDiffMatte
msgid "Difference Key"
msgstr "Skillnadsnyckling"

#. :src: bpy.types.CompositorNodeDiffMatte
msgid ""
"Produce a matte that isolates foreground content by comparing it with a "
"reference background image"
msgstr ""
"Skapa en matta som isolerar förgrundsinnehåll genom att jämföra det med en "
"referensbakgrundsbild"

#. :src: bpy.types.CompositorNodeDiffMatte.falloff
#. :src: bpy.types.CompositorNodeDistanceMatte.falloff
msgid ""
"Color distances below this additional threshold are partially keyed. "
"(Deprecated: Use Falloff input instead.)"
msgstr ""
"Färgavstånd under detta extra tröskelvärde är delvis frilagda. (Föråldrad: "
"Använd Falloff-ingång i stället.)"

#. :src: bpy.types.CompositorNodeDiffMatte.tolerance
#. :src: bpy.types.CompositorNodeDistanceMatte.tolerance
msgid ""
"Color distances below this threshold are keyed. (Deprecated: Use Tolerance "
"input instead.)"
msgstr ""
"Färgavstånd under detta tröskelvärde är frilagda. (Föråldrad: Använd "
"Tolerance-ingången i stället.)"

#. :src: bpy.types.CompositorNodeDilateErode
#. :src: bpy.types.CompositorNodeKeying.dilate_distance
msgid "Dilate/Erode"
msgstr "Utvidga/erodera"

#. :src: bpy.types.CompositorNodeDisplace
msgid "Displace pixel position using an offset vector"
msgstr "Förskjut pixelpositionen med en förskjutningsvektor"

#. :src: bpy.types.CompositorNodeDistanceMatte
msgid "Distance Key"
msgstr "Avståndsnyckling"

#. :src: bpy.types.CompositorNodeDistanceMatte
msgid "Create matte based on 3D distance between colors"
msgstr "Skapa en matta baserad på 3D-avståndet mellan färgerna"

#. :src: bpy.types.CompositorNodeDoubleEdgeMask
msgid "Double Edge Mask"
msgstr "Dubbelkantmask"

#. :src: bpy.types.CompositorNodeDoubleEdgeMask.edge_mode
msgid "Buffer Edge Mode"
msgstr "Läge för buffertkant"

#. :src: bpy.types.CompositorNodeDoubleEdgeMask.edge_mode:'KEEP_IN'
msgid "Keep In"
msgstr "Håll inne"
