#. :src: bpy.types.BoneCollection.index
msgid ""
"Index of this bone collection in the armature.collections_all array. Note "
"that finding this index requires a scan of all the bone collections, so do "
"access this with care."
msgstr ""
"Index för den här bensamlingen i arrayen armature.collections_all. Observera "
"att det krävs en genomgång av alla bensamlingar för att hitta indexet, så "
"använd det med försiktighet."

#. :src: bpy.types.BoneCollection.is_editable
msgid ""
"This collection is owned by a local Armature, or was added via a library "
"override in the current blend file"
msgstr ""
"Den här samlingen ägs av en lokal armatur eller har lagts till via en "
"biblioteksåsidosättning i den aktuella blendfilen"

#. :src: bpy.types.BoneCollection.is_expanded
msgid "This bone collection is expanded in the bone collections tree view"
msgstr "Den här bensamlingen är expanderad i trädvyn för bensamlingar"

#. :src: bpy.types.BoneCollection.is_local_override
msgid "Is Local Override"
msgstr "Är en lokal åsidosättning"

#. :src: bpy.types.BoneCollection.is_local_override
msgid ""
"This collection was added via a library override in the current blend file"
msgstr ""
"Den här samlingen har lagts till via en biblioteksåsidosättning i den "
"aktuella blendfilen"

#. :src: bpy.types.BoneCollection.is_solo
msgid "Show only this bone collection, and others also marked as 'solo'"
msgstr ""
"Visa endast den här bensamlingen och andra som också är markerade som ”solo”"

#. :src: bpy.types.BoneCollection.is_visible
msgid "Bones in this collection will be visible in pose/object mode"
msgstr "Ben i den här samlingen visas i poserings- och objektläge"

#. :src: bpy.types.BoneCollection.is_visible_ancestors
msgid "Ancestors Effectively Visible"
msgstr "Överordnade samlingar är effektivt synliga"

#. :src: bpy.types.BoneCollection.is_visible_ancestors
msgid ""
"True when all of the ancestors of this bone collection are marked as "
"visible; always True for root bone collections"
msgstr ""
"Sant när alla överordnade samlingar till den här bensamlingen är markerade "
"som synliga; alltid sant för rotbensamlingar"

#. :src: bpy.types.BoneCollection.is_visible_effectively
msgid ""
"Whether this bone collection is effectively visible in the viewport. This is "
"True when this bone collection and all of its ancestors are visible, or when "
"it is marked as 'solo'."
msgstr ""
"Anger om den här bensamlingen är effektivt synlig i vyporten. Detta är sant "
"när bensamlingen och alla överordnade samlingar är synliga eller när den är "
"markerad som ”solo”."

#. :src: bpy.types.BoneCollection.parent
msgid ""
"Parent bone collection. Note that accessing this requires a scan of all the "
"bone collections to find the parent."
msgstr ""
"Överordnad bensamling. Observera att åtkomst till den kräver en genomsökning "
"av alla bensamlingar för att hitta den överordnade samlingen."

#. :src: bpy.types.BoneCollection.rigify_color_set_id
msgid "Color Set ID"
msgstr "ID för färguppsättning"

#. :src: bpy.types.BoneCollection.rigify_sel_set
msgid "Add Selection Set for this collection"
msgstr "Lägg till urvalsuppsättning för den här samlingen"

#. :src: bpy.types.BoneCollection.rigify_ui_row
msgid "UI Row"
msgstr "UI-rad"

#. :src: bpy.types.BoneCollection.rigify_ui_row
msgid ""
"If not zero, row of the UI panel where the button for this collection is "
"shown"
msgstr ""
"Om värdet inte är noll är detta raden i UI-panelen där knappen för den här "
"samlingen visas"

#. :src: bpy.types.BoneCollection.rigify_ui_title
#. :src: bpy.types.BoneCollection.rigify_ui_title_name
msgid "UI Title"
msgstr "UI-titel"

#. :src: bpy.types.BoneCollectionMemberships
msgid "Bone Collection Memberships"
msgstr "Medlemskap i bensamlingar"

#. :src: bpy.types.BoneCollections
msgid "Armature Bone Collections"
msgstr "Armaturens bensamlingar"

#. :src: bpy.types.BoneCollections
msgid "The Bone Collections of this Armature"
msgstr "Den här armaturens bensamlingar"

#. :src: bpy.types.BoneCollections.active
msgid "Armature's active bone collection"
msgstr "Armaturens aktiva bensamling"

#. :src: bpy.types.BoneCollections.active_index
msgid "Active Collection Index"
msgstr "Index för aktiv bensamling"

#. :src: bpy.types.BoneCollections.active_name
msgid "Active Collection Name"
msgstr "Namn på aktiv bensamling"

#. :src: bpy.types.BoneCollections.active_name
msgid ""
"The name of the Armature's active bone collection; empty when there is no "
"active collection"
msgstr ""
"Namnet på armaturens aktiva bensamling; tomt när ingen samling är aktiv"

#. :src: bpy.types.BoneCollections.is_solo_active
msgid "Solo Active"
msgstr "Sololäge aktivt"

#. :src: bpy.types.BoneCollections.is_solo_active
msgid ""
"Read-only flag that indicates there is at least one bone collection marked "
"as 'solo'"
msgstr ""
"Skrivskyddad flagga som anger att minst en bensamling är markerad som ”solo”"

#. :src: bpy.types.BoolAttributeValue
msgid "Bool Attribute Value"
msgstr "Booleskt attributvärde"

#. :src: bpy.types.BoolAttributeValue
msgid "Bool value in geometry attribute"
msgstr "Booleskt värde i geometriattribut"
