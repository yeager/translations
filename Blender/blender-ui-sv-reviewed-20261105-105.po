#. :src: bpy.types.GreasePencilColorModifier.use_custom_curve
#. :src: bpy.types.GreasePencilHookModifier.use_custom_curve
#. :src: bpy.types.GreasePencilNoiseModifier.use_custom_curve
#. :src: bpy.types.GreasePencilOpacityModifier.use_custom_curve
#. :src: bpy.types.GreasePencilSmoothModifier.use_custom_curve
#. :src: bpy.types.GreasePencilThickModifierData.use_custom_curve
#. :src: bpy.types.GreasePencilTintModifier.use_custom_curve
msgid "Use a custom curve to define a factor along the strokes"
msgstr "Använd en anpassad kurva för att definiera en faktor längs strecken"

#. :src: bpy.types.GreasePencilDashModifierData
msgid "Grease Pencil Dash Modifier"
msgstr "Grease Pencil-streckmodifierare"

#. :src: bpy.types.GreasePencilDashModifierData
msgid "Create dot-dash effect for strokes"
msgstr "Skapa en punktstreckseffekt för streck"

#. :src: bpy.types.GreasePencilDashModifierData.dash_offset
msgid ""
"Offset into each stroke before the beginning of the dashed segment generation"
msgstr ""
"Förskjutning i varje streck före början av genereringen av streckade segment"

#. :src: bpy.types.GreasePencilDashModifierData.segment_active_index
msgid "Active Dash Segment Index"
msgstr "Aktivt strecksegmentsindex"

#. :src: bpy.types.GreasePencilEnvelopeModifier
msgid "Grease Pencil Envelope Modifier"
msgstr "Grease Pencil-kuvertmodifierare"

#. :src: bpy.types.GreasePencilEnvelopeModifier
msgid "Envelope stroke effect modifier"
msgstr "Kuvertmodifierare för streckeffekter"

#. :src: bpy.types.GreasePencilEnvelopeModifier.mat_nr
msgid "The material to use for the new strokes"
msgstr "Material att använda för de nya strecken"

#. :src: bpy.types.GreasePencilEnvelopeModifier.mode:'DEFORM'
msgid "Deform the stroke to best match the envelope shape"
msgstr "Deformera strecket så att det bäst följer kuvertets form"

#. :src: bpy.types.GreasePencilEnvelopeModifier.strength
msgid "Multiplier for the strength of the new strokes"
msgstr "Multiplikator för styrkan hos de nya strecken"

#. :src: bpy.types.GreasePencilHookModifier
msgid "Hook modifier to modify the location of stroke points"
msgstr "Krokmodifierare som ändrar placeringen av streckpunkter"

#. :src: bpy.types.GreasePencilHookModifier.object
#. :src: bpy.types.HookModifier.object
msgid "Parent Object for hook, also recalculates and clears offset"
msgstr ""
"Överordnat objekt för kroken; beräknar också om och rensar förskjutningen"

#. :src: bpy.types.GreasePencilHookModifier.subtarget
#. :src: bpy.types.HookModifier.subtarget
msgid ""
"Name of Parent Bone for hook (if applicable), also recalculates and clears "
"offset"
msgstr ""
"Namn på överordnat ben för kroken (om tillämpligt); beräknar också om och "
"rensar förskjutningen"

#. :src: bpy.types.GreasePencilLatticeModifier.strength
#. :src: bpy.types.LatticeModifier.strength
#. :src: bpy.types.SmoothModifier.factor
msgid "Strength of modifier effect"
msgstr "Modifierareffektens styrka"

#. :src: bpy.types.GreasePencilLengthModifier.end_factor
msgid "Added length to the end of each stroke relative to its length"
msgstr "Tilläggslängd vid slutet av varje streck i förhållande till dess längd"

#. :src: bpy.types.GreasePencilLengthModifier.end_length
msgid "Absolute added length to the end of each stroke"
msgstr "Absolut tilläggslängd vid slutet av varje streck"

#. :src: bpy.types.GreasePencilLengthModifier.invert_curvature
msgid "Invert the curvature of the stroke's extension"
msgstr "Invertera krökningen för streckets förlängning"

#. :src: bpy.types.GreasePencilLengthModifier.max_angle
msgid ""
"Ignore points on the stroke that deviate from their neighbors by more than "
"this angle when determining the extrapolation shape"
msgstr ""
"Ignorera punkter på strecket som avviker från sina grannar med mer än denna "
"vinkel när extrapolationsformen bestäms"

#. :src: bpy.types.GreasePencilLengthModifier.mode:'RELATIVE'
msgid "Length in ratio to the stroke's length"
msgstr "Längd i förhållande till streckets längd"

#. :src: bpy.types.GreasePencilLengthModifier.overshoot_factor
msgid ""
"Defines what portion of the stroke is used for the calculation of the "
"extension"
msgstr ""
"Anger vilken del av strecket som används för beräkningen av förlängningen"

#. :src: bpy.types.GreasePencilLengthModifier.point_density
msgid "Multiplied by Start/End for the total added point count"
msgstr "Multiplicerat med Start/slut för det totala antalet tillagda punkter"

#. :src: bpy.types.GreasePencilLengthModifier.random_end_factor
msgid "Size of random length added to the end of each stroke"
msgstr "Storlek på slumpmässig längd som läggs till i slutet av varje streck"

#. :src: bpy.types.GreasePencilLengthModifier.random_offset
msgid "Smoothly offset each stroke's random value"
msgstr "Förskjut varje strecks slumpvärde mjukt"

#. :src: bpy.types.GreasePencilLengthModifier.start_factor
msgid "Added length to the start of each stroke relative to its length"
msgstr "Tilläggslängd i början av varje streck i förhållande till dess längd"

#. :src: bpy.types.GreasePencilLengthModifier.start_length
msgid "Absolute added length to the start of each stroke"
msgstr "Absolut tilläggslängd i början av varje streck"

#. :src: bpy.types.GreasePencilLengthModifier.step
#. :src: bpy.types.GreasePencilNoiseModifier.step
msgid "Number of frames between randomization steps"
msgstr "Antal bildrutor mellan slumpningsstegen"
