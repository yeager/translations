#. :src: bpy.types.MovieClipUser.proxy_render_size:'FULL'
msgid "None, full render"
msgstr "Ingen, full rendering"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled
msgid "Physically-based, easy-to-use shader for rendering hair and fur"
msgstr "Fysikbaserad, lättanvänd skuggning för rendering av hår och päls"

#. :src: bpy.types.ShaderNodeBsdfPrincipled
msgid ""
"Physically-based, easy-to-use shader for rendering surface materials, based "
"on the OpenPBR model"
msgstr ""
"Fysikbaserad, lättanvänd skuggning för rendering av ytmaterial baserad på "
"OpenPBR-modellen"

#. :src: bpy.types.ShaderNodeOutputMaterial
msgid "Output surface material information for use in rendering"
msgstr "Mata ut information om ytmaterial för rendering"

#. :src: bpy.types.ShaderNodeShaderToRGB
msgid ""
"Convert rendering effect (such as light and shadow) to color. Typically used for non-photorealistic rendering, to apply additional effects on the output of BSDFs.\n"
"Note: only supported in EEVEE"
msgstr ""
"Konvertera renderingseffekter (som ljus och skugga) till färg. Används vanligen för icke-fotorealistisk rendering, för att tillämpa ytterligare effekter på utdata från BSDF:er.\n"
"Obs! Stöds bara i EEVEE"

#. :src: bpy.types.USERPREF_PT_interface_text
msgid "Text Rendering"
msgstr "Textrendering"

#. :src: bpy.types.ScriptDirectory.directory
msgid ""
"Alternate script path, matching the default layout with sub-directories: "
"startup, add-ons, modules, and presets (requires restart)"
msgstr ""
"Alternativ skriptväg som följer standardlayouten med underkatalogerna: "
"startup, add-ons, modules och presets (kräver omstart)"

#. :src: bpy.types.CyclesPreferences.kernel_optimization_level:'OFF'
msgid ""
"Disable kernel optimization. Slowest rendering, no extra background CPU "
"usage"
msgstr ""
"Inaktivera kärnoptimering. Långsammast rendering, ingen extra CPU-användning"
" i bakgrunden"

#. :src: bpy.types.CyclesPreferences.kernel_optimization_level:'FULL'
msgid ""
"Optimize all kernels. Fastest rendering, may result in extra background CPU "
"usage"
msgstr ""
"Optimera alla kärnor. Snabbast rendering, kan medföra extra CPU-användning i"
" bakgrunden"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:47
msgid "Minimum coordinate in X axis (grid index space)"
msgstr "Minsta koordinat längs X-axeln (rutnätsindexrymden)"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:50
msgid "Minimum coordinate in Y axis (grid index space)"
msgstr "Minsta koordinat längs Y-axeln (rutnätsindexrymden)"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:53
msgid "Minimum coordinate in Z axis (grid index space)"
msgstr "Minsta koordinat längs Z-axeln (rutnätsindexrymden)"

#: source/blender/nodes/geometry/nodes/node_geo_grid_to_points.cc:51
#: source/blender/nodes/geometry/nodes/node_geo_input_voxel_index.cc:16
msgid ""
"X coordinate of the voxel in index space, or the minimum X coordinate of a "
"tile"
msgstr ""
"X-koordinaten för voxeln i indexrymden, eller den minsta X-koordinaten för "
"en ruta"

#: source/blender/nodes/geometry/nodes/node_geo_grid_to_points.cc:53
#: source/blender/nodes/geometry/nodes/node_geo_input_voxel_index.cc:20
msgid ""
"Y coordinate of the voxel in index space, or the minimum Y coordinate of a "
"tile"
msgstr ""
"Y-koordinaten för voxeln i indexrymden, eller den minsta Y-koordinaten för "
"en ruta"

#: source/blender/nodes/geometry/nodes/node_geo_grid_to_points.cc:55
#: source/blender/nodes/geometry/nodes/node_geo_input_voxel_index.cc:24
msgid ""
"Z coordinate of the voxel in index space, or the minimum Z coordinate of a "
"tile"
msgstr ""
"Z-koordinaten för voxeln i indexrymden, eller den minsta Z-koordinaten för "
"en ruta"

#. :src: bpy.types.KeyMap.is_modal
msgid ""
"Indicates that a keymap is used for translate modal events for an operator"
msgstr ""
"Anger att en tangentmappning används för att översätta modala händelser för "
"en operator"

#. :src: bpy.types.SpaceNodeEditor.show_backdrop
msgid "Use active Viewer Node output as backdrop for compositing nodes"
msgstr ""
"Använd utdatan från den aktiva visningsnoden som bakgrund för "
"kompositeringsnoder"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:26
msgid "Minimum boundary of the grid (world space)"
msgstr "Rutnätets minsta gräns (världsrymden)"

#: source/blender/nodes/geometry/nodes/node_geo_cube_grid_topology.cc:29
msgid "Maximum boundary of the grid (world space)"
msgstr "Rutnätets största gräns (världsrymden)"

#. :src: bpy.types.ShaderNodeTexImage.projection:'BOX'
msgid ""
"Image is projected using different components for each side of the object "
"space bounding box"
msgstr ""
"Bilden projiceras med olika komponenter för varje sida i objektrymdens "
"begränsningsruta"
