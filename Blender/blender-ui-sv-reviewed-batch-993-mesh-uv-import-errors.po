#: source/blender/editors/sculpt_paint/curves/sculpt_ops.cc:1062
msgid "Cursor must be over the surface mesh"
msgstr "Markören måste vara över ytmeshen"

#: source/blender/editors/sculpt_paint/mesh/sculpt_detail.cc:372
msgid "Click on the mesh to set the detail"
msgstr "Klicka på meshen för att ställa in detaljnivån"

#: source/blender/editors/uvedit/uvedit_unwrap_ops.cc:2887
msgid "Object has non-uniform scale, unwrap will operate on a non-scaled version of the mesh"
msgstr "Objektet har icke-enhetlig skala; uppackning fungerar på en oskalad version av meshen"

#: source/blender/editors/uvedit/uvedit_unwrap_ops.cc:2896
msgid "Object has negative scale, unwrap will operate on a non-flipped version of the mesh"
msgstr "Objektet har negativ skala; uppackning fungerar på en ovänd version av meshen"

#: source/blender/geometry/intern/realize_instances.cc:2021
msgid "Realized mesh has too many elements."
msgstr "Den realiserade meshen har för många element."

#: source/blender/io/alembic/intern/abc_reader_mesh.cc:599
msgid "Topology has changed, perhaps by triangulating the mesh. Only vertices will be read!"
msgstr "Topologin har ändrats, kanske genom triangulering av meshen. Endast hörnpunkter kommer att läsas!"

#: source/blender/io/stl/importer/stl_import.cc:92
msgid "STL Import: Failed to import mesh from file '%s'"
msgstr "STL-import: Det gick inte att importera meshen från filen ”%s”"

#: source/blender/io/usd/intern/usd_reader_mesh.cc:342
msgid "Invalid face data detected for mesh '%s'. Automatic correction will be used, but some data will most likely be lost"
msgstr "Ogiltiga ytdata upptäcktes för meshen ”%s”. Automatisk korrigering används, men vissa data kommer sannolikt att gå förlorade"
