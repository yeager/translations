#. :src: bpy.types.RigidBodyObject.mesh_source:'BASE'
msgid "Base mesh"
msgstr "Basmesh"

#. :src: bpy.types.OBJECT_OT_multires_base_apply
msgid "Modify the base mesh to conform to the displaced mesh"
msgstr ""
"Modifiera basmeshen så att den överensstämmer med den förskjutna meshen"

#. :src: bpy.types.OBJECT_OT_multires_unsubdivide
msgid "Rebuild a lower subdivision level of the current base mesh"
msgstr "Återuppbygg en lägre underindelningsnivå av den aktuella basmeshen"

#. :src: bpy.types.OBJECT_OT_multires_rebuild_subdiv
msgid ""
"Rebuilds all possible subdivisions levels to generate a lower resolution "
"base mesh"
msgstr ""
"Återuppbygg alla möjliga underindelningsnivåer för att generera en basmesh "
"med lägre upplösning"

#. :src: bpy.types.WM_OT_usd_export.export_subdivision:'IGNORE'
msgid "Scheme = None. Export base mesh without subdivision"
msgstr "Schema = Inget. Exportera basmesh utan underindelning"

#. :src: bpy.types.OBJECT_OT_multires_base_apply.apply_heuristic
msgid ""
"Whether or not the final base mesh positions will be slightly altered to "
"account for a new subdivision modifier being added"
msgstr ""
"Huruvida de slutliga basmeshpositionerna ändras något för att ta hänsyn till "
"att en ny underindelningsmodifierare läggs till"
