msgid "Clamp"
msgstr "Begränsa"

#. :src: bpy.types.Brush.hardness
msgid "How close the brush falloff starts from the edge of the brush"
msgstr "Hur nära penselns kant avtagandet börjar"

#. :src: bpy.types.Brush.has_unsaved_changes
msgid ""
"Indicates that there are any user visible changes since the brush has been "
"imported or read from the file"
msgstr ""
"Anger om det finns synliga ändringar för användaren sedan penseln "
"importerades eller lästes in från filen"

#. :src: bpy.types.Brush.invert_density_pressure
msgid "Invert the modulation of pressure in density"
msgstr "Invertera tryckmoduleringen för densitet"

#. :src: bpy.types.Brush.invert_flow_pressure
msgid "Invert the modulation of pressure in flow"
msgstr "Invertera tryckmoduleringen för flöde"

#. :src: bpy.types.Brush.invert_hardness_pressure
msgid "Invert the modulation of pressure in hardness"
msgstr "Invertera tryckmoduleringen för hårdhet"

#. :src: bpy.types.Brush.invert_wet_mix_pressure
msgid "Invert Pressure for Wet Mix"
msgstr "Invertera tryck för våtblandning"

#. :src: bpy.types.Brush.invert_wet_mix_pressure
msgid "Invert the modulation of pressure in wet mix"
msgstr "Invertera tryckmoduleringen för våtblandning"

#. :src: bpy.types.Brush.invert_wet_persistence_pressure
msgid "Invert Pressure for Wet Persistence"
msgstr "Invertera tryck för våt beständighet"

#. :src: bpy.types.Brush.invert_wet_persistence_pressure
msgid "Invert the modulation of pressure in wet persistence"
msgstr "Invertera tryckmoduleringen för våt beständighet"

#. :src: bpy.types.Brush.jitter
msgid "Jitter the position of the brush while painting"
msgstr "Variera penselns position vid målning"

#. :src: bpy.types.Brush.jitter_absolute
msgid "Jitter the position of the brush in pixels while painting"
msgstr "Variera penselns position i pixlar vid målning"

#. :src: bpy.types.Brush.jitter_unit
msgid "Jitter Unit"
msgstr "Variationsenhet"

#. :src: bpy.types.Brush.jitter_unit
msgid "Jitter in screen space or relative to brush size"
msgstr "Variation i skärmutrymmet eller i förhållande till penselstorleken"

#. :src: bpy.types.Brush.jitter_unit:'VIEW'
msgid "Jittering happens in screen space, in pixels"
msgstr "Variationen sker i skärmutrymmet, i pixlar"

#. :src: bpy.types.Brush.jitter_unit:'BRUSH'
msgid "Jittering happens relative to the brush size"
msgstr "Variationen sker relativt penselstorleken"

#. :src: bpy.types.Brush.mask_stencil_dimension
msgid "Mask Stencil Dimensions"
msgstr "Mått för maskschablon"

#. :src: bpy.types.Brush.mask_stencil_dimension
msgid "Dimensions of mask stencil in viewport"
msgstr "Mått på maskschablonen i visningsområdet"

#. :src: bpy.types.Brush.mask_stencil_pos
msgid "Mask Stencil Position"
msgstr "Position för maskschablon"

#. :src: bpy.types.Brush.mask_stencil_pos
msgid "Position of mask stencil in viewport"
msgstr "Position för maskschablonen i visningsområdet"
