#. :src: bpy.types.AnnotationStrokePoints
msgid "Annotation Stroke Points"
msgstr "Punkter i anteckningsstreck"

#. :src: bpy.types.AnnotationStrokePoints
msgid "Collection of annotation stroke points"
msgstr "Samling av punkter i anteckningsstreck"

#. :src: bpy.types.AnnotationStrokes
msgid "Annotation Strokes"
msgstr "Anteckningsstreck"

#. :src: bpy.types.AnnotationStrokes
msgid "Collection of annotation strokes"
msgstr "Samling av anteckningsstreck"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'FILL'
msgid "Painting affects only fills, not strokes"
msgstr "Målning påverkar endast fyllningar, inte streck"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'BOTH'
msgid "Painting affects both strokes and fills"
msgstr "Målning påverkar både streck och fyllningar"

#. :src: bpy.types.Brush.gpencil_brush_type:'ERASE'
msgid "The brush is used for erasing strokes"
msgstr "Penseln används för att radera streck"

#. :src: bpy.types.Brush.gpencil_sculpt_brush_type:'THICKNESS'
msgid "Adjust thickness of strokes"
msgstr "Justera streckens tjocklek"

#. :src: bpy.types.Brush.gpencil_sculpt_brush_type:'STRENGTH'
msgid "Adjust color strength of strokes"
msgstr "Justera streckens färgstyrka"

#. :src: bpy.types.Brush.gpencil_sculpt_brush_type:'CLONE'
msgid "Paste copies of the strokes stored on the internal clipboard"
msgstr "Klistra in kopior av strecken som lagras i det interna urklippet"
