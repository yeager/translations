#. :src: Asset name from file procedural_hair_node_assets.blend
#: scripts/startup/bl_operators/object_quick_effects.py:171
msgid "Interpolate Hair Curves"
msgstr "Interpolera hårkurvor"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Interpolates existing guide curves on a surface mesh"
msgstr "Interpolerar befintliga guidekurvor på en meshyta"

#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Index of the main guide curve per curve"
msgstr "Index för huvudguidekurva per kurva"

#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Follow Surface Normal"
msgstr "Följ ytnormal"

#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Align the interpolated curves to the surface normal"
msgstr "Rikta in de interpolerade kurvorna mot ytnormalen"

#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Part by Mesh Islands"
msgstr "Dela efter meshöar"

#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Use mesh islands of the surface geometry for parting"
msgstr "Använd ytgeometrins meshöar för uppdelning"

#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Interpolation Guides"
msgstr "Guidekurvor för interpolering"

#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Amount of guides to be used for interpolation per curve"
msgstr "Antal guidekurvor som ska användas för interpolering per kurva"

#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Distance to Guides"
msgstr "Avstånd till guidekurvor"

#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Distance around each guide to spawn interpolated curves"
msgstr "Avstånd runt varje guidekurva för att skapa interpolerade kurvor"
