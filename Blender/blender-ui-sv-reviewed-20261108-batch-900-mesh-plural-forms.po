#. :src: bpy.types.BakeSettings.target:'VERTEX_COLORS'
#. :src: bpy.types.OBJECT_OT_bake.target:'VERTEX_COLORS'
msgid "Bake to the active color attribute on meshes"
msgstr "Baka till det aktiva färgattributet på meshar"

#. :src: bpy.types.BlendDataMeshes
msgid "Collection of meshes"
msgstr "Samling av meshar"

#. :src: bpy.types.FileSelectIDFilter.category_geometry
msgid "Show meshes, curves, lattice, armatures and metaballs data"
msgstr "Visa data för meshar, kurvor, gitter, armaturer och metabollar"

#. :src: bpy.types.GeometryNodeTree.is_type_mesh
msgid "The node group is used for meshes"
msgstr "Nodgruppen används för meshar"

#. :src: bpy.types.MeshVertex.undeformed_co
msgid ""
"For meshes with modifiers applied, the coordinate of the vertex with no "
"deforming modifiers applied, as used for generated texture coordinates"
msgstr ""
"För meshar med tillämpade modifierare: koordinaten för hörnpunkten utan "
"deformerande modifierare, som används för genererade texturkoordinater"

#. :src: bpy.types.BooleanModifier.operation:'UNION'
#. :src: bpy.types.GeometryNodeMeshBoolean.operation:'UNION'
msgid "Combine meshes in an additive way"
msgstr "Kombinera meshar på ett additivt sätt"

#. :src: bpy.types.BooleanModifier.operation:'DIFFERENCE'
#. :src: bpy.types.GeometryNodeMeshBoolean.operation:'DIFFERENCE'
msgid "Combine meshes in a subtractive way"
msgstr "Kombinera meshar på ett subtraktivt sätt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gn_mesh
msgid "Export Geometry nodes instance meshes"
msgstr "Exportera instansmeshar från geometrinoder"

#: source/blender/blenkernel/intern/mesh.cc:514
msgid "meshes"
msgstr "Meshar"
