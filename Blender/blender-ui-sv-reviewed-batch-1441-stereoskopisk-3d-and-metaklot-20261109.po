#. :src: bpy.types.WM_OT_set_stereo_3d
msgctxt "Operator"
msgid "Set Stereo 3D"
msgstr "Ställ in stereoskopisk 3D"

#. :src: bpy.types.WM_OT_set_stereo_3d
msgid ""
"Toggle 3D stereo support for current window (or change the display mode)"
msgstr ""
"Växla stöd för stereoskopisk 3D för aktuellt fönster (eller ändra "
"visningsläget)"

#. :src: bpy.types.SpaceView3D.show_stereo_3d_convergence_plane
msgid "Show the stereo 3D convergence plane"
msgstr "Visa konvergensplanet för stereoskopisk 3D"

#. :src: bpy.types.SpaceView3D.show_stereo_3d_volume
msgid "Show the stereo 3D frustum volume"
msgstr "Visa frustumvolymen för stereoskopisk 3D"

#. :src: bpy.types.Stereo3dDisplay
#. :src: bpy.types.Window.stereo_3d_display
msgid "Stereo 3D Display"
msgstr "Stereoskopisk 3D-visning"

#. :src: bpy.types.Stereo3dDisplay
#. :src: bpy.types.Window.stereo_3d_display
msgid "Settings for stereo 3D display"
msgstr "Inställningar för stereoskopisk 3D-visning"

#: source/blender/makesrna/intern/rna_meta.cc:128
msgid "Metaball '%s' does not contain spline given"
msgstr "Metaklot ”%s” innehåller inte den angivna splinen"

#: source/blender/windowmanager/intern/wm_stereo.cc:352
msgid "Set Stereo 3D"
msgstr "Ställ in stereoskopisk 3D"

#: source/blender/windowmanager/intern/wm_stereo.cc:323
msgid "Stereo 3D Mode requires the window to be fullscreen"
msgstr "Stereoskopiskt 3D-läge kräver att fönstret är i helskärmsläge"
