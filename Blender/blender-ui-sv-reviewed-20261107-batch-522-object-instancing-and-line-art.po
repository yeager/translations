#. :src: bpy.types.Object.instance_faces_scale
msgid "Instance Faces Scale"
msgstr "Skala för instansytor"

#. :src: bpy.types.Object.instance_faces_scale
msgid "Scale the face instance objects"
msgstr "Skala objekten i ytinstansen"

#. :src: bpy.types.Object.is_shadow_catcher
#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_shadow_catcher
#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'SHADOW_CATCHER'
msgid "Shadow Catcher"
msgstr "Skuggfångare"

#. :src: bpy.types.Object.is_shadow_catcher
msgid ""
"Only render shadows and reflections on this object, for compositing renders "
"into real footage. Objects with this setting are considered to already exist "
"in the footage, objects without it are synthetic objects being composited "
"into it."
msgstr ""
"Rendera endast skuggor och reflektioner på detta objekt för att kompositera "
"renderingar med verkligt bildmaterial. Objekt med inställningen anses redan "
"finnas i bildmaterialet; objekt utan den är syntetiska och kompositeras in i "
"det."

#. :src: bpy.types.Object.light_linking
msgid "Light linking settings"
msgstr "Inställningar för ljuslänkning"

#. :src: bpy.types.Object.lineart
#. :src: bpy.types.Modifier.type:'LINEART'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'LINEART'
#. :src: bpy.types.COLLECTION_PT_lineart_collection
#. :src: bpy.types.MATERIAL_PT_lineart
#. :src: bpy.types.OBJECT_PT_lineart
msgid "Line Art"
msgstr "Linjeteckning"

#. :src: bpy.types.Object.lineart
msgid "Line Art settings for the object"
msgstr "Inställningar för linjeteckning för objektet"

#. :src: bpy.types.Object.lock_rotation_w
#. :src: bpy.types.PoseBone.lock_rotation_w
msgid ""
"Lock editing of 'angle' component of four-component rotations when "
"transforming"
msgstr ""
"Lås redigering av \"vinkel\"-komponenten i fyrakomponentsrotationer vid "
"transformering"

#. :src: bpy.types.Object.lock_rotations_4d
#. :src: bpy.types.PoseBone.lock_rotations_4d
msgid ""
"Lock editing of four component rotations by components (instead of as Eulers)"
msgstr ""
"Lås redigering av fyrakomponentsrotationer komponentvis (i stället för som "
"Eulerrotationer)"

#. :src: bpy.types.Object.material_slots
msgid "Material Slots"
msgstr "Materialplatser"

#. :src: bpy.types.Object.material_slots
msgid "Material slots in the object"
msgstr "Materialplatser i objektet"
