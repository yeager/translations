#. :src: bpy.types.Curve
msgid "Curve data-block storing curves, splines and NURBS"
msgstr "Kurvdatablock som lagrar kurvor, splines och NURBS"

#. :src: bpy.types.Curve.bevel_depth
msgid "Bevel Depth"
msgstr "Avfasningsdjup"

#. :src: bpy.types.Curve.bevel_depth
msgid "Radius of the bevel geometry, not including extrusion"
msgstr "Avfasningsgeometrins radie, exklusive extrudering"

#. :src: bpy.types.Curve.bevel_factor_end
msgid "Geometry End Factor"
msgstr "Geometrins slutfaktor"

#. :src: bpy.types.Curve.bevel_factor_end
msgid ""
"Define where along the spline the curve geometry ends (0 for the beginning, "
"1 for the end)"
msgstr ""
"Definiera var längs kurvsplinen geometrin slutar (0 för början, 1 för slutet)"

#. :src: bpy.types.Curve.bevel_factor_mapping_end
msgid "End Mapping Type"
msgstr "Mappningstyp för slutet"

#. :src: bpy.types.Curve.bevel_factor_mapping_end
msgid "Determine how the geometry end factor is mapped to a spline"
msgstr "Bestäm hur geometrins slutfaktor ska mappas till en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_mapping_end:'RESOLUTION'
#. :src: bpy.types.Curve.bevel_factor_mapping_start:'RESOLUTION'
msgid ""
"Map the geometry factor to the number of subdivisions of a spline (U "
"resolution)"
msgstr ""
"Mappa geometrifaktorn till antalet underindelningar i en kurvspline (U-"
"upplösning)"

#. :src: bpy.types.Curve.bevel_factor_mapping_end:'SEGMENTS'
#. :src: bpy.types.Curve.bevel_factor_mapping_start:'SEGMENTS'
msgid ""
"Map the geometry factor to the length of a segment and to the number of "
"subdivisions of a segment"
msgstr ""
"Mappa geometrifaktorn till längden på ett segment och till antalet "
"underindelningar av ett segment"

#. :src: bpy.types.Curve.bevel_factor_mapping_end:'SPLINE'
#. :src: bpy.types.Curve.bevel_factor_mapping_start:'SPLINE'
msgid "Map the geometry factor to the length of a spline"
msgstr "Mappa geometrifaktorn till längden på en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_mapping_start
msgid "Start Mapping Type"
msgstr "Mappningstyp för början"

#. :src: bpy.types.Curve.bevel_factor_mapping_start
msgid "Determine how the geometry start factor is mapped to a spline"
msgstr "Bestäm hur geometrins startfaktor ska mappas till en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_start
msgid "Geometry Start Factor"
msgstr "Geometrins startfaktor"

#. :src: bpy.types.Curve.bevel_factor_start
msgid ""
"Define where along the spline the curve geometry starts (0 for the "
"beginning, 1 for the end)"
msgstr ""
"Definiera var längs kurvsplinen geometrin börjar (0 för början, 1 för slutet)"

#. :src: bpy.types.Curve.bevel_mode
msgid "Bevel Mode"
msgstr "Avfasningsläge"

#. :src: bpy.types.Curve.bevel_mode
msgid "Determine how to build the curve's bevel geometry"
msgstr "Bestäm hur du ska bygga kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_mode:'ROUND'
#. :src: bpy.types.FreestyleLineStyle.caps:'ROUND'
msgid "Round"
msgstr "Rund"

#. :src: bpy.types.Curve.bevel_mode:'ROUND'
msgid "Use circle for the section of the curve's bevel geometry"
msgstr "Använd en cirkel som tvärsnitt för kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_mode:'OBJECT'
msgid "Use an object for the section of the curve's bevel geometry segment"
msgstr "Använd ett objekt som tvärsnitt för kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_mode:'PROFILE'
msgid "Use a custom profile for each quarter of curve's bevel geometry"
msgstr ""
"Använd en anpassad profil för varje fjärdedel av kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_object
msgid "Bevel Object"
msgstr "Avfasningsobjekt"

#. :src: bpy.types.Curve.bevel_object
msgid "The name of the Curve object that defines the bevel shape"
msgstr "Namnet på det kurvobjekt som definierar avfasningsformen"

#. :src: bpy.types.Curve.bevel_profile
#. :src: bpy.types.BevelModifier.custom_profile
msgid "Custom Profile Path"
msgstr "Anpassad profilsökväg"

#. :src: bpy.types.Curve.bevel_profile
msgid "The path for the curve's custom profile"
msgstr "Sökvägen till kurvans anpassade profil"

#. :src: bpy.types.Curve.bevel_resolution
msgid "Bevel Resolution"
msgstr "Avfasningsupplösning"

#. :src: bpy.types.Curve.bevel_resolution
msgid "The number of segments in each quarter-circle of the bevel"
msgstr "Antalet segment i varje kvartscirkel i avfasningen"
