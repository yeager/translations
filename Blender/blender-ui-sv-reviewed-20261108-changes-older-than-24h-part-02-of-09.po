msgstr "Linjefärg som används för Freestyle-linjerendering"

#. :src: bpy.types.Material.line_priority
msgid "Line Priority"
msgstr "Linjeprioritet"

#. :src: bpy.types.Material.line_priority
msgid "The line color of a higher priority is used at material boundaries"
msgstr "Linjefärgen med högre prioritet används vid materialgränser"

#. :src: bpy.types.Material.lineart
msgid "Line Art Settings"
msgstr "Inställningar för linjeteckning"

#. :src: bpy.types.Material.lineart
msgid "Line Art settings for material"
msgstr "Inställningar för linjeteckning för material"

#. :src: bpy.types.Material.max_vertex_displacement
msgid "Max Vertex Displacement"
msgstr "Maximal hörnpunktsförskjutning"

#. :src: bpy.types.Material.max_vertex_displacement
msgid ""
"The max distance a vertex can be displaced. Displacements over this "
"threshold may cause visibility issues."
msgstr ""
"Det maximala avstånd som en hörnpunkt kan förskjutas. Förskjutningar över "
"detta tröskelvärde kan orsaka synlighetsproblem."

#. :src: bpy.types.Material
msgid ""
"Material data-block to define the appearance of geometric objects for "
"rendering"
msgstr ""
"Materialdatablock som bestämmer hur geometriska objekt ser ut vid rendering"

#. :src: bpy.types.Material.alpha_threshold
msgid "Clip Threshold"
msgstr "Klipptröskel"

#. :src: bpy.types.Material.alpha_threshold
msgid "A pixel is rendered only if its alpha value is above this threshold"
msgstr ""
"En pixel återges endast om dess alfavärde ligger över denna klipptröskel"

#. :src: bpy.types.Material.blend_method
msgctxt "Material"
msgid "Blend Mode"
msgstr "Blandningsläge"

#. :src: bpy.types.Material.blend_method
msgid ""
"Blend Mode for Transparent Faces (Deprecated: use 'surface_render_method')"
msgstr ""
"Blandningsläge för genomskinliga ytor (föråldrad: använd "
"'surface_render_method')"

#. :src: bpy.types.Material.blend_method:'OPAQUE'
msgctxt "Material"
msgid "Opaque"
msgstr "Ogenomskinlig"

#. :src: bpy.types.Material.blend_method:'OPAQUE'
