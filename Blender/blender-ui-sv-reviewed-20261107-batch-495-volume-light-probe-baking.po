#. :src: bpy.types.LightProbeVolume
msgid "Volume Probe"
msgstr "Volymljussond"

#. :src: bpy.types.LightProbeVolume.bake_samples
msgid "Bake Samples"
msgstr "Bakningsprov"

#. :src: bpy.types.LightProbeVolume.bake_samples
msgid "Number of ray directions to evaluate when baking"
msgstr "Antal strålriktningar att utvärdera vid bakning"

#. :src: bpy.types.LightProbeVolume.capture_distance
msgid "Capture Distance"
msgstr "Fångstavstånd"

#. :src: bpy.types.LightProbeVolume.capture_distance
msgid ""
"Distance around the probe volume that will be considered during the bake"
msgstr "Avstånd runt sondvolymen som kommer att beaktas under bakningen"

#. :src: bpy.types.LightProbeVolume.capture_emission
msgid "Capture Emission"
msgstr "Fånga emission"

#. :src: bpy.types.LightProbeVolume.capture_emission
msgid "Bake emissive surfaces for more accurate lighting"
msgstr "Baka emitterande ytor för mer exakt belysning"

#. :src: bpy.types.LightProbeVolume.capture_indirect
msgid "Capture Indirect"
msgstr "Fånga indirekt ljus"

#. :src: bpy.types.LightProbeVolume.capture_indirect
msgid "Bake light bounces from light sources for more accurate lighting"
msgstr "Baka ljusstudsar från ljuskällor för mer exakt belysning"

#. :src: bpy.types.LightProbeVolume.capture_world
msgid "Capture World"
msgstr "Fånga omvärldsljus"

#. :src: bpy.types.LightProbeVolume.capture_world
msgid ""
"Bake incoming light from the world instead of just the visibility for more "
"accurate lighting, but lose correct blending to surrounding irradiance "
"volumes"
msgstr ""
"Baka inkommande ljus från omvärlden i stället för enbart synlighet för mer "
"exakt belysning, men korrekt blandning med omgivande irradiansvolymer går "
"förlorad"

#. :src: bpy.types.LightProbeVolume.clamp_direct
#. :src: bpy.types.CyclesRenderSettings.sample_clamp_direct
msgid "Clamp Direct"
msgstr "Begränsa direktljus"

#. :src: bpy.types.LightProbeVolume.clamp_direct
msgid "Clamp the direct lighting intensity to reduce noise (0 to disable)"
msgstr ""
"Begränsa direktljusets intensitet för att minska brus (0 för att inaktivera)"

#. :src: bpy.types.LightProbeVolume.clamp_indirect
#. :src: bpy.types.CyclesRenderSettings.sample_clamp_indirect
msgid "Clamp Indirect"
msgstr "Begränsa indirekt ljus"

#. :src: bpy.types.LightProbeVolume.clamp_indirect
msgid "Clamp the indirect lighting intensity to reduce noise (0 to disable)"
msgstr ""
"Begränsa det indirekta ljusets intensitet för att minska brus (0 för att "
"inaktivera)"

#. :src: bpy.types.LightProbeVolume.dilation_radius
msgid "Dilation Radius"
msgstr "Utvidgningsradie"

#. :src: bpy.types.LightProbeVolume.dilation_radius
msgid ""
"Radius in grid sample to search valid grid samples to copy into invalid grid "
"samples"
msgstr ""
"Radie inom rutnätsprovet för att söka efter giltiga rutnätsprov att kopiera "
"till ogiltiga rutnätsprov"

#. :src: bpy.types.LightProbeVolume.dilation_threshold
msgid "Dilation Threshold"
msgstr "Utvidgningströskel"

#. :src: bpy.types.LightProbeVolume.dilation_threshold
msgid ""
"Ratio of front-facing surface hits under which a grid sample will reuse "
"neighbors grid sample lighting"
msgstr ""
"Förhållande mellan träffar på framåtvända ytor under vilket ett rutnätsprov "
"återanvänder belysningen från angränsande rutnätsprov"

#. :src: bpy.types.LightProbeVolume.escape_bias
msgid "Search Distance"
msgstr "Sökavstånd"

#. :src: bpy.types.LightProbeVolume.escape_bias
msgid ""
"Distance to search for valid capture positions to prevent lighting artifacts"
msgstr ""
"Avstånd för att söka efter giltiga fångstpositioner och undvika "
"ljusartefakter"

#. :src: bpy.types.LightProbeVolume.facing_bias
msgid "Facing Bias"
msgstr "Riktningsförskjutning"

#. :src: bpy.types.LightProbeVolume.facing_bias
msgid "Smoother irradiance interpolation but introduce light bleeding"
msgstr "Ger jämnare interpolering av irradians, men kan orsaka ljusläckage"

#. :src: bpy.types.LightProbeVolume.intensity
msgid "Modify the intensity of the lighting captured by this probe"
msgstr "Ändra intensiteten hos belysningen som fångas av denna ljussond"

#. :src: bpy.types.LightProbeVolume.normal_bias
msgid "Normal Bias"
msgstr "Normalförskjutning"

#. :src: bpy.types.LightProbeVolume.normal_bias
msgid ""
"Offset sampling of the irradiance grid in the surface normal direction to "
"reduce light bleeding"
msgstr ""
"Förskjut provtagningen av irradiansgallret i ytans normalriktning för att "
"minska ljusläckage"

#. :src: bpy.types.LightProbeVolume.resolution_x
msgid "Number of samples along the x axis of the volume"
msgstr "Antal prov längs volymens x-axel"

#. :src: bpy.types.LightProbeVolume.resolution_y
msgid "Number of samples along the y axis of the volume"
msgstr "Antal prov längs volymens y-axel"

#. :src: bpy.types.LightProbeVolume.resolution_z
#: source/blender/nodes/geometry/nodes/node_geo_volume_cube.cc:45
msgid "Resolution Z"
msgstr "Upplösning Z"

#. :src: bpy.types.LightProbeVolume.resolution_z
msgid "Number of samples along the z axis of the volume"
msgstr "Antal prov längs volymens z-axel"

#. :src: bpy.types.LightProbeVolume.surface_bias
#. :src: bpy.types.GREASE_PENCIL_OT_reproject.offset
#. :src: bpy.types.ToolSettings.gpencil_surface_offset
msgid "Surface Offset"
msgstr "Ytförskjutning"

#. :src: bpy.types.LightProbeVolume.surface_bias
msgid "Moves capture points away from surfaces to prevent artifacts"
msgstr "Flyttar fångstpunkterna bort från ytor för att förhindra artefakter"

#. :src: bpy.types.LightProbeVolume.surfel_density
msgid "Surfel Resolution"
msgstr "Surfelupplösning"

#. :src: bpy.types.LightProbeVolume.surfel_density
msgid ""
"Number of surfels to spawn in one local unit distance (higher values improve "
"quality)"
msgstr ""
"Antal surfelar per lokal längdenhet (högre värden förbättrar kvaliteten)"
