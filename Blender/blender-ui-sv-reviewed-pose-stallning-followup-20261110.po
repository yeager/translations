#. :src: bpy.types.Constraint.type:'ACTION'
#. :src: bpy.types.POSE_OT_constraint_add.type:'ACTION'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'ACTION'
msgid ""
"Use transform property of target to look up pose for owner from an Action"
msgstr ""
"Använd en transformationsegenskap från målet för att slå upp ägarens "
"ställning i en Action"

#. :src: bpy.types.KinematicConstraint.ik_type:'COPY_POSE'
msgid "Copy Pose"
msgstr "Kopiera ställning"

#. :src: bpy.types.Object.pose
msgid "Current pose for armatures"
msgstr "Aktuell ställning för armaturer"

#. :src: bpy.types.GeometryNodeBoneInfo.transform_space:'ORIGINAL'
msgid "Output the bone pose relative to the armature object transform"
msgstr "Mata ut benets ställning relativt armaturobjektets transformation"

#. :src: bpy.types.GeometryNodeBoneInfo.transform_space:'RELATIVE'
msgid "Bring the bone pose into the modified object"
msgstr "För in benets ställning i det modifierade objektet"

#. :src: bpy.types.POSELIB_OT_copy_as_asset
msgctxt "Operator"
msgid "Copy Pose as Asset"
msgstr "Kopiera ställning som resurs"

#. :src: bpy.types.POSELIB_OT_pose_asset_select_bones
msgid "Select those bones that are used in this pose"
msgstr "Välj de ben som används i denna ställning"

#. :src: bpy.types.POSE_OT_armature_apply
msgctxt "Operator"
msgid "Apply Pose as Rest Pose"
msgstr "Tillämpa ställning som viloposition"

#. :src: bpy.types.POSE_OT_blend_with_rest
msgctxt "Operator"
msgid "Blend Pose with Rest Pose"
msgstr "Blanda ställning med viloposition"

#. :src: bpy.types.POSE_OT_copy
msgctxt "Operator"
msgid "Copy Pose"
msgstr "Kopiera ställning"

#. :src: bpy.types.POSE_OT_paste
msgctxt "Operator"
msgid "Paste Pose"
msgstr "Klistra in ställning"

#. :src: bpy.types.POSE_OT_propagate
msgctxt "Operator"
msgid "Propagate Pose"
msgstr "Sprid ställning"

#. :src: bpy.types.POSE_OT_propagate.mode
msgid "Method used to determine when to stop propagating pose to keyframes"
msgstr ""
"Metod som avgör när spridningen av ställningen till nyckelbildrutor ska "
"avslutas"

#. :src: bpy.types.POSE_OT_push
msgctxt "Operator"
msgid "Push Pose from Breakdown"
msgstr "Förstärk ställning från mellanställning"

#. :src: bpy.types.POSE_OT_relax
msgctxt "Operator"
msgid "Relax Pose to Breakdown"
msgstr "Dämpa ställning mot mellanställning"

#. :src: bpy.types.POSE_OT_visual_transform_apply
msgctxt "Operator"
msgid "Apply Visual Transform to Pose"
msgstr "Tillämpa visuell transformation på ställning"

#. :src: bpy.types.VRLandmark.type:'CUSTOM'
msgid "Custom Pose"
msgstr "Anpassad ställning"

#. :src: bpy.types.XrActionMapBinding.pose_location
