#: ../../manual/video_editing/edit/montage/editing.rst:44
msgid "Snap to"
msgstr "Snabbt till"

#: ../../manual/editors/video_sequencer/preview/controls/snapping.rst:17
msgid "Borders"
msgstr "Ramar"

#: ../../manual/editors/video_sequencer/preview/controls/snapping.rst:18
