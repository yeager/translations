msgstr "Alla slag startar samtidigt (d.v.s. kortare slag avslutas tidigare)."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:81
msgid "Align End"
msgstr "Rikta in änden"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:82
msgid "All stroke end at the same time (i.e. shorter strokes start later)."
msgstr "Alla slag slutar samtidigt (dvs. kortare slag börjar senare)."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:85
msgid "Use the distance to an object to define the order in which strokes appear."
msgstr "Använd avståndet till ett objekt för att definiera i vilken ordning stroke visas."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:91
msgid "If enabled, only modify strokes during the specified frame range."
msgstr "Om den är aktiverad, modifieras endast slag under det angivna bildintervallet."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:94
msgid "Determines the start and end frame for the build effect."
msgstr "Bestämmer start- och slutbilden för byggeffekten."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:98
#: ../../manual/grease_pencil/modifiers/generate/multiple_strokes.rst:30
#: ../../manual/grease_pencil/properties/onion_skinning.rst:61
