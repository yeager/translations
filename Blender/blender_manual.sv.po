msgid "Align"
msgstr "Justera"

#: ../../manual/modeling/meshes/import_images_as_planes.rst:153
msgid "Specifies the plane's rotation upon import."
msgstr "Anger planets rotation vid import."

#: ../../manual/modeling/meshes/import_images_as_planes.rst:0
