msgid "Unique"
msgstr "Unik"

#: ../../manual/sculpt_paint/sculpting/brushes/boundary.rst:55
#: ../../manual/sculpt_paint/sculpting/brushes/multires_displacement_smear.rst:41
#: ../../manual/sculpt_paint/sculpting/brushes/pose.rst:42
#: ../../manual/sculpt_paint/sculpting/brushes/slide_relax.rst:40
#: ../../manual/sculpt_paint/sculpting/brushes/snake_hook.rst:46
msgid "Deformation type that is used by the brush."
msgstr "Deformationstyp som används av penseln."

#: ../../manual/sculpt_paint/sculpting/brushes/boundary.rst:58
msgid "Rotates the boundary around the local Y axis. Useful for creating folding shapes, like sleeves."
msgstr "Roterar begränsningen runt den lokala Y-axeln. Användbart för att skapa vikbara former, t.ex. ärmar."

#: ../../manual/sculpt_paint/sculpting/brushes/boundary.rst:0
#: ../../manual/sculpt_paint/sculpting/brushes/cloth.rst:0
#: ../../manual/sculpt_paint/sculpting/brushes/multires_displacement_smear.rst:0
#: ../../manual/sculpt_paint/sculpting/brushes/slide_relax.rst:0
#: ../../manual/sculpt_paint/sculpting/brushes/smear.rst:0
