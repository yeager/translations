msgstr "Position X, Y"

#: ../../manual/editors/video_sequencer/sequencer/sidebar/strip.rst:75
msgid "Used to move the frames along the X and Y axis."
msgstr "Används för att flytta ramarna längs X- och Y-axlarna."

#: ../../manual/editors/video_sequencer/sequencer/sidebar/strip.rst:80
#: ../../manual/video_editing/edit/montage/strips/effects/transform.rst:49
msgid "Scale the image on the X and Y axis."
msgstr "Skala bilden på X- och Y-axeln."

#: ../../manual/editors/video_sequencer/sequencer/sidebar/strip.rst:85
#: ../../manual/video_editing/edit/montage/strips/effects/transform.rst:54
