msgstr "Översätt nod"

#: ../../manual/compositing/types/transform/translate.rst:8
msgid "Translate Node."
msgstr "Översätt nod."

#: ../../manual/compositing/types/transform/translate.rst:12
msgid "The Translate node moves an image."
msgstr "Noden Translate flyttar en bild."

#: ../../manual/compositing/types/transform/translate.rst:14
msgid "Could also be used to add a 2D camera shake."
msgstr "Kan också användas för att lägga till en 2D-kameraskakning."

#: ../../manual/compositing/types/transform/translate.rst:30
msgid "Percentage translation values relative to the input image size."
msgstr "Procentuella översättningsvärden i förhållande till den ingående bildstorleken."

