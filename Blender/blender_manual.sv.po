#: ../../manual/modeling/meshes/editing/vertex/slide_vertices.rst:27
#: ../../manual/modeling/meshes/uv/editing.rst:68
#: ../../manual/modeling/meshes/uv/editing.rst:91
msgid "Toggle clamping the slide within the edge extents."
msgstr "Spänn fast glidskenan inom kantutdragen."

#: ../../manual/modeling/meshes/editing/edge/edge_slide.rst:26
msgid "Determines the amount of slide performed. Negative values correspond to slides toward one face, while positive ones, refer to the other one. It is also displayed in the 3D Viewport footer."
msgstr "Bestämmer hur mycket glidning som ska utföras. Negativa värden motsvarar glidningar mot en sida, medan positiva värden hänvisar till den andra sidan. Det visas också i sidfoten i 3D-visningsportalen."

#: ../../manual/modeling/meshes/editing/edge/edge_slide.rst:29
#: ../../manual/modeling/meshes/editing/edge/loopcut_slide.rst:130
