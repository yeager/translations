msgstr "Antalet på varandra följande punkter från det ursprungliga slaget som ska ingå i detta segment."

#: ../../manual/grease_pencil/modifiers/generate/dash.rst:29
msgid "Gap"
msgstr "Avstånd"

#: ../../manual/grease_pencil/modifiers/generate/dash.rst:30
