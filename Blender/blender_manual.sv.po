#: ../../manual/contribute/manual/guides/markup_guide.rst:5
msgid "Markup Style Guide"
msgstr "Stilguide för uppmärkning"

#: ../../manual/contribute/manual/guides/markup_guide.rst:22
msgid "This page covers the conventions for writing and use of the reStructuredText (RST) markup syntax."
msgstr "På den här sidan beskrivs konventionerna för skrivning och användning av markupsyntaxen reStructuredText (RST)."

#: ../../manual/contribute/manual/guides/markup_guide.rst:26
msgid "Conventions"
msgstr "Konventioner"

#: ../../manual/contribute/manual/guides/markup_guide.rst:28
msgid "Three space indentation."
msgstr "Tre mellanslag i indraget."

#: ../../manual/contribute/manual/guides/markup_guide.rst:29
msgid "Lines should be less than 120 characters long."
msgstr "Raderna ska vara mindre än 120 tecken långa."

#: ../../manual/contribute/manual/guides/markup_guide.rst:30
msgid "Use italics for button/menu names."
msgstr "Använd kursiv stil för namn på knappar/menyer."

#: ../../manual/contribute/manual/guides/markup_guide.rst:32
msgid "Other loose conventions:"
msgstr "Andra lösa konventioner:"

#: ../../manual/contribute/manual/guides/markup_guide.rst:34
msgid "Avoid Unicode characters."
msgstr "Undvik Unicode-tecken."

#: ../../manual/contribute/manual/guides/markup_guide.rst:35
msgid "Avoid heavily wrapped text (i.e. sentences can have their own lines)."
msgstr "Undvik kraftigt omsluten text (dvs. meningar kan ha sina egna rader)."

#: ../../manual/contribute/manual/guides/markup_guide.rst:40
msgid "Headings"
msgstr "Rubriker"

#: ../../manual/contribute/manual/guides/markup_guide.rst:64
msgid "*Parts* should only be used for contents or index pages."
msgstr "*Parts* bör endast användas för innehålls- eller indexsidor."

#: ../../manual/contribute/manual/guides/markup_guide.rst:66
msgid "Each ``.rst`` file should only have one chapter heading (``*``) per file."
msgstr "Varje `.rst`-fil bör endast ha en kapitelrubrik (`*`) per fil."

#: ../../manual/contribute/manual/guides/markup_guide.rst:70
msgid "Text Styling"
msgstr "Styling av text"

#: ../../manual/contribute/manual/guides/markup_guide.rst:72
msgid "See the `overview on ReStructuredText <https://www.sphinx-doc.org/en/master/usage/restructuredtext/basics.html>`__ for more information on how to style the various elements of the documentation and on how to add lists, tables, pictures and code blocks. The `Sphinx reference <https://www.sphinx-doc.org/en/master/usage/restructuredtext/index.html>`__ provides more insight additional constructs."
msgstr "Se `översikten över ReStructuredText <https://www.sphinx-doc.org/en/master/usage/restructuredtext/basics.html>`__ för mer information om hur du utformar de olika delarna av dokumentationen och hur du lägger till listor, tabeller, bilder och kodblock. I `Sphinx-referensen <https://www.sphinx-doc.org/en/master/usage/restructuredtext/index.html>`__ finns mer information om ytterligare konstruktioner."

