msgstr "Sky Texture Node (texturnod för himmel)."

#: ../../manual/render/shader_nodes/textures/sky.rst:11
msgid "The *Sky Texture* node generates a procedural sky. It's typically used in combination with the :doc:`/render/shader_nodes/output/world`."
msgstr "Noden *Sky Texture* genererar en procedurell himmel. Den används vanligtvis i kombination med :doc:`/render/shader_nodes/output/world`."

#: ../../manual/render/shader_nodes/textures/sky.rst:26
msgid "Sky Type"
msgstr "Typ av himmel"

#: ../../manual/render/shader_nodes/textures/sky.rst:27
