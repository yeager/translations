#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:5
#: ../../manual/modeling/geometry_nodes/utilities/math/mix.rst:6
#: ../../manual/render/shader_nodes/converter/mix.rst:8
msgid "Mix Node"
msgstr "Blanda nod"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:11
msgid "Blends two images together, much like how an image editing program blends two layers."
msgstr "Blandar ihop två bilder, ungefär som när ett bildredigeringsprogram blandar ihop två lager."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:17
msgid "Fac"
msgstr "Fac"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:18
msgid "The opacity of the foreground image."
msgstr "Opaciteten för förgrundsbilden."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:20
msgid "The background image. Determines the dimensions of the output."
msgstr "Bakgrundsbilden. Bestämmer dimensionerna på utskriften."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:24
msgid "Keep in mind that, unlike image editing programs where the foreground layer is on top, the foreground slot in Blender is on the bottom."
msgstr "Tänk på att till skillnad från bildredigeringsprogram där förgrundsskiktet ligger överst, ligger förgrundsspalten i Blender längst ner."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:31
msgid "Blending Mode"
msgstr "Blandningsläge"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:32
msgid "The :term:`blending mode <Color Blend Modes>` to use."
msgstr ":term:`blending mode <Color Blend Modes>` att använda."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:35
msgid "Regular alpha blending. Typically called *Normal* in image editing programs."
msgstr "Vanlig alfablandning. Kallas vanligtvis *Normal* i bildredigeringsprogram."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:36
msgid "`Darken <https://docs.krita.org/en/reference_manual/blending_modes/darken.html#bm-darken>`__"
msgstr "mörk <https://docs.krita.org/en/reference_manual/blending_modes/darken.html#bm-darken>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:37
msgid "For each color component, takes the smallest of the two values being blended."
msgstr "För varje färgkomponent tas det minsta av de två värden som ska blandas."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:38
msgid "`Multiply <https://docs.krita.org/en/reference_manual/blending_modes/arithmetic.html#bm-multiply>`__"
msgstr "`Multiply <https://docs.krita.org/en/reference_manual/blending_modes/arithmetic.html#bm-multiply>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:39
msgid "Multiplies the colors component by component. Blending with a white pixel (value 1.0) has no effect, while blending with a black one (0.0) always results in black."
msgstr "Multiplicerar färgerna komponent för komponent. Att blanda med en vit pixel (värde 1,0) har ingen effekt, medan blandning med en svart pixel (0,0) alltid resulterar i svart."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:42
msgid "`Color Burn <https://docs.krita.org/en/reference_manual/blending_modes/darken.html#bm-color-burn>`__"
msgstr "färgbränning <https://docs.krita.org/en/reference_manual/blending_modes/darken.html#bm-color-burn>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:43
msgid "Inverts the background color, divides it by the foreground color, and inverts the result."
msgstr "Inverterar bakgrundsfärgen, delar den med förgrundsfärgen och inverterar resultatet."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:44
msgid "`Lighten <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-lighten>`__"
msgstr "`Lighten <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-lighten>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:45
msgid "For each color component, takes the largest of the two values being blended."
msgstr "För varje färgkomponent tas det största av de två värden som ska blandas."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:46
msgid "`Screen <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-screen>`__"
msgstr "bildskärm <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-screen>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:47
msgid "Inverts both colors, multiplies them, and inverts the result."
msgstr "Inverterar båda färgerna, multiplicerar dem och inverterar resultatet."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:48
msgid "`Color Dodge <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-color-dodge>`__"
msgstr "färg Dodge <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-color-dodge>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:49
msgid "Divides the background color by the inverted foreground color."
msgstr "Delar bakgrundsfärgen med den inverterade förgrundsfärgen."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:50
msgid "`Add <https://docs.krita.org/en/reference_manual/blending_modes/arithmetic.html#addition>`__"
msgstr "lägg till <https://docs.krita.org/en/reference_manual/blending_modes/arithmetic.html#addition>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:51
msgid "Adds the two colors together."
msgstr "Lägger till de två färgerna tillsammans."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:52
msgid "`Overlay <https://docs.krita.org/en/reference_manual/blending_modes/mix.html#overlay>`__"
msgstr "`Överlägg <https://docs.krita.org/en/reference_manual/blending_modes/mix.html#overlay>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:53
msgid "Applies Multiply blending if the foreground color's lightness is below 0.5, or Screen blending if it's above."
msgstr "Tillämpar Multiply blending om förgrundsfärgens ljushet är under 0,5, eller Screen blending om den är över."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:55
msgid "`Soft Light <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-soft-light>`__"
msgstr "mjukt ljus <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-soft-light>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:56
msgid "Like Overlay, but more subtle."
msgstr "Som Overlay, men mer subtilt."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:57
msgid "`Linear Light <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-linear-light>`__"
msgstr "linjärt ljus <https://docs.krita.org/en/reference_manual/blending_modes/lighten.html#bm-linear-light>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:58
msgid "Applies Linear Burn blending (background + foregound - 1) if the foreground color's lightness is below 0.5, or Linear Dodge (background + foreground) if it's above."
msgstr "Tillämpar Linear Burn-blandning (bakgrund + förgrund - 1) om förgrundsfärgens ljushet är under 0,5, eller Linear Dodge (bakgrund + förgrund) om den är över."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:60
msgid "`Difference <https://docs.krita.org/en/reference_manual/blending_modes/negative.html#bm-difference>`__"
msgstr "skillnad <https://docs.krita.org/en/reference_manual/blending_modes/negative.html#bm-difference>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:61
msgid "For each component, subtracts the lower value from the higher value."
msgstr "För varje komponent subtraheras det lägre värdet från det högre värdet."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:62
msgid "`Exclusion <https://docs.krita.org/en/reference_manual/blending_modes/negative.html#bm-exclusion>`__"
msgstr "`Exkludering <https://docs.krita.org/en/reference_manual/blending_modes/negative.html#bm-exclusion>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:63
msgid "Adds the two colors, then subtracts their multiple twice."
msgstr "Lägger till de två färgerna och subtraherar sedan deras multipel två gånger."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:64
msgid "`Subtract <https://docs.krita.org/en/reference_manual/blending_modes/arithmetic.html#subtract>`__"
msgstr "`Subtrahera <https://docs.krita.org/en/reference_manual/blending_modes/arithmetic.html#subtract>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:65
msgid "Subtracts the foreground color from the background color."
msgstr "Subtraherar förgrundsfärgen från bakgrundsfärgen."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:66
msgid "`Divide <https://docs.krita.org/en/reference_manual/blending_modes/arithmetic.html#divide>`__"
msgstr "dela upp <https://docs.krita.org/en/reference_manual/blending_modes/arithmetic.html#divide>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:67
msgid "Divides the background color by the foreground color."
msgstr "Delar bakgrundsfärgen med förgrundsfärgen."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:68
msgid "`Hue <https://docs.krita.org/en/reference_manual/blending_modes/hsx.html#bm-hue>`__"
msgstr "`Hue <https://docs.krita.org/en/reference_manual/blending_modes/hsx.html#bm-hue>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:69
msgid "Combines the saturation and value of the background color with the hue of the foreground color."
msgstr "Kombinerar mättnad och värde för bakgrundsfärgen med nyansen för förgrundsfärgen."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:70
msgid "`Saturation <https://docs.krita.org/en/reference_manual/blending_modes/hsx.html#bm-saturation>`__"
msgstr "mättnad <https://docs.krita.org/en/reference_manual/blending_modes/hsx.html#bm-saturation>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:71
msgid "Combines the hue and value of the background color with the saturation of the foreground color."
msgstr "Kombinerar bakgrundsfärgens nyans och värde med förgrundsfärgens mättnad."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:72
msgid "`Color <https://docs.krita.org/en/reference_manual/blending_modes/hsx.html#bm-color>`__"
msgstr "färg <https://docs.krita.org/en/reference_manual/blending_modes/hsx.html#bm-color>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:73
msgid "Combines the value of the background color with the hue and saturation of the foreground color."
msgstr "Kombinerar värdet för bakgrundsfärgen med nyansen och mättnaden för förgrundsfärgen."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:74
msgid "`Value <https://docs.krita.org/en/reference_manual/blending_modes/hsx.html#bm-luminosity>`__"
msgstr "värde <https://docs.krita.org/en/reference_manual/blending_modes/hsx.html#bm-luminosity>`__"

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:75
msgid "Combines the hue and saturation of the background color with the value of the foreground color."
msgstr "Kombinerar bakgrundsfärgens nyans och mättnad med förgrundsfärgens värde."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:78
msgid "Whether to use the alpha channel of the foreground image during mixing. The alpha channel of the background image is always used."
msgstr "Om förgrundsbildens alfakanal ska användas vid mixning. Bakgrundsbildens alfakanal används alltid."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:82
msgid "Clamp the output value to the [0.0, 1.0] range."
msgstr "Kläm fast utgångsvärdet till intervallet [0,0, 1,0]."

#: ../../manual/editors/texture_node/types/color/mix_rgb.rst:89
msgid "The result of the mixing operation."
msgstr "Resultatet av blandningsoperationen."

#: ../../manual/modeling/geometry_nodes/utilities/color/separate_color.rst:13
#: ../../manual/modeling/geometry_nodes/utilities/color/separate_color.rst:11
msgid "Splits an image into its channels, based on a particular :term:`Color Model`."
msgstr "Delar upp en bild i dess kanaler, baserat på en viss :term:`Color Model`."

#: ../../manual/modeling/geometry_nodes/utilities/color/separate_color.rst:38
#: ../../manual/modeling/geometry_nodes/utilities/color/separate_color.rst:36
msgid "The outputs of this node depend on the Mode property (see above)."
msgstr "Utgångarna för denna nod beror på egenskapen Mode (se ovan)."

#: ../../manual/modeling/geometry_nodes/utilities/color/separate_color.rst:41
#: ../../manual/modeling/geometry_nodes/utilities/color/separate_color.rst:39
msgid "The opacity value."
msgstr "Opacitetsvärdet."

#: ../../manual/editors/texture_node/types/converter/distance.rst:5
