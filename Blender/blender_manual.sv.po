msgstr "Lägg till ett cylindernätobjekt interaktivt."

#: ../../manual/modeling/meshes/tools/toolbar.rst:57
#: ../../manual/scene_layout/object/tools/toolbar.rst:56
msgid ":ref:`Add UV Sphere <tool-add-uvsphere>`"
msgstr ":ref:`Add UV Sphere <tool-add-uvsphere>`"

#: ../../manual/modeling/meshes/tools/toolbar.rst:58
#: ../../manual/scene_layout/object/tools/toolbar.rst:57
msgid "Interactively add a UV sphere mesh object."
msgstr "Lägg till ett UV-sfäriskt mesh-objekt interaktivt."

#: ../../manual/modeling/meshes/tools/toolbar.rst:59
#: ../../manual/scene_layout/object/tools/toolbar.rst:58
msgid ":ref:`Add Icosphere <tool-add-icosphere>`"
msgstr ":ref:`Add Icosphere <tool-add-icosphere>`"

#: ../../manual/modeling/meshes/tools/toolbar.rst:60
#: ../../manual/scene_layout/object/tools/toolbar.rst:59
msgid "Interactively add an icosphere mesh object."
msgstr "Lägg till ett icosphere mesh-objekt interaktivt."

#: ../../manual/modeling/meshes/tools/toolbar.rst:62
msgid ":ref:`Extrude Region <tool-mesh-extrude_region>`"
msgstr ":ref:`Extrude Region <tool-mesh-extrude_region>`"

#: ../../manual/modeling/meshes/tools/toolbar.rst:63
msgid "Extrude the selected region together freely or along an axis."
msgstr "Extrudera den valda regionen tillsammans fritt eller längs en axel."

#: ../../manual/modeling/meshes/tools/toolbar.rst:65
msgid ":doc:`Extrude Manifold </modeling/meshes/tools/extrude_manifold>`"
msgstr ":doc:`Extruderingsmanifold </modeling/meshes/tools/extrude_manifold>`"

#: ../../manual/modeling/meshes/tools/toolbar.rst:66
msgid "Extrudes region and dissolves overlapping geometry."
msgstr "Extruderar regionen och löser upp överlappande geometri."

#: ../../manual/modeling/meshes/tools/toolbar.rst:67
msgid ":doc:`Extrude Along Normals </modeling/meshes/editing/face/extrude_faces_normal>`"
msgstr ":doc:`Extrudera längs normallinjer </modeling/meshes/editing/face/extrude_faces_normal>`"

#: ../../manual/modeling/meshes/tools/toolbar.rst:68
msgid "Extrude Region along their local normal."
