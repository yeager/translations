msgid "Selects non-selected items and deselects existing selection."
msgstr "Väljer icke valda objekt och avmarkerar befintliga val."

#: ../../manual/movie_clip/masking/selecting.rst:57
#: ../../manual/movie_clip/tracking/clip/selecting.rst:28
msgid "See :ref:`tool-select-box`."
msgstr "Se :ref:`tool-select-box`."

