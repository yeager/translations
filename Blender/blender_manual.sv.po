msgid "Image Node"
msgstr "Bildnod"

#: ../../manual/compositing/types/input/image.rst:8
msgid "Image Node."
msgstr "Bildnod."

#: ../../manual/compositing/types/input/image.rst:12
msgid "The *Image* node injects any image :doc:`format that is supported by Blender </files/media/image_formats>`."
msgstr "Noden *Image* injicerar valfri bild :doc:`format som stöds av Blender </files/media/image_formats>`."

