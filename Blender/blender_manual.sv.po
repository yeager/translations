msgstr "Multiplikator för solskivsbelysning."

#: ../../manual/render/shader_nodes/textures/sky.rst:65
msgid "Sun Elevation"
msgstr "Solhöjd"

#: ../../manual/render/shader_nodes/textures/sky.rst:66
msgid "Rotation of the sun from the horizon (in degrees)."
msgstr "Solens rotation från horisonten (i grader)."

#: ../../manual/render/shader_nodes/textures/sky.rst:68
