#: ../../manual/interface/window_system/workspaces.rst:106
msgid "Workspace Settings"
msgstr "Inställningar för arbetsyta"

#: ../../manual/interface/window_system/workspaces.rst:110
msgid ":doc:`/editors/properties_editor`"
msgstr ":doc:`/editors/properties_editor`"

#: ../../manual/interface/window_system/workspaces.rst:111
msgid ":menuselection:`Tool tab --> Workspace`"
msgstr "::menuselection:`Verktygsflik --> Arbetsyta`"

#: ../../manual/interface/window_system/workspaces.rst:113
msgid "Pin Scene"
msgstr "Pin Scene"

#: ../../manual/interface/window_system/workspaces.rst:114
msgid "When enabled, the current workspace will remember the currently selected scene. Then, whenever you activate the workspace, it'll automatically switch back to that scene."
msgstr "När den är aktiverad kommer den aktuella arbetsytan att komma ihåg den valda scenen. När du sedan aktiverar arbetsytan växlar den automatiskt tillbaka till den scenen."

#: ../../manual/interface/window_system/workspaces.rst:120
msgid "Switch to this :doc:`Mode </editors/3dview/modes>` when activating the workspace."
msgstr "Byt till detta :doc:`Mode </editors/3dview/modes>` när du aktiverar arbetsytan."

#: ../../manual/interface/window_system/workspaces.rst:127
msgid "Filter Add-ons"
msgstr "Filtrera tillägg"

#: ../../manual/interface/window_system/workspaces.rst:128
