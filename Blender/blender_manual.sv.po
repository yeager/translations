msgstr ":menuselection:`Klipp --> Ställ in scenramar`"

#: ../../manual/movie_clip/tracking/clip/editing/clip.rst:30
msgid "Sets end scene frame to match current clip duration."
msgstr "Ställer in bildrutan i slutet av scenen så att den matchar det aktuella klippets längd."

#: ../../manual/movie_clip/tracking/clip/editing/clip.rst:36
msgid "Set Principal to Center"
msgstr "Ställ in rektor till centrum"

