msgstr "Koordinera utrymme som ska användas."

#: ../../manual/grease_pencil/modifiers/edit/weight_angle.rst:43
#: ../../manual/grease_pencil/modifiers/edit/weight_proximity.rst:47
msgid "Minimum value for vertex weight."
msgstr "Minsta värde för vertexvikt."

#: ../../manual/grease_pencil/modifiers/edit/weight_angle.rst:45
#: ../../manual/grease_pencil/modifiers/edit/weight_proximity.rst:49
msgid "Multiply Weights"
msgstr "Multiplicera vikter"

#: ../../manual/grease_pencil/modifiers/edit/weight_angle.rst:46
#: ../../manual/grease_pencil/modifiers/edit/weight_proximity.rst:50
