msgstr "Flyttar slutbilden till animationens start för att hålla animationen i en loop."

#: ../../manual/grease_pencil/modifiers/edit/time_offset.rst:63
#: ../../manual/grease_pencil/modifiers/generate/build.rst:89
#: ../../manual/render/eevee/render_settings/volumes.rst:32
msgid "Custom Range"
msgstr "Anpassat sortiment"

#: ../../manual/grease_pencil/modifiers/edit/time_offset.rst:65
