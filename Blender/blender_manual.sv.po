msgstr "Sortera"

#: ../../manual/grease_pencil/modes/edit/stroke_menu.rst:261
msgid ":menuselection:`Stroke --> Arrange`"
msgstr ":menuselection:`Stroke --> Arrange`"

#: ../../manual/grease_pencil/modes/edit/stroke_menu.rst:263
