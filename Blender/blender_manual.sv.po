msgstr ":doc:`Grease Pencil </editors/dope_sheet/modes/grease_pencil>`"

#: ../../manual/editors/dope_sheet/introduction.rst:34
msgid ":doc:`Mask </editors/dope_sheet/modes/mask>`"
msgstr ":doc:`Mask </editors/dope_sheet/modes/mask>`"

