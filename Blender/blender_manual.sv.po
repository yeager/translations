#: ../../manual/physics/rigid_body/constraints/types/fixed.rst:5
msgid "Fixed Constraint"
msgstr "Fast begränsning"

#: ../../manual/physics/rigid_body/constraints/types/fixed.rst:12
msgid "This constraint cause the two objects to move as one. Since the physics system does have a tiny bit of slop in it, the objects do not move as rigidly as they would if they were part of the same mesh."
msgstr "Denna begränsning gör att de två objekten rör sig som ett. Eftersom fysiksystemet har en liten sladd i sig rör sig objekten inte lika styvt som de skulle göra om de var en del av samma mesh."

#: ../../manual/physics/rigid_body/constraints/types/fixed.rst:20
msgid "*Fixed* constraint options."
msgstr "*Fixat* alternativ för begränsning."

#: ../../manual/physics/rigid_body/constraints/types/generic.rst:5
msgid "Generic Constraint"
