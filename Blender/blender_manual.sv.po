#: ../../manual/editors/3dview/display/overlays.rst:215
msgid "Highlight selected faces. Affects all selection modes."
msgstr "Markera valda ytor. Påverkar alla markeringslägen."

#: ../../manual/editors/3dview/display/overlays.rst:217
msgid "Show face center points in solid shading modes. (They're always shown in wireframe shading mode.)"
msgstr "Visa ansiktets mittpunkter i solid shading-lägen. (De visas alltid i skuggningsläget wireframe.)"

#: ../../manual/editors/3dview/display/overlays.rst:219
msgid "Only affects face selection mode."
msgstr "Påverkar endast läget för val av ansikte."

#: ../../manual/editors/3dview/display/overlays.rst:220
msgid "Creases"
msgstr "Veck"

#: ../../manual/editors/3dview/display/overlays.rst:221
msgid "Display edges marked with a crease for the :doc:`Subdivision Surface Modifier </modeling/modifiers/generate/subdivision_surface>`."
msgstr "Visa kanter markerade med ett veck för :doc:`Modifieraren för underindelningsyta </modeling/modifiers/generate/subdivision_surface>`."

