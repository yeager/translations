#: ../../manual/render/shader_nodes/input/texture_coordinate.rst:51
msgid "Generated"
msgstr "Genererad"

#: ../../manual/editors/image/image_settings.rst:89
msgid "Image generated by Blender."
msgstr "Bild genererad av Blender."

#: ../../manual/editors/image/image_settings.rst:92
msgid "The width and height of the image in pixels."
msgstr "Bildens bredd och höjd i pixlar."

#: ../../manual/editors/image/image_settings.rst:93
msgid "Float Buffer"
msgstr "Flytande buffert"

#: ../../manual/editors/image/image_settings.rst:94
msgid "Creates a 32-bit image. This has a larger file size, but holds much more color information than the standard 8-bit image. For close-ups and large gradients, it may be better to use a 32-bit image."
msgstr "Skapar en 32-bitars bild. Den har en större filstorlek, men innehåller mycket mer färginformation än en 8-bitars standardbild. För närbilder och stora gradienter kan det vara bättre att använda en 32-bitarsbild."

#: ../../manual/editors/image/image_settings.rst:0
#: ../../manual/grease_pencil/primitives.rst:22
#: ../../manual/render/layers/introduction.rst:42
msgid "Blank"
msgstr "Blank"

#: ../../manual/editors/image/image_settings.rst:98
msgid "Creates a blank image of a single specified color."
msgstr "Skapar en tom bild med en enda angiven färg."

#: ../../manual/editors/image/image_settings.rst:0
msgid "UV Grid"
msgstr "UV-rutnät"

#: ../../manual/editors/image/image_settings.rst:99
msgid "Creates a checkerboard pattern with a colored cross (+) in each square."
msgstr "Skapar ett rutmönster med ett färgat kors (+) i varje ruta."

#: ../../manual/editors/image/image_settings.rst:0
msgid "Color Grid"
msgstr "Färgschema"

#: ../../manual/editors/image/image_settings.rst:101
msgid "Creates a more complex colored grid with letters and numbers denoting locations. It could be used to check for stretching or distortion in the UV mapping."
msgstr "Skapar ett mer komplext färgat rutnät med bokstäver och siffror som anger platser. Det kan användas för att kontrollera om UV-mappningen är uttänjd eller förvrängd."

#: ../../manual/editors/image/image_settings.rst:104
msgid "The fill color when creating a *Blank* image."
msgstr "Fyllnadsfärgen när du skapar en *Blank* bild."

#: ../../manual/editors/image/image_settings.rst:109
#: ../../manual/editors/texture_node/types/textures/index.rst:11
#: ../../manual/editors/video_sequencer/sequencer/sidebar/modifiers.rst:40
#: ../../manual/grease_pencil/modes/draw/brushes/draw.rst:201
