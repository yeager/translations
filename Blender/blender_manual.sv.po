msgstr "Roterad kub med global orientering, gizmo har inte ändrats."

#: ../../manual/editors/3dview/controls/orientation.rst:106
msgid "Local orientation, gizmo matches the object's rotation."
msgstr "Lokal orientering, gizmo matchar objektets rotation."

#: ../../manual/editors/3dview/controls/orientation.rst:110
msgid "Normal orientation, in Edit Mode."
msgstr "Normal orientering, i redigeringsläge."

#: ../../manual/editors/3dview/controls/orientation.rst:114
