#: ../../manual/modeling/meshes/uv/editing.rst:178
msgid "Selected to Cursor"
msgstr "Väljs till markör"

#: ../../manual/modeling/meshes/uv/editing.rst:179
msgid "Moves selection to 2D cursor location."
msgstr "Flyttar markeringen till markörens 2D-position."

#: ../../manual/modeling/meshes/uv/editing.rst:180
msgid "Selected to Cursor (Offset)"
msgstr "Vald till markör (Offset)"

#: ../../manual/modeling/meshes/uv/editing.rst:181
msgid "Moves selection center to 2D cursor location, while preserving the offset of the vertices from the center."
msgstr "Flyttar urvalets mitt till 2D-markörens position, samtidigt som hörnpunkternas förskjutning från mitten bevaras."

#: ../../manual/modeling/meshes/uv/editing.rst:182
msgid "Selected to Adjacent Unselected"
