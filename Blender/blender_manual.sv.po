msgstr "Z- (nedåt), Y-, X-, Z+ (uppåt), Y+, X+"

#: ../../manual/modeling/meshes/import_images_as_planes.rst:156
msgid "Rotates the plane to align with the selected axis."
msgstr "Roterar planet så att det ligger i linje med den valda axeln."

#: ../../manual/modeling/meshes/import_images_as_planes.rst:0
msgid "Face Camera"
msgstr "Ansiktskamera"

#: ../../manual/modeling/meshes/import_images_as_planes.rst:158
