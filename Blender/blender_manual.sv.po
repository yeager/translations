#: ../../manual/modeling/meshes/editing/vertex/slide_vertices.rst:23
#: ../../manual/modeling/meshes/uv/editing.rst:64
#: ../../manual/modeling/meshes/uv/editing.rst:88
msgid "Flipped :kbd:`F`"
msgstr "Flippad :kbd:`F`"

#: ../../manual/modeling/meshes/editing/edge/edge_slide.rst:22
#: ../../manual/modeling/meshes/uv/editing.rst:89
msgid "When Even mode is active, this flips between the two adjacent edge loops the active edge loop will match."
msgstr "När Even-läget är aktivt växlar detta mellan de två intilliggande kantslingorna som den aktiva kantslingan kommer att matcha."

#: ../../manual/modeling/meshes/editing/edge/edge_slide.rst:23
#: ../../manual/modeling/meshes/editing/vertex/slide_vertices.rst:26
#: ../../manual/modeling/meshes/uv/editing.rst:67
#: ../../manual/modeling/meshes/uv/editing.rst:90
