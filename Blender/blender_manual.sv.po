#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:162
msgid "Cycles Modifier"
msgstr "Cykler Modifierare"

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:164
msgid "Makes the curve repeat itself."
msgstr "Gör att kurvan upprepar sig själv."

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:168
msgid "The Cycles Modifier can only be the first modifier."
msgstr "Cycles Modifier kan bara vara den första modifieraren."

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:170
msgid "Before/After Mode"
msgstr "Före/efter-läge"

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:171
msgid "No Cycles"
msgstr "Inga cykler"

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:172
msgid "Do not repeat the curve before/after the original."
msgstr "Upprepa inte kurvan före/efter originalet."

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:173
msgid "Repeat Motion"
msgstr "Upprepa rörelse"

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:174
msgid "Repeats the curve, keeping the values of each copy the same."
msgstr "Upprepar kurvan och behåller samma värden för varje kopia."

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:175
msgid "Repeat with Offset"
msgstr "Upprepa med Offset"

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:176
msgid "Repeats the curve, offsetting each copy vertically so that its first keyframe matches the previous last keyframe."
msgstr "Repeterar kurvan och förskjuter varje kopia vertikalt så att dess första keyframe matchar den föregående sista keyframen."

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:178
msgid "Repeat Mirrored"
msgstr "Repeat Spegelvänd"

#: ../../manual/editors/graph_editor/fcurves/modifiers.rst:179
msgid "Repeats the curve, flipping every other copy horizontally."
msgstr "Upprepar kurvan och vänder varannan kopia horisontellt."

