#: ../../manual/sculpt_paint/brush/brush_management.rst:71
msgid "See :ref:`Asset Author <bpy.types.AssetMetaData.description>`."
msgstr "Se :ref:`Asset Author <bpy.types.AssetMetaData.description>`."

#: ../../manual/sculpt_paint/brush/brush_management.rst:73
msgid "See :ref:`Asset Description <bpy.types.AssetMetaData.description>`."
