msgstr ":doc:`Fysikalisk simulering </physics/introduction>`"

#: ../../manual/animation/introduction.rst:27
msgid ":doc:`Motion Tracking </movie_clip/index>`"
msgstr ":doc:`Motion Tracking </movie_clip/index>`"

#: ../../manual/animation/introduction.rst:33
msgid "State Colors"
msgstr "Statsfärger"

#: ../../manual/animation/introduction.rst:37
msgid "State colors of properties."
msgstr "Statliga färger på egenskaper."

#: ../../manual/animation/introduction.rst:39
msgid "Properties have different colors and menu items for different states."
msgstr "Properties har olika färger och menyalternativ för olika stater."

#: ../../manual/animation/introduction.rst:45
#: ../../manual/editors/dope_sheet/introduction.rst:54
#: ../../manual/render/color_management.rst:179
msgid "Gray"
msgstr "Grå"

#: ../../manual/animation/introduction.rst:46
msgid "Not animated"
