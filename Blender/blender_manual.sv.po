msgstr "Markörens storlek är som standard 28, men du kanske vill öka storleken på Hi-DPI-skärmar."

#: ../../manual/getting_started/installing/linux_windowing_environment.rst:86
msgid "Gnome Shell's Fractional Scaling (before version 44)"
msgstr "Gnome Shells fraktionerade skalning (före version 44)"

#: ../../manual/getting_started/installing/linux_windowing_environment.rst:87
