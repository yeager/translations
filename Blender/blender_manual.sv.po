#: ../../manual/modeling/meshes/uv/editing.rst:186
msgid "Snaps the cursor to the nearest pixels."
msgstr "Snäpper markören till de närmaste pixlarna."

#: ../../manual/modeling/meshes/uv/editing.rst:187
#: ../../manual/scene_layout/object/editing/snap.rst:29
