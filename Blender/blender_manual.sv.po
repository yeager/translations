msgstr "Samplingar"

#: ../../manual/compositing/types/filter/blur/vector_blur.rst:32
msgid "Quality factor."
msgstr "Kvalitetsfaktor."

#: ../../manual/compositing/types/filter/blur/vector_blur.rst:33
