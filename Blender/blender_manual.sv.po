msgstr "Flyttar topparna i slumpmässiga riktningar efter att nätet har delats upp."

#: ../../manual/modeling/meshes/editing/edge/subdivide.rst:119
msgid "Plane before subdivision."
msgstr "Plan före underindelning."

#: ../../manual/modeling/meshes/editing/edge/subdivide.rst:124
msgid "Regular subdivision."
msgstr "Vanlig indelning."

#: ../../manual/modeling/meshes/editing/edge/subdivide.rst:129
msgid "Same mesh with fractal added."
msgstr "Samma nät med fraktal tillagd."

#: ../../manual/modeling/meshes/editing/edge/subdivide.rst:131
msgid "Along Normal"
msgstr "Längs Normal"

#: ../../manual/modeling/meshes/editing/edge/subdivide.rst:132
msgid "Causes the vertices to move along their normals, instead of random directions."
msgstr "Gör att hörnen rör sig längs sina normaler, istället för slumpmässigt i olika riktningar."

#: ../../manual/modeling/meshes/editing/edge/subdivide.rst:137
msgid "Along Normal set to 1."
msgstr "Along Normal inställd på 1."

#: ../../manual/modeling/meshes/editing/edge/subdivide.rst:140
msgid "Changes the random seed of the *Fractal* noise function, producing a different result for each seed value."
msgstr "Ändrar det slumpmässiga fröet för brusfunktionen *Fractal*, vilket ger ett annat resultat för varje frövärde."

#: ../../manual/modeling/meshes/editing/edge/subdivide.rst:145
msgid "Same mesh with a different seed value."
msgstr "Samma nät med ett annat seed-värde."

