msgstr "Aktivera MetalRT för intersektionella frågor."

#: ../../manual/editors/preferences/system.rst:65
msgid "Automatically pick the fastest intersection method."
msgstr "Välj automatiskt den snabbaste intersektionsmetoden."

#: ../../manual/editors/preferences/system.rst:70
msgid "Display Graphics"
msgstr "Displaygrafik"

#: ../../manual/editors/preferences/system.rst:72
msgid "Changes how display graphics are drawn."
msgstr "Ändrar hur displaygrafik ritas."

#: ../../manual/editors/preferences/system.rst:74
msgid "Backend"
msgstr "Bakände"

#: ../../manual/editors/preferences/system.rst:0
#: ../../manual/glossary/index.rst:642
msgid "OpenGL"
msgstr "OpenGL"

#: ../../manual/editors/preferences/system.rst:76
