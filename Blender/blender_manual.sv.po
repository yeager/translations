#: ../../manual/compositing/types/filter/glare.rst:31
msgid "Controls how gradually pixels transition into the glare effect. Higher values create a smoother highlight extraction."
msgstr "Styr hur gradvis pixlarna övergår till bländningseffekten. Högre värden skapar en mjukare extrahering av högdagrar."

#: ../../manual/compositing/types/filter/glare.rst:36
msgid "Suppress"
msgstr "Undertrycka"

#: ../../manual/compositing/types/filter/glare.rst:38
msgid "Suppress bright highlights defined by the *Maximum* input."
msgstr "Undertrycker ljusa högdagrar som definieras av *Maximum*-ingången."

#: ../../manual/compositing/types/filter/glare.rst:40
msgid "This can help create a more consistent looking bloom effect when there is a large variations in luminance."
msgstr "Detta kan bidra till att skapa en mer enhetlig bloom-effekt när det finns stora variationer i luminans."

