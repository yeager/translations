msgstr "Lägger till text i början av det aktuella namnet. Detta är användbart för verktyg som letar efter specialtext i prefixet till ett datablocknamn."

#: ../../manual/files/blend/rename.rst:89
msgid "Adds text to the end of the current name. This is useful for tools that look for special text in the suffix of a data-block name."
msgstr "Lägger till text i slutet av det aktuella namnet. Detta är användbart för verktyg som letar efter specialtext i suffixet i ett datablocknamn."

#: ../../manual/files/blend/rename.rst:92
msgid "Defines the new name or the text to add as a prefix/suffix."
msgstr "Definierar det nya namnet eller den text som ska läggas till som prefix/suffix."

#: ../../manual/files/blend/rename.rst:96
msgid "Strip Characters"
msgstr "Stripa karaktärer"

#: ../../manual/files/blend/rename.rst:98
msgid "*Strip Characters* cleans up names by removing certain character types from either the beginning or the end of the name."
msgstr "*Strip Characters* rensar upp namn genom att ta bort vissa teckentyper från antingen början eller slutet av namnet."

#: ../../manual/files/blend/rename.rst:101
msgid "Characters"
msgstr "Tecken"

#: ../../manual/files/blend/rename.rst:0
msgid "Spaces"
msgstr "Antal platser"

#: ../../manual/files/blend/rename.rst:103
msgid "Strips any space characters from the name, e.g. \"Living Room   \" becomes \"Living Room\"."
msgstr "Tar bort alla mellanslagstecken från namnet, t.ex. \"Living Room\" blir \"Living Room\"."

#: ../../manual/files/blend/rename.rst:0
msgid "Digits"
msgstr "%d siffror"

#: ../../manual/files/blend/rename.rst:105
msgid "Strips any numerical characters from the name, e.g. ``cube.001`` becomes ``cube.``."
msgstr "Tar bort alla numeriska tecken från namnet, t.ex. `cube.001` blir `cube.`."

#: ../../manual/files/blend/rename.rst:0
msgid "Punctuation"
msgstr "Skiljetecken"

#: ../../manual/files/blend/rename.rst:107
msgid "Strips any punctuation characters (``,.?!:;`` etc.) from the name, e.g. ``cube?`` becomes ``cube``."
msgstr "Tar bort alla skiljetecken (`,.?!:;` etc.) från namnet, t.ex. `cube?` blir `cube`."

#: ../../manual/files/blend/rename.rst:111
msgid "Multiple character types can be removed at once by :kbd:`Shift-LMB` on the types."
msgstr "Flera teckentyper kan tas bort samtidigt genom att :kbd:`Shift-LMB` på typerna."

#: ../../manual/files/blend/rename.rst:113
msgid "Strip From"
msgstr "Stripa från"

#: ../../manual/files/blend/rename.rst:114
msgid "Strips any leading characters in the name."
msgstr "Tar bort alla inledande tecken i namnet."

#: ../../manual/files/blend/rename.rst:115
msgid "Strips any trailing characters in the name."
msgstr "Tar bort eventuella efterföljande tecken i namnet."

#: ../../manual/files/blend/rename.rst:119
msgid "Change Case"
msgstr "Ändra ärende"

#: ../../manual/files/blend/rename.rst:121
