msgstr "`partikel:storlek`"

#: ../../manual/render/cycles/osl/index.rst:248
#: ../../manual/render/shader_nodes/input/particle_info.rst:51
#: ../../manual/render/shader_nodes/input/point_info.rst:36
msgid "Size of the particle."
msgstr "Partikelns storlek."

#: ../../manual/render/cycles/osl/index.rst:249
