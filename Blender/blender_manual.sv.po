#: ../../manual/modeling/surfaces/editing/surface.rst:64
msgid "Spin"
msgstr "Snurra"

#: ../../manual/compositing/types/filter/blur/directional_blur.rst:38
msgid "Rotates the image each iteration to create a spin effect, from the center point."
msgstr "Roterar bilden vid varje iteration för att skapa en snurrande effekt, från mittpunkten."

#: ../../manual/compositing/types/filter/blur/directional_blur.rst:39
#: ../../manual/editors/clip/introduction.rst:55
#: ../../manual/editors/graph_editor/introduction.rst:47
#: ../../manual/editors/image/navigating.rst:45
#: ../../manual/editors/preferences/navigation.rst:88
#: ../../manual/editors/video_sequencer/preview/header.rst:45
#: ../../manual/getting_started/configuration/hardware.rst:127
msgid "Zoom"
msgstr "Zooma"

#: ../../manual/compositing/types/filter/blur/directional_blur.rst:40
msgid "Scales the image each iteration, creating the effect of a zoom."
msgstr "Skalar bilden vid varje iteration, vilket ger effekten av en zoom."

#: ../../manual/compositing/types/filter/blur/index.rst:4
msgid "Blur Filter Nodes"
msgstr "Noder för oskärpefilter"

#: ../../manual/compositing/types/filter/blur/vector_blur.rst:6
msgid "Vector Blur Node"
msgstr "Vector Blur Node"

#: ../../manual/compositing/types/filter/blur/vector_blur.rst:8
msgid "Vector Blur Node."
msgstr "Vector Blur Node."

#: ../../manual/compositing/types/filter/blur/vector_blur.rst:12
msgid "The Vector Blur node is a fast method for simulating :term:`Motion Blur` in compositing. It uses the vector speed render pass to blur the image pixels in 2D."
msgstr "Vector Blur-noden är en snabb metod för att simulera :term:`Motion Blur` i compositing. Den använder renderingspasset för vektorhastighet för att sudda ut bildpixlarna i 2D."

#: ../../manual/compositing/types/filter/blur/vector_blur.rst:20
msgid "Image input, to be linked to the \"Combined\" render pass."
msgstr "Bildinmatning som ska kopplas till \"Combined\"-renderingspasset."

#: ../../manual/compositing/types/filter/blur/vector_blur.rst:22
msgid "Z depth, to be linked to the \"Depth\" render pass."
msgstr "Z-djup, ska kopplas till renderingspasset \"Depth\"."

#: ../../manual/compositing/types/filter/blur/vector_blur.rst:23
#: ../../manual/compositing/types/tracking/track_position.rst:47
#: ../../manual/modeling/modifiers/deform/wave.rst:119
