msgstr "Ändrar :ref:`Optical Center <bpy.types.MovieTrackingCamera.principal>`-värdena till bildens mittpunkt."

#: ../../manual/movie_clip/tracking/clip/editing/clip.rst:49
#: ../../manual/movie_clip/tracking/clip/toolbar/track.rst:11
msgid "Prefetch"
msgstr "Förhandsgranskning"

#: ../../manual/movie_clip/tracking/clip/editing/clip.rst:54
