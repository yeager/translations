#: ../../manual/render/cycles/baking.rst:126
msgid "Emit"
msgstr "Emittera"

#: ../../manual/render/cycles/baking.rst:67
msgid "Bakes Emission, or the Glow color of a material."
msgstr "Bakar Emission, eller Glow-färgen på ett material."

