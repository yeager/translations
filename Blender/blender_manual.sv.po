#: ../../manual/modeling/geometry_nodes/texture/image.rst:33
#: ../../manual/modeling/modifiers/modify/mesh_cache.rst:0
#: ../../manual/modeling/modifiers/modify/mesh_sequence_cache.rst:0
#: ../../manual/render/output/properties/metadata.rst:30
msgid "Frame"
msgstr "Bildruta"

#: ../../manual/animation/constraints/transform/transform_cache.rst:59
msgid "The velocity unit was encoded in frames and does not need to be scaled by scene FPS."
msgstr "Hastighetsenheten kodades i bildrutor och behöver inte skalas med scenens FPS."

#: ../../manual/animation/constraints/transform/transform_cache.rst:60
#: ../../manual/editors/dope_sheet/editing.rst:0
#: ../../manual/editors/graph_editor/introduction.rst:382
#: ../../manual/editors/nla/introduction.rst:0
#: ../../manual/modeling/modifiers/modify/mesh_sequence_cache.rst:0
