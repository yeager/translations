#: ../../manual/addons/import_export/scene_gltf2.rst:1119
msgid "Animation mode"
msgstr "Animeringsläge"

#: ../../manual/addons/import_export/scene_gltf2.rst:1120
msgid "Animation mode used for export (See `Animations`_)"
msgstr "Animationsläge som används för export (Se `Animations`_)"

#: ../../manual/addons/import_export/scene_gltf2.rst:1124
msgid "Animation - Bake & Merge"
msgstr "Animation - Bake & Merge"

#: ../../manual/addons/import_export/scene_gltf2.rst:1126
msgid "Bake All Objects Animations"
msgstr "Baka alla objekt Animationer"

#: ../../manual/addons/import_export/scene_gltf2.rst:1127
msgid "Useful when some objects are constrained without being animated themselves."
msgstr "Användbart när vissa objekt begränsas utan att själva animeras."

#: ../../manual/addons/import_export/scene_gltf2.rst:1128
#: ../../manual/editors/dope_sheet/modes/action.rst:56
msgid "Merge Animation"
msgstr "Merge Animation"

#: ../../manual/addons/import_export/scene_gltf2.rst:1129
msgid "Merge animation mode. Can be by Action (using slot), by NLA Track Name, or no merge. When merging by NLA Track Name, all animation with the same NLA Track name will be merged. When merging by Action, all animations with the same action will be merged. When no merge, all animations will be exported as separate animations."
msgstr "Läge för sammanslagning av animering. Kan vara efter Action (med slot), efter NLA Track Name eller ingen sammanfogning. Vid sammanslagning med NLA Track Name kommer alla animationer med samma NLA Track-namn att slås samman. Vid sammanfogning efter Action kommer alla animationer med samma action att sammanfogas. Om ingen sammanslagning görs exporteras alla animationer som separata animationer."

#: ../../manual/addons/import_export/scene_gltf2.rst:1136
msgid "Animation - Rest & Ranges"
msgstr "Animation - Rest & Ranges"

#: ../../manual/addons/import_export/scene_gltf2.rst:1138
msgid "Use Current Frame as Object Rest Transformations"
msgstr "Använd aktuell bildram som objekt Resttransformationer"

#: ../../manual/addons/import_export/scene_gltf2.rst:1139
msgid "Export the scene in the current animation frame. When off, frame 0 is used as rest transformation for objects."
msgstr "Exporterar scenen i den aktuella animationsramen. När funktionen är avstängd används frame 0 som resttransformation för objekt."

#: ../../manual/addons/import_export/scene_gltf2.rst:1140
msgid "Limit to Playback Range"
msgstr "Begränsa till uppspelningsintervall"

#: ../../manual/addons/import_export/scene_gltf2.rst:1141
msgid "Clips animations to selected playback range."
msgstr "Klipper animationer till valt uppspelningsområde."

#: ../../manual/addons/import_export/scene_gltf2.rst:1142
msgid "Set all glTF Animation starting at 0"
msgstr "Ställ in alla glTF-animationer med början på 0"

#: ../../manual/addons/import_export/scene_gltf2.rst:1143
msgid "Set all glTF Animation starting at 0. Can be useful for looping animation"
msgstr "Ställ in alla glTF-animationer med början på 0. Kan vara användbart för loopande animationer"

#: ../../manual/addons/import_export/scene_gltf2.rst:1144
msgid "Negative Frames"
msgstr "Negativa ramar"

#: ../../manual/addons/import_export/scene_gltf2.rst:1145
msgid "When some frames are in negative range, slide or crop the animation."
msgstr "Om vissa bildrutor är i negativt intervall, flytta eller beskär animationen."

#: ../../manual/addons/import_export/scene_gltf2.rst:1148
msgid "Animation - Armature"
msgstr "Animation - Armatur"

#: ../../manual/addons/import_export/scene_gltf2.rst:1150
msgid "Export all Armature Actions"
msgstr "Exportera alla armaturåtgärder"

#: ../../manual/addons/import_export/scene_gltf2.rst:1151
msgid "Export all actions, bound to a single armature. Warning: Option does not support exports including multiple armatures."
msgstr "Exportera alla åtgärder, knutna till en enda armatur. Varning för detta: Alternativet stöder inte export som omfattar flera armaturer."

#: ../../manual/addons/import_export/scene_gltf2.rst:1153
msgid "Reset pose bones between actions"
msgstr "Återställ poseben mellan åtgärder"

#: ../../manual/addons/import_export/scene_gltf2.rst:1154
msgid "Reset pose bones between each action exported. This is needed when some bones are not keyed on some animations."
msgstr "Återställ poseringsben mellan varje exporterad åtgärd. Detta behövs när vissa ben inte är keyade i vissa animationer."

#: ../../manual/addons/import_export/scene_gltf2.rst:1159
msgid "Animation - Shape Keys"
msgstr "Animering - Formnycklar"

#: ../../manual/addons/import_export/scene_gltf2.rst:1161
msgid "Shape Keys Animations"
msgstr "Animationer av formnycklar"

#: ../../manual/addons/import_export/scene_gltf2.rst:1162
msgid "Export Shape Keys Animation. Need Shape Keys to be exported (See `Data - Shape Keys`_)"
msgstr "Exportera animering av Shape Keys. Behöver Shape Keys för att exporteras (se `Data - Shape Keys`_)"

#: ../../manual/addons/import_export/scene_gltf2.rst:1163
msgid "Reset Shape Keys between actions"
msgstr "Återställ Shape Keys mellan åtgärder"

#: ../../manual/addons/import_export/scene_gltf2.rst:1164
msgid "Reset Shape Keys between each action exported. This is needed when some shape keys are not keyed on some animations."
msgstr "Återställ Shape Keys mellan varje exporterad åtgärd. Detta behövs när vissa shape keys inte är keyade på vissa animationer."

#: ../../manual/addons/import_export/scene_gltf2.rst:1169
msgid "Animation - Sampling"
msgstr "Animation - Provtagning"

#: ../../manual/addons/import_export/scene_gltf2.rst:1171
msgid "Apply sampling to all animations. Do not sample animation can lead to wrong animation export."
msgstr "Tillämpa sampling på alla animationer. Om du inte samplar animationer kan det leda till felaktig export av animationer."

#: ../../manual/addons/import_export/scene_gltf2.rst:1174
msgid "How often to evaluate animated values (in frames)."
msgstr "Hur ofta ska man utvärdera animerade värden (i bildrutor)."

#: ../../manual/addons/import_export/scene_gltf2.rst:1175
msgid "Sampling Interpolation Fallback"
msgstr "Sampling Interpolation Fallback"

#: ../../manual/addons/import_export/scene_gltf2.rst:1176
msgid "Interpolation choosen for properties that are not keyed (LINEAR or STEP/CONSTANT)"
msgstr "Val av interpolation för egenskaper som inte är nycklade (LINEAR eller STEP/CONSTANT)"

#: ../../manual/addons/import_export/scene_gltf2.rst:1180
msgid "Animation - Optimize"
msgstr "Animering - Optimera"

#: ../../manual/addons/import_export/scene_gltf2.rst:1182
msgid "Optimize Animation Size"
msgstr "Optimera animeringens storlek"

#: ../../manual/addons/import_export/scene_gltf2.rst:1183
msgid "Reduce exported file size by removing duplicate keyframes when all identical."
msgstr "Minska storleken på den exporterade filen genom att ta bort duplicerade keyframes när alla är identiska."

#: ../../manual/addons/import_export/scene_gltf2.rst:1184
msgid "Force keeping channel for armature / bones"
msgstr "Krafthållningskanal för armatur/ben"

#: ../../manual/addons/import_export/scene_gltf2.rst:1185
msgid "if all keyframes are identical in a rig, force keeping the minimal animation."
msgstr "om alla keyframes är identiska i en rigg, tvinga fram en minimal animation."

#: ../../manual/addons/import_export/scene_gltf2.rst:1186
msgid "Force keeping channel for objects"
msgstr "Krafthållande kanal för objekt"

#: ../../manual/addons/import_export/scene_gltf2.rst:1187
msgid "if all keyframes are identical for object transformations, force keeping the minimal animation."
msgstr "om alla keyframes är identiska för objekttransformationer, tvingar du fram en minimal animation."

#: ../../manual/addons/import_export/scene_gltf2.rst:1188
msgid "Disable viewport for other objects"
msgstr "Inaktivera vyport för andra objekt"

#: ../../manual/addons/import_export/scene_gltf2.rst:1189
msgid "When exporting animations, disable viewport for other objects, for performance reasons, when possible."
msgstr "När du exporterar animationer ska du av prestandaskäl inaktivera vyport för andra objekt när det är möjligt."

#: ../../manual/addons/import_export/scene_gltf2.rst:1193
msgid "Animation - Filter"
msgstr "Animation - Filter"

#: ../../manual/addons/import_export/scene_gltf2.rst:1195
msgid "Restrict actions to be exported to the ones matching the filter."
msgstr "Begränsa de åtgärder som ska exporteras till de som matchar filtret."

#: ../../manual/addons/import_export/scene_gltf2.rst:1199
msgid "Collection Exporters"
msgstr "Exportörer av kollektioner"

#: ../../manual/addons/import_export/scene_gltf2.rst:1201
msgid "This exporter can be used as a collection exporter. See :doc:`/scene_layout/collections/collections` for more information about collections and their exporters."
msgstr "Denna exportör kan användas som en samlingsexportör. Se :doc:`/scene_layout/collections/collections` för mer information om samlingar och deras exportörer."

#: ../../manual/addons/import_export/scene_gltf2.rst:1204
msgid "Here are the options & specificity for collection export:"
msgstr "Här är alternativen och specificiteten för export av samlingar:"

#: ../../manual/addons/import_export/scene_gltf2.rst:1206
msgid "Include part of options are not available for collection exporter (like every other exporter)."
msgstr "Inkludera en del av alternativen är inte tillgängliga för samlingsexportören (som alla andra exportörer)."

#: ../../manual/addons/import_export/scene_gltf2.rst:1207
msgid "Option to export at collection center (at center of mass of all root objects of the collection)."
msgstr "Möjlighet att exportera vid samlingens centrum (vid masscentrum för alla rotobjekt i samlingen)."

#: ../../manual/addons/import_export/scene_gltf2.rst:1208
msgid "Custom Properties of the collection are exported as Scene glTF extras."
msgstr "Custom Properties för samlingen exporteras som Scene glTF-extramaterial."

#: ../../manual/addons/import_export/scene_gltf2.rst:1212
msgid "Contributing"
msgstr "Bidragande"

#: ../../manual/addons/import_export/scene_gltf2.rst:1214
msgid "This importer/exporter is developed through the `glTF-Blender-IO repository <https://github.com/KhronosGroup/glTF-Blender-IO>`__, where you can file bug reports, submit feature requests, or contribute code."
msgstr "Denna importör/exportör utvecklas genom `glTF-Blender-IO repository <https://github.com/KhronosGroup/glTF-Blender-IO>`__, där du kan lämna in felrapporter, skicka in funktionsförfrågningar eller bidra med kod."

#: ../../manual/addons/import_export/scene_gltf2.rst:1218
msgid "Discussion and development of the glTF 2.0 format itself takes place on the Khronos Group `glTF GitHub repository <https://github.com/KhronosGroup/glTF>`__, and feedback there is welcome."
msgstr "Diskussion och utveckling av själva glTF 2.0-formatet sker på Khronos Group `glTF GitHub repository <https://github.com/KhronosGroup/glTF>`__, och feedback där är välkommen."

