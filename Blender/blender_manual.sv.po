msgstr "Visa kantmarkeringar för Freestyle."

#: ../../manual/editors/3dview/display/overlays.rst:333
#: ../../manual/render/freestyle/view_layer/line_set.rst:204
msgid "Face Marks"
msgstr "Märken i ansiktet"

#: ../../manual/editors/3dview/display/overlays.rst:334
msgid "Display Freestyle face marks."
msgstr "Visa ansiktsmarkeringar för Freestyle."

#: ../../manual/editors/3dview/display/overlays.rst:338
