msgstr "Visa eller dölj inställningarna för det valda verktyget."

#: ../../manual/editors/image/navigating.rst:31
#: ../../manual/interface/window_system/regions.rst:180
msgid "Asset Shelf"
msgstr "Tillgångshylla"

#: ../../manual/editors/image/navigating.rst:32
