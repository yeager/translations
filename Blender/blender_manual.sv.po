msgstr "Upp :kbd:`PageUp`"

#: ../../manual/editors/nla/editing/track.rst:57
msgid "Moves the selected tracks up by one."
msgstr "Flyttar de markerade spåren ett steg uppåt."

#: ../../manual/editors/nla/editing/track.rst:58
msgid "Down :kbd:`PageDown`"
msgstr "Nedåt :kbd:`PageDown`"

#: ../../manual/editors/nla/editing/track.rst:59
