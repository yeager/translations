msgstr "Y: Upp/Ned"

#: ../../manual/editors/3dview/controls/orientation.rst:82
msgid "Z: Towards/Away from the screen"
msgstr "Z: Mot/från skärmen"

#: ../../manual/editors/3dview/controls/orientation.rst:85
msgid "Align the transformation axes to the :doc:`3D Cursor </editors/3dview/3d_cursor>`."
msgstr "Rikta in transformationsaxlarna till :doc:`3D Cursor </editors/3dview/3d_cursor>`."

#: ../../manual/editors/3dview/controls/orientation.rst:88
msgid "Align the transformation axes to the :doc:`Parent </scene_layout/object/editing/parent>`."
msgstr "Rikta in transformationsaxlarna mot :doc:`Parent </scene_layout/object/editing/parent>`."

#: ../../manual/editors/3dview/controls/orientation.rst:94
