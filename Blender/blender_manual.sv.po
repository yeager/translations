#: ../../manual/files/import_export/usd.rst:411
msgid "Convert the :doc:`world material </render/lights/world>` to a ``UsdLuxDomeLight``. Currently works for simple materials, consisting of an environment texture connected to a background shader, with an optional vector multiply of the texture color."
msgstr "Konvertera :doc:`world-materialet </render/lights/world>` till en `UsdLuxDomeLight`. Fungerar för närvarande för enkla material, bestående av en miljötextur ansluten till en bakgrundsskugga, med en valfri vektormultiplicering av texturfärgen."

#: ../../manual/files/import_export/usd.rst:415
msgid "Exports :doc:`Camera Objects </render/cameras>` Only perspective cameras are exported."
msgstr "Exporterar :doc:`Kameraobjekt </render/cameras>` Endast perspektivkameror exporteras."

#: ../../manual/files/import_export/usd.rst:418
msgid "Exports :doc:`Curve Objects </modeling/curves/index>`"
msgstr "Exporterar :doc:`Kurvobjekt </modeling/curves/index>`"

#: ../../manual/files/import_export/usd.rst:420
msgid "Exports :doc:`Point Cloud Objects </modeling/point_cloud/index>`"
msgstr "Exporterar :doc:`Point Cloud Objects </modeling/point_cloud/index>`"

#: ../../manual/files/import_export/usd.rst:422
msgid "Exports :doc:`Volume Objects </modeling/volumes/index>`"
msgstr "Exporterar :doc:`Volymobjekt </modeling/volumes/index>`"

#: ../../manual/files/import_export/usd.rst:423
#: ../../manual/files/import_export/usd.rst:588
