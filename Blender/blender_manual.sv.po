#: ../../manual/render/materials/legacy_textures/types/distorted_noise.rst:22
msgid "Amount"
msgstr "Mängd"

#: ../../manual/modeling/geometry_nodes/geometry/operations/duplicate_elements.rst:27
msgid "Field indicating how many times each input element should be duplicated. If the value is zero for an element, it will not be included in the output at all."
msgstr "Fält som anger hur många gånger varje input-element ska dupliceras. Om värdet är noll för ett element kommer det inte alls att ingå i utdata."

#: ../../manual/modeling/geometry_nodes/geometry/operations/duplicate_elements.rst:35
msgid "The type of geometry element to duplicate"
msgstr "Typ av geometrielement som ska dupliceras"

#: ../../manual/modeling/geometry_nodes/geometry/operations/duplicate_elements.rst:38
msgid "Duplicate the points of meshes, curves, or point clouds. Any other elements will not be included in the output."
msgstr "Duplicera punkterna i maskor, kurvor eller punktmoln. Alla andra element kommer inte att inkluderas i utdata."

#: ../../manual/modeling/geometry_nodes/geometry/operations/duplicate_elements.rst:41
msgid "Duplicate mesh edges. Faces will not be included in the output."
msgstr "Duplicera nätkanter. Ansikten kommer inte att inkluderas i utdata."

#: ../../manual/modeling/geometry_nodes/geometry/operations/duplicate_elements.rst:43
msgid "Duplicate mesh faces. Each duplicated face will be separate, in other words they will not share edges with other faces."
msgstr "Duplicera meshytor. Varje duplicerad yta kommer att vara separat, med andra ord kommer de inte att dela kanter med andra ytor."

#: ../../manual/modeling/geometry_nodes/geometry/operations/duplicate_elements.rst:46
msgid "Individual curves from the input curves component will be duplicated."
msgstr "Enskilda kurvor från komponenten Input Curves kommer att dupliceras."

