#: ../../manual/grease_pencil/modifiers/edit/weight_proximity.rst:41
#: ../../manual/modeling/modifiers/modify/weight_proximity.rst:59
msgid "Lowest"
msgstr "Lägsta"

#: ../../manual/grease_pencil/modifiers/edit/weight_proximity.rst:42
#: ../../manual/modeling/modifiers/modify/weight_proximity.rst:60
msgid "Distance mapping to 0.0 weight."
msgstr "Avstånd mappning till 0,0 vikt."

#: ../../manual/grease_pencil/modifiers/edit/weight_proximity.rst:43
#: ../../manual/modeling/modifiers/modify/weight_proximity.rst:61
msgid "Highest"
msgstr "Högsta"

#: ../../manual/grease_pencil/modifiers/edit/weight_proximity.rst:44
#: ../../manual/modeling/modifiers/modify/weight_proximity.rst:62
msgid "Distance mapping to 1.0 weight."
msgstr "Mappning av avstånd till 1,0 vikt."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:6
#: ../../manual/modeling/modifiers/generate/array.rst:6
msgid "Array Modifier"
msgstr "Array Modifierare"

#: ../../manual/grease_pencil/modifiers/generate/array.rst:8
msgid "The *Array* modifier creates an array of copies of the base object, with each copy being offset from the previous one in any of a number of possible ways."
msgstr "Modifieraren *Array* skapar en array av kopior av basobjektet, där varje kopia förskjuts från den föregående på något av ett antal möjliga sätt."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:11
msgid "Useful for creating complex repetitive drawings."
msgstr "Användbar för att skapa komplexa repetitiva ritningar."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:13
#: ../../manual/modeling/modifiers/generate/array.rst:16
msgid "Multiple Array modifiers may be active for an object at the same time (e.g. to create complex three-dimensional constructs)."
msgstr "Flera Array-modifierare kan vara aktiva för ett objekt samtidigt (t.ex. för att skapa komplexa tredimensionella konstruktioner)."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:18
msgid "This documentation refers to the Array Modifier specific to the Grease Pencil object. For uses with other object types refer to the general :doc:`/modeling/modifiers/generate/array`."
msgstr "Denna dokumentation hänvisar till Array Modifier som är specifik för Grease Pencil-objektet. För användning med andra objekttyper hänvisas till den allmänna :doc:`/modeling/modifiers/generate/array`."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:28
#: ../../manual/modeling/modifiers/generate/array.rst:27
msgid "The Array modifier."
msgstr "Modifieraren Array."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:31
msgid "Total number of copies."
msgstr "Totalt antal kopior."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:33
#: ../../manual/render/layers/introduction.rst:153
msgid "Material Override"
msgstr "Åsidosättande av material"

#: ../../manual/grease_pencil/modifiers/generate/array.rst:34
msgid "Index of the material to use on duplicated strokes (0 use strokes original materials)."
msgstr "Index för det material som ska användas på duplicerade slag (0 använd slag originalmaterial)."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:38
#: ../../manual/modeling/modifiers/generate/array.rst:50
msgid "Relative Offset"
msgstr "Relativ förskjutning"

#: ../../manual/grease_pencil/modifiers/generate/array.rst:40
#: ../../manual/grease_pencil/modifiers/generate/array.rst:48
msgid "Factor X, Y, Z"
msgstr "Faktor X, Y, Z"

#: ../../manual/grease_pencil/modifiers/generate/array.rst:41
#: ../../manual/modeling/modifiers/generate/array.rst:53
msgid "Adds a translation equal to the object's bounding box size along each axis, multiplied by a scaling factor, to the offset. X, Y and Z scaling factors can be specified."
msgstr "Lägger till en translation som är lika med objektets bounding box-storlek längs varje axel, multiplicerat med en skalningsfaktor, till förskjutningen. Skalningsfaktorer för X, Y och Z kan anges."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:46
#: ../../manual/modeling/modifiers/generate/array.rst:62
msgid "Constant Offset"
msgstr "Konstant Offset"

#: ../../manual/grease_pencil/modifiers/generate/array.rst:49
#: ../../manual/modeling/modifiers/generate/array.rst:65
msgid "Adds a constant translation component to the duplicate object's offset. X, Y and Z constant components can be specified."
msgstr "Lägger till en konstant translationskomponent till det duplicerade objektets offset. Konstanta X-, Y- och Z-komponenter kan anges."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:54
#: ../../manual/modeling/modifiers/generate/array.rst:70
msgid "Object Offset"
msgstr "Objekt Offset"

#: ../../manual/grease_pencil/modifiers/generate/array.rst:56
msgid "Distance X, Y, Z"
msgstr "Avstånd X, Y, Z"

#: ../../manual/grease_pencil/modifiers/generate/array.rst:57
msgid "Adds a transformation taken from an object (relative to the current object) to the offset. It is good practice to use an empty object centered or near to the initial object."
msgstr "Lägger till en transformation från ett objekt (i förhållande till det aktuella objektet) till förskjutningen. Det är bra att använda ett tomt objekt som är centrerat eller nära det ursprungliga objektet."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:65
msgid "Add random offset values to the copies."
msgstr "Lägg till slumpmässiga offsetvärden i kopiorna."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:68
msgid "Add random rotation values to the copies."
msgstr "Lägg till slumpmässiga rotationsvärden till kopiorna."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:71
msgid "Add random scale values to the copies."
msgstr "Lägg till slumpmässiga skalvärden i kopiorna."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:73
#: ../../manual/video_editing/edit/montage/strips/effects/transform.rst:43
msgid "Uniform Scale"
msgstr "Enhetlig skala"

#: ../../manual/grease_pencil/modifiers/generate/array.rst:74
msgid "Use the same random *Seed* for each scale axis in the copies for a uniform scale."
msgstr "Använd samma slumpmässiga *Seed* för varje skalaxel i kopiorna för att få en enhetlig skala."

#: ../../manual/grease_pencil/modifiers/generate/array.rst:81
msgid "The *Depth Order* used in the Grease Pencil object has an influence on the visualization of the strokes when using the Array modifier. See :doc:`Depth Order </grease_pencil/properties/strokes>` for more information."
msgstr "Den *Depth Order* som används i Grease Pencil-objektet påverkar visualiseringen av strecken när du använder Array-modifieraren. Se :doc:`Depth Order </grease_pencil/properties/strokes>` för mer information."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:6
#: ../../manual/modeling/modifiers/generate/build.rst:6
msgid "Build Modifier"
msgstr "Bygg modifierare"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:8
msgid "The *Build* modifier make strokes appear or disappear in a frame range to create the effect of animating lines being drawn or erased."
msgstr "Modifieraren *Build* gör att streck visas eller försvinner i ett bildintervall för att skapa effekten av animerade linjer som ritas eller raderas."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:13
msgid "This documentation refers to the Build Modifier specific to the Grease Pencil object. For uses with other object types refer to the general :doc:`/modeling/modifiers/generate/build`."
msgstr "Denna dokumentation hänvisar till Build Modifier som är specifik för Grease Pencil-objektet. För användning med andra objekttyper hänvisas till den allmänna :doc:`/modeling/modifiers/generate/build`."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:23
#: ../../manual/modeling/modifiers/generate/build.rst:21
msgid "The Build modifier."
msgstr "Modifieraren Build."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:26
msgid "Determines how many strokes are being animated at a time."
msgstr "Bestämmer hur många streck som animeras samtidigt."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
msgid "Sequential"
msgstr "Sekventiell"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:29
msgid "Strokes appear/disappear one after the other, but only a single one changes at a time."
msgstr "Strokes dyker upp/försvinner efter varandra, men bara en enda ändras åt gången."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
msgid "Concurrent"
msgstr "Samtidigt"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:31
msgid "Multiple stroke appear/disappear at a time."
msgstr "Flera stroke dyker upp/försvinner samtidigt."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:33
msgid "Builds only the strokes that are new compared to last keyframe. The assumption is Additive Drawing was used so that the shared strokes are the same."
msgstr "Bygger endast de streck som är nya jämfört med den senaste nyckelbilden. Antagandet är att Additive Drawing användes så att de delade strecken är likadana."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:36
msgid "Transition *(in Sequential and Concurrent Mode)*"
msgstr "Övergång *(i sekventiellt och samtidigt läge)*"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:37
msgid "Determines the animation type to build the strokes."
msgstr "Bestämmer vilken animationstyp som ska användas för att bygga stroke."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
#: ../../manual/sculpt_paint/curves_sculpting/introduction.rst:85
msgid "Grow"
msgstr "Bli större"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:40
msgid "Shows points in the order they occur in each stroke, from first to last stroke. (Simulating lines being drawn.)"
msgstr "Visar punkterna i den ordning de förekommer i varje streck, från första till sista strecket. (Simulerar linjer som ritas.)"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
#: ../../manual/interface/controls/nodes/frame.rst:21
#: ../../manual/physics/dynamic_paint/canvas.rst:241
msgid "Shrink"
msgstr "Gör mindre"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:43
msgid "Hide points from the end of each stroke to the start, from last to first stroke. (Simulating lines being erased.)"
msgstr "Dölj punkter från slutet av varje streck till början, från sista till första strecket. (Simulerar linjer som suddas ut.)"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
msgid "Vanish"
msgstr "Försvinn"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:46
msgid "Hide points in the order they occur in each stroke, from first to last stroke. (Simulating ink fading or vanishing after getting drawn.)"
msgstr "Dölj punkterna i den ordning de förekommer i varje streck, från första till sista strecket. (Simulerar bläck som bleknar eller försvinner efter att ha blivit ritat.)"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:49
#: ../../manual/physics/particles/emitter/render.rst:84
msgid "Timing"
msgstr "Tid"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:50
msgid "The way you want to time the building of the strokes."
msgstr "Det sätt du vill ta tid på byggandet av slagen."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
msgid "Natural Drawing Speed"
msgstr "Naturlig ritningshastighet"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:53
msgid "Use the recorded speed of the stylus when the strokes were drawn. Only available in Sequential and Additive Mode."
msgstr "Använd den registrerade hastigheten för pennan när strecken ritades. Endast tillgängligt i Sequential och Additive Mode."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:57
msgid "The recorded speed is multiplied by this value."
msgstr "Den registrerade hastigheten multipliceras med detta värde."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:58
msgid "Maximum Gap"
msgstr "Maximalt gap"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:59
msgid "The maximum gap between strokes in seconds."
msgstr "Det maximala avståndet mellan slag i sekunder."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
msgid "Number of Frames"
msgstr "Antal ramar"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:62
msgid "Set a fixed maximum number of frames for the build animation. (Unless another Grease Pencil keyframe occurs before this time has elapsed.)"
msgstr "Ställ in ett fast maximalt antal bildrutor för bygganimationen. (Om inte en annan Grease Pencil-keyframe inträffar innan denna tid har gått ut)"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:66
msgid "The maximum number of frames used."
msgstr "Det maximala antalet ramar som används."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:67
msgid "Delay"
msgstr "Fördröjning"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:68
msgid "Number of frames after each Grease Pencil keyframe before the modifier has any effects."
msgstr "Antal bildrutor efter varje Grease Pencil-keyframe innan modifieraren har någon effekt."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
msgid "Percentage Factor"
msgstr "Procentuell faktor"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:71
msgid "Manually set a percentage factor to control the amount of the strokes that are visible."
msgstr "Ställ in en procentuell faktor manuellt för att styra hur stor del av strecken som ska vara synliga."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:74
msgid "The factor from 0 to 1."
msgstr "Faktor från 0 till 1."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:0
msgid "Time Alignment"
msgstr "Tidsinriktning"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:77
msgid "Only available in Concurrent Mode."
msgstr "Endast tillgängligt i Concurrent Mode."

#: ../../manual/grease_pencil/modifiers/generate/build.rst:79
msgid "Align Start"
msgstr "Rikta in start"

#: ../../manual/grease_pencil/modifiers/generate/build.rst:80
