msgstr "Lägg till ett arkiv från en URL."

#: ../../manual/editors/preferences/extensions.rst:131
msgid "Add Local Repository"
msgstr "Lägg till lokal lagringsplats"

#: ../../manual/editors/preferences/extensions.rst:132
