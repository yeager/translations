msgstr "Stänger den aktiva splinten."

#: ../../manual/modeling/curves/properties/active_spline.rst:29
#: ../../manual/modeling/curves/properties/active_spline.rst:111
msgid "Default NURBS curve."
msgstr "Standard NURBS-kurva."

#: ../../manual/modeling/curves/properties/active_spline.rst:33
