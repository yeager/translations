msgid ":ref:`bpy.ops.uv.follow_active_quads`"
msgstr ":ref:`bpy.ops.uv.follow_active_quads`"

#: ../../manual/modeling/meshes/uv/editing.rst:271
msgid ":ref:`bpy.ops.uv.cube_project`"
msgstr ":ref:`bpy.ops.uv.cube_project`"

#: ../../manual/modeling/meshes/uv/editing.rst:272
msgid ":ref:`bpy.ops.uv.cylinder_project`"
msgstr ":ref:`bpy.ops.uv.cylinder_project`"

