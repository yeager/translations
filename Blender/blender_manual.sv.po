msgstr "När den är aktiverad begränsas animationsuppspelningen endast till ett bildintervall."

#: ../../manual/grease_pencil/modifiers/edit/time_offset.rst:67
msgid "Frame Start/End"
msgstr "Ram Start/Slut"

#: ../../manual/grease_pencil/modifiers/edit/time_offset.rst:68
msgid "Sets the range start and end frames."
msgstr "Ställer in start- och slutramarna för intervallet."

#: ../../manual/grease_pencil/modifiers/edit/weight_angle.rst:6
msgid "Vertex Weight Angle Modifier"
msgstr "Vertex viktvinkelmodifierare"

#: ../../manual/grease_pencil/modifiers/edit/weight_angle.rst:8
msgid "This modifier sets the weights of the given vertex group, based on a predetermined angle."
msgstr "Denna modifierare ställer in vikterna för den givna toppunktsgruppen, baserat på en förutbestämd vinkel."

#: ../../manual/grease_pencil/modifiers/edit/weight_angle.rst:13
#: ../../manual/grease_pencil/modifiers/edit/weight_proximity.rst:14
