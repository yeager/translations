msgid "The thickness is evenly split to the left and right side of the stroke geometry."
msgstr "Tjockleken är jämnt fördelad på vänster och höger sida av strokegeometrin."

#: ../../manual/render/freestyle/view_layer/line_style/thickness.rst:23
msgid "The strokes are drawn within object boundary."
msgstr "Strecken ritas inom objektgränsen."

#: ../../manual/render/freestyle/view_layer/line_style/thickness.rst:25
