msgstr "Lägger till ett Grease Pencil-objekt med ett enkelt streck som referens."

#: ../../manual/grease_pencil/primitives.rst:34
#: ../../manual/modeling/meshes/primitives.rst:221
msgid "Monkey"
msgstr "Apa"

#: ../../manual/grease_pencil/primitives.rst:36
