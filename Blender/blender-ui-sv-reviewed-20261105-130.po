#. :src: bpy.types.ActionChannelbag
msgid "Animation Channel Bag"
msgstr "Animationskanalbehållare"

#. :src: bpy.types.ActionChannelbag
msgid ""
"Collection of animation channels, typically associated with an action slot"
msgstr "Samling av animationskanaler, vanligtvis kopplade till en åtgärdsplats"

#. :src: bpy.types.ActionChannelbag.fcurves
msgid "The individual F-Curves that animate the slot"
msgstr "De enskilda F-kurvorna som animerar åtgärdsplatsen"

#. :src: bpy.types.ActionChannelbag.groups
#. :src: bpy.types.ActionChannelbagGroups
msgid "F-Curve Groups"
msgstr "F-kurvgrupper"

#. :src: bpy.types.ActionChannelbag.groups
msgid ""
"Groupings of F-Curves for display purposes, in e.g. the dopesheet and graph "
"editor"
msgstr ""
"Grupperingar av F-kurvor för visning, till exempel i exponeringsbladet och "
"grafredigeraren"

#. :src: bpy.types.ActionChannelbag.slot
msgid "The Slot that the Channelbag's animation data is for"
msgstr "Åtgärdsplatsen som behållarens animationsdata gäller"

#. :src: bpy.types.ActionChannelbagFCurves
msgid "Collection of F-Curves for a specific action slot, on a specific strip"
msgstr "Samling av F-kurvor för en specifik åtgärdsplats på en specifik remsa"

#. :src: bpy.types.ActionChannelbagGroups
msgid "Collection of f-curve groups"
msgstr "Samling av F-kurvgrupper"

#. :src: bpy.types.ActionChannelbags
msgid "Animation Channels for Slots"
msgstr "Animationskanaler för åtgärdsplatser"

#. :src: bpy.types.ActionChannelbags
msgid ""
"For each action slot, a list of animation channels that are meant for that "
"slot"
msgstr ""
"För varje åtgärdsplats: en lista över animationskanaler som är avsedda för "
"den platsen"

#. :src: bpy.types.ActionFCurves
msgid "Action F-Curves"
msgstr "F-kurvor för åtgärd"

#. :src: bpy.types.ActionFCurves
msgid ""
"Collection of action F-Curves. Note that this is a legacy API that is "
"unaware of action slots, and will only consider the F-Curves for this "
"action's first slot"
msgstr ""
"Samling av F-kurvor för åtgärd. Observera att detta är ett äldre API som "
"inte känner till åtgärdsplatser och endast beaktar F-kurvorna för åtgärdens "
"första åtgärdsplats"

#. :src: bpy.types.ActionGroup.mute
msgid "Action group is muted"
msgstr "Åtgärdsgruppen är avstängd"

#. :src: bpy.types.ActionGroup.select
msgid "Action group is selected"
msgstr "Åtgärdsgruppen är markerad"

#. :src: bpy.types.ActionGroup.show_expanded
msgid "Action group is expanded except in graph editor"
msgstr "Åtgärdsgruppen är expanderad utom i grafredigeraren"

#. :src: bpy.types.ActionGroup.show_expanded_graph
msgid "Action group is expanded in graph editor"
msgstr "Åtgärdsgruppen är expanderad i grafredigeraren"

#. :src: bpy.types.ActionGroup.use_pin
#. :src: bpy.types.AnimData.use_pin
msgid "Pin in Graph Editor"
msgstr "Fäst i grafredigeraren"

#. :src: bpy.types.ActionGroups
msgid "Action Groups"
msgstr "Åtgärdsgrupper"

#. :src: bpy.types.ActionGroups
msgid "Collection of action groups"
msgstr "Samling av åtgärdsgrupper"

#. :src: bpy.types.ActionLayers
msgid "Action Layers"
msgstr "Åtgärdslager"

#. :src: bpy.types.ActionLayers
msgid "Collection of animation layers"
msgstr "Samling av animationslager"

#. :src: bpy.types.ActionPoseMarkers
msgid "Action Pose Markers"
msgstr "Posemarkörer för åtgärd"

#. :src: bpy.types.ActionPoseMarkers.active
msgid "Active Pose Marker"
msgstr "Aktiv posemarkör"

#. :src: bpy.types.ActionPoseMarkers.active_index
msgid "Active Pose Marker Index"
msgstr "Index för aktiv posemarkör"

#. :src: bpy.types.ActionSlot
msgid "Action slot"
msgstr "Åtgärdsplats"

#. :src: bpy.types.ActionSlot.active
msgid ""
"Whether this is the active slot, can be set by assigning to "
"action.slots.active"
msgstr ""
"Anger om detta är den aktiva åtgärdsplatsen. Kan ställas in genom "
"tilldelning till action.slots.active"

#. :src: bpy.types.ActionSlot.handle
msgid "Slot Handle"
msgstr "Handtag för åtgärdsplats"

#. :src: bpy.types.ActionSlot.identifier
msgid "Slot Identifier"
msgstr "Identifierare för åtgärdsplats"

#. :src: bpy.types.ActionSlot.name_display
msgid "Slot Display Name"
msgstr "Visningsnamn för åtgärdsplats"

#. :src: bpy.types.ActionSlot.select
msgid "Selection state of the slot"
msgstr "Markeringsstatus för åtgärdsplatsen"

#. :src: bpy.types.ActionSlot.show_expanded
msgid "Expanded state of the slot"
msgstr "Expanderingsstatus för åtgärdsplatsen"

#. :src: bpy.types.ActionSlot.target_id_type
msgid ""
"Type of data-block that this slot is intended to animate; can be set when "
"'UNSPECIFIED' but is otherwise read-only"
msgstr ""
"Typ av datablock som den här åtgärdsplatsen ska animera. Kan ställas in när "
"den är ”UNSPECIFIED”, men är annars skrivskyddad"

#. :src: bpy.types.CyclesPreferences.kernel_optimization_level
msgid "Kernel Optimization"
msgstr "Kärnoptimering"

#. :src: bpy.types.CyclesPreferences.kernel_optimization_level
msgid ""
"Kernels can be optimized based on scene content. Optimized kernels are "
"requested at the start of a render. If optimized kernels are not available, "
"rendering will proceed using generic kernels until the optimized set is "
"available in the cache. This can result in additional CPU usage for a brief "
"time (tens of seconds)"
msgstr ""
"Kärnor kan optimeras utifrån sceninnehållet. Optimerade kärnor begärs i "
"början av en rendering. Om optimerade kärnor inte är tillgängliga fortsätter "
"renderingen med generiska kärnor tills den optimerade uppsättningen finns i "
"cacheminnet. Detta kan medföra extra CPU-användning under en kort tid "
"(tiotals sekunder)"

#. :src: bpy.types.CyclesPreferences.kernel_optimization_level:'OFF'
msgid ""
"Disable kernel optimization. Slowest rendering, no extra background CPU usage"
msgstr ""
"Inaktivera kärnoptimering. Långsammaste renderingen, ingen extra CPU-"
"användning i bakgrunden"

#. :src: bpy.types.CyclesPreferences.kernel_optimization_level:'INTERSECT'
msgid "Intersection only"
msgstr "Endast skärningsberäkning"

#. :src: bpy.types.CyclesPreferences.kernel_optimization_level:'INTERSECT'
msgid ""
"Optimize only intersection kernels. Faster rendering, negligible extra "
"background CPU usage"
msgstr ""
"Optimera endast kärnor för skärningsberäkning. Snabbare rendering, försumbar "
"extra CPU-användning i bakgrunden"

#. :src: bpy.types.CyclesPreferences.kernel_optimization_level:'FULL'
msgid ""
"Optimize all kernels. Fastest rendering, may result in extra background CPU "
"usage"
msgstr ""
"Optimera alla kärnor. Snabbaste renderingen, kan medföra extra CPU-"
"användning i bakgrunden"

#. :src: bpy.types.CyclesPreferences.metalrt
msgid "MetalRT"
msgstr "MetalRT"

#. :src: bpy.types.CyclesPreferences.metalrt:'ON'
msgid "Enable MetalRT for intersection queries"
msgstr "Aktivera MetalRT för skärningsfrågor"

#. :src: bpy.types.CyclesPreferences.metalrt:'AUTO'
msgid "Automatically pick the fastest intersection method"
msgstr "Välj automatiskt den snabbaste skärningsmetoden"

#. :src: bpy.types.CyclesPreferences.use_oneapirt
msgid ""
"Embree on GPU enables the use of hardware ray tracing on Intel GPUs, "
"providing better overall performance"
msgstr ""
"Embree på GPU möjliggör hårdvarustrålspårning på Intel-GPU:er och ger bättre "
"övergripande prestanda"

#. :src: bpy.types.GLTF_AddonPreferences.KHR_materials_variants_ui
msgid "KHR_materials_variants_ui"
msgstr "KHR_materials_variants_ui"

#. :src: bpy.types.GLTF_AddonPreferences.KHR_materials_variants_ui
msgid "Displays glTF UI to manage material variants"
msgstr "Visar glTF-gränssnittet för att hantera materialvarianter"

#. :src: bpy.types.GLTF_AddonPreferences.allow_embedded_format
#: scripts/addons_core/io_scene_gltf2/__init__.py:2158
msgid "Allow glTF Embedded format"
msgstr "Tillåt inbäddat glTF-format"

#. :src: bpy.types.GLTF_AddonPreferences.animation_ui
msgid "Display glTF UI to manage animations"
msgstr "Visa glTF-gränssnittet för att hantera animeringar"

#. :src: bpy.types.GLTF_AddonPreferences.gltfpack_path_ui
msgid "glTFpack file path"
msgstr "Sökväg till glTFpack-fil"

#. :src: bpy.types.GLTF_AddonPreferences.gltfpack_path_ui
msgid "Path to gltfpack binary"
msgstr "Sökväg till binärfilen glTFpack"

#. :src: bpy.types.NWNodeWrangler.merge_hide
msgid ""
"When merging nodes with the Ctrl+Numpad0 hotkey (and similar) specify "
"whether to collapse them or show the full node with options expanded"
msgstr ""
"När noder sammanfogas med snabbtangenten Ctrl+Numpad0 (och liknande) anger "
"du om de ska fällas ihop eller visas helt med expanderade alternativ"

#. :src: bpy.types.NWNodeWrangler.merge_hide:'ALWAYS'
msgid "Always collapse the new merge nodes"
msgstr "Fäll alltid ihop de nya sammanfogningsnoderna"

#. :src: bpy.types.NWNodeWrangler.merge_hide:'NON_SHADER'
msgid "Non-Shader"
msgstr "Icke-shader"

#. :src: bpy.types.NWNodeWrangler.merge_hide:'NON_SHADER'
msgid "Collapse in all cases except for shaders"
msgstr "Fäll ihop i alla fall utom för shaders"

#. :src: bpy.types.NWNodeWrangler.merge_hide:'NEVER'
msgid "Never collapse the new merge nodes"
msgstr "Fäll aldrig ihop de nya sammanfogningsnoderna"

#. :src: bpy.types.NWNodeWrangler.merge_position
msgid "Mix Node Position"
msgstr "Mix-nodens position"

#. :src: bpy.types.NWNodeWrangler.merge_position
msgid ""
"When merging nodes with the Ctrl+Numpad0 hotkey (and similar) specify the "
"position of the new nodes"
msgstr ""
"När noder sammanfogas med snabbtangenten Ctrl+Numpad0 (och liknande) anger "
"du positionen för de nya noderna"

#. :src: bpy.types.NWNodeWrangler.show_principled_lists
msgid "Show Principled naming tags"
msgstr "Visa namntaggar för Principled"

#. :src: bpy.types.NWNodeWrangler.show_principled_lists
msgid ""
"Expand this box into a list of all naming tags for principled texture setup"
msgstr ""
"Expandera rutan till en lista över alla namntaggar för Principled-"
"texturinställning"

#. :src: bpy.types.UI_AP_i18n_settings.FRIBIDI_LIB
msgid "Fribidi Library"
msgstr "FriBidi-bibliotek"

#. :src: bpy.types.UI_AP_i18n_settings.FRIBIDI_LIB
msgid ""
"The FriBidi C compiled library (.so under Linux, .dll under windows...), "
"you’ll likely have to edit it if you’re under Windows, e.g. using the one "
"included in Blender libraries repository"
msgstr ""
"Det kompilerade C-biblioteket FriBidi (.so i Linux, .dll i Windows …). I "
"Windows behöver du sannolikt redigera den här inställningen, till exempel "
"med versionen som ingår i Blenders biblioteksarkiv"

#. :src: bpy.types.UI_AP_i18n_settings.I18N_DIR
msgid "The bf-translation repository"
msgstr "Förrådet bf-translation"

#. :src: bpy.types.UI_AP_i18n_settings.SOURCE_DIR
msgid "Source Root"
msgstr "Källrot"

#. :src: bpy.types.UI_AP_i18n_settings.SOURCE_DIR
msgid "The Blender source root path"
msgstr "Sökvägen till rotkatalogen för Blender-källkoden"

#. :src: bpy.types.UI_AP_i18n_settings.SPELL_CACHE
msgid "Spell Cache"
msgstr "Stavningscache"

#. :src: bpy.types.UI_AP_i18n_settings.SPELL_CACHE
msgid "A cache storing validated msgids, to avoid re-spellchecking them"
msgstr ""
"En cache som lagrar validerade msgid för att undvika att "
"stavningskontrollera dem igen"

#. :src: bpy.types.UI_AP_i18n_settings.WARN_MSGID_NOT_CAPITALIZED
msgid "Warn Msgid Not Capitalized"
msgstr "Varna om msgid saknar inledande versal"

#. :src: bpy.types.UI_AP_i18n_settings.WARN_MSGID_NOT_CAPITALIZED
msgid ""
"Warn about messages not starting by a capitalized letter (with a few allowed "
"exceptions!)"
msgstr ""
"Varna för meddelanden som inte börjar med versal (med några få tillåtna "
"undantag!)"

#. :src: bpy.types.UI_AP_i18n_settings.persistent_data_path
msgid "Persistent Data Path"
msgstr "Sökväg till beständiga data"

#. :src: bpy.types.UI_AP_i18n_settings.persistent_data_path
msgid ""
"The name of a json file storing those settings (unfortunately, Blender's "
"system does not work here)"
msgstr ""
"Namnet på JSON-filen som lagrar de här inställningarna (Blenders system "
"fungerar tyvärr inte här)"
