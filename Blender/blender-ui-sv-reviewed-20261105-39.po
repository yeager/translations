#. :src: bpy.types.Bone.use_scale_easing
#. :src: bpy.types.EditBone.use_scale_easing
msgid "Scale Easing"
msgstr "Skalutjämning"

#. :src: bpy.types.Bone.use_scale_easing
#. :src: bpy.types.EditBone.use_scale_easing
msgid "Multiply the final easing values by the Scale In/Out Y factors"
msgstr "Multiplicera de slutliga utjämningsvärdena med Y-faktorerna för Skala in/ut"

#. :src: bpy.types.BoneCollection
msgid "Bone collection in an Armature data-block"
msgstr "Bensamling i ett riggskelettdatablock"

#. :src: bpy.types.BoneCollection.bones
msgid "Bones assigned to this bone collection. In armature edit mode this will always return an empty list of bones, as the bone collection memberships are only synchronized when exiting edit mode."
msgstr "Ben som tilldelats denna bensamling. I riggskelettets redigeringsläge returneras alltid en tom benlista eftersom medlemskap i bensamlingar synkroniseras först när redigeringsläget avslutas."
