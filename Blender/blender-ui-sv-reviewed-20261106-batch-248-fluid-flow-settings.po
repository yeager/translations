#. :src: bpy.types.FluidEffectorSettings.subframes
#. :src: bpy.types.FluidFlowSettings.subframes
#. :src: bpy.types.ParticleSettings.subframes
#: scripts/startup/bl_ui/space_time.py:266
msgid "Subframes"
msgstr "Delbildrutor"

#. :src: bpy.types.FluidEffectorSettings.subframes
msgid ""
"Number of additional samples to take between frames to improve quality of "
"fast moving effector objects"
msgstr ""
"Antal extra provtagningar mellan bildrutorna för att förbättra kvaliteten på "
"snabbt rörliga effektorobjekt"

#. :src: bpy.types.FluidEffectorSettings.surface_distance
msgid "Additional distance around mesh surface to consider as effector"
msgstr "Ytterligare avstånd runt meshytan som räknas som effektor"

#. :src: bpy.types.FluidEffectorSettings.use_plane_init
#. :src: bpy.types.FluidFlowSettings.use_plane_init
#: scripts/startup/bl_ui/properties_physics_fluid.py:559
#: scripts/startup/bl_ui/properties_physics_fluid.py:287
msgid "Is Planar"
msgstr "Är plan"

#. :src: bpy.types.FluidFlowSettings.flow_type:'LIQUID'
msgid "Add liquid"
msgstr "Lägg till vätska"

#. :src: bpy.types.FluidFlowSettings.particle_system
#. :src: bpy.types.Object.particle_systems
msgid "Particle systems emitted from the object"
msgstr "Partikelsystem som avges från objektet"

#. :src: bpy.types.FluidFlowSettings.subframes
msgid ""
"Number of additional samples to take between frames to improve quality of "
"fast moving flows"
msgstr ""
"Antal extra provtagningar mellan bildrutorna för att förbättra kvaliteten på "
"snabba flöden"

#. :src: bpy.types.FluidFlowSettings.surface_distance
#: scripts/startup/bl_ui/properties_physics_fluid.py:560
msgid "Surface Emission"
msgstr "Ytemission"

#. :src: bpy.types.FluidFlowSettings.surface_distance
msgid ""
"Controls fluid emission from the mesh surface (higher value results in "
"emission further away from the mesh surface"
msgstr ""
"Styr vätskeemission från meshytan (högre värde ger emission längre bort från "
"meshytan)"

#. :src: bpy.types.FluidFlowSettings.use_absolute
msgid "Only allow given density value in emitter area and will not add up"
msgstr ""
"Tillåter endast det angivna densitetsvärdet i emitterområdet; värden adderas "
"inte"

#. :src: bpy.types.FluidFlowSettings.use_inflow
msgid "Control when to apply fluid flow"
msgstr "Styr när vätskeflödet ska användas"

#. :src: bpy.types.FluidFlowSettings.velocity_coord
msgid ""
"Additional initial velocity in X, Y and Z direction (added to source "
"velocity)"
msgstr ""
"Ytterligare initialhastighet i X-, Y- och Z-riktning (läggs till "
"källhastigheten)"

#. :src: bpy.types.FluidFlowSettings.velocity_factor
msgid ""
"Multiplier of source velocity passed to fluid (source velocity is non-zero "
"only if object is moving)"
msgstr ""
"Multiplikator för källhastigheten som överförs till vätskan (källhastigheten "
"är endast skild från noll när objektet rör sig)"

#. :src: bpy.types.FluidFlowSettings.velocity_random
msgid "Amount of random velocity"
msgstr "Slumphastighetens storlek"
