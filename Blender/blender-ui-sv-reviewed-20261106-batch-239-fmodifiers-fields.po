#. :src: bpy.types.FModifierNoise.use_legacy_noise
msgid "Legacy Noise"
msgstr "Äldre brus"

#. :src: bpy.types.FModifierNoise.use_legacy_noise
msgid ""
"Use the legacy way of generating noise. Has the issue that it can produce "
"values outside of -1/1"
msgstr ""
"Använd den äldre metoden för att generera brus. Den kan skapa värden utanför "
"-1/1"

#. :src: bpy.types.FModifierStepped
msgid ""
"Hold each interpolated value from the F-Curve for several frames without "
"changing the timing"
msgstr ""
"Behåll varje interpolerat värde från F-kurvan i flera bildrutor utan att "
"ändra tidpunkterna"

#. :src: bpy.types.FModifierStepped.use_frame_end
msgid "Restrict modifier to only act before its 'end' frame"
msgstr "Begränsa modifieraren så att den endast verkar före sin slutbildruta"

#. :src: bpy.types.FModifierStepped.use_frame_start
msgid "Restrict modifier to only act after its 'start' frame"
msgstr "Begränsa modifieraren så att den endast verkar efter sin startbildruta"

#. :src: bpy.types.FieldSettings.falloff_power
msgid "Falloff Power"
msgstr "Avtagandeexponent"

#. :src: bpy.types.FieldSettings.linear_drag
msgid "Linear Drag"
msgstr "Linjärt motstånd"

#. :src: bpy.types.FieldSettings.linear_drag
msgid "Drag component proportional to velocity"
msgstr "Motståndskomponent som är proportionell mot hastigheten"

#. :src: bpy.types.FieldSettings.noise
msgid "Amount of noise for the force strength"
msgstr "Mängden brus för kraftens styrka"

#. :src: bpy.types.FieldSettings.quadratic_drag
msgid "Quadratic Drag"
msgstr "Kvadratiskt motstånd"

#. :src: bpy.types.FieldSettings.quadratic_drag
msgid "Drag component proportional to the square of velocity"
msgstr "Motståndskomponent som är proportionell mot hastighetens kvadrat"

#. :src: bpy.types.FieldSettings.radial_falloff
msgid "Radial Falloff Power"
msgstr "Radiell avtagandeexponent"

#. :src: bpy.types.FieldSettings.radial_falloff
msgid "Radial falloff power (real gravitational falloff = 2)"
msgstr "Radiell avtagandeexponent (verkligt gravitationsavtagande = 2)"

#. :src: bpy.types.FieldSettings.radial_min
msgid "Minimum radial distance for the field's falloff"
msgstr "Minsta radiella avstånd för fältets avtagande"
