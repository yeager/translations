#. :src: bpy.types.BrushGpencilSettings.eraser_mode:'SOFT'
#. :src: bpy.types.GREASE_PENCIL_OT_dissolve.type:'POINTS'
msgctxt "GPencil"
msgid "Dissolve"
msgstr "Lös upp"

#. :src: bpy.types.BrushGpencilSettings.eraser_mode:'SOFT'
msgid "Erase strokes, fading their points strength and thickness"
msgstr "Radera streck genom att tona ned punkternas styrka och tjocklek"

#. :src: bpy.types.BrushGpencilSettings.eraser_mode:'HARD'
msgctxt "GPencil"
msgid "Point"
msgstr "Punkt"

#. :src: bpy.types.BrushGpencilSettings.eraser_mode:'HARD'
msgid "Erase stroke points"
msgstr "Radera streckpunkter"

#. :src: bpy.types.BrushGpencilSettings.eraser_mode:'STROKE'
msgctxt "GPencil"
msgid "Stroke"
msgstr "Streck"

#. :src: bpy.types.BrushGpencilSettings.eraser_mode:'STROKE'
msgid "Erase entire strokes"
msgstr "Radera hela streck"

#. :src: bpy.types.BrushGpencilSettings.eraser_strength_factor
msgid "Affect Stroke Strength"
msgstr "Påverka streckstyrkan"

#. :src: bpy.types.BrushGpencilSettings.eraser_strength_factor
msgid "Amount of erasing for strength"
msgstr "Grad av radering av styrkan"

#. :src: bpy.types.BrushGpencilSettings.eraser_thickness_factor
msgid "Affect Stroke Thickness"
msgstr "Påverka strecktjockleken"

#. :src: bpy.types.BrushGpencilSettings.eraser_thickness_factor
msgid "Amount of erasing for thickness"
msgstr "Grad av radering av tjockleken"

#. :src: bpy.types.BrushGpencilSettings.extend_stroke_factor
msgid "Closure Size"
msgstr "Storlek för slutning"

#. :src: bpy.types.BrushGpencilSettings.extend_stroke_factor
msgid "Strokes end extension for closing gaps, use zero to disable"
msgstr "Förlängning av streckens ändar för att stänga glapp; ange 0 för att inaktivera"

#. :src: bpy.types.BrushGpencilSettings.fill_direction:'NORMAL'
msgid "Fill internal area"
msgstr "Fyll det inre området"

#. :src: bpy.types.BrushGpencilSettings.fill_direction:'INVERT'
msgctxt "Brush"
msgid "Inverted"
msgstr "Omvänt"

#. :src: bpy.types.BrushGpencilSettings.fill_direction:'INVERT'
msgid "Fill inverted area"
msgstr "Fyll det omvända området"

#. :src: bpy.types.BrushGpencilSettings.fill_draw_mode
msgid "Mode to draw boundary limits"
msgstr "Läge för att rita gränser för fyllning"

#. :src: bpy.types.BrushGpencilSettings.fill_draw_mode:'CONTROL'
msgid "Edit Lines"
msgstr "Redigeringslinjer"

#. :src: bpy.types.BrushGpencilSettings.fill_extend_mode
msgctxt "GPencil"
msgid "Closure Mode"
msgstr "Slutningsläge"

#. :src: bpy.types.BrushGpencilSettings.fill_extend_mode
msgid "Types of stroke extensions used for closing gaps"
msgstr "Typer av streckförlängningar som används för att stänga glapp"

#. :src: bpy.types.BrushGpencilSettings.fill_extend_mode:'EXTEND'
msgctxt "GPencil"
msgid "Extend"
msgstr "Förläng"

#. :src: bpy.types.BrushGpencilSettings.fill_extend_mode:'EXTEND'
msgid "Extend strokes in straight lines"
msgstr "Förläng streck i raka linjer"
