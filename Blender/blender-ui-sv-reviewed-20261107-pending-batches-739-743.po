#. :src: bpy.types.Brush.gpencil_sculpt_brush_type:'STRENGTH'
msgid "Adjust color strength of strokes"
msgstr "Justera streckens färgstyrka"

#. :src: bpy.types.Brush.gpencil_sculpt_brush_type:'THICKNESS'
msgid "Adjust thickness of strokes"
msgstr "Justera streckens tjocklek"

#. :src: bpy.types.AnnotationStrokePoints
msgid "Annotation Stroke Points"
msgstr "Anteckningsstreckpunkter"

#. :src: bpy.types.AnnotationStrokes
msgid "Annotation Strokes"
msgstr "Anteckningsstreck"

#. :src: bpy.types.BrushGpencilSettings.use_auto_remove_fill_guides
msgid "Automatically remove fill guide strokes after fill operation"
msgstr "Ta bort fyllningshjälplinjers streck automatiskt efter fyllningen"

#. :src: bpy.types.AnnotationStrokePoints
msgid "Collection of annotation stroke points"
msgstr "Samling av anteckningsstreckpunkter"

#. :src: bpy.types.AnnotationStrokes
msgid "Collection of annotation strokes"
msgstr "Samling av anteckningsstreck"

#. :src: bpy.types.AnnotationStroke.display_mode
msgid "Coordinate space that stroke is in"
msgstr "Koordinatrymd för strecket"

#. :src: bpy.types.Modifier.type:'MESH_SEQUENCE_CACHE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_SEQUENCE_CACHE'
msgid "Deform the mesh or curve using an external mesh cache in Alembic format"
msgstr ""
"Deformera meshen eller kurvan med hjälp av en extern mesh-cache i Alembic-"
"format"

#. :src: bpy.types.BrushGpencilSettings.show_lasso
msgid "Display fill color while drawing the stroke"
msgstr "Visa fyllningsfärgen medan strecket ritas"

#. :src: bpy.types.OUTLINER_OT_material_drop
msgid "Drag material to object in Outliner"
msgstr "Dra material till objekt i Outliner"

#. :src: bpy.types.OUTLINER_OT_scene_drop
msgid "Drag object to scene in Outliner"
msgstr "Dra objektet till scenen i Outliner"

#. :src: bpy.types.OUTLINER_OT_parent_clear
msgid "Drag to clear parent in Outliner"
msgstr "Dra för att rensa förälder i Outliner"

#. :src: bpy.types.OUTLINER_OT_collection_drop
msgid "Drag to move to collection in Outliner"
msgstr "Dra för att flytta till samling i Outliner"

#. :src: bpy.types.OUTLINER_OT_parent_drop
msgid "Drag to parent in Outliner"
msgstr "Dra för att ange förälder i Outliner"

#. :src: bpy.types.MeshCacheModifier.deform_mode:'INTEGRATE'
msgid ""
"Integrate deformation from this modifier's input with the mesh-cache "
"coordinates (useful for shape keys)"
msgstr ""
"Integrera deformation från denna modifierares indata med mesh-"
"cachekoordinaterna (användbart för formnycklar)"

#. :src: bpy.types.BrushGpencilSettings.stroke_type
msgid "Mode to use when creating strokes"
msgstr "Läge att använda när streck skapas"

