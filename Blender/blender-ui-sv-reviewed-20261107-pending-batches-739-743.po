#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'BOTH'
msgid "Painting affects both strokes and fills"
msgstr "Målning påverkar både streck och fyllningar"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'FILL'
msgid "Painting affects only fills, not strokes"
msgstr "Målning påverkar endast fyllningar, inte streck"

#. :src: bpy.types.BrushGpencilSettings.vertex_mode:'STROKE'
msgid "Painting affects only strokes, not fills"
msgstr "Målning påverkar endast streck, inte fyllningar"

#. :src: bpy.types.Brush.gpencil_sculpt_brush_type:'CLONE'
msgid "Paste copies of the strokes stored on the internal clipboard"
msgstr "Klistra in kopior av strecken som lagras i det interna urklippet"

#. :src: bpy.types.NodeSocket.is_inactive
msgid ""
"Socket is grayed out because it has been detected to not have any effect on "
"the output"
msgstr ""
"Uttaget är gråmarkerat eftersom det har konstaterats att det inte har någon "
"effekt på utdatan"

#. :src: bpy.types.BrushGpencilSettings.stroke_type
msgctxt "GPencil"
msgid "Stroke Mode"
msgstr "Streckläge"

#. :src: bpy.types.AnnotationStroke.display_mode:'2DIMAGE'
msgid "Stroke is in 2D image/UV space"
msgstr "Strecket är i 2D-bild-/UV-rymden"

#. :src: bpy.types.AnnotationStroke.display_mode:'2DSPACE'
msgid "Stroke is in 2D space, locked to the camera view"
msgstr "Strecket är i 2D-rymden och låst till kameravyn"

#. :src: bpy.types.AnnotationStroke.display_mode:'3DSPACE'
msgid "Stroke is in 3D space"
msgstr "Strecket är i 3D-rymden"

#. :src: bpy.types.Brush.gpencil_brush_type:'DRAW'
msgid "The brush is of type used for drawing strokes"
msgstr "Penseltypen används för att rita streck"

#. :src: bpy.types.Brush.gpencil_brush_type:'ERASE'
msgid "The brush is used for erasing strokes"
msgstr "Penseln används för att radera streck"

#. :src: bpy.types.BrushGpencilSettings.caps_type
msgid "The shape of the start and end of the stroke"
msgstr "Formen på streckets början och slut"

#. :src: bpy.types.OUTLINER_OT_select_all
msgid "Toggle the Outliner selection of items"
msgstr "Växla markering av objekt i Outliner"

#. :src: bpy.types.RemeshModifier.sharpness
msgid ""
"Tolerance for outliers; lower values filter noise while higher values will "
"reproduce edges closer to the input"
msgstr ""
"Tolerans för avvikande värden; lägre värden filtrerar bort brus medan högre "
"värden återger kanter som ligger närmare inmatningsmeshen"
