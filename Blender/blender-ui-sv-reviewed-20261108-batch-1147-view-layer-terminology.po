#. :src: bpy.types.ShaderNodeAttribute.attribute_type:'VIEW_LAYER'
msgid ""
"The attribute is associated with the View Layer, Scene or World that is "
"being rendered"
msgstr ""
"Attributet är kopplat till visningslagret, scenen eller världen som renderas"

#. :src: bpy.types.CYCLES_OT_denoise_animation
msgid ""
"Denoise rendered animation sequence using current scene and view layer "
"settings. Requires denoising data passes and output to OpenEXR multilayer "
"files"
msgstr ""
"Brusreducera den renderade animationssekvensen med den aktuella scenens och "
"visningslagrets inställningar. Kräver datakanaler för brusreducering och "
"utdata till OpenEXR-flerlagerfiler"

#. :src: bpy.types.IMAGE_OT_read_viewlayers
msgid "Read all the current scene's view layers from cache, as needed"
msgstr ""
"Läs vid behov in alla visningslager för den aktuella scenen från cacheminnet"

#. :src: bpy.types.NODE_OT_read_viewlayers
msgctxt "Operator"
msgid "Read View Layers"
msgstr "Läs visningslager"

#. :src: bpy.types.OUTLINER_OT_collection_disable
msgid "Disable viewport display in the view layers"
msgstr "Inaktivera visning i vyporten i visningslagren"

#. :src: bpy.types.OUTLINER_OT_collection_enable
msgid "Enable viewport display in the view layers"
msgstr "Aktivera visning i vyporten i visningslagren"

#. :src: bpy.types.OUTLINER_OT_collection_exclude_clear
msgctxt "Operator"
msgid "Enable in View Layer"
msgstr "Aktivera i visningslager"

#. :src: bpy.types.OUTLINER_OT_collection_exclude_clear
msgid "Include collection in the active view layer"
msgstr "Inkludera samlingen i det aktiva visningslagret"

#. :src: bpy.types.OUTLINER_OT_collection_exclude_set
msgctxt "Operator"
msgid "Disable from View Layer"
msgstr "Inaktivera från visningslager"

#. :src: bpy.types.OUTLINER_OT_collection_exclude_set
msgid "Exclude collection from the active view layer"
msgstr "Uteslut samlingen från det aktiva visningslagret"

#. :src: bpy.types.OUTLINER_OT_collection_hide
msgid "Hide the collection in this view layer"
msgstr "Dölj samlingen i det här visningslagret"

#. :src: bpy.types.OUTLINER_OT_collection_holdout_clear
msgid "Clear masking of collection in the active view layer"
msgstr "Rensa maskeringen av samlingen i det aktiva visningslagret"

#. :src: bpy.types.OUTLINER_OT_collection_holdout_set
msgid "Mask collection in the active view layer"
msgstr "Maskera samlingen i det aktiva visningslagret"

#. :src: bpy.types.OUTLINER_OT_collection_indirect_only_clear
msgid "Clear collection contributing only indirectly in the view layer"
msgstr "Rensa samlingens indirekta bidrag i visningslagret"

#. :src: bpy.types.OUTLINER_OT_collection_indirect_only_set
msgid ""
"Set collection to only contribute indirectly (through shadows and "
"reflections) in the view layer"
msgstr ""
"Låt samlingen bara bidra indirekt (genom skuggor och reflektioner) i "
"visningslagret"

#. :src: bpy.types.OUTLINER_OT_collection_show
msgid "Show the collection in this view layer"
msgstr "Visa samlingen i det här visningslagret"

#. :src: bpy.types.SCENE_OT_view_layer_add
msgctxt "Operator"
msgid "Add View Layer"
msgstr "Lägg till visningslager"

#. :src: bpy.types.SCENE_OT_view_layer_add
msgid "Add a view layer"
msgstr "Lägg till ett visningslager"

#. :src: bpy.types.SCENE_OT_view_layer_add.type:'NEW'
msgid "Add a new view layer"
msgstr "Lägg till ett nytt visningslager"

#. :src: bpy.types.SCENE_OT_view_layer_add.type:'COPY'
msgid "Copy settings of current view layer"
msgstr "Kopiera inställningarna för det aktuella visningslagret"

#. :src: bpy.types.SCENE_OT_view_layer_add.type:'EMPTY'
msgid "Add a new view layer with all collections disabled"
msgstr "Lägg till ett nytt visningslager med alla samlingar inaktiverade"

#. :src: bpy.types.SCENE_OT_view_layer_remove
msgctxt "Operator"
msgid "Remove View Layer"
msgstr "Ta bort visningslager"

#. :src: bpy.types.SCENE_OT_view_layer_remove
msgid "Remove the selected view layer"
msgstr "Ta bort det valda visningslagret"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples
msgid "How to use per view layer sample settings"
msgstr "Hur inställningarna för sampel per visningslager används"

#. :src: bpy.types.SpaceOutliner.display_mode:'VIEW_LAYER'
msgid "Display collections and objects in the view layer"
msgstr "Visa samlingar och objekt i visningslagret"

#. :src: bpy.types.SpaceProperties.context:'VIEW_LAYER'
msgid "View Layer Properties"
msgstr "Egenskaper för visningslager"
