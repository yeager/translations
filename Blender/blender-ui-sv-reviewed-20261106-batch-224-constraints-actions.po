#. :src: bpy.types.Constraint.type:'COPY_ROTATION'
#. :src: bpy.types.POSE_OT_constraint_add.type:'COPY_ROTATION'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'COPY_ROTATION'
msgid ""
"Copy the rotation of a target (with an optional offset), so that they rotate "
"together"
msgstr ""
"Kopiera ett måls rotation (med en valfri förskjutning), så att de roterar "
"tillsammans"

#. :src: bpy.types.Constraint.type:'COPY_SCALE'
#. :src: bpy.types.POSE_OT_constraint_add.type:'COPY_SCALE'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'COPY_SCALE'
msgid ""
"Copy the scale factors of a target (with an optional offset), so that they "
"are scaled by the same amount"
msgstr ""
"Kopiera ett måls skalfaktorer (med en valfri förskjutning), så att de skalas "
"lika mycket"

#. :src: bpy.types.Constraint.type:'COPY_TRANSFORMS'
#. :src: bpy.types.POSE_OT_constraint_add.type:'COPY_TRANSFORMS'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'COPY_TRANSFORMS'
msgid "Copy all the transformations of a target, so that they move together"
msgstr ""
"Kopiera alla transformationer från ett mål, så att de rör sig tillsammans"

#. :src: bpy.types.Constraint.type:'LIMIT_DISTANCE'
#. :src: bpy.types.POSE_OT_constraint_add.type:'LIMIT_DISTANCE'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'LIMIT_DISTANCE'
#: source/blender/blenkernel/intern/constraint.cc:3411
#: source/blender/editors/uvedit/uvedit_smart_stitch.cc:293
msgid "Limit Distance"
msgstr "Avståndsbegränsning"

#. :src: bpy.types.Constraint.type:'LIMIT_DISTANCE'
#. :src: bpy.types.POSE_OT_constraint_add.type:'LIMIT_DISTANCE'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'LIMIT_DISTANCE'
msgid ""
"Restrict movements to within a certain distance of a target (at the time of "
"constraint evaluation only)"
msgstr ""
"Begränsa rörelserna till ett visst avstånd från ett mål (endast när "
"begränsningen utvärderas)"

#. :src: bpy.types.Constraint.type:'LIMIT_LOCATION'
#. :src: bpy.types.POSE_OT_constraint_add.type:'LIMIT_LOCATION'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'LIMIT_LOCATION'
#: source/blender/blenkernel/intern/constraint.cc:1674
msgid "Limit Location"
msgstr "Positionsbegränsning"

#. :src: bpy.types.Constraint.type:'LIMIT_ROTATION'
#. :src: bpy.types.POSE_OT_constraint_add.type:'LIMIT_ROTATION'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'LIMIT_ROTATION'
#: source/blender/blenkernel/intern/constraint.cc:1821
msgid "Limit Rotation"
msgstr "Rotationsbegränsning"

#. :src: bpy.types.Constraint.type:'LIMIT_SCALE'
#. :src: bpy.types.POSE_OT_constraint_add.type:'LIMIT_SCALE'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'LIMIT_SCALE'
#: source/blender/blenkernel/intern/constraint.cc:1877
msgid "Limit Scale"
msgstr "Skalbegränsning"

#. :src: bpy.types.Constraint.type:'MAINTAIN_VOLUME'
#. :src: bpy.types.StretchToConstraint.volume
#. :src: bpy.types.POSE_OT_constraint_add.type:'MAINTAIN_VOLUME'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'MAINTAIN_VOLUME'
#: source/blender/blenkernel/intern/constraint.cc:2456
msgid "Maintain Volume"
msgstr "Behåll volym"

#. :src: bpy.types.Constraint.type:'TRANSFORM'
#. :src: bpy.types.POSE_OT_constraint_add.type:'TRANSFORM'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'TRANSFORM'
#: source/blender/blenkernel/intern/constraint.cc:4144
msgid "Transformation"
msgstr "Transformation"

#. :src: bpy.types.Constraint.type:'CLAMP_TO'
#. :src: bpy.types.POSE_OT_constraint_add.type:'CLAMP_TO'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'CLAMP_TO'
#: source/blender/blenkernel/intern/constraint.cc:3935
msgid "Clamp To"
msgstr "Begränsa till"

#. :src: bpy.types.Constraint.type:'CLAMP_TO'
#. :src: bpy.types.POSE_OT_constraint_add.type:'CLAMP_TO'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'CLAMP_TO'
msgid ""
"Restrict movements to lie along a curve by remapping location along curve's "
"longest axis"
msgstr ""
"Begränsa förflyttningar till en kurva genom att mappa om positionen längs "
"kurvans längsta axel"

#. :src: bpy.types.Constraint.type:'LOCKED_TRACK'
#. :src: bpy.types.POSE_OT_constraint_add.type:'LOCKED_TRACK'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'LOCKED_TRACK'
#: source/blender/blenkernel/intern/constraint.cc:3269
msgid "Locked Track"
msgstr "Låst spårning"

#. :src: bpy.types.Constraint.type:'SPLINE_IK'
#. :src: bpy.types.POSE_OT_constraint_add.type:'SPLINE_IK'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'SPLINE_IK'
#: source/blender/blenkernel/intern/constraint.cc:4642
msgid "Spline IK"
msgstr "Spline-IK"

#. :src: bpy.types.Constraint.type:'STRETCH_TO'
#. :src: bpy.types.POSE_OT_constraint_add.type:'STRETCH_TO'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'STRETCH_TO'
#: source/blender/blenkernel/intern/constraint.cc:3619
msgid "Stretch To"
msgstr "Sträck ut"

#. :src: bpy.types.Constraint.type:'ACTION'
#. :src: bpy.types.POSE_OT_constraint_add.type:'ACTION'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'ACTION'
msgid ""
"Use transform property of target to look up pose for owner from an Action"
msgstr ""
"Använd en transformationsegenskap från målet för att slå upp ägarens pose i "
"en Action"

#. :src: bpy.types.Constraint.type:'ARMATURE'
#. :src: bpy.types.POSE_OT_constraint_add.type:'ARMATURE'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'ARMATURE'
msgid ""
"Apply weight-blended transformation from multiple bones like the Armature "
"modifier"
msgstr ""
"Tillämpa viktblandad transformation från flera ben, liksom modifieraren "
"Armatur"

#. :src: bpy.types.Constraint.type:'PIVOT'
#. :src: bpy.types.POSE_OT_constraint_add.type:'PIVOT'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'PIVOT'
msgid "Change pivot point for transforms (buggy)"
msgstr "Ändra vridpunkt för transformationer (felbenägen)"

#. :src: bpy.types.Constraint.type:'SHRINKWRAP'
#. :src: bpy.types.POSE_OT_constraint_add.type:'SHRINKWRAP'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'SHRINKWRAP'
msgid "Restrict movements to surface of target mesh"
msgstr "Begränsa rörelserna till målnätets yta"

#. :src: bpy.types.ActionConstraint.mix_mode
#. :src: bpy.types.CopyRotationConstraint.mix_mode
#. :src: bpy.types.CopyTransformsConstraint.mix_mode
#. :src: bpy.types.DataTransferModifier.mix_mode
#. :src: bpy.types.NormalEditModifier.mix_mode
#. :src: bpy.types.VertexWeightMixModifier.mix_mode
#. :src: bpy.types.NODE_OT_nw_batch_change.blend_type:'MIX'
#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'MIX'
#. :src: bpy.types.OBJECT_OT_data_transfer.mix_mode
msgid "Mix Mode"
msgstr "Blandningsläge"

#. :src: bpy.types.ActionConstraint.mix_mode
msgid ""
"Specify how existing transformations and the action channels are combined"
msgstr "Ange hur befintliga transformationer och åtgärdskanaler kombineras"

#. :src: bpy.types.ActionConstraint.mix_mode:'BEFORE_SPLIT'
msgid ""
"Apply the action channels before the original transformation, handling "
"location, rotation and scale separately"
msgstr ""
"Tillämpa åtgärdskanalerna före den ursprungliga transformationen och hantera "
"position, rotation och skala separat"

#. :src: bpy.types.ActionConstraint.mix_mode:'AFTER_SPLIT'
msgid ""
"Apply the action channels after the original transformation, handling "
"location, rotation and scale separately"
msgstr ""
"Tillämpa åtgärdskanalerna efter den ursprungliga transformationen och "
"hantera position, rotation och skala separat"

#. :src: bpy.types.ActionConstraint.transform_channel
#. :src: bpy.types.DriverVariable.type:'TRANSFORMS'
#. :src: bpy.types.ActionSlot.transform_channel
#: scripts/addons_core/rigify/operators/action_layers.py:465
msgid "Transform Channel"
msgstr "Transformationskanal"

#. :src: bpy.types.ActionConstraint.transform_channel:'LOCATION_X'
#. :src: bpy.types.DriverTarget.transform_type:'LOC_X'
#. :src: bpy.types.ActionSlot.transform_channel:'LOCATION_X'
msgid "X Location"
msgstr "X-position"

#. :src: bpy.types.ActionConstraint.transform_channel:'LOCATION_Y'
#. :src: bpy.types.DriverTarget.transform_type:'LOC_Y'
#. :src: bpy.types.ActionSlot.transform_channel:'LOCATION_Y'
msgid "Y Location"
msgstr "Y-position"

#. :src: bpy.types.ActionConstraint.transform_channel:'LOCATION_Z'
#. :src: bpy.types.DriverTarget.transform_type:'LOC_Z'
#. :src: bpy.types.ActionSlot.transform_channel:'LOCATION_Z'
msgid "Z Location"
msgstr "Z-position"

#. :src: bpy.types.ActionConstraint.use_bone_object_action
msgid "Object Action"
msgstr "Objektåtgärd"

#. :src: bpy.types.ArmatureConstraint
msgid "Applies transformations done by the Armature modifier"
msgstr "Tillämpar transformationer som utförs av armaturmodifieraren"

#. :src: bpy.types.ArmatureConstraint.use_bone_envelopes
msgid "Use Envelopes"
msgstr "Använd omslutningar"

#. :src: bpy.types.ArmatureConstraint.use_bone_envelopes
msgid ""
"Multiply weights by envelope for all bones, instead of acting like Vertex "
"Group based blending. The specified weights are still used, and only the "
"listed bones are considered."
msgstr ""
"Multiplicera vikterna med omslutningen för alla ben i stället för att "
"använda blandning baserad på vertexgrupper. De angivna vikterna används "
"fortfarande och endast de listade benen beaktas."

#. :src: bpy.types.ArmatureConstraint.use_current_location
msgid ""
"Use the current bone location for envelopes and choosing B-Bone segments "
"instead of rest position"
msgstr ""
"Använd den aktuella benpositionen för omslutningar och välj B-bensegment i "
"stället för viloposition"
