#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Attach Hair Curves to Surface"
msgstr "Fäst hårkurvor vid meshyta"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Attaches hair curves to a surface mesh"
msgstr "Fäster hårkurvor vid en meshyta"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface UV Coordinate"
msgstr "Ytans UV-koordinat"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface UV coordinates at the attachment point"
msgstr "Ytans UV-koordinater vid infästningspunkten"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface normal at the attachment point"
msgstr "Ytnormal vid infästningspunkten"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface geometry to attach hair curves to"
msgstr "Ytgeometri som hårkurvor ska fästas vid"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface Object to attach to (needs to have matching transforms)"
msgstr "Ytobjekt att fästa vid (måste ha matchande transformationer)"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Surface Rest Position"
msgstr "Ytans viloposition"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Set the surface mesh into its rest position before attachment"
msgstr "Sätt meshytan i dess viloposition före infästningen"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Sample Attachment UV"
msgstr "Provta infästnings-UV"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Sample the surface UV map at the attachment point"
msgstr "Provta ytans UV-karta vid infästningspunkten"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Snap to Surface"
msgstr "Snäpp till ytan"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Snap the root of each curve to the closest surface point"
msgstr "Snäpp varje kurvas rot till närmaste punkt på ytan"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Align to Surface Normal"
msgstr "Rikta in efter ytnormal"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Align the curve to the surface normal (needs a guide as reference)"
msgstr "Rikta in kurvan efter ytnormalen (kräver en guide som referens)"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Blend along Curve"
msgstr "Blanda längs kurvan"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Blend deformation along each curve from the root"
msgstr "Blanda deformationen längs varje kurva från roten"
