#: source/blender/nodes/geometry/nodes/node_geo_store_named_attribute.cc:217
msgid "Failed to write to attribute \"{}\" with domain \"{}\" and type \"{}\""
msgstr ""
"Det gick inte att skriva till attributet \"{}\" med domänen \"{}\" och typen"
" \"{}\""

#: source/blender/nodes/geometry/nodes/node_geo_string_to_curves.cc:49
msgid ""
"Only output curves that fit within the width and height. Output the "
"remainder to the \"Remainder\" output."
msgstr ""
"Mata endast ut kurvor som ryms inom bredden och höjden. Mata ut återstoden "
"till utdatan \"Remainder\"."

#: source/blender/nodes/geometry/nodes/node_geo_uv_pack_islands.cc:25
msgid ""
"Use axis-aligned bounding boxes for packing (fastest, least space efficient)"
msgstr ""
"Använd axeljusterade begränsningsboxar för packning (snabbast, minst "
"utrymmeseffektivt)"

#: source/blender/nodes/geometry/nodes/node_geo_viewport_transform.cc:15
msgid ""
"Transforms points from object space to view space using the viewport's "
"location and rotation"
msgstr ""
"Transformerar punkter från objektrymd till visningsrymd med vyportens "
"placering och rotation"

#: source/blender/nodes/geometry/nodes/node_geo_viewport_transform.cc:19
msgid "Whether the viewport is using orthographic projection"
msgstr "Anger om vyporten använder ortografisk projektion"
