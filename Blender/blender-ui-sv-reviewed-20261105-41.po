msgid "The Bone Collections that contain this Bone"
msgstr "Bensamlingarna som innehåller detta ben"

#. :src: bpy.types.BoneCollections
msgid "Armature Bone Collections"
msgstr "Bensamlingar för riggskelett"

#. :src: bpy.types.BoneCollections
msgid "The Bone Collections of this Armature"
msgstr "Bensamlingarna i detta riggskelett"

#. :src: bpy.types.BoneCollections.active
msgid "Armature's active bone collection"
msgstr "Riggskelettets aktiva bensamling"
