#. :src: bpy.types.BoneCollection.rigify_color_set_id
msgid "Color Set ID"
msgstr "ID för färguppsättning"

#. :src: bpy.types.BoneCollection.rigify_color_set_name
msgid "Color set specifying bone colors for this group"
msgstr "Färguppsättning som anger benfärger för denna grupp"

#. :src: bpy.types.BoneCollection.rigify_sel_set
msgid "Add Selection Set"
msgstr "Lägg till urvalsuppsättning"

#. :src: bpy.types.BoneCollection.rigify_sel_set
msgid "Add Selection Set for this collection"
msgstr "Lägg till urvalsuppsättning för denna samling"

#. :src: bpy.types.BoneCollection.rigify_ui_row
msgid "Button Row"
msgstr "Knapprad"

#. :src: bpy.types.BoneCollection.rigify_ui_row
msgid "The row in the UI panel where the button for this collection is shown. (0 = hidden)"
msgstr "Raden i användargränssnittspanelen där knappen för samlingen visas (0 = dold)"

#. :src: bpy.types.BoneCollection.rigify_ui_title
#. :src: bpy.types.BoneCollection.rigify_ui_title_name
msgid "Button Text"
msgstr "Knapptext"

#. :src: bpy.types.BoneCollection.rigify_ui_title
msgid "Text to use on the UI panel button instead of the collection name"
msgstr "Text att använda på panelknappen i stället för samlingsnamnet"

#. :src: bpy.types.BoneCollection.rigify_ui_title_name
msgid "Text to use on the UI panel button (does not edit the collection name)"
msgstr "Text att använda på panelknappen (redigerar inte samlingsnamnet)"

#. :src: bpy.types.BoneCollection.rigify_uid
#. :src: bpy.types.RigifyBoneCollectionReference.uid
msgid "Unique ID"
msgstr "Unikt ID"

#. :src: bpy.types.BoneCollectionMemberships
msgid "Bone Collection Memberships"
msgstr "Medlemskap i bensamlingar"

