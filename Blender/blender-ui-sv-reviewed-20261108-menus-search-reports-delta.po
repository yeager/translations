#. :src: bpy.types.AssetShelf.bl_options:'ACTIVATE_FOR_CONTEXT_MENU'
msgid "When spawning a context menu for an asset, activate the asset and call `bl_activate_operator` if present, rather than just highlighting the asset"
msgstr "När en kontextmeny öppnas för en resurs, aktivera resursen och anropa `bl_activate_operator` om den finns i stället för att bara markera resursen"

#. :src: bpy.types.SCREEN_OT_region_context_menu
msgid "Display region context menu"
msgstr "Visa områdets kontextmeny"

#: source/blender/editors/interface/interface_context_menu.cc:1175
msgid "Add to a user defined context menu (stored in the user preferences)"
msgstr "Lägg till i en användardefinierad kontextmeny (sparas i användarinställningarna)"
