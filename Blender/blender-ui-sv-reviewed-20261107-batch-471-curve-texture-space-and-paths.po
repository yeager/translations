#. :src: bpy.types.Curve.texspace_location
#. :src: bpy.types.Mesh.texspace_location
#. :src: bpy.types.MetaBall.texspace_location
msgid "Texture Space Location"
msgstr "Texturutrymmesposition"

#. :src: bpy.types.Curve.texspace_size
#. :src: bpy.types.Mesh.texspace_size
#. :src: bpy.types.MetaBall.texspace_size
msgid "Texture Space Size"
msgstr "Texturutrymmets storlek"

#. :src: bpy.types.Curve.twist_mode
msgid "Twist Method"
msgstr "Vridningsmetod"

#. :src: bpy.types.Curve.twist_mode
msgid "The type of tilt calculation for 3D Curves"
msgstr "Typ av lutningsberäkning för 3D-kurvor"

#. :src: bpy.types.Curve.twist_mode:'Z_UP'
msgid "Z-Up"
msgstr "Z-Up"

#. :src: bpy.types.Curve.twist_mode:'Z_UP'
msgid "Use Z-Up axis to calculate the curve twist at each point"
msgstr "Använd Z-Up-axeln för att beräkna kurvans vridning vid varje punkt"

#. :src: bpy.types.Curve.twist_mode:'MINIMUM'
msgid "Use the least twist over the entire curve"
msgstr "Använd minsta möjliga vridning över hela kurvan"

#. :src: bpy.types.Curve.twist_mode:'TANGENT'
msgid "Use the tangent to calculate twist"
msgstr "Använd tangenten för att beräkna vridningen"

#. :src: bpy.types.Curve.twist_smooth
msgid "Twist Smooth"
msgstr "Vridningsutjämning"

#. :src: bpy.types.Curve.twist_smooth
msgid "Smoothing iteration for tangents"
msgstr "Utjämnande iteration för tangenter"

#. :src: bpy.types.Curve.use_auto_texspace
#. :src: bpy.types.Mesh.auto_texspace
#. :src: bpy.types.Mesh.use_auto_texspace
#. :src: bpy.types.MetaBall.use_auto_texspace
msgid "Auto Texture Space"
msgstr "Automatiskt texturutrymme"

#. :src: bpy.types.Curve.use_auto_texspace
#. :src: bpy.types.Mesh.auto_texspace
#. :src: bpy.types.Mesh.use_auto_texspace
#. :src: bpy.types.MetaBall.use_auto_texspace
msgid ""
"Adjust active object's texture space automatically when transforming object"
msgstr ""
"Justera det aktiva objektets texturutrymme automatiskt när objektet "
"transformeras"

#. :src: bpy.types.Curve.use_deform_bounds
msgid "Bounds Clamp"
msgstr "Begränsa till meshgränser"

#. :src: bpy.types.Curve.use_deform_bounds
msgid "Option for curve-deform: Use the mesh bounds to clamp the deformation"
msgstr ""
"Alternativ för kurvdeformering: begränsa deformeringen till meshens gränser"

#. :src: bpy.types.Curve.use_fill_caps
#: source/blender/nodes/geometry/nodes/node_geo_curve_to_mesh.cc:28
msgid "Fill Caps"
msgstr "Fyll ändlock"

#. :src: bpy.types.Curve.use_fill_caps
msgid "Fill caps for beveled curves"
msgstr "Fyll ändarna på avfasade kurvor"

#. :src: bpy.types.Curve.use_map_taper
msgid "Map Taper"
msgstr "Mappa avsmalning"

#. :src: bpy.types.Curve.use_map_taper
msgid "Map effect of the taper object to the beveled part of the curve"
msgstr "Mappa avsmalningsobjektets effekt till den avfasade delen av kurvan"

#. :src: bpy.types.Curve.use_path
msgid "Enable the curve to become a translation path"
msgstr "Gör det möjligt att använda kurvan som förflyttningsbana"

#. :src: bpy.types.Curve.use_path_clamp
msgid ""
"Clamp the curve path children so they can't travel past the start/end point "
"of the curve"
msgstr ""
"Begränsa kurvbanans underordnade objekt så att de inte kan färdas förbi "
"kurvans start- eller slutpunkt"

#. :src: bpy.types.Curve.use_path_follow
#. :src: bpy.types.Screen.use_follow
msgid "Follow"
msgstr "Följ"

#. :src: bpy.types.Curve.use_path_follow
msgid "Make curve path children rotate along the path"
msgstr "Gör så att kurvbanans underordnade objekt roterar längs banan"

#. :src: bpy.types.Curve.use_radius
msgid ""
"Option for paths and curve-deform: apply the curve radius to objects "
"following it and to deformed objects"
msgstr ""
"Alternativ för banor och kurvdeformering: tillämpa kurvradien på objekt som "
"följer den och på deformerade objekt"

#. :src: bpy.types.Curve.use_stretch
msgid "Option for curve-deform: make deformed child stretch along entire path"
msgstr ""
"Alternativ för kurvdeformering: gör att det deformerade underordnade "
"objektet sträcker sig längs hela banan"
