#. :src: bpy.types.Brush.deform_target
msgid "How the deformation of the brush will affect the object"
msgstr "Hur penselns deformation påverkar objektet"

#. :src: bpy.types.Brush.deform_target:'GEOMETRY'
msgid "Brush deformation displaces the vertices of the mesh"
msgstr "Penseldeformation förskjuter meshens hörnpunkter"

#. :src: bpy.types.Brush.direction:'ADD'
msgid "Add effect of brush"
msgstr "Lägg till penselns effekt"

#. :src: bpy.types.Brush.direction:'SUBTRACT'
msgid "Subtract effect of brush"
msgstr "Subtrahera penselns effekt"

#. :src: bpy.types.Brush.disconnected_distance_max
msgid "Max Element Distance"
msgstr "Största elementavstånd"

#. :src: bpy.types.Brush.disconnected_distance_max
msgid "Maximum distance to search for disconnected loose parts in the mesh"
msgstr "Största avstånd för sökning efter frånkopplade lösa delar i meshen"

#. :src: bpy.types.Brush.elastic_deform_type:'GRAB_BISCALE'
msgctxt "Brush"
msgid "Bi-Scale Grab"
msgstr "Flytta i två skalor"

#. :src: bpy.types.Brush.elastic_deform_type:'GRAB_TRISCALE'
msgctxt "Brush"
msgid "Tri-Scale Grab"
msgstr "Flytta i tre skalor"

#. :src: bpy.types.Brush.elastic_deform_volume_preservation
msgid ""
"Poisson ratio for elastic deformation. Higher values preserve volume more, "
"but also lead to more bulging."
msgstr ""
"Poisson-tal för elastisk deformation. Högre värden bevarar volymen bättre, "
"men leder också till mer utbuktning."

#. :src: bpy.types.Brush.falloff_angle
#. :src: bpy.types.ImagePaint.normal_angle
msgid "Paint most on faces pointing towards the view according to this angle"
msgstr "Måla främst på ytor som vetter mot vyn enligt denna vinkel"

#. :src: bpy.types.Brush.falloff_shape:'SPHERE'
msgid "Apply brush influence in a Sphere, outwards from the center"
msgstr "Tillämpa penselns påverkan sfäriskt, utåt från mitten"

#. :src: bpy.types.Brush.falloff_shape:'PROJECTED'
msgid "Apply brush influence in a 2D circle, projected from the view"
msgstr "Tillämpa penselns påverkan i en 2D-cirkel som projiceras från vyn"

#. :src: bpy.types.Brush.fill_threshold
#: scripts/startup/bl_ui/properties_paint_common.py:1003
msgid "Fill Threshold"
msgstr "Fyllningströskel"

#. :src: bpy.types.Brush.flow
msgid "Amount of paint that is applied per stroke sample"
msgstr "Mängd färg som tillämpas per penseldragsprov"
