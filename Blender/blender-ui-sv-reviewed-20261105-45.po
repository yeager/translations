#. :src: bpy.types.BrushGpencilSettings.angle
msgid "Direction of the stroke at which brush gives maximal thickness (0° for horizontal)"
msgstr "Riktningen för penseldraget där penseln får maximal tjocklek (0° är vågrätt)"

#. :src: bpy.types.BrushGpencilSettings.angle_factor
msgid "Angle Factor"
msgstr "Vinkelfaktor"

#. :src: bpy.types.BrushGpencilSettings.angle_factor
msgid "Reduce brush thickness by this factor when stroke is perpendicular to 'Angle' direction"
msgstr "Minska penseltjockleken med denna faktor när penseldraget är vinkelrätt mot vinkeln"

#. :src: bpy.types.BrushGpencilSettings.brush_draw_mode
msgid "Preselected mode when using this brush"
msgstr "Förvalt läge när penseln används"

#. :src: bpy.types.BrushGpencilSettings.brush_draw_mode:'MATERIAL'
msgid "Use always material mode"
msgstr "Använd alltid materialläge"

#. :src: bpy.types.BrushGpencilSettings.brush_draw_mode:'VERTEXCOLOR'
#. :src: bpy.types.DynamicPaintSurface.init_color_type:'VERTEX_COLOR'
#. :src: bpy.types.ShaderNodeTexPointDensity.vertex_color_source:'VERTEX_COLOR'
#. :src: bpy.types.GREASE_PENCIL_OT_select_similar.mode:'VERTEX_COLOR'
msgid "Vertex Color"
msgstr "Hörnpunktsfärg"

#. :src: bpy.types.BrushGpencilSettings.brush_draw_mode:'VERTEXCOLOR'
msgid "Use always Vertex Color mode"
msgstr "Använd alltid läget Hörnpunktsfärg"

#. :src: bpy.types.BrushGpencilSettings.caps_type
msgctxt "GPencil"
msgid "Caps Type"
msgstr "Ändtyp"

#. :src: bpy.types.BrushGpencilSettings.caps_type
msgid "The shape of the start and end of the stroke"
msgstr "Formen på penseldragets början och slut"

#. :src: bpy.types.BrushGpencilSettings.curve_jitter
msgid "Curve Jitter"
msgstr "Slumpningskurva"

#. :src: bpy.types.BrushGpencilSettings.curve_jitter
msgid "Curve used for the jitter effect"
msgstr "Kurva som styr slumpningseffekten"

#. :src: bpy.types.BrushGpencilSettings.curve_sensitivity
msgid "Curve Sensitivity"
msgstr "Känslighetskurva"

#. :src: bpy.types.BrushGpencilSettings.curve_strength
msgid "Curve Strength"
msgstr "Styrkekurva"

#. :src: bpy.types.BrushGpencilSettings.dilate
msgid "Dilate/Contract"
msgstr "Utvidga/dra samman"

#. :src: bpy.types.BrushGpencilSettings.dilate
msgid "Number of pixels to expand or contract fill area"
msgstr "Antal pixlar som fyllningsområdet ska utvidgas eller dras samman"

#. :src: bpy.types.BrushGpencilSettings.eraser_mode
msgid "Eraser Mode"
msgstr "Raderingsläge"
