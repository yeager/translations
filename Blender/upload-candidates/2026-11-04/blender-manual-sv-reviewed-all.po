msgstr "Typer av färgväljare."

msgid "Circle HSV."
msgstr "Cirkel (HSV)."

msgid "Circle HSL."
msgstr "Cirkel (HSL)."

msgid "Square (SV + H)."
msgstr "Kvadrat (SV + H)."

msgid "Square (HS + V)."
msgstr "Kvadrat (HS + V)."

msgid "Square (HV + S)."
msgstr "Kvadrat (HV + S)."

msgid "Header Position"
msgstr "Rubrikposition"

