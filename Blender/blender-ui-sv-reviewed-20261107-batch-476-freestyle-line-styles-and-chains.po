msgstr "Alfagenomskinlighet"

#. :src: bpy.types.FreestyleLineStyle.alpha
msgid ""
"Base alpha transparency, possibly modified by alpha transparency modifiers"
msgstr ""
"Grundläggande alfagenomskinlighet, som kan modifieras av "
"alfagenomskinlighetsmodifierare"

