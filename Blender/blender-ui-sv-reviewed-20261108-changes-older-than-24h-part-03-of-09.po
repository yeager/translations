msgid "Thirds"
msgstr "Tredjedelsregeln"

#. :src: bpy.types.Camera.show_composition_thirds
msgid "Display rule of thirds composition guide inside the camera view"
msgstr "Visa kompositionsguide för tredjedelsregeln i kameravyn"

#. :src: bpy.types.Camera.show_limits
msgid "Show Limits"
msgstr "Visa gränser"

#. :src: bpy.types.Camera.show_limits
msgid "Display the clipping range and focus point on the camera"
msgstr "Visa beskärningsintervallet och fokuspunkten för kameran"

#. :src: bpy.types.Camera.show_mist
msgid "Show Mist"
msgstr "Visa dimma"

#. :src: bpy.types.Camera.show_mist
msgid "Display a line from the Camera to indicate the mist area"
msgstr "Visa en linje från kameran för att markera dimområdet"

#. :src: bpy.types.Camera.show_name
#. :src: bpy.types.SequencerTimelineOverlay.show_strip_name
msgid "Show Name"
msgstr "Visa namn"

#. :src: bpy.types.Camera.show_name
msgid "Show the active Camera's name in Camera view"
msgstr "Visa den aktiva kamerans namn i kameravyn"

#. :src: bpy.types.Camera.show_passepartout
#. :src: bpy.types.View3DOverlay.show_camera_passepartout
