#. :src: bpy.types.Curve.use_path_follow
msgid "Make curve path children rotate along the path"
msgstr "Gör så att kurvbanans underordnade objekt roterar längs banan"

#. :src: bpy.types.Curve.use_radius
msgid ""
"Option for paths and curve-deform: apply the curve radius to objects "
"following it and to deformed objects"
msgstr ""
"Alternativ för banor och kurvdeformering: tillämpa kurvradien på objekt som "
"följer den och på deformerade objekt"

#. :src: bpy.types.Curve.use_stretch
msgid "Option for curve-deform: make deformed child stretch along entire path"
msgstr ""
"Alternativ för kurvdeformering: gör att det deformerade underordnade "
"objektet sträcker sig längs hela banan"

#. :src: bpy.types.Curve.extrude
msgid ""
"Length of the depth added in the local Z direction along the curve, "
"perpendicular to its normals"
msgstr ""
"Längden på djupet som läggs till i den lokala Z-riktningen längs kurvan, "
"vinkelrätt mot dess normaler"

#. :src: bpy.types.Curve.fill_mode
msgid "Fill Mode"
msgstr "Fyllningsläge"

#. :src: bpy.types.Curve.fill_mode
msgid "Mode of filling curve"
msgstr "Kurvans fyllningsläge"

#. :src: bpy.types.Curve.fill_mode:'HALF'
#. :src: bpy.types.MetaBall.update_method:'HALFRES'
#. :src: bpy.types.MovieTrackingSettings.speed:'HALF'
#. :src: bpy.types.SequencerTimelineOverlay.waveform_display_style:'HALF_WAVEFORMS'
#. :src: bpy.types.VolumeRender.precision:'HALF'
msgid "Half"
msgstr "Halv"

#. :src: bpy.types.Curve.offset
msgid "Distance to move the curve parallel to its normals"
msgstr "Avstånd för att flytta kurvan parallellt med dess normaler"

#. :src: bpy.types.Curve.path_duration
msgid "Path Duration"
msgstr "Sökvägsvaraktighet"

#. :src: bpy.types.Curve.path_duration
msgid ""
"The number of frames that are needed to traverse the path, defining the "
"maximum value for the 'Evaluation Time' setting"
msgstr ""
"Antalet bildrutor som behövs för att färdas längs sökvägen; anger maxvärdet "
"för inställningen \"Utvärderingstid\""

#. :src: bpy.types.Curve.render_resolution_u
msgid "Render Resolution U"
msgstr "Renderingsupplösning U"

#. :src: bpy.types.Curve.render_resolution_u
msgid ""
"Surface resolution in U direction used while rendering (zero uses preview "
"resolution)"
msgstr ""
"Ytupplösning i U-riktning som används vid rendering (noll använder "
"förhandsgranskningsupplösning)"

#. :src: bpy.types.Curve.render_resolution_v
msgid "Render Resolution V"
msgstr "Renderingsupplösning V"

#. :src: bpy.types.Curve.render_resolution_v
msgid ""
"Surface resolution in V direction used while rendering (zero uses preview "
"resolution)"
msgstr ""
"Ytupplösning i V-riktning som används vid rendering (noll använder "
"förhandsgranskningsupplösning)"

#. :src: bpy.types.Curve.resolution_u
#. :src: bpy.types.Spline.resolution_u
msgid "Resolution U"
msgstr "Upplösning U"

#. :src: bpy.types.Curve.resolution_u
msgid ""
"Number of computed points in the U direction between every pair of control "
"points"
msgstr ""
"Antal beräknade punkter i U-riktningen mellan varje par av kontrollpunkter"

#. :src: bpy.types.Curve.resolution_v
#. :src: bpy.types.Spline.resolution_v
msgid "Resolution V"
msgstr "Upplösning V"

#. :src: bpy.types.Curve.resolution_v
msgid ""
"The number of computed points in the V direction between every pair of "
"control points"
msgstr ""
"Antalet beräknade punkter i V-riktningen mellan varje par av kontrollpunkter"

#. :src: bpy.types.Curve.splines
#. :src: bpy.types.MaskLayer.splines
msgid "Splines"
msgstr "Kurvsplines"

#. :src: bpy.types.Curve.splines
msgid "Collection of splines in this curve data object"
msgstr "Samling av kurvsplines i detta kurvdataobjekt"

#. :src: bpy.types.Curve.taper_object
msgid "Taper Object"
msgstr "Avsmalningsobjekt"

#. :src: bpy.types.Curve.taper_object
msgid "Curve object name that defines the taper (width)"
msgstr "Namnet på kurvobjektet som definierar avsmalningens bredd"

#. :src: bpy.types.Curve.taper_radius_mode
msgid "Taper Radius"
msgstr "Avsmalningsradie"

#. :src: bpy.types.Curve.taper_radius_mode
msgid ""
"Determine how the effective radius of the spline point is computed when a "
"taper object is specified"
msgstr ""
"Bestäm hur den effektiva radien för splinepunkten beräknas när ett "
"avsmalningsobjekt har angetts"

#. :src: bpy.types.Curve.taper_radius_mode:'OVERRIDE'
msgid "Override the radius of the spline point with the taper radius"
msgstr "Åsidosätt splinepunktens radie med avsmalningsradien"

#. :src: bpy.types.Curve.taper_radius_mode:'MULTIPLY'
msgid "Multiply the radius of the spline point by the taper radius"
msgstr "Multiplicera splinepunktens radie med avsmalningsradien"

#. :src: bpy.types.Curve.taper_radius_mode:'ADD'
msgid "Add the radius of the bevel point to the taper radius"
msgstr "Lägg till avfasningspunktens radie till avsmalningsradien"

#. :src: bpy.types.Curve
msgid "Curve data-block storing curves, splines and NURBS"
msgstr "Kurvdatablock som lagrar kurvor, splines och NURBS"

#. :src: bpy.types.Curve.bevel_depth
msgid "Bevel Depth"
msgstr "Avfasningsdjup"

#. :src: bpy.types.Curve.bevel_depth
msgid "Radius of the bevel geometry, not including extrusion"
msgstr "Avfasningsgeometrins radie, exklusive extrudering"

#. :src: bpy.types.Curve.bevel_factor_end
msgid "Geometry End Factor"
msgstr "Geometrins slutfaktor"

#. :src: bpy.types.Curve.bevel_factor_end
msgid ""
"Define where along the spline the curve geometry ends (0 for the beginning, "
"1 for the end)"
msgstr ""
"Definiera var längs kurvsplinen geometrin slutar (0 för början, 1 för slutet)"

#. :src: bpy.types.Curve.bevel_factor_mapping_end
msgid "End Mapping Type"
msgstr "Mappningstyp för slutet"

#. :src: bpy.types.Curve.bevel_factor_mapping_end
msgid "Determine how the geometry end factor is mapped to a spline"
msgstr "Bestäm hur geometrins slutfaktor ska mappas till en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_mapping_end:'RESOLUTION'
#. :src: bpy.types.Curve.bevel_factor_mapping_start:'RESOLUTION'
msgid ""
"Map the geometry factor to the number of subdivisions of a spline (U "
"resolution)"
msgstr ""
"Mappa geometrifaktorn till antalet underindelningar i en kurvspline (U-"
"upplösning)"

#. :src: bpy.types.Curve.bevel_factor_mapping_end:'SEGMENTS'
#. :src: bpy.types.Curve.bevel_factor_mapping_start:'SEGMENTS'
msgid ""
"Map the geometry factor to the length of a segment and to the number of "
"subdivisions of a segment"
msgstr ""
"Mappa geometrifaktorn till längden på ett segment och till antalet "
"underindelningar av ett segment"

#. :src: bpy.types.Curve.bevel_factor_mapping_end:'SPLINE'
#. :src: bpy.types.Curve.bevel_factor_mapping_start:'SPLINE'
msgid "Map the geometry factor to the length of a spline"
msgstr "Mappa geometrifaktorn till längden på en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_mapping_start
msgid "Start Mapping Type"
msgstr "Mappningstyp för början"

#. :src: bpy.types.Curve.bevel_factor_mapping_start
msgid "Determine how the geometry start factor is mapped to a spline"
msgstr "Bestäm hur geometrins startfaktor ska mappas till en kurvspline"

#. :src: bpy.types.Curve.bevel_factor_start
msgid "Geometry Start Factor"
msgstr "Geometrins startfaktor"

#. :src: bpy.types.Curve.bevel_factor_start
msgid ""
"Define where along the spline the curve geometry starts (0 for the "
"beginning, 1 for the end)"
msgstr ""
"Definiera var längs kurvsplinen geometrin börjar (0 för början, 1 för slutet)"

#. :src: bpy.types.Curve.bevel_mode
msgid "Bevel Mode"
msgstr "Avfasningsläge"

#. :src: bpy.types.Curve.bevel_mode
msgid "Determine how to build the curve's bevel geometry"
msgstr "Bestäm hur du ska bygga kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_mode:'ROUND'
#. :src: bpy.types.FreestyleLineStyle.caps:'ROUND'
msgid "Round"
msgstr "Rund"

#. :src: bpy.types.Curve.bevel_mode:'ROUND'
msgid "Use circle for the section of the curve's bevel geometry"
msgstr "Använd en cirkel som tvärsnitt för kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_mode:'OBJECT'
msgid "Use an object for the section of the curve's bevel geometry segment"
msgstr "Använd ett objekt som tvärsnitt för kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_mode:'PROFILE'
msgid "Use a custom profile for each quarter of curve's bevel geometry"
msgstr ""
"Använd en anpassad profil för varje fjärdedel av kurvans avfasningsgeometri"

#. :src: bpy.types.Curve.bevel_object
msgid "Bevel Object"
msgstr "Avfasningsobjekt"

#. :src: bpy.types.Curve.bevel_object
msgid "The name of the Curve object that defines the bevel shape"
msgstr "Namnet på det kurvobjekt som definierar avfasningsformen"

#. :src: bpy.types.Curve.bevel_profile
#. :src: bpy.types.BevelModifier.custom_profile
msgid "Custom Profile Path"
msgstr "Anpassad profilsökväg"

#. :src: bpy.types.Curve.bevel_profile
msgid "The path for the curve's custom profile"
msgstr "Sökvägen till kurvans anpassade profil"

#. :src: bpy.types.Curve.bevel_resolution
msgid "Bevel Resolution"
msgstr "Avfasningsupplösning"

#. :src: bpy.types.Curve.bevel_resolution
msgid "The number of segments in each quarter-circle of the bevel"
msgstr "Antalet segment i varje kvartscirkel i avfasningen"

#. :src: bpy.types.Collection
msgid "Collection of Object data-blocks"
msgstr "Samling av objektdatablock"

#. :src: bpy.types.Collection.active_exporter_index
msgid "Active Collection Exporter Index"
msgstr "Index för aktiv samlingsexportör"

#. :src: bpy.types.Collection.active_exporter_index
msgid "Active index in the exporters list"
msgstr "Aktivt index i exportörslistan"

#. :src: bpy.types.Collection.all_objects
msgid "Objects that are in this collection and its child collections"
msgstr "Objekt som finns i den här samlingen och dess underordnade samlingar"

#. :src: bpy.types.Collection.children
msgid "Collections that are immediate children of this collection"
msgstr "Direkta underordnade samlingar till denna samling"

#. :src: bpy.types.Collection.collection_children
msgid "Children collections with their parent-collection-specific settings"
msgstr "Underordnade samlingar med sina inställningar för överordnad samling"

#. :src: bpy.types.Collection.collection_objects
msgid ""
"Objects of the collection with their parent-collection-specific settings"
msgstr ""
"Objekt i samlingen med sina inställningar för den överordnade samlingen"

