"The intersection line will be included into the object with the higher "
"intersection priority value"
msgstr ""
"Korsningslinjen kommer att ingå i objektet med det högre värdet för "
"korsningsprioritet"

#. :src: bpy.types.Collection.lineart_usage
#. :src: bpy.types.ObjectLineArt.usage
msgid "Usage"
msgstr "Användning"

#. :src: bpy.types.Collection.lineart_usage
msgid "How to use this collection in Line Art calculation"
msgstr "Hur den här samlingen används i beräkningen för linjekonst"

#. :src: bpy.types.Collection.lineart_usage:'INCLUDE'
msgid "Generate feature lines for this collection"
msgstr "Generera funktionslinjer för den här samlingen"

#. :src: bpy.types.Collection.lineart_usage:'OCCLUSION_ONLY'
#. :src: bpy.types.ObjectLineArt.usage:'OCCLUSION_ONLY'
msgid "Occlusion Only"
msgstr "Endast ocklusion"

#. :src: bpy.types.Collection.lineart_usage:'OCCLUSION_ONLY'
msgid "Only use the collection to produce occlusion"
msgstr "Använd endast samlingen för att skapa ocklusion"

#. :src: bpy.types.Collection.lineart_usage:'EXCLUDE'
msgid "Don't use this collection in Line Art"
msgstr "Använd inte den här samlingen i linjekonst"

#. :src: bpy.types.Collection.lineart_usage:'INTERSECTION_ONLY'
#. :src: bpy.types.ObjectLineArt.usage:'INTERSECTION_ONLY'
msgid "Intersection Only"
msgstr "Endast korsning"

#. :src: bpy.types.Collection.lineart_usage:'INTERSECTION_ONLY'
#. :src: bpy.types.ObjectLineArt.usage:'INTERSECTION_ONLY'
msgid "Only generate intersection lines for this collection"
msgstr "Generera endast korsningslinjer för den här samlingen"

#. :src: bpy.types.Collection.lineart_usage:'NO_INTERSECTION'
#. :src: bpy.types.ObjectLineArt.usage:'NO_INTERSECTION'
msgid "No Intersection"
msgstr "Ingen korsning"

#. :src: bpy.types.Collection.lineart_usage:'NO_INTERSECTION'
msgid "Include this collection but do not generate intersection lines"
msgstr "Inkludera den här samlingen men generera inte korsningslinjer"

#. :src: bpy.types.Collection.lineart_usage:'FORCE_INTERSECTION'
#. :src: bpy.types.ObjectLineArt.usage:'FORCE_INTERSECTION'
msgid "Force Intersection"
msgstr "Tvinga korsning"

#. :src: bpy.types.Collection.lineart_usage:'FORCE_INTERSECTION'
#. :src: bpy.types.ObjectLineArt.usage:'FORCE_INTERSECTION'
msgid ""
"Generate intersection lines even with objects that disabled intersection"
msgstr ""
"Generera korsningslinjer även med objekt där korsningar har inaktiverats"

#. :src: bpy.types.Collection.lineart_use_intersection_mask
msgid "Use Intersection Masks"
msgstr "Använd korsningsmasker"

#. :src: bpy.types.Collection.lineart_use_intersection_mask
msgid "Use custom intersection mask for faces in this collection"
msgstr "Använd anpassad korsningsmask för ytor i den här samlingen"

#. :src: bpy.types.Collection.objects
