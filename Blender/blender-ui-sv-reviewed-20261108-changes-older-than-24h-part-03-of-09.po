#. :src: bpy.types.UnifiedPaintSettings.use_locked_size
msgid "Measure brush size relative to the view or the scene"
msgstr "Mät penselns storlek i förhållande till vyn eller scenen"

#. :src: bpy.types.Brush.use_locked_size:'VIEW'
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size:'VIEW'
msgid "Measure brush size relative to the view"
msgstr "Mät penselns storlek i förhållande till vyn"

#. :src: bpy.types.Brush.use_locked_size:'SCENE'
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size:'SCENE'
msgid "Measure brush size relative to the scene"
msgstr "Mät penselns storlek i förhållande till scenen"

#. :src: bpy.types.Brush.use_multiplane_scrape_dynamic
msgid "Dynamic Mode"
msgstr "Dynamiskt läge"

#. :src: bpy.types.Brush.use_multiplane_scrape_dynamic
msgid ""
"The angle between the planes changes during the stroke to fit the surface "
"under the cursor"
msgstr ""
"Vinkeln mellan planen ändras under penseldraget för att passa ytan under "
"markören"

#. :src: bpy.types.Brush.use_offset_pressure
msgid "Plane Offset Pressure"
msgstr "Tryck för planförskjutning"

#. :src: bpy.types.Brush.use_offset_pressure
msgid "Enable tablet pressure sensitivity for offset"
msgstr "Aktivera ritplattans tryckkänslighet för förskjutning"

#. :src: bpy.types.Brush.use_original_normal
msgid "Original Normal"
msgstr "Ursprunglig normal"

#. :src: bpy.types.Brush.use_original_normal
msgid "When locked keep using normal of surface where stroke was initiated"
msgstr ""
"När funktionen är låst används fortsatt normalen för ytan där penseldraget "
"startades"

