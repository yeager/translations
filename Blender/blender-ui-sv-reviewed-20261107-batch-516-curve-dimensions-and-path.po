#. :src: bpy.types.Curve.cycles
#. :src: bpy.types.Mesh.cycles
#. :src: bpy.types.MetaBall.cycles
msgid "Cycles Mesh Settings"
msgstr "Inställningar för Cycles-mesh"

#. :src: bpy.types.Curve.cycles
#. :src: bpy.types.Mesh.cycles
#. :src: bpy.types.MetaBall.cycles
msgid "Cycles mesh settings"
msgstr "Inställningar för Cycles-mesh"

#. :src: bpy.types.Curve.dimensions
#. :src: bpy.types.Object.dimensions
#. :src: bpy.types.Node.dimensions
msgid "Dimensions"
msgstr "Dimensioner"

#. :src: bpy.types.Curve.dimensions
msgid "Select 2D or 3D curve type"
msgstr "Välj 2D- eller 3D-kurvtyp"

#. :src: bpy.types.Curve.dimensions:'2D'
msgid "Clamp the Z axis of the curve"
msgstr "Begränsa kurvans Z-axel"

#. :src: bpy.types.Curve.dimensions:'3D'
msgid ""
"Allow editing on the Z axis of this curve, also allows tilt and curve radius "
"to be used"
msgstr ""
"Tillåt redigering på Z-axeln för denna kurva, gör det också möjligt att "
"använda lutning och kurvradie"

#. :src: bpy.types.Curve.eval_time
msgid ""
"Parametric position along the length of the curve that Objects 'following' "
"it should be at (position is evaluated by dividing by the 'Path Length' "
"value)"
msgstr ""
"Parametrisk position längs kurvan där objekt som \"följer\" den ska vara "
"(positionen beräknas genom att dividera med värdet \"Sökvägslängd\")"
