#. :src: bpy.types.ArrayModifier
msgid "Array duplication modifier"
msgstr "Arraymodifierare för duplicering"

#. :src: bpy.types.BevelModifier
msgid "Bevel modifier to make edges and vertices more rounded"
msgstr "Avfasningsmodifierare som gör kanter och hörnpunkter rundare"

#. :src: bpy.types.BooleanModifier
msgid "Boolean Modifier"
msgstr "Boolesk modifierare"

#. :src: bpy.types.BooleanModifier
msgid "Boolean operations modifier"
msgstr "Modifierare för booleska operationer"

#. :src: bpy.types.NormalEditModifier
msgid "Modifier affecting/generating custom normals"
msgstr "Modifierare som påverkar eller genererar anpassade normaler"

#. :src: bpy.types.SubsurfModifier
msgid "Subdivision Surface Modifier"
msgstr "Underindelningsytemodifierare"

#. :src: bpy.types.SubsurfModifier
msgid "Subdivision surface modifier"
msgstr "Underindelningsytemodifierare"

#. :src: bpy.types.TriangulateModifier
msgid "Triangulate Modifier"
msgstr "Trianguleringsmodifierare"

#. :src: bpy.types.TriangulateModifier.min_vertices
msgid "Triangulate only polygons with vertex count greater than or equal to this number"
msgstr "Triangulera endast polygoner med ett antal hörnpunkter som är större än eller lika med detta tal"

#. :src: bpy.types.WeightedNormalModifier.mode
msgid "Weighted vertex normal mode to use"
msgstr "Läge för viktade hörnpunktsnormaler som ska användas"

#. :src: bpy.types.WeightedNormalModifier.vertex_group
msgid "Vertex group name for modifying the selected areas"
msgstr "Namn på hörnpunktsgruppen för modifiering av de markerade områdena"

#. :src: bpy.types.ToolSettings.use_auto_normalize
msgid "Weight Paint Auto-Normalize"
msgstr "Normalisera viktmålning automatiskt"

#. :src: bpy.types.View3DOverlay.show_edge_crease
msgid "Display creases created for Subdivision Surface modifier"
msgstr "Visa veck som skapats för underindelningsytemodifieraren"
