#. :src: bpy.types.Armature.rigify_widgets_collection
msgid "Widgets Collection"
msgstr "Widgetsamling"

#. :src: bpy.types.Armature.rigify_widgets_collection
msgid ""
"Defines which collection to place widget objects in. If unset, a new one "
"will be created based on the name of the rig"
msgstr ""
"Definierar vilken samling som widgetobjekt ska placeras i. Om den inte anges "
"skapas en ny samling baserat på namnet på riggen"

#. :src: bpy.types.Armature.show_axes
#. :src: bpy.types.Object.show_axis
msgid "Display Axes"
msgstr "Visa axlar"

#. :src: bpy.types.Armature.show_axes
msgid "Display bone axes"
msgstr "Visa benaxlar"

#. :src: bpy.types.Armature.show_bone_colors
msgid "Display Bone Colors"
msgstr "Visa benfärger"

#. :src: bpy.types.Armature.show_bone_colors
msgid "Display bone colors"
msgstr "Visa benfärger"

#. :src: bpy.types.Armature.show_bone_custom_shapes
msgid "Display Custom Bone Shapes"
msgstr "Visa anpassade benformer"

#. :src: bpy.types.Armature.show_bone_custom_shapes
msgid "Display bones with their custom shapes"
msgstr "Visa ben med sina anpassade former"

#. :src: bpy.types.Armature.show_names
msgid "Display Names"
msgstr "Visa namn"

#. :src: bpy.types.Armature.show_names
msgid "Display bone names"
msgstr "Visa benens namn"

#. :src: bpy.types.Armature.use_mirror_x
#. :src: bpy.types.Pose.use_mirror_x
msgid "X-Axis Mirror"
msgstr "Spegling över X-axeln"

#. :src: bpy.types.Armature.use_mirror_x
#. :src: bpy.types.Pose.use_mirror_x
msgid "Apply changes to matching bone on opposite side of X-Axis"
msgstr "Tillämpa ändringar på motsvarande ben på X-axelns andra sida"

#. :src: bpy.types.Brush
msgid "Brush data-block for storing brush settings for painting and sculpting"
msgstr ""
"Penseldatablock för lagring av penselinställningar för målning och "
"skulptering"

#. :src: bpy.types.Brush.area_radius_factor
msgid "Area Radius"
msgstr "Områdesradie"

#. :src: bpy.types.Brush.area_radius_factor
msgid ""
"Ratio between the brush radius and the radius that is going to be used to "
"sample the area center"
msgstr ""
"Förhållandet mellan penselradien och den radie som används för att sampla "
"områdets mittpunkt"
