#. :src: bpy.types.ChannelDriverVariables
msgid "ChannelDriver Variables"
msgstr "Drivrutinsvariabler"

#. :src: bpy.types.ChannelDriverVariables
msgid "Collection of channel driver Variables"
msgstr "Samling av drivrutinsvariabler"

#. :src: bpy.types.ChildParticle
msgid "Child Particle"
msgstr "Barnpartikel"

#. :src: bpy.types.ChildParticle
msgid "Child particle interpolated from simulated or edited particles"
msgstr "Barnpartikel interpolerad från simulerade eller redigerade partiklar"

#. :src: bpy.types.ClothCollisionSettings
#. :src: bpy.types.ClothModifier.collision_settings
msgid "Cloth Collision Settings"
msgstr "Kollisionsinställningar för tyg"

#. :src: bpy.types.ClothCollisionSettings
msgid ""
"Cloth simulation settings for self collision and collision with other objects"
msgstr ""
"Inställningar för tygsimulering för självkollision och kollision med andra "
"objekt"

#. :src: bpy.types.ClothCollisionSettings.collection
#. :src: bpy.types.ParticleSettings.collision_collection
#. :src: bpy.types.SoftBodySettings.collision_collection
msgid "Collision Collection"
msgstr "Kollisionssamling"

#. :src: bpy.types.ClothCollisionSettings.collection
msgid "Limit colliders to this Collection"
msgstr "Begränsa kolliderande objekt till den här samlingen"

#. :src: bpy.types.ClothCollisionSettings.collision_quality
msgid ""
"How many collision iterations should be done (higher is better quality but "
"slower)"
msgstr ""
"Hur många kollisionsiterationer ska göras (högre är bättre kvalitet men "
"långsammare)"

#. :src: bpy.types.ClothCollisionSettings.damping
msgid "Restitution"
msgstr "Restitutionskoefficient"

#. :src: bpy.types.ClothCollisionSettings.damping
msgid "Amount of velocity lost on collision"
msgstr "Hur mycket hastighet som förloras vid en kollision"

#. :src: bpy.types.ClothCollisionSettings.distance_min
msgid ""
"Minimum distance between collision objects before collision response takes "
"effect"
msgstr ""
"Minsta avstånd mellan kollisionsobjekten innan kollisionssvaret träder i "
"kraft"

#. :src: bpy.types.ClothCollisionSettings.friction
#. :src: bpy.types.CollisionSettings.cloth_friction
#. :src: bpy.types.RigidBodyObject.friction
#. :src: bpy.types.SoftBodySettings.friction
#: scripts/startup/bl_ui/properties_physics_cloth.py:419
#: scripts/startup/bl_ui/properties_physics_field.py:414
msgid "Friction"
msgstr "Friktion"

#. :src: bpy.types.ClothCollisionSettings.friction
msgid "Friction force if a collision happened (higher = less movement)"
msgstr "Friktionskraft om en kollision inträffar (högre = mindre rörelse)"

#. :src: bpy.types.ClothCollisionSettings.impulse_clamp
#. :src: bpy.types.ClothCollisionSettings.self_impulse_clamp
msgid "Impulse Clamping"
msgstr "Impulsbegränsning"

#. :src: bpy.types.ClothCollisionSettings.impulse_clamp
#. :src: bpy.types.ClothCollisionSettings.self_impulse_clamp
msgid "Clamp collision impulses to avoid instability (0.0 to disable clamping)"
msgstr ""
"Begränsa kollisionsimpulser för att undvika instabilitet (0,0 för att "
"inaktivera begränsning)"

#. :src: bpy.types.ClothCollisionSettings.self_distance_min
msgid "Self Minimum Distance"
msgstr "Minsta avstånd vid självkollision"

#. :src: bpy.types.ClothCollisionSettings.self_distance_min
msgid ""
"Minimum distance between cloth faces before collision response takes effect"
msgstr "Minsta avstånd mellan tygytorna innan kollisionssvaret träder i kraft"

#. :src: bpy.types.ClothCollisionSettings.self_friction
msgid "Self Friction"
msgstr "Friktion vid kontakt med sig själv"

#. :src: bpy.types.ClothCollisionSettings.self_friction
msgid "Friction with self contact"
msgstr "Friktion vid kontakt med sig själv"

#. :src: bpy.types.ClothCollisionSettings.use_collision
msgid "Enable collisions with other objects"
msgstr "Aktivera kollisioner med andra objekt"

#. :src: bpy.types.ClothCollisionSettings.vertex_group_object_collisions
msgid "Collision Vertex Group"
msgstr "Hörnpunktsgrupp för kollision"

#. :src: bpy.types.ClothCollisionSettings.vertex_group_object_collisions
msgid ""
"Triangles with all vertices in this group are not used during object "
"collisions"
msgstr ""
"Trianglar där alla hörnpunkter ingår i denna grupp används inte vid "
"objektkollisioner"

#. :src: bpy.types.ClothCollisionSettings.vertex_group_self_collisions
msgid "Selfcollision Vertex Group"
msgstr "Hörnpunktsgrupp för självkollision"

#. :src: bpy.types.ClothCollisionSettings.vertex_group_self_collisions
msgid ""
"Triangles with all vertices in this group are not used during self collisions"
msgstr ""
"Trianglar där alla hörnpunkter ingår i denna grupp används inte vid "
"självkollisioner"

#. :src: bpy.types.ClothSettings
#. :src: bpy.types.ClothModifier.settings
msgid "Cloth Settings"
msgstr "Inställningar för tyg"

#. :src: bpy.types.ClothSettings
msgid "Cloth simulation settings for an object"
msgstr "Inställningar för tygsimulering för ett objekt"

#. :src: bpy.types.ClothSettings.air_damping
msgid "Air Damping"
msgstr "Luftdämpning"

#. :src: bpy.types.ClothSettings.air_damping
msgid "Air has normally some thickness which slows falling things down"
msgstr "Luft har normalt ett visst motstånd som bromsar fallande objekt"

#. :src: bpy.types.ClothSettings.bending_damping
msgid "Bending Spring Damping"
msgstr "Dämpning för böjfjädrar"

#. :src: bpy.types.ClothSettings.bending_damping
msgid "Amount of damping in bending behavior"
msgstr "Mängden dämpning vid böjning"

#. :src: bpy.types.ClothSettings.bending_model
msgid "Bending Model"
msgstr "Modell för böjning"

#. :src: bpy.types.ClothSettings.bending_model
msgid "Physical model for simulating bending forces"
msgstr "Fysisk modell för simulering av böjkrafter"

#. :src: bpy.types.ClothSettings.bending_model:'LINEAR'
msgid "Cloth model with linear bending springs (legacy)"
msgstr "Tygmodell med linjära böjfjädrar (äldre modell)"

#. :src: bpy.types.ClothSettings.bending_stiffness
#. :src: bpy.types.SoftBodySettings.bend
msgid "Bending Stiffness"
msgstr "Böjstyvhet"

#. :src: bpy.types.ClothSettings.bending_stiffness
msgid "How much the material resists bending"
msgstr "Hur mycket materialet står emot böjning"

#. :src: bpy.types.ClothSettings.bending_stiffness_max
msgid "Bending Stiffness Maximum"
msgstr "Maximal böjstyvhet"

#. :src: bpy.types.ClothSettings.bending_stiffness_max
msgid "Maximum bending stiffness value"
msgstr "Maximalt värde för böjstyvhet"
