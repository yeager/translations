#. :src: bpy.types.Screen
msgid "Screen data-block, defining the layout of areas in a window"
msgstr "Skärmdatablock som definierar områdenas layout i ett fönster"

#. :src: bpy.types.Screen.areas
msgid "Areas"
msgstr "Områden"

#. :src: bpy.types.Screen.areas
msgid "Areas the screen is subdivided into"
msgstr "Områden som skärmen är uppdelad i"

#. :src: bpy.types.Screen.is_animation_playing
