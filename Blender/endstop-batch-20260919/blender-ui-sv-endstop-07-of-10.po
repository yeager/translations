msgid "Cache is disabled until the file is saved"
msgstr "Cachen är inaktiverad tills filen sparas"

msgid "Options are disabled until the file is saved"
msgstr "Alternativen är inaktiverade tills filen har sparats"

msgid "Linked object baking requires Disk Cache to be enabled"
msgstr "För att kunna baka länkade objekt måste Disk Cache vara aktiverat"

msgid "Enable Guides first! Defaulting to Fluid Velocity"
msgstr ""
"Aktivera först guiderna! Standardinställning är Fluid Velocity (flytande "
"hastighet)"

msgid "This object is part of a compound shape"
msgstr "Detta objekt är en del av en sammansatt form"

msgid "Two or more channels are needed below this strip"
msgstr "Två eller flera kanaler behövs under denna remsa"

msgid "Cycles is disabled in this build"
msgstr "Cycles är inaktiverat i denna version"

msgid "A restart of Blender is required"
msgstr "En omstart av Blender krävs"

msgid "File association is handled by the package manager"
msgstr "Filassociation hanteras av pakethanteraren"

msgid "Cannot change action, as it is still being edited in NLA"
msgstr "Kan inte ändra åtgärd, eftersom den fortfarande redigeras i NLA"

msgid ""
"Failed to insert keys on F-Curve with path '%s[%d]', ensure that it is not "
"locked or sampled, and try removing F-Modifiers"
msgstr ""
"Det gick inte att infoga nycklar på F-kurvan med sökvägen '%s[%d]'. "
"Kontrollera att den inte är låst eller samplad och försök ta bort "
"F-modifierare"

msgid "Failed to create asset library directory to save asset"
msgstr ""
"Det gick inte att skapa en katalog för resursbiblioteket för att spara "
"resursen"

msgid "Failed to delete asset library file"
msgstr "Det gick inte att ta bort filen med tillgångsbiblioteket"

msgid "Could not create a copy of ID '%s' to write it in the library"
msgstr ""
"Det gick inte att skapa en kopia av ID '%s' för att skriva den i biblioteket"

msgid "Unable to create attribute in edit mode"
msgstr "Det går inte att skapa attribut i redigeringsläget"

msgid "Attribute is not part of this geometry"
msgstr "Attributet ingår inte i denna geometri"

msgid "The attribute name must not be empty"
msgstr "Attributnamnet får inte vara tomt"

msgid "This attribute cannot be accessed in a procedural context"
msgstr "Detta attribut kan inte nås i ett procedurmässigt sammanhang"

msgid "Can only unpack bake if the current .blend file is saved"
msgstr "Kan endast packa upp bake om den aktuella .blend-filen är sparad"

msgid ""
"This file is managed by the asset system, you cannot overwrite it (using "
"\"Save As\" is possible)"
msgstr ""
"Denna fil hanteras av tillgångssystemet och kan inte skrivas över (det går "
"dock att använda \"Spara som\")"

msgid "Unable to create userpref path"
msgstr "Det går inte att skapa sökvägen userpref"

msgid ""
"Linking or appending from a very old .blend file format (%d.%d), no "
"animation conversion will be done! You may want to re-save your lib file "
"with current Blender"
msgstr ""
"Vid länkning eller tillägg från ett mycket gammalt .blend-filformat (%d.%d) "
"kommer ingen animeringskonvertering att göras! Du kanske vill spara om din "
"lib-fil med den aktuella versionen av Blender"

msgid ""
"Lib Reload: Replacing all references to old data-block '%s' by reloaded one "
"failed, old one (%d remaining users) had to be kept and was renamed to '%s'"
msgstr ""
"Lib Reload: Ersättning av alla referenser till det gamla datablocket '%s' "
"med det omladdade misslyckades, det gamla (%d återstående användare) måste "
"behållas och döptes om till '%s'"

msgid "Path '%s' cannot be made absolute"
msgstr "Sökvägen '%s' kan inte göras absolut"

msgid "Crazyspace transformation is only available for Mesh type of objects"
msgstr "Crazyspace-omvandling är endast tillgänglig för objekt av typen Mesh"

msgid ""
"Source and destination meshes do not have the same number of vertices, "
"'Topology' mapping cannot be used in this case"
msgstr ""
"Käll- och målnät har inte samma antal hörn, därför kan inte "
"topologikartläggning användas i detta fall"

msgid ""
"Source mesh does not have any edges, none of the 'Edge' mappings can be used"
" in this case"
msgstr ""
"Källnätet har inga kanter, ingen av \"Edge\"-mappningarna kan användas i "
"detta fall"

msgid ""
"Source mesh does not have any faces, none of the 'Face' mappings can be used"
" in this case"
msgstr ""
"Källnätet har inga ytor, ingen av \"Face\"-mappningarna kan användas i detta"
" fall"

msgid ""
"Source or destination meshes do not have any vertices, cannot transfer "
"vertex data"
msgstr ""
"Käll- eller målnät har inga hörnpunkter och kan inte överföra hörnpunktsdata"

msgid ""
"Source and destination meshes do not have the same number of edges, "
"'Topology' mapping cannot be used in this case"
msgstr ""
"Käll- och målnät har inte samma antal kanter, därför kan inte "
"topologikartläggning användas i detta fall"

msgid ""
"Source or destination meshes do not have any edges, cannot transfer edge "
"data"
msgstr "Käll- eller målnät har inga kanter och kan inte överföra kantdata"

msgid ""
"Source and destination meshes do not have the same number of face corners, "
"'Topology' mapping cannot be used in this case"
msgstr ""
"Käll- och målnät har inte samma antal hörn, därför kan inte "
"topologikartläggning användas i detta fall"

msgid ""
"Source or destination meshes do not have any faces, cannot transfer corner "
"data"
msgstr "Käll- eller målnät har inga ytor och kan inte överföra hörndata"

msgid ""
"Source and destination meshes do not have the same number of faces, "
"'Topology' mapping cannot be used in this case"
msgstr ""
"Käll- och målmesharna har inte samma antal ytor, därför kan inte "
"'Topology'-mappning användas i detta fall"

msgid ""
"Source or destination meshes do not have any faces, cannot transfer face "
"data"
msgstr "Käll- eller målnät har inga ytor och kan inte överföra ytdata"

msgid "F-Curve modifier lost on '%s[%d]' because it has an unknown type"
msgstr ""
"F-kurvmodifieraren förlorades på '%s[%d]' eftersom den har en okänd typ"

msgid ""
"When saving a tiled image, the path '%s' must contain a valid UDIM marker"
msgstr ""
"När du sparar en kaklad bild måste sökvägen '%s' innehålla en giltig UDIM-"
"markör"

msgid ""
"Impossible to resync data-block %s and its dependencies, as its linked "
"reference is missing"
msgstr ""
"Omöjligt att synkronisera om datablock %s och dess beroenden, eftersom dess "
"länkade referens saknas"

msgid ""
"During resync of data-block %s, %d obsolete overrides were deleted, that had"
" local changes defined by user"
msgstr ""
"Under omsynkroniseringen av datablock %s, %d raderades föråldrade "
"överskrivningar som hade lokala ändringar definierade av användaren"

msgid ""
"Library override templates have been removed: removing all override data "
"from the data-block '%s'"
msgstr ""
"Bibliotekets överskrivningsmallar har tagits bort: alla överskrivningsdata "
"har tagits bort från datablocket '%s'"

msgid ""
"Data corruption: data-block '%s' is using itself as library override "
"reference, removing all override data"
msgstr ""
"Datakorruption: datablocket '%s' använder sig själv som referens för "
"biblioteksöverskrivning, vilket tar bort alla överskrivningsdata"

msgid ""
"Data corruption: data-block '%s' is using another local data-block ('%s') as"
" library override reference, removing all override data"
msgstr ""
"Datakorruption: datablocket '%s' använder ett annat lokalt datablock ('%s') "
"som referens för biblioteksöverskrivning, vilket tar bort all "
"överskrivningsdata"

msgid "Cannot unlink unsupported '%s' from light linking collection '%s'"
msgstr ""
"Det går inte att ta bort länken till det icke-stödda '%s' från "
"ljuslänksamlingen '%s'"

msgid ""
"Merged %d IDs from '%s' Main into '%s' Main; %d IDs and %d Libraries already"
" existed as part of the destination Main, and %d IDs missing from "
"destination Main, were freed together with the source Main"
msgstr ""
"Sammanslagna %d ID:n från '%s' Main till '%s' Main; %d ID:n och %d bibliotek"
" fanns redan som en del av destinations-Main, och %d ID:n som saknades i "
"destinations-Main frigjordes tillsammans med käll-Main"

msgid "The links form a cycle which is not supported"
msgstr "Länkarna bildar en cykel som inte stöds"

msgid "Links can only go into a zone but not out"
msgstr "Länkar kan endast gå in i en zon, men inte ut ur den"

msgid "Unable to pack file, source path '%s' not found"
msgstr "Det går inte att packa filen, källsökvägen '%s' hittades inte"

msgid "Cannot add Rigid Body to non mesh object"
msgstr ""
"Det går inte att lägga till Rigid Body till objekt som inte är mesh-objekt"

msgid ""
"At least 8 common tracks on both keyframes are needed for reconstruction"
msgstr ""
"Minst 8 gemensamma spår på båda nyckelrutorna krävs för rekonstruktion"

msgid "Blender is compiled without motion tracking library"
msgstr "Blender är kompilerad utan bibliotek för rörelsespårning"

msgid "No input grid found that can determine the topology"
msgstr "Inget ingångsnätverk hittades som kan bestämma topologin"

msgid ""
"Data-block '%s' had an invalid embedded node group, which has not been read"
msgstr "Datablocket '%s' hade en ogiltig inbäddad nodgrupp som inte har lästs"

msgid "Scene '%s' had an invalid root collection, which has not been read"
msgstr "Scenen '%s' hade en ogiltig rotsamling som inte har lästs"

msgid ""
"The file was saved by a newer version, open it with Blender %s or later"
msgstr ""
"Filen har sparats med en nyare version. Öppna den med Blender %s eller "
"senare"

msgid ""
"Non-Empty object '%s' cannot duplicate collection '%s' anymore in Blender "
"2.80 and later, removed instancing"
msgstr ""
"Icke-tomt objekt '%s' kan inte längre duplicera samlingen '%s' i Blender "
"2.80 och senare, instansiering har tagits bort"

msgid ""
"Mesh %s has invalid faces, likely caused by the manifold extrude tool in "
"version 2.90.0. Opening and saving the file in a version prior to 5.1 should"
" resolve the issue"
msgstr ""
"Mesh %s har ogiltiga ytor, vilket troligen orsakas av verktyget för manifold"
" extrude i version 2.90.0. Problemet bör lösas genom att öppna och spara "
"filen i en version före 5.1"

msgid ""
"Material %s could not be converted because of different Blend Mode and "
"Shadow Mode (need manual adjustment)"
msgstr ""
"Material %s kunde inte konverteras på grund av olika blandningsläge och "
"skuggläge (kräver manuell justering)"

msgid "Checking validity of current .blend file *BEFORE* save to disk"
msgstr ""
"Kontrollera giltigheten för den aktuella .blend-filen *INNAN* du sparar den "
"på disken"

msgid ""
"Select two edge loops or a single closed edge loop from which two edge loops"
" can be calculated"
msgstr ""
"Välj två kantloopar eller en enda sluten kantloop från vilken två kantloopar"
" kan beräknas"

msgid "Unexpected library type. Failed to create pose asset"
msgstr "Oväntad bibliotekstyp. Det gick inte att skapa pose-resursen"

msgid "Pose assets can only be modified from Pose Mode"
msgstr "Pose-tillgångar kan endast modifieras från Pose Mode"

msgid ""
"NLA Track is the only one evaluated in this animation data-block, with all "
"others muted"
msgstr ""
"NLA Track är den enda som utvärderas i detta animationsdatablock, medan alla"
" andra är avstängda"

msgid "Cannot edit this property from a linked data-block"
msgstr ""
"Det går inte att redigera den här egenskapen från ett länkat datablock"

msgid "None of the selected channels is an Action Slot"
msgstr "Ingen av de valda kanalerna är en Action Slot"

msgid "One or more F-Curves are not visible due to filter settings"
msgstr ""
"En eller flera F-kurvor är inte synliga på grund av filterinställningarna"

msgid "Cannot re-link markers into the same scene"
msgstr "Det går inte att länka om markörer till samma scen"

msgid "The action %s is not editable"
msgstr "Åtgärden %s kan inte redigeras"

msgid "Failed to merge any animation. Note that NLA strips cannot be merged"
msgstr ""
"Det gick inte att slå samman någon animation. Observera att NLA-remsor inte "
"kan slås samman"

msgid "Cannot paste driver variables without a driver"
msgstr "Det går inte att klistra in drivrutinsvariabler utan en drivrutin"

msgid "This property cannot be animated as it will not get updated correctly"
msgstr "Denna egenskap kan inte animeras eftersom den inte uppdateras korrekt"

msgid ""
"Failed to resolve path to property, try manually specifying this using a "
"Keying Set instead"
msgstr ""
"Det gick inte att lösa sökvägen till egenskapen. Försök att ange den "
"manuellt med hjälp av en nyckeluppsättning istället"

msgid ""
"Could not update flags for this F-curve, as RNA path is invalid for the "
"given ID (ID = %s, path = %s)"
msgstr ""
"Det gick inte att uppdatera flaggorna för denna F-kurva, eftersom RNA-"
"sökvägen är ogiltig för det angivna ID:t (ID = %s, sökväg = %s)"

msgid "Successfully removed %d keyframes for keying set '%s'"
msgstr "%d nyckelrutor för nyckeluppsättningen '%s' har tagits bort"

msgid "Scene has no animation data or active action"
msgstr "Scenen har inga animationsdata eller aktiva åtgärder"

msgid "No keyframes removed from %d object(s)"
msgstr "Inga nyckelrutor har tagits bort från %d objekt"

msgid "\"%s\" property cannot be animated"
msgstr "Egenskapen \"%s\" kan inte animeras"

msgid "Cannot remove property from built in keying set"
msgstr "Det går inte att ta bort egenskaper från den inbyggda nyckelsatsen"

msgid "This operator only works in pose mode and armature edit mode"
msgstr ""
"Denna operator fungerar endast i poseringsläge och armeringsredigeringsläge"

msgid "All selected bones were already part of this collection"
msgstr "Alla utvalda ben ingick redan i denna samling"

msgid "None of the selected bones were assigned to this collection"
msgstr "Inget av de utvalda benen tilldelades denna samling"

msgid ""
"Cannot add bone collections to a linked Armature without an override on the "
"Armature Data"
msgstr ""
"Det går inte att lägga till bensamlingar till en länkad armatur utan att "
"åsidosätta armaturdata"

msgid ""
"Cannot add bone collections to a linked Armature with a system override; "
"explicitly create an override on the Armature Data"
msgstr ""
"Det går inte att lägga till bensamlingar till en länkad armatur med ett "
"systemöverskridande; skapa uttryckligen ett överskridande på armaturdatan"

msgid ""
"Cannot update a linked Armature with a system override; explicitly create an"
" override on the Armature Data"
msgstr ""
"Det går inte att uppdatera en länkad armatur med en systemöverskrivning. "
"Skapa en överskrivning explicit på armaturdata"

msgid "Cannot edit bone collections that are linked from another blend file"
msgstr ""
"Det går inte att redigera bensamlingar som är länkade från en annan blend-"
"fil"

msgid "Bone collections can only be edited on an Armature"
msgstr "Bensamlingar kan endast redigeras på en armatur"

msgid "Cannot edit bone collections on linked Armatures without override"
msgstr ""
"Det går inte att redigera bensamlingar på länkade armeringar utan att "
"åsidosätta inställningarna"

msgid ""
"Cannot edit bone collections on a linked Armature with a system override; "
"explicitly create an override on the Armature Data"
msgstr ""
"Det går inte att redigera bensamlingar på en länkad armatur med ett "
"systemöverskridande. Skapa ett överskridande uttryckligen på armaturdatan"

msgid "Linked bone collections are not editable"
msgstr "Länkade bensamlingar kan inte redigeras"

msgid "Cannot (de)select bones on linked object, that would need an override"
msgstr ""
"Det går inte att (av)markera ben på länkat objekt, det skulle kräva en "
"överskrivning"

msgid "This needs a local Armature or an override"
msgstr "Detta kräver en lokal armatur eller en överstyrning"

msgid "Pose lib is only for armatures in pose mode"
msgstr "Pose lib är endast för armeringar i poseläge"

msgid "This pose asset is empty, and thus has no pose"
msgstr "Denna pose-resurs är tom och har därför ingen pose"

msgid "Asset ('%s') is not an action data-block"
msgstr "Tillgången ('%s') är inte ett åtgärdsdatablock"

msgid ""
"Use another Keying Set, as the active one depends on the currently selected "
"items or cannot find any targets due to unsuitable context"
msgstr ""
"Använd en annan tangentuppsättning, eftersom den aktiva beror på de valda "
"objekten eller inte kan hitta några mål på grund av olämpligt sammanhang"

msgid ""
"Actions on this armature will be destroyed by this new rest pose as the "
"transforms stored are relative to the old rest pose"
msgstr ""
"Åtgärder på denna armatur kommer att förstöras av denna nya viloposition, "
"eftersom de lagrade transformationerna är relativa till den gamla "
"vilopositionen"

msgid "Cannot copy/paste packed data"
msgstr "Det går inte att kopiera/klistra in packade data"

msgid "Internal clipboard is empty"
msgstr "Det interna urklipp är tomt"

msgid "Internal clipboard is not from pose mode"
msgstr "Det interna urklipp är inte från poseringsläget"

msgid "Pasted only %d of the %d copied bones, and skipped %d unselected bones"
msgstr ""
"Klistrade in endast %d av de %d kopierade benen och hoppade över %d icke "
"valda ben"

msgid ""
"Delete all asset metadata, turning the selected asset data-blocks back into "
"normal data-blocks, and set Fake User to ensure the data-blocks will still "
"be saved"
msgstr ""
"Ta bort alla tillgångsmetadata, återställ de valda tillgångsdatablocken till"
" normala datablock och ställ in Fake User för att säkerställa att "
"datablocken fortfarande sparas"

msgid ""
"Data-block does not support asset operations - must be a Brush, Collection, "
"Node Group, Object, Pose Action, Scene, or World"
msgstr ""
"Datablocket stöder inte tillgångsoperationer – måste vara en pensel, "
"samling, nodgrupp, objekt, poseringsåtgärd, scen eller värld"

msgid ""
"No data-block selected that supports asset operations - select at least one "
"Brush, Collection, Node Group, Object, Pose Action, Scene, or World"
msgstr ""
"Inget datablock som stöder tillgångsoperationer har valts – välj minst en "
"pensel, samling, nodgrupp, objekt, poseringsåtgärd, scen eller värld"

msgid "Data-block is not marked as asset"
msgstr "Datablocket är inte markerat som tillgång"

msgid ""
"Selected data-blocks are already assets (or do not support use as assets)"
msgstr ""
"Vissa datablock är redan tillgångar (eller stöder inte användning som "
"tillgångar)"

msgid ""
"No asset data-blocks from the current file selected (assets must be stored "
"in the current file to be able to edit or clear them)"
msgstr ""
"Inga tillgångsdatablock från den aktuella filen är markerade (tillgångar "
"måste lagras i den aktuella filen för att kunna redigeras eller rensas)"

msgid "Data-block '%s' is not an asset anymore"
msgstr "Datablocket '%s' är inte längre en tillgång"

msgid "Selected path is outside of the selected asset library"
msgstr "Den valda sökvägen ligger utanför det valda objektbiblioteket"

msgid ""
"Unable to copy bundle due to %zu external dependencies; more details on the "
"console"
msgstr ""
"Det går inte att kopiera paketet på grund av %zu externa beroenden. Mer "
"information finns på konsolen"

msgid "Screenshot cannot be smaller than %i pixels on a side"
msgstr "Skärmdumpen får inte vara mindre än %i pixlar på en sida"

msgid "Asset catalogs cannot be edited in this asset library"
msgstr "Assetkataloger kan inte redigeras i detta assetbibliotek"

msgid "Cannot save asset catalogs before the Blender file is saved"
msgstr ""
"Det går inte att spara tillgångskataloger innan Blender-filen har sparats"

msgid "Asset cannot be modified from this file"
msgstr "Tillgången kan inte ändras från den här filen"

msgid "Enable catalog, making contained assets visible in the asset shelf"
msgstr ""
"Aktivera katalog, så att tillgångarna i den blir synliga i tillgångshyllan"

msgid ""
"Select the asset library and the contained catalogs to display in the asset "
"shelf"
msgstr ""
"Välj tillgångsbiblioteket och de kataloger som ska visas i tillgångshyllan"

msgid "Could not separate selected curve(s)"
msgstr "Det gick inte att separera valda kurvor"

msgid "Cannot split current selection"
msgstr "Det går inte att dela upp det aktuella valet"

msgid "Cannot duplicate current selection"
msgstr "Det går inte att duplicera det aktuella valet"

msgid "The \"stroke\" cannot be empty"
msgstr "\"Stroken\" kan inte vara tom"

msgid "Curve(s) have no active point"
msgstr "Kurvorna har inga aktiva punkter"

msgid ""
"Some curves could not be converted because they were not attached to the "
"surface"
msgstr ""
"Vissa kurvor kunde inte konverteras eftersom de inte var kopplade till ytan"

msgid ""
"Curves do not have attachment information that can be used for deformation"
msgstr "Kurvor har ingen bifogad information som kan användas för deformation"

msgid "The active attribute has an unsupported type"
msgstr "Det aktiva attributet har en typ som inte stöds"

msgid ""
"Tool node group assets not assigned to a catalog.\n"
"Catalogs can be assigned in the Asset Browser"
msgstr ""
"Verktygsnodgruppens tillgångar som inte är tilldelade en katalog. Kataloger "
"kan tilldelas i tillgångsbläddraren"

msgid "Node group's first output must be a geometry"
msgstr "Nodgruppens första utdata måste vara en geometri"

msgid "Failed to find Annotation data to draw into"
msgstr "Det gick inte att hitta anteckningsdata att rita in"

msgid "Cannot delete locked layers"
msgstr "Det går inte att ta bort låsta lager"

msgid "Unable to find layer to add"
msgstr "Det går inte att hitta något lager att lägga till"

msgid "All Line Art objects are now cleared of bakes"
msgstr "Alla Line Art-objekt är nu rensade från bakningar"

msgid "No active object, or active object isn't a Grease Pencil object"
msgstr ""
"Inget aktivt objekt, eller det aktiva objektet är inte ett Grease Pencil-"
"objekt"

msgid "Picked bone does not belong to the already chosen armature"
msgstr "Det valda benet tillhör inte den redan valda armeringen"

msgid ""
"Selection is not a bone. Armature needs to be in Pose Mode or Edit Mode to "
"pick in the 3D Viewport"
msgstr ""
"Valet är inte ett ben. Armaturen måste vara i poseringsläge eller "
"redigeringsläge för att kunna väljas i 3D-vyn"

msgid "The active object needs to be an armature"
msgstr "Det aktiva objektet måste vara en armatur"

msgid "The armature needs to be in Pose mode or Edit mode"
msgstr "Armaturen måste vara i Pose-läge eller Edit-läge"

msgid "Press 'Enter' to sample outside of a Blender window"
msgstr "Tryck på \"Enter\" för att ta ett prov utanför ett Blender-fönster"

msgid ""
"Only keyboard shortcuts can be edited that way, please use User Preferences "
"otherwise"
msgstr ""
"Endast kortkommandon kan redigeras på det sättet. Använd annars "
"användarinställningarna"

msgid "Can't edit driven number value, see driver editor for the driver setup"
msgstr ""
"Kan inte redigera drivrutinsnummervärdet, se drivrutinsredigeraren för "
"drivrutinsinställningarna"

msgid "The data-block %s is not overridable"
msgstr "Datablocket %s kan inte åsidosättas"

msgid "The type of data-block %s is not yet implemented"
msgstr "Datablocket %s är ännu inte implementerat"

msgid "The data-block %s could not be overridden"
msgstr "Datablocket %s kunde inte överskrivas"

msgid ""
"This file is managed by the Blender asset system and cannot be overridden"
msgstr ""
"Denna fil hanteras av Blenders tillgångssystem och kan inte åsidosättas"

msgid ""
"Displays, views or color spaces in this file were missing and have been "
"changed"
msgstr ""
"Visningar, vyer eller färgrymder i den här filen saknades och har ändrats"

msgid "Unable to determine ABC sequence length"
msgstr "Det går inte att fastställa längden på ABC-sekvensen"

msgid "Could not add a layer to the cache file"
msgstr "Det gick inte att lägga till ett lager i cachefilen"

msgid "Unable to find valid 3D View area"
msgstr "Det går inte att hitta ett giltigt 3D-vyområde"

msgid "You have to select a string of connected vertices too"
msgstr "Du måste också välja en sträng av sammankopplade hörn"

msgid ""
"No other selected objects have wire or boundary edges to use for projection"
msgstr ""
"Inga andra valda objekt har tråd- eller gränskanter som kan användas för "
"projektion"

msgid "An edit-mesh with vertex or edge selection mode is required"
msgstr "En redigeringsmesh med val av vertex eller kant krävs"

msgid "The active attribute must have a boolean type"
msgstr "Det aktiva attributet måste ha en boolesk typ"

msgid "The active attribute must be on the vertex, edge, or face domain"
msgstr "Det aktiva attributet måste finnas på vertex-, kant- eller ytdomänen"

msgid "Can only copy one custom normal, vertex normal or face normal"
msgstr "Kan endast kopiera en anpassad normal, vertexnormal eller ytnormal"

msgid "Cannot add vertices in edit mode"
msgstr "Det går inte att lägga till hörn i redigeringsläget"

msgid "Cannot add edges in edit mode"
msgstr "Det går inte att lägga till kanter i redigeringsläget"

msgid "Cannot add loops in edit mode"
msgstr "Det går inte att lägga till loopar i redigeringsläget"

msgid "Cannot add faces in edit mode"
msgstr "Det går inte att lägga till ytor i redigeringsläget"

msgid "Cannot remove more vertices than the mesh contains"
msgstr "Det går inte att ta bort fler hörn än vad nätet innehåller"

msgid "Cannot remove more edges than the mesh contains"
msgstr "Det går inte att ta bort fler kanter än vad nätet innehåller"

msgid "Cannot remove more loops than the mesh contains"
msgstr "Det går inte att ta bort fler öglor än vad nätet innehåller"

msgid "Cannot remove more polys than the mesh contains"
msgstr "Det går inte att ta bort fler polygoner än vad nätet innehåller"

msgid "Selected meshes must have equal numbers of vertices"
msgstr "Valda nät måste ha lika många hörnpunkter"

msgid "Selected objects' names must use .L or .R suffix"
msgstr "Namnen på valda objekt måste ha suffixet .L eller .R"

msgid ""
"Modifier node group assets not assigned to a catalog.\n"
"Catalogs can be assigned in the Asset Browser"
msgstr ""
"Modifierar nodgruppstillgångar som inte är tilldelade till en katalog. "
"Kataloger kan tilldelas i tillgångsbläddraren"

msgid "Image objects can only be added in Object Mode"
msgstr "Bildobjekt kan endast läggas till i objektläget"

msgid "Cannot convert selected objects while they are in edit mode"
msgstr "Det går inte att konvertera valda objekt när de är i redigeringsläge"

msgid "This data does not support joining in edit mode"
msgstr "Dessa data stöder inte sammanfogning i redigeringsläge"

msgid "Cannot delete object '%s' as it is used by override collections"
msgstr ""
"Det går inte att ta bort objektet '%s' eftersom det används av "
"överskrivningssamlingar"

msgid "Object '%s' has no evaluated Curve or Grease Pencil data"
msgstr "Objektet '%s' har inga utvärderade kurv- eller fettpennadata"

msgid "Object '%s' has no evaluated mesh or curves data"
msgstr "Objektet '%s' har inga utvärderade mesh- eller kurvdata"

msgid "Object '%s' has no evaluated Grease Pencil or Curves data"
msgstr "Objektet '%s' har inga utvärderade Grease Pencil- eller Curves-data"

msgid "Object '%s' has no evaluated curves data"
msgstr "Objektet '%s' har inga utvärderade kurvdata"

msgid "None of the objects are compatible with a conversion to \"%s\""
msgstr "Inget av objekten är kompatibelt med en konvertering till \"%s\""

msgid ""
"The selection included %d object type(s) which do not support conversion to "
"\"%s\""
msgstr ""
"Urvalet innehöll %d objekttyp(er) som inte stöder konvertering till \"%s\""

msgid "Cannot edit object '%s' as it is used by override collections"
msgstr ""
"Det går inte att redigera objektet '%s' eftersom det används av "
"överskrivningssamlingar"

msgid "This operation is not supported in edit mode"
msgstr "Denna åtgärd stöds inte i redigeringsläget"

msgid "Baking of multires data only works with an active mesh object"
msgstr "Bakning av multires-data fungerar endast med ett aktivt mesh-objekt"

msgid "Mesh should be unwrapped before multires data baking"
msgstr "Mesh bör packas upp innan multires-data bakas"

msgid "You should have active texture to use multires baker"
msgstr "Du bör ha aktiv textur för att kunna använda multires baker"

msgid ""
"Combined bake pass requires Emission, or a light pass with Direct or "
"Indirect contributions enabled"
msgstr ""
"Kombinerad bakningspass kräver utsläpp eller en lätt pass med direkta eller "
"indirekta bidrag aktiverade"

msgid ""
"Bake pass requires Direct, Indirect, or Color contributions to be enabled"
msgstr ""
"Bake pass kräver att Direct, Indirect eller Color-bidrag är aktiverade"

msgid ""
"No active image found, add a material or bake without the Split Materials "
"option"
msgstr ""
"Ingen aktiv bild hittades, lägg till ett material eller baka utan "
"alternativet Dela material"

msgid "Color attribute baking is only supported for mesh objects"
msgstr "Färgattributbakning stöds endast för meshobjekt"

msgid "Current render engine does not support baking"
msgstr "Den nuvarande renderingsmotorn stöder inte baking"

msgid ""
"Invalid cage object, the cage mesh must have the same number of faces as the"
" active object"
msgstr ""
"Ogiltigt bur-objekt, burens nät måste ha samma antal ytor som det aktiva "
"objektet"

msgid ""
"Object \"%s\" is not a mesh or cannot be converted to a mesh (Curve, Text, "
"Surface or Metaball)"
msgstr ""
"Objektet \"%s\" är inte ett nät eller kan inte konverteras till ett nät "
"(kurva, text, yta eller metaboll)"

msgid "Cage object \"%s\" not found in evaluated scene, it may be hidden"
msgstr ""
"Bur-objekt \"%s\" hittades inte i den utvärderade scenen, det kan vara dolt"

msgid "Object \"%s\" not found in evaluated scene, it may be hidden"
msgstr "Objekt \"%s\" hittades inte i den utvärderade scenen, det kan vara dolt"

msgid ""
"Failed to access mesh from object \"%s\", ensure it's visible while "
"rendering"
msgstr ""
"Det gick inte att komma åt nätet från objekt \"%s\". Se till att det är "
"synligt under rendering"

msgid "Could not add the collection because of dependency cycle detected"
msgstr "Kunde inte lägga till samlingen på grund av upptäckt beroendecykel"

msgid ""
"Cannot unlink a library override collection which is not the root of its "
"override hierarchy"
msgstr ""
"Det går inte att koppla bort en biblioteksoverridingssamling som inte är "
"roten i dess overridehierarki"

msgid "Cannot edit constraints coming from linked data in a library override"
msgstr ""
"Det går inte att redigera begränsningar som kommer från länkade data i en "
"biblioteksöverskrivning"

msgid "No inverse correction is set, so there is nothing to clear"
msgstr "Ingen invers korrigering är inställd, så det finns inget att rensa"

msgid "No other bones are selected"
msgstr "Inga andra ben väljs ut"

msgid "No other objects are selected"
msgstr "Inga andra objekt är markerade"

msgid ""
"Operator is frozen, changes to its settings won't take effect until you "
"unfreeze it"
msgstr ""
"Operatören är fryst, ändringar av dess inställningar träder inte i kraft "
"förrän du låser upp den"

msgid "Skipping object '%s', linked or override data '%s' cannot be modified"
msgstr ""
"Objektet '%s' kan inte hoppas över, länkade eller överskrivna data '%s' kan "
"inte ändras"

msgid ""
"Skipping object '%s', data '%s' has already been processed with a previous "
"object"
msgstr ""
"Objektet '%s' har hoppats över, data '%s' har redan bearbetats med ett "
"tidigare objekt"

msgid "Cannot edit linked mesh or curve data"
msgstr "Det går inte att redigera länkade nät- eller kurvdata"

msgid "Unable to change object mode while transforming"
msgstr "Det går inte att ändra objektläge under transformationen"

msgid "Cannot add hook bone for a non armature object"
msgstr ""
"Det går inte att lägga till kroksben för ett objekt som inte är en armatur"

msgid ""
"Unable to transfer mode, the source and/or target objects are not editable"
msgstr ""
"Om det inte går att överföra läget kan käll- och/eller målopjekten inte "
"redigeras"

msgid "Apply modifier as a new shapekey and keep it in the stack"
msgstr "Tillämpa modifieraren som en ny formnyckel och behåll den i stapeln"

msgid "Only one modifier of this type is allowed"
msgstr "Endast en modifierare av denna typ är tillåten"

msgid "Evaluated geometry from modifier does not contain a mesh"
msgstr "Utvärderad geometri från modifieraren innehåller inte ett nät"

msgid "Only deforming modifiers can be applied to shapes"
msgstr "Endast deformerande modifierare kan tillämpas på former"

msgid "Cannot apply modifier for this object type"
msgstr "Modifieraren kan inte tillämpas på denna objekttyp"

msgid "Modifier cannot be applied to a mesh with shape keys"
msgstr "Modifieraren kan inte tillämpas på ett nät med formnycklar"

msgid ""
"Cannot apply constructive modifiers on curve. Convert curve to mesh in order"
" to apply"
msgstr ""
"Det går inte att tillämpa konstruktiva modifierare på kurvor. Konvertera "
"kurvan till nät för att kunna tillämpa modifierarna"

msgid "Evaluated geometry from modifier does not contain a point cloud"
msgstr "Utvärderad geometri från modifieraren innehåller inte någon punktmoln"

msgid ""
"Evaluated geometry from modifier does not contain Grease Pencil geometry"
msgstr ""
"Utvärderad geometri från modifieraren innehåller inte Grease Pencil-geometri"

msgid "Modifiers cannot be applied in edit mode"
msgstr "Modifierare kan inte tillämpas i redigeringsläget"

msgid "Modifiers cannot be applied to multi-user data"
msgstr "Modifierare kan inte tillämpas på data för flera användare"

msgid ""
"Constructive modifier cannot be applied to multi-res data in sculpt mode"
msgstr ""
"Konstruktiv modifierare kan inte tillämpas på multiresolutionsdata i "
"skulpteringsläge"

msgid "Applied modifier was not first, result may not be as expected"
msgstr ""
"Den tillämpade modifieraren var inte den första, resultatet kanske inte blir"
" som förväntat"

msgid "Modifier '%s' was not copied to any objects"
msgstr "Modifieraren '%s' kopierades inte till några objekt"

msgid "Cannot edit modifiers coming from linked data in a library override"
msgstr ""
"Det går inte att redigera modifierare som kommer från länkade data i en "
"biblioteksöverskrivning"
