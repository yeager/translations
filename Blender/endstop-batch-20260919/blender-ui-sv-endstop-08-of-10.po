msgstr ""
"Det gick inte att öppna Alembic-arkivet för läsning, se konsolen för mer "
"information"

msgid "Unable to create new object"
msgstr "Det går inte att skapa ett nytt objekt"

msgid "%s: Cannot copy %s. The source and destination paths are the same"
msgstr "%s: Kan inte kopiera %s. Käll- och målvägarna är desamma"

msgid ""
"USD Export: Couldn't move new usdz file from temporary location %s to %s"
msgstr ""
"USD Export: Det gick inte att flytta den nya usdz-filen från den tillfälliga"
