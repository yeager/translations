msgid "This modifier operation is not allowed from Edit mode"
msgstr "Denna modifieringsåtgärd är inte tillåten från redigeringsläget"

msgid "Modifiers cannot be applied on override data"
msgstr "Modifierare kan inte tillämpas på överskrivningsdata"

msgid "Reshape can work only with higher levels of subdivisions"
msgstr "Reshape kan endast fungera med högre nivåer av subdivisionar"

msgid "Objects do not have the same number of vertices"
msgstr "Objekten har inte samma antal hörn"

msgid "No valid subdivisions found to rebuild a lower level"
msgstr ""
"Inga giltiga subdivisionar hittades för att återuppbygga en lägre nivå"

msgid "Operation cannot be performed in edit mode"
msgstr "Åtgärden kan inte utföras i redigeringsläge"

msgid "Cannot link objects into the same scene"
msgstr "Det går inte att länka objekt till samma scen"

msgid "Cannot link objects into a linked scene"
msgstr "Det går inte att länka objekt till en länkad scen"

msgid "Cannot make library override from a local object"
msgstr "Det går inte att göra biblioteksoverridning från ett lokalt objekt"

msgid "The node group must have a geometry output socket"
msgstr "Nodgruppen måste ha ett geometriutgångsuttag"

msgid "The first output must be a geometry socket"
msgstr "Den första utgången måste vara ett geometrisockel"

msgid "Node group must be a geometry node tree"
msgstr "Nodgruppen måste vara ett geometrinodträd"

msgid "Cannot unlink this object data"
msgstr "Det går inte att ta bort länken till detta objektdata"

msgid "Collection '%s' (instantiated by the active object) is not overridable"
msgstr ""
"Samlingen '%s' (instansierad av det aktiva objektet) kan inte åsidosättas"

msgid ""
"Too many potential root collections (%d) for the override hierarchy, please "
"use the Outliner instead"
msgstr ""
"För många potentiella rotsamlingar (%d) för överskrivningshierarkin, använd "
"istället Outliner"

msgid "Voxel remesher cannot run with a voxel size of 0.0"
msgstr "Voxel remesher kan inte köras med en voxelstorlek på 0,0"

msgid ""
"QuadriFlow: The mesh needs to be manifold and have face normals that point "
"in a consistent direction"
msgstr ""
"QuadriFlow: Nätet måste vara mångfaldigt och ha ytnormaler som pekar i en "
"konsekvent riktning"

msgid "The remesher cannot work on linked or override data"
msgstr "Remesher kan inte arbeta med länkade eller överskrivna data"

msgid "The remesher cannot run from edit mode"
msgstr "Remesher kan inte köras från redigeringsläget"

msgid "The remesher cannot run with dyntopo activated"
msgstr "Remesher kan inte köras med dyntopo aktiverat"

msgid "The remesher cannot run with a Multires modifier in the modifier stack"
msgstr ""
"Remesher kan inte köras med en Multires-modifierare i modifierarstacken"

msgid ""
"Use another Keying Set, as the active one depends on the currently selected "
"objects or cannot find any targets due to unsuitable context"
msgstr ""
"Använd en annan nyckelsats, eftersom den aktiva beror på de objekt som för "
"närvarande är markerade eller inte kan hitta några mål på grund av olämpligt"
" sammanhang"

msgid "Only one Effect of this type is allowed"
msgstr "Endast en effekt av denna typ är tillåten"

msgid "Cannot edit shaderfxs in a library override"
msgstr "Det går inte att redigera shaderfxs i en biblioteksöverskrivning"

msgid "Cannot edit library or override data"
msgstr "Det går inte att redigera biblioteket eller åsidosätta data"

msgid "Cannot edit shaderfxs coming from linked data in a library override"
msgstr ""
"Det går inte att redigera shaderfxs som kommer från länkade data i en "
"biblioteksöverskrivning"

msgid "The active shape key of %s is locked"
msgstr "Den aktiva formnyckeln för %s är låst"

msgid "Failed to apply rotation to some of the objects"
msgstr "Det gick inte att tillämpa rotation på vissa av objekten"

msgid "Set Origin not supported for Empty object(s)"
msgstr "Set Origin stöds inte för tomma objekt"

msgid "Curves Object does not support this set origin operation"
msgstr "Curves Object stöder inte denna inställning av ursprung"

msgid "Grease Pencil Object does not support this set origin operation"
msgstr "Fettpennaobjekt stöder inte denna inställning av ursprungsposition"

msgid "Point cloud object does not support this set origin operation"
msgstr "Punktmolnobjektet stöder inte denna operation för att ange ursprung"

msgid "Editmode lattice is not supported yet"
msgstr "Redigeringsläget för gitter stöds ännu inte"

msgid "Object type \"%s\" does not have editable data"
msgstr "Objekttyp \"%s\" har inga redigerbara data"

msgid "Vertex select needs to be enabled in weight paint mode"
msgstr "Vertex select måste vara aktiverat i viktmålningsläget"

msgid ""
"Fluid: Could not use default cache directory '%s', please define a valid "
"cache path manually"
msgstr ""
"Fluid: Det gick inte att använda standardkachekatalogen '%s'. Ange en giltig"
" cacheväg manuellt"

msgid "Library override data-blocks only support Disk Cache storage"
msgstr ""
"Bibliotekets överskrivningsdatablock stöder endast lagring i diskcache"

msgid "Linked data-blocks do not allow editing caches"
msgstr "Länkade datablock tillåter inte redigering av cacheminnen"

msgid ""
"Linked or library override data-blocks do not allow adding or removing "
"caches"
msgstr ""
"Länkade eller biblioteksöverskrivande datablock tillåter inte att "
"cacheminnen läggs till eller tas bort"

msgid "Object '%s' already has a Rigid Body Constraint"
msgstr "Objektet '%s' har redan en rigid kroppsbegränsning"

msgid "Object has no Rigid Body settings to remove"
msgstr "Objektet har inga inställningar för stel kropp som kan tas bort"

msgid "Rigid Body World has no associated physics data to export"
msgstr "Rigid Body World har inga associerade fysikdata att exportera"

msgid "Cannot write a single file with an animation format selected"
msgstr "Det går inte att skriva en enda fil med ett animerat format valt"

msgid ""
"Render the viewport for the animation range of this scene, but only render "
"keyframes of selected objects"
msgstr ""
"Rendera visningsfönstret för animeringsområdet i denna scen, men rendera "
"endast nyckelrutor för valda objekt"

msgid "Node groups do not support automatic previews"
msgstr "Nodgrupper stöder inte automatiska förhandsvisningar"

msgid ""
"Collection does not contain object types that can be rendered for the "
"automatic preview"
msgstr ""
"Samlingen innehåller inte objekttyper som kan återges för automatisk "
"förhandsgranskning"

msgid "Scenes without a camera do not support previews"
msgstr "Scener utan kamera stöder inte förhandsgranskningar"

msgid "Data-block type does not support automatic previews"
msgstr "Datablocktypen stöder inte automatiska förhandsvisningar"

msgid ""
"The active lineset does not have a line style (indicating data corruption)"
msgstr ""
"Den aktiva linjesatsen har ingen linjestil (vilket indikerar datakorruption)"

msgid "The object the data pointer refers to is not a valid modifier"
msgstr "Objektet som datapekaren refererar till är inte en giltig modifierare"

msgid "Unable to remove material slot in edit mode"
msgstr "Det går inte att ta bort materialplatsen i redigeringsläget"

msgid "A narrow vertical area interferes with this operation"
msgstr "Ett smalt vertikalt område stör denna operation"

msgid "A narrow horizontal area interferes with this operation"
msgstr "Ett smalt horisontellt område stör denna operation"

msgid "Only window region can be 4-split"
msgstr "Endast fönsterområdet kan delas upp i fyra delar"

msgid "Only last region can be 4-split"
msgstr "Endast den sista regionen kan delas upp i fyra delar"

msgid "Cannot edit library linked or non-editable override object"
msgstr ""
"Det går inte att redigera bibliotekskopplade eller icke-redigerbara "
"överskrivningsobjekt"

msgid "Toggling regions in the Top-bar is not allowed"
msgstr "Det är inte tillåtet att växla mellan regioner i den övre fältet"

msgid "Flipping regions in the Top-bar is not allowed"
msgstr "Det är inte tillåtet att vända regioner i toppfältet"

msgid "Right click on buttons to add them to this menu"
msgstr "Högerklicka på knapparna för att lägga till dem i denna meny"

msgid "File not found '%s'"
msgstr "Filen '%s' hittades inte"

msgid "Assets in the current file cannot be individually saved"
msgstr "Tillgångarna i den aktuella filen kan inte sparas individuellt"

msgid "Assets in the current file cannot be reverted"
msgstr "Tillgångarna i den aktuella filen kan inte återställas"

msgid "Invalid UV map: UV islands must not overlap"
msgstr "Ogiltig UV-karta: UV-öar får inte överlappa varandra"

msgid "Curves do not have surface attachment information"
msgstr "Kurvor har ingen information om ytans fästning"

msgid "The modifier used does not support deformed locations"
msgstr "Den modifierare som används stöder inte deformerade platser"

msgid "Mask overlay opacity is currently set to 0"
msgstr "Masköverläggets opacitet är för närvarande inställd på 0"

msgid "Face Sets overlay opacity is currently set to 0"
msgstr ""
"Överlagringens opacitet för ansiktsuppsättningar är för närvarande inställd "
"på 0"

msgid ""
"Keeping the modifiers will increase polycount when returning to object mode"
msgstr ""
"Om du behåller modifierarna ökar antalet polygoner när du återgår till "
"objektläget"

msgid ""
"Active brush does not contain any texture to distort the expand boundary"
msgstr "Aktiv pensel innehåller ingen textur som förvränger expansionsgränsen"

msgid "Texture mapping not set to 3D, results may be unpredictable"
msgstr ""
"Texturmappning är inte inställd på 3D, resultatet kan bli oförutsägbart"

msgid "The geometry cannot be extracted with dyntopo activated"
msgstr "Geometrin kan inte extraheras med dyntopo aktiverat"

msgid "Boolean result is too big for solver to handle"
msgstr ""
"Det booleska resultatet är för stort för att lösaren ska kunna hantera det"

msgid "Brush. Use Left Click to sample for palette instead"
msgstr "Pensel. Använd vänster musknapp för att välja färg i paletten"

msgid "Palette. Use Left Click to sample more colors"
msgstr "Palett. Använd vänster musknapp för att välja fler färger"

msgid "Cancelling this stroke is unsupported"
msgstr "Det går inte att avbryta denna åtgärd"

msgid "AutoPack is enabled, so image will be packed again on file save"
msgstr ""
"AutoPack är aktiverat, så bilden kommer att packas igen när filen sparas"

msgid "Could not unassign the active Action"
msgstr "Det gick inte att avaktivera den aktiva åtgärden"

msgid ""
"Action '%s' will not be saved, create Fake User or Stash in NLA Stack to "
"retain"
msgstr ""
"Åtgärd \"%s\" sparas inte. Skapa en falsk användare eller stash i NLA-"
"stacken för att behålla den"

msgid "Keyframe pasting is not available for mask mode"
msgstr "Inklistring av nyckelrutor är inte tillgängligt för mask-läget"

msgid "Keyframe pasting is not available for Grease Pencil or mask mode"
msgstr ""
"Inklistring av nyckelrutor är inte tillgängligt för Grease Pencil eller "
"mask-läge"

msgid "Insert Keyframes is not yet implemented for this mode"
msgstr "Infoga nyckelrutor är ännu inte implementerat för detta läge"

msgid "Cannot activate a file selector dialog, one already open"
msgstr "Det går inte att aktivera en filväljardialog, en är redan öppen"

msgid ""
"At least one track with bundle should be selected to define origin position"
msgstr ""
"Minst ett spår med bunt ska väljas för att definiera ursprungspositionen"

msgid "Catalog is already placed inside this catalog"
msgstr "Katalogen finns redan i denna katalog"

msgid "Only assets from this current file can be moved between catalogs"
msgstr ""
"Endast tillgångar från den aktuella filen kan flyttas mellan kataloger"

msgid "Catalogs cannot be edited in this asset library"
msgstr "Kataloger kan inte redigeras i detta tillgångsbibliotek"

msgid "This file is read-only"
msgstr "Denna fil är skrivskyddad"

msgid "This is a restricted system file"
msgstr "Detta är en begränsad systemfil"

msgid "Unable to create configuration directory to write bookmarks"
msgstr ""
"Det går inte att skapa konfigurationskatalogen för att skriva bokmärken"

msgid "Could not create new folder name"
msgstr "Det gick inte att skapa ett nytt mappnamn"

msgid "Unable to open or write bookmark file \"%s\""
msgstr "Det går inte att öppna eller skriva bokmärkesfilen \"%s\""

msgid "'%s' given path is OS-invalid, creating '%s' path instead"
msgstr ""
"Den angivna sökvägen '%s' är ogiltig i operativsystemet, vilket istället "
"skapar sökvägen '%s'"

msgid "Add a Driver Variable to keep track of an input used by the driver"
msgstr ""
"Lägg till en drivrutinsvariabel för att hålla reda på en ingång som används "
"av drivrutinen"

msgid ""
"Force updates of dependencies - Only use this if drivers are not updating "
"correctly"
msgstr ""
"Tvinga uppdateringar av beroenden – Använd endast detta om drivrutinerna "
"inte uppdateras korrekt"

msgid "See Modifiers panel below"
msgstr "Se panelen Modifierare nedan"

msgid "F-Curve does not have any keyframes as it only contains sampled points"
msgstr ""
"F-kurvan har inga nyckelrutor eftersom den endast innehåller samplade "
"punkter"

msgid "It cannot be left blank"
msgstr "Det får inte lämnas tomt"

msgid ""
"It cannot start with a special character, including '$', '@', '!', '~', '+',"
" '-', '_', '.', or ' '"
msgstr ""
"Det får inte börja med ett specialtecken, inklusive '$', '@', '!', '~', '+',"
" '-', '_', '.' eller ' '"

msgid "It cannot contain special (non-alphabetical/numeric) characters"
msgstr ""
"Den får inte innehålla specialtecken (icke-alfabetiska/numeriska tecken)"

msgid "It cannot be a reserved keyword in Python"
msgstr "Det kan inte vara ett reserverat nyckelord i Python"

msgid "WARNING: Driver expression may not work correctly"
msgstr "VARNING: Driveruttrycket kanske inte fungerar korrekt"

msgid "TIP: bpy.context is not safe for renderfarm usage"
msgstr "TIPS: bpy.context är inte säkert för användning i renderfarmar"

msgid "TIP: Use F-Curves for procedural animation instead"
msgstr "TIPS: Använd F-kurvor för proceduranimering istället"

msgid "F-Modifiers can generate curves for those too"
msgstr "F-modifierare kan också generera kurvor för dessa"

msgid ""
"No active F-Curve to add a keyframe to. Select an editable F-Curve first"
msgstr ""
"Ingen aktiv F-kurva att lägga till en nyckelbildruta till. Välj först en "
"redigerbar F-kurva"

msgid "Keyframes cannot be added to sampled F-Curves"
msgstr "Nyckelrutor kan inte läggas till i samplade F-kurvor"

msgid ""
"No Euler Rotations could be corrected, ensure each rotation has keys for all"
" components, and that F-Curves for these are in consecutive XYZ order and "
"selected"
msgstr ""
"Inga Euler-rotationer kunde korrigeras. Se till att varje rotation har "
"nycklar för alla komponenter och att F-kurvorna för dessa är i konsekutiv "
"XYZ-ordning och markerade"

msgid ""
"Decimate F-Curves by specifying how much they can deviate from the original "
"curve"
msgstr ""
"Decimera F-kurvor genom att ange hur mycket de kan avvika från den "
"ursprungliga kurvan"

msgid "You need at least 2 keys to the right side of the selection"
msgstr "Du behöver minst två tangenter till höger om markeringen"

msgid "You need at least 2 keys to the left side of the selection"
msgstr "Du behöver minst två tangenter till vänster om markeringen"

msgid "There is no animation data to operate on"
msgstr "Det finns inga animationsdata att bearbeta"

msgid "Movies or image sequences do not support packing"
msgstr "Filmer eller bildsekvenser stöder inte packning"

msgid "No images have been changed"
msgstr "Inga bilder har ändrats"

msgid "No compatible images are on the clipboard"
msgstr "Det finns inga kompatibla bilder i urklipp"

msgid "Pack all used external files into this .blend file"
msgstr "Packa alla använda externa filer i denna .blend-fil"

msgid "Data-block using this packed file is not editable"
msgstr "Data-block som använder denna packade fil är inte redigerbara"

msgid "Cannot set relative paths with an unsaved blend file"
msgstr "Det går inte att ställa in relativa sökvägar med en osparad blend-fil"

msgid "Cannot set absolute paths with an unsaved blend file"
msgstr "Det går inte att ange absoluta sökvägar med en osparad blend-fil"

msgid ""
"No active track(s) to add strip to, select an existing track or add one "
"before trying again"
msgstr ""
"Inga aktiva spår att lägga till remsan till, välj ett befintligt spår eller "
"lägg till ett innan du försöker igen"

msgid ""
"Cannot swap selected strips because they will overlap each other in their "
"new places"
msgstr ""
"Det går inte att byta plats på valda remsor eftersom de kommer att överlappa"
" varandra på sina nya platser"

msgid ""
"Cannot swap selected strips as they will not be able to fit in their new "
"places"
msgstr ""
"Det går inte att byta ut valda remsor eftersom de inte får plats på sina nya"
" platser"

msgid ""
"Could not add action '%s' as it cannot be used relative to ID-blocks of type"
" '%s'"
msgstr ""
"Kunde inte lägga till åtgärden '%s' eftersom den inte kan användas i "
"relation till ID-block av typen '%s'"

msgid ""
"Cannot swap '%s' and '%s' as one or both will not be able to fit in their "
"new places"
msgstr ""
"Det går inte att byta plats på '%s' och '%s', eftersom en eller båda inte "
"får plats på sina nya platser"

msgid ""
"Cannot push down actions while tweaking a strip's action, exit tweak mode "
"first"
msgstr ""
"Det går inte att trycka ner åtgärder medan du justerar en remsa, avsluta "
"först justeringsläget"

msgid "Select an existing NLA Track or an empty action line first"
msgstr "Välj först en befintlig NLA-spår eller en tom åtgärdsrad"

msgid "Animation track at index %d is not a NLA 'Active Action' track"
msgstr "Animationsspåret vid index %d är inte ett NLA-spår för \"Aktiv åtgärd\""

msgid ""
"Node group assets not assigned to a catalog.\n"
"Catalogs can be assigned in the Asset Browser"
msgstr ""
"Nodgruppstillgångar som inte har tilldelats en katalog. Kataloger kan "
"tilldelas i tillgångsbläddraren"

msgid "Could not determine type of group node"
msgstr "Det gick inte att fastställa typen av gruppnod"

msgid "Could not add an image node"
msgstr "Det gick inte att lägga till en bildnod"

msgid "Could not add image. A node tree has not been created or assigned"
msgstr ""
"Det gick inte att lägga till bild. Ett nodträd har inte skapats eller "
"tilldelats"

msgid "Could not add a mask node"
msgstr "Det gick inte att lägga till en masknod"

msgid ""
"Adding node groups isn't supported for custom (Python defined) node trees"
msgstr ""
"Det går inte att lägga till nodgrupper för anpassade (Python-definierade) "
"nodträd"

msgid ""
"Attributes with these names used within the group may conflict with existing"
" attributes"
msgstr ""
"Attribut med dessa namn som används inom gruppen kan komma i konflikt med "
"befintliga attribut"

msgid ""
"The execution time from the node tree's latest evaluation. For frame and "
"group nodes, the time for all sub-nodes"
msgstr ""
"Exekveringstiden från nodträdets senaste utvärdering. För bildruta- och "
"gruppnoder, tiden för alla underordnade noder"

msgid ""
"Cannot add zone input node '%s' to a group without its paired output '%s'"
msgstr ""
"Det går inte att lägga till zoninmatningsnoden '%s' till en grupp utan dess "
"parade utmatning '%s'"

msgid ""
"Cannot add zone output node '%s' to a group without its paired input '%s'"
msgstr ""
"Det går inte att lägga till zonutgångsnoden '%s' till en grupp utan dess "
"parade ingång '%s'"

msgid "There is no parent group node in this context"
msgstr "Det finns ingen överordnad gruppnod i detta sammanhang"

msgid "Cannot add a new collection to linked/override scene"
msgstr "Det går inte att lägga till en ny samling till länkad/ersättande scen"

msgid "Cannot add a collection to a linked/override collection/scene"
msgstr ""
"Det går inte att lägga till en samling till en länkad/ersättande "
"samling/scen"

msgid "Cannot add a color tag to a linked collection"
msgstr "Det går inte att lägga till en färgtagg till en länkad samling"

msgid ""
"Cannot delete collection '%s', it is either a linked one used by other "
"linked scenes/collections, or a library override one"
msgstr ""
"Det går inte att ta bort samlingen '%s', eftersom den antingen är länkad "
"till andra scener/samlingar eller är en överskrivning i biblioteket"

msgid ""
"Unable to duplicate %d of the selected collections. Could not find a valid "
"parent collection for the new duplicate, they won't be linked to any view "
"layer"
msgstr ""
"Det går inte att duplicera %d av de valda samlingarna. Det gick inte att "
"hitta en giltig överordnad samling för den nya dupliceringen, de kommer inte"
" att länkas till något visningslager"

msgid "Cannot edit library linked or non-editable override object(s)"
msgstr ""
"Det går inte att redigera bibliotekskopplade eller icke-redigerbara "
"överskrivningsobjekt"

msgid ""
"Item has no users and will be removed.\n"
"Click to protect from deletion"
msgstr ""
"Objektet har inga användare och kommer att tas bort. Klicka för att skydda "
"mot radering"

msgid "Library path '%s' does not exist, correct this before saving"
msgstr "Bibliotekssökvägen '%s' finns inte, korrigera detta innan du sparar"

msgid "Library path '%s' is now valid, please reload the library"
msgstr "Bibliotekssökvägen '%s' är nu giltig. Ladda om biblioteket"

msgid "Strip names are not editable from the Outliner"
msgstr "Stripnamn kan inte redigeras från Outliner"

msgid "Overridden data-blocks names are not editable"
msgstr "Överskrivna datablocksnamn kan inte redigeras"

msgid "Library path is not editable, use the Relocate operation"
msgstr "Bibliotekets sökväg kan inte redigeras, använd funktionen Flytta"

msgid "There is no active data-block"
msgstr "Det finns inga aktiva datablock"

msgid ""
"Attempt to delete scenes as part of a purge operation, should never happen"
msgstr ""
"Försök att radera scener som en del av en rensningsoperation bör aldrig ske"

msgid ""
"Cannot delete library override id '%s', it is part of an override hierarchy"
msgstr ""
"Det går inte att ta bort biblioteksöverskrivnings-id '%s', det ingår i en "
"överskrivningshierarki"

msgid ""
"Cannot find a scene to replace the active one, which belongs to the to be "
"deleted library '%s'"
msgstr ""
"Det går inte att hitta en scen som kan ersätta den aktiva scenen, som "
"tillhör biblioteket '%s' som ska raderas"

msgid "Cannot delete currently visible workspace id '%s'"
msgstr ""
"Det går inte att ta bort det aktuella synliga arbetsutrymmet med id '%s'"

msgid ""
"Old ID '%s' is linked from a library, indirect usages of this data-block "
"will not be remapped"
msgstr ""
"Gammal ID '%s' är länkad från ett bibliotek, indirekt användning av detta "
"datablock kommer inte att ommappas"

msgid ""
"Copying ID '%s' is not possible, '%s' type of data-blocks is not supported"
msgstr "Det går inte att kopiera ID '%s', datablock av typen '%s' stöds inte"

msgid "The active data-block '%s' is not a valid linked one"
msgstr "Det aktiva datablocket '%s' är inte ett giltigt länkat block"

msgid "The active data-block '%s' is used by other linked data"
msgstr "Det aktiva datablocket '%s' används av andra länkade data"

msgid ""
"Cannot unlink action '%s'. It's not clear which object or object-data it "
"should be unlinked from, there's no object or object-data as parent in the "
"Outliner tree"
msgstr ""
"Det går inte att koppla bort åtgärden '%s'. Det är oklart vilket objekt "
"eller vilka objektdata den ska kopplas bort från, eftersom det inte finns "
"något objekt eller några objektdata som överordnade i Outliner-trädet"

msgid ""
"Cannot unlink material '%s'. It's not clear which object or object-data it "
"should be unlinked from, there's no object or object-data as parent in the "
"Outliner tree"
msgstr ""
"Det går inte att koppla bort materialet '%s'. Det är oklart vilket objekt "
"eller vilka objektdata det ska kopplas bort från, eftersom det inte finns "
"något objekt eller några objektdata som överordnade i Outliner-trädet"

msgid "Cannot unlink the material '%s' from linked object data"
msgstr "Det går inte att koppla bort materialet '%s' från länkade objektdata"

msgid ""
"Cannot unlink texture '%s'. It's not clear which Freestyle line style it "
"should be unlinked from, there's no Freestyle line style as parent in the "
"Outliner tree"
msgstr ""
"Det går inte att koppla bort texturen '%s'. Det är oklart vilken Freestyle-"
"linjestil den ska kopplas bort från, det finns ingen Freestyle-linjestil som"
" överordnad i Outliner-trädet"

msgid ""
"Cannot unlink collection '%s'. It's not clear which scene, collection or "
"instance empties it should be unlinked from, there's no scene, collection or"
" instance empties as parent in the Outliner tree"
msgstr ""
"Det går inte att koppla bort samlingen '%s'. Det är oklart vilken scen, "
"samling eller instans den ska kopplas bort från, eftersom det inte finns "
"någon scen, samling eller instans som är överordnad i Outliner-trädet"

msgid ""
"Cannot unlink collection '%s' parented to another linked collection '%s'"
msgstr ""
"Det går inte att koppla bort samlingen '%s' som är kopplad till en annan "
"samling '%s'"

msgid "Cannot unlink object '%s' parented to another linked object '%s'"
msgstr ""
"Det går inte att koppla bort objektet '%s' som är kopplat till ett annat "
"länkat objekt '%s'"

msgid "Cannot unlink object '%s' from linked collection or scene '%s'"
msgstr ""
"Det går inte att koppla bort objektet '%s' från den länkade samlingen eller "
"scenen '%s'"

msgid ""
"Cannot unlink world '%s'. It's not clear which scene it should be unlinked "
"from, there's no scene as parent in the Outliner tree"
msgstr ""
"Det går inte att koppla bort världen '%s'. Det är oklart vilken scen den ska"
" kopplas bort från, det finns ingen scen som överordnad i Outliner-trädet"

msgid ""
"Could not create library override from data-block '%s', as it is not "
"overridable"
msgstr ""
"Det gick inte att skapa biblioteksöverskrivning från datablocket '%s', "
"eftersom det inte går att överskriva"

msgid ""
"Could not create library override from data-block '%s', one of its parents "
"is not overridable ('%s')"
msgstr ""
"Det gick inte att skapa biblioteksoverride från datablocket '%s', en av dess"
" överordnade är inte överskrivbar ('%s')"

msgid ""
"Could not create library override from one or more of the selected data-"
"blocks"
msgstr ""
"Det gick inte att skapa biblioteksöverskrivning från ett eller flera av de "
"valda datablocken"

msgid ""
"Cannot clear embedded library override '%s', only overrides of real data-"
"blocks can be directly cleared"
msgstr ""
"Det går inte att rensa den inbäddade biblioteksöverskrivningen '%s', endast "
"överskrivningar av verkliga datablock kan rensas direkt"

msgid ""
"Cannot clear linked library override '%s', only local overrides can be "
"directly cleared"
msgstr ""
"Det går inte att rensa länkad biblioteksöverskrivning '%s', endast lokala "
"överskrivningar kan rensas direkt"

msgid ""
"Contains linked library overrides that need to be resynced, updating the "
"library is recommended"
msgstr ""
"Innehåller länkade biblioteksöverskrivningar som måste synkroniseras om. Det"
" rekommenderas att uppdatera biblioteket"

msgid ""
"This override data-block is not needed anymore, but was detected as user-"
"edited"
msgstr ""
"Detta överskrivningsdatablock behövs inte längre, men upptäcktes som "
"användarredigerat"

msgid "This override data-block is unused"
msgstr "Detta överskrivningsdatablock används inte"

msgid ""
"This override property does not exist in current data, it will be removed on"
" next .blend file save"
msgstr ""
"Denna överskrivningsegenskap finns inte i aktuella data och kommer att tas "
"bort nästa gång .blend-filen sparas"

msgid ""
"Add a multiply blend mode effect strip for two selected strips with video "
"content"
msgstr ""
"Lägg till en effektremsa med blandningsläget Multiplicera för två valda "
"remsor med videoinnehåll"

msgid ""
"Scene assets not assigned to a catalog.\n"
"Catalogs can be assigned in the Asset Browser"
msgstr ""
"Scenresurser som inte är tilldelade en katalog. Kataloger kan tilldelas i "
"resursbläddraren"

msgid "Cannot set a negative range"
msgstr "Det går inte att ange ett negativt intervall"

msgid "This strip type cannot be retimed"
msgstr "Denna remsa kan inte omsynkroniseras"

msgid "This text has not been saved"
msgstr "Denna text har inte sparats"

msgid "See '%s' in the text editor"
msgstr "Se \"%s\" i textredigeraren"

msgid "Registration not possible from Microsoft Store installations"
msgstr "Registrering är inte möjlig från installationer från Microsoft Store"

msgid "Unregistration not possible from Microsoft Store installations"
msgstr ""
"Avregistrering är inte möjlig från installationer från Microsoft Store"

msgid "There is no asset library to remove"
msgstr "Det finns inget tillgångsbibliotek att ta bort"

msgid "There is no extension repository to remove"
msgstr "Det finns inget tilläggsarkiv att ta bort"

msgid ""
"Cannot remove background image %d from camera '%s', as it is from the linked"
