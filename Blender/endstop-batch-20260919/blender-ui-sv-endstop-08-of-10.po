msgstr ""
"Kan inte ta bort bakgrundsbilden %d från kameran '%s', eftersom den kommer "
"från länkade referensdata"

msgid ""
"Cannot navigate a camera from an external library or non-editable override"
msgstr ""
"Det går inte att navigera en kamera från ett externt bibliotek eller en "
"icke-redigerbar överskrivning"

msgid "Cannot navigate when the view offset is locked"
msgstr "Det går inte att navigera när vyförskjutningen är låst"

msgid "Rotation is not supported in the Dope Sheet Editor"
msgstr "Rotation stöds inte i Dope Sheet Editor"

msgid "'Shrink/Fatten' meshes is only supported in edit mode"
msgstr "\"Krymp/Feta\" nät stöds endast i redigeringsläget"

msgid ""
"Use 'Time_Translate' transform mode instead of 'Translation' mode for "
"translating keyframes in Dope Sheet Editor"
msgstr ""
"Använd transformeringsläget \"Time_Translate\" istället för \"Translation\" "
"för att översätta nyckelrutor i Dope Sheet Editor"

msgid "Cannot edit previews of overridden library data"
msgstr ""
"Det går inte att redigera förhandsvisningar av överskrivna biblioteksdata"

msgid "None of the selected data-blocks supports previews"
msgstr "Inget av de valda datablocken stöder förhandsgranskning"

msgid "Rip is only compatible with sync-select with vertex/edge selection"
msgstr ""
"Rip är endast kompatibel med synkroniseringsval med val av hörnpunkt/kant"

msgid "Pinned vertices can be selected in Vertex Mode only"
msgstr "Fästa hörn kan endast väljas i hörnläget"

msgid ""
"Cannot split selection with \"Sync Select\" and \"Shared Vertex\" selection "
