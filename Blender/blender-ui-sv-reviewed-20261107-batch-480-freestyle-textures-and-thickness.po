#. :src: bpy.types.FreestyleLineStyle.texture_slots
#. :src: bpy.types.Material.texture_paint_slots
#. :src: bpy.types.ParticleSettings.texture_slots
msgid "Texture slots defining the mapping and influence of textures"
msgstr "Texturplatser som definierar texturernas mappning och påverkan"

#. :src: bpy.types.FreestyleLineStyle.texture_spacing
msgid "Texture Spacing"
msgstr "Texturavstånd"

#. :src: bpy.types.FreestyleLineStyle.texture_spacing
msgid "Spacing for textures along stroke length"
msgstr "Texturavstånd längs streckets längd"

#. :src: bpy.types.FreestyleLineStyle.thickness
msgid "Base line thickness, possibly modified by line thickness modifiers"
msgstr "Linjens grundtjocklek, som kan modifieras av linjetjockleksmodifierare"

#. :src: bpy.types.FreestyleLineStyle.thickness_modifiers
#. :src: bpy.types.LineStyleThicknessModifiers
msgid "Thickness Modifiers"
msgstr "Tjockleksmodifierare"

#. :src: bpy.types.FreestyleLineStyle.thickness_modifiers
msgid "List of line thickness modifiers"
msgstr "Lista över linjetjockleksmodifierare"

#. :src: bpy.types.FreestyleLineStyle.thickness_position
msgid "Thickness Position"
msgstr "Tjockleksplacering"

#. :src: bpy.types.FreestyleLineStyle.thickness_position
msgid ""
"Thickness position of silhouettes and border edges (applicable when plain "
"chaining is used with the Same Object option)"
msgstr ""
"Tjockleksplacering för silhuetter och gränskanter (gäller när vanlig "
"kedjning används med alternativet Samma objekt)"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'CENTER'
msgid "Silhouettes and border edges are centered along stroke geometry"
msgstr "Silhuetter och gränskanter är centrerade längs streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'INSIDE'
msgid "Silhouettes and border edges are drawn inside of stroke geometry"
msgstr "Silhuetter och gränskanter ritas inuti streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'OUTSIDE'
msgid "Silhouettes and border edges are drawn outside of stroke geometry"
msgstr "Silhuetter och gränskanter ritas utanför streckgeometrin"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'RELATIVE'
msgid "Silhouettes and border edges are shifted by a user-defined ratio"
msgstr ""
"Silhuetter och gränskanter förskjuts med ett användardefinierat förhållande"

#. :src: bpy.types.FreestyleLineStyle.thickness_ratio
msgid "Thickness Ratio"
msgstr "Tjockleksförhållande"

#. :src: bpy.types.FreestyleLineStyle.thickness_ratio
msgid ""
"A number between 0 (inside) and 1 (outside) specifying the relative position "
"of stroke thickness"
msgstr ""
"Ett tal mellan 0 (insida) och 1 (utsida) som anger den relativa positionen "
"för strecktjockleken"

#. :src: bpy.types.FreestyleLineStyle.use_angle_max
msgid "Use Max 2D Angle"
msgstr "Använd maximal 2D-vinkel"

#. :src: bpy.types.FreestyleLineStyle.use_angle_max
msgid "Split chains at points with angles larger than the maximum 2D angle"
msgstr ""
"Dela kedjor vid punkter med vinklar som är större än den maximala 2D-vinkeln"

#. :src: bpy.types.FreestyleLineStyle.use_angle_min
msgid "Use Min 2D Angle"
msgstr "Använd minimal 2D-vinkel"

#. :src: bpy.types.FreestyleLineStyle.use_angle_min
msgid "Split chains at points with angles smaller than the minimum 2D angle"
msgstr ""
"Dela kedjor vid punkter med vinklar som är mindre än den minsta 2D-vinkeln"

#. :src: bpy.types.FreestyleLineStyle.use_chain_count
msgid "Use Chain Count"
msgstr "Använd antal kedjor"

#. :src: bpy.types.FreestyleLineStyle.use_chain_count
msgid "Enable the selection of first N chains"
msgstr "Aktivera urval av de första N kedjorna"

#. :src: bpy.types.FreestyleLineStyle.use_chaining
#. :src: bpy.types.VIEWLAYER_PT_freestyle_linestyle_strokes_chaining
#: source/blender/modifiers/intern/MOD_lineart.cc:755
msgid "Chaining"
msgstr "Kedjning"

#. :src: bpy.types.FreestyleLineStyle.use_chaining
msgid "Enable chaining of feature edges"
msgstr "Aktivera kedjning av funktionskanter"

#. :src: bpy.types.FreestyleLineStyle.use_dashed_line
#. :src: bpy.types.VIEWLAYER_PT_freestyle_linestyle_strokes_dashedline
msgid "Dashed Line"
msgstr "Streckad linje"

#. :src: bpy.types.FreestyleLineStyle.use_dashed_line
msgid "Enable or disable dashed line"
msgstr "Aktivera eller inaktivera streckad linje"

#. :src: bpy.types.FreestyleLineStyle.use_length_max
msgid "Use Max 2D Length"
msgstr "Använd maximal 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_length_max
msgid "Enable the selection of chains by a maximum 2D length"
msgstr "Aktivera urval av kedjor efter maximal 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_length_min
msgid "Use Min 2D Length"
msgstr "Använd minimal 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_length_min
msgid "Enable the selection of chains by a minimum 2D length"
msgstr "Aktivera urval av kedjor efter minimal 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_nodes
#. :src: bpy.types.Light.use_nodes
#. :src: bpy.types.Material.use_nodes
#. :src: bpy.types.Scene.use_nodes
#. :src: bpy.types.Texture.use_nodes
#. :src: bpy.types.World.use_nodes
msgid "Use Nodes"
msgstr "Använd noder"

#. :src: bpy.types.FreestyleLineStyle.use_nodes
msgid "Use shader nodes for the line style"
msgstr "Använd shader-noder för linjestilen"
