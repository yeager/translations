#: source/blender/nodes/composite/nodes/node_composite_file_output.cc:404
msgid "The File Output node is only supported for scene compositing"
msgstr "File Output-noden stöds endast för scenkomposition"

#: source/blender/nodes/composite/nodes/node_composite_strip_info.cc:84
msgid "The Strip Info node is only supported for sequencer compositing"
msgstr "Strip Info-noden stöds endast för sekvenserarkomposition"
