#: source/blender/editors/space_outliner/tree/tree_display_override_library_hierarchies.cc:55
msgid "No Library Overrides"
msgstr "Inga biblioteksåsidosättningar"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:78
msgid ""
"This override data-block is not needed anymore, but was detected as user-"
"edited"
msgstr ""
"Detta datablock för biblioteksåsidosättning behövs inte längre, men har "
"identifierats som användarredigerat"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:82
msgid "This override data-block is unused"
msgstr "Detta datablock för biblioteksåsidosättning används inte"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:196
msgid ""
"This override property does not exist in current data, it will be removed on "
"next .blend file save"
msgstr ""
"Denna egenskap för biblioteksåsidosättning finns inte i aktuella data och "
"kommer att tas bort nästa gång .blend-filen sparas"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:256
msgid "Added through override"
msgstr "Tillagd genom åsidosättning"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:263
msgid "Protected from override"
msgstr "Skyddad mot åsidosättning"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:265
msgid "Additive override"
msgstr "Additiv åsidosättning"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:267
msgid "Subtractive override"
msgstr "Subtraktiv åsidosättning"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:269
msgid "Multiplicative override"
msgstr "Multiplikativ åsidosättning"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:271
msgid "Custom override"
msgstr "Anpassad åsidosättning"

#: source/blender/editors/space_outliner/tree/tree_element_overrides.cc:273
msgid "Unknown override"
msgstr "Okänd åsidosättning"
