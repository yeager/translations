#. :src: bpy.types.KinematicConstraint.use_stretch
msgid "Enable IK Stretching"
msgstr "Aktivera IK-sträckning"

#. :src: bpy.types.KinematicConstraint.use_tail
#. :src: bpy.types.RigifyParameters.use_tail
msgid "Use Tail"
msgstr "Använd benspets"

#. :src: bpy.types.KinematicConstraint.use_tail
msgid "Include bone's tail as last element in chain"
msgstr "Inkludera benets spets som sista element i kedjan"

#. :src: bpy.types.LimitLocationConstraint
msgid "Limit the location of the constrained object"
msgstr "Begränsa positionen för det begränsade objektet"

#. :src: bpy.types.LimitRotationConstraint.use_legacy_behavior
msgid ""
"Use the old semi-broken behavior that doesn't understand that rotations loop "
"around"
msgstr ""
"Använd det gamla, delvis trasiga beteendet som inte hanterar att rotationer "
"går runt i varv"

#. :src: bpy.types.LimitRotationConstraint.use_limit_x
#: scripts/startup/bl_ui/properties_constraint.py:212
#: scripts/startup/bl_ui/properties_data_bone.py:472
msgid "Limit X"
msgstr "Begränsa X"

#. :src: bpy.types.LockedTrackConstraint
msgid "Locked Track Constraint"
msgstr "Låst spårningsbegränsning"

#. :src: bpy.types.LockedTrackConstraint
msgid ""
"Point toward the target along the track axis, while locking the other axis"
msgstr ""
"Peka mot målet längs riktningsaxeln samtidigt som du låser den andra axeln"

#. :src: bpy.types.MaintainVolumeConstraint
msgid "Maintain Volume Constraint"
msgstr "Volymbevarande begränsning"

#. :src: bpy.types.MaintainVolumeConstraint
msgid "Maintain a constant volume along a single scaling axis"
msgstr "Bevarar en konstant volym längs en enda skalningsaxel"

#. :src: bpy.types.MaintainVolumeConstraint.mode
msgid "The way the constraint treats original non-free axis scaling"
msgstr ""
"Hur begränsningen behandlar den ursprungliga skalningen av den icke-fria "
"axeln"

#. :src: bpy.types.MaintainVolumeConstraint.mode:'UNIFORM'
msgid ""
"Volume is preserved when the object is scaled uniformly. Deviations from "
"uniform scale on non-free axes are passed through."
msgstr ""
"Volymen bevaras när objektet skalas enhetligt. Avvikelser från enhetlig "
"skala på icke-fria axlar påverkas inte."

#. :src: bpy.types.MaintainVolumeConstraint.mode:'SINGLE_AXIS'
msgid ""
"Volume is preserved when the object is scaled only on the free axis. Non-"
"free axis scaling is passed through."
msgstr ""
"Volymen bevaras när objektet endast skalas på den fria axeln. Skalning på "
"icke-fria axlar påverkas inte."

#. :src: bpy.types.ObjectSolverConstraint
msgid "Object Solver Constraint"
msgstr "Objektlösarbegränsning"

#. :src: bpy.types.ObjectSolverConstraint
msgid "Lock motion to the reconstructed object movement"
msgstr "Lås rörelsen till den rekonstruerade objektrörelsen"

#. :src: bpy.types.PivotConstraint
msgid "Pivot Constraint"
msgstr "Vridpunktsbegränsning"

#. :src: bpy.types.PivotConstraint.offset
msgid ""
"Offset of pivot from target (when set), or from owner's location (when Fixed "
"Position is off), or the absolute pivot point"
msgstr ""
"Vridpunktens förskjutning från målet (när det är angivet), från ägarens "
"position (när Fast position är av) eller den absoluta vridpunkten"

#. :src: bpy.types.PivotConstraint.rotation_range
msgid "Enabled Rotation Range"
msgstr "Aktiverat rotationsintervall"

#. :src: bpy.types.PivotConstraint.rotation_range
msgid "Rotation range on which pivoting should occur"
msgstr "Rotationsintervall inom vilket vridpunkten ska användas"

#. :src: bpy.types.PivotConstraint.rotation_range:'NX'
msgid "Use the pivot point in the negative rotation range around the X-axis"
msgstr "Använd vridpunkten i det negativa rotationsintervallet runt X-axeln"

#. :src: bpy.types.PivotConstraint.rotation_range:'NY'
msgid "Use the pivot point in the negative rotation range around the Y-axis"
msgstr "Använd vridpunkten i det negativa rotationsintervallet runt Y-axeln"

#. :src: bpy.types.PivotConstraint.rotation_range:'NZ'
msgid "Use the pivot point in the negative rotation range around the Z-axis"
msgstr "Använd vridpunkten i det negativa rotationsintervallet runt Z-axeln"

#. :src: bpy.types.PivotConstraint.rotation_range:'X'
msgid "Use the pivot point in the positive rotation range around the X-axis"
msgstr "Använd vridpunkten i det positiva rotationsintervallet runt X-axeln"

#. :src: bpy.types.PivotConstraint.rotation_range:'Y'
msgid "Use the pivot point in the positive rotation range around the Y-axis"
msgstr "Använd vridpunkten i det positiva rotationsintervallet runt Y-axeln"

#. :src: bpy.types.PivotConstraint.rotation_range:'Z'
msgid "Use the pivot point in the positive rotation range around the Z-axis"
msgstr "Använd vridpunkten i det positiva rotationsintervallet runt Z-axeln"

#. :src: bpy.types.PivotConstraint.target
msgid "Target Object, defining the position of the pivot when defined"
msgstr "Målobjekt som anger vridpunktens position när det är angivet"

#. :src: bpy.types.PivotConstraint.use_relative_location
msgid ""
"Offset will be an absolute point in space instead of relative to the target"
msgstr ""
"Förskjutningen blir en absolut punkt i rymden i stället för att vara relativ "
"till målet"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face
#. :src: bpy.types.ShrinkwrapModifier.cull_face
msgid "Face Cull"
msgstr "Ytborttagning"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face
#. :src: bpy.types.ShrinkwrapModifier.cull_face
msgid ""
"Stop vertices from projecting to a face on the target when facing towards/"
"away"
msgstr ""
"Förhindra att hörnpunkter projiceras mot en yta på målet när de är vända mot "
"eller från den"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face:'OFF'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face:'OFF'
#. :src: bpy.types.ShrinkwrapModifier.cull_face:'OFF'
msgid "No culling"
msgstr "Ingen borttagning"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face:'FRONT'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face:'FRONT'
#. :src: bpy.types.ShrinkwrapModifier.cull_face:'FRONT'
msgid "No projection when in front of the face"
msgstr "Ingen projektion när punkten är framför ytan"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face:'BACK'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face:'BACK'
#. :src: bpy.types.ShrinkwrapModifier.cull_face:'BACK'
msgid "No projection when behind the face"
msgstr "Ingen projektion när punkten är bakom ytan"

#. :src: bpy.types.ShrinkwrapConstraint.project_axis_space
msgid "Axis Space"
msgstr "Axelrymd"

#. :src: bpy.types.ShrinkwrapConstraint.project_axis_space
msgid "Space for the projection axis"
msgstr "Koordinatrymd för projektionsaxeln"

#. :src: bpy.types.ShrinkwrapConstraint.target
msgid "Target Mesh object"
msgstr "Målmesh-objekt"

#. :src: bpy.types.ShrinkwrapConstraint.use_invert_cull
#. :src: bpy.types.GreasePencilShrinkwrapModifier.use_invert_cull
#. :src: bpy.types.ShrinkwrapModifier.use_invert_cull
msgid "Invert Cull"
msgstr "Invertera ytborttagning"

#. :src: bpy.types.ShrinkwrapConstraint.use_invert_cull
msgid "When projecting in the opposite direction invert the face cull mode"
msgstr "Vid projektion i motsatt riktning inverteras ytborttagningsläget"

#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode
#. :src: bpy.types.NODE_OT_nw_batch_change.operation:'SNAP'
#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'SNAP'
#: scripts/startup/bl_ui/properties_constraint.py:701
msgid "Snap Mode"
msgstr "Fästläge"

#. :src: bpy.types.SplineIKConstraint.bulge
#. :src: bpy.types.StretchToConstraint.bulge
msgid "Factor between volume variation and stretching"
msgstr "Faktor mellan volymvariation och sträckning"

#. :src: bpy.types.SplineIKConstraint.bulge_smooth
#. :src: bpy.types.StretchToConstraint.bulge_smooth
msgid "Strength of volume stretching clamping"
msgstr "Styrka för begränsning av volymsträckning"
