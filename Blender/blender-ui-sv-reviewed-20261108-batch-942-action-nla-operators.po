#. :src: bpy.types.NlaStrip.action_frame_end
msgid "Last frame from action to use"
msgstr "Sista bildrutan från Actionen som ska användas"

#. :src: bpy.types.NlaStrip.action_frame_start
msgid "First frame from action to use"
msgstr "Första bildrutan från Actionen som ska användas"

#. :src: bpy.types.NlaStrip.use_sync_length
msgid ""
"Update range of frames referenced from action after tweaking strip and its "
"keyframes"
msgstr ""
"Uppdatera intervallet med bildrutor som refereras från Actionen efter att "
"remsan och dess nyckelbildrutor har justerats"

#. :src: bpy.types.ANIM_OT_clear_useless_actions
msgid ""
"Mark actions with no F-Curves for deletion after save and reload of file "
"preserving \"action libraries\""
msgstr ""
"Markera Actioner utan F-kurvor för borttagning efter att filen har sparats "
"och lästs in på nytt, samtidigt som \"Action-biblioteken\" bevaras"

#. :src: bpy.types.NLA_OT_bake
msgid ""
"Bake all selected objects location/scale/rotation animation to an action"
msgstr ""
"Baka alla valda objekts plats-, skal- och rotationsanimering till en Action"

#. :src: bpy.types.OBJECT_OT_rigify_action_create
msgid "Create a new action"
msgstr "Skapa en ny Action"

#. :src: bpy.types.SCENE_OT_gltf2_action_filter_refresh
msgid "Refresh list of actions"
msgstr "Uppdatera Action-listan"

#. :src: bpy.types.SCENE_OT_gltf2_action_filter_refresh
msgctxt "Operator"
msgid "Refresh action list"
msgstr "Uppdatera Action-listan"

#. :src: bpy.types.ACTION_OT_markers_make_local
msgid "Move selected scene markers to the active action as pose markers"
msgstr "Flytta valda scenmarkörer till den aktiva Actionen som posemarkörer"

#. :src: bpy.types.ACTION_OT_new
msgid "Create new action"
msgstr "Skapa ny Action"

#. :src: bpy.types.ACTION_OT_push_down
msgid "Push action down on to the NLA stack as a new strip"
msgstr "Flytta ned Actionen på NLA-stacken som en ny remsa"
