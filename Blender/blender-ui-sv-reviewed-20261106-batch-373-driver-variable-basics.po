#. :src: bpy.types.DriverTarget.transform_space:'LOCAL_SPACE'
msgid "Transforms include effects of constraints but not parenting/restpose"
msgstr ""
"Transformationerna omfattar effekterna av begränsningar, men inte "
"föräldraskap eller viloposition"

#. :src: bpy.types.DriverTarget.transform_type
#. :src: bpy.types.DriverVariable.type
msgid "Driver variable type"
msgstr "Drivrutinsvariabeltyp"

#. :src: bpy.types.DriverTarget.transform_type:'ROT_W'
msgid "W Rotation"
msgstr "W-rotation"

#. :src: bpy.types.DriverTarget.transform_type:'SCALE_AVG'
msgid "Average Scale"
msgstr "Genomsnittlig skala"

#. :src: bpy.types.DriverTarget.use_fallback_value
msgid "Use Fallback"
msgstr "Använd reservvärde"

#. :src: bpy.types.DriverTarget.use_fallback_value
msgid ""
"Use the fallback value if the data path can't be resolved, instead of "
"failing to evaluate the driver"
msgstr ""
"Använd reservvärdet om datasökvägen inte kan lösas i stället för att "
"utvärderingen av drivrutinen misslyckas"

#. :src: bpy.types.DriverVariable
msgid "Driver Variable"
msgstr "Drivrutinsvariabel"

#. :src: bpy.types.DriverVariable
msgid "Variable from some source/target for driver relationship"
msgstr "Variabel från en källa eller ett mål som ingår i drivrutinsrelationen"

#. :src: bpy.types.DriverVariable.is_name_valid
msgid "Is Name Valid"
msgstr "Är namnet giltigt"

#. :src: bpy.types.DriverVariable.is_name_valid
msgid "Is this a valid name for a driver variable"
msgstr "Är detta ett giltigt namn för en drivrutinsvariabel"
