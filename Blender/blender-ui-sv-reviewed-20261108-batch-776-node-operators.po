#. :src: bpy.types.NODE_OT_add_zone.input_node_type
#. :src: bpy.types.NODE_OT_swap_zone.input_node_type
#. :src: bpy.types.ThemeNodeEditor.input_node
msgid "Input Node"
msgstr "Indatanod"

#. :src: bpy.types.NODE_OT_add_zone.input_node_type
#. :src: bpy.types.NODE_OT_swap_zone.input_node_type
msgid "Specifies the input node used by the created zone"
msgstr "Anger den indatanod som används av den skapade zonen"

#. :src: bpy.types.NODE_OT_add_zone.output_node_type
#. :src: bpy.types.NODE_OT_swap_zone.output_node_type
#. :src: bpy.types.TextureSlot.output_node
#. :src: bpy.types.ThemeNodeEditor.output_node
msgid "Output Node"
msgstr "Utdatanod"

#. :src: bpy.types.NODE_OT_add_zone.output_node_type
#. :src: bpy.types.NODE_OT_swap_zone.output_node_type
msgid "Specifies the output node used by the created zone"
msgstr "Anger den utdatanod som används av den skapade zonen"

#. :src: bpy.types.NODE_OT_connect_to_output
msgid "Connect active node to the active output node of the node tree"
msgstr "Anslut den aktiva noden till den aktiva utdatanoden i nodträdet"

#. :src: bpy.types.NODE_OT_duplicate.keep_inputs
msgid "Keep Inputs"
msgstr "Behåll indata"

#. :src: bpy.types.NODE_OT_duplicate.keep_inputs
msgid "Keep the input links to duplicated nodes"
msgstr "Behåll indatalänkarna till duplicerade noder"

#. :src: bpy.types.NODE_OT_duplicate_move_keep_inputs
msgid "Duplicate selected nodes keeping input links and move them"
msgstr "Duplicera valda noder med bibehållna indatalänkar och flytta dem"

#. :src: bpy.types.NODE_OT_link_make
msgid "Make a link between selected output and input sockets"
msgstr "Skapa en länk mellan valda utdata- och indatauttag"

#. :src: bpy.types.NODE_OT_nw_add_reroutes
msgid "Add reroutes to outputs"
msgstr "Lägg till omdirigeringar till utdata"

#. :src: bpy.types.NODE_OT_render_changed
msgid "Render current scene, when input node's layer has been changed"
msgstr "Rendera aktuell scen när indatanodens lager har ändrats"
