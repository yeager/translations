#. :src: bpy.types.OBJECT_OT_data_transfer
msgid "Transfer data layer(s) (weights, edge sharp, etc.) from active to selected meshes"
msgstr "Överför datalager (vikter, kantskärpa etc.) från den aktiva meshen till valda meshar"

#: source/blender/editors/object/object_bake_api.cc:1537
msgid "Invalid cage object, the cage mesh must have the same number of faces as the active object"
msgstr "Ogiltigt bur-objekt, burmeshen måste ha samma antal ytor som det aktiva objektet"

#: source/blender/editors/object/object_bake_api.cc:650
msgid "Object \"%s\" is not a mesh or cannot be converted to a mesh (Curve, Text, Surface or Metaball)"
msgstr "Objektet ”%s” är inte en mesh eller kan inte konverteras till en mesh (kurva, text, yta eller metaboll)"

#: source/blender/editors/object/object_bake_api.cc:1634
msgid "Failed to access mesh from object \"%s\", ensure it's visible while rendering"
msgstr "Det gick inte att komma åt meshen från objektet ”%s”. Se till att det är synligt under rendering"

#: source/blender/editors/object/object_modifier.cc:1067
msgid "Modifier cannot be applied to a mesh with shape keys"
msgstr "Modifieraren kan inte tillämpas på en mesh med formnycklar"

#: source/blender/editors/object/object_modifier.cc:1124
msgid "Cannot apply constructive modifiers on curve. Convert curve to mesh in order to apply"
msgstr "Det går inte att tillämpa konstruktiva modifierare på kurvor. Konvertera kurvan till mesh för att kunna tillämpa modifierarna"

#: source/blender/editors/object/object_modifier.cc:2877
msgid "Mesh '%s' has no skin vertex data"
msgstr "Meshen ”%s” saknar Skin-hörnpunktsdata"

#: source/blender/editors/object/object_remesh.cc:949
msgid "QuadriFlow: The mesh needs to be manifold and have face normals that point in a consistent direction"
msgstr "QuadriFlow: Meshen måste vara manifold och ha ytnormaler som pekar i en konsekvent riktning"

#: source/blender/editors/object/object_vgroup.cc:3471
msgid "No meshes with vertex groups found"
msgstr "Inga meshar med hörnpunktsgrupper hittades"
