#. :src: bpy.types.GreasePencilFrame.keyframe_type:'BREAKDOWN'
#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'BREAKDOWN'
msgctxt "GPencil"
msgid "Breakdown"
msgstr "Mellanpose"

#. :src: bpy.types.GreasePencilFrame.keyframe_type:'BREAKDOWN'
#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'BREAKDOWN'
#. :src: bpy.types.Keyframe.type:'BREAKDOWN'
#. :src: bpy.types.ACTION_OT_keyframe_type.type:'BREAKDOWN'
#. :src: bpy.types.ToolSettings.keyframe_type:'BREAKDOWN'
msgid "A breakdown pose, e.g. for transitions between key poses"
msgstr "En mellanpose, till exempel för övergångar mellan nyckelposer"

#. :src: bpy.types.GreasePencilFrame.keyframe_type:'MOVING_HOLD'
#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'MOVING_HOLD'
msgctxt "GPencil"
msgid "Moving Hold"
msgstr "Rörlig hållning"

#. :src: bpy.types.GreasePencilFrame.keyframe_type:'MOVING_HOLD'
#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'MOVING_HOLD'
#. :src: bpy.types.Keyframe.type:'MOVING_HOLD'
#. :src: bpy.types.ACTION_OT_keyframe_type.type:'MOVING_HOLD'
#. :src: bpy.types.ToolSettings.keyframe_type:'MOVING_HOLD'
msgid "A keyframe that is part of a moving hold"
msgstr "En nyckelbildruta som ingår i en rörlig hållning"

#. :src: bpy.types.GreasePencilFrame.keyframe_type:'EXTREME'
#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'EXTREME'
msgctxt "GPencil"
msgid "Extreme"
msgstr "Ytterläge"

#. :src: bpy.types.GreasePencilFrame.keyframe_type:'EXTREME'
#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'EXTREME'
msgid "An 'extreme' pose, or some other purpose as needed"
msgstr "Ett ytterläge eller något annat ändamål efter behov"

#. :src: bpy.types.GreasePencilFrame.keyframe_type:'JITTER'
#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'JITTER'
#. :src: bpy.types.Keyframe.type:'JITTER'
#. :src: bpy.types.ACTION_OT_keyframe_type.type:'JITTER'
#. :src: bpy.types.ToolSettings.keyframe_type:'JITTER'
msgid ""
"A filler or baked keyframe for keying on ones, or some other purpose as "
"needed"
msgstr ""
"En utfyllnads- eller bakad nyckelbildruta för animering på ettor, eller "
"något annat ändamål efter behov"

#. :src: bpy.types.GreasePencilFrame.keyframe_type:'GENERATED'
#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'GENERATED'
#. :src: bpy.types.Keyframe.type:'GENERATED'
#. :src: bpy.types.ACTION_OT_keyframe_type.type:'GENERATED'
#. :src: bpy.types.ToolSettings.keyframe_type:'GENERATED'
msgid "A key generated automatically by a tool, not manually created"
msgstr ""
"En nyckelbildruta som genereras automatiskt av ett verktyg och inte skapas "
"manuellt"
