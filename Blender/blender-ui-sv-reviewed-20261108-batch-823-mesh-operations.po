#. :src: bpy.types.Modifier.type:'EXPLODE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'EXPLODE'
msgid "Break apart the mesh faces and let them follow particles"
msgstr "Dela upp meshens ytor och låt dem följa partiklarna"

#. :src: bpy.types.ScrewModifier.use_normal_calculate
msgid "Calculate the order of edges (needed for meshes, but not curves)"
msgstr "Beräkna ordningen på kanter (behövs för mesh, men inte kurvor)"

#. :src: bpy.types.GeometryNodeInputMeshFaceArea
msgid "Calculate the surface area of a mesh's faces"
msgstr "Beräkna ytarean för meshens ytor"

#. :src: bpy.types.OBJECT_OT_meshdeform_bind
msgid "Bind mesh to cage in mesh deform modifier"
msgstr "Bind meshen till buren i modifieraren för meshdeformering"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_faces
msgid "Approximate number of faces (quads) in the new mesh"
msgstr "Ungefärligt antal ytor (fyrkanter) i den nya meshen"

#. :src: bpy.types.OBJECT_OT_surfacedeform_bind
msgid "Bind mesh to target in surface deform modifier"
msgstr "Bind meshen till målet i ytdeformeringsmodifieraren"

#. :src: bpy.types.WM_OT_obj_export.apply_modifiers
#. :src: bpy.types.WM_OT_ply_export.apply_modifiers
#. :src: bpy.types.WM_OT_stl_export.apply_modifiers
msgid "Apply modifiers to exported meshes"
msgstr "Tillämpa modifierare på exporterade meshobjekt"

msgid "Cannot remove more vertices than the mesh contains"
msgstr "Det går inte att ta bort fler hörn än vad meshen innehåller"

msgid "Cannot remove more edges than the mesh contains"
msgstr "Det går inte att ta bort fler kanter än vad meshen innehåller"

msgid "Cannot remove more loops than the mesh contains"
msgstr "Det går inte att ta bort fler öglor än vad meshen innehåller"

msgid "Cannot remove more polys than the mesh contains"
msgstr "Det går inte att ta bort fler polygoner än vad meshen innehåller"

msgid "Cannot edit linked mesh or curve data"
msgstr "Det går inte att redigera länkade meshdata eller kurvdata"

msgid "Cannot get mesh from cage object"
msgstr "Det går inte att hämta meshen från bur-objektet"
