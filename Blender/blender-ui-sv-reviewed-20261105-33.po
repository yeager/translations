#. :src: bpy.types.Bone.bbone_mapping_mode:'CURVED'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'CURVED'
msgid "Curved"
msgstr "Böjd"

#. :src: bpy.types.Bone.bbone_mapping_mode:'CURVED'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'CURVED'
msgid "Slower mapping that gives better deformation for B-Bones that are sharply curved in rest pose"
msgstr "Långsammare mappning som ger bättre deformation för B-Bones som är kraftigt böjda i viloposen"

#. :src: bpy.types.Bone.bbone_rollin
#. :src: bpy.types.EditBone.bbone_rollin
#. :src: bpy.types.PoseBone.bbone_rollin
#: scripts/startup/bl_ui/properties_data_bone.py:156
msgid "Roll In"
msgstr "Inrullning"

#. :src: bpy.types.Bone.bbone_rollin
#. :src: bpy.types.EditBone.bbone_rollin
#. :src: bpy.types.PoseBone.bbone_rollin
msgid "Roll offset for the start of the B-Bone, adjusts twist"
msgstr "Rullningsförskjutning vid B-Bonens början som justerar vridningen"

#. :src: bpy.types.Bone.bbone_rollout
#. :src: bpy.types.EditBone.bbone_rollout
#. :src: bpy.types.PoseBone.bbone_rollout
#: scripts/startup/bl_ui/properties_data_bone.py:157
msgid "Roll Out"
msgstr "Utrullning"

#. :src: bpy.types.Bone.bbone_rollout
#. :src: bpy.types.EditBone.bbone_rollout
#. :src: bpy.types.PoseBone.bbone_rollout
msgid "Roll offset for the end of the B-Bone, adjusts twist"
msgstr "Rullningsförskjutning vid B-Bonens slut som justerar vridningen"

#. :src: bpy.types.Bone.bbone_scalein
#. :src: bpy.types.EditBone.bbone_scalein
#. :src: bpy.types.PoseBone.bbone_scalein
#: scripts/startup/bl_ui/properties_data_bone.py:161
msgid "Scale In"
msgstr "Skala in"

#. :src: bpy.types.Bone.bbone_scalein
#. :src: bpy.types.EditBone.bbone_scalein
#. :src: bpy.types.PoseBone.bbone_scalein
msgid "Scale factors for the start of the B-Bone, adjusts thickness (for tapering effects)"
msgstr "Skalfaktorer vid B-Bonens början som justerar tjockleken (för avsmalnande effekter)"

#. :src: bpy.types.Bone.bbone_scaleout
#. :src: bpy.types.EditBone.bbone_scaleout
#. :src: bpy.types.PoseBone.bbone_scaleout
#: scripts/startup/bl_ui/properties_data_bone.py:164
msgid "Scale Out"
msgstr "Skala ut"

#. :src: bpy.types.Bone.bbone_scaleout
#. :src: bpy.types.EditBone.bbone_scaleout
#. :src: bpy.types.PoseBone.bbone_scaleout
msgid "Scale factors for the end of the B-Bone, adjusts thickness (for tapering effects)"
msgstr "Skalfaktorer vid B-Bonens slut som justerar tjockleken (för avsmalnande effekter)"
