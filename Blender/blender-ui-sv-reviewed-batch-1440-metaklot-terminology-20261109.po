#. :src: bpy.types.AssetShelf.filter_metaball
#. :src: bpy.types.FileAssetSelectIDFilter.experimental_filter_metaball
#. :src: bpy.types.FileSelectIDFilter.filter_metaball
msgid "Show Metaball data-blocks"
msgstr "Visa metaklotdatablock"

#. :src: bpy.types.BlendData.metaballs
msgid "Metaball data-blocks"
msgstr "Metaklotdatablock"

#. :src: bpy.types.DopeSheet.show_metaballs
msgid "Display Metaball"
msgstr "Visa metaklot"

#. :src: bpy.types.DopeSheet.show_metaballs
msgid "Include visualization of metaball related animation data"
msgstr "Visa även metaklotrelaterade animeringsdata"

#. :src: bpy.types.MetaBall
msgid "Metaball data-block to define blobby surfaces"
msgstr "Metaklotdatablock för att definiera sammanflytande ytor"

#. :src: bpy.types.MetaBall.update_method
msgid "Metaball edit update behavior"
msgstr "Uppdateringsbeteende vid redigering av metaklot"

#. :src: bpy.types.MetaBall.update_method:'UPDATE_ALWAYS'
msgid "While editing, update metaball always"
msgstr "Uppdatera alltid metaklotet vid redigering"

#. :src: bpy.types.MetaBall.update_method:'HALFRES'
msgid "While editing, update metaball in half resolution"
msgstr "Uppdatera metaklotet med halv upplösning vid redigering"

#. :src: bpy.types.MetaBall.update_method:'FAST'
msgid "While editing, update metaball without polygonization"
msgstr "Uppdatera metaklotet utan polygonisering vid redigering"

#. :src: bpy.types.MetaBall.update_method:'NEVER'
msgid "While editing, don't update metaball at all"
msgstr "Uppdatera inte metaklotet alls vid redigering"

#. :src: bpy.types.MetaElement.type
msgid "Metaball type"
msgstr "Metaklottyp"

#. :src: bpy.types.OBJECT_OT_convert.target:'MESH'
msgid "Mesh from Curve, Surface, Metaball, Text, or Point Cloud objects"
msgstr "Mesh från kurv-, yt-, metaklot-, text- eller punktmolnsobjekt"

#: source/blender/editors/interface/templates/interface_template_id.cc:849
msgid "Browse Metaball Data to be linked"
msgstr "Bläddra bland metaklotdata som ska länkas"

#: source/blender/editors/object/object_bake_api.cc:650
msgid ""
"Object \"%s\" is not a mesh or cannot be converted to a mesh (Curve, Text, "
"Surface or Metaball)"
msgstr ""
"Objektet ”%s” är inte en mesh eller kan inte konverteras till en mesh "
"(kurva, text, yta eller metaklot)"
