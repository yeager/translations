#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'NONE'
msgid "Don't scale the X and Z axes"
msgstr "Skala inte X- och Z-axlarna"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'BONE_ORIGINAL'
#. :src: bpy.types.SplineIKConstraint.y_scale_mode:'BONE_ORIGINAL'
msgid "Bone Original"
msgstr "Benets ursprungliga skala"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'BONE_ORIGINAL'
msgid "Use the original scaling of the bones"
msgstr "Använd den ursprungliga skalningen av benen"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'INVERSE_PRESERVE'
msgid "Inverse Scale"
msgstr "Invers skala"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'INVERSE_PRESERVE'
msgid "Scale of the X and Z axes is the inverse of the Y-Scale"
msgstr "Skalan för X- och Z-axlarna är inversen av Y-skalan"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'VOLUME_PRESERVE'
#. :src: bpy.types.Brush.elastic_deform_volume_preservation
msgid "Volume Preservation"
msgstr "Volymbevarande"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'VOLUME_PRESERVE'
msgid ""
"Scale of the X and Z axes are adjusted to preserve the volume of the bones"
msgstr "Skalan på X- och Z-axlarna justeras för att bevara benens volym"

#. :src: bpy.types.SplineIKConstraint.y_scale_mode
msgid "Y Scale Mode"
msgstr "Y-skalningsläge"

#. :src: bpy.types.SplineIKConstraint.y_scale_mode
msgid ""
"Method used for determining the scaling of the Y axis of the bones, on top "
"of the shape and scaling of the curve itself"
msgstr ""
"Metod som används för att bestämma skalningen av benens Y-axel, utöver "
"formen och skalningen av själva kurvan"

#. :src: bpy.types.SplineIKConstraint.y_scale_mode:'NONE'
msgid "Don't scale in the Y axis"
msgstr "Skala inte längs Y-axeln"

#. :src: bpy.types.SplineIKConstraint.y_scale_mode:'FIT_CURVE'
#. :src: bpy.types.ArrayModifier.fit_type:'FIT_CURVE'
msgid "Fit Curve"
msgstr "Anpassa till kurva"

#. :src: bpy.types.SplineIKConstraint.y_scale_mode:'FIT_CURVE'
msgid "Scale the bones to fit the entire length of the curve"
msgstr "Skala benen så att de fyller kurvans hela längd"

#. :src: bpy.types.SplineIKConstraint.y_scale_mode:'BONE_ORIGINAL'
msgid "Use the original Y scale of the bone"
msgstr "Använd den ursprungliga Y-skalan för benet"
