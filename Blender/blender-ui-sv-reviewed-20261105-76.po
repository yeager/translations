#. :src: bpy.types.Brush.curves_sculpt_tool:'SLIDE'
msgctxt "Curves"
msgid "Slide"
msgstr "Glid"

#. :src: bpy.types.Brush.dash_ratio
#: scripts/startup/bl_ui/properties_paint_common.py:540
msgid "Dash Ratio"
msgstr "Streckförhållande"

#. :src: bpy.types.Brush.dash_samples
#: scripts/startup/bl_ui/properties_paint_common.py:541
msgid "Dash Length"
msgstr "Strecklängd"

#. :src: bpy.types.Brush.dash_samples
msgid "Length of a dash cycle measured in stroke samples"
msgstr "Längd på en streckcykel, mätt i penseldragsprov"

#. :src: bpy.types.Brush.deform_target:'GEOMETRY'
msgid "Brush deformation displaces the vertices of the mesh"
msgstr "Penselns deformation förskjuter meshens hörnpunkter"

#. :src: bpy.types.Brush.deform_target:'CLOTH_SIM'
msgid "Cloth Simulation"
msgstr "Tygsimulering"

#. :src: bpy.types.Brush.deform_target:'CLOTH_SIM'
msgid ""
"Brush deforms the mesh by deforming the constraints of a cloth simulation"
msgstr ""
"Penseln deformerar meshen genom att deformera begränsningarna i en "
"tygsimulering"

#. :src: bpy.types.Brush.density
msgid "Amount of random elements that are going to be affected by the brush"
msgstr "Mängd slumpmässiga element som påverkas av penseln"

#. :src: bpy.types.Brush.disconnected_distance_max
msgid "Maximum distance to search for disconnected loose parts in the mesh"
msgstr "Maximalt avstånd för att söka efter frånkopplade lösa delar i meshen"

#. :src: bpy.types.Brush.falloff_angle
msgid "Falloff Angle"
msgstr "Avtagandevinkel"

#. :src: bpy.types.Brush.falloff_angle
#. :src: bpy.types.ImagePaint.normal_angle
msgid "Paint most on faces pointing towards the view according to this angle"
msgstr "Måla mest på ytor som enligt denna vinkel är riktade mot vyn"

#. :src: bpy.types.Brush.falloff_shape
msgid "Falloff Shape"
msgstr "Avtagandeform"

#. :src: bpy.types.Brush.falloff_shape
msgid "Use projected or spherical falloff"
msgstr "Använd projicerat eller sfäriskt avtagande"

#. :src: bpy.types.Brush.falloff_shape:'SPHERE'
msgid "Apply brush influence in a Sphere, outwards from the center"
msgstr "Tillämpa penselns påverkan i en sfär, utåt från mitten"

#. :src: bpy.types.Brush.falloff_shape:'PROJECTED'
msgid "Projected"
msgstr "Projicerad"

#. :src: bpy.types.Brush.falloff_shape:'PROJECTED'
msgid "Apply brush influence in a 2D circle, projected from the view"
msgstr "Tillämpa penselns påverkan i en 2D-cirkel, projicerad från vyn"

#. :src: bpy.types.Brush.flow
msgid "Amount of paint that is applied per stroke sample"
msgstr "Mängd färg som appliceras per penseldragsprov"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'SMOOTH'
msgid "Smooth stroke points"
msgstr "Jämna ut streckpunkter"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'RANDOMIZE'
msgid "Introduce jitter/randomness into strokes"
msgstr "Inför slumpmässighet i streck"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'GRAB'
msgctxt "GPencil"
msgid "Grab"
msgstr "Dra"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'GRAB'
msgid "Translate the set of points initially within the brush circle"
msgstr ""
"Flytta uppsättningen punkter som ursprungligen ligger inom penselcirkeln"

#. :src: bpy.types.Brush.gpencil_sculpt_tool:'CLONE'
msgid "Paste copies of the strokes stored on the internal clipboard"
msgstr "Klistra in kopior av de streck som lagras i det interna urklippet"

#. :src: bpy.types.Brush.gpencil_settings
msgid "Gpencil Settings"
msgstr "Grease Pencil-inställningar"

