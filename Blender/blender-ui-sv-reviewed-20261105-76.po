#. :src: bpy.types.Brush.boundary_offset
msgid "Boundary Origin Offset"
msgstr "Förskjutning av gränsens ursprung"

#. :src: bpy.types.Brush.brush_capabilities
msgid "Brush's capabilities"
msgstr "Penselns egenskaper"

#. :src: bpy.types.Brush.cloth_force_falloff_type
msgid "Force Falloff"
msgstr "Kraftavtagande"

#. :src: bpy.types.Brush.cloth_force_falloff_type
msgid "Shape used in the brush to apply force to the cloth"
msgstr "Form som används i penseln för att tillämpa kraft på tyget"

#. :src: bpy.types.Brush.cloth_sim_falloff
msgid "Simulation Falloff"
msgstr "Simuleringsavtagande"

#. :src: bpy.types.Brush.cloth_sim_falloff
msgid "Area to apply deformation falloff to the effects of the simulation"
msgstr ""
"Område där deformationens avtagande tillämpas på simuleringens effekter"

#. :src: bpy.types.Brush.cloth_sim_limit
msgid ""
"Factor added relative to the size of the radius to limit the cloth "
"simulation effects"
msgstr ""
"Faktor som läggs till i förhållande till radiens storlek för att begränsa "
"tygsimuleringens effekter"

#. :src: bpy.types.Brush.cloth_simulation_area_type
msgid ""
"Part of the mesh that is going to be simulated when the stroke is active"
msgstr "Del av meshen som simuleras när penseldraget är aktivt"

#. :src: bpy.types.Brush.cloth_simulation_area_type:'GLOBAL'
msgid "Simulates the entire mesh"
msgstr "Simulerar hela meshen"

#. :src: bpy.types.Brush.cursor_overlay_alpha
