#. :src: bpy.types.SEQUENCER_OT_strip_modifier_add_node_group.asset_library_type:'ALL'
msgid "Show assets from all of the listed asset libraries"
msgstr "Visa resurser från alla listade resursbibliotek"

#. :src: bpy.types.AssetLibrary.user_library
msgid "Show assets from the asset libraries configured in the Preferences"
msgstr "Visa resurser från de resursbibliotek som har konfigurerats i Inställningar"

#. :src: bpy.types.AssetMetaData
msgid "Additional data stored for an asset data-block"
msgstr "Ytterligare data som lagras för ett resursdatablock"

#. :src: bpy.types.AssetMetaData.catalog_id
msgid "Identifier for the asset's catalog, used by Blender to look up the asset's catalog path. Must be a UUID according to RFC4122."
msgstr "Identifierare för resursens katalog. Blender använder den för att slå upp resursens katalogsökväg. Måste vara en UUID enligt RFC 4122."

#. :src: bpy.types.AssetMetaData.copyright
msgid "Copyright notice for this asset. An empty copyright notice does not necessarily indicate that this is copyright-free. Contact the author if any clarification is needed."
msgstr "Upphovsrättsmeddelande för denna resurs. Ett tomt meddelande betyder inte nödvändigtvis att den är fri från upphovsrätt. Kontakta skaparen om något behöver klargöras."

#. :src: bpy.types.AssetMetaData.license
msgid "The type of license this asset is distributed under. An empty license name does not necessarily indicate that this is free of licensing terms. Contact the author if any clarification is needed."
msgstr "Typ av licens som denna resurs distribueras under. Ett tomt licensnamn betyder inte nödvändigtvis att den är fri från licensvillkor. Kontakta skaparen om något behöver klargöras."

#. :src: bpy.types.AssetMetaData.use_preferred_import_method
msgid "When \"Follow Asset or Preferences\" is selected for the import method in the Asset Browser, use the preferred import method of this asset"
msgstr "När \"Följ resurs eller inställningar\" har valts som importmetod i resursbläddraren används den här resursens föredragna importmetod"

#. :src: bpy.types.AssetRepresentation
msgid "Information about an entity that makes it possible for the asset system to deal with the entity as asset"
msgstr "Information om en enhet som gör det möjligt för resurssystemet att hantera enheten som en resurs"

#. :src: bpy.types.AssetShelf
msgid "Regions for quick access to assets"
msgstr "Områden för snabb åtkomst till resurser"

#. :src: bpy.types.AssetShelf.asset_library_reference
msgid "Choose the asset library to display assets from"
msgstr "Välj ett resursbibliotek att visa resurser från"

#. :src: bpy.types.AssetShelf.bl_activate_operator
msgid "Operator to call when activating an item with asset reference properties"
msgstr "Operator som ska anropas när ett objekt med resursreferensegenskaper aktiveras"

#. :src: bpy.types.AssetShelf.bl_default_preview_size
msgid "Default size of the asset preview thumbnails in pixels"
msgstr "Standardstorlek för resursernas förhandsvisningsminiatyrer i pixlar"

#. :src: bpy.types.AssetShelf.bl_options:'NO_ASSET_DRAG'
msgid "No Asset Dragging"
msgstr "Ingen resursdragning"

#. :src: bpy.types.AssetShelf.bl_options:'NO_ASSET_DRAG'
msgid "Disable the default asset dragging on drag events. Useful for implementing custom dragging via custom key-map items."
msgstr "Inaktivera standarddragning av resurser vid draghändelser. Användbart för att implementera anpassad dragning via anpassade tangentmappningsposter."

#. :src: bpy.types.AssetShelf.search_filter
msgid "Filter assets by name"
msgstr "Filtrera resurser efter namn"

#. :src: bpy.types.AssetShelf.show_names
msgid "Show the asset name together with the preview. Otherwise only the preview will be visible."
msgstr "Visa resursens namn tillsammans med förhandsvisningen. Annars visas bara förhandsvisningen."

#. :src: bpy.types.AssetWeakReference
msgid "Weak reference to some asset"
msgstr "Svag referens till en resurs"

#. :src: bpy.types.FileAssetSelectParams.filter_asset_id
msgid "Which asset types to show/hide, when browsing an asset library"
msgstr "Vilka resurstyper som visas eller döljs vid bläddring i ett resursbibliotek"

#. :src: bpy.types.FileAssetSelectParams.import_method:'FOLLOW_PREFS'
msgid "Follow Asset or Preferences"
msgstr "Följ resurs eller inställningar"

#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND'
msgid "Import the asset as copied data-block, with no link to the original asset data-block"
msgstr "Importera resursen som ett kopierat datablock utan länk till ursprungligt resursdatablock"
