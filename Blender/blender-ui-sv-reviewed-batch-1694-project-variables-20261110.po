#: source/blender/makesrna/intern/rna_blender_project.cc:433
msgid ""
"Invalid variable name '%s': name must not be empty, must not start with a "
"digit, and must contain only alphanumeric characters and underscores."
msgstr ""
"Ogiltigt variabelnamn ”%s”: namnet får inte vara tomt, får inte börja med en"
" siffra och får endast innehålla alfanumeriska tecken och understreck."

#: source/blender/makesrna/intern/rna_blender_project.cc:484
msgid "From index is out of bounds of the variable list."
msgstr "Startindex ligger utanför variabellistans gränser."

#: source/blender/makesrna/intern/rna_blender_project.cc:489
msgid "To index is out of bounds of the variable list."
msgstr "Slutindex ligger utanför variabellistans gränser."
