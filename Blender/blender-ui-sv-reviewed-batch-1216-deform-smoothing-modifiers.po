#. :src: bpy.types.CastModifier
msgid "Modifier to cast to other shapes"
msgstr "Modifierare som formar om till andra former"

#. :src: bpy.types.DisplaceModifier.direction:'CUSTOM_NORMAL'
msgid "Use the texture's intensity value to displace along the (averaged) custom normal (falls back to vertex)"
msgstr "Använd texturens intensitetsvärde för att förskjuta längs den genomsnittliga anpassade normalen (använder annars hörnpunktsnormalen)"

#. :src: bpy.types.DisplaceModifier.strength
msgid "Amount to displace geometry"
msgstr "Hur mycket geometrin ska förskjutas"

#. :src: bpy.types.SimpleDeformModifier
msgid "Simple deformation modifier to apply effects such as twisting and bending"
msgstr "Enkel deformationsmodifierare som tillämpar effekter som vridning och böjning"

#. :src: bpy.types.SimpleDeformModifier.deform_axis
msgid "Deform around local axis"
msgstr "Deformera runt en lokal axel"

#. :src: bpy.types.SimpleDeformModifier.factor
msgid "Amount to deform object"
msgstr "Hur mycket objektet ska deformeras"

#. :src: bpy.types.SimpleDeformModifier.limits
msgid "Lower/Upper limits for deform"
msgstr "Nedre och övre gräns för deformation"

#. :src: bpy.types.OBJECT_OT_correctivesmooth_bind
msgid "Bind base pose in Corrective Smooth modifier"
msgstr "Bind grundposen i modifieraren för korrigerande utjämning"

#: source/blender/modifiers/intern/MOD_laplaciandeform.cc:860
msgid "LaplacianDeform"
msgstr "Laplacisk deformering"

#: source/blender/modifiers/intern/MOD_laplaciansmooth.cc:550
msgid "LaplacianSmooth"
msgstr "Laplacisk utjämning"
