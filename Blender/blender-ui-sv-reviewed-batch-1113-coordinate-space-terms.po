#. :src: bpy.types.GeometryNodeSetGridTransform
msgid "Set the transform for the grid from index space into object space."
msgstr "Ange transformeringen för rutnätet från indexrymd till objektrymd."

#. :src: bpy.types.ShaderNodeDisplacement.space:'OBJECT'
msgid "Displacement is in object space, affected by object scale"
msgstr "Förskjutningen sker i objektrymd och påverkas av objektets skala"

#. :src: bpy.types.ShaderNodeDisplacement.space:'WORLD'
msgid "Displacement is in world space, not affected by object scale"
msgstr "Förskjutningen sker i världsrymd och påverkas inte av objektets skala"

#. :src: bpy.types.ShaderNodeNormalMap.space:'BLENDER_OBJECT'
msgid "Object space normal mapping, compatible with Blender render baking"
msgstr "Normalmappning i objektrymd, kompatibel med Blender-renderingsbakning"

#. :src: bpy.types.ShaderNodeNormalMap.space:'BLENDER_WORLD'
msgid "World space normal mapping, compatible with Blender render baking"
msgstr "Normalmappning i världsrymd, kompatibel med Blender-renderingsbakning"

#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'TANGENT'
msgid "Tangent space vector displacement mapping"
msgstr "Vektorförskjutningsavbildning i tangentrymd"

#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'OBJECT'
msgid "Object space vector displacement mapping"
msgstr "Vektorförskjutningsavbildning i objektrymd"

#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'WORLD'
msgid "World space vector displacement mapping"
msgstr "Vektorförskjutningsavbildning i världsrymd"

#. :src: bpy.types.ANIM_OT_world_space_copy
msgctxt "Operator"
msgid "Copy World Space Range"
msgstr "Kopiera intervall i världsrymden"
