#. :src: bpy.types.ID.override_library
#. :src: bpy.types.Menu
#. :src: bpy.types.OUTLINER_MT_liboverride
#. :src: bpy.types.VIEW3D_MT_object_liboverride
msgid "Library Override"
msgstr "Biblioteksåsidosättning"

#. :src: bpy.types.BlendImportContextItem.library_override_id
msgid "The library override of the linked ID. None until it has been created"
msgstr ""
"Biblioteksåsidosättningen för det länkade ID:t. Den saknas tills den har "
"skapats"

#. :src: bpy.types.IDOverrideLibrary.is_in_hierarchy
msgid ""
"Whether this library override is defined as part of a library hierarchy, or "
"as a single, isolated and autonomous override"
msgstr ""
"Anger om denna biblioteksåsidosättning ingår i en bibliotekshierarki eller "
"är en enskild, isolerad och autonom åsidosättning"

#. :src: bpy.types.IDOverrideLibrary.is_system_override
msgid ""
"Whether this library override exists only for the override hierarchy, or if "
"it is actually editable by the user"
msgstr ""
"Anger om denna biblioteksåsidosättning endast finns för "
"åsidosättningshierarkin eller om användaren faktiskt kan redigera den"

#. :src: bpy.types.GeometryNodeMergePoints
msgid "Merge points of a point cloud or mesh based on group ID and selection."
msgstr ""
"Sammanfoga punkter i ett punktmoln eller mesh utifrån grupp-ID och urval."

#. :src: bpy.types.ShaderNodeCustomGroup
msgid "Shader Custom Group"
msgstr "Anpassad shadergrupp"

#. :src: bpy.types.ShaderNodeCustomGroup
msgid "Custom Shader Group Node for Python nodes"
msgstr "Anpassad shadergruppnod för Python-noder"

#. :src: bpy.types.IMAGE_OT_save_as.save_as_render
msgid ""
"Save image with render color management.\n"
"For display image formats like PNG, apply view and display transform.\n"
"For intermediate image formats like OpenEXR, use the default render output "
"color space"
msgstr ""
"Spara bilden med renderingsfärghantering.\n"
"För visningsbildformat som PNG tillämpas vy- och skärmtransformering.\n"
"För mellanliggande bildformat som OpenEXR används standardfärgrymden för "
"renderingsutdata"

#. :src: bpy.types.MESH_OT_dissolve_edges.angle_threshold
#. :src: bpy.types.MESH_OT_dissolve_mode.angle_threshold
msgid ""
"Remaining vertices which separate edge pairs are preserved if their edge "
"angle exceeds this threshold."
msgstr ""
"Återstående hörnpunkter som separerar kantpar bevaras om deras kantvinkel "
"överskrider tröskelvärdet."

#. :src: bpy.types.MESH_OT_remove_doubles.use_centroid
msgid ""
"Move vertices to the centroid of the duplicate cluster, otherwise the vertex "
"closest to the centroid is used."
msgstr ""
"Flytta hörnpunkter till tyngdpunkten för dubblettklustret; annars används "
"den hörnpunkt som ligger närmast tyngdpunkten."

#. :src: bpy.types.MESH_OT_reorder_vertices_spatial
msgid ""
"Reorder mesh faces and vertices based on their spatial position for better "
"BVH building and sculpting performance."
msgstr ""
"Ordna om nätytor och hörnpunkter utifrån deras rumsliga position för bättre "
"BVH-byggande och skulpteringsprestanda."

#. :src: bpy.types.NODE_OT_delete_copy_reconnect
msgid "Copy nodes to clipboard, remove and reconnect them."
msgstr "Kopiera noder till urklippet, ta bort dem och återanslut dem."

#. :src: bpy.types.NODE_OT_duplicate_compositing_modifier_node_group
#. :src: bpy.types.NODE_OT_duplicate_compositing_node_group
msgid "Duplicate the currently assigned compositing node group."
msgstr "Duplicera den för närvarande tilldelade kompositornodgruppen."

#. :src: bpy.types.PREFERENCES_OT_extension_repo_add.use_custom_directory
#. :src: bpy.types.UserExtensionRepo.use_custom_directory
msgid ""
"Manually set the path for extensions to be stored. When disabled a user's "
"extensions directory is created."
msgstr ""
"Ange manuellt sökvägen där tillägg ska lagras. När funktionen är inaktiverad "
"skapas en katalog för användarens tillägg."

#. :src: bpy.types.WM_OT_usd_export.merge_parent_xform
msgid ""
"Merge USD primitives with their Xform parent if possible. USD does not allow "
"nested UsdGeomGprims, intermediary Xform prims will be defined to keep the "
"USD file valid when encountering object hierarchies."
msgstr ""
"Slå samman USD-primitiver med deras överordnade Xform om möjligt. USD "
"tillåter inte kapslade UsdGeomGprims. Mellanliggande Xform-primitiver "
"definieras för att hålla USD-filen giltig vid objekthierarkier."

#. :src: bpy.types.TOPBAR_PT_tool_settings_extra
msgid ""
"\n"
"Popover panel for adding extra options that don't fit in the tool settings "
"header"
msgstr ""
"\n"
"Utfällbar panel för extra alternativ som inte ryms i "
"verktygsinställningarnas rubrik"

#. :src: bpy.types.WM_OT_xr_navigation_teleport.hit_color
msgid "Hit Color"
msgstr "Färg vid träff"

#. :src: bpy.types.PREFERENCES_OT_asset_library_add.type:'REMOTE'
msgid "Add Remote Asset Library"
msgstr "Lägg till fjärranslutet resursbibliotek"

#. :src: bpy.types.PreferencesExperimental.use_remote_asset_libraries
msgid "Remote Asset Libraries"
msgstr "Fjärranslutna resursbibliotek"

#. :src: bpy.types.WM_OT_save_as_mainfile.copy
msgid ""
"Save a copy of the actual working state but does not make saved file active"
msgstr ""
"Spara en kopia av det faktiska arbetsläget utan att göra den sparade filen "
"aktiv"
