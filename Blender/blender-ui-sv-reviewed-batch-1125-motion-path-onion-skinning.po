#. :src: bpy.types.AnimVizMotionPaths.frame_after
msgid ""
"Number of frames to show after the current frame (only for 'Around Frame' "
"Onion-skinning method)"
msgstr ""
"Antal bildrutor som ska visas efter den aktuella bildrutan (endast för "
"lökskalningsmetoden ”Omkring bildrutan”)"

#. :src: bpy.types.AnimVizMotionPaths.frame_before
msgid ""
"Number of frames to show before the current frame (only for 'Around Frame' "
"Onion-skinning method)"
msgstr ""
"Antal bildrutor som ska visas före den aktuella bildrutan (endast för "
"lökskalningsmetoden ”Omkring bildrutan”)"

#. :src: bpy.types.AnimVizMotionPaths.frame_end
msgid ""
"End frame of range of paths to display/calculate (not for 'Around Frame' "
"Onion-skinning method)"
msgstr ""
"Slutbildruta för intervallet av banor som ska visas eller beräknas (inte "
"för lökskalningsmetoden ”Omkring bildrutan”)"

#. :src: bpy.types.AnimVizMotionPaths.frame_start
msgid ""
"Starting frame of range of paths to display/calculate (not for 'Around "
"Frame' Onion-skinning method)"
msgstr ""
"Startbildruta för intervallet av banor som ska visas eller beräknas (inte "
"för lökskalningsmetoden ”Omkring bildrutan”)"

#. :src: bpy.types.AnimVizMotionPaths.frame_step
msgid ""
"Number of frames between paths shown (not for 'On Keyframes' Onion-skinning "
"method)"
msgstr ""
"Antal bildrutor mellan visade banor (inte för lökskalningsmetoden ”Vid "
"nyckelbildrutor”)"
