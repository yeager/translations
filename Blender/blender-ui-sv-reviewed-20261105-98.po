msgid "Show stroke fills of this material"
msgstr "Visa fyllningar för streck med detta material"

#. :src: bpy.types.MaterialGPencilStyle.show_stroke
msgid "Show Stroke"
msgstr "Visa streck"

#. :src: bpy.types.MaterialGPencilStyle.show_stroke
msgid "Show stroke lines of this material"
msgstr "Visa strecklinjer för detta material"

#. :src: bpy.types.MaterialGPencilStyle.stroke_style
msgctxt "GPencil"
msgid "Stroke Style"
msgstr "Streckstil"

#. :src: bpy.types.MaterialGPencilStyle.stroke_style:'SOLID'
msgid "Draw strokes with solid color"
msgstr "Rita streck med enfärgad färg"

#. :src: bpy.types.MaterialGPencilStyle.texture_angle
msgid "Texture Orientation Angle"
msgstr "Texturorienteringsvinkel"

#. :src: bpy.types.MaterialGPencilStyle.texture_clamp
msgid "Do not repeat texture and clamp to one instance only"
msgstr "Upprepa inte texturen utan begränsa den till en instans"

#. :src: bpy.types.MaterialGPencilStyle.texture_offset
msgid "Shift Texture in 2d Space"
msgstr "Förskjut textur i 2D-utrymme"

#. :src: bpy.types.MaterialGPencilStyle.use_fill_holdout
#. :src: bpy.types.MaterialGPencilStyle.use_stroke_holdout
msgid "Remove the color from underneath this stroke by using it as a mask"
msgstr "Ta bort färgen under det här strecket genom att använda det som mask"

#. :src: bpy.types.MaterialGPencilStyle.use_overlap_strokes
msgid "Self Overlap"
msgstr "Självöverlappning"

#. :src: bpy.types.MaterialLineArt
msgid "Material Line Art"
msgstr "Materiallinjekonst"

#. :src: bpy.types.MaterialLineArt.mat_occlusion
msgid ""
"Faces with this material will behave as if it has set number of layers in "
"occlusion"
msgstr ""
"Ytor med detta material uppför sig som om de hade det inställda antalet "
"lager i ocklusionen"

#. :src: bpy.types.MaterialLineArt.use_intersection_priority_override
msgid "Override object and collection intersection priority value"
msgstr "Åsidosätt prioritetsvärdet för objekt- och samlingsskärningar"

