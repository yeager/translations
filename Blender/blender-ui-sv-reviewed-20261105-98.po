#. :src: bpy.types.MaterialGPencilStyle.mode
msgid "Line Type"
msgstr "Linjetyp"

#. :src: bpy.types.MaterialGPencilStyle.mode:'DOTS'
msgid "Draw strokes using separated dots"
msgstr "Rita streck med åtskilda punkter"

#. :src: bpy.types.MaterialGPencilStyle.pass_index
msgid "Index number for the \"Color Index\" pass"
msgstr "Indexnummer för passet ”Färgindex”"

#. :src: bpy.types.MaterialGPencilStyle.pixel_size
msgid "Texture Pixel Size factor along the stroke"
msgstr "Faktor för texturens pixelstorlek längs strecket"

