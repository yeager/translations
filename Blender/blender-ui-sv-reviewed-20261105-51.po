msgid "Selfcollision Vertex Group"
msgstr "Hörnpunktsgrupp för självkollision"

msgid "Triangles with all vertices in this group are not used during self collisions"
msgstr "Trianglar där alla hörnpunkter ingår i denna grupp används inte vid självkollisioner"

msgid "Bending Spring Damping"
msgstr "Dämpning för böjfjädrar"

msgid "Amount of damping in bending behavior"
msgstr "Dämpningens omfattning vid böjning"

msgid "Cloth model with linear bending springs (legacy)"
msgstr "Tygmodell med linjära böjfjädrar (äldre modell)"

msgid "Bending Stiffness Maximum"
msgstr "Maximal böjstyvhet"

msgid "Compression Spring Damping"
msgstr "Dämpning för kompressionsfjädrar"

msgid "Amount of damping in compression behavior"
msgstr "Dämpningens omfattning vid kompression"

msgid "Compression Stiffness Maximum"
msgstr "Maximal kompressionsstyvhet"

msgid "Effector Weights"
msgstr "Effektorvikter"

msgid "Internal Spring Max Diversion"
msgstr "Maximal avvikelse för interna fjädrar"

msgid "How much the rays used to connect the internal points can diverge from the vertex normal"
msgstr "Hur mycket strålarna som används för att ansluta de interna punkterna kan avvika från hörnpunktens normal"

msgid "Internal Spring Max Length"
msgstr "Maximal längd för interna fjädrar"

msgid "Check Internal Spring Normals"
msgstr "Kontrollera normaler för interna fjädrar"

msgid "Tension Stiffness"
msgstr "Dragstyvhet"

msgid "Tension Stiffness Maximum"
msgstr "Maximal dragstyvhet"

msgid "Vertex Mass"
msgstr "Hörnpunktsmassa"

msgid "The mass of each vertex on the cloth material"
msgstr "Massan för varje hörnpunkt i tygmaterialet"

msgid "Rest Shape Key"
msgstr "Formnyckel för viloläge"

msgid "Shape key to use the rest spring lengths from"
msgstr "Formnyckel vars vilolängder för fjädrar ska användas"
