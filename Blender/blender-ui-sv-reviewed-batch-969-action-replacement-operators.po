#. :src: bpy.types.ANIM_OT_replace_action
msgctxt "Operator"
msgid "Replace Action"
msgstr "Ersätt Action"

#. :src: bpy.types.ANIM_OT_replace_action
msgid "Swap all users of one action to another one. The normal action slot assignment rules apply. This ignores the NLA and Action Constraints"
msgstr "Byt alla användare av en Action till en annan. De vanliga reglerna för tilldelning av Action-slotar gäller. NLA och Action-begränsningar ignoreras"

#. :src: bpy.types.ANIM_OT_replace_action.new_session_uid
msgid "Replacement Action"
msgstr "Ersättnings-Action"

#. :src: bpy.types.ANIM_OT_replace_action.new_session_uid
msgid "The replacement Action's session uid to remap all selected Action's users to"
msgstr "Sessions-UID för ersättnings-Actionen som alla användare av den valda Actionen ska mappas om till"

#. :src: bpy.types.ANIM_OT_replace_action.old_session_uid
#. :src: bpy.types.ANIM_OT_replace_action_duplicate.old_session_uid
#. :src: bpy.types.ANIM_OT_replace_action_new.old_session_uid
msgid "Old Action"
msgstr "Gammal Action"

#. :src: bpy.types.ANIM_OT_replace_action.old_session_uid
#. :src: bpy.types.ANIM_OT_replace_action_duplicate.old_session_uid
#. :src: bpy.types.ANIM_OT_replace_action_new.old_session_uid
msgid "Old Action's session uid to replace"
msgstr "Sessions-UID för den gamla Actionen som ska ersättas"

#. :src: bpy.types.ANIM_OT_replace_action_duplicate
msgctxt "Operator"
msgid "Replace with Duplicate Action"
msgstr "Ersätt med duplicerad Action"

#. :src: bpy.types.ANIM_OT_replace_action_duplicate
msgid "Duplicates the action of the active object and swaps all users of that action to that duplicate"
msgstr "Duplicerar det aktiva objektets Action och byter alla användare av den Actionen till dubbletten"

#. :src: bpy.types.ANIM_OT_replace_action_new
msgctxt "Operator"
msgid "Replace with New Action"
msgstr "Ersätt med ny Action"

#. :src: bpy.types.ANIM_OT_replace_action_new
msgid "Swap all users of one action to a new action. This ignores the NLA and Action Constraints"
msgstr "Byt alla användare av en Action till en ny Action. Detta ignorerar NLA och Action-begränsningar"

#: source/blender/blenkernel/intern/nla.cc:1945
#: source/blender/editors/animation/anim_channels_defines.cc:4588
msgid "<No Action>"
msgstr "<Ingen Action>"
