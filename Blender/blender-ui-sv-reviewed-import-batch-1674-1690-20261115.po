msgid "Loading Asset Libraries"
msgstr "Läser in resursbibliotek"

#: source/blender/editors/object/object_bake.cc:148
msgid "Mesh should be unwrapped before multires data baking"
msgstr "Meshen bör vecklas ut innan multires-data bakas"

#: source/blender/editors/object/object_bake.cc:176
msgid "Baking should happen to image with image buffer"
msgstr "Bakning måste ske till en bild med bildbuffert"

#: source/blender/editors/object/object_bake.cc:191
msgid "Baking to unsupported image type"
msgstr "Bakning till bildtyp som inte stöds"

#: source/blender/editors/object/object_bake.cc:464
msgid "Baking Multires..."
msgstr "Bakar multires..."

#: source/blender/editors/object/object_bake_api.cc:588
#: source/blender/editors/object/object_bake_api.cc:595
msgid ""
"Combined bake pass requires Emission, or a light pass with Direct or "
"Indirect contributions enabled"
msgstr ""
"Det kombinerade bakningspasset kräver emission eller ett ljuspass med direkt "
"eller indirekt bidrag aktiverat"

#: source/blender/editors/object/object_bake_api.cc:611
msgid ""
"Bake pass requires Direct, Indirect, or Color contributions to be enabled"
msgstr ""
"Bakningspasset kräver att direkt, indirekt eller färgbidrag är aktiverat"

#: source/blender/editors/object/object_bake_api.cc:1431
#: source/blender/editors/object/object_bake_api.cc:1709
msgid "Current render engine does not support baking"
msgstr "Den nuvarande renderingsmotorn stöder inte bakning"

#: source/blender/editors/object/object_bake_api.cc:1687
msgid "Error baking from object \"%s\""
msgstr "Fel vid bakning från objektet ”%s”"

#: source/blender/editors/object/object_bake_api.cc:1799
msgid "Problem baking object \"%s\""
msgstr "Problem vid bakning av objektet ”%s”"

#: source/blender/editors/object/object_bake_api.cc:2194
msgid "Baking texture..."
msgstr "Bakar textur..."

#: source/blender/editors/object/object_collection.cc:1331
msgid "Exported %d files from collection '%s'"
msgstr "Exporterade %d filer från samlingen ”%s”"

#: source/blender/editors/object/object_data_transfer.cc:451
msgid ""
"Operator is frozen, changes to its settings won't take effect until you "
"unfreeze it"
msgstr ""
"Operatören är låst. Ändringar i inställningarna träder inte i kraft förrän "
"du låser upp den"

#: source/blender/editors/object/object_edit.cc:2295
msgid "Objects linked to %s"
msgstr "Objekt länkade till %s"

#: source/blender/editors/object/object_light_linking_ops.cc:146
msgid "Cannot link to light linking collection '%s' that is used by scene '%s'"
msgstr ""
"Det går inte att länka till ljuslänkningssamlingen ”%s” som används av "
"scenen ”%s”"

#: source/blender/editors/object/object_light_linking_ops.cc:262
msgid ""
"Cannot unlink from light linking collection '%s' that is used by scene '%s'"
msgstr ""
"Det går inte att avlänka från ljuslänkningssamlingen ”%s” som används av "
"scenen ”%s”"

#: source/blender/editors/object/object_modes.cc:572
msgid ""
"Current mode of source object '%s' is not compatible with target liboverride "
"object '%s'"
msgstr ""
"Det aktuella läget ”%s” för källobjektet är inte kompatibelt med "
"biblioteksåsidosättningsobjektet ”%s”"

#: source/blender/editors/object/object_modes.cc:581
msgid ""
"Current mode of source object '%s' is not compatible with target object '%s'"
msgstr ""
"Det aktuella läget ”%s” för källobjektet är inte kompatibelt med målobjektet "
"”%s”"

#: source/blender/editors/object/object_modifier.cc:2095
msgid "Make data single-user, apply modifier, and remove it from the list."
msgstr ""
"Gör data till enskild användare, tillämpa modifieraren och ta bort den från "
"listan."

#: source/blender/editors/object/object_modifier.cc:901
msgid "Modifier is disabled or returned error, skipping apply"
msgstr ""
"Modifieraren är inaktiverad eller returnerade ett fel. Hoppar över "
"tillämpning"

#: source/blender/editors/object/object_relations.cc:2991
msgid "Make Selected Objects Single-User"
msgstr "Gör valda objekt till enskild användare"

#: source/blender/editors/object/object_relations.cc:2991
#: source/blender/editors/space_nla/nla_edit.cc:2120
msgid "Make Single"
msgstr "Gör till enskild användare"

#: source/blender/editors/object/object_relations.cc:3251
msgid "Incorrect context for running object data unlink"
msgstr "Felaktigt sammanhang för att ta bort länken till objektdata"

#: source/blender/editors/object/object_relations.cc:2469
msgid "Collection '%s' (instantiated by the active object) is not overridable"
msgstr ""
"Samlingen ”%s” (instansierad av det aktiva objektet) kan inte åsidosättas"

#: source/blender/editors/object/object_transform.cc:1179
msgid ""
"Warning: Multiple objects share the same data.\n"
"Make single user and then apply transformations?"
msgstr ""
"Varning: Flera objekt delar samma data.\n"
"Gör data till enskild användare och tillämpa sedan transformeringarna?"

#: source/blender/editors/object/object_transform.cc:762
msgid "Text objects can only have their scale applied: \"%s\""
msgstr "Textobjekt kan endast ha sin skala tillämpad: ”%s”"

#: source/blender/editors/object/object_volume.cc:103
msgid "Volume \"%s\" contains points, only voxel grids are supported"
msgstr "Volymen ”%s” innehåller punkter, endast voxelrutnät stöds"

#: source/blender/editors/physics/physics_fluid.cc:201
msgid "Fluid: Could not create cache directory '%s', reset to default '%s'"
msgstr ""
"Vätska: Det gick inte att skapa cachekatalogen ”%s”; återställs till "
"standardvärdet ”%s”"

#: source/blender/editors/physics/physics_pointcache.cc:55
msgid "Library override data-blocks only support Disk Cache storage"
msgstr "Biblioteksåsidosatta datablock stöder endast lagring i diskcache"

#: source/blender/editors/render/render_opengl.cc:1432
msgid ""
"Render the viewport for the animation range of this scene, but only render "
"keyframes of selected objects"
msgstr ""
"Rendera vyporten för scenens animeringsintervall, men bara nyckelbildrutor "
"för valda objekt"

#: source/blender/editors/render/render_opengl.cc:1437
msgid "Render the viewport for the animation range of this scene"
msgstr "Rendera vyporten för scenens animeringsintervall"

#: source/blender/editors/render/render_opengl.cc:1364
msgid "Rendering viewport..."
msgstr "Renderar vyporten..."

#: source/blender/editors/render/render_preview.cc:982
msgid "Object %s has no pose, unable to apply the Action before rendering"
msgstr ""
"Objektet %s har ingen ställning. Det går inte att tillämpa Actionen före "
"rendering"

#: source/blender/editors/render/render_preview.cc:1843
#: source/blender/editors/space_sequencer/sequencer_drag_drop.cc:753
msgid "Loading previews..."
msgstr "Läser in förhandsvisningar..."

#: source/blender/editors/screen/screen_ops.cc:357
msgid "Expected an active Outliner"
msgstr "En aktiv Outliner förväntades"

#: source/blender/editors/screen/screen_ops.cc:362
msgid "Expected an Outliner region"
msgstr "En Outliner-region förväntades"

#: source/blender/editors/screen/screen_ops.cc:429
msgid "Expected an active Dope Sheet"
msgstr "Ett aktivt dopeblad förväntades"

#: source/blender/editors/screen/screen_ops.cc:434
msgid "Expected a Dope Sheet region"
msgstr "En dopebladsregion förväntades"

#: source/blender/editors/sculpt_paint/mesh/paint_image_proj.cc:6701
msgid " UVs,"
msgstr " UV:er,"

#: source/blender/editors/sculpt_paint/mesh/sculpt.cc:8305
#: source/blender/editors/sculpt_paint/mesh/sculpt.cc:8327
msgid "Viewport overlays are disabled"
msgstr "Vyportens överlägg är inaktiverade"

#: source/blender/editors/space_file/file_draw.cc:1747
msgid "Loading..."
msgstr "Läser in..."

#: source/blender/editors/space_graph/graph_buttons.cc:589
msgid "F-Curve does not have any keyframes as it only contains sampled points"
msgstr ""
"F-kurvan har inga nyckelbildrutor eftersom den endast innehåller provtagna "
"punkter"

#: source/blender/editors/space_graph/graph_edit.cc:370
msgid "Keyframes cannot be added to sampled F-Curves"
msgstr "Det går inte att lägga till nyckelbildrutor i provtagna F-kurvor"

#: source/blender/editors/space_info/info_ops.cc:271
msgid "Unpack - Files: {}, Bakes: {}"
msgstr "Packa upp - filer: {}, bakningar: {}"

#: source/blender/editors/space_info/info_ops.cc:466
msgid "Cannot set absolute paths with an unsaved blend file"
msgstr "Det går inte att ange absoluta sökvägar med en osparad .blend-fil"

