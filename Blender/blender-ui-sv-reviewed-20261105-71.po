#. :src: bpy.types.FluidEffectorSettings.use_plane_init
msgid "Treat this object as a planar, unclosed mesh"
msgstr "Behandla objektet som en plan, öppen mesh"

#. :src: bpy.types.FluidFlowSettings.density_vertex_group
msgid "Name of vertex group which determines surface emission rate"
msgstr "Namn på den hörnpunktsgrupp som bestämmer ytans emissionshastighet"

#. :src: bpy.types.FluidFlowSettings.flow_behavior:'GEOMETRY'
msgid "Only use given geometry for fluid"
msgstr "Använd endast den angivna geometrin för vätskan"

#. :src: bpy.types.FluidFlowSettings.flow_type:'BOTH'
msgid "Fire + Smoke"
msgstr "Eld + rök"

#. :src: bpy.types.FluidFlowSettings.texture_offset
msgid "Z-offset of texture mapping"
msgstr "Z-förskjutning för texturmappning"

#. :src: bpy.types.FluidFlowSettings.use_initial_velocity
msgid "Fluid has some initial velocity when it is emitted"
msgstr "Vätskan har en viss initialhastighet när den avges"

#. :src: bpy.types.FluidFlowSettings.use_plane_init
msgid ""
"Treat this object as a planar and unclosed mesh. Fluid will only be emitted "
"from the mesh surface and based on the surface emission value."
msgstr ""
"Behandla objektet som en plan, öppen mesh. Vätska avges bara från meshytan "
"och styrs av ytans emissionsvärde."

#. :src: bpy.types.FluidFlowSettings.velocity_coord
#. :src: bpy.types.Itasc.reiteration_method:'INITIAL'
msgid "Initial"
msgstr "Initial"

#. :src: bpy.types.FluidFlowSettings.velocity_normal
msgid "Amount of normal directional velocity"
msgstr "Mängd hastighet i normalriktningen"

#. :src: bpy.types.FluidFlowSettings.volume_density
#: scripts/startup/bl_ui/properties_physics_fluid.py:563
msgid "Volume Emission"
msgstr "Volymemission"

#. :src: bpy.types.FluidFlowSettings.volume_density
msgid ""
"Controls fluid emission from within the mesh (higher value results in "
"greater emissions from inside the mesh)"
msgstr ""
"Styr vätskeutsläpp inifrån meshen (högre värde ger större utsläpp inifrån "
"meshen)"
