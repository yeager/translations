#. :src: bpy.types.Object.show_all_edges
msgid "Display All Edges"
msgstr "Visa alla kanter"

#. :src: bpy.types.Object.show_all_edges
msgid "Display all edges for mesh objects"
msgstr "Visa alla kanter för mesh-objekt"

#. :src: bpy.types.Object.show_axis
msgid "Display the object's origin and axes"
msgstr "Visa objektets ursprung och axlar"

#. :src: bpy.types.Object.show_bounds
msgid "Display Bounds"
msgstr "Visa begränsningsbox"

#. :src: bpy.types.Object.show_bounds
msgid "Display the object's bounds"
msgstr "Visa objektets begränsningsbox"

#. :src: bpy.types.Object.show_empty_image_only_axis_aligned
msgid "Display Only Axis Aligned"
msgstr "Visa endast axelriktad"

#. :src: bpy.types.Object.show_empty_image_only_axis_aligned
msgid "Only display the image when it is aligned with the view axis"
msgstr "Visa endast bilden när den är i linje med vyaxeln"

#. :src: bpy.types.Object.show_empty_image_orthographic
msgid "Display in Orthographic Mode"
msgstr "Visa i ortografiskt läge"

#. :src: bpy.types.Object.show_empty_image_orthographic
msgid "Display image in orthographic mode"
msgstr "Visa bilden i ortografiskt läge"

#. :src: bpy.types.Object.show_empty_image_perspective
msgid "Display in Perspective Mode"
msgstr "Visa i perspektivläge"

#. :src: bpy.types.Object.show_empty_image_perspective
msgid "Display image in perspective mode"
msgstr "Visa bilden i perspektivläge"

#. :src: bpy.types.Object.show_in_front
msgid "Make the object display in front of others"
msgstr "Visa objektet framför övriga"

#. :src: bpy.types.Object.show_instancer_for_render
msgid "Render Instancer"
msgstr "Rendera instansierare"

#. :src: bpy.types.Object.show_instancer_for_render
msgid "Make instancer visible when rendering"
msgstr "Gör instansieraren synlig vid rendering"

#. :src: bpy.types.Object.show_instancer_for_viewport
msgid "Display Instancer"
msgstr "Visa instansierare"

#. :src: bpy.types.Object.show_instancer_for_viewport
msgid "Make instancer visible in the viewport"
msgstr "Gör instansieraren synlig i vyporten"

#. :src: bpy.types.Object.show_only_shape_key
msgid "Solo Active Shape Key"
msgstr "Visa bara aktiv formnyckel"

#. :src: bpy.types.Object.show_only_shape_key
msgid "Only show the active shape key at full value"
msgstr "Visa bara den aktiva formnyckeln till fullt värde"

#. :src: bpy.types.Object.show_texture_space
msgid "Display Texture Space"
msgstr "Visa texturutrymme"

#. :src: bpy.types.Object.show_texture_space
msgid "Display the object's texture space"
msgstr "Visa objektets texturutrymme"

#. :src: bpy.types.Object.show_transparent
msgid "Display Transparent"
msgstr "Visa genomskinlighet"

#. :src: bpy.types.Object.show_transparent
msgid "Display material transparency in the object"
msgstr "Visa materialets genomskinlighet i objektet"

#. :src: bpy.types.Object.show_wire
msgid "Display the object's wireframe over solid shading"
msgstr "Visa objektets trådram över solid skuggning"

#. :src: bpy.types.Object.soft_body
msgid "Settings for soft body simulation"
msgstr "Inställningar för simulering av mjuk kropp"

#. :src: bpy.types.Object.track_axis
msgid ""
"Axis that points in the 'forward' direction (applies to Instance Vertices "
"when Align to Vertex Normal is enabled)"
msgstr ""
"Axel som pekar i riktningen \"framåt\" (gäller för instanshörnpunkter när "
"Justera efter hörnpunktsnormal är aktiverat)"

#. :src: bpy.types.Object.type:'SURFACE'
#. :src: bpy.types.OBJECT_OT_add.type:'SURFACE'
#. :src: bpy.types.OBJECT_OT_select_by_type.type:'SURFACE'
msgctxt "ID"
msgid "Surface"
msgstr "Yta"

#. :src: bpy.types.Object.type:'CURVES'
#. :src: bpy.types.OBJECT_OT_add.type:'CURVES'
#. :src: bpy.types.OBJECT_OT_select_by_type.type:'CURVES'
msgctxt "ID"
msgid "Hair Curves"
msgstr "Hårkurvor"

#. :src: bpy.types.Object.type:'EMPTY'
#. :src: bpy.types.OBJECT_OT_add.type:'EMPTY'
#. :src: bpy.types.OBJECT_OT_select_by_type.type:'EMPTY'
#. :src: bpy.types.DATA_PT_empty
#. :src: bpy.types.ThemeView3D.empty
#: source/blender/blenkernel/intern/object.cc:1951
#: source/blender/blenkernel/intern/object.cc:1958
msgctxt "ID"
msgid "Empty"
msgstr "Tomobjekt"

#. :src: bpy.types.Object.up_axis
msgid ""
"Axis that points in the upward direction (applies to Instance Vertices when "
"Align to Vertex Normal is enabled)"
msgstr ""
"Axel som pekar uppåt (gäller för instanshörnpunkter när Justera efter "
"hörnpunktsnormal är aktiverat)"

#. :src: bpy.types.Object.use_camera_lock_parent
msgid "Camera Parent Lock"
msgstr "Lås kamerans förälder"

#. :src: bpy.types.Object.use_camera_lock_parent
msgid ""
"View Lock 3D viewport camera transformation affects the object's parent "
"instead"
msgstr ""
"Låsning av vy: 3D-vyportens kameratransformation påverkar i stället "
"objektets förälder"

#. :src: bpy.types.Object.use_dynamic_topology_sculpting
msgid "Dynamic Topology Sculpting"
msgstr "Skulptering med dynamisk topologi"

#. :src: bpy.types.Object.use_empty_image_alpha
#. :src: bpy.types.ImageTexture.use_alpha
#. :src: bpy.types.CompositorNodeComposite.use_alpha
#. :src: bpy.types.CompositorNodeViewer.use_alpha
#. :src: bpy.types.CompositorNodeZcombine.use_alpha
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.use_transparency
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.use_transparency
#: source/blender/nodes/composite/nodes/node_composite_zcombine.cc:45
msgid "Use Alpha"
msgstr "Använd alfa"

#. :src: bpy.types.Object.use_empty_image_alpha
msgid ""
"Use alpha blending instead of alpha test (can produce sorting artifacts)"
msgstr ""
"Använd alfablandning i stället för alfatest (kan ge sorteringsartefakter)"

#. :src: bpy.types.Object.use_grease_pencil_lights
msgid "Lights affect Grease Pencil object"
msgstr "Ljus påverkar Grease Pencil-objekt"

#. :src: bpy.types.Object.use_instance_faces_scale
msgid "Scale to Face Sizes"
msgstr "Skala efter ytstorlek"

#. :src: bpy.types.Object.use_instance_faces_scale
msgid "Scale instance based on face size"
msgstr "Skala instansen utifrån ytans storlek"

#. :src: bpy.types.Object.use_instance_vertices_rotation
msgid "Orient with Normals"
msgstr "Orientera efter normaler"

#. :src: bpy.types.Object.use_instance_vertices_rotation
msgid "Rotate instance according to vertex normal"
msgstr "Rotera instansen enligt hörnpunktsnormalen"

#. :src: bpy.types.Object.use_mesh_mirror_x
msgid "Enable mesh symmetry in the X axis"
msgstr "Aktivera mesh-symmetri i X-axeln"

#. :src: bpy.types.Object.use_mesh_mirror_y
msgid "Enable mesh symmetry in the Y axis"
msgstr "Aktivera mesh-symmetri i Y-axeln"

#. :src: bpy.types.Object.use_mesh_mirror_z
msgid "Enable mesh symmetry in the Z axis"
msgstr "Aktivera mesh-symmetri i Z-axeln"

#. :src: bpy.types.Object.use_parent_final_indices
msgid "Use Final Indices"
msgstr "Använd slutgiltiga index"

#. :src: bpy.types.Object.use_parent_final_indices
msgid "Use the final evaluated indices rather than the original mesh indices"
msgstr ""
"Använd de slutliga utvärderade indexen i stället för de ursprungliga "
"meshindexen"

#. :src: bpy.types.Object.use_shape_key_edit_mode
msgid "Shape Key Edit Mode"
msgstr "Redigeringsläge för formnyckel"

#. :src: bpy.types.Object.use_shape_key_edit_mode
msgid "Display shape keys in edit mode (for meshes only)"
msgstr "Visa formnycklar i redigeringsläge (endast för meshar)"

#. :src: bpy.types.Object.use_simulation_cache
msgid "Use Simulation Cache"
msgstr "Använd simuleringscache"

#. :src: bpy.types.Object.use_simulation_cache
msgid "Cache frames during simulation nodes playback"
msgstr "Spara bildrutor i cache under uppspelning av simuleringsnoder"
