#. :src: bpy.types.AssetShelf.bl_activate_operator
msgid "Activate Operator"
msgstr "Aktiveringsoperatör"

#. :src: bpy.types.AssetShelf.bl_drag_operator
msgid "Drag Operator"
msgstr "Dragoperatör"

#. :src: bpy.types.AssetShelf.bl_drag_operator
msgid "Operator to call when dragging an item with asset reference properties"
msgstr "Operatör att anropa när ett objekt med resursreferensegenskaper dras"

#. :src: bpy.types.FileHandler
msgid "Extends functionality to operators that manages files, such as adding drag and drop support"
msgstr "Utökar funktionerna hos operatörer som hanterar filer, till exempel genom att lägga till stöd för dra och släpp"

#. :src: bpy.types.KeyMap.is_modal
msgid "Modal Keymap"
msgstr "Modal tangentmappning"

#. :src: bpy.types.KeyMap.is_modal
msgid "Indicates that a keymap is used for translate modal events for an operator"
msgstr "Anger att en tangentmappning används för att översätta modala händelser för en operatör"

#. :src: bpy.types.KeyMap.keymap_items
msgid "Items in the keymap, linking an operator to an input event"
msgstr "Poster i tangentmappningen som kopplar en operatör till en inmatningshändelse"

#. :src: bpy.types.KeyMap.modal_event_values
msgid "Give access to the possible event values of this modal keymap's items (#KeyMapItem.propvalue), for API introspection"
msgstr "Ger åtkomst till möjliga händelsevärden för posterna i denna modala tangentmappning (#KeyMapItem.propvalue) för API-introspektion"

#. :src: bpy.types.KeyMap.name
msgid "Name of the key map"
msgstr "Namn på tangentmappningen"

#. :src: bpy.types.KeyMap.region_type
msgid "Optional region type keymap is associated with"
msgstr "Valfri regiontyp som tangentmappningen är kopplad till"

#. :src: bpy.types.KeyMapItem.idname
msgid "Identifier of operator to call on input event"
msgstr "Identifierare för operatören som ska anropas vid en inmatningshändelse"

#. :src: bpy.types.KeyMapItem.is_user_defined
msgid "Is this keymap item user defined (does not just replace a builtin item)"
msgstr "Är denna tangentmappningspost användardefinierad (ersätter inte bara en inbyggd post)"

#. :src: bpy.types.KeyMapItem.name
msgid "Name of operator (translated) to call on input event"
msgstr "Namn på operatören (översatt) som ska anropas vid inmatningshändelse"
