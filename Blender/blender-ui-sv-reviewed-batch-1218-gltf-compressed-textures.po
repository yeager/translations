# translation of Blender UI to Swedish
# Delta review: glTF compressed-texture export and import UI
msgid ""
msgstr ""
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_compressed_images_fallback
msgid "Compressed Images Fallback"
msgstr "Reservtextur för komprimerade texturer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_compressed_images_fallback
msgid "For all compressed textures (WebP or KTX2), create a PNG fallback texture"
msgstr "Skapa en PNG-reservtextur för alla komprimerade texturer (WebP eller KTX2)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_compressed_images_type
msgid "Compressed Images Type"
msgstr "Typ av komprimerade texturer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_compressed_images_type
msgid "Choose the format for compressed textures fallback (WebP or KTX2 with BasisU supercompression)"
msgstr "Välj format för reservtexturen för komprimerade texturer (WebP eller KTX2 med BasisU-superkomprimering)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_add_compressed_images
msgid "Create Compressed Images"
msgstr "Skapa komprimerade texturer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_add_compressed_images
msgid "Creates compressed textures (WebP or KTX2)for every texture. For already compressed textures, nothing happens"
msgstr "Skapar komprimerade texturer (WebP eller KTX2) för varje textur. Redan komprimerade texturer lämnas oförändrade"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_ktx_zstd_level
msgid "Set the Zstandard compression level for (UASTC) non-color KTX2 textures (1 is fastest/lowest ratio, 22 is slowest/highest ratio)"
msgstr "Ange Zstandard-komprimeringsnivån för KTX2-texturer utan färg (UASTC). Nivå 1 är snabbast och har lägst kompressionsförhållande, nivå 22 är långsammast och har högst kompressionsförhållande"

#. :src: bpy.types.IMPORT_SCENE_OT_gltf.import_ktx_texture
msgid "If a texture exists in KTX format, loads the KTX texture instead of the fallback PNG/JPEG one"
msgstr "Om en textur finns i KTX-format läses KTX-texturen in i stället för PNG-/JPEG-reservtexturen"
