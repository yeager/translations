#. :src: bpy.types.FluidDomainSettings.use_color_ramp
#. :src: bpy.types.PHYSICS_PT_viewport_display_color
msgid "Grid Display"
msgstr "Rutnätsvisning"

#. :src: bpy.types.FluidDomainSettings.use_color_ramp
msgid ""
"Render a simulation field while mapping its voxels values to the colors of a "
"ramp or using a predefined color code"
msgstr ""
"Rendera ett simuleringsfält genom att färgkartlägga dess voxelvärden med "
"färgerna i en färggradient eller använda en fördefinierad färgkod"

#. :src: bpy.types.FluidDomainSettings.use_diffusion
msgid "Use Diffusion"
msgstr "Använd diffusion"

#. :src: bpy.types.FluidDomainSettings.use_diffusion
msgid "Enable fluid diffusion settings (e.g. viscosity, surface tension)"
msgstr ""
"Aktivera inställningar för vätskediffusion (t.ex. viskositet, ytspänning)"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke
msgid "Let smoke disappear over time"
msgstr "Låt röken försvinna över tid"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke_log
msgid "Logarithmic Dissolve"
msgstr "Logaritmisk upplösning"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke_log
msgid ""
"Dissolve smoke in a logarithmic fashion. Dissolves quickly at first, but "
"lingers longer."
msgstr ""
"Lös upp röken logaritmiskt. Den löses först upp snabbt men dröjer kvar "
"längre."

#. :src: bpy.types.FluidDomainSettings.use_flip_particles
msgid "Create liquid particle system"
msgstr "Skapa vätskepartikelsystem"

#. :src: bpy.types.FluidDomainSettings.use_foam_particles
#: scripts/startup/bl_ui/properties_physics_fluid.py:947
#: source/blender/modifiers/intern/MOD_ocean.cc:539
msgid "Foam"
msgstr "Skum"

#. :src: bpy.types.FluidDomainSettings.use_foam_particles
msgid "Create foam particle system"
msgstr "Skapa skumpartikelsystem"

#. :src: bpy.types.FluidDomainSettings.use_fractions
#: scripts/startup/bl_ui/properties_physics_fluid.py:519
msgid "Fractional Obstacles"
msgstr "Fraktionella hinder"

#. :src: bpy.types.FluidDomainSettings.use_fractions
msgid "Fractional obstacles improve and smoothen the fluid-obstacle boundary"
msgstr ""
"Fraktionella hinder förbättrar och jämnar ut gränsen mellan vätska och hinder"

#. :src: bpy.types.FluidDomainSettings.use_guide
msgid "Use Guiding"
msgstr "Använd styrning"

#. :src: bpy.types.FluidDomainSettings.use_guide
msgid "Enable fluid guiding"
msgstr "Aktivera vätskestyrning"

#. :src: bpy.types.FluidDomainSettings.use_slice
#. :src: bpy.types.VolumeDisplay.use_slice
msgid "Perform a single slice of the domain object"
msgstr "Visa en enda skiva av domänobjektet"

#. :src: bpy.types.FluidDomainSettings.use_speed_vectors
msgid "Speed Vectors"
msgstr "Hastighetsvektorer"

#. :src: bpy.types.FluidDomainSettings.use_speed_vectors
msgid ""
"Caches velocities of mesh vertices. These will be used (automatically) when "
"rendering with motion blur enabled."
msgstr ""
"Cachelagrar hastigheter för meshens hörnpunkter. De används automatiskt vid "
"rendering med aktiverad rörelseoskärpa."

#. :src: bpy.types.FluidDomainSettings.use_spray_particles
#: scripts/startup/bl_ui/properties_physics_fluid.py:946
msgid "Spray"
msgstr "Spray"

#. :src: bpy.types.FluidDomainSettings.use_spray_particles
msgid "Create spray particle system"
msgstr "Skapa spraypartikelsystem"

#. :src: bpy.types.FluidDomainSettings.use_tracer_particles
msgid "Tracer"
msgstr "Spårare"

#. :src: bpy.types.FluidDomainSettings.use_tracer_particles
msgid "Create tracer particle system"
msgstr "Skapa spårpartikelsystem"

#. :src: bpy.types.FluidDomainSettings.use_viscosity
msgid "Use Viscosity"
msgstr "Använd viskositet"

#. :src: bpy.types.FluidDomainSettings.use_viscosity
msgid "Simulate fluids with high viscosity using a special solver"
msgstr "Simulera vätskor med hög viskositet med en särskild lösare"
