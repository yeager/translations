#. :src: bpy.types.Text
msgid "Text data-block referencing an external or packed text file"
msgstr "Textdatablock som refererar till en extern eller packad textfil"

#. :src: bpy.types.Text.current_character
msgid "Current Character"
msgstr "Aktuellt tecken"

#. :src: bpy.types.Text.current_character
msgid ""
"Index of current character in current line, and also start index of "
"character in selection if one exists"
msgstr ""
"Index för aktuellt tecken på aktuell rad, och även startindex för tecken i "
"urvalet om ett sådant finns"

#. :src: bpy.types.Text.current_line
msgid "Current Line"
msgstr "Aktuell rad"

#. :src: bpy.types.Text.current_line
msgid "Current line, and start line of selection if one exists"
msgstr "Aktuell rad och urvalets startrad om en sådan finns"

#. :src: bpy.types.Text.current_line_index
msgid "Current Line Index"
msgstr "Index för aktuell rad"

#. :src: bpy.types.Text.current_line_index
msgid "Index of current TextLine in TextLine collection"
msgstr "Index för aktuell TextLine i samlingen av TextLine-objekt"

#. :src: bpy.types.Text.filepath
msgid "Filename of the text file"
msgstr "Filnamn för textfilen"

#. :src: bpy.types.Text.select_end_character
msgid "Selection End Character"
msgstr "Urvalets sluttecken"

#. :src: bpy.types.Text.select_end_character
msgid "Index of character after end of selection in the selection end line"
msgstr "Index för tecknet efter urvalets slut på urvalets slutrad"

#. :src: bpy.types.Text.select_end_line
msgid "Selection End Line"
msgstr "Urvalets slutrad"

#. :src: bpy.types.Text.select_end_line
msgid "End line of selection"
msgstr "Urvalets slutrad"

#. :src: bpy.types.Text.select_end_line_index
msgid "Select End Line Index"
msgstr "Index för urvalets slutrad"

#. :src: bpy.types.Text.select_end_line_index
msgid "Index of last TextLine in selection"
msgstr "Index för den sista TextLine i urvalet"

#. :src: bpy.types.Text.use_module
msgid "Register"
msgstr "Registrera"

#. :src: bpy.types.Text.use_module
msgid "Run this text as a Python script on loading"
msgstr "Kör denna text som ett Python-skript vid inläsning"
