#. :src: bpy.types.Sculpt.detail_type_method:'RELATIVE'
msgid "Mesh detail is relative to the brush size and detail size"
msgstr "Meshdetaljer är relativa till borststorlek och detaljstorlek"

#. :src: bpy.types.Sculpt.detail_type_method:'CONSTANT'
msgid "Mesh detail is constant in world space according to detail size"
msgstr "Meshdetaljer är konstanta i världsrymden enligt detaljstorleken"

#. :src: bpy.types.Sculpt.detail_type_method:'BRUSH'
msgid "Mesh detail is relative to brush size"
msgstr "Meshdetaljer är relativa till penselstorleken"

#. :src: bpy.types.Sculpt.detail_type_method:'MANUAL'
msgid "Mesh detail does not change on each stroke, only when using Flood Fill"
msgstr ""
"Meshdetaljerna ändras inte vid varje drag, endast när Flood Fill används"

