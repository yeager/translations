#: ../../manual/editors/preferences/interface.rst:265
msgid "Date Format"
msgstr "Datumformat"

#: ../../manual/editors/preferences/interface.rst:266
msgid "Format used to display dates."
msgstr "Format som används för att visa datum."

#: ../../manual/editors/preferences/interface.rst:268
msgid "Uses the default date format for the selected language."
msgstr "Använder standarddatumformatet för det valda språket."

#: ../../manual/editors/preferences/interface.rst
msgid "dd/mm/yyyy"
msgstr "dd/mm/yyyy"

#: ../../manual/editors/preferences/interface.rst:269
msgid "Displays dates as day/month/year, for example ``27/02/2019``."
msgstr "Visar datum som dag/månad/år, till exempel ``27/02/2019``."

#: ../../manual/editors/preferences/interface.rst
msgid "dd.mm.yyyy"
msgstr "dd.mm.yyyy"

#: ../../manual/editors/preferences/interface.rst:270
msgid "Displays dates as day.month.year, for example ``27.02.2019``."
msgstr "Visar datum som dag.månad.år, till exempel ``27.02.2019``."

#: ../../manual/editors/preferences/interface.rst
msgid "dd-mm-yyyy"
msgstr "dd-mm-yyyy"

#: ../../manual/editors/preferences/interface.rst:271
msgid "Displays dates as day-month-year, for example ``27-02-2019``."
msgstr "Visar datum som dag-månad-år, till exempel ``27-02-2019``."

#: ../../manual/editors/preferences/interface.rst
msgid "mm/dd/yyyy"
msgstr "mm/dd/yyyy"

#: ../../manual/editors/preferences/interface.rst:272
msgid "Displays dates as month/day/year, for example ``02/27/2019``."
msgstr "Visar datum som månad/dag/år, till exempel ``02/27/2019``."

#: ../../manual/editors/preferences/interface.rst
msgid "yyyy/mm/dd"
msgstr "yyyy/mm/dd"

#: ../../manual/editors/preferences/interface.rst:273
msgid "Displays dates as year/month/day, for example ``2019/02/27``."
msgstr "Visar datum som år/månad/dag, till exempel ``2019/02/27``."

#: ../../manual/editors/preferences/interface.rst
msgid "yyyy.mm.dd"
msgstr "yyyy.mm.dd"

#: ../../manual/editors/preferences/interface.rst:274
msgid "Displays dates as year.month.day, for example ``2019.02.27``."
msgstr "Visar datum som år.månad.dag, till exempel ``2019.02.27``."

#: ../../manual/editors/preferences/interface.rst
msgid "yyyy-mm-dd"
msgstr "yyyy-mm-dd"

#: ../../manual/editors/preferences/interface.rst:275
msgid "Displays dates as year-month-day, for example ``2019-02-27``."
msgstr "Visar datum som år-månad-dag, till exempel ``2019-02-27``."

#: ../../manual/editors/preferences/interface.rst:279
msgid "Time Format"
msgstr "Tidsformat"

#: ../../manual/editors/preferences/interface.rst:280
msgid "Format used to display times."
msgstr "Format som används för att visa tider."

#: ../../manual/editors/preferences/interface.rst
msgid "24-Hour (23:59)"
msgstr "24-timmarsformat (23:59)"

#: ../../manual/editors/preferences/interface.rst:282
msgid "Displays times using a 24-hour clock, for example ``23:59``."
msgstr "Visar tider med 24-timmarsformat, till exempel ``23:59``."

#: ../../manual/editors/preferences/interface.rst
msgid "12-Hour (11:59 PM)"
msgstr "12-timmarsformat (11:59 PM)"

#: ../../manual/editors/preferences/interface.rst:283
msgid "Displays times using a 12-hour clock, for example ``11:59 PM``."
msgstr "Visar tider med 12-timmarsformat, till exempel ``11:59 PM``."
