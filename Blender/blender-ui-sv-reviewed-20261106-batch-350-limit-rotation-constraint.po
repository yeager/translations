#. :src: bpy.types.LimitRotationConstraint
msgid "Limit Rotation Constraint"
msgstr "Rotationsbegränsning"

#. :src: bpy.types.LimitRotationConstraint
msgid "Limit the rotation of the constrained object"
msgstr "Begränsa rotationen av det begränsade objektet"

#. :src: bpy.types.LimitRotationConstraint.max_x
msgid "Upper X angle bound"
msgstr "Övre X-vinkelgräns"

#. :src: bpy.types.LimitRotationConstraint.max_y
msgid "Upper Y angle bound"
msgstr "Övre Y-vinkelgräns"

#. :src: bpy.types.LimitRotationConstraint.max_z
msgid "Upper Z angle bound"
msgstr "Övre Z-vinkelgräns"

#. :src: bpy.types.LimitRotationConstraint.min_x
msgid "Lower X angle bound"
msgstr "Nedre X-vinkelgräns"

#. :src: bpy.types.LimitRotationConstraint.min_y
msgid "Lower Y angle bound"
msgstr "Nedre Y-vinkelgräns"

#. :src: bpy.types.LimitRotationConstraint.min_z
msgid "Lower Z angle bound"
msgstr "Nedre Z-vinkelgräns"

#. :src: bpy.types.LimitRotationConstraint.use_legacy_behavior
msgid "Legacy Behavior"
msgstr "Äldre beteende"

#. :src: bpy.types.LimitRotationConstraint.use_legacy_behavior
msgid ""
"Use the old semi-broken behavior that doesn't understand that rotations loop "
"around"
msgstr ""
"Använd det gamla, delvis trasiga beteendet som inte hanterar att rotationer "
"går runt i varv"

#. :src: bpy.types.LimitRotationConstraint.use_limit_x
#: scripts/startup/bl_ui/properties_constraint.py:212
#: scripts/startup/bl_ui/properties_data_bone.py:472
msgid "Limit X"
msgstr "Begränsa X"

#. :src: bpy.types.LimitRotationConstraint.use_limit_y
#: scripts/startup/bl_ui/properties_data_bone.py:483
msgid "Limit Y"
msgstr "Begränsa Y"

#. :src: bpy.types.LimitRotationConstraint.use_limit_z
#: scripts/startup/bl_ui/properties_data_bone.py:494
msgid "Limit Z"
msgstr "Begränsa Z"
