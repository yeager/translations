#. :src: bpy.types.FluidDomainSettings.cache_frame_offset
msgid ""
"Frame offset that is used when loading the simulation from the cache. It is "
"not considered when baking the simulation, only when loading it."
msgstr ""
"Bildruteförskjutning som används när simuleringen läses in från cachen. Den "
"beaktas inte när simuleringen bakas, utan bara när den läses in."

#. :src: bpy.types.FluidDomainSettings.cache_resumable
msgid "Resumable"
msgstr "Återupptagbar"

#. :src: bpy.types.FluidDomainSettings.cache_type:'REPLAY'
msgid "Use the timeline to bake the scene"
msgstr "Använd tidslinjen för att baka scenen"

#. :src: bpy.types.FluidDomainSettings.cfl_condition
msgid ""
"Maximal velocity per cell (greater CFL numbers will minimize the number of "
"simulation steps and the computation time.)"
msgstr ""
"Maximal hastighet per cell (högre CFL-tal minskar antalet simuleringssteg "
"och beräkningstiden)"

