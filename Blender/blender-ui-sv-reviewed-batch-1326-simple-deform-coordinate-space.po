#. :src: bpy.types.SimpleDeformModifier.deform_method:'TWIST'
msgid "Rotate around the Z axis of the modifier space"
msgstr "Rotera runt Z-axeln i modifierarens koordinatrymd"

#. :src: bpy.types.SimpleDeformModifier.deform_method:'BEND'
msgid "Bend the mesh over the Z axis of the modifier space"
msgstr "Böj meshen över Z-axeln i modifierarens koordinatrymd"

#. :src: bpy.types.SimpleDeformModifier.deform_method:'TAPER'
msgid "Linearly scale along Z axis of the modifier space"
msgstr "Skala linjärt längs Z-axeln i modifierarens koordinatrymd"

#. :src: bpy.types.SimpleDeformModifier.deform_method:'STRETCH'
msgid "Stretch the object along the Z axis of the modifier space"
msgstr "Sträck objektet längs Z-axeln i modifierarens koordinatrymd"
