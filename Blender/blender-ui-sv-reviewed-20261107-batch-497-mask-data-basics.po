#. :src: bpy.types.Mask
msgid "Mask data-block defining mask for compositing"
msgstr "Maskdatablock som definierar en mask för bildkomposition"

#. :src: bpy.types.Mask.active_layer_index
msgid "Active Shape Index"
msgstr "Aktivt formindex"

#. :src: bpy.types.Mask.active_layer_index
msgid "Index of active layer in list of all mask's layers"
msgstr "Index för det aktiva lagret i listan över alla maskens lager"

#. :src: bpy.types.Mask.frame_end
msgid "Final frame of the mask (used for sequencer)"
msgstr "Maskens sista bildruta (används för sekvensredigeraren)"

#. :src: bpy.types.Mask.frame_start
msgid "First frame of the mask (used for sequencer)"
msgstr "Maskens första bildruta (används för sekvensredigeraren)"

#. :src: bpy.types.Mask.layers
msgid "Collection of layers which defines this mask"
msgstr "Samling av lager som definierar denna mask"
