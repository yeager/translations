#. :src: bpy.types.FModifierGenerator
msgid "Deterministically generate values for the modified F-Curve"
msgstr "Generera värden för den modifierade F-kurvan deterministiskt"

#. :src: bpy.types.FModifierGenerator.poly_order
msgid "Polynomial Order"
msgstr "Polynomgrad"

#. :src: bpy.types.FModifierNoise
msgid "Noise F-Modifier"
msgstr "Brusmodifierare för F-kurvor"

#. :src: bpy.types.FModifierNoise
msgid "Give randomness to the modified F-Curve"
msgstr "Lägg till slumpmässighet i den modifierade F-kurvan"

#. :src: bpy.types.FModifierNoise.lacunarity
msgid ""
"Gap between successive frequencies. Depth needs to be greater than 0 for "
"this to have an effect"
msgstr ""
"Avstånd mellan på varandra följande frekvenser. Djupet måste vara större än "
"0 för att detta ska ha någon effekt"

#. :src: bpy.types.FModifierNoise.offset
msgid "Time offset for the noise effect"
msgstr "Tidsförskjutning för bruseffekten"

#. :src: bpy.types.FModifierNoise.roughness
msgid ""
"Amount of high frequency detail. Depth needs to be greater than 0 for this "
"to have an effect"
msgstr ""
"Mängd högfrekventa detaljer. Djupet måste vara större än 0 för att detta ska "
"ha någon effekt"

#. :src: bpy.types.FModifierStepped
msgid "Stepped Interpolation F-Modifier"
msgstr "Modifierare för stegad interpolation"

#. :src: bpy.types.FModifierEnvelopeControlPoint.frame
msgid "Frame this control-point occurs on"
msgstr "Bildruta där den här kontrollpunkten ligger"

#. :src: bpy.types.FieldSettings.apply_to_rotation
msgid "Affect particle's dynamic rotation"
msgstr "Påverka partikelns dynamiska rotation"

#. :src: bpy.types.FieldSettings.distance_min
msgid "Minimum distance for the field's falloff"
msgstr "Minsta avstånd för fältets avtagande"

#. :src: bpy.types.FieldSettings.use_object_coords
msgid "Use object/global coordinates for texture"
msgstr "Använd objektets eller globala koordinater för texturen"

#. :src: bpy.types.FieldSettings.use_smoke_density
msgid "Adjust force strength based on smoke density"
msgstr "Justera kraftfältets styrka utifrån röktätheten"

#. :src: bpy.types.FieldSettings.z_direction
msgid "Z Direction"
msgstr "Z-riktning"

#. :src: bpy.types.FieldSettings.z_direction
msgid "Effect in full or only positive/negative Z direction"
msgstr "Full effekt eller endast i positiv/negativ Z-riktning"
