#. :src: bpy.types.TextCurve.body
msgid "Body Text"
msgstr "Brödtext"

#. :src: bpy.types.TextCurve.body
msgid "Content of this text object"
msgstr "Innehållet i detta textobjekt"

#. :src: bpy.types.TextCurve.body_format
msgid "Character Info"
msgstr "Teckeninformation"

#. :src: bpy.types.TextCurve.body_format
msgid "Stores the style of each character"
msgstr "Lagrar stilen för varje tecken"

#. :src: bpy.types.TextCurve.edit_format
msgid "Edit Format"
msgstr "Redigeringsformat"

#. :src: bpy.types.TextCurve.edit_format
msgid "Editing settings character formatting"
msgstr "Inställningar för redigering av teckenformatering"

#. :src: bpy.types.TextCurve.family
msgid "Object Font"
msgstr "Objektteckensnitt"

#. :src: bpy.types.TextCurve.family
msgid ""
"Use objects as font characters (give font objects a common name followed by "
"the character they represent, eg. 'family-a', 'family-b', etc, set this "
"setting to 'family-', and turn on Vertex Instancing)"
msgstr ""
"Använd objekt som teckensnittstecken (ge teckensnittsobjekt ett gemensamt "
"namn följt av det tecken de representerar, t.ex. \"family-a\", \"family-b\" "
"etc., sätt denna inställning till \"family-\" och aktivera Vertex Instancing)"

#. :src: bpy.types.TextCurve.follow_curve
msgid "Text on Curve"
msgstr "Text på kurva"

#. :src: bpy.types.TextCurve.follow_curve
msgid "Curve deforming text object"
msgstr "Kurva som deformerar textobjektet"

#. :src: bpy.types.TextCurve.font_bold
msgid "Font Bold"
msgstr "Fetstilt typsnitt"

#. :src: bpy.types.TextCurve.font_bold_italic
msgid "Font Bold Italic"
msgstr "Fetkursivt typsnitt"

#. :src: bpy.types.TextCurve.font_italic
msgid "Font Italic"
msgstr "Kursivt typsnitt"

#. :src: bpy.types.TextCurve.has_selection
#. :src: bpy.types.ThemeWidgetColors.text_sel
msgid "Text Selected"
msgstr "Vald text"

#. :src: bpy.types.TextCurve.has_selection
msgid "Whether there is any text selected"
msgstr "Om det finns någon text markerad"

#. :src: bpy.types.TextCurve.is_select_bold
msgid "Selected Bold"
msgstr "Markerad fetstil"

#. :src: bpy.types.TextCurve.is_select_bold
msgid "Whether the selected text is bold"
msgstr "Om den markerade texten är fet"

#. :src: bpy.types.TextCurve.is_select_italic
msgid "Selected Italic"
msgstr "Vald kursiv"

#. :src: bpy.types.TextCurve.is_select_italic
msgid "Whether the selected text is italics"
msgstr "Om den markerade texten är kursiv"

#. :src: bpy.types.TextCurve.is_select_smallcaps
msgid "Selected Small Caps"
msgstr "Markerade kapitäler"

#. :src: bpy.types.TextCurve.is_select_smallcaps
msgid "Whether the selected text is small caps"
msgstr "Om den markerade texten är i kapitäler"

#. :src: bpy.types.TextCurve.is_select_underline
msgid "Selected Underline"
msgstr "Vald understrykning"

#. :src: bpy.types.TextCurve.is_select_underline
msgid "Whether the selected text is underlined"
msgstr "Om den markerade texten är understruken"
