msgid "%s: Error creating deform group data for mesh %s"
msgstr "%s: Fel vid skapande av deformationsgruppdata för mesh %s"

msgid "'Shrink/Fatten' meshes is only supported in edit mode"
msgstr "”Krymp/förstora” av mesh stöds endast i redigeringsläge"

#. :src: bpy.types.ImagePaint.missing_uvs
msgid "A UV layer is missing on the mesh"
msgstr "Ett UV-lager saknas i meshen"

msgid "A cube mesh enclosing the input geometry"
msgstr "En kubmesh som omsluter indatageometrin"

msgid "Active mesh does not have shape keys"
msgstr "Den aktiva meshen har inga formnycklar"

msgid "Active object is not a selected mesh"
msgstr "Aktivt objekt är inte ett markerat meshobjekt"

msgid "Add cone to mesh interactively"
msgstr "Lägg interaktivt till en kon i meshen"

#. :src: bpy.types.PAINT_OT_add_simple_uvs
msgid "Add cube map UVs on mesh"
msgstr "Lägg till UV:er för kubavbildning på meshen"

msgid "Add cube to mesh interactively"
msgstr "Lägg interaktivt till en kub i meshen"

msgid "Add cylinder to mesh interactively"
msgstr "Lägg interaktivt till en cylinder i meshen"

msgid "Add sphere to mesh interactively"
msgstr "Lägg interaktivt till en sfär i meshen"

msgid "An edit-mesh with vertex or edge selection mode is required"
msgstr "En mesh i redigeringsläge med markerade hörnpunkter eller kanter krävs"
