#. :src: bpy.types.MESH_OT_customdata_face_sets_clear
msgid "Clear sculpt face set data from the mesh"
msgstr "Rensa data för skulpteringsytuppsättning från meshen"

#. :src: bpy.types.MESH_OT_customdata_mask_clear
msgid "Clear vertex sculpt masking data from the mesh"
msgstr "Rensa data för skulpteringsmaskering av hörnpunkter från meshen"

#. :src: bpy.types.MESH_OT_delete.type
msgid "Method used for deleting mesh data"
msgstr "Metod som används för att radera meshdata"

#. :src: bpy.types.MESH_OT_duplicate_move
msgid "Duplicate mesh and move"
msgstr "Duplicera mesh och flytta"

#. :src: bpy.types.MESH_OT_loopcut_slide
msgid "Cut mesh loop and slide it"
msgstr "Skär meshslingan och skjut den"

#. :src: bpy.types.MESH_OT_loopcut_slide.TRANSFORM_OT_edge_slide
#. :src: bpy.types.MESH_OT_offset_edge_loops_slide.TRANSFORM_OT_edge_slide
#. :src: bpy.types.TRANSFORM_OT_edge_slide
msgid "Slide an edge loop along a mesh"
msgstr "Skjut en kantslinga längs meshen"

#. :src: bpy.types.MESH_OT_normals_make_consistent
msgid "Make face and vertex normals point either outside or inside the mesh"
msgstr ""
"Gör så att yt- och hörnpunktsnormaler pekar antingen utåt eller inåt i meshen"

#. :src: bpy.types.MESH_OT_primitive_circle_add
msgid "Construct a circle mesh"
msgstr "Konstruera ett cirkelmesh"

#. :src: bpy.types.MESH_OT_primitive_cone_add
msgid "Construct a conic mesh"
msgstr "Konstruera ett konmesh"

#. :src: bpy.types.MESH_OT_primitive_cube_add
msgid "Construct a cube mesh that consists of six square faces"
msgstr "Konstruera ett kubmesh som består av sex kvadratiska ytor"

#. :src: bpy.types.MESH_OT_primitive_cube_add_gizmo
msgid "Construct a cube mesh"
msgstr "Konstruera ett kubmesh"

#. :src: bpy.types.MESH_OT_primitive_cylinder_add
msgid "Construct a cylinder mesh"
msgstr "Konstruera ett cylindermesh"

#. :src: bpy.types.MESH_OT_primitive_grid_add
msgid "Construct a subdivided plane mesh"
msgstr "Konstruera ett underindelat meshplan"

#. :src: bpy.types.MESH_OT_primitive_ico_sphere_add
msgid "Construct a spherical mesh that consists of equally sized triangles"
msgstr "Konstruera ett sfäriskt mesh som består av trianglar av samma storlek"

#. :src: bpy.types.MESH_OT_primitive_monkey_add
msgid "Construct a Suzanne mesh"
msgstr "Konstruera ett Suzanne-mesh"

#. :src: bpy.types.MESH_OT_primitive_plane_add
msgid "Construct a filled planar mesh with 4 vertices"
msgstr "Konstruera ett fyllt meshplan med fyra hörnpunkter"

#. :src: bpy.types.MESH_OT_primitive_quad_sphere_add
msgid ""
"Construct a spherical mesh from a subdivided cube, consisting entirely of "
"four-sided faces"
msgstr ""
"Skapa ett sfäriskt mesh från en underindelad kub som helt består av "
"fyrsidiga ytor"

#. :src: bpy.types.MESH_OT_primitive_uv_sphere_add
msgid ""
"Construct a spherical mesh with quad faces, except for triangle faces at the "
"top and bottom"
msgstr ""
"Konstruera ett sfäriskt mesh med fyrkantiga ytor, förutom triangulära ytor "
"längst upp och längst ner"

#. :src: bpy.types.MESH_OT_reorder_vertices_spatial
msgid ""
"Reorder mesh faces and vertices based on their spatial position for better "
"BVH building and sculpting performance."
msgstr ""
"Ordna om meshytor och hörnpunkter utifrån deras rumsliga position för bättre "
"BVH-byggande och skulpteringsprestanda."

#. :src: bpy.types.MESH_OT_select_axis
msgid "Select all data in the mesh on a single axis"
msgstr "Markera alla data i meshen på en enda axel"

#. :src: bpy.types.MESH_OT_select_mirror
msgid "Select mesh items at mirrored locations"
msgstr "Markera meshelement på speglade platser"

#. :src: bpy.types.MESH_OT_separate
msgid "Separate selected geometry into a new mesh"
msgstr "Separera vald geometri till en ny mesh"

#. :src: bpy.types.MESH_OT_vertices_smooth.repeat
msgid "Number of times to smooth the mesh"
msgstr "Antal gånger meshen ska jämnas ut"

#. :src: bpy.types.MESH_OT_vertices_smooth_laplacian.repeat
msgid "Number of iterations to smooth the mesh"
msgstr "Antal iterationer för att jämna ut meshen"
