"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#. :src: bpy.types.BevelModifier.vmesh_method
msgid "The method to use to create the mesh at intersections"
msgstr "Metoden som ska användas för att skapa meshen vid korsningar"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'NEAREST_SURFACEPOINT'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'NEAREST_SURFACEPOINT'
msgid "Shrink the mesh to the nearest target surface"
msgstr "Anpassa meshen till närmaste målyta"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'PROJECT'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'PROJECT'
msgid "Shrink the mesh to the nearest target surface along a given axis"
msgstr "Anpassa meshen till närmaste målyta längs en given axel"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'NEAREST_VERTEX'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'NEAREST_VERTEX'
msgid "Shrink the mesh to the nearest target vertex"
msgstr "Anpassa meshen till närmaste målhörnpunkt"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'TARGET_PROJECT'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'TARGET_PROJECT'
msgid ""
"Shrink the mesh to the nearest target surface along the interpolated vertex "
"normals of the target"
msgstr ""
"Anpassa meshen till närmaste målyta längs målets interpolerade "
"hörnpunktsnormaler"

#. :src: bpy.types.MaskModifier
msgid "Mask modifier to hide parts of the mesh"
msgstr "Maskmodifierare för att dölja delar av meshen"

#. :src: bpy.types.MultiresModifier.use_custom_normals
#. :src: bpy.types.SubsurfModifier.use_custom_normals
msgid "Interpolates existing custom normals to resulting mesh"
msgstr ""
"Interpolerar befintliga anpassade normaler till den resulterande meshen"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'NON_MANIFOLD'
msgid ""
"Output a manifold mesh even if the base mesh is non-manifold, where edges "
"have 3 or more connecting faces. This method is slower."
msgstr ""
"Skapa en manifold-mesh även om basmeshen inte är manifold, där kanterna har "
"tre eller fler anslutande ytor. Denna metod är långsammare."

#. :src: bpy.types.MeshToVolumeModifier.interior_band_width
msgid "Width of the gradient inside of the mesh"
msgstr "Bredden på gradienten inuti meshen"

#. :src: bpy.types.MirrorModifier.use_bisect_axis
msgid "Cuts the mesh across the mirror plane"
msgstr "Skär meshen tvärs över spegelplanet"

#. :src: bpy.types.MultiresModifier.use_sculpt_base_mesh
msgid "Sculpt Base Mesh"
msgstr "Skulptera basmesh"

#. :src: bpy.types.MultiresModifier.use_sculpt_base_mesh
msgid ""
"Make Sculpt Mode tools deform the base mesh while previewing the "
"displacement of higher subdivision levels"
msgstr ""
"Låt verktygen i skulpteringsläget deformera basmeshen medan förskjutningen "
"av högre underindelningsnivåer förhandsgranskas"

#. :src: bpy.types.ParticleInstanceModifier.space
msgid "Space to use for copying mesh data"
msgstr "Koordinatutrymme som används för kopiering av meshdata"

#. :src: bpy.types.SurfaceDeformModifier.is_bound
msgid "Whether geometry has been bound to target mesh"
msgstr "Om geometrin har kopplats till målmeshen"

#. :src: bpy.types.VolumeToMeshModifier.grid_name
msgid "Grid in the volume object that is converted to a mesh"
msgstr "Rutnätet i volymobjektet som konverteras till en mesh"

#. :src: bpy.types.VolumeToMeshModifier.threshold
msgid "Voxels with a larger value are inside the generated mesh"
msgstr "Voxlar med ett högre värde ligger inuti den genererade meshen"

#. :src: bpy.types.SubsurfModifier.adaptive_space
msgid "How to adaptively subdivide the mesh"
msgstr "Hur meshen ska delas upp adaptivt"

#. :src: bpy.types.SubsurfModifier.use_adaptive_subdivision
msgid "Adaptively subdivide mesh based on camera distance"
msgstr "Dela upp meshen adaptivt utifrån kameraavståndet"

#. :src: bpy.types.BooleanModifier.collection
msgid "Use mesh objects in this collection for Boolean operation"
msgstr "Använd meshobjekt i denna samling för boolesk operation"

#. :src: bpy.types.BooleanModifier.operand_type:'OBJECT'
msgid "Use a mesh object as the operand for the Boolean operation"
msgstr "Använd ett meshobjekt som operand för den booleska operationen"

#. :src: bpy.types.BooleanModifier.operand_type:'COLLECTION'
msgid ""
"Use a collection of mesh objects as the operand for the Boolean operation"
msgstr "Använd en samling meshobjekt som operand för den booleska operationen"

#. :src: bpy.types.CorrectiveSmoothModifier.rest_source:'ORCO'
msgid "Use base mesh vertex coordinates as the rest position"
msgstr "Använd basmeshens hörnpunktskoordinater som viloposition"

#. :src: bpy.types.DisplaceModifier.direction:'RGB_TO_XYZ'
msgid "Use the texture's RGB values to displace the mesh in the XYZ direction"
msgstr "Använd texturens RGB-värden för att förskjuta meshen i XYZ-riktningen"

#. :src: bpy.types.RemeshModifier
msgid ""
"Generate a new surface with regular topology that follows the shape of the "
"input mesh"
msgstr ""
"Skapa en ny yta med regelbunden topologi som följer formen på indatameshen"

#. :src: bpy.types.RemeshModifier.mode:'SHARP'
msgid ""
"Output a surface that reproduces sharp edges and corners from the input mesh"
msgstr "Skapa en yta som återger skarpa kanter och hörn från indatameshen"

#. :src: bpy.types.RemeshModifier.mode:'VOXEL'
msgid "Output a mesh corresponding to the volume of the original mesh"
msgstr "Skapa en mesh som motsvarar volymen hos den ursprungliga meshen"

#. :src: bpy.types.RemeshModifier.sharpness
msgid ""
"Tolerance for outliers; lower values filter noise while higher values will "
"reproduce edges closer to the input"
msgstr ""
"Tolerans för avvikande värden; lägre värden filtrerar bort brus medan högre "
"värden återger kanter som ligger närmare indatameshen"

#. :src: bpy.types.ActionSlot.target_id_type:'MESH'
#. :src: bpy.types.AssetRepresentation.id_type:'MESH'
#. :src: bpy.types.BlendImportContextItem.id_type:'MESH'
#. :src: bpy.types.DriverTarget.id_type:'MESH'
msgctxt "ID"
msgid "Mesh"
msgstr "Mesh"

#. :src: bpy.types.Mesh.has_custom_normals
msgid "True if there is custom normal data for this mesh"
msgstr "Sant om meshen har anpassade normaldata"

#. :src: bpy.types.MeshSkinVertexLayer
msgid "Mesh Skin Vertex Layer"
msgstr "Meshens Skin-hörnpunktslager"

#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_SEQUENCE_CACHE'
msgid "Deform the mesh or curve using an external mesh cache in Alembic format"
msgstr ""
"Deformera meshen eller kurvan med hjälp av en extern meshcache i Alembic-"
"format"

#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BEVEL'
msgid ""
"Generate sloped corners by adding geometry to the mesh's edges or vertices"
msgstr ""
"Skapa avfasade hörn genom att lägga till geometri till meshens kanter eller "
"hörnpunkter"

#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BUILD'
msgid ""
"Cause the faces of the mesh object to appear or disappear one after the "
"other over time"
msgstr ""
"Få ytorna på meshobjektet att visas eller försvinna en efter en över tid"

#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MULTIRES'
msgid ""
"Subdivide the mesh in a way that allows editing the higher subdivision levels"
msgstr ""
"Dela upp meshen på ett sätt som gör det möjligt att redigera de högre "
"indelningsnivåerna"

#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SCREW'
msgid "Lathe around an axis, treating the input mesh as a profile"
msgstr "Svarva runt en axel och behandla indatameshen som en profil"

#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SMOOTH'
msgid "Smooth the mesh by flattening the angles between adjacent faces"
msgstr ""
"Jämna ut meshen genom att platta till vinklarna mellan intilliggande ytor"

#. :src: bpy.types.OBJECT_OT_modifier_add.type:'CORRECTIVE_SMOOTH'
msgid "Smooth the mesh while still preserving the volume"
msgstr "Jämna ut meshen samtidigt som volymen bevaras"

#. :src: bpy.types.SEQUENCER_OT_strip_modifier_add_node_group.asset_library_type:'ALL'
msgid "Show assets from all of the listed asset libraries"
msgstr "Visa resurser från alla listade resursbibliotek"

#. :src: bpy.types.FileAssetSelectParams.asset_library_reference:'ALL'
msgid "Show assets from the asset libraries configured in the Preferences"
msgstr ""
"Visa resurser från de resursbibliotek som har konfigurerats i Inställningar"

#. :src: bpy.types.AssetShelf
msgid "Regions for quick access to assets"
msgstr "Områden för snabb åtkomst till resurser"

#. :src: bpy.types.AssetShelf.asset_library_reference
msgid "Choose the asset library to display assets from"
msgstr "Välj ett resursbibliotek att visa resurser från"

#. :src: bpy.types.AssetShelf.bl_default_preview_size
msgid "Default size of the asset preview thumbnails in pixels"
msgstr "Standardstorlek för resursernas förhandsvisningsminiatyrer i pixlar"

#. :src: bpy.types.AssetShelf.bl_options:'NO_ASSET_DRAG'
msgid "No Asset Dragging"
msgstr "Ingen resursdragning"

#. :src: bpy.types.AssetShelf.bl_options:'NO_ASSET_DRAG'
msgid ""
"Disable the default asset dragging on drag events. Useful for implementing "
"custom dragging via custom key-map items."
msgstr ""
"Inaktivera standarddragning av resurser vid draghändelser. Användbart för "
"att implementera anpassad dragning via anpassade tangentmappningsposter."

#. :src: bpy.types.AssetShelf.bl_options:'DEFAULT_VISIBLE'
msgid ""
"Unhide the asset shelf when it's available for the first time, otherwise it "
"will be hidden"
msgstr ""
"Visa resurshyllan när den blir tillgänglig första gången, annars är den dold"

#. :src: bpy.types.AssetShelf.search_filter
msgid "Filter assets by name"
msgstr "Filtrera resurser efter namn"

#. :src: bpy.types.AssetShelf.show_names
msgid ""
"Show the asset name together with the preview. Otherwise only the preview "
"will be visible."
msgstr ""
"Visa resursens namn tillsammans med förhandsvisningen. Annars visas bara "
"förhandsvisningen."

#. :src: bpy.types.PreferencesView.asset_access
msgid "Asset Access"
msgstr "Resursåtkomst"

#. :src: bpy.types.FileAssetSelectParams.asset_access
#. :src: bpy.types.PreferencesView.asset_access
msgid "Choose the visibility of online and offline assets"
msgstr "Välj synlighet för resurser online och offline"

#. :src: bpy.types.FileAssetSelectParams.asset_access:'ALL'
#. :src: bpy.types.PreferencesView.asset_access:'ALL'
msgid ""
"Show assets that are both hosted online (need downloading) and available on "
"disk already"
msgstr ""
"Visa resurser både online, som måste hämtas, och som redan finns på disken"

#. :src: bpy.types.FileAssetSelectParams.asset_access:'ONLY_ONLINE'
#. :src: bpy.types.PreferencesView.asset_access:'ONLY_ONLINE'
msgid "Show only assets that need downloading (requires internet access)"
msgstr "Visa endast resurser som måste hämtas (kräver internetanslutning)"

#. :src: bpy.types.FileAssetSelectParams.asset_access:'ONLY_OFFLINE'
#. :src: bpy.types.PreferencesView.asset_access:'ONLY_OFFLINE'
msgid ""
"Show only assets that are available on disk already (no internet access "
"needed)"
msgstr ""
"Visa endast resurser som redan finns på disken (ingen internetanslutning "
"behövs)"

#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility
msgid "Which assets to show based on catalog filter"
msgstr "Välj vilka resurser som visas utifrån katalogfiltret"

#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility:'ALL'
msgid "Show assets from all catalogs"
msgstr "Visa resurser från alla kataloger"

#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility:'CATALOG'
msgid "Show assets from the active catalog only"
msgstr "Visa endast resurser från den aktiva katalogen"

#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility:'UNASSIGNED'
msgid "Show assets not assigned to any catalog"
msgstr "Visa resurser som inte är tilldelade någon katalog"

#. :src: bpy.types.FileAssetSelectParams.import_method:'FOLLOW_PREFS'
msgid "Follow Asset or Preferences"
msgstr "Följ resurs eller inställningar"

#. :src: bpy.types.CompositorNodeOutputFile.use_file_extension
msgid ""
"Add the file format extensions to the saved file name (eg: filename + .jpg)"
msgstr ""
"Lägg till filformatstilläggen i det sparade filnamnet (t.ex. filnamn + .jpg)"

#. :src: bpy.types.RenderSettings.use_file_extension
msgid ""
"Add the file format extensions to the rendered file name (eg: filename "
"+ .jpg)"
msgstr ""
"Lägg till filformatstilläggen i det renderade filnamnet (t.ex. filnamn "
"+ .jpg)"

#. :src: bpy.types.Action.curve_frame_range
msgid "The combined frame range of all F-Curves within this action"
msgstr ""
"Det sammanlagda bildruteintervallet för alla F-kurvor i den här Actionen"

#. :src: bpy.types.Action.frame_range
msgid ""
"The intended playback frame range of this action, using the manually set "
"range if available, or the combined frame range of all F-Curves within this "
"action if not (assigning sets the manual frame range)"
msgstr ""
"Det avsedda uppspelningsbildruteintervallet för den här Actionen. Om ett "
"manuellt intervall finns används det, annars används det sammanlagda "
"intervallet för alla F-kurvor (när ett värde tilldelas ställs det manuella "
"intervallet in)"

#. :src: bpy.types.Action.is_action_layered
msgid ""
"Return whether this is a layered Action. At this point all actions are "
"layered through versioning and this function will always return true"
msgstr ""
"Returnerar om detta är en skiktad Action. För närvarande är alla Actioner "
"skiktade genom versionshantering och funktionen returnerar alltid sant"

#. :src: bpy.types.Action.is_action_legacy
msgid ""
"Return whether this is a legacy Action. Legacy Actions have no layers or "
"slots. Since Blender 4.4 actions are automatically updated to layered "
"actions. This will only return true on empty actions"
msgstr ""
"Returnerar om detta är en äldre Action. Äldre Actioner saknar lager och "
"Action-slotar. Sedan Blender 4.4 uppdateras Actioner automatiskt till "
"skiktade Actioner. Funktionen returnerar endast sant för tomma Actioner"

#. :src: bpy.types.Action.pose_markers
msgid "Markers specific to this action, for labeling poses"
msgstr "Markörer särskilt för den här Actionen, som märker ut poser"

#. :src: bpy.types.Action.use_frame_range
msgid ""
"Manually specify the intended playback frame range for the action (this "
"range is used by some tools, but does not affect animation evaluation)"
msgstr ""
"Ange det avsedda uppspelningsbildruteintervallet manuellt för Actionen "
"(intervallet används av vissa verktyg men påverkar inte "
"animeringsutvärderingen)"

#. :src: bpy.types.ANIM_OT_replace_action
msgctxt "Operator"
msgid "Replace Action"
msgstr "Ersätt Action"

#. :src: bpy.types.ANIM_OT_replace_action
msgid ""
"Swap all users of one action to another one. The normal action slot "
"assignment rules apply. This ignores the NLA and Action Constraints"
msgstr ""
"Byt alla användare av en Action till en annan. De vanliga reglerna för "
"tilldelning av Action-slotar gäller. NLA och Action-begränsningar ignoreras"

#. :src: bpy.types.ANIM_OT_replace_action.new_session_uid
msgid "Replacement Action"
msgstr "Ersättnings-Action"

#. :src: bpy.types.ANIM_OT_replace_action.new_session_uid
msgid ""
"The replacement Action's session uid to remap all selected Action's users to"
msgstr ""
"Sessions-UID för ersättnings-Actionen som alla användare av den valda "
"Actionen ska mappas om till"

#. :src: bpy.types.ANIM_OT_replace_action.old_session_uid
#. :src: bpy.types.ANIM_OT_replace_action_duplicate.old_session_uid
#. :src: bpy.types.ANIM_OT_replace_action_new.old_session_uid
msgid "Old Action"
msgstr "Gammal Action"

#. :src: bpy.types.ANIM_OT_replace_action.old_session_uid
#. :src: bpy.types.ANIM_OT_replace_action_duplicate.old_session_uid
#. :src: bpy.types.ANIM_OT_replace_action_new.old_session_uid
msgid "Old Action's session uid to replace"
msgstr "Sessions-UID för den gamla Actionen som ska ersättas"

#. :src: bpy.types.ANIM_OT_replace_action_duplicate
msgctxt "Operator"
msgid "Replace with Duplicate Action"
msgstr "Ersätt med duplicerad Action"

#. :src: bpy.types.ANIM_OT_replace_action_duplicate
msgid ""
"Duplicates the action of the active object and swaps all users of that "
"action to that duplicate"
msgstr ""
"Duplicerar det aktiva objektets Action och byter alla användare av den "
"Actionen till dubbletten"

#. :src: bpy.types.ANIM_OT_replace_action_new
msgctxt "Operator"
msgid "Replace with New Action"
msgstr "Ersätt med ny Action"

#. :src: bpy.types.ANIM_OT_replace_action_new
msgid ""
"Swap all users of one action to a new action. This ignores the NLA and "
"Action Constraints"
msgstr ""
"Byt alla användare av en Action till en ny Action. Detta ignorerar NLA och "
"Action-begränsningar"

msgid "<No Action>"
msgstr "<Ingen Action>"

#. :src: bpy.types.ActionConstraint.action_slot
#. :src: bpy.types.NlaStrip.action_slot
msgid ""
"The slot identifies which sub-set of the Action is considered to be for this "
"strip, and its name is used to find the right slot when assigning another "
"Action"
msgstr ""
"Action-slotten identifierar vilken delmängd av Actionen som hör till den här "
"remsan. Namnet används för att hitta rätt Action-slot när en annan Action "
"tilldelas"

#. :src: bpy.types.ActionConstraint.action_suitable_slots
#. :src: bpy.types.NlaStrip.action_suitable_slots
msgid "The list of action slots suitable for this NLA strip"
msgstr "Listan över Action-slotar som lämpar sig för denna NLA-remsa"

#. :src: bpy.types.ActionConstraint.last_slot_identifier
msgid ""
"The identifier of the most recently assigned action slot. The slot "
"identifies which sub-set of the Action is considered to be for this "
"constraint, and its identifier is used to find the right slot when assigning "
"an Action."
msgstr ""
"Identifieraren för den senast tilldelade Action-slotten. Action-slotten "
"anger vilken delmängd av Actionen som avses för denna begränsning, och dess "
"identifierare används för att hitta rätt Action-slot när en Action tilldelas."

#. :src: bpy.types.ActionSlot.action
msgid "Action to apply to the rig via constraints"
msgstr "Action som ska tillämpas på riggen via begränsningar"

#. :src: bpy.types.ActionSlot.action_slot_ui
msgid "Slot of the Action to use for the Action Constraints"
msgstr "Action-slot för Actionen som ska användas för Action-begränsningarna"

#. :src: bpy.types.ActionSlot.enabled
msgid "Create constraints for this action on the generated rig"
msgstr "Skapa begränsningar för denna Action på den genererade riggen"

#. :src: bpy.types.ActionSlot.frame_end
msgid "Last frame of the action's timeline"
msgstr "Sista bildrutan på Actionens tidslinje"

#. :src: bpy.types.SpaceDopeSheetEditor.mode:'ACTION'
#. :src: bpy.types.SpaceDopeSheetEditor.ui_mode:'ACTION'
msgid "Action Editor"
msgstr "Action-redigerare"

#. :src: bpy.types.SpaceDopeSheetEditor.mode:'ACTION'
#. :src: bpy.types.SpaceDopeSheetEditor.ui_mode:'ACTION'
msgid "Edit keyframes in active object's Object-level action"
msgstr "Redigera nyckelbildrutor i det aktiva objektets Action på objektnivå"

msgid "Could not assign action %s to Action Constraint %s"
msgstr "Kunde inte tilldela Actionen %s till Action-begränsningen %s"

#. :src: bpy.types.AnimData.action
msgid "Active Action for this data-block"
msgstr "Aktiv Action för detta datablock"

#. :src: bpy.types.AnimData.action_blend_type
msgid "Action Blending"
msgstr "Action-blandning"

#. :src: bpy.types.AnimData.action_blend_type
msgid ""
"Method used for combining Active Action's result with result of NLA stack"
msgstr ""
"Metod för att kombinera den aktiva Actionens resultat med resultatet från "
"NLA-stapeln"

#. :src: bpy.types.AnimData.action_extrapolation
msgid "Action Extrapolation"
msgstr "Action-extrapolering"

#. :src: bpy.types.AnimData.action_extrapolation
msgid ""
"Action to take for gaps past the Active Action's range (when evaluating with "
"NLA)"
msgstr ""
"Hantering av luckor utanför den aktiva Actionens räckvidd (vid utvärdering "
"med NLA)"

#. :src: bpy.types.AnimData.action_influence
msgid "Action Influence"
msgstr "Actionens påverkan"

#. :src: bpy.types.AnimData.action_influence
msgid "Amount the Active Action contributes to the result of the NLA stack"
msgstr ""
"I vilken grad den aktiva Actionen bidrar till resultatet av NLA-stapeln"

#. :src: bpy.types.AnimData.action_slot
#. :src: bpy.types.ActionConstraint.action_slot
#. :src: bpy.types.NlaStrip.action_slot
#. :src: bpy.types.ActionSlot.action_slot_ui
msgid "Action Slot"
msgstr "Action-slot"

#. :src: bpy.types.AnimData.action_slot
msgid ""
"The slot identifies which sub-set of the Action is considered to be for this "
"data-block, and its name is used to find the right slot when assigning an "
"Action"
msgstr ""
"Action-slotten anger vilken delmängd av Actionen som hör till det här "
"datablocket, och dess namn används för att hitta rätt Action-slot när en "
"Action tilldelas"

#. :src: bpy.types.BlendData.actions
msgid "Action data-blocks"
msgstr "Action-datablock"

#. :src: bpy.types.BlendDataActions
msgid "Main Actions"
msgstr "Huvud-Actioner"

#. :src: bpy.types.BlendImportContextItem.append_action
msgid "Append Action"
msgstr "Lägg till Action"

#. :src: bpy.types.ActionSlot
msgid ""
"Identifier for a set of channels in this Action, that can be used by a data-"
"block to specify what it gets animated by"
msgstr ""
"Identifierare för en uppsättning kanaler i den här Actionen, som ett "
"datablock kan använda för att ange vad det animeras av"

#. :src: bpy.types.ActionSlot.handle
msgid ""
"Number specific to this Slot, unique within the Action.\n"
"This is used, for example, on a ActionKeyframeStrip to look up the "
"ActionChannelbag for this Slot"
msgstr ""
"Nummer som är specifikt för den här Action-slotten och unikt inom Actionen.\n"
"Det används till exempel av en ActionKeyframeStrip för att hitta "
"ActionChannelbag för den här Action-slotten"

#. :src: bpy.types.ActionSlot.identifier
msgid ""
"Used when connecting an Action to a data-block, to find the correct slot "
"handle. This is the display name, prefixed by two characters determined by "
"the slot's ID type"
msgstr ""
"Används när en Action kopplas till ett datablock för att hitta rätt "
"slothandtag. Detta är visningsnamnet med ett prefix av två tecken som "
"bestäms av Action-slottens ID-typ"

#. :src: bpy.types.ActionSlot.name_display
msgid ""
"Name of the slot, for display in the user interface. This name combined with "
"the slot's data-block type is unique within its Action"
msgstr ""
"Action-slottens namn för visning i användargränssnittet. Namnet tillsammans "
"med Action-slottens datablocktyp är unikt inom Actionen"

#. :src: bpy.types.ActionSlot.target_id_type
msgid ""
"Type of data-block that this slot is intended to animate; can be set when "
"'UNSPECIFIED' but is otherwise read-only"
msgstr ""
"Datablockstypen som Action-slotten är avsedd att animera. Kan ställas in när "
"”UNSPECIFIED”, men är annars skrivskyddad"

#. :src: bpy.types.ActionGroup
msgid "Action Group"
msgstr "Actiongrupp"

#. :src: bpy.types.ActionGroup.lock
msgid "Action group is locked"
msgstr "Actiongruppen är låst"

#. :src: bpy.types.ActionGroup.mute
msgid "Action group is muted"
msgstr "Actiongruppen är avstängd"

#. :src: bpy.types.ActionGroup.select
msgid "Action group is selected"
msgstr "Actiongruppen är markerad"

#. :src: bpy.types.ActionGroup.show_expanded
msgid "Action group is expanded except in graph editor"
msgstr "Actiongruppen är expanderad utom i grafredigeraren"

#. :src: bpy.types.ActionGroup.show_expanded_graph
msgid "Action group is expanded in graph editor"
msgstr "Actiongruppen är expanderad i grafredigeraren"

#. :src: bpy.types.ActionLayer
msgid "Action Layer"
