#. :src: bpy.types.LightProbeVolume.validity_threshold
msgid "Validity Threshold"
msgstr "Giltighetströskel"

#. :src: bpy.types.LightProbeVolume.validity_threshold
msgid ""
"Ratio of front-facing surface hits under which a grid sample will not be "
"considered for lighting"
msgstr ""
"Förhållande mellan träffar på ytan som vetter mot framsidan under vilket ett "
"rutnätsprov inte kommer att beaktas för belysning"

#. :src: bpy.types.LightProbeVolume.view_bias
msgid "View Bias"
msgstr "Visningsförskjutning"

#. :src: bpy.types.LightProbeVolume.view_bias
msgid ""
"Offset sampling of the irradiance grid in the viewing direction to reduce "
"light bleeding"
msgstr ""
"Förskjut provtagningen av irradiansgallret i betraktningsriktningen för att "
"minska ljusläckage"
