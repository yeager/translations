#. :src: bpy.types.Brush.use_automasking_boundary_edges
#. :src: bpy.types.Sculpt.use_automasking_boundary_edges
msgid "Mesh Boundary Auto-Masking"
msgstr "Automaskering av meshgräns"

#. :src: bpy.types.Brush.use_automasking_boundary_edges
#. :src: bpy.types.Sculpt.use_automasking_boundary_edges
msgid "Do not affect non manifold boundary edges"
msgstr "Påverka inte icke-mångfaldiga gränskanter"

#. :src: bpy.types.Brush.use_automasking_boundary_face_sets
#. :src: bpy.types.Sculpt.use_automasking_boundary_face_sets
msgid "Face Sets Boundary Automasking"
msgstr "Automaskering av ytuppsättningsgräns"

#. :src: bpy.types.Brush.use_automasking_boundary_face_sets
#. :src: bpy.types.Sculpt.use_automasking_boundary_face_sets
msgid "Do not affect vertices that belong to a Face Set boundary"
msgstr "Påverka inte hörnpunkter som tillhör en ytuppsättningsgräns"

#. :src: bpy.types.Brush.use_automasking_cavity
#. :src: bpy.types.Paint.use_cavity
#. :src: bpy.types.Sculpt.use_automasking_cavity
#. :src: bpy.types.VIEW3D_PT_tools_imagepaint_options_cavity
msgid "Cavity Mask"
msgstr "Hålighetsmask"

#. :src: bpy.types.Brush.use_automasking_cavity
#. :src: bpy.types.Sculpt.use_automasking_cavity
msgid "Do not affect vertices on peaks, based on the surface curvature"
msgstr "Påverka inte hörnpunkter vid toppar, utifrån ytans krökning"

#. :src: bpy.types.Brush.use_automasking_cavity_inverted
#. :src: bpy.types.Sculpt.use_automasking_cavity_inverted
msgid "Inverted Cavity Mask"
msgstr "Inverterad hålighetsmask"

#. :src: bpy.types.Brush.use_automasking_cavity_inverted
#. :src: bpy.types.Sculpt.use_automasking_cavity_inverted
msgid "Do not affect vertices within crevices, based on the surface curvature"
msgstr "Påverka inte hörnpunkter i skåror, utifrån ytans krökning"

#. :src: bpy.types.Brush.use_automasking_custom_cavity_curve
#. :src: bpy.types.Sculpt.use_automasking_custom_cavity_curve
msgid "Custom Cavity Curve"
msgstr "Anpassad hålighetskurva"

#. :src: bpy.types.Brush.use_automasking_custom_cavity_curve
#. :src: bpy.types.Sculpt.use_automasking_custom_cavity_curve
msgid "Use custom curve"
msgstr "Använd anpassad kurva"

#. :src: bpy.types.Brush.use_automasking_face_sets
#. :src: bpy.types.Sculpt.use_automasking_face_sets
msgid "Affect only vertices that share Face Sets with the active vertex"
msgstr ""
"Påverka endast hörnpunkter som tillhör samma ytuppsättning som den aktiva "
"hörnpunkten"

#. :src: bpy.types.Brush.use_automasking_start_normal
#. :src: bpy.types.Sculpt.use_automasking_start_normal
#: scripts/startup/bl_ui/properties_paint_common.py:1267
#: scripts/startup/bl_ui/space_view3d.py:6180
#: scripts/startup/bl_ui/space_view3d.py:8779
msgid "Area Normal"
msgstr "Områdesnormal"

#. :src: bpy.types.Brush.use_automasking_start_normal
#. :src: bpy.types.Sculpt.use_automasking_start_normal
msgid "Affect only vertices with a similar normal to where the stroke starts"
msgstr ""
"Påverka endast hörnpunkter med en normal som liknar normalen där "
"penseldraget börjar"

#. :src: bpy.types.Brush.use_automasking_topology
#. :src: bpy.types.Sculpt.use_automasking_topology
msgid "Affect only vertices connected to the active vertex under the brush"
msgstr ""
"Påverka endast hörnpunkter som är topologiskt anslutna till den aktiva "
"hörnpunkten under penseln"

#. :src: bpy.types.Brush.use_automasking_view_normal
#. :src: bpy.types.Sculpt.use_automasking_view_normal
#: scripts/startup/bl_ui/properties_paint_common.py:1257
#: scripts/startup/bl_ui/space_view3d.py:6181
#: scripts/startup/bl_ui/space_view3d.py:8769
msgid "View Normal"
msgstr "Visningsnormal"

#. :src: bpy.types.Brush.use_automasking_view_normal
#. :src: bpy.types.Sculpt.use_automasking_view_normal
msgid "Affect only vertices with a normal that faces the viewer"
msgstr "Påverka endast hörnpunkter med en normal som vetter mot betraktaren"

#. :src: bpy.types.Brush.use_automasking_view_occlusion
#. :src: bpy.types.Sculpt.use_automasking_view_occlusion
#: scripts/startup/bl_ui/properties_paint_common.py:1260
#: scripts/startup/bl_ui/space_view3d.py:8772
#: source/blender/modifiers/intern/MOD_lineart.cc:743
msgid "Occlusion"
msgstr "Ocklusion"

#. :src: bpy.types.Brush.use_automasking_view_occlusion
#. :src: bpy.types.Sculpt.use_automasking_view_occlusion
msgid ""
"Only affect vertices that are not occluded by other faces (slower "
"performance)"
msgstr ""
"Påverka endast hörnpunkter som inte täcks av andra ytor (långsammare "
"prestanda)"
