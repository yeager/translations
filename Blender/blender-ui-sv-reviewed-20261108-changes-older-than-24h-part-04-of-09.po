#. :src: bpy.types.OBJECT_OT_duplicate.mode:'CREASE'
#. :src: bpy.types.TRANSFORM_OT_transform.mode:'CREASE'
msgid "Crease"
msgstr "Veck"

#. :src: bpy.types.FreestyleLineSet.exclude_crease
msgid "Exclude crease edges"
msgstr "Uteslut veckkanter"

#. :src: bpy.types.FreestyleLineSet.exclude_edge_mark
#. :src: bpy.types.FreestyleLineSet.select_edge_mark
msgid "Edge Mark"
msgstr "Kantmarkering"

#. :src: bpy.types.FreestyleLineSet.exclude_edge_mark
msgid "Exclude edge marks"
msgstr "Uteslut kantmarkeringar"

#. :src: bpy.types.FreestyleLineSet.exclude_external_contour
#. :src: bpy.types.FreestyleLineSet.select_external_contour
msgid "External Contour"
msgstr "Extern kontur"

#. :src: bpy.types.FreestyleLineSet.exclude_external_contour
msgid "Exclude external contours"
msgstr "Uteslut yttre konturer"

#. :src: bpy.types.FreestyleLineSet.exclude_material_boundary
#. :src: bpy.types.FreestyleLineSet.select_material_boundary
#. :src: bpy.types.FreestyleLineStyle.material_boundary
msgid "Material Boundary"
msgstr "Materialgräns"

#. :src: bpy.types.FreestyleLineSet.exclude_material_boundary
msgid "Exclude edges at material boundaries"
msgstr "Uteslut kanter vid materialgränser"

#. :src: bpy.types.FreestyleLineSet.exclude_ridge_valley
#. :src: bpy.types.FreestyleLineSet.select_ridge_valley
msgid "Ridge & Valley"
msgstr "Åsar och dalar"

#. :src: bpy.types.FreestyleLineSet.exclude_ridge_valley
msgid "Exclude ridges and valleys"
msgstr "Uteslut åsar och dalar"

#. :src: bpy.types.FreestyleLineSet.exclude_silhouette
#. :src: bpy.types.FreestyleLineSet.select_silhouette
#. :src: bpy.types.GreasePencilLineartModifier.silhouette_filtering:'GROUP'
msgid "Silhouette"
msgstr "Silhuett"

#. :src: bpy.types.FreestyleLineSet.exclude_silhouette
msgid "Exclude silhouette edges"
msgstr "Uteslut silhuettkanter"

#. :src: bpy.types.FreestyleLineSet.exclude_suggestive_contour
#. :src: bpy.types.FreestyleLineSet.select_suggestive_contour
msgid "Suggestive Contour"
msgstr "Suggestiv kontur"

#. :src: bpy.types.FreestyleLineSet.exclude_suggestive_contour
msgid "Exclude suggestive contours"
msgstr "Uteslut suggestiva konturer"

#. :src: bpy.types.FluidFlowSettings
#. :src: bpy.types.FluidModifier.flow_settings
msgid "Flow Settings"
msgstr "Flödesinställningar"

#. :src: bpy.types.FluidFlowSettings
msgid "Fluid flow settings"
msgstr "Inställningar för vätskeflöde"

#. :src: bpy.types.FluidFlowSettings.flow_behavior
msgid "Flow Behavior"
msgstr "Flödesbeteende"

#. :src: bpy.types.FluidFlowSettings.flow_behavior
msgid "Change flow behavior in the simulation"
msgstr "Ändra flödesbeteendet i simuleringen"

#. :src: bpy.types.FluidFlowSettings.flow_behavior:'INFLOW'
msgid "Add fluid to simulation"
msgstr "Lägg till vätska i simuleringen"

#. :src: bpy.types.FluidFlowSettings.flow_behavior:'OUTFLOW'
msgid "Delete fluid from simulation"
msgstr "Ta bort vätska från simuleringen"

#. :src: bpy.types.FluidFlowSettings.flow_source
msgid "Change how fluid is emitted"
msgstr "Ändra hur vätskan avges"

#. :src: bpy.types.FluidFlowSettings.flow_type
msgid "Flow Type"
msgstr "Flödestyp"

#. :src: bpy.types.FluidFlowSettings.flow_type
msgid "Change type of fluid in the simulation"
msgstr "Ändra typ av vätska i simuleringen"

#. :src: bpy.types.FluidFlowSettings.flow_type:'SMOKE'
msgid "Add smoke"
msgstr "Lägg till rök"

#. :src: bpy.types.FluidFlowSettings.flow_type:'BOTH'
msgid "Add fire and smoke"
msgstr "Lägg till eld och rök"

#. :src: bpy.types.FluidFlowSettings.flow_type:'FIRE'
msgid "Add fire"
msgstr "Lägg till eld"

#. :src: bpy.types.FluidFlowSettings.flow_type:'LIQUID'
msgid "Add liquid"
msgstr "Lägg till vätska"

#. :src: bpy.types.FluidFlowSettings.fuel_amount
msgid "Flame Rate"
msgstr "Flamhastighet"

#. :src: bpy.types.FluidFlowSettings.noise_texture
msgid "Texture that controls emission strength"
msgstr "Textur som kontrollerar emissionsstyrkan"

#. :src: bpy.types.FluidFlowSettings.particle_size
msgid "Particle size in simulation cells"
msgstr "Partikelstorlek i simuleringsceller"

#. :src: bpy.types.FluidFlowSettings.particle_system
#. :src: bpy.types.Object.particle_systems
msgid "Particle systems emitted from the object"
msgstr "Partikelsystem som emitteras från objektet"

#. :src: bpy.types.FluidFlowSettings.smoke_color
msgid "Color of smoke"
msgstr "Rökens färg"

#. :src: bpy.types.FluidFlowSettings.subframes
msgid ""
"Number of additional samples to take between frames to improve quality of "
"fast moving flows"
msgstr ""
"Antal extra provtagningar mellan bildrutorna för att förbättra kvaliteten på "
"snabba flöden"

#. :src: bpy.types.FluidFlowSettings.surface_distance
msgid "Surface Emission"
msgstr "Ytemission"

#. :src: bpy.types.FluidFlowSettings.surface_distance
msgid ""
"Controls fluid emission from the mesh surface (higher value results in "
"emission further away from the mesh surface"
msgstr ""
"Styr vätskeemission från meshytan (högre värde ger emission längre bort från "
"meshytan)"

#. :src: bpy.types.FluidFlowSettings.temperature
msgid "Temperature Difference"
msgstr "Temperaturskillnad"

#. :src: bpy.types.FluidFlowSettings.temperature
msgid "Temperature difference to ambient temperature"
msgstr "Temperaturskillnad mot omgivningstemperatur"

#. :src: bpy.types.FluidFlowSettings.texture_map_type
msgctxt "Texture"
msgid "Mapping"
msgstr "Kartläggning"

#. :src: bpy.types.FluidFlowSettings.texture_map_type
msgid "Texture mapping type"
msgstr "Typ av texturmappning"

#. :src: bpy.types.FluidFlowSettings.texture_map_type:'AUTO'
#. :src: bpy.types.LineStyleTextureSlot.texture_coords:'ORCO'
#. :src: bpy.types.ParticleSettingsTextureSlot.texture_coords:'ORCO'
msgctxt "Texture"
msgid "Generated"
msgstr "Genererad"

#. :src: bpy.types.FluidFlowSettings.texture_map_type:'AUTO'
msgid "Generated coordinates centered to flow object"
msgstr "Genererade koordinater centrerade till flödesobjektet"

#. :src: bpy.types.FluidFlowSettings.texture_map_type:'UV'
#. :src: bpy.types.ParticleSettingsTextureSlot.texture_coords:'UV'
msgctxt "Texture"
msgid "UV"
msgstr "UV"

#. :src: bpy.types.FluidFlowSettings.texture_map_type:'UV'
msgid "Use UV layer for texture coordinates"
msgstr "Använd UV-lager för texturkoordinater"

#. :src: bpy.types.FluidFlowSettings.texture_size
msgid "Size of texture mapping"
msgstr "Storlek på texturmappning"

#. :src: bpy.types.FluidFlowSettings.use_absolute
msgid "Absolute Density"
msgstr "Absolut densitet"

#. :src: bpy.types.FluidFlowSettings.use_absolute
msgid "Only allow given density value in emitter area and will not add up"
msgstr ""
"Tillåt endast det angivna densitetsvärdet i emissionsområdet; värden adderas "
"inte"

#. :src: bpy.types.FluidFlowSettings.use_inflow
msgid "Use Flow"
msgstr "Använd flöde"

#. :src: bpy.types.FluidFlowSettings.use_inflow
msgid "Control when to apply fluid flow"
msgstr "Styr när vätskeflödet ska användas"

#. :src: bpy.types.FluidFlowSettings.use_particle_size
msgid "Set particle size in simulation cells or use nearest cell"
msgstr ""
"Ställ in partikelstorlek i simuleringsceller eller använd närmaste cell"

#. :src: bpy.types.FluidFlowSettings.use_texture
#. :src: bpy.types.Brush.use_paint_image
msgid "Use Texture"
msgstr "Använd textur"

#. :src: bpy.types.FluidFlowSettings.use_texture
msgid "Use a texture to control emission strength"
msgstr "Använd en textur för att kontrollera emissionsstyrkan"

#. :src: bpy.types.FluidFlowSettings.velocity_coord
msgid ""
"Additional initial velocity in X, Y and Z direction (added to source "
"velocity)"
msgstr ""
"Ytterligare initialhastighet i X-, Y- och Z-riktning (läggs till "
"källhastigheten)"

#. :src: bpy.types.FluidFlowSettings.velocity_factor
msgid ""
"Multiplier of source velocity passed to fluid (source velocity is non-zero "
"only if object is moving)"
msgstr ""
"Multiplikator för källhastigheten som överförs till vätskan (källhastigheten "
"är endast skild från noll när objektet rör sig)"

#. :src: bpy.types.FluidFlowSettings.velocity_random
msgid "Amount of random velocity"
msgstr "Slumphastighetens storlek"

#. :src: bpy.types.FluidEffectorSettings
#. :src: bpy.types.FluidModifier.effector_settings
msgid "Effector Settings"
msgstr "Inställningar för effektorn"

#. :src: bpy.types.FluidEffectorSettings
msgid "Smoke collision settings"
msgstr "Inställningar för kollision med rök"

#. :src: bpy.types.FluidEffectorSettings.effector_type
msgid "Effector Type"
msgstr "Typ av effektor"

#. :src: bpy.types.FluidEffectorSettings.effector_type
msgid "Change type of effector in the simulation"
msgstr "Ändra typ av effektor i simuleringen"

#. :src: bpy.types.FluidEffectorSettings.effector_type:'COLLISION'
msgid "Create collision object"
msgstr "Skapa kollisionsobjekt"

#. :src: bpy.types.FluidEffectorSettings.effector_type:'GUIDE'
msgid "Create guide object"
msgstr "Skapa styrningsobjekt"

#. :src: bpy.types.FluidEffectorSettings.guide_mode
msgid "Guiding mode"
msgstr "Styrningsläge"

#. :src: bpy.types.FluidEffectorSettings.guide_mode
msgid "How to create guiding velocities"
msgstr "Hur styrhastigheter skapas"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'MAXIMUM'
msgid ""
"Compare velocities from previous frame with new velocities from current "
"frame and keep the maximum"
msgstr ""
"Jämför hastigheterna från föregående bildruta med de nya hastigheterna från "
"aktuell bildruta och behåll den högsta"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'MINIMUM'
msgid ""
"Compare velocities from previous frame with new velocities from current "
"frame and keep the minimum"
msgstr ""
"Jämför hastigheterna från föregående bildruta med de nya hastigheterna från "
"aktuell bildruta och behåll den lägsta"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'OVERRIDE'
msgid ""
"Always write new guide velocities for every frame (each frame only contains "
"current velocities from guiding objects)"
msgstr ""
"Skriv alltid nya styrhastigheter för varje bildruta (varje bildruta "
"innehåller endast aktuella hastigheter från styrningsobjekten)"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'AVERAGED'
msgid ""
"Take average of velocities from previous frame and new velocities from "
"current frame"
msgstr ""
"Ta medelvärdet av hastigheterna från föregående bildruta och de nya "
"hastigheterna från aktuell bildruta"

#. :src: bpy.types.FluidEffectorSettings.subframes
msgid ""
"Number of additional samples to take between frames to improve quality of "
"fast moving effector objects"
msgstr ""
"Antal extra provtagningar mellan bildrutorna för att förbättra kvaliteten på "
"snabbt rörliga effektorobjekt"

#. :src: bpy.types.FluidEffectorSettings.surface_distance
msgid "Additional distance around mesh surface to consider as effector"
msgstr "Ytterligare avstånd runt meshytan som ska räknas som del av effektorn"

#. :src: bpy.types.FluidEffectorSettings.use_effector
msgid "Control when to apply the effector"
msgstr "Styr när effektorn ska användas"

#. :src: bpy.types.FluidEffectorSettings.use_plane_init
#. :src: bpy.types.FluidFlowSettings.use_plane_init
msgid "Is Planar"
msgstr "Är plan"

#. :src: bpy.types.FluidEffectorSettings.velocity_factor
msgid "Multiplier of obstacle velocity"
msgstr "Multiplikator för hinderhastighet"

