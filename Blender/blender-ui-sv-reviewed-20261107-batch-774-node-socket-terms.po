#. :src: bpy.types.NodeGeometryForeachGeometryElementInputItems
msgid "Collection of input items"
msgstr "Samling av indataobjekt"

#. :src: bpy.types.NodeSocket.hide_value
msgid "Hide the socket input value"
msgstr "Dölj uttagets indatavärde"

#. :src: bpy.types.NodeSocket.inferred_structure_type
msgid "Best known structure type of the socket. This may not match the socket shape, e.g. for unlinked input sockets"
msgstr "Den bäst kända strukturtypen för uttaget. Den kanske inte matchar uttagets form, t.ex. för olänkade indatauttag"

#. :src: bpy.types.NodeInternalLink
msgid "Internal link used by muted nodes to connect input to output sockets"
msgstr "Intern länk som används av avstängda noder för att ansluta indata- till utdatauttag"

#. :src: bpy.types.NodeLink.multi_input_sort_id
msgid "Used to sort multiple links coming into the same input. The highest ID is at the top."
msgstr "Används för att sortera flera länkar som kommer in till samma indata. Det högsta ID-numret ligger överst."
