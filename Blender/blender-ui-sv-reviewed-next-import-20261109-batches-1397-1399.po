#. :src: bpy.types.ACTION_OT_clickselect.channel
msgid "Select all the keyframes in the channel under the mouse"
msgstr "Markera alla nyckelbildrutor i kanalen under musen"

#. :src: bpy.types.ACTION_OT_paste.offset:'END'
#. :src: bpy.types.GRAPH_OT_paste.offset:'END'
msgid "Paste keys ending at current frame"
msgstr "Klistra in nyckelbildrutor som slutar vid aktuell bildruta"

#. :src: bpy.types.ACTION_OT_select_by_type
msgid "Select all keyframes of the given type"
msgstr "Markera alla nyckelbildrutor av den angivna typen"

#. :src: bpy.types.ACTION_OT_snap.type:'NEAREST_FRAME'
#. :src: bpy.types.GRAPH_OT_snap.type:'NEAREST_FRAME'
msgid ""
"Snap selected keyframes to the nearest (whole) frame (use to fix accidental "
"subframe offsets)"
msgstr ""
"Fäst valda nyckelbildrutor till närmaste hela bildruta (används för att "
"korrigera oavsiktliga förskjutningar av delrutor)"

#. :src: bpy.types.ANIM_OT_channels_bake.interpolation_type
msgid "Choose the interpolation type with which new keys will be added"
msgstr "Välj interpoleringstyp för nya nyckelbildrutor"

#. :src: bpy.types.ANIM_OT_channels_bake.range
msgid ""
"The custom range in which to create new keys. Only used when not using the "
"scene range"
msgstr ""
"Det anpassade intervallet där nya nyckelbildrutor ska skapas. Används endast"
" när scenintervallet inte används"

#. :src: bpy.types.ANIM_OT_keyframe_delete_vse
msgid "Remove keyframes on current frame for selected strips"
msgstr "Ta bort nyckelbildrutor på aktuell bildruta för valda remsor"

#. :src: bpy.types.CLIP_OT_select_grouped.group:'KEYFRAMED'
msgid "Select all keyframed tracks"
msgstr "Markera alla spår med nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_blend_offset
msgctxt "Operator"
msgid "Blend Offset Keyframes"
msgstr "Blanda offset-nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_blend_offset
msgid "Shift selected keys to the value of the neighboring keys as a block"
msgstr ""
"Flytta de markerade nyckelbildrutorna som ett block till värdet för "
"angränsande nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_blend_to_default
msgid "Blend selected keys to their default value from their current position"
msgstr ""
"Blanda markerade nyckelbildrutor från deras aktuella position till "
"standardvärdet"

#. :src: bpy.types.GRAPH_OT_blend_to_ease
msgctxt "Operator"
msgid "Blend to Ease Keyframes"
msgstr "Blanda till mjuka nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_blend_to_ease
msgid "Blends keyframes from current state to an ease-in or ease-out curve"
msgstr ""
"Blandar nyckelbildrutor från aktuellt tillstånd till en mjukstart- eller "
"mjukslutskurva"

#. :src: bpy.types.GRAPH_OT_blend_to_neighbor
msgid "Blend selected keyframes to their left or right neighbor"
msgstr "Blanda valda nyckelbildrutor med deras vänstra eller högra granne"

#. :src: bpy.types.GRAPH_OT_breakdown
msgid ""
"Move selected keyframes to an inbetween position relative to adjacent keys"
msgstr ""
"Flytta markerade nyckelbildrutor till en mellanposition i förhållande till "
"intilliggande nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_click_insert
msgctxt "Operator"
msgid "Click-Insert Keyframes"
msgstr "Klicka för att infoga nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_clickselect.curves
msgid "Select all the keyframes in the curve"
msgstr "Markera alla nyckelbildrutor i kurvan"

#. :src: bpy.types.GRAPH_OT_decimate
msgctxt "Operator"
msgid "Decimate Keyframes"
msgstr "Decimera nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_decimate
msgid ""
"Decimate F-Curves by removing keyframes that influence the curve shape the "
"least"
msgstr ""
"Decimera F-kurvor genom att ta bort nyckelbildrutor som påverkar kurvans "
"form minst"

#. :src: bpy.types.GRAPH_OT_decimate.factor
msgid "The ratio of keyframes to remove"
msgstr "Förhållandet mellan nyckelbildrutor som ska tas bort"

#. :src: bpy.types.GRAPH_OT_decimate.mode:'RATIO'
msgid "Use a percentage to specify how many keyframes you want to remove"
msgstr ""
"Använd en procentandel för att ange hur många nyckelbildrutor du vill ta "
"bort"

#. :src: bpy.types.GRAPH_OT_ease
msgctxt "Operator"
msgid "Ease Keyframes"
msgstr "Mjuka nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_ease
msgid "Align keyframes on a ease-in or ease-out curve"
msgstr "Justera nyckelbildrutor efter en mjukstarts- eller mjukslutskurva"

#. :src: bpy.types.GRAPH_OT_ease.factor
msgid "Defines if the keys should be aligned on an ease-in or ease-out curve"
msgstr ""
"Anger om nyckelbildrutorna ska justeras efter en mjukstarts- eller "
"mjukslutskurva"

#. :src: bpy.types.GRAPH_OT_equalize_handles
msgid ""
"Ensure selected keyframes' handles have equal length, optionally making them"
" horizontal. Automatic, Automatic Clamped, or Vector handle types will be "
"converted to Aligned"
msgstr ""
"Se till att de valda nyckelbildrutornas handtag har samma längd, eventuellt "
"genom att göra dem horisontella. Handtagstyperna Automatisk, Automatisk "
"klämd eller Vektor konverteras till Justerad"

#. :src: bpy.types.GRAPH_OT_equalize_handles.flatten
msgid ""
"Make the values of the selected keyframes' handles the same as their "
"respective keyframes"
msgstr ""
"Gör värdena för de valda nyckelbildrutornas handtag samma som deras "
"respektive nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_equalize_handles.handle_length
msgid "Length to make selected keyframes' Bézier handles"
msgstr "Längd som valda nyckelbildrutors Bézier-handtag ska få"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side
msgid "Side of the keyframes' Bézier handles to affect"
msgstr "Sidan av nyckelbildrutornas Bézier-handtag som ska påverkas"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side:'LEFT'
msgid "Equalize selected keyframes' left handles"
msgstr "Utjämna valda nyckelbildrutors vänstra handtag"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side:'RIGHT'
msgid "Equalize selected keyframes' right handles"
msgstr "Jämna ut valda nyckelbildrutors högra handtag"

#. :src: bpy.types.GRAPH_OT_frame_jump
msgid "Place the cursor on the midpoint of selected keyframes"
msgstr "Placera markören mitt emellan markerade nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_keys_to_samples
msgctxt "Operator"
msgid "Keys to Samples"
msgstr "Nyckelbildrutor till sampel"

#. :src: bpy.types.GRAPH_OT_match_slope
msgid "Blend selected keys to the slope of neighboring ones"
msgstr ""
"Blanda markerade nyckelbildrutor med lutningen hos angränsande "
"nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_match_slope.factor
msgid "Defines which keys to use as slope and how much to blend towards them"
msgstr ""
"Anger vilka nyckelbildrutor som ska användas som lutning och hur mycket som "
"ska blandas mot dem"

#. :src: bpy.types.GRAPH_OT_mirror.type:'YAXIS'
msgid ""
"Flip times of selected keyframes, effectively reversing the order they "
"appear in"
msgstr ""
"Vänd tiderna för valda nyckelbildrutor, vilket effektivt vänder ordningen de"
" visas i"

#. :src: bpy.types.GRAPH_OT_mirror.type:'VALUE'
msgid ""
"Flip values of selected keyframes using the cursor value (Y/Horizontal "
"component) as the mirror line"
msgstr ""
"Vänd värden för valda nyckelbildrutor med hjälp av markörvärdet "
"(Y/horisontell komponent) som spegellinje"

#. :src: bpy.types.GRAPH_OT_paste.value_offset
msgid "Paste keys with a value offset"
msgstr "Klistra in nyckelbildrutor med en värdeförskjutning"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'LEFT_KEY'
msgid "Paste keys with the first key matching the key left of the cursor"
msgstr ""
"Klistra in nyckelbildrutor med den första nyckelrutan anpassad till "
"nyckelrutan till vänster om markören"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'RIGHT_KEY'
msgid "Paste keys with the last key matching the key right of the cursor"
msgstr ""
"Klistra in nyckelbildrutor med den sista nyckelrutan anpassad till "
"nyckelrutan till höger om markören"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'CURRENT_FRAME'
msgid "Paste keys relative to the value of the curve under the cursor"
msgstr ""
"Klistra in nyckelbildrutor i förhållande till värdet på kurvan under "
"markören"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'CURSOR_VALUE'
msgid "Paste keys relative to the Y-Position of the cursor"
msgstr "Klistra in nyckelbildrutor i förhållande till markörens Y-position"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'NONE'
msgid "Paste keys with the same value as they were copied"
msgstr "Klistra in nyckelbildrutor med samma värde som när de kopierades"

#. :src: bpy.types.GRAPH_OT_previewrange_set
msgid "Set Preview Range based on range of selected keyframes"
msgstr ""
"Ange förhandsgranskningsintervall utifrån intervallet för markerade "
"nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_push_pull
msgctxt "Operator"
msgid "Push Pull Keyframes"
msgstr "Skjut-/drag-nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_push_pull
msgid "Exaggerate or minimize the value of the selected keys"
msgstr "Överdriv eller minska värdet på markerade nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_push_pull.factor
msgid "Control how far to push or pull the keys"
msgstr "Styr hur långt nyckelbildrutorna ska skjutas eller dras"

#. :src: bpy.types.GRAPH_OT_samples_to_keys
msgctxt "Operator"
msgid "Samples to Keys"
msgstr "Sampel till nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_samples_to_keys
msgid "Convert selected channels from samples to keyframes"
msgstr "Konvertera markerade kanaler från sampel till nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_scale_average
msgctxt "Operator"
msgid "Scale Average Keyframes"
msgstr "Skala nyckelbildrutors medelvärde"

#. :src: bpy.types.GRAPH_OT_scale_from_neighbor
msgid ""
"Increase or decrease the value of selected keys in relationship to the "
"neighboring one"
msgstr ""
"Öka eller minska värdet på markerade nyckelbildrutor i förhållande till den "
"angränsande nyckelrutan"

#. :src: bpy.types.GRAPH_OT_scale_from_neighbor.factor
msgid "The factor to scale keys with"
msgstr "Faktorn som nyckelbildrutorna ska skalas med"

#. :src: bpy.types.GRAPH_OT_select_box.include_handles
#. :src: bpy.types.GRAPH_OT_select_circle.include_handles
#. :src: bpy.types.GRAPH_OT_select_lasso.include_handles
msgid ""
"Are handles tested individually against the selection criteria, "
"independently from their keys. When unchecked, handles are (de)selected in "
"unison with their keys"
msgstr ""
"Handtag testas individuellt mot urvalskriterierna, oberoende av sina "
"nyckelbildrutor. När detta inte är markerat markeras eller avmarkeras "
"handtagen tillsammans med sina nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_select_box.use_curve_selection
msgid ""
"Allow selecting all the keyframes of a curve by selecting the calculated "
"F-curve"
msgstr ""
"Tillåt att alla nyckelbildrutor i en kurva markeras genom att markera den "
"beräknade F-kurvan"

#. :src: bpy.types.GRAPH_OT_select_circle.use_curve_selection
#. :src: bpy.types.GRAPH_OT_select_lasso.use_curve_selection
msgid ""
"Allow selecting all the keyframes of a curve by selecting the curve itself"
msgstr ""
"Tillåt att alla nyckelbildrutor i en kurva markeras genom att markera själva"
" kurvan"

#. :src: bpy.types.GRAPH_OT_shear
msgctxt "Operator"
msgid "Shear Keyframes"
msgstr "Skjuva nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_shear
msgid ""
"Affect the value of the keys linearly, keeping the same relationship between"
" them using either the left or the right key as reference"
msgstr ""
"Påverka nyckelbildrutornas värde linjärt och behåll samma förhållande mellan"
" dem med antingen den vänstra eller högra nyckelrutan som referens"

#. :src: bpy.types.GRAPH_OT_shear.direction:'FROM_LEFT'
msgid "Shear the keys using the left key as reference"
msgstr "Skjuva nyckelbildrutorna med den vänstra nyckelrutan som referens"

#. :src: bpy.types.GRAPH_OT_shear.direction:'FROM_RIGHT'
msgid "Shear the keys using the right key as reference"
msgstr "Skjuva nyckelbildrutorna med den högra nyckelrutan som referens"

#. :src: bpy.types.GRAPH_OT_smooth
msgctxt "Operator"
msgid "Smooth Keys"
msgstr "Jämna ut nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_snap
msgid "Snap selected keyframes to the chosen times/values"
msgstr "Fäst markerade nyckelbildrutor vid valda tider/värden"

#. :src: bpy.types.GRAPH_OT_snap.type:'VALUE'
msgid ""
"Set values of selected keyframes to the cursor value (Y/Horizontal "
"component)"
msgstr ""
"Ställ in värdena för valda nyckelbildrutor till markörvärdet (Y/horisontell "
"komponent)"

#. :src: bpy.types.GRAPH_OT_snap_cursor_value
msgid "Place the cursor value on the average value of selected keyframes"
msgstr "Placera markörvärdet på medelvärdet för valda nyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_time_offset
msgctxt "Operator"
msgid "Time Offset Keyframes"
msgstr "Tidsförskjutningsnyckelbildrutor"

#. :src: bpy.types.GRAPH_OT_time_offset
msgid "Shifts the value of selected keys in time"
msgstr "Förskjuter markerade nyckelbildrutors värde i tiden"

#. :src: bpy.types.GRAPH_OT_view_selected
msgid "Reset viewable area to show selected keyframe range"
msgstr ""
"Återställ det synliga området så att intervallet för markerade "
"nyckelbildrutor visas"

#. :src: bpy.types.GREASE_PENCIL_OT_active_frame_delete.all
msgid "Delete active keyframes of all layers"
msgstr "Ta bort aktiva nyckelbildrutor för alla lager"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation
msgid "Bake Grease Pencil object transform to Grease Pencil keyframes"
msgstr ""
"Beräkna Grease Pencil-objektets transformering till Grease Pencil-"
"nyckelbildrutor"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.only_selected
msgid "Only Selected Keyframes"
msgstr "Endast valda nyckelbildrutor"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.only_selected
msgid "Convert only selected keyframes"
msgstr "Konvertera endast valda nyckelbildrutor"

#. :src: bpy.types.GREASE_PENCIL_OT_frame_clean_duplicate.selected
msgid "Only delete selected keyframes"
msgstr "Ta endast bort markerade nyckelbildrutor"

#. :src: bpy.types.GREASE_PENCIL_OT_frame_duplicate.all
msgid "Duplicate active keyframes of all layer"
msgstr "Duplicera aktiva nyckelbildrutor i alla lager"

#. :src: bpy.types.GREASE_PENCIL_OT_layer_duplicate.empty_keyframes
msgid "Empty Keyframes"
msgstr "Tomma nyckelbildrutor"

#. :src: bpy.types.GREASE_PENCIL_OT_layer_duplicate.empty_keyframes
msgid "Add Empty Keyframes"
msgstr "Lägg till tomma nyckelbildrutor"

#. :src: bpy.types.NLA_OT_tweakmode_enter
msgid ""
"Enter tweaking mode for the action referenced by the active strip to edit "
"its keyframes"
msgstr ""
"Gå in i justeringsläget för den Action som den aktiva remsan refererar till "
"för att redigera dess nyckelbildrutor"

#. :src: bpy.types.OBJECT_OT_modifier_apply.all_keyframes
msgid "Apply to all keyframes"
msgstr "Tillämpa på alla nyckelbildrutor"

#. :src: bpy.types.OBJECT_OT_modifier_apply.all_keyframes
msgid "For Grease Pencil objects, apply the modifier to all the keyframes"
msgstr ""
"För Grease Pencil-objekt, tillämpa modifieraren på alla nyckelbildrutor"

#. :src: bpy.types.OBJECT_OT_paste_transform.method
msgid ""
"Update the current transform, selected keyframes, or even create new keys"
msgstr ""
"Uppdatera den aktuella transformeringen, valda nyckelbildrutor eller skapa "
"till och med nya nycklar"

#. :src: bpy.types.OBJECT_OT_paste_transform.method:'BAKE'
msgid ""
"Paste onto all frames between the first and last selected key, creating new "
"keyframes if necessary"
msgstr ""
"Klistra in på alla bildrutor mellan den första och sista valda nyckeln och "
"skapa nya nyckelbildrutor om det behövs"

#. :src: bpy.types.POSE_OT_propagate.mode:'SELECTED_KEYS'
msgid "Propagate pose to all selected keyframes"
msgstr "Sprid posen till alla valda nyckelbildrutor"

#. :src: bpy.types.RENDER_OT_opengl.render_keyed_only
msgid "Render Keyframes Only"
msgstr "Rendera endast nyckelbildrutor"

#. :src: bpy.types.PreferencesEdit.show_only_selected_curve_keyframes
msgid "Only keyframes of selected F-Curves are visible and editable"
msgstr "Endast nyckelbildrutor för valda F-kurvor är synliga och redigerbara"

#. :src: bpy.types.PreferencesEdit.use_keyframe_insert_available
msgid "Insert Keyframes only for properties that are already animated"
msgstr "Infoga endast nyckelbildrutor för egenskaper som redan är animerade"

#. :src: bpy.types.SpaceDopeSheetEditor.use_realtime_update
#. :src: bpy.types.SpaceGraphEditor.use_realtime_update
msgid ""
"When transforming keyframes, changes to the animation data are flushed to "
"other views"
msgstr ""
"När nyckelbildrutor transformeras överförs ändringarna i animationsdata till"
" andra vyer"

#. :src: bpy.types.SpaceGraphEditor.use_auto_lock_translation_axis
msgid "Automatically locks the movement of keyframes to the dominant axis"
msgstr ""
"Låser automatiskt rörelsen för nyckelbildrutor till den dominerande axeln"

#. :src: bpy.types.SpaceGraphEditor.use_only_selected_keyframe_handles
msgid "Only show and edit handles of selected keyframes"
msgstr "Visa och redigera endast handtag för valda nyckelbildrutor"

#: scripts/startup/bl_ui/properties_grease_pencil_common.py:662
#: scripts/startup/bl_ui/space_view3d.py:5374
msgctxt "Operator"
msgid "Delete Active Keyframes (All Layers)"
msgstr "Ta bort aktiva nyckelbildrutor (alla lager)"

#: source/blender/animrig/intern/keyframing.cc:514
#: source/blender/animrig/intern/keyframing.cc:592
msgid "No action to delete keyframes from for ID = %s"
msgstr "Ingen Action att ta bort nyckelbildrutor från för ID = %s"

#: source/blender/editors/animation/keyframing.cc:1136
msgid "Delete keyframes from selected strips?"
msgstr "Ta bort nyckelbildrutor från valda remsor?"

#: source/blender/editors/animation/keyframing.cc:1271
msgid "Delete keyframes from selected objects?"
msgstr "Ta bort nyckelbildrutor från valda objekt?"

#: source/blender/editors/animation/keyframing.cc:1245
msgid "No keyframes removed from %d object(s)"
msgstr "Inga nyckelbildrutor har tagits bort från %d objekt"

#: source/blender/editors/interface/interface_context_menu.cc:644
msgctxt "Operator"
msgid "Replace Keyframes"
msgstr "Ersätt nyckelbildrutor"

#: source/blender/editors/screen/screen_ops.cc:4297
msgid "No more keyframes to jump to in this direction"
msgstr "Inga fler nyckelbildrutor att hoppa till i denna riktning"

#: source/blender/editors/space_graph/graph_buttons.cc:589
msgid "F-Curve does not have any keyframes as it only contains sampled points"
msgstr ""
"F-kurvan har inga nyckelbildrutor eftersom den endast innehåller samplade "
"punkter"

#. :src: bpy.types.ToolSettings.auto_keying_mode
msgid ""
"Can add additional constraints on when auto keying can insert keyframes"
msgstr ""
"Lägg till ytterligare begränsningar för när automatisk nyckelbildsättning "
"får infoga nyckelbildrutor"

#. :src: bpy.types.MovieTrackingPlaneTrack.use_auto_keying
msgid "Automatic keyframe insertion when moving plane corners"
msgstr "Automatisk insättning av nyckelbildrutor vid flytt av planhörn"

#. :src: bpy.types.SEQUENCER_OT_slip.slip_keyframes
msgid "Slip Keyframes"
msgstr "Förskjut nyckelbildrutor"

#. :src: bpy.types.SEQUENCER_OT_slip.slip_keyframes
msgid "Move the keyframes alongside the media"
msgstr "Flytta nyckelbildrutorna tillsammans med mediet"

#. :src: bpy.types.TRANSFORM_OT_resize.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_seq_slide.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_transform.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_translate.use_duplicated_keyframes
msgid "Duplicated Keyframes"
msgstr "Duplicerade nyckelbildrutor"

#. :src: bpy.types.TRANSFORM_OT_resize.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_seq_slide.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_transform.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_translate.use_duplicated_keyframes
msgid "Transform duplicated keyframes"
msgstr "Transformera duplicerade nyckelbildrutor"

#. :src: bpy.types.SCENE_PT_keyframing_settings
msgid "Keyframing Settings"
msgstr "Inställningar för nyckelbildsättning"

#. :src: bpy.types.TIME_PT_keyframing
#. :src: bpy.types.TIME_PT_keyframing_settings
#: scripts/startup/bl_ui/space_userpref.py:659
msgid "Keyframing"
msgstr "Nyckelbildsättning"

#. :src: bpy.types.PreferencesEdit.auto_keying_mode
msgid ""
"Mode of automatic keyframe insertion for Objects and Bones (default setting "
"used for new Scenes)"
msgstr ""
"Läge för automatisk infogning av nyckelbildrutor för objekt och ben "
"(standardinställning som används för nya scener)"

#. :src: bpy.types.PreferencesEdit.key_insert_channels
msgid "Default Key Channels"
msgstr "Standardkanaler för nyckelbildrutor"

#. :src: bpy.types.PreferencesEdit.keyframe_new_handle_type
msgid "New Handles Type"
msgstr "Handtagstyp för nya nyckelbildrutor"

#. :src: bpy.types.PreferencesEdit.keyframe_new_handle_type
msgid "Handle type for handles of new keyframes"
msgstr "Typ av handtag för handtagen på nya nyckelbildrutor"

#. :src: bpy.types.PreferencesEdit.keyframe_new_interpolation_type
msgid ""
"Interpolation mode used for first keyframe on newly added F-Curves "
"(subsequent keyframes take interpolation from preceding keyframe)"
msgstr ""
"Interpoleringsläge som används för den första nyckelbildrutan på nyligen "
"tillagda F-kurvor (efterföljande nyckelbildrutor använder interpoleringen "
"från föregående nyckelbildruta)"

#. :src: bpy.types.PreferencesEdit.show_only_selected_curve_keyframes
msgid "Only Show Selected F-Curve Keyframes"
