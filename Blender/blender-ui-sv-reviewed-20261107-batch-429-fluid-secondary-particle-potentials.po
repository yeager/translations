#. :src: bpy.types.FluidDomainSettings.sndparticle_life_max
msgid "Maximum Lifetime"
msgstr "Maximal livslängd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_life_max
msgid "Highest possible particle lifetime"
msgstr "Högsta möjliga partikellivslängd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_life_min
msgid "Minimum Lifetime"
msgstr "Minsta livslängd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_life_min
msgid "Lowest possible particle lifetime"
msgstr "Lägsta möjliga partikellivslängd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_energy
msgid "Maximum Kinetic Energy Potential"
msgstr "Maximal potential för rörelseenergi"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_energy
msgid ""
"Upper clamping threshold that indicates the fluid speed where cells no "
"longer emit more particles (higher value results in generally less particles)"
msgstr ""
"Övre begränsningströskel som anger den vätskehastighet där cellerna inte "
"längre avger partiklar (högre värde ger vanligen färre partiklar)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_trappedair
msgid "Maximum Trapped Air Potential"
msgstr "Maximal potential för instängd luft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_trappedair
msgid ""
"Upper clamping threshold for marking fluid cells where air is trapped "
"(higher value results in less marked cells)"
msgstr ""
"Övre begränsningströskel för markering av vätskeceller där luft är instängd "
"(högre värde ger färre markerade celler)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_wavecrest
msgid "Maximum Wave Crest Potential"
msgstr "Maximal vågtoppspotential"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_wavecrest
msgid ""
"Upper clamping threshold for marking fluid cells as wave crests (higher "
"value results in less marked cells)"
msgstr ""
"Övre begränsningströskel för markering av vätskeceller som vågtoppar (högre "
"värde ger färre markerade celler)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_energy
msgid "Minimum Kinetic Energy Potential"
msgstr "Minsta potential för rörelseenergi"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_energy
msgid ""
"Lower clamping threshold that indicates the fluid speed where cells start to "
"emit particles (lower values result in generally more particles)"
msgstr ""
"Nedre begränsningströskel som anger den vätskehastighet där cellerna börjar "
"avge partiklar (lägre värde ger vanligen fler partiklar)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_trappedair
msgid "Minimum Trapped Air Potential"
msgstr "Minsta potential för instängd luft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_trappedair
msgid ""
"Lower clamping threshold for marking fluid cells where air is trapped (lower "
"value results in more marked cells)"
msgstr ""
"Nedre begränsningströskel för markering av vätskeceller där luft är instängd "
"(lägre värde ger fler markerade celler)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_wavecrest
msgid "Minimum Wave Crest Potential"
msgstr "Minsta vågtoppspotential"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_wavecrest
msgid ""
"Lower clamping threshold for marking fluid cells as wave crests (lower value "
"results in more marked cells)"
msgstr ""
"Nedre begränsningströskel för markering av vätskeceller som vågtoppar (lägre "
"värde ger fler markerade celler)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_radius
#: scripts/startup/bl_ui/properties_physics_fluid.py:978
msgid "Potential Radius"
msgstr "Potentialradie"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_radius
msgid ""
"Radius to compute potential for each cell (higher values are slower but "
"create smoother potential grids)"
msgstr ""
"Radie för att beräkna potentialen för varje cell (högre värden är "
"långsammare men skapar jämnare potentialrutnät)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_sampling_trappedair
msgid "Trapped Air Sampling"
msgstr "Provtagning av instängd luft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_sampling_trappedair
msgid "Maximum number of particles generated per trapped air cell per frame"
msgstr ""
"Maximalt antal partiklar som genereras per instängd luftcell per bildruta"

#. :src: bpy.types.FluidDomainSettings.sndparticle_sampling_wavecrest
msgid "Maximum number of particles generated per wave crest cell per frame"
msgstr "Maximalt antal partiklar som genereras per vågtoppscell per bildruta"

#. :src: bpy.types.FluidDomainSettings.sndparticle_update_radius
msgid ""
"Radius to compute position update for each particle (higher values are "
"slower but particles move less chaotic)"
msgstr ""
"Radie för att beräkna positionsuppdateringen för varje partikel (högre "
"värden är långsammare men partiklarna rör sig mindre kaotiskt)"
