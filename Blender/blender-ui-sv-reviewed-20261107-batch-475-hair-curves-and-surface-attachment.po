#. :src: bpy.types.Curves
msgid "Hair data-block for hair curves"
msgstr "Hårdatablock för hårkurvor"

#. :src: bpy.types.Curves.curves
msgid "All curves in the data-block"
msgstr "Alla kurvor i datablocket"

#. :src: bpy.types.Curves.normals
msgid "The curve normal value at each of the curve's control points"
msgstr "Kurvans normalvärde vid varje kontrollpunkt"

#. :src: bpy.types.Curves.points
msgid "Control points of all curves"
msgstr "Kontrollpunkter för alla kurvor"

#. :src: bpy.types.Curves.selection_domain
msgid "Selection Domain"
msgstr "Urvalsdomän"

#. :src: bpy.types.Curves.surface
msgid "Mesh object that the curves can be attached to"
msgstr "Mesh-objekt som kurvorna kan kopplas till"

#. :src: bpy.types.Curves.surface_collision_distance
msgid "Collision distance"
msgstr "Kollisionsavstånd"

#. :src: bpy.types.Curves.surface_collision_distance
msgid "Distance to keep the curves away from the surface"
msgstr "Avstånd för att hålla kurvorna borta från ytan"

#. :src: bpy.types.Curves.surface_uv_map
#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Displace Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Hair Attachment Info, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Surface UV Map"
msgstr "Ytans UV-karta"

#. :src: bpy.types.Curves.surface_uv_map
msgid ""
"The name of the attribute on the surface mesh used to define the attachment "
"of each curve"
msgstr ""
"Namnet på attributet på ytmeshen som används för att definiera varje kurvas "
"infästning"

#. :src: bpy.types.Curves.use_mirror_x
#. :src: bpy.types.Mesh.use_mirror_x
msgid "Enable symmetry in the X axis"
msgstr "Aktivera symmetri längs X-axeln"

#. :src: bpy.types.Curves.use_mirror_y
#. :src: bpy.types.Mesh.use_mirror_y
msgid "Enable symmetry in the Y axis"
msgstr "Aktivera symmetri längs Y-axeln"

#. :src: bpy.types.Curves.use_mirror_z
#. :src: bpy.types.Mesh.use_mirror_z
msgid "Enable symmetry in the Z axis"
msgstr "Aktivera symmetri längs Z-axeln"

#. :src: bpy.types.Curves.use_sculpt_collision
msgid "Use Sculpt Collision"
msgstr "Använd skulpteringskollision"

#. :src: bpy.types.Curves.use_sculpt_collision
msgid "Enable collision with the surface while sculpting"
msgstr "Aktivera kollision med ytan under skulptering"
