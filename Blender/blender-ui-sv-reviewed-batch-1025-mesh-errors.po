#. :src: KM_HIERARCHY.VIEW_3D.EMPTY:'SET_USE_SELECTED'
msgid "Select new active mesh element and use its location"
msgstr "Välj ett nytt aktivt meshelement och använd dess placering"

#: scripts/startup/bl_operators/image_as_planes.py:1197
msgid "{:d} image(s) converted to mesh plane(s)"
msgstr "{:d} bilder konverterades till meshplan"

#: source/blender/blenkernel/intern/data_transfer.cc:1516
msgid "Source and destination meshes do not have the same number of vertices, 'Topology' mapping cannot be used in this case"
msgstr "Käll- och målmeshar har inte samma antal hörnpunkter; topologimappning kan inte användas i detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1537
msgid "Source or destination meshes do not have any vertices, cannot transfer vertex data"
msgstr "Käll- eller målmeshar har inga hörnpunkter och kan inte överföra hörnpunktsdata"

#: source/blender/blenkernel/intern/data_transfer.cc:1596
msgid "Source and destination meshes do not have the same number of edges, 'Topology' mapping cannot be used in this case"
msgstr "Käll- och målmeshar har inte samma antal kanter; topologimappning kan inte användas i detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1610
msgid "Source or destination meshes do not have any edges, cannot transfer edge data"
msgstr "Käll- eller målmeshar har inga kanter och kan inte överföra kantdata"

#: source/blender/blenkernel/intern/data_transfer.cc:1673
msgid "Source and destination meshes do not have the same number of face corners, 'Topology' mapping cannot be used in this case"
msgstr "Käll- och målmeshar har inte samma antal ythörn; topologimappning kan inte användas i detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1687
msgid "Source or destination meshes do not have any faces, cannot transfer corner data"
msgstr "Käll- eller målmeshar har inga ytor och kan inte överföra hörndata"

#: source/blender/blenkernel/intern/data_transfer.cc:1751
msgid "Source and destination meshes do not have the same number of faces, 'Topology' mapping cannot be used in this case"
msgstr "Käll- och målmeshar har inte samma antal ytor; topologimappning kan inte användas i detta fall"

#: source/blender/blenkernel/intern/data_transfer.cc:1765
msgid "Source or destination meshes do not have any faces, cannot transfer face data"
msgstr "Käll- eller målmeshar har inga ytor och kan inte överföra ytdata"

#: source/blender/blenkernel/intern/mesh.cc:514
msgid "meshes"
msgstr "meshar"

#: source/blender/editors/mesh/mesh_join.cc:553
msgid "Active object is not a selected mesh"
msgstr "Aktivt objekt är inte en vald mesh"

#: source/blender/editors/mesh/mesh_join.cc:597
msgid "No mesh data to join"
msgstr "Inga meshdata att sammanfoga"

#: source/blender/editors/object/object_add.cc:3942
msgid "Object '%s' has no evaluated mesh or curves data"
msgstr "Objektet ”%s” har inga utvärderade mesh- eller kurvdata"

#: source/blender/editors/object/object_bake_api.cc:462
msgid "Object \"%s\" is not a mesh"
msgstr "Objektet ”%s” är inte en mesh"

#: source/blender/editors/object/object_data_transfer.cc:537
msgid "Failed to transfer mesh data to %d objects"
msgstr "Det gick inte att överföra meshdata till %d objekt"

#: source/blender/editors/object/object_edit.cc:1726
msgid "Cannot edit linked mesh or curve data"
msgstr "Det går inte att redigera länkade mesh- eller kurvdata"

#: source/blender/editors/object/object_modifier.cc:844
msgid "Evaluated geometry from modifier does not contain a mesh"
msgstr "Utvärderad geometri från modifieraren innehåller inte en mesh"

#: source/blender/editors/object/object_remesh.cc:134
msgid "Voxel remesher failed to create mesh"
msgstr "Voxelommesharen kunde inte skapa en mesh"

#: source/blender/editors/sculpt_paint/mesh/sculpt_trim.cc:624
msgid "Solver requires a manifold mesh"
msgstr "Lösaren kräver en manifoldmesh"
