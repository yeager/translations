#. :src: bpy.types.ShrinkwrapConstraint
msgid "Shrinkwrap Constraint"
msgstr "Shrinkwrap-begränsning"

#. :src: bpy.types.ShrinkwrapConstraint
msgid "Create constraint-based shrinkwrap relationship"
msgstr "Skapa en begränsningsbaserad Shrinkwrap-relation"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face
#. :src: bpy.types.ShrinkwrapModifier.cull_face
msgid "Face Cull"
msgstr "Ytgallring"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face
#. :src: bpy.types.ShrinkwrapModifier.cull_face
msgid ""
"Stop vertices from projecting to a face on the target when facing towards/"
"away"
msgstr ""
"Förhindra att hörnpunkter projiceras på en yta på målet när de är vända mot "
"eller från den"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face:'OFF'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face:'OFF'
#. :src: bpy.types.ShrinkwrapModifier.cull_face:'OFF'
msgid "No culling"
msgstr "Ingen gallring"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face:'FRONT'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face:'FRONT'
#. :src: bpy.types.ShrinkwrapModifier.cull_face:'FRONT'
msgid "No projection when in front of the face"
msgstr "Ingen projektion när punkten är framför ytan"

#. :src: bpy.types.ShrinkwrapConstraint.cull_face:'BACK'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.cull_face:'BACK'
#. :src: bpy.types.ShrinkwrapModifier.cull_face:'BACK'
msgid "No projection when behind the face"
msgstr "Ingen projektion när punkten är bakom ytan"

#. :src: bpy.types.ShrinkwrapConstraint.distance
msgid "Distance to Target"
msgstr "Avstånd till målet"
