#. :src: bpy.types.Strip.modifiers
#: scripts/startup/bl_ui/space_dopesheet.py:156
#: source/blender/editors/space_action/action_buttons.cc:44
#: source/blender/editors/space_buttons/buttons_texture.cc:244
#: source/blender/editors/space_graph/graph_buttons.cc:1504
#: source/blender/editors/space_nla/nla_buttons.cc:730
#: source/blender/editors/space_outliner/tree/tree_element_modifier.cc:26
msgid "Modifiers"
msgstr "Modifierare"

#. :src: bpy.types.FCurve.modifiers
msgid "Modifiers affecting the shape of the F-Curve"
msgstr "Modifierare som påverkar F-kurvans form"

#. :src: bpy.types.FCurve.mute
#. :src: bpy.types.NlaTrack.mute
#. :src: bpy.types.NodeLink.is_muted
msgid "Muted"
msgstr "Dämpad"

#. :src: bpy.types.FCurve.mute
msgid "Disable F-Curve evaluation"
msgstr "Inaktivera utvärdering av F-kurvan"

#. :src: bpy.types.FCurve.sampled_points
msgid "Sampled Points"
msgstr "Provtagna punkter"

#. :src: bpy.types.FCurve.sampled_points
msgid "Sampled animation data"
msgstr "Provtagna animeringsdata"

#. :src: bpy.types.FCurve.select
msgid "F-Curve is selected for editing"
msgstr "F-kurvan är vald för redigering"

#. :src: bpy.types.FCurveKeyframePoints
msgid "Keyframe Points"
msgstr "Nyckelbildrutepunkter"

#. :src: bpy.types.FCurveKeyframePoints
msgid "Collection of keyframe points"
msgstr "Samling av nyckelbildrutepunkter"

#. :src: bpy.types.FCurveModifiers
msgid "F-Curve Modifiers"
msgstr "Modifierare för F-kurva"

#. :src: bpy.types.FCurveModifiers
msgid "Collection of F-Curve Modifiers"
msgstr "Samling av F-kurvmodifierare"

#. :src: bpy.types.FCurveModifiers.active
msgid "Active F-Curve Modifier"
msgstr "Modifierare för aktiv F-kurva"

#. :src: bpy.types.FCurveSample
msgid "F-Curve Sample"
msgstr "F-kurvprov"

#. :src: bpy.types.FCurveSample
msgid "Sample point for F-Curve"
msgstr "Provpunkt för F-kurva"

#. :src: bpy.types.FCurveSample.co
#. :src: bpy.types.SplinePoint.co
msgid "Point coordinates"
msgstr "Punktkoordinater"

#. :src: bpy.types.FCurveSample.select
#. :src: bpy.types.LatticePoint.select
#. :src: bpy.types.MaskSplinePointUW.select
#. :src: bpy.types.SplinePoint.select
msgid "Selection status"
msgstr "Status för urval"
