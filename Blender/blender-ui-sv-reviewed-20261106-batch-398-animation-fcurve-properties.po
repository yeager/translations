#. :src: bpy.types.FCurve.driver
msgid "Channel Driver (only set for Driver F-Curves)"
msgstr "Kanaldrivrutin (anges endast för F-kurvor med drivrutin)"

#. :src: bpy.types.FCurve.extrapolation
#. :src: bpy.types.NlaStrip.extrapolation
#: source/blender/editors/space_nla/nla_buttons.cc:349
msgid "Extrapolation"
msgstr "Extrapolering"

#. :src: bpy.types.FCurve.extrapolation
msgid ""
"Method used for evaluating value of F-Curve outside first and last keyframes"
msgstr ""
"Metod för att utvärdera F-kurvans värde utanför den första och sista "
"nyckelbildrutan"

#. :src: bpy.types.FCurve.extrapolation:'CONSTANT'
msgid "Hold values of endpoint keyframes"
msgstr "Behåll värdena från nyckelbildrutorna vid slutpunkterna"

#. :src: bpy.types.FCurve.extrapolation:'LINEAR'
msgid "Use slope of curve leading in/out of endpoint keyframes"
msgstr ""
"Använd kurvans lutning in mot och ut från nyckelbildrutorna vid slutpunkterna"

#. :src: bpy.types.FCurve.group
msgid "Action Group that this F-Curve belongs to"
msgstr "Action-grupp som den här F-kurvan tillhör"

#. :src: bpy.types.FCurve.hide
msgid "F-Curve and its keyframes are hidden in the Graph Editor graphs"
msgstr ""
"F-kurvan och dess nyckelbildrutor är dolda i graferna i grafredigeraren"

#. :src: bpy.types.FCurve.is_empty
msgid ""
"True if the curve contributes no animation due to lack of keyframes or "
"useful modifiers, and should be deleted"
msgstr ""
"Sant om kurvan inte bidrar med någon animation på grund av avsaknad av "
"nyckelbildrutor eller användbara modifierare och därför bör tas bort"

#. :src: bpy.types.FCurve.is_valid
msgid ""
"False when F-Curve could not be evaluated in past, so should be skipped when "
"evaluating"
msgstr ""
"Falskt när F-kurvan inte kunde utvärderas tidigare och därför bör hoppas "
"över vid utvärdering"

#. :src: bpy.types.FCurve.keyframe_points
msgid "User-editable keyframes"
msgstr "Redigerbara nyckelbildrutor"

#. :src: bpy.types.FCurve.lock
msgid "F-Curve's settings cannot be edited"
msgstr "F-kurvans inställningar kan inte redigeras"

#. :src: bpy.types.FCurve.modifiers
#. :src: bpy.types.Object.modifiers
#. :src: bpy.types.Menu
#. :src: bpy.types.VIEW3D_MT_object_modifiers
