#: source/blender/nodes/geometry/nodes/node_geo_curve_sample.cc:29
msgid "Curves to sample positions on"
msgstr "Kurvor att provta positioner på"

#: source/blender/nodes/geometry/nodes/node_geo_sample_index.cc:28
msgid "Geometry to sample a value on"
msgstr "Geometri att provta ett värde på"

#: source/blender/nodes/geometry/nodes/node_geo_sample_nearest.cc:315
msgid "The source geometry must contain a mesh or a point cloud"
msgstr "Källgeometrin måste innehålla en mesh eller ett punktmoln"

#: source/blender/nodes/geometry/nodes/node_geo_sample_nearest_surface.cc:229
#: source/blender/nodes/geometry/nodes/node_geo_sample_uv_surface.cc:170
msgid "The source mesh must have faces"
msgstr "Källmeshen måste ha ytor"

#: source/blender/nodes/geometry/nodes/node_geo_sample_nearest_surface.cc:30
msgid "Mesh to find the closest surface point on"
msgstr "Mesh för att hitta den närmaste ytpunkten på"

#: source/blender/nodes/geometry/nodes/node_geo_sample_nearest_surface.cc:38
msgid "Splits the faces of the input mesh into groups which can be sampled individually"
msgstr "Delar upp ytorna i indatameshen i grupper som kan provtas var för sig"

#: source/blender/nodes/geometry/nodes/node_geo_sample_sound_frequencies.cc:65
msgid "Sound to sample"
msgstr "Ljud att provta"

#: source/blender/nodes/geometry/nodes/node_geo_sample_sound_frequencies.cc:69
msgid "Time in seconds of the sound to sample at"
msgstr "Tidpunkt i sekunder i ljudet att provta vid"

#: source/blender/nodes/geometry/nodes/node_geo_sample_sound_frequencies.cc:73
msgid "Mix all channels before sampling the sound (e.g. stereo to mono)"
msgstr "Blanda alla kanaler innan ljudet provtas (till exempel stereo till mono)"

#: source/blender/nodes/geometry/nodes/node_geo_sample_sound_frequencies.cc:94
msgid "The channel to sample unless 'All Channels' is checked"
msgstr "Kanalen som ska provtas om inte ”Alla kanaler” är markerat"

#: source/blender/nodes/geometry/nodes/node_geo_sample_uv_surface.cc:40
msgid "Sample UV"
msgstr "Provta UV"

#: source/blender/nodes/geometry/nodes/node_geo_sample_uv_surface.cc:31
msgid "Mesh whose UV map is used"
msgstr "Mesh vars UV-karta används"

#: source/blender/nodes/geometry/nodes/node_geo_sample_uv_surface.cc:39
msgid "The mesh UV map to sample. Should not have overlapping faces"
msgstr "Meshens UV-karta att provta. Får inte ha överlappande ytor"

#: source/blender/nodes/geometry/nodes/node_geo_sample_uv_surface.cc:41
msgid "The coordinates to sample within the UV map"
msgstr "Koordinaterna att provta inom UV-kartan"

#: source/blender/nodes/geometry/nodes/node_geo_sample_uv_surface.cc:54
msgid "Whether the node could find a single face to sample at the UV coordinate"
msgstr "Om noden kunde hitta en enskild yta att provta vid UV-koordinaten"
