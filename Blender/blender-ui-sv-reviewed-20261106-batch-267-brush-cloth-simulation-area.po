#. :src: bpy.types.Brush.cloth_sim_falloff
msgid "Area to apply deformation falloff to the effects of the simulation"
msgstr "Område där simuleringens deformationsverkan avtar"

#. :src: bpy.types.Brush.cloth_sim_limit
msgid ""
"Factor added relative to the size of the radius to limit the cloth "
"simulation effects"
msgstr ""
"Faktor som läggs till i förhållande till radien för att begränsa "
"tygsimuleringens effekter"

#. :src: bpy.types.Brush.cloth_simulation_area_type
msgid ""
"Part of the mesh that is going to be simulated when the stroke is active"
msgstr "Den del av meshen som ska simuleras när penseldraget är aktivt"

#. :src: bpy.types.Brush.cloth_simulation_area_type:'LOCAL'
msgid ""
"Simulates only a specific area around the brush limited by a fixed radius"
msgstr ""
"Simulerar endast ett specifikt område runt penseln som begränsas av en fast "
"radie"

#. :src: bpy.types.Brush.cloth_simulation_area_type:'DYNAMIC'
msgid "The active simulation area moves with the brush"
msgstr "Det aktiva simuleringsområdet flyttas med penseln"
