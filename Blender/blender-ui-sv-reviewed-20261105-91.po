msgid "World mist settings"
msgstr "Världens diminställningar"

#. :src: bpy.types.World.sun_angle
msgid "Sun Angle"
msgstr "Solvinkel"

#. :src: bpy.types.World.sun_threshold
msgid "Sun Threshold"
msgstr "Soltröskel"

#. :src: bpy.types.World.use_eevee_finite_volume
msgid "Finite Volume"
msgstr "Ändlig volym"

#. :src: bpy.types.World.use_sun_shadow
#. :src: bpy.types.GreasePencilLineartModifier.use_shadow
msgid "Use Shadow"
msgstr "Använd skugga"

#. :src: bpy.types.World.use_sun_shadow
msgid "Enable sun shadow casting"
msgstr "Aktivera kastning av solskuggor"

#. :src: bpy.types.IDOverrideLibrary
msgid "ID Library Override"
msgstr "ID-biblioteksåsidosättning"

#. :src: bpy.types.IDOverrideLibrary
msgid "Struct gathering all data needed by overridden linked IDs"
msgstr "Struktur som samlar alla data som behövs för åsidosatta länkade ID:n"

#. :src: bpy.types.IDOverrideLibrary.hierarchy_root
msgid "Hierarchy Root ID"
msgstr "Hierarkirot-ID"

#. :src: bpy.types.IDOverrideLibrary.is_in_hierarchy
msgid "Is In Hierarchy"
msgstr "Ingår i hierarki"

#. :src: bpy.types.IDOverrideLibrary.is_system_override
msgid "Is System Override"
msgstr "Är systemåsidosättning"

#. :src: bpy.types.IDOverrideLibrary.properties
msgid "List of overridden properties"
msgstr "Lista över åsidosatta egenskaper"

#. :src: bpy.types.IDOverrideLibraryProperties
msgid "Override Properties"
msgstr "Åsidosättningsegenskaper"

#. :src: bpy.types.IDOverrideLibraryProperties
msgid "Collection of override properties"
msgstr "Samling av åsidosättningsegenskaper"

#. :src: bpy.types.IDOverrideLibraryProperty.operations
msgid "List of overriding operations for a property"
msgstr "Lista över åsidosättningsåtgärder för en egenskap"

#. :src: bpy.types.IDOverrideLibraryProperty.rna_path
msgid "RNA Path"
msgstr "RNA-sökväg"

#. :src: bpy.types.IDOverrideLibraryProperty.rna_path
msgid "RNA path leading to that property, from owning ID"
msgstr "RNA-sökväg till den egenskapen, från ägar-ID:t"

#. :src: bpy.types.IDOverrideLibraryPropertyOperation
msgid "ID Library Override Property Operation"
msgstr "Åtgärd för egenskap hos ID-biblioteksåsidosättning"

#. :src: bpy.types.IDOverrideLibraryPropertyOperation
msgid "Description of an override operation over an overridden property"
msgstr "Beskrivning av en åsidosättningsåtgärd för en åsidosatt egenskap"

#. :src: bpy.types.IDOverrideLibraryPropertyOperations
msgid "Override Operations"
msgstr "Åsidosättningsoperationer"

#. :src: bpy.types.IKParam
msgid "Base type for IK solver parameters"
msgstr "Bastyp för parametrar till IK-lösaren"

#. :src: bpy.types.IKParam.ik_solver
#. :src: bpy.types.Pose.ik_solver
msgid "IK Solver"
msgstr "IK-lösare"

#. :src: bpy.types.IKParam.ik_solver
msgid "IK solver for which these parameters are defined"
msgstr "IK-lösare som dessa parametrar är definierade för"

#. :src: bpy.types.IKParam.ik_solver:'LEGACY'
#. :src: bpy.types.Pose.ik_solver:'LEGACY'
msgid "Original IK solver"
msgstr "Ursprunglig IK-lösare"

#. :src: bpy.types.IKParam.ik_solver:'ITASC'
#. :src: bpy.types.Pose.ik_solver:'ITASC'
msgid "Multi constraint, stateful IK solver"
msgstr "Tillståndsbaserad IK-lösare med flera begränsningar"

#. :src: bpy.types.Itasc.mode:'ANIMATION'
msgid ""
"Stateless solver computing pose starting from current action and non-IK "
"constraints"
msgstr ""
"Tillståndslös lösare som beräknar posen utifrån aktuell åtgärd och icke-IK-"
"begränsningar"

#. :src: bpy.types.Itasc.mode:'SIMULATION'
msgid ""
"State-full solver running in real-time context and ignoring actions and non-"
"IK constraints"
msgstr ""
"Tillståndsbaserad lösare som körs i realtidskontext och ignorerar åtgärder "
"och icke-IK-begränsningar"

#. :src: bpy.types.Itasc.reiteration_method:'NEVER'
msgid ""
"The solver does not reiterate, not even on first frame (starts from rest "
"pose)"
msgstr ""
"Lösaren itererar inte om, inte ens på den första bildrutan (startar från "
"viloposen)"

#. :src: bpy.types.Itasc.reiteration_method:'INITIAL'
msgid ""
"The solver reiterates (converges) on the first frame but not on subsequent "
"frame"
msgstr ""
"Lösaren itererar om (konvergerar) på den första bildrutan men inte på "
"följande bildruta"

#. :src: bpy.types.Itasc.reiteration_method:'ALWAYS'
msgid "The solver reiterates (converges) on all frames"
msgstr "Lösaren itererar om (konvergerar) på alla bildrutor"

#. :src: bpy.types.Itasc.step_count
msgid "Divide the frame interval into this many steps"
msgstr "Dela upp bildruteintervallet i så här många steg"

#. :src: bpy.types.Itasc.step_min
#. :src: bpy.types.SoftBodySettings.step_min
msgid "Min Step"
msgstr "Minsta steg"

#. :src: bpy.types.Itasc.translate_root_bones
msgid "Translate Roots"
msgstr "Flytta rotben"

#. :src: bpy.types.Itasc.translate_root_bones
msgid "Translate root (i.e. parentless) bones to the armature origin"
msgstr "Flytta rotben (dvs. ben utan förälder) till armaturens ursprung"

#. :src: bpy.types.Itasc.use_auto_step
msgid "Auto Step"
msgstr "Automatiskt steg"

#. :src: bpy.types.ImageFormatSettings.color_management
#. :src: bpy.types.RENDER_PT_color_management
#. :src: bpy.types.RENDER_PT_output_color_management
msgid "Color Management"
msgstr "Färghantering"

#. :src: bpy.types.ImageFormatSettings.exr_codec
msgid "Compression codec settings for OpenEXR"
msgstr "Inställningar för komprimeringskodeken för OpenEXR"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'NONE'
#. :src: bpy.types.PointCache.compression:'NO'
#. :src: bpy.types.PointCacheItem.compression:'NO'
msgid "No compression"
msgstr "Ingen komprimering"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'ZIP'
msgid "ZIP"
msgstr "ZIP"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'DWAA'
msgid "DWAA (lossy)"
msgstr "DWAA (med förlust)"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'DWAB'
msgid "DWAB (lossy)"
msgstr "DWAB (med förlust)"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'RLE'
msgid "Lossless run length encoding compression"
msgstr "Förlustfri körlängdskomprimering"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'PXR24'
msgid "Pxr24 (lossy)"
msgstr "Pxr24 (med förlust)"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'PXR24'
msgid ""
"Lossy compression for 32 bit float images (stores 24 bits of each float)"
msgstr ""
"Komprimering med förlust för 32-bitars flyttalsbilder (lagrar 24 bitar av "
"varje flyttal)"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'B44'
msgid "B44 (lossy)"
msgstr "B44 (med förlust)"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'B44'
#. :src: bpy.types.ImageFormatSettings.exr_codec:'B44A'
msgid "Lossy compression for 16 bit float images, at fixed 2.3:1 ratio"
msgstr ""
"Komprimering med förlust för 16-bitars flyttalsbilder med fast förhållande "
"2,3:1"

#. :src: bpy.types.ImageFormatSettings.exr_codec:'B44A'
msgid "B44A (lossy)"
msgstr "B44A (med förlust)"

#. :src: bpy.types.ImageFormatSettings.file_format
msgid "File format to save the rendered images as"
msgstr "Filformat att spara de renderade bilderna i"

#. :src: bpy.types.ImageFormatSettings.jpeg2k_codec
msgid "Codec settings for JPEG 2000"
msgstr "Kodekinställningar för JPEG 2000"

#. :src: bpy.types.ImageFormatSettings.stereo_3d_format
#. :src: bpy.types.ImageStrip.stereo_3d_format
#. :src: bpy.types.MovieStrip.stereo_3d_format
msgid "Settings for stereo 3D"
msgstr "Inställningar för stereoskopisk 3D"

#. :src: bpy.types.ImageFormatSettings.tiff_codec:'DEFLATE'
msgid "Deflate"
msgstr "Deflate"

#. :src: bpy.types.ImageFormatSettings.use_jpeg2k_cinema_48
msgid "Cinema (48)"
msgstr "Cinema (48)"

#. :src: bpy.types.ImageFormatSettings.use_jpeg2k_cinema_preset
msgid "Cinema"
msgstr "Cinema"

#. :src: bpy.types.ImagePackedFile.tile_number
msgid "Tile Number"
msgstr "Plattnummer"

#. :src: bpy.types.ImagePackedFile.view
msgid "View Index"
msgstr "Vyindex"

#. :src: bpy.types.ImagePreview
#. :src: bpy.types.SpaceSequenceEditor.display_mode:'IMAGE'
msgid "Image Preview"
msgstr "Bildförhandsgranskning"

#. :src: bpy.types.ImagePreview.icon_pixels
msgid "Icon Pixels"
msgstr "Ikonpixlar"

#. :src: bpy.types.ImagePreview.icon_pixels
msgid "Icon pixels, as bytes (always 32-bit RGBA)"
msgstr "Ikonpixlar som byte (alltid 32-bitars RGBA)"

#. :src: bpy.types.ImagePreview.icon_pixels_float
msgid "Float Icon Pixels"
msgstr "Flyttalsikonpixlar"

#. :src: bpy.types.ImagePreview.icon_pixels_float
msgid "Icon pixels components, as floats (RGBA concatenated values)"
msgstr "Ikonpixelkomponenter som flyttal (sammanfogade RGBA-värden)"
