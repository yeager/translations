#. :src: bpy.types.ID.is_linked_packed
msgid "Linked Packed"
msgstr "Länkat och packat"

#. :src: bpy.types.Image.alpha_mode:'CHANNEL_PACKED'
msgid "Different images are packed in the RGB and alpha channels, and they should not affect each other. Channel packing is commonly used by game engines to save memory."
msgstr "Olika bilder packas i RGB- och alfakanalerna, och de ska inte påverka varandra. Kanalpackning används ofta av spelmotorer för att spara minne."

#. :src: bpy.types.Library.archive_libraries
msgid "Archive libraries of packed IDs, generated (and owned) by this source library"
msgstr "Arkivbibliotek för packade ID:n som skapats (och ägs) av källbiblioteket"

#. :src: bpy.types.Library.archive_parent_library
msgid "Source library from which this archive of packed IDs was generated"
msgstr "Källbiblioteket som arkivet med packade ID:n skapades från"

#. :src: bpy.types.Library.is_archive
msgid "This library is an 'archive' storage for packed linked IDs originally linked from its 'archive parent' library."
msgstr "Biblioteket är ett ”arkiv” för packade länkade ID:n som ursprungligen länkades från det överordnade arkivbiblioteket."

#: source/blender/editors/space_image/image_ops.cc:4460
msgid "No UDIM tiles were created"
msgstr "Inga UDIM-plattor skapades"

#: source/blender/editors/uvedit/uvedit_unwrap_ops.cc:2937
msgid "Unwrap could not solve any island(s), edge seams may need to be added"
msgstr "UV-uppackningen kunde inte lösa någon UV-ö; UV-sömmar kan behöva läggas till"

#: source/blender/editors/uvedit/uvedit_unwrap_ops.cc:2942
#, c-format
msgid "Unwrap failed to solve %d of %d island(s), edge seams may need to be added"
msgstr "UV-uppackningen kunde inte lösa %d av %d UV-öar; UV-sömmar kan behöva läggas till"
