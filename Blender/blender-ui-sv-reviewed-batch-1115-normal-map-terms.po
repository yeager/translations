#. :src: bpy.types.ShaderNodeNormalMap.space:'BLENDER_OBJECT'
msgid "Object space normal mapping, compatible with Blender render baking"
msgstr "Normalkartläggning i objektrymd, kompatibel med Blender-renderingsbakning"

#. :src: bpy.types.ShaderNodeNormalMap.space:'BLENDER_WORLD'
msgid "World space normal mapping, compatible with Blender render baking"
msgstr "Normalkartläggning i världsrymd, kompatibel med Blender-renderingsbakning"

#. :src: bpy.types.ImageTexture.use_normal_map
msgid "Use image RGB values for normal mapping"
msgstr "Använd bildens RGB-värden för normalkartläggning"

#. :src: bpy.types.ShaderNodeNormalMap.base:'DISPLACED'
msgid ""
"Apply normal map relative to the displaced surface, for normal maps that are "
"to be applied in addition to the displacement map"
msgstr ""
"Tillämpa normalkartan relativt den förskjutna ytan för normalkartor som ska "
"tillämpas utöver förskjutningskartan"

#. :src: bpy.types.ShaderNodeNormalMap.convention:'OPENGL'
msgid ""
"Normal map uses OpenGL convention, with Y axis in the green channel pointing "
"up"
msgstr ""
"Normalkartan använder OpenGL-konventionen, med Y-axeln i den gröna kanalen "
"riktad uppåt"

#. :src: bpy.types.ShaderNodeNormalMap.convention:'DIRECTX'
msgid ""
"Normal map uses DirectX convention, with Y axis in the green channel "
"pointing down"
msgstr ""
"Normalkartan använder DirectX-konventionen, med Y-axeln i den gröna "
"kanalen riktad nedåt"

#. :src: bpy.types.ShaderNodeNormalMap.space
msgid "Space of the input normal"
msgstr "Indatanormalens koordinatrymd"

msgid "Strength of the normal mapping effect"
msgstr "Styrkan hos normalkartläggningseffekten"

msgid "Color that encodes the normal map in the specified space"
msgstr "Färg som kodar normalkartan i den angivna koordinatrymden"
