#. :src: bpy.types.ActionChannelbag.fcurves
msgid "The individual F-Curves that animate the slot"
msgstr "De enskilda F-kurvorna som animerar Action-slotten"

#. :src: bpy.types.AnimData.action_slot_handle
msgid ""
"A number that identifies which sub-set of the Action is considered to be for"
" this data-block"
msgstr ""
"Ett nummer som identifierar vilken delmängd av Actionen som anses vara för "
"detta datablock"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_action_all
msgid ""
"For bone motion paths, search whole Action for keyframes instead of in group"
" with matching name only (is slower)"
msgstr ""
"För rörelsebanor för ben söker du efter nyckelbildrutor i hela Actionen i "
"stället för endast i en grupp med matchande namn (går långsammare)"

#: scripts/startup/bl_operators/anim.py:383
msgid "Removed {:d} empty and/or fake-user only Actions"
msgstr ""
"Tog bort {:d} tomma Actioner och/eller Actioner med endast falsk användare"
