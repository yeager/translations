"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#. :src: bpy.types.SpaceView3D.show_object_select_mesh
#. :src: bpy.types.XrSessionSettings.show_object_select_mesh
msgid "Allow selection of mesh objects"
msgstr "Tillåt val av meshobjekt"

#. :src: bpy.types.View3DOverlay.show_retopology
msgid ""
"Hide the solid mesh and offset the overlay towards the view. Selection is "
"occluded by inactive geometry, unless X-Ray is enabled"
msgstr ""
"Dölj den solida meshen och förskjut överlägget mot vyn. Urvalet skymmer "
"inaktiv geometri om inte röntgen är aktiverad"

#. :src: bpy.types.View3DOverlay.show_statvis
msgid "Display statistical information about the mesh"
msgstr "Visa statistisk information om meshen"

#. :src: KM_HIERARCHY.VIEW_3D.EMPTY:'SET_USE_SELECTED'
msgctxt "WindowManager"
msgid "Select and Use Mesh Item"
msgstr "Välj och använd meshobjekt"

msgid "Expected one other selected mesh object to copy from"
msgstr "Förväntade ett annat markerat meshobjekt att kopiera från"

msgid "Both objects must be meshes"
msgstr "Båda objekten måste vara meshobjekt"

msgid "Skipping '{:s}', not a mesh"
msgstr "Hoppar över ”{:s}” eftersom det inte är ett meshobjekt"

msgid "Select at least one mesh object"
msgstr "Välj minst ett meshobjekt"

msgid "Active object is not a mesh"
msgstr "Det aktiva objektet är inte ett meshobjekt"

msgid "Select two mesh objects"
msgstr "Välj två meshobjekt"

#. :src: bpy.types.Paint.use_cavity
msgid "Mask painting according to mesh geometry cavity"
msgstr "Maskmålning utifrån håligheter i meshgeometrin"

#. :src: bpy.types.ImagePaint.missing_uvs
msgid "A UV layer is missing on the mesh"
msgstr "Ett UV-lager saknas i meshen"

#. :src: bpy.types.Sculpt.detail_refine_method
msgid "In dynamic-topology mode, how to add or remove mesh detail"
msgstr ""
"Hur meshdetalj ska läggas till eller tas bort i läget för dynamisk topologi"

#. :src: bpy.types.Sculpt.detail_refine_method:'SUBDIVIDE'
msgid "Subdivide long edges to add mesh detail where needed"
msgstr "Dela upp långa kanter för att lägga till meshdetalj där det behövs"

#. :src: bpy.types.Sculpt.detail_refine_method:'COLLAPSE'
msgid "Collapse short edges to remove mesh detail where possible"
msgstr "Fäll ihop korta kanter för att ta bort meshdetalj där det är möjligt"

#. :src: bpy.types.Sculpt.detail_refine_method:'SUBDIVIDE_COLLAPSE'
msgid ""
"Both subdivide long edges and collapse short edges to refine mesh detail"
msgstr ""
"Dela både upp långa kanter och fäll ihop korta kanter för att förfina "
"meshdetaljen"

#. :src: bpy.types.Sculpt.detail_type_method
msgid "In dynamic-topology mode, how mesh detail size is calculated"
msgstr "Hur storleken på meshdetaljen beräknas i läget för dynamisk topologi"

#. :src: bpy.types.Sculpt.transform_mode:'ALL_VERTICES'
msgid "Applies the transformation to all vertices in the mesh"
msgstr "Tillämpa transformeringen på alla hörnpunkter i meshen"

#. :src: bpy.types.RigidBodyObject.mesh_source
msgid "Source of the mesh used to create collision shape"
msgstr "Källa till meshen som används för att skapa kollisionsformen"

#. :src: bpy.types.SpaceView3D.show_object_viewport_mesh
#. :src: bpy.types.XrSessionSettings.show_object_viewport_mesh
msgid "Show mesh objects"
msgstr "Visa meshobjekt"

#. :src: bpy.types.UV_OT_project_from_view
msgid "Project the UV vertices of the mesh as seen in current 3D view"
msgstr "Projicera UV-hörnpunkterna i meshen som de visas i den aktuella 3D-vyn"

#. :src: bpy.types.UV_OT_seams_from_islands
msgid "Set mesh seams according to island setup in the UV editor"
msgstr "Ange meshsömmar enligt öarnas konfiguration i UV-redigeraren"

#. :src: bpy.types.UV_OT_smart_project
msgid "Projection unwraps the selected faces of mesh objects"
msgstr "Projektionen vecklar ut markerade ytor på meshobjekt"

#. :src: bpy.types.UV_OT_sphere_project
msgid "Project the UV vertices of the mesh over the curved surface of a sphere"
msgstr "Projicera UV-hörnpunkterna i meshen över den böjda ytan på en sfär"

#. :src: bpy.types.UV_OT_unwrap
msgid "Unwrap the mesh of the object being edited"
msgstr "Veckla ut meshen för objektet som redigeras"

#. :src: bpy.types.WM_OT_obj_export.export_object_groups
msgid "Append mesh name to object name, separated by a '_'"
msgstr "Lägg till meshens namn i objektnamnet, avgränsat med ”_”"

#. :src: bpy.types.WM_OT_usd_export.export_mesh_colors
msgid "Include mesh color attributes in the export"
msgstr "Inkludera meshens färgattribut i exporten"

#. :src: bpy.types.WM_OT_usd_import.read_mesh_attributes
msgid "Read USD Primvars as mesh attributes"
msgstr "Läs USD-Primvars som meshattribut"

#. :src: bpy.types.WM_OT_usd_import.read_mesh_colors
msgid "Read mesh color attributes"
msgstr "Läs meshens färgattribut"

#. :src: bpy.types.SCULPT_OT_trim_lasso_gesture
msgid ""
"Execute a boolean operation on the mesh and a shape defined by the cursor"
msgstr ""
"Utför en boolesk operation på meshen och en form som definieras av markören"

#. :src: bpy.types.SCULPT_OT_trim_line_gesture
msgid "Remove a portion of the mesh on one side of a line"
msgstr "Ta bort en del av meshen på ena sidan av en linje"

#. :src: bpy.types.SCULPT_OT_trim_polyline_gesture
msgid ""
"Execute a boolean operation on the mesh and a polygonal shape defined by the "
"cursor"
msgstr ""
"Utför en boolesk operation på meshen och en polygonal form som definieras av "
"markören"

#. :src: bpy.types.UV_OT_cube_project
msgid "Project the UV vertices of the mesh over the six faces of a cube"
msgstr "Projicera UV-hörnpunkterna i meshen över de sex ytorna på en kub"

#. :src: bpy.types.UV_OT_cylinder_project
msgid "Project the UV vertices of the mesh over the curved wall of a cylinder"
msgstr ""
"Projicera UV-hörnpunkterna i meshen över den böjda väggen på en cylinder"

#. :src: bpy.types.UV_OT_export_layout.modified
msgid "Exports UVs from the modified mesh"
msgstr "Exporterar UV-koordinater från den modifierade meshen"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_CONTEXT:'ALL_FACES'
msgid "Pack all faces in the mesh"
msgstr "Packa alla ytor i meshen"

#. :src: bpy.types.UV_OT_unwrap.fill_holes
msgid ""
"Virtually fill holes in mesh before unwrapping, to better avoid overlaps and "
"preserve symmetry"
msgstr ""
"Fyll virtuellt hål i meshen före uppackning för att bättre undvika "
"överlappningar och bevara symmetrin"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'INFLATE'
msgid "Inflate mesh"
msgstr "Blås upp meshen"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'SURFACE_SMOOTH'
msgid "Smooth the surface of the mesh, preserving the volume"
msgstr "Jämna ut meshytan och bevara volymen"

#. :src: bpy.types.SCULPT_OT_mesh_filter.type:'SHARPEN'
msgid "Sharpen the cavities of the mesh"
msgstr "Gör hålrummen i meshen skarpare"

#. :src: bpy.types.SCULPT_OT_paint_mask_extract
msgid "Create a new mesh object from the current paint mask"
msgstr "Skapa ett nytt meshobjekt från den aktuella målningsmasken"

#. :src: bpy.types.SCULPT_OT_paint_mask_extract.mask_threshold
#. :src: bpy.types.SCULPT_OT_paint_mask_slice.mask_threshold
msgid ""
"Minimum mask value to consider the vertex valid to extract a face from the "
"original mesh"
msgstr ""
"Minsta maskvärde för att betrakta hörnpunkten som giltig för att extrahera "
"en yta från den ursprungliga meshen"

#. :src: bpy.types.SCULPT_OT_paint_mask_slice
msgid "Slices the paint mask from the mesh"
msgstr "Skär ut målningsmasken från meshen"

#. :src: bpy.types.SCULPT_OT_sample_detail_size
msgid "Sample the mesh detail on clicked point"
msgstr "Provta meshdetaljen på den klickade punkten"

#. :src: bpy.types.SCULPT_OT_set_persistent_base
msgid "Reset the copy of the mesh that is being sculpted on"
msgstr "Återställ kopian av meshen som skulpteras på"

#. :src: bpy.types.SCULPT_OT_trim_box_gesture
msgid ""
"Execute a boolean operation on the mesh and a rectangle defined by the cursor"
msgstr ""
"Utför en boolesk operation på meshen och en rektangel som definieras av "
"markören"

#. :src: bpy.types.SCULPT_OT_trim_line_gesture.trim_mode:'JOIN'
#. :src: bpy.types.SCULPT_OT_trim_polyline_gesture.trim_mode:'JOIN'
msgid ""
"Join the new mesh as separate geometry, without performing any boolean "
"operation"
msgstr ""
"Sammanfoga den nya meshen som separat geometri utan att utföra någon boolesk "
"operation"

#. :src: bpy.types.SCULPT_OT_face_set_extract
msgid "Create a new mesh object from the selected face set"
msgstr "Skapa ett nytt meshobjekt från den valda ytuppsättningen"

#. :src: bpy.types.SCULPT_OT_face_set_extract.apply_shrinkwrap
#. :src: bpy.types.SCULPT_OT_paint_mask_extract.apply_shrinkwrap
msgid "Project the extracted mesh into the original sculpt"
msgstr "Projicera den extraherade meshen på den ursprungliga skulpturen"

#. :src: bpy.types.SCULPT_OT_face_set_extract.smooth_iterations
#. :src: bpy.types.SCULPT_OT_paint_mask_extract.smooth_iterations
msgid "Smooth iterations applied to the extracted mesh"
msgstr "Utjämningsiterationer som tillämpas på den extraherade meshen"

#. :src: bpy.types.SCULPT_OT_face_sets_create.mode:'ALL'
msgid "Face Set Full Mesh"
msgstr "Ytuppsättning för hela meshen"

#. :src: bpy.types.SCULPT_OT_face_sets_init
msgid "Initializes all face sets in the mesh"
msgstr "Initierar alla ytuppsättningar i meshen"

#. :src: bpy.types.SCULPT_OT_face_sets_init.mode:'LOOSE_PARTS'
msgid "Create a face set per loose part in the mesh"
msgstr "Skapa en ytuppsättning per lös del i meshen"

#. :src: bpy.types.SCULPT_OT_face_sets_init.mode:'NORMALS'
msgid "Face Sets from Mesh Normals"
msgstr "Ytuppsättningar från meshnormaler"

#. :src: bpy.types.SCULPT_OT_mask_from_boundary.boundary_mode:'MESH'
msgid "Calculate the boundary mask based on disconnected mesh topology islands"
msgstr "Beräkna gränsmasken baserat på frånkopplade meshöar"

#. :src: bpy.types.SCULPT_OT_mask_init
msgid "Creates a new mask for the entire mesh"
msgstr "Skapar en ny mask för hela meshen"

#. :src: bpy.types.SCULPT_OT_mesh_filter
msgid "Applies a filter to modify the current mesh"
msgstr "Tillämpar ett filter för att ändra den aktuella meshen"

#. :src: bpy.types.SCULPT_OT_cloth_filter
msgid "Applies a cloth simulation deformation to the entire mesh"
msgstr "Tillämpa en tygsimuleringsdeformering på hela meshen"

#. :src: bpy.types.SCULPT_OT_cloth_filter.type
#. :src: bpy.types.SCULPT_OT_mesh_filter.type
msgid "Operation that is going to be applied to the mesh"
msgstr "Åtgärd som ska tillämpas på meshen"

#. :src: bpy.types.SCULPT_OT_cloth_filter.type:'SCALE'
msgid "Scales the mesh as a soft body using the origin of the object as scale"
msgstr ""
"Skalerar meshen som en mjuk kropp med hjälp av objektets ursprung som skala"

#. :src: bpy.types.SCULPT_OT_detail_flood_fill
msgid "Flood fill the mesh with the selected detail setting"
msgstr "Fyll meshen med den valda detaljinställningen"

#. :src: bpy.types.SCULPT_OT_dynamic_topology_toggle
msgid "Dynamic topology alters the mesh topology while sculpting"
msgstr "Dynamisk topologi ändrar meshtopologin under skulpteringen"

#. :src: bpy.types.SCULPT_OT_expand.max_geodesic_move_preview
msgid ""
"Maximum number of vertices in the mesh for using geodesic falloff when "
"moving the origin of expand. If the total number of vertices is greater than "
"this value, the falloff will be set to spherical when moving"
msgstr ""
"Maximalt antal hörnpunkter i meshen för att använda geodetisk avklingning "
"när utökningens ursprung flyttas. Om det totala antalet hörnpunkter är "
"större än detta värde blir avklingningen sfärisk vid flyttning"

#. :src: bpy.types.SCULPT_OT_face_set_edit.mode:'GROW'
msgid "Grows the face set boundary by one face based on mesh topology"
msgstr "Utökar ytuppsättningsgränsen med en yta utifrån meshtopologin"

#. :src: bpy.types.SCULPT_OT_face_set_edit.mode:'SHRINK'
msgid "Shrinks the face set boundary by one face based on mesh topology"
msgstr "Minskar ytuppsättningsgränsen med en yta utifrån meshtopologin"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_mesh_symmetry
msgid "Generates a symmetrical mesh using the mesh symmetry configuration"
msgstr "Genererar en symmetrisk mesh med meshens symmetrikonfiguration"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_sharp
msgid "Try to preserve sharp features on the mesh"
msgstr "Försök att bevara skarpa detaljer på meshen"

#. :src: bpy.types.OBJECT_OT_surfacedeform_bind
msgid "Bind mesh to target in surface deform modifier"
msgstr "Bind meshen till målet i ytdeformeringsmodifieraren"

#. :src: bpy.types.OBJECT_OT_voxel_remesh
msgid ""
"Calculates a new manifold mesh based on the volume of the current mesh. All "
"data layers will be lost"
msgstr ""
"Beräknar en ny manifold-mesh utifrån volymen av den aktuella meshen. Alla "
"datalager går förlorade"

#. :src: bpy.types.PAINT_OT_add_simple_uvs
msgid "Add cube map UVs on mesh"
msgstr "Lägg till UV:er för kubavbildning på meshen"

#. :src: bpy.types.PAINT_OT_visibility_filter
msgid "Edit the visibility of the current mesh"
msgstr "Redigera synligheten för den aktuella meshen"

#. :src: bpy.types.PAINT_OT_visibility_filter.action:'GROW'
msgid "Grow the visibility by one face based on mesh topology"
msgstr "Öka synligheten med en yta utifrån meshtopologin"

#. :src: bpy.types.PAINT_OT_visibility_filter.action:'SHRINK'
msgid "Shrink the visibility by one face based on mesh topology"
msgstr "Minska synligheten med en yta utifrån meshtopologin"

#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode
msgid "How the mesh is going to be subdivided to create a new level"
msgstr "Hur meshen ska delas upp för att skapa en ny nivå"

#. :src: bpy.types.OBJECT_OT_multires_unsubdivide
msgid "Rebuild a lower subdivision level of the current base mesh"
msgstr "Återuppbygg en lägre underindelningsnivå av den aktuella basmeshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh
msgid ""
"Create a new quad based mesh using the surface data of the current mesh. All "
"data layers will be lost"
msgstr ""
"Skapa en ny fyrhörningsbaserad mesh med ytdata från den aktuella meshen. "
"Alla datalager går förlorade"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode
msgid "How to specify the amount of detail for the new mesh"
msgstr "Hur detaljnivån för den nya meshen ska anges"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'RATIO'
msgid "Specify target number of faces relative to the current mesh"
msgstr "Ange målantalet ytor i förhållande till den aktuella meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'EDGE'
msgid "Input target edge length in the new mesh"
msgstr "Ange målkantlängd i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'FACES'
msgid "Input target number of faces in the new mesh"
msgstr "Ange målantalet ytor i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.preserve_attributes
msgid "Reproject attributes onto the new mesh"
msgstr "Reprojektera attribut på den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.smooth_normals
msgid "Set the output mesh normals to smooth"
msgstr "Ange att utmeshens normaler ska vara jämna"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_edge_length
msgid "Target edge length in the new mesh"
msgstr "Målkantlängd i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_faces
msgid "Approximate number of faces (quads) in the new mesh"
msgstr "Ungefärligt antal ytor (fyrkanter) i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_ratio
msgid "Relative number of faces compared to the current mesh"
msgstr "Relativt antal ytor jämfört med den aktuella meshen"

#. :src: bpy.types.Modifier.type:'LAPLACIANSMOOTH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'LAPLACIANSMOOTH'
msgid "Reduce the noise on a mesh surface with minimal changes to its shape"
msgstr "Minska bruset på en meshyta med minimala förändringar av dess form"

#. :src: bpy.types.Modifier.type:'SURFACE_DEFORM'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SURFACE_DEFORM'
msgid "Transfer motion from another mesh"
msgstr "Överför rörelse från en annan mesh"

#. :src: bpy.types.Modifier.type:'WARP'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'WARP'
msgid ""
"Warp parts of a mesh to a new location in a very flexible way thanks to 2 "
"specified objects"
msgstr ""
"Förvräng delar av en mesh till en ny plats på ett mycket flexibelt sätt med "
"hjälp av två angivna objekt"

#. :src: bpy.types.Modifier.type:'EXPLODE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'EXPLODE'
msgid "Break apart the mesh faces and let them follow particles"
msgstr "Dela upp meshytorna och låt dem följa partiklarna"

#. :src: bpy.types.Modifier.type:'MESH_DEFORM'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_DEFORM'
msgid "Deform using a different mesh, which acts as a deformation cage"
msgstr "Deformera med en annan mesh som fungerar som en deformationsbur"

#. :src: bpy.types.BakeSettings.use_lores_mesh
msgid "Low Resolution Mesh"
msgstr "Lågupplöst mesh"

#. :src: bpy.types.BakeSettings.use_lores_mesh
msgid "Calculate heights against unsubdivided low resolution mesh"
msgstr "Beräkna höjder mot en lågupplöst mesh utan underindelning"

#. :src: bpy.types.FluidFlowSettings.surface_distance
msgid ""
"Height (in domain grid units) of fluid emission above the mesh surface. "
"Higher values result in emission further away from the mesh surface. If this "
"value and the emitter size are smaller than the domain grid unit, fluid will "
"not be created"
msgstr ""
"Höjd, i domänrutnätsenheter, för vätskeemission ovanför meshens yta. Högre "
"värden ger emission längre från meshens yta. Om värdet och emitterarens "
"storlek är mindre än domänrutnätsenheten skapas ingen vätska"

#. :src: bpy.types.Modifier.type:'REMESH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'REMESH'
msgid "Generate new mesh topology based on the current shape"
msgstr "Skapa ny meshtopologi utifrån den aktuella formen"

#. :src: bpy.types.Brush.mesh_automasking_settings
#. :src: bpy.types.Paint.mesh_automasking_settings
msgid "Mesh Automasking Settings"
msgstr "Inställningar för automatisk maskning av mesh"

#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND_REUSE'
msgid ""
"Import the asset as copied data-block while avoiding multiple copies of "
"nested, typically heavy data. For example the textures of a material asset, "
"or the mesh of an object asset, don't have to be copied every time this "
"asset is imported. The instances of the asset share the data instead"
msgstr ""
"Importera resursen som ett kopierat datablock och undvik flera kopior av "
"nästlade, vanligen tunga data. Till exempel behöver texturerna i en "
"materialresurs eller meshen i en objektresurs inte kopieras varje gång "
"resursen importeras. Resursinstanserna delar i stället data"

#. :src: bpy.types.Mesh.texture_mesh
msgid "Use another mesh for texture indices (vertex indices must be aligned)"
msgstr ""
"Använd en annan mesh för texturindex (hörnpunktsindex måste vara justerade)"

#. :src: bpy.types.MeshAutomaskingSettings
msgid "Automasking settings for mesh painting & sculpting."
msgstr "Inställningar för automatisk maskning vid meshmålning och skulptering."

msgid "Mesh does not have an active color attribute \"%s\""
msgstr "Meshen saknar det aktiva färgattributet ”%s”"

#. :src: bpy.types.BevelModifier.vmesh_method
msgid "The method to use to create the mesh at intersections"
msgstr "Metoden som ska användas för att skapa meshen vid korsningar"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'NEAREST_SURFACEPOINT'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'NEAREST_SURFACEPOINT'
msgid "Shrink the mesh to the nearest target surface"
msgstr "Anpassa meshen till närmaste målyta"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'PROJECT'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'PROJECT'
msgid "Shrink the mesh to the nearest target surface along a given axis"
msgstr "Anpassa meshen till närmaste målyta längs en given axel"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'NEAREST_VERTEX'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'NEAREST_VERTEX'
msgid "Shrink the mesh to the nearest target vertex"
msgstr "Anpassa meshen till närmaste målhörnpunkt"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'TARGET_PROJECT'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'TARGET_PROJECT'
msgid ""
"Shrink the mesh to the nearest target surface along the interpolated vertex "
"normals of the target"
msgstr ""
"Anpassa meshen till närmaste målyta längs målets interpolerade "
"hörnpunktsnormaler"

#. :src: bpy.types.MaskModifier
msgid "Mask modifier to hide parts of the mesh"
msgstr "Maskmodifierare för att dölja delar av meshen"

#. :src: bpy.types.MultiresModifier.use_custom_normals
#. :src: bpy.types.SubsurfModifier.use_custom_normals
msgid "Interpolates existing custom normals to resulting mesh"
msgstr ""
"Interpolerar befintliga anpassade normaler till den resulterande meshen"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'NON_MANIFOLD'
msgid ""
"Output a manifold mesh even if the base mesh is non-manifold, where edges "
"have 3 or more connecting faces. This method is slower."
msgstr ""
"Skapa en manifold-mesh även om basmeshen inte är manifold, där kanterna har "
"tre eller fler anslutande ytor. Denna metod är långsammare."

#. :src: bpy.types.MeshToVolumeModifier.interior_band_width
msgid "Width of the gradient inside of the mesh"
msgstr "Bredden på gradienten inuti meshen"

#. :src: bpy.types.MirrorModifier.use_bisect_axis
msgid "Cuts the mesh across the mirror plane"
msgstr "Skär meshen tvärs över spegelplanet"

#. :src: bpy.types.MultiresModifier.use_sculpt_base_mesh
msgid "Sculpt Base Mesh"
msgstr "Skulptera basmesh"

#. :src: bpy.types.MultiresModifier.use_sculpt_base_mesh
msgid ""
"Make Sculpt Mode tools deform the base mesh while previewing the "
"displacement of higher subdivision levels"
msgstr ""
"Låt verktygen i skulpteringsläget deformera basmeshen medan förskjutningen "
"av högre underindelningsnivåer förhandsgranskas"

#. :src: bpy.types.ParticleInstanceModifier.space
msgid "Space to use for copying mesh data"
msgstr "Koordinatutrymme som används för kopiering av meshdata"

#. :src: bpy.types.SurfaceDeformModifier.is_bound
msgid "Whether geometry has been bound to target mesh"
msgstr "Om geometrin har kopplats till målmeshen"

#. :src: bpy.types.VolumeToMeshModifier.grid_name
msgid "Grid in the volume object that is converted to a mesh"
msgstr "Rutnätet i volymobjektet som konverteras till en mesh"

#. :src: bpy.types.VolumeToMeshModifier.threshold
msgid "Voxels with a larger value are inside the generated mesh"
msgstr "Voxlar med ett högre värde ligger inuti den genererade meshen"

