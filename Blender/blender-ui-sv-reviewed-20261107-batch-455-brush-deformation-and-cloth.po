#. :src: bpy.types.Brush.boundary_deform_type
#. :src: bpy.types.Brush.cloth_deform_type
#. :src: bpy.types.Brush.elastic_deform_type
#. :src: bpy.types.Brush.slide_deform_type
#. :src: bpy.types.Brush.smear_deform_type
msgctxt "Brush"
msgid "Deformation"
msgstr "Deformation"

#. :src: bpy.types.Brush.boundary_deform_type
#. :src: bpy.types.Brush.cloth_deform_type
#. :src: bpy.types.Brush.elastic_deform_type
#. :src: bpy.types.Brush.pose_deform_type
#. :src: bpy.types.Brush.slide_deform_type
#. :src: bpy.types.Brush.smear_deform_type
#. :src: bpy.types.Brush.smooth_deform_type
#. :src: bpy.types.Brush.snake_hook_deform_type
msgid "Deformation type that is used in the brush"
msgstr "Deformationstyp som används i penseln"

#. :src: bpy.types.Brush.boundary_deform_type:'EXPAND'
#. :src: bpy.types.Brush.cloth_deform_type:'EXPAND'
#. :src: bpy.types.Brush.slide_deform_type:'EXPAND'
#. :src: bpy.types.Brush.smear_deform_type:'EXPAND'
msgctxt "Brush"
msgid "Expand"
msgstr "Expandera"

#. :src: bpy.types.Brush.boundary_deform_type:'INFLATE'
#. :src: bpy.types.Brush.cloth_deform_type:'INFLATE'
#. :src: bpy.types.Brush.sculpt_tool:'INFLATE'
msgctxt "Brush"
msgid "Inflate"
msgstr "Blås upp"

#. :src: bpy.types.Brush.boundary_deform_type:'GRAB'
#. :src: bpy.types.Brush.cloth_deform_type:'GRAB'
#. :src: bpy.types.Brush.elastic_deform_type:'GRAB'
#. :src: bpy.types.Brush.sculpt_tool:'GRAB'
msgctxt "Brush"
msgid "Grab"
msgstr "Flytta"

#. :src: bpy.types.Brush.boundary_deform_type:'TWIST'
#. :src: bpy.types.Brush.elastic_deform_type:'TWIST'
msgctxt "Brush"
msgid "Twist"
msgstr "Vridning"

#. :src: bpy.types.Brush.boundary_falloff_type
msgid "Boundary Falloff"
msgstr "Avtagande vid gräns"

#. :src: bpy.types.Brush.boundary_falloff_type
msgid "How the brush falloff is applied across the boundary"
msgstr "Hur penselns avtagande tillämpas över gränsen"

#. :src: bpy.types.Brush.boundary_falloff_type:'CONSTANT'
msgid "Applies the same deformation in the entire boundary"
msgstr "Tillämpar samma deformation i hela gränsen"

#. :src: bpy.types.Brush.boundary_falloff_type:'RADIUS'
msgid "Brush Radius"
msgstr "Penselradie"

#. :src: bpy.types.Brush.boundary_falloff_type:'RADIUS'
msgid "Applies the deformation in a localized area limited by the brush radius"
msgstr ""
"Tillämpar deformationen i ett lokalt område som begränsas av penselradien"

#. :src: bpy.types.Brush.boundary_falloff_type:'LOOP'
#. :src: bpy.types.IMPORT_ANIM_OT_bvh.use_cyclic
msgid "Loop"
msgstr "Slinga"

#. :src: bpy.types.Brush.boundary_falloff_type:'LOOP'
msgid "Applies the brush falloff in a loop pattern"
msgstr "Tillämpar penselns avtagande i ett slingmönster"

#. :src: bpy.types.Brush.boundary_falloff_type:'LOOP_INVERT'
msgid "Loop and Invert"
msgstr "Slinga och invertera"

#. :src: bpy.types.Brush.boundary_falloff_type:'LOOP_INVERT'
msgid ""
"Applies the falloff radius in a loop pattern, inverting the displacement "
"direction in each pattern repetition"
msgstr ""
"Tillämpar radien för avtagande i ett slingmönster och inverterar "
"förskjutningsriktningen vid varje mönsterupprepning"

#. :src: bpy.types.Brush.boundary_offset
msgid "Boundary Origin Offset"
msgstr "Förskjutning av gränsens ursprung"

#. :src: bpy.types.Brush.boundary_offset
msgid "Offset of the boundary origin in relation to the brush radius"
msgstr "Förskjutning av gränsens ursprung i förhållande till penselns radie"

#. :src: bpy.types.Brush.brush_capabilities
msgid "Brush's capabilities"
msgstr "Penselns funktioner"

#. :src: bpy.types.Brush.cloth_constraint_softbody_strength
msgid "Soft Body Plasticity"
msgstr "Plasticitet i mjuka kroppar"

#. :src: bpy.types.Brush.cloth_constraint_softbody_strength
msgid "How much the cloth preserves the original shape, acting as a soft body"
msgstr ""
"Hur väl tyget behåller sin ursprungliga form när det fungerar som en mjuk "
"kropp"

#. :src: bpy.types.Brush.cloth_damping
#. :src: bpy.types.SCULPT_OT_cloth_filter.cloth_damping
msgid "Cloth Damping"
msgstr "Tygdämpning"

#. :src: bpy.types.Brush.cloth_damping
#. :src: bpy.types.SCULPT_OT_cloth_filter.cloth_damping
msgid "How much the applied forces are propagated through the cloth"
msgstr "Hur mycket de tillämpade krafterna fortplantas genom tyget"

#. :src: bpy.types.Brush.cloth_deform_type:'DRAG'
#. :src: bpy.types.Brush.slide_deform_type:'DRAG'
#. :src: bpy.types.Brush.smear_deform_type:'DRAG'
msgctxt "Brush"
msgid "Drag"
msgstr "Dra"

#. :src: bpy.types.Brush.cloth_deform_type:'PUSH'
msgctxt "Brush"
msgid "Push"
msgstr "Tryck"

#. :src: bpy.types.Brush.cloth_deform_type:'PINCH_POINT'
msgctxt "Brush"
msgid "Pinch Point"
msgstr "Nypunkt"

#. :src: bpy.types.Brush.cloth_deform_type:'PINCH_PERPENDICULAR'
msgctxt "Brush"
msgid "Pinch Perpendicular"
msgstr "Nyp vinkelrätt"

#. :src: bpy.types.Brush.cloth_deform_type:'SNAKE_HOOK'
#. :src: bpy.types.Brush.sculpt_tool:'SNAKE_HOOK'
msgctxt "Brush"
msgid "Snake Hook"
msgstr "Ormkrok"

#. :src: bpy.types.Brush.cloth_force_falloff_type
msgid "Force Falloff"
msgstr "Kraftavtagande"

#. :src: bpy.types.Brush.cloth_force_falloff_type
msgid "Shape used in the brush to apply force to the cloth"
msgstr "Form som används av penseln för att tillämpa kraft på tyget"

#. :src: bpy.types.Brush.cloth_mass
#. :src: bpy.types.SCULPT_OT_cloth_filter.cloth_mass
msgid "Cloth Mass"
msgstr "Tygmassa"

#. :src: bpy.types.Brush.cloth_mass
#. :src: bpy.types.SCULPT_OT_cloth_filter.cloth_mass
msgid "Mass of each simulation particle"
msgstr "Massa för varje simuleringspartikel"

#. :src: bpy.types.Brush.cloth_sim_falloff
msgid "Simulation Falloff"
msgstr "Simuleringsavklingning"

#. :src: bpy.types.Brush.cloth_sim_falloff
msgid "Area to apply deformation falloff to the effects of the simulation"
msgstr "Område där simuleringens deformationsverkan avtar"

#. :src: bpy.types.Brush.cloth_sim_limit
msgid "Simulation Limit"
msgstr "Simuleringsgräns"

#. :src: bpy.types.Brush.cloth_sim_limit
msgid ""
"Factor added relative to the size of the radius to limit the cloth "
"simulation effects"
msgstr ""
"Faktor som läggs till i förhållande till radien för att begränsa "
"tygsimuleringens effekter"

#. :src: bpy.types.Brush.cloth_simulation_area_type
msgid "Simulation Area"
msgstr "Simuleringsområde"

#. :src: bpy.types.Brush.cloth_simulation_area_type
msgid ""
"Part of the mesh that is going to be simulated when the stroke is active"
msgstr "Den del av meshen som ska simuleras när penseldraget är aktivt"

#. :src: bpy.types.Brush.cloth_simulation_area_type:'LOCAL'
msgid ""
"Simulates only a specific area around the brush limited by a fixed radius"
msgstr ""
"Simulerar endast ett specifikt område runt penseln som begränsas av en fast "
"radie"
