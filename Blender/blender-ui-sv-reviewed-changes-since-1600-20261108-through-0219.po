#. :src: bpy.types.TOPBAR_PT_tool_settings_extra
msgid ""
"\n"
"Popover panel for adding extra options that don't fit in the tool settings "
"header"
msgstr ""
"\n"
"Utfällbar panel för extra alternativ som inte ryms i "
"verktygsinställningarnas rubrik"

msgid "%s: Cannot generate a textures directory path for anonymous stage"
msgstr ""
"%s: Det går inte att skapa en sökväg till texturkatalogen för en anonym scen"

msgid "%s: Couldn't determine package-relative file name from path %s"
msgstr "%s: Kunde inte bestämma paketrelativt filnamn från sökvägen %s"

msgid ""
"%s: Couldn't find a common Xform ancestor for skinned prim %s and skeleton "
"%s to convert to a USD SkelRoot. This can be addressed by setting a root "
"primitive in the export options"
msgstr ""
"%s: Kunde inte hitta en gemensam Xform-förfader för skinnad prim %s och "
"skelett %s för att konvertera till en USD SkelRoot. Detta kan åtgärdas genom "
"att ange en rotprimitiv i exportalternativen"

msgid "%s: Couldn't get blendshape targets for prim %s"
msgstr "%s: Kunde inte hämta morfmål för prim %s"

msgid "%s: Couldn't get offsets for blend shape %s"
msgstr "%s: Kunde inte hämta förskjutningar för formnyckeln %s"

msgid "%s: No offsets for blend shape %s"
msgstr "%s: Inga förskjutningar för formnyckeln %s"

msgid ""
"%s: Number of blendshapes does not match number of blendshape targets for "
"prim %s"
msgstr ""
"%s: Antalet formnycklar stämmer inte överens med antalet morfmål för prim %s"

msgid "%s: Texture import directory path empty, couldn't import %s"
msgstr ""
"%s: Sökvägen till texturimportkatalogen är tom; det gick inte att importera "
"%s"

msgid ""
"%s: import directory is relative but the blend file path is empty. Please "
"save the blend file before importing the USD or provide an absolute import "
"directory path. Cannot import %s"
msgstr ""
"%s: Importkatalogen är relativ men sökvägen till .blend-filen är tom. "
"Spara .blend-filen innan du importerar USD eller ange en absolut sökväg till "
"importkatalogen. Det går inte att importera %s"

