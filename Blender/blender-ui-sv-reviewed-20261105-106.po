#. :src: bpy.types.GreasePencilMultiplyModifier
msgid "Multiply Modifier"
msgstr "Multiplikatormodifierare"

#. :src: bpy.types.GreasePencilMultiplyModifier.distance
msgid "Distance of duplications"
msgstr "Avstånd mellan dubbletter"

#. :src: bpy.types.GreasePencilMultiplyModifier.fading_center
msgid "Fade center"
msgstr "Uttoningscentrum"

#. :src: bpy.types.GreasePencilMultiplyModifier.offset
msgid "Offset of duplicates, -1 to 1 (inner to outer)"
msgstr "Förskjutning av dubbletter, -1 till 1 (inre till yttre)"

#. :src: bpy.types.GreasePencilNoiseModifier
msgid "Grease Pencil Noise Modifier"
msgstr "Grease Pencil-brusmodifierare"

#. :src: bpy.types.GreasePencilNoiseModifier
msgid "Noise effect modifier"
msgstr "Brusmodifierare"

#. :src: bpy.types.GreasePencilNoiseModifier.factor
msgid "Position Factor"
msgstr "Positionsfaktor"

#. :src: bpy.types.GreasePencilNoiseModifier.factor
msgid "Amount of noise to apply"
msgstr "Mängd brus att tillämpa"

#. :src: bpy.types.GreasePencilNoiseModifier.factor_thickness
#. :src: bpy.types.GreasePencilThickModifierData.thickness_factor
msgid "Thickness Factor"
msgstr "Tjockleksfaktor"

#. :src: bpy.types.GreasePencilNoiseModifier.factor_thickness
msgid "Amount of noise to apply to thickness"
msgstr "Mängd brus att tillämpa på tjockleken"

#. :src: bpy.types.GreasePencilNoiseModifier.noise_offset
#: source/blender/modifiers/intern/MOD_grease_pencil_length.cc:305
msgid "Noise Offset"
msgstr "Brusförskjutning"

#. :src: bpy.types.GreasePencilNoiseModifier.noise_offset
msgid "Offset the noise along the strokes"
msgstr "Förskjut bruset längs strecken"

#. :src: bpy.types.GreasePencilNoiseModifier.random_mode
msgid "Where to perform randomization"
msgstr "Var slumpningen ska utföras"

#. :src: bpy.types.GreasePencilNoiseModifier.random_mode:'STEP'
msgid "Randomize every number of frames"
msgstr "Slumpa efter ett angivet antal bildrutor"

#. :src: bpy.types.GreasePencilNoiseModifier.random_mode:'KEYFRAME'
msgctxt "GPencil"
msgid "Keyframes"
msgstr "Nyckelbildrutor"

#. :src: bpy.types.GreasePencilNoiseModifier.random_mode:'KEYFRAME'
msgid "Randomize on keyframes only"
msgstr "Slumpa endast vid nyckelbildrutor"

#. :src: bpy.types.GreasePencilNoiseModifier.seed
msgid "Noise Seed"
msgstr "Brusfrö"

#. :src: bpy.types.GreasePencilOffsetModifier
msgid "Grease Pencil Offset Modifier"
msgstr "Grease Pencil-förskjutningsmodifierare"

#. :src: bpy.types.GreasePencilOffsetModifier.location
msgid "Values for change location"
msgstr "Värden för positionsändring"

#. :src: bpy.types.GreasePencilOffsetModifier.offset_mode:'RANDOM'
msgid "Randomize stroke offset"
msgstr "Slumpa streckförskjutning"

#. :src: bpy.types.GreasePencilOffsetModifier.offset_mode:'LAYER'
msgid "Offset layers by the same factor"
msgstr "Förskjut lager med samma faktor"

#. :src: bpy.types.GreasePencilOffsetModifier.offset_mode:'STROKE'
msgid "Offset strokes by the same factor based on stroke draw order"
msgstr "Förskjut streck med samma faktor utifrån streckens ritordning"

#. :src: bpy.types.GreasePencilOffsetModifier.offset_mode:'MATERIAL'
msgid "Offset materials by the same factor"
msgstr "Förskjut material med samma faktor"

#. :src: bpy.types.GreasePencilOffsetModifier.stroke_start_offset
msgid "Offset starting point"
msgstr "Förskjut startpunkten"
