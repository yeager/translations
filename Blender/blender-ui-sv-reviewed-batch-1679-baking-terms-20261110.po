#: source/blender/editors/object/object_bake.cc:148
msgid "Mesh should be unwrapped before multires data baking"
msgstr "Meshen bör vecklas ut innan multires-data bakas"

#: source/blender/editors/object/object_bake.cc:176
msgid "Baking should happen to image with image buffer"
msgstr "Bakning måste ske till en bild med bildbuffert"

#: source/blender/editors/object/object_bake.cc:191
msgid "Baking to unsupported image type"
msgstr "Bakning till bildtyp som inte stöds"

#: source/blender/editors/object/object_bake.cc:464
msgid "Baking Multires..."
msgstr "Bakar multires..."

#: source/blender/editors/object/object_bake_api.cc:588
#: source/blender/editors/object/object_bake_api.cc:595
msgid ""
"Combined bake pass requires Emission, or a light pass with Direct or "
"Indirect contributions enabled"
msgstr ""
"Det kombinerade bakningspasset kräver emission eller ett ljuspass med direkt "
"eller indirekt bidrag aktiverat"

#: source/blender/editors/object/object_bake_api.cc:611
msgid ""
"Bake pass requires Direct, Indirect, or Color contributions to be enabled"
msgstr ""
"Bakningspasset kräver att direkt, indirekt eller färgbidrag är aktiverat"

#: source/blender/editors/object/object_bake_api.cc:1431
#: source/blender/editors/object/object_bake_api.cc:1709
msgid "Current render engine does not support baking"
msgstr "Den nuvarande renderingsmotorn stöder inte bakning"

#: source/blender/editors/object/object_bake_api.cc:1687
msgid "Error baking from object \"%s\""
msgstr "Fel vid bakning från objektet ”%s”"

#: source/blender/editors/object/object_bake_api.cc:1799
msgid "Problem baking object \"%s\""
msgstr "Problem vid bakning av objektet ”%s”"

#: source/blender/editors/object/object_bake_api.cc:2194
msgid "Baking texture..."
msgstr "Bakar textur..."
