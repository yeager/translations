msgid "Mesh to set the custom normals on"
msgstr "Nät att ställa in anpassade normaler på"

msgid "Input curves do not have NURBS type"
msgstr "Indatakurvorna är inte av NURBS-typ."

msgid "Curves to change the order of"
msgstr "Kurvor vars ordning ska ändras"

msgid "Curves to set the weight on"
msgstr "Kurvor som vikten ska anges för"

msgid "Whether each element should participate in sorting"
msgstr "Om varje element ska delta i sorteringen"

msgid "Elements with the same Group ID are sorted together"
msgstr "Element med samma grupp-ID sorteras tillsammans"

msgid "A field or list of values that will determine the sorted order"
msgstr "Ett fält eller en lista med värden som avgör sorteringsordningen"

msgid "Let the text use more space than the specified height"
msgstr "Låt texten använda mer utrymme än den angivna höjden"

msgid "Scale To Fit"
msgstr "Skala för att passa"

msgid "Scale the text size to fit inside the width and height"
msgstr "Skala textstorleken så att den ryms inom bredden och höjden"

msgid ""
"Only output curves that fit within the width and height. Output the "
"remainder to the \"Remainder\" output."
msgstr ""
"Mata endast ut kurvor som ryms inom bredden och höjden. Mata ut resten till "
"utdata ”Återstående”."

msgid "Align text to the left and the right"
msgstr "Justera texten till vänster och höger"

msgid "Align text to the left and the right, with equal character spacing"
msgstr "Justera texten till vänster och höger med lika teckenavstånd"

msgid "Set the pivot point for each character at its midpoint"
msgstr "Ange vridpunkten för varje tecken vid dess mittpunkt"

msgid "Top Left"
msgstr "Överst till vänster"

msgid "Set the pivot point for each character at its top left"
msgstr "Ange vridpunkten för varje tecken uppe till vänster"

msgid "Top Center"
msgstr "Överst i mitten"

msgid "Set the pivot point for each character at its top center"
msgstr "Ange vridpunkten för varje tecken överst i mitten"

msgid "Set the pivot point for each character at its top right"
msgstr "Ange vridpunkten för varje tecken uppe till höger"

msgid "Set the pivot point for each character at its bottom left"
msgstr "Ange vridpunkten för varje tecken nere till vänster"

msgid "Bottom Center"
msgstr "Nederst i mitten"

msgid "Set the pivot point for each character at its bottom center"
msgstr "Ange vridpunkten för varje tecken nederst i mitten"

msgid "Bottom Right"
msgstr "Nederst till höger"

msgid "Set the pivot point for each character at its bottom right"
msgstr "Ange vridpunkten för varje tecken nere till höger"

msgid "Point around which to rotate each character instance"
msgstr "Punkt som varje teckeninstans roteras kring"

msgid "Subdivision result mesh is too large for uniform subdivision"
msgstr ""
"Nätresultatet från underindelningen är för stort för enhetlig "
"underindelning"

msgid "Subdivision failed for some geometry. Original mesh returned."
msgstr ""
"Underindelning misslyckades för viss geometri. Ursprungligt nät returneras."

msgid "Accuracy of vertex positions, lower value is faster but less precise."
msgstr ""
"Noggrannhet för hörnpositioner; lägre värde går snabbare men är mindre "
"exakt."

msgid "Type cannot be switched by a field"
msgstr "Typen kan inte växlas med ett fält"

msgid "Mesh to override the face set attribute on"
msgstr "Nät där ansiktsuppsättningsattributet ska åsidosättas"

msgid "No attribute found matching"
msgstr "Inget matchande attribut hittades"

msgid "Target Point ID"
msgstr "Målpunkt-ID"

msgid "Target Edge ID"
msgstr "Målkant-ID"

msgid "Target Face ID"
msgstr "Målyte-ID"

msgid "Target Corner ID"
msgstr "Målhörn-ID"

msgid "Target Curve ID"
msgstr "Målkurv-ID"

msgid "Target Instance ID"
msgstr "Målinstans-ID"

msgid "Source Point ID"
msgstr "Källpunkt-ID"

msgid "Source Edge ID"
msgstr "Källkant-ID"

msgid "Source Face ID"
msgstr "Källyte-ID"

msgid "Source Corner ID"
msgstr "Källhörn-ID"

msgid "Source Curve ID"
msgstr "Källkurv-ID"

msgid "Source Instance ID"
msgstr "Källinstans-ID"

msgid "Attribute Names"
msgstr "Attributnamn"

msgid "Exclude Names"
msgstr "Uteslut namn"

msgid "Transferred Names"
msgstr "Överförda namn"

msgid ""
"Attribute names that have been transferred excluding internal attributes"
msgstr "Attributnamn som har överförts, exklusive interna attribut"

msgid ""
"List of attribute names (not) to transfer. A wildcard (*) at the end is "
"allowed"
msgstr ""
"Lista över attributnamn som ska (eller inte ska) överföras. Jokertecken (*) "
"tillåts i slutet"

msgid "Transfer all attributes except the ones matching any of the names"
msgstr "Överför alla attribut utom de som matchar något av namnen"

msgid "Target IDs"
msgstr "Mål-ID:n"

msgid "Source IDs"
msgstr "Käll-ID:n"

msgid "Faces to participate in the unwrap operation"
msgstr "Ytor som deltar i uppackningsåtgärden"

msgid "(None)"
msgstr "Ingen"

msgid "Rod stretch/shear constraint requires \"rotation\" attribute"
msgstr ""
"Begränsningen för stångsträckning/skjuvning kräver attributet ”rotation”"

msgctxt "NodeTree"
msgid "XPBD Solver (Experimental)"
msgstr "XPBD-lösare (experimentell)"

msgid "Simulation to World"
msgstr "Simulering till värld"

msgid "Constraint Iterations"
msgstr "Begränsningsiterationer"

msgid "Solver Path"
msgstr "Lösarväg"

msgid "Begin"
msgstr "Början"

msgid ""
"Average remaining relative error, values smaller than one are below the "
"constraint threshold."
msgstr ""
"Genomsnittligt återstående relativt fel; värden mindre än ett ligger under "
"begränsningströskeln."

msgid "World state that is updated by the solver"
msgstr "Världstillstånd som uppdateras av lösaren"

msgid "Filters the geometry sets to process based on their tags"
msgstr "Filtrerar geometrimängderna som ska behandlas utifrån deras taggar"

msgid "Optional output path in the world bundle for solver data"
msgstr "Valfri utdatasökväg i världspaketet för lösardata"

msgid "Interpolation Range"
msgstr "Interpoleringsintervall"

msgid "The first node group input must have the Color type"
msgstr "Den första nodgruppsindatan måste ha typen Color"

msgid "Node group must have at least two inputs to use the mask input"
msgstr "Nodgruppen måste ha minst två indata för att använda maskingången"

msgid "The second node group input must have the Color type"
msgstr "Den andra nodgruppsindatan måste ha typen Color"

msgid "Node group must have an output"
msgstr "Nodgruppen måste ha ett utgångsuttag"

msgid "The first node group output must have the Color type"
msgstr "Den första nodgruppsutdata måste ha typen Color"

msgid "Stack limit reached. Closure becomes pass-through."
msgstr "Stackgränsen nåddes. Closure blir genomsläpp."

msgid "Stack limit reached. Group node is ignored."
msgstr "Stackgränsen nåddes. Gruppnoden ignoreras."

msgid "Missing Data-Block"
msgstr "Saknat datablock"

msgid "To %s"
msgstr "Till %s"

msgid "Type for {}"
msgstr "Typ för {}"

msgid "Type for"
msgstr "Typ för"

msgid "Attribute for {}"
msgstr "Attribut för {}"

msgid "Layer for {}"
msgstr "Lager för {}"

msgid "Nodes stack limit reached (too many levels of nested nodes)"
msgstr "Nodernas stackgräns nåddes (för många nivåer av nästlade noder)"

msgid "Index must be a constant value for this data type"
msgstr "Index måste vara ett konstant värde för den här datatypen"

msgid "Switch must be a constant value for this data type"
msgstr "Växeln måste vara ett konstant värde för den här datatypen"

msgid "Node requires constant input values"
msgstr "Noden kräver konstanta indatavärden"

msgid "Invalid pattern"
msgstr "Ogiltigt mönster"

msgid "LightIndex"
msgstr "LightIndex"

msgid ""
"Amount of anisotropy for specular reflection. Higher absolute values give "
"elongated highlights along the tangent direction"
msgstr ""
"Mängden anisotropi vid spekulär reflektion. Högre absoluta värden ger "
"långsträckta högdagrar längs tangentriktningen."

msgid "Thin Wall"
msgstr "Tunn vägg"

msgid "Transmission Dispersion Scale"
msgstr "Skala för transmissionsspridning"

msgid "Transmission Dispersion Abbe Number"
msgstr "Abbe-tal för transmissionsspridning"

msgid ""
"A thin structure with the same material on both sides, useful for modeling "
"thin objects such as window, papers and leaves"
msgstr ""
"En tunn struktur med samma material på båda sidor, användbar för att "
"modellera tunna objekt som fönster, papper och löv"

msgid ""
"Directionality of volume scattering within the subsurface medium. Zero "
"scatters uniformly in all directions, positive values scatter more in the "
"forward direction, and negative values scatter more backwards. For example, "
"skin has been measured to have an anisotropy of 0.8"
msgstr ""
"Riktningsberoende för volymspridning i det underliggande mediet. Noll "
"sprider jämnt i alla riktningar, positiva värden sprider mer framåt och "
"negativa värden mer bakåt. Hud har till exempel uppmätts ha en anisotropi på"
" 0.8"

msgid "Linearly scales the amount of dispersion"
msgstr "Skalar mängden spridning linjärt"

msgid ""
"Abbe number of the base dielectric medium. Smaller number gives stronger "
"dispersion"
msgstr ""
"Abbe-tal för det dielektriska grundmediet. Ett lägre tal ger starkare "
"spridning"

msgid "Diffuse Light"
msgstr "Diffust ljus"

msgid "Glossy Light"
msgstr "Glansigt ljus"

msgid "Transmission Light"
msgstr "Transmissionsljus"

msgid "Evaluation position. Surface position by default"
msgstr "Utvärderingsposition. Ytposition som standard"

msgid "Evaluation normal. Surface normal by default"
msgstr "Utvärderingsnormal. Ytnormal som standard"

msgid "Evaluation roughness. Used for reflection factor"
msgstr "Utvärderingsråhet. Används för reflektionsfaktor"

msgid "Shading reflection factor, scaled by PI"
msgstr "Skuggningsreflektionsfaktor, skalad med PI"

msgid ""
"All local lights: Mask to smooth the light cutoff.\n"
"Spot lights: Cutoff mask and spot attenuation.\n"
"Sun lights: 1.0"
msgstr ""
"Alla lokala ljus: mask för att mjuka upp ljusavskärningen.\n"
"Spotljus: avskärningsmask och spotdämpning.\n"
"Solljus: 1.0"

msgid ""
"Local lights: Normalized direction from evaluation position to light position.\n"
"Sun lights: Sun direction * -1.0"
msgstr ""
"Lokala ljus: normaliserad riktning från utvärderingspositionen till ljuspositionen.\n"
"Solljus: solriktning * -1.0"

msgid ""
"Local lights: Distance from evaluation position to light position.\n"
"Sun lights: 1.0"
msgstr ""
"Lokala ljus: avstånd från utvärderingspositionen till ljuspositionen.\n"
"Solljus: 1.0"

msgid "Radiant intensity divided by PI"
msgstr "Strålningsintensitet delad med PI"

msgid "Light position"
msgstr "Ljusposition"

msgid ""
"Normal direction vector.\n"
"• LMB click and drag on the sphere to set the direction of the normal.\n"
"• Holding Ctrl while dragging snaps to 45 degree rotation increments"
msgstr ""
"Normalriktningsvektor. • Klicka med vänster musknapp och dra på sfären för "
"att ställa in normalens riktning. • Håll ned Ctrl-tangenten medan du drar "
"för att snäppa till 45 graders rotationssteg."

msgid "Strength of the normal mapping effect"
msgstr "Styrkan hos normalmappningseffekten"

msgid "Color that encodes the normal map in the specified space"
msgstr "Färg som kodar normalkartan i det angivna utrymmet"

msgid "Sample Attributes"
msgstr "Sampla attribut"

msgid "Accessing attributes is not supported by EEVEE renderer"
msgstr "Åtkomst till attribut stöds inte av EEVEE-renderaren"

msgid "Attributes Not Supported"
msgstr "Attribut stöds inte"

msgid "Render output and compositing disabled in Output properties"
msgstr "Renderingsutdata och komposition är inaktiverade i utdataegenskaperna"

msgid ""
"Render output disabled in Output properties and no active compositing File "
"Output nodes"
msgstr ""
"Renderingsutdata är inaktiverade i utdataegenskaperna och det finns inga "
"aktiva filutdatanoder för komposition"

msgid "Reading render result: expected pass \"%s.%s\" not found"
msgstr "Läser renderingsresultat: förväntat pass \"%s.%s\" hittades inte"

msgid "Reading render result: pass \"%s.%s\" has no buffer, skipping"
msgstr ""
"Läser renderingsresultat: passet ”%s.%s” saknar buffert och hoppas över"

msgid "Reading render result: pass \"%s.%s\" has %d channels, expected %d"
msgstr ""
"Läser renderingsresultat: passet ”%s.%s” har %d kanaler, förväntade %d"

msgid "Asset needs downloading first"
msgstr "Tillgången måste hämtas först"

msgid "Asset '%s' is still downloading"
msgstr "Tillgången ”%s” hämtas fortfarande"

msgid "Images are not automatically saved with the file"
msgstr "Bilder sparas inte automatiskt tillsammans med filen"

msgid "Save {} modified image(s)"
msgstr "Spara {} ändrade bilder"

msgid "Corner Title"
msgstr "Hörnrubrik"

msgid "Main Title"
msgstr "Huvudrubrik"

msgid "Subtitle"
msgstr "Undertext"

msgid "Hydra Cycles render engine"
msgstr "Hydra Cycles-renderingsmotor"

msgid "Cycles path tracing renderer using the Hydra render delegate"
msgstr ""
"Cycles-sökvägsspårningsrenderare som använder renderingsdelegaten Hydra"

