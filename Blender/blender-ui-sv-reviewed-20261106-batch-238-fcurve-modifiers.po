#. :src: bpy.types.FFmpegSettings.use_lossless_output
msgid "Lossless Output"
msgstr "Förlustfria utdata"

#. :src: bpy.types.FModifier.blend_out
msgid "Number of frames from end frame for influence to fade out"
msgstr "Antal bildrutor från slutbildrutan tills påverkan tonas ut"

#. :src: bpy.types.FModifier.influence
msgid "Amount of influence F-Curve Modifier will have when not fading in/out"
msgstr ""
"Hur stor påverkan F-kurvmodifieraren har när den inte tonas in eller ut"

#. :src: bpy.types.FModifier.type:'CYCLES'
#. :src: bpy.types.GRAPH_OT_fmodifier_add.type:'CYCLES'
#. :src: bpy.types.NLA_OT_fmodifier_add.type:'CYCLES'
msgid "Cyclic extend/repeat keyframe sequence"
msgstr "Cyklisk förlängning eller upprepning av en nyckelbildruteföljd"

#. :src: bpy.types.FModifier.type:'STEPPED'
#. :src: bpy.types.GRAPH_OT_fmodifier_add.type:'STEPPED'
#. :src: bpy.types.NLA_OT_fmodifier_add.type:'STEPPED'
msgctxt "Action"
msgid "Stepped Interpolation"
msgstr "Stegad interpolation"

#. :src: bpy.types.FModifier.use_influence
msgid "Use Influence"
msgstr "Använd påverkan"

#. :src: bpy.types.FModifier.use_influence
msgid "F-Curve Modifier's effects will be tempered by a default factor"
msgstr "F-kurvmodifierarens effekter dämpas med en standardfaktor"

#. :src: bpy.types.FModifier.use_restricted_range
msgid ""
"F-Curve Modifier is only applied for the specified frame range to help mask "
"off effects in order to chain them"
msgstr ""
"F-kurvmodifieraren tillämpas endast inom det angivna bildruteintervallet för "
"att effekter ska kunna maskeras och kedjas"

#. :src: bpy.types.FModifierCycles.mode_after
msgid "Cycling mode to use after last keyframe"
msgstr "Cyklingsläge som ska användas efter den sista nyckelbildrutan"

#. :src: bpy.types.FModifierCycles.mode_after:'REPEAT_OFFSET'
#. :src: bpy.types.FModifierCycles.mode_before:'REPEAT_OFFSET'
msgid ""
"Repeat keyframe range, but with offset based on gradient between start and "
"end values"
msgstr ""
"Upprepa nyckelbildruteintervallet, men med en förskjutning baserad på "
"skillnaden mellan start- och slutvärdena"

#. :src: bpy.types.FModifierCycles.mode_after:'MIRROR'
#. :src: bpy.types.FModifierCycles.mode_before:'MIRROR'
msgid "Alternate between forward and reverse playback of keyframe range"
msgstr "Växla mellan uppspelning framåt och bakåt av nyckelbildruteintervallet"

#. :src: bpy.types.FModifierCycles.mode_before
msgid "Cycling mode to use before first keyframe"
msgstr "Cyklingsläge som ska användas före den första nyckelbildrutan"

#. :src: bpy.types.FModifierStepped.frame_end
msgid "Frame that modifier's influence ends (if applicable)"
msgstr "Bildruta där modifierarens påverkan upphör (om tillämpligt)"

#. :src: bpy.types.FModifierStepped.frame_start
msgid "Frame that modifier's influence starts (if applicable)"
msgstr "Bildruta där modifierarens påverkan börjar (om tillämpligt)"
