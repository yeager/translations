#. :src: bpy.types.ID.use_extra_user
msgid ""
"Indicates whether an extra user is set or not (mainly for internal/debug "
"usages)"
msgstr ""
"Anger om en extra användare har angetts eller inte (främst för intern "
"användning och felsökning)"

#. :src: bpy.types.ID.users
msgid "Number of times this data-block is referenced"
msgstr "Antal referenser till detta datablock"

