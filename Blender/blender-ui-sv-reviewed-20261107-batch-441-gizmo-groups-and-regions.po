#. :src: bpy.types.GizmoGroup.bl_options:'PERSISTENT'
#. :src: bpy.types.Brush.use_persistent
msgid "Persistent"
msgstr "Beständig"

#. :src: bpy.types.GizmoGroup.bl_options:'SHOW_MODAL_ALL'
msgid "Show Modal All"
msgstr "Visa alla under interaktion"

#. :src: bpy.types.GizmoGroup.bl_options:'SHOW_MODAL_ALL'
msgid ""
"Show all while interacting, as well as this group when another is being "
"interacted with"
msgstr ""
"Visa alla under interaktion samt denna grupp när en annan grupp används"

#. :src: bpy.types.GizmoGroup.bl_options:'EXCLUDE_MODAL'
msgid "Exclude Modal"
msgstr "Uteslut under interaktion"

#. :src: bpy.types.GizmoGroup.bl_options:'EXCLUDE_MODAL'
msgid "Show all except this group while interacting"
msgstr "Visa alla utom denna grupp under interaktion"

#. :src: bpy.types.GizmoGroup.bl_options:'TOOL_INIT'
msgid "Tool Init"
msgstr "Verktygsinitiering"

#. :src: bpy.types.GizmoGroup.bl_options:'TOOL_INIT'
msgid "Postpone running until tool operator run (when used with a tool)"
msgstr ""
"Skjut upp körningen tills verktygsoperatorn körs (vid användning med ett "
"verktyg)"

#. :src: bpy.types.GizmoGroup.bl_options:'TOOL_FALLBACK_KEYMAP'
msgid "Use fallback tools keymap"
msgstr "Använd tangentmappning för reservverktyg"

#. :src: bpy.types.GizmoGroup.bl_options:'TOOL_FALLBACK_KEYMAP'
msgid "Add fallback tools keymap to this gizmo type"
msgstr "Lägg till tangentmappning för reservverktyg till denna gizmotyp"

#. :src: bpy.types.GizmoGroup.bl_options:'VR_REDRAWS'
msgid "VR Redraws"
msgstr "VR-omritningar"

#. :src: bpy.types.GizmoGroup.bl_options:'VR_REDRAWS'
msgid ""
"The gizmos are made for use with virtual reality sessions and require "
"special redraw management"
msgstr ""
"Gizmorna är gjorda för sessioner i virtuell verklighet och kräver särskild "
"hantering av omritning"

