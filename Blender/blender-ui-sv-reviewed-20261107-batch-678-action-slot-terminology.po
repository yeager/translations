#. :src: bpy.types.ActionChannelbag.slot
#. :src: bpy.types.DOPESHEET_PT_action_slot
#. :src: bpy.types.NODE_PT_material_slots
#: scripts/startup/bl_ui/properties_constraint.py:1185
#: scripts/startup/bl_ui/space_node.py:530
#: source/blender/editors/space_image/image_buttons.cc:113
#: source/blender/editors/space_nla/nla_buttons.cc:344
msgid "Slot"
msgstr "Slot"

#. :src: bpy.types.ActionSlot.name_display
msgid ""
"Name of the slot, for display in the user interface. This name combined with "
"the slot's data-block type is unique within its Action"
msgstr ""
"Slottens namn för visning i användargränssnittet. Namnet tillsammans med "
"slottens datablocktyp är unikt inom åtgärden"

#. :src: bpy.types.ActionChannelbag.fcurves
msgid "The individual F-Curves that animate the slot"
msgstr "De enskilda F-kurvor som animerar slotten"

#. :src: bpy.types.ActionChannelbag.slot
msgid "The Slot that the Channelbag's animation data is for"
msgstr "Slotten som Channelbags animationsdata gäller"

#. :src: bpy.types.ActionChannelbags
msgid ""
"For each action slot, a list of animation channels that are meant for that "
"slot"
msgstr ""
"För varje åtgärdsslot finns en lista över animationskanaler avsedda för den"

#. :src: bpy.types.ActionSlot.active
msgid ""
"Whether this is the active slot, can be set by assigning to "
"action.slots.active"
msgstr ""
"Anger om detta är den aktiva slotten; kan ställas in genom tilldelning till "
"action.slots.active"

#. :src: bpy.types.ActionSlot.handle
msgid "Slot Handle"
msgstr "Slothandtag"

#. :src: bpy.types.ActionSlot.identifier
msgid "Slot Identifier"
msgstr "Slotidentifierare"

#. :src: bpy.types.ActionSlot.identifier
msgid ""
"Used when connecting an Action to a data-block, to find the correct slot "
"handle. This is the display name, prefixed by two characters determined by "
"the slot's ID type"
msgstr ""
"Används när en åtgärd kopplas till ett datablock för att hitta rätt "
"slothandtag. Detta är visningsnamnet med ett prefix av två tecken som "
"bestäms av slottens ID-typ"

#. :src: bpy.types.ActionSlot.name_display
msgid "Slot Display Name"
msgstr "Slotvisningsnamn"

#. :src: bpy.types.DopeSheet.show_only_slot_of_active_object
msgid "Only Show Slot of Active Object"
msgstr "Visa endast slotten för det aktiva objektet"
