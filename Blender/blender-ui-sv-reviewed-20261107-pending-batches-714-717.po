msgstr "Dölj i vyport"

#. :src: bpy.types.View3DShading.type
#: scripts/startup/bl_ui/space_view3d.py:6762
msgid "Viewport Shading"
msgstr "Skuggning i vyport"

#. :src: bpy.types.SpaceImageEditor.show_gizmo_navigate
#. :src: bpy.types.SpaceSequenceEditor.show_gizmo_navigate
#. :src: bpy.types.SpaceView3D.show_gizmo_navigate
msgid "Viewport navigation gizmo"
msgstr "Navigeringsgizmo i vyport"

#: scripts/startup/bl_ui/space_node.py:288
#: scripts/startup/bl_ui/space_sequencer.py:189
#: scripts/startup/bl_ui/space_view3d.py:7129
msgid "Viewport Gizmos"
msgstr "Gizmor i vyport"

#. :src: bpy.types.PreferencesInput.navigation_mode
msgid "Which method to use for viewport navigation"
msgstr "Vilken metod som ska användas för navigering i vyporten"

#. :src: bpy.types.PreferencesInput.view_rotate_method
msgid "Orbit method in the viewport"
msgstr "Kretsningsmetod i vyport"

#. :src: bpy.types.Constraint.owner_space:'POSE'
#. :src: bpy.types.ShrinkwrapConstraint.project_axis_space:'POSE'
msgid ""
"The constraint is applied in Pose Space, the object transformation is ignored"
msgstr ""
"Begränsningen tillämpas i poseringsrymden; objektets transformation ignoreras"

#. :src: bpy.types.FunctionNodeCombineTransform
msgid ""
"Combine a translation vector, a rotation, and a scale vector into a "
"transformation matrix"
msgstr ""
"Kombinera en förskjutningsvektor, en rotation och en skalningsvektor till en "
"transformationsmatris"

#. :src: bpy.types.BrushGpencilSettings.use_fill_limit
msgid "Fill only visible areas in viewport"
msgstr "Fyll endast synliga områden i 3D-vyporten"

#. :src: bpy.types.CurvePaintSettings.surface_plane:'VIEW'
msgid "Draw in a plane aligned to the viewport"
msgstr "Rita i ett plan parallellt med 3D-vyporten"

#. :src: bpy.types.FluidDomainSettings.display_thickness
msgid "Thickness of smoke display in the viewport"
msgstr "Tjocklek på rökvisningen i 3D-vyporten"

#. :src: bpy.types.Object.show_instancer_for_viewport
msgid "Make instancer visible in the viewport"
msgstr "Gör instansieraren synlig i 3D-vyporten"

#. :src: bpy.types.ParticleSettings.display_method
msgid "How particles are displayed in viewport"
msgstr "Hur partiklar visas i 3D-vyporten"

#. :src: bpy.types.Modifier.show_viewport
msgid "Display modifier in viewport"
msgstr "Visa modifieraren i 3D-vyporten"

#. :src: bpy.types.ThemeView3D
msgid "Theme 3D Viewport"
msgstr "Tema för 3D-vyporten"

#. :src: bpy.types.ThemeView3D
msgid "Theme settings for the 3D viewport"
msgstr "Temainställningar för 3D-vyporten"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.set_view_transform
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.set_view_transform
msgid "Set View Transform"
msgstr "Ange visningstransformering"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.set_view_transform
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.set_view_transform
msgid "Set appropriate view transform based on media color space"
msgstr "Ställ in lämplig visningstransformering baserat på mediets färgrymd"

#. :src: bpy.types.CompositorNodeConvertToDisplay
msgid ""
"Convert from scene linear to display color space, with a view transform and "
"look for tone mapping"
msgstr ""
"Konvertera från scenlinjär färgrymd till visningsfärgrymd med "
"visningstransformering och utseende för tonmappning"

#. :src: bpy.types.CompositorNodeConvertToDisplay.view_settings
msgid "Color management view transform settings"
msgstr "Inställningar för färghanteringens visningstransformering"

#. :src: bpy.types.ShaderNodeDisplacement.space:'WORLD'
msgid "Displacement is in world space, not affected by object scale"
msgstr "Förskjutningen sker i världsrymd och påverkas inte av objektets skala"

#. :src: bpy.types.ShaderNodeNormalMap.space:'BLENDER_WORLD'
msgid "Blender World Space"
msgstr "Blender-världsrymd"

#. :src: bpy.types.ShaderNodeNormalMap.space:'BLENDER_WORLD'
msgid "World space normal mapping, compatible with Blender render baking"
msgstr "Normalmappning i världsrymd, kompatibel med Blender-renderingsbakning"

#. :src: bpy.types.RenderSettings.film_transparent
msgid ""
"World background is transparent, for compositing the render over another "
"background"
msgstr ""
"Världsbakgrunden är transparent för att kunna komponera renderingen över en "
"annan bakgrund"

#. :src: bpy.types.CompositorStrip
msgid "Compositor Strip"
msgstr "Kompositörremsa"

#. :src: bpy.types.Window.support_hdr_color
msgid ""
"The window has a HDR graphics buffer that wide gamut and high dynamic range "
"colors can be written to, in extended sRGB color space."
msgstr ""
"Fönstret har en HDR-grafikbuffert som färger med brett färgomfång och högt "
"dynamiskt omfång kan skrivas till i den utökade sRGB-färgrymden."

#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND_REUSE'
msgid ""
"Import the asset as copied data-block while avoiding multiple copies of "
"nested, typically heavy data. For example the textures of a material asset, "
"or the mesh of an object asset, don't have to be copied every time this "
"asset is imported. The instances of the asset share the data instead"
msgstr ""
"Importera tillgången som ett kopierat datablock men undvik flera kopior av "
"nästlade, vanligtvis tunga data. Texturer i en materialtillgång eller meshen "
"i en objekttillgång behöver exempelvis inte kopieras vid varje import. "
"Tillgångsinstanserna delar i stället data"

#. :src: bpy.types.OUTLINER_OT_collection_instance
msgctxt "Operator"
msgid "Instance Collection"
msgstr "Instanssamling"

#. :src: bpy.types.MeshAutomaskingSettings
msgid "Automasking settings for mesh painting & sculpting."
msgstr "Inställningar för automaskering vid meshmålning och meshskulptering."

#. :src: bpy.types.MeshLoopTriangle.polygon_index
msgid "Index of mesh face that the triangle is a part of"
msgstr "Index för meshytan som triangeln är en del av"

#. :src: bpy.types.MeshSkinVertex.use_root
msgid ""
"Vertex is a root for rotation calculations and armature generation, setting "
"this flag does not clear other roots in the same mesh island"
msgstr ""
"Hörnpunkten är en rot för rotationsberäkningar och armaturgenerering. Om "
"denna flagga anges rensas inte andra rötter på samma meshö"

#. :src: bpy.types.Modifier.type:'BUILD'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BUILD'
msgid ""
"Cause the faces of the mesh object to appear or disappear one after the "
"other over time"
msgstr ""
"Få ytorna på meshobjektet att visas eller försvinna en efter en över tid"

#. :src: bpy.types.Modifier.type:'DECIMATE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'DECIMATE'
#: source/blender/modifiers/intern/MOD_decimate.cc:276
#: source/blender/editors/object/object_remesh.cc:1123
#: source/blender/modifiers/intern/MOD_remesh.cc:264
msgid "Remesh"
msgstr "Ommeshning"

#. :src: bpy.types.Modifier.type:'REMESH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'REMESH'
msgid "Generate new mesh topology based on the current shape"
msgstr "Skapa ny meshtopologi baserad på den aktuella formen"

#. :src: bpy.types.Modifier.type:'SCREW'
#. :src: bpy.types.ScrewModifier.screw_offset
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SCREW'
msgid "Lathe around an axis, treating the input mesh as a profile"
msgstr "Svarva runt en axel och behandla ingångsmeshen som en profil"

#. :src: bpy.types.Modifier.type:'LAPLACIANSMOOTH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'LAPLACIANSMOOTH'
msgid "Reduce the noise on a mesh surface with minimal changes to its shape"
msgstr "Minska bruset på en meshyta med minimala förändringar av dess form"

