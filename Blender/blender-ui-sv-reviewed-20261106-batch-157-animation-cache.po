#. :src: bpy.types.ActionChannelbag
msgid ""
"Collection of animation channels, typically associated with an action slot"
msgstr "Samling av animationskanaler, vanligtvis kopplade till en åtgärdsslot"

#. :src: bpy.types.ActionChannelbag.slot
msgid "The Slot that the Channelbag's animation data is for"
msgstr "Åtgärdsslotten som behållarens animationsdata hör till"

#. :src: bpy.types.ActionChannelbags
msgid "Animation Channels for Slots"
msgstr "Animationskanaler för åtgärdsslotar"

#. :src: bpy.types.ActionChannelbags
msgid ""
"For each action slot, a list of animation channels that are meant for that "
"slot"
msgstr ""
"För varje åtgärdsslot: en lista över animationskanaler som är avsedda för "
"den aktuella åtgärdsslotten"

#. :src: bpy.types.AnimVizMotionPaths.range:'SCENE'
#. :src: bpy.types.OBJECT_OT_paths_calculate.range:'SCENE'
#. :src: bpy.types.POSE_OT_paths_calculate.range:'SCENE'
msgid "Scene Frame Range"
msgstr "Scenens bildruteintervall"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_action_all
msgid ""
"For bone motion paths, search whole Action for keyframes instead of in group "
"with matching name only (is slower)"
msgstr ""
"För rörelsebanor för ben söker du efter nyckelbildrutor i hela åtgärden i "
"stället för endast i en grupp med matchande namn (går långsammare)"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_highlight
msgid "Emphasize position of keyframes on Motion Paths"
msgstr "Betona nyckelbildrutornas position på rörelsebanorna"

