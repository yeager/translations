#. :src: bpy.types.DynamicPaintSurface.use_antialiasing
msgid "Use 5× multisampling to smooth paint edges"
msgstr "Använd 5× multisampling för att jämna ut målningskanter"

#. :src: bpy.types.DynamicPaintSurface.wave_smoothness
msgid ""
"Limit maximum steepness of wave slope between simulation points (use higher "
"values for smoother waves at expense of reduced detail)"
msgstr ""
"Begränsa den maximala brantheten i våglutningen mellan simuleringspunkterna "
"(använd högre värden för mjukare vågor på bekostnad av minskad detaljrikedom)"

#. :src: bpy.types.DynamicPaintSurface.wave_speed
msgid "Wave propagation speed"
msgstr "Vågens utbredningshastighet"

#. :src: bpy.types.DynamicPaintSurface.wave_spring
msgid "Spring"
msgstr "Fjäder"

#. :src: bpy.types.DynamicPaintSurface.wave_spring
msgid "Spring force that pulls water level back to zero"
msgstr "Fjäderkraft som drar tillbaka vattennivån till noll"

#. :src: bpy.types.DynamicPaintSurface.wave_timescale
msgid "Timescale"
msgstr "Tidsskala"

#. :src: bpy.types.DynamicPaintSurface.wave_timescale
msgid "Wave time scaling factor"
msgstr "Tidsskalningsfaktor för vågor"

#. :src: bpy.types.DynamicPaintSurfaces
msgid "Canvas Surfaces"
msgstr "Dynamic Paint-dukytor"

#. :src: bpy.types.DynamicPaintSurfaces
msgid "Collection of Dynamic Paint Canvas surfaces"
msgstr "Samling av Dynamic Paint-dukytor"

#. :src: bpy.types.DynamicPaintSurfaces.active
msgid "Active Surface"
msgstr "Aktiv yta"

#. :src: bpy.types.DynamicPaintSurfaces.active
msgid "Active Dynamic Paint surface being displayed"
msgstr "Den aktiva Dynamic Paint-ytan som visas"
