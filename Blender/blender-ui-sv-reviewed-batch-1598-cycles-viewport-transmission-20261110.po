#. :src: bpy.types.CyclesRenderSettings.use_preview_adaptive_sampling
msgid ""
"Automatically reduce the number of samples per pixel based on estimated "
"noise level, for viewport renders"
msgstr ""
"Minska automatiskt antalet sampel per pixel baserat på uppskattad brusnivå "
"för rendering i vyporten"

#. :src: bpy.types.CyclesRenderSettings.use_preview_denoising
msgid "Use Viewport Denoising"
msgstr "Använd brusreducering i vyporten"

#. :src:
#. bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_COLOR'
msgid "Show the Transmission Color render pass"
msgstr "Visa renderingspasset för transmissionsfärg"
