#. :src: bpy.types.DynamicPaintSurface.use_drip
msgid "Process drip effect (drip wet paint to gravity direction)"
msgstr ""
"Beräkna droppningseffekten (låt våt färg droppa i tyngdkraftens riktning)"

#. :src: bpy.types.DynamicPaintSurface.use_dry_log
msgid ""
"Use logarithmic drying (makes high values to dry faster than low values)"
msgstr ""
"Använd logaritmisk torkning (gör att höga värden torkar snabbare än låga "
"värden)"

#. :src: bpy.types.DynamicPaintSurface.use_drying
#. :src: bpy.types.PHYSICS_PT_dp_surface_canvas_paint_dry
msgid "Dry"
msgstr "Torr"

#. :src: bpy.types.DynamicPaintSurface.use_drying
msgid "Enable to make surface wetness dry over time"
msgstr "Gör så att ytans våthet torkar över tid"

#. :src: bpy.types.DynamicPaintSurface.use_incremental_displace
#. :src: bpy.types.WM_OT_save_mainfile.incremental
msgid "Incremental"
msgstr "Inkrementell"

#. :src: bpy.types.DynamicPaintSurface.use_incremental_displace
msgid "New displace is added cumulatively on top of existing"
msgstr "Ny förskjutning läggs kumulativt ovanpå befintlig förskjutning"

#. :src: bpy.types.DynamicPaintSurface.use_output_a
#. :src: bpy.types.DynamicPaintSurface.use_output_b
msgid "Use Output"
msgstr "Använd utdata"

#. :src: bpy.types.DynamicPaintSurface.use_output_a
#. :src: bpy.types.DynamicPaintSurface.use_output_b
msgid "Save this output layer"
msgstr "Spara det här utdatalagret"

#. :src: bpy.types.DynamicPaintSurface.use_premultiply
#: scripts/startup/bl_ui/properties_physics_dynamicpaint.py:413
msgid "Premultiply Alpha"
msgstr "Förmultiplicera alfa"

#. :src: bpy.types.DynamicPaintSurface.use_premultiply
msgid "Multiply color by alpha (recommended for Blender input)"
msgstr "Multiplicera färg med alfa (rekommenderas för inmatning till Blender)"
