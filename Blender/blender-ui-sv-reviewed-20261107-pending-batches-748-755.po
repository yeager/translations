#. :src: bpy.types.NlaStrip
msgid "A container referencing an existing Action"
msgstr "En behållare som refererar till en befintlig Action"

#. :src: bpy.types.DriverTarget.context_property:'ACTIVE_VIEW_LAYER'
#. :src: bpy.types.Window.view_layer
msgid "Active View Layer"
msgstr "Aktivt visningslager"

#. :src: bpy.types.SCENE_OT_freestyle_add_edge_marks_to_keying_set
msgid ""
"Add the data paths to the Freestyle Edge Mark property of selected edges to "
"the active keying set"
msgstr ""
"Lägg till datasökvägarna till egenskapen Freestyle Edge Mark för valda "
"kanter i den aktiva nyckeluppsättningen"

#. :src: bpy.types.SCENE_OT_freestyle_add_face_marks_to_keying_set
msgid ""
"Add the data paths to the Freestyle Face Mark property of selected polygons "
"to the active keying set"
msgstr ""
"Lägg till datasökvägarna till egenskapen Freestyle Face Mark för valda "
"polygoner i den aktiva nyckeluppsättningen"

#. :src: bpy.types.ASSET_OT_assign_action
msgctxt "Operator"
msgid "Assign Action"
msgstr "Tilldela Action"

#. :src: bpy.types.ViewLayer.has_export_collections
msgid "At least one Collection in this View Layer has an exporter"
msgstr "Minst en samling i detta visningslager har en exportör"

#. :src: bpy.types.NLA_OT_bake
msgctxt "Operator"
msgid "Bake Action"
msgstr "Baka Action"

msgid "Cannot add properties to override data"
msgstr "Det går inte att lägga till egenskaper i åsidosättningsdata"

msgid "Cannot edit library linked or non-editable override object(s)"
msgstr ""
"Det går inte att redigera bibliotekslänkade eller icke-redigerbara "
"åsidosättningsobjekt"

msgid "Cannot edit properties from override data"
msgstr "Det går inte att redigera egenskaper från åsidosättningsdata"

msgid "Cannot remove properties from override data"
msgstr "Det går inte att ta bort egenskaper från åsidosättningsdata"

#. :src: bpy.types.ANIM_OT_clear_useless_actions
msgctxt "Operator"
msgid "Clear Useless Actions"
msgstr "Rensa bort onödiga Action"

msgid "Clipping works in Wireframe and Solid viewport shading only"
msgstr ""
"Klippning fungerar endast med skuggningslägena trådram och solid i 3D-"
"vyporten"

#. :src: bpy.types.NodeGeometryForeachGeometryElementInputItems
msgid "Collection of input items"
msgstr "Samling av indataobjekt"

#. :src: bpy.types.UI_OT_copy_data_path_button
msgctxt "Operator"
msgid "Copy Data Path"
msgstr "Kopiera datasökväg"

#. :src: bpy.types.ACTION_OT_stash.create_new
msgid "Create New Action"
msgstr "Skapa ny Action"

#. :src: bpy.types.DriverTarget.context_property:'ACTIVE_VIEW_LAYER'
msgid "Currently evaluating view layer"
msgstr "Visningslagret som utvärderas"

#. :src: bpy.types.ViewLayer.cycles
msgid "Cycles ViewLayer Settings"
msgstr "Cycles-inställningar för visningslager"

msgid "Failed to find Action Slot."
msgstr "Det gick inte att hitta Action-slotten."

#. :src: bpy.types.NlaStrip.strip_time
msgid "Frame of referenced Action to evaluate"
msgstr "Bildruta i den refererade Action som ska utvärderas"

#. :src: bpy.types.Constraint.is_override_data
msgid ""
"In a local override object, whether this constraint comes from the linked "
"reference object, or is local to the override"
msgstr ""
"I ett objekt med lokal biblioteksåsidosättning anger detta om begränsningen "
"kommer från det länkade referensobjektet eller är lokal för åsidosättningen"

#. :src: bpy.types.Action.is_action_layered
msgid "Is Layered Action"
msgstr "Är en skiktad Action"

#. :src: bpy.types.Action.is_action_legacy
msgid "Is Legacy Action"
msgstr "Är äldre Action"

#. :src: bpy.types.ViewLayer.material_override
msgid "Material to override all other materials in this view layer"
msgstr "Material som åsidosätter alla andra material i detta visningslager"

#. :src: bpy.types.NlaStrip.type:'CLIP'
msgid "NLA Strip references some Action"
msgstr "NLA-remsan refererar till en Action"

#. :src: bpy.types.ACTION_OT_new
msgctxt "Operator"
msgid "New Action"
msgstr "Ny Action"

msgid "No slots in this Action."
msgstr "Inga slotar i denna Action."

#. :src: bpy.types.OBJECT_OT_make_override_library.collection
msgid "Override Collection"
msgstr "Skapa samlingsåsidosättning"

#. :src: bpy.types.ViewLayer.samples
msgid ""
"Override number of render samples for this view layer, 0 will use the scene "
"setting"
msgstr ""
"Åsidosätt antalet renderingssampler för detta visningslager. 0 använder "
"sceninställningen"

#. :src: bpy.types.WM_OT_radial_control.data_path_primary
msgid "Primary Data Path"
msgstr "Primär datasökväg"

msgid "Properties from override data cannot be edited"
msgstr "Egenskaper från åsidosättningsdata kan inte redigeras"

#. :src: bpy.types.ACTION_OT_push_down
#. :src: bpy.types.NLA_OT_action_pushdown
msgctxt "Operator"
msgid "Push Down Action"
msgstr "Skjut ned Action"

#. :src: bpy.types.Action.is_action_layered
msgid ""
"Return whether this is a layered Action. At this point all actions are "
"layered through versioning and this function will always return true"
msgstr ""
"Returnerar om detta är en skiktad Action. För närvarande är alla Action "
"lagerindelade genom versionshantering och funktionen returnerar alltid sant"

#. :src: bpy.types.ViewLayer.layer_collection
msgid ""
"Root of collections hierarchy of this view layer, its 'collection' pointer "
"property is the same as the scene's master collection"
msgstr ""
"Roten för samlingshierarkin i detta visningslager. Dess \"collection\"-"
"pekare är samma som scenens huvudsamling"

#. :src: bpy.types.WM_OT_radial_control.data_path_secondary
msgid "Secondary Data Path"
msgstr "Sekundär datasökväg"

msgid "Selected asset %s is not an Action"
msgstr "Den markerade resursen %s är inte en Action"

#. :src: bpy.types.OBJECT_OT_make_override_library.collection
msgid ""
"Session UID of the directly linked collection containing the selected "
"object, to make an override from"
msgstr ""
"Sessions-UID för den direktlänkade samling som innehåller det valda objektet "
"och ska användas för att skapa en åsidosättning"

#. :src: bpy.types.ACTION_OT_stash
#. :src: bpy.types.ACTION_OT_stash_and_create
msgctxt "Operator"
msgid "Stash Action"
msgstr "Lagra Action"

#. :src: bpy.types.Window.view_layer
msgid "The active workspace view layer showing in the window"
msgstr "Arbetsytans aktiva visningslager som visas i fönstret"

#. :src: bpy.types.Action.layers
msgid "The list of layers that make up this Action"
msgstr "Listan över lager som utgör denna Action"

#. :src: bpy.types.ACTION_OT_unlink
#. :src: bpy.types.NLA_OT_action_unlink
msgctxt "Operator"
msgid "Unlink Action"
msgstr "Koppla bort Action"

#. :src: bpy.types.WireframeModifier
msgid "Wireframe effect modifier"
msgstr "Modifierare för trådramseffekt"
