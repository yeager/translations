#. :src: bpy.types.BrushCurvesSculptSettings.add_amount
msgid "Number of curves added by the Add brush"
msgstr "Antal kurvor som Lägg till-penseln lägger till"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_length
#. :src: bpy.types.GeometryNodeCurveLength
msgid "Curve Length"
msgstr "Kurvlängd"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_length
msgid "Length of newly added curves when it is not interpolated from other curves"
msgstr "Längden på nyss tillagda kurvor när den inte beräknas genom interpolering från andra kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_parameter_falloff
msgid "Curve Parameter Falloff"
msgstr "Avtagande längs kurvparametern"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_parameter_falloff
msgid "Falloff that is applied from the tip to the root of each curve"
msgstr "Avtagande som tillämpas från spetsen till roten på varje kurva"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_radius
#. :src: bpy.types.FollowPathConstraint.use_curve_radius
msgid "Curve Radius"
msgstr "Kurvradie"

#. :src: bpy.types.BrushCurvesSculptSettings.density_add_attempts
msgid "Density Add Attempts"
msgstr "Täthetspenselns antal försök"

#. :src: bpy.types.BrushCurvesSculptSettings.density_add_attempts
msgid "How many times the Density brush tries to add a new curve"
msgstr "Hur många gånger täthetspenseln försöker lägga till en ny kurva"

#. :src: bpy.types.BrushCurvesSculptSettings.density_mode:'AUTO'
msgctxt "Operator"
msgid "Auto"
msgstr "Automatiskt"

#. :src: bpy.types.BrushCurvesSculptSettings.density_mode:'AUTO'
msgid "Either add or remove curves depending on the minimum distance of the curves under the cursor"
msgstr "Lägger till eller tar bort kurvor beroende på minimiavståndet mellan kurvorna under markören"

#. :src: bpy.types.BrushCurvesSculptSettings.minimum_length
msgid "Minimum Length"
msgstr "Minsta längd"

#. :src: bpy.types.BrushCurvesSculptSettings.minimum_length
msgid "Avoid shrinking curves shorter than this length"
msgstr "Undvik att förkorta kurvor till mindre än denna längd"

#. :src: bpy.types.BrushCurvesSculptSettings.points_per_curve
msgid "Points per Curve"
msgstr "Punkter per kurva"

#. :src: bpy.types.BrushCurvesSculptSettings.use_length_interpolate
msgid "Use length of the curves in close proximity"
msgstr "Använd längden hos närliggande kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.use_radius_interpolate
msgid "Use radius of the curves in close proximity"
msgstr "Använd radien hos närliggande kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.use_shape_interpolate
msgid "Use shape of the curves in close proximity"
msgstr "Använd formen hos närliggande kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.use_uniform_scale
#. :src: Socket name from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Scale Uniform"
msgstr "Skala jämnt"

#. :src: bpy.types.BrushCurvesSculptSettings.use_uniform_scale
msgid "Grow or shrink curves by changing their size uniformly instead of using trimming or extrapolation"
msgstr "Förläng eller förkorta kurvor genom att ändra deras storlek jämnt i stället för att använda trimning eller extrapolering"
