#: source/blender/io/ply/importer/ply_import_gsplat.cc:137
msgid ""
"PLY Importer: Spherical harmonics degree above the supported %d, spherical "
"harmonics are not imported"
msgstr ""
"PLY-importerare: Sfäriska harmoniker har en högre grad än den högsta grad "
"som stöds, %d. De sfäriska harmonikerna importeras inte"

#: source/blender/io/ply/importer/ply_import_gsplat.cc:145
msgid ""
"PLY Importer: Unexpected number of f_rest properties %d, spherical harmonics"
" are not imported"
msgstr ""
"PLY-importerare: Oväntat antal f_rest-egenskaper, %d. De sfäriska "
"harmonikerna importeras inte"

