msgid ""
"%d image sequence(s) with non-sequential filenames found, this is currently "
"unsupported"
msgstr ""
"%d bildsekvens eller bildsekvenser med icke sekventiella filnamn hittades. "
"Det stöds för närvarande inte"

#. :src: source/blender/io/otio/importer/otio_import.cc:550
msgid "OTIO Import"
msgstr "OTIO-import"

#. :src: source/blender/io/otio/importer/otio_import.cc:287
