#. :src: bpy.types.FFmpegSettings.constant_rate_factor
msgid "Output Quality"
msgstr "Kvalitet på utdata"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor
msgid ""
"Constant Rate Factor (CRF); tradeoff between video quality and file size"
msgstr ""
"Constant Rate Factor (CRF); avvägning mellan videokvalitet och filstorlek"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor:'NONE'
msgid "Constant Bitrate"
msgstr "Konstant bithastighet"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor:'NONE'
msgid "Configure constant bit rate, rather than constant output quality"
msgstr ""
"Konfigurera konstant bithastighet i stället för konstant utdatakvalitet"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor:'LOSSLESS'
msgid "Lossless"
msgstr "Förlustfri"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor:'PERC_LOSSLESS'
msgid "Perceptually Lossless"
msgstr "Visuellt förlustfri"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor:'MEDIUM'
msgid "Medium Quality"
msgstr "Medelhög kvalitet"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor:'LOW'
msgid "Low Quality"
msgstr "Låg kvalitet"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor:'VERYLOW'
msgid "Very Low Quality"
msgstr "Mycket låg kvalitet"

#. :src: bpy.types.FFmpegSettings.constant_rate_factor:'LOWEST'
msgid "Lowest Quality"
msgstr "Lägsta kvalitet"

#. :src: bpy.types.FFmpegSettings.ffmpeg_preset
msgid "Encoding Speed"
msgstr "Kodningshastighet"

#. :src: bpy.types.FFmpegSettings.ffmpeg_preset
msgid "Tradeoff between encoding speed and compression ratio"
msgstr "Kompromiss mellan kodningshastighet och komprimeringsgrad"

#. :src: bpy.types.FFmpegSettings.ffmpeg_preset:'BEST'
msgid "Slowest"
msgstr "Långsammast"

#. :src: bpy.types.FFmpegSettings.ffmpeg_preset:'BEST'
msgid ""
"Recommended if you have lots of time and want the best compression efficiency"
msgstr ""
"Rekommenderas om du har gott om tid och vill ha bästa möjliga "
"komprimeringseffektivitet"

#. :src: bpy.types.FFmpegSettings.ffmpeg_preset:'GOOD'
msgid "Good"
msgstr "Bra"

#. :src: bpy.types.FFmpegSettings.ffmpeg_preset:'GOOD'
msgid "The default and recommended for most applications"
msgstr "Standardvalet och rekommenderas för de flesta användningsområden"

#. :src: bpy.types.FFmpegSettings.ffmpeg_preset:'REALTIME'
#. :src: bpy.types.Modifier.show_viewport
#. :src: bpy.types.MovieTrackingSettings.speed:'REALTIME'
#. :src: bpy.types.ShaderFx.show_viewport
msgid "Realtime"
msgstr "Realtid"

#. :src: bpy.types.FFmpegSettings.ffmpeg_preset:'REALTIME'
msgid "Recommended for fast encoding"
msgstr "Rekommenderas för snabb kodning"

#. :src: bpy.types.FFmpegSettings.ffmpeg_prores_profile
#. :src: bpy.types.Curve.bevel_mode:'PROFILE'
#. :src: bpy.types.BevelModifier.profile
#. :src: bpy.types.MESH_OT_bevel.profile
#. :src: bpy.types.XrActionMapBinding.profile
#: source/blender/modifiers/intern/MOD_bevel.cc:425
msgid "Profile"
msgstr "Profil"

#. :src: bpy.types.FFmpegSettings.ffmpeg_prores_profile
msgid "ProRes Profile"
msgstr "ProRes-profil"

#. :src: bpy.types.FFmpegSettings.ffmpeg_prores_profile:'422_PROXY'
msgid "ProRes 422 Proxy"
msgstr "ProRes 422 Proxy"

#. :src: bpy.types.FFmpegSettings.ffmpeg_prores_profile:'422_LT'
msgid "ProRes 422 LT"
msgstr "ProRes 422 LT"

#. :src: bpy.types.FFmpegSettings.ffmpeg_prores_profile:'422_STD'
msgid "ProRes 422"
msgstr "ProRes 422"

#. :src: bpy.types.FFmpegSettings.ffmpeg_prores_profile:'422_HQ'
msgid "ProRes 422 HQ"
msgstr "ProRes 422 HQ"

#. :src: bpy.types.FFmpegSettings.ffmpeg_prores_profile:'4444'
msgid "ProRes 4444"
msgstr "ProRes 4444"

