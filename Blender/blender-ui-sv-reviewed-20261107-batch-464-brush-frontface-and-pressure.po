#. :src: bpy.types.Brush.use_frontface
msgid "Use Front-Face"
msgstr "Använd framsidan"

#. :src: bpy.types.Brush.use_frontface
msgid "Brush only affects vertices that face the viewer"
msgstr "Penseln påverkar endast hörnpunkter som vetter mot betraktaren"

#. :src: bpy.types.Brush.use_frontface_falloff
msgid "Use Front-Face Falloff"
msgstr "Använd avtagande för framsidan"

#. :src: bpy.types.Brush.use_frontface_falloff
msgid "Blend brush influence by how much they face the front"
msgstr "Blanda penselns påverkan efter hur mycket hörnpunkterna vetter framåt"

#. :src: bpy.types.Brush.use_grab_active_vertex
msgid "Grab Active Vertex"
msgstr "Flytta aktiv hörnpunkt"

#. :src: bpy.types.Brush.use_grab_active_vertex
msgid ""
"Apply the maximum grab strength to the active vertex instead of the cursor "
"location"
msgstr ""
"Tillämpa maximal flyttstyrka på den aktiva hörnpunkten i stället för på "
"markörens position"

#. :src: bpy.types.Brush.use_grab_silhouette
msgid "Grab Silhouette"
msgstr "Flytta silhuett"

#. :src: bpy.types.Brush.use_grab_silhouette
msgid "Grabs trying to automask the silhouette of the object"
msgstr "Flyttverktyg försöker automatiskt maskera objektets silhuett"

#. :src: bpy.types.Brush.use_hardness_pressure
msgid "Use Pressure for Hardness"
msgstr "Använd tryck för hårdhet"

#. :src: bpy.types.Brush.use_hardness_pressure
msgid "Use pressure to modulate hardness"
msgstr "Använd tryck för att modulera hårdheten"

#. :src: bpy.types.Brush.use_inverse_smooth_pressure
msgid "Inverse Smooth Pressure"
msgstr "Omvänt utjämningstryck"

#. :src: bpy.types.Brush.use_inverse_smooth_pressure
msgid "Lighter pressure causes more smoothing to be applied"
msgstr "Lättare tryck gör att mer utjämning tillämpas"

#. :src: bpy.types.Brush.use_locked_size
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size
msgid "Radius Unit"
msgstr "Radieenhet"

#. :src: bpy.types.Brush.use_locked_size
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size
msgid "Measure brush size relative to the view or the scene"
msgstr "Mät penselns storlek i förhållande till vyn eller scenen"

#. :src: bpy.types.Brush.use_locked_size:'VIEW'
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size:'VIEW'
msgid "Measure brush size relative to the view"
msgstr "Mät penselns storlek i förhållande till vyn"

#. :src: bpy.types.Brush.use_locked_size:'SCENE'
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size:'SCENE'
msgid "Measure brush size relative to the scene"
msgstr "Mät penselns storlek i förhållande till scenen"

#. :src: bpy.types.Brush.use_multiplane_scrape_dynamic
msgid "Dynamic Mode"
msgstr "Dynamiskt läge"

#. :src: bpy.types.Brush.use_multiplane_scrape_dynamic
msgid ""
"The angle between the planes changes during the stroke to fit the surface "
"under the cursor"
msgstr ""
"Vinkeln mellan planen ändras under penseldraget för att passa ytan under "
"markören"

#. :src: bpy.types.Brush.use_offset_pressure
msgid "Plane Offset Pressure"
msgstr "Tryck för planförskjutning"

#. :src: bpy.types.Brush.use_offset_pressure
msgid "Enable tablet pressure sensitivity for offset"
msgstr "Aktivera ritplattans tryckkänslighet för förskjutning"

#. :src: bpy.types.Brush.use_original_normal
msgid "Original Normal"
msgstr "Ursprunglig normal"

#. :src: bpy.types.Brush.use_original_normal
msgid "When locked keep using normal of surface where stroke was initiated"
msgstr ""
"När funktionen är låst används fortsatt normalen för ytan där penseldraget "
"startades"

#. :src: bpy.types.Brush.use_original_plane
msgid "Original Plane"
msgstr "Originalplan"

#. :src: bpy.types.Brush.use_original_plane
msgid ""
"When locked keep using the plane origin of surface where stroke was initiated"
msgstr ""
"När funktionen är låst används fortsatt planets ursprung från ytan där "
"penseldraget startades"

#. :src: bpy.types.Brush.use_paint_antialiasing
msgid "Smooths the edges of the strokes"
msgstr "Utjämnar kanterna på strecken"
