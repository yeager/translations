"Förskjutning som tillämpas på Y-koordinaterna för streckets hörnpunkter"

#. :src: bpy.types.LineStyleGeometryModifier_2DTransform
msgid "Apply two-dimensional scaling and rotation to stroke backbone geometry"
msgstr ""
"Tillämpa tvådimensionell skalning och rotation på streckets ryggradsgeometri"

#. :src: bpy.types.LineStyleGeometryModifier_2DTransform.pivot
msgid "Pivot of scaling and rotation operations"
msgstr "Vridpunkt för skalnings- och rotationsåtgärder"

#. :src: bpy.types.LineStyleGeometryModifier_2DTransform.pivot:'CENTER'
msgid "Stroke Center"
msgstr "Streckets mittpunkt"

#. :src: bpy.types.LineStyleGeometryModifier_2DTransform.pivot:'START'
msgid "Stroke Start"
msgstr "Streckets början"

#. :src: bpy.types.LineStyleGeometryModifier_2DTransform.pivot:'END'
msgid "Stroke End"
msgstr "Streckets slut"

#. :src: bpy.types.LineStyleGeometryModifier_2DTransform.pivot:'PARAM'
#. :src: bpy.types.LineStyleGeometryModifier_2DTransform.pivot_u
msgid "Stroke Point Parameter"
msgstr "Streckpunktsparameter"

