#. :src: Asset name from file procedural_hair_node_assets.blend
#: scripts/startup/bl_operators/object_quick_effects.py:185
msgid "Frizz Hair Curves"
msgstr "Kurvor för frissigt hår"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Displace Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Frizz Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Smooth Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Straighten Hair Curves, file procedural_hair_node_assets.blend
msgid "Shape of the influence along curves (0=constant, 0.5=linear)"
msgstr "Påverkansform längs kurvorna (0=konstant, 0,5=linjär)"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Deforms hair curves using a random vector per point to frizz them"
msgstr "Gör hårkurvor frissiga med en slumpmässig vektor för varje punkt"

#. :src: Socket name from node group Frizz Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Offset Vector"
msgstr "Förskjutningsvektor"

#. :src: Socket description from node group Frizz Hair Curves, file procedural_hair_node_assets.blend
msgid "Vector by which each point was offset during deformation"
msgstr "Vektor som varje punkt försköts med under deformationen"

#. :src: Socket name from node group Frizz Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Cumulative Offset"
msgstr "Ackumulerad förskjutning"

#. :src: Socket description from node group Frizz Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Apply offset cumulatively (previous points affect points after)"
msgstr ""
"Tillämpa förskjutningen kumulativt (tidigare punkter påverkar följande "
"punkter)"

#. :src: Socket description from node group Frizz Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Overall distance factor for the deformation"
msgstr "Övergripande avståndsfaktor för deformationen"
