#. :src: bpy.types.SpeedControlStrip.speed_control:'STRETCH'
msgid "Adjust input playback speed, so its duration fits strip length"
msgstr "Justera ingångens uppspelningshastighet så att dess längd passar remsans längd"

#. :src: bpy.types.SpeedControlStrip.speed_factor
msgid ""
"Multiply the current speed of the strip with this number or remap current "
"frame to this frame"
msgstr ""
"Multiplicera remsans aktuella hastighet med detta tal eller ommappa aktuell "
"bildruta till denna bildruta"
