#. :src: bpy.types.ActionConstraint.use_eval_time
msgid ""
"Interpolate between Action Start and End frames, with the Evaluation Time "
"slider instead of the Target object/bone"
msgstr ""
"Interpolera mellan Actionens start- och slutbildrutor med reglaget "
"Utvärderingstid i stället för målobjektet eller målbenet"

#. :src: bpy.types.ArmatureConstraint
msgid "Armature Constraint"
msgstr "Armaturbegränsning"

#. :src: bpy.types.ArmatureConstraint
msgid "Applies transformations done by the Armature modifier"
msgstr "Tillämpar transformationerna från armaturmodifieraren"

#. :src: bpy.types.ArmatureConstraint.targets
#. :src: bpy.types.DriverVariable.targets
#. :src: bpy.types.ParticleSystem.targets
msgid "Targets"
msgstr "Mål"

#. :src: bpy.types.ArmatureConstraint.targets
msgid "Target Bones"
msgstr "Målben"

#. :src: bpy.types.ArmatureConstraint.use_bone_envelopes
msgid "Use Envelopes"
msgstr "Använd omslutningar"

#. :src: bpy.types.ArmatureConstraint.use_bone_envelopes
msgid ""
"Multiply weights by envelope for all bones, instead of acting like Vertex "
"Group based blending. The specified weights are still used, and only the "
"listed bones are considered."
msgstr ""
"Multiplicera vikterna med omslutningen för alla ben i stället för att "
"använda blandning baserad på hörnpunktsgrupper. De angivna vikterna används "
"fortfarande och endast de listade benen beaktas."

#. :src: bpy.types.ArmatureConstraint.use_current_location
msgid "Use Current Location"
msgstr "Använd aktuell position"

#. :src: bpy.types.ArmatureConstraint.use_current_location
msgid ""
"Use the current bone location for envelopes and choosing B-Bone segments "
"instead of rest position"
msgstr ""
"Använd den aktuella benpositionen för omslutningar och för att välja B-"
"bensegment i stället för viloposition"

#. :src: bpy.types.ArmatureConstraint.use_deform_preserve_volume
#. :src: bpy.types.Mesh.use_remesh_preserve_volume
#. :src: bpy.types.ArmatureModifier.use_deform_preserve_volume
#. :src: bpy.types.GreasePencilArmatureModifier.use_deform_preserve_volume
#. :src: bpy.types.LaplacianSmoothModifier.use_volume_preserve
#. :src: bpy.types.WarpModifier.use_volume_preserve
#. :src: bpy.types.MESH_OT_vertices_smooth_laplacian.preserve_volume
msgid "Preserve Volume"
msgstr "Bevara volymen"

#. :src: bpy.types.ArmatureConstraint.use_deform_preserve_volume
#. :src: bpy.types.ArmatureModifier.use_deform_preserve_volume
#. :src: bpy.types.GreasePencilArmatureModifier.use_deform_preserve_volume
msgid "Deform rotation interpolation with quaternions"
msgstr "Interpolera deformationsrotation med kvaternioner"
