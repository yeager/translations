#. :src: bpy.types.AnimVizMotionPaths.type:'CURRENT_FRAME'
#. :src: bpy.types.OBJECT_OT_paths_calculate.display_type:'CURRENT_FRAME'
#. :src: bpy.types.POSE_OT_paths_calculate.display_type:'CURRENT_FRAME'
msgid ""
"Display Paths of poses within a fixed number of frames around the current "
"frame"
msgstr ""
"Visa rörelsebanor för poser inom ett fast antal bildrutor kring den aktuella "
"bildrutan"

#. :src: bpy.types.AnimVizMotionPaths.type:'RANGE'
#. :src: bpy.types.OBJECT_OT_paths_calculate.display_type:'RANGE'
#. :src: bpy.types.POSE_OT_paths_calculate.display_type:'RANGE'
msgid "In Range"
msgstr "Inom intervall"

#. :src: bpy.types.AnimVizMotionPaths.type:'RANGE'
#. :src: bpy.types.OBJECT_OT_paths_calculate.display_type:'RANGE'
#. :src: bpy.types.POSE_OT_paths_calculate.display_type:'RANGE'
msgid "Display Paths of poses within specified range"
msgstr "Visa rörelsebanor för poser inom angivet intervall"

#. :src: bpy.types.AnimVizMotionPaths.use_camera_space_bake
msgid "Bake to active Camera"
msgstr "Beräkna i aktiv kameras koordinatsystem"

#. :src: bpy.types.AnimVizMotionPaths.use_camera_space_bake
msgid ""
"Motion path points will be baked into the camera space of the active camera. "
"This means they will only look right when looking through that camera. "
"Switching cameras using markers is not supported."
msgstr ""
"Rörelsebanepunkter beräknas i den aktiva kamerans koordinatsystem. De ser "
"därför rätt ut endast när du ser genom den kameran. Det finns inte stöd för "
"att byta kamera med markörer."
