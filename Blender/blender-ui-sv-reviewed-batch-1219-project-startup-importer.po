# translation of Blender UI to Swedish
# Delta review: project, startup image and collection-importer UI
msgid ""
msgstr ""
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"

#. :src: bpy.types.PROJECT_OT_close.skip_save_check
#. :src: bpy.types.PROJECT_OT_open.skip_save_check
msgid "Skip check to prevent unsaved changes from being lost"
msgstr "Hoppa över kontrollen som förhindrar att osparade ändringar går förlorade"

#. :src: bpy.types.PROJECT_OT_new.directory
msgid "Project folder, created if missing"
msgstr "Projektmapp som skapas om den saknas"

#. :src: bpy.types.PROJECT_OT_open
msgid "Open a project, starting a new file in it"
msgstr "Öppna ett projekt och skapa en ny fil i det"

#. :src: bpy.types.PROJECT_OT_variable_add.variable_type
msgid "The kind of variable type to add"
msgstr "Typ av variabel som ska läggas till"

#. :src: bpy.types.PROJECT_OT_variable_move.direction
msgid "Which direction to move the variable"
msgstr "Åt vilket håll variabeln ska flyttas"

#. :src: bpy.types.Preferences.use_project_remember
msgid "On startup, automatically re-open the project that was last open when Blender was closed"
msgstr "När Blender startas öppnas automatiskt det projekt som var öppet när Blender senast stängdes"
