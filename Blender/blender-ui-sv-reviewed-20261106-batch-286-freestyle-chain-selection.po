#. :src: bpy.types.FreestyleLineStyle.use_chain_count
msgid "Use Chain Count"
msgstr "Använd antal kedjor"

#. :src: bpy.types.FreestyleLineStyle.use_chain_count
msgid "Enable the selection of first N chains"
msgstr "Aktivera urval av de första N kedjorna"

#. :src: bpy.types.FreestyleLineStyle.use_chaining
msgid "Enable chaining of feature edges"
msgstr "Aktivera kedjning av funktionskanter"

#. :src: bpy.types.FreestyleLineStyle.use_dashed_line
msgid "Enable or disable dashed line"
msgstr "Aktivera eller inaktivera streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.use_length_max
msgid "Use Max 2D Length"
msgstr "Använd maximal 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_length_max
msgid "Enable the selection of chains by a maximum 2D length"
msgstr "Aktivera urval av kedjor efter maximal 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_length_min
msgid "Use Min 2D Length"
msgstr "Använd minimal 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_length_min
msgid "Enable the selection of chains by a minimum 2D length"
msgstr "Aktivera urval av kedjor efter minimal 2D-längd"

#. :src: bpy.types.FreestyleLineStyle.use_split_pattern
msgid "Use Split Pattern"
msgstr "Använd delningsmönster"

#. :src: bpy.types.FreestyleLineStyle.use_split_pattern
msgid "Enable chain splitting by dashed line patterns"
msgstr "Aktivera kedjedelning med streckmönster"
