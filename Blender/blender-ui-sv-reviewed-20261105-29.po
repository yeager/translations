#. :src: bpy.types.AnimVizMotionPaths.use_camera_space_bake
msgid "Bake to active Camera"
msgstr "Baka till aktiv kamera"

#. :src: bpy.types.AnimVizMotionPaths.use_camera_space_bake
msgid "Motion path points will be baked into the camera space of the active camera. This means they will only look right when looking through that camera. Switching cameras using markers is not supported."
msgstr "Rörelsebanans punkter bakas till den aktiva kamerans kamerarum. De visas därför korrekt endast när du ser genom den kameran. Det går inte att byta kamera med markörer."

#. :src: bpy.types.BakeSettings.normal_b
#. :src: bpy.types.OBJECT_OT_bake.normal_b
msgid "Axis to bake in blue channel"
msgstr "Axel som ska bakas i den blå kanalen"

#. :src: bpy.types.BakeSettings.normal_g
#. :src: bpy.types.OBJECT_OT_bake.normal_g
msgid "Axis to bake in green channel"
msgstr "Axel som ska bakas i den gröna kanalen"

#. :src: bpy.types.BakeSettings.normal_r
#. :src: bpy.types.OBJECT_OT_bake.normal_r
msgid "Axis to bake in red channel"
msgstr "Axel som ska bakas i den röda kanalen"

#. :src: bpy.types.BakeSettings.target:'IMAGE_TEXTURES'
#. :src: bpy.types.OBJECT_OT_bake.target:'IMAGE_TEXTURES'
msgid "Bake to image data-blocks associated with active image texture nodes in materials"
msgstr "Baka till bilddatablock som är kopplade till aktiva bildtexturnoder i materialen"

#. :src: bpy.types.BakeSettings.target:'VERTEX_COLORS'
#. :src: bpy.types.OBJECT_OT_bake.target:'VERTEX_COLORS'
msgid "Bake to the active color attribute on meshes"
msgstr "Baka till det aktiva färgattributet på maskor"
