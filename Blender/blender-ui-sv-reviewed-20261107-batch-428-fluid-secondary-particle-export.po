#. :src: bpy.types.FluidDomainSettings.sndparticle_bubble_buoyancy
#: scripts/startup/bl_ui/properties_physics_fluid.py:993
msgid "Bubble Buoyancy"
msgstr "Bubblornas flytkraft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_bubble_buoyancy
msgid ""
"Amount of buoyancy force that rises bubbles (high value results in bubble "
"movement mainly upwards)"
msgstr ""
"Flytkraft som får bubblorna att stiga (högt värde gör att bubblorna främst "
"rör sig uppåt)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_bubble_drag
#: scripts/startup/bl_ui/properties_physics_fluid.py:994
msgid "Bubble Drag"
msgstr "Bubbelmotstånd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_bubble_drag
msgid ""
"Amount of drag force that moves bubbles along with the fluid (high value "
"results in bubble movement mainly along with the fluid)"
msgstr ""
"Motståndskraft som får bubblorna att följa med vätskan (högt värde gör att "
"bubblorna främst följer med vätskan)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export
msgid "Combined Export"
msgstr "Samlad export"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export
msgid "Determines which particle systems are created from secondary particles"
msgstr "Bestämmer vilka partikelsystem som skapas av sekundära partiklar"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'OFF'
msgid "Create a separate particle system for every secondary particle type"
msgstr "Skapa ett separat partikelsystem för varje sekundär partikeltyp"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'SPRAY_FOAM'
msgid "Spray + Foam"
msgstr "Spray + skum"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'SPRAY_FOAM'
msgid "Spray and foam particles are saved in the same particle system"
msgstr "Spray- och skumpartiklar sparas i samma partikelsystem"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'SPRAY_BUBBLES'
msgid "Spray + Bubbles"
msgstr "Spray + bubblor"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'SPRAY_BUBBLES'
msgid "Spray and bubble particles are saved in the same particle system"
msgstr "Spray- och bubbelpartiklar sparas i samma partikelsystem"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'FOAM_BUBBLES'
msgid "Foam + Bubbles"
msgstr "Skum + bubblor"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'FOAM_BUBBLES'
msgid "Foam and bubbles particles are saved in the same particle system"
msgstr "Skum- och bubbelpartiklar sparas i samma partikelsystem"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'SPRAY_FOAM_BUBBLES'
msgid "Spray + Foam + Bubbles"
msgstr "Spray + skum + bubblor"

#. :src: bpy.types.FluidDomainSettings.sndparticle_combined_export:'SPRAY_FOAM_BUBBLES'
msgid ""
"Create one particle system that contains all three secondary particle types"
msgstr ""
"Skapa ett partikelsystem som innehåller alla tre sekundära partikeltyper"
