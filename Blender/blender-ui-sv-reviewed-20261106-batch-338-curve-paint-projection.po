#. :src: bpy.types.CurvePaintSettings.surface_plane:'VIEW'
msgid "Draw in a plane aligned to the viewport"
msgstr "Rita i ett plan parallellt med vyporten"

#. :src: bpy.types.CurvePaintSettings.use_corners_detect
#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:1190
msgid "Detect Corners"
msgstr "Identifiera hörn"

#. :src: bpy.types.CurvePaintSettings.use_corners_detect
msgid "Detect corners and use non-aligned handles"
msgstr "Identifiera hörn och använd icke-inriktade handtag"

#. :src: bpy.types.CurvePaintSettings.use_offset_absolute
msgid "Absolute Offset"
msgstr "Absolut förskjutning"

#. :src: bpy.types.CurvePaintSettings.use_offset_absolute
msgid "Apply a fixed offset (don't scale by the radius)"
msgstr "Tillämpa en fast förskjutning (skala inte med radien)"

#. :src: bpy.types.CurvePaintSettings.use_pressure_radius
msgid "Map tablet pressure to curve radius"
msgstr "Koppla ritplattans tryck till kurvradien"

#. :src: bpy.types.CurvePaintSettings.use_project_only_selected
#. :src: bpy.types.ToolSettings.use_annotation_project_only_selected
#. :src: bpy.types.ToolSettings.use_gpencil_project_only_selected
msgid "Project Onto Selected"
msgstr "Projicera på markerade"

#. :src: bpy.types.CurvePaintSettings.use_project_only_selected
#. :src: bpy.types.ToolSettings.use_annotation_project_only_selected
#. :src: bpy.types.ToolSettings.use_gpencil_project_only_selected
msgid "Project the strokes only onto selected objects"
msgstr "Projicera strecken endast på markerade objekt"

#. :src: bpy.types.CurvePaintSettings.use_stroke_endpoints
msgid "Only First"
msgstr "Endast början"

#. :src: bpy.types.CurvePaintSettings.use_stroke_endpoints
msgid "Use the start of the stroke for the depth"
msgstr "Använd början av strecket för djupet"
