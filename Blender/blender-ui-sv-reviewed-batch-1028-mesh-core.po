#. :src: bpy.types.GeometryNodeTree.is_type_mesh
#. :src: bpy.types.Menu
#. :src: bpy.types.NODE_MT_geometry_node_GEO_MESH
#. :src: bpy.types.VIEW3D_MT_edit_mesh
#: source/blender/nodes/geometry/nodes/node_geo_curve_to_mesh.cc:24
#: source/blender/nodes/geometry/nodes/node_geo_mesh_to_curve.cc:25
msgid "Mesh"
msgstr "Mesh"

#. :src: bpy.types.BevelModifier.vmesh_method
#. :src: bpy.types.MESH_OT_bevel.vmesh_method
msgid "Vertex Mesh Method"
msgstr "Hörnpunktsmetod för mesh"

#. :src: bpy.types.GreasePencilLineartModifier.source_vertex_group
msgid ""
"Match the beginning of vertex group names from mesh objects, match all when "
"left empty"
msgstr ""
"Matcha början av hörnpunktsgruppsnamn från meshobjekt; matcha alla när "
"fältet lämnas tomt"

#. :src: bpy.types.MultiresModifier
msgid "Multiresolution mesh modifier"
msgstr "Modifierare för mesh med flera upplösningar"

#. :src: bpy.types.MultiresModifier.use_creases
#. :src: bpy.types.SubsurfModifier.use_creases
msgid "Use mesh crease information to sharpen edges or corners"
msgstr "Använd information om meshveck för att skärpa kanter eller hörn"

#. :src: bpy.types.SubsurfModifier.adaptive_space:'OBJECT'
msgid ""
"Subdivide to reach a specified edge length in object space. This is required "
"to use adaptive subdivision for instanced meshes"
msgstr ""
"Dela upp för att nå en angiven kantlängd i objektrymden. Detta krävs för att "
"använda adaptiv underindelning för instansierade meshar"

#. :src: bpy.types.GeometryNodeClusterByConnected
msgid ""
"Group mesh vertices connected by edges when they are within a specified "
"distance"
msgstr ""
"Gruppera meshhörnpunkter som är anslutna med kanter när de ligger inom ett "
"angivet avstånd"

#. :src: bpy.types.GeometryNodeDeformCurvesOnSurface
msgid ""
"Translate and rotate curves based on changes between the object's original "
"and evaluated surface mesh"
msgstr ""
"Förskjut och rotera kurvor utifrån förändringar mellan objektets ursprungliga "
"och utvärderade ytmesh"
