#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'NEAREST_SURFACEPOINT'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'NEAREST_SURFACEPOINT'
msgid "Shrink the mesh to the nearest target surface"
msgstr "Anpassa meshen till närmaste målyta"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'PROJECT'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'PROJECT'
msgid "Shrink the mesh to the nearest target surface along a given axis"
msgstr "Anpassa meshen till närmaste målyta längs en angiven axel"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_method:'NEAREST_VERTEX'
#. :src: bpy.types.ShrinkwrapModifier.wrap_method:'NEAREST_VERTEX'
msgid "Shrink the mesh to the nearest target vertex"
msgstr "Anpassa meshen till närmaste målhörnpunkt"

#. :src: bpy.types.GeometryNodeMeshToDensityGrid
msgid "Create a filled volume grid from a mesh"
msgstr "Skapa ett volymrutnät med fyllning från en mesh"

#. :src: bpy.types.GeometryNodeMeshToSDFGrid
msgid "Create a signed distance volume grid from a mesh"
msgstr "Skapa ett volymrutnät med signerat avstånd från en mesh"

#. :src: bpy.types.MESH_OT_circularize.flatten
msgid "Flatten the circle, instead of projecting it on the mesh"
msgstr "Platta till cirkeln i stället för att projicera den på meshen"

#. :src: bpy.types.OBJECT_OT_data_transfer.use_auto_transform
msgid ""
"Automatically compute transformation to get the best possible match between "
"source and destination meshes.\n"
"Warning: Results will never be as good as manual matching of objects"
msgstr ""
"Beräkna automatiskt transformeringen för att få bästa möjliga "
"överensstämmelse mellan käll- och målmeshen.\n"
"Varning: Resultaten blir aldrig lika bra som vid manuell matchning av objekt"

#. :src: bpy.types.OBJECT_OT_multires_base_apply.apply_heuristic
msgid ""
"Whether or not the final base mesh positions will be slightly altered to "
"account for a new subdivision modifier being added"
msgstr ""
"Huruvida basmeshens slutliga positioner ändras något för att ta hänsyn till "
"att en ny underindelningsmodifierare läggs till"

#. :src: bpy.types.OBJECT_OT_shape_key_make_basis
msgid ""
"Make the active shape key the new basis key, effectively applying it to the "
"mesh.\n"
"Note that this applies the shape key at its 100% value"
msgstr ""
"Gör den aktiva formnyckeln till den nya basnyckeln, vilket tillämpar den på "
"meshen.\n"
"Observera att formnyckeln tillämpas med värdet 100 %"

#. :src: bpy.types.UV_OT_seams_from_islands
msgid "Set mesh seams according to island setup in the UV editor"
msgstr "Ange meshsömmar enligt öarnas konfiguration i UV-redigeraren"

#. :src: bpy.types.UV_OT_smart_project
msgid "Projection unwraps the selected faces of mesh objects"
msgstr "Projektionen vecklar ut markerade ytor på meshobjekt"

#. :src: bpy.types.WM_OT_usd_export.export_subdivision:'IGNORE'
msgid "Scheme = None. Export base mesh without subdivision"
msgstr "Schema = Inget. Exportera basmesh utan underindelning"

#. :src: bpy.types.PreferencesEdit.use_duplicate_mesh
msgid "Causes mesh data to be duplicated with the object"
msgstr "Orsakar att meshdata dupliceras med objektet"

#. :src: bpy.types.PreferencesView.use_fresnel_edit
msgid ""
"Enable a fresnel effect on edit mesh overlays.\n"
"It improves shape readability of very dense meshes, but increases eye "
"fatigue when modeling lower poly"
msgstr ""
"Aktivera en Fresnel-effekt för redigeringsmeshens överlägg.\n"
"Det förbättrar formens läsbarhet i mycket täta mesh, men ökar ögontröttheten "
"vid modellering med låg polygonupplösning"

#. :src: bpy.types.RigidBodyObject.mesh_source:'BASE'
msgid "Base mesh"
msgstr "Basmesh"

#. :src: bpy.types.SpaceOutliner.use_filter_object_mesh
#. :src: bpy.types.SpaceView3D.show_object_viewport_mesh
#. :src: bpy.types.XrSessionSettings.show_object_viewport_mesh
msgid "Show mesh objects"
msgstr "Visa meshobjekt"

#. :src: bpy.types.SpaceView3D.show_object_select_mesh
#. :src: bpy.types.XrSessionSettings.show_object_select_mesh
msgid "Allow selection of mesh objects"
msgstr "Tillåt markering av meshobjekt"

#. :src: bpy.types.ToolSettings.use_uv_select_sync
msgid "Keep UV and edit mode mesh selection in sync"
msgstr "Håll UV-markering och meshmarkering i redigeringsläget synkroniserade"

#: scripts/startup/bl_operators/image_as_planes.py:1197
msgid "{:d} image(s) converted to mesh plane(s)"
msgstr "{:d} bilder konverterades till meshplan"

#: scripts/startup/bl_operators/object.py:411
msgid "Skipping '{:s}', not a mesh"
msgstr "Hoppar över ”{:s}” eftersom det inte är ett meshobjekt"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:869
msgid ""
"Use multiple operators in an interactive way to add, delete, or move "
"geometry\n"
" • {:s} - Add geometry by moving the cursor close to an element\n"
" • {:s} - Extrude edges by moving the cursor\n"
" • {:s} - Delete mesh element"
msgstr ""
"Använd flera operatorer interaktivt för att lägga till, ta bort eller flytta "
"geometri\n"
"· • {:s} – Lägg till geometri genom att föra markören nära ett element\n"
"· • {:s} – Extrudera kanter genom att flytta markören\n"
"· • {:s} – Ta bort meshelement"

#: scripts/startup/bl_ui/space_view3d_toolbar.py:994
msgctxt "Operator"
msgid "Remesh"
msgstr "Ommesha"

#: source/blender/nodes/geometry/nodes/node_geo_boolean.cc:32
msgid "Base mesh to subtract geometry from"
msgstr "Basmesh för att subtrahera geometri från"

#: source/blender/nodes/geometry/nodes/node_geo_boolean.cc:47
msgid "Mesh that is subtracted from the first mesh"
msgstr "Mesh som subtraheras från den första meshen"

#: source/blender/nodes/geometry/nodes/node_geo_curve_to_mesh.cc:38
msgid ""
"If the profile spline is cyclic, fill the ends of the generated mesh with N-"
"gons"
msgstr ""
"Om profilsplinen är cyklisk fylls ändarna av den genererade meshen med N-"
"hörningar"

#: source/blender/nodes/geometry/nodes/node_geo_deform_curves_on_surface.cc:260
msgid "Surface has no mesh"
msgstr "Ytan har ingen mesh"

#: source/blender/nodes/geometry/nodes/node_geo_dual_mesh.cc:28
msgid ""
"Keep non-manifold boundaries of the input mesh in place by avoiding the dual "
"transformation there"
msgstr ""
"Behåll icke-manifoldgränser i indatameshen på plats genom att undvika den "
"dubbla transformeringen där"

#: source/blender/nodes/geometry/nodes/node_geo_grid_to_mesh.cc:21
#: source/blender/nodes/geometry/nodes/node_geo_volume_to_mesh.cc:66
msgid "Values larger than the threshold are inside the generated mesh"
msgstr ""
"Värden som är större än tröskelvärdet ligger inom den genererade meshen"

#: source/blender/nodes/geometry/nodes/node_geo_input_mesh_face_area.cc:15
msgid "The surface area of each of the mesh's faces"
msgstr "Ytarean för var och en av meshens ytor"

#: source/blender/nodes/geometry/nodes/node_geo_input_mesh_island.cc:22
msgid "The total number of mesh islands"
msgstr "Det totala antalet meshöar"

#: source/blender/nodes/geometry/nodes/node_geo_merge_by_distance.cc:37
#: source/blender/nodes/geometry/nodes/node_geo_merge_points.cc:23
msgid "Point cloud or mesh to merge points of"
msgstr "Punktmoln eller mesh vars punkter ska sammanfogas"

#: source/blender/nodes/geometry/nodes/node_geo_mesh_bevel.cc:118
msgid "Identifies output faces that are in the new mesh parts for vertices"
msgstr "Identifierar utdataytor i meshens nya delar för hörnpunkter"

#: source/blender/nodes/geometry/nodes/node_geo_mesh_bevel.cc:122
msgid "Identifies output faces that are in the new mesh parts for edges"
msgstr "Identifierar utdataytor i meshens nya delar för kanter"

#: source/blender/nodes/geometry/nodes/node_geo_mesh_bevel.cc:126
msgid ""
"Identifies output edges that are on the outsides of new mesh parts for edges"
msgstr "Identifierar utdatakanter på utsidan av meshens nya delar för kanter"

#: source/blender/nodes/geometry/nodes/node_geo_mesh_bevel.cc:130
msgid ""
"Identifies output edges that are in the middle of new mesh parts of edges "
"and continued through vertices (round down if odd number of segments)"
msgstr ""
"Identifierar utdatakanter mitt i meshens nya delar för kanter och som "
"fortsätter genom hörnpunkter (avrunda nedåt vid udda antal segment)"

#: source/blender/nodes/geometry/nodes/node_geo_points_to_vertices.cc:20
msgid "Points that are converted to vertices in a mesh"
msgstr "Punkter som konverteras till hörnpunkter i en mesh"

#: source/blender/nodes/geometry/nodes/node_geo_raycast.cc:260
msgid "The target mesh must have faces"
msgstr "Målmeshen måste ha ytor"

#: source/blender/nodes/geometry/nodes/node_geo_realize_instances.cc:44
msgid "Preserve the apparent face orientation of mirrored mesh instances"
msgstr "Bevara den synliga ytorienteringen för speglade meshinstanser"

#: source/blender/nodes/geometry/nodes/node_geo_sample_nearest.cc:315
msgid "The source geometry must contain a mesh or a point cloud"
msgstr "Källgeometrin måste innehålla en mesh eller ett punktmoln"

#: source/blender/nodes/geometry/nodes/node_geo_sample_nearest_surface.cc:229
#: source/blender/nodes/geometry/nodes/node_geo_sample_uv_surface.cc:170
msgid "The source mesh must have faces"
msgstr "Källmeshen måste ha ytor"

#: source/blender/nodes/geometry/nodes/node_geo_sample_nearest_surface.cc:38
msgid ""
"Splits the faces of the input mesh into groups which can be sampled "
"individually"
msgstr "Delar upp ytorna i indatameshen i grupper som kan samplas var för sig"

#: source/blender/nodes/geometry/nodes/node_geo_subdivision_surface.cc:212
msgid "Subdivision result mesh is too large for uniform subdivision"
msgstr ""
"Underindelningsresultatets mesh är för stor för enhetlig underindelning"

#: source/blender/nodes/geometry/nodes/node_geo_subdivision_surface.cc:240
msgid "Subdivision failed for some geometry. Original mesh returned."
msgstr ""
"Underindelning misslyckades för viss geometri. Den ursprungliga meshen "
"returneras."

#: source/blender/nodes/geometry/nodes/node_geo_tool_active_element.cc:22
msgid "True if an active element exists in the mesh, false otherwise"
msgstr "Sant om ett aktivt element finns i meshen, annars falskt"

#: source/blender/nodes/geometry/nodes/node_geo_uv_unwrap.cc:20
msgid "This method gives a good 2D representation of a mesh"
msgstr "Denna metod ger en bra 2D-representation av en mesh"

#: source/blender/nodes/geometry/nodes/node_geo_uv_unwrap.cc:46
msgid "Edges to mark where the mesh is \"cut\" for the purposes of unwrapping"
msgstr "Kanter att markera där meshen ”klipps” vid uppackning"

#: source/blender/nodes/geometry/nodes/node_geo_volume_to_mesh.cc:49
msgid "Volume to convert to a mesh"
msgstr "Volym att konvertera till en mesh"

#. :src: Asset description from file geometry_nodes_dynamics_assets.blend
msgid "Simulate dynamic cloth behavior on mesh geometry"
msgstr "Simulerar dynamiskt tygbeteende på meshgeometri"

#. :src: Asset description from file geometry_nodes_dynamics_assets.blend
msgid "Set up a mesh as an external colliider"
msgstr "Konfigurerar en mesh som extern kolliderare"

#. :src: Socket description from node group Collider, file geometry_nodes_dynamics_assets.blend
msgid ""
"If true, the simulated geometry should stay within the mesh instead of it "
"being pushed out of it."
msgstr ""
"Om sant ska den simulerade geometrin stanna inom meshen i stället för att "
"pressas ut ur det."

#. :src: Socket description from node group Hair Dynamics, file geometry_nodes_dynamics_assets.blend
msgid "The surface mesh is deforming."
msgstr "Ytmeshen deformeras."

#. :src: Socket description from node group Hair Dynamics, file geometry_nodes_dynamics_assets.blend
msgid "Collide with the surface mesh the hair is attached to."
msgstr "Kolliderar med ytmeshen som håret är fäst vid."

#. :src: Socket description from node group Hair Dynamics, file geometry_nodes_dynamics_assets.blend
msgid "Settings for collisions with the surface mesh."
msgstr "Inställningar för kollisioner med ytmeshen."

#. :src: Asset description from file geometry_nodes_essentials.blend
msgid "Convert curve geometry into tube meshes"
msgstr "Konvertera kurvgeometri till rörmesh"

#. :src: Socket description from node group Curve to Tube, file geometry_nodes_essentials.blend
msgid ""
"Combine the cap geometry with the base mesh (realizing instances and merging "
"vertices)"
msgstr ""
"Kombinera lockets geometri med basmeshen (genom att realisera instanser och "
"slå samman hörnpunkter)"

#. :src: Socket description from node group Curve to Tube, file geometry_nodes_essentials.blend
msgid "Tube mesh"
msgstr "Rörmesh"

#. :src: Socket description from node group Curve to Tube, file geometry_nodes_essentials.blend
msgid "Resample the input curve before meshing"
msgstr "Omprovtar indatakurvan före meshgenerering"

#. :src: Socket description from node group Is Edge Boundary, file geometry_nodes_essentials.blend
msgid "Selection of edges that are part of the boundary of a mesh surface"
msgstr "Val av kanter som ingår i gränsen för en meshyta"

#. :src: Socket description from node group Is Edge Manifold, file geometry_nodes_essentials.blend
msgid "Selection of edges that connect two faces of a mesh surface"
msgstr "Val av kanter som förbinder två ytor i en meshstruktur"

#. :src: Asset description from file geometry_nodes_essentials.blend
msgid "Scatter referenced geometry on a surface mesh"
msgstr "Sprid refererad geometri på en ytmesh"

#. :src: Menu item description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
#. :src: Menu item description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
msgid "Use the incoming surface input mesh"
msgstr "Använder indatans ytmesh"
