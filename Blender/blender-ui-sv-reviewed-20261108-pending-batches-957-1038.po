msgstr "Meshen saknar ytor för materialtilldelning"

msgid "Mesh to set the custom normals on"
msgstr "Mesh att ange anpassade normaler för"

msgid "Mesh to triangulate"
msgstr "Mesh att triangulera"

msgid "Mesh on whose faces to distribute points on"
msgstr "Mesh vars ytor punkter ska fördelas på"

msgid "Mesh to subdivide"
msgstr "Mesh att dela upp"

