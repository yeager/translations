#. :src: bpy.types.ActionConstraint.mix_mode:'REPLACE'
msgid "Replace the original transformation with the action channels"
msgstr "Ersätt den ursprungliga transformeringen med Action-kanalerna"

#. :src: bpy.types.NlaStrip.action_frame_end
msgid "Last frame from action to use"
msgstr "Sista bildrutan från Actionen som ska användas"

#. :src: bpy.types.NlaStrip.action_frame_start
msgid "First frame from action to use"
msgstr "Första bildrutan från Actionen som ska användas"

#. :src: bpy.types.NlaStrip.last_slot_identifier
msgid ""
"The identifier of the most recently assigned action slot. The slot "
"identifies which sub-set of the Action is considered to be for this strip, "
"and its identifier is used to find the right slot when assigning an Action."
msgstr ""
"Identifieraren för den senast tilldelade Action-slotten. Slotten anger "
"vilken delmängd av Actionen som avses för denna remsa, och dess "
"identifierare används för att hitta rätt slot när en Action tilldelas."

#. :src: bpy.types.NlaStrip.use_sync_length
msgid ""
"Update range of frames referenced from action after tweaking strip and its "
"keyframes"
msgstr ""
"Uppdatera intervallet med bildrutor som refereras från Actionen efter att "
"remsan och dess nyckelbildrutor har justerats"

#. :src: bpy.types.NLA_OT_bake
msgid ""
"Bake all selected objects location/scale/rotation animation to an action"
msgstr ""
"Baka alla valda objekts positions-, skalnings- och rotationsanimering till "
"en Action"

#. :src: bpy.types.ACTION_OT_unlink
#. :src: bpy.types.NLA_OT_action_unlink
msgid "Unlink this action from the active action slot (and/or exit Tweak Mode)"
msgstr ""
"Koppla bort den här Actionen från den aktiva Action-slotten (och/eller "
"avsluta justeringsläget)"

#. :src: bpy.types.NLA_OT_action_pushdown
msgid "Push action down onto the top of the NLA stack as a new strip"
msgstr "Skjut ned Actionen överst i NLA-stacken som en ny remsa"

#. :src: bpy.types.NLA_OT_action_pushdown.track_index
msgid "Index of NLA action track to perform pushdown operation on"
msgstr "Index för NLA-Action-spåret som Actionen ska skjutas ned i"

#. :src: bpy.types.NLA_OT_bake.use_current_action
msgid ""
"Bake animation into current action, instead of creating a new one (useful "
"for baking only part of bones in an armature)"
msgstr ""
"Baka animeringen i den aktuella Actionen i stället för att skapa en ny "
"(användbart när endast delar av ben i en armatur ska bakas)"

#. :src: bpy.types.NLA_OT_duplicate.linked
msgid "When duplicating strips, assign new copies of the actions they use"
msgstr ""
"När du duplicerar remsor, tilldela dem nya kopior av de Actioner de använder"

#. :src: bpy.types.NLA_OT_make_single_user
msgid "Make linked action local to each strip"
msgstr "Gör länkad Action lokal för varje remsa"

#. :src: bpy.types.NLA_OT_tweakmode_enter
msgid ""
"Enter tweaking mode for the action referenced by the active strip to edit "
"its keyframes"
msgstr ""
"Gå in i justeringsläget för den Action som den aktiva remsan refererar till "
"för att redigera dess nyckelrutor"

#. :src: bpy.types.NLA_OT_tweakmode_exit
msgid "Exit tweaking mode for the action referenced by the active strip"
msgstr ""
"Avsluta justeringsläget för den Action som den aktiva remsan refererar till"

#. :src: bpy.types.SpaceNLA.show_local_markers
msgid ""
"Show action-local markers on the strips, useful when synchronizing timing "
"across strips"
msgstr ""
"Visa Action-lokala markörer på remsorna, vilket är användbart vid "
"synkronisering av tidpunkter mellan remsor"

#. :src: bpy.types.ThemeNLAEditor.active_action
msgid "Animation data-block has active action"
msgstr "Animationsdatablocket har en aktiv Action"

#. :src: bpy.types.ThemeNLAEditor.active_action_unset
msgid "Animation data-block does not have active action"
msgstr "Animationsdatablocket har ingen aktiv Action"

#. :src: bpy.types.ThemeNLAEditor.tweak
msgid "Color for strip/action being \"tweaked\" or edited"
msgstr "Färg för remsa/Action som finjusteras eller redigeras"

#. :src: bpy.types.ActionChannelbag
msgid ""
"Collection of animation channels, typically associated with an action slot"
msgstr "Samling av animationskanaler, vanligtvis kopplade till en Action-slot"

#. :src: bpy.types.ActionChannelbagFCurves
msgid "Collection of F-Curves for a specific action slot, on a specific strip"
msgstr "Samling av F-kurvor för en specifik Action-slot i en specifik remsa"

#. :src: bpy.types.ActionChannelbags
msgid ""
"For each action slot, a list of animation channels that are meant for that "
"slot"
msgstr ""
"För varje Action-slot finns en lista över animationskanaler avsedda för den "
"slotten"

#. :src: bpy.types.ActionPoseMarkers.active
msgid "Active pose marker for this action"
msgstr "Aktiv posemarkör för denna Action"

#. :src: bpy.types.ActionSlots
msgid "Collection of action slots"
msgstr "Samling av Action-slotar"

#. :src: bpy.types.ActionSlots.active
msgid "Active slot for this action"
msgstr "Aktiv Action-slot för denna Action"

#. :src: bpy.types.ActionStrip.type:'KEYFRAME'
#. :src: bpy.types.ActionKeyframeStrip
msgid "Strip with a set of F-Curves for each action slot"
msgstr "Remsa med en uppsättning F-kurvor för varje Action-slot"

#. :src: bpy.types.AnimData.action_slot_handle_tweak_storage
msgid "Storage to temporarily hold the main action slot while in tweak mode"
msgstr ""
"Lagring för att tillfälligt behålla huvud-Action-slotten i justeringsläge"

#. :src: bpy.types.AnimData.last_slot_identifier
msgid ""
"The identifier of the most recently assigned action slot. The slot "
"identifies which sub-set of the Action is considered to be for this data-"
"block, and its identifier is used to find the right slot when assigning an "
"Action."
msgstr ""
"Identifieraren för den senast tilldelade Action-slotten. Action-slotten "
"anger vilken delmängd av Actionen som avses för det här datablocket; "
"identifieraren används för att hitta rätt slot när en Action tilldelas."

#. :src: bpy.types.BlendDataActions
msgid "Collection of actions"
msgstr "Samling av Actioner"

#. :src: bpy.types.PreferencesView.use_fresnel_edit
msgid ""
"Enable a fresnel effect on edit mesh overlays.\n"
"It improves shape readability of very dense meshes, but increases eye "
"fatigue when modeling lower poly"
msgstr ""
"Aktivera en Fresnel-effekt för meshöverlägg i redigeringsläge.\n"
"Det förbättrar formens läsbarhet i mycket täta meshar, men ökar "
"ögontröttheten vid modellering med färre polygoner"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'FRONT'
msgid ""
"Treat only front side of the surface as a light, usually for closed meshes "
"whose interior is not visible"
msgstr ""
"Behandla bara ytans framsida som en ljuskälla, vanligtvis för slutna meshar "
"vars insida inte är synlig"

#. :src: bpy.types.RenderSettings.use_simplify_normals
msgid ""
"Skip computing custom normals and face corner normals for displaying meshes "
"in the viewport"
msgstr ""
"Hoppa över beräkning av anpassade normaler och ythörnsnormaler för visning "
"av meshar i visningsområdet"

#. :src: bpy.types.RigidBodyObject.mesh_source:'BASE'
msgid "Base mesh"
msgstr "Basmesh"

#. :src: bpy.types.ToolSettings.mesh_select_mode
msgid "Which mesh elements selection works on"
msgstr "Vilka meshelement urvalet fungerar på"

msgid "The remesher cannot work on linked or override data"
msgstr "Ommesharen kan inte arbeta med länkade eller åsidosatta data"

msgid "The remesher cannot run from edit mode"
msgstr "Ommesharen kan inte köras från redigeringsläge"

msgid "The remesher cannot run with dyntopo activated"
msgstr "Ommesharen kan inte köras med dyntopo aktiverad"

msgid "The remesher cannot run with a Multires modifier in the modifier stack"
msgstr ""
"Ommesharen kan inte köras med en Multires-modifierare i modifierarstapeln"

