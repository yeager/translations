msgstr "Den ursprungliga ytmeshen är tom"

msgid "Missing surface mesh"
msgstr "Ytmesh saknas"

msgid "Create Mesh From Paint Mask"
msgstr "Skapa mesh från målningsmask"

msgid "No valid target mesh"
msgstr "Ingen giltig målmesh"

