#: source/blender/editors/mesh/mesh_data.cc:968
msgid "Cannot remove more vertices than the mesh contains"
msgstr "Det går inte att ta bort fler hörnpunkter än vad meshen innehåller"

#: source/blender/editors/mesh/mesh_data.cc:982
msgid "Cannot remove more edges than the mesh contains"
msgstr "Det går inte att ta bort fler kanter än vad meshen innehåller"

#: source/blender/editors/mesh/mesh_data.cc:996
msgid "Cannot remove more loops than the mesh contains"
msgstr "Det går inte att ta bort fler meshslingor än vad meshen innehåller"

#: source/blender/editors/mesh/mesh_data.cc:1010
msgid "Cannot remove more polys than the mesh contains"
msgstr "Det går inte att ta bort fler polygoner än vad meshen innehåller"

#: source/blender/editors/object/object_add.cc:2466
#: source/blender/editors/sculpt_paint/mesh/paint_image_proj.cc:6434
msgid "No active mesh object"
msgstr "Inget aktivt meshobjekt"

#: source/blender/editors/object/object_bake.cc:115
msgid "Baking of multires data only works with an active mesh object"
msgstr "Bakning av multires-data fungerar endast med ett aktivt meshobjekt"

#: source/blender/editors/object/object_bake_api.cc:1634
msgid "Failed to access mesh from object \"%s\", ensure it's visible while rendering"
msgstr "Det gick inte att komma åt meshen från objektet ”%s”. Se till att den är synlig under rendering"

#: source/blender/editors/object/object_data_transfer.cc:645
msgid "Transfer data layer(s) (weights, edge sharp, etc.) from selected meshes to active one"
msgstr "Överför datalager (vikter, kantskärpa etc.) från valda meshar till den aktiva meshen"

#: source/blender/editors/object/object_multires_modifier.cc:212
msgid "Second selected mesh object required to copy shape from"
msgstr "Ett andra valt meshobjekt krävs för att kopiera formen"

#: source/blender/editors/sculpt_paint/curves/sculpt_brush.cc:410
msgid "Evaluated surface mesh is empty"
msgstr "Den utvärderade ytmeshen är tom"
