#. :src: bpy.types.CurveMapping.tone:'STANDARD'
msgid ""
"Combined curve is applied to each channel individually, which may result in "
"a change of hue"
msgstr ""
"Den kombinerade kurvan tillämpas på varje kanal för sig, vilket kan ändra "
"färgtonen"

#. :src: bpy.types.CurveMapping.tone:'FILMLIKE'
msgid "Filmlike"
msgstr "Filmliknande"

#. :src: bpy.types.CurveMapping.tone:'FILMLIKE'
msgid "Keeps the hue constant"
msgstr "Håller färgtonen konstant"

#. :src: bpy.types.CurveMapping.use_clip
msgid "Force the curve view to fit a defined boundary"
msgstr "Tvinga kurvvyn att passa inom en definierad gräns"
