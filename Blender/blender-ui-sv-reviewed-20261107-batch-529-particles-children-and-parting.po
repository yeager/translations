#. :src: bpy.types.ParticleSettings.adaptive_angle
msgid "How many degrees path has to curve to make another render segment"
msgstr "Hur många grader måste banan böjas för att göra ett nytt rendersegment"

#. :src: bpy.types.ParticleSettings.adaptive_pixel
#. :src: bpy.types.SpaceUVEditor.grid_shape_source:'PIXEL'
msgid "Pixel"
msgstr "Bildpunkt"

#. :src: bpy.types.ParticleSettings.adaptive_pixel
msgid "How many pixels path has to cover to make another render segment"
msgstr ""
"Hur många pixlar måste banan täcka för att skapa ett nytt rendersegment"

#. :src: bpy.types.ParticleSettings.angular_velocity_factor
msgid "Angular velocity amount (in radians per second)"
msgstr "Vinkelhastighetens storlek (i radianer per sekund)"

#. :src: bpy.types.ParticleSettings.angular_velocity_mode:'GLOBAL_X'
#. :src: bpy.types.ParticleSettings.rotation_mode:'GLOB_X'
msgid "Global X"
msgstr "Global X"

#. :src: bpy.types.ParticleSettings.angular_velocity_mode:'GLOBAL_Y'
#. :src: bpy.types.ParticleSettings.rotation_mode:'GLOB_Y'
msgid "Global Y"
msgstr "Global Y"

#. :src: bpy.types.ParticleSettings.angular_velocity_mode:'GLOBAL_Z'
#. :src: bpy.types.ParticleSettings.rotation_mode:'GLOB_Z'
msgid "Global Z"
msgstr "Global Z"

#. :src: bpy.types.ParticleSettings.apply_effector_to_children
msgid "Affect Children"
msgstr "Påverka barnpartiklar"

#. :src: bpy.types.ParticleSettings.apply_effector_to_children
msgid "Apply effectors to children"
msgstr "Tillämpa effektorer på barnpartiklar"

#. :src: bpy.types.ParticleSettings.bending_random
msgid "Random Bending Stiffness"
msgstr "Slumpmässig böjstyvhet"

#. :src: bpy.types.ParticleSettings.bending_random
msgid "Random stiffness of hairs"
msgstr "Slumpmässig styvhet hos hårstrån"

#. :src: bpy.types.ParticleSettings.branch_threshold
msgid "Threshold of branching"
msgstr "Tröskelvärde för förgrening"

#. :src: bpy.types.ParticleSettings.brownian_factor
msgid "Brownian"
msgstr "Brownsk rörelse"

#. :src: bpy.types.ParticleSettings.brownian_factor
msgid "Amount of random, erratic particle movement"
msgstr "Mängd slumpmässiga, oregelbundna partikelrörelser"

#. :src: bpy.types.ParticleSettings.child_length
msgid "Length of child paths"
msgstr "Längd på barnpartikelbanor"

#. :src: bpy.types.ParticleSettings.child_length_threshold
msgid "Amount of particles left untouched by child path length"
msgstr "Andel partiklar som inte påverkas av barnpartikelbanans längd"

#. :src: bpy.types.ParticleSettings.child_parting_factor
msgid "Parting Factor"
msgstr "Bena"

#. :src: bpy.types.ParticleSettings.child_parting_factor
msgid "Create parting in the children based on parent strands"
msgstr "Skapa en bena bland barnpartiklarna baserat på föräldratrådar"

#. :src: bpy.types.ParticleSettings.child_parting_max
msgid "Parting Maximum"
msgstr "Största benvinkel"

#. :src: bpy.types.ParticleSettings.child_parting_max
msgid "Maximum root to tip angle (tip distance/root distance for long hair)"
msgstr ""
"Maximal vinkel från rot till spets (spetsavstånd/rotavstånd för långt hår)"

#. :src: bpy.types.ParticleSettings.child_parting_min
msgid "Parting Minimum"
msgstr "Minsta benvinkel"

#. :src: bpy.types.ParticleSettings.child_parting_min
msgid "Minimum root to tip angle (tip distance/root distance for long hair)"
msgstr ""
"Minsta vinkel från rot till spets (spetsavstånd/rotavstånd för långt hår)"

#. :src: bpy.types.ParticleSettings.child_percent
msgid "Children Per Parent"
msgstr "Barnpartiklar per förälder"

#. :src: bpy.types.ParticleSettings.child_percent
msgid "Number of children per parent"
msgstr "Antal barnpartiklar per förälder"

#. :src: bpy.types.ParticleSettings.child_radius
msgid "Child Radius"
msgstr "Barnpartikelradie"

#. :src: bpy.types.ParticleSettings.child_radius
msgid "Radius of children around parent"
msgstr "Radie för barnpartiklar runt föräldern"

#. :src: bpy.types.ParticleSettings.child_roundness
msgid "Child Roundness"
msgstr "Barnpartikelrundhet"

#. :src: bpy.types.ParticleSettings.child_roundness
msgid "Roundness of children around parent"
msgstr "Barnens rundhet runt föräldern"

#. :src: bpy.types.ParticleSettings.child_size
msgid "Child Size"
msgstr "Barnpartikelstorlek"

#. :src: bpy.types.ParticleSettings.child_size
msgid "A multiplier for the child particle size"
msgstr "En multiplikator för barnpartikelstorleken"

#. :src: bpy.types.ParticleSettings.child_size_random
msgid "Random Child Size"
msgstr "Slumpmässig barnpartikelstorlek"

#. :src: bpy.types.ParticleSettings.child_size_random
msgid "Random variation to the size of the child particles"
msgstr "Slumpmässig variation i storleken på barnpartiklarna"

#. :src: bpy.types.ParticleSettings.child_type
msgid "Children From"
msgstr "Barnpartiklar från"

#. :src: bpy.types.ParticleSettings.child_type
msgid "Create child particles"
msgstr "Skapa barnpartiklar"

#. :src: bpy.types.ParticleSettings.child_type:'SIMPLE'
#. :src: bpy.types.CorrectiveSmoothModifier.smooth_type:'SIMPLE'
#. :src: bpy.types.GreasePencilSubdivModifier.subdivision_type:'SIMPLE'
#. :src: bpy.types.SolidifyModifier.solidify_mode:'EXTRUDE'
#. :src: bpy.types.SubsurfModifier.subdivision_type:'SIMPLE'
#. :src: bpy.types.CompositorNodeColorSpill.limit_method:'SIMPLE'
#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode:'SIMPLE'
#. :src: bpy.types.SoftBodySettings.aerodynamics_type:'SIMPLE'
#: source/blender/modifiers/intern/MOD_multires.cc:355
msgid "Simple"
msgstr "Enkel"

#. :src: bpy.types.ParticleSettings.child_type:'INTERPOLATED'
#. :src: bpy.types.GeometryNodeRaycast.mapping:'INTERPOLATED'
msgid "Interpolated"
msgstr "Interpolerad"
