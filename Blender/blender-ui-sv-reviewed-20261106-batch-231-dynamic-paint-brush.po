#. :src: bpy.types.DynamicPaintBrushSettings.paint_distance
msgid "Maximum distance from brush to mesh surface to affect paint"
msgstr "Största avståndet från penseln till meshytan som påverkar färgen"

#. :src: bpy.types.DynamicPaintBrushSettings.paint_ramp
msgid "Paint Color Ramp"
msgstr "Målningsfärggradient"

#. :src: bpy.types.DynamicPaintBrushSettings.paint_ramp
msgid "Color ramp used to define proximity falloff"
msgstr "Färggradient som används för att definiera närhetsavtagandet"

#. :src: bpy.types.DynamicPaintBrushSettings.paint_wetness
msgid "Paint Wetness"
msgstr "Färgens våthet"

#. :src: bpy.types.DynamicPaintBrushSettings.paint_wetness
msgid "Paint wetness, visible in wetmap (some effects only affect wet paint)"
msgstr ""
"Färgens våthet, synlig i våtkartan (vissa effekter påverkar endast våt färg)"

#. :src: bpy.types.DynamicPaintBrushSettings.proximity_falloff
msgctxt "Brush"
msgid "Falloff"
msgstr "Avtagande"

#. :src: bpy.types.DynamicPaintBrushSettings.proximity_falloff:'RAMP'
msgctxt "Brush"
msgid "Color Ramp"
msgstr "Färggradient"

#. :src: bpy.types.DynamicPaintBrushSettings.ray_direction:'CANVAS'
msgid "Canvas Normal"
msgstr "Duknormal"

#. :src: bpy.types.DynamicPaintBrushSettings.ray_direction:'BRUSH'
msgid "Brush Normal"
msgstr "Penselnormal"

#. :src: bpy.types.DynamicPaintBrushSettings.smooth_radius
#: scripts/startup/bl_ui/properties_physics_dynamicpaint.py:768
msgid "Smooth Radius"
msgstr "Utjämningsradie"

#. :src: bpy.types.DynamicPaintBrushSettings.smooth_radius
msgid "Smooth falloff added after solid radius"
msgstr "Jämnt avtagande läggs till utanför den heltäckande radien"

#. :src: bpy.types.DynamicPaintBrushSettings.smudge_strength
msgid "Smudge Strength"
msgstr "Smetningsstyrka"

#. :src: bpy.types.DynamicPaintBrushSettings.smudge_strength
msgid "Smudge effect strength"
msgstr "Smetningseffektens styrka"

#. :src: bpy.types.DynamicPaintBrushSettings.solid_radius
msgid "Solid Radius"
msgstr "Heltäckande radie"

#. :src: bpy.types.DynamicPaintBrushSettings.solid_radius
msgid "Radius that will be painted solid"
msgstr "Radie som målas heltäckande"

#. :src: bpy.types.DynamicPaintBrushSettings.use_negative_volume
msgid "Negate Volume"
msgstr "Invertera volym"

#. :src: bpy.types.DynamicPaintBrushSettings.use_negative_volume
msgid "Negate influence inside the volume"
msgstr "Invertera påverkan inuti volymen"

#. :src: bpy.types.DynamicPaintBrushSettings.use_proximity_ramp_alpha
#: scripts/startup/bl_ui/properties_physics_dynamicpaint.py:819
msgid "Only Use Alpha"
msgstr "Använd endast alfa"

#. :src: bpy.types.DynamicPaintBrushSettings.use_proximity_ramp_alpha
msgid "Only read color ramp alpha"
msgstr "Läs endast färggradientens alfa"

#. :src: bpy.types.DynamicPaintBrushSettings.use_smudge
msgid "Do Smudge"
msgstr "Smeta ut"

#. :src: bpy.types.DynamicPaintBrushSettings.use_smudge
msgid "Make this brush to smudge existing paint as it moves"
msgstr "Låt den här penseln smeta ut befintlig färg när den rör sig"

#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_alpha
#. :src: bpy.types.EffectStrip.multiply_alpha
#. :src: bpy.types.ImageStrip.multiply_alpha
#. :src: bpy.types.MaskStrip.multiply_alpha
#. :src: bpy.types.MetaStrip.multiply_alpha
#. :src: bpy.types.MovieClipStrip.multiply_alpha
#. :src: bpy.types.MovieStrip.multiply_alpha
#. :src: bpy.types.SceneStrip.multiply_alpha
msgid "Multiply Alpha"
msgstr "Multiplicera alfa"

#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_alpha
msgid "Multiply brush influence by velocity color ramp alpha"
msgstr ""
"Multiplicera penselns påverkan med alfavärdet från hastighetsfärggradienten"

#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_depth
msgid ""
"Multiply brush intersection depth (displace, waves) by velocity ramp alpha"
msgstr ""
"Multiplicera penselns skärningsdjup (förskjutning, vågor) med alfavärdet "
"från hastighetsgradienten"

#. :src: bpy.types.DynamicPaintBrushSettings.velocity_max
#. :src: bpy.types.Itasc.velocity_max
msgid "Max Velocity"
msgstr "Maximal hastighet"

#. :src: bpy.types.DynamicPaintBrushSettings.velocity_ramp
msgid "Velocity Color Ramp"
msgstr "Hastighetsfärggradient"

#. :src: bpy.types.DynamicPaintBrushSettings.velocity_ramp
msgid "Color ramp used to define brush velocity effect"
msgstr "Färggradient som används för att definiera penselns hastighetseffekt"

#. :src: bpy.types.DynamicPaintBrushSettings.wave_clamp
msgid "Clamp Waves"
msgstr "Begränsa vågor"

#. :src: bpy.types.DynamicPaintBrushSettings.wave_clamp
msgid ""
"Maximum level of surface intersection used to influence waves (use 0.0 to "
"disable)"
msgstr ""
"Högsta nivå av ytskärning som används för att påverka vågorna (använd 0,0 "
"för att inaktivera)"
