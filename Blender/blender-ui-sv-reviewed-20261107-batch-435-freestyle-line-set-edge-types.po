msgid "Collection"
msgstr "Samling"

#. :src: bpy.types.FreestyleLineSet.collection
msgid "A collection of objects based on which feature edges are selected"
msgstr "En samling objekt vars funktionskanter väljs"

#. :src: bpy.types.FreestyleLineSet.collection_negation
msgid ""
"Specify either inclusion or exclusion of feature edges belonging to a "
"collection of objects"
msgstr ""
"Ange antingen inkludering eller exkludering av funktionskanter som tillhör "
"en samling objekt"

#. :src: bpy.types.FreestyleLineSet.collection_negation:'INCLUSIVE'
#. :src: bpy.types.FreestyleLineSet.edge_type_negation:'INCLUSIVE'
#. :src: bpy.types.FreestyleLineSet.face_mark_negation:'INCLUSIVE'
msgid "Inclusive"
msgstr "Inkluderande"

#. :src: bpy.types.FreestyleLineSet.collection_negation:'INCLUSIVE'
msgid "Select feature edges belonging to some object in the group"
msgstr "Välj funktionskanter som hör till något objekt i gruppen"

#. :src: bpy.types.FreestyleLineSet.collection_negation:'EXCLUSIVE'
#. :src: bpy.types.FreestyleLineSet.edge_type_negation:'EXCLUSIVE'
#. :src: bpy.types.FreestyleLineSet.face_mark_negation:'EXCLUSIVE'
msgid "Exclusive"
msgstr "Exkluderande"

#. :src: bpy.types.FreestyleLineSet.collection_negation:'EXCLUSIVE'
msgid "Select feature edges not belonging to any object in the group"
msgstr "Välj funktionskanter som inte tillhör något objekt i gruppen"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination
msgid ""
"Specify a logical combination of selection conditions on feature edge types"
msgstr "Ange en logisk kombination av urvalsvillkor för funktionskantstyper"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination:'OR'
msgid "Select feature edges satisfying at least one of edge type conditions"
msgstr "Välj funktionskanter som uppfyller minst ett av villkoren för kanttyp"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination:'AND'
msgid "Select feature edges satisfying all edge type conditions"
msgstr "Välj funktionskanter som uppfyller alla villkor för kanttyp"

#. :src: bpy.types.FreestyleLineSet.edge_type_negation
msgid ""
"Specify either inclusion or exclusion of feature edges selected by edge types"
msgstr ""
"Ange antingen inkludering eller exkludering av funktionskanter som valts av "
"kanttyper"

#. :src: bpy.types.FreestyleLineSet.edge_type_negation:'INCLUSIVE'
msgid "Select feature edges satisfying the given edge type conditions"
msgstr "Välj funktionskanter som uppfyller de angivna villkoren för kanttyp"

#. :src: bpy.types.FreestyleLineSet.edge_type_negation:'EXCLUSIVE'
msgid "Select feature edges not satisfying the given edge type conditions"
msgstr "Välj funktionskanter som inte uppfyller de givna villkoren för kanttyp"

#. :src: bpy.types.FreestyleLineSet.exclude_border
#. :src: bpy.types.FreestyleLineSet.select_border
msgid "Border"
msgstr "Gräns"

#. :src: bpy.types.FreestyleLineSet.exclude_border
msgid "Exclude border edges"
msgstr "Uteslut gränskanter"

#. :src: bpy.types.FreestyleLineSet.exclude_contour
#. :src: bpy.types.FreestyleLineSet.select_contour
#. :src: bpy.types.GreasePencilLineartModifier.silhouette_filtering:'NONE'
msgid "Contour"
msgstr "Kontur"

#. :src: bpy.types.FreestyleLineSet.exclude_contour
msgid "Exclude contours"
msgstr "Uteslut konturer"

#. :src: bpy.types.FreestyleLineSet.exclude_crease
#. :src: bpy.types.FreestyleLineSet.select_crease
#. :src: bpy.types.DataTransferModifier.data_types_edges:'CREASE'
