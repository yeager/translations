#. :src: bpy.types.GreasePencilBuildModifier.frame_end
msgid "End Frame (when Restrict Frame Range is enabled)"
msgstr "Slutbildruta (när Begränsa bildruteintervall är aktiverat)"

#. :src: bpy.types.GreasePencilBuildModifier.frame_start
msgid "Start Frame (when Restrict Frame Range is enabled)"
msgstr "Startbildruta (när Begränsa bildruteintervall är aktiverat)"

#. :src: bpy.types.GreasePencilBuildModifier.use_restrict_frame_range
msgid "Only modify strokes during the specified frame range"
msgstr "Modifiera endast streck under det angivna bildruteintervallet"

#. :src: bpy.types.MotionPath
msgid "Cache of the world-space positions of an element over a frame range"
msgstr "Cache av ett elements världsrymdspositioner över ett bildruteintervall"

#. :src: bpy.types.ANIM_OT_end_frame_set
msgid "Set the current frame as the preview or scene end frame"
msgstr ""
"Ställ in den aktuella bildrutan som förhandsgranskningens eller scenens "
"slutbildruta"

#. :src: bpy.types.ANIM_OT_scene_range_frame
msgid ""
"Reset the horizontal view to the current scene frame range, taking the "
"preview range into account if it is active"
msgstr ""
"Återställ den horisontella vyn till den aktuella scenens bildruteintervall, "
"med hänsyn till förhandsgranskningsintervallet om det är aktivt"

#. :src: bpy.types.ED_OT_lib_id_remove_preview
msgctxt "Operator"
msgid "Remove Preview"
msgstr "Ta bort förhandsgranskning"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_frame_range
msgid "Clips animations to selected playback range"
msgstr "Beskär animationer till det valda uppspelningsintervallet"
