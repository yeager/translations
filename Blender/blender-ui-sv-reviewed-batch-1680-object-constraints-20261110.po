#: source/blender/editors/object/object_collection.cc:1331
msgid "Exported %d files from collection '%s'"
msgstr "Exporterade %d filer från samlingen ”%s”"

#: source/blender/editors/object/object_data_transfer.cc:451
msgid ""
"Operator is frozen, changes to its settings won't take effect until you "
"unfreeze it"
msgstr ""
"Operatören är låst. Ändringar i inställningarna träder inte i kraft förrän "
"du låser upp den"

#: source/blender/editors/object/object_edit.cc:2295
msgid "Objects linked to %s"
msgstr "Objekt länkade till %s"

#: source/blender/editors/object/object_light_linking_ops.cc:146
msgid ""
"Cannot link to light linking collection '%s' that is used by scene '%s'"
msgstr ""
"Det går inte att länka till ljuslänkningssamlingen ”%s” som används av "
"scenen ”%s”"

#: source/blender/editors/object/object_light_linking_ops.cc:262
msgid ""
"Cannot unlink from light linking collection '%s' that is used by scene '%s'"
msgstr ""
"Det går inte att avlänka från ljuslänkningssamlingen ”%s” som används av "
"scenen ”%s”"

#: source/blender/editors/object/object_modes.cc:572
msgid ""
"Current mode of source object '%s' is not compatible with target liboverride"
" object '%s'"
msgstr ""
"Det aktuella läget ”%s” för källobjektet är inte kompatibelt med "
"biblioteksåsidosättningsobjektet ”%s”"

#: source/blender/editors/object/object_modes.cc:581
msgid ""
"Current mode of source object '%s' is not compatible with target object '%s'"
msgstr ""
"Det aktuella läget ”%s” för källobjektet är inte kompatibelt med målobjektet"
" ”%s”"

#: source/blender/editors/object/object_modifier.cc:2095
msgid "Make data single-user, apply modifier, and remove it from the list."
msgstr ""
"Gör data till enskild användare, tillämpa modifieraren och ta bort den från "
"listan."
