#. :src: bpy.types.ActionChannelbag
msgid "Animation Channel Bag"
msgstr "Animationskanalbehållare"

#. :src: bpy.types.ActionChannelbag
msgid ""
"Collection of animation channels, typically associated with an action slot"
msgstr "Samling av animationskanaler, vanligtvis kopplade till en åtgärdsslot"

#. :src: bpy.types.ActionChannelbag.fcurves
msgid "The individual F-Curves that animate the slot"
msgstr "De enskilda F-kurvorna som animerar åtgärdsslotten"

#. :src: bpy.types.ActionChannelbag.groups
#. :src: bpy.types.ActionChannelbagGroups
msgid "F-Curve Groups"
msgstr "F-kurvgrupper"

#. :src: bpy.types.ActionChannelbag.slot
#. :src: bpy.types.DOPESHEET_PT_action_slot
#. :src: bpy.types.NODE_PT_material_slots
#: scripts/startup/bl_ui/properties_constraint.py:1158
#: scripts/startup/bl_ui/space_node.py:418
#: source/blender/editors/space_image/image_buttons.cc:103
#: source/blender/editors/space_nla/nla_buttons.cc:345
msgid "Slot"
msgstr "Slot"

#. :src: bpy.types.ActionChannelbag.slot
msgid "The Slot that the Channelbag's animation data is for"
msgstr "Åtgärdsslotten som behållarens animationsdata gäller"

#. :src: bpy.types.ActionChannelbagFCurves
msgid "Collection of F-Curves for a specific action slot, on a specific strip"
msgstr "Samling av F-kurvor för en specifik åtgärdsslot i en specifik remsa"

#. :src: bpy.types.ActionChannelbagGroups
msgid "Collection of f-curve groups"
msgstr "Samling av F-kurvgrupper"

#. :src: bpy.types.ActionChannelbags
msgid "Animation Channels for Slots"
msgstr "Animationskanaler för åtgärdsslotar"

#. :src: bpy.types.ActionChannelbags
msgid ""
"For each action slot, a list of animation channels that are meant for that "
"slot"
msgstr ""
"För varje åtgärdsslot finns en lista med animationskanaler som är avsedda "
"för slotten"

#. :src: bpy.types.ActionFCurves
msgid "Action F-Curves"
msgstr "Åtgärdens F-kurvor"

#. :src: bpy.types.ActionFCurves
msgid ""
"Collection of action F-Curves. Note that this is a legacy API that is "
"unaware of action slots, and will only consider the F-Curves for this "
"action's first slot"
msgstr ""
"Samling av åtgärdens F-kurvor. Observera att detta är ett äldre API som inte "
"känner till åtgärdsslotar och endast beaktar F-kurvorna för åtgärdens första "
"åtgärdsslot"

#. :src: bpy.types.ActionGroup
msgid "Action Group"
msgstr "Åtgärdsgrupp"
