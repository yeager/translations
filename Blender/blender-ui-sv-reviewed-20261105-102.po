#. :src: bpy.types.BevelModifier.harden_normals
#. :src: bpy.types.MESH_OT_bevel.harden_normals
msgid "Match normals of new faces to adjacent faces"
msgstr "Anpassa normalerna för nya ytor till intilliggande ytor"

#. :src: bpy.types.BevelModifier.limit_method
msgid "Limit Method"
msgstr "Begränsningsmetod"

#. :src: bpy.types.BevelModifier.limit_method:'NONE'
msgid "Bevel the entire mesh by a constant amount"
msgstr "Fasa av hela meshen med ett konstant värde"

#. :src: bpy.types.BevelModifier.limit_method:'VGROUP'
msgid "Use vertex group weights to select whether vertex or edge is beveled"
msgstr ""
"Använd hörnpunktsgruppens vikter för att välja om hörnpunkt eller kant ska "
"fasas av"

#. :src: bpy.types.BevelModifier.mark_sharp
#. :src: bpy.types.MESH_OT_bevel.mark_sharp
#. :src: bpy.types.UV_OT_seams_from_islands.mark_sharp
msgid "Mark Sharp"
msgstr "Markera skarpa"

#. :src: bpy.types.BevelModifier.mark_sharp
#. :src: bpy.types.MESH_OT_bevel.mark_sharp
msgid "Mark beveled edges as sharp"
msgstr "Markera avfasade kanter som skarpa"

#. :src: bpy.types.BevelModifier.offset_type
#. :src: bpy.types.MESH_OT_bevel.offset_type
#: source/blender/editors/mesh/editmesh_bevel.cc:178
msgid "Width Type"
msgstr "Breddtyp"

#. :src: bpy.types.BevelModifier.offset_type
msgid "What distance Width measures"
msgstr "Vilket avstånd bredden mäter"

#. :src: bpy.types.BevelModifier.segments
msgid "Number of segments for round edges/verts"
msgstr "Antal segment för runda kanter/hörnpunkter"

#. :src: bpy.types.BevelModifier.use_clamp_overlap
#. :src: bpy.types.MESH_OT_bevel.clamp_overlap
msgid "Clamp Overlap"
msgstr "Begränsa överlappning"

#. :src: bpy.types.BevelModifier.use_clamp_overlap
msgid "Clamp the width to avoid overlap"
msgstr "Begränsa bredden för att undvika överlappning"

#. :src: bpy.types.BevelModifier.vertex_group
#. :src: bpy.types.CastModifier.vertex_group
#. :src: bpy.types.MaskModifier.vertex_group
#. :src: bpy.types.MeshDeformModifier.vertex_group
#. :src: bpy.types.ShrinkwrapModifier.vertex_group
#. :src: bpy.types.SimpleDeformModifier.vertex_group
#. :src: bpy.types.SolidifyModifier.vertex_group
#. :src: bpy.types.UVWarpModifier.vertex_group
#. :src: bpy.types.VertexWeightEditModifier.vertex_group
#. :src: bpy.types.VertexWeightProximityModifier.vertex_group
#. :src: bpy.types.VertexGroup.name
msgid "Vertex group name"
msgstr "Namn på hörnpunktsgrupp"

#. :src: bpy.types.BevelModifier.vertex_weight
#. :src: bpy.types.ShaderNodeTexPointDensity.vertex_color_source:'VERTEX_WEIGHT'
#. :src: bpy.types.VertexGroupElement.weight
msgid "Vertex Weight"
msgstr "Hörnpunktsvikt"

#. :src: bpy.types.BevelModifier.vertex_weight
msgid "Attribute name for vertex weight"
msgstr "Attributnamn för hörnpunktsvikt"

#. :src: bpy.types.BevelModifier.vmesh_method:'CUTOFF'
msgid "A cut-off at the end of each profile before the intersection"
msgstr "En avskärning i slutet av varje profil före korsningen"

#. :src: bpy.types.BevelModifier.width
#. :src: bpy.types.MESH_OT_bevel.offset
msgid "Bevel amount"
msgstr "Avfasningsmängd"

#. :src: bpy.types.BevelModifier.width_pct
#. :src: bpy.types.MESH_OT_bevel.offset_pct
msgid "Width Percent"
msgstr "Breddprocent"

#. :src: bpy.types.BooleanModifier.operand_type
msgid "Operand Type"
msgstr "Operandtyp"

#. :src: bpy.types.BooleanModifier.operation:'INTERSECT'
#. :src: bpy.types.GeometryNodeMeshBoolean.operation:'INTERSECT'
msgid "Keep the part of the mesh that is common between all operands"
msgstr "Behåll den del av meshen som är gemensam för alla operander"

#. :src: bpy.types.BooleanModifier.operation:'UNION'
#. :src: bpy.types.GeometryNodeMeshBoolean.operation:'UNION'
msgid "Combine meshes in an additive way"
msgstr "Kombinera meshar på ett additivt sätt"

#. :src: bpy.types.BooleanModifier.operation:'DIFFERENCE'
#. :src: bpy.types.GeometryNodeMeshBoolean.operation:'DIFFERENCE'
msgid "Combine meshes in a subtractive way"
msgstr "Kombinera meshar på ett subtraktivt sätt"

#. :src: bpy.types.BooleanModifier.solver
msgid "Method for calculating booleans"
msgstr "Metod för att beräkna booleska operationer"

#. :src: bpy.types.BooleanModifier.solver:'MANIFOLD'
#. :src: bpy.types.GeometryNodeMeshBoolean.solver:'MANIFOLD'
#. :src: bpy.types.SCULPT_OT_trim_box_gesture.trim_solver:'MANIFOLD'
#. :src: bpy.types.SCULPT_OT_trim_lasso_gesture.trim_solver:'MANIFOLD'
#. :src: bpy.types.SCULPT_OT_trim_line_gesture.trim_solver:'MANIFOLD'
#. :src: bpy.types.SCULPT_OT_trim_polyline_gesture.trim_solver:'MANIFOLD'
msgid "Manifold"
msgstr "Manifold"

#. :src: bpy.types.BooleanModifier.use_self
#. :src: bpy.types.MESH_OT_intersect_boolean.use_self
#: source/blender/nodes/geometry/nodes/node_geo_boolean.cc:50
msgid "Self Intersection"
msgstr "Självskärning"

#. :src: bpy.types.BuildModifier
#. :src: bpy.types.GreasePencilBuildModifier
msgid "Build Modifier"
msgstr "Byggmodifierare"

#. :src: bpy.types.BuildModifier
msgid "Build effect modifier"
msgstr "Byggeffektmodifierare"

#. :src: bpy.types.BuildModifier.seed
msgid "Seed for random if used"
msgstr "Frö för slumpning, om den används"

#. :src: bpy.types.BuildModifier.use_random_order
msgid "Randomize the faces or edges during build"
msgstr "Slumpa ordningen på ytorna eller kanterna under uppbyggnaden"

#. :src: bpy.types.CorrectiveSmoothModifier
msgid "Corrective Smooth Modifier"
msgstr "Modifierare för korrigerande utjämning"

#. :src: bpy.types.CorrectiveSmoothModifier
msgid "Correct distortion caused by deformation"
msgstr "Korrigera förvrängning som orsakas av deformation"

#. :src: bpy.types.CorrectiveSmoothModifier.factor
#. :src: bpy.types.LaplacianSmoothModifier.lambda_factor
msgid "Smooth effect factor"
msgstr "Faktor för utjämningseffekten"

#. :src: bpy.types.CorrectiveSmoothModifier.is_bind
msgid "Bind current shape"
msgstr "Bind aktuell form"

#. :src: bpy.types.CorrectiveSmoothModifier.rest_source:'ORCO'
msgid "Original Coords"
msgstr "Ursprungliga koordinater"

#. :src: bpy.types.CorrectiveSmoothModifier.rest_source:'BIND'
msgid "Bind Coords"
msgstr "Bindningskoordinater"

#. :src: bpy.types.CorrectiveSmoothModifier.smooth_type
msgid "Smooth Type"
msgstr "Utjämningstyp"

#. :src: bpy.types.CorrectiveSmoothModifier.use_only_smooth
msgid "Only Smooth"
msgstr "Endast utjämning"

#. :src: bpy.types.CorrectiveSmoothModifier.use_only_smooth
msgid "Apply smoothing without reconstructing the surface"
msgstr "Tillämpa utjämning utan att rekonstruera ytan"

#. :src: bpy.types.CurveModifier.deform_axis
#. :src: bpy.types.SCULPT_OT_mesh_filter.deform_axis
msgid "Deform Axis"
msgstr "Deformationsaxel"
