#. :src: Asset name from file procedural_hair_node_assets.blend
#: scripts/startup/bl_operators/object_quick_effects.py:181
msgid "Hair Curves Noise"
msgstr "Hårkurvsbrus"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Deforms hair curves using a noise texture"
msgstr "Deformerar hårkurvor med hjälp av en brustextur"

#. :src: Socket description from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Overall factor for the deformation"
msgstr "Övergripande faktor för deformationen"

#. :src: Socket description from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Shape of amount along each curve (0=constant, 0.5=linear)"
msgstr "Påverkansform längs varje kurva (0=konstant, 0,5=linjär)"

#. :src: Socket description from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Scale of the noise texture by root position"
msgstr "Skala för brustexturen utifrån rotpositionen"

#. :src: Socket name from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Scale along Curve"
msgstr "Skala längs kurvan"

#. :src: Socket description from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Scale of noise texture along each curve"
msgstr "Skala för brustexturen längs varje kurva"

#. :src: Socket name from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Offset per Curve"
msgstr "Förskjutning per kurva"

#. :src: Socket description from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Random offset of noise texture for each curve"
msgstr "Slumpmässig förskjutning av brustexturen för varje kurva"

#. :src: Socket description from node group Hair Curves Noise, file procedural_hair_node_assets.blend
msgid "Preserve the length of the curves on a segment basis"
msgstr "Bevara kurvornas längd segmentvis"
