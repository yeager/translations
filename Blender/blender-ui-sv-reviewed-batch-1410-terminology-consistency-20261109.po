#. :src: bpy.types.GizmoGroup.bl_options:'TOOL_INIT'
msgid "Postpone running until tool operator run (when used with a tool)"
msgstr ""
"Skjut upp körningen tills verktygsoperatören körs (vid användning med ett "
"verktyg)"

#. :src: bpy.types.ID.is_linked_packed
msgid "This data-block is linked and packed into the .blend file"
msgstr "Datablocket är länkat och packat i .blend-filen"

#. :src: bpy.types.KeyMap.keymap_items
msgid "Items in the keymap, linking an operator to an input event"
msgstr ""
"Objekt i tangentmappningen som kopplar en operatör till en "
"inmatningshändelse"

#. :src: bpy.types.KeyMap.space_type
msgid "Optional space type keymap is associated with"
msgstr "Valfri redigerartyp kopplad till tangentmappningen"

#. :src: bpy.types.FILE_OT_unpack_all.method:'KEEP'
msgid "Disable auto-pack, keep all packed files"
msgstr "Inaktivera automatisk paketering, behåll alla packade filer"

