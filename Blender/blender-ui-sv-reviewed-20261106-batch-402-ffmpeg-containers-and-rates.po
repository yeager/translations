#. :src: bpy.types.FFmpegSettings.gopsize
msgid "Keyframe Interval"
msgstr "Nyckelbildruteintervall"

#. :src: bpy.types.FFmpegSettings.gopsize
msgid ""
"Distance between key frames, also known as GOP size; influences file size "
"and seekability"
msgstr ""
"Avstånd mellan nyckelbildrutor, även kallat GOP-storlek; påverkar filstorlek "
"och sökbarhet"

#. :src: bpy.types.FFmpegSettings.max_b_frames
msgid "Max B-Frames"
msgstr "Maximalt antal B-bildrutor"

#. :src: bpy.types.FFmpegSettings.max_b_frames
msgid ""
"Maximum number of B-frames between non-B-frames; influences file size and "
"seekability"
msgstr ""
"Maximalt antal B-bildrutor mellan icke-B-bildrutor; påverkar filstorlek och "
"sökbarhet"

#. :src: bpy.types.FFmpegSettings.maxrate
msgid "Max Rate"
msgstr "Högsta bithastighet"

#. :src: bpy.types.FFmpegSettings.maxrate
msgid "Rate control: max rate (kbit/s)"
msgstr "Hastighetsreglering: högsta bithastighet (kbit/s)"

#. :src: bpy.types.FFmpegSettings.minrate
msgid "Min Rate"
msgstr "Lägsta bithastighet"

#. :src: bpy.types.FFmpegSettings.minrate
msgid "Rate control: min rate (kbit/s)"
msgstr "Hastighetsreglering: lägsta bithastighet (kbit/s)"

#. :src: bpy.types.FFmpegSettings.muxrate
#: scripts/startup/bl_ui/properties_output.py:589
msgid "Mux Rate"
msgstr "Muxningshastighet"

#. :src: bpy.types.FFmpegSettings.muxrate
msgid "Mux rate (bits/second)"
msgstr "Muxningshastighet (bitar/sekund)"

#. :src: bpy.types.FFmpegSettings.packetsize
#: scripts/startup/bl_ui/properties_output.py:590
msgid "Mux Packet Size"
msgstr "Muxpaketstorlek"

#. :src: bpy.types.FFmpegSettings.packetsize
msgid "Mux packet size (byte)"
msgstr "Muxpaketets storlek (byte)"

#. :src: bpy.types.FFmpegSettings.use_autosplit
msgid "Autosplit Output"
msgstr "Dela automatiskt upp utdata"

#. :src: bpy.types.FFmpegSettings.use_autosplit
msgid "Autosplit output at 2GB boundary"
msgstr "Dela utdata automatiskt vid 2 GB-gränsen"

#. :src: bpy.types.FFmpegSettings.use_lossless_output
msgid "Lossless Output"
msgstr "Förlustfria utdata"

#. :src: bpy.types.FFmpegSettings.use_lossless_output
msgid "Use lossless output for video streams"
msgstr "Använd förlustfri utdata för videoströmmar"

#. :src: bpy.types.FFmpegSettings.use_max_b_frames
msgid "Use Max B-Frames"
msgstr "Använd maximalt antal B-bildrutor"

#. :src: bpy.types.FFmpegSettings.use_max_b_frames
msgid "Set a maximum number of B-frames"
msgstr "Ange ett maximalt antal B-bildrutor"

#. :src: bpy.types.FFmpegSettings.video_bitrate
msgid "Video bitrate (kbit/s)"
msgstr "Videobithastighet (kbit/s)"
