msgstr "Vridpunktsposition"

#. :src: bpy.types.RigifyParameters.pivot_pos
msgid "Position of the torso control and pivot point"
msgstr "Position för överkroppskontroll och vridpunkt"

#. :src: bpy.types.RigifyParameters.primary_coll_refs
