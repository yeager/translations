msgstr "Konvertera Grease Pencil-lager till kurvinstanser"

#. :src: bpy.types.GeometryNodeGridAdvect
msgid "Advect Grid"
msgstr "Advect rutnät"

#. :src: bpy.types.GeometryNodeGridAdvect
msgid "Move grid values through a velocity field using numerical integration. Supports multiple integration schemes for different accuracy and performance trade-offs"
msgstr ""
"Flytta rutnätsvärden genom ett hastighetsfält med hjälp av numerisk "
"integration. Stöder flera integrationsscheman för olika avvägningar mellan "
"noggrannhet och prestanda"

#. :src: bpy.types.GeometryNodeGridClip
msgid "Clip Grid"
msgstr "Klipprutnät"

#. :src: bpy.types.GeometryNodeGridClip
msgid "Deactivate grid voxels outside minimum and maximum coordinates, setting them to the background value."
msgstr "Inaktivera rutnätsvoxlar utanför minimi- och maximikoordinaterna och ställ in dem till bakgrundsvärdet."

#. :src: bpy.types.GeometryNodeGridCurl
msgid "Grid Curl"
msgstr "Rutnätsrotation"

#. :src: bpy.types.GeometryNodeGridCurl
msgid "Calculate the magnitude and direction of circulation of a directional vector grid"
msgstr "Beräkna storleken och riktningen på cirkulationen för ett riktningsvektorgaller"

#. :src: bpy.types.GeometryNodeGridDeactivateVoxels
msgid "Deactivate Voxels"
msgstr "Inaktivera voxlar"

#. :src: bpy.types.GeometryNodeGridDeactivateVoxels
msgid "Deactivate selected voxels and tiles"
msgstr "Inaktivera markerade voxlar och rutor"

#. :src: bpy.types.GeometryNodeGridDilateAndErode
msgid "Grid Dilate & Erode"
msgstr "Rutnätet utvidgas och urholkas"

#. :src: bpy.types.GeometryNodeGridDilateAndErode
msgid "Dilate or erode the active regions of a grid. This changes which voxels are active but does not change their values."
msgstr "Utvidga eller erodera de aktiva områdena i ett rutnät. Detta ändrar vilka voxlar som är aktiva, men ändrar inte deras värden."

#. :src: bpy.types.GeometryNodeGridDivergence
msgid "Grid Divergence"
msgstr "Nätavvikelse"

#. :src: bpy.types.GeometryNodeGridDivergence
msgid "Calculate the flow into and out of each point of a directional vector grid"
msgstr "Beräkna flödet in och ut från varje punkt i ett riktningsvektorgaller"

#. :src: bpy.types.GeometryNodeGridGradient
msgid "Grid Gradient"
msgstr "Rutnätets lutning"

#. :src: bpy.types.GeometryNodeGridGradient
msgid "Calculate the direction and magnitude of the change in values of a scalar grid"
msgstr "Beräkna riktningen och storleken på förändringen i värdena för ett skalärt rutnät"

#. :src: bpy.types.GeometryNodeGridInfo
msgid "Grid Info"
msgstr "Nätinformation"

#. :src: bpy.types.GeometryNodeGridInfo
msgid "Retrieve information about a volume grid"
msgstr "Hämta information om ett volymrutnät"

#. :src: bpy.types.GeometryNodeGridLaplacian
msgid "Grid Laplacian"
msgstr "Rutnätslaplacian"

#. :src: bpy.types.GeometryNodeGridLaplacian
msgid "Compute the divergence of the gradient of the input grid"
msgstr "Beräkna divergensen av gradienten för ingångsrutnätet"

#. :src: bpy.types.GeometryNodeGridMean
msgid "Grid Mean"
msgstr "Nätets medelvärde"

#. :src: bpy.types.GeometryNodeGridMean
msgid "Apply mean (box) filter smoothing to a voxel. The mean value from surrounding voxels in a box-shape defined by the radius replaces the voxel value."
msgstr "Tillämpa medelvärdesfilter (box) på en voxel. Medelvärdet från omgivande voxlar i en boxform definierad av radien ersätter voxelvärdet."

#. :src: bpy.types.GeometryNodeGridMedian
msgid "Grid Median"
msgstr "Nätets medianvärde"

#. :src: bpy.types.GeometryNodeGridMedian
msgid "Apply median (box) filter smoothing to a voxel. The median value from surrounding voxels in a box-shape defined by the radius replaces the voxel value."
msgstr "Tillämpa medianfilterutjämning (box) på en voxel. Medianvärdet från omgivande voxlar i en boxform definierad av radien ersätter voxelvärdet."

#. :src: bpy.types.GeometryNodeGridPrune
msgid "Prune Grid"
msgstr "Beskärningsrutnät"

#. :src: bpy.types.GeometryNodeGridPrune
msgid "Make the storage of a volume grid more efficient by collapsing data into tiles or inner nodes"
msgstr ""
"Gör lagringen av ett volymnät mer effektiv genom att komprimera data till "
"rutor eller inre noder"

#. :src: bpy.types.GeometryNodeGridToMesh
msgid "Grid to Mesh"
msgstr "Rutnät till nät"

#. :src: bpy.types.GeometryNodeGridToMesh
msgid "Generate a mesh on the \"surface\" of a volume grid"
msgstr "Skapa ett nät på \"ytan\" av ett volymrutnät"

#. :src: bpy.types.GeometryNodeGridToPoints
msgid "Grid to Points"
msgstr "Rutnät till punkter"

#. :src: bpy.types.GeometryNodeGridToPoints
msgid "Generate a point cloud from a volume grid's active voxels"
msgstr "Generera en punktmoln från ett volymrutnätets aktiva voxlar"

#. :src: bpy.types.GeometryNodeGridTopologyBoolean
msgid "Grid Topology Boolean"
msgstr "Boolesk rutnätstopologi"

#. :src: bpy.types.GeometryNodeGridTopologyBoolean
msgid "Combine the topology of multiple grids"
msgstr "Kombinera topologin för flera rutnät"

#. :src: bpy.types.GeometryNodeGridVoxelize
msgid "Voxelize Grid"
msgstr "Voxelize-rutnät"

#. :src: bpy.types.GeometryNodeGridVoxelize
msgid "Remove sparseness from a volume grid by making the active tiles into voxels"
msgstr ""
"Ta bort gleshet från ett volymrutnät genom att göra de aktiva rutorna till "
"voxlar"

