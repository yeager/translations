msgid "Split Animation by Object"
msgstr "Dela animering efter objekt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_scene_split_object
msgid "Export Scene as seen in Viewport, But split animation by Object"
msgstr "Exportera scen som den visas i visningsfönstret, men dela upp animationen efter objekt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_single_armature
msgid "Export all Armature Actions"
msgstr "Exportera alla armaturåtgärder"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_single_armature
msgid "Export all actions, bound to a single armature. WARNING: Option does not support exports including multiple armatures"
msgstr ""
"Exportera alla åtgärder som är kopplade till en enda armatur. VARNING: "
"Alternativet stöder inte export som inkluderar flera armaturer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_slide_to_zero
msgid "Set All glTF Animation Starting at 0"
msgstr "Ställ in alla glTF-animationer så att de startar vid 0"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_slide_to_zero
msgid "Set all glTF animation starting at 0.0s. Can be useful for looping animations"
msgstr ""
"Ställ in alla glTF-animationer så att de startar vid 0,0 sekunder. Kan vara "
"användbart för loopade animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode
msgid "Animation Mode"
msgstr "Animationsläge"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode
msgid "Export Animation mode"
msgstr "Exportera animeringsläge"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIONS'
msgid "Export actions (actives and on NLA tracks) as separate animations"
msgstr "Exportera åtgärder (aktiva och på NLA-spår) som separata animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIVE_ACTIONS'
msgid "Active actions merged"
msgstr "Aktiva åtgärder slogs samman"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIVE_ACTIONS'
msgid "All the currently assigned actions become one glTF animation"
msgstr "Alla för närvarande tilldelade åtgärder blir en glTF-animation"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'BROADCAST'
msgid "Broadcast actions"
msgstr "Sändningsåtgärder"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'BROADCAST'
msgid "Broadcast all compatible actions to all objects. Animated objects will get all actions compatible with them, others will get no animation at all"
msgstr ""
"Sänd alla kompatibla åtgärder till alla objekt. Animerade objekt får alla "
"åtgärder som är kompatibla med dem, andra får ingen animering alls"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'NLA_TRACKS'
msgid "Export individual NLA Tracks as separate animation"
msgstr "Exportera enskilda NLA-spår som separata animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'SCENE'
msgid "Export baked scene as a single animation"
msgstr "Exportera bakad scen som en enda animation"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animations
msgid "Exports active actions and NLA tracks as glTF animations"
msgstr "Exporterar aktiva åtgärder och NLA-spår som glTF-animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_apply
msgid "Apply modifiers (excluding Armatures) to mesh objects -WARNING: prevents exporting shape keys"
msgstr "Tillämpa modifierare (utom armeringar) på nätobjekt -VARNING: förhindrar export av formnycklar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_armature_object_remove
msgid "Remove Armature Object"
msgstr "Ta bort armeringsobjekt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_armature_object_remove
msgid "Remove Armature object if possible. If Armature has multiple root bones, object will not be removed"
msgstr ""
"Ta bort Armature-objektet om möjligt. Om Armature har flera rotben kommer "
"objektet inte att tas bort"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_attributes
msgid "Export Attributes (when starting with underscore)"
msgstr "Exportattribut (när de börjar med understreck)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_bake_animation
msgid "Bake All Objects Animations"
msgstr "Baka alla objektanimationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_bake_animation
msgid "Force exporting animation on every object. Can be useful when using constraints or driver. Also useful when exporting only selection"
msgstr ""
"Tvinga export av animering på varje objekt. Kan vara användbart när du "
"använder begränsningar eller drivrutiner. Även användbart när du endast "
"exporterar valda objekt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_cameras
msgid "Export cameras"
msgstr "Exportera kameror"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_convert_animation_pointer
msgid "Convert TRS/Weights to Animation Pointer"
msgstr "Konvertera TRS/vikter till animationspekare"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_convert_animation_pointer
msgid "Export TRS and weights as Animation Pointer. Using KHR_animation_pointer extension"
msgstr "Exportera TRS och vikter som animationspekare. Använda KHR_animation_pointer-tillägget"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_copyright
msgid "Legal rights and conditions for the model"
msgstr "Modellens juridiska rättigheter och villkor"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_current_frame
msgid "Use Current Frame as Object Rest Transformations"
msgstr "Använd aktuell bildruta som objektets resttransformationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_current_frame
msgid "Export the scene in the current animation frame. When off, frame 0 is used as rest transformations for objects"
msgstr ""
"Exportera scenen i den aktuella animationsramen. När funktionen är avstängd "
"används bildruta 0 som vilotransformationer för objekt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_def_bones
msgid "Export Deformation Bones Only"
msgstr "Exportera endast deformationsben"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_def_bones
msgid "Export Deformation bones only"
msgstr "Exportera endast deformationsben"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_color_quantization
msgid "Color Quantization Bits"
msgstr "Färgkvantiseringsbitar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_color_quantization
msgid "Quantization bits for color values (0 = no quantization)"
msgstr "Kvantiseringsbitar för färgvärden (0 = ingen kvantisering)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_generic_quantization
msgid "Generic Quantization Bits"
msgstr "Generiska kvantiseringsbitar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_generic_quantization
msgid "Quantization bits for generic values like weights or joints (0 = no quantization)"
msgstr "Kvantiseringsbitar för generiska värden som vikter eller leder (0 = ingen kvantisering)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_mesh_compression_enable
msgid "Draco Mesh Compression"
msgstr "Draco-nätkomprimering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_mesh_compression_enable
msgid "Compress mesh using Draco"
msgstr "Komprimera nät med Draco"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_mesh_compression_level
msgid "Compression Level"
msgstr "Kompressionsnivå"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_mesh_compression_level
msgid "Compression level (0 = most speed, 6 = most compression, higher values currently not supported)"
msgstr "Kompressionsnivå (0 = högsta hastighet, 6 = högsta kompression, högre värden stöds för närvarande inte)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_normal_quantization
msgid "Normal Quantization Bits"
msgstr "Normala kvantiseringsbitar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_normal_quantization
msgid "Quantization bits for normal values (0 = no quantization)"
msgstr "Kvantiseringsbitar för normala värden (0 = ingen kvantisering)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_position_quantization
msgid "Position Quantization Bits"
msgstr "Positionskvantiseringsbitar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_position_quantization
msgid "Quantization bits for position values (0 = no quantization)"
msgstr "Kvantiseringsbitar för positionsvärden (0 = ingen kvantisering)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_texcoord_quantization
msgid "Texcoord Quantization Bits"
msgstr "Texcoord-kvantiseringsbitar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_texcoord_quantization
msgid "Quantization bits for texture coordinate values (0 = no quantization)"
msgstr "Kvantiseringsbitar för texturkoordinatvärden (0 = ingen kvantisering)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_extra_animations
msgid "Prepare Extra Animations"
msgstr "Förbered extra animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_extra_animations
msgid ""
"Export additional animations.\n"
"This feature is not standard and needs an external extension to be included in the glTF file"
msgstr ""
"Exporterar ytterligare animationer.\n"
"Detta är inte en standardfunktion och kräver ett externt tillägg för att "
"inkluderas i glTF-filen"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_extras
msgid "Export custom properties as glTF extras"
msgstr "Exportera anpassade egenskaper som glTF-extras"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_force_sampling
msgid "Always Sample Animations"
msgstr "Alltid exempelanimationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_force_sampling
msgid "Apply sampling to all animations"
msgstr "Tillämpa sampling på alla animationer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_format
msgid "Output format. Binary is most efficient, but JSON may be easier to edit later"
msgstr ""
"Utdataformat. Binärt är mest effektivt, men JSON kan vara lättare att "
"redigera senare"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_frame_range
msgid "Limit to Playback Range"
msgstr "Begränsa uppspelningsområdet"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_frame_range
msgid "Clips animations to selected playback range"
msgstr "Klippar animationer till valt uppspelningsintervall"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_kn
msgid "Keep Named Nodes"
msgstr "Behåll namngivna noder"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_kn
msgid "Restrict some optimization to keep named nodes and meshes attached to named nodes so that named nodes can be transformed externally"
msgstr ""
"Begränsa viss optimering för att behålla namngivna noder och nät kopplade "
"till namngivna noder så att namngivna noder kan transformeras externt"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_noq
msgid "Disable Quantization"
msgstr "Inaktivera kvantisering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_noq
msgid "Disable quantization; produces much larger glTF files with no extensions"
msgstr "Inaktivera kvantisering; ger mycket större glTF-filer utan tillägg"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_sa
msgid "Aggressive Mesh Simplification"
msgstr "Aggressiv förenkling av nät"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_sa
msgid "Aggressively simplify to the target ratio disregarding quality"
msgstr "Förenkla aggressivt till målkvoten utan hänsyn till kvalitet"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_si
msgid "Mesh Simplification Ratio"
msgstr "Förenklingsgrad för nät"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_si
msgid "Simplify meshes targeting triangle count ratio"
msgstr "Förenkla nät med fokus på triangelns antal"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_slb
msgid "Lock Mesh Border Vertices"
msgstr "Lås nätgränsvertikaler"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_slb
msgid "Lock border vertices during simplification to avoid gaps on connected meshes"
msgstr ""
"Lås kantpunkter under förenkling för att undvika luckor i sammankopplade nät"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_tc
msgid "KTX2 Compression"
msgstr "KTX2-komprimering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_tc
msgid "Convert all textures to KTX2 with BasisU supercompression"
msgstr "Konvertera alla texturer till KTX2 med BasisU-superkomprimering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_tq
msgid "Texture Encoding Quality"
msgstr "Texturkodningskvalitet"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_tq
msgid "Texture encoding quality"
msgstr "Texturkodningskvalitet"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vc
msgid "Vertex Color Quantization"
msgstr "Vertexfärgkvantisering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vc
msgid "Use N-bit quantization for colors"
msgstr "Använd N-bitskvantisering för färger"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vn
msgid "Normal/Tangent Quantization"
msgstr "Normal/tangentiell kvantisering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vn
msgid "Use N-bit quantization for normals and tangents"
msgstr "Använd N-bit kvantisering för normaler och tangenter"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vp
msgid "Position Quantization"
msgstr "Positionskvantisering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vp
msgid "Use N-bit quantization for positions"
msgstr "Använd N-bitskvantisering för positioner"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vpi
msgid "Vertex Position Attributes"
msgstr "Vertexpositionsattribut"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vpi
msgid "Type to use for vertex position attributes"
msgstr "Typ som ska användas för attribut för vertexpositioner"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vpi:'Integer'
msgid "Use integer attributes for positions"
msgstr "Använd heltalattribut för positioner"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vpi:'Normalized'
msgid "Use normalized attributes for positions"
msgstr "Använd normaliserade attribut för positioner"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vpi:'Floating-point'
msgid "Use floating-point attributes for positions"
msgstr "Använd flyttalsattribut för positioner"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vt
msgid "Texture Coordinate Quantization"
msgstr "Texturkoordinatkvantisering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gltfpack_vt
msgid "Use N-bit quantization for texture coordinates"
msgstr "Använd N-bitskvantisering för texturkoordinater"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gn_mesh
msgid "Geometry Nodes Instances (Experimental)"
msgstr "Geometri-nodinstanser (experimentellt)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gn_mesh
msgid "Export Geometry nodes instance meshes"
msgstr "Exportera geometrinodernas instansnät"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gpu_instances
msgid "GPU Instances"
msgstr "GPU-instanser"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_gpu_instances
msgid "Export using EXT_mesh_gpu_instancing. Limited to children of a given Empty. Multiple materials might be omitted"
msgstr ""
"Exportera med EXT_mesh_gpu_instancing. Begränsat till barn till en given "
"Empty. Flera material kan utelämnas"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_hierarchy_flatten_bones
msgid "Flatten Bone Hierarchy"
msgstr "Platta till benhierarkin"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_hierarchy_flatten_bones
msgid "Flatten Bone Hierarchy. Useful in case of non decomposable transformation matrix"
msgstr ""
"Platta till benhierarkin. Användbart vid icke-nedbrytbar "
"transformationsmatris"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_hierarchy_flatten_objs
msgid "Flatten Object Hierarchy"
msgstr "Platta till objekthierarkin"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_hierarchy_flatten_objs
msgid "Flatten Object Hierarchy. Useful in case of non decomposable transformation matrix"
msgstr ""
"Platta till objekthierarkin. Användbart vid icke-dekomponerbara "
"transformationsmatriser"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_hierarchy_full_collections
msgid "Full Collection Hierarchy"
msgstr "Fullständig samlingshierarki"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_hierarchy_full_collections
msgid "Export full hierarchy, including intermediate collections"
msgstr "Exportera hela hierarkin, inklusive mellanliggande samlingar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_add_webp
msgid "Create WebP"
msgstr "Skapa WebP"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_add_webp
msgid "Creates WebP textures for every texture. For already WebP textures, nothing happens"
msgstr ""
"Skapar WebP-texturer för varje textur. För redan befintliga WebP-texturer "
"händer ingenting"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_format
msgid "Output format for images. PNG is lossless and generally preferred, but JPEG might be preferable for web applications due to the smaller file size. Alternatively they can be omitted if they are not needed"
msgstr ""
"Utdataformat för bilder. PNG är förlustfritt och generellt att föredra, men "
"JPEG kan vara att föredra för webbapplikationer på grund av den mindre "
"filstorleken. Alternativt kan de utelämnas om de inte behövs"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_format:'AUTO'
msgid "Save PNGs as PNGs, JPEGs as JPEGs, WebPs as WebPs. For other formats, use PNG"
msgstr ""
"Spara PNG-filer som PNG, JPEG-filer som JPEG och WebP-filer som WebP. För "
"andra format, använd PNG"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_format:'JPEG'
msgid "JPEG Format (.jpg)"
msgstr "JPEG-format (.jpg)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_format:'JPEG'
msgid "Save images as JPEGs. (Images that need alpha are saved as PNGs though.) Be aware of a possible loss in quality"
msgstr ""
"Spara bilder som JPEG-filer. (Bilder som behöver alfa sparas dock som PNG-"
"filer.) Var medveten om att kvaliteten kan försämras"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_format:'WEBP'
msgid "WebP Format"
msgstr "WebP-format"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_format:'WEBP'
msgid "Save images as WebPs as main image (no fallback)"
msgstr "Spara bilder som WebP-filer som huvudbild (ingen fallback)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_format:'NONE'
msgid "Don't export images"
msgstr "Exportera inte bilder"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_quality
msgid "Image Quality"
msgstr "Bildkvalitet"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_quality
msgid "Quality of image export"
msgstr "Kvalitet på bildexport"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_webp_fallback
msgid "WebP Fallback"
msgstr "WebP-fallback"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_image_webp_fallback
msgid "For all WebP textures, create a PNG fallback texture"
msgstr "Skapa en PNG-fallbacktextur för alla WebP-texturer"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_import_convert_lighting_mode
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.export_import_convert_lighting_mode
msgid "Lighting Mode"
msgstr "Belysningsläge"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_import_convert_lighting_mode
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.export_import_convert_lighting_mode
msgid "Optional backwards compatibility for non-standard render engines. Applies to lights"
msgstr ""
"Valfri bakåtkompatibilitet för icke-standardiserade renderingsmotorer. "
"Gäller belysning"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'SPEC'
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'SPEC'
msgid "Physically-based glTF lighting units (cd, lx, nt)"
msgstr "Fysiskt baserade glTF-belysningsenheter (cd, lx, nt)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'COMPAT'
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'COMPAT'
msgid "Unitless"
msgstr "Enhetslös"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'COMPAT'
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'COMPAT'
msgid "Non-physical, unitless lighting. Useful when exposure controls are not available"
msgstr ""
"Icke-fysisk belysning utan enheter. Användbar när exponeringskontroller inte "
"är tillgängliga"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'RAW'
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'RAW'
msgid "Raw (Deprecated)"
msgstr "Rå (föråldrad)"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'RAW'
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.export_import_convert_lighting_mode:'RAW'
msgid "Blender lighting strengths with no conversion"
msgstr "Blender-belysningsstyrkor utan konvertering"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_influence_nb
msgid "Bone Influences"
msgstr "Benets inflytande"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_influence_nb
msgid "Choose how many Bone influences to export"
msgstr "Välj hur många Bone-influenser som ska exporteras"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_jpeg_quality
msgid "JPEG Quality"
msgstr "JPEG-kvalitet"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_jpeg_quality
msgid "Quality of JPEG export"
msgstr "Kvalitet på JPEG-export"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_keep_originals
#. :src: bpy.types.PREFERENCES_OT_keyconfig_import.keep_original
msgid "Keep Original"
msgstr "Behåll originalet"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_keep_originals
msgid "Keep original textures files if possible. WARNING: if you use more than one texture, where pbr standard requires only one, only one texture will be used. This can lead to unexpected results"
msgstr ""
"Behåll originaltexturfilerna om möjligt. VARNING: om du använder mer än en "
"textur, där pbr-standarden endast kräver en, kommer endast en textur att "
"användas. Detta kan leda till oväntade resultat"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_lights
msgid "Punctual Lights"
msgstr "Punktliga lampor"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_lights
msgid "Export directional, point, and spot lights. Uses \"KHR_lights_punctual\" glTF extension"
msgstr ""
"Exportera riktade lampor, punktlampor och spotlights. Använder glTF-"
"tillägget \"KHR_lights_punctual\""

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_loglevel
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.loglevel
msgid "Log Level"
msgstr "Loggnivå"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_materials
