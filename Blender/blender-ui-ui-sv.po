msgid "Output Vertex group"
msgstr "Utgående vertexgrupp"

#. :src: bpy.types.GreasePencilBuildModifier.time_mode
#. :src: bpy.types.PARTICLE_PT_render_path_timing
msgid "Timing"
msgstr "Tidpunkt"

#. :src: bpy.types.GreasePencilBuildModifier.time_mode
msgid "Use drawing speed, a number of frames, or a manual factor to build strokes"
msgstr ""
"Använd ritningshastighet, antal bildrutor eller en manuell faktor för att "
"skapa streck"

#. :src: bpy.types.GreasePencilBuildModifier.time_mode:'DRAWSPEED'
msgid "Natural Drawing Speed"
msgstr "Naturlig ritningshastighet"

#. :src: bpy.types.GreasePencilBuildModifier.time_mode:'DRAWSPEED'
msgid "Use recorded speed multiplied by a factor"
msgstr "Använd registrerad hastighet multiplicerad med en faktor"

#. :src: bpy.types.GreasePencilBuildModifier.time_mode:'FRAMES'
msgid "Number of Frames"
msgstr "Antal bildrutor"

#. :src: bpy.types.GreasePencilBuildModifier.time_mode:'FRAMES'
msgid "Set a fixed number of frames for all build animations"
msgstr "Ställ in ett fast antal bildrutor för alla bygganimationer"

#. :src: bpy.types.GreasePencilBuildModifier.time_mode:'PERCENTAGE'
msgid "Percentage Factor"
msgstr "Procentuell faktor"

#. :src: bpy.types.GreasePencilBuildModifier.time_mode:'PERCENTAGE'
msgid "Set a manual percentage to build"
msgstr "Ställ in en manuell procentandel för att bygga"

#. :src: bpy.types.GreasePencilBuildModifier.transition
msgid "How are strokes animated (i.e. are they appearing or disappearing)"
msgstr "Hur streck animeras (dvs. visas eller försvinner de)"

#. :src: bpy.types.GreasePencilBuildModifier.transition:'GROW'
#. :src: bpy.types.ParticleBrush.length_mode:'GROW'
msgid "Grow"
msgstr "Växa"

#. :src: bpy.types.GreasePencilBuildModifier.transition:'GROW'
msgid "Show points in the order they occur in each stroke (e.g. for animating lines being drawn)"
msgstr ""
"Visa punkter i den ordning de förekommer i varje streck (t.ex. för att "
"animera linjer som ritas)"

#. :src: bpy.types.GreasePencilBuildModifier.transition:'SHRINK'
msgid "Hide points from the end of each stroke to the start (e.g. for animating lines being erased)"
msgstr "Dölj punkter från slutet av varje streck till början (t.ex. för att animera linjer som raderas)"

#. :src: bpy.types.GreasePencilBuildModifier.transition:'FADE'
msgid "Vanish"
msgstr "Försvinn"

#. :src: bpy.types.GreasePencilBuildModifier.transition:'FADE'
msgid "Hide points in the order they occur in each stroke (e.g. for animating ink fading or vanishing after getting drawn)"
msgstr ""
"Dölj punkter i den ordning de förekommer i varje streck (t.ex. för att "
"animera bläck som bleknar eller försvinner efter att det ritats)"

#. :src: bpy.types.GreasePencilBuildModifier.use_fading
msgid "Use Fading"
msgstr "Använd Fading"

#. :src: bpy.types.GreasePencilBuildModifier.use_fading
msgid "Fade out strokes instead of directly cutting off"
msgstr "Tona ut streck istället för att klippa av dem direkt"

#. :src: bpy.types.GreasePencilBuildModifier.use_percentage
msgid "Restrict Visible Points"
msgstr "Begränsa synliga punkter"

#. :src: bpy.types.GreasePencilBuildModifier.use_percentage
msgid "Use a percentage factor to determine the visible points"
msgstr "Använd en procentfaktor för att bestämma de synliga punkterna"

#. :src: bpy.types.GreasePencilBuildModifier.use_restrict_frame_range
msgid "Only modify strokes during the specified frame range"
msgstr "Ändra endast streck under det angivna bildintervallet"

