#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:42
msgid "Semi-Lagrangian"
msgstr "Semi-lagrangisk"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:43
msgid "1st order semi-Lagrangian integration. Fast but least accurate, suitable for simple advection"
msgstr ""
"1:a ordningens semi-Lagrangiansk integration. Snabb men minst noggrann, "
"lämplig för enkel advektion"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:49
msgid "2nd order midpoint integration. Good balance between speed and accuracy for most cases"
msgstr ""
"2:a ordningens mittpunktsintegration. Bra balans mellan hastighet och "
"noggrannhet i de flesta fall"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:53
msgid "Runge-Kutta 3"
msgstr "Runge-Kutta 3"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:54
msgid "3rd order Runge-Kutta integration. Higher accuracy at moderate computational cost"
msgstr ""
"3:e ordningens Runge-Kutta-integration. Högre noggrannhet till måttlig "
"beräkningskostnad"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:58
msgid "Runge-Kutta 4"
msgstr "Runge-Kutta 4"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:59
msgid "4th order Runge-Kutta integration. Highest accuracy single-step method but slower"
msgstr ""
"4:e ordningens Runge-Kutta-integration. Metod med högsta noggrannhet i ett "
"steg, men långsammare"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:63
msgid "MacCormack"
msgstr "MacCormack"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:64
msgid "MacCormack scheme with implicit diffusion control. Reduces numerical dissipation while maintaining stability"
msgstr ""
"MacCormack-schema med implicit diffusionskontroll. Minskar numerisk "
"dissipation samtidigt som stabiliteten bibehålls"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:69
msgid "BFECC"
msgstr "BFECC"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:70
msgid "Back and Forth Error Compensation and Correction. Advanced scheme that minimizes dissipation and diffusion"
msgstr ""
"Fram- och återgående felkompensering och korrigering. Avancerat system som "
"minimerar dissipation och diffusion"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:80
msgid "No limiting applied. Fastest but may produce artifacts in high-order schemes"
msgstr ""
"Ingen begränsning tillämpas. Snabbaste men kan ge artefakter i högordnade "
"scheman"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:85
msgid "Clamp values to the range of the original neighborhood. Prevents overshooting and undershooting"
msgstr ""
"Klämma värden till intervallet för det ursprungliga grannskapet. Förhindrar "
"överskridande och underskridande"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:90
#: source/blender/windowmanager/intern/wm_files.cc:2766
#: source/blender/windowmanager/intern/wm_files.cc:3443
