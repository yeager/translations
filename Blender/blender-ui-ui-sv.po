#. :src: bpy.types.ShaderNodeBsdfGlass.distribution:'BECKMANN'
#. :src: bpy.types.ShaderNodeBsdfMetallic.distribution:'BECKMANN'
#. :src: bpy.types.ShaderNodeBsdfRefraction.distribution:'BECKMANN'
msgid "Beckmann"
msgstr "Beckmann"

#. :src: bpy.types.ShaderNodeBsdfAnisotropic.distribution:'GGX'
#. :src: bpy.types.ShaderNodeBsdfGlass.distribution:'GGX'
#. :src: bpy.types.ShaderNodeBsdfMetallic.distribution:'GGX'
#. :src: bpy.types.ShaderNodeBsdfPrincipled.distribution:'GGX'
#. :src: bpy.types.ShaderNodeBsdfRefraction.distribution:'GGX'
msgid "GGX"
msgstr "GGX"

#. :src: bpy.types.ShaderNodeBsdfAnisotropic.distribution:'ASHIKHMIN_SHIRLEY'
msgid "Ashikhmin-Shirley"
msgstr "Ashikhmin-Shirley"

#. :src: bpy.types.ShaderNodeBsdfAnisotropic.distribution:'MULTI_GGX'
#. :src: bpy.types.ShaderNodeBsdfGlass.distribution:'MULTI_GGX'
#. :src: bpy.types.ShaderNodeBsdfMetallic.distribution:'MULTI_GGX'
#. :src: bpy.types.ShaderNodeBsdfPrincipled.distribution:'MULTI_GGX'
msgid "Multiscatter GGX"
msgstr "Multispridning GGX"

#. :src: bpy.types.ShaderNodeBsdfAnisotropic.distribution:'MULTI_GGX'
#. :src: bpy.types.ShaderNodeBsdfGlass.distribution:'MULTI_GGX'
#. :src: bpy.types.ShaderNodeBsdfMetallic.distribution:'MULTI_GGX'
#. :src: bpy.types.ShaderNodeBsdfPrincipled.distribution:'MULTI_GGX'
msgid "GGX with additional correction to account for multiple scattering, preserve energy and prevent unexpected darkening at high roughness"
msgstr ""
"GGX med ytterligare korrigering för att ta hänsyn till multipel spridning, "
"bevara energi och förhindra oväntad mörkfärgning vid hög grovhet"

#. :src: bpy.types.ShaderNodeBsdfDiffuse
msgid "Diffuse BSDF"
msgstr "Diffus BSDF"

#. :src: bpy.types.ShaderNodeBsdfDiffuse
msgid "Lambertian and Oren-Nayar diffuse reflection"
msgstr "Lambertisk och Oren-Nayar diffus reflektion"

#. :src: bpy.types.ShaderNodeBsdfGlass
msgid "Glass BSDF"
msgstr "Glas BSDF"

#. :src: bpy.types.ShaderNodeBsdfGlass
msgid "Glass-like shader mixing refraction and reflection at grazing angles"
msgstr "Glasliknande shader som blandar refraktion och reflektion vid sneda vinklar"

#. :src: bpy.types.ShaderNodeBsdfHair
msgid "Hair BSDF"
msgstr "Hår BSDF"

#. :src: bpy.types.ShaderNodeBsdfHair
msgid "Reflection and transmission shaders optimized for hair rendering"
msgstr "Reflektions- och transmissionsskuggare optimerade för hårrendering"

#. :src: bpy.types.ShaderNodeBsdfHair.component
msgid "Hair BSDF component to use"
msgstr "Hår BSDF-komponent att använda"

#. :src: bpy.types.ShaderNodeBsdfHair.component:'Reflection'
#: source/blender/nodes/shader/nodes/node_shader_bsdf_hair_principled.cc:143
#: source/blender/nodes/shader/nodes/node_shader_tex_coord.cc:27
msgid "Reflection"
msgstr "Reflektion"

#. :src: bpy.types.ShaderNodeBsdfHair.component:'Reflection'
msgid "The light that bounces off the surface of the hair"
msgstr "Ljuset som reflekteras från hårets yta"

#. :src: bpy.types.ShaderNodeBsdfHair.component:'Transmission'
msgid "The light that passes through the hair and exits on the other side"
msgstr "Ljuset som passerar genom håret och kommer ut på andra sidan"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled
msgid "Principled Hair BSDF"
msgstr "Principiell hår BSDF"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled
msgid "Physically-based, easy-to-use shader for rendering hair and fur"
msgstr "Fysikbaserad, lättanvänd shader för rendering av hår och päls"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.model
msgid "Scattering model"
msgstr "Spridningsmodell"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.model
msgid "Select from Chiang or Huang model"
msgstr "Välj mellan modellen Chiang eller Huang"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.model:'CHIANG'
msgid "Chiang"
msgstr "Chiang"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.model:'CHIANG'
msgid "Near-field hair scattering model by Chiang et al. 2016, suitable for close-up looks, but is more noisy when viewing from a distance."
msgstr "Närfältsmodell för hårspridning av Chiang et al. 2016, lämplig för närbilder, men mer störande vid betraktande på avstånd."

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.model:'HUANG'
msgid "Huang"
msgstr "Huang"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.model:'HUANG'
msgid "Multi-scale hair scattering model by Huang et al. 2022, suitable for viewing both up close and from a distance, supports elliptical cross-sections and has more precise highlight in forward scattering directions."
msgstr "Multiskalig hårspridningsmodell av Huang et al. 2022, lämplig för visning både på nära håll och på avstånd, stöder elliptiska tvärsnitt och har mer precis belysning i framåtriktade spridningsriktningar."

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization
msgid "Color Parametrization"
msgstr "Färgparametrisering"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization
msgid "Select the shader's color parametrization"
msgstr "Välj shaderens färgparametrisering"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization:'ABSORPTION'
#: source/blender/nodes/shader/nodes/node_shader_bsdf_hair_principled.cc:69
msgid "Absorption Coefficient"
msgstr "Absorptionskoefficient"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization:'ABSORPTION'
msgid "Directly set the absorption coefficient \"sigma_a\" (this is not the most intuitive way to color hair)"
msgstr ""
"Ställ in absorptionskoefficienten \"sigma_a\" direkt (detta är inte det mest "
"intuitiva sättet att färga hår)"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization:'MELANIN'
msgid "Melanin Concentration"
msgstr "Melankoncentration"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization:'MELANIN'
msgid "Define the melanin concentrations below to get the most realistic-looking hair (you can get the concentrations for different types of hair online)"
msgstr ""
"Definiera melaninkoncentrationerna nedan för att få ett så realistiskt hår "
"som möjligt (du kan hitta koncentrationerna för olika hårtyper online)"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization:'COLOR'
msgid "Direct Coloring"
msgstr "Direktfärgning"

#. :src: bpy.types.ShaderNodeBsdfHairPrincipled.parametrization:'COLOR'
msgid "Choose the color of your preference, and the shader will approximate the absorption coefficient to render lookalike hair"
msgstr ""
"Välj önskad färg så kommer shaderen att approximera absorptionskoefficienten "
"för att återge liknande hår"

#. :src: bpy.types.ShaderNodeBsdfMetallic
msgid "Metallic BSDF"
msgstr "Metallisk BSDF"

#. :src: bpy.types.ShaderNodeBsdfMetallic
msgid "Metallic reflection with microfacet distribution, and metallic fresnel"
msgstr "Metallisk reflektion med mikrofacettfördelning och metallisk fresnel"

#. :src: bpy.types.ShaderNodeBsdfMetallic.fresnel_type
msgid "Fresnel Type"
msgstr "Fresnel-typ"

#. :src: bpy.types.ShaderNodeBsdfMetallic.fresnel_type
msgid "Fresnel method used to tint the metal"
msgstr "Fresnel-metoden används för att färga metallen"

#. :src: bpy.types.ShaderNodeBsdfMetallic.fresnel_type:'PHYSICAL_CONDUCTOR'
msgid "Physical Conductor"
msgstr "Fysisk ledare"

#. :src: bpy.types.ShaderNodeBsdfMetallic.fresnel_type:'PHYSICAL_CONDUCTOR'
msgid "Fresnel conductor based on the complex refractive index per color channel"
msgstr "Fresnel-ledare baserad på det komplexa brytningsindexet per färgkanal"

#. :src: bpy.types.ShaderNodeBsdfMetallic.fresnel_type:'F82'
msgid "F82 Tint"
msgstr "F82 Färgton"

#. :src: bpy.types.ShaderNodeBsdfMetallic.fresnel_type:'F82'
msgid "An approximation of the Fresnel conductor curve based on the colors at perpendicular and near-grazing (roughly 82°) angles"
msgstr ""
"En approximation av Fresnel-ledarkurvan baserad på färgerna vid vinkelräta "
"och nära sneda (ungefär 82°) vinklar"

#. :src: bpy.types.ShaderNodeBsdfPrincipled
msgid "Principled BSDF"
msgstr "Principiell BSDF"

#. :src: bpy.types.ShaderNodeBsdfPrincipled
msgid "Physically-based, easy-to-use shader for rendering surface materials, based on the OpenPBR model"
msgstr ""
"Fysikbaserad, lättanvänd shader för rendering av ytmaterial, baserad på "
"OpenPBR-modellen"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method
msgid "Subsurface Method"
msgstr "Metod under ytan"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff
msgid "Method for rendering subsurface scattering"
msgstr "Metod för att återge spridning under ytan"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method:'BURLEY'
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff:'BURLEY'
msgid "Christensen-Burley"
msgstr "Christensen-Burley"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method:'BURLEY'
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff:'BURLEY'
msgid "Approximation to physically based volume scattering"
msgstr "Approximation till fysikaliskt baserad volymspridning"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method:'RANDOM_WALK'
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff:'RANDOM_WALK'
msgid "Random Walk"
msgstr "Slumpmässig promenad"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method:'RANDOM_WALK'
#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method:'RANDOM_WALK_LEGACY'
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff:'RANDOM_WALK'
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff:'RANDOM_WALK_LEGACY'
msgid "Volumetric approximation to physically based volume scattering, using the scattering radius as specified"
msgstr "Volymetrisk approximation till fysikaliskt baserad volymspridning, med användning av den angivna spridningsradien"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method:'RANDOM_WALK_SKIN'
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff:'RANDOM_WALK_SKIN'
msgid "Random Walk (Skin)"
msgstr "Slumpmässig promenad (Skin)"

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method:'RANDOM_WALK_SKIN'
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff:'RANDOM_WALK_SKIN'
msgid "Volumetric approximation to physically based volume scattering, with scattering radius automatically adjusted to match color textures. Designed for skin shading."
msgstr "Volymetrisk approximation till fysikbaserad volymspridning, med spridningsradie som automatiskt justeras för att matcha färgtexturer. Utformad för hudskuggning."

#. :src: bpy.types.ShaderNodeBsdfPrincipled.subsurface_method:'RANDOM_WALK_LEGACY'
#. :src: bpy.types.ShaderNodeSubsurfaceScattering.falloff:'RANDOM_WALK_LEGACY'
msgid "Random Walk (Legacy)"
msgstr "Slumpvandring (äldre)"

#. :src: bpy.types.ShaderNodeBsdfRayPortal
msgid "Ray Portal BSDF"
msgstr "Strålportal-BSDF"

#. :src: bpy.types.ShaderNodeBsdfRayPortal
msgid "Continue tracing from an arbitrary new position and in a new direction"
msgstr "Fortsätt spåra från en valfri ny position och i en ny riktning"

#. :src: bpy.types.ShaderNodeBsdfRefraction
msgid "Refraction BSDF"
msgstr "Refraktion BSDF"

#. :src: bpy.types.ShaderNodeBsdfRefraction
msgid "Glossy refraction with sharp or microfacet distribution, typically used for materials that transmit light"
msgstr ""
"Glansig refraktion med skarp eller mikrofacetterad fördelning, används "
"vanligtvis för material som släpper igenom ljus"

#. :src: bpy.types.ShaderNodeBsdfSheen
msgid "Sheen BSDF"
msgstr "Lyster-BSDF"

#. :src: bpy.types.ShaderNodeBsdfSheen
msgid ""
"Reflection for materials such as cloth.\n"
"Typically mixed with other shaders (such as a Diffuse Shader) and is not particularly useful on its own"
msgstr ""
"Reflektion för material som tyg.\n"
"Blandas vanligtvis med andra skuggare (t.ex. en diffus skuggare) och är inte "
"särskilt användbar på egen hand"

#. :src: bpy.types.ShaderNodeBsdfSheen.distribution
msgid "Sheen shading model"
msgstr "Sheen-skuggmodell"

#. :src: bpy.types.ShaderNodeBsdfSheen.distribution:'ASHIKHMIN'
msgid "Ashikhmin"
msgstr "Ashikhmin"

#. :src: bpy.types.ShaderNodeBsdfSheen.distribution:'ASHIKHMIN'
msgid "Classic Ashikhmin velvet (legacy model)"
msgstr "Klassisk Ashikhmin-sammet (äldre modell)"

#. :src: bpy.types.ShaderNodeBsdfSheen.distribution:'MICROFIBER'
msgid "Microfiber"
msgstr "Mikrofiber"

#. :src: bpy.types.ShaderNodeBsdfSheen.distribution:'MICROFIBER'
msgid "Microflake-based model of multiple scattering between normal-oriented fibers"
msgstr "Mikroflakbaserad modell för multipel spridning mellan normalt orienterade fibrer"

#. :src: bpy.types.ShaderNodeBsdfToon
msgid "Toon BSDF"
msgstr "Tecknad BSDF"

#. :src: bpy.types.ShaderNodeBsdfToon
msgid "Diffuse and Glossy shaders with cartoon light effects"
msgstr "Diffusa och glansiga shader med tecknade ljuseffekter"

#. :src: bpy.types.ShaderNodeBsdfToon.component
msgid "Toon BSDF component to use"
msgstr "Toon BSDF-komponent att använda"

#. :src: bpy.types.ShaderNodeBsdfToon.component:'DIFFUSE'
msgid "Use diffuse BSDF"
msgstr "Använd diffus BSDF"

#. :src: bpy.types.ShaderNodeBsdfToon.component:'GLOSSY'
msgid "Use glossy BSDF"
msgstr "Använd glansig BSDF"

#. :src: bpy.types.ShaderNodeBsdfTranslucent
msgid "Translucent BSDF"
msgstr "Genomskinlig BSDF"

#. :src: bpy.types.ShaderNodeBsdfTranslucent
msgid "Lambertian diffuse transmission"
msgstr "Lambertisk diffus transmission"

#. :src: bpy.types.ShaderNodeBsdfTransparent
msgid "Transparent BSDF"
msgstr "Transparent BSDF"

#. :src: bpy.types.ShaderNodeBsdfTransparent
msgid "Transparency without refraction, passing straight through the surface as if there were no geometry"
msgstr ""
"Transparens utan brytning, som passerar rakt igenom ytan som om det inte "
"fanns någon geometri"

#. :src: bpy.types.ShaderNodeBump
#. :src: bpy.types.PAINT_OT_add_texture_paint_slot.type:'BUMP'
#. :src: bpy.types.NWPrincipledPreferences.bump
msgid "Bump"
msgstr "Bump"

#. :src: bpy.types.ShaderNodeBump
msgid "Generate a perturbed normal from a height texture for bump mapping. Typically used for faking highly detailed surfaces"
msgstr ""
"Generera en störd normal från en höjdtextur för bump mapping. Används "
"vanligtvis för att simulera mycket detaljerade ytor"

#. :src: bpy.types.ShaderNodeBump.invert
msgid "Invert the bump mapping direction to push into the surface instead of out"
msgstr "Vänd bump mapping-riktningen för att trycka in i ytan istället för ut"

#. :src: bpy.types.ShaderNodeCameraData
msgid "Camera Data"
msgstr "Kameradata"

#. :src: bpy.types.ShaderNodeCameraData
msgid "Retrieve information about the camera and how it relates to the current shading point's position"
msgstr ""
"Hämta information om kameran och hur den förhåller sig till den aktuella "
"skuggpunktens position"

#. :src: bpy.types.ShaderNodeClamp
msgid "Clamp a value between a minimum and a maximum"
