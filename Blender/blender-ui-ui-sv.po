msgstr "Bakåtspridning"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:86
#: source/blender/nodes/shader/nodes/node_shader_volume_scatter.cc:58
msgid "Diameter"
msgstr "Diameter"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:94
msgid "Emission Coefficients"
msgstr "Emissionskoefficienter"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:38
msgid "Probability density per color channel that light is absorbed per unit distance traveled in the medium"
msgstr "Sannolikhetstäthet per färgkanal för att ljus absorberas per enhet avstånd som färdas i mediet"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:50
msgid "Probability density per color channel of an out-scattering event occurring per unit distance"
msgstr "Sannolikhetstäthet per färgkanal för en utstrålningshändelse som inträffar per avståndsenhet"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:59
#: source/blender/nodes/shader/nodes/node_shader_volume_scatter.cc:35
msgid "Directionality of the scattering. Zero is isotropic, negative is backward, positive is forward"
msgstr ""
"Spridningens riktning. Noll är isotropisk, negativ är bakåt, positiv är "
"framåt"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:69
#: source/blender/nodes/shader/nodes/node_shader_volume_scatter.cc:44
msgid "Index Of Refraction of the scattering particles"
msgstr "Brytningsindex för de spridande partiklarna"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:77
#: source/blender/nodes/shader/nodes/node_shader_volume_scatter.cc:51
msgid "Fraction of light that is scattered backwards"
msgstr "Del av ljuset som sprids bakåt"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:90
#: source/blender/nodes/shader/nodes/node_shader_volume_scatter.cc:62
msgid "Diameter of the water droplets, in micrometers"
msgstr "Vattendropparnas diameter, i mikrometer"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:98
msgid "Emitted radiance per color channel that is added to a ray per unit distance"
msgstr "Utsänd strålning per färgkanal som läggs till en stråle per enhetsavstånd"

#: source/blender/nodes/shader/nodes/node_shader_volume_principled.cc:27
