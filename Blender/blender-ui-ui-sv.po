"lin_ap1_scene (för ACEScg)"

#. :src: bpy.types.BlendImportContext
msgid "Blendfile Import Context"
msgstr "Blendfile-importkontext"

#. :src: bpy.types.BlendImportContext
msgid "Contextual data for a blendfile library/linked-data related operation. Currently only exposed as read-only data for the pre/post blendimport handlers"
msgstr ""
"Kontextuella data för en åtgärd som rör ett .blend-bibliotek eller länkade "
"data. För närvarande endast tillgängliga som skrivskyddade data för för-/"
"efterhanterare för blendimport"

#. :src: bpy.types.BlendImportContext.options
msgid "Options for this blendfile import operation"
msgstr "Alternativ för denna import av blend-fil"

#. :src: bpy.types.BlendImportContext.options:'LINK'
msgid "Only link data, instead of appending it"
msgstr "Endast länka data, istället för att lägga till den"

#. :src: bpy.types.BlendImportContext.options:'MAKE_PATHS_RELATIVE'
msgid "Make paths of used library blendfiles relative to current blendfile"
msgstr "Gör sökvägar till använda bibliotekets blendfiler relativa till aktuell blendfil"

#. :src: bpy.types.BlendImportContext.options:'USE_PLACEHOLDERS'
msgid "Generate a placeholder (empty ID) if not found in any library files"
msgstr "Skapa en platshållare (tomt ID) om den inte finns i någon biblioteksfil"

#. :src: bpy.types.BlendImportContext.options:'FORCE_INDIRECT'
msgid "Force loaded ID to be tagged as indirectly linked (used in reload context only)"
msgstr "Tvinga ID att märkas som indirekt länkat (används endast i omladdningssammanhang)"

#. :src: bpy.types.BlendImportContext.options:'APPEND_SET_FAKEUSER'
msgid "Set fake user on appended IDs"
msgstr "Ställ in falsk användare på tillagda ID:n"

#. :src: bpy.types.BlendImportContext.options:'APPEND_RECURSIVE'
msgid "Append (make local) also indirect dependencies of appended IDs coming from other libraries. NOTE: All IDs (including indirectly linked ones) coming from the same initial library are always made local"
msgstr ""
"Lägg till (gör lokala) även indirekta beroenden av tillagda ID:n som kommer "
"från andra bibliotek. OBS: Alla ID:n (inklusive indirekt länkade) som kommer "
"från samma ursprungliga bibliotek görs alltid lokala"

#. :src: bpy.types.BlendImportContext.options:'APPEND_LOCAL_ID_REUSE'
msgid "Try to re-use previously appended matching IDs when appending them again, instead of creating local duplicates"
msgstr ""
"Försök att återanvända tidigare tillagda matchande ID:n när du lägger till "
"dem igen i stället för att skapa lokala dubbletter"

#. :src: bpy.types.BlendImportContext.options:'APPEND_ASSET_DATA_CLEAR'
msgid "Clear the asset data on append (it is always kept for linked data)"
msgstr "Rensa tillgångsdata vid tillägg (den sparas alltid för länkade data)"

#. :src: bpy.types.BlendImportContext.options:'SELECT_OBJECTS'
msgid "Automatically select imported objects"
msgstr "Välj importerade objekt automatiskt"

#. :src: bpy.types.BlendImportContext.options:'USE_ACTIVE_COLLECTION'
msgid "Use the active Collection of the current View Layer to instantiate imported collections and objects"
msgstr ""
"Använd den aktiva samlingen i det aktuella visningslagret för att "
"instansiera importerade samlingar och objekt"

#. :src: bpy.types.BlendImportContext.options:'OBDATA_INSTANCE'
msgid "Instantiate object data IDs (i.e. create objects for them if needed)"
msgstr "Instansiera objektdatadid (dvs. skapa objekt för dem om det behövs)"

#. :src: bpy.types.BlendImportContext.options:'COLLECTION_INSTANCE'
msgid "Instantiate collections as empties, instead of linking them into the current view layer"
msgstr ""
"Instansiera samlingar som tomma i stället för att länka dem till det "
"aktuella visningslagret"

#. :src: bpy.types.BlendImportContext.process_stage
msgid "Current stage of the import process"
msgstr "Aktuell fas i importprocessen"

#. :src: bpy.types.BlendImportContext.process_stage:'INIT'
msgid "Blendfile import context has been initialized and filled with a list of items to import, no data has been linked or appended yet"
msgstr ""
"Blendfile-importkontexten har initialiserats och fyllts med en lista över "
"objekt som ska importeras; inga data har ännu länkats eller lagts till"

#. :src: bpy.types.BlendImportContext.process_stage:'DONE'
msgid "All data has been imported and is available in the list of \"import_items\""
msgstr ""
"Alla data har importerats och finns tillgängliga i listan \"import_items\""

#. :src: bpy.types.BlendImportContextItem
msgid "Blendfile Import Context Item"
msgstr "Blendfile-importkontextelement"

#. :src: bpy.types.BlendImportContextItem
msgid "An item (representing a data-block) in a BlendImportContext data. Currently only exposed as read-only data for the pre/post linking handlers"
msgstr ""
"En post (som representerar ett datablock) i BlendImportContext-data. För "
"närvarande endast tillgänglig som skrivskyddade data för för-/efterhanterare "
"för länkning"

#. :src: bpy.types.BlendImportContextItem.append_action
msgid "Append Action"
msgstr "Lägg till åtgärd"

#. :src: bpy.types.BlendImportContextItem.append_action
msgid "How this item has been handled by the append operation. Only set if the data has been appended"
msgstr ""
"Hur denna post har hanterats av tilläggsoperationen. Ange endast om data har "
"lagts till"

#. :src: bpy.types.BlendImportContextItem.append_action:'UNSET'
msgid "Not yet defined"
msgstr "Ännu inte definierat"

#. :src: bpy.types.BlendImportContextItem.append_action:'KEEP_LINKED'
msgid "ID has been kept linked"
msgstr "ID har hållits länkat"

#. :src: bpy.types.BlendImportContextItem.append_action:'REUSE_LOCAL'
msgid "An existing matching local ID has been re-used"
msgstr "Ett befintligt matchande lokalt ID har återanvänts"

#. :src: bpy.types.BlendImportContextItem.append_action:'MAKE_LOCAL'
msgid "The newly linked ID has been made local"
msgstr "Det nykopplade ID:t har gjorts lokalt"

#. :src: bpy.types.BlendImportContextItem.append_action:'COPY_LOCAL'
msgid "The linked ID had other unrelated usages, so it has been duplicated into a local copy"
msgstr ""
"Det länkade ID:t hade andra orelaterade användningar, så det har duplicerats "
"som en lokal kopia"

#. :src: bpy.types.BlendImportContextItem.id
msgid "Imported ID"
msgstr "Importerad ID"

#. :src: bpy.types.BlendImportContextItem.id
msgid "The imported ID. None until it has been linked or appended. May be the same as ``reusable_local_id`` when appended"
msgstr ""
"Det importerade ID:t. Saknas tills det har länkats eller lagts till. Kan "
"vara samma som ``reusable_local_id`` när det läggs till"

#. :src: bpy.types.BlendImportContextItem.id_type
#. :src: bpy.types.DriverTarget.id_type
#. :src: bpy.types.KeyingSetPath.id_type
#. :src: bpy.types.OUTLINER_OT_id_remap.id_type
#. :src: bpy.types.WM_OT_properties_edit.id_type
msgctxt "ID"
msgid "ID Type"
msgstr "ID-typ"

#. :src: bpy.types.BlendImportContextItem.id_type
msgid "ID type of the item"
msgstr "ID-typ för artikeln"

#. :src: bpy.types.BlendImportContextItem.import_info
msgid "Import Info"
msgstr "Importinformation"

#. :src: bpy.types.BlendImportContextItem.import_info
msgid "Various status info about an item after it has been imported"
msgstr "Olika statusuppgifter om en artikel efter att den har importerats"

#. :src: bpy.types.BlendImportContextItem.import_info:'INDIRECT_USAGE'
msgid "That item was added for an indirectly imported ID, as a dependency of another data-block"
msgstr ""
"Den posten lades till för ett indirekt importerat ID som ett beroende till "
"ett annat datablock"

#. :src: bpy.types.BlendImportContextItem.import_info:'LIBOVERRIDE_DEPENDENCY'
msgid "That item represents an ID also used as liboverride dependency (either directly, as a liboverride reference, or indirectly, as data used by a liboverride reference). It should never be directly made local. Mutually exclusive with `LIBOVERRIDE_DEPENDENCY_ONLY`"
msgstr ""
"Denna post representerar ett ID som också används som liboverride-beroende "
"(antingen direkt, som en liboverride-referens, eller indirekt, som data som "
"används av en liboverride-referens). Den ska aldrig göras direkt lokal. "
"Ömsesidigt uteslutande med `LIBOVERRIDE_DEPENDENCY_ONLY`"

#. :src: bpy.types.BlendImportContextItem.import_info:'LIBOVERRIDE_DEPENDENCY_ONLY'
msgid "That item represents an ID only used as liboverride dependency (either directly or indirectly, see `LIBOVERRIDE_DEPENDENCY` for precisions). It should not be considered during the 'make local' (append) process, and remain purely linked data. Mutually exclusive with `LIBOVERRIDE_DEPENDENCY`"
msgstr ""
"Denna post representerar ett ID som endast används som liboverride-beroende "
"(antingen direkt eller indirekt, se `LIBOVERRIDE_DEPENDENCY` för mer "
"information). Den ska inte beaktas under processen \"make local\" (append) "
"och ska förbli rent länkad data. Ömsesidigt uteslutande med "
"`LIBOVERRIDE_DEPENDENCY`"

#. :src: bpy.types.BlendImportContextItem.library_override_id
msgid "Library Overridden ID"
msgstr "Bibliotekets överskrivna ID"

#. :src: bpy.types.BlendImportContextItem.library_override_id
msgid "The library override of the linked ID. None until it has been created"
msgstr ""
"Biblioteksöverstyrningen för det länkade ID:t. Saknas tills den har skapats"

#. :src: bpy.types.BlendImportContextItem.name
msgid "ID name of the item"
msgstr "ID-namn på artikeln"

#. :src: bpy.types.BlendImportContextItem.reusable_local_id
msgid "Reusable Local ID"
msgstr "Återanvändbart lokalt ID"

#. :src: bpy.types.BlendImportContextItem.reusable_local_id
msgid "The already existing local ID that may be reused in append & reuse case. None until it has been found"
msgstr ""
"Det befintliga lokala ID:t som kan återanvändas vid tillägg och "
"återanvändning. Saknas tills det har hittats"

#. :src: bpy.types.BlendImportContextItem.source_libraries
msgid "Source Libraries"
msgstr "Källbibliotek"

#. :src: bpy.types.BlendImportContextItem.source_libraries
msgid "List of libraries to search and import that ID from. The ID will be imported from the first file in that list that contains it"
msgstr ""
"Lista över bibliotek att söka efter och importera det ID:t från. ID:t "
"importeras från den första filen i listan som innehåller det"

#. :src: bpy.types.BlendImportContextItem.source_library
msgid "Source Library"
msgstr "Källbibliotek"

#. :src: bpy.types.BlendImportContextItem.source_library
msgid "Library ID representing the blendfile from which the ID was imported. None until the ID has been linked or appended"
msgstr ""
"Biblioteks-ID som representerar den blendfil från vilken ID:t importerades. "
"Saknas tills ID:t har länkats eller lagts till"

#. :src: bpy.types.BlendImportContextItems
msgid "Blendfile Import Context Items"
msgstr "Blendfile-importkontextposter"

#. :src: bpy.types.BlendImportContextItems
msgid "Collection of blendfile import context items"
msgstr "Samling av blendfile-importkontextelement"

#. :src: bpy.types.BlendImportContextLibraries
msgid "Blendfile Import Context Libraries"
msgstr "Kontextbibliotek för import av blend-filer"

#. :src: bpy.types.BlendImportContextLibraries
msgid "Collection of source libraries, i.e. blendfile paths"
msgstr "Samling av källbibliotek, dvs. blendfile-sökvägar"

#. :src: bpy.types.BlendImportContextLibrary
msgid "BlendFile Import Context Library"
msgstr "Bibliotek för BlendFile-importkontext"

#. :src: bpy.types.BlendImportContextLibrary
msgid "Library (blend-file) reference in a BlendImportContext data. Currently only exposed as read-only data for the pre/post blend-import handlers"
msgstr ""
"Biblioteksreferens (.blend-fil) i BlendImportContext-data. Exponeras för "
"närvarande endast som skrivskyddade data för för-/efterhanterare för "
"blendimport"

