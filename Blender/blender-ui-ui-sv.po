msgstr "Modifierarens styrka"

#. :src: bpy.types.GreasePencilLengthModifier
msgid "Length Modifier"
msgstr "Längdmodifierare"

#. :src: bpy.types.GreasePencilLengthModifier
msgid "Stretch or shrink strokes"
msgstr "Sträck eller krymp streck"

#. :src: bpy.types.GreasePencilLengthModifier.end_factor
#. :src: bpy.types.GreasePencilLengthModifier.end_length
msgid "End Factor"
msgstr "Slutfaktor"

#. :src: bpy.types.GreasePencilLengthModifier.end_factor
msgid "Added length to the end of each stroke relative to its length"
msgstr "Längd tillagd i slutet av varje slag i förhållande till dess längd"

#. :src: bpy.types.GreasePencilLengthModifier.end_length
msgid "Absolute added length to the end of each stroke"
msgstr "Absolut tillagd längd i slutet av varje slag"

#. :src: bpy.types.GreasePencilLengthModifier.invert_curvature
msgid "Invert Curvature"
msgstr "Invertera krökning"

#. :src: bpy.types.GreasePencilLengthModifier.invert_curvature
msgid "Invert the curvature of the stroke's extension"
msgstr "Vänd på kurvan för strykningens förlängning"

#. :src: bpy.types.GreasePencilLengthModifier.max_angle
msgid "Filter Angle"
msgstr "Filtervinkel"

#. :src: bpy.types.GreasePencilLengthModifier.max_angle
msgid "Ignore points on the stroke that deviate from their neighbors by more than this angle when determining the extrapolation shape"
msgstr ""
"Ignorera punkter på strecket som avviker från intilliggande punkter med mer "
"än denna vinkel när extrapoleringsformen bestäms"

#. :src: bpy.types.GreasePencilLengthModifier.mode
msgid "Mode to define length"
msgstr "Läge för att definiera längd"

#. :src: bpy.types.GreasePencilLengthModifier.mode:'RELATIVE'
msgid "Length in ratio to the stroke's length"
msgstr "Längd i förhållande till slaglängden"

#. :src: bpy.types.GreasePencilLengthModifier.mode:'ABSOLUTE'
msgid "Length in geometry space"
msgstr "Längd i geometriskt utrymme"

#. :src: bpy.types.GreasePencilLengthModifier.overshoot_factor
#: source/blender/modifiers/intern/MOD_grease_pencil_length.cc:288
msgid "Used Length"
msgstr "Använd längd"

#. :src: bpy.types.GreasePencilLengthModifier.overshoot_factor
msgid "Defines what portion of the stroke is used for the calculation of the extension"
msgstr "Anger vilken del av strecket som används för att beräkna förlängningen"

#. :src: bpy.types.GreasePencilLengthModifier.point_density
msgid "Point Density"
msgstr "Punkttäthet"

#. :src: bpy.types.GreasePencilLengthModifier.point_density
msgid "Multiplied by Start/End for the total added point count"
msgstr "Multiplicerat med Start/Slut för det totala antalet tillagda poäng"

#. :src: bpy.types.GreasePencilLengthModifier.random_end_factor
msgid "Random End Factor"
msgstr "Slumpmässig slutfaktor"

#. :src: bpy.types.GreasePencilLengthModifier.random_end_factor
msgid "Size of random length added to the end of each stroke"
msgstr "Storlek på slumpmässig längd som läggs till i slutet av varje streck"

#. :src: bpy.types.GreasePencilLengthModifier.random_offset
msgid "Random Noise Offset"
msgstr "Slumpmässig brusförskjutning"

#. :src: bpy.types.GreasePencilLengthModifier.random_offset
msgid "Smoothly offset each stroke's random value"
msgstr "Jämna ut varje slags slumpmässiga värde"

#. :src: bpy.types.GreasePencilLengthModifier.random_start_factor
msgid "Random Start Factor"
msgstr "Slumpmässig startfaktor"

#. :src: bpy.types.GreasePencilLengthModifier.random_start_factor
msgid "Size of random length added to the start of each stroke"
msgstr "Storlek på slumpmässig längd som läggs till i början av varje streck"

#. :src: bpy.types.GreasePencilLengthModifier.segment_influence
msgid "Segment Influence"
msgstr "Segmentets inflytande"

#. :src: bpy.types.GreasePencilLengthModifier.segment_influence
msgid "Factor to determine how much the length of the individual segments should influence the final computed curvature. Higher factors makes small segments influence the overall curvature less."
msgstr "Faktor som avgör hur mycket längden på de enskilda segmenten ska påverka den slutliga beräknade krökningen. Högre faktorer gör att små segment påverkar den totala krökningen mindre."

#. :src: bpy.types.GreasePencilLengthModifier.start_factor
#. :src: bpy.types.GreasePencilLengthModifier.start_length
msgid "Start Factor"
msgstr "Startfaktor"

#. :src: bpy.types.GreasePencilLengthModifier.start_factor
msgid "Added length to the start of each stroke relative to its length"
msgstr ""
"Längd som läggs till i början av varje streck i förhållande till dess längd"

#. :src: bpy.types.GreasePencilLengthModifier.start_length
msgid "Absolute added length to the start of each stroke"
msgstr "Absolut tillagd längd till början av varje slag"

