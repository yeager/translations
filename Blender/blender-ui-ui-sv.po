#. :src: bpy.types.CyclesDeviceSettings.type:'ONEAPI'
msgid "oneAPI"
msgstr "oneAPI"

#. :src: bpy.types.CyclesDeviceSettings.use
msgid "Use device for rendering"
msgstr "Använd enhet för rendering"

#. :src: bpy.types.CyclesLightSettings.is_caustics_light
#. :src: bpy.types.CyclesWorldSettings.is_caustics_light
#: scripts/addons_core/cycles/ui.py:1694
#: scripts/addons_core/cycles/ui.py:1892
msgid "Shadow Caustics"
msgstr "Skuggkaustik"

#. :src: bpy.types.CyclesLightSettings.is_caustics_light
#. :src: bpy.types.CyclesWorldSettings.is_caustics_light
msgid "Generate approximate caustics in shadows of refractive surfaces. Lights, caster and receiver objects must have shadow caustics options set to enable this"
msgstr ""
"Generera ungefärliga kaustiker i skuggor på refraktiva ytor. Ljus-, kastare- "
"och mottagareobjekt måste ha skuggkaustikalternativ inställda för att "
"aktivera detta"

#. :src: bpy.types.CyclesLightSettings.is_portal
msgid "Is Portal"
msgstr "Är Portal"

#. :src: bpy.types.CyclesLightSettings.is_portal
msgid "Use this area light to guide sampling of the background, note that this will make the light invisible"
msgstr ""
"Använd detta områdesljus för att styra provtagningen av bakgrunden. "
"Observera att detta gör ljuset osynligt"

#. :src: bpy.types.CyclesLightSettings.max_bounces
msgid "Maximum number of bounces the light will contribute to the render"
msgstr "Maximalt antal studsar som ljuset bidrar till renderingen"

#. :src: bpy.types.CyclesLightSettings.use_multiple_importance_sampling
msgid "Multiple Importance Sample"
msgstr "Flera viktiga exempel"

#. :src: bpy.types.CyclesLightSettings.use_multiple_importance_sampling
msgid "Use multiple importance sampling for the light, reduces noise for area lights and sharp glossy materials"
msgstr ""
"Använd flera viktiga provtagningar för ljuset, minskar brus för "
"områdesbelysning och skarpa glansiga material"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling
msgctxt "Light"
msgid "Emission Sampling"
msgstr "Utsläppsprovtagning"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling
msgid "Sampling strategy for emissive surfaces"
msgstr "Provtagningsstrategi för emitterande ytor"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'NONE'
msgctxt "Light"
msgid "None"
msgstr "Ingen"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'NONE'
msgid "Do not use this surface as a light for sampling"
msgstr "Använd inte denna yta som belysning för provtagning"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'AUTO'
msgctxt "Light"
msgid "Auto"
msgstr "Auto"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'AUTO'
msgid "Automatically determine if the surface should be treated as a light for sampling, based on estimated emission intensity"
msgstr ""
"Automatiskt avgöra om ytan ska behandlas som en ljuspunkt för provtagning, "
"baserat på uppskattad emissionsintensitet"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'FRONT'
msgctxt "Light"
msgid "Front"
msgstr "Framsida"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'FRONT'
msgid "Treat only front side of the surface as a light, usually for closed meshes whose interior is not visible"
msgstr ""
"Behandla endast framsidan av ytan som ljus, vanligtvis för slutna nät vars "
"insida inte är synlig"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'BACK'
msgctxt "Light"
msgid "Back"
msgstr "Tillbaka"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'BACK'
msgid "Treat only back side of the surface as a light for sampling"
msgstr "Behandla endast baksidan av ytan som ett ljus för provtagning"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'FRONT_BACK'
msgctxt "Light"
msgid "Front and Back"
msgstr "Framsida och baksida"

#. :src: bpy.types.CyclesMaterialSettings.emission_sampling:'FRONT_BACK'
msgid "Treat surface as a light for sampling, emitting from both the front and back side"
msgstr ""
"Behandla ytan som ett ljus för provtagning, som avges från både fram- och "
"baksidan"

#. :src: bpy.types.CyclesMaterialSettings.use_bump_map_correction
msgid "Bump Map Correction"
msgstr "Korrigering av bump map"

#. :src: bpy.types.CyclesMaterialSettings.use_bump_map_correction
msgid "Apply corrections to solve shadow terminator artifacts caused by bump mapping"
msgstr ""
"Tillämpa korrigeringar för att lösa skuggtillfälliga artefakter orsakade av "
"bump mapping"

#. :src: bpy.types.CyclesMaterialSettings.volume_interpolation
#. :src: bpy.types.CyclesWorldSettings.volume_interpolation
msgid "Volume Interpolation"
msgstr "Volyminterpolering"

#. :src: bpy.types.CyclesMaterialSettings.volume_interpolation
msgid "Interpolation method to use for smoke/fire volumes"
msgstr "Interpoleringsmetod som ska användas för rök-/brandvolymer"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling
#. :src: bpy.types.CyclesWorldSettings.volume_sampling
msgid "Volume Sampling"
msgstr "Volymprovtagning"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling
#. :src: bpy.types.CyclesWorldSettings.volume_sampling
msgid "Sampling method to use for volumes"
msgstr "Provtagningsmetod som ska användas för volymer"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'DISTANCE'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'DISTANCE'
msgid "Use distance sampling, best for dense volumes with lights far away"
msgstr "Använd avståndsampling, bäst för täta volymer med ljus långt bort"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'EQUIANGULAR'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'EQUIANGULAR'
msgid "Equiangular"
msgstr "Likvinkel"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'EQUIANGULAR'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'EQUIANGULAR'
msgid "Use equiangular sampling, best for volumes with low density with light inside or near the volume"
msgstr ""
"Använd ekvivalenta provtagningar, vilket är bäst för volymer med låg "
"densitet med ljus inuti eller nära volymen"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'MULTIPLE_IMPORTANCE'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'MULTIPLE_IMPORTANCE'
#: scripts/addons_core/cycles/ui.py:1693
msgid "Multiple Importance"
msgstr "Flera viktiga faktorer"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'MULTIPLE_IMPORTANCE'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'MULTIPLE_IMPORTANCE'
msgid "Combine distance and equi-angular sampling for volumes where neither method is ideal"
msgstr ""
"Kombinera avstånds- och likvinkelprovtagning för volymer där ingen av "
"metoderna är idealisk"

#. :src: bpy.types.CyclesMaterialSettings.volume_step_rate
#. :src: bpy.types.CyclesRenderSettings.volume_preview_step_rate
#. :src: bpy.types.CyclesRenderSettings.volume_step_rate
msgid "Step Rate"
msgstr "Stegfrekvens"

#. :src: bpy.types.CyclesMaterialSettings.volume_step_rate
msgid "Scale the distance between volume shader samples when rendering the volume (lower values give more accurate and detailed results, but also increased render time)"
msgstr ""
"Skala avståndet mellan volymskuggproverna när volymen renderas (lägre värden "
"ger mer exakta och detaljerade resultat, men också längre rendertid)"

#. :src: bpy.types.CyclesObjectSettings.ao_distance
#: scripts/addons_core/cycles/ui.py:718
msgid "AO Distance"
msgstr "AO-avstånd"

#. :src: bpy.types.CyclesObjectSettings.ao_distance
msgid "AO distance used for approximate global illumination (0 means use world setting)"
msgstr "AO-avstånd som används för ungefärlig global belysning (0 betyder att världsinställningen används)"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_caster
msgid "Cast Shadow Caustics"
msgstr "Kastad skugga Kaustik"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_caster
msgid "With refractive materials, generate approximate caustics in shadows of this object. Up to 10 bounces inside this object are taken into account. Lights, caster and receiver objects must have shadow caustics options set to enable this"
msgstr ""
"Med refraktiva material genereras ungefärliga kaustiker i skuggorna av detta "
"objekt. Upp till 10 studsar inuti detta objekt beaktas. Ljus-, kastare- och "
"mottagareobjekt måste ha inställningar för skuggkaustik aktiverade för att "
"detta ska fungera"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_receiver
msgid "Receive Shadow Caustics"
msgstr "Ta emot skuggkaustik"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_receiver
msgid "Receive approximate caustics from refractive materials in shadows on this object. Lights, caster and receiver objects must have shadow caustics options set to enable this"
msgstr ""
"Ta emot ungefärliga kaustiker från refraktiva material i skuggor på detta "
"objekt. Ljus-, kastare- och mottagareobjekt måste ha skuggkaustikalternativ "
"inställda för att aktivera detta"

#. :src: bpy.types.CyclesObjectSettings.motion_steps
msgid "Motion Steps"
msgstr "Rörelsesteg"

#. :src: bpy.types.CyclesObjectSettings.motion_steps
msgid "Control accuracy of motion blur, more steps gives more memory usage (actual number of steps is 2^(steps - 1))"
msgstr ""
"Kontrollera noggrannheten för rörelseoskärpa. Fler steg innebär större "
"minnesanvändning (det faktiska antalet steg är 2^(steg - 1))"

#. :src: bpy.types.CyclesObjectSettings.use_camera_cull
#. :src: bpy.types.CyclesRenderSettings.use_camera_cull
msgid "Use Camera Cull"
msgstr "Använd kamerautval"

#. :src: bpy.types.CyclesObjectSettings.use_camera_cull
msgid "Allow this object and its duplicators to be culled by camera space culling"
msgstr ""
"Tillåt att detta objekt och dess duplicatorer gallras bort av kamerans "
"rymdgallring"

#. :src: bpy.types.CyclesObjectSettings.use_deform_motion
msgid "Use Deformation Motion"
msgstr "Använd deformationsrörelse"

#. :src: bpy.types.CyclesObjectSettings.use_deform_motion
msgid "Use deformation motion blur for this object"
msgstr "Använd deformationsrörelseoskärpa för detta objekt"

#. :src: bpy.types.CyclesObjectSettings.use_distance_cull
#. :src: bpy.types.CyclesRenderSettings.use_distance_cull
msgid "Use Distance Cull"
msgstr "Använd avståndssortering"

#. :src: bpy.types.CyclesObjectSettings.use_distance_cull
msgid "Allow this object and its duplicators to be culled by distance from camera"
msgstr ""
"Tillåt att detta objekt och dess duplicatorer gallras bort efter avstånd "
"från kameran"

#. :src: bpy.types.CyclesObjectSettings.use_motion_blur
msgid "Use Motion Blur"
msgstr "Använd rörelseoskärpa"

#. :src: bpy.types.CyclesObjectSettings.use_motion_blur
msgid "Use motion blur for this object"
msgstr "Använd rörelseoskärpa för detta objekt"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_pass_follow_reflections
msgid "Denoising Pass Reflections"
msgstr "Reflektioner för brusreduceringspass"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_pass_follow_reflections
msgid "Follow reflections for the denoising feature passes"
msgstr "Följ reflektioner för funktionspassen för brusreducering"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_pass_use_albedo_roughness_weighting
#. :src: bpy.types.ViewLayerEEVEE.denoising_pass_use_albedo_roughness_weighting
msgid "Denoising Pass Albedo Roughness Weighting"
msgstr "Viktning av albedoråhet för brusreduceringspass"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_pass_use_albedo_roughness_weighting
#. :src: bpy.types.ViewLayerEEVEE.denoising_pass_use_albedo_roughness_weighting
msgid "Use roughness-based weighting of the albedo for the denoising feature passes"
msgstr "Använd råhetsbaserad viktning av albedot för funktionspassen för brusreducering"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_store_passes
msgid "Store Denoising Passes"
msgstr "Lagra brusreduceringspass"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_store_passes
msgid "Store the denoising feature passes and the noisy image. The passes adapt to the denoiser selected for rendering"
msgstr ""
"Lagra passagen för brusreducering och den brusiga bilden. Passagen anpassas "
"till den brusreducerare som valts för rendering"

#. :src: bpy.types.CyclesRenderLayerSettings.pass_debug_sample_count
#: scripts/addons_core/cycles/engine.py:228
msgid "Debug Sample Count"
msgstr "Felsökning av provantal"

#. :src: bpy.types.CyclesRenderLayerSettings.pass_debug_sample_count
msgid "Number of samples per pixel taken, divided by the maximum number of samples. To analyze adaptive sampling"
msgstr "Antal prov per pixel som tagits, dividerat med det maximala antalet prov. För att analysera adaptiv provtagning"

#. :src: bpy.types.CyclesRenderLayerSettings.pass_render_time
#: scripts/addons_core/cycles/engine.py:232
#: scripts/addons_core/cycles/ui.py:1114
#: scripts/startup/bl_ui/properties_output.py:222
msgid "Render Time"
msgstr "Renderingstid"

#. :src: bpy.types.CyclesRenderLayerSettings.pass_render_time
msgid "Reports time per pixel in milliseconds. Supported only on CPU render devices"
msgstr ""
"Rapporterar tid per pixel i millisekunder. Stöds endast på CPU-"
"renderingsenheter"

#. :src: bpy.types.CyclesRenderLayerSettings.use_denoising
#. :src: bpy.types.CyclesRenderSettings.use_denoising
msgid "Use Denoising"
msgstr "Använd brusreducering"

#. :src: bpy.types.CyclesRenderLayerSettings.use_denoising
#. :src: bpy.types.CyclesRenderSettings.use_denoising
msgid "Denoise the rendered image"
msgstr "Brusreducering av den renderade bilden"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_shadow_catcher
msgid "Pass containing shadows and light which is to be multiplied into backdrop"
msgstr "Pass med skuggor och ljus som ska multipliceras till bakgrund"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_direct
#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'VOLUME_DIRECT'
#: scripts/addons_core/cycles/engine.py:215
msgid "Volume Direct"
msgstr "Volym Direkt"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_direct
msgid "Deliver direct volumetric scattering pass"
msgstr "Leverera direkt volymetrisk spridningspass"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_indirect
#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'VOLUME_INDIRECT'
#: scripts/addons_core/cycles/engine.py:216
msgid "Volume Indirect"
msgstr "Volym Indirekt"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_indirect
msgid "Deliver indirect volumetric scattering pass"
msgstr "Leverera indirekt volymetrisk spridningspass"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_majorant
#: scripts/addons_core/cycles/engine.py:219
msgid "Volume Majorant"
msgstr "Volymmajorant"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_majorant
msgid "Majorant transmittance of the volume"
msgstr "Volymens majoranta transmittans"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_scatter
msgid "Contribution of paths that scattered in the volume at the primary ray"
msgstr "Bidrag från strålar som spridits i volymen vid primärstrålen"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_transmit
#: scripts/addons_core/cycles/engine.py:218
msgid "Volume Transmit"
msgstr "Volymöverföring"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_transmit
msgid "Contribution of paths that transmitted through the volume at the primary ray"
msgstr "Bidrag från banor som överfördes genom volymen vid den primära strålen"

#. :src: bpy.types.CyclesRenderSettings.adaptive_min_samples
#. :src: bpy.types.CyclesRenderSettings.preview_adaptive_min_samples
msgid "Adaptive Min Samples"
msgstr "Adaptiva minsta antal sampel"

#. :src: bpy.types.CyclesRenderSettings.adaptive_min_samples
msgid "Minimum AA samples for adaptive sampling, to discover noisy features before stopping sampling. Zero for automatic setting based on noise threshold"
msgstr ""
"Minsta antal AA-sampel för adaptiv provtagning, för att upptäcka brusiga "
"egenskaper innan provtagningen avbryts. Noll för automatisk inställning "
"baserad på brusgränsvärde"

#. :src: bpy.types.CyclesRenderSettings.adaptive_threshold
#. :src: bpy.types.CyclesRenderSettings.preview_adaptive_threshold
msgid "Adaptive Sampling Threshold"
msgstr "Adaptiv provtagningsgräns"

#. :src: bpy.types.CyclesRenderSettings.adaptive_threshold
msgid "Noise level step to stop sampling at, lower values reduce noise at the cost of render time. Zero for automatic setting based on number of AA samples"
msgstr ""
"Ljudnivå vid vilken sampling avbryts. Lägre värden minskar bruset på "
"bekostnad av renderingshastigheten. Noll för automatisk inställning baserad "
"på antalet AA-samplingar"

#. :src: bpy.types.CyclesRenderSettings.ao_bounces
msgid "AO Bounces"
msgstr "AO studsar"

#. :src: bpy.types.CyclesRenderSettings.ao_bounces
#. :src: bpy.types.CyclesRenderSettings.ao_bounces_render
msgid "After this number of light bounces, use approximate global illumination. 0 disables this feature"
msgstr ""
"Efter detta antal ljusreflektioner, använd ungefärlig global belysning. 0 "
"inaktiverar denna funktion"

#. :src: bpy.types.CyclesRenderSettings.ao_bounces_render
msgid "AO Bounces Render"
msgstr "AO-studsrendering"

#. :src: bpy.types.CyclesRenderSettings.auto_scrambling_distance
msgid "Automatic Scrambling Distance"
msgstr "Automatisk krypteringsavstånd"

#. :src: bpy.types.CyclesRenderSettings.auto_scrambling_distance
msgid "Automatically reduce the randomization between pixels to improve GPU rendering performance, at the cost of possible rendering artifacts"
msgstr ""
"Minska automatiskt slumpmässigheten mellan pixlar för att förbättra GPU-"
"renderingens prestanda, på bekostnad av möjliga renderingsartefakter"

#. :src: bpy.types.CyclesRenderSettings.bake_type
msgid "Type of pass to bake"
msgstr "Typ av pass för bakning"

#. :src: bpy.types.CyclesRenderSettings.blur_glossy
msgid "Filter Glossy"
msgstr "Filter Glansig"

#. :src: bpy.types.CyclesRenderSettings.blur_glossy
msgid "Adaptively blur glossy shaders and image textures after blurry bounces, to reduce noise and improve texture cache efficiency at the cost of accuracy. Lower this value to render caustics"
msgstr "Gör glansiga shaders och bildtexturer adaptivt oskarpa efter oskarpa studsningar för att minska brus och förbättra texturcachens effektivitet på bekostnad av noggrannhet. Sänk värdet för att rendera kaustik"

#. :src: bpy.types.CyclesRenderSettings.camera_cull_margin
msgid "Camera Cull Margin"
msgstr "Kamerans gallringsmarginal"

#. :src: bpy.types.CyclesRenderSettings.camera_cull_margin
msgid "Margin for the camera space culling"
msgstr "Marginal för kamerans utrymmesgallring"

#. :src: bpy.types.CyclesRenderSettings.caustics_reflective
msgid "Reflective Caustics"
msgstr "Reflekterande kaustik"

#. :src: bpy.types.CyclesRenderSettings.caustics_reflective
msgid "Use reflective caustics, resulting in a brighter image (more noise but added realism)"
msgstr "Använd reflekterande kaustik, vilket ger en ljusare bild (mer brus men ökad realism)"

#. :src: bpy.types.CyclesRenderSettings.caustics_refractive
msgid "Refractive Caustics"
msgstr "Refraktiva kaustiker"

#. :src: bpy.types.CyclesRenderSettings.caustics_refractive
msgid "Use refractive caustics, resulting in a brighter image (more noise but added realism)"
msgstr "Använd refraktiva kaustiker, vilket ger en ljusare bild (mer brus men ökad realism)"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_layout
msgid "BVH Layout"
msgstr "BVH-layout"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_layout:'BVH2'
msgid "BVH2"
msgstr "BVH2"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_layout:'EMBREE'
msgid "Embree"
msgstr "Embree"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_time_steps
msgid "BVH Time Steps"
msgstr "BVH-tidsteg"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_time_steps
msgid "Split BVH primitives by this number of time steps to speed up render time in cost of memory"
msgstr ""
"Dela upp BVH-primitiv efter detta antal tidssteg för att påskynda "
"renderningstiden på bekostnad av minne"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type
msgid "Viewport BVH Type"
msgstr "Visningsvy BVH-typ"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type
msgid "Choose between faster updates, or faster render"
msgstr "Välj mellan snabbare uppdateringar eller snabbare rendering"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type:'DYNAMIC_BVH'
msgid "Dynamic BVH"
msgstr "Dynamisk BVH"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type:'DYNAMIC_BVH'
msgid "Objects can be individually updated, at the cost of slower render time"
msgstr "Objekt kan uppdateras individuellt, men det tar längre tid att rendera"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type:'STATIC_BVH'
msgid "Static BVH"
msgstr "Statisk BVH"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type:'STATIC_BVH'
msgid "Any object modification requires a complete BVH rebuild, but renders faster"
msgstr ""
"Alla objektmodifieringar kräver en fullständig ombyggnad av BVH, men "
"renderas snabbare"

#. :src: bpy.types.CyclesRenderSettings.debug_texture_cache_preserve_unused
msgid "Preserve Unused MB"
msgstr "Bevara oanvända MB"

#. :src: bpy.types.CyclesRenderSettings.debug_texture_cache_preserve_unused
msgid "Preserve unused texture cache data, up to this amount of memory"
msgstr "Bevara oanvända texturcachedata upp till denna mängd minne"

#. :src: bpy.types.CyclesRenderSettings.debug_use_compact_bvh
msgid "Use Compact BVH"
msgstr "Använd Compact BVH"

#. :src: bpy.types.CyclesRenderSettings.debug_use_compact_bvh
msgid "Use compact BVH structure (uses less ram but renders slower)"
msgstr "Använd kompakt BVH-struktur (använder mindre RAM men renderar långsammare)"

#. :src: bpy.types.CyclesRenderSettings.debug_use_cpu_avx2
msgid "AVX2"
msgstr "AVX2"

#. :src: bpy.types.CyclesRenderSettings.debug_use_cpu_sse42
msgid "SSE42"
msgstr "SSE42"

#. :src: bpy.types.CyclesRenderSettings.debug_use_cuda_adaptive_compile
#. :src: bpy.types.CyclesRenderSettings.debug_use_hip_adaptive_compile
#. :src: bpy.types.CyclesRenderSettings.debug_use_metal_adaptive_compile
msgid "Adaptive Compile"
msgstr "Adaptiv kompilering"

#. :src: bpy.types.CyclesRenderSettings.debug_use_cuda_adaptive_compile
#. :src: bpy.types.CyclesRenderSettings.debug_use_hip_adaptive_compile
#. :src: bpy.types.CyclesRenderSettings.debug_use_metal_adaptive_compile
msgid "Compile the Cycles GPU kernel with only the feature set required for the current scene"
msgstr ""
"Kompilera Cycles GPU-kärnan med endast de funktioner som krävs för den "
"aktuella scenen"

#. :src: bpy.types.CyclesRenderSettings.debug_use_hair_bvh
msgid "Use Curves BVH"
msgstr "Använd kurvor BVH"

#. :src: bpy.types.CyclesRenderSettings.debug_use_hair_bvh
msgid "Use special type BVH optimized for curves (uses more ram but renders faster)"
msgstr "Använd specialtyp BVH optimerad för kurvor (använder mer RAM men renderar snabbare)"

#. :src: bpy.types.CyclesRenderSettings.debug_use_optix_debug
msgid "OptiX Module Debug"
msgstr "OptiX-modulens felsökning"

#. :src: bpy.types.CyclesRenderSettings.debug_use_optix_debug
msgid "Load OptiX module in debug mode: lower logging verbosity level, enable validations, and lower optimization level"
msgstr ""
"Ladda OptiX-modulen i felsökningsläge: sänk loggningsnivån, aktivera "
"valideringar och sänk optimeringsnivån"

#. :src: bpy.types.CyclesRenderSettings.debug_use_spatial_splits
msgid "Use Spatial Splits"
msgstr "Använd rumsliga uppdelningar"

#. :src: bpy.types.CyclesRenderSettings.debug_use_spatial_splits
msgid "Use BVH spatial splits: longer builder time, faster render"
msgstr "Använd BVH-rumsliga uppdelningar: längre byggtid, snabbare rendering"

#. :src: bpy.types.CyclesRenderSettings.debug_use_texture_cache_eviction
msgid "Cache Eviction"
msgstr "Utrensning av cache"

#. :src: bpy.types.CyclesRenderSettings.debug_use_texture_cache_eviction
msgid "Evict unused tiles from the texture cache to free up memory"
msgstr "Rensa oanvända paneler från texturcachen för att frigöra minne"

#. :src: bpy.types.CyclesRenderSettings.denoiser
#: scripts/addons_core/cycles/ui.py:273
#: scripts/addons_core/cycles/ui.py:358
msgid "Denoiser"
msgstr "Brusreducerare"

#. :src: bpy.types.CyclesRenderSettings.denoiser
msgid "Denoise the image with the selected denoiser. For denoising the image after rendering"
msgstr "Avbrusbilden med den valda brusreduceraren. För brusreducering av bilden efter rendering"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes
msgid "Denoising Input Passes"
msgstr "Brusreducering av ingångssignaler"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes
msgid "Passes used by the denoiser to distinguish noise from shader and geometry detail"
msgstr "Pass som används av brusreduceraren för att skilja brus från shader och geometridetaljer"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB'
msgid "Do not use utility passes for denoising"
msgstr "Använd inte hjälppass för brusreducering"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB_ALBEDO'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB_ALBEDO'
#: source/blender/nodes/composite/nodes/node_composite_denoise.cc:76
msgid "Albedo"
msgstr "Albedo"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB_ALBEDO'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB_ALBEDO'
msgid "Use albedo pass for denoising"
msgstr "Använd albedo-pass för brusreducering"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB_ALBEDO_NORMAL'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB_ALBEDO_NORMAL'
msgid "Albedo and Normal"
msgstr "Albedo och Normal"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB_ALBEDO_NORMAL'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB_ALBEDO_NORMAL'
msgid "Use albedo and normal passes for denoising"
msgstr "Använd albedo och normala pass för brusreducering"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter
msgid "Denoising Prefilter"
msgstr "Brusreducerande förfilter"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter
msgid "Prefilter noisy guiding (albedo and normal) passes to improve denoising quality when using OpenImageDenoise"
msgstr "Förfilter för brusig guidning (albedo och normal) passerar för att förbättra brusreduceringskvaliteten vid användning av OpenImageDenoise"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter:'NONE'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter:'NONE'
#: source/blender/nodes/composite/nodes/node_composite_denoise.cc:34
msgid "No prefiltering, use when guiding passes are noise-free"
msgstr "Ingen förfiltrering, använd när styrpassningarna är brusfria"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter:'FAST'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter:'FAST'
msgid "Denoise color and guiding passes together. Improves quality when guiding passes are noisy using least amount of extra processing time"
msgstr ""
"Brusreducering av färg och guidningspass samtidigt. Förbättrar kvaliteten "
"när guidningspass är brusiga med minsta möjliga extra bearbetningstid"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter:'ACCURATE'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter:'ACCURATE'
msgid "Prefilter noisy guiding passes before denoising color. Improves quality when guiding passes are noisy using extra processing time"
msgstr ""
"Förfilterar brusiga guidningspass innan brusreducering av färg. Förbättrar "
"kvaliteten när guidningspass är brusiga genom att använda extra "
"bearbetningstid"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality
msgid "Denoising Quality"
msgstr "Brusreduceringskvalitet"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality
msgid "Overall denoising quality when using OpenImageDenoise"
msgstr "Övergripande brusreduceringskvalitet vid användning av OpenImageDenoise"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'HIGH'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'HIGH'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'HIGH'
#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality:'HIGH'
msgid "High quality"
msgstr "Hög kvalitet"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'BALANCED'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'BALANCED'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'BALANCED'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'BALANCED'
#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality:'BALANCED'
#: source/blender/nodes/composite/nodes/node_composite_denoise.cc:59
msgid "Balanced"
msgstr "Balanserad"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'BALANCED'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'BALANCED'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'BALANCED'
#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality:'BALANCED'
#: source/blender/nodes/composite/nodes/node_composite_denoise.cc:60
msgid "Balanced between performance and quality"
msgstr "Balans mellan prestanda och kvalitet"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'FAST'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'FAST'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'FAST'
#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality:'FAST'
msgid "High performance"
msgstr "Hög prestanda"

#. :src: bpy.types.CyclesRenderSettings.denoising_use_gpu
msgid "Denoise on GPU"
msgstr "Brusreducering på GPU"

#. :src: bpy.types.CyclesRenderSettings.denoising_use_gpu
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_use_gpu
msgid "Perform denoising on GPU devices configured in the system tab in the user preferences. This is significantly faster than on CPU, but requires additional GPU memory. When large scenes need more GPU memory, this option can be disabled"
msgstr ""
"Utför brusreducering på GPU-enheter som konfigurerats under fliken System i "
"användarinställningarna. Detta är betydligt snabbare än på CPU, men kräver "
"ytterligare GPU-minne. När stora scener kräver mer GPU-minne kan detta "
"alternativ inaktiveras"

#. :src: bpy.types.CyclesRenderSettings.device
msgid "Device to use for rendering"
msgstr "Enhet som ska användas för rendering"

#. :src: bpy.types.CyclesRenderSettings.device:'CPU'
msgid "Use CPU for rendering"
msgstr "Använd CPU för rendering"

#. :src: bpy.types.CyclesRenderSettings.device:'GPU'
msgid "GPU Compute"
msgstr "GPU-beräkning"

#. :src: bpy.types.CyclesRenderSettings.device:'GPU'
msgid "Use GPU compute device for rendering, configured in the system tab in the user preferences"
msgstr ""
"Använd GPU-beräkningsenhet för rendering, konfigurerad under fliken System i "
"användarinställningarna"

#. :src: bpy.types.CyclesRenderSettings.dicing_camera
msgid "Dicing Camera"
msgstr "Tärningskamera"

#. :src: bpy.types.CyclesRenderSettings.dicing_camera
msgid "Camera to use as reference point when subdividing geometry, useful to avoid crawling artifacts in animations when the scene camera is moving"
msgstr ""
"Kamera som används som referenspunkt vid uppdelning av geometri, användbar "
"för att undvika krypande artefakter i animationer när scenkameran rör sig"

#. :src: bpy.types.CyclesRenderSettings.dicing_rate
msgid "Dicing Rate"
msgstr "Skärhastighet"

#. :src: bpy.types.CyclesRenderSettings.dicing_rate
msgid "Multiplier for per object adaptive subdivision size"
msgstr "Multiplikator för adaptiv subdivisionsstorlek per objekt"

#. :src: bpy.types.CyclesRenderSettings.diffuse_bounces
#. :src: bpy.types.SceneEEVEE.gi_diffuse_bounces
msgid "Diffuse Bounces"
msgstr "Diffusa studsar"

#. :src: bpy.types.CyclesRenderSettings.diffuse_bounces
msgid "Maximum number of diffuse reflection bounces, bounded by total maximum"
msgstr "Maximalt antal diffusa reflektionsstudsar, begränsat av totalt maximum"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type
msgid "Direct Light Sampling"
msgstr "Direkt ljusprovtagning"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type
msgid "The type of strategy used for sampling direct light contributions"
msgstr "Den typ av strategi som används för att sampla direkta ljusbidrag"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type:'MULTIPLE_IMPORTANCE_SAMPLING'
msgid "Multiple Importance Sampling"
msgstr "Multipel viktningssampling"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type:'MULTIPLE_IMPORTANCE_SAMPLING'
msgid "Multiple importance sampling is used to combine direct light contributions from next-event estimation and forward path tracing"
msgstr ""
"Multiplast viktighetsprovtagning används för att kombinera direkta "
"ljusbidrag från nästa händelseuppskattning och framåtsträckning"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type:'FORWARD_PATH_TRACING'
msgid "Forward Path Tracing"
msgstr "Framåtsträckt spårning"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type:'FORWARD_PATH_TRACING'
msgid "Direct light contributions are only sampled using forward path tracing"
msgstr ""
"Direkt ljus bidrar endast till sampling med hjälp av framåtriktad "
"strålspårning"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type:'NEXT_EVENT_ESTIMATION'
msgid "Next-Event Estimation"
msgstr "Uppskattning av nästa händelse"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type:'NEXT_EVENT_ESTIMATION'
msgid "Direct light contributions are only sampled using next-event estimation"
msgstr ""
"Direkt ljus bidrar endast till mätningen genom att nästa händelse uppskattas"

#. :src: bpy.types.CyclesRenderSettings.distance_cull_margin
msgid "Cull Distance"
msgstr "Avstånd för gallring"

#. :src: bpy.types.CyclesRenderSettings.distance_cull_margin
msgid "Cull objects which are further away from camera than this distance"
msgstr ""
"Ta bort objekt som befinner sig längre bort från kameran än detta avstånd"

#. :src: bpy.types.CyclesRenderSettings.fast_gi_method
msgid "Fast GI Method"
msgstr "Snabb GI-metod"

#. :src: bpy.types.CyclesRenderSettings.fast_gi_method
#. :src: bpy.types.SceneEEVEE.fast_gi_method
msgid "Fast GI approximation method"
msgstr "Snabb GI-approximationsmetod"

#. :src: bpy.types.CyclesRenderSettings.fast_gi_method:'REPLACE'
msgid "Replace global illumination with ambient occlusion after a specified number of bounces"
msgstr ""
"Ersätt global belysning med omgivande ocklusion efter ett angivet antal "
"studsar"

#. :src: bpy.types.CyclesRenderSettings.fast_gi_method:'ADD'
msgid "Add ambient occlusion to diffuse surfaces"
msgstr "Lägg till omgivande ocklusion till diffusa ytor"

#. :src: bpy.types.CyclesRenderSettings.film_exposure
msgid "Image brightness scale"
msgstr "Bildens ljusstyrka skala"

#. :src: bpy.types.CyclesRenderSettings.film_transparent_glass
#: scripts/addons_core/cycles/ui.py:821
msgid "Transparent Glass"
msgstr "Transparent glas"

#. :src: bpy.types.CyclesRenderSettings.film_transparent_glass
msgid "Render transmissive surfaces as transparent, for compositing glass over another background"
msgstr ""
"Rendera genomskinliga ytor som transparenta för att komponera glas över en "
"annan bakgrund"

#. :src: bpy.types.CyclesRenderSettings.film_transparent_roughness
msgid "Transparent Roughness Threshold"
msgstr "Transparent grovhetströskel"

#. :src: bpy.types.CyclesRenderSettings.film_transparent_roughness
msgid "For transparent transmission, keep surfaces with roughness above the threshold opaque"
msgstr ""
"För transparent transmission, håll ytor med grovhet över tröskelvärdet opaka"

#. :src: bpy.types.CyclesRenderSettings.filter_width
msgid "Pixel filter width"
msgstr "Pixel filterbredd"

#. :src: bpy.types.CyclesRenderSettings.glossy_bounces
msgid "Glossy Bounces"
msgstr "Glansiga studsar"

#. :src: bpy.types.CyclesRenderSettings.glossy_bounces
msgid "Maximum number of glossy reflection bounces, bounded by total maximum"
msgstr "Maximalt antal glansiga reflektionsstudsar, begränsat av totalt maximalt antal"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type
#: scripts/addons_core/cycles/ui.py:438
msgid "Directional Sampling Type"
msgstr "Riktad provtagningstyp"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type
msgid "Type of the directional sampling used for guiding"
msgstr "Typ av riktad provtagning som används för vägledning"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'MIS'
msgid "Diffuse Product MIS"
msgstr "Diffus produkt MIS"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'MIS'
msgid "Guided diffuse BSDF component based on the incoming light distribution and the cosine product (closed form product)"
msgstr "Guidad diffus BSDF-komponent baserad på den inkommande ljusfördelningen och cosinusprodukten (sluten formprodukt)"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'RIS'
msgid "Re-sampled Importance Sampling"
msgstr "Omprovtagning av viktighetsprovtagning"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'RIS'
msgid "Perform RIS sampling to guided based on the product of the incoming light distribution and the BSDF"
msgstr ""
"Utför RIS-sampling för att styra baserat på produkten av den inkommande "
"ljusfördelningen och BSDF"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'ROUGHNESS'
msgid "Roughness-based"
msgstr "Grovhetsbaserad"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'ROUGHNESS'
msgid "Adjust the guiding probability based on the roughness of the material components"
msgstr "Justera styrsannolikheten utifrån materialkomponenternas grovhet"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type
msgid "Guiding Distribution Type"
msgstr "Vägledande distributionstyp"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type
msgid "Type of representation for the guiding distribution"
msgstr "Typ av representation för vägledande distribution"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type:'PARALLAX_AWARE_VMM'
msgid "Parallax-Aware VMM"
msgstr "Parallaxmedveten VMM"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type:'PARALLAX_AWARE_VMM'
msgid "Use Parallax-aware von Mises-Fisher models as directional distribution"
msgstr "Använd parallaxmedvetna von Mises-Fisher-modeller som riktningsfördelning"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type:'DIRECTIONAL_QUAD_TREE'
msgid "Directional Quad Tree"
msgstr "Riktad fyrkantsträdstruktur"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type:'DIRECTIONAL_QUAD_TREE'
msgid "Use Directional Quad Trees as directional distribution"
msgstr "Använd riktade fyrkantsträd som riktad distribution"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type:'VMM'
msgid "VMM"
msgstr "VMM"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type:'VMM'
msgid "Use von Mises-Fisher models as directional distribution"
msgstr "Använd von Mises-Fisher-modeller som riktningsfördelning"

#. :src: bpy.types.CyclesRenderSettings.guiding_roughness_threshold
msgid "Guiding Roughness Threshold"
msgstr "Vägledande gränsvärde för grovhet"

#. :src: bpy.types.CyclesRenderSettings.guiding_roughness_threshold
msgid "The minimal roughness value of a material to apply guiding"
msgstr "Det minsta grovhetsvärdet för ett material som ska appliceras som vägledning"

#. :src: bpy.types.CyclesRenderSettings.guiding_training_samples
msgid "Training Samples"
msgstr "Träningsprover"

#. :src: bpy.types.CyclesRenderSettings.guiding_training_samples
msgid "The maximum number of samples used for training path guiding. Higher samples lead to more accurate guiding, however may also unnecessarily slow down rendering once guiding is accurate enough. A value of 0 will continue training until the last sample"
msgstr ""
"Det maximala antalet sampel som används för träning av vägledning. Fler "
"sampel leder till mer exakt vägledning, men kan också onödigt sakta ner "
"renderingen när vägledningen är tillräckligt exakt. Ett värde på 0 "
"fortsätter träningen tills det sista samplet"

#. :src: bpy.types.CyclesRenderSettings.light_sampling_threshold
msgid "Light Sampling Threshold"
msgstr "Ljusprovtagningströskel"

#. :src: bpy.types.CyclesRenderSettings.light_sampling_threshold
msgid "Probabilistically terminate light samples when the light contribution is below this threshold (more noise but faster rendering). Zero disables the test and never ignores lights"
msgstr ""
"Avsluta ljusprover probabilistiskt när ljusbidraget ligger under denna "
"tröskel (mer brus men snabbare rendering). Noll inaktiverar testet och "
"ignorerar aldrig ljus"

#. :src: bpy.types.CyclesRenderSettings.max_bounces
msgid "Total maximum number of bounces"
msgstr "Totalt maximalt antal studsar"

#. :src: bpy.types.CyclesRenderSettings.max_subdivisions
msgid "Max Subdivisions"
msgstr "Max antal subdivisionar"

#. :src: bpy.types.CyclesRenderSettings.max_subdivisions
msgid "Stop subdividing when this level is reached even if the dicing rate would produce finer tessellation"
msgstr ""
"Sluta dela upp när denna nivå nås, även om delningshastigheten skulle ge "
"finare tessellation"

#. :src: bpy.types.CyclesRenderSettings.min_light_bounces
msgid "Min Light Bounces"
msgstr "Min ljus studsar"

#. :src: bpy.types.CyclesRenderSettings.min_light_bounces
msgid "Minimum number of light bounces. Setting this higher reduces noise in the first bounces, but can also be less efficient for more complex geometry like curves and volumes"
msgstr ""
"Minsta antal ljusreflektioner. Om du ställer in ett högre värde minskar "
"bruset i de första reflektionerna, men det kan också bli mindre effektivt "
"för mer komplex geometri som kurvor och volymer"

#. :src: bpy.types.CyclesRenderSettings.min_transparent_bounces
msgid "Min Transparent Bounces"
msgstr "Min transparenta studsar"

#. :src: bpy.types.CyclesRenderSettings.min_transparent_bounces
msgid "Minimum number of transparent bounces. Setting this higher reduces noise in the first bounces, but can also be less efficient for more complex geometry like curves and volumes"
msgstr ""
"Minsta antal transparenta studsar. Om du ställer in ett högre värde minskar "
"bruset i de första studsarna, men det kan också bli mindre effektivt för mer "
"komplex geometri som kurvor och volymer"

#. :src: bpy.types.CyclesRenderSettings.offscreen_dicing_scale
msgid "Offscreen Dicing Scale"
msgstr "Skala för skärning utanför skärmen"

#. :src: bpy.types.CyclesRenderSettings.offscreen_dicing_scale
msgid "Multiplier for dicing rate of geometry outside of the camera view. The dicing rate of objects is gradually increased the further they are outside the camera view. Lower values provide higher quality reflections and shadows for off screen objects, while higher values use less memory"
msgstr ""
"Multiplikator för dicing-hastigheten för geometri utanför kameravyn. Dicing-"
"hastigheten för objekt ökar gradvis ju längre bort de är från kameravyn. "
"Lägre värden ger högre kvalitet på reflektioner och skuggor för objekt "
"utanför skärmen, medan högre värden använder mindre minne"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type
msgid "Pixel filter type"
msgstr "Pixel filter typ"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type:'BOX'
msgid "Box filter"
msgstr "Boxfilter"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type:'GAUSSIAN'
msgid "Gaussian filter"
msgstr "Gaussiskt filter"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type:'BLACKMAN_HARRIS'
msgid "Blackman-Harris"
msgstr "Blackman-Harris"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type:'BLACKMAN_HARRIS'
msgid "Blackman-Harris filter"
msgstr "Blackman-Harris-filter"

#. :src: bpy.types.CyclesRenderSettings.preview_adaptive_min_samples
msgid "Minimum AA samples for adaptive sampling, to discover noisy features before stopping sampling. Zero for automatic setting based on noise threshold, for viewport renders"
msgstr ""
"Minsta antal AA-prov för adaptiv provtagning, för att upptäcka störande "
"egenskaper innan provtagningen avbryts. Noll för automatisk inställning "
"baserad på brusgräns, för visningsfönsterrenderingar"

#. :src: bpy.types.CyclesRenderSettings.preview_adaptive_threshold
msgid "Noise level step to stop sampling at, lower values reduce noise at the cost of render time. Zero for automatic setting based on number of AA samples, for viewport renders"
msgstr ""
"Ljudnivå vid vilken samplingen avbryts. Lägre värden minskar ljudet på "
"bekostnad av renderings tiden. Noll för automatisk inställning baserad på "
"antalet AA-samplingar, för renderings av visningsvy"

#. :src: bpy.types.CyclesRenderSettings.preview_denoiser
msgid "Viewport Denoiser"
msgstr "Viewport-brusreducerare"

#. :src: bpy.types.CyclesRenderSettings.preview_denoiser
msgid "Denoise the image after each preview update with the selected denoiser"
msgstr "Avbrusbilden efter varje förhandsgranskningsuppdatering med den valda brusreduceraren"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes
msgid "Viewport Denoising Input Passes"
msgstr "Viewport-brusreducering av ingångspass"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter
msgid "Viewport Denoising Prefilter"
msgstr "Förfilter för brusreducering i visningsfönstret"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality
msgid "Viewport Denoising Quality"
msgstr "Kvalitet på brusreducering i visningsfönstret"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_start_sample
msgid "Start Denoising"
msgstr "Starta brusreducering"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_start_sample
msgid "Sample to start denoising the preview at"
msgstr "Exempel för att börja brusreducering av förhandsvisningen vid"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality
msgid "Viewport Denoising Upscale Quality"
msgstr "Kvalitet på brusreducering i visningsfönstret"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality
msgid "Overall upscale factor and denoising quality when using DLSS"
msgstr ""
"Övergripande uppskalningsfaktor och brusreduceringskvalitet vid användning "
"av DLSS"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'NONE'
msgid "Highest quality without upscaling"
msgstr "Högsta kvalitet utan uppskalning"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'QUALITY'
msgid "Offers higher image quality than balanced mode"
msgstr "Ger högre bildkvalitet än balanserat läge"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'BALANCED'
msgid "Offers both optimized performance and image quality"
msgstr "Ger både optimerad prestanda och bildkvalitet"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'PERFORMANCE'
msgid "Offers a higher performance boost than balanced mode"
msgstr "Ger större prestandaökning än balanserat läge"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'ULTRA_PERFORMANCE'
msgid "Ultra Performance"
msgstr "Ultraprestanda"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'ULTRA_PERFORMANCE'
msgid "Offers the highest performance boost"
msgstr "Ger den största prestandaökningen"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_use_gpu
msgid "Denoise Preview on GPU"
msgstr "Förhandsgranska brusreducering på GPU"

#. :src: bpy.types.CyclesRenderSettings.preview_dicing_rate
msgid "Viewport Dicing Rate"
msgstr "Visningsfönstrets delningsfrekvens"

#. :src: bpy.types.CyclesRenderSettings.preview_dicing_rate
msgid "Multiplier for per object adaptive subdivision size in the viewport"
msgstr "Multiplikator för adaptiv subdivisionsstorlek per objekt i visningsfönstret"

#. :src: bpy.types.CyclesRenderSettings.preview_pause
msgid "Pause Preview"
msgstr "Paus Förhandsgranska"

#. :src: bpy.types.CyclesRenderSettings.preview_pause
msgid "Deprecated, this has no effect anymore. Use RegionView3D.pause_render instead"
msgstr "Föråldrat, har inte längre någon effekt. Använd RegionView3D.pause_render i stället"

#. :src: bpy.types.CyclesRenderSettings.preview_samples
#. :src: bpy.types.SceneEEVEE.taa_samples
msgid "Viewport Samples"
msgstr "Exempel på visningsvy"

#. :src: bpy.types.CyclesRenderSettings.preview_samples
msgid "Number of samples to render in the viewport, unlimited if 0"
msgstr "Antal sampel som ska renderas i visningsfönstret, obegränsat om 0"

#. :src: bpy.types.CyclesRenderSettings.preview_scrambling_distance
msgid "Scrambling Distance viewport"
msgstr "Viewport för avståndsklassificering"

#. :src: bpy.types.CyclesRenderSettings.preview_scrambling_distance
msgid "Uses the Scrambling Distance value for the viewport. Faster but may flicker"
msgstr ""
"Använder värdet för Scrambling Distance för visningsfönstret. Snabbare men "
"kan flimra"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_duration
msgid "Rolling Shutter Duration"
msgstr "Rulljalusins varaktighet"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_duration
msgid "Scanline \"exposure\" time for the rolling shutter effect"
msgstr "Scanline \"exponeringstid\" för rullande slutareffekt"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_type
msgid "Shutter Type"
msgstr "Slutartyp"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_type
msgid "Type of rolling shutter effect matching CMOS-based cameras"
msgstr "Typ av rulljalusieffekt som matchar CMOS-baserade kameror"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_type:'NONE'
msgid "No rolling shutter effect used"
msgstr "Ingen rullande slutareffekt används"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_type:'TOP'
msgid "Sensor is being scanned from top to bottom"
msgstr "Sensorn skannas från topp till botten"

#. :src: bpy.types.CyclesRenderSettings.sample_clamp_direct
msgid "If non-zero, the maximum value for a direct sample, higher values will be scaled down to avoid too much noise and slow convergence at the cost of accuracy"
msgstr ""
"Om värdet är större än noll, det maximala värdet för ett direktprov, kommer "
"högre värden att skalas ned för att undvika för mycket brus och långsam "
"konvergens på bekostnad av noggrannheten"

#. :src: bpy.types.CyclesRenderSettings.sample_clamp_indirect
msgid "If non-zero, the maximum value for an indirect sample, higher values will be scaled down to avoid too much noise and slow convergence at the cost of accuracy"
msgstr ""
"Om värdet är större än noll, det maximala värdet för ett indirekt prov, "
"kommer högre värden att skalas ned för att undvika för mycket brus och "
"långsam konvergens på bekostnad av noggrannheten"

#. :src: bpy.types.CyclesRenderSettings.sample_offset
msgid "Sample Subset Offset"
msgstr "Exempel på delmängd Offset"

#. :src: bpy.types.CyclesRenderSettings.sample_offset
msgid "0-based index of sample to start rendering from"
msgstr "0-baserat index för prov att börja rendera från"

#. :src: bpy.types.CyclesRenderSettings.sample_subset_length
msgid "Sample Subset Length"
msgstr "Längd på delmängd av prov"

#. :src: bpy.types.CyclesRenderSettings.sample_subset_length
msgid "The number of samples to render in this subset"
msgstr "Antalet sampel som ska renderas i denna delmängd"

#. :src: bpy.types.CyclesRenderSettings.samples
msgid "Number of samples to render for each pixel"
msgstr "Antal sampel som ska renderas för varje pixel"

#. :src: bpy.types.CyclesRenderSettings.sampling_pattern
msgid "Sampling Pattern"
msgstr "Provtagningsmönster"

#. :src: bpy.types.CyclesRenderSettings.sampling_pattern
msgid "Random sampling pattern used by the integrator"
msgstr "Slumpmässigt urvalsmönster som används av integratorn"

#. :src: bpy.types.CyclesRenderSettings.scrambling_distance
#: scripts/addons_core/cycles/ui.py:481
msgid "Scrambling Distance"
msgstr "Krypteringsavstånd"

#. :src: bpy.types.CyclesRenderSettings.scrambling_distance
msgid "Reduce randomization between pixels to improve GPU rendering performance, at the cost of possible rendering artifacts if set too low"
msgstr ""
"Minska slumpmässigheten mellan pixlar för att förbättra GPU-renderingens "
"prestanda, på bekostnad av möjliga renderingsartefakter om inställningen är "
"för låg"

#. :src: bpy.types.CyclesRenderSettings.seed
msgid "Seed value for integrator to get different noise patterns"
msgstr "Frövärde för integratorn för att få olika brusmönster"

#. :src: bpy.types.CyclesRenderSettings.shading_system
msgid "Use Open Shading Language"
msgstr "Använd Open Shading Language"

#. :src: bpy.types.CyclesRenderSettings.surface_guiding_probability
msgid "Surface Guiding Probability"
msgstr "Ytstyrningssannolikhet"

#. :src: bpy.types.CyclesRenderSettings.surface_guiding_probability
msgid "The probability of guiding a direction on a surface"
msgstr "Sannolikheten för att styra en riktning på en yta"

#. :src: bpy.types.CyclesRenderSettings.texture_limit
msgid "Viewport Texture Limit"
msgstr "Texturgräns för vyport"

#. :src: bpy.types.CyclesRenderSettings.texture_limit
msgid "Limit texture size used by viewport rendering"
msgstr "Begränsa texturstorleken som används vid rendering i vyporten"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'OFF'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'OFF'
msgid "No Limit"
msgstr "Ingen gräns"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'OFF'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'OFF'
msgid "No texture size limit"
msgstr "Ingen begränsning av texturstorlek"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'128'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'128'
msgid "Limit texture size to 128 pixels"
msgstr "Begränsa texturstorleken till 128 bildpunkter"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'256'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'256'
msgid "Limit texture size to 256 pixels"
msgstr "Begränsa texturstorleken till 256 bildpunkter"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'512'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'512'
msgid "Limit texture size to 512 pixels"
msgstr "Begränsa texturstorleken till 512 bildpunkter"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'1024'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'1024'
msgid "Limit texture size to 1024 pixels"
msgstr "Begränsa texturstorleken till 1024 bildpunkter"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'2048'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'2048'
msgid "Limit texture size to 2048 pixels"
msgstr "Begränsa texturstorleken till 2048 bildpunkter"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'4096'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'4096'
msgid "Limit texture size to 4096 pixels"
msgstr "Begränsa texturstorleken till 4096 bildpunkter"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'8192'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'8192'
msgid "Limit texture size to 8192 pixels"
msgstr "Begränsa texturstorleken till 8192 bildpunkter"

#. :src: bpy.types.CyclesRenderSettings.texture_limit_render
msgid "Render Texture Limit"
msgstr "Renderingsgräns för texturer"

#. :src: bpy.types.CyclesRenderSettings.texture_limit_render
msgid "Limit texture size used by final rendering"
msgstr "Begränsa texturstorleken som används vid slutrendering"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution
msgid "Viewport Texture Resolution"
msgstr "Texturupplösning i visningsfönstret"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution
msgid "Scale factor for texture resolution used by viewport rendering"
msgstr "Skalfaktor för texturupplösningen som används vid rendering i vyporten"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution_render
msgid "Render Texture Resolution"
msgstr "Renderingsupplösning för texturer"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution_render
msgid "Scale factor for texture resolution used by final rendering"
msgstr "Skalfaktor för texturupplösningen som används vid slutrendering"

#. :src: bpy.types.CyclesRenderSettings.tile_size
msgid "Tile Size"
msgstr "Rutstorlek"

#. :src: bpy.types.CyclesRenderSettings.tile_size
msgid "Render high resolution images in tiles of this size, to reduce memory usage. Tiles are cached to disk while rendering to save memory"
msgstr ""
"Rendera högupplösta bilder i rutor av denna storlek för att minska "
"minnesanvändningen. Rutorna cachelagras på disken under renderingen för att "
"spara minne"

#. :src: bpy.types.CyclesRenderSettings.time_limit
msgid "Limit the render time (excluding synchronization time). Zero disables the limit"
msgstr ""
"Begränsa renderningstiden (exklusive synkroniseringstid). Noll inaktiverar "
"begränsningen"

#. :src: bpy.types.CyclesRenderSettings.transmission_bounces
msgid "Transmission Bounces"
msgstr "Överföringsstudsar"

#. :src: bpy.types.CyclesRenderSettings.transmission_bounces
msgid "Maximum number of transmission bounces, bounded by total maximum"
msgstr "Maximalt antal överföringsstudsar, begränsat av totalt maximalt antal"

#. :src: bpy.types.CyclesRenderSettings.transparent_max_bounces
msgid "Transparent Max Bounces"
msgstr "Transparent Max studsar"

#. :src: bpy.types.CyclesRenderSettings.transparent_max_bounces
msgid "Maximum number of transparent bounces. This is independent of maximum number of other bounces"
msgstr ""
"Maximalt antal transparenta studsar. Detta är oberoende av maximalt antal "
"andra studsar"

#. :src: bpy.types.CyclesRenderSettings.use_adaptive_sampling
#. :src: bpy.types.CyclesRenderSettings.use_preview_adaptive_sampling
msgid "Use Adaptive Sampling"
msgstr "Använd adaptiv sampling"

#. :src: bpy.types.CyclesRenderSettings.use_adaptive_sampling
msgid "Automatically reduce the number of samples per pixel based on estimated noise level"
msgstr ""
"Minska automatiskt antalet sampel per pixel baserat på uppskattad brusnivå"

#. :src: bpy.types.CyclesRenderSettings.use_animated_seed
msgid "Use Animated Seed"
msgstr "Använd animerat frö"

#. :src: bpy.types.CyclesRenderSettings.use_animated_seed
msgid "Use different seed values (and hence noise patterns) at different frames"
msgstr ""
"Använd olika startvärden (och därmed olika brusmönster) vid olika bildrutor"

#. :src: bpy.types.CyclesRenderSettings.use_auto_tile
msgid "Auto Tile"
msgstr "Auto Kakel"

#. :src: bpy.types.CyclesRenderSettings.use_auto_tile
msgid "Deprecated, tiling is always enabled"
msgstr "Föråldrat, kakel är alltid aktiverat"

#. :src: bpy.types.CyclesRenderSettings.use_camera_cull
msgid "Allow objects to be culled based on the camera frustum"
msgstr "Tillåt att objekt gallras bort baserat på kamerans frustum"

#. :src: bpy.types.CyclesRenderSettings.use_deterministic_guiding
msgid "Deterministic"
msgstr "Deterministisk"

#. :src: bpy.types.CyclesRenderSettings.use_deterministic_guiding
msgid "Makes path guiding deterministic which means renderings will be reproducible with the same pixel values every time. This feature slows down training"
msgstr ""
"Gör vägledningen deterministisk, vilket innebär att renderingarna blir "
"reproducerbara med samma pixelvärden varje gång. Denna funktion saktar ner "
"träningen"

#. :src: bpy.types.CyclesRenderSettings.use_distance_cull
msgid "Allow objects to be culled based on the distance from camera"
msgstr "Tillåt att objekt gallras bort baserat på avståndet från kameran"

#. :src: bpy.types.CyclesRenderSettings.use_fast_gi
msgid "Approximate diffuse indirect light with background tinted ambient occlusion. This provides fast alternative to full global illumination, for interactive viewport rendering or final renders with reduced quality"
msgstr ""
"Ungefärligt diffust indirekt ljus med bakgrundsfärgad omgivande ocklusion. "
"Detta ger ett snabbt alternativ till fullständig global belysning, för "
"interaktiv vyportrendering eller slutliga renderingar med reducerad kvalitet"

#. :src: bpy.types.CyclesRenderSettings.use_guiding
msgid "Guiding"
msgstr "Vägledning"

#. :src: bpy.types.CyclesRenderSettings.use_guiding
msgid "Use path guiding for sampling paths. Path guiding incrementally learns the light distribution of the scene and guides path into directions with high direct and indirect light contributions"
msgstr ""
"Använd vägledning för provtagningsvägar. Vägledningen lär sig stegvis "
"ljusfördelningen i scenen och leder vägen i riktningar med hög direkt och "
"indirekt ljusinsats"

#. :src: bpy.types.CyclesRenderSettings.use_guiding_direct_light
msgid "Guide Direct Light"
msgstr "Guide Direkt ljus"

#. :src: bpy.types.CyclesRenderSettings.use_guiding_direct_light
msgid "Consider the contribution of directly visible light sources during guiding"
msgstr "Beakta bidraget från direkt synliga ljuskällor under guidningen"

#. :src: bpy.types.CyclesRenderSettings.use_guiding_mis_weights
msgid "Use MIS Weights"
msgstr "Använd MIS-vikter"

#. :src: bpy.types.CyclesRenderSettings.use_guiding_mis_weights
msgid "Use the MIS weight to weight the contribution of directly visible light sources during guiding"
msgstr ""
"Använd MIS-vikten för att väga bidraget från direkt synliga ljuskällor under "
"guidning"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples
msgid "Layer Samples"
msgstr "Lagerskikt"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples
msgid "How to use per view layer sample settings"
msgstr "Hur man använder exempelinställningar per visningslager"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples:'USE'
msgid "Per render layer number of samples override scene samples"
msgstr "Per renderlager antal sampel åsidosätter scenprover"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples:'BOUNDED'
msgid "Bounded"
msgstr "Begränsad"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples:'BOUNDED'
msgid "Bound per render layer number of samples by global samples"
msgstr "Begränsad per renderingslager antal sampel per globala sampel"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples:'IGNORE'
msgid "Ignore per render layer number of samples"
msgstr "Ignorera antal sampel per renderingslager"

#. :src: bpy.types.CyclesRenderSettings.use_light_tree
msgid "Light Tree"
msgstr "Ljusträd"

#. :src: bpy.types.CyclesRenderSettings.use_light_tree
msgid "Sample multiple lights more efficiently based on estimated contribution at every shading point"
msgstr "Prova flera ljus mer effektivt baserat på uppskattat bidrag vid varje skuggpunkt"

#. :src: bpy.types.CyclesRenderSettings.use_pixel_jitter
msgid "Use Pixel Jitter"
msgstr "Använd pixeljitter"

#. :src: bpy.types.CyclesRenderSettings.use_preview_adaptive_sampling
msgid "Automatically reduce the number of samples per pixel based on estimated noise level, for viewport renders"
msgstr ""
"Minska automatiskt antalet sampel per pixel baserat på uppskattad brusnivå "
"för visningsfönsterrenderingar"

#. :src: bpy.types.CyclesRenderSettings.use_preview_denoising
msgid "Use Viewport Denoising"
msgstr "Använd Viewport Denoising"

#. :src: bpy.types.CyclesRenderSettings.use_preview_denoising
msgid "Denoise the image in the 3D viewport"
msgstr "Brusreducering av bilden i 3D-vyfönstret"

#. :src: bpy.types.CyclesRenderSettings.use_sample_subset
msgid "Use Sample Subset"
msgstr "Använd provundergrupp"

#. :src: bpy.types.CyclesRenderSettings.use_sample_subset
msgid "Render a subset of the specified max samples. Typically used for distributed rendering across multiple devices"
msgstr ""
"Rendera en delmängd av de angivna maximala proverna. Används vanligtvis för "
"distribuerad rendering över flera enheter"

#. :src: bpy.types.CyclesRenderSettings.use_surface_guiding
msgid "Surface Guiding"
msgstr "Ytstyrning"

#. :src: bpy.types.CyclesRenderSettings.use_surface_guiding
msgid "Use guiding when sampling directions on a surface"
msgstr "Använd vägledning när du provtar riktningar på en yta"

#. :src: bpy.types.CyclesRenderSettings.use_volume_guiding
msgid "Volume Guiding"
msgstr "Volymstyrning"

#. :src: bpy.types.CyclesRenderSettings.use_volume_guiding
msgid "Use guiding when sampling directions inside a volume"
msgstr "Använd vägledning när du samplar riktningar inuti en volym"

#. :src: bpy.types.CyclesRenderSettings.volume_biased
#: scripts/addons_core/cycles/ui.py:609
msgid "Biased"
msgstr "Partisk"

#. :src: bpy.types.CyclesRenderSettings.volume_biased
msgid "Default volume rendering uses null scattering, which is unbiased and has less artifacts, but could be noisier. Biased option uses ray marching, with controls for steps size and max steps"
msgstr ""
"Standardvolymrendering använder nollspridning, vilket är opartiskt och har "
"färre artefakter, men kan vara mer brusigt. Det partiska alternativet "
"använder strålmarschering, med kontroller för stegstorlek och maximalt antal "
"steg"

#. :src: bpy.types.CyclesRenderSettings.volume_bounces
msgid "Volume Bounces"
msgstr "Volymstudsar"

#. :src: bpy.types.CyclesRenderSettings.volume_bounces
msgid "Maximum number of volumetric scattering events"
msgstr "Maximalt antal volymetriska spridningshändelser"

#. :src: bpy.types.CyclesRenderSettings.volume_guiding_probability
msgid "Volume Guiding Probability"
msgstr "Volymstyrande sannolikhet"

#. :src: bpy.types.CyclesRenderSettings.volume_guiding_probability
msgid "The probability of guiding a direction inside a volume"
msgstr "Sannolikheten för att styra en riktning inuti en volym"

#. :src: bpy.types.CyclesRenderSettings.volume_max_steps
#: scripts/addons_core/cycles/ui.py:614
msgid "Max Steps"
msgstr "Max antal steg"

#. :src: bpy.types.CyclesRenderSettings.volume_max_steps
msgid "Maximum number of steps through the volume before giving up, to avoid extremely long render times with big objects or small step sizes"
msgstr ""
"Maximalt antal steg genom volymen innan man ger upp, för att undvika extremt "
"långa rendertider med stora objekt eller små stegstorlekar"

#. :src: bpy.types.CyclesRenderSettings.volume_preview_step_rate
#. :src: bpy.types.CyclesRenderSettings.volume_step_rate
msgid "Globally adjust detail for volume rendering, on top of automatically estimated step size. Higher values reduce render time, lower values render with more detail"
msgstr ""
"Justera detaljerna för volymrendering globalt, utöver automatiskt uppskattad "
"stegstorlek. Högre värden minskar renderningstiden, lägre värden renderar "
"med mer detaljer"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass
msgid "Render pass to show in the 3D Viewport"
msgstr "Rendera pass för visning i 3D-vyfönstret"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'COMBINED'
msgid "Show the Combined Render pass"
msgstr "Visa det kombinerade renderingspasset"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'EMISSION'
msgid "Show the Emission render pass"
msgstr "Visa renderingspasset för utsläpp"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'BACKGROUND'
msgid "Show the Background render pass"
msgstr "Visa bakgrundsrendering"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'AO'
msgid "Show the Ambient Occlusion render pass"
msgstr "Visa renderingspasset för omgivande ocklusion"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'SHADOW_CATCHER'
msgid "Show the Shadow Catcher render pass"
msgstr "Visa Shadow Catcher-renderingpasset"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_DIRECT'
#. :src: bpy.types.RenderLayer.use_pass_diffuse_direct
#. :src: bpy.types.ViewLayer.use_pass_diffuse_direct
#: scripts/addons_core/cycles/engine.py:206
msgid "Diffuse Direct"
msgstr "Diffus direkt"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_DIRECT'
msgid "Show the Diffuse Direct render pass"
msgstr "Visa renderingspasset Diffuse Direct"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_INDIRECT'
#. :src: bpy.types.RenderLayer.use_pass_diffuse_indirect
#. :src: bpy.types.ViewLayer.use_pass_diffuse_indirect
#: scripts/addons_core/cycles/engine.py:207
msgid "Diffuse Indirect"
msgstr "Diffus indirekt"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_INDIRECT'
msgid "Show the Diffuse Indirect render pass"
msgstr "Visa diffus indirekt renderingspass"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_COLOR'
msgid "Show the Diffuse Color render pass"
msgstr "Visa renderingspasset Diffuse Color"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_DIRECT'
#. :src: bpy.types.RenderLayer.use_pass_glossy_direct
#. :src: bpy.types.ViewLayer.use_pass_glossy_direct
#: scripts/addons_core/cycles/engine.py:209
msgid "Glossy Direct"
msgstr "Glänsande direkt"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_DIRECT'
msgid "Show the Glossy Direct render pass"
msgstr "Visa Glossy Direct-rendering"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_INDIRECT'
#. :src: bpy.types.RenderLayer.use_pass_glossy_indirect
#. :src: bpy.types.ViewLayer.use_pass_glossy_indirect
#: scripts/addons_core/cycles/engine.py:210
msgid "Glossy Indirect"
msgstr "Glansig indirekt"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_INDIRECT'
msgid "Show the Glossy Indirect render pass"
msgstr "Visa den glansiga indirekta renderingspasset"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_COLOR'
#. :src: bpy.types.RenderLayer.use_pass_glossy_color
#. :src: bpy.types.ViewLayer.use_pass_glossy_color
#: scripts/addons_core/cycles/engine.py:211
#: source/blender/nodes/shader/nodes/node_shader_light_accumulation.cc:32
msgid "Glossy Color"
msgstr "Glansig färg"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_COLOR'
msgid "Show the Glossy Color render pass"
msgstr "Visa renderingspasset Glossy Color"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_DIRECT'
#. :src: bpy.types.RenderLayer.use_pass_transmission_direct
#. :src: bpy.types.ViewLayer.use_pass_transmission_direct
#: scripts/addons_core/cycles/engine.py:212
msgid "Transmission Direct"
msgstr "Direkt överföring"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_DIRECT'
msgid "Show the Transmission Direct render pass"
msgstr "Visa direkt renderingspasset för Transmission"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_INDIRECT'
#. :src: bpy.types.RenderLayer.use_pass_transmission_indirect
#. :src: bpy.types.ViewLayer.use_pass_transmission_indirect
#: scripts/addons_core/cycles/engine.py:213
msgid "Transmission Indirect"
msgstr "Indirekt överföring"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_INDIRECT'
msgid "Show the Transmission Indirect render pass"
msgstr "Visa överföringen Indirekt renderingspass"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_COLOR'
#. :src: bpy.types.RenderLayer.use_pass_transmission_color
#. :src: bpy.types.ViewLayer.use_pass_transmission_color
#: scripts/addons_core/cycles/engine.py:214
#: source/blender/nodes/shader/nodes/node_shader_light_accumulation.cc:38
