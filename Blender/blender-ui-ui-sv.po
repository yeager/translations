#. :src: bpy.types.FunctionNodeBitMath
msgid "Bit Math"
msgstr "Bitmatematik"

#. :src: bpy.types.FunctionNodeBitMath
msgid "Perform bitwise operations on 32-bit integers"
msgstr "Utför bitvisa operationer på 32-bitars heltal"

#. :src: bpy.types.FunctionNodeBitMath.operation:'AND'
#. :src: bpy.types.FunctionNodeBooleanMath.operation:'AND'
msgid "And"
msgstr "Och"

#. :src: bpy.types.FunctionNodeBitMath.operation:'AND'
msgid "Returns a value where the bits of A and B are both set"
msgstr "Returnerar ett värde där bitarna i både A och B är satta"

#. :src: bpy.types.FunctionNodeBitMath.operation:'OR'
#. :src: bpy.types.FunctionNodeBooleanMath.operation:'OR'
msgid "Or"
msgstr "Eller"

#. :src: bpy.types.FunctionNodeBitMath.operation:'OR'
msgid "Returns a value where the bits of either A or B are set"
msgstr "Returnerar ett värde där bitarna i antingen A eller B är satta"

#. :src: bpy.types.FunctionNodeBitMath.operation:'XOR'
msgid "Exclusive Or"
msgstr "Exklusiv eller"

#. :src: bpy.types.FunctionNodeBitMath.operation:'XOR'
msgid "Returns a value where only one bit from A and B is set"
msgstr "Returnerar ett värde där endast en av bitarna i A och B är satt"

#. :src: bpy.types.FunctionNodeBitMath.operation:'NOT'
#. :src: bpy.types.FunctionNodeBooleanMath.operation:'NOT'
#: source/blender/nodes/composite/nodes/node_composite_box_mask.cc:25
#: source/blender/nodes/composite/nodes/node_composite_ellipse_mask.cc:23
msgid "Not"
msgstr "Inte"

#. :src: bpy.types.FunctionNodeBitMath.operation:'NOT'
msgid "Returns the opposite bit value of A, in decimal it is equivalent of A = -A - 1"
msgstr ""
"Returnerar det inverterade bitvärdet för A; i decimalform motsvarar det A = -"
"A - 1"

#. :src: bpy.types.FunctionNodeBitMath.operation:'SHIFT'
msgid "Shifts the bit values of A by the specified Shift amount. Positive values shift left, negative values shift right."
msgstr "Skiftar bitvärdena för A med det angivna skiftvärdet. Positiva värden skiftas åt vänster, negativa värden skiftas åt höger."

#. :src: bpy.types.FunctionNodeBitMath.operation:'ROTATE'
msgid "Rotates the bit values of A by the specified Shift amount. Positive values rotate left, negative values rotate right."
msgstr "Roterar bitvärdena för A med det angivna skiftvärdet. Positiva värden roterar åt vänster, negativa värden roterar åt höger."

#. :src: bpy.types.FunctionNodeBooleanMath
msgid "Boolean Math"
msgstr "Boolesk matematik"

