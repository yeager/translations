msgstr "Konvertera en svartkroppstemperatur till ett RGB-värde"

#. :src: bpy.types.ShaderNodeBrightContrast
msgid "Control the brightness and contrast of the input color"
msgstr "Kontrollera ljusstyrkan och kontrasten för ingångsfärgen"

#. :src: bpy.types.ShaderNodeBsdfAnisotropic
msgid "Glossy BSDF"
msgstr "Glansig BSDF"

#. :src: bpy.types.ShaderNodeBsdfAnisotropic
msgid "Reflection with microfacet distribution, used for materials such as metal or mirrors"
msgstr "Reflektion med mikrofacettfördelning, används för material som metall eller speglar"

#. :src: bpy.types.ShaderNodeBsdfAnisotropic.distribution
