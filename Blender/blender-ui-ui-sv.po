msgstr "Färg som kodar normalkartan i det angivna utrymmet"

#: source/blender/nodes/shader/nodes/node_shader_output_linestyle.cc:20
msgid "Color Fac"
msgstr "Färg Fac"

#: source/blender/nodes/shader/nodes/node_shader_output_linestyle.cc:30
msgid "Alpha Fac"
msgstr "Alfa Fac"

#: source/blender/nodes/shader/nodes/node_shader_particle_info.cc:18
