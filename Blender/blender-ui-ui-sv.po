#: source/blender/nodes/shader/nodes/node_shader_map_range.cc:174
#: source/blender/nodes/shader/nodes/node_shader_map_range.cc:48
#: source/blender/nodes/shader/nodes/node_shader_mix.cc:228
#: source/blender/nodes/shader/nodes/node_shader_mix.cc:105
#: source/blender/nodes/shader/nodes/node_shader_mix.cc:106
