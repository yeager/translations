msgstr "Spara tillfälliga filer automatiskt"

#. :src: bpy.types.PreferencesFilePaths.use_auto_save_temporary_files
msgid ""
"Automatic saving of temporary files in temp directory, uses process ID.\n"
"Warning: Sculpt and edit mode data won't be saved"
msgstr ""
"Automatisk sparning av temporära filer i tempkatalogen; använder process-"
"ID:t.\n"
"Varning: Data i skulpterings- och redigeringsläget sparas inte"

