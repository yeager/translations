msgstr "Svart kroppsfärg"

#: source/blender/nodes/shader/nodes/node_shader_volume_principled.cc:54
msgid "Temperature Attribute"
msgstr "Temperaturattribut"

#: source/blender/nodes/texture/node_texture_tree.cc:89
