msgstr "Streck"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:296
msgid "Ghost"
msgstr "Spöke"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:298
#: source/blender/nodes/composite/nodes/node_composite_glare.cc:54
msgid "Sun Beams"
msgstr "Solstrålar"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:50
msgid "Ghosts"
msgstr "Spöken"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:176
msgid "Streaks Angle"
msgstr "Streaks Vinkel"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:197
msgid "Color Modulation"
msgstr "Färgmodulering"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:208
msgid "Sun Position"
msgstr "Solens position"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:97
msgid "The image with the generated glare added"
msgstr "Bilden med den genererade bländningen tillagd"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:102
msgid "The generated glare"
msgstr "Den genererade bländningen"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:105
msgid "The extracted highlights from which the glare was generated"
msgstr "De extraherade höjdpunkterna från vilka bländningen genererades"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:120
msgid "The brightness level at which pixels are considered part of the highlights that produce a glare"
msgstr ""
"Den ljusstyrka vid vilken pixlar betraktas som en del av de höjdpunkter som "
"ger bländning"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:128
msgid "The smoothness of the extracted highlights"
msgstr "Jämnheten hos de extraherade höjdpunkterna"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:135
msgid "Clamp bright highlights"
msgstr "Klämma ljusa höjdpunkter"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:139
msgid "Clamp bright highlights such that their brightness are not larger than this value"
msgstr ""
"Krama ljusa höjdpunkter så att deras ljusstyrka inte överstiger detta värde"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:148
msgid "Adjusts the brightness of the glare"
msgstr "Justerar bländningens ljusstyrka"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:154
msgid "Adjusts the saturation of the glare"
msgstr "Justerar bländningens mättnad"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:157
msgid "Tints the glare. Consider desaturating the glare to more accurate tinting"
msgstr ""
"Toner glansen. Överväg att minska glansen för att få en mer exakt toning"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:167
msgid "The size of the glare relative to the image. 1 means the glare covers the entire image, 0.5 means the glare covers half the image, and so on"
msgstr ""
"Storleken på bländningen i förhållande till bilden. 1 betyder att "
"bländningen täcker hela bilden, 0,5 betyder att bländningen täcker halva "
"bilden, och så vidare"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:175
msgid "The number of streaks"
msgstr "Antalet streck"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:180
msgid "The angle that the first streak makes with the horizontal axis"
msgstr "Vinkeln som den första strecken bildar med den horisontella axeln"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:187
msgid "The number of ghosts for Ghost glare or the quality and spread of Glare for Streaks and Simple Star"
msgstr "Antalet spöken för Ghost glare eller kvaliteten och spridningen av Glare för Streaks och Simple Star"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:196
msgid "Streak fade-out factor"
msgstr "Streak-uttoningsfaktor"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:203
msgid "Modulates colors of streaks and ghosts for a spectral dispersion effect"
msgstr "Modulerar färgerna på strimmor och spökbilder för en spektral dispersionseffekt"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:207
msgid "Align the star diagonally"
msgstr "Rikta in stjärnan diagonalt"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:215
msgid "The position of the source of the rays in normalized coordinates. 0 means lower left corner and 1 means upper right corner"
msgstr ""
"Strålningens källas position i normaliserade koordinater. 0 betyder nedre "
"vänstra hörnet och 1 betyder övre högra hörnet"

#: source/blender/nodes/composite/nodes/node_composite_glare.cc:224
msgid "The amount of jitter to introduce while computing rays, higher jitter can be faster but can produce grainy or noisy results"
msgstr ""
"Mängden jitter som ska införas vid beräkning av strålar. Högre jitter kan "
"vara snabbare men kan ge korniga eller brusiga resultat"

#: source/blender/nodes/composite/nodes/node_composite_hue_saturation_value.cc:39
#: source/blender/nodes/shader/nodes/node_shader_ies_light.cc:23
#: source/blender/nodes/texture/nodes/node_texture_valToRgb.cc:17
msgid "Fac"
msgstr "Faktor"

#: source/blender/nodes/composite/nodes/node_composite_id_mask.cc:21
msgid "ID value"
msgstr "ID-värde"

#: source/blender/nodes/composite/nodes/node_composite_image_coordinates.cc:20
msgid "Zero centered coordinates normalizes along the larger dimension for uniform scaling"
msgstr ""
"Nollcentrerade koordinater normaliseras längs den större dimensionen för "
"enhetlig skalning"

#: source/blender/nodes/composite/nodes/node_composite_image_coordinates.cc:25
msgid "Normalized coordinates with half pixel offsets"
msgstr "Normaliserade koordinater med halvpixelavvikelser"

#: source/blender/nodes/composite/nodes/node_composite_image_coordinates.cc:29
msgid "Integer pixel coordinates"
msgstr "Heltals-pixelkoordinater"

#: source/blender/nodes/composite/nodes/node_composite_image_info.cc:24
msgid "The dimensions of the image in pixels with transformations applied"
msgstr "Bildens dimensioner i pixlar med tillämpade transformationer"

#: source/blender/nodes/composite/nodes/node_composite_image_info.cc:27
msgid "The original resolution of the image in pixels before any transformations"
msgstr "Bildens ursprungliga upplösning i pixlar före eventuella transformationer"

#: source/blender/nodes/composite/nodes/node_composite_inpaint.cc:33
msgid "The size of the inpaint in pixels"
msgstr "Storleken på inpaint i pixlar"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:46
#: source/blender/nodes/composite/nodes/node_composite_keying.cc:123
msgid "Blur Size"
msgstr "Oskärpningsstorlek"

#. :src: Socket name from node group Split Toning, file compositing_nodes_essentials.blend
#: source/blender/nodes/composite/nodes/node_composite_keying.cc:57
#: source/blender/nodes/composite/nodes/node_composite_keying.cc:154
#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:62
msgid "Balance"
msgstr "Balans"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:106
msgid "Garbage Matte"
msgstr "Sopmatta"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:113
msgid "Core Matte"
msgstr "Kärnmatta"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:128
msgid "Dilate Size"
msgstr "Expanderad storlek"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:134
msgid "Feather Size"
msgstr "Fjäderstorlek"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:141
msgid "Despill Strength"
msgstr "Despill-styrka"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:141
msgctxt "Curve"
msgid "Feather Falloff"
msgstr "Fjäderfall"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:37
#: source/blender/nodes/composite/nodes/node_composite_keying.cc:85
msgctxt "Image"
msgid "Edges"
msgstr "Kanter"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:50
msgid "Blur the color of the input image in YCC color space before keying while leaving the luminance intact using a Gaussian blur of the given size"
msgstr ""
"Sudda ut färgen på den inmatade bilden i YCC-färgrymden före keying, "
"samtidigt som luminansen lämnas intakt, med hjälp av en gaussisk suddning av "
"given storlek"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:62
msgid "Balances between the two non primary color channels that the primary channel compares against. 0 means the latter channel of the two is used, while 1 means the former of the two is used"
msgstr ""
"Balans mellan de två icke-primära färgkanalerna som den primära kanalen "
"jämförs med. 0 betyder att den senare av de två kanalerna används, medan 1 "
"betyder att den förra av de två används"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:73
msgid "The matte gets remapped such matte values lower than the black level become black. Pixels at the identified edges are excluded from the remapping to preserve details"
msgstr ""
"Mattan ommappas så att mattvärden som är lägre än svartnivån blir svarta. "
"Pixlar vid de identifierade kanterna undantas från ommappningen för att "
"bevara detaljerna"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:81
msgid "The matte gets remapped such matte values higher than the white level become white. Pixels at the identified edges are excluded from the remapping to preserve details"
msgstr ""
"Mattan ommappas så att mattvärden som är högre än vitnivån blir vita. Pixlar "
"vid de identifierade kanterna undantas från ommappningen för att bevara "
"detaljerna"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:92
msgid "Size of the search window used to identify edges. Higher search size corresponds to less noisy and higher quality edges, not necessarily bigger edges. Edge tolerance can be used to expend the size of the edges"
msgstr ""
"Storleken på sökfönstret som används för att identifiera kanter. En större "
"sökstorlek motsvarar mindre brus och kanter av högre kvalitet, inte "
"nödvändigtvis större kanter. Kanttolerans kan användas för att utöka "
"storleken på kanterna"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:101
msgid "Pixels are considered part of the edges if more than 10% of the neighbouring pixels have matte values that differ from the pixel's matte value by this tolerance"
msgstr ""
"Pixlar betraktas som en del av kanterna om mer än 10% of av de angränsande "
"pixlarna har mattvärden som skiljer sig från pixelens mattvärde med denna "
"tolerans"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:112
msgid "Areas in the garbage matte mask are excluded from the matte"
msgstr "Områden i skräpmatta-masken exkluderas från matta"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:119
msgid "Areas in the core matte mask are included in the matte"
msgstr "Områden i den centrala matta masken ingår i matta"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:127
msgid "Blur the computed matte using a Gaussian blur of the given size"
msgstr ""
"Sudda ut den beräknade mattan med en gaussisk suddning av angiven storlek"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:131
msgid "Dilate or erode the computed matte using a circular structuring element of the specified size. Negative sizes means erosion while positive means dilation"
msgstr ""
"Expandera eller erodera den beräknade mattan med hjälp av ett cirkulärt "
"struktureringselement av angiven storlek. Negativa storlekar innebär "
"erosion, medan positiva storlekar innebär expansion"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:137
msgid "Dilate or erode the computed matte using an inverse distance operation evaluated at the given falloff of the specified size. Negative sizes means erosion while positive means dilation"
msgstr ""
"Expandera eller erodera den beräknade mattan med hjälp av en invers "
"avståndsoperation som utvärderas vid den angivna avklingningen av den "
"specificerade storleken. Negativa storlekar innebär erosion medan positiva "
"innebär expansion"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:153
msgid "Specifies the strength of the despill"
msgstr "Anger styrkan på despill"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:159
msgid "Defines the channel used for despill limiting. Balances between the two non primary color channels that the primary channel compares against. 0 means the latter channel of the two is used, while 1 means the former of the two is used"
msgstr ""
"Definierar kanalen som används för despillbegränsning. Balanserar mellan de "
"två icke-primära färgkanalerna som den primära kanalen jämför med. 0 betyder "
"att den senare av de två kanalerna används, medan 1 betyder att den förra av "
"de två används"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:45
msgid "Preprocess"
msgstr "Förbehandling"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:122
msgid "Postprocess"
msgstr "Efterbearbetning"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:147
msgid "Despill"
msgstr "Despill"

#: source/blender/nodes/composite/nodes/node_composite_keying.cc:54
msgctxt "NodeTree"
msgid "Key"
msgstr "Nyckel"

#: source/blender/nodes/composite/nodes/node_composite_keying_screen.cc:40
msgid "Specifies the smoothness of the keying screen"
msgstr "Anger hur jämn nyckelskärmen ska vara"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:28
msgid "Fast but less accurate variation"
msgstr "Snabb men mindre exakt variant"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:33
msgid "Accurate but slower variation"
msgstr "Noggrann men långsammare variation"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:60
msgid "Uniformity"
msgstr "Enhetlighet"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:76
msgid "Eccentricity"
msgstr "Excentricitet"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:85
msgid "High Precision"
msgstr "Hög precision"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:53
msgid "The size of the filter in pixels"
msgstr "Filterstorleken i pixlar"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:64
msgid "Controls the uniformity of the direction of the filter. Higher values produces more uniform directions"
msgstr ""
"Kontrollerar enhetligheten i filterriktningen. Högre värden ger mer "
"enhetliga riktningar"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:73
msgid "Controls the sharpness of the filter. 0 means completely smooth while 1 means completely sharp"
msgstr "Styr filterets skärpa. 0 betyder helt jämnt medan 1 betyder helt skarpt"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:82
msgid "Controls how directional the filter is. 0 means the filter is completely omnidirectional while 2 means it is maximally directed along the edges of the image"
msgstr ""
"Styr hur riktat filtret är. 0 betyder att filtret är helt rundstrålande, "
"medan 2 betyder att det är maximalt riktat längs bildens kanter"

#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:88
msgid "Uses a more precise but slower method. Use if the output contains undesirable noise."
msgstr "Använder en mer precis men långsammare metod. Används om utdata innehåller oönskat brus."

#: source/blender/nodes/composite/nodes/node_composite_lens_distortion.cc:36
msgid "Radially distorts the image to create a barrel or a Pincushion distortion"
msgstr ""
"Förvränger bilden radiellt för att skapa en tunnformad eller kuddformad "
"förvrängning"

#: source/blender/nodes/composite/nodes/node_composite_lens_distortion.cc:41
msgid "Horizontally distorts the image to create a channel/color shifting effect"
msgstr ""
"Förvränger bilden horisontellt för att skapa en kanal-/färgskiftningseffekt"

#: source/blender/nodes/composite/nodes/node_composite_lens_distortion.cc:70
msgid "Dispersion"
msgstr "Spridning"

#: source/blender/nodes/composite/nodes/node_composite_lens_distortion.cc:67
msgid "The amount of distortion. 0 means no distortion, -1 means full Pincushion distortion, and 1 means full Barrel distortion"
msgstr ""
"Graden av distorsion. 0 betyder ingen distorsion, -1 betyder full "
"nålkuddeformning och 1 betyder full tunnformning"

#: source/blender/nodes/composite/nodes/node_composite_lens_distortion.cc:75
msgid "The amount of chromatic aberration to add to the distortion"
msgstr "Mängden kromatisk aberration som ska läggas till distorsionen"

#: source/blender/nodes/composite/nodes/node_composite_lens_distortion.cc:79
msgid "Introduces jitter while doing distortion, which can be faster but can produce grainy or noisy results"
msgstr ""
"Introducerar jitter vid distorsion, vilket kan vara snabbare men kan ge "
"korniga eller brusiga resultat"

#: source/blender/nodes/composite/nodes/node_composite_lens_distortion.cc:85
msgid "Scales the image such that it fits entirely in the frame, leaving no empty spaces at the corners"
msgstr ""
"Skalera bilden så att den passar helt i bildrutan utan att lämna tomma "
"utrymmen i hörnen"

#: source/blender/nodes/composite/nodes/node_composite_levels.cc:19
msgid "Combined RGB"
msgstr "Kombinerad RGB"

#: source/blender/nodes/composite/nodes/node_composite_levels.cc:20
msgid "Red Channel"
msgstr "Röd kanal"

#: source/blender/nodes/composite/nodes/node_composite_levels.cc:21
msgid "Green Channel"
msgstr "Grön kanal"

#: source/blender/nodes/composite/nodes/node_composite_levels.cc:22
msgid "Blue Channel"
msgstr "Blå kanal"

#: source/blender/nodes/composite/nodes/node_composite_levels.cc:23
msgid "Luminance Channel"
msgstr "Luminanskanal"

#: source/blender/nodes/composite/nodes/node_composite_levels.cc:38
#: source/blender/nodes/geometry/nodes/node_geo_attribute_statistic.cc:43
#: source/blender/nodes/geometry/nodes/node_geo_field_variance.cc:93
#: source/blender/nodes/geometry/nodes/node_geo_field_variance.cc:42
msgid "Standard Deviation"
msgstr "Standardavvikelse"

#: source/blender/nodes/composite/nodes/node_composite_luminance_key.cc:36
msgid "Pixels whose luminance values lower than this minimum are keyed"
msgstr "Pixlar vars luminansvärden är lägre än detta minimum är nyckelade"

#: source/blender/nodes/composite/nodes/node_composite_luminance_key.cc:42
msgid "Pixels whose luminance values higher than this maximum are not keyed"
msgstr ""
"Pixlar vars luminansvärden är högre än detta maximum är inte nyckelbelagda"

#: source/blender/nodes/composite/nodes/node_composite_map_uv.cc:45
msgid "The UV coordinates at which to sample the texture. The Z component is assumed to contain an alpha channel"
msgstr ""
"UV-koordinaterna vid vilka texturen ska samplas. Z-komponenten antas "
"innehålla en alfakanal"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:21
msgid "Use pixel size for the buffer"
msgstr "Använd pixelstorlek för buffert"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:25
msgid "Fixed/Scene"
msgstr "Fast/Scene"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:26
msgid "Pixel size scaled by scene percentage"
msgstr "Pixelstorlek skalad efter scenprocent"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:40
msgid "Size Source"
msgstr "Storlek Källa"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:44
msgid "The source where the size of the mask is retrieved"
msgstr "Källan där maskens storlek hämtas"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:51
msgid "The resolution of the mask along the X direction"
msgstr "Masken upplösning längs X-riktningen"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:58
msgid "The resolution of the mask along the Y direction"
msgstr "Masken upplösning längs Y-riktningen"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:61
msgid "Use feather information from the mask"
msgstr "Använd fjäderinformation från masken"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:68
msgid "Use multi-sampled motion blur of the mask"
msgstr "Använd multisamplade rörelseoskärpa för masken"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:73
#: source/blender/nodes/composite/nodes/node_composite_plane_track_deform.cc:91
msgid "Number of motion blur samples"
msgstr "Antal rörelseoskärpaexempel"

#: source/blender/nodes/composite/nodes/node_composite_mask.cc:79
#: source/blender/nodes/composite/nodes/node_composite_plane_track_deform.cc:97
msgid "Exposure for motion blur as a factor of FPS"
msgstr "Exponering för rörelseoskärpa som en faktor av FPS"

#: source/blender/nodes/composite/nodes/node_composite_mask_to_sdf.cc:19
#: source/blender/nodes/geometry/nodes/node_geo_grid_prune.cc:56
msgid "SDF"
msgstr "SDF"

#: source/blender/nodes/composite/nodes/node_composite_mask_to_sdf.cc:24
msgid "Nearest Pixel"
msgstr "Närmaste pixel"

#: source/blender/nodes/composite/nodes/node_composite_mask_to_sdf.cc:21
msgid "The distance in pixel to the nearest pixel at the boundary of the mask. The distance is negative inside the mask"
msgstr ""
"Avståndet i pixlar till närmaste pixel vid maskens gräns. Avståndet är "
"negativt inuti masken"

#: source/blender/nodes/composite/nodes/node_composite_mask_to_sdf.cc:27
msgid "The integer coordinates of the nearest pixel at the boundary of the mask"
msgstr "Heltalskoordinaterna för den närmaste pixeln vid maskens gräns"

#: source/blender/nodes/composite/nodes/node_composite_movie_clip.cc:33
msgid "Offset Y"
msgstr "Offset Y"

#: source/blender/nodes/composite/nodes/node_composite_pixelate.cc:29
msgid "The number of pixels that correspond to the same output pixel"
msgstr "Antalet pixlar som motsvarar samma utgångspixel"

#: source/blender/nodes/composite/nodes/node_composite_plane_track_deform.cc:86
msgid "Use multi-sampled motion blur of the plane"
msgstr "Använd multisamplade rörelseoskärpa för planet"

#: source/blender/nodes/composite/nodes/node_composite_relative_to_pixel.cc:30
#: source/blender/nodes/composite/nodes/node_composite_relative_to_pixel.cc:38
msgid "A value that is relative to the image size and needs to be converted to be in pixels"
msgstr ""
"Ett värde som är relativt till bildstorleken och måste konverteras till "
"pixlar"

#: source/blender/nodes/composite/nodes/node_composite_render_layers.cc:247
msgid "The Render Layers node is only supported for scene compositing"
msgstr "Noden Render Layers stöds endast för scenkomponering"

#: source/blender/nodes/composite/nodes/node_composite_rgb_curves.cc:30
msgid "Image/Color input on which RGB color transformation will be applied"
msgstr "Bild-/färginmatning på vilken RGB-färgkonvertering kommer att tillämpas"

#: source/blender/nodes/composite/nodes/node_composite_rgb_curves.cc:36
#: source/blender/nodes/shader/nodes/node_shader_hueSatVal.cc:43
#: source/blender/nodes/shader/nodes/node_shader_invert.cc:21
msgid "Amount of influence the node exerts on the image"
msgstr "Hur stor påverkan noden har på bilden"

#: source/blender/nodes/composite/nodes/node_composite_rgb_curves.cc:39
msgid "Input color that should be mapped to black"
msgstr "Ange färg som ska mappas till svart"

#: source/blender/nodes/composite/nodes/node_composite_rgb_curves.cc:42
msgid "Input color that should be mapped to white"
msgstr "Ange färg som ska mappas till vitt"

#: source/blender/nodes/composite/nodes/node_composite_rgb_to_bw.cc:25
#: source/blender/nodes/shader/nodes/node_shader_rgb_to_bw.cc:21
#: source/blender/nodes/texture/nodes/node_texture_valToNor.cc:13
#: source/blender/nodes/texture/nodes/node_texture_valToRgb.cc:73
msgid "Val"
msgstr "Val"

#: source/blender/nodes/composite/nodes/node_composite_scale.cc:28
msgid "Scene Size"
msgstr "Scens storlek"

#: source/blender/nodes/composite/nodes/node_composite_scale.cc:70
msgid "Frame Type"
msgstr "Ramtyp"

#: source/blender/nodes/composite/nodes/node_composite_set_alpha.cc:22
msgid "Apply Mask"
msgstr "Applicera mask"

#: source/blender/nodes/composite/nodes/node_composite_set_alpha.cc:23
msgid "Multiply the input image's RGBA channels by the alpha input value"
msgstr ""
"Multiplicera RGBA-kanalerna i den inmatade bilden med alfa-inmatningsvärdet"

#: source/blender/nodes/composite/nodes/node_composite_set_alpha.cc:27
msgid "Replace Alpha"
msgstr "Ersätt Alpha"

#: source/blender/nodes/composite/nodes/node_composite_set_alpha.cc:28
msgid "Replace the input image's alpha channel by the alpha input value"
msgstr "Ersätt ingångsbildens alfakanal med alfainmatningsvärdet"

#: source/blender/nodes/composite/nodes/node_composite_split.cc:23
msgid "Line position where the image should be split"
msgstr "Linjeposition där bilden ska delas"

#: source/blender/nodes/composite/nodes/node_composite_split.cc:27
msgid "Line angle where the image should be split"
msgstr "Linjevinkel där bilden ska delas"

#: source/blender/nodes/composite/nodes/node_composite_stabilize_2d.cc:48
msgid "The frame to get the stabilization data at"
msgstr "Bildrutan där stabiliseringsdata ska hämtas"

#: source/blender/nodes/composite/nodes/node_composite_stabilize_2d.cc:52
msgid "Invert stabilization to reintroduce motion to the image"
msgstr "Invertera stabiliseringen för att återinföra rörelse i bilden"

#: source/blender/nodes/composite/nodes/node_composite_string_to_image.cc:28
#: source/blender/nodes/geometry/nodes/node_geo_string_to_curves.cc:64
msgid "Align text to the center"
msgstr "Centrera texten"

#: source/blender/nodes/composite/nodes/node_composite_string_to_image.cc:73
msgid "The image containing the paragraph of text"
msgstr "Bilden som innehåller textstycket"

#: source/blender/nodes/composite/nodes/node_composite_string_to_image.cc:84
msgid "The height of each line in pixels"
msgstr "Höjden för varje rad i bildpunkter"

#: source/blender/nodes/composite/nodes/node_composite_string_to_image.cc:103
msgid "Wrap text into new lines if it exceeds the specified width"
msgstr "Radbryt text om den överskrider den angivna bredden"

#: source/blender/nodes/composite/nodes/node_composite_string_to_image.cc:108
msgid "The maximum width of each line in pixels. Lines with larger widths will be wrapped into new lines"
msgstr "Maximal bredd för varje rad i bildpunkter. Rader med större bredd radbryts"

#: source/blender/nodes/composite/nodes/node_composite_strip_info.cc:84
msgid "The Strip Info node is only supported for sequencer compositing"
msgstr "Strip Info-noden stöds endast för sekvenserkomposition"

#: source/blender/nodes/composite/nodes/node_composite_switch.cc:60
msgid "Use Utilities ▸ Switch node instead"
msgstr "Använd i stället noden Verktyg ▸ Växla"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:27
msgid "More advanced algorithm based on eye physiology, by Reinhard and Devlin"
msgstr "Mer avancerad algoritm baserad på ögonfysiologi, av Reinhard och Devlin"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:32
msgid "Simpler photographic algorithm by Reinhard"
msgstr "Enklare fotografisk algoritm av Reinhard"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:88
msgid "Light Adaptation"
msgstr "Ljusadaptation"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:97
msgid "Chromatic Adaptation"
msgstr "Kromatisk anpassning"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:59
msgid "The luminance that will be mapped to the log average luminance, typically set to the middle gray value"
msgstr ""
"Luminansen som kommer att mappas till den logaritmiska genomsnittliga "
"luminansen, vanligtvis inställd på det mellersta gråvärdet"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:66
msgid "Balances low and high luminance areas. Lower values emphasize details in shadows, while higher values compress highlights more smoothly"
msgstr ""
"Balanserar områden med låg och hög luminans. Lägre värden framhäver detaljer "
"i skuggor, medan högre värden komprimerar högdagrar mer jämnt"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:73
msgid "Gamma correction factor applied after tone mapping"
msgstr "Gammakorrigeringstillämpad efter tonmappning"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:78
msgid "Controls the intensity of the image, lower values makes it darker while higher values makes it lighter"
msgstr ""
"Kontrollerar bildens intensitet. Lägre värden gör bilden mörkare, medan "
"högre värden gör den ljusare"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:85
msgid "Controls the contrast of the image. Zero automatically sets the contrast based on its global range for better luminance distribution"
msgstr ""
"Styr bildens kontrast. Noll ställer automatiskt in kontrasten baserat på "
"dess globala intervall för bättre luminansfördelning"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:94
msgid "Specifies if tone mapping operates on the entire image or per pixel, 0 means the entire image, 1 means it is per pixel, and values in between blends between both"
msgstr ""
"Anger om tonmappningen ska utföras på hela bilden eller per pixel. 0 betyder "
"hela bilden, 1 betyder per pixel och värden däremellan är en blandning av "
"båda"

#: source/blender/nodes/composite/nodes/node_composite_tone_map.cc:103
msgid "Specifies if tone mapping operates on the luminance or on each channel independently, 0 means it uses luminance, 1 means it is per channel, and values in between blends between both"
msgstr ""
"Anger om tonmappningen ska utföras på luminansen eller på varje kanal "
"separat. 0 betyder att luminansen används, 1 betyder att det är per kanal "
"och värden däremellan blandar mellan båda"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:36
msgid "Returns the position and speed of the marker at the current scene frame relative to the zero origin of the tracking space"
msgstr ""
"Returnerar markörens position och hastighet i den aktuella scenramen "
"relativt spårningsutrymmets nollpunkt"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:41
msgid "Relative Start"
msgstr "Relativ start"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:42
msgid "Returns the position and speed of the marker at the current scene frame relative to the position of the first non-disabled marker in the track"
msgstr ""
"Returnerar markörens position och hastighet i den aktuella scenramen i "
"förhållande till positionen för den första icke-inaktiverade markören i "
"spåret"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:47
msgid "Relative Frame"
msgstr "Relativ bildruta"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:48
msgid "Returns the position and speed of the marker at the current scene frame relative to the position of the marker at the current scene frame plus the user given relative frame"
msgstr ""
"Returnerar markörens position och hastighet i den aktuella scenramen i "
"förhållande till markörens position i den aktuella scenramen plus den "
"relativa bildruta som användaren angett"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:53
msgid "Absolute Frame"
msgstr "Absolut bildruta"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:54
msgid "Returns the position and speed of the marker at the given absolute frame"
msgstr ""
"Returnerar markörens position och hastighet vid den angivna absoluta "
"bildrutan"

