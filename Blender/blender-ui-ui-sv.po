#. :src: bpy.types.GreasePencilNoiseModifier.step
msgid "Number of frames between randomization steps"
msgstr "Antal bildrutor mellan randomiseringsstegen"

#. :src: bpy.types.GreasePencilLengthModifier.use_curvature
msgid "Use Curvature"
msgstr "Använd Curvature"

#. :src: bpy.types.GreasePencilLengthModifier.use_curvature
msgid "Follow the curvature of the stroke"
msgstr "Följ streckets kurvatur"

#. :src: bpy.types.GreasePencilLengthModifier.use_random
#. :src: bpy.types.GreasePencilNoiseModifier.use_random
msgid "Use random values over time"
msgstr "Använd slumpmässiga värden över tid"

#. :src: bpy.types.GreasePencilLineartModifier
msgid "Line Art Modifier"
msgstr "Linjekonstmodifierare"

#. :src: bpy.types.GreasePencilLineartModifier
msgid "Generate Line Art strokes from selected source"
msgstr "Skapa linjekonststreck från vald källa"

#. :src: bpy.types.GreasePencilLineartModifier.chaining_image_threshold
msgid "Image Threshold"
msgstr "Bildtröskel"

#. :src: bpy.types.GreasePencilLineartModifier.chaining_image_threshold
msgid "Segments with an image distance smaller than this will be chained together"
msgstr "Segment med ett bildavstånd mindre än detta kopplas ihop"

#. :src: bpy.types.GreasePencilLineartModifier.crease_threshold
msgid "Crease Threshold"
msgstr "Veckgräns"

#. :src: bpy.types.GreasePencilLineartModifier.crease_threshold
msgid "Angles smaller than this will be treated as creases. Crease angle priority: object Line Art crease override > mesh auto smooth angle > Line Art default crease."
msgstr "Vinklar som är mindre än detta kommer att behandlas som veck. Prioritet för veckvinkel: objekt Linjekonst vecköverskrivning > mesh automatisk utjämningsvinkel > Linjekonst standardveck."

#. :src: bpy.types.GreasePencilLineartModifier.fill_strokes
msgid "Fill Strokes"
msgstr "Fyll streck"

#. :src: bpy.types.GreasePencilLineartModifier.fill_strokes
msgid "Generate filled strokes instead of only outline"
msgstr "Skapa fyllda streck i stället för endast kontur"

#. :src: bpy.types.GreasePencilLineartModifier.invert_source_vertex_group
msgid "Invert source vertex group values"
msgstr "Invertera källans vertexgruppsvärden"

#. :src: bpy.types.GreasePencilLineartModifier.is_baked
msgid "Is Baked"
msgstr "Är bakad"

#. :src: bpy.types.GreasePencilLineartModifier.is_baked
msgid "This modifier has baked data"
msgstr "Denna modifierare har bakade data"

#. :src: bpy.types.GreasePencilLineartModifier.level_end
msgid "Level End"
msgstr "Nivå Slut"

#. :src: bpy.types.GreasePencilLineartModifier.level_end
msgid "Maximum number of occlusions for the generated strokes"
msgstr "Maximalt antal ocklusioner för de genererade slagen"

#. :src: bpy.types.GreasePencilLineartModifier.level_start
msgid "Level Start"
msgstr "Nivå Start"

#. :src: bpy.types.GreasePencilLineartModifier.level_start
msgid "Minimum number of occlusions for the generated strokes"
msgstr "Minsta antal ocklusioner för de genererade slagen"

#. :src: bpy.types.GreasePencilLineartModifier.light_contour_object
msgid "Light Object"
msgstr "Ljusoobjekt"

#. :src: bpy.types.GreasePencilLineartModifier.light_contour_object
msgid "Use this light object to generate light contour"
msgstr "Använd detta ljusobjekt för att generera ljus kontur"

#. :src: bpy.types.GreasePencilLineartModifier.opacity
msgid "The strength value for the generate strokes"
msgstr "Styrkevärdet för genererade slag"

#. :src: bpy.types.GreasePencilLineartModifier.overscan
#. :src: bpy.types.SceneEEVEE.use_overscan
#: scripts/addons_core/viewport_vr_preview/gui.py:209
#: scripts/startup/bl_ui/properties_render.py:779
msgid "Overscan"
msgstr "Överskanning"

#. :src: bpy.types.GreasePencilLineartModifier.overscan
msgid "A margin to prevent strokes from ending abruptly at the edge of the image"
msgstr "En marginal för att förhindra att streck slutar abrupt vid bildens kant"

#. :src: bpy.types.GreasePencilLineartModifier.radius
msgid "The radius for the generated strokes"
msgstr "Radien för de genererade strecken"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_camera_far
msgid "Shadow Camera Far"
msgstr "Skuggkamera långt bort"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_camera_far
msgid "Far clipping distance of shadow camera"
msgstr "Lång klippningsavstånd för skuggkamera"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_camera_near
msgid "Shadow Camera Near"
msgstr "Skuggkamera nära"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_camera_near
msgid "Near clipping distance of shadow camera"
msgstr "Nära klippavstånd för skuggkamera"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_camera_size
msgid "Shadow Camera Size"
msgstr "Skuggkameraens storlek"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_camera_size
msgid "Represents the \"Orthographic Scale\" of an orthographic camera. If the camera is positioned at the light's location with this scale, it will represent the coverage of the shadow \"camera\"."
msgstr "Representerar den \"ortografiska skalan\" för en ortografisk kamera. Om kameran placeras på ljusets plats med denna skala kommer den att representera täckningen för skuggkameran."

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering
msgctxt "GPencil"
msgid "Shadow Region Filtering"
msgstr "Skuggregionfiltrering"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering
msgid "Select feature lines that comes from lit or shaded regions. Will not affect cast shadow and light contour since they are at the border."
msgstr "Välj linjer som kommer från upplysta eller skuggade områden. Påverkar inte kastade skuggor och ljuskonturer eftersom de ligger vid gränsen."

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering:'NONE'
msgctxt "GPencil"
msgid "None"
msgstr "Ingen"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering:'NONE'
msgid "Not filtering any lines based on illumination region"
msgstr "Ingen filtrering av linjer baserat på belysningsområde"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering:'ILLUMINATED'
msgctxt "GPencil"
msgid "Illuminated"
msgstr "Upplyst"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering:'ILLUMINATED'
msgid "Only selecting lines from illuminated regions"
msgstr "Välj endast linjer från upplysta områden"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering:'SHADED'
msgctxt "GPencil"
msgid "Shaded"
msgstr "Skuggad"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering:'SHADED'
msgid "Only selecting lines from shaded regions"
msgstr "Välj endast rader från skuggade områden"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering:'ILLUMINATED_ENCLOSED'
msgctxt "GPencil"
msgid "Illuminated (Enclosed Shapes)"
msgstr "Upplyst (slutna former)"

#. :src: bpy.types.GreasePencilLineartModifier.shadow_region_filtering:'ILLUMINATED_ENCLOSED'
msgid "Selecting lines from lit regions, and make the combination of contour, light contour and shadow lines into enclosed shapes"
msgstr ""
"Välj linjer från upplysta områden och kombinera kontur-, ljus- och "
"skugglinjer till slutna former"

#. :src: bpy.types.GreasePencilLineartModifier.silhouette_filtering
msgid "Silhouette Filtering"
msgstr "Silhuettfiltrering"

#. :src: bpy.types.GreasePencilLineartModifier.silhouette_filtering
msgid "Select contour or silhouette"
msgstr "Välj kontur eller silhuett"

#. :src: bpy.types.GreasePencilLineartModifier.silhouette_filtering:'INDIVIDUAL'
msgid "Individual Silhouette"
msgstr "Individuell silhuett"

#. :src: bpy.types.GreasePencilLineartModifier.smooth_tolerance
msgid "Smooth Tolerance"
msgstr "Jämn tolerans"

#. :src: bpy.types.GreasePencilLineartModifier.smooth_tolerance
msgid "Strength of smoothing applied on jagged chains"
msgstr "Styrka hos utjämning som tillämpas på ojämna kedjor"

#. :src: bpy.types.GreasePencilLineartModifier.source_camera
msgid "Camera Object"
msgstr "Kameraobjekt"

#. :src: bpy.types.GreasePencilLineartModifier.source_camera
msgid "Use specified camera object for generating Line Art strokes"
msgstr "Använd angivet kameraobjekt för att generera linjekonststreck"

#. :src: bpy.types.GreasePencilLineartModifier.source_collection
msgid "Generate strokes from the objects in this collection"
msgstr "Skapa streck från objekten i denna samling"

#. :src: bpy.types.GreasePencilLineartModifier.source_object
msgid "Generate strokes from this object"
msgstr "Skapa streck från detta objekt"

#. :src: bpy.types.GreasePencilLineartModifier.source_type
msgid "Source Type"
msgstr "Källtyp"

#. :src: bpy.types.GreasePencilLineartModifier.source_type
msgid "Line Art stroke source type"
msgstr "Linjekonstpenselkälltyp"

#. :src: bpy.types.GreasePencilLineartModifier.source_vertex_group
msgid "Source Vertex Group"
msgstr "Källvertexgrupp"

#. :src: bpy.types.GreasePencilLineartModifier.source_vertex_group
msgid "Match the beginning of vertex group names from mesh objects, match all when left empty"
msgstr "Matcha början av vertexgruppsnamn från nätobjekt; matcha alla när fältet lämnas tomt"

#. :src: bpy.types.GreasePencilLineartModifier.split_angle
msgid "Angle Splitting"
msgstr "Vinkeluppdelning"

#. :src: bpy.types.GreasePencilLineartModifier.split_angle
msgid "Angle in screen space below which a stroke is split in two"
msgstr "Vinkel i skärmytan under vilken ett streck delas i två delar"

#. :src: bpy.types.GreasePencilLineartModifier.stroke_depth_offset
msgid "Stroke Depth Offset"
msgstr "Djupförskjutning för streck"

#. :src: bpy.types.GreasePencilLineartModifier.stroke_depth_offset
msgid "Move strokes slightly towards the camera to avoid clipping while preserve depth for the viewport"
msgstr ""
"Flytta strecken något mot kameran för att undvika klippning samtidigt som "
"djupet för visningsfönstret bevaras"

#. :src: bpy.types.GreasePencilLineartModifier.target_layer
msgid "Grease Pencil layer to which assign the generated strokes"
msgstr "Grease Pencil-lager som de genererade strecken tilldelas"

#. :src: bpy.types.GreasePencilLineartModifier.target_material
msgid "Grease Pencil material assigned to the generated strokes"
msgstr "Grease Pencil-material som tilldelas de genererade strecken"

#. :src: bpy.types.GreasePencilLineartModifier.use_back_face_culling
msgid "Back Face Culling"
msgstr "Baksideklippning"

#. :src: bpy.types.GreasePencilLineartModifier.use_back_face_culling
msgid "Remove all back faces to speed up calculation, this will create edges in different occlusion levels than when disabled"
msgstr ""
"Ta bort alla baksidor för att påskynda beräkningen; då skapas kanter på "
"andra ocklusionsnivåer än när funktionen är inaktiverad"

#. :src: bpy.types.GreasePencilLineartModifier.use_cache
msgid "Use cached scene data from the first Line Art modifier in the stack. Certain settings will be unavailable."
msgstr "Använd cachade scendata från den första Line Art-modifieraren i stapeln. Vissa inställningar kommer inte att vara tillgängliga."

#. :src: bpy.types.GreasePencilLineartModifier.use_clip_plane_boundaries
msgid "Clipping Boundaries"
msgstr "Klippgränser"

#. :src: bpy.types.GreasePencilLineartModifier.use_clip_plane_boundaries
msgid "Allow lines generated by the near/far clipping plane to be shown"
msgstr "Tillåt att linjer som genereras av det nära/fjärran klippplanet visas"

#. :src: bpy.types.GreasePencilLineartModifier.use_contour
msgid "Use Contour"
msgstr "Använd Contour"

#. :src: bpy.types.GreasePencilLineartModifier.use_contour
msgid "Generate strokes from contours lines"
msgstr "Generera streck från konturlinjer"

#. :src: bpy.types.GreasePencilLineartModifier.use_crease
#. :src: bpy.types.ObjectLineArt.use_crease_override
msgid "Use Crease"
msgstr "Använd veck"

#. :src: bpy.types.GreasePencilLineartModifier.use_crease
msgid "Generate strokes from creased edges"
msgstr "Skapa streck från vikta kanter"

#. :src: bpy.types.GreasePencilLineartModifier.use_crease_on_sharp
msgid "Crease On Sharp Edges"
msgstr "Veck på skarpa kanter"

#. :src: bpy.types.GreasePencilLineartModifier.use_crease_on_sharp
msgid "Allow crease to show on sharp edges"
msgstr "Låt veck synas på skarpa kanter"

#. :src: bpy.types.GreasePencilLineartModifier.use_crease_on_smooth
msgid "Crease On Smooth Surfaces"
msgstr "Veck på släta ytor"

#. :src: bpy.types.GreasePencilLineartModifier.use_crease_on_smooth
msgid "Allow crease edges to show inside smooth surfaces"
msgstr "Låt veckade kanter synas på släta ytor"

#. :src: bpy.types.GreasePencilLineartModifier.use_custom_camera
msgid "Use Custom Camera"
msgstr "Använd anpassad kamera"

#. :src: bpy.types.GreasePencilLineartModifier.use_custom_camera
msgid "Use custom camera instead of the active camera"
msgstr "Använd anpassad kamera istället för den aktiva kameran"

#. :src: bpy.types.GreasePencilLineartModifier.use_detail_preserve
msgid "Preserve Details"
msgstr "Bevara detaljer"

#. :src: bpy.types.GreasePencilLineartModifier.use_detail_preserve
msgid "Keep the zig-zag \"noise\" in initial chaining"
msgstr "Behåll zigzag-bruset i den initiala kedjan"

#. :src: bpy.types.GreasePencilLineartModifier.use_edge_mark
msgid "Use Edge Mark"
msgstr "Använd kantmarkering"

#. :src: bpy.types.GreasePencilLineartModifier.use_edge_mark
