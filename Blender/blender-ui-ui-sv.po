msgid "Repeat Input"
msgstr "Upprepa inmatning"

#. :src: bpy.types.GeometryNodeRepeatOutput
msgid "Repeat Output"
msgstr "Upprepa utdata"

#. :src: bpy.types.GeometryNodeReplaceMaterial
msgid "Replace Material"
msgstr "Byt ut material"

#. :src: bpy.types.GeometryNodeReplaceMaterial
msgid "Swap one material with another"
msgstr "Byt ut ett material mot ett annat"

#. :src: bpy.types.GeometryNodeResampleCurve
msgid "Resample Curve"
msgstr "Omprovtagning av kurva"

#. :src: bpy.types.GeometryNodeResampleCurve
msgid "Generate a poly spline for each input spline"
msgstr "Generera en polyspline för varje ingångsspline"

#. :src: bpy.types.GeometryNodeResampleCurve.keep_last_segment
msgid "Keep Last Segment"
msgstr "Behåll sista segmentet"

#. :src: bpy.types.GeometryNodeResampleCurve.keep_last_segment
msgid "Do not collapse curves to single points if they are shorter than the given length. The collapsing behavior exists for compatibility reasons."
msgstr "Kollapsa inte kurvor till enstaka punkter om de är kortare än den angivna längden. Kollapsningsfunktionen finns av kompatibilitetsskäl."

#. :src: bpy.types.GeometryNodeReverseCurve
msgid "Reverse Curve"
msgstr "Omvänd kurva"

#. :src: bpy.types.GeometryNodeReverseCurve
msgid "Change the direction of curves by swapping their start and end data"
msgstr ""
"Ändra kurvornas riktning genom att byta plats på deras start- och slutdata"

#. :src: bpy.types.GeometryNodeRotateInstances
msgid "Rotate Instances"
msgstr "Rotera instanser"

#. :src: bpy.types.GeometryNodeRotateInstances
msgid "Rotate geometry instances in local or global space"
msgstr "Rotera geometriinstanser i lokalt eller globalt utrymme"

#. :src: bpy.types.GeometryNodeSDFGridBoolean
msgid "SDF Grid Boolean"
msgstr "SDF-rutnät Boolesk"

#. :src: bpy.types.GeometryNodeSDFGridBoolean
msgid "Cut, subtract, or join multiple SDF volume grid inputs"
msgstr "Klipp, subtrahera eller sammanfoga flera SDF-volymrutnätinmatningar"

#. :src: bpy.types.GeometryNodeSDFGridBoolean.operation:'INTERSECT'
msgid "Keep the part of the grids that is common between all operands"
msgstr "Behåll den del av rutnäten som är gemensam för alla operander"

#. :src: bpy.types.GeometryNodeSDFGridBoolean.operation:'UNION'
msgid "Combine grids in an additive way"
msgstr "Kombinera rutnät på ett additivt sätt"

#. :src: bpy.types.GeometryNodeSDFGridBoolean.operation:'DIFFERENCE'
msgid "Combine grids in a subtractive way"
msgstr "Kombinera rutnät på ett subtraktivt sätt"

#. :src: bpy.types.GeometryNodeSDFGridFillet
msgid "SDF Grid Fillet"
msgstr "SDF-rutnätfilé"

#. :src: bpy.types.GeometryNodeSDFGridFillet
msgid "Round off concave internal corners in a signed distance field. Only affects areas with negative principal curvature, creating smoother transitions between surfaces"
msgstr ""
"Avrunda konkava inre hörn i ett signerat avståndsfält. Påverkar endast "
"områden med negativ huvudkrökning, vilket skapar mjukare övergångar mellan "
"ytor"

#. :src: bpy.types.GeometryNodeSDFGridLaplacian
msgid "SDF Grid Laplacian"
msgstr "SDF-rutnät Laplacian"

#. :src: bpy.types.GeometryNodeSDFGridLaplacian
msgid "Apply Laplacian flow smoothing to a signed distance field. Computationally efficient alternative to mean curvature flow, ideal when combined with SDF normalization"
msgstr ""
"Tillämpa Laplacian-flödesutjämning på ett signerat avståndsfält. "
"Beräkningsmässigt effektivt alternativ till medelkurvaturflöde, idealiskt i "
"kombination med SDF-normalisering"

#. :src: bpy.types.GeometryNodeSDFGridMean
msgid "SDF Grid Mean"
msgstr "SDF-nätets medelvärde"

#. :src: bpy.types.GeometryNodeSDFGridMean
msgid "Apply mean (box) filter smoothing to a signed distance field. Fast separable averaging filter for general smoothing of the distance field"
msgstr ""
"Tillämpa medelvärdesfilter (boxfilter) för utjämning av ett signerat "
"avståndsfält. Snabbt separerbart medelvärdesfilter för allmän utjämning av "
"avståndsfältet"

#. :src: bpy.types.GeometryNodeSDFGridMeanCurvature
msgid "SDF Grid Mean Curvature"
msgstr "SDF-rutnätets medelkurvatur"

#. :src: bpy.types.GeometryNodeSDFGridMeanCurvature
msgid "Apply mean curvature flow smoothing to a signed distance field. Evolves the surface based on its mean curvature, naturally smoothing high-curvature regions more than flat areas"
msgstr ""
"Tillämpa utjämning av medelkurvaturflöde på ett signerat avståndsfält. "
"Utvecklar ytan baserat på dess medelkurvatur, vilket naturligt utjämnar "
"områden med hög kurvatur mer än plana områden"

#. :src: bpy.types.GeometryNodeSDFGridMedian
msgid "SDF Grid Median"
msgstr "SDF-rutnätets median"

#. :src: bpy.types.GeometryNodeSDFGridMedian
msgid "Apply median filter to a signed distance field. Reduces noise while preserving sharp features and edges in the distance field"
msgstr ""
"Tillämpa medianfilter på ett signerat avståndsfält. Minskar bruset samtidigt "
"som skarpa detaljer och kanter i avståndsfältet bevaras"

#. :src: bpy.types.GeometryNodeSDFGridOffset
msgid "SDF Grid Offset"
msgstr "SDF-rutnätsförskjutning"

#. :src: bpy.types.GeometryNodeSDFGridOffset
msgid "Offset a signed distance field surface by a world-space distance. Dilates (positive) or erodes (negative) while maintaining the signed distance property"
msgstr ""
"Kompensera en signerad avståndsfältyta med ett avstånd i världsrummet. "
"Dilaterar (positivt) eller eroderar (negativt) samtidigt som den signerade "
"avståndsegenskapen bibehålls"

#. :src: bpy.types.GeometryNodeSampleCurve
msgid "Sample Curve"
msgstr "Exempelkurva"

#. :src: bpy.types.GeometryNodeSampleCurve
msgid "Retrieve data from a point on a curve at a certain distance from its start"
msgstr "Hämta data från en punkt på en kurva på ett visst avstånd från dess startpunkt"

#. :src: bpy.types.GeometryNodeSampleCurve.mode
msgid "Method for sampling input"
msgstr "Metod för provtagning av ingångssignaler"

#. :src: bpy.types.GeometryNodeSampleCurve.mode:'FACTOR'
msgid "Find sample positions on the curve using a factor of its total length"
msgstr ""
"Hitta exempelpositioner på kurvan med hjälp av en faktor av dess totala längd"

#. :src: bpy.types.GeometryNodeSampleCurve.mode:'LENGTH'
msgid "Find sample positions on the curve using a distance from its beginning"
msgstr "Hitta exempelpositioner på kurvan med hjälp av avståndet från dess början"

#. :src: bpy.types.GeometryNodeSampleCurve.use_all_curves
msgid "All Curves"
msgstr "Alla kurvor"

#. :src: bpy.types.GeometryNodeSampleCurve.use_all_curves
msgid "Sample lengths based on the total length of all curves, rather than using a length inside each selected curve"
msgstr ""
"Provlängder baserade på den totala längden av alla kurvor, snarare än att "
"använda en längd inuti varje vald kurva"

#. :src: bpy.types.GeometryNodeSampleGrid
msgid "Sample Grid"
msgstr "Exempel på rutnät"

#. :src: bpy.types.GeometryNodeSampleGrid
msgid "Retrieve values from the specified volume grid"
msgstr "Hämta värden från det angivna volymrutnätet"

#. :src: bpy.types.GeometryNodeSampleGridIndex
msgid "Sample Grid Index"
msgstr "Exempel på rutnätindex"

#. :src: bpy.types.GeometryNodeSampleGridIndex
msgid "Retrieve volume grid values at specific voxels"
msgstr "Hämta volymrutnätsvärden vid specifika voxlar"

#. :src: bpy.types.GeometryNodeSampleIndex
msgid "Retrieve values from specific geometry elements"
msgstr "Hämta värden från specifika geometrielement"

#. :src: bpy.types.GeometryNodeSampleIndex.clamp
msgid "Clamp the indices to the size of the attribute domain instead of outputting a default value for invalid indices"
msgstr ""
"Kläm fast indexen till storleken på attributdomänen istället för att mata ut "
"ett standardvärde för ogiltiga index"

#. :src: bpy.types.GeometryNodeSampleNearest
msgid "Sample Nearest"
msgstr "Närmaste prov"

#. :src: bpy.types.GeometryNodeSampleNearest
msgid "Find the element of a geometry closest to a position. Similar to the \"Index of Nearest\" node"
msgstr ""
"Hitta det geometriska element som ligger närmast en position. Liknar noden "
"\"Index of Nearest\" (Index för närmaste)"

#. :src: bpy.types.GeometryNodeSampleNearestSurface
msgid "Sample Nearest Surface"
msgstr "Exempel på närmaste yta"

#. :src: bpy.types.GeometryNodeSampleNearestSurface
msgid "Calculate the interpolated value of a mesh attribute on the closest point of its surface"
msgstr ""
"Beräkna det interpolerade värdet för ett nätattribut på den närmaste punkten "
"på dess yta"

#. :src: bpy.types.GeometryNodeSampleSoundFrequencies
msgid "Sample Sound Frequencies"
msgstr "Sampla ljudfrekvenser"

#. :src: bpy.types.GeometryNodeSampleSoundFrequencies
msgid "Retrieve the amplitude from a sound data-block of a frequency range at a given time"
msgstr "Hämta amplituden från ett ljuddatablock för ett frekvensområde vid en angiven tidpunkt"

#. :src: bpy.types.GeometryNodeSampleUVSurface
msgid "Sample UV Surface"
msgstr "Prov UV-yta"

#. :src: bpy.types.GeometryNodeSampleUVSurface
msgid "Calculate the interpolated values of a mesh attribute at a UV coordinate"
msgstr "Beräkna de interpolerade värdena för ett nätattribut vid en UV-koordinat"

#. :src: bpy.types.GeometryNodeScaleElements
msgid "Scale Elements"
msgstr "Skalaelement"

#. :src: bpy.types.GeometryNodeScaleElements
msgid "Scale groups of connected edges and faces"
msgstr "Skala grupper av sammankopplade kanter och ytor"

#. :src: bpy.types.GeometryNodeScaleElements.domain
msgid "Element type to transform"
msgstr "Elementtyp att transformera"

#. :src: bpy.types.GeometryNodeScaleElements.domain:'FACE'
msgid "Scale individual faces or neighboring face islands"
msgstr "Skala enskilda ytor eller angränsande ytor"

#. :src: bpy.types.GeometryNodeScaleElements.domain:'EDGE'
msgid "Scale individual edges or neighboring edge islands"
msgstr "Skala enskilda kanter eller angränsande kantöar"

#. :src: bpy.types.GeometryNodeScaleInstances
msgid "Scale Instances"
msgstr "Skala instanser"

#. :src: bpy.types.GeometryNodeScaleInstances
msgid "Scale geometry instances in local or global space"
msgstr "Skalgeometriinstanser i lokalt eller globalt utrymme"

#. :src: bpy.types.GeometryNodeSelfObject
#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'SELF_OBJECT'
#: source/blender/editors/space_node/node_socket_tooltip.cc:948
#: source/blender/nodes/geometry/nodes/node_geo_self_object.cc:10
msgid "Self Object"
msgstr "Självobjekt"

#. :src: bpy.types.GeometryNodeSelfObject
msgid "Retrieve the object that contains the geometry nodes modifier currently being executed"
msgstr ""
"Hämta objektet som innehåller geometrinodmodifieraren som för närvarande "
"exekveras"

#. :src: bpy.types.GeometryNodeSeparateComponents
msgid "Separate Components"
msgstr "Separata komponenter"

#. :src: bpy.types.GeometryNodeSeparateComponents
msgid "Split a geometry into a separate output for each type of data in the geometry"
msgstr ""
"Dela upp en geometri i separata utdata för varje typ av data i geometrin"

#. :src: bpy.types.GeometryNodeSeparateGeometry
msgid "Separate Geometry"
msgstr "Separat geometri"

#. :src: bpy.types.GeometryNodeSeparateGeometry
msgid "Split a geometry into two geometry outputs based on a selection"
msgstr "Dela upp en geometri i två geometriutdata baserat på ett val"

#. :src: bpy.types.GeometryNodeSeparateGeometry.domain
msgid "Which domain to separate on"
msgstr "Vilken domän ska separeras på"

#. :src: bpy.types.GeometryNodeSetCurveHandlePositions
msgid "Set Handle Positions"
msgstr "Ställ in handtagspositioner"

#. :src: bpy.types.GeometryNodeSetCurveHandlePositions
msgid "Set the positions for the handles of Bézier curves"
msgstr "Ställ in positionerna för handtagen på Bézier-kurvorna"

#. :src: bpy.types.GeometryNodeSetCurveNormal
msgid "Set Curve Normal"
msgstr "Ställ in kurvan Normal"

#. :src: bpy.types.GeometryNodeSetCurveNormal
msgid "Set the evaluation mode for curve normals"
msgstr "Ställ in utvärderingsläget för kurvnormaler"

#. :src: bpy.types.GeometryNodeSetCurveRadius
msgid "Set Curve Radius"
msgstr "Ställ in kurvradie"

#. :src: bpy.types.GeometryNodeSetCurveRadius
msgid "Set the radius of the curve at each control point"
msgstr "Ställ in kurvans radie vid varje kontrollpunkt"

#. :src: bpy.types.GeometryNodeSetCurveTilt
msgid "Set Curve Tilt"
msgstr "Ställ in kurvlutning"

#. :src: bpy.types.GeometryNodeSetCurveTilt
msgid "Set the tilt angle at each curve control point"
msgstr "Ställ in lutningsvinkeln vid varje kurvkontrollpunkt"

#. :src: bpy.types.GeometryNodeSetGeometryBundle
msgid "Set Geometry Bundle"
msgstr "Ställ in geometripaket"

#. :src: bpy.types.GeometryNodeSetGeometryBundle
msgid "Set the bundle of a geometry"
msgstr "Ställ in geometrins bunt"

#. :src: bpy.types.GeometryNodeSetGeometryName
msgid "Set Geometry Name"
msgstr "Ange geometrins namn"

#. :src: bpy.types.GeometryNodeSetGeometryName
msgid "Set the name of a geometry for easier debugging"
msgstr "Ange namnet på en geometri för enklare felsökning"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor
msgid "Set Grease Pencil Color"
msgstr "Ställ in Grease Pencil-färg"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor
msgid "Set color and opacity attributes on Grease Pencil geometry"
msgstr "Ställ in färg- och opacitetsattribut för Grease Pencil-geometri"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor.mode
msgid "Set the color and opacity for strokes or fills"
msgstr "Ange färg och opacitet för streck eller fyllningar"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor.mode:'STROKE'
msgid "Set the color and opacity for the points of the stroke"
msgstr "Ange färg och opacitet för streckets punkter"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor.mode:'FILL'
msgid "Set the color and opacity for the stroke fills"
msgstr "Ange färg och opacitet för streckfyllningar"

#. :src: bpy.types.GeometryNodeSetGreasePencilDepth
msgid "Set Grease Pencil Depth"
msgstr "Ställ in Grease Pencil-djup"

#. :src: bpy.types.GeometryNodeSetGreasePencilDepth
msgid "Set the Grease Pencil depth order to use"
msgstr "Ställ in Grease Pencil-djupordningen som ska användas"

#. :src: bpy.types.GeometryNodeSetGreasePencilDepth.depth_order
#: source/blender/nodes/geometry/nodes/node_geo_set_grease_pencil_depth_mode.cc:34
msgid "Depth Order"
msgstr "Djupordning"

#. :src: bpy.types.GeometryNodeSetGreasePencilSoftness
msgid "Set Grease Pencil Softness"
msgstr "Ställ in Grease Pencil-mjukhet"

#. :src: bpy.types.GeometryNodeSetGreasePencilSoftness
msgid "Set softness attribute on Grease Pencil geometry"
msgstr "Ställ in mjukhetsattribut på Grease Pencil-geometri"

#. :src: bpy.types.GeometryNodeSetGridBackground
msgid "Set Grid Background"
msgstr "Ställ in rutnätets bakgrund"

#. :src: bpy.types.GeometryNodeSetGridBackground
msgid "Set the background value used for inactive voxels and tiles"
msgstr "Ställ in bakgrundsvärdet som används för inaktiva voxlar och brickor"

#. :src: bpy.types.GeometryNodeSetGridTransform
msgid "Set Grid Transform"
msgstr "Ställ in rutnätstransformering"

#. :src: bpy.types.GeometryNodeSetGridTransform
msgid "Set the transform for the grid from index space into object space."
msgstr "Ställ in transformeringen för rutnätet från indexutrymmet till objektutrymmet."

#. :src: bpy.types.GeometryNodeSetID
msgid "Set ID"
msgstr "Ställ in ID"

#. :src: bpy.types.GeometryNodeSetID
msgid "Set the id attribute on the input geometry, mainly used internally for randomizing"
msgstr ""
"Ställ in id-attributet på ingångsgeometrin, används främst internt för "
"randomisering"

#. :src: bpy.types.GeometryNodeSetInstanceTransform
msgid "Set Instance Transform"
msgstr "Ställ in instansomvandling"

#. :src: bpy.types.GeometryNodeSetInstanceTransform
msgid "Set the transformation matrix of every instance"
msgstr "Ställ in transformationsmatrisen för varje instans"

#. :src: bpy.types.GeometryNodeSetMaterial
msgid "Set Material"
msgstr "Materialuppsättning"

#. :src: bpy.types.GeometryNodeSetMaterial
msgid "Assign a material to geometry elements"
msgstr "Tilldela ett material till geometrielement"

#. :src: bpy.types.GeometryNodeSetMaterialIndex
msgid "Set Material Index"
msgstr "Ställ in materialindex"

#. :src: bpy.types.GeometryNodeSetMaterialIndex
msgid "Set the material index for each selected geometry element"
msgstr "Ställ in materialindex för varje valt geometrielement"

#. :src: bpy.types.GeometryNodeSetMeshNormal
msgid "Set Mesh Normal"
msgstr "Ställ in mesh-normal"

#. :src: bpy.types.GeometryNodeSetMeshNormal
msgid "Store a normal vector for each mesh element"
msgstr "Lagra en normalvektor för varje nätelement"

#. :src: bpy.types.GeometryNodeSetMeshNormal.domain
msgid "Attribute domain to store free custom normals"
msgstr "Attributdomän för lagring av fria anpassade normaler"

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode
msgid "Storage mode for custom normal data"
msgstr "Lagringsläge för anpassade normala data"

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'SHARPNESS'
msgid "Store the sharpness of each face or edge. Similar to the \"Shade Smooth\" and \"Shade Flat\" operators."
msgstr "Lagra skärpan för varje yta eller kant. Liknar operatorerna \"Shade Smooth\" och \"Shade Flat\"."

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'FREE'
msgid "Store custom normals as simple vectors in the local space of the mesh. Values are not necessarily updated automatically later on as the mesh is deformed."
msgstr "Lagra anpassade normaler som enkla vektorer i meshens lokala utrymme. Värdena uppdateras inte nödvändigtvis automatiskt senare när meshen deformeras."

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'TANGENT_SPACE'
#. :src: bpy.types.ShaderNodeNormalMap.space:'TANGENT'
#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'TANGENT'
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_tspace
msgid "Tangent Space"
msgstr "Tangentutrymme"

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'TANGENT_SPACE'
msgid "Store normals in a deformation dependent custom transformation space. This method is slower, but can be better when subsequent operations change the mesh without handling normals specifically."
msgstr "Lagra normaler i ett deformationsberoende anpassat transformationsutrymme. Denna metod är långsammare, men kan vara bättre när efterföljande operationer ändrar nätet utan att hantera normaler specifikt."

#. :src: bpy.types.GeometryNodeSetNURBSOrder
msgid "Set NURBS Order"
msgstr "Ange NURBS-ordning"

#. :src: bpy.types.GeometryNodeSetNURBSOrder
msgid "Control how many curve control points influence each evaluated point by changing the \"nurbs_order\" attribute"
msgstr "Styr hur många kurvkontrollpunkter som påverkar varje utvärderad punkt genom att ändra attributet ”nurbs_order”"

#. :src: bpy.types.GeometryNodeSetNURBSWeight
msgid "Set NURBS Weight"
msgstr "Ange NURBS-vikt"

#. :src: bpy.types.GeometryNodeSetNURBSWeight
msgid "Control the influence of each NURBS control point on the curve by changing the \"nurbs_weight\" attribute"
msgstr "Styr varje NURBS-kontrollpunkts påverkan på kurvan genom att ändra attributet ”nurbs_weight”"

#. :src: bpy.types.GeometryNodeSetPointRadius
msgid "Set Point Radius"
msgstr "Inställningspunktsradie"

#. :src: bpy.types.GeometryNodeSetPointRadius
msgid "Set the display size of point cloud points"
msgstr "Ställ in visningsstorleken för punktmolnspunkter"

#. :src: bpy.types.GeometryNodeSetPosition
msgid "Set Position"
msgstr "Ställ in position"

#. :src: bpy.types.GeometryNodeSetPosition
msgid "Set the location of each point"
msgstr "Ange platsen för varje punkt"

#. :src: bpy.types.GeometryNodeSetShadeSmooth
msgid "Set Shade Smooth"
msgstr "Ställ in skugga jämn"

#. :src: bpy.types.GeometryNodeSetShadeSmooth
msgid "Control the smoothness of mesh normals around each face by changing the \"shade smooth\" attribute"
msgstr ""
"Kontrollera jämnheten hos mesh-normaler runt varje yta genom att ändra "
"attributet \"shade smooth\" (skuggjämnhet)"

#. :src: bpy.types.GeometryNodeSetSplineCyclic
msgid "Set Spline Cyclic"
msgstr "Ställ in spline cyklisk"

#. :src: bpy.types.GeometryNodeSetSplineCyclic
msgid "Control whether each spline loops back on itself by changing the \"cyclic\" attribute"
msgstr ""
"Kontrollera om varje spline slingrar sig tillbaka på sig själv genom att "
"ändra attributet \"cyklisk\""

#. :src: bpy.types.GeometryNodeSetSplineResolution
msgid "Set Spline Resolution"
msgstr "Ställ in splineupplösning"

#. :src: bpy.types.GeometryNodeSetSplineResolution
msgid "Control how many evaluated points should be generated on every curve segment"
msgstr ""
"Kontrollera hur många utvärderade punkter som ska genereras på varje "
"kurvsegment"

#. :src: bpy.types.GeometryNodeSimulationInput
msgid "Simulation Input"
msgstr "Simuleringsinmatning"

#. :src: bpy.types.GeometryNodeSimulationInput
msgid "Input data for the simulation zone"
msgstr "Indata för simuleringszonen"

#. :src: bpy.types.GeometryNodeSimulationOutput
msgid "Simulation Output"
msgstr "Simuleringsresultat"

#. :src: bpy.types.GeometryNodeSimulationOutput
msgid "Output data from the simulation zone"
msgstr "Utdata från simuleringszonen"

#. :src: bpy.types.GeometryNodeSortElements
msgid "Sort Elements"
msgstr "Sortera element"

#. :src: bpy.types.GeometryNodeSortElements
msgid "Rearrange geometry elements, changing their indices"
msgstr "Omordna geometrielement och ändra deras index"

#. :src: bpy.types.GeometryNodeSortList
msgid "Sort List"
msgstr "Sortera lista"

#. :src: bpy.types.GeometryNodeSortList
msgid "Sort a list based on weights"
msgstr "Sortera en lista utifrån vikter"

#. :src: bpy.types.GeometryNodeSplineLength
msgid "Spline Length"
msgstr "Spline-längd"

#. :src: bpy.types.GeometryNodeSplineLength
msgid "Retrieve the total length of each spline, as a distance or as a number of points"
msgstr ""
"Hämta den totala längden på varje spline, som ett avstånd eller som ett "
"antal punkter"

#. :src: bpy.types.GeometryNodeSplineParameter
msgid "Spline Parameter"
msgstr "Splineparameter"

#. :src: bpy.types.GeometryNodeSplineParameter
msgid "Retrieve how far along each spline a control point is"
msgstr "Hämta hur långt längs varje spline en kontrollpunkt befinner sig"

#. :src: bpy.types.GeometryNodeSplitEdges
msgid "Split Edges"
msgstr "Delade kanter"

#. :src: bpy.types.GeometryNodeSplitEdges
msgid "Duplicate mesh edges and break connections with the surrounding faces"
msgstr "Duplicera nätkanter och bryt kopplingar med omgivande ytor"

#. :src: bpy.types.GeometryNodeSplitToInstances
msgid "Split to Instances"
msgstr "Dela upp i instanser"

#. :src: bpy.types.GeometryNodeSplitToInstances
msgid "Create separate geometries containing the elements from the same group"
msgstr "Skapa separata geometrier som innehåller elementen från samma grupp"

#. :src: bpy.types.GeometryNodeSplitToInstances.domain
msgid "Attribute domain for the Selection and Group ID inputs"
msgstr "Attributdomän för inmatningarna Selection och Group ID"

#. :src: bpy.types.GeometryNodeStoreNamedAttribute
msgid "Store Named Attribute"
msgstr "Butik med namngivet attribut"

#. :src: bpy.types.GeometryNodeStoreNamedAttribute
msgid "Store the result of a field on a geometry as an attribute with the specified name"
msgstr ""
"Lagra resultatet av ett fält på en geometri som ett attribut med det angivna "
"namnet"

#. :src: bpy.types.GeometryNodeStoreNamedGrid
msgid "Store Named Grid"
msgstr "Butik med namnet Grid"

#. :src: bpy.types.GeometryNodeStoreNamedGrid
msgid "Store grid data in a volume geometry with the specified name"
msgstr "Lagra rutnätsdata i en volymgeometri med det angivna namnet"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type
msgid "Type of grid data"
msgstr "Typ av nätdata"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'FLOAT'
#. :src: bpy.types.VolumeGrid.data_type:'FLOAT'
msgid "Single precision float"
msgstr "Enkel precision flytande"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'DOUBLE'
#. :src: bpy.types.VolumeGrid.data_type:'DOUBLE'
msgid "Double precision"
msgstr "Dubbel precision"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'INT64'
msgid "Integer 64-bit"
msgstr "Heltal 64-bitars"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'INT64'
#. :src: bpy.types.VolumeGrid.data_type:'INT64'
msgid "64-bit integer"
msgstr "64-bitars heltal"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'MASK'
#. :src: bpy.types.VolumeGrid.data_type:'MASK'
msgid "No data, boolean mask of active voxels"
msgstr "Inga data, boolesk mask av aktiva voxlar"

