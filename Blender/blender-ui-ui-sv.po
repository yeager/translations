#. :src: bpy.types.RigifyParameters.register_parent
msgid "Register Parent"
msgstr "Registrera förälder"

#. :src: bpy.types.RigifyParameters.register_parent
msgid "Register the control as a switchable parent candidate"
msgstr "Registrera kontrollen som en omkopplingsbar överordnad kandidat"

#. :src: bpy.types.RigifyParameters.register_parent_tags
msgid "Parent Tags"
msgstr "Föräldrataggar"

#. :src: bpy.types.RigifyParameters.register_parent_tags
msgid "Comma-separated tags to use for the registered parent"
msgstr "Kommaseparerade taggar som ska användas för den registrerade föräldern"

#. :src: bpy.types.RigifyParameters.relink_constraints
msgid "Relink Constraints"
msgstr "Återkoppla begränsningar"

#. :src: bpy.types.RigifyParameters.relink_constraints
msgid "For constraints with names formed like 'base@bonename', use the part after '@' as the new subtarget after all bones are created. Use '@CTRL', '@DEF' or '@MCH' to simply replace the prefix"
msgstr ""
"För begränsningar med namn som bildas som \"base@bonename\" använder du "
"delen efter \"@\" som det nya delmålet efter att alla ben har skapats. "
"Använd \"@CTRL\", \"@DEF\" eller \"@MCH\" för att helt enkelt ersätta "
"prefixet"

#. :src: bpy.types.RigifyParameters.roll_alignment
msgid "Bone roll alignment"
msgstr "Justering av benrullen"

#. :src: bpy.types.RigifyParameters.secondary_coll_refs
#. :src: bpy.types.RigifyParameters.skin_secondary_coll_refs
msgid "Layers for the secondary controls to be on"
msgstr "Lager för sekundära kontroller som ska vara på"

#. :src: bpy.types.RigifyParameters.secondary_layers_extra
msgid "Assign Secondary Collections"
msgstr "Tilldela sekundära samlingar"

#. :src: bpy.types.RigifyParameters.segments
msgid "Limb Segments"
msgstr "Lemdelar"

#. :src: bpy.types.RigifyParameters.segments
msgid "Number of limb segments"
msgstr "Antal lemmar"

#. :src: bpy.types.RigifyParameters.sik_end_controls
msgid "Extra End Controls"
msgstr "Extra slutkontroller"

#. :src: bpy.types.RigifyParameters.sik_end_controls
msgid "Number of extra spline control points attached to the end control"
msgstr "Antal extra spline-kontrollpunkter kopplade till ändkontrollen"

#. :src: bpy.types.RigifyParameters.sik_fk_controls
msgid "Generate an FK control chain for the tentacle"
msgstr "Skapa en FK-kontrollkedja för tentakeln"

#. :src: bpy.types.RigifyParameters.sik_max_radius
msgid "Maximum Radius"
msgstr "Maximal radie"

#. :src: bpy.types.RigifyParameters.sik_max_radius
msgid "Maximum supported scale factor for the spline control bones"
msgstr "Maximal stödd skalningsfaktor för spline-kontrollbenen"

#. :src: bpy.types.RigifyParameters.sik_mid_controls
msgid "Middle Controls"
msgstr "Mellankontroller"

#. :src: bpy.types.RigifyParameters.sik_mid_controls
msgid "Number of spline control points in the middle"
msgstr "Antal spline-kontrollpunkter i mitten"

#. :src: bpy.types.RigifyParameters.sik_radius_scaling
msgid "Radius Scaling"
msgstr "Radiusskalning"

#. :src: bpy.types.RigifyParameters.sik_radius_scaling
msgid "Allow scaling the spline control bones to affect the thickness via curve radius"
msgstr "Tillåt skalning av spline-kontrollbenen för att påverka tjockleken via kurvradien"

#. :src: bpy.types.RigifyParameters.sik_start_controls
msgid "Extra Start Controls"
msgstr "Extra startkontroller"

#. :src: bpy.types.RigifyParameters.sik_start_controls
msgid "Number of extra spline control points attached to the start control"
msgstr "Antal extra spline-kontrollpunkter kopplade till startkontrollen"

#. :src: bpy.types.RigifyParameters.sik_stretch_control
msgid "Tip Control"
msgstr "Tips Kontroll"

#. :src: bpy.types.RigifyParameters.sik_stretch_control
msgid "How the stretching of the tentacle is controlled"
msgstr "Hur tentakelns sträckning styrs"

#. :src: bpy.types.RigifyParameters.sik_stretch_control:'FIT_CURVE'
msgid "Stretch To Fit"
msgstr "Sträck för att passa"

#. :src: bpy.types.RigifyParameters.sik_stretch_control:'FIT_CURVE'
msgid "The tentacle stretches to fit the curve"
msgstr "Tentakeln sträcker sig för att passa kurvan"

#. :src: bpy.types.RigifyParameters.sik_stretch_control:'DIRECT_TIP'
msgid "Direct Tip Control"
msgstr "Direkt tipskontroll"

#. :src: bpy.types.RigifyParameters.sik_stretch_control:'DIRECT_TIP'
msgid "The last bone of the chain is directly controlled, like the hand in an IK arm, and the middle stretches to reach it"
msgstr ""
"Det sista benet i kedjan styrs direkt, precis som handen i en IK-arm, och "
"mitten sträcker sig för att nå det"

#. :src: bpy.types.RigifyParameters.sik_stretch_control:'MANUAL_STRETCH'
msgid "Manual Squash & Stretch"
msgstr "Manuell squash & stretch"

#. :src: bpy.types.RigifyParameters.sik_stretch_control:'MANUAL_STRETCH'
msgid "The tentacle scaling is manually controlled via twist controls."
msgstr "Tentakelns skalning styrs manuellt med hjälp av vridreglage."

#. :src: bpy.types.RigifyParameters.skin_anchor_hide
msgid "Suppress Control"
msgstr "Undertryck kontroll"

#. :src: bpy.types.RigifyParameters.skin_anchor_hide
msgid "Make the control bone a mechanism bone invisible to the user and only affected by constraints"
msgstr ""
"Gör kontrollbenet till ett mekanismben som är osynligt för användaren och "
"endast påverkas av begränsningar"

#. :src: bpy.types.RigifyParameters.skin_chain_connect_ends
msgid "Connect Matching Ends"
msgstr "Anslut matchande ändar"

#. :src: bpy.types.RigifyParameters.skin_chain_connect_ends
msgid "Create a smooth B-Bone transition if an end of the chain meets another chain going in the same direction"
msgstr ""
"Skapa en smidig B-Bone-övergång om ena änden av kedjan möter en annan kedja "
"som går i samma riktning"

#. :src: bpy.types.RigifyParameters.skin_chain_connect_mirror
msgid "Connect With Mirror"
msgstr "Anslut med Mirror"

#. :src: bpy.types.RigifyParameters.skin_chain_connect_mirror
msgid "Create a smooth B-Bone transition if an end of the chain meets its mirror"
msgstr ""
"Skapa en smidig B-Bone-övergång om ena änden av kedjan möter sin spegelbild"

#. :src: bpy.types.RigifyParameters.skin_chain_connect_sharp_angle
msgid "Sharpen Corner"
msgstr "Skärpa hörn"

#. :src: bpy.types.RigifyParameters.skin_chain_connect_sharp_angle
msgid "Create a mechanism to sharpen a connected corner when the angle is below this value"
msgstr ""
"Skapa en mekanism för att vässa ett anslutet hörn när vinkeln är mindre än "
"detta värde"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff
msgid "Control Falloff"
msgstr "Kontroll av avklingning"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff
msgid "Falloff curve coefficient: 0 is linear, and higher value is wider influence. Set to -10 to disable influence completely"
msgstr ""
"Falloff-kurvkoefficient: 0 är linjärt, och högre värden ger större påverkan. "
"Ställ in på -10 för att inaktivera påverkan helt"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_length
msgid "Falloff Along Chain Curve"
msgstr "Falloff längs kedjekurvan"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_length
msgid "Falloff is computed along the curve of the chain, instead of projecting on the axis connecting the start and end points"
msgstr ""
"Falloff beräknas längs kedjans kurva, istället för att projiceras på axeln "
"som förbinder start- och slutpunkterna"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_scale
msgid "Propagate Scale"
msgstr "Föröka skala"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_scale
msgid "Propagate scale from main controls throughout the chain"
msgstr "Sprid skala från huvudkontroller genom hela kedjan"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_spherical
msgid "Spherical Falloff"
msgstr "Sfärisk avklingning"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_spherical
msgid "Falloff curve tries to form a circle at +1 instead of a parabola"
msgstr "Falloff-kurvan försöker bilda en cirkel vid +1 istället för en parabel"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_to_controls
msgid "Propagate To Controls"
msgstr "Sprid till kontroller"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_to_controls
msgid "Expose scale and/or twist propagated to tweak controls to be seen as parent motion by glue or other chains using Merge Parent Rotation And Scale. Otherwise it is only propagated internally within this chain"
msgstr ""
"Exponera skala och/eller vridning som sprids till justeringskontroller för "
"att ses som överordnad rörelse av lim eller andra kedjor med hjälp av Merge "
"Parent Rotation And Scale. Annars sprids det endast internt inom denna kedja"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_twist
msgid "Propagate Twist"
msgstr "Propagera Twist"

#. :src: bpy.types.RigifyParameters.skin_chain_falloff_twist
msgid "Propagate twist from main controls throughout the chain"
msgstr "Sprid vridningen från huvudkontrollerna genom hela kedjan"

#. :src: bpy.types.RigifyParameters.skin_chain_pivot_pos
msgid "Middle Control Position"
msgstr "Mittre kontrollposition"

#. :src: bpy.types.RigifyParameters.skin_chain_pivot_pos
msgid "Position of the middle control, disabled if zero"
msgstr "Mittkontrollens läge, inaktiverad om noll"

#. :src: bpy.types.RigifyParameters.skin_chain_priority
msgid "Chain Priority"
msgstr "Kedjeprioritet"

#. :src: bpy.types.RigifyParameters.skin_chain_priority
msgid "When merging controls, chains with higher priority always win"
msgstr ""
"Vid sammanslagning av kontroller vinner alltid kedjor med högre prioritet"

#. :src: bpy.types.RigifyParameters.skin_chain_use_reparent
msgid "Merge Parent Rotation And Scale"
msgstr "Slå ihop överordnad rotation och skala"

#. :src: bpy.types.RigifyParameters.skin_chain_use_reparent
msgid "When controls are merged into ones owned by other chains, include parent-induced rotation/scale difference into handle motion. Otherwise only local motion of the control bone is used"
msgstr ""
"När kontroller slås samman med sådana som ägs av andra kedjor, inkludera "
"rotations-/skalningsskillnader som orsakas av överordnade element i "
"handtagsrörelsen. Annars används endast den lokala rörelsen hos kontrollbenet"

#. :src: bpy.types.RigifyParameters.skin_chain_use_scale
msgid "Use Handle Scale"
msgstr "Använd handtagsskalan"

#. :src: bpy.types.RigifyParameters.skin_chain_use_scale
msgid "Use control scaling to scale the B-Bone"
msgstr "Använd kontrollskalning för att skala B-Bone"

#. :src: bpy.types.RigifyParameters.skin_control_orientation_bone
msgid "Orientation Bone"
msgstr "Orientering Ben"

#. :src: bpy.types.RigifyParameters.skin_control_orientation_bone
msgid "If set, control orientation is taken from the specified bone"
msgstr "Om inställd, hämtas kontrollorienteringen från det angivna benet"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint
msgid "Add Constraint"
msgstr "Lägg till begränsning"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint
msgid "Add one of the common constraints linking the control to the tail target"
msgstr ""
"Lägg till en av de vanliga begränsningarna som kopplar kontrollen till "
"svansmålet"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint:'NONE'
msgid "No New Constraint"
msgstr "Inga nya begränsningar"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint:'NONE'
msgid "Don't add new constraints"
msgstr "Lägg inte till nya begränsningar"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint:'COPY_LOCATION'
msgid "Copy Location (Local)"
msgstr "Kopiera plats (lokalt)"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint:'COPY_LOCATION'
msgid "Add a constraint to copy Local Location with Offset. If the owner and target control rest orientations are different, the global movement direction will change accordingly"
msgstr ""
"Lägg till en begränsning för att kopiera lokal placering med förskjutning. "
"Om ägarens och målkontrollens vilolägen är olika kommer den globala "
"rörelseriktningen att ändras i enlighet med detta"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint:'COPY_LOCATION_OWNER'
msgid "Copy Location (Local, Owner Orientation)"
msgstr "Kopiera plats (lokal, ägarorientering)"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint:'COPY_LOCATION_OWNER'
msgid "Add a constraint to copy Local Location (Owner Orientation) with Offset. Even if the owner and target controls have different rest orientations, the global movement direction would be the same"
msgstr ""
"Lägg till en begränsning för att kopiera lokal placering (ägarorientering) "
"med förskjutning. Även om ägar- och målkontrollerna har olika "
"vilorienteringar skulle den globala rörelseriktningen vara densamma"

#. :src: bpy.types.RigifyParameters.skin_glue_add_constraint_influence
msgid "Influence of the added constraint"
msgstr "Inverkan av den tillagda begränsningen"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode
msgid "Glue Mode"
msgstr "Limningsläge"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode
msgid "Specifies how the glue bone is rigged to the control at the bone head location"
msgstr "Anger hur limbenet är riggat till kontrollen vid benhuvudets placering"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode:'CHILD'
msgid "Child Of Control"
msgstr "Kontrollens barn"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode:'CHILD'
msgid "The glue bone becomes a child of the control bone"
msgstr "Limbenet blir ett barn till kontrollbenet"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode:'MIRROR'
msgid "Mirror Of Control"
msgstr "Spegel av kontroll"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode:'MIRROR'
msgid "The glue bone becomes a sibling of the control bone with Copy Transforms"
msgstr "Limbenet blir ett syskon till kontrollbenet med Kopiera transformationer"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode:'REPARENT'
msgid "Mirror With Parents"
msgstr "Spegel med föräldrar"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode:'REPARENT'
msgid "The glue bone keeps its parent, but uses Copy Transforms to group both local and parent induced motion of the control into local space"
msgstr ""
"Limbenet behåller sin överordnade, men använder Copy Transforms för att "
"gruppera både lokal och överordnad inducerad rörelse av kontrollen i det "
"lokala utrymmet"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode:'BRIDGE'
msgid "Deformation Bridge"
msgstr "Deformationsbro"

#. :src: bpy.types.RigifyParameters.skin_glue_head_mode:'BRIDGE'
msgid "Other than adding glue constraints to the control, the rig acts as a one segment basic deform chain"
msgstr ""
"Förutom att lägga till limbegränsningar till kontrollen fungerar riggen som "
"en enkel deformationskedja med ett segment"

#. :src: bpy.types.RigifyParameters.skin_glue_tail_reparent
msgid "Target Local With Parents"
msgstr "Rikta in dig lokalt med föräldrar"

#. :src: bpy.types.RigifyParameters.skin_glue_tail_reparent
msgid "Include transformations induced by target parents into target local space"
msgstr "Inkludera transformationer inducerade av målföräldrar i målets lokala rum"

#. :src: bpy.types.RigifyParameters.skin_glue_use_tail
msgid "Use Tail Target"
msgstr "Använd Tail Target"

#. :src: bpy.types.RigifyParameters.skin_glue_use_tail
msgid "Find the control at the bone tail location and use it to relink TARGET or any constraints without an assigned subtarget or relink spec"
msgstr ""
"Hitta kontrollen vid benets ändpunkt och använd den för att återkoppla "
"TARGET eller eventuella begränsningar utan tilldelat delmål eller "
"återkopplingsspecifikation"

#. :src: bpy.types.RigifyParameters.skin_primary_layers_extra
msgid "Primary Control Layers"
msgstr "Primära kontrollnivåer"

#. :src: bpy.types.RigifyParameters.skin_secondary_layers_extra
msgid "Secondary Control Layers"
msgstr "Sekundära kontrollskikt"

#. :src: bpy.types.RigifyParameters.tail_pos
msgid "Tail Position"
msgstr "Svansens position"

#. :src: bpy.types.RigifyParameters.tail_pos
msgid "Where the tail starts"
msgstr "Var svansen börjar"

#. :src: bpy.types.RigifyParameters.tweak_axis
msgid "Orient y-axis to"
msgstr "Orientera y-axeln mot"

#. :src: bpy.types.RigifyParameters.tweak_axis
msgid "Targets all ctrls y-axis to defined axis (global space)"
msgstr "Riktar alla ctrls y-axlar mot definierad axel (globalt utrymme)"

#. :src: bpy.types.RigifyParameters.tweak_axis:'x'
msgid "X-Global"
msgstr "X-Global"

#. :src: bpy.types.RigifyParameters.tweak_axis:'y'
msgid "Y-Global"
msgstr "Y-Global"

#. :src: bpy.types.RigifyParameters.tweak_axis:'z'
msgid "Z-Global"
msgstr "Z-Global"

#. :src: bpy.types.RigifyParameters.tweak_coll_refs
msgid "Layers for the tweak controls to be on"
msgstr "Lager för justeringskontrollerna ska vara på"

