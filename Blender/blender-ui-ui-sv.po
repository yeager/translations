msgstr "Ljusets riktning för skuggor och högdagrar"

#. :src: bpy.types.SceneDisplay.matcap_ssao_attenuation
msgid "Attenuation constant"
msgstr "Dämpningskonstant"

#. :src: bpy.types.SceneDisplay.matcap_ssao_distance
msgid "Distance of object that contribute to the cavity/edge effect"
msgstr "Avstånd till objekt som bidrar till kavitets-/kanteffekten"

#. :src: bpy.types.SceneDisplay.matcap_ssao_samples
msgid "Number of samples"
msgstr "Antal sampel"

#. :src: bpy.types.SceneDisplay.render_aa
msgid "Render Anti-Aliasing"
msgstr "Rendera kantutjämning"

#. :src: bpy.types.SceneDisplay.render_aa
msgid "Method of anti-aliasing when rendering final image"
msgstr "Metod för anti-aliasing vid rendering av slutlig bild"

#. :src: bpy.types.SceneDisplay.shading
#. :src: bpy.types.SpaceView3D.shading
#. :src: bpy.types.XrSessionSettings.shading
msgid "Shading Settings"
msgstr "Inställningar för skuggning"

#. :src: bpy.types.SceneDisplay.shading
msgid "Shading settings for OpenGL render engine"
msgstr "Skugginställningar för OpenGL-renderingsmotor"

#. :src: bpy.types.SceneDisplay.shadow_focus
msgid "Shadow Focus"
msgstr "Skuggfokus"

#. :src: bpy.types.SceneDisplay.shadow_focus
msgid "Shadow factor hardness"
msgstr "Skuggfaktorhårdhet"

#. :src: bpy.types.SceneDisplay.shadow_shift
msgid "Shadow Shift"
msgstr "Skuggförskjutning"

#. :src: bpy.types.SceneDisplay.shadow_shift
msgid "Shadow termination angle"
msgstr "Skugganslutningsvinkel"

#. :src: bpy.types.SceneDisplay.viewport_aa
msgid "Method of anti-aliasing when rendering 3d viewport"
msgstr "Metod för anti-aliasing vid rendering av 3D-viewport"

#. :src: bpy.types.SceneEEVEE.bokeh_max_size
msgid "Max Size"
msgstr "Maximal storlek"

#. :src: bpy.types.SceneEEVEE.bokeh_max_size
msgid "Max size of the bokeh shape for the depth of field (lower is faster)"
msgstr "Maximal storlek på bokeh-formen för skärpedjupet (lägre är snabbare)"

#. :src: bpy.types.SceneEEVEE.bokeh_neighbor_max
msgid "Neighbor Rejection"
msgstr "Naboavvisande"

#. :src: bpy.types.SceneEEVEE.bokeh_neighbor_max
msgid "Maximum brightness to consider when rejecting bokeh sprites based on neighborhood (lower is faster)"
msgstr "Maximal ljusstyrka att beakta vid avvisande av bokeh-sprites baserat på närhet (lägre är snabbare)"

#. :src: bpy.types.SceneEEVEE.bokeh_overblur
msgid "Over-blur"
msgstr "Överblurring"

#. :src: bpy.types.SceneEEVEE.bokeh_overblur
msgid "Apply blur to each jittered sample to reduce under-sampling artifacts"
msgstr ""
"Tillämpa oskärpa på varje jitterat prov för att minska artefakter från "
"undersamplingen"

#. :src: bpy.types.SceneEEVEE.bokeh_threshold
msgid "Sprite Threshold"
msgstr "Sprite-tröskelvärde"

#. :src: bpy.types.SceneEEVEE.bokeh_threshold
msgid "Brightness threshold for using sprite base depth of field"
msgstr "Ljusstyrketröskel för användning av spritebaserat skärpedjup"

#. :src: bpy.types.SceneEEVEE.clamp_surface_direct
msgid "Clamp Surface Direct"
msgstr "Klämyta Direkt"

#. :src: bpy.types.SceneEEVEE.clamp_surface_direct
msgid "If non-zero, the maximum value for lights contribution on a surface. Higher values will be scaled down to avoid too much noise and slow convergence at the cost of accuracy. Used by light objects."
msgstr "Om värdet är större än noll, det maximala värdet för ljusets bidrag på en yta. Högre värden skalas ned för att undvika för mycket brus och långsam konvergens på bekostnad av noggrannheten. Används av ljusobjekt."

#. :src: bpy.types.SceneEEVEE.clamp_surface_indirect
msgid "Clamp Surface Indirect"
msgstr "Klämyta indirekt"

#. :src: bpy.types.SceneEEVEE.clamp_surface_indirect
msgid "If non-zero, the maximum value for indirect lighting on surface. Higher values will be scaled down to avoid too much noise and slow convergence at the cost of accuracy. Used by ray-tracing and light-probes."
msgstr "Om värdet är större än noll, det maximala värdet för indirekt belysning på ytan. Högre värden skalas ned för att undvika för mycket brus och långsam konvergens på bekostnad av noggrannheten. Används av strålspårning och ljusprober."

#. :src: bpy.types.SceneEEVEE.clamp_volume_direct
msgid "Clamp Volume Direct"
msgstr "Klämvolym Direkt"

#. :src: bpy.types.SceneEEVEE.clamp_volume_direct
msgid "If non-zero, the maximum value for lights contribution in volumes. Higher values will be scaled down to avoid too much noise and slow convergence at the cost of accuracy. Used by light objects."
msgstr "Om värdet är större än noll, det maximala värdet för ljusets bidrag i volymer. Högre värden skalas ned för att undvika för mycket brus och långsam konvergens på bekostnad av noggrannheten. Används av ljusobjekt."

#. :src: bpy.types.SceneEEVEE.clamp_volume_indirect
msgid "Clamp Volume Indirect"
msgstr "Klämvolym indirekt"

#. :src: bpy.types.SceneEEVEE.clamp_volume_indirect
msgid "If non-zero, the maximum value for indirect lighting in volumes. Higher values will be scaled down to avoid too much noise and slow convergence at the cost of accuracy. Used by light-probes."
msgstr "Om inte noll, det maximala värdet för indirekt belysning i volymer. Högre värden skalas ned för att undvika för mycket brus och långsam konvergens på bekostnad av noggrannheten. Används av ljusprober."

#. :src: bpy.types.SceneEEVEE.direct_light_intensity
msgid "Direct Light Strength"
msgstr "Direkt ljusstyrka"

#. :src: bpy.types.SceneEEVEE.direct_light_intensity
msgid "Scale the contribution of direct lighting"
msgstr "Skala bidraget från direkt belysning"

#. :src: bpy.types.SceneEEVEE.fast_gi_bias
#: scripts/startup/bl_ui/properties_data_lightprobe.py:156
#: scripts/startup/bl_ui/properties_render.py:503
#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:72
#: source/blender/nodes/texture/nodes/node_texture_bricks.cc:22
msgid "Bias"
msgstr "Partiskhet"

#. :src: bpy.types.SceneEEVEE.fast_gi_bias
msgid "Bias the shading normal to reduce self intersection artifacts"
msgstr ""
"Förskjut skuggningen normalt för att minska artefakter från självkorsningar"

#. :src: bpy.types.SceneEEVEE.fast_gi_distance
msgid "If non-zero, the maximum distance at which other surfaces will contribute to the fast GI approximation"
msgstr ""
"Om värdet är större än noll, det maximala avståndet vid vilket andra ytor "
"bidrar till den snabba GI-approximationen"

#. :src: bpy.types.SceneEEVEE.fast_gi_method:'AMBIENT_OCCLUSION_ONLY'
msgid "Use ambient occlusion instead of full global illumination"
msgstr "Använd omgivande ocklusion istället för full global belysning"

#. :src: bpy.types.SceneEEVEE.fast_gi_method:'GLOBAL_ILLUMINATION'
msgid "Global Illumination"
msgstr "Global belysning"

#. :src: bpy.types.SceneEEVEE.fast_gi_method:'GLOBAL_ILLUMINATION'
msgid "Compute global illumination taking into account light bouncing off surrounding objects"
msgstr ""
"Beräkna global belysning med hänsyn till ljus som reflekteras från omgivande "
"objekt"

#. :src: bpy.types.SceneEEVEE.fast_gi_quality
msgid "Trace Precision"
msgstr "Spårprecision"

#. :src: bpy.types.SceneEEVEE.fast_gi_quality
msgid "Precision of the fast GI ray marching"
msgstr "Precisionen hos den snabba GI-strålmarschen"

#. :src: bpy.types.SceneEEVEE.fast_gi_ray_count
msgid "Ray Count"
msgstr "Strålningsräkning"

#. :src: bpy.types.SceneEEVEE.fast_gi_ray_count
msgid "Amount of GI ray to trace for each pixel"
msgstr "Mängd GI-strålning som ska spåras för varje pixel"

#. :src: bpy.types.SceneEEVEE.fast_gi_resolution
msgid "Control the quality of the fast GI lighting. Higher resolution uses more memory."
msgstr "Kontrollera kvaliteten på den snabba GI-belysningen. Högre upplösning använder mer minne."

#. :src: bpy.types.SceneEEVEE.fast_gi_step_count
msgid "Step Count"
msgstr "Stegräknare"

#. :src: bpy.types.SceneEEVEE.fast_gi_step_count
msgid "Amount of screen sample per GI ray"
msgstr "Mängd skärmprov per GI-stråle"

#. :src: bpy.types.SceneEEVEE.fast_gi_thickness_near
msgid "Geometric thickness of the surfaces when computing fast GI and ambient occlusion. Reduces light leaking and missing contact occlusion."
msgstr "Geometrisk tjocklek på ytorna vid beräkning av snabb GI och omgivande ocklusion. Minskar ljusläckage och saknad kontaktocklusion."

#. :src: bpy.types.SceneEEVEE.gi_cubemap_resolution
msgid "Cubemap Size"
msgstr "Kubkarta storlek"

#. :src: bpy.types.SceneEEVEE.gi_cubemap_resolution
msgid "Size of every cubemaps"
msgstr "Storlek på varje kubkarta"

#. :src: bpy.types.SceneEEVEE.gi_cubemap_resolution:'128'
msgid "128 px"
msgstr "128 px"

#. :src: bpy.types.SceneEEVEE.gi_cubemap_resolution:'256'
msgid "256 px"
msgstr "256 px"

#. :src: bpy.types.SceneEEVEE.gi_cubemap_resolution:'512'
msgid "512 px"
msgstr "512 px"

#. :src: bpy.types.SceneEEVEE.gi_cubemap_resolution:'1024'
msgid "1024 px"
msgstr "1024 px"

#. :src: bpy.types.SceneEEVEE.gi_cubemap_resolution:'2048'
msgid "2048 px"
msgstr "2048 px"

#. :src: bpy.types.SceneEEVEE.gi_cubemap_resolution:'4096'
msgid "4096 px"
msgstr "4096 px"

#. :src: bpy.types.SceneEEVEE.gi_diffuse_bounces
msgid "Number of times the light is reinjected inside light grids, 0 disable indirect diffuse light"
msgstr "Antal gånger ljuset återinförs i ljusrutnät, 0 inaktivera indirekt diffust ljus"

#. :src: bpy.types.SceneEEVEE.gi_glossy_clamp
msgid "Clamp Glossy"
msgstr "Klämma Glansig"

#. :src: bpy.types.SceneEEVEE.gi_glossy_clamp
msgid "Clamp pixel intensity to reduce noise inside glossy reflections from reflection cubemaps (0 to disable)"
msgstr "Begränsa pixelintensiteten för att minska bruset i glansiga reflektioner från reflektionskubkartor (0 för att inaktivera)"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size
msgid "Irradiance Pool Size"
msgstr "Irradians Poolstorlek"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size
msgid "Size of the irradiance pool, a bigger pool size allows for more irradiance grid in the scene but might not fit into GPU memory and decrease performance"
msgstr ""
"Storleken på irradianspoolen. En större pool möjliggör fler irradiansrutnät "
"i scenen, men kanske inte får plats i GPU-minnet och minskar prestandan"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size:'16'
#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'16'
msgid "16 MB"
msgstr "16 MB"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size:'32'
#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'32'
msgid "32 MB"
msgstr "32 MB"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size:'64'
#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'64'
msgid "64 MB"
msgstr "64 MB"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size:'128'
#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'128'
msgid "128 MB"
msgstr "128 MB"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size:'256'
#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'256'
msgid "256 MB"
msgstr "256 MB"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size:'512'
#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'512'
msgid "512 MB"
msgstr "512 MB"

#. :src: bpy.types.SceneEEVEE.gi_irradiance_pool_size:'1024'
#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'1024'
msgid "1 GB"
msgstr "1 GB"

#. :src: bpy.types.SceneEEVEE.gi_visibility_resolution
msgid "Irradiance Visibility Size"
msgstr "Irradians Synlighet Storlek"

#. :src: bpy.types.SceneEEVEE.gi_visibility_resolution
msgid "Size of the shadow map applied to each irradiance sample"
msgstr "Storleken på skuggkartan som tillämpas på varje irradiansprov"

#. :src: bpy.types.SceneEEVEE.gi_visibility_resolution:'8'
msgid "8 px"
msgstr "8 px"

#. :src: bpy.types.SceneEEVEE.gi_visibility_resolution:'16'
msgid "16 px"
msgstr "16 px"

#. :src: bpy.types.SceneEEVEE.gi_visibility_resolution:'32'
msgid "32 px"
msgstr "32 px"

#. :src: bpy.types.SceneEEVEE.gi_visibility_resolution:'64'
msgid "64 px"
msgstr "64 px"

#. :src: bpy.types.SceneEEVEE.indirect_light_intensity
msgid "Indirect Light Strength"
msgstr "Indirekt ljusstyrka"

#. :src: bpy.types.SceneEEVEE.indirect_light_intensity
msgid "Scale the contribution of indirect lighting"
msgstr "Skala bidraget från indirekt belysning"

#. :src: bpy.types.SceneEEVEE.light_threshold
#: scripts/addons_core/cycles/ui.py:540
msgid "Light Threshold"
msgstr "Ljuströskel"

#. :src: bpy.types.SceneEEVEE.light_threshold
msgid "Minimum light intensity for a light to contribute to the lighting"
msgstr "Minsta ljusintensitet för att en lampa ska bidra till belysningen"

#. :src: bpy.types.SceneEEVEE.motion_blur_depth_scale
msgid "Bleeding Bias"
msgstr "Blödningsbias"

#. :src: bpy.types.SceneEEVEE.motion_blur_depth_scale
msgid "Lower values will reduce background bleeding onto foreground elements"
msgstr "Lägre värden minskar bakgrundsblödningen på förgrundselementen"

#. :src: bpy.types.SceneEEVEE.motion_blur_max
msgid "Maximum blur distance a pixel can spread over"
msgstr "Maximal oskärpaavstånd som en pixel kan sprida sig över"

#. :src: bpy.types.SceneEEVEE.motion_blur_steps
msgid "Motion steps"
msgstr "Rörelsesteg"

#. :src: bpy.types.SceneEEVEE.motion_blur_steps
msgid "Controls accuracy of motion blur, more steps means longer render time"
msgstr "Kontrollerar noggrannheten för rörelseoskärpa, fler steg innebär längre renderningstid"

#. :src: bpy.types.SceneEEVEE.overscan_size
msgid "Overscan Size"
msgstr "Överskanningsstorlek"

#. :src: bpy.types.SceneEEVEE.overscan_size
msgid "Percentage of render size to add as overscan to the internal render buffers"
msgstr "Procentandel av renderingsstorlek som ska läggas till som överskanning till de interna renderingsbuffertarna"

#. :src: bpy.types.SceneEEVEE.ray_tracing_method
msgid "Tracing Method"
msgstr "Spårningsmetod"

#. :src: bpy.types.SceneEEVEE.ray_tracing_method
msgid "Select the tracing method used to find scene-ray intersections"
msgstr ""
"Välj den spårningsmetod som används för att hitta skärningspunkter mellan "
"scenstrålar"

#. :src: bpy.types.SceneEEVEE.ray_tracing_method:'PROBE'
msgid "Use light probes to find scene intersection"
msgstr "Använd ljussonder för att hitta skärningspunkten mellan scener"

#. :src: bpy.types.SceneEEVEE.ray_tracing_method:'SCREEN'
msgid "Screen-Trace"
msgstr "Skärmspårning"

#. :src: bpy.types.SceneEEVEE.ray_tracing_method:'SCREEN'
msgid "Raytrace against the depth buffer. Fallback to light probes for invalid rays."
msgstr "Raytrace mot djupbuffert. Fallback till ljusprober för ogiltiga strålar."

#. :src: bpy.types.SceneEEVEE.ray_tracing_options
msgid "Reflection Trace Options"
msgstr "Alternativ för reflektionsspårning"

#. :src: bpy.types.SceneEEVEE.ray_tracing_options
msgid "EEVEE settings for tracing reflections"
msgstr "EEVEE-inställningar för spårning av reflektioner"

#. :src: bpy.types.SceneEEVEE.shadow_pool_size
msgid "Shadow Pool Size"
msgstr "Skuggpoolens storlek"

#. :src: bpy.types.SceneEEVEE.shadow_pool_size
msgid "Size of the shadow pool, a bigger pool size allows for more shadows in the scene but might not fit into GPU memory"
msgstr ""
"Storleken på skuggpoolen. En större pool gör det möjligt att ha fler skuggor "
"i scenen, men kanske inte får plats i GPU-minnet"

#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'1536'
msgid "1.5 GB"
msgstr "1,5 GB"

#. :src: bpy.types.SceneEEVEE.shadow_pool_size:'2048'
msgid "2 GB"
msgstr "2 GB"

#. :src: bpy.types.SceneEEVEE.shadow_ray_count
msgid "Shadow Ray Count"
msgstr "Skuggråstråleantal"

#. :src: bpy.types.SceneEEVEE.shadow_ray_count
msgid "Amount of shadow ray to trace for each light"
msgstr "Mängd skuggråder som ska spåras för varje ljus"

#. :src: bpy.types.SceneEEVEE.shadow_resolution_scale
msgid "Shadows Resolution Scale"
msgstr "Skuggupplösningsskala"

#. :src: bpy.types.SceneEEVEE.shadow_resolution_scale
msgid "Resolution percentage of shadow maps"
msgstr "Upplösningsprocent för skuggkartor"

#. :src: bpy.types.SceneEEVEE.shadow_step_count
msgid "Shadow Step Count"
msgstr "Skuggstegräkning"

#. :src: bpy.types.SceneEEVEE.shadow_step_count
msgid "Amount of shadow map sample per shadow ray"
msgstr "Mängd skuggkarta-prov per skuggestråle"

#. :src: bpy.types.SceneEEVEE.taa_render_samples
msgid "Render Samples"
msgstr "Rendera exempel"

#. :src: bpy.types.SceneEEVEE.taa_render_samples
msgid "Number of samples per pixel for rendering"
msgstr "Antal sampel per pixel för rendering"

#. :src: bpy.types.SceneEEVEE.taa_samples
msgid "Number of samples, unlimited if 0"
msgstr "Antal sampel, obegränsat om 0"

#. :src: bpy.types.SceneEEVEE.time_limit
msgid "Limit the render time. Zero disables the limit."
msgstr "Begränsa renderingstiden. Noll inaktiverar begränsningen."

#. :src: bpy.types.SceneEEVEE.use_bokeh_jittered
#: scripts/startup/bl_ui/properties_render.py:316
msgid "Jitter Camera"
msgstr "Jitterkamera"

#. :src: bpy.types.SceneEEVEE.use_bokeh_jittered
msgid "Jitter camera position to create accurate blurring using render samples (only for final render)"
msgstr "Skaka kamerapositionen för att skapa exakt oskärpa med hjälp av renderingsprover (endast för slutlig rendering)"

#. :src: bpy.types.SceneEEVEE.use_fast_gi
msgid "Use faster global illumination technique for high roughness surfaces"
msgstr "Använd snabbare global belysningsteknik för ytor med hög grovhet"

#. :src: bpy.types.SceneEEVEE.use_overscan
msgid "Internally render past the image border to avoid screen-space effects disappearing"
msgstr ""
"Rendera internt utanför bildens kant för att undvika att "
"skärmutrymmeeffekter försvinner"

#. :src: bpy.types.SceneEEVEE.use_raytracing
msgid "Use Ray-Tracing"
msgstr "Använd Ray-Tracing"

#. :src: bpy.types.SceneEEVEE.use_raytracing
msgid "Enable the ray-tracing module"
msgstr "Aktivera ray-tracing-modulen"

#. :src: bpy.types.SceneEEVEE.use_shadow_jitter_viewport
msgid "Jittered Shadows (Viewport)"
msgstr "Jitterade skuggor (viewport)"

#. :src: bpy.types.SceneEEVEE.use_shadow_jitter_viewport
msgid "Enable jittered shadows on the viewport. (Jittered shadows are always enabled for final renders)."
msgstr "Aktivera jitterade skuggor i visningsfönstret. (Jitterade skuggor är alltid aktiverade för slutliga renderingar)."

#. :src: bpy.types.SceneEEVEE.use_shadows
msgid "Enable shadow casting from lights"
msgstr "Aktivera skuggkastning från lampor"

#. :src: bpy.types.SceneEEVEE.use_taa_reprojection
msgid "Viewport Denoising"
msgstr "Bildrutans brusreducering"

#. :src: bpy.types.SceneEEVEE.use_taa_reprojection
msgid "Denoise image using temporal reprojection (can leave some ghosting)"
msgstr "Brusreducering av bild med hjälp av tidsmässig reprojicering (kan lämna vissa spökbilder)"

#. :src: bpy.types.SceneEEVEE.use_volume_custom_range
msgid "Volume Custom Range"
msgstr "Volym Anpassat intervall"

#. :src: bpy.types.SceneEEVEE.use_volume_custom_range
msgid "Enable custom start and end clip distances for volume computation"
msgstr "Aktivera anpassade start- och slutavstånd för volymberäkning"

#. :src: bpy.types.SceneEEVEE.use_volumetric_shadows
msgid "Volumetric Shadows"
msgstr "Volymetriska skuggor"

#. :src: bpy.types.SceneEEVEE.use_volumetric_shadows
msgid "Cast shadows from volumetric materials onto volumetric materials (Very expensive)"
msgstr "Kasta skuggor från volymetriska material på volymetriska material (mycket dyrt)"

#. :src: bpy.types.SceneEEVEE.volumetric_end
msgid "End distance of the volumetric effect"
msgstr "Volymverkets slutavstånd"

#. :src: bpy.types.SceneEEVEE.volumetric_light_clamp
msgid "Maximum light contribution, reducing noise"
msgstr "Maximal ljusinsläpp, minskar brus"

#. :src: bpy.types.SceneEEVEE.volumetric_ray_depth
msgid "Volume Max Ray Depth"
msgstr "Volym Max strålningsdjup"

#. :src: bpy.types.SceneEEVEE.volumetric_ray_depth
msgid "Maximum surface intersection count used by the accurate volume intersection method. Will create artifact if it is exceeded. Higher count increases VRAM usage."
msgstr "Maximalt antal ytors skärningspunkter som används av den exakta volymskärningsmetoden. Skapar artefakter om det överskrids. Högre antal ökar VRAM-användningen."

#. :src: bpy.types.SceneEEVEE.volumetric_sample_distribution
msgid "Exponential Sampling"
msgstr "Exponentiell sampling"

#. :src: bpy.types.SceneEEVEE.volumetric_sample_distribution
msgid "Distribute more samples closer to the camera"
msgstr "Distribuera fler sampel närmare kameran"

#. :src: bpy.types.SceneEEVEE.volumetric_samples
msgid "Number of steps to compute volumetric effects. Higher step count increase VRAM usage and quality."
msgstr "Antal steg för att beräkna volymetriska effekter. Ett högre antal steg ökar VRAM-användningen och kvaliteten."

#. :src: bpy.types.SceneEEVEE.volumetric_shadow_samples
msgid "Volumetric Shadow Samples"
msgstr "Volymetriska skuggprover"

#. :src: bpy.types.SceneEEVEE.volumetric_shadow_samples
msgid "Number of samples to compute volumetric shadowing"
msgstr "Antal sampel för beräkning av volymskuggning"

#. :src: bpy.types.SceneEEVEE.volumetric_start
msgid "Start distance of the volumetric effect"
msgstr "Startavstånd för den volymetriska effekten"

#. :src: bpy.types.SceneEEVEE.volumetric_tile_size
msgid "Control the quality of the volumetric effects. Higher resolution uses more memory."
msgstr "Kontrollera kvaliteten på de volymetriska effekterna. Högre upplösning använder mer minne."

#. :src: bpy.types.SceneGpencil
msgid "Grease Pencil Render"
msgstr "Grease Pencil-rendering"

#. :src: bpy.types.SceneGpencil
msgid "Render settings"
msgstr "Renderinginställningar"

#. :src: bpy.types.SceneGpencil.aa_samples
msgid "Anti-Aliasing Samples"
msgstr "Exempel på anti-aliasing"

#. :src: bpy.types.SceneGpencil.aa_samples
msgid "Number of supersampling anti-aliasing samples per pixel for final render"
msgstr "Antal supersampling-anti-aliasing-samplingar per pixel för slutlig rendering"

#. :src: bpy.types.SceneGpencil.antialias_threshold
msgid "SMAA Threshold Viewport"
msgstr "SMAA-tröskelvärde för visningsvy"

#. :src: bpy.types.SceneGpencil.antialias_threshold
msgid "Threshold for edge detection algorithm (higher values might over-blur some part of the image)"
msgstr "Tröskelvärde för kantdetekteringsalgoritm (högre värden kan göra att vissa delar av bilden blir för suddiga)"

#. :src: bpy.types.SceneGpencil.antialias_threshold_render
msgid "SMAA Threshold Render"
msgstr "SMAA-tröskelvärde"

#. :src: bpy.types.SceneGpencil.antialias_threshold_render
msgid "Threshold for edge detection algorithm (higher values might over-blur some part of the image). Only applies to final render"
