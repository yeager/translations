msgid "Segment Coordinates"
msgstr "Segmentkoordinater"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:33
msgid "Segment ID"
msgstr "Segment-ID"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:38
msgid "Segment Width"
msgstr "Segmentbredd"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:43
msgid "Segment Rotation"
msgstr "Segmentrotation"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:32
msgid "Segment coordinates for texture mapping within each angular segment"
msgstr "Segmentkoordinater för texturmappning inom varje vinkelsegment"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:35
msgid "Unique ID for every angular segment starting at 0 and increasing counterclockwise by 1"
msgstr "Unikt ID för varje vinkelsegment som börjar på 0 och ökar moturs med 1"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:40
msgid "Relative width of each angular segment. May be used to scale textures to fit into each segment"
msgstr ""
"Relativ bredd för varje vinkelsegment. Kan användas för att skala texturer "
"så att de passar in i varje segment"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:45
msgid "Counterclockwise rotation of each segment coordinates system. May be used to align the rotation of the textures of each segment"
msgstr ""
"Moturs rotation av varje segments koordinatsystem. Kan användas för att "
"justera rotationen av texturerna för varje segment"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:52
msgid "Input texture coordinates"
msgstr "Ange texturkoordinater"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:57
msgid "Number of angular segments for tiling. A non-integer value results in an irregular segment"
msgstr ""
"Antal vinkelsegment för kakel. Ett icke-heltal resulterar i ett oregelbundet "
"segment"

#: source/blender/nodes/shader/nodes/node_shader_radial_tiling.cc:65
msgid "Roundness of the segment coordinates systems"
msgstr "Rundhet hos segmentkoordinatsystemen"

#: source/blender/nodes/shader/nodes/node_shader_raycast.cc:111
msgid "Sample Attributes"
msgstr "Sampla attribut"

#: source/blender/nodes/shader/nodes/node_shader_raycast.cc:138
msgid "Accessing attributes is not supported by EEVEE renderer"
msgstr "Åtkomst till attribut stöds inte av EEVEE-renderaren"

#: source/blender/nodes/shader/nodes/node_shader_raycast.cc:137
msgid "Attributes Not Supported"
msgstr "Attribut stöds inte"

#: source/blender/nodes/shader/nodes/node_shader_raycast.cc:42
msgid "Self Hit"
msgstr "Självträff"

#: source/blender/nodes/shader/nodes/node_shader_subsurface_scattering.cc:59
msgid "BSSRDF"
msgstr "BSSRDF"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:46
#: source/blender/nodes/texture/nodes/node_texture_bricks.cc:20
msgid "Mortar"
msgstr "Murbruk"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:56
msgid "Mortar Size"
msgstr "Murbruksstorlek"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:64
msgid "Mortar Smooth"
msgstr "Murbruk Slät"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:80
#: source/blender/nodes/texture/nodes/node_texture_bricks.cc:23
msgid "Brick Width"
msgstr "Tegelstenens bredd"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:86
#: source/blender/nodes/texture/nodes/node_texture_bricks.cc:24
msgid "Row Height"
msgstr "Radhöjd"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:42
msgid "Color of the first reference brick"
msgstr "Färgen på den första referensstenen"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:45
msgid "Color of the second reference brick"
msgstr "Färgen på den andra referensstenen"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:49
msgid "Color of the area between bricks"
msgstr "Färgen på området mellan tegelstenarna"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:55
#: source/blender/nodes/shader/nodes/node_shader_tex_magic.cc:36
msgid "Scale of the texture"
msgstr "Texturens skala"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:61
msgid "Size of the filling between the bricks (known as \"mortar\"). 0 means no mortar"
msgstr ""
"Storleken på fyllningen mellan tegelstenarna (kallas \"murbruk\"). 0 betyder "
"ingen murbruk"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:69
msgid "Blurs/softens the edge between the mortar and the bricks. This can be useful with a texture and displacement textures"
msgstr ""
"Suddar ut/mjukar upp kanten mellan murbruk och tegelstenar. Detta kan vara "
"användbart med texturer och förskjutningstexturer"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:76
msgid "The color variation between Color1 and Color2. Values of -1 and 1 only use one of the two colors. Values in between mix the colors"
msgstr ""
"Färgvariationen mellan Color1 och Color2. Värdena -1 och 1 använder endast "
"en av de två färgerna. Värden däremellan blandar färgerna"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:85
msgid "Ratio of brick's width relative to the texture scale"
msgstr "Förhållandet mellan tegelstenens bredd och texturskalan"

#: source/blender/nodes/shader/nodes/node_shader_tex_brick.cc:91
msgid "Ratio of brick's row height relative to the texture scale"
msgstr "Förhållandet mellan tegelstenens radhöjd och texturskalan"

#: source/blender/nodes/shader/nodes/node_shader_tex_checker.cc:34
msgid "Color of the first checker"
msgstr "Färgen på den första brickan"

#: source/blender/nodes/shader/nodes/node_shader_tex_checker.cc:37
msgid "Color of the second checker"
msgstr "Färgen på den andra brickan"

#: source/blender/nodes/shader/nodes/node_shader_tex_checker.cc:43
msgid ""
"Overall texture scale.\n"
"The scale is a factor of the bounding box of the face divided by the Scale value"
msgstr ""
"Övergripande texturskala.\n"
"Skalan är en faktor av ytans begränsningsram dividerad med värdet Skala"

#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:38
msgid "The coordinates at which Gabor noise will be evaluated. The Z component is ignored in the 2D case"
msgstr ""
"Koordinaterna vid vilka Gabor-bruset kommer att utvärderas. Z-komponenten "
"ignoreras i 2D-fallet"

#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:44
msgid "The scale of the Gabor noise"
msgstr "Skalan för Gabor-bruset"

#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:48
msgid "The rate at which the Gabor noise changes across space. This is different from the Scale input in that it only scales perpendicular to the Gabor noise direction"
msgstr ""
"Den hastighet med vilken Gabor-bruset förändras över rymden. Detta skiljer "
"sig från skalningsinmatningen genom att det endast skalar vinkelrätt mot "
"Gabor-brusets riktning"

#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:56
msgid "The directionality of Gabor noise. 1 means the noise is completely directional, while 0 means the noise is omnidirectional"
msgstr ""
"Riktningen för Gabor-brus. 1 betyder att bruset är helt riktat, medan 0 "
"betyder att bruset är rundstrålande"

#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:66
#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:71
msgid "The direction of the anisotropic Gabor noise"
msgstr "Riktningen för det anisotropa Gabor-bruset"

#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:74
msgid "The Gabor noise value with both random intensity and phase. This is equal to sine the phase multiplied by the intensity"
msgstr ""
"Gabor-brusvärdet med både slumpmässig intensitet och fas. Detta är lika med "
"sinus fas multiplicerat med intensiteten"

#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:78
msgid "The phase of the Gabor noise, which has no random intensity"
msgstr "Fasen av Gabor-bruset, som inte har någon slumpmässig intensitet"

#: source/blender/nodes/shader/nodes/node_shader_tex_gabor.cc:80
msgid "The intensity of the Gabor noise, which has no random phase"
msgstr "Intensiteten hos Gabor-bruset, som inte har någon slumpmässig fas"

#: source/blender/nodes/shader/nodes/node_shader_tex_noise.cc:54
msgid "Scale of the base noise octave"
msgstr "Skalan för basbrusets oktav"

#: source/blender/nodes/shader/nodes/node_shader_tex_noise.cc:59
msgid "The number of noise octaves. Higher values give more detailed noise but increase render time"
msgstr ""
"Antalet oktaver i bruset. Högre värden ger mer detaljerat brus men ökar "
"renderningstiden"

#: source/blender/nodes/shader/nodes/node_shader_tex_noise.cc:68
msgid "Blend factor between an octave and its previous one. A value of zero corresponds to zero detail"
msgstr ""
"Blandningsfaktor mellan en oktav och dess föregående. Värdet noll motsvarar "
"noll detaljer"

#: source/blender/nodes/shader/nodes/node_shader_tex_noise.cc:75
msgid "The difference between the scale of each two consecutive octaves. Larger values corresponds to larger scale for higher octaves"
msgstr ""
"Skillnaden mellan skalan för två på varandra följande oktaver. Större värden "
"motsvarar större skala för högre oktaver"

#: source/blender/nodes/shader/nodes/node_shader_tex_noise.cc:88
msgid "An added offset to each octave, determines the level where the highest octave will appear"
msgstr ""
"En extra förskjutning för varje oktav bestämmer nivån där den högsta oktaven "
"kommer att visas"

#: source/blender/nodes/shader/nodes/node_shader_tex_noise.cc:97
msgid "An extra multiplier to tune the magnitude of octaves"
msgstr "En extra multiplikator för att justera oktavernas storlek"

#: source/blender/nodes/shader/nodes/node_shader_tex_sky.cc:50
msgid "Sun disc not available in EEVEE"
msgstr "Soldisken är inte tillgänglig i EEVEE"

#: source/blender/nodes/shader/nodes/node_shader_tex_voronoi.cc:60
msgid "The number of Voronoi layers to sum"
msgstr "Antalet Voronoi-lager som ska summeras"

#: source/blender/nodes/shader/nodes/node_shader_tex_voronoi.cc:68
msgid "The influence of a Voronoi layer relative to that of the previous layer"
msgstr "Influensen av ett Voronoi-lager i förhållande till det föregående lagret"

#: source/blender/nodes/shader/nodes/node_shader_tex_voronoi.cc:75
msgid "The scale of a Voronoi layer relative to that of the previous layer"
msgstr "Skalan för ett Voronoi-lager i förhållande till det föregående lagret"

#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:52
msgid "Detail Scale"
msgstr "Detaljskala"

#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:57
msgid "Detail Roughness"
msgstr "Detaljernas grovhet"

#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:41
msgid "Overall texture scale"
msgstr "Övergripande texturskala"

#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:46
msgid "Amount of distortion of the wave"
msgstr "Vågens distorsionsgrad"

#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:51
msgid "Amount of distortion noise detail"
msgstr "Mängd distorsionsbrusdetaljer"

#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:56
msgid "Scale of distortion noise"
msgstr "Skalan för distorsionsbrus"

#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:62
msgid "Blend between a smoother noise pattern, and rougher with sharper peaks"
msgstr ""
"Blanda mellan ett mjukare brusmönster och ett grovare med skarpare toppar"

#: source/blender/nodes/shader/nodes/node_shader_tex_wave.cc:67
msgid ""
"Position of the wave along the Bands Direction.\n"
"This can be used as an input for more control over the distortion"
msgstr ""
"Vågens position längs bandriktningen.\n"
"Kan användas som indata för bättre kontroll över distorsionen"

#: source/blender/nodes/shader/nodes/node_shader_tex_white_noise.cc:46
msgid "Value used as seed in 1D and 4D dimensions"
msgstr "Värde som används som utgångspunkt i 1D- och 4D-dimensioner"

#: source/blender/nodes/shader/nodes/node_shader_vector_math.cc:54
msgid "Incident"
msgstr "Händelse"

#: source/blender/nodes/shader/nodes/node_shader_vector_rotate.cc:34
msgid "Point to rotate around"
msgstr "Peka för att rotera runt"

#: source/blender/nodes/shader/nodes/node_shader_vector_rotate.cc:43
msgid "Angle to rotate the input vector by"
msgstr "Vinkel för att rotera ingångsvektorn med"

#: source/blender/nodes/shader/nodes/node_shader_vector_rotate.cc:47
msgid "The amount of rotation on each axis, around the X, Y, then Z axes in that order"
msgstr ""
"Rotationsgraden på varje axel, runt X-, Y- och Z-axlarna i den ordningen"

#: source/blender/nodes/shader/nodes/node_shader_vector_transform.cc:24
msgid "Vector, point, or normal which will be used for conversion between spaces"
msgstr "Vektor, punkt eller normal som kommer att användas för konvertering mellan utrymmen"

#: source/blender/nodes/shader/nodes/node_shader_vertex_color.cc:48
msgid "No mesh in active object"
msgstr "Inget nät i aktivt objekt"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:34
msgid "Absorption Coefficients"
msgstr "Absorptionskoefficienter"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:46
msgid "Scatter Coefficients"
msgstr "Spridningskoefficienter"

#: source/blender/nodes/shader/nodes/node_shader_volume_coefficients.cc:72
#: source/blender/nodes/shader/nodes/node_shader_volume_scatter.cc:46
