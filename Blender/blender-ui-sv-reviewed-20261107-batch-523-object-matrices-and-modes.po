#. :src: bpy.types.Object.matrix_basis
msgid "Input Matrix"
msgstr "Inmatningsmatris"

#. :src: bpy.types.Object.matrix_basis
msgid ""
"Matrix access to location, rotation and scale (including deltas), before "
"constraints and parenting are applied"
msgstr ""
"Matrisåtkomst till plats, rotation och skala (inklusive deltavärden), innan "
"begränsningar och föräldrarelationer tillämpas"

#. :src: bpy.types.Object.matrix_local
msgid ""
"Parent relative transformation matrix.\n"
"Warning: Only takes into account object parenting, so e.g. in case of bone "
"parenting you get a matrix relative to the Armature object, not to the "
"actual parent bone"
msgstr ""
"Föräldrarelativ transformationsmatris.\n"
"Varning: Tar endast hänsyn till objektets föräldrarelation. Vid "
"benföräldraskap får du därför en matris relativ till armaturobjektet, inte "
"till det faktiska överordnade benet"

#. :src: bpy.types.Object.matrix_parent_inverse
msgid "Parent Inverse Matrix"
msgstr "Förälderns inversa matris"

#. :src: bpy.types.Object.matrix_parent_inverse
msgid "Inverse of object's parent matrix at time of parenting"
msgstr "Objektets föräldramatris inverterad när föräldrarelationen skapades"

#. :src: bpy.types.Object.matrix_world
msgid "Matrix World"
msgstr "Världsmatris"

#. :src: bpy.types.Object.matrix_world
#. :src: bpy.types.MovieReconstructedCamera.matrix
msgid "Worldspace transformation matrix"
msgstr "Transformationsmatris i världsrymden"

#. :src: bpy.types.Object.mode
msgid "Object interaction mode"
msgstr "Objektets interaktionsläge"

