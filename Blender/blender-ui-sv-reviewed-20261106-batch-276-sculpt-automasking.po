#. :src: bpy.types.Brush.use_automasking_boundary_edges
#. :src: bpy.types.Sculpt.use_automasking_boundary_edges
msgid "Mesh Boundary Auto-Masking"
msgstr "Automaskering av meshgräns"

#. :src: bpy.types.Brush.use_automasking_boundary_edges
#. :src: bpy.types.Sculpt.use_automasking_boundary_edges
msgid "Do not affect non manifold boundary edges"
msgstr "Påverka inte icke-mångfaldiga gränskanter"

#. :src: bpy.types.Brush.use_automasking_boundary_face_sets
#. :src: bpy.types.Sculpt.use_automasking_boundary_face_sets
msgid "Face Sets Boundary Automasking"
msgstr "Automaskering av ytuppsättningsgräns"

#. :src: bpy.types.Brush.use_automasking_boundary_face_sets
#. :src: bpy.types.Sculpt.use_automasking_boundary_face_sets
msgid "Do not affect vertices that belong to a Face Set boundary"
msgstr "Påverka inte hörnpunkter som tillhör en ytuppsättningsgräns"

#. :src: bpy.types.Brush.use_automasking_cavity
#. :src: bpy.types.Paint.use_cavity
#. :src: bpy.types.Sculpt.use_automasking_cavity
#. :src: bpy.types.VIEW3D_PT_tools_imagepaint_options_cavity
msgid "Cavity Mask"
msgstr "Hålighetsmask"

#. :src: bpy.types.Brush.use_automasking_cavity
#. :src: bpy.types.Sculpt.use_automasking_cavity
msgid "Do not affect vertices on peaks, based on the surface curvature"
msgstr "Påverka inte hörnpunkter vid toppar, utifrån ytans krökning"

#. :src: bpy.types.Brush.use_automasking_cavity_inverted
#. :src: bpy.types.Sculpt.use_automasking_cavity_inverted
msgid "Inverted Cavity Mask"
msgstr "Inverterad hålighetsmask"

#. :src: bpy.types.Brush.use_automasking_cavity_inverted
#. :src: bpy.types.Sculpt.use_automasking_cavity_inverted
msgid "Do not affect vertices within crevices, based on the surface curvature"
msgstr "Påverka inte hörnpunkter i skåror, utifrån ytans krökning"

#. :src: bpy.types.Brush.use_automasking_custom_cavity_curve
#. :src: bpy.types.Sculpt.use_automasking_custom_cavity_curve
msgid "Custom Cavity Curve"
msgstr "Anpassad hålighetskurva"

#. :src: bpy.types.Brush.use_automasking_face_sets
#. :src: bpy.types.Sculpt.use_automasking_face_sets
msgid "Affect only vertices that share Face Sets with the active vertex"
msgstr ""
"Påverka endast hörnpunkter som tillhör samma ytuppsättning som den aktiva "
"hörnpunkten"

#. :src: bpy.types.Brush.use_automasking_start_normal
#. :src: bpy.types.Sculpt.use_automasking_start_normal
msgid "Affect only vertices with a similar normal to where the stroke starts"
msgstr ""
"Påverka endast hörnpunkter med en normal som liknar normalen där "
"penseldraget börjar"

#. :src: bpy.types.Brush.use_automasking_topology
#. :src: bpy.types.Sculpt.use_automasking_topology
msgid "Affect only vertices connected to the active vertex under the brush"
msgstr ""
"Påverka endast hörnpunkter som är topologiskt anslutna till den aktiva "
"hörnpunkten under penseln"

#. :src: bpy.types.Brush.use_automasking_view_normal
#. :src: bpy.types.Sculpt.use_automasking_view_normal
msgid "Affect only vertices with a normal that faces the viewer"
msgstr "Påverka endast hörnpunkter med en normal som vetter mot betraktaren"

#. :src: bpy.types.Brush.use_automasking_view_occlusion
#. :src: bpy.types.Sculpt.use_automasking_view_occlusion
msgid ""
"Only affect vertices that are not occluded by other faces (slower "
"performance)"
msgstr ""
"Påverka endast hörnpunkter som inte täcks av andra ytor (långsammare "
"prestanda)"

#. :src: bpy.types.Brush.use_cloth_collision
msgid "Collide with objects during the simulation"
msgstr "Kollidera med objekt under simuleringen"

#. :src: bpy.types.Brush.use_cloth_pin_simulation_boundary
msgid "Pin Simulation Boundary"
msgstr "Fäst simuleringsgränsen"

#. :src: bpy.types.Brush.use_cloth_pin_simulation_boundary
msgid ""
"Lock the position of the vertices in the simulation falloff area to avoid "
"artifacts and create a softer transition with unaffected areas"
msgstr ""
"Lås hörnpunkternas position i simuleringsområdet för avtagande för att "
"undvika artefakter och skapa en mjukare övergång till opåverkade områden"

#. :src: bpy.types.Brush.use_color_as_displacement
msgid ""
"Handle each pixel color as individual vector for displacement (area plane "
"mapping only)"
msgstr ""
"Hantera varje pixelfärg som en enskild vektor för förskjutning (endast "
"mappning av områdesplan)"

#. :src: bpy.types.Brush.use_connected_only
msgid "Affect only topologically connected elements"
msgstr "Påverka endast topologiskt sammanhängande element"

#. :src: bpy.types.Brush.use_cursor_overlay_override
#. :src: bpy.types.Brush.use_primary_overlay_override
#. :src: bpy.types.Brush.use_secondary_overlay_override
msgid "Don't show overlay during a stroke"
msgstr "Visa inte överlägget under ett penseldrag"

#. :src: bpy.types.Brush.use_curve
msgid ""
"Define the stroke curve with a Bézier curve. Dabs are separated according to "
"spacing."
msgstr ""
"Definiera penseldragskurvan med en Bézier-kurva. Penselavtrycken separeras "
"enligt avståndet."

#. :src: bpy.types.Brush.use_custom_icon
msgid "Set the brush icon from an image file"
msgstr "Ange penselikonen från en bildfil"

#. :src: bpy.types.Brush.use_edge_to_edge
msgid "Edge-to-Edge"
msgstr "Kant till kant"

#. :src: bpy.types.Brush.use_edge_to_edge
msgid "Drag anchor brush from edge-to-edge"
msgstr "Dra den förankrade penseln från kant till kant"

#. :src: bpy.types.Brush.use_frontface
msgid "Use Front-Face"
msgstr "Använd framsidan"

#. :src: bpy.types.Brush.use_frontface
msgid "Brush only affects vertices that face the viewer"
msgstr "Penseln påverkar endast hörnpunkter som vetter mot betraktaren"

#. :src: bpy.types.Brush.use_frontface_falloff
msgid "Use Front-Face Falloff"
msgstr "Använd avtagande för framsidan"

#. :src: bpy.types.Brush.use_frontface_falloff
msgid "Blend brush influence by how much they face the front"
msgstr "Blanda penselns påverkan efter hur mycket hörnpunkterna vetter framåt"

#. :src: bpy.types.Brush.use_grab_active_vertex
msgid "Grab Active Vertex"
msgstr "Flytta aktiv hörnpunkt"

#. :src: bpy.types.Brush.use_grab_active_vertex
msgid ""
"Apply the maximum grab strength to the active vertex instead of the cursor "
"location"
msgstr ""
"Tillämpa maximal flyttstyrka på den aktiva hörnpunkten i stället för på "
"markörens position"

#. :src: bpy.types.Brush.use_grab_silhouette
msgid "Grab Silhouette"
msgstr "Flytta silhuett"

#. :src: bpy.types.Brush.use_grab_silhouette
msgid "Grabs trying to automask the silhouette of the object"
msgstr "Flyttverktyg försöker automatiskt maskera objektets silhuett"
