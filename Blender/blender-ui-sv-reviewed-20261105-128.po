#. :src: bpy.types.ACTION_OT_select_circle
#. :src: bpy.types.GRAPH_OT_select_circle
msgid "Select keyframe points using circle selection"
msgstr "Markera nyckelbildrutepunkter med cirkelmarkering"

#. :src: bpy.types.ACTION_OT_select_column
#. :src: bpy.types.GRAPH_OT_select_column
msgid "Select all keyframes on the specified frame(s)"
msgstr "Markera alla nyckelbildrutor på de angivna bildrutorna"

#. :src: bpy.types.ACTION_OT_select_column.mode:'KEYS'
#. :src: bpy.types.GRAPH_OT_select_column.mode:'KEYS'
#. :src: bpy.types.POSE_OT_propagate.mode:'SELECTED_KEYS'
msgid "On Selected Keyframes"
msgstr "På markerade nyckelbildrutor"

#. :src: bpy.types.ACTION_OT_select_column.mode:'MARKERS_BETWEEN'
#. :src: bpy.types.GRAPH_OT_select_column.mode:'MARKERS_BETWEEN'
msgid "Between Min/Max Selected Markers"
msgstr "Mellan minsta och största markerade markör"

#. :src: bpy.types.ACTION_OT_select_lasso
#. :src: bpy.types.GRAPH_OT_select_lasso
msgid "Select keyframe points using lasso selection"
msgstr "Markera nyckelbildrutepunkter med lassomarkering"

