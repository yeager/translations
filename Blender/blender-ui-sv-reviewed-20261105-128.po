#. :src: bpy.types.ACTION_OT_keyframe_type
msgctxt "Operator"
msgid "Set Keyframe Type"
msgstr "Ange nyckelbildrutatyp"

#. :src: bpy.types.ACTION_OT_keyframe_type
msgid "Set type of keyframe for the selected keyframes"
msgstr "Ange nyckelbildrutatyp för markerade nyckelbildrutor"

#. :src: bpy.types.ACTION_OT_layer_next
msgid ""
"Switch to editing action in animation layer above the current action in the "
"NLA Stack"
msgstr ""
"Växla till redigering av åtgärden i animationslagret ovanför den aktuella "
"åtgärden i NLA-stapeln"

#. :src: bpy.types.ACTION_OT_layer_prev
msgid ""
"Switch to editing action in animation layer below the current action in the "
"NLA Stack"
msgstr ""
"Växla till redigering av åtgärden i animationslagret under den aktuella "
"åtgärden i NLA-stapeln"

#. :src: bpy.types.ACTION_OT_markers_make_local
msgid ""
"Move selected scene markers to the active Action as local 'pose' markers"
msgstr ""
"Flytta markerade scenmarkörer till den aktiva åtgärden som lokala ”pose”-"
"markörer"

#. :src: bpy.types.ACTION_OT_mirror
#. :src: bpy.types.GRAPH_OT_mirror
msgctxt "Operator"
msgid "Mirror Keys"
msgstr "Spegla nyckelbildrutor"

#. :src: bpy.types.ACTION_OT_mirror
#. :src: bpy.types.GRAPH_OT_mirror
msgid "Flip selected keyframes over the selected mirror line"
msgstr "Spegla markerade nyckelbildrutor över den valda spegellinjen"

#. :src: bpy.types.ACTION_OT_mirror.type:'CFRA'
#. :src: bpy.types.GRAPH_OT_mirror.type:'CFRA'
msgid ""
"Flip times of selected keyframes using the current frame as the mirror line"
msgstr ""
"Spegla tiderna för markerade nyckelbildrutor med den aktuella bildrutan som "
"spegellinje"

#. :src: bpy.types.ACTION_OT_mirror.type:'XAXIS'
#. :src: bpy.types.GRAPH_OT_mirror.type:'XAXIS'
msgid ""
"Flip values of selected keyframes (i.e. negative values become positive, and "
"vice versa)"
msgstr ""
"Spegla värden för markerade nyckelbildrutor (dvs. negativa värden blir "
"positiva och tvärtom)"

#. :src: bpy.types.ACTION_OT_mirror.type:'MARKER'
#. :src: bpy.types.GRAPH_OT_mirror.type:'MARKER'
msgid ""
"Flip times of selected keyframes using the first selected marker as the "
"reference point"
msgstr ""
"Spegla tiderna för markerade nyckelbildrutor med den första markerade "
"markören som referenspunkt"

#. :src: bpy.types.ACTION_OT_paste
#. :src: bpy.types.GRAPH_OT_paste
msgctxt "Operator"
msgid "Paste Keyframes"
msgstr "Klistra in nyckelbildrutor"

#. :src: bpy.types.ACTION_OT_paste
#. :src: bpy.types.GRAPH_OT_paste
msgid ""
"Paste keyframes from the internal clipboard for the selected channels, "
"starting on the current frame"
msgstr ""
"Klistra in nyckelbildrutor från det interna urklippet för de markerade "
"kanalerna, med början på den aktuella bildrutan"

#. :src: bpy.types.ACTION_OT_paste.flipped
#. :src: bpy.types.GRAPH_OT_paste.flipped
#. :src: bpy.types.POSELIB_OT_pose_asset_select_bones.flipped
#. :src: bpy.types.TRANSFORM_OT_edge_slide.flipped
#. :src: bpy.types.TRANSFORM_OT_vert_slide.flipped
#: source/blender/editors/transform/transform_mode_edge_slide.cc:833
msgid "Flipped"
msgstr "Spegelvänd"

#. :src: bpy.types.ACTION_OT_paste.flipped
#. :src: bpy.types.GRAPH_OT_paste.flipped
#: source/blender/editors/space_action/action_edit.cc:735
#: source/blender/editors/space_graph/graph_edit.cc:617
msgid "Paste keyframes from mirrored bones if they exist"
msgstr "Klistra in nyckelbildrutor från speglade ben om de finns"

#. :src: bpy.types.ACTION_OT_paste.merge
#. :src: bpy.types.GRAPH_OT_paste.merge
msgid "Method of merging pasted keys and existing"
msgstr "Metod för att sammanfoga inklistrade och befintliga nyckelbildrutor"

#. :src: bpy.types.ACTION_OT_paste.merge:'MIX'
#. :src: bpy.types.GRAPH_OT_paste.merge:'MIX'
msgid "Overlay existing with new keys"
msgstr "Lägg nya nyckelbildrutor ovanpå befintliga"

#. :src: bpy.types.ACTION_OT_paste.merge:'OVER_RANGE'
#. :src: bpy.types.GRAPH_OT_paste.merge:'OVER_RANGE'
msgid "Overwrite Range"
msgstr "Skriv över intervall"

#. :src: bpy.types.ACTION_OT_paste.merge:'OVER_RANGE'
#. :src: bpy.types.GRAPH_OT_paste.merge:'OVER_RANGE'
msgid "Overwrite keys in pasted range"
msgstr "Skriv över nyckelbildrutor i det inklistrade intervallet"

#. :src: bpy.types.ACTION_OT_paste.merge:'OVER_RANGE_ALL'
#. :src: bpy.types.GRAPH_OT_paste.merge:'OVER_RANGE_ALL'
msgid "Overwrite Entire Range"
msgstr "Skriv över hela intervallet"

#. :src: bpy.types.ACTION_OT_paste.merge:'OVER_RANGE_ALL'
#. :src: bpy.types.GRAPH_OT_paste.merge:'OVER_RANGE_ALL'
msgid "Overwrite keys in pasted range, using the range of all copied keys"
msgstr ""
"Skriv över nyckelbildrutor i det inklistrade intervallet med intervallet för "
"alla kopierade nyckelbildrutor"

#. :src: bpy.types.ACTION_OT_paste.offset
#. :src: bpy.types.GRAPH_OT_paste.offset
msgid "Paste time offset of keys"
msgstr "Klistra in nyckelbildrutornas tidsförskjutning"

#. :src: bpy.types.ACTION_OT_paste.offset:'START'
#. :src: bpy.types.GRAPH_OT_paste.offset:'START'
msgid "Paste keys starting at current frame"
msgstr "Klistra in nyckelbildrutor som börjar vid den aktuella bildrutan"

#. :src: bpy.types.ACTION_OT_paste.offset:'END'
#. :src: bpy.types.GRAPH_OT_paste.offset:'END'
msgid "Frame End"
msgstr "Slutbildruta"

#. :src: bpy.types.ACTION_OT_paste.offset:'RELATIVE'
#. :src: bpy.types.GRAPH_OT_paste.offset:'RELATIVE'
msgid "Frame Relative"
msgstr "Relativt till bildruta"

#. :src: bpy.types.ACTION_OT_paste.offset:'RELATIVE'
#. :src: bpy.types.GRAPH_OT_paste.offset:'RELATIVE'
msgid "Paste keys relative to the current frame when copying"
msgstr ""
"Klistra in nyckelbildrutor relativt den aktuella bildrutan vid kopiering"

#. :src: bpy.types.ACTION_OT_paste.offset:'NONE'
#. :src: bpy.types.GRAPH_OT_paste.offset:'NONE'
msgid "Paste keys from original time"
msgstr "Klistra in nyckelbildrutor från ursprunglig tid"

#. :src: bpy.types.ACTION_OT_previewrange_set
#. :src: bpy.types.GRAPH_OT_previewrange_set
#. :src: bpy.types.NLA_OT_previewrange_set
msgctxt "Operator"
msgid "Set Preview Range to Selected"
msgstr "Ange förhandsgranskningsintervall för markerade"

#. :src: bpy.types.ACTION_OT_previewrange_set
msgid "Set Preview Range based on extents of selected Keyframes"
msgstr ""
"Ange förhandsgranskningsintervall utifrån omfånget av markerade "
"nyckelbildrutor"

#. :src: bpy.types.ACTION_OT_push_down
#. :src: bpy.types.NLA_OT_action_pushdown
#: scripts/startup/bl_ui/space_dopesheet.py:576
msgctxt "Operator"
msgid "Push Down Action"
msgstr "Skjut ned åtgärd"

#. :src: bpy.types.ACTION_OT_select_all
#. :src: bpy.types.GRAPH_OT_select_all
msgid "Toggle selection of all keyframes"
msgstr "Växla markering av alla nyckelbildrutor"

#. :src: bpy.types.ACTION_OT_select_box
#. :src: bpy.types.GRAPH_OT_select_box
msgid "Select all keyframes within the specified region"
msgstr "Markera alla nyckelbildrutor inom den angivna regionen"

#. :src: bpy.types.ACTION_OT_select_box.tweak
#. :src: bpy.types.GRAPH_OT_select_box.tweak
#. :src: bpy.types.MARKER_OT_move.tweak
#. :src: bpy.types.MARKER_OT_select_box.tweak
#. :src: bpy.types.NLA_OT_select_box.tweak
msgid "Operator has been activated using a click-drag event"
msgstr "Operatören har aktiverats genom att klicka och dra"

