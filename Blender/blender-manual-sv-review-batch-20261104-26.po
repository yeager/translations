#. Mesh bevel menu paths, ../../manual/modeling/meshes/editing/edge/bevel.rst:10,14.
msgid ""
":menuselection:`Vertex --> Bevel Vertices`, :menuselection:`Edge --> "
"Bevel Edges`"
msgstr ""
":menuselection:`Hörnpunkt --> Fasa hörnpunkter`, :menuselection:`Kant --> "
"Fasa kanter`"

#. Mesh bevel shortcuts, ../../manual/modeling/meshes/editing/edge/bevel.rst:11,15.
msgid ":kbd:`Shift-Ctrl-B` (Bevel Vertices), :kbd:`Ctrl-B` (Bevel Edges)"
msgstr ":kbd:`Shift-Ctrl-B` (Fasa hörnpunkter), :kbd:`Ctrl-B` (Fasa kanter)"

#. Mesh bevel comparison caption, ../../manual/modeling/meshes/editing/edge/bevel.rst:18,22.
msgid "Cubes without and with bevel."
msgstr "Kuber utan respektive med fasning."

#. Bevel modifier reference, ../../manual/modeling/meshes/editing/edge/bevel.rst:22,26.
msgid "The :doc:`/modeling/modifiers/generate/bevel` does this non-destructively."
msgstr ":doc:`Avfasningsmodifieraren </modeling/modifiers/generate/bevel>` utför detta icke-destruktivt."

#. Bevel caption, ../../manual/modeling/meshes/editing/edge/bevel.rst:38,42,139,143,162,166.
msgid "Before beveling."
msgstr "Före fasning."

#. Bevel width caption, ../../manual/modeling/meshes/editing/edge/bevel.rst:42,46.
msgid "Increased bevel width."
msgstr "Ökad fasningsbredd."

#. Bevel segments caption, ../../manual/modeling/meshes/editing/edge/bevel.rst:46,50.
msgid "Increased bevel segments."
msgstr "Fler fasningssegment."

#. Vertex bevel operation, ../../manual/modeling/meshes/editing/edge/bevel.rst:61,65.
msgid "Bevel the selected vertices, leaving the edges unchanged."
msgstr "Fasa de markerade hörnpunkterna utan att ändra kanterna."

#. Bevel profile shape, ../../manual/modeling/meshes/editing/edge/bevel.rst:111,115.
msgid "Profile Shape :kbd:`P`"
msgstr "Profilform :kbd:`P`"

#. Bevel loop slide state, ../../manual/modeling/meshes/editing/edge/bevel.rst:143,147.
msgid "Loop Slide off."
msgstr "Slingglidning av."

#. Bevel loop slide state, ../../manual/modeling/meshes/editing/edge/bevel.rst:147,151.
msgid "Loop Slide on."
msgstr "Slingglidning på."

#. Bevel sharp edges option, ../../manual/modeling/meshes/editing/edge/bevel.rst:155,159.
msgid ""
"Same as *Mark Seams*, but for :ref:`Sharp <bpy.ops.mesh.mark_sharp>` "
"edges."
