# Blender UI Swedish review delta – File Browser and Asset Browser
msgid ""
msgstr ""
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#. :src: bpy.types.AssetMetaData.preferred_import_method:'APPEND'
#. :src: bpy.types.UserAssetLibrary.import_method:'APPEND'
msgid "Import the assets as copied data-block, with no link to the original asset data-block"
msgstr "Importera resurserna som kopierade datablock utan länk till det ursprungliga resursdatablocket"

#. :src: bpy.types.BlendImportContext.options:'APPEND_RECURSIVE'
msgid "Append (make local) also indirect dependencies of appended IDs coming from other libraries. NOTE: All IDs (including indirectly linked ones) coming from the same initial library are always made local"
msgstr "Lägg även till (gör lokala) indirekta beroenden till tillagda ID:n från andra bibliotek. OBS! Alla ID:n (även indirekt länkade) som kommer från samma ursprungliga bibliotek görs alltid lokala"

#. :src: bpy.types.BlendImportContextItem
msgid "An item (representing a data-block) in a BlendImportContext data. Currently only exposed as read-only data for the pre/post linking handlers"
msgstr "Ett objekt (som representerar ett datablock) i data för BlendImportContext. För närvarande bara exponerat som skrivskyddade data för länkningshanterare före och efter länkning"

#. :src: bpy.types.BlendImportContextLibrary
msgid "Library (blend-file) reference in a BlendImportContext data. Currently only exposed as read-only data for the pre/post blend-import handlers"
msgstr "Biblioteksreferens till en blendfil i data för BlendImportContext. För närvarande bara exponerad som skrivskyddade data för hanterare före och efter blendfilimport"

#. :src: bpy.types.FileAssetSelectParams.import_method:'FOLLOW_PREFS'
msgid "Use the import method set in the Preferences for this asset library, don't override it for this Asset Browser"
msgstr "Använd importmetoden som angetts i Inställningar för detta resursbibliotek; åsidosätt den inte för denna resursbläddrare"

#. :src: bpy.types.WorkSpace.asset_library_reference
msgid "Active asset library to show in the UI, not used by the Asset Browser (which has its own active asset library)"
msgstr "Aktivt resursbibliotek som ska visas i gränssnittet; används inte av resursbläddraren (som har ett eget aktivt resursbibliotek)"

#. :src: bpy.types.ASSET_OT_mark
msgid "Enable easier reuse of selected data-blocks through the Asset Browser, with the help of customizable metadata (like previews, descriptions and tags)"
msgstr "Gör det enklare att återanvända markerade datablock via resursbläddraren med hjälp av anpassningsbara metadata, till exempel förhandsvisningar, beskrivningar och taggar"

#. :src: bpy.types.ASSET_OT_mark_single
msgid "Enable easier reuse of a data-block through the Asset Browser, with the help of customizable metadata (like previews, descriptions and tags)"
msgstr "Gör det enklare att återanvända ett datablock via resursbläddraren med hjälp av anpassningsbara metadata, till exempel förhandsvisningar, beskrivningar och taggar"

#. :src: bpy.types.PROJECT_OT_new.existing_directory
msgid "Folder of the current file or one of its parents, to turn into a project"
msgstr "Mappen för den aktuella filen eller en av dess överordnade mappar, som ska göras till ett projekt"

#. :src: bpy.types.PreferencesAssetLibraries.use_online_essentials
msgid "Include remote assets in the Essentials asset library. Downloading requires Online Access to be enabled under System > Network in the Preferences"
msgstr "Inkludera fjärranslutna resurser i Essentials-resursbiblioteket. Hämtning kräver att nätåtkomst är aktiverad under System > Nätverk i Inställningar"

#. :src: bpy.types.PreferencesExperimental.use_extended_asset_browser
msgid "Enable Asset Browser editor and operators to manage regular data-blocks as assets, not just poses"
msgstr "Aktivera resursbläddrarens redigerare och operatörer för att hantera vanliga datablock som resurser, inte bara poser"

#. :src: bpy.types.UserAssetLibrary
#. :src: bpy.types.ProjectAssetLibrary
msgid "Settings to define a reusable library for Asset Browsers to use"
msgstr "Inställningar för att definiera ett återanvändbart bibliotek för resursbläddrare"

#. :src: bpy.types.UserAssetLibrary.import_method
msgid "Determine how the asset will be imported, unless overridden by the Asset Browser"
msgstr "Bestäm hur resursen ska importeras, om inte resursbläddraren åsidosätter detta"
