#. :src: bpy.types.BoolAttribute
msgid "Bool Attribute"
msgstr "Booleskt attribut"

#. :src: bpy.types.ByteIntAttribute
msgid "8-bit Integer Attribute"
msgstr "8-bitars heltalsattribut"

#. :src: bpy.types.Float2Attribute
msgid "Float2 Attribute"
msgstr "Float2-attribut"

#. :src: bpy.types.Float2Attribute
msgid "Geometry attribute that stores floating-point 2D vectors"
msgstr "Geometriattribut som lagrar 2D-vektorer med flyttalsvärden"

#. :src: bpy.types.Float4x4Attribute
msgid "4x4 Matrix Attribute"
msgstr "4x4-matrisattribut"

#. :src: bpy.types.Float4x4Attribute
msgid "Geometry attribute that stores a 4 by 4 float matrix"
msgstr "Geometriattribut som lagrar en 4 x 4-flyttalsmatris"

#. :src: bpy.types.FloatAttribute
msgid "Float Attribute"
msgstr "Flyttalsattribut"

#. :src: bpy.types.FloatAttribute
msgid "Geometry attribute that stores floating-point values"
msgstr "Geometriattribut som lagrar flyttalsvärden"

#. :src: bpy.types.FloatColorAttribute
msgid "Float Color Attribute"
msgstr "Flyttalsfärgattribut"

#. :src: bpy.types.FloatColorAttribute
msgid ""
"Geometry attribute that stores RGBA colors as floating-point values using 32-"
"bits per channel"
msgstr ""
"Geometriattribut som lagrar RGBA-färger som flyttalsvärden med 32 bitar per "
"kanal"

#. :src: bpy.types.FloatVectorAttribute
msgid "Float Vector Attribute"
msgstr "Flyttalsvektorattribut"

#. :src: bpy.types.FloatVectorAttribute
msgid "Geometry attribute that stores floating-point 3D vectors"
msgstr "Geometriattribut som lagrar 3D-vektorer med flyttalsvärden"

#. :src: bpy.types.Int2Attribute
msgid "2D Integer Vector Attribute"
msgstr "2D-heltalsvektorattribut"

#. :src: bpy.types.Int2Attribute
#. :src: bpy.types.Short2Attribute
msgid "Geometry attribute that stores 2D integer vectors"
msgstr "Geometriattribut som lagrar 2D-heltalsvektorer"

#. :src: bpy.types.IntAttribute
msgid "Integer Attribute"
msgstr "Heltalsattribut"

#. :src: bpy.types.IntAttribute
msgid "Geometry attribute that stores integer values"
msgstr "Geometriattribut som lagrar heltalsvärden"

#. :src: bpy.types.QuaternionAttribute
msgid "Quaternion Attribute"
msgstr "Kvaternionsattribut"

#. :src: bpy.types.QuaternionAttribute
msgid "Geometry attribute that stores rotation"
msgstr "Geometriattribut som lagrar rotation"

#. :src: bpy.types.Short2Attribute
msgid "2D 16-Bit Integer Vector Attribute"
msgstr "2D-vektorattribut med 16-bitars heltal"

#. :src: bpy.types.StringAttribute
msgid "Geometry attribute that stores strings"
msgstr "Geometriattribut som lagrar strängar"

#. :src: bpy.types.AttributeGroupCurves
#. :src: bpy.types.AttributeGroupGreasePencil
#. :src: bpy.types.AttributeGroupGreasePencilDrawing
#. :src: bpy.types.AttributeGroupMesh
#. :src: bpy.types.AttributeGroupPointCloud
msgid "Attribute Group"
msgstr "Attributgrupp"

#. :src: bpy.types.AttributeGroupCurves
#. :src: bpy.types.AttributeGroupGreasePencil
#. :src: bpy.types.AttributeGroupGreasePencilDrawing
#. :src: bpy.types.AttributeGroupMesh
#. :src: bpy.types.AttributeGroupPointCloud
msgid "Group of geometry attributes"
msgstr "Grupp med geometriattribut"

#. :src: bpy.types.AttributeGroupCurves.active
#. :src: bpy.types.AttributeGroupGreasePencil.active
#. :src: bpy.types.AttributeGroupGreasePencilDrawing.active
#. :src: bpy.types.AttributeGroupMesh.active
#. :src: bpy.types.AttributeGroupPointCloud.active
msgid "Active Attribute"
msgstr "Aktivt attribut"

#. :src: bpy.types.AttributeGroupCurves.active
#. :src: bpy.types.AttributeGroupGreasePencil.active
#. :src: bpy.types.AttributeGroupGreasePencilDrawing.active
#. :src: bpy.types.AttributeGroupMesh.active
#. :src: bpy.types.AttributeGroupPointCloud.active
msgid "Active attribute"
msgstr "Aktivt attribut"

#. :src: bpy.types.AttributeGroupCurves.active_index
#. :src: bpy.types.AttributeGroupGreasePencil.active_index
#. :src: bpy.types.AttributeGroupGreasePencilDrawing.active_index
#. :src: bpy.types.AttributeGroupMesh.active_index
#. :src: bpy.types.AttributeGroupPointCloud.active_index
msgid "Active Attribute Index"
msgstr "Aktivt attributindex"

#. :src: bpy.types.AttributeGroupCurves.active_index
#. :src: bpy.types.AttributeGroupGreasePencil.active_index
#. :src: bpy.types.AttributeGroupGreasePencilDrawing.active_index
#. :src: bpy.types.AttributeGroupMesh.active_index
#. :src: bpy.types.AttributeGroupPointCloud.active_index
msgid "Active attribute index or -1 when none are active"
msgstr "Aktivt attributindex eller -1 om inget attribut är aktivt"

#. :src: bpy.types.AttributeGroupMesh.active_color
msgid "Active color attribute for display and editing"
msgstr "Aktivt färgattribut för visning och redigering"

#. :src: bpy.types.AttributeGroupMesh.active_color_index
msgid "Active color attribute index"
msgstr "Aktivt färgattributindex"

#. :src: bpy.types.AttributeGroupMesh.active_color_name
#. :src: bpy.types.BakeSettings.target:'VERTEX_COLORS'
#. :src: bpy.types.OBJECT_OT_bake.target:'VERTEX_COLORS'
msgid "Active Color Attribute"
msgstr "Aktivt färgattribut"

#. :src: bpy.types.AttributeGroupMesh.active_color_name
msgid "The name of the active color attribute for display and editing"
msgstr "Namnet på det aktiva färgattributet för visning och redigering"

#. :src: bpy.types.AttributeGroupMesh.default_color_name
msgid "Default Color Attribute"
msgstr "Standardfärgattribut"

#. :src: bpy.types.AttributeGroupMesh.default_color_name
msgid ""
"The name of the default color attribute used as a fallback for rendering"
msgstr "Namnet på standardfärgattributet som används som reserv för rendering"

#. :src: bpy.types.AttributeGroupMesh.render_color_index
msgid "Active Render Color Index"
msgstr "Aktivt färgattributindex för rendering"

#. :src: bpy.types.AttributeGroupMesh.render_color_index
msgid "The index of the color attribute used as a fallback for rendering"
msgstr "Index för färgattributet som används som reserv vid rendering"
