#. :src: bpy.types.BakeSettings
msgid "Bake data for a Scene data-block"
msgstr "Bakningsdata för ett scendatablock"

#. :src: bpy.types.BakeSettings.cage_object
msgid ""
"Object to use as cage instead of calculating the cage from the active object "
"with cage extrusion"
msgstr ""
"Objekt som används som bur i stället för att beräkna buren från det aktiva "
"objektet med bursextrudering"

#. :src: bpy.types.BakeSettings.margin
#. :src: bpy.types.OBJECT_OT_bake.margin
#. :src: bpy.types.RenderSettings.bake_margin
msgid "Extends the baked result as a post process filter"
msgstr "Utökar det bakade resultatet som ett efterbehandlingsfilter"

#. :src: bpy.types.BakeSettings.margin_type:'EXTEND'
#. :src: bpy.types.OBJECT_OT_bake.margin_type:'EXTEND'
#. :src: bpy.types.RenderSettings.bake_margin_type:'EXTEND'
msgid "Extend border pixels outwards"
msgstr "Utöka kantpixlar utåt"

#. :src: bpy.types.BakeSettings.normal_b
#. :src: bpy.types.OBJECT_OT_bake.normal_b
msgid "Axis to bake in blue channel"
msgstr "Axel som ska bakas i blå kanal"

#. :src: bpy.types.BakeSettings.normal_g
#. :src: bpy.types.OBJECT_OT_bake.normal_g
msgid "Axis to bake in green channel"
msgstr "Axel som ska bakas i grön kanal"

#. :src: bpy.types.BakeSettings.normal_r
#. :src: bpy.types.OBJECT_OT_bake.normal_r
msgid "Axis to bake in red channel"
msgstr "Axel som ska bakas i röd kanal"

#. :src: bpy.types.BakeSettings.save_mode
#. :src: bpy.types.OBJECT_OT_bake.save_mode
msgid "Where to save baked image textures"
msgstr "Var bakade bildtexturer ska sparas"

#. :src: bpy.types.BakeSettings.target
#. :src: bpy.types.OBJECT_OT_bake.target
msgid "Where to output the baked map"
msgstr "Var den bakade kartan ska matas ut"

#. :src: bpy.types.BakeSettings.target:'IMAGE_TEXTURES'
#. :src: bpy.types.OBJECT_OT_bake.target:'IMAGE_TEXTURES'
msgid ""
"Bake to image data-blocks associated with active image texture nodes in "
"materials"
msgstr ""
"Baka till bilddatablock som är kopplade till aktiva bildtexturnoder i "
"material"

#. :src: bpy.types.BakeSettings.target:'VERTEX_COLORS'
#. :src: bpy.types.OBJECT_OT_bake.target:'VERTEX_COLORS'
msgid "Bake to the active color attribute on meshes"
msgstr "Baka till det aktiva färgattributet på mesh"

#. :src: bpy.types.BakeSettings.use_automatic_name
msgid "Automatically name the output file with the pass type (external only)"
msgstr "Namnge utdatafilen automatiskt med passtypen (endast externt)"

#. :src: bpy.types.BakeSettings.use_pass_emit
msgid "Add emission contribution"
msgstr "Lägg till emissionsbidrag"

#. :src: bpy.types.BakeSettings.use_pass_glossy
msgid "Add glossy contribution"
msgstr "Lägg till glansbidrag"

#. :src: bpy.types.BakeSettings.view_from
msgid "Source of reflection ray directions"
msgstr "Källa för reflektionsstrålarnas riktningar"

#. :src: bpy.types.BezierSplinePoint
msgid "Bézier Curve Point"
msgstr "Bézierkurvpunkt"
