#. :src: bpy.types.BrushCurvesSculptSettings
msgid "Curves Sculpt Brush Settings"
msgstr "Inställningar för kurvskulpteringspensel"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_length
msgid ""
"Length of newly added curves when it is not interpolated from other curves"
msgstr ""
"Längd på nyligen tillagda kurvor när längden inte interpoleras från andra "
"kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.curve_radius
msgid ""
"Radius of newly added curves when it is not interpolated from other curves"
msgstr ""
"Radie för nyligen tillagda kurvor när den inte interpoleras från andra kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.density_add_attempts
msgid "Density Add Attempts"
msgstr "Antal försök att öka tätheten"

#. :src: bpy.types.BrushCurvesSculptSettings.density_mode
msgctxt "Operator"
msgid "Density Mode"
msgstr "Täthetsläge"

#. :src: bpy.types.BrushCurvesSculptSettings.minimum_distance
msgid "Goal distance between curve roots for the Density brush"
msgstr "Målavstånd mellan kurvornas rotpunkter för täthetspenseln"

#. :src: bpy.types.BrushCurvesSculptSettings.use_point_count_interpolate
msgid "Use the number of points from the curves in close proximity"
msgstr "Använd antalet punkter från närliggande kurvor"

#. :src: bpy.types.BrushCurvesSculptSettings.use_uniform_scale
#. :src: Socket name from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Scale Uniform"
msgstr "Skala enhetligt"

#. :src: bpy.types.BrushCurvesSculptSettings.use_uniform_scale
msgid ""
"Grow or shrink curves by changing their size uniformly instead of using "
"trimming or extrapolation"
msgstr ""
"Förläng eller förkorta kurvor genom att skala dem enhetligt i stället för "
"att använda trimning eller extrapolering"

#. :src: bpy.types.BrushGpencilSettings
msgid "Grease Pencil Brush Settings"
msgstr "Inställningar för Grease Pencil-pensel"
