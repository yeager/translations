#. :src: bpy.types.ActionGroup
msgid "Action Group"
msgstr "Action-grupp"

#. :src: bpy.types.ActionGroup.lock
msgid "Action group is locked"
msgstr "Action-gruppen är låst"

#. :src: bpy.types.ActionGroup.mute
msgid "Action group is muted"
msgstr "Action-gruppen är avstängd"

#. :src: bpy.types.ActionGroup.select
msgid "Action group is selected"
msgstr "Action-gruppen är markerad"

#. :src: bpy.types.ActionGroup.show_expanded
msgid "Action group is expanded except in graph editor"
msgstr "Action-gruppen är utfälld utom i grafredigeraren"

#. :src: bpy.types.ActionGroup.show_expanded_graph
msgid "Action group is expanded in graph editor"
msgstr "Action-gruppen är utfälld i grafredigeraren"

#. :src: bpy.types.ActionLayer
msgid "Action Layer"
msgstr "Action-lager"

#. :src: bpy.types.ActionLayers
msgid "Action Layers"
msgstr "Action-lager"

#. :src: bpy.types.ActionPoseMarkers
msgid "Action Pose Markers"
msgstr "Action-posemarkörer"

#. :src: bpy.types.ActionPoseMarkers.active
msgid "Active pose marker for this action"
msgstr "Aktiv posemarkör för denna Action"

#. :src: bpy.types.ActionSlot
msgid "Action slot"
msgstr "Action-slot"

#. :src: bpy.types.ActionSlot
msgid "Identifier for a set of channels in this Action, that can be used by a data-block to specify what it gets animated by"
msgstr "Identifierare för en uppsättning kanaler i denna Action som ett datablock kan använda för att ange vad det animeras av"

#. :src: bpy.types.ActionSlot.handle
msgid "Number specific to this Slot, unique within the Action.\nThis is used, for example, on a ActionKeyframeStrip to look up the ActionChannelbag for this Slot"
msgstr "Nummer som är specifikt för denna slot och unikt inom Action.\nDet används exempelvis av en ActionKeyframeStrip för att hitta ActionChannelbag för denna slot"

#. :src: bpy.types.ActionSlots
