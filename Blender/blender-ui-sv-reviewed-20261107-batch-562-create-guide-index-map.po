#. :src: Socket name from node group Create Guide Index Map, file procedural_hair_node_assets.blend
#: source/blender/nodes/geometry/nodes/node_geo_interpolate_curves.cc:24
msgid "Guide Curves"
msgstr "Guidekurvor"

#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Create Guide Index Map"
msgstr "Skapa guideindexkarta"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid ""
"Creates an attribute that maps each curve to its nearest guide via index"
msgstr ""
"Skapar ett attribut som via index kopplar varje kurva till närmaste "
"guidekurva"

#. :src: Socket name from node group Create Guide Index Map, file procedural_hair_node_assets.blend
msgid "Guide Selection"
msgstr "Guideurval"

#. :src: Socket description from node group Create Guide Index Map, file procedural_hair_node_assets.blend
msgid "Guide curves or points used for the selection of guide curves"
msgstr "Guidekurvor eller punkter som används för att välja guidekurvor"

#. :src: Socket description from node group Create Guide Index Map, file procedural_hair_node_assets.blend
msgid "Minimum distance between two guides"
msgstr "Minsta avstånd mellan två guider"

#. :src: Socket description from node group Create Guide Index Map, file procedural_hair_node_assets.blend
msgid "ID to group curves together for guide map creation"
msgstr "ID för att gruppera kurvor vid skapandet av guideindexkartan"
