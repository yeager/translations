#. :src: bpy.types.GizmoGroup
msgctxt "Operator"
msgid "GizmoGroup"
msgstr "GizmoGroup"

#. :src: bpy.types.GizmoGroup
msgid "Storage of an operator being executed, or registered after execution"
msgstr "Lagring av en operatör som körs eller registreras efter körning"

#. :src: bpy.types.GizmoGroup.bl_options
msgid "Options for this operator type"
msgstr "Alternativ för denna operatörstyp"

#. :src: bpy.types.GizmoGroup.bl_options:'SCALE'
msgid "Scale to respect zoom (otherwise zoom independent display size)"
msgstr "Skala efter zoomnivån (annars visas den i en zoomoberoende storlek)"

#. :src: bpy.types.GizmoGroup.bl_options:'DEPTH_3D'
msgid "Depth 3D"
msgstr "Djup 3D"

#. :src: bpy.types.GizmoGroup.bl_options:'DEPTH_3D'
msgid "Supports culled depth by other objects in the view"
msgstr "Stöder djup som skyms av andra objekt i vyn"

#. :src: bpy.types.GizmoGroup.bl_options:'SELECT'
msgid "Supports selection"
msgstr "Stöder urval"
