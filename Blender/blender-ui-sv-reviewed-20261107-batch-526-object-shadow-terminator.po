#. :src: bpy.types.Object.shadow_terminator_geometry_offset
#. :src: bpy.types.CyclesObjectSettings.shadow_terminator_geometry_offset
msgid "Shadow Terminator Geometry Offset"
msgstr "Skuggterminator: geometriförskjutning"

#. :src: bpy.types.Object.shadow_terminator_geometry_offset
#. :src: bpy.types.CyclesObjectSettings.shadow_terminator_geometry_offset
msgid ""
"Offset rays from the surface to reduce shadow terminator artifact on low "
"poly geometry. Only affects triangles at grazing angles to light"
msgstr ""
"Förskjut strålar från ytan för att minska artefakter vid skuggterminatorn på "
"lågpolygeometri. Påverkar endast trianglar vid flacka vinklar mot ljuset"

#. :src: bpy.types.Object.shadow_terminator_normal_offset
msgid "Shadow Terminator Normal Offset"
msgstr "Skuggterminator: normalförskjutning"

#. :src: bpy.types.Object.shadow_terminator_normal_offset
msgid ""
"Offset rays from the surface to reduce shadow terminator artifact on low "
"poly geometry.Only affect triangles that are affected by the geometry offset"
msgstr ""
"Förskjut strålar från ytan för att minska artefakter vid skuggterminatorn på "
"lågpolygeometri. Påverkar endast trianglar som påverkas av "
"geometriförskjutningen"

#. :src: bpy.types.Object.shadow_terminator_shading_offset
#. :src: bpy.types.CyclesObjectSettings.shadow_terminator_offset
msgid "Shadow Terminator Shading Offset"
msgstr "Skuggterminator: skuggningsförskjutning"

#. :src: bpy.types.Object.shadow_terminator_shading_offset
#. :src: bpy.types.CyclesObjectSettings.shadow_terminator_offset
msgid ""
"Push the shadow terminator towards the light to hide artifacts on low poly "
"geometry"
msgstr ""
"Flytta skuggterminatorn mot ljuset för att dölja artefakter på "
"lågpolygeometri"

#. :src: bpy.types.OBJECT_PT_shadow_terminator
msgid "Shadow Terminator"
msgstr "Skuggterminator"
