#. :src: bpy.types.BlenderProject.ocio_config
msgid "OpenColorIO configuration to use for this project"
msgstr "OpenColorIO-konfiguration som ska användas för detta projekt"

#. :src: bpy.types.BlenderProject.ocio_config:'BLENDER'
msgid ""
"The default Blender OpenColorIO configuration. Works with both ACES "
"workflows and Blender specific views and color spaces"
msgstr ""
"Blenders standardkonfiguration för OpenColorIO. Fungerar både med ACES-"
"arbetsflöden och Blenders särskilda vyer och färgrymder"

#. :src: bpy.types.BlenderProject.ocio_config:'ACES_2_0_STUDIO'
msgid "ACES 2.0 Studio"
msgstr "ACES 2.0 Studio"

#. :src: bpy.types.BlenderProject.ocio_config:'ACES_2_0_STUDIO'
msgid ""
"Academy Color Encoding System 2.0, Studio Config v4.0.0. Less compatible "
"with existing assets and add-ons, but more consistent with other "
"applications using the same configuration"
msgstr ""
"Academy Color Encoding System 2.0, studiokonfiguration v4.0.0. Mindre "
"kompatibel med befintliga resurser och tillägg, men mer konsekvent med andra"
" program som använder samma konfiguration"

#. :src: bpy.types.BlenderProject.ocio_config:'ACES_1_3_STUDIO'
msgid "ACES 1.3 Studio"
msgstr "ACES 1.3 Studio"

#. :src: bpy.types.BlenderProject.ocio_config:'ACES_1_3_STUDIO'
msgid ""
"Academy Color Encoding System 1.3, Studio Config v2.2.0. Less compatible "
"with existing assets and add-ons, but more consistent with other "
"applications using the same configuration"
msgstr ""
"Academy Color Encoding System 1.3, studiokonfiguration v2.2.0. Mindre "
"kompatibel med befintliga resurser och tillägg, men mer konsekvent med andra"
" program som använder samma konfiguration"

#. :src: bpy.types.BlenderProject.ocio_config:'PATH'
msgid "OpenColorIO configuration from a file path or ocio:// URI"
msgstr "OpenColorIO-konfiguration från en filsökväg eller en ocio://-URI"

#. :src: bpy.types.BlenderProject.ocio_config_path
msgid "OpenColorIO Configuration Path"
msgstr "Sökväg till OpenColorIO-konfiguration"

#. :src: bpy.types.BlenderProject.ocio_config_path
msgid ""
"Path to the OpenColorIO configuration to use for this project. May be an "
"absolute file path, project relative path with {project_root}, or an ocio://"
" built-in OpenColorIO config"
msgstr ""
"Sökväg till OpenColorIO-konfigurationen som ska användas för detta projekt. "
"Kan vara en absolut filsökväg, en relativ projektväg med {project_root} "
"eller en inbyggd OpenColorIO-konfiguration via ocio://"

#. :src: bpy.types.BrushGpencilSettings.use_cyclic_stroke
msgid "Create a cyclic stroke"
msgstr "Skapa ett cykliskt streck"

#. :src: bpy.types.CollectionChild.sort_index
