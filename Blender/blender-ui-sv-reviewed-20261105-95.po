#. :src: bpy.types.KeyingSet.use_insertkey_needed
#. :src: bpy.types.KeyingSetPath.use_insertkey_needed
msgid "Only insert keyframes where they're needed in the relevant F-Curves"
msgstr "Infoga endast nyckelbildrutor där de behövs i de relevanta F-kurvorna"

#. :src: bpy.types.KeyingSet.use_insertkey_visual
#. :src: bpy.types.KeyingSetPath.use_insertkey_visual
msgid "Insert Keyframes - Visual"
msgstr "Infoga nyckelbildrutor – visuellt"

#. :src: bpy.types.KeyingSet.use_insertkey_visual
#. :src: bpy.types.KeyingSetPath.use_insertkey_visual
msgid "Insert keyframes based on 'visual transforms'"
msgstr "Infoga nyckelbildrutor baserat på ”visuella transformationer”"

#. :src: bpy.types.BUILTIN_KSI_DeltaLocation
msgid "Insert keyframes for additional location offset"
msgstr "Infoga nyckelbildrutor för ytterligare deltaförflyttning"

#. :src: bpy.types.BUILTIN_KSI_LocRot
#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'LocRot'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'LocRot'
msgid "Location & Rotation"
msgstr "Position och rotation"

#. :src: bpy.types.WholeCharacterSelected
msgid "Whole Character (Selected Bones Only)"
msgstr "Hela karaktären (endast markerade ben)"

#. :src: bpy.types.KeyingSetPath
msgid "Keying Set Path"
msgstr "Sökväg för nyckeluppsättning"

#. :src: bpy.types.KeyingSetPath
msgid "Path to a setting for use in a Keying Set"
msgstr "Sökväg till en inställning för användning i en nyckeluppsättning"

#. :src: bpy.types.KeyingSetPath.data_path
msgid "Path to property setting"
msgstr "Sökväg till egenskapsinställning"

#. :src: bpy.types.KeyingSetPath.id
msgid "ID-Block"
msgstr "ID-datablock"

#. :src: bpy.types.KeyingSetPath.id
msgid ""
"ID-Block that keyframes for Keying Set should be added to (for Absolute "
"Keying Sets only)"
msgstr ""
"ID-datablock som nyckelbildrutor för nyckeluppsättningen ska läggas till i "
"(endast för absoluta nyckeluppsättningar)"

#. :src: bpy.types.KeyingSetPaths
msgid "Keying set paths"
msgstr "Sökvägar för nyckeluppsättningar"

#. :src: bpy.types.KeyingSetPaths.active
#. :src: bpy.types.KeyingSets.active
#. :src: bpy.types.KeyingSetsAll.active
msgid "Active Keying Set used to insert/delete keyframes"
msgstr ""
"Aktiv nyckeluppsättning som används för att infoga/ta bort nyckelbildrutor"

#. :src: bpy.types.KeyingSets
msgid "Scene keying sets"
msgstr "Scenens nyckeluppsättningar"

#. :src: bpy.types.LatticePoint.co
msgid ""
"Original undeformed location used to calculate the strength of the deform "
"effect (edit/animate the Deformed Location instead)"
msgstr ""
"Ursprunglig odeformerad position som används för att beräkna "
"deformationseffektens styrka (redigera/animera i stället den deformerade "
"positionen)"

#. :src: bpy.types.LatticePoint.groups
msgid "Weights for the vertex groups this point is member of"
msgstr "Vikter för de hörnpunktsgrupper som denna punkt ingår i"

#. :src: bpy.types.LayerCollection.children
msgid "Layer collection children"
msgstr "Underordnade lagersamlingar"

#. :src: bpy.types.LayerCollection.indirect_only
msgid ""
"Objects in collection only contribute indirectly (through shadows and "
"reflections) in the view layer"
msgstr ""
"Objekt i samlingen bidrar endast indirekt (genom skuggor och reflektioner) i "
"visningslagret"

