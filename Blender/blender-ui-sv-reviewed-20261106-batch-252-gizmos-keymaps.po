#. :src: bpy.types.Gizmo
#. :src: bpy.types.Gizmos
msgid "Collection of gizmos"
msgstr "Samling av gizmor"

#. :src: bpy.types.Gizmo.group
msgid "Gizmo group this gizmo is a member of"
msgstr "Gizmo-grupp som denna gizmo tillhör"

#. :src: bpy.types.Gizmo.hide_keymap
msgid "Hide Keymap"
msgstr "Dölj tangentmappning"

#. :src: bpy.types.Gizmo.hide_keymap
msgid "Ignore the key-map for this gizmo"
msgstr "Ignorera tangentmappningen för den här gizmon"

#. :src: bpy.types.Gizmo.hide_select
msgid "Hide Select"
msgstr "Dölj markering"

#. :src: bpy.types.Gizmo.matrix_offset
msgid "Offset Matrix"
msgstr "Förskjutningsmatris"

#. :src: bpy.types.Gizmo.scale_basis
msgid "Scale Basis"
msgstr "Skalbas"

#. :src: bpy.types.Gizmo.select_bias
msgid "Select Bias"
msgstr "Urvalsförskjutning"

#. :src: bpy.types.Gizmo.select_bias
msgid "Depth bias used for selection"
msgstr "Djupförskjutning som används för urval"

#. :src: bpy.types.Gizmo.use_draw_hover
msgid "Show Hover"
msgstr "Visa när pekaren hålls över"

#. :src: bpy.types.Gizmo.use_draw_modal
msgid "Show Active"
msgstr "Visa som aktiv"

#. :src: bpy.types.Gizmo.use_draw_offset_scale
#. :src: bpy.types.MESH_OT_extrude_repeat.scale_offset
msgid "Scale Offset"
msgstr "Skala förskjutning"

#. :src: bpy.types.Gizmo.use_draw_offset_scale
msgid "Scale the offset matrix (use to apply screen-space offset)"
msgstr ""
"Skala förskjutningsmatrisen (används för att tillämpa förskjutning i "
"skärmrymden)"

#. :src: bpy.types.Gizmo.use_event_handle_all
msgid ""
"When highlighted, do not pass events through to be handled by other keymaps"
msgstr ""
"När den är markerad ska händelser inte skickas vidare för hantering av andra "
"tangentmappningar"

#. :src: bpy.types.Gizmo.use_operator_tool_properties
msgid "Tool Property Init"
msgstr "Initiera verktygsegenskaper"

#. :src: bpy.types.GizmoGroup.bl_options:'SCALE'
msgid "Scale to respect zoom (otherwise zoom independent display size)"
msgstr "Skala med zoomnivån (annars visas den i en zoomoberoende storlek)"

#. :src: bpy.types.GizmoGroup.bl_options:'DEPTH_3D'
msgid "Supports culled depth by other objects in the view"
msgstr "Stöder djup som skymts av andra objekt i vyn"
