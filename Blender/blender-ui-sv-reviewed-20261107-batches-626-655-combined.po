msgstr "Inaktivera globalt i sfäriska ljussonder"

#. :src: bpy.types.World.sun_threshold
msgid ""
"If non-zero, the maximum value for world contribution that will be recorded "
"inside the world light probe. The excess contribution is converted to a sun "
"light. This reduces the light bleeding caused by very bright light sources."
msgstr ""
"Om värdet är större än noll är det maximala värdet för världsbidrag som "
"registreras i världsljussonden. Det överskjutande bidraget omvandlas till "
"solljus. Detta minskar ljusläckaget som orsakas av mycket starka ljuskällor."

#. :src: bpy.types.OBJECT_OT_lightprobe_add
msgctxt "Operator"
msgid "Add Light Probe"
msgstr "Lägg till ljussond"

#. :src: bpy.types.OBJECT_OT_lightprobe_add
msgid "Add a light probe object"
msgstr "Lägg till ett ljussondsobjekt"

#. :src: bpy.types.OBJECT_OT_lightprobe_cache_bake.subset
#. :src: bpy.types.OBJECT_OT_lightprobe_cache_free.subset
