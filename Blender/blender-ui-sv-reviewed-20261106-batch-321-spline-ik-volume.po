#. :src: bpy.types.SplineIKConstraint
msgid "Spline IK Constraint"
msgstr "Spline IK-begränsning"

#. :src: bpy.types.SplineIKConstraint
msgid "Align 'n' bones along a curve"
msgstr "Rikta in n ben längs en kurva"

#. :src: bpy.types.SplineIKConstraint.bulge
#. :src: bpy.types.StretchToConstraint.bulge
#: scripts/startup/bl_ui/properties_constraint.py:578
#: scripts/startup/bl_ui/properties_constraint.py:1110
msgid "Volume Variation"
msgstr "Variation i volym"

#. :src: bpy.types.SplineIKConstraint.bulge
#. :src: bpy.types.StretchToConstraint.bulge
msgid "Factor between volume variation and stretching"
msgstr "Faktor mellan volymvariation och sträckning"

#. :src: bpy.types.SplineIKConstraint.bulge_max
#. :src: bpy.types.StretchToConstraint.bulge_max
msgid "Volume Variation Maximum"
msgstr "Maximal volymvariation"

#. :src: bpy.types.SplineIKConstraint.bulge_max
#. :src: bpy.types.StretchToConstraint.bulge_max
msgid "Maximum volume stretching factor"
msgstr "Maximal volymsträckningsfaktor"

#. :src: bpy.types.SplineIKConstraint.bulge_min
#. :src: bpy.types.StretchToConstraint.bulge_min
msgid "Volume Variation Minimum"
msgstr "Minimal volymvariation"

#. :src: bpy.types.SplineIKConstraint.bulge_min
#. :src: bpy.types.StretchToConstraint.bulge_min
msgid "Minimum volume stretching factor"
msgstr "Minsta volymsträckningsfaktor"

#. :src: bpy.types.SplineIKConstraint.bulge_smooth
#. :src: bpy.types.StretchToConstraint.bulge_smooth
msgid "Volume Variation Smoothness"
msgstr "Utjämning av volymvariation"

#. :src: bpy.types.SplineIKConstraint.bulge_smooth
#. :src: bpy.types.StretchToConstraint.bulge_smooth
msgid "Strength of volume stretching clamping"
msgstr "Styrka för begränsning av volymsträckning"

#. :src: bpy.types.SplineIKConstraint.chain_count
msgid "How many bones are included in the chain"
msgstr "Hur många ben ingår i kedjan"

#. :src: bpy.types.SplineIKConstraint.joint_bindings
msgid "Joint Bindings"
msgstr "Ledbindningar"

#. :src: bpy.types.SplineIKConstraint.joint_bindings
msgid ""
"(EXPERIENCED USERS ONLY) The relative positions of the joints along the "
"chain, as percentages"
msgstr ""
"(ENDAST FÖR ERFARNA ANVÄNDARE) De relativa positionerna för lederna längs "
"kedjan, som procentandelar"

#. :src: bpy.types.SplineIKConstraint.target
msgid "Curve that controls this relationship"
msgstr "Kurva som styr den här relationen"

#. :src: bpy.types.SplineIKConstraint.use_bulge_max
#. :src: bpy.types.StretchToConstraint.use_bulge_max
msgid "Use Volume Variation Maximum"
msgstr "Använd maximal volymvariation"

#. :src: bpy.types.SplineIKConstraint.use_bulge_max
#. :src: bpy.types.StretchToConstraint.use_bulge_max
msgid "Use upper limit for volume variation"
msgstr "Använd övre gräns för volymvariation"

#. :src: bpy.types.SplineIKConstraint.use_bulge_min
#. :src: bpy.types.StretchToConstraint.use_bulge_min
msgid "Use Volume Variation Minimum"
msgstr "Använd minimal volymvariation"

#. :src: bpy.types.SplineIKConstraint.use_bulge_min
#. :src: bpy.types.StretchToConstraint.use_bulge_min
msgid "Use lower limit for volume variation"
msgstr "Använd nedre gräns för volymvariation"

#. :src: bpy.types.SplineIKConstraint.use_chain_offset
msgid "Chain Offset"
msgstr "Kedjeförskjutning"

#. :src: bpy.types.SplineIKConstraint.use_chain_offset
msgid "Offset the entire chain relative to the root joint"
msgstr "Förskjut hela kedjan i förhållande till rotleden"
