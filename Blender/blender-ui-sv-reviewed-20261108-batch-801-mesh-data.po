#. :src: bpy.types.PreferencesEdit.use_duplicate_mesh
msgid "Causes mesh data to be duplicated with the object"
msgstr "Orsakar att meshdata dupliceras med objektet"

msgid "Failed to transfer mesh data to %d objects"
msgstr "Det gick inte att överföra meshdata till %d objekt"

msgid "Object '%s' has no evaluated mesh data"
msgstr "Objektet ”%s” har inga utvärderade meshdata"

#. :src: bpy.types.ShaderNodeAttribute.attribute_type:'OBJECT'
msgid ""
"The attribute is associated with the object or mesh data-block itself, and "
"its value is uniform"
msgstr ""
"Attributet är associerat med själva objektet eller meshdatablocket och "
"värdet är enhetligt"
