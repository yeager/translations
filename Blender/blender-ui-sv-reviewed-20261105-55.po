msgid "Constraint's panel is expanded in UI"
msgstr "Begränsningens panel är utfälld i användargränssnittet"

msgid "Copy Rotation"
msgstr "Kopiera rotation"

msgid "Copy Transforms"
msgstr "Kopiera transformationer"

msgid "Limit Location"
msgstr "Begränsa position"

msgid "Limit Rotation"
msgstr "Begränsa rotation"

msgid "Limit Scale"
msgstr "Begränsa skala"

msgid "Transform Cache"
msgstr "Transformationscache"

msgid "Action Constraint"
msgstr "Åtgärdsbegränsning"

msgid "The slot identifies which sub-set of the Action is considered to be for this strip, and its name is used to find the right slot when assigning another Action"
msgstr "Åtgärdsslotten anger vilken delmängd av åtgärden som hör till denna remsa, och dess namn används för att hitta rätt åtgärdsslot när en annan åtgärd tilldelas"

msgid "A number that identifies which sub-set of the Action is considered to be for this Action Constraint"
msgstr "Ett nummer som anger vilken delmängd av åtgärden som hör till denna åtgärdsbegränsning"

msgid "The list of action slots suitable for this NLA strip"
msgstr "Listan över åtgärdsslotar som är lämpliga för denna NLA-remsa"

msgid "The identifier of the most recently assigned action slot. The slot identifies which sub-set of the Action is considered to be for this constraint, and its identifier is used to find the right slot when assigning an Action."
msgstr "Identifieraren för den senast tilldelade åtgärdsslotten. Åtgärdsslotten anger vilken delmängd av åtgärden som hör till denna begränsning, och dess identifierare används för att hitta rätt åtgärdsslot när en åtgärd tilldelas."
