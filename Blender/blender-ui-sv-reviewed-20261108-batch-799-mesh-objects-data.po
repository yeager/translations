#. :src: bpy.types.SpaceView3D.show_object_select_mesh
#. :src: bpy.types.XrSessionSettings.show_object_select_mesh
msgid "Allow selection of mesh objects"
msgstr "Tillåt val av meshobjekt"

msgid "Cannot add Rigid Body to non mesh object"
msgstr ""
"Det går inte att lägga till Rigid Body till ett objekt som inte är ett "
"meshobjekt"

#. :src: bpy.types.Modifier.type:'BUILD'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BUILD'
msgid ""
"Cause the faces of the mesh object to appear or disappear one after the "
"other over time"
msgstr ""
"Få ytorna på meshobjektet att visas eller försvinna en efter en över tid"

#. :src: bpy.types.SCULPT_OT_paint_mask_extract
msgid "Create a new mesh object from the current paint mask"
msgstr "Skapa ett nytt meshobjekt från den aktuella målningsmasken"

#. :src: bpy.types.SCULPT_OT_face_set_extract
msgid "Create a new mesh object from the selected face set"
msgstr "Skapa ett nytt meshobjekt från den valda ytuppsättningen"

#. :src: bpy.types.Object.show_all_edges
msgid "Display all edges for mesh objects"
msgstr "Visa alla kanter för meshobjekt"

msgid "Expected one other selected mesh object to copy from"
msgstr "Förväntade ett annat markerat meshobjekt att kopiera från"

#. :src: bpy.types.OBJECT_OT_convert.target:'GREASEPENCIL'
msgid "Grease Pencil from Curve or Mesh objects"
msgstr "Grease Pencil från kurv- eller meshobjekt"

#. :src: bpy.types.Mesh
msgid "Mesh data-block defining geometric surfaces"
msgstr "Meshdatablock som definierar geometriska ytor"

#. :src: bpy.types.Curves.surface
msgid "Mesh object that the curves can be attached to"
msgstr "Meshobjekt som kurvorna kan kopplas till"

#. :src: bpy.types.MeshDeformModifier.object
#. :src: bpy.types.SurfaceDeformModifier.target
msgid "Mesh object to deform with"
msgstr "Meshobjekt att deformera med"

#. :src: bpy.types.ArrayModifier.start_cap
msgid "Mesh object to use as a start cap"
msgstr "Meshobjekt som ska användas som startlock"

#. :src: bpy.types.ArrayModifier.end_cap
msgid "Mesh object to use as an end cap"
msgstr "Meshobjekt som ska användas som ändlock"

#. :src: bpy.types.BooleanModifier.object
msgid "Mesh object to use for Boolean operation"
msgstr "Meshobjekt som ska användas för boolesk operation"

msgid "Mesh object(s) have no active vertex/edge/face"
msgstr "Meshobjekt har ingen aktiv hörnpunkt, kant eller yta"

#. :src: bpy.types.MESH_OT_delete.type
msgid "Method used for deleting mesh data"
msgstr "Metod som används för att radera meshdata"

msgid "No mesh data to join"
msgstr "Inga meshdata att sammanfoga"

msgid "No mesh object"
msgstr "Inget meshobjekt"

msgid "No source mesh objects selected"
msgstr "Inga källmeshobjekt valda"

msgid "Object '%s' has no evaluated Mesh data"
msgstr "Objektet ”%s” har inga utvärderade meshdata"

#. :src: bpy.types.OBJECT_OT_convert.target:'POINTCLOUD'
msgid "Point Cloud from Mesh objects"
msgstr "Punktmoln från meshobjekt"

#. :src: KM_HIERARCHY.VIEW_3D.EMPTY:'SET_USE_SELECTED'
msgctxt "WindowManager"
msgid "Select and Use Mesh Item"
msgstr "Välj och använd meshelement"

msgid "Select and use mesh item"
msgstr "Välj och använd meshelement"

msgid "Select at least one mesh object"
msgstr "Välj minst ett meshobjekt"

msgid "Select two mesh objects"
msgstr "Välj två meshobjekt"

#. :src: bpy.types.SpaceOutliner.use_filter_object_mesh
#. :src: bpy.types.SpaceView3D.show_object_viewport_mesh
#. :src: bpy.types.XrSessionSettings.show_object_viewport_mesh
msgid "Show mesh objects"
msgstr "Visa meshobjekt"

#. :src: bpy.types.ParticleInstanceModifier.space
msgid "Space to use for copying mesh data"
msgstr "Koordinatutrymme som används för kopiering av meshdata"

#. :src: bpy.types.OBJECT_OT_data_transfer
msgctxt "Operator"
msgid "Transfer Mesh Data"
msgstr "Överför meshdata"

#. :src: bpy.types.OBJECT_OT_datalayout_transfer
msgctxt "Operator"
msgid "Transfer Mesh Data Layout"
msgstr "Överför layout för meshdata"

#. :src: bpy.types.BooleanModifier.operand_type:'COLLECTION'
msgid ""
"Use a collection of mesh objects as the operand for the Boolean operation"
msgstr "Använd en samling meshobjekt som operand för den booleska operationen"

#. :src: bpy.types.BooleanModifier.operand_type:'OBJECT'
msgid "Use a mesh object as the operand for the Boolean operation"
msgstr "Använd ett meshobjekt som operand för den booleska operationen"

#. :src: bpy.types.BooleanModifier.collection
msgid "Use mesh objects in this collection for Boolean operation"
msgstr "Använd meshobjekt i denna samling för boolesk operation"
