#. :src: bpy.types.GeometryNodeCameraInfo
msgid "Retrieve information from a camera object"
msgstr "Hämta information från ett kameraobjekt"

#. :src: bpy.types.GeometryNodeCaptureAttribute
msgid "Capture Attribute"
msgstr "Fånga attribut"

#. :src: bpy.types.GeometryNodeCaptureAttribute
msgid ""
"Store the result of a field on a geometry and output the data as a node "
"socket. Allows remembering or interpolating data as the geometry changes, "
"such as positions before deformation"
msgstr ""
"Lagra resultatet av ett fält på en geometri och mata ut data som ett "
"noduttag. Gör det möjligt att komma ihåg eller interpolera data när "
"geometrin ändras, till exempel positioner före deformation"

#. :src: bpy.types.GeometryNodeClosureInput.paired_output
#. :src: bpy.types.GeometryNodeForeachGeometryElementInput.paired_output
#. :src: bpy.types.GeometryNodeRepeatInput.paired_output
#. :src: bpy.types.GeometryNodeSimulationInput.paired_output
msgid "Zone output node that this input node is paired with"
msgstr "Zonutgångsnod som denna ingångsnod är kopplad till"

#. :src: bpy.types.GeometryNodeCollectionInfo.transform_space:'ORIGINAL'
msgid "Output the geometry relative to the collection offset"
msgstr "Mata ut geometrin i förhållande till samlingens förskjutning"

#. :src: bpy.types.GeometryNodeCollectionInfo.transform_space:'RELATIVE'
msgid ""
"Bring the input collection geometry into the modified object, maintaining "
"the relative position between the objects in the scene"
msgstr ""
"För in indatasamlingens geometri i det modifierade objektet och behåll den "
"relativa positionen mellan objekten i scenen"

#. :src: bpy.types.GeometryNodeConvexHull
msgid ""
"Create a mesh that encloses all points in the input geometry with the "
"smallest number of points"
msgstr ""
"Skapa en mesh som omsluter alla punkter i indatageometrin med minsta möjliga "
"antal punkter"

#. :src: bpy.types.GeometryNodeCornersOfEdge
msgid "Corners of Edge"
msgstr "Hörn på kant"

#. :src: bpy.types.GeometryNodeCornersOfEdge
msgid "Retrieve face corners connected to edges"
msgstr "Hämta ythörn som är kopplade till kanter"

#. :src: bpy.types.GeometryNodeCornersOfFace
msgid "Corners of Face"
msgstr "Ytans hörn"

#. :src: bpy.types.GeometryNodeCornersOfFace
msgid "Retrieve corners that make up a face"
msgstr "Hämta hörn som bildar en yta"

#. :src: bpy.types.GeometryNodeCornersOfVertex
msgid "Corners of Vertex"
msgstr "Hörn på hörnpunkt"

#. :src: bpy.types.GeometryNodeCornersOfVertex
msgid "Retrieve face corners connected to vertices"
msgstr "Hämta ythörn som är anslutna till hörnpunkter"

#. :src: bpy.types.GeometryNodeCurveArc.mode:'RADIUS'
msgid "Define radius with a float"
msgstr "Definiera radien med ett flyttal"

#. :src: bpy.types.GeometryNodeCurveEndpointSelection
msgid "Endpoint Selection"
msgstr "Ändpunktsurval"

#. :src: bpy.types.GeometryNodeCurveEndpointSelection
msgid "Provide a selection for an arbitrary number of endpoints in each spline"
msgstr ""
"Tillhandahåll ett urval för ett godtyckligt antal ändpunkter i varje spline"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.handle_type:'AUTO'
#. :src: bpy.types.GeometryNodeCurveSetHandles.handle_type:'AUTO'
#. :src: bpy.types.CURVES_OT_handle_type_set.type:'AUTO'
#. :src: bpy.types.GREASE_PENCIL_OT_set_handle_type.type:'AUTO'
msgid "The location is automatically calculated to be smooth"
msgstr "Positionen beräknas automatiskt för att vara jämn"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.handle_type:'VECTOR'
#. :src: bpy.types.GeometryNodeCurveSetHandles.handle_type:'VECTOR'
#. :src: bpy.types.CURVES_OT_handle_type_set.type:'VECTOR'
#. :src: bpy.types.GREASE_PENCIL_OT_set_handle_type.type:'VECTOR'
msgid "The location is calculated to point to the next/previous control point"
msgstr "Positionen beräknas peka mot nästa/föregående kontrollpunkt"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.mode:'RIGHT'
#. :src: bpy.types.GeometryNodeCurveSetHandles.mode:'RIGHT'
#. :src: bpy.types.GeometryNodeSetCurveHandlePositions.mode:'RIGHT'
msgid "Use the right handles"
msgstr "Använd de högra handtagen"

#. :src: bpy.types.GeometryNodeCurveLength
msgid "Retrieve the length of all splines added together"
msgstr "Hämta den sammanlagda längden för alla splines"

#. :src: bpy.types.GeometryNodeCurvePrimitiveCircle
msgid "Curve Circle"
msgstr "Kurvcirkel"

#. :src: bpy.types.GeometryNodeCurvePrimitiveCircle
msgid "Generate a poly spline circle"
msgstr "Generera en polyspline-cirkel"

#. :src: bpy.types.GeometryNodeCurvePrimitiveCircle.mode:'RADIUS'
msgid "Define the radius with a float"
msgstr "Definiera radien med ett flyttal"

#. :src: bpy.types.GeometryNodeCurvePrimitiveLine
msgid "Curve Line"
msgstr "Kurvlinje"

#. :src: bpy.types.GeometryNodeCurvePrimitiveLine
msgid "Generate a poly spline line with two points"
msgstr "Generera en polyspline-linje med två punkter"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral
msgid "Quadrilateral"
msgstr "Fyrhörning"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'TRAPEZOID'
msgid "Create a trapezoid"
msgstr "Skapa en trapets"

#. :src: bpy.types.GeometryNodeCurveSetHandles
msgid "Set Handle Type"
msgstr "Ange handtagstyp"

#. :src: bpy.types.GeometryNodeCurveSpiral
msgid "Spiral"
msgstr "Spiral"

#. :src: bpy.types.GeometryNodeCurveSplineType
msgid "Set Spline Type"
msgstr "Ange splinetyp"

#. :src: bpy.types.GeometryNodeCurveToMesh
msgid "Curve to Mesh"
msgstr "Kurva till mesh"

#. :src: bpy.types.GeometryNodeCurveToMesh
msgid ""
"Convert curves into a mesh, optionally with a custom profile shape defined "
"by curves"
msgstr ""
"Konvertera kurvor till en mesh, eventuellt med en anpassad profilform som "
"definieras av kurvorna"

#. :src: bpy.types.GeometryNodeCurveToPoints.mode
msgid "How to generate points from the input curve"
msgstr "Hur punkter ska genereras från indatakurvan"

#. :src: bpy.types.GeometryNodeCurveToPoints.mode:'LENGTH'
msgid ""
"Sample each spline by splitting it into segments with the specified length"
msgstr "Provta varje spline genom att dela upp den i segment med angiven längd"

#. :src: bpy.types.GeometryNodeCurvesToGreasePencil
msgid "Curves to Grease Pencil"
msgstr "Kurvor till Grease Pencil"

#. :src: bpy.types.GeometryNodeCustomGroup
msgid "Geometry Custom Group"
msgstr "Anpassad geometrigrupp"

#. :src: bpy.types.GeometryNodeDeformCurvesOnSurface
msgid ""
"Translate and rotate curves based on changes between the object's original "
"and evaluated surface mesh"
msgstr ""
"Förskjut och rotera kurvor baserat på förändringar mellan objektets "
"ursprungliga och utvärderade ytnät"

#. :src: bpy.types.GeometryNodeDistributePointsInGrid
msgid "Distribute Points in Grid"
msgstr "Fördela punkter i ett rutnät"

#. :src: bpy.types.GeometryNodeDistributePointsInGrid
msgid "Generate points inside a volume grid"
msgstr "Generera punkter i ett volymrutnät"

#. :src: bpy.types.GeometryNodeDistributePointsOnFaces.distribute_method:'POISSON'
msgid ""
"Distribute the points randomly on the surface while taking a minimum "
"distance between points into account"
msgstr ""
"Distribuera punkterna slumpvis på ytan och ta hänsyn till ett minimalt "
"avstånd mellan punkterna"

#. :src: bpy.types.GeometryNodeDualMesh
msgid "Convert Faces into vertices and vertices into faces"
msgstr "Konvertera ytor till hörnpunkter och hörnpunkter till ytor"

#. :src: bpy.types.GeometryNodeDuplicateElements
msgid "Generate an arbitrary number copies of each selected input element"
msgstr "Generera ett godtyckligt antal kopior av varje valt indataelement"

#. :src: bpy.types.GeometryNodeEdgesOfCorner
msgid "Edges of Corner"
msgstr "Kanter vid ythörn"

#. :src: bpy.types.GeometryNodeEdgesOfVertex
msgid "Edges of Vertex"
msgstr "Kanter vid hörnpunkt"

#. :src: bpy.types.GeometryNodeEdgesOfVertex
msgid "Retrieve the edges connected to each vertex"
msgstr "Hämta kanterna som är anslutna till varje hörnpunkt"

#. :src: bpy.types.GeometryNodeEdgesToFaceGroups
#: source/blender/nodes/geometry/nodes/node_geo_edges_to_face_groups.cc:40
msgid "Edges to Face Groups"
msgstr "Kanter till ytgrupper"

#. :src: bpy.types.GeometryNodeEdgesToFaceGroups
msgid "Group faces into regions surrounded by the selected boundary edges"
msgstr "Gruppera ytor i områden som omges av de valda begränsningskanterna"

#. :src: bpy.types.GeometryNodeEvaluateClosure.input_items
#. :src: bpy.types.NodeGeometryEvaluateClosureInputItems
#. :src: bpy.types.NodeGeometryForeachGeometryElementInputItems
#: source/blender/nodes/geometry/nodes/node_geo_closure.cc:39
#: source/blender/nodes/geometry/nodes/node_geo_evaluate_closure.cc:84
msgid "Input Items"
msgstr "Indataobjekt"

#. :src: bpy.types.GeometryNodeEvaluateClosure.output_items
#. :src: bpy.types.NodeGeometryEvaluateClosureOutputItems
#: source/blender/nodes/geometry/nodes/node_geo_closure.cc:49
#: source/blender/nodes/geometry/nodes/node_geo_evaluate_closure.cc:92
msgid "Output Items"
msgstr "Utdataobjekt"

#. :src: bpy.types.GeometryNodeExtrudeMesh
msgid ""
"Generate new vertices, edges, or faces from selected elements and move them "
"based on an offset while keeping them connected by their boundary"
msgstr ""
"Generera nya hörnpunkter, kanter eller ytor från markerade element och "
"flytta dem med en förskjutning, samtidigt som de hålls samman vid sina "
"gränser"

#. :src: bpy.types.GeometryNodeFieldAverage
msgid "Field Average"
msgstr "Fältmedelvärde"

#. :src: bpy.types.GeometryNodeFieldMinAndMax
msgid "Field Min & Max"
msgstr "Fältets min- och maxvärde"

#. :src: bpy.types.GeometryNodeFieldMinAndMax
msgid "Calculate the minimum and maximum of a given field"
msgstr "Beräkna minimi- och maximivärdet för ett givet fält"
