msgid "Geometry Node"
msgstr "Geometrinod"

#. :src: bpy.types.GeometryNodeAccumulateField.data_type:'FLOAT'
msgid "Add floating point values"
msgstr "Lägg till flyttalsvärden"

#. :src: bpy.types.GeometryNodeAttributeStatistic
msgid "Attribute Statistic"
msgstr "Attributstatistik"

#. :src: bpy.types.GeometryNodeBake
msgid "Cache the incoming data so that it can be used without recomputation"
msgstr "Cachelagra inkommande data så att de kan användas utan omberäkning"

