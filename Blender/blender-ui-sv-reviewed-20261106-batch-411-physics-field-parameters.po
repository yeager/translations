#. :src: bpy.types.FieldSettings.quadratic_drag
msgid "Quadratic Drag"
msgstr "Kvadratiskt motstånd"

#. :src: bpy.types.FieldSettings.quadratic_drag
msgid "Drag component proportional to the square of velocity"
msgstr "Motståndskomponent som är proportionell mot hastighetens kvadrat"

#. :src: bpy.types.FieldSettings.radial_falloff
msgid "Radial Falloff Power"
msgstr "Exponent för radiellt avtagande"

#. :src: bpy.types.FieldSettings.radial_falloff
msgid "Radial falloff power (real gravitational falloff = 2)"
msgstr "Exponent för radiellt avtagande (verkligt gravitationsavtagande = 2)"

#. :src: bpy.types.FieldSettings.radial_max
msgid "Maximum Radial Distance"
msgstr "Maximalt radiellt avstånd"

#. :src: bpy.types.FieldSettings.radial_max
msgid "Maximum radial distance for the field to work"
msgstr "Maximalt radiellt avstånd för att fältet ska fungera"

#. :src: bpy.types.FieldSettings.radial_min
msgid "Minimum Radial Distance"
msgstr "Minsta radiella avstånd"

#. :src: bpy.types.FieldSettings.radial_min
msgid "Minimum radial distance for the field's falloff"
msgstr "Minsta radiella avstånd för fältets avtagande"

#. :src: bpy.types.FieldSettings.rest_length
#. :src: bpy.types.SPHFluidSettings.rest_length
msgid "Rest Length"
msgstr "Vilolängd"

#. :src: bpy.types.FieldSettings.rest_length
msgid "Rest length of the harmonic force"
msgstr "Vilolängd för den harmoniska kraften"

#. :src: bpy.types.FieldSettings.seed
msgid "Seed of the noise"
msgstr "Brusets frö"

#. :src: bpy.types.FieldSettings.shape
msgid "Which direction is used to calculate the effector force"
msgstr "Vilken riktning används för att beräkna effektorkraften"

#. :src: bpy.types.FieldSettings.shape:'POINT'
msgid "Field originates from the object center"
msgstr "Fältet utgår från objektets centrum"

#. :src: bpy.types.FieldSettings.shape:'LINE'
msgid "Field originates from the local Z axis of the object"
msgstr "Fältet utgår från objektets lokala Z-axel"

#. :src: bpy.types.FieldSettings.shape:'PLANE'
msgid "Field originates from the local XY plane of the object"
msgstr "Fältet utgår från objektets lokala XY-plan"

#. :src: bpy.types.FieldSettings.shape:'SURFACE'
msgid "Field originates from the surface of the object"
msgstr "Fältet utgår från objektets yta"

#. :src: bpy.types.FieldSettings.shape:'POINTS'
msgid "Every Point"
msgstr "Varje punkt"

#. :src: bpy.types.FieldSettings.shape:'POINTS'
msgid "Field originates from all of the vertices of the object"
msgstr "Fältet utgår från objektets alla hörnpunkter"

#. :src: bpy.types.FieldSettings.size
msgid "Size of the turbulence"
msgstr "Turbulensens storlek"

#. :src: bpy.types.FieldSettings.source_object
msgid "Domain Object"
msgstr "Domänobjekt"

#. :src: bpy.types.FieldSettings.source_object
msgid "Select domain object of the smoke simulation"
msgstr "Välj domänobjekt för röksimuleringen"

#. :src: bpy.types.FieldSettings.strength
msgid "Strength of force field"
msgstr "Kraftfältets styrka"

#. :src: bpy.types.FieldSettings.texture
msgid "Texture to use as force"
msgstr "Textur som används som kraft"
