#. :src: bpy.types.EditBone
msgid "Edit Bone"
msgstr "Redigeringsben"

#. :src: bpy.types.EditBone
msgid "Edit mode bone in an armature data-block"
msgstr "Ett ben i redigeringsläge i ett armaturdatablock"

#. :src: bpy.types.EditBone.head
msgid "Location of head end of the bone"
msgstr "Placering av benets huvudände"

#. :src: bpy.types.EditBone.hide
msgid "Bone is not visible when in Edit Mode"
msgstr "Benet är inte synligt i redigeringsläget"

#. :src: bpy.types.EditBone.length
msgid "Length of the bone. Changing moves the tail end."
msgstr "Benets längd. En ändring flyttar benspetsen."

#. :src: bpy.types.EditBone.lock
msgid "Bone is not able to be transformed when in Edit Mode"
msgstr "Benet kan inte transformeras i redigeringsläget"

#. :src: bpy.types.EditBone.matrix
msgid "Edit Bone Matrix"
msgstr "Redigeringsbenets matris"

#. :src: bpy.types.EditBone.matrix
msgid ""
"Matrix combining location and rotation of the bone (head position, direction "
"and roll), in armature space (does not include/support bone's length/size)"
msgstr ""
"Matris som kombinerar benets läge och rotation (huvudändens position, "
"riktning och rullning) i armaturens koordinatsystem (omfattar eller stöder "
"inte benets längd eller storlek)"

#. :src: bpy.types.EditBone.parent
msgid "Parent edit bone (in same Armature)"
msgstr "Överordnat redigeringsben (i samma armatur)"

#. :src: bpy.types.EditBone.roll
#. :src: bpy.types.ARMATURE_OT_roll_clear.roll
#. :src: bpy.types.VIEW3D_OT_view_orbit.angle
#. :src: bpy.types.VIEW3D_OT_view_roll.angle
msgid "Roll"
msgstr "Rullning"
