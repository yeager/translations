#. :src: bpy.types.WorkSpace
msgid "Workspace data-block, defining the working environment for the user"
msgstr "Arbetsytedatablock som definierar användarens arbetsmiljö"

#. :src: bpy.types.WorkSpace.active_addon
msgid "Active Add-on in the Workspace Add-ons filter"
msgstr "Aktivt tillägg i filtret Tillägg i arbetsytan"

#. :src: bpy.types.WorkSpace.object_mode
msgid "Switch to this object mode when activating the workspace"
msgstr "Växla till detta objektläge när du aktiverar arbetsytan"

#. :src: bpy.types.WorkSpace.screens
msgid "Screen layouts of a workspace"
msgstr "En arbetsytas skärmlayouter"

#. :src: bpy.types.WorkSpace.use_pin_scene
msgid "Pin Scene"
msgstr "Fäst scen"

#. :src: bpy.types.WorkSpace.use_pin_scene
msgid ""
"Remember the last used scene for the workspace and switch to it whenever "
"this workspace is activated again"
msgstr ""
"Kom ihåg den senast använda scenen för arbetsytan och byt till den när "
"arbetsytan aktiveras igen"

#. :src: bpy.types.IDOverrideLibrary
msgid "ID Library Override"
msgstr "ID-biblioteksåsidosättning"

#. :src: bpy.types.IDOverrideLibrary
msgid "Struct gathering all data needed by overridden linked IDs"
msgstr "Struktur som samlar alla data som behövs för åsidosatta länkade ID:n"

#. :src: bpy.types.IDOverrideLibrary.hierarchy_root
msgid "Hierarchy Root ID"
msgstr "Hierarkirot-ID"

#. :src: bpy.types.IDOverrideLibrary.hierarchy_root
msgid ""
"Library override ID used as root of the override hierarchy this ID is a "
"member of"
msgstr ""
"ID för biblioteksåsidosättning som används som rot i den "
"åsidosättningshierarki som detta ID ingår i"

#. :src: bpy.types.IDOverrideLibrary.is_in_hierarchy
msgid "Is In Hierarchy"
msgstr "Ingår i hierarki"

#. :src: bpy.types.IDOverrideLibrary.is_system_override
msgid "Is System Override"
msgstr "Är systemåsidosättning"

#. :src: bpy.types.IDOverrideLibrary.reference
msgid "Linked ID used as reference by this override"
msgstr "Länkat ID som används som referens av denna åsidosättning"

#. :src: bpy.types.IDOverrideLibraryProperties
msgid "Override Properties"
msgstr "Åsidosättningsegenskaper"

#. :src: bpy.types.IDOverrideLibraryProperty
msgid "Description of an overridden property"
msgstr "Beskrivning av en åsidosatt egenskap"

#. :src: bpy.types.IDOverrideLibraryPropertyOperation.operation
msgid "What override operation is performed"
msgstr "Vilken åsidosättningsåtgärd som utförs"

#. :src: bpy.types.IDOverrideLibraryPropertyOperation.operation:'REPLACE'
msgid "Replace value of reference by overriding one"
msgstr "Ersätt referensens värde med åsidosättningsvärdet"

#. :src: bpy.types.IDOverrideLibraryPropertyOperation.subitem_local_id
msgid "Subitem Local ID"
msgstr "Lokalt ID för underobjekt"

#. :src: bpy.types.IDOverrideLibraryPropertyOperation.subitem_local_index
msgid "Subitem Local Index"
msgstr "Lokalt index för underobjekt"
