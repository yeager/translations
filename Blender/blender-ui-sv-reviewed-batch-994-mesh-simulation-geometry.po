#: source/blender/makesrna/intern/rna_fluid.cc:1219
msgid "Emit fluid from mesh surface or volume"
msgstr "Avge vätska från meshens yta eller volym"

#: source/blender/makesrna/intern/rna_object_api.cc:561
msgid "No vertex groups assigned to mesh"
msgstr "Inga hörnpunktsgrupper har tilldelats meshen"

#: source/blender/modifiers/intern/MOD_boolean.cc:197
msgid "Cannot execute, the selected collection contains non mesh objects"
msgstr "Det går inte att utföra; den valda samlingen innehåller objekt som inte är meshobjekt"

#: source/blender/modifiers/intern/MOD_meshcache.cc:164
msgid "'Integrate' only valid for Mesh objects"
msgstr "”Integrera” gäller endast för meshobjekt"

#: source/blender/modifiers/intern/MOD_meshcache.cc:167
msgid "'Integrate' original mesh vertex mismatch"
msgstr "”Integrera”: Antalet hörnpunkter i den ursprungliga meshen stämmer inte överens"

#: source/blender/modifiers/intern/MOD_meshdeform.cc:335
msgid "Cannot get mesh from cage object"
msgstr "Det går inte att hämta meshen från bur-objektet"

#: source/blender/modifiers/intern/MOD_skin.cc:2024
msgid "No valid root vertex found (you need one per mesh island you want to skin)"
msgstr "Ingen giltig rothörnpunkt hittades (en behövs per meshö som ska förses med skal)"

#: source/blender/modifiers/intern/MOD_volume_to_mesh.cc:176
msgid "Could not generate mesh from grid"
msgstr "Kunde inte generera en mesh från rutnätet"

#: source/blender/nodes/geometry/nodes/node_geo_boolean.cc:47
msgid "Mesh that is subtracted from the first mesh"
msgstr "Mesh som subtraheras från den första meshen"

#: source/blender/nodes/geometry/nodes/node_geo_curve_to_mesh.cc:38
msgid "If the profile spline is cyclic, fill the ends of the generated mesh with N-gons"
msgstr "Om profilsplinen är cyklisk fylls ändarna av den genererade meshen med N-hörningar"
