#. :src: bpy.types.CameraBackgroundImage.scale
msgid "Scale the background image"
msgstr "Skala bakgrundsbilden"

#. :src: bpy.types.CameraBackgroundImage.show_background_image
msgid "Show Background Image"
msgstr "Visa bakgrundsbild"

#. :src: bpy.types.CameraBackgroundImage.show_background_image
msgid "Show this image as background"
msgstr "Visa denna bild som bakgrund"

#. :src: bpy.types.CameraBackgroundImage.show_expanded
msgid "Show the details in the user interface"
msgstr "Visa detaljerna i användargränssnittet"

#. :src: bpy.types.CameraBackgroundImage.show_on_foreground
msgid "Show On Foreground"
msgstr "Visa i förgrunden"

#. :src: bpy.types.CameraBackgroundImage.source
msgid "Background Source"
msgstr "Bakgrundskälla"

#. :src: bpy.types.CameraBackgroundImage.source
msgid "Data source used for background"
msgstr "Datakälla som används för bakgrund"

#. :src: bpy.types.CameraBackgroundImage.source:'MOVIE_CLIP'
#. :src: bpy.types.CameraSolverConstraint.clip
#. :src: bpy.types.FollowTrackConstraint.clip
#. :src: bpy.types.ObjectSolverConstraint.clip
#. :src: bpy.types.MaskParent.id_type:'MOVIECLIP'
#. :src: bpy.types.CompositorNodeKeyingScreen.clip
#. :src: bpy.types.CompositorNodeMovieClip
#. :src: bpy.types.CompositorNodeMovieClip.clip
#. :src: bpy.types.CompositorNodeMovieDistortion.clip
#. :src: bpy.types.CompositorNodePlaneTrackDeform.clip
#. :src: bpy.types.CompositorNodeStabilize.clip
#. :src: bpy.types.CompositorNodeTrackPos.clip
#. :src: bpy.types.SEQUENCER_PT_movie_clip
#. :src: bpy.types.SpaceClipEditor.clip
#. :src: bpy.types.MovieClipStrip.clip
msgid "Movie Clip"
msgstr "Filmklipp"

#. :src: bpy.types.CameraBackgroundImage.use_camera_clip
msgid "Camera Clip"
msgstr "Kamerans filmklipp"

#. :src: bpy.types.CameraBackgroundImage.use_camera_clip
msgid "Use movie clip from active scene camera"
msgstr "Använd filmklippet från den aktiva scenens kamera"

#. :src: bpy.types.CameraBackgroundImage.use_flip_x
msgid "Flip Horizontally"
msgstr "Vänd vågrätt"

#. :src: bpy.types.CameraBackgroundImage.use_flip_x
msgid "Flip the background image horizontally"
msgstr "Vänd bakgrundsbilden horisontellt"

#. :src: bpy.types.CameraBackgroundImage.use_flip_y
msgid "Flip Vertically"
msgstr "Vänd vertikalt"

#. :src: bpy.types.CameraBackgroundImage.use_flip_y
msgid "Flip the background image vertically"
msgstr "Vänd bakgrundsbilden vertikalt"

#. :src: bpy.types.CameraBackgroundImages
#. :src: bpy.types.Camera.background_images
#. :src: bpy.types.DATA_PT_camera_background_image
msgid "Background Images"
msgstr "Bakgrundsbilder"

#. :src: bpy.types.CameraBackgroundImages
msgid "Collection of background images"
msgstr "Samling av bakgrundsbilder"

#. :src: bpy.types.CameraDOFSettings.aperture_blades
msgid "Blades"
msgstr "Lameller"

#. :src: bpy.types.CameraDOFSettings.aperture_blades
msgid "Number of blades in aperture for polygonal bokeh (at least 3)"
msgstr "Antal lameller i bländaren för polygonal bokeh (minst 3)"

#. :src: bpy.types.CameraDOFSettings.aperture_fstop
#. :src: bpy.types.CompositorNodeDefocus.f_stop
msgid "F-Stop"
msgstr "Bländartal"

#. :src: bpy.types.CameraDOFSettings.aperture_fstop
msgid ""
"F-Stop ratio (lower numbers give more defocus, higher numbers give a sharper "
"image)"
msgstr ""
"Bländartal (lägre värden ger större oskärpa, högre värden ger en skarpare "
"bild)"

#. :src: bpy.types.CameraDOFSettings.aperture_ratio
#. :src: bpy.types.DecimateModifier.ratio
#. :src: bpy.types.CompositorNodeColorSpill.ratio
#. :src: bpy.types.CLIP_OT_view_zoom_ratio.ratio
#. :src: bpy.types.CURVE_OT_decimate.ratio
#. :src: bpy.types.CURVE_OT_select_random.ratio
#. :src: bpy.types.GRAPH_OT_decimate.mode:'RATIO'
#. :src: bpy.types.GREASE_PENCIL_OT_select_random.ratio
#. :src: bpy.types.IMAGE_OT_view_zoom_ratio.ratio
#. :src: bpy.types.LATTICE_OT_select_random.ratio
#. :src: bpy.types.MBALL_OT_select_random_metaelems.ratio
#. :src: bpy.types.MESH_OT_decimate.ratio
#. :src: bpy.types.MESH_OT_select_random.ratio
#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'RATIO'
#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_ratio
#. :src: bpy.types.OBJECT_OT_select_random.ratio
#. :src: bpy.types.PARTICLE_OT_select_random.ratio
#. :src: bpy.types.SEQUENCER_OT_view_zoom_ratio.ratio
#: scripts/startup/bl_ui/properties_data_camera.py:487
msgid "Ratio"
msgstr "Förhållande"

#. :src: bpy.types.CameraDOFSettings.aperture_ratio
msgid "Distortion to simulate anamorphic lens bokeh"
msgstr "Distorsion för att simulera bokeh i anamorfiska objektiv"

#. :src: bpy.types.CameraDOFSettings.aperture_rotation
msgid "Rotation of blades in aperture"
msgstr "Rotation av bländarens lameller"

#. :src: bpy.types.CameraDOFSettings.focus_distance
#: scripts/addons_core/cycles/ui.py:1151
#: scripts/startup/bl_ui/properties_data_camera.py:280
#: scripts/startup/bl_ui/space_view3d.py:6951
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:22
msgid "Focus Distance"
msgstr "Fokusavstånd"

#. :src: bpy.types.CameraDOFSettings.focus_distance
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:23
msgid "Distance to the focus point for depth of field"
msgstr "Avstånd till fokuspunkten för skärpedjup"

#. :src: bpy.types.CameraDOFSettings.focus_object
msgid "Focus Object"
msgstr "Fokusobjekt"

#. :src: bpy.types.CameraDOFSettings.focus_object
msgid "Use this object to define the depth of field focal point"
msgstr "Använd detta objekt för att definiera skärpedjupets fokuspunkt"

#. :src: bpy.types.CameraDOFSettings.focus_subtarget
#: scripts/addons_core/cycles/ui.py:1147
msgid "Focus Bone"
msgstr "Fokusben"

#. :src: bpy.types.CameraDOFSettings.focus_subtarget
msgid "Use this armature bone to define the depth of field focal point"
msgstr ""
"Använd detta armaturben för att definiera fokuspunkten för skärpedjupet"

#. :src: bpy.types.CameraDOFSettings.use_dof
#: source/blender/shader_fx/intern/FX_shader_blur.cc:49
msgid "Use Depth of Field"
msgstr "Använd skärpedjup"

#. :src: bpy.types.CameraStereoData
msgid "Stereoscopy settings for a Camera data-block"
msgstr "Stereoskopiinställningar för ett kameradatablock"

#. :src: bpy.types.CameraStereoData.convergence_distance
msgid "Convergence Plane Distance"
msgstr "Avstånd till konvergensplanet"

#. :src: bpy.types.CameraStereoData.convergence_distance
msgid ""
"The converge point for the stereo cameras (often the distance between a "
"projector and the projection screen)"
msgstr ""
"Konvergenspunkten för stereokamerorna (ofta avståndet mellan en projektor "
"och projektionsduken)"

#. :src: bpy.types.CameraStereoData.convergence_mode:'OFFAXIS'
msgid "Off-Axis"
msgstr "Utanför axeln"

#. :src: bpy.types.CameraStereoData.convergence_mode:'OFFAXIS'
msgid "Off-axis frustums converging in a plane"
msgstr "Frustum utanför axeln som konvergerar i ett plan"

#. :src: bpy.types.CameraStereoData.convergence_mode:'PARALLEL'
#. :src: bpy.types.GPencilSculptGuide.type:'PARALLEL'
msgid "Parallel"
msgstr "Parallell"

#. :src: bpy.types.CameraStereoData.convergence_mode:'PARALLEL'
msgid "Parallel cameras with no convergence"
msgstr "Parallella kameror utan konvergens"

#. :src: bpy.types.CameraStereoData.convergence_mode:'TOE'
msgid "Toe-in"
msgstr "Inåtvinklad"

#. :src: bpy.types.CameraStereoData.convergence_mode:'TOE'
msgid "Rotated cameras, looking at the same point at the convergence distance"
msgstr "Roterade kameror som tittar på samma punkt vid konvergensavståndet"

#. :src: bpy.types.CameraStereoData.interocular_distance
msgid "Interocular Distance"
msgstr "Interokulärt avstånd"

#. :src: bpy.types.CameraStereoData.interocular_distance
msgid ""
"Set the distance between the eyes - the stereo plane distance / 30 should be "
"fine"
msgstr ""
"Ställ in avståndet mellan ögonen – stereoplanets avstånd / 30 är ett "
"lämpligt värde"

#. :src: bpy.types.CameraStereoData.pivot
#. :src: bpy.types.Constraint.type:'PIVOT'
#. :src: bpy.types.LineStyleGeometryModifier_2DTransform.pivot
#. :src: bpy.types.POSE_OT_constraint_add.type:'PIVOT'
#. :src: bpy.types.POSE_OT_constraint_add_with_targets.type:'PIVOT'
#. :src: bpy.types.SpaceImageEditor.pivot_point
#: source/blender/blenkernel/intern/constraint.cc:4770
#: source/blender/nodes/function/nodes/node_fn_align_euler_to_vector.cc:31
#: source/blender/nodes/function/nodes/node_fn_align_rotation_to_vector.cc:35
msgid "Pivot"
msgstr "Vridpunkt"

#. :src: bpy.types.CameraStereoData.pole_merge_angle_from
msgid "Pole Merge Start Angle"
msgstr "Startvinkel för polsammanfogning"

#. :src: bpy.types.CameraStereoData.pole_merge_angle_from
msgid "Angle at which interocular distance starts to fade to 0"
msgstr "Vinkel vid vilken det interokulära avståndet börjar minska till 0"

#. :src: bpy.types.CameraStereoData.pole_merge_angle_to
msgid "Pole Merge End Angle"
msgstr "Slutvinkel för polsammanfogning"

#. :src: bpy.types.CameraStereoData.pole_merge_angle_to
msgid "Angle at which interocular distance is 0"
msgstr "Vinkel vid vilken det interokulära avståndet är 0"

#. :src: bpy.types.CameraStereoData.use_pole_merge
msgid "Use Pole Merge"
msgstr "Använd polsammanfogning"

#. :src: bpy.types.CameraStereoData.use_pole_merge
msgid "Fade interocular distance to 0 after the given cutoff angle"
msgstr ""
"Tona ned det interokulära avståndet till 0 efter den angivna gränsvinkeln"

#. :src: bpy.types.CameraStereoData.use_spherical_stereo
msgid "Spherical Stereo"
msgstr "Sfärisk stereo"

#. :src: bpy.types.CameraStereoData.use_spherical_stereo
msgid ""
"Render every pixel rotating the camera around the middle of the interocular "
"distance"
msgstr ""
"Rendera varje pixel genom att rotera kameran runt mitten av det interokulära "
"avståndet"
