msgstr "Endast aktiv nyckeluppsättning"

#: source/blender/animrig/intern/keyingsets.cc:448
msgid "Skipping path in keying set, as it has no ID (KS = '%s', path = '%s[%d]')"
msgstr "Hoppar över sökvägen i nyckeluppsättningen eftersom den saknar ID (KS = ”%s”, sökväg = ”%s[%d]”)"

#: source/blender/editors/animation/keyframing.cc:254
