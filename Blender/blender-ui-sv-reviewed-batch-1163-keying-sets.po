#. :src: bpy.types.KeyingSet
#. :src: bpy.types.ANIM_OT_keyframe_delete.type
#. :src: bpy.types.ANIM_OT_keyframe_delete_by_name.type
#. :src: bpy.types.ANIM_OT_keyframe_insert.type
