#: source/blender/editors/space_node/drawnode.cc:289
msgid "Shrink"
msgstr "Krympning"

#. :src: bpy.types.DynamicPaintSurface.frame_end
msgid "Simulation end frame"
msgstr "Simuleringens slutbildruta"

