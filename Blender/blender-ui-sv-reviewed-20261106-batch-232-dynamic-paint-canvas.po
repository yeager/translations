msgid "Adjust radius of proximity brushes or particles for this surface"
msgstr "Justera radien för närhetspenslar eller partiklar på den här ytan"

#. :src: bpy.types.DynamicPaintSurface.color_dry_threshold
msgid "Color Dry"
msgstr "Färgtorkning"

#. :src: bpy.types.DynamicPaintSurface.depth_clamp
msgid "Max Displace"
msgstr "Maximal förskjutning"

#. :src: bpy.types.DynamicPaintSurface.depth_clamp
msgid ""
"Maximum level of depth intersection in object space (use 0.0 to disable)"
msgstr ""
"Högsta nivå av djupskärning i objektrymden (använd 0,0 för att inaktivera)"

#. :src: bpy.types.DynamicPaintSurface.displace_factor
msgid "Strength of displace when applied to the mesh"
msgstr "Styrkan hos förskjutningen när den tillämpas på meshet"

#. :src: bpy.types.DynamicPaintSurface.effect_ui:'DRIP'
