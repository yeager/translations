#: ../../manual/editors/preferences/interface.rst:298
msgid "Text Rendering"
msgstr "Textåtergivning"

#: ../../manual/editors/preferences/interface.rst:302
msgid "Anti-Aliasing"
msgstr "Kantutjämning"

#: ../../manual/editors/preferences/interface.rst:303
msgid "Enable interface text :term:`Anti-Aliasing`. When disabled, texts are rendered using straight text rendering (filling only absolute pixels)."
msgstr "Aktivera :term:`kantutjämning` för gränssnittstext. När funktionen är inaktiverad återges text utan kantutjämning (endast hela bildpunkter fylls)."

#: ../../manual/editors/preferences/interface.rst:308
msgid "Subpixel Anti-Aliasing"
msgstr "Kantutjämning på subpixelnivå"

#: ../../manual/editors/preferences/interface.rst:309
msgid "Render text for optimal horizontal placement."
msgstr "Återger text med optimal vågrät placering."

#: ../../manual/editors/preferences/interface.rst:313
msgid "Hinting"
msgstr "Teckensnittshintning"

#: ../../manual/editors/preferences/interface.rst:314
msgid "Adjust `font hinting <https://en.wikipedia.org/wiki/Font_hinting>`__, controls the spacing and crispness of text display."
msgstr "Justerar `teckensnittshintning <https://en.wikipedia.org/wiki/Font_hinting>`__, som styr teckenavståndet och skärpan i textåtergivningen."

#: ../../manual/editors/preferences/interface.rst:319
msgid "Interface Font"
msgstr "Teckensnitt för gränssnittet"

#: ../../manual/editors/preferences/interface.rst:320
msgid "Replacement for the default user interface font."
msgstr "Ersätter standardteckensnittet i användargränssnittet."

#: ../../manual/editors/preferences/interface.rst:324
msgid "Mono-space Font"
msgstr "Teckensnitt med fast bredd"

#: ../../manual/editors/preferences/interface.rst:325
msgid "Replacement for the default mono-space interface font *(used in the Text editor and Python Console)*."
msgstr "Ersätter standardteckensnittet med fast bredd i gränssnittet *(används i textredigeraren och Python-konsolen)*."
