#. :src: bpy.types.Mesh
msgid "Mesh data-block defining geometric surfaces"
msgstr "Meshdatablock som definierar geometriska ytor"

#. :src: bpy.types.Mesh.edges
msgid "Edges of the mesh"
msgstr "Meshens kanter"

#. :src: bpy.types.Mesh.has_custom_normals
msgid "True if there is custom normal data for this mesh"
msgstr "Sant om meshen har anpassade normaldata"

#. :src: bpy.types.Mesh.loop_triangles
#. :src: bpy.types.MeshLoopTriangles
msgid "Tessellation of mesh polygons into triangles"
msgstr "Tessellering av meshens polygoner till trianglar"

#. :src: bpy.types.Mesh.loops
msgid "Loops of the mesh (face corners)"
msgstr "Meshens slingor (ythörn)"

#. :src: bpy.types.Mesh.polygons
msgid "Polygons of the mesh"
msgstr "Meshens polygoner"

#. :src: bpy.types.Mesh.texco_mesh
msgid "Texture Space Mesh"
msgstr "Mesh för texturutrymme"

#. :src: bpy.types.Mesh.texco_mesh
msgid "Derive texture coordinates from another mesh"
msgstr "Hämta texturkoordinater från en annan mesh"

#. :src: bpy.types.Mesh.texture_mesh
msgid "Texture Mesh"
msgstr "Texturmesh"

#. :src: bpy.types.Mesh.use_remesh_preserve_attributes
msgid "Transfer all attributes to the new mesh"
msgstr "Överför alla attribut till den nya meshen"

#. :src: bpy.types.Mesh.vertices
msgid "Vertices of the mesh"
msgstr "Meshens hörnpunkter"
