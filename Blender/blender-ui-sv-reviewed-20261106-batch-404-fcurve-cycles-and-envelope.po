#. :src: bpy.types.FModifierCycles
msgid "Cycles F-Modifier"
msgstr "Cykel-F-kurvmodifierare"

#. :src: bpy.types.FModifierCycles
msgid "Repeat the values of the modified F-Curve"
msgstr "Upprepa värdena för den modifierade F-kurvan"

# was: cyclist. what?
#. :src: bpy.types.FModifierCycles.cycles_after
msgid "After Cycles"
msgstr "Cykler efter"

#. :src: bpy.types.FModifierCycles.cycles_after
msgid "Maximum number of cycles to allow after last keyframe (0 = infinite)"
msgstr "Maximalt antal cykler efter den sista nyckelbildrutan (0 = oändligt)"

#. :src: bpy.types.FModifierCycles.cycles_before
msgid "Before Cycles"
msgstr "Cykler före"

#. :src: bpy.types.FModifierCycles.cycles_before
msgid "Maximum number of cycles to allow before first keyframe (0 = infinite)"
msgstr "Maximalt antal cykler före den första nyckelbildrutan (0 = oändligt)"

#. :src: bpy.types.FModifierCycles.mode_after
msgid "After Mode"
msgstr "Läge efter"

#. :src: bpy.types.FModifierCycles.mode_after
msgid "Cycling mode to use after last keyframe"
msgstr "Läge som används efter den sista nyckelbildrutan"

# was: cyclist. what?
#. :src: bpy.types.FModifierCycles.mode_after:'NONE'
#. :src: bpy.types.FModifierCycles.mode_before:'NONE'
msgid "No Cycles"
msgstr "Ingen upprepning"

#. :src: bpy.types.FModifierCycles.mode_after:'NONE'
#. :src: bpy.types.FModifierCycles.mode_before:'NONE'
msgid "Don't do anything"
msgstr "Gör ingenting"

#. :src: bpy.types.FModifierCycles.mode_after:'REPEAT'
#. :src: bpy.types.FModifierCycles.mode_before:'REPEAT'
msgid "Repeat Motion"
msgstr "Upprepa rörelsen"

#. :src: bpy.types.FModifierCycles.mode_after:'REPEAT'
#. :src: bpy.types.FModifierCycles.mode_before:'REPEAT'
msgid "Repeat keyframe range as-is"
msgstr "Upprepa nyckelbildruteintervallet utan ändringar"

#. :src: bpy.types.FModifierCycles.mode_after:'REPEAT_OFFSET'
#. :src: bpy.types.FModifierCycles.mode_before:'REPEAT_OFFSET'
msgid "Repeat with Offset"
msgstr "Upprepa med förskjutning"

#. :src: bpy.types.FModifierCycles.mode_after:'REPEAT_OFFSET'
#. :src: bpy.types.FModifierCycles.mode_before:'REPEAT_OFFSET'
msgid ""
"Repeat keyframe range, but with offset based on gradient between start and "
"end values"
msgstr ""
"Upprepa nyckelbildruteintervallet, men med en förskjutning baserad på "
"lutningen mellan start- och slutvärdena"

#. :src: bpy.types.FModifierCycles.mode_after:'MIRROR'
#. :src: bpy.types.FModifierCycles.mode_before:'MIRROR'
msgid "Repeat Mirrored"
msgstr "Upprepa spegelvänt"

#. :src: bpy.types.FModifierCycles.mode_after:'MIRROR'
#. :src: bpy.types.FModifierCycles.mode_before:'MIRROR'
msgid "Alternate between forward and reverse playback of keyframe range"
msgstr "Växla mellan framåt- och bakåtuppspelning av nyckelbildruteintervallet"

#. :src: bpy.types.FModifierCycles.mode_before
msgid "Before Mode"
msgstr "Läge före"

#. :src: bpy.types.FModifierCycles.mode_before
msgid "Cycling mode to use before first keyframe"
msgstr "Läge som används före den första nyckelbildrutan"

#. :src: bpy.types.FModifierEnvelope
msgid "Envelope F-Modifier"
msgstr "Kuvert-F-kurvmodifierare"

#. :src: bpy.types.FModifierEnvelope
msgid "Scale the values of the modified F-Curve"
msgstr "Skala värdena för den modifierade F-kurvan"

#. :src: bpy.types.FModifierEnvelope.control_points
#. :src: bpy.types.FModifierEnvelopeControlPoints
#. :src: bpy.types.Menu
#. :src: bpy.types.VIEW3D_MT_edit_curve_ctrlpoints
#. :src: bpy.types.VIEW3D_MT_edit_curves_control_points
#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
msgid "Control Points"
msgstr "Kontrollpunkter"

#. :src: bpy.types.FModifierEnvelope.control_points
#. :src: bpy.types.FModifierEnvelopeControlPoints
msgid "Control points defining the shape of the envelope"
msgstr "Kontrollpunkter som definierar kuvertets form"

#. :src: bpy.types.FModifierEnvelope.default_max
msgid "Default Maximum"
msgstr "Standardmaximum"

#. :src: bpy.types.FModifierEnvelope.default_max
msgid "Upper distance from Reference Value for 1:1 default influence"
msgstr "Övre avstånd från referensvärdet vid standardpåverkan 1:1"

#. :src: bpy.types.FModifierEnvelope.default_min
msgid "Default Minimum"
msgstr "Standardminimum"

#. :src: bpy.types.FModifierEnvelope.default_min
msgid "Lower distance from Reference Value for 1:1 default influence"
msgstr "Nedre avstånd från referensvärdet vid standardpåverkan 1:1"

#. :src: bpy.types.FModifierEnvelope.reference_value
msgid "Reference Value"
msgstr "Referensvärde"

#. :src: bpy.types.FModifierEnvelope.reference_value
msgid "Value that envelope's influence is centered around / based on"
msgstr "Värde som kuvertets påverkan centreras kring eller baseras på"

#. :src: bpy.types.FModifierFunctionGenerator
msgid "Built-In Function F-Modifier"
msgstr "F-kurvmodifierare för inbyggd funktion"

#. :src: bpy.types.FModifierFunctionGenerator
msgid "Generate values using a built-in function"
msgstr "Generera värden med hjälp av en inbyggd funktion"
