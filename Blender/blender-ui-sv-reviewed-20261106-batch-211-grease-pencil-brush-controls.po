msgid "Strength"
msgstr "Styrka"

#. :src: bpy.types.BrushGpencilSettings.pen_strength
msgid "Color strength for new strokes (affect alpha factor of color)"
msgstr "Färgstyrka för nya streck (påverkar färgens alfafaktor)"

#. :src: bpy.types.BrushGpencilSettings.random_saturation_factor
msgid "Random factor to modify original saturation"
msgstr "Slumpfaktor för att ändra den ursprungliga mättnaden"

#. :src: bpy.types.BrushGpencilSettings.random_value_factor
msgid "Random factor to modify original value"
msgstr "Slumpfaktor för att ändra originalvärdet"

#. :src: bpy.types.BrushGpencilSettings.show_fill
msgid "Show transparent lines to use as boundary for filling"
msgstr "Visa transparenta linjer för att använda som avgränsning för fyllning"

#. :src: bpy.types.BrushGpencilSettings.show_fill_boundary
msgid "Show help lines for filling to see boundaries"
msgstr "Visa hjälplinjer för fyllning för att se gränser"

#. :src: bpy.types.BrushGpencilSettings.show_fill_extend
#: scripts/startup/bl_ui/space_view3d_toolbar.py:1973
#: scripts/startup/bl_ui/space_view3d_toolbar.py:2934
msgid "Visual Aids"
msgstr "Visuella hjälpmedel"

#. :src: bpy.types.BrushGpencilSettings.show_lasso
msgid "Show Lasso"
msgstr "Visa Lasso"

#. :src: bpy.types.BrushGpencilSettings.show_lasso
msgid "Do not display fill color while drawing the stroke"
msgstr "Visa inte fyllnadsfärg när du ritar strecket"

#. :src: bpy.types.BrushGpencilSettings.simplify_pixel_threshold
msgid ""
"Threshold in screen space used for the simplify algorithm. Points within "
"this threshold are treated as if they were in a straight line."
msgstr ""
"Tröskelvärde i skärmrymden som används för förenklingsalgoritmen. Punkter "
"inom detta tröskelvärde behandlas som om de låg i en rak linje."

