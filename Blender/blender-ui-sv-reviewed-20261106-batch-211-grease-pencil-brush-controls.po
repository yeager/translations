msgid "Active Layer"
msgstr "Aktivt lager"

#. :src: bpy.types.BrushGpencilSettings.use_active_layer_only
msgid "Only edit the active layer of the object"
msgstr "Redigera endast objektets aktiva lager"

#. :src: bpy.types.BrushGpencilSettings.use_collide_strokes
msgid "Check if extend lines collide with strokes"
msgstr "Kontrollera om förlängda streck kolliderar med streck"

#. :src: bpy.types.BrushGpencilSettings.use_edit_position
#. :src: bpy.types.GreasePencilSmoothModifier.use_edit_position
msgid "Affect Position"
msgstr "Påverka position"

#. :src: bpy.types.BrushGpencilSettings.use_edit_position
msgid "The brush affects the position of the point"
msgstr "Penseln påverkar punktens position"

#. :src: bpy.types.BrushGpencilSettings.use_edit_strength
#. :src: bpy.types.GreasePencilSmoothModifier.use_edit_strength
msgid "Affect Strength"
msgstr "Påverka styrkan"

#. :src: bpy.types.BrushGpencilSettings.use_edit_strength
msgid "The brush affects the color strength of the point"
msgstr "Penseln påverkar färgstyrkan i punkten"

#. :src: bpy.types.BrushGpencilSettings.use_edit_uv
#. :src: bpy.types.GreasePencilSmoothModifier.use_edit_uv
msgid "Affect UV"
msgstr "Påverka UV"

#. :src: bpy.types.BrushGpencilSettings.use_edit_uv
msgid "The brush affects the UV rotation of the point"
msgstr "Penseln påverkar UV-rotationen av punkten"

#. :src: bpy.types.BrushGpencilSettings.use_fill_limit
msgid "Fill only visible areas in viewport"
msgstr "Fyll endast synliga områden i vyporten"

#. :src: bpy.types.BrushGpencilSettings.use_occlude_eraser
msgid "Occlude Eraser"
msgstr "Endast synliga streck"

#. :src: bpy.types.BrushGpencilSettings.use_occlude_eraser
msgid "Erase only strokes visible and not occluded"
msgstr "Radera endast streck som är synliga och inte dolda"
