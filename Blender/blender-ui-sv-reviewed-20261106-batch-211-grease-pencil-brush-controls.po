#. :src: bpy.types.BrushGpencilSettings.fill_simplify_level
msgid "Number of simplify steps (large values reduce fill accuracy)"
msgstr "Antal förenklingssteg (stora värden minskar fyllningsnoggrannheten)"

#. :src: bpy.types.BrushGpencilSettings.fill_threshold
msgid "Threshold to consider color transparent for filling"
msgstr "Tröskelvärde för att anse att färgen är transparent för fyllning"

#. :src: bpy.types.BrushGpencilSettings.hardness
msgid ""
"Gradient from the center of Dot and Box strokes (set to 1 for a solid stroke)"
msgstr ""
"Gradient från mitten av Dot- och Box-strecken (inställd på 1 för ett "
"heltäckande streck)"

#. :src: bpy.types.BrushGpencilSettings.input_samples
#. :src: bpy.types.Brush.input_samples
#. :src: bpy.types.UnifiedPaintSettings.input_samples
msgid "Input Samples"
msgstr "Indataprover"

#. :src: bpy.types.BrushGpencilSettings.material
msgid "Material used for strokes drawn using this brush"
msgstr "Material som används för streck ritade med denna pensel"

#. :src: bpy.types.BrushGpencilSettings.outline_thickness_factor
msgid "Thickness of the outline stroke relative to current brush thickness"
msgstr "Tjockleken på konturstrecket i förhållande till aktuell penseltjocklek"

