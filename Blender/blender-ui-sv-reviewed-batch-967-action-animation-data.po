#. :src: bpy.types.AnimData.action
msgid "Active Action for this data-block"
msgstr "Aktiv Action för detta datablock"

#. :src: bpy.types.AnimData.action_blend_type
msgid "Action Blending"
msgstr "Action-blandning"

#. :src: bpy.types.AnimData.action_blend_type
msgid "Method used for combining Active Action's result with result of NLA stack"
msgstr "Metod för att kombinera den aktiva Actionens resultat med resultatet från NLA-stapeln"

#. :src: bpy.types.AnimData.action_extrapolation
msgid "Action Extrapolation"
msgstr "Action-extrapolering"

#. :src: bpy.types.AnimData.action_extrapolation
msgid "Action to take for gaps past the Active Action's range (when evaluating with NLA)"
msgstr "Hantering av luckor utanför den aktiva Actionens räckvidd (vid utvärdering med NLA)"

#. :src: bpy.types.AnimData.action_influence
msgid "Action Influence"
msgstr "Actionens påverkan"

#. :src: bpy.types.AnimData.action_influence
msgid "Amount the Active Action contributes to the result of the NLA stack"
msgstr "I vilken grad den aktiva Actionen bidrar till resultatet av NLA-stapeln"

#. :src: bpy.types.AnimData.action_slot
#. :src: bpy.types.ActionConstraint.action_slot
#. :src: bpy.types.NlaStrip.action_slot
#. :src: bpy.types.ActionSlot.action_slot_ui
msgid "Action Slot"
msgstr "Action-slot"

#. :src: bpy.types.AnimData.action_slot
msgid "The slot identifies which sub-set of the Action is considered to be for this data-block, and its name is used to find the right slot when assigning an Action"
msgstr "Action-slotten anger vilken delmängd av Actionen som hör till det här datablocket, och dess namn används för att hitta rätt Action-slot när en Action tilldelas"

#. :src: bpy.types.BlendData.actions
msgid "Action data-blocks"
msgstr "Action-datablock"

#. :src: bpy.types.BlendDataActions
msgid "Main Actions"
msgstr "Huvud-Actioner"

#. :src: bpy.types.BlendImportContextItem.append_action
msgid "Append Action"
msgstr "Lägg till Action"
