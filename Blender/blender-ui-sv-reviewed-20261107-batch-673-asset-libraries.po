msgid "Active Asset Library"
msgstr "Aktivt resursbibliotek"

msgid ""
"Re-download the asset listing of a remote library. Only supported when the "
"active asset library is remote or has a remote component (the Essentials "
"library)"
msgstr ""
"Hämta resurslistan för ett fjärrbibliotek på nytt. Stöds endast när det "
"aktiva resursbiblioteket är fjärranslutet eller har en fjärrkomponent "
"(Essentials-biblioteket)"

msgid "Remote URL to the asset library"
msgstr "Fjärr-URL till resursbiblioteket"

msgid "The kind of asset library to add"
msgstr "Typ av resursbibliotek som ska läggas till"

msgid "Add Local Asset Library"
msgstr "Lägg till resursbibliotek"

msgid ""
"Add an asset library managed via the file system without referencing an "
"external repository"
msgstr ""
"Lägg till ett resursbibliotek som hanteras via filsystemet utan att "
"referera till ett externt arkiv"

msgid "Asset library requires an authentication token"
msgstr "Resursbiblioteket kräver en autentiseringstoken"

msgid "Asset Library Directory"
msgstr "Katalog för resursbibliotek"

msgid "Enable asset libraries served over HTTP/HTTPS"
msgstr "Aktivera resursbibliotek som tillhandahålls över HTTP/HTTPS"

msgid "Collection of project asset libraries"
msgstr "Samling av projektets resursbibliotek"

msgid "Signifies if the asset library is defined by a project"
msgstr "Anger om resursbiblioteket definieras av ett projekt"

msgid "Synchronize the asset library with a remote URL"
msgstr "Synkronisera resursbiblioteket med en fjärr-URL"

msgid "The unique identifier for the asset library"
msgstr "Den unika identifieraren för resursbiblioteket"

msgid "Project Asset Library"
msgstr "Projektets resursbibliotek"

msgid "The asset library this asset belongs to is not editable"
msgstr "Resursbiblioteket som resursen tillhör kan inte redigeras"

msgid "Could not find asset library URL for asset '%s'"
msgstr "Det gick inte att hitta resursbibliotekets URL för resursen ”%s”"

msgid "Asset Library '%s': %s"
msgstr "Resursbibliotek ”%s”: %s"

msgid "This asset library does not have a remote listing to download"
msgstr "Detta resursbibliotek har ingen fjärrlista att hämta"

msgid ""
"Asset Libraries are local directories that can contain .blend files with "
"assets inside.\n"
"Manage Asset Libraries from the Asset Libraries section in the Preferences"
msgstr ""
"Resursbibliotek är lokala kataloger som kan innehålla .blend-filer med "
"resurser.\n"
"Hantera resursbibliotek i avsnittet Resursbibliotek i Inställningar"

msgid "Local Asset Library"
msgstr "Lokalt resursbibliotek"

msgid "Settings of project asset libraries can be edited in Project Setup."
msgstr ""
"Inställningar för projektets resursbibliotek kan redigeras i "
"projektinställningar."

msgid "Add Asset Library"
msgstr "Lägg till resursbibliotek"

#. :src: bpy.types.PreferencesAssetLibrary
msgid "Preferences Asset Library"
msgstr "Resursbibliotek i inställningar"

#. :src: bpy.types.UserExtensionRepo.use_access_token_for_asset_libraries
msgid ""
"Asset libraries installed from this repository use its access token (cached "
"from the repository listing when syncing)"
msgstr ""
"Resursbibliotek som installerats från detta förvar använder dess "
"åtkomsttoken. Den mellanlagras från förvarsförteckningen vid synkronisering"

#: scripts/addons_core/bl_pkg/bl_extension_ops.py:3734
msgid "Asset Library \"{:s}\" is already installed!"
msgstr "Resursbiblioteket ”{:s}” är redan installerat!"

#. :src: source/blender/editors/space_userpref/userpref_ops.cc:374
msgid ""
"Asset libraries defined by an extension are removed by uninstalling the "
"extension"
msgstr ""
"Resursbibliotek som definierats av ett tillägg tas bort när tillägget "
"avinstalleras"

#. :src: source/blender/makesrna/intern/rna_userdef.cc:833
msgid "Extension defined asset libraries require a remote URL"
msgstr "Resursbibliotek som definieras av tillägg kräver en fjärradress"
