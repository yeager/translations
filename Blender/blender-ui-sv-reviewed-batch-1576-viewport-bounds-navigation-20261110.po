#. :src: bpy.types.VIEW3D_OT_cursor3d.orientation:'VIEW'
msgid "Orient to the viewport"
msgstr "Orientera efter vyporten"

#. :src: bpy.types.WM_OT_ply_export.evaluation_mode:'DAG_EVAL_VIEWPORT'
#. :src: bpy.types.WM_OT_stl_export.evaluation_mode:'DAG_EVAL_VIEWPORT'
msgid ""
"Export objects as they appear in the viewport (Multiresolution modifiers in "
"Sculpt Mode will not be evaluated)"
msgstr ""
"Exportera objekt som de visas i vyporten (flerupplösningsmodifierare i "
"skulpteringsläge utvärderas inte)"

#. :src: bpy.types.VIEW3D_OT_select_lasso
msgid "Select items using lasso selection"
msgstr "Välj objekt med lassomarkering"

#. :src: bpy.types.VIEW3D_OT_view_center_pick
msgctxt "Operator"
msgid "Center View to Mouse"
msgstr "Centrera vyn vid muspekaren"

#. :src: bpy.types.WM_OT_alembic_export.evaluation_mode
#. :src: bpy.types.WM_OT_usd_export.evaluation_mode
msgid ""
"Determines visibility of objects, modifier settings, and other areas where "
"there are different settings for viewport and rendering"
msgstr ""
"Bestämmer synligheten för objekt, modifierarinställningar och andra områden "
"där vyporten och renderingen har olika inställningar"

#. :src: bpy.types.WM_OT_alembic_export.evaluation_mode:'VIEWPORT'
#. :src: bpy.types.WM_OT_usd_export.evaluation_mode:'VIEWPORT'
msgid "Use Viewport settings for object visibility, modifier settings, etc"
msgstr ""
"Använd vyportsinställningar för objektsynlighet, modifierarinställningar med "
"mera"

#. :src: bpy.types.WM_OT_grease_pencil_import_svg.recenter_bounds
msgid "Center the imported SVG on its bounding box"
msgstr "Centrera importerad SVG efter dess begränsningsbox"

#. :src: bpy.types.WM_OT_obj_export.export_eval_mode
#. :src: bpy.types.WM_OT_ply_export.evaluation_mode
#. :src: bpy.types.WM_OT_stl_export.evaluation_mode
msgid ""
"Determines properties like object visibility, modifiers etc., where they "
"differ for Render and Viewport"
msgstr ""
"Bestämmer egenskaper som objektsynlighet och modifierare, där de skiljer sig "
"mellan rendering och vyport"

#. :src: bpy.types.WM_OT_obj_export.export_eval_mode:'DAG_EVAL_VIEWPORT'
msgid "Export objects as they appear in the viewport"
msgstr "Exportera objekt så som de visas i vyporten"

#. :src: bpy.types.WM_OT_obj_import.clamp_size
msgid "Clamp Bounding Box"
msgstr "Begränsa begränsningsboxens storlek"
