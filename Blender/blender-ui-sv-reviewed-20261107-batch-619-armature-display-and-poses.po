#. :src: bpy.types.Armature.collections_all
msgid "Bone Collections (All)"
msgstr "Bensamlingar (alla)"

#. :src: bpy.types.Armature.collections_all
msgid "List of all bone collections of the armature"
msgstr "Lista över alla bensamlingar i armaturen"

#. :src: bpy.types.Armature.display_type:'OCTAHEDRAL'
msgid "Octahedral"
msgstr "Oktaedrisk"

#. :src: bpy.types.Armature.display_type:'OCTAHEDRAL'
msgid "Display bones as octahedral shape (default)"
msgstr "Visa benen som oktaedrar (standard)"

#. :src: bpy.types.Armature.display_type:'STICK'
msgid "Stick"
msgstr "Streck"

#. :src: bpy.types.Armature.display_type:'STICK'
msgid "Display bones as simple 2D lines with dots"
msgstr "Visa benen som enkla 2D-linjer med prickar"

#. :src: bpy.types.Armature.display_type:'BBONE'
#. :src: bpy.types.NLA_OT_bake.channel_types:'BBONE'
msgid "B-Bone"
msgstr "B-Bone"

#. :src: bpy.types.Armature.display_type:'BBONE'
msgid "Display bones as boxes, showing subdivision and B-Splines"
msgstr "Visa benen som lådor med synlig underindelning och B-spline-kurvor"

#. :src: bpy.types.Armature.display_type:'ENVELOPE'
#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_ENVELOPE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_ENVELOPE'
#: source/blender/editors/space_view3d/view3d_buttons.cc:1760
#: source/blender/modifiers/intern/MOD_grease_pencil_envelope.cc:740
msgid "Envelope"
msgstr "Omslutning"

#. :src: bpy.types.Armature.display_type:'ENVELOPE'
msgid "Display bones as extruded spheres, showing deformation influence volume"
msgstr ""
"Visa benen som utdragna sfärer som visar deformationens påverkansomfång"

#. :src: bpy.types.Armature.display_type:'WIRE'
msgid "Display bones as thin wires, showing subdivision and B-Splines"
msgstr ""
"Visa benen som tunna trådar med synlig underindelning och B-spline-kurvor"

#. :src: bpy.types.Armature.edit_bones
msgid "Edit Bones"
msgstr "Redigeringsben"

#. :src: bpy.types.Armature.is_editmode
#. :src: bpy.types.Curve.is_editmode
#. :src: bpy.types.Lattice.is_editmode
#. :src: bpy.types.Mesh.is_editmode
#. :src: bpy.types.MetaBall.is_editmode
msgid "Is Editmode"
msgstr "Är i redigeringsläge"

#. :src: bpy.types.Armature.is_editmode
#. :src: bpy.types.Curve.is_editmode
#. :src: bpy.types.Lattice.is_editmode
#. :src: bpy.types.Mesh.is_editmode
#. :src: bpy.types.MetaBall.is_editmode
msgid "True when used in editmode"
msgstr "Sant när data används i redigeringsläge"

#. :src: bpy.types.Armature.pose_position
#. :src: bpy.types.Armature.pose_position:'POSE'
msgid "Pose Position"
msgstr "Poseringsläge"

#. :src: bpy.types.Armature.pose_position
msgid "Show armature in binding pose or final posed state"
msgstr "Visa armaturen i viloposition eller i det slutliga poserade läget"

#. :src: bpy.types.Armature.pose_position:'POSE'
msgid "Show armature in posed state"
msgstr "Visa armaturen i poserat läge"

#. :src: bpy.types.Armature.pose_position:'REST'
msgid "Rest Position"
msgstr "Viloposition"

#. :src: bpy.types.Armature.pose_position:'REST'
msgid "Show Armature in binding pose state (no posing possible)"
msgstr "Visa armaturen i viloposition (ingen posering möjlig)"
