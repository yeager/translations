#. :src: bpy.types.NWNodeWrangler.hotkey_list_filter
msgid "Show only hotkeys that have this text in their name"
msgstr "Visa endast snabbtangenter som har denna text i sitt namn"

#. :src: bpy.types.NWNodeWrangler.merge_hide
msgid "Hide Mix nodes"
msgstr "Dölj blandningsnoder"

#. :src: bpy.types.NWNodeWrangler.merge_hide
msgid ""
"When merging nodes with the Ctrl+Numpad0 hotkey (and similar) specify "
"whether to collapse them or show the full node with options expanded"
msgstr ""
"När noder sammanfogas med snabbtangenten Ctrl+Numpad0 (och liknande) anger "
"du om de ska fällas ihop eller visas helt med expanderade alternativ"

#. :src: bpy.types.NWNodeWrangler.merge_hide:'ALWAYS'
msgid "Always collapse the new merge nodes"
msgstr "Fäll alltid ihop de nya sammanfogningsnoderna"

#. :src: bpy.types.NWNodeWrangler.merge_hide:'NON_SHADER'
msgid "Non-Shader"
msgstr "Icke-shader"

#. :src: bpy.types.NWNodeWrangler.merge_hide:'NON_SHADER'
msgid "Collapse in all cases except for shaders"
msgstr "Fäll ihop i alla fall utom för shadernoder"

#. :src: bpy.types.NWNodeWrangler.merge_hide:'NEVER'
msgid "Never collapse the new merge nodes"
msgstr "Fäll aldrig ihop de nya sammanfogningsnoderna"

#. :src: bpy.types.NWNodeWrangler.merge_position
msgid "Mix Node Position"
msgstr "Blandningsnodens position"

#. :src: bpy.types.NWNodeWrangler.merge_position
msgid ""
"When merging nodes with the Ctrl+Numpad0 hotkey (and similar) specify the "
"position of the new nodes"
msgstr ""
"När noder sammanfogas med snabbtangenten Ctrl+Numpad0 (och liknande) anger "
"du positionen för de nya noderna"

#. :src: bpy.types.NWNodeWrangler.merge_position:'CENTER'
msgid "Place the Mix node between the two nodes"
msgstr "Placera blandningsnoden mellan de två noderna"

#. :src: bpy.types.NWNodeWrangler.merge_position:'BOTTOM'
msgid "Place the Mix node at the same height as the lowest node"
msgstr "Placera blandningsnoden på samma höjd som den lägsta noden"

#. :src: bpy.types.NWNodeWrangler.show_hotkey_list
msgid "Show Hotkey List"
msgstr "Visa lista över snabbtangenter"

#. :src: bpy.types.NWNodeWrangler.show_hotkey_list
msgid ""
"Expand this box into a list of all the hotkeys for functions in this addon"
msgstr ""
"Fäll ut den här rutan till en lista med alla snabbtangenter för funktioner i "
"det här tillägget"

#. :src: bpy.types.NWNodeWrangler.show_principled_lists
msgid "Show Principled naming tags"
msgstr "Visa namntaggar för Principled"

#. :src: bpy.types.NWNodeWrangler.show_principled_lists
msgid ""
"Expand this box into a list of all naming tags for principled texture setup"
msgstr ""
"Fäll ut rutan till en lista över alla namntaggar för Principled-"
"texturinställningen"
