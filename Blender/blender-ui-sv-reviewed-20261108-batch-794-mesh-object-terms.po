#. :src: bpy.types.BooleanModifier.collection
msgid "Use mesh objects in this collection for Boolean operation"
msgstr "Använd meshobjekt i denna samling för boolesk operation"

#. :src: bpy.types.BooleanModifier.operand_type:'OBJECT'
msgid "Use a mesh object as the operand for the Boolean operation"
msgstr "Använd ett meshobjekt som operand för den booleska operationen"

#. :src: bpy.types.BooleanModifier.operand_type:'COLLECTION'
msgid "Use a collection of mesh objects as the operand for the Boolean operation"
msgstr "Använd en samling meshobjekt som operand för den booleska operationen"

#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.name_from
msgid "Name for new mesh object and material"
msgstr "Namn på nytt meshobjekt och material"

#. :src: bpy.types.OBJECT_OT_convert.target:'POINTCLOUD'
msgid "Point Cloud from Mesh objects"
msgstr "Punktmoln från meshobjekt"

#. :src: bpy.types.OBJECT_OT_convert.target:'GREASEPENCIL'
msgid "Grease Pencil from Curve or Mesh objects"
msgstr "Grease Pencil från kurv- eller meshobjekt"

#. :src: bpy.types.OBJECT_OT_modifier_convert
msgid "Convert particles to a mesh object"
msgstr "Konvertera partiklar till ett meshobjekt"

#. :src: bpy.types.SCULPT_OT_face_set_extract
msgid "Create a new mesh object from the selected face set"
msgstr "Skapa ett nytt meshobjekt från den valda ytuppsättningen"

#. :src: bpy.types.SCULPT_OT_paint_mask_extract
msgid "Create a new mesh object from the current paint mask"
msgstr "Skapa ett nytt meshobjekt från den aktuella målningsmasken"

#. :src: bpy.types.UV_OT_smart_project
msgid "Projection unwraps the selected faces of mesh objects"
msgstr "Projektionen vecklar ut markerade ytor på meshobjekt"

#. :src: bpy.types.SpaceView3D.show_object_viewport_mesh
#. :src: bpy.types.XrSessionSettings.show_object_viewport_mesh
msgid "Show mesh objects"
msgstr "Visa meshobjekt"

#. :src: bpy.types.SpaceView3D.show_object_select_mesh
#. :src: bpy.types.XrSessionSettings.show_object_select_mesh
msgid "Allow selection of mesh objects"
msgstr "Tillåt val av meshobjekt"

#: scripts/startup/bl_operators/object.py:529
msgid "Both objects must be meshes"
msgstr "Båda objekten måste vara mesh"

#: scripts/startup/bl_operators/object.py:411
msgid "Skipping '{:s}', not a mesh"
msgstr "Hoppar över ”{:s}” eftersom det inte är en mesh"

#: scripts/startup/bl_operators/object_quick_effects.py:563
#: scripts/startup/bl_operators/object_quick_effects.py:293
msgid "Select at least one mesh object"
msgstr "Välj minst ett meshobjekt"

#: scripts/startup/bl_operators/object_quick_effects.py:279
#: source/blender/editors/mesh/mesh_join.cc:535
msgid "Active object is not a mesh"
msgstr "Det aktiva objektet är inte en mesh"

#: scripts/startup/bl_operators/object_quick_effects.py:289
msgid "Select two mesh objects"
msgstr "Välj två meshobjekt"

#: scripts/startup/bl_operators/uvcalc_lightmap.py:576
msgid "No mesh object"
msgstr "Inget meshobjekt"

#: source/blender/editors/curves/intern/curves_ops.cc:138
msgid "Curves must have a mesh surface object set"
msgstr "Kurvor måste ha ett meshobjekt som yta inställt"

#: source/blender/editors/object/object_add.cc:2466
#: source/blender/editors/sculpt_paint/mesh/paint_image_proj.cc:6434
msgid "No active mesh object"
msgstr "Inget aktivt meshobjekt"

#: source/blender/editors/object/object_bake.cc:115
msgid "Baking of multires data only works with an active mesh object"
msgstr "Beräkning av multires-data fungerar bara med ett aktivt meshobjekt"

#: source/blender/editors/object/object_multires_modifier.cc:212
msgid "Second selected mesh object required to copy shape from"
msgstr "Ett andra valt meshobjekt krävs för att kopiera formen"

#: source/blender/modifiers/intern/MOD_meshcache.cc:164
msgid "'Integrate' only valid for Mesh objects"
msgstr "”Integrera” gäller endast för meshobjekt"
