#. :src: bpy.types.PointLight.shadow_soft_size
#. :src: bpy.types.SpotLight.shadow_soft_size
#. :src: bpy.types.SunLight.shadow_soft_size
msgid "Shadow Soft Size"
msgstr "Mjuk skuggstorlek"

