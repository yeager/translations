#. :src: bpy.types.WM_OT_xr_navigation_fly
msgid "Move/turn relative to the VR viewer or controller"
msgstr "Flytta/vrid i förhållande till VR-visaren eller styrenheten"

#. :src: bpy.types.WM_OT_xr_navigation_teleport
msgid "Set VR viewer location to controller raycast hit location"
msgstr "Placera VR-visaren vid träffpunkten för styrenhetens raycast"

#. :src: bpy.types.WM_OT_xr_navigation_teleport.fallback_color
msgid "Color of raycast when a fallback case succeeds"
msgstr "Färg för raycast vid lyckat reservfall"

#. :src: bpy.types.WM_OT_xr_navigation_teleport.miss_color
msgid "Color of raycast when it misses"
msgstr "Färg för raycast vid miss"
