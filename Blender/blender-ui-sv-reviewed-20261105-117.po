#. :src: bpy.types.FunctionNodeIntegerMath
msgid "Integer Math"
msgstr "Heltalsmatematik"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'NEGATE'
msgctxt "NodeTree"
msgid "Negate"
msgstr "Negera"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'POWER'
msgid "A power B, pow(A,B)"
msgstr "A upphöjt till B, pow(A,B)"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'DIVIDE_ROUND'
msgctxt "NodeTree"
msgid "Divide Round"
msgstr "Dividera och avrunda"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'DIVIDE_FLOOR'
msgctxt "NodeTree"
msgid "Divide Floor"
msgstr "Dividera och avrunda nedåt"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'DIVIDE_FLOOR'
msgid "Divide and floor result, the largest integer smaller than or equal A"
msgstr ""
"Dividera och avrunda resultatet nedåt, till det största heltalet som är "
"mindre än eller lika med A"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'DIVIDE_CEIL'
msgctxt "NodeTree"
msgid "Divide Ceiling"
msgstr "Dividera och avrunda uppåt"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'DIVIDE_CEIL'
msgid "Divide and ceil result, the smallest integer greater than or equal A"
msgstr ""
"Dividera och avrunda resultatet uppåt, till det minsta heltalet som är "
"större än eller lika med A"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'MODULO'
msgid "Modulo which is the remainder of A / B"
msgstr "Modulo som är återstoden av A / B"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'GCD'
msgctxt "NodeTree"
msgid "Greatest Common Divisor"
msgstr "Största gemensamma delare"

#. :src: bpy.types.FunctionNodeIntegerMath.operation:'GCD'
msgid ""
"The largest positive integer that divides into each of the values A and B, "
"e.g. GCD(8,12) = 4"
msgstr ""
"Det största positiva heltal som delar vart och ett av värdena A och B, till "
"exempel GCD(8,12) = 4"

#. :src: bpy.types.FunctionNodeInvertMatrix
msgid "Invert Matrix"
msgstr "Invertera matris"

#. :src: bpy.types.FunctionNodeMatchString.operation:'STARTS_WITH'
msgid "Starts With"
msgstr "Börjar med"

#. :src: bpy.types.FunctionNodeMatchString.operation:'STARTS_WITH'
msgid "True when the first input starts with the second"
msgstr "Sant när den första indatan börjar med den andra"

#. :src: bpy.types.FunctionNodeMatchString.operation:'CONTAINS'
msgid "True when the first input contains the second as a substring"
msgstr "Sant när den första indatan innehåller den andra som en delsträng"

#. :src: bpy.types.FunctionNodeMatrixDeterminant
msgid "Matrix Determinant"
msgstr "Matrisdeterminant"

#. :src: bpy.types.FunctionNodeProjectPoint
msgid "Project Point"
msgstr "Projicera punkt"

#. :src: bpy.types.FunctionNodeProjectPoint
msgid ""
"Project a point using a matrix, using location, rotation, scale, and "
"perspective divide"
msgstr ""
"Projicera en punkt med hjälp av en matris, med hjälp av position, rotation, "
"skala och perspektivdelning"
