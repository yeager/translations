#. :src: bpy.types.CompositorNodeTonemap
msgid "Tonemap"
msgstr "Tonmappning"

#. :src: bpy.types.CompositorNodeTonemap.tonemap_type
#. :src: bpy.types.SequencerTonemapModifierData.tonemap_type
msgid "Tonemap Type"
msgstr "Tonmappningstyp"

#. :src: bpy.types.CompositorNodeTonemap.tonemap_type:'RD_PHOTORECEPTOR'
#. :src: bpy.types.SequencerTonemapModifierData.tonemap_type:'RD_PHOTORECEPTOR'
msgid "R/D Photoreceptor"
msgstr "R/D-fotoreceptor"

#. :src: bpy.types.CompositorNodeTonemap.tonemap_type:'RH_SIMPLE'
#. :src: bpy.types.SequencerTonemapModifierData.tonemap_type:'RH_SIMPLE'
msgid "Rh Simple"
msgstr "Rh enkel"

#. :src: bpy.types.CompositorNodeTrackPos
msgid "Track Position"
msgstr "Spårposition"

#. :src: bpy.types.CompositorNodeTrackPos
msgid ""
"Provide information about motion tracking points, such as x and y values"
msgstr ""
"Tillhandahåll information om filmspårningspunkter, till exempel X- och Y-"
"värden"

#. :src: bpy.types.CompositorNodeTrackPos.frame_relative
msgid "Frame to be used for relative position"
msgstr "Bildruta som ska användas för relativ position"

#. :src: bpy.types.CompositorNodeTrackPos.position
msgid "Which marker position to use for output"
msgstr "Vilken markörposition som ska användas för utdata"

#. :src: bpy.types.CompositorNodeTrackPos.position:'ABSOLUTE'
msgid "Output absolute position of a marker"
msgstr "Mata ut en markörs absoluta position"

#. :src: bpy.types.CompositorNodeTrackPos.position:'RELATIVE_FRAME'
msgid "Relative Frame"
msgstr "Relativ bildruta"

#. :src: bpy.types.CompositorNodeTrackPos.position:'ABSOLUTE_FRAME'
msgid "Absolute Frame"
msgstr "Absolut bildruta"

#. :src: bpy.types.CompositorNodeTransform
msgid "Scale, translate and rotate an image"
msgstr "Skala, förskjut och rotera en bild"

#. :src: bpy.types.CompositorNodeTranslate
#. :src: bpy.types.TextureNodeTranslate
msgid "Translate"
msgstr "Förskjut"

#. :src: bpy.types.CompositorNodeTranslate
msgid "Offset an image"
msgstr "Förskjut en bild"

#. :src: bpy.types.CompositorNodeTranslate.use_relative
msgid ""
"Use relative (fraction of input image size) values to define translation"
msgstr ""
"Använd relativa värden (en andel av indatabildens storlek) för att definiera "
"förskjutningen"

#. :src: bpy.types.CompositorNodeTranslate.wrap_axis:'NONE'
msgid "No repeating"
msgstr "Ingen upprepning"

#. :src: bpy.types.CompositorNodeVecBlur
msgid "Vector Blur"
msgstr "Vektoroskärpa"

#. :src: bpy.types.CompositorNodeViewer
#. :src: bpy.types.GeometryNodeViewer
#. :src: bpy.types.TextureNodeViewer
#: source/blender/editors/interface/regions/interface_region_tooltip.cc:1685
msgid "Viewer"
msgstr "Visare"

#. :src: bpy.types.CompositorNodeZcombine
msgid "Z Combine"
msgstr "Z-kombinering"

#. :src: bpy.types.FunctionNode
msgid "Function Node"
msgstr "Funktionsnod"

#. :src: bpy.types.FunctionNodeAxesToRotation
msgid "Axes to Rotation"
msgstr "Axlar till rotation"

#. :src: bpy.types.FunctionNodeAxisAngleToRotation
msgid "Axis Angle to Rotation"
msgstr "Axelvinkel till rotation"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'NOR'
msgid "Nor"
msgstr "Varken eller"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'XNOR'
msgid "True when both inputs are equal (exclusive nor)"
msgstr "Sant när båda indata är lika (exklusivt eller ej)"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'IMPLY'
msgid "Imply"
msgstr "Implikation"

#. :src: bpy.types.FunctionNodeCombineTransform
msgid "Combine Transform"
msgstr "Kombinera transformation"

#. :src: bpy.types.FunctionNodeCompare.data_type
#. :src: bpy.types.GeometryNodeSwitch.input_type
msgid "Input Type"
msgstr "Indatatyp"

#. :src: bpy.types.FunctionNodeCompare.operation:'GREATER_THAN'
#. :src: bpy.types.MESH_OT_select_by_pole_count.type:'GREATER'
#. :src: bpy.types.MESH_OT_select_face_by_sides.type:'GREATER'
#. :src: bpy.types.SpreadsheetRowFilter.operation:'GREATER'
msgid "Greater Than"
msgstr "Större än"

#. :src: bpy.types.FunctionNodeCompare.operation:'GREATER_EQUAL'
msgid "True when the first input is greater than the second input or equal"
msgstr "Sant när den första indatan är större än eller lika med den andra"

#. :src: bpy.types.FunctionNodeCompare.operation:'BRIGHTER'
msgid "True when the first input is brighter"
msgstr "Sant när den första indatan är ljusare"

#. :src: bpy.types.FunctionNodeCompare.operation:'DARKER'
msgid "True when the first input is darker"
msgstr "Sant när den första indatan är mörkare"

#. :src: bpy.types.FunctionNodeEulerToRotation
msgid "Euler to Rotation"
msgstr "Euler till rotation"

#. :src: bpy.types.FunctionNodeFloatToInt
msgid "Float to Integer"
msgstr "Flyttal till heltal"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode
msgid "Method used to convert the float to an integer"
msgstr "Metod som används för att konvertera flyttalet till ett heltal"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'ROUND'
msgid "Round the float up or down to the nearest integer"
msgstr "Avrunda flyttalet uppåt eller nedåt till närmaste heltal"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'FLOOR'
msgid "Round the float down to the next smallest integer"
msgstr "Avrunda flyttalet nedåt till nästa minsta heltal"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'CEILING'
msgctxt "NodeTree"
msgid "Ceiling"
msgstr "Avrunda uppåt"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'CEILING'
msgid "Round the float up to the next largest integer"
msgstr "Avrunda flyttalet uppåt till nästa största heltal"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'TRUNCATE'
msgid ""
"Round the float to the closest integer in the direction of zero (floor if "
"positive; ceiling if negative)"
msgstr ""
"Avrunda flyttalet till närmaste heltal i riktning mot noll (nedåt om "
"positivt, uppåt om negativt)"

#. :src: bpy.types.FunctionNodeHashValue
msgid "Hash Value"
msgstr "Hashvärde"

