#. :src: bpy.types.MovieTrackingSettings.clean_frames
#. :src: bpy.types.CLIP_OT_clean_tracks.frames
msgid "Tracked Frames"
msgstr "Spårade bildrutor"

#. :src: bpy.types.MovieTrackingSettings.default_frames_limit
#. :src: bpy.types.MovieTrackingTrack.frames_limit
msgid "Frames Limit"
msgstr "Bildrutegräns"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'Affine'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'Affine'
msgid ""
"Search for markers that are affine-deformed (t, r, k, and skew) between "
"frames"
msgstr ""
"Sök efter markörer som är affint deformerade (t, r, k och skevning) mellan "
"bildrutorna"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'LocRotScale'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'LocRotScale'
msgid ""
"Search for markers that are translated, rotated, and scaled between frames"
msgstr ""
"Sök efter markörer som förflyttas, roteras och skalas mellan bildrutorna"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'LocScale'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'LocScale'
msgid "Search for markers that are translated and scaled between frames"
msgstr "Sök efter markörer som förflyttas och skalas mellan bildrutorna"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'LocRot'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'LocRot'
msgid "Search for markers that are translated and rotated between frames"
msgstr "Sök efter markörer som förflyttas och roteras mellan bildrutorna"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'Loc'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'Loc'
msgid "Search for markers that are translated between frames"
msgstr "Sök efter markörer som förflyttas mellan bildrutorna"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_match:'KEYFRAME'
#. :src: bpy.types.MovieTrackingTrack.pattern_match:'KEYFRAME'
msgid "Track pattern from keyframe to next frame"
msgstr "Spåra mönster från nyckelbildrutan till nästa bildruta"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_match:'PREV_FRAME'
#. :src: bpy.types.MovieTrackingTrack.pattern_match:'PREV_FRAME'
msgid "Previous frame"
msgstr "Föregående bildruta"

#. :src: bpy.types.MovieTrackingSettings.default_search_size
msgid "Search Size"
msgstr "Sökområdesstorlek"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_principal_point
msgid "Refine Principal Point"
msgstr "Finjustera huvudpunkten"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_principal_point
msgid "Refine principal point during camera solving"
msgstr "Finjustera huvudpunkten under kameralösningen"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_radial_distortion
msgid "Refine Radial"
msgstr "Finjustera radiellt"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_tangential_distortion
msgid "Refine Tangential"
msgstr "Finjustera tangentiellt"

#. :src: bpy.types.MovieTrackingSettings.speed:'REALTIME'
msgid "Track with realtime speed"
msgstr "Spåra med realtidshastighet"

#. :src: bpy.types.MovieTrackingSettings.speed:'HALF'
msgid "Track with half of realtime speed"
msgstr "Spåra med halv realtidshastighet"

#. :src: bpy.types.MovieTrackingSettings.speed:'QUARTER'
msgid "Quarter"
msgstr "Kvart"

#. :src: bpy.types.MovieTrackingSettings.speed:'QUARTER'
msgid "Track with quarter of realtime speed"
msgstr "Spåra med en fjärdedels realtidshastighet"

#. :src: bpy.types.MovieTrackingSettings.use_keyframe_selection
msgid "Keyframe Selection"
msgstr "Val av nyckelbildruta"

#. :src: bpy.types.MovieTrackingSettings.use_keyframe_selection
msgid "Automatically select keyframes when solving camera/object motion"
msgstr "Välj automatiskt nyckelbildrutor när du löser kamera-/objektrörelsen"

#. :src: bpy.types.MovieTrackingSettings.use_tripod_solver
msgid "Tripod Motion"
msgstr "Stativrörelse"

#. :src: bpy.types.MovieTrackingSettings.use_tripod_solver
msgid "Use special solver to track a stable camera position, such as a tripod"
msgstr ""
"Använd en särskild lösare för att spåra en stabil kameraposition, till "
"exempel ett stativ"

#. :src: bpy.types.MovieTrackingStabilization.active_rotation_track_index
msgid "Active Rotation Track Index"
msgstr "Index för aktivt rotationsspår"

#. :src: bpy.types.MovieTrackingStabilization.active_track_index
msgid "Active Track Index"
msgstr "Index för aktivt spår"

#. :src: bpy.types.MovieTrackingStabilization.active_track_index
msgid "Index of active track in translation stabilization tracks list"
msgstr ""
"Index för aktivt spår i listan över förflyttningsspår för stabilisering"

#. :src: bpy.types.MovieTrackingStabilization.anchor_frame
msgid "Anchor Frame"
msgstr "Ankarbildruta"

#. :src: bpy.types.MovieTrackingStabilization.anchor_frame
msgid ""
"Reference point to anchor stabilization (other frames will be adjusted "
"relative to this frame's position)"
msgstr ""
"Referenspunkt för att förankra stabiliseringen (andra bildrutor justeras i "
"förhållande till den här bildrutans position)"

#. :src: bpy.types.MovieTrackingStabilization.influence_location
msgid "Location Influence"
msgstr "Positionspåverkan"

#. :src: bpy.types.MovieTrackingStabilization.influence_location
msgid "Influence of stabilization algorithm on footage location"
msgstr "Stabiliseringsalgoritmens påverkan på filmmaterialets position"

#. :src: bpy.types.MovieTrackingStabilization.influence_rotation
msgid "Rotation Influence"
msgstr "Rotationspåverkan"

#. :src: bpy.types.MovieTrackingStabilization.influence_scale
msgid "Scale Influence"
msgstr "Skalpåverkan"

#. :src: bpy.types.MovieTrackingStabilization.rotation_tracks
#. :src: bpy.types.MovieTrackingStabilization.tracks
msgid "Collection of tracks used for 2D stabilization (translation)"
msgstr "Samling av spår som används för 2D-stabilisering (förflyttning)"

#. :src: bpy.types.MovieTrackingStabilization.target_scale
msgid "Explicitly scale resulting frame to compensate zoom of original shot"
msgstr ""
"Skala uttryckligen den resulterande bildrutan för att kompensera för "
"zoomningen i originalbilden"

#. :src: bpy.types.MovieTrackingStabilization.tracks
msgid "Translation Tracks"
msgstr "Förflyttningsspår"

#. :src: bpy.types.MovieTrackingStabilization.use_autoscale
msgid "Autoscale"
msgstr "Automatisk skalning"

#. :src: bpy.types.MovieTrackingStabilization.use_autoscale
msgid "Automatically scale footage to cover unfilled areas when stabilizing"
msgstr ""
"Skala automatiskt filmmaterialet för att täcka ofyllda områden vid "
"stabilisering"

#. :src: bpy.types.MovieTrackingStabilization.use_stabilize_rotation
msgid "Stabilize detected rotation around center of frame"
msgstr "Stabilisera den upptäckta rotationen runt bildrutans mitt"

#. :src: bpy.types.MovieTrackingTrack
msgid "Movie tracking track data"
msgstr "Spårdata för filmspårning"

#. :src: bpy.types.MovieTrackingTrack
msgid "Match-moving track data for tracking"
msgstr "Spårdata för matchning av rörelser"

#. :src: bpy.types.MovieTrackingTrack.grease_pencil
msgid "Grease Pencil data for this track"
msgstr "Grease Pencil-data för detta spår"

#. :src: bpy.types.MovieTrackingTrack.has_bundle
msgid "True if track has a valid bundle"
msgstr "Sant om spåret har en giltig rekonstruerad punkt"

#. :src: bpy.types.MovieTrackingTrack.select_anchor
msgid "Track's anchor point is selected"
msgstr "Spårets ankarpunkt är vald"

#. :src: bpy.types.MovieTrackingTrack.use_custom_color
msgid "Use custom color instead of theme-defined"
msgstr "Använd anpassad färg i stället för temadefinierad färg"

#. :src: bpy.types.MovieTrackingTrack.weight_stab
msgid "Stab Weight"
msgstr "Stabiliseringsvikt"

#. :src: bpy.types.NlaStrip
#: source/blender/blenkernel/intern/nla.cc:1919
msgid "NLA Strip"
msgstr "NLA-remsa"

#. :src: bpy.types.NlaStrip
msgid "A container referencing an existing Action"
msgstr "En behållare som refererar till en befintlig åtgärd"

#. :src: bpy.types.NlaStrip.action
msgid "Action referenced by this strip"
msgstr "Åtgärd som den här remsan refererar till"

#. :src: bpy.types.NlaStrip.action_frame_end
msgid "Action End Frame"
msgstr "Åtgärdens slutbildruta"

#. :src: bpy.types.NlaStrip.action_frame_end
msgid "Last frame from action to use"
msgstr "Sista bildrutan från åtgärden som ska användas"

#. :src: bpy.types.NlaStrip.action_frame_start
msgid "Action Start Frame"
msgstr "Åtgärdens startbildruta"

#. :src: bpy.types.NlaStrip.action_frame_start
msgid "First frame from action to use"
msgstr "Första bildrutan från åtgärden som ska användas"

#. :src: bpy.types.NlaStrip.active
msgid "NLA Strip is active"
msgstr "NLA-remsan är aktiv"

#. :src: bpy.types.NlaStrip.fcurves
msgid "F-Curves for controlling the strip's influence and timing"
msgstr "F-kurvor för styrning av remsans påverkan och tidsinställning"

#. :src: bpy.types.NlaStrip.frame_end_raw
msgid "End Frame (raw value)"
msgstr "Slutbildruta (råvärde)"

#. :src: bpy.types.NlaStrip.frame_start_raw
msgid "Start Frame (raw value)"
msgstr "Startbildruta (råvärde)"

#. :src: bpy.types.NlaStrip.frame_start_ui
msgid "Start Frame (manipulated from UI)"
msgstr "Startbildruta (manipuleras i gränssnittet)"

#. :src: bpy.types.NlaStrip.influence
msgid "Amount the strip contributes to the current result"
msgstr "Mängd som remsan bidrar med till det aktuella resultatet"

#. :src: bpy.types.NlaStrip.mute
msgid "Disable NLA Strip evaluation"
msgstr "Inaktivera utvärdering av NLA-remsa"

#. :src: bpy.types.NlaStrip.select
msgid "NLA Strip is selected"
msgstr "NLA-remsan är vald"

#. :src: bpy.types.NlaStrip.strip_time
msgid "Strip Time"
msgstr "Remstid"

#. :src: bpy.types.NlaStrip.strip_time
msgid "Frame of referenced Action to evaluate"
msgstr "Bildruta i den refererade åtgärden som ska utvärderas"

#. :src: bpy.types.NlaStrip.type:'CLIP'
msgid "NLA Strip references some Action"
msgstr "NLA-remsan refererar till en åtgärd"

#. :src: bpy.types.NlaStrip.type:'TRANSITION'
msgid "NLA Strip 'transitions' between adjacent strips"
msgstr "NLA-remsan övergår mellan intilliggande remsor"

#. :src: bpy.types.NlaStrip.type:'SOUND'
msgid "NLA Strip representing a sound event for speakers"
msgstr "NLA-remsa som representerar en ljudhändelse för högtalare"

#. :src: bpy.types.NlaStrip.use_animated_influence
#: source/blender/editors/space_nla/nla_buttons.cc:703
msgid "Animated Influence"
msgstr "Animerad påverkan"

#. :src: bpy.types.NlaStrip.use_animated_time
#: source/blender/editors/space_nla/nla_buttons.cc:717
msgid "Animated Strip Time"
msgstr "Animerad remstid"

#. :src: bpy.types.NlaStrip.use_animated_time_cyclic
msgid "Cyclic Strip Time"
msgstr "Cyklisk remstid"
