msgid "Distance from Camera"
msgstr "Avstånd från kameran"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'DISTANCE_FROM_CAMERA'
msgid "Sort by distance from camera (closer lines lie on top of further lines)"
msgstr ""
"Sortera efter avstånd från kameran (närmare linjer hamnar ovanpå mer "
"avlägsna linjer)"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'2D_LENGTH'
#: scripts/startup/bl_ui/properties_freestyle.py:616
msgid "2D Length"
msgstr "2D-längd"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'2D_LENGTH'
msgid ""
"Sort by curvilinear 2D length (longer lines lie on top of shorter lines)"
msgstr ""
"Sortera efter kurvlinjär 2D-längd (längre linjer ligger ovanpå kortare "
"linjer)"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_X'
msgid "Projected X"
msgstr "Projicerad X"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_X'
msgid "Sort by the projected X value in the image coordinate system"
msgstr "Sortera efter det projicerade X-värdet i bildkoordinatsystemet"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_Y'
msgid "Projected Y"
msgstr "Projicerad Y"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_Y'
msgid "Sort by the projected Y value in the image coordinate system"
msgstr "Sortera efter det projicerade Y-värdet i bildkoordinatsystemet"

#. :src: bpy.types.FreestyleLineStyle.sort_order
#: scripts/startup/bl_ui/properties_freestyle.py:697
msgid "Sort Order"
msgstr "Sorteringsordning"

#. :src: bpy.types.FreestyleLineStyle.sort_order
msgid "Select the sort order"
msgstr "Välj sorteringsordning"

#. :src: bpy.types.FreestyleLineStyle.sort_order:'DEFAULT'
msgid "Default order of the sort key"
msgstr "Standardordning för sorteringsnyckeln"

#. :src: bpy.types.FreestyleLineStyle.sort_order:'REVERSE'
msgid "Reverse order"
msgstr "Omvänd ordning"

