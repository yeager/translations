#. :src: bpy.types.GreasePencilLayerMask
msgid "List of Mask Layers"
msgstr "Lista över maskeringslager"

#. :src: bpy.types.GreasePencilLayerMask.name
msgid "Mask layer name"
msgstr "Maskeringslagernamn"

#. :src: bpy.types.GreasePencilLayerMasks.active_mask_index
msgid "Active Layer Mask Index"
msgstr "Index för aktivt lagers mask"

#. :src: bpy.types.GreasePencilLayers
msgid "Annotation Layers"
msgstr "Anteckningslager"

#. :src: bpy.types.GreasePencilLayers
msgid "Collection of annotation layers"
msgstr "Samling av anteckningslager"

#. :src: bpy.types.GreasePencilLayers.active_index
msgid "Active Layer Index"
msgstr "Index för aktivt lager"

#. :src: bpy.types.GreasePencilLayers.active_index
msgid "Index of active annotation layer"
msgstr "Index för aktivt anteckningslager"

#. :src: bpy.types.GreasePencilLayers.active_note
msgid "Note/Layer to add annotation strokes to"
msgstr "Anteckning/lager som anteckningsstreck ska läggas till i"

#. :src: bpy.types.GreasePencilTimeModifierSegment
msgid "Time Modifier Segment"
msgstr "Tidsmodifierarsegment"

#. :src: bpy.types.GreasePencilTimeModifierSegment.segment_mode:'NORMAL'
#. :src: bpy.types.GreasePencilTimeModifier.mode:'NORMAL'
msgid "Apply offset in usual animation direction"
msgstr "Tillämpa förskjutning i den vanliga animationsriktningen"

#. :src: bpy.types.GreasePencilTimeModifierSegment.segment_mode:'REVERSE'
#. :src: bpy.types.GreasePencilTimeModifier.mode:'REVERSE'
msgid "Apply offset in reverse animation direction"
msgstr "Tillämpa förskjutning i omvänd animationsriktning"

#. :src: bpy.types.GreasePencilTimeModifierSegment.segment_mode:'PINGPONG'
msgid "Loop back and forth"
msgstr "Upprepa fram och tillbaka"

#. :src: bpy.types.GreasePencilTreeNode.parent_group
msgid "Parent Layer Group"
msgstr "Överordnad lagergrupp"

#. :src: bpy.types.GreasePencilTreeNode.use_onion_skinning
msgid "Display onion skins before and after the current frame"
msgstr "Visa lökskal före och efter den aktuella bildrutan"

#. :src: bpy.types.GreasePencilLayer.mask_layers
msgid "List of Masking Layers"
msgstr "Lista över maskeringslager"

#. :src: bpy.types.GreasePencilLayer.matrix_local
msgid "Local transformation matrix of the layer"
msgstr "Lokal transformationsmatris för lagret"

#. :src: bpy.types.GreasePencilLayer.matrix_parent_inverse
msgid "Inverse of layer's parent transformation matrix"
msgstr "Invers av lagrets överordnade transformationsmatris"

#. :src: bpy.types.GreasePencilLayer.radius_offset
msgid "Radius change to apply to current strokes"
msgstr "Radieändring som ska tillämpas på aktuella streck"

#. :src: bpy.types.GreasePencilLayer.rotation
msgid "Euler rotation of the layer"
msgstr "Euler-rotation av lagret"
