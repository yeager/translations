#. :src: bpy.types.ACTION_OT_extrapolation_type.type:'MAKE_CYCLIC'
#. :src: bpy.types.GRAPH_OT_extrapolation_type.type:'MAKE_CYCLIC'
msgid "Make Cyclic (F-Modifier)"
msgstr "Gör cyklisk (F-kurvmodifierare)"

#. :src: bpy.types.ACTION_OT_extrapolation_type.type:'MAKE_CYCLIC'
#. :src: bpy.types.GRAPH_OT_extrapolation_type.type:'MAKE_CYCLIC'
msgid "Add Cycles F-Modifier if one does not exist already"
msgstr "Lägg till en Cykel-F-kurvmodifierare om en sådan inte redan finns"

#. :src: bpy.types.ACTION_OT_extrapolation_type.type:'CLEAR_CYCLIC'
#. :src: bpy.types.GRAPH_OT_extrapolation_type.type:'CLEAR_CYCLIC'
msgid "Clear Cyclic (F-Modifier)"
msgstr "Rensa cyklisk (F-kurvmodifierare)"

#. :src: bpy.types.ACTION_OT_extrapolation_type.type:'CLEAR_CYCLIC'
#. :src: bpy.types.GRAPH_OT_extrapolation_type.type:'CLEAR_CYCLIC'
msgid "Remove Cycles F-Modifier if not needed anymore"
msgstr "Ta bort Cykel-F-kurvmodifieraren om den inte längre behövs"

#. :src: bpy.types.GRAPH_OT_fmodifier_add
msgid "Add F-Modifier to the active/selected F-Curves"
msgstr "Lägg till en F-kurvmodifierare på de aktiva/markerade F-kurvorna"

#. :src: bpy.types.GRAPH_OT_fmodifier_add.only_active
msgid "Only add F-Modifier to active F-Curve"
msgstr "Lägg endast till en F-kurvmodifierare på den aktiva F-kurvan"

#. :src: bpy.types.GRAPH_OT_fmodifier_copy
#. :src: bpy.types.NLA_OT_fmodifier_copy
msgctxt "Operator"
msgid "Copy F-Modifiers"
msgstr "Kopiera F-kurvmodifierare"

#. :src: bpy.types.GRAPH_OT_fmodifier_copy
msgid "Copy the F-Modifier(s) of the active F-Curve"
msgstr "Kopiera F-kurvmodifierare från den aktiva F-kurvan"

#. :src: bpy.types.GRAPH_OT_fmodifier_paste
#. :src: bpy.types.NLA_OT_fmodifier_paste
msgctxt "Operator"
msgid "Paste F-Modifiers"
msgstr "Klistra in F-kurvmodifierare"

#. :src: bpy.types.GRAPH_OT_fmodifier_paste
msgid "Add copied F-Modifiers to the selected F-Curves"
msgstr "Lägg till de kopierade F-kurvmodifierarna på de valda F-kurvorna"

#. :src: bpy.types.GRAPH_OT_fmodifier_paste.only_active
msgid "Only paste F-Modifiers on active F-Curve"
msgstr "Klistra endast in F-kurvmodifierare på den aktiva F-kurvan"

#. :src: bpy.types.GRAPH_OT_fmodifier_paste.replace
#. :src: bpy.types.NLA_OT_fmodifier_paste.replace
msgid "Replace existing F-Modifiers, instead of just appending to the end of the existing list"
msgstr "Ersätt befintliga F-kurvmodifierare i stället för att bara lägga till dem sist i den befintliga listan"

#. :src: bpy.types.NLA_OT_fmodifier_add
msgctxt "Operator"
msgid "Add F-Modifier"
msgstr "Lägg till F-kurvmodifierare"

#. :src: bpy.types.NLA_OT_fmodifier_add
msgid "Add F-Modifier to the active/selected NLA-Strips"
msgstr "Lägg till F-kurvmodifierare på aktiva/valda NLA-remsor"

#. :src: bpy.types.NLA_OT_fmodifier_add.only_active
msgid "Only add a F-Modifier of the specified type to the active strip"
msgstr "Lägg endast till en F-kurvmodifierare av den angivna typen på den aktiva remsan"

#. :src: bpy.types.NLA_OT_fmodifier_copy
msgid "Copy the F-Modifier(s) of the active NLA-Strip"
msgstr "Kopiera F-kurvmodifierare från den aktiva NLA-remsan"

#. :src: bpy.types.NLA_OT_fmodifier_paste
msgid "Add copied F-Modifiers to the selected NLA-Strips"
msgstr "Lägg till de kopierade F-kurvmodifierarna på de valda NLA-remsorna"

#. :src: bpy.types.NLA_OT_fmodifier_paste.only_active
msgid "Only paste F-Modifiers on active strip"
msgstr "Klistra endast in F-kurvmodifierare på den aktiva remsan"

msgid "Failed to insert keys on F-Curve with path '%s[%d]', ensure that it is not locked or sampled, and try removing F-Modifiers"
msgstr "Det gick inte att infoga nycklar på F-kurvan med sökvägen '%s[%d]'. Kontrollera att den inte är låst eller samplad och försök ta bort F-kurvmodifierare"

msgid "F-Curve only has F-Modifiers"
msgstr "F-kurvan har endast F-kurvmodifierare"

msgid "F-Modifiers can generate curves for those too"
msgstr "F-kurvmodifierare kan också generera kurvor för dessa"

msgid "Remove F-Modifiers from F-Curve to add keyframes"
msgstr "Ta bort F-kurvmodifierare från F-kurvan för att lägga till nyckelbilder"

msgid "No F-Modifiers found to delete"
msgstr "Inga F-kurvmodifierare att ta bort"

msgid "No F-Modifiers available to be copied"
msgstr "Inga F-kurvmodifierare är tillgängliga för kopiering"

msgid "No F-Modifiers to paste"
msgstr "Inga F-kurvmodifierare att klistra in"

msgid "Removed %d F-Modifier(s) from %d selected F-Curve(s)"
msgstr "Tog bort %d F-kurvmodifierare från %d markerade F-kurvor"

msgid "Control point not in Envelope F-Modifier"
msgstr "Kontrollpunkten finns inte i kuvert-F-kurvmodifieraren"
