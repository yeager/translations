#. :src: bpy.types.PreferencesView.asset_access
msgid "Asset Access"
msgstr "Resursåtkomst"

#. :src: bpy.types.FileAssetSelectParams.asset_access
#. :src: bpy.types.PreferencesView.asset_access
msgid "Choose the visibility of online and offline assets"
msgstr "Välj synlighet för resurser på nätet och lokala resurser"

#. :src: bpy.types.FileAssetSelectParams.asset_access:'ALL'
#. :src: bpy.types.PreferencesView.asset_access:'ALL'
msgid "Show assets that are both hosted online (need downloading) and available on disk already"
msgstr "Visa resurser som både finns på nätet (och behöver hämtas) och redan finns på disken"

#. :src: bpy.types.FileAssetSelectParams.asset_access:'ONLY_ONLINE'
#. :src: bpy.types.PreferencesView.asset_access:'ONLY_ONLINE'
msgid "Show only assets that need downloading (requires internet access)"
msgstr "Visa endast resurser som behöver hämtas (kräver nätåtkomst)"

#. :src: bpy.types.FileAssetSelectParams.asset_access:'ONLY_OFFLINE'
#. :src: bpy.types.PreferencesView.asset_access:'ONLY_OFFLINE'
msgid "Show only assets that are available on disk already (no internet access needed)"
msgstr "Visa endast resurser som redan finns på disken (ingen nätåtkomst behövs)"

#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility
msgid "Which assets to show based on catalog filter"
msgstr "Välj vilka resurser som visas utifrån katalogfiltret"

#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility:'ALL'
msgid "Show assets from all catalogs"
msgstr "Visa resurser från alla kataloger"

#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility:'CATALOG'
msgid "Show assets from the active catalog only"
msgstr "Visa endast resurser från den aktiva katalogen"

#. :src: bpy.types.FileAssetSelectParams.asset_catalog_visibility:'UNASSIGNED'
msgid "Show assets not assigned to any catalog"
msgstr "Visa resurser som inte är tilldelade någon katalog"

#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND_REUSE'
msgid "Import the asset as copied data-block while avoiding multiple copies of nested, typically heavy data. For example the textures of a material asset, or the mesh of an object asset, don't have to be copied every time this asset is imported. The instances of the asset share the data instead"
msgstr "Importera resursen som ett kopierat datablock men undvik flera kopior av nästlade, vanligtvis tunga data. Texturer i en materialresurs eller meshen i en objektresurs behöver exempelvis inte kopieras vid varje import. Resursinstanserna delar i stället data"

#. :src: bpy.types.ID.asset_data
msgid "Additional data for an asset data-block"
msgstr "Ytterligare data för ett resursdatablock"

#. :src: bpy.types.ID.is_editable
msgid "This data-block is editable in the user interface. Linked data-blocks are not editable, except if they were loaded as editable assets."
msgstr "Datablocket kan redigeras i användargränssnittet. Länkade datablock kan inte redigeras, utom om de har lästs in som redigerbara resurser."

#. :src: bpy.types.ASSET_OT_external_asset_rename
msgid "Change the name of this asset. Note that this cannot be un-done via the undo system"
msgstr "Byt namn på denna resurs. Observera att åtgärden inte kan ångras via ångringssystemet"

#. :src: bpy.types.POSELIB_OT_create_pose_asset
msgid "Create a new asset from the selected bones in the scene"
msgstr "Skapa en ny resurs från de valda benen i scenen"
