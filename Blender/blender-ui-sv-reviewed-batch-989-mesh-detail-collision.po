#. :src: bpy.types.Paint.use_cavity
msgid "Mask painting according to mesh geometry cavity"
msgstr "Maskmålning utifrån håligheter i meshgeometrin"

#. :src: bpy.types.ImagePaint.missing_uvs
msgid "A UV layer is missing on the mesh"
msgstr "Ett UV-lager saknas i meshen"

#. :src: bpy.types.Sculpt.detail_refine_method
msgid "In dynamic-topology mode, how to add or remove mesh detail"
msgstr "Hur meshdetalj ska läggas till eller tas bort i läget för dynamisk topologi"

#. :src: bpy.types.Sculpt.detail_refine_method:'SUBDIVIDE'
msgid "Subdivide long edges to add mesh detail where needed"
msgstr "Dela upp långa kanter för att lägga till meshdetalj där det behövs"

#. :src: bpy.types.Sculpt.detail_refine_method:'COLLAPSE'
msgid "Collapse short edges to remove mesh detail where possible"
msgstr "Fäll ihop korta kanter för att ta bort meshdetalj där det är möjligt"

#. :src: bpy.types.Sculpt.detail_refine_method:'SUBDIVIDE_COLLAPSE'
msgid "Both subdivide long edges and collapse short edges to refine mesh detail"
msgstr "Dela både upp långa kanter och fäll ihop korta kanter för att förfina meshdetaljen"

#. :src: bpy.types.Sculpt.detail_type_method
msgid "In dynamic-topology mode, how mesh detail size is calculated"
msgstr "Hur storleken på meshdetaljen beräknas i läget för dynamisk topologi"

#. :src: bpy.types.Sculpt.transform_mode:'ALL_VERTICES'
msgid "Applies the transformation to all vertices in the mesh"
msgstr "Tillämpa transformeringen på alla hörnpunkter i meshen"

#. :src: bpy.types.RigidBodyObject.mesh_source
msgid "Source of the mesh used to create collision shape"
msgstr "Källa till meshen som används för att skapa kollisionsformen"

#. :src: bpy.types.SpaceView3D.show_object_viewport_mesh
#. :src: bpy.types.XrSessionSettings.show_object_viewport_mesh
msgid "Show mesh objects"
msgstr "Visa meshobjekt"
