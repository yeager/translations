msgstr "Registrering av resurshylleklass: ”%s” är för lång, maximal längd är %d"

#: source/blender/makesrna/intern/rna_ui.cc:1275
msgid "Registering asset shelf class: '%s' has been registered before, unregistering previous"
msgstr "Registrering av resurshylleklass: ”%s” har redan registrerats, avregistrerar den tidigare"
