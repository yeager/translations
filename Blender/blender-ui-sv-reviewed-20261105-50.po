#. :src: bpy.types.CameraBackgroundImage.show_on_foreground
msgid "Show On Foreground"
msgstr "Visa i förgrunden"

#. :src: bpy.types.CameraBackgroundImage.show_on_foreground
msgid "Show this image in front of objects in viewport"
msgstr "Visa den här bilden framför objekt i vyn"

#. :src: bpy.types.CameraBackgroundImage.source
msgid "Background Source"
msgstr "Bakgrundskälla"

#. :src: bpy.types.CameraBackgroundImage.use_camera_clip
msgid "Camera Clip"
msgstr "Kameraklipp"

#. :src: bpy.types.CameraBackgroundImage.use_camera_clip
msgid "Use movie clip from active scene camera"
msgstr "Använd filmklippet från den aktiva scenens kamera"

#. :src: bpy.types.CameraDOFSettings.aperture_fstop
#. :src: bpy.types.CompositorNodeDefocus.f_stop
msgid "F-Stop"
msgstr "Bländartal"

#. :src: bpy.types.CameraDOFSettings.aperture_fstop
msgid "F-Stop ratio (lower numbers give more defocus, higher numbers give a sharper image)"
msgstr "Bländartal (lägre värden ger större oskärpa, högre värden ger en skarpare bild)"

#. :src: bpy.types.CameraDOFSettings.focus_object
msgid "Focus Object"
msgstr "Fokusobjekt"

#. :src: bpy.types.CameraDOFSettings.focus_subtarget
msgid "Focus Bone"
msgstr "Fokusben"

#. :src: bpy.types.CameraStereoData.convergence_distance
msgid "Convergence Plane Distance"
msgstr "Avstånd till konvergensplanet"

#. :src: bpy.types.CameraStereoData.pole_merge_angle_from
msgid "Pole Merge Start Angle"
msgstr "Startvinkel för polsammanfogning"

#. :src: bpy.types.CameraStereoData.pole_merge_angle_to
msgid "Pole Merge End Angle"
msgstr "Slutvinkel för polsammanfogning"

#. :src: bpy.types.CameraStereoData.use_pole_merge
msgid "Use Pole Merge"
msgstr "Använd polsammanfogning"

#. :src: bpy.types.CameraStereoData.use_pole_merge
msgid "Fade interocular distance to 0 after the given cutoff angle"
msgstr "Tona ned det interokulära avståndet till 0 efter den angivna gränsvinkeln"

#. :src: bpy.types.ClothCollisionSettings
#. :src: bpy.types.ClothModifier.collision_settings
msgid "Cloth Collision Settings"
msgstr "Kollisionsinställningar för tyg"

#. :src: bpy.types.ClothCollisionSettings.collection
#. :src: bpy.types.ParticleSettings.collision_collection
#. :src: bpy.types.SoftBodySettings.collision_collection
msgid "Collision Collection"
msgstr "Kollisionssamling"

#. :src: bpy.types.ClothCollisionSettings.collection
msgid "Limit colliders to this Collection"
msgstr "Begränsa kolliderande objekt till den här samlingen"

#. :src: bpy.types.ClothCollisionSettings.collision_quality
msgid "Collision Quality"
msgstr "Kollisionskvalitet"

#. :src: bpy.types.ClothCollisionSettings.damping
msgid "Restitution"
msgstr "Restitutionskoefficient"

#. :src: bpy.types.ClothCollisionSettings.impulse_clamp
#. :src: bpy.types.ClothCollisionSettings.self_impulse_clamp
msgid "Impulse Clamping"
msgstr "Impulsbegränsning"

#. :src: bpy.types.ClothCollisionSettings.impulse_clamp
#. :src: bpy.types.ClothCollisionSettings.self_impulse_clamp
msgid "Clamp collision impulses to avoid instability (0.0 to disable clamping)"
msgstr "Begränsa kollisionsimpulser för att undvika instabilitet (0,0 för att inaktivera begränsning)"

#. :src: bpy.types.ClothCollisionSettings.self_distance_min
msgid "Self Minimum Distance"
msgstr "Minsta avstånd vid självkollision"

#. :src: bpy.types.ClothCollisionSettings.vertex_group_object_collisions
msgid "Collision Vertex Group"
msgstr "Hörnpunktsgrupp för kollision"

#. :src: bpy.types.ClothCollisionSettings.vertex_group_object_collisions
msgid "Triangles with all vertices in this group are not used during object collisions"
msgstr "Trianglar där alla hörnpunkter ingår i denna grupp används inte vid objektkollisioner"
