#. :src: bpy.types.Mesh.use_mirror_vertex_groups
#. :src: bpy.types.MirrorModifier.use_mirror_vertex_groups
msgid "Mirror Vertex Groups"
msgstr "Spegla hörnpunktsgrupper"

#. :src: bpy.types.Mesh.use_mirror_vertex_groups
msgid ""
"Mirror the left/right vertex groups when painting. The symmetry axis is "
"determined by the symmetry settings."
msgstr ""
"Spegla vänster/höger-hörnpunktsgrupperna vid målning. Symmetriaxeln bestäms "
"av symmetriinställningarna."

#. :src: bpy.types.Mesh.use_paint_bone_selection
msgid "Bone Selection"
msgstr "Benmarkering"

#. :src: bpy.types.Mesh.use_paint_bone_selection
msgid "Bone selection during painting"
msgstr "Val av ben under målning"

#. :src: bpy.types.Mesh.use_paint_mask
msgid "Paint Mask"
msgstr "Målningsmask"

#. :src: bpy.types.Mesh.use_paint_mask
msgid "Face selection masking for painting"
msgstr "Maskering med ytmarkering för målning"

#. :src: bpy.types.Mesh.use_paint_mask_vertex
msgid "Vertex Selection"
msgstr "Hörnpunktsmarkering"

#. :src: bpy.types.Mesh.use_paint_mask_vertex
msgid "Vertex selection masking for painting"
msgstr "Maskering med hörnpunktsmarkering för målning"

#. :src: bpy.types.Mesh.use_remesh_fix_poles
msgid "Fix Poles"
msgstr "Korrigera poler"

#. :src: bpy.types.Mesh.use_remesh_fix_poles
msgid "Produces fewer poles and a better topology flow"
msgstr "Ger färre poler och ett bättre topologiskt flöde"

#. :src: bpy.types.Mesh.use_remesh_preserve_attributes
msgid "Transfer all attributes to the new mesh"
msgstr "Överför alla attribut till den nya meshen"

#. :src: bpy.types.Mesh.use_remesh_preserve_volume
msgid ""
"Projects the mesh to preserve the volume and details of the original mesh"
msgstr ""
"Projicerar meshen för att bevara volymen och detaljerna i den ursprungliga "
"meshen"

#. :src: bpy.types.Mesh.uv_layer_clone
msgid "Clone UV Loop Layer"
msgstr "UV-looplager för kloning"

#. :src: bpy.types.Mesh.uv_layer_clone
msgid "UV loop layer to be used as cloning source"
msgstr "UV-looplager som ska användas som kloningskälla"

#. :src: bpy.types.Mesh.uv_layer_clone_index
msgid "Clone UV Loop Layer Index"
msgstr "Index för UV-looplager för kloning"

#. :src: bpy.types.Mesh.uv_layer_clone_index
msgid "Clone UV loop layer index"
msgstr "Index för UV-looplager för kloning"

#. :src: bpy.types.Mesh.uv_layer_stencil
msgid "Mask UV Loop Layer"
msgstr "UV-looplager för maskning"

#. :src: bpy.types.Mesh.uv_layer_stencil
msgid "UV loop layer to mask the painted area"
msgstr "UV-looplager för att maskera det målade området"

#. :src: bpy.types.Mesh.uv_layer_stencil_index
msgid "Mask UV Loop Layer Index"
msgstr "Index för maskens UV-looplager"

#. :src: bpy.types.Mesh.uv_layer_stencil_index
msgid "Mask UV loop layer index"
msgstr "Index för maskens UV-looplager"

#. :src: bpy.types.Mesh.uv_layers
msgid "UV Loop Layers"
msgstr "UV-looplager"

#. :src: bpy.types.Mesh.uv_layers
msgid "All UV loop layers"
msgstr "Alla UV-looplager"

#. :src: bpy.types.Mesh.vertex_colors
msgid "Legacy vertex color layers. Deprecated, use color attributes instead."
msgstr ""
"Äldre lager med hörnpunktsfärger. Föråldrade; använd färgattribut i stället."

#. :src: bpy.types.Mesh.vertex_normals
#: source/blender/editors/io/io_ply_ops.cc:132
msgid "Vertex Normals"
msgstr "Hörnpunktsnormaler"

#. :src: bpy.types.Mesh.vertex_normals
msgid ""
"The normal direction of each vertex, defined as the average of the "
"surrounding face normals"
msgstr ""
"Normalriktningen för varje hörnpunkt, definierad som medelvärdet av de "
"omgivande ytnormalerna"

