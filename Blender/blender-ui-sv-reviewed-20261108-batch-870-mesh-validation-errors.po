#: source/blender/editors/mesh/mesh_join.cc:597
msgid "No mesh data to join"
msgstr "Inga meshdata att sammanfoga"

#: source/blender/editors/mesh/meshtools.cc:134
msgid "No source mesh objects selected"
msgstr "Inga källmeshobjekt har markerats"

#: source/blender/editors/mesh/meshtools.cc:139
msgid "Selected meshes must have equal numbers of vertices"
msgstr "Markerade mesh måste ha samma antal hörnpunkter"

#: source/blender/editors/object/object_add.cc:2466
#: source/blender/editors/sculpt_paint/mesh/paint_image_proj.cc:6434
msgid "No active mesh object"
msgstr "Inget aktivt meshobjekt"

#: source/blender/editors/object/object_bake.cc:115
msgid "Baking of multires data only works with an active mesh object"
msgstr ""
"Bakning av flerupplösningsdata fungerar endast med ett aktivt meshobjekt"

#: source/blender/editors/object/object_data_transfer.cc:537
msgid "Failed to transfer mesh data to %d objects"
msgstr "Det gick inte att överföra meshdata till %d objekt"

#: source/blender/editors/object/object_multires_modifier.cc:212
msgid "Second selected mesh object required to copy shape from"
msgstr "Ett andra markerat meshobjekt krävs för att kopiera formen"

#: source/blender/editors/object/object_remesh.cc:117
msgid "Voxel remesher cannot run with a voxel size of 0.0"
msgstr "Voxelommesharen kan inte köras med voxelstorleken 0,0"

#: source/blender/editors/object/object_remesh.cc:91
msgid "The remesher cannot run from edit mode"
msgstr "Ommeshningsverktyget kan inte köras från redigeringsläget"

#: source/blender/editors/object/object_remesh.cc:96
msgid "The remesher cannot run with dyntopo activated"
msgstr "Ommeshningsverktyget kan inte köras när dyntopo är aktiverat"

#: source/blender/editors/object/object_remesh.cc:101
msgid "The remesher cannot run with a Multires modifier in the modifier stack"
msgstr ""
"Ommeshningsverktyget kan inte köras med en flerupplösningsmodifierare i "
"modifierarstapeln"

#: source/blender/editors/screen/screen_ops.cc:686
msgid "Expected a view3d region & editmesh"
msgstr "Förväntade en 3D-vyregion och en redigeringsmesh"

#: source/blender/editors/sculpt_paint/curves/sculpt_brush.cc:410
msgid "Evaluated surface mesh is empty"
msgstr "Den utvärderade ytmeshen är tom"

#: source/blender/editors/sculpt_paint/curves/sculpt_brush.cc:415
msgid "Missing surface mesh"
msgstr "Ytmesh saknas"

#: source/blender/editors/sculpt_paint/curves/sculpt_ops.cc:1062
msgid "Cursor must be over the surface mesh"
msgstr "Markören måste vara över ytmeshen"

#: source/blender/makesrna/intern/rna_object_api.cc:616
msgid "Object '%s' has no evaluated mesh data"
msgstr "Objektet ”%s” saknar utvärderade meshdata"

#: source/blender/modifiers/intern/MOD_boolean.cc:197
msgid "Cannot execute, the selected collection contains non mesh objects"
msgstr ""
"Kan inte utföra åtgärden; den markerade samlingen innehåller objekt som inte "
"är meshobjekt"

#: source/blender/modifiers/intern/MOD_surfacedeform.cc:1447
msgid "No valid target mesh"
msgstr "Ingen giltig målmesh"
