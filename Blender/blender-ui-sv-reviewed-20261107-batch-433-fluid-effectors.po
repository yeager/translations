#. :src: bpy.types.FluidEffectorSettings
#. :src: bpy.types.FluidModifier.effector_settings
msgid "Effector Settings"
msgstr "Inställningar för effektorn"

#. :src: bpy.types.FluidEffectorSettings
msgid "Smoke collision settings"
msgstr "Inställningar för kollision med rök"

#. :src: bpy.types.FluidEffectorSettings.effector_type
msgid "Effector Type"
msgstr "Typ av effektor"

#. :src: bpy.types.FluidEffectorSettings.effector_type
msgid "Change type of effector in the simulation"
msgstr "Ändra typ av effektor i simuleringen"

#. :src: bpy.types.FluidEffectorSettings.effector_type:'COLLISION'
msgid "Create collision object"
msgstr "Skapa kollisionsobjekt"

#. :src: bpy.types.FluidEffectorSettings.effector_type:'GUIDE'
msgid "Create guide object"
msgstr "Skapa styrningsobjekt"

#. :src: bpy.types.FluidEffectorSettings.guide_mode
msgid "Guiding mode"
msgstr "Styrningsläge"

#. :src: bpy.types.FluidEffectorSettings.guide_mode
msgid "How to create guiding velocities"
msgstr "Hur styrhastigheter skapas"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'MAXIMUM'
msgid ""
"Compare velocities from previous frame with new velocities from current "
"frame and keep the maximum"
msgstr ""
"Jämför hastigheterna från föregående bildruta med de nya hastigheterna från "
"aktuell bildruta och behåll den högsta"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'MINIMUM'
msgid ""
"Compare velocities from previous frame with new velocities from current "
"frame and keep the minimum"
msgstr ""
"Jämför hastigheterna från föregående bildruta med de nya hastigheterna från "
"aktuell bildruta och behåll den lägsta"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'OVERRIDE'
msgid ""
"Always write new guide velocities for every frame (each frame only contains "
"current velocities from guiding objects)"
msgstr ""
"Skriv alltid nya styrhastigheter för varje bildruta (varje bildruta "
"innehåller endast aktuella hastigheter från styrningsobjekten)"

#. :src: bpy.types.FluidEffectorSettings.guide_mode:'AVERAGED'
msgid ""
"Take average of velocities from previous frame and new velocities from "
"current frame"
msgstr ""
"Ta medelvärdet av hastigheterna från föregående bildruta och de nya "
"hastigheterna från aktuell bildruta"

#. :src: bpy.types.FluidEffectorSettings.subframes
msgid ""
"Number of additional samples to take between frames to improve quality of "
"fast moving effector objects"
msgstr ""
"Antal extra provtagningar mellan bildrutorna för att förbättra kvaliteten på "
"snabbt rörliga effektorobjekt"

#. :src: bpy.types.FluidEffectorSettings.surface_distance
msgid "Additional distance around mesh surface to consider as effector"
msgstr "Ytterligare avstånd runt meshytan som ska räknas som del av effektorn"

#. :src: bpy.types.FluidEffectorSettings.use_effector
msgid "Control when to apply the effector"
msgstr "Styr när effektorn ska användas"

#. :src: bpy.types.FluidEffectorSettings.use_plane_init
#. :src: bpy.types.FluidFlowSettings.use_plane_init
#: scripts/startup/bl_ui/properties_physics_fluid.py:559
#: scripts/startup/bl_ui/properties_physics_fluid.py:287
msgid "Is Planar"
msgstr "Är plan"

#. :src: bpy.types.FluidEffectorSettings.velocity_factor
msgid "Multiplier of obstacle velocity"
msgstr "Multiplikator för hinderhastighet"
