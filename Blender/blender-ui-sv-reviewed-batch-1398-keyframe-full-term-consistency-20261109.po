msgid "Duplicated Keyframes"
msgstr "Duplicerade nyckelbildrutor"

#. :src: bpy.types.TRANSFORM_OT_resize.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_seq_slide.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_transform.use_duplicated_keyframes
#. :src: bpy.types.TRANSFORM_OT_translate.use_duplicated_keyframes
msgid "Transform duplicated keyframes"
msgstr "Transformera duplicerade nyckelbildrutor"

#. :src: bpy.types.SCENE_PT_keyframing_settings
msgid "Keyframing Settings"
msgstr "Inställningar för nyckelbildsättning"

#. :src: bpy.types.TIME_PT_keyframing
#. :src: bpy.types.TIME_PT_keyframing_settings
#: scripts/startup/bl_ui/space_userpref.py:659
msgid "Keyframing"
msgstr "Nyckelbildsättning"

#. :src: bpy.types.PreferencesEdit.auto_keying_mode
msgid ""
"Mode of automatic keyframe insertion for Objects and Bones (default setting "
"used for new Scenes)"
msgstr ""
"Läge för automatisk infogning av nyckelbildrutor för objekt och ben "
"(standardinställning som används för nya scener)"

#. :src: bpy.types.PreferencesEdit.key_insert_channels
msgid "Default Key Channels"
msgstr "Standardkanaler för nyckelbildrutor"

#. :src: bpy.types.PreferencesEdit.keyframe_new_handle_type
msgid "New Handles Type"
msgstr "Handtagstyp för nya nyckelbildrutor"

#. :src: bpy.types.PreferencesEdit.keyframe_new_handle_type
msgid "Handle type for handles of new keyframes"
msgstr "Typ av handtag för handtagen på nya nyckelbildrutor"

#. :src: bpy.types.PreferencesEdit.keyframe_new_interpolation_type
msgid ""
"Interpolation mode used for first keyframe on newly added F-Curves "
"(subsequent keyframes take interpolation from preceding keyframe)"
msgstr ""
"Interpoleringsläge som används för den första nyckelbilden på nyligen "
"tillagda F-kurvor (efterföljande nyckelbildrutor använder interpoleringen "
"från föregående nyckelbild)"

#. :src: bpy.types.PreferencesEdit.show_only_selected_curve_keyframes
msgid "Only Show Selected F-Curve Keyframes"
msgstr "Visa endast nyckelbildrutor för markerade F-kurvor"

#. :src: bpy.types.PreferencesEdit.use_auto_keyframe_insert_needed
msgid "Auto-Keying will skip inserting keys that don't affect the animation"
msgstr ""
"Automatisk nyckling hoppar över nyckelbildrutor som inte påverkar "
"animeringen"

#. :src: bpy.types.PreferencesEdit.use_auto_keying
msgid ""
"Automatic keyframe insertion for Objects and Bones (default setting used for"
" new Scenes)"
msgstr ""
"Automatisk infogning av nyckelbildrutor för objekt och ben "
"(standardinställning som används för nya scener)"

#. :src: bpy.types.PreferencesEdit.use_keyframe_insert_available
msgid "Auto Keyframe Insert Available"
msgstr "Automatisk infogning av nyckelbildrutor tillgänglig"

#. :src: bpy.types.PreferencesEdit.use_keyframe_insert_needed
msgid ""
"When keying manually, skip inserting keys that don't affect the animation"
msgstr ""
"När nyckelbildrutor infogas manuellt, hoppa över nyckelbildrutor som inte "
"påverkar animeringen"

#. :src: bpy.types.PreferencesView.view_frame_keyframes
msgid "Zoom Keyframes"
msgstr "Zooma in på nyckelbildrutor"

#. :src: bpy.types.PreferencesView.view_frame_keyframes
msgid "Keyframes around cursor that we zoom around"
msgstr "Nyckelbildrutor runt markören som vi zoomar in på"

#. :src: bpy.types.SpaceGraphEditor.mode:'FCURVES'
msgid "Edit animation/keyframes displayed as 2D curves"
msgstr "Redigera animationer och nyckelbildrutor som visas som 2D-kurvor"

#. :src: bpy.types.SpaceGraphEditor.use_only_selected_keyframe_handles
msgid "Only Selected Keyframes Handles"
msgstr "Endast handtag för markerade nyckelbildrutor"

#. :src: bpy.types.ThemeClipEditor.path_keyframe_after
msgid "Color of keyframes on a path after current frame"
msgstr "Färg på nyckelbildrutor på en bana efter aktuell bildruta"

#. :src: bpy.types.ThemeClipEditor.path_keyframe_before
msgid "Color of keyframes on a path before current frame"
msgstr "Färg på nyckelbildrutor på en bana före aktuell bildruta"

#. :src: bpy.types.ThemeDopeSheet.keyframe_scale_factor
msgid "Scale factor for adjusting the height of keyframes"
msgstr "Skalningsfaktor för att justera nyckelbildrutors höjd"

#. :src: bpy.types.ThemeView3D.text_grease_pencil
msgid "Color for indicating Grease Pencil keyframes"
msgstr "Färg som visar nyckelbildrutor för Grease Pencil"

#. :src: bpy.types.ToolSettings.keyframe_type
msgid "Type of keyframes to create when inserting keyframes"
msgstr "Typ av nyckelbildrutor som ska skapas när nyckelbildrutor infogas"

#. :src: bpy.types.ToolSettings.snap_playhead_element:'KEY'
msgctxt "Unit"
msgid "Keyframes"
msgstr "Nyckelbildrutor"

#. :src: bpy.types.ToolSettings.snap_playhead_element:'KEY'
msgid "Snap to keyframes"
msgstr "Fäst vid nyckelbildrutor"

#. :src: bpy.types.ToolSettings.use_keyframe_cycle_aware
msgid ""
"For channels with cyclic extrapolation, keyframe insertion is automatically "
"remapped inside the cycle time range, and keeps ends in sync. Curves newly "
"added to actions with a Manual Frame Range and Cyclic Animation are "
"automatically made cyclic."
msgstr ""
"För kanaler med cyklisk extrapolering ommappas insättning av nyckelbildrutor"
" automatiskt inom cykelns tidsintervall och håller ändarna synkroniserade. "
"Kurvor som läggs till i Actioner med manuellt bildruteintervall och cyklisk "
"animering blir automatiskt cykliska."

#. :src: bpy.types.ToolSettings.use_keyframe_insert_auto
msgid "Automatically insert keyframes on modified properties"
msgstr "Infoga automatiskt nyckelbildrutor för ändrade egenskaper"

#. :src: bpy.types.ToolSettings.use_keyframe_insert_keyingset
msgid "Automatic keyframe insertion using active Keying Set only"
msgstr ""
"Automatisk infogning av nyckelbildrutor enbart med den aktiva "
"nyckeluppsättningen"

#. :src: bpy.types.ToolSettings.use_snap_time_absolute
msgid "Absolute time alignment when transforming keyframes"
msgstr "Absolut tidsjustering vid transformering av nyckelbildrutor"

#. :src: bpy.types.View3DOverlay.use_gpencil_onion_skin
msgid "Show ghosts of the keyframes before and after the current frame"
msgstr ""
"Visa spökbilder av nyckelbildrutorna före och efter den aktuella bildrutan"

