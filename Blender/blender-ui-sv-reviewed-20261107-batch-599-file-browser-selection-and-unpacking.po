#. :src: bpy.types.FILE_OT_select.fill
#. :src: bpy.types.FILE_OT_select_walk.fill
msgid "Select everything beginning with the last selection"
msgstr "Markera allt från den senaste markeringen"

#. :src: bpy.types.FILE_OT_select.only_activate_if_selected
msgid "Only Activate if Selected"
msgstr "Aktivera endast om den är markerad"

#. :src: bpy.types.FILE_OT_select.only_activate_if_selected
msgid ""
"Do not change selection if the item under the cursor is already selected, "
"only activate it"
msgstr ""
"Ändra inte markeringen om objektet under markören redan är markerat, utan "
"aktivera det bara"

#. :src: bpy.types.FILE_OT_select.open
msgid "Open a directory when selecting it"
msgstr "Öppna en katalog när du väljer den"

#. :src: bpy.types.FILE_OT_select.pass_through
msgid "Pass Through"
msgstr "Släpp igenom"

#. :src: bpy.types.FILE_OT_select.pass_through
msgid ""
"Even on successful execution, pass the event on so other operators can "
"execute on it as well"
msgstr ""
"Skicka händelsen vidare även vid lyckad körning så att andra operatorer "
"också kan köra den"

#. :src: bpy.types.FILE_OT_select_all
msgctxt "Operator"
msgid "(De)select All Files"
msgstr "(Av)markera alla filer"

#. :src: bpy.types.FILE_OT_select_all
msgid "Select or deselect all files"
msgstr "Markera eller avmarkera alla filer"

#. :src: bpy.types.FILE_OT_select_bookmark
msgctxt "Operator"
msgid "Select Directory"
msgstr "Välj katalog"

#. :src: bpy.types.FILE_OT_select_bookmark
msgid "Select a bookmarked directory"
msgstr "Välj en bokmärkt katalog"

#. :src: bpy.types.FILE_OT_select_box
msgid "Activate/select the file(s) contained in the border"
msgstr "Aktivera/markera filerna inom området"

#. :src: bpy.types.FILE_OT_smoothscroll
msgctxt "Operator"
msgid "Smooth Scroll"
msgstr "Mjuk rullning"

#. :src: bpy.types.FILE_OT_smoothscroll
msgid "Smooth scroll to make editable file visible"
msgstr "Rulla mjukt så att den redigerbara filen blir synlig"

#. :src: bpy.types.FILE_OT_sort_column_ui_context
msgctxt "Operator"
msgid "Sort from Column"
msgstr "Sortera efter kolumn"

#. :src: bpy.types.FILE_OT_sort_column_ui_context
msgid "Change sorting to use column under cursor"
msgstr "Ändra sortering så att kolumnen under markören används"

#. :src: bpy.types.FILE_OT_unpack_all
msgctxt "Operator"
msgid "Unpack Resources"
msgstr "Packa upp resurser"

#. :src: bpy.types.FILE_OT_unpack_all
msgid "Unpack all files packed into this .blend to external ones"
msgstr ""
"Packa upp alla filer som är packade i den här .blend-filen till externa filer"

#. :src: bpy.types.FILE_OT_unpack_all.method
#. :src: bpy.types.FILE_OT_unpack_item.method
#. :src: bpy.types.IMAGE_OT_unpack.method
#. :src: bpy.types.OBJECT_OT_geometry_node_bake_unpack_single.method
#. :src: bpy.types.SOUND_OT_unpack.method
msgid "How to unpack"
msgstr "Hur man packar upp"

#. :src: bpy.types.FILE_OT_unpack_all.method:'USE_LOCAL'
msgid "Use files in current directory (create when necessary)"
msgstr "Använd filer i aktuell katalog (skapa vid behov)"

#. :src: bpy.types.FILE_OT_unpack_all.method:'WRITE_LOCAL'
msgid "Write files to current directory (overwrite existing files)"
msgstr "Skriv filer till aktuell katalog (skriv över befintliga filer)"

#. :src: bpy.types.FILE_OT_unpack_all.method:'USE_ORIGINAL'
msgid "Use files in original location (create when necessary)"
msgstr "Använd filer på ursprunglig plats (skapa vid behov)"

#. :src: bpy.types.FILE_OT_unpack_all.method:'WRITE_ORIGINAL'
msgid "Write files to original location (overwrite existing files)"
msgstr "Skriv filer till ursprunglig plats (skriv över befintliga filer)"

#. :src: bpy.types.FILE_OT_unpack_all.method:'KEEP'
msgid "Disable auto-pack, keep all packed files"
msgstr "Inaktivera automatisk packning, behåll alla packade filer"

#. :src: bpy.types.FILE_OT_unpack_all.method:'REMOVE'
#. :src: bpy.types.IMAGE_OT_unpack.method:'REMOVE'
#. :src: bpy.types.SOUND_OT_unpack.method:'REMOVE'
#: source/blender/editors/util/ed_util.cc:375
msgid "Remove Pack"
msgstr "Ta bort packning"

#. :src: bpy.types.FILE_OT_unpack_item
msgctxt "Operator"
msgid "Unpack Item"
msgstr "Packa upp objektet"

#. :src: bpy.types.FILE_OT_unpack_item
msgid "Unpack this file to an external file"
msgstr "Packa upp den här filen till en extern fil"

#. :src: bpy.types.FILE_OT_unpack_item.id_name
msgid "Name of ID block to unpack"
msgstr "Namn på ID-block som ska packas upp"

#. :src: bpy.types.FILE_OT_unpack_item.id_type
msgid "Identifier type of ID block"
msgstr "Typ av identifierare för ID-block"

#. :src: bpy.types.FILE_OT_unpack_item.method:'USE_LOCAL'
msgid "Use file from current directory (create when necessary)"
msgstr "Använd fil från aktuell katalog (skapa vid behov)"

#. :src: bpy.types.FILE_OT_unpack_item.method:'WRITE_LOCAL'
msgid "Write file to current directory (overwrite existing file)"
msgstr "Skriv fil till aktuell katalog (skriv över befintlig fil)"

#. :src: bpy.types.FILE_OT_unpack_item.method:'USE_ORIGINAL'
msgid "Use file in original location (create when necessary)"
msgstr "Använd filen på ursprunglig plats (skapa vid behov)"

#. :src: bpy.types.FILE_OT_unpack_item.method:'WRITE_ORIGINAL'
msgid "Write file to original location (overwrite existing file)"
msgstr "Skriv fil till ursprunglig plats (skriv över befintlig fil)"
