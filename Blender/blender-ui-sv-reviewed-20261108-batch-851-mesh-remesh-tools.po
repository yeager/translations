#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'RATIO'
msgid "Specify target number of faces relative to the current mesh"
msgstr "Ange målantalet ytor i förhållande till den aktuella meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'EDGE'
msgid "Input target edge length in the new mesh"
msgstr "Ange målkantlängd i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'FACES'
msgid "Input target number of faces in the new mesh"
msgstr "Ange målantalet ytor i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.preserve_attributes
msgid "Reproject attributes onto the new mesh"
msgstr "Reprojektera attribut på den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.smooth_normals
msgid "Set the output mesh normals to smooth"
msgstr "Ange att utgångsmeshens normaler ska vara jämna"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_edge_length
msgid "Target edge length in the new mesh"
msgstr "Målkantlängd i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_faces
msgid "Approximate number of faces (quads) in the new mesh"
msgstr "Ungefärligt antal ytor (fyrkanter) i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_ratio
msgid "Relative number of faces compared to the current mesh"
msgstr "Relativt antal ytor jämfört med den aktuella meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_mesh_symmetry
msgid "Generates a symmetrical mesh using the mesh symmetry configuration"
msgstr "Genererar en symmetrisk mesh med meshens symmetrikonfiguration"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_boundary
msgid "Try to preserve mesh boundary on the mesh"
msgstr "Försök bevara meshgränsen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_sharp
msgid "Try to preserve sharp features on the mesh"
msgstr "Försök att bevara skarpa detaljer på meshen"

#. :src: bpy.types.OBJECT_OT_shade_auto_smooth
msgid ""
"Add modifier to automatically set the sharpness of mesh edges based on the "
"angle between the neighboring faces"
msgstr ""
"Lägg till en modifierare som automatiskt anger meshkanternas skärpa utifrån "
"vinkeln mellan angränsande ytor"

#. :src: bpy.types.OBJECT_OT_shade_smooth_by_angle
#. :src: Asset description from file geometry_nodes_essentials.blend
msgid ""
"Set the sharpness of mesh edges based on the angle between the neighboring "
"faces"
msgstr ""
"Ställ in skärpan på meshkanterna baserat på vinkeln mellan angränsande ytor"

#. :src: bpy.types.OBJECT_OT_surfacedeform_bind
msgid "Bind mesh to target in surface deform modifier"
msgstr "Bind meshen till målet i ytdeformeringsmodifieraren"

#. :src: bpy.types.PAINT_OT_add_simple_uvs
msgid "Add cube map UVs on mesh"
msgstr "Lägg till UV:er för kubavbildning på meshen"

#. :src: bpy.types.PAINT_OT_visibility_filter
msgid "Edit the visibility of the current mesh"
msgstr "Redigera synligheten för den aktuella meshen"

#. :src: bpy.types.PAINT_OT_visibility_filter.action:'GROW'
msgid "Grow the visibility by one face based on mesh topology"
msgstr "Öka synligheten med en yta utifrån meshens topologi"

#. :src: bpy.types.PAINT_OT_visibility_filter.action:'SHRINK'
msgid "Shrink the visibility by one face based on mesh topology"
msgstr "Minska synligheten med en yta utifrån meshens topologi"
