#. :src: bpy.types.Constraint.error_location
msgid "Amount of residual error in Blender space unit for constraints that work on position"
msgstr "Mängden kvarstående fel i Blender-enheter för begränsningar som påverkar positionen"

#. :src: bpy.types.Constraint.error_rotation
msgid "Amount of residual error in radians for constraints that work on orientation"
msgstr "Mängden kvarstående fel i radianer för begränsningar som påverkar orienteringen"

#. :src: bpy.types.GeometryAttributeConstraint.attribute_name
msgid "Name of the attribute to retrieve the transform from"
msgstr "Namn på attributet att hämta transformationen från"

#. :src: bpy.types.GeometryAttributeConstraint.data_type:'FLOAT4X4'
msgid "4x4 Matrix data type, affects transform"
msgstr "Matrisdatatypen 4×4, påverkar transformationen"

#. :src: bpy.types.GeometryAttributeConstraint.mix_mode:'REPLACE'
msgid "Replace the original transformation with the transform from the attribute"
msgstr "Ersätt den ursprungliga transformationen med transformationen från attributet"

#. :src: bpy.types.Brush.pose_origin_type:'FACE_SETS'
msgid "Creates a pose segment per face set, starting from the active face set"
msgstr "Skapar ett poseringssegment per ytuppsättning med den aktiva ytuppsättningen som startpunkt"

#. :src: bpy.types.Itasc.reiteration_method:'NEVER'
msgid "The solver does not reiterate, not even on first frame (starts from rest pose)"
msgstr "Lösaren itererar inte om, inte ens på den första bildrutan (startar från vilopositionen)"

#. :src: bpy.types.POSE_OT_armature_apply
msgctxt "Operator"
msgid "Apply Pose as Rest Pose"
msgstr "Tillämpa pose som viloposition"

#. :src: bpy.types.POSE_OT_armature_apply
msgid "Apply the current pose as the new rest pose"
msgstr "Tillämpa den aktuella posen som den nya vilopositionen"

#. :src: bpy.types.POSE_OT_blend_with_rest
msgctxt "Operator"
msgid "Blend Pose with Rest Pose"
msgstr "Blanda pose med viloposition"

#. :src: bpy.types.POSE_OT_blend_with_rest
msgid "Make the current pose more similar to, or further away from, the rest pose"
msgstr "Gör den aktuella posen mer lik eller mer olik vilopositionen"

msgctxt "Operator"
msgid "Apply Selected as Rest Pose"
msgstr "Verkställ markerade som viloposition"

#. :src: bpy.types.POSE_OT_relax
msgid "Make the current pose more similar to its breakdown pose"
msgstr "Gör den aktuella posen mer lik sin mellanpose"
