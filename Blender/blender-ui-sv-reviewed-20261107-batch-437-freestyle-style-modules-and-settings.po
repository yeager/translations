#. :src: bpy.types.FreestyleSettings.kr_derivative_epsilon
msgid "Kr Derivative Epsilon"
msgstr "Epsilon för Kr-derivatan"

#. :src: bpy.types.FreestyleSettings.kr_derivative_epsilon
msgid "Kr derivative epsilon for computing suggestive contours"
msgstr "Epsilon för Kr-derivatan vid beräkning av suggestiva konturer"

#. :src: bpy.types.FreestyleSettings.mode
#: scripts/startup/bl_ui/properties_freestyle.py:164
msgid "Control Mode"
msgstr "Kontrolläge"

#. :src: bpy.types.FreestyleSettings.mode
msgid "Select the Freestyle control mode"
msgstr "Välj kontrolläge för Freestyle"

#. :src: bpy.types.FreestyleSettings.mode:'SCRIPT'
msgid "Advanced mode for using style modules written in Python"
msgstr "Avancerat läge för användning av stilmoduler skrivna i Python"

#. :src: bpy.types.FreestyleSettings.mode:'EDITOR'
msgid "Parameter Editor"
msgstr "Parameterredigerare"

#. :src: bpy.types.FreestyleSettings.mode:'EDITOR'
msgid "Basic mode for interactive style parameter editing"
msgstr "Grundläge för interaktiv parameterredigering"

#. :src: bpy.types.FreestyleSettings.sphere_radius
msgid "Sphere Radius"
msgstr "Sfärens radie"

#. :src: bpy.types.FreestyleSettings.sphere_radius
msgid "Sphere radius for computing curvatures"
msgstr "Sfärradie för beräkning av krökningar"

#. :src: bpy.types.FreestyleSettings.use_culling
msgid "If enabled, out-of-view edges are ignored"
msgstr "Om aktiverat ignoreras kanter som inte syns"

#. :src: bpy.types.FreestyleSettings.use_material_boundaries
msgid "Material Boundaries"
msgstr "Materialgränser"

#. :src: bpy.types.FreestyleSettings.use_material_boundaries
msgid "Enable material boundaries"
msgstr "Aktivera materialgränser"

#. :src: bpy.types.FreestyleSettings.use_ridges_and_valleys
msgid "Ridges and Valleys"
msgstr "Åsar och dalar"

#. :src: bpy.types.FreestyleSettings.use_ridges_and_valleys
msgid "Enable ridges and valleys"
msgstr "Aktivera åsar och dalar"

#. :src: bpy.types.FreestyleSettings.use_smoothness
msgid "Face Smoothness"
msgstr "Ytjämnhet"

#. :src: bpy.types.FreestyleSettings.use_smoothness
msgid "Take face smoothness into account in view map calculation"
msgstr "Ta hänsyn till ytjämnheten vid beräkning av vykartan"

#. :src: bpy.types.FreestyleSettings.use_suggestive_contours
msgid "Suggestive Contours"
msgstr "Suggestiva konturer"

#. :src: bpy.types.FreestyleSettings.use_suggestive_contours
msgid "Enable suggestive contours"
msgstr "Aktivera suggestiva konturer"

#. :src: bpy.types.FreestyleSettings.use_view_map_cache
msgid ""
"Keep the computed view map and avoid recalculating it if mesh geometry is "
"unchanged"
msgstr ""
"Behåll den beräknade vykartan och undvik att räkna om den om meshgeometrin "
"är oförändrad"
