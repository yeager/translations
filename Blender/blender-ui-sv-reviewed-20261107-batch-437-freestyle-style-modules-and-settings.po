#. :src: bpy.types.FreestyleModuleSettings
msgid "Freestyle Module"
msgstr "Freestyle-modul"

#. :src: bpy.types.FreestyleModuleSettings
msgid "Style module configuration for specifying a style module"
msgstr "Konfiguration av stilmodul för att specificera en stilmodul"

#. :src: bpy.types.FreestyleModuleSettings.script
msgid "Style Module"
msgstr "Stilmodul"

#. :src: bpy.types.FreestyleModuleSettings.script
msgid "Python script to define a style module"
msgstr "Python-skript för att definiera en stilmodul"

#. :src: bpy.types.FreestyleModules
#. :src: bpy.types.FreestyleSettings.modules
#. :src: bpy.types.VIEWLAYER_PT_freestyle_style_modules
msgid "Style Modules"
msgstr "Stilmoduler"

#. :src: bpy.types.FreestyleModules
#. :src: bpy.types.FreestyleSettings.modules
msgid "A list of style modules (to be applied from top to bottom)"
msgstr "En lista med stilmoduler (som ska tillämpas uppifrån och ner)"

#. :src: bpy.types.FreestyleSettings
#. :src: bpy.types.ViewLayer.freestyle_settings
msgid "Freestyle Settings"
msgstr "Freestyle-inställningar"

#. :src: bpy.types.FreestyleSettings
msgid "Freestyle settings for a ViewLayer data-block"
msgstr "Freestyle-inställningar för ett visningslagerdatablock"

#. :src: bpy.types.FreestyleSettings.as_render_pass
msgid ""
"Renders Freestyle output to a separate pass instead of overlaying it on the "
"Combined pass"
msgstr ""
"Renderar Freestyle-utdata i ett separat pass i stället för att överlagra det "
"på Kombinerat-passet"

