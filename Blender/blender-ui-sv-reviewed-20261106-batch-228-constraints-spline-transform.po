#. :src: bpy.types.SplineIKConstraint.target
msgid "Curve that controls this relationship"
msgstr "Kurva som styr den här relationen"

#. :src: bpy.types.SplineIKConstraint.use_chain_offset
msgid "Offset the entire chain relative to the root joint"
msgstr "Förskjut hela kedjan i förhållande till rotleden"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'BONE_ORIGINAL'
#. :src: bpy.types.SplineIKConstraint.y_scale_mode:'BONE_ORIGINAL'
msgid "Bone Original"
msgstr "Ursprungligt ben"

#. :src: bpy.types.SplineIKConstraint.xz_scale_mode:'VOLUME_PRESERVE'
#. :src: bpy.types.Brush.elastic_deform_volume_preservation
msgid "Volume Preservation"
msgstr "Volymbevarande"

#. :src: bpy.types.StretchToConstraint.keep_axis
msgid "Keep Axis"
msgstr "Behåll axel"

#. :src: bpy.types.StretchToConstraint.keep_axis:'SWING_Y'
msgid "Swing"
msgstr "Svängning"

#. :src: bpy.types.StretchToConstraint.volume
msgid "Maintain the object's volume as it stretches"
msgstr "Bevara objektets volym när det sträcks"

#. :src: bpy.types.TrackToConstraint.use_target_z
msgid "Target Z"
msgstr "Mål-Z"

#. :src: bpy.types.TransformCacheConstraint
msgid "Transform Cache Constraint"
msgstr "Transformationscachebegränsning"

#. :src: bpy.types.TransformCacheConstraint.object_path
msgid ""
"Path to the object in the Alembic archive used to lookup the transform matrix"
msgstr ""
"Sökväg till objektet i Alembic-arkivet som används för att slå upp "
"transformationsmatrisen"

#. :src: bpy.types.TransformConstraint.from_max_x
#. :src: bpy.types.TransformConstraint.from_max_x_rot
#. :src: bpy.types.TransformConstraint.from_max_x_scale
msgid "From Maximum X"
msgstr "Från högsta X"

#. :src: bpy.types.TransformConstraint.from_max_y
#. :src: bpy.types.TransformConstraint.from_max_y_rot
#. :src: bpy.types.TransformConstraint.from_max_y_scale
msgid "From Maximum Y"
msgstr "Från högsta Y"

#. :src: bpy.types.TransformConstraint.from_max_z
#. :src: bpy.types.TransformConstraint.from_max_z_rot
#. :src: bpy.types.TransformConstraint.from_max_z_scale
msgid "From Maximum Z"
msgstr "Från högsta Z"

#. :src: bpy.types.TransformConstraint.from_max_z
#. :src: bpy.types.TransformConstraint.from_max_z_rot
#. :src: bpy.types.TransformConstraint.from_max_z_scale
msgid "Top range of Z axis source motion"
msgstr "Övre intervall för Z-axelns källrörelse"

#. :src: bpy.types.TransformConstraint.from_min_x
#. :src: bpy.types.TransformConstraint.from_min_x_rot
#. :src: bpy.types.TransformConstraint.from_min_x_scale
msgid "From Minimum X"
msgstr "Från lägsta X"

#. :src: bpy.types.TransformConstraint.from_min_y
#. :src: bpy.types.TransformConstraint.from_min_y_rot
#. :src: bpy.types.TransformConstraint.from_min_y_scale
msgid "From Minimum Y"
msgstr "Från lägsta Y"

#. :src: bpy.types.TransformConstraint.from_min_y
#. :src: bpy.types.TransformConstraint.from_min_y_rot
#. :src: bpy.types.TransformConstraint.from_min_y_scale
msgid "Bottom range of Y axis source motion"
msgstr "Nedre intervall för Y-axelns källrörelse"

#. :src: bpy.types.TransformConstraint.from_min_z
#. :src: bpy.types.TransformConstraint.from_min_z_rot
#. :src: bpy.types.TransformConstraint.from_min_z_scale
msgid "From Minimum Z"
msgstr "Från lägsta Z"

#. :src: bpy.types.TransformConstraint.from_min_z
#. :src: bpy.types.TransformConstraint.from_min_z_rot
#. :src: bpy.types.TransformConstraint.from_min_z_scale
msgid "Bottom range of Z axis source motion"
msgstr "Nedre intervall för Z-axelns källrörelse"

#. :src: bpy.types.TransformConstraint.from_rotation_mode:'AUTO'
#. :src: bpy.types.DriverTarget.rotation_mode:'AUTO'
msgid "Auto Euler"
msgstr "Automatisk Euler"

#. :src: bpy.types.TransformConstraint.from_rotation_mode:'QUATERNION'
#. :src: bpy.types.DriverTarget.rotation_mode:'QUATERNION'
msgid "Quaternion rotation"
msgstr "Kvaternionrotation"

#. :src: bpy.types.TransformConstraint.from_rotation_mode:'SWING_TWIST_X'
#. :src: bpy.types.DriverTarget.rotation_mode:'SWING_TWIST_X'
msgid "Swing and X Twist"
msgstr "Svängning och vridning kring X"

#. :src: bpy.types.TransformConstraint.from_rotation_mode:'SWING_TWIST_X'
#. :src: bpy.types.DriverTarget.rotation_mode:'SWING_TWIST_X'
msgid ""
"Decompose into a swing rotation to aim the X axis, followed by twist around "
"it"
msgstr ""
"Dela upp i en svängning som riktar in X-axeln, följd av vridning kring den"

#. :src: bpy.types.TransformConstraint.from_rotation_mode:'SWING_TWIST_Y'
#. :src: bpy.types.DriverTarget.rotation_mode:'SWING_TWIST_Y'
msgid "Swing and Y Twist"
msgstr "Svängning och vridning kring Y"

#. :src: bpy.types.TransformConstraint.from_rotation_mode:'SWING_TWIST_Y'
#. :src: bpy.types.DriverTarget.rotation_mode:'SWING_TWIST_Y'
msgid ""
"Decompose into a swing rotation to aim the Y axis, followed by twist around "
"it"
msgstr ""
"Dela upp i en svängning som riktar in Y-axeln, följd av vridning kring den"

#. :src: bpy.types.TransformConstraint.from_rotation_mode:'SWING_TWIST_Z'
#. :src: bpy.types.DriverTarget.rotation_mode:'SWING_TWIST_Z'
msgid "Swing and Z Twist"
msgstr "Svängning och vridning kring Z"

#. :src: bpy.types.TransformConstraint.from_rotation_mode:'SWING_TWIST_Z'
#. :src: bpy.types.DriverTarget.rotation_mode:'SWING_TWIST_Z'
msgid ""
"Decompose into a swing rotation to aim the Z axis, followed by twist around "
"it"
msgstr ""
"Dela upp i en svängning som riktar in Z-axeln, följd av vridning kring den"

#. :src: bpy.types.TransformConstraint.map_to_x_from
msgid "Map To X From"
msgstr "Mappa till X från"

#. :src: bpy.types.TransformConstraint.map_to_x_from
msgid "The source axis constrained object's X axis uses"
msgstr "Källaxeln som det begränsade objektets X-axel använder"

#. :src: bpy.types.TransformConstraint.map_to_y_from
msgid "Map To Y From"
msgstr "Mappa till Y från"

#. :src: bpy.types.TransformConstraint.map_to_y_from
msgid "The source axis constrained object's Y axis uses"
msgstr "Källaxeln som det begränsade objektets Y-axel använder"

#. :src: bpy.types.TransformConstraint.map_to_z_from
msgid "Map To Z From"
msgstr "Mappa till Z från"

#. :src: bpy.types.TransformConstraint.map_to_z_from
msgid "The source axis constrained object's Z axis uses"
msgstr "Källaxeln som det begränsade objektets Z-axel använder"

#. :src: bpy.types.TransformConstraint.mix_mode
msgid "Specify how to combine the new location with original"
msgstr "Ange hur den nya positionen ska kombineras med den ursprungliga"

#. :src: bpy.types.TransformConstraint.mix_mode:'ADD'
#. :src: bpy.types.TransformConstraint.mix_mode_rot:'ADD'
msgid "Add component values together"
msgstr "Addera komponentvärden"

#. :src: bpy.types.TransformConstraint.mix_mode_rot:'BEFORE'
msgid "Apply new rotation before original, as if it was on a parent"
msgstr ""
"Tillämpa den nya rotationen före originalet, som om den låg på en förälder"

#. :src: bpy.types.TransformConstraint.mix_mode_rot:'AFTER'
msgid "Apply new rotation after original, as if it was on a child"
msgstr ""
"Tillämpa den nya rotationen efter originalet, som om den låg på ett barn"

#. :src: bpy.types.TransformConstraint.mix_mode_scale:'MULTIPLY'
msgid "Multiply component values together"
msgstr "Multiplicera komponentvärden"

#. :src: bpy.types.TransformConstraint.to_euler_order
msgid "To Order"
msgstr "Utdataordning"

#. :src: bpy.types.TransformConstraint.to_euler_order
msgid "Explicitly specify the output euler rotation order"
msgstr "Ange uttryckligen Eulerrotationens ordning för utdata"
