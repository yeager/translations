#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.method
msgid "Method of distributing the vertices over the stroke"
msgstr "Metod för att fördela hörnen över strecket"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.method:'SPREAD'
msgid ""
"Distribute vertices along the full stroke, retaining relative distances "
"between the vertices"
msgstr ""
"Fördela hörnen längs hela strecket och behåll de relativa avstånden mellan "
"hörnen"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.method:'SPREAD_EVENLY'
msgid "Spread Evenly"
msgstr "Fördela jämnt"

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.method:'SPREAD_EVENLY'
msgid "Distribute vertices at regular distances along the full stroke "
msgstr "Fördela hörn med jämna avstånd längs hela strecket "

#. :src: bpy.types.MESH_OT_fit_edge_loops_to_annotation.method:'PROJECT'
msgid ""
"Project vertices onto the stroke using vertex normals and connected edges. "
"Requires more exact annotation placement, otherwise it may do nothing"
msgstr ""
"Projicera hörnen på strecket med hjälp av hörnnormala och anslutna kanter. "
"Kräver mer exakt placering av anteckningen, annars kanske inget händer"

#. :src: bpy.types.NODE_OT_comment_edit
msgctxt "Operator"
msgid "Edit Comment"
msgstr "Redigera kommentar"

#. :src: bpy.types.NODE_OT_comment_edit
msgid "Enter edit mode for the comment node under the cursor"
msgstr "Gå till redigeringsläge för kommentarsnoden under pekaren"

#. :src: bpy.types.NODE_OT_comment_edit.use_active
msgid "Edit the active comment node, rather than the one under the cursor"
msgstr "Redigera den aktiva kommentarsnoden i stället för den under pekaren"

#. :src: bpy.types.NODE_OT_nw_factor
msgid "Change factor inputs of selected nodes"
msgstr "Ändra faktorindata för markerade noder"

#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'INSTANCES'
msgctxt "NodeTree"
msgid "Geometry to Instance"
msgstr "Geometri till instans"

#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'INSTANCES'
msgid "Geometry to Instance Mode"
msgstr "Läge för geometri till instans"

#. :src: bpy.types.POSE_OT_paste.factor
msgid ""
"Blends the current pose to the pose to paste. At 1, the pasted pose "
"completely overwrites the current pose"
msgstr ""
"Blandar den aktuella posen med posen som ska klistras in. Vid 1 skriver den "
"inklistrade posen över den aktuella posen helt"

#. :src: bpy.types.SCREEN_OT_project_settings_show
msgctxt "Operator"
msgid "Open Project Settings..."
msgstr "Öppna projektinställningar…"

#. :src: bpy.types.SCREEN_OT_project_settings_show.section
msgid "Section to activate in Project Settings"
msgstr "Avsnitt som ska aktiveras i projektinställningarna"

#. :src: bpy.types.SCREEN_OT_userpref_show.section:'ASSETS'
#. :src: bpy.types.Preferences.active_section:'ASSETS'
msgid "Manage remote, local, and extension asset libraries"
msgstr "Hantera fjärranslutna, lokala och tillgångsbibliotek för tillägg"

