#. :src: bpy.types.TRANSFORM_OT_seq_slide.insert
#. :src: bpy.types.SequencerToolSettings.ripple_insert
msgid ""
"Split strips at the leftmost edited handle and push the remainder aside, "
"else ripple only as far as needed to resolve the overlap"
msgstr ""
"Dela remsor vid det vänstra redigerade handtaget och flytta resten åt sidan."
" Annars förskjuts endast så långt som behövs för att lösa överlappningen"

#. :src: bpy.types.WM_OT_otio_export
msgctxt "Operator"
msgid "Export OTIO"
msgstr "Exportera OTIO"

#. :src: bpy.types.WM_OT_otio_export
