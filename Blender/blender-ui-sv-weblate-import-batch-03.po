msgstr "Flytta remsor efter tillägg"

#. :src: bpy.types.SEQUENCER_OT_add_scene_strip_from_scene_asset.overlap_mode
#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.overlap_mode
#. :src: bpy.types.SEQUENCER_OT_image_strip_add.overlap_mode
