#. :src: source/blender/editors/transform/transform_mode_edge_seq_slide.cc:187
msgid "Ripple"
msgstr "Kedjeförskjutning"

#. :src:
#. bpy.types.SEQUENCER_OT_add_scene_strip_from_scene_asset.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_image_strip_add.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_mask_strip_add.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_movieclip_strip_add.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_scene_strip_add.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_scene_strip_add_new.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_sound_strip_add.overlap_mode:'RIPPLE'
#. :src: bpy.types.SEQUENCER_OT_text_strip_add.overlap_mode:'RIPPLE'
#. :src: bpy.types.TRANSFORM_OT_seq_slide.overlap_mode:'RIPPLE'
#. :src: bpy.types.SequencerToolSettings.overlap_mode:'RIPPLE'
msgid ""
"Push the strips that are in the way further along the timeline, keeping the "
"spacing between them intact"
msgstr ""
"Flytta remsor som ligger i vägen längre fram på tidslinjen och behåll "
"avståndet mellan dem"

#. :src:
#. bpy.types.SEQUENCER_OT_add_scene_strip_from_scene_asset.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_image_strip_add.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_mask_strip_add.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_movieclip_strip_add.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_scene_strip_add.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_scene_strip_add_new.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_sound_strip_add.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SEQUENCER_OT_text_strip_add.overlap_mode:'OVERWRITE'
#. :src: bpy.types.TRANSFORM_OT_seq_slide.overlap_mode:'OVERWRITE'
#. :src: bpy.types.SequencerToolSettings.overlap_mode:'OVERWRITE'
msgid ""
"Replace the covered part of the strips that are in the way, trimming or "
"splitting them"
msgstr ""
"Ersätt de delar av remsor som ligger i vägen och täcks, genom att trimma "
"eller dela dem"

#. :src:
#. bpy.types.SEQUENCER_OT_add_scene_strip_from_scene_asset.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_image_strip_add.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_mask_strip_add.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_movieclip_strip_add.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_scene_strip_add.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_scene_strip_add_new.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_sound_strip_add.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SEQUENCER_OT_text_strip_add.overlap_mode:'SHUFFLE'
#. :src: bpy.types.TRANSFORM_OT_seq_slide.overlap_mode:'SHUFFLE'
#. :src: bpy.types.SequencerToolSettings.overlap_mode:'SHUFFLE'
msgid ""
"Move the transformed strips to the nearest free space, leaving every other "
"strip where it is"
msgstr ""
"Flytta de transformerade remsorna till närmaste lediga utrymme och lämna "
"alla andra remsor där de är"

#. :src: bpy.types.SEQUENCER_OT_box_blade.ignore_selection
#. :src: bpy.types.SEQUENCER_OT_split.ignore_selection
msgid "Deprecated, will be removed in 6.0. Use only_selected instead"
msgstr "Föråldrad, tas bort i 6.0. Använd only_selected i stället"

#. :src: bpy.types.SEQUENCER_OT_box_blade.only_selected
#. :src: bpy.types.SEQUENCER_OT_split.only_selected
msgid "Only split selected strips"
msgstr "Dela endast markerade remsor"

#. :src: bpy.types.SEQUENCER_OT_ripple_delete.all_channels
#. :src: bpy.types.SEQUENCER_OT_ripple_trim.all_channels
#. :src: bpy.types.TRANSFORM_OT_seq_slide.all_channels
#. :src: bpy.types.SequencerToolSettings.ripple_all_channels
msgid ""
"Ripple strips on other channels too, else only strips on the same channels "
"as the edited strips"
msgstr ""
"Förskjut även remsor på andra kanaler, annars endast remsor på samma kanaler"
" som de redigerade remsorna"

#. :src: bpy.types.SEQUENCER_OT_ripple_delete.clear_ranges
#. :src: bpy.types.SequencerToolSettings.ripple_clear_ranges
msgid "Clear Ranges"
msgstr "Rensa intervall"

#. :src: bpy.types.SEQUENCER_OT_ripple_delete.clear_ranges
#. :src: bpy.types.SequencerToolSettings.ripple_clear_ranges
msgid ""
"Delete strip contents inside the removed ranges on rippled channels so later"
" strips close the full gap, else ripple later strips only as far as they can"
msgstr ""
"Ta bort remsinnehåll inom de borttagna intervallen på kedjeförskjutna "
"kanaler så att senare remsor fyller hela luckan, annars förskjuts senare "
"remsor endast så långt som möjligt"

#. :src: bpy.types.SEQUENCER_OT_ripple_trim
msgctxt "Operator"
msgid "Ripple Trim Strips"
msgstr "Trimma remsor med kedjeförskjutning"

#. :src: bpy.types.SEQUENCER_OT_ripple_trim
msgid "Trim strips to the current frame and close the gaps left behind"
msgstr ""
"Trimma remsor till den aktuella bildrutan och stäng luckorna som blir kvar"

#. :src: bpy.types.SEQUENCER_OT_ripple_trim.side
msgid "The side of the strips to trim to the current frame"
msgstr "Den sida av remsorna som ska trimmas till den aktuella bildrutan"

#. :src: bpy.types.SEQUENCER_OT_split.all_channels
msgid ""
"Split strips in all channels at the split frame, not only the one under the "
"cursor"
msgstr ""
"Dela remsor i alla kanaler vid delningsbildrutan, inte bara den under "
"pekaren"

#. :src: bpy.types.SEQUENCER_OT_split.channel
msgid ""
"Initial channel used for the split, which may propagate to channels of "
"effects, connections, or all other channels"
msgstr ""
"Ursprunglig kanal som används för delningen. Den kan påverka kanaler med "
"effekter, anslutningar eller alla andra kanaler"

#. :src: bpy.types.SEQUENCER_OT_split.use_cursor_position
msgid "Split at Cursor"
msgstr "Dela vid markören"

#. :src: bpy.types.SEQUENCER_OT_split.use_cursor_position
msgid "Split at the position of the mouse cursor instead of the current frame"
msgstr "Dela vid markörens position i stället för den aktuella bildrutan"

