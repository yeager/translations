#. :src: bpy.types.Bone.head
msgid "Location of head end of the bone relative to its parent"
msgstr "Placering av benets huvud i förhållande till det överordnade benet"

#. :src: bpy.types.Bone.head_local
msgid "Location of head end of the bone relative to armature"
msgstr "Placering av benets huvud i förhållande till riggskelettet"

#. :src: bpy.types.Bone.hide
msgid ""
"Bone is not visible when it is not in Edit Mode (i.e. in Object or Pose "
"Modes)"
msgstr ""
"Benet är inte synligt när det inte är i redigeringsläge (dvs. i objekt- "
"eller poseringsläge)"

#. :src: bpy.types.Bone.hide_select
#. :src: bpy.types.EditBone.hide_select
#. :src: bpy.types.SpaceOutliner.filter_state:'SELECTABLE'
#. :src: bpy.types.SpaceOutliner.show_restrict_column_select
#: scripts/addons_core/cycles/ui.py:1402
#: scripts/startup/bl_ui/properties_collection.py:41
#: scripts/startup/bl_ui/properties_object.py:397
msgid "Selectable"
msgstr "Valbar"

#. :src: bpy.types.Bone.hide_select
#. :src: bpy.types.EditBone.hide_select
msgid "Bone is able to be selected"
msgstr "Benet kan väljas"

#. :src: bpy.types.Bone.inherit_scale
#. :src: bpy.types.EditBone.inherit_scale
msgid "Specifies how the bone inherits scaling from the parent bone"
msgstr "Anger hur benet ärver skalning från det överordnade benet"

#. :src: bpy.types.Bone.length
#. :src: bpy.types.PoseBone.length
msgid "Length of the bone"
msgstr "Benets längd"

#. :src: bpy.types.Bone.matrix
msgid "Bone Matrix"
msgstr "Benmatris"

#. :src: bpy.types.Bone.matrix
msgid "3×3 bone matrix"
msgstr "3×3 benmatris"

#. :src: bpy.types.Bone.select_head
msgid "Select Head"
msgstr "Välj benhuvud"

#. :src: bpy.types.Bone.select_tail
msgid "Select Tail"
msgstr "Välj benspets"

#. :src: bpy.types.Bone.tail
msgid "Location of tail end of the bone relative to its parent"
msgstr "Placering av benets spets i förhållande till det överordnade benet"

#. :src: bpy.types.Bone.tail_local
msgid "Armature-Relative Tail"
msgstr "Benspets relativt riggskelettet"

#. :src: bpy.types.Bone.tail_local
msgid "Location of tail end of the bone relative to armature"
msgstr "Placering av benets spets i förhållande till riggskelettet"

#. :src: bpy.types.Bone.tail_radius
#. :src: bpy.types.EditBone.tail_radius
msgid "Envelope Tail Radius"
msgstr "Kuvertets spetsradie"

#. :src: bpy.types.Bone.tail_radius
#. :src: bpy.types.EditBone.tail_radius
msgid "Radius of tail of bone (for Envelope deform only)"
msgstr "Radie för benets spets (endast för kuvertdeformering)"

#. :src: bpy.types.Bone.use_connect
#. :src: bpy.types.EditBone.use_connect
msgid "When bone has a parent, bone's head is stuck to the parent's tail"
msgstr ""
"När benet har ett överordnat ben sitter dess huvud fast vid det överordnade "
"benets spets"

#. :src: bpy.types.Bone.use_cyclic_offset
#. :src: bpy.types.EditBone.use_cyclic_offset
msgid "Cyclic Offset"
msgstr "Cyklisk förskjutning"
