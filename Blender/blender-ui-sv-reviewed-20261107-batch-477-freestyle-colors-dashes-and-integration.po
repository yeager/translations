msgstr "Längd på första strecket i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.dash2
msgid "Dash 2"
msgstr "Streck 2"

#. :src: bpy.types.FreestyleLineStyle.dash2
msgid "Length of the 2nd dash for dashed lines"
msgstr "Längd på andra strecket i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.dash3
msgid "Dash 3"
msgstr "Streck 3"

#. :src: bpy.types.FreestyleLineStyle.dash3
msgid "Length of the 3rd dash for dashed lines"
msgstr "Längd på tredje strecket i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.gap1
#: scripts/startup/bl_ui/properties_freestyle.py:656
#: scripts/startup/bl_ui/properties_freestyle.py:762
msgid "Gap 1"
msgstr "Mellanrum 1"

#. :src: bpy.types.FreestyleLineStyle.gap1
msgid "Length of the 1st gap for dashed lines"
msgstr "Längd på första mellanrummet i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.gap2
msgid "Gap 2"
msgstr "Mellanrum 2"

#. :src: bpy.types.FreestyleLineStyle.gap2
