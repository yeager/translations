#. :src: bpy.types.FreestyleLineStyle.color_modifiers
#. :src: bpy.types.LineStyleColorModifiers
msgid "Color Modifiers"
msgstr "Färgmodifierare"

#. :src: bpy.types.FreestyleLineStyle.color_modifiers
msgid "List of line color modifiers"
msgstr "Lista över linjefärgsmodifierare"

#. :src: bpy.types.FreestyleLineStyle.dash1
#: scripts/startup/bl_ui/properties_freestyle.py:652
#: scripts/startup/bl_ui/properties_freestyle.py:758
msgid "Dash 1"
msgstr "Streck 1"

#. :src: bpy.types.FreestyleLineStyle.dash1
