#. :src: bpy.types.FreestyleLineStyle.gap3
msgid "Gap 3"
msgstr "Mellanrum 3"

#. :src: bpy.types.FreestyleLineStyle.gap3
msgid "Length of the 3rd gap for dashed lines"
msgstr "Längd på tredje mellanrummet i streckade linjer"

#. :src: bpy.types.FreestyleLineStyle.geometry_modifiers
#. :src: bpy.types.LineStyleGeometryModifiers
msgid "Geometry Modifiers"
msgstr "Geometrimodifierare"

#. :src: bpy.types.FreestyleLineStyle.geometry_modifiers
msgid "List of stroke geometry modifiers"
msgstr "Lista över streckgeometrimodifierare"

#. :src: bpy.types.FreestyleLineStyle.integration_type
msgid "Integration Type"
msgstr "Typ av integration"

#. :src: bpy.types.FreestyleLineStyle.integration_type
msgid "Select the way how the sort key is computed for each chain"
msgstr "Välj hur sorteringsnyckeln ska beräknas för varje kedja"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'MEAN'
#: source/blender/nodes/composite/nodes/node_composite_levels.cc:33
#: source/blender/nodes/geometry/nodes/node_geo_attribute_statistic.cc:33
#: source/blender/nodes/geometry/nodes/node_geo_field_average.cc:94
msgid "Mean"
msgstr "Medelvärde"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'MEAN'
msgid ""
"The value computed for the chain is the mean of the values obtained for "
"chain vertices"
msgstr ""
"Det värde som beräknas för kedjan är medelvärdet av de värden som erhålls "
"för kedjans hörnpunkter"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'MIN'
msgid ""
"The value computed for the chain is the minimum of the values obtained for "
"chain vertices"
msgstr ""
"Det värde som beräknas för kedjan är det lägsta av de värden som erhålls för "
"kedjans hörnpunkter"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'MAX'
msgid ""
"The value computed for the chain is the maximum of the values obtained for "
"chain vertices"
msgstr ""
"Det värde som beräknas för kedjan är det högsta av de värden som erhålls för "
"kedjans hörnpunkter"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'FIRST'
#: scripts/startup/bl_ui/properties_physics_rigidbody_constraint.py:95
#: scripts/startup/bl_ui/properties_texture.py:673
msgid "First"
msgstr "Första"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'FIRST'
msgid ""
"The value computed for the chain is the value obtained for the first chain "
"vertex"
msgstr ""
"Det värde som beräknas för kedjan är det värde som erhålls för kedjans "
"första hörnpunkt"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'LAST'
msgid "Last"
msgstr "Sista"

#. :src: bpy.types.FreestyleLineStyle.integration_type:'LAST'
msgid ""
"The value computed for the chain is the value obtained for the last chain "
"vertex"
msgstr ""
"Det värde som beräknas för kedjan är det värde som erhålls för kedjans sista "
"hörnpunkt"
