#. :src: bpy.types.MovieClip
msgid "MovieClip data-block referencing an external movie file"
msgstr "MovieClip-datablock som refererar till en extern filmfil"

#. :src: bpy.types.MovieClip.display_aspect
msgid "Display Aspect for this clip, does not affect rendering"
msgstr "Visningsproportioner för det här klippet; påverkar inte renderingen"

#. :src: bpy.types.MovieClip.filepath
msgid "Filename of the movie or sequence file"
msgstr "Filnamn för film- eller sekvensfilen"

#. :src: bpy.types.MovieClip.fps
msgid "Detected frame rate of the movie clip in frames per second"
msgstr "Upptäckt bildfrekvens för filmklippet i bildrutor per sekund"

#. :src: bpy.types.MovieClip.frame_duration
msgid "Detected duration of movie clip in frames"
msgstr "Upptäckt längd på filmklipp i bildrutor"

#. :src: bpy.types.MovieClip.frame_offset
msgid ""
"Offset of footage first frame relative to its file name (affects only how "
"footage is loading, does not change data associated with a clip)"
msgstr ""
"Förskjutning av filmens första bildruta i förhållande till filnamnet "
"(påverkar endast hur filmen läses in och ändrar inte data som är kopplade "
"till ett klipp)"

#. :src: bpy.types.MovieClip.frame_start
msgid ""
"Global scene frame number at which this movie starts playing (affects all "
"data associated with a clip)"
msgstr ""
"Globalt bildnummer för scenen där filmen börjar spelas upp (påverkar alla "
"data som är associerade med ett klipp)"

#. :src: bpy.types.MovieClip.grease_pencil
msgid "Grease Pencil data for this movie clip"
msgstr "Grease Pencil-data för detta filmklipp"

#. :src: bpy.types.MovieClip.size
msgid "Width and height in pixels, zero when image data can't be loaded"
msgstr "Bredd och höjd i pixlar, noll om bilddata inte kan läsas in"

#. :src: bpy.types.MovieClip.source
msgid "Where the clip comes from"
msgstr "Varifrån klippet kommer"

#. :src: bpy.types.MovieClip.source:'MOVIE'
msgid "Movie File"
msgstr "Filmfil"

#. :src: bpy.types.MovieClip.use_proxy
#. :src: bpy.types.EffectStrip.use_proxy
#. :src: bpy.types.ImageStrip.use_proxy
#. :src: bpy.types.MetaStrip.use_proxy
#. :src: bpy.types.MovieStrip.use_proxy
#. :src: bpy.types.SceneStrip.use_proxy
msgid "Use Proxy / Timecode"
msgstr "Använd proxy/tidskod"

#. :src: bpy.types.MovieClip.use_proxy
msgid "Use a preview proxy and/or timecode index for this clip"
msgstr ""
"Använd en förhandsgranskningsproxy och/eller ett tidskodsindex för det här "
"klippet"

#. :src: bpy.types.MovieClip.use_proxy_custom_directory
#. :src: bpy.types.StripProxy.use_proxy_custom_directory
msgid "Proxy Custom Directory"
msgstr "Anpassad proxykatalog"

#. :src: bpy.types.MovieClip.use_proxy_custom_directory
msgid "Create proxy images in a custom directory (default is movie location)"
msgstr ""
"Skapa proxybilder i en anpassad katalog (standarden är filmens katalog)"
