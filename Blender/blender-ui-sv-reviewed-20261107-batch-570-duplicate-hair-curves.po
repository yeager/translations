#. :src: bpy.types.SolidifyModifier.use_even_offset
#. :src: Socket name from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Even Thickness"
msgstr "Jämn tjocklek"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Duplicates hair curves a certain number of times within a radius"
msgstr "Duplicerar hårkurvor ett visst antal gånger inom en radie"

#. :src: Socket description from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Amount of duplicates per curve"
msgstr "Antal dubbletter per kurva"

#. :src: Socket name from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Viewport Amount"
msgstr "Mängd i visningsområdet"

#. :src: Socket description from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Percentage of amount used for the viewport"
msgstr "Procentandel av mängden som används i visningsområdet"

#. :src: Socket description from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Radius in which the duplicate curves are offset from the guides"
msgstr "Radie inom vilken de duplicerade kurvorna förskjuts från guidekurvorna"

#. :src: Socket name from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Distribution Shape"
msgstr "Fördelningsform"

#. :src: Socket description from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Shape of distribution from center to the edge around the guide"
msgstr "Fördelningens form från mitten till kanten runt guiden"

#. :src: Socket description from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Offset of the curves to round the tip"
msgstr "Förskjutning av kurvorna för att runda spetsen"

#. :src: Socket description from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Keep an even thickness of the distribution of duplicates"
msgstr "Bibehåll en jämn tjocklek i fördelningen av dubbletter"
