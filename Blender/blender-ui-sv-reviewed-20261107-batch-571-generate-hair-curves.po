#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Generate Hair Curves"
msgstr "Generera hårkurvor"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Surface geometry for generation"
msgstr "Ytgeometri för generering"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Surface object for generation (needs matching transforms)"
msgstr "Ytobjekt för generering (behöver matchande transformationer)"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
msgid "Length of the generated hair curves"
msgstr "Längd på de genererade hårkurvorna"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
msgid "Material of the generated hair curves"
msgstr "Material för de genererade hårkurvorna"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
msgid "Amount of control points of the generated hair curves"
msgstr "Antal kontrollpunkter för de genererade hårkurvorna"

#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Poisson Disk Distribution"
msgstr "Poisson-diskfördelning"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Use Poisson disk distribution method to keep a minimum distance"
msgstr "Använd Poisson-diskfördelning för att upprätthålla ett minsta avstånd"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Surface density of generated hair curves"
msgstr "Ytdensitet för genererade hårkurvor"

#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Density Mask"
msgstr "Densitetsmask"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Factor applied on the density for curve distribution"
msgstr "Faktor som tillämpas på densiteten vid kurvfördelning"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Discard points based on a mask texture after distribution"
msgstr "Kasta bort punkter utifrån en masktextur efter fördelningen"

#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Factor applied on the density for the viewport"
msgstr "Faktor som tillämpas på densiteten i 3D-vyporten"
