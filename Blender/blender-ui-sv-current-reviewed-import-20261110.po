#. :src: bpy.types.MovieTrackingTracks.active
msgid ""
"Active track in this tracking data object. Deprecated, use "
"objects[name].tracks.active"
msgstr ""
"Aktivt spår i detta spårningsdataobjekt. Föråldrat, använd "
"objects[name].tracks.active"

#. :src: bpy.types.COLLECTION_OT_importer_add.filter_glob
msgid "'Glob' file type extension(s), as defined by the selected file handler"
msgstr "Filändelser för ”Glob” enligt den valda filhanteraren"

#. :src: bpy.types.OUTLINER_OT_lib_operation.type:'RELOCATE'
msgid "Select a new path for this library, and reload all its data"
msgstr "Välj en ny sökväg för biblioteket och läs in på nytt alla dess data"

#: scripts/startup/bl_ui/space_userpref.py:144
msgctxt "Operator"
msgid "Load Factory Blender Preferences"
msgstr "Läs in Blenders fabriksinställningar"

#: source/blender/bmesh/operators/bmo_bridge.cc:594
msgid "Select at least two edge loops"
msgstr "Välj minst två kantslingor"

#: source/blender/bmesh/operators/bmo_fill_grid.cc:608
msgid ""
"Select two edge loops or a single closed edge loop from which two edge loops"
" can be calculated"
msgstr ""
"Välj två kantslingor eller en enda sluten kantslinga från vilken två "
"kantslingor kan beräknas"

#: source/blender/bmesh/operators/bmo_fill_grid.cc:669
msgid "Connecting edge loops overlap"
msgstr "Anslutna kantslingor överlappar varandra"

#: source/blender/bmesh/operators/bmo_subdivide_edgering.cc:1177
msgid "Edge-ring pair isn't connected"
msgstr "Kantringsparet är inte anslutet"

#: source/blender/draw/engines/eevee/eevee_instance.cc:784
msgid "Loading textures ({} remaining)"
msgstr "Läser in texturer ({} kvar)"

#: source/blender/editors/animation/anim_channels_defines.cc:5867
msgid "Grease Pencil layer is visible in the viewport"
msgstr "Grease Pencil-lagret är synligt i vyporten"

#: source/blender/nodes/composite/nodes/node_composite_lens_distortion.cc:79
msgid ""
"Introduces jitter while doing distortion, which can be faster but can "
"produce grainy or noisy results"
msgstr ""
"Introducerar jitter vid förvrängning, vilket kan vara snabbare men kan ge "
"korniga eller brusiga resultat"

#: source/blender/nodes/composite/nodes/node_composite_rgb_curves.cc:30
msgid "Image/Color input on which RGB color transformation will be applied"
msgstr "Indatabild eller indatafärg som RGB-färgtransformering tillämpas på"

#: source/blender/nodes/composite/nodes/node_composite_strip_info.cc:84
msgid "The Strip Info node is only supported for sequencer compositing"
msgstr "Strip Info-noden stöds endast för kompositering i sekvensredigeraren"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:36
msgid ""
"Returns the position and speed of the marker at the current scene frame "
"relative to the zero origin of the tracking space"
msgstr ""
"Ger markörens position och hastighet vid den aktuella bildrutan i scenen "
"relativt spårningsrymdens nollpunkt"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:42
msgid ""
"Returns the position and speed of the marker at the current scene frame "
"relative to the position of the first non-disabled marker in the track"
msgstr ""
"Ger markörens position och hastighet vid den aktuella bildrutan i scenen "
"relativt positionen för den första icke-inaktiverade markören i spåret"

#: source/blender/nodes/composite/nodes/node_composite_track_position.cc:48
msgid ""
"Returns the position and speed of the marker at the current scene frame "
"relative to the position of the marker at the current scene frame plus the "
"user given relative frame"
msgstr ""
"Ger markörens position och hastighet vid den aktuella bildrutan i scenen "
"relativt markörens position vid den aktuella bildrutan i scenen plus "
"användarens angivna relativa bildruta"

#: source/blender/nodes/geometry/nodes/node_geo_gizmo_dial.cc:24
msgid ""
"If true, the gizmo is displayed in screen space. Otherwise it's in object "
"space"
msgstr "Om sant visas gizmon i skärmrymden. Annars visas den i objektrymden"

