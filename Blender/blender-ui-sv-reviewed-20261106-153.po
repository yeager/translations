#. :src: bpy.types.AnimData.action_slot
#. :src: bpy.types.ActionConstraint.action_slot
#. :src: bpy.types.NlaStrip.action_slot
msgid "Action Slot"
msgstr "Åtgärdsslot"

#. :src: bpy.types.AnimData.action_slot
msgid ""
"The slot identifies which sub-set of the Action is considered to be for this "
"data-block, and its name is used to find the right slot when assigning an "
"Action"
msgstr ""
"Åtgärdsslotten anger vilken delmängd av åtgärden som hör till det här "
"datablocket, och dess namn används för att hitta rätt åtgärdsslot när en "
"åtgärd tilldelas"

#. :src: bpy.types.AnimData.action_slot_handle
#. :src: bpy.types.ActionConstraint.action_slot_handle
#. :src: bpy.types.NlaStrip.action_slot_handle
msgid "Action Slot Handle"
msgstr "Handtag för åtgärdsslot"

#. :src: bpy.types.AnimData.action_suitable_slots
#. :src: bpy.types.Action.slots
msgid "Slots"
msgstr "Åtgärdsslotar"

#. :src: bpy.types.AnimData.action_suitable_slots
msgid "The list of slots in this animation data-block"
msgstr "Listan över åtgärdsslotar i det här animeringsdatablocket"

#. :src: bpy.types.AnimViz.motion_path
msgid "Motion Path settings for visualization"
msgstr "Inställningar för rörelsebanor vid visualisering"

#. :src: bpy.types.AnimVizMotionPaths
msgid "Motion Path Settings"
msgstr "Inställningar för rörelsebanor"
