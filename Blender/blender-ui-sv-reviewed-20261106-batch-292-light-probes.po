#. :src: bpy.types.LightProbe
msgid "Light Probe data-block for lighting capture objects"
msgstr "Ljussonddatablock för objekt som fångar belysning"

#. :src: bpy.types.LightProbe.clip_start
msgid "Probe clip start, below which objects will not appear in reflections"
msgstr "Sondens klippstart, under vilken objekt inte visas i reflektioner"

#. :src: bpy.types.LightProbe.data_display_size
msgid "Display Data Size"
msgstr "Storlek på visningsdata"

#. :src: bpy.types.LightProbe.data_display_size
msgid "Viewport display size of the sampled data"
msgstr "Storlek i 3D-vyn för samplade data"

#. :src: bpy.types.LightProbe.influence_distance
msgid "Influence Distance"
msgstr "Påverkansavstånd"

#. :src: bpy.types.LightProbe.influence_distance
msgid "Influence distance of the probe"
msgstr "Sondens påverkansavstånd"

#. :src: bpy.types.LightProbeSphere.clip_end
msgid "Probe clip end, beyond which objects will not appear in reflections"
msgstr "Sondens klippslut, bortom vilket objekt inte visas i reflektioner"

#. :src: bpy.types.LightProbeSphere.falloff
msgid "Control how fast the probe influence decreases"
msgstr "Styr hur snabbt sondens påverkan minskar"

#. :src: bpy.types.LightProbeVolume.bake_samples
msgid "Bake Samples"
msgstr "Bakningsprov"

#. :src: bpy.types.LightProbeVolume.capture_distance
msgid "Capture Distance"
msgstr "Fångstavstånd"

#. :src: bpy.types.LightProbeVolume.capture_emission
msgid "Capture Emission"
msgstr "Fånga emission"

#. :src: bpy.types.LightProbeVolume.capture_indirect
msgid "Capture Indirect"
msgstr "Fånga indirekt ljus"

#. :src: bpy.types.LightProbeVolume.capture_indirect
msgid "Bake light bounces from light sources for more accurate lighting"
msgstr "Baka ljusstudsar från ljuskällor för mer exakt belysning"

#. :src: bpy.types.LightProbeVolume.capture_world
msgid "Capture World"
msgstr "Fånga omvärldsljus"

#. :src: bpy.types.LightProbeVolume.clamp_direct
#. :src: bpy.types.CyclesRenderSettings.sample_clamp_direct
msgid "Clamp Direct"
msgstr "Begränsa direktljus"

#. :src: bpy.types.LightProbeVolume.clamp_direct
msgid "Clamp the direct lighting intensity to reduce noise (0 to disable)"
msgstr ""
"Begränsa direktljusets intensitet för att minska brus (0 för att inaktivera)"

#. :src: bpy.types.LightProbeVolume.clamp_indirect
#. :src: bpy.types.CyclesRenderSettings.sample_clamp_indirect
msgid "Clamp Indirect"
msgstr "Begränsa indirekt ljus"

#. :src: bpy.types.LightProbeVolume.clamp_indirect
msgid "Clamp the indirect lighting intensity to reduce noise (0 to disable)"
msgstr ""
"Begränsa det indirekta ljusets intensitet för att minska brus (0 för att "
"inaktivera)"

#. :src: bpy.types.LightProbeVolume.escape_bias
msgid ""
"Distance to search for valid capture positions to prevent lighting artifacts"
msgstr ""
"Avstånd för att söka efter giltiga fångstpositioner och undvika "
"ljusartefakter"

#. :src: bpy.types.LightProbeVolume.validity_threshold
msgid "Validity Threshold"
msgstr "Giltighetströskel"
