#. :src: bpy.types.Float2AttributeValue
msgid "Float2 Attribute Value"
msgstr "2D-flyttalsattributvärde"

#. :src: bpy.types.Float2AttributeValue
msgid "2D Vector value in geometry attribute"
msgstr "2D-vektorvärde i geometriattribut"

#. :src: bpy.types.Float4x4AttributeValue
msgid "Matrix Attribute Value"
msgstr "Matrisattributvärde"

#. :src: bpy.types.FloatAttributeValue
msgid "Float Attribute Value"
msgstr "Flyttalsattributvärde"

#. :src: bpy.types.FloatColorAttributeValue
msgid "Float Color Attribute Value"
msgstr "Flyttalsfärgattributvärde"

#. :src: bpy.types.FloatVectorAttributeValue
msgid "Float Vector Attribute Value"
msgstr "Flyttalsvektorattributvärde"

#. :src: bpy.types.FloatVectorValueReadOnly
msgid "Read-Only Vector"
msgstr "Skrivskyddad vektor"

#. :src: bpy.types.FluidDomainSettings.adapt_margin
msgid "Margin added around fluid to minimize boundary interference"
msgstr "Marginal runt vätskan för att minimera påverkan från gränserna"

#. :src: bpy.types.FluidDomainSettings.alpha
msgid ""
"Buoyant force based on smoke density (higher value results in faster rising "
"smoke)"
msgstr ""
"Flytkraft som baseras på rökdensitet (högre värde ger rök som stiger "
"snabbare)"

#. :src: bpy.types.FluidDomainSettings.beta
msgid ""
"Buoyant force based on smoke heat (higher value results in faster rising "
"smoke)"
msgstr ""
"Flytkraft som baseras på rökvärme (högre värde ger rök som stiger snabbare)"

#. :src: bpy.types.FluidDomainSettings.cache_frame_end
msgid "Frame on which the simulation stops (last frame baked)"
msgstr "Bildruta där simuleringen avslutas (senaste bakade bildrutan)"

#. :src: bpy.types.FluidDomainSettings.cache_frame_start
msgid "Frame on which the simulation starts (first frame baked)"
msgstr "Bildruta där simuleringen startar (första bakade bildrutan)"

#. :src: bpy.types.FluidDomainSettings.cache_noise_format
msgid "Select the file format to be used for caching noise data"
msgstr "Välj det filformat som ska användas för cachelagring av brusdata"

#. :src: bpy.types.FluidDomainSettings.cache_type
msgid "Change the cache type of the simulation"
msgstr "Ändra simuleringens cachetyp"

#. :src: bpy.types.FluidDomainSettings.color_ramp_field
msgid "Simulation field to color map"
msgstr "Simuleringsfält som färgkartläggs"

#. :src: bpy.types.FluidDomainSettings.color_ramp_field_scale
msgid "Multiplier for scaling the selected field to color map"
msgstr "Multiplikator som skalar det valda fältet till färgkartan"

#. :src: bpy.types.FluidDomainSettings.density_grid
msgid "Smoke density grid"
msgstr "Rökdensitetsrutnät"

#. :src: bpy.types.FluidDomainSettings.display_interpolation
msgid "Interpolation method to use for smoke/fire volumes in solid mode"
msgstr "Interpolationsmetod för rök- och eldvolymer i solid-läge"

#. :src: bpy.types.FluidDomainSettings.display_thickness
msgid "Thickness of smoke display in the viewport"
msgstr "Tjocklek på rökvisningen i vyporten"
