#. :src: bpy.types.FileAssetSelectParams
msgid "Asset Select Parameters"
msgstr "Parametrar för resursval"

#. :src: bpy.types.FileAssetSelectParams
msgid "Settings for the file selection in Asset Browser mode"
msgstr "Inställningar för filval i resursbläddrarläget"

#. :src: bpy.types.FileAssetSelectParams.catalog_id
msgid "The UUID of the catalog shown in the browser"
msgstr "UUID för katalogen som visas i resursbläddraren"

#. :src: bpy.types.FileAssetSelectParams.filter_asset_id
msgid "Filter Asset Types"
msgstr "Filtrera resurstyper"

#. :src: bpy.types.FileAssetSelectParams.import_method:'FOLLOW_PREFS'
msgid "Follow Preferences"
msgstr "Följ inställningarna"

#. :src: bpy.types.FileAssetSelectParams.import_method:'FOLLOW_PREFS'
msgid ""
"Use the import method set in the Preferences for this asset library, don't "
"override it for this Asset Browser"
msgstr ""
"Använd den importmetod som angetts i inställningarna för det här "
"resursbiblioteket; åsidosätt den inte för den här resursbläddraren"

#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND'
#. :src: bpy.types.SEQUENCER_OT_strip_modifier_copy.type:'APPEND'
#. :src: bpy.types.UserAssetLibrary.import_method:'APPEND'
msgid "Append"
msgstr "Lägg till"

#. :src: bpy.types.FileAssetSelectParams.import_method:'APPEND_REUSE'
#. :src: bpy.types.UserAssetLibrary.import_method:'APPEND_REUSE'
msgid "Append (Reuse Data)"
msgstr "Lägg till (återanvänd data)"

#. :src: bpy.types.FileAssetSelectParams.instance_collections_on_append
msgid "Instance Collections on Appending"
msgstr "Instanssamlingar vid tillägg"

#. :src: bpy.types.FileAssetSelectParams.instance_collections_on_append
msgid ""
"Create instances for collections when appending, rather than adding them "
"directly to the scene"
msgstr ""
"Skapa instanser av samlingar vid tillägg i stället för att lägga till dem "
"direkt i scenen"

#. :src: bpy.types.FileAssetSelectParams.instance_collections_on_link
msgid "Instance Collections on Linking"
msgstr "Instanssamlingar vid länkning"
