#. :src: bpy.types.ArrayModifier.end_cap
msgid "Mesh object to use as an end cap"
msgstr "Meshobjekt som ska användas som ändlock"

#. :src: bpy.types.ArrayModifier.start_cap
msgid "Mesh object to use as a start cap"
msgstr "Meshobjekt som ska användas som startlock"

#. :src: bpy.types.BooleanModifier.object
msgid "Mesh object to use for Boolean operation"
msgstr "Meshobjekt som ska användas för boolesk operation"

#. :src: bpy.types.MeshDeformModifier.object
#. :src: bpy.types.SurfaceDeformModifier.target
msgid "Mesh object to deform with"
msgstr "Meshobjekt att deformera med"

#. :src: Socket description from node group Scatter on Surface, file geometry_nodes_essentials.blend
msgid "Mesh on whose faces to scatter on"
msgstr "Mesh vars ytor ska användas för spridning"

msgid ""
"Online access required to install or update. Launch Blender without --"
"offline-mode"
msgstr ""
"Nätåtkomst krävs för installation eller uppdatering. Starta Blender utan --"
"offline-mode"

msgid ""
"Online access required to install or update. Enable online access in System "
"preferences"
msgstr ""
"Nätåtkomst krävs för installation eller uppdatering. Aktivera nätåtkomst i "
"systeminställningarna"

msgid "Online access required to install or update."
msgstr "Nätåtkomst krävs för installation eller uppdatering."

msgid "Please enable Online Access from the System settings."
msgstr "Aktivera nätåtkomst i systeminställningarna."

msgid "Online access required to check for updates."
msgstr "Nätåtkomst krävs för att söka efter uppdateringar."

msgid "Online access required to install updates."
msgstr "Nätåtkomst krävs för att installera uppdateringar."

msgid "Enable online access in System preferences"
msgstr "Aktivera nätåtkomst i systeminställningarna"

msgid "Online directory of free and open source extensions"
msgstr "Katalog på nätet med fria tillägg med öppen källkod"

msgid ""
"Internet access disabled, only showing assets that are available offline."
msgstr "Nätåtkomst är inaktiverad. Visar endast resurser som finns lokalt."

msgid "No items. Note: The \"Only Online\" filter option is enabled."
msgstr "Inga objekt. Obs: filteralternativet ”Endast på nätet” är aktiverat."

msgid "No assets found."
msgstr "Inga resurser hittades."

msgid ""
"Only assets from the current file or asset system files (.asset.blend) can "
"be moved between catalogs"
msgstr ""
"Endast resurser från den aktuella filen eller resurssystemfiler "
"(.asset.blend) kan flyttas mellan kataloger"

msgid "Asset Catalogs"
msgstr "Resurskataloger"

msgid "No selected asset."
msgstr "Ingen markerad resurs."

msgid "Asset is local to this file and can be renamed directly."
msgstr "Resursen är lokal i den här filen och kan byta namn direkt."

msgid "Asset cannot be modified from this file."
msgstr "Resursen kan inte ändras från den här filen."

#. :src: bpy.types.WM_OT_usd_import.read_mesh_attributes
msgid "Mesh Attributes"
msgstr "Meshattribut"

#. :src: bpy.types.Sculpt.detail_type_method:'RELATIVE'
msgid "Mesh detail is relative to the brush size and detail size"
msgstr "Meshdetaljer är relativa till penselstorlek och detaljstorlek"

#. :src: bpy.types.RenderSettings.use_simplify_normals
msgid "Mesh Normals"
msgstr "Meshnormaler"

msgid "Mesh has no VCol data"
msgstr "Meshen saknar VCol-data"

msgid "Mesh should be unwrapped before multires data baking"
msgstr "Meshen bör vecklas ut innan multires-data beräknas"

msgid "Mesh does not have an active color attribute \"%s\""
msgstr "Meshen saknar det aktiva färgattributet ”%s”"

msgid "Mesh too large; more detail on the console"
msgstr "Meshen är för stor; mer information finns i konsolen"

#. :src: bpy.types.AnimData.action_tweak_storage
msgid "Tweak Mode Action Storage"
msgstr "Lagring av Action i justeringsläge"

#. :src: bpy.types.AnimData.action_tweak_storage
msgid "Storage to temporarily hold the main action while in tweak mode"
msgstr "Lagring för att tillfälligt behålla huvud-Actionen i justeringsläge"

#. :src: bpy.types.AnimVizMotionPaths.show_keyframe_action_all
msgid "All Action Keyframes"
msgstr "Alla Action-nyckelbildrutor"

#. :src: bpy.types.Area.type:'NLA_EDITOR'
msgid "Combine and layer Actions"
msgstr "Kombinera och lägg Actioner i lager"

#. :src: bpy.types.Action.is_action_layered
msgid "Is Layered Action"
msgstr "Är skiktad Action"

#. :src: bpy.types.Action.is_action_legacy
msgid "Is Legacy Action"
msgstr "Är äldre Action"

#. :src: bpy.types.Action.is_empty
msgid "False when there is any Layer, Slot, or legacy F-Curve"
msgstr "Falskt om det finns ett lager, en Action-slot eller en äldre F-kurva"

#. :src: bpy.types.Action.layers
msgid "The list of layers that make up this Action"
msgstr "Listan över lager som utgör den här Actionen"

#. :src: bpy.types.Action.slots
msgid "The list of slots in this Action"
msgstr "Listan över Action-slotar i den här Actionen"

#. :src: bpy.types.Action.use_cyclic
msgid ""
"The action is intended to be used as a cycle looping over its manually set "
"playback frame range (enabling this does not automatically make it loop)"
msgstr ""
"Actionen är avsedd att upprepas i en slinga över det manuellt angivna "
"bildruteintervallet för uppspelning. Aktivering gör inte automatiskt att den "
"upprepas i en slinga"

#. :src: bpy.types.NlaStrip
msgid "A container referencing an existing Action"
msgstr "En behållare som refererar till en befintlig Action"

#. :src: bpy.types.NlaStrip.strip_time
msgid "Frame of referenced Action to evaluate"
msgstr "Bildruta i den refererade Actionen som ska utvärderas"

#. :src: bpy.types.PARTICLE_OT_weight_set.factor
msgid "Interpolation factor between current brush weight, and keys' weights"
msgstr "Interpolationsfaktor mellan aktuell penselvikt och tangenternas vikt"

#. :src: bpy.types.WM_OT_tool_set_by_brush_type.brush_type
msgid ""
"Brush type identifier for which the most appropriate tool will be looked up"
msgstr ""
"Identifierare för penseltyp som används för att hitta det lämpligaste "
"verktyget"

