#: source/blender/editors/space_info/info_stats.cc:844
msgid "Strokes"
msgstr "Streck"

#. :src: bpy.types.BrushGpencilSettings.fill_layer_mode
msgid "Layers used as boundaries"
msgstr "Lager som används som gränser"

#. :src: bpy.types.BrushGpencilSettings.input_samples
msgid ""
"Generated intermediate points for very fast mouse movements (Set to 0 to "
"disable)"
msgstr ""
"Genererade mellanpunkter för mycket snabba musrörelser (ställ in på 0 för "
"att inaktivera)"

#. :src: bpy.types.BrushGpencilSettings.material_alt
msgid "Material used for secondary uses for this brush"
msgstr "Material som används för sekundära användningsområden för denna pensel"

#. :src: bpy.types.BrushGpencilSettings.pen_smooth_factor
msgid ""
"Amount of smoothing to apply after finish newly created strokes, to reduce "
"jitter/noise"
msgstr ""
"Utjämningsgrad som ska tillämpas efter att nya streck har skapats för att "
"minska slumpning och brus"

#. :src: bpy.types.BrushGpencilSettings.pin_draw_mode
msgid "Pin Mode"
msgstr "Fästläge"

#. :src: bpy.types.ByteIntAttributeValue
msgid "8-bit Integer Attribute Value"
msgstr "8-bitars heltalsattributvärde"

#. :src: bpy.types.CameraBackgroundImage.image_user
#. :src: bpy.types.Object.image_user
#. :src: bpy.types.ImageTexture.image_user
#. :src: bpy.types.ImageUser
#. :src: bpy.types.ShaderNodeTexEnvironment.image_user
#. :src: bpy.types.ShaderNodeTexImage.image_user
#. :src: bpy.types.TextureNodeImage.image_user
#. :src: bpy.types.SpaceImageEditor.image_user
msgid "Image User"
msgstr "Bildanvändare"

#. :src: bpy.types.CameraBackgroundImage.image_user
#. :src: bpy.types.Object.image_user
#. :src: bpy.types.ImageTexture.image_user
#. :src: bpy.types.ShaderNodeTexEnvironment.image_user
#. :src: bpy.types.ShaderNodeTexImage.image_user
#. :src: bpy.types.SpaceImageEditor.image_user
msgid ""
"Parameters defining which layer, pass and frame of the image is displayed"
msgstr ""
"Parametrar som definierar vilket lager, pass och bildruta i bilden som visas"

#. :src: bpy.types.CameraBackgroundImage.is_override_data
msgid "Override Background Image"
msgstr "Åsidosätt bakgrundsbild"

#. :src: bpy.types.CameraBackgroundImage.is_override_data
msgid ""
"In a local override camera, whether this background image comes from the "
"linked reference camera, or is local to the override"
msgstr ""
"I en kamera med lokal biblioteksåsidosättning anger detta om bakgrundsbilden "
"kommer från den länkade referenskameran eller är lokal för åsidosättningen"

#. :src: bpy.types.CollectionChild
msgid "Child collection with its collection related settings"
msgstr "Underordnad samling med sina samlingsrelaterade inställningar"
