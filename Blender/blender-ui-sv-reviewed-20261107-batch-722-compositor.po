#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality
msgid "Compositor Final Denoise Quality"
msgstr "Kompositörens slutliga brusreduceringskvalitet"

#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality
msgid "Compositor Preview Denoise Quality"
msgstr "Kompositörens brusreduceringskvalitet för förhandsgranskning"

#. :src: bpy.types.RenderSettings.compositor_precision
msgid "Compositor Precision"
msgstr "Kompositörprecision"

#. :src: bpy.types.RenderSettings.compositor_precision
msgid "The precision of compositor intermediate result"
msgstr "Precisionen för kompositörens mellanresultat"

#. :src: bpy.types.RenderSettings.compositor_precache
msgid "Cache the result of the interactive compositor across frames"
msgstr "Cachelagra resultatet från den interaktiva kompositören mellan bildrutor"

#. :src: bpy.types.SceneCompositorEffect
msgid "Compositor effect for scene"
msgstr "Kompositöreffekt för scen"

#: source/blender/editors/space_node/node_edit.cc:1225
msgid "Asset is not a compositor node group"
msgstr "Resursen är inte en kompositionsnodgrupp"

#: source/blender/compositor/intern/COM_context.cc:314
msgid "Render size too large for GPU, use CPU compositor instead"
msgstr "Renderingsstorleken är för stor för GPU:n. Använd CPU-kompositören i stället"

#. :src: bpy.types.NODE_OT_edit_compositor_node_group
msgid "Edit compositor node group for the active scene compositor effect"
msgstr "Redigera kompositionsnodgruppen för den aktiva scenens kompositöreffekt"
