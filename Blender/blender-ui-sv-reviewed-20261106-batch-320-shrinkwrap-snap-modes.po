#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode
#. :src: bpy.types.NODE_OT_nw_batch_change.operation:'SNAP'
#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'SNAP'
#: scripts/startup/bl_ui/properties_constraint.py:701
msgid "Snap Mode"
msgstr "Fästläge"

#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode
msgid "Select how to constrain the object to the target surface"
msgstr "Välj hur objektet ska begränsas till målytan"

#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'ON_SURFACE'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'ON_SURFACE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'ON_SURFACE'
msgid ""
"The point is constrained to the surface of the target object, with distance "
"offset towards the original point location"
msgstr ""
"Punkten begränsas till ytan på målobjektet, med avståndsförskjutning mot den "
"ursprungliga punktpositionen"

#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'INSIDE'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'INSIDE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'INSIDE'
msgid "The point is constrained to be inside the target object"
msgstr "Punkten begränsas till att vara inuti målobjektet"

#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'OUTSIDE'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'OUTSIDE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'OUTSIDE'
msgid "The point is constrained to be outside the target object"
msgstr "Punkten begränsas till att vara utanför målobjektet"

#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'OUTSIDE_SURFACE'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'OUTSIDE_SURFACE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'OUTSIDE_SURFACE'
msgid "Outside Surface"
msgstr "Utanför ytan"

#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'OUTSIDE_SURFACE'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'OUTSIDE_SURFACE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'OUTSIDE_SURFACE'
msgid ""
"The point is constrained to the surface of the target object, with distance "
"offset always to the outside, towards or away from the original location"
msgstr ""
"Punkten begränsas till ytan på målobjektet, med avståndsförskjutning alltid "
"utåt, mot eller bort från den ursprungliga positionen"

#. :src: bpy.types.ShrinkwrapConstraint.wrap_mode:'ABOVE_SURFACE'
#. :src: bpy.types.GreasePencilShrinkwrapModifier.wrap_mode:'ABOVE_SURFACE'
#. :src: bpy.types.ShrinkwrapModifier.wrap_mode:'ABOVE_SURFACE'
msgid ""
"The point is constrained to the surface of the target object, with distance "
"offset applied exactly along the target normal"
msgstr ""
"Punkten begränsas till ytan på målobjektet, med avståndsförskjutning som "
"tillämpas exakt längs målets normal"
