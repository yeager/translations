#: scripts/startup/bl_operators/wm.py:1915
msgid "Cannot edit properties from override data"
msgstr "Det går inte att redigera egenskaper från åsidosättningsdata"

#: scripts/startup/bl_operators/wm.py:1966
msgid "Properties from override data cannot be edited"
msgstr "Egenskaper från åsidosättningsdata kan inte redigeras"

#: scripts/startup/bl_operators/wm.py:2180
msgid "Cannot add properties to override data"
msgstr "Det går inte att lägga till egenskaper i åsidosättningsdata"

#: scripts/startup/bl_operators/wm.py:2236
msgid "Cannot remove properties from override data"
msgstr "Det går inte att ta bort egenskaper från åsidosättningsdata"
