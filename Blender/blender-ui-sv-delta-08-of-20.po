msgid "Distribute vertices at constant distances along the loop"
msgstr "Fördela hörnen med konstant avstånd längs slingan"

msgid "Algorithm used for interpolation"
msgstr "Algoritm som används för interpolering"

msgid "Natural cubic spline, smooth results"
msgstr "Naturlig kubisk spline, ger mjuka resultat"

msgid "Relax edge loops using linear interpolation"
msgstr "Jämna ut kantslingor med linjär interpolering"

msgid "Number of times the loop is relaxed"
msgstr "Antal gånger slingan jämnas ut"

msgctxt "Operator"
msgid "Multi Select Boundary Loops"
msgstr "Välj flera gränsloopar"

msgid "Select entire boundary loop of each selected boundary edge"
msgstr "Markera hela gränsslingan för varje markerad gränskant"

msgctxt "Operator"
msgid "Select Faces by Sides"
msgstr "Välj ytor efter sidor"

msgid "Vertex selection mode"
msgstr "Hörnvalsläge"

msgid "Multiple Faces"
msgstr "Flera ytor"

msgctxt "Mesh"
msgid "Vertex Crease"
msgstr "Hörnveck"

msgctxt "Operator"
msgid "Space Edge Loops Evenly"
msgstr "Fördela kantslingor jämnt"

msgid "Space the vertices in a regular distribution on the loop"
msgstr "Fördela hörnen regelbundet på slingan"

msgid "Spacing effect factor"
msgstr "Faktor för fördelningseffekt"

msgid "Vertices are projected on existing edges"
msgstr "Hörn projiceras på befintliga kanter"

msgid "Use topology to find mirrored vertices instead of spatial proximity"
msgstr ""
"Använd topologin för att hitta speglade hörn i stället för rumslig närhet"

msgid ""
"Add an Action-Clip strip (i.e. an NLA Strip referencing an Action) to the "
"active track"
msgstr ""
"Lägg till en åtgärdsklippremsa (dvs. en NLA-remsa som refererar till en "
"åtgärd) till det aktiva spåret."

msgid "All Panel Contents"
msgstr "Allt panelinnehåll"

msgid ""
"Include sockets in all selected panels, even if they have a panel toggle"
msgstr "Ta med uttag i alla markerade paneler, även om de har en panelväxlare"

msgid "Only Selected Sockets"
msgstr "Endast valda uttag"

msgid "Include only selected sockets/panels in the added group input node"
msgstr "Ta endast med markerade uttag/paneler i den tillagda gruppindatanoden"

msgid "Add a Combine Bundle node with a type input"
msgstr "Lägg till en Combine Bundle-nod med en typindata"

msgid "Zoom to mouse position"
msgstr "Zooma till muspositionen"

msgid "Init from Active"
msgstr "Initiera från aktiv"

msgid ""
"Instead of using the provided name or type, copy the state of the active "
"item"
msgstr ""
"Kopiera det aktiva objektets tillstånd i stället för att använda angivet "
"namn eller typ"

msgid "Item Name"
msgstr "Objektnamn"

msgid "Name of the new socket item"
msgstr "Namn på det nya uttagsobjektet"

msgid "Show Dialog"
msgstr "Visa dialogruta"

msgid "Show a dialog to edit the initial properties"
msgstr "Visa en dialogruta för att redigera de ursprungliga egenskaperna"

msgid "Type of the new socket item"
msgstr "Typ av nytt uttagsobjekt"

msgid "Index to remove"
msgstr "Index som ska tas bort"

msgid "Run in Geometry Nodes Editor"
msgstr "Kör i geometrinodsredigeraren"

msgid ""
"Create a new compositing node group and initialize it with default nodes. "
"Deprecated and will be removed in 6.0"
msgstr ""
"Skapa en ny kompositnodgrupp och initiera den med standardnoder. Föråldrad "
"och tas bort i 6.0."

msgid "From Node"
msgstr "Från nod"

msgid "Merge using Mesh Boolean or Join Geometry nodes"
msgstr "Sammanfoga med noderna Mesh Boolean eller Sammanfoga geometri"

msgctxt "NodeTree"
msgid "Exclusion"
msgstr "Uteslutning"

msgctxt "NodeTree"
msgid "Join Geometry"
msgstr "Sammanfoga geometri"

msgid "Join Geometry Mode"
msgstr "Sammanfogningsläge för geometri"

msgid "Swap existing node with a Combine Bundle node with a type input"
msgstr "Byt ut befintlig nod mot en Combine Bundle-nod med en typindata"

msgid "Export Faces"
msgstr "Exportera ytor"

msgid "Export faces as filled strokes"
msgstr "Exportera ytor som fyllda streck"

msgid "Grease Pencil from Curve or Mesh objects"
msgstr "Grease Pencil från kurv- eller nätobjekt"

msgid "Vertex Group(s)"
msgstr "Vertexgrupp(er)"

msgctxt "Operator"
msgid "Add Grease Pencil"
msgstr "Lägg till Grease Pencil"

msgctxt "Operator"
msgid "Join as Shapes"
msgstr "Sammanfoga som former"

msgid "Bind mesh to system in laplacian deform modifier"
msgstr "Bind nät till systemet i Laplace-deformeringsmodifieraren"

msgctxt "Operator"
msgid "Link Receiver Objects to Emitter"
msgstr "Länka mottagarobjekt till sändare"

msgid "Light link selected objects to the active emitter object"
msgstr "Ljuslänka valda objekt till det aktiva sändarobjektet"

msgid "Bake Line Art for current Grease Pencil object"
msgstr "Baka linjekonst för aktuellt Grease Pencil-objekt"

msgid "Copy Constraints"
msgstr "Kopiera begränsningar"

msgid "Replace Constraints"
msgstr "Ersätt begränsningar"

msgid "Copy Grease Pencil Effects"
msgstr "Kopiera Grease Pencil-effekter"

msgid "Replace Grease Pencil Effects"
msgstr "Ersätt Grease Pencil-effekter"

msgid "Copy Light Linking"
msgstr "Kopiera ljuslänkning"

msgid "Replace assigned Light Linking collection"
msgstr "Ersätt tilldelad samling för ljuslänkning"

msgid "Copy Shadow Linking"
msgstr "Kopiera skugglänkning"

msgid "Replace assigned Shadow Linking collection"
msgstr "Ersätt tilldelad Shadow Linking-samling"

msgid "Assign active material slot to selection"
msgstr "Tilldela aktiv materialplats till valet"

msgid "Deselect by active material slot"
msgstr "Avmarkera efter aktiv materialplats"

msgid "Remove the selected material slot"
msgstr "Ta bort den valda materialplatsen"

msgid "Select by active material slot"
msgstr "Välj efter aktiv materialplats"

msgid "Current Transform"
msgstr "Aktuell omvandling"

msgid "Number of Faces"
msgstr "Antal ytor"

msgctxt "Operator"
msgid "Remove Grease Pencil Effect"
msgstr "Ta bort Grease Pencil-effekt"

msgid "Create a new shape key from the visual result of existing mix of keys"
msgstr ""
"Skapa en ny formnyckel från det visuella resultatet av den befintliga "
"blandningen av nycklar"

msgid ""
"Make the active shape key the new basis key, effectively applying it to the mesh.\n"
"Note that this applies the shape key at its 100% value"
msgstr ""
"Gör den aktiva formnyckeln till den nya basnyckeln, vilket tillämpar den på meshet.\n"
"Observera att formnyckeln tillämpas med värdet 100 %."

msgid "Mirror the active shape key along the local X axis"
msgstr "Spegla den aktuella formnyckeln längs den lokala X-axeln"

msgid "Remove selected shape keys from the object"
msgstr "Ta bort valda formnycklar från objektet"

msgid "Relative Face"
msgstr "Relativ yta"

msgctxt "Operator"
msgid "Look at Surface"
msgstr "Titta på yta"

msgid ""
"Interactively point cameras and lights to the surface under the pointer "
"(Ctrl to translate)"
msgstr ""
"Rikta kameror och ljus interaktivt mot ytan under pekaren (Ctrl för att "
"förflytta)"

msgid ""
"Update existing shape keys with the vertex positions of selected objects "
"with matching names"
msgstr ""
"Uppdatera befintliga formnycklar med hörnpositionerna för valda objekt med "
"matchande namn."

msgctxt "Operator"
msgid "Add Vertex Group"
msgstr "Lägg till vertexgrupp"

msgctxt "Operator"
msgid "Assign to Vertex Group"
msgstr "Tilldela till vertexgrupp"

msgid "Assign the selected vertices to the active vertex group"
msgstr "Tilldela de valda hörnen till den aktiva vertexgruppen"

msgid "Assign the selected vertices to a new vertex group"
msgstr "Tilldela de valda hörnen till en ny vertexgrupp"

msgctxt "Operator"
msgid "Clean Vertex Group Weights"
msgstr "Rensa vertexgruppsvikter"

msgid "Keep verts assigned to at least one group when cleaning"
msgstr "Behåll hörn som är tilldelade till minst en grupp vid rensning"

msgctxt "Operator"
msgid "Copy Vertex Group to Selected"
msgstr "Kopiera vertexgrupp till markerade"

msgctxt "Operator"
msgid "Deselect Vertex Group"
msgstr "Avmarkera vertexgrupp"

msgid "Deselect all selected vertices assigned to the active vertex group"
msgstr ""
"Avmarkera alla markerade hörn som tilldelats den aktiva vertexgruppen."

msgctxt "Operator"
msgid "Vertex Group Levels"
msgstr "Vertexgruppsnivåer"

msgctxt "Operator"
msgid "Limit Number of Weights per Vertex"
msgstr "Begränsa antalet vikter per hörn"

msgid ""
"Limit deform weights associated with a vertex to a specified number by "
"removing lowest weights"
msgstr ""
"Begränsa deformationsvikter som är kopplade till ett hörn till ett angivet "
"antal genom att ta bort de lägsta vikterna."

msgctxt "Operator"
msgid "Mirror Vertex Group"
msgstr "Spegla vertexgrupp"

msgid ""
"Mirror vertex group, flip weights and/or names, editing only selected "
"vertices, flipping when both sides are selected otherwise copy from "
"unselected"
msgstr ""
"Spegla vertexgrupp, vänd vikter och/eller namn, redigera endast valda hörn, "
"vänd när båda sidorna är valda, annars kopiera från ovalda."

msgid ""
"Normalize all weights of all vertex groups, so that for each vertex, the sum"
" of all weights is 1.0"
msgstr ""
"Normalisera alla vikter för alla vertexgrupper så att summan av alla vikter "
"för varje hörn blir 1,0."

msgctxt "Operator"
msgid "Remove from Vertex Group"
msgstr "Ta bort från vertexgrupp"

msgid "Remove the selected vertices from active or all vertex group(s)"
msgstr "Ta bort de valda hörnen från den aktiva eller alla vertexgrupper"

msgctxt "Operator"
msgid "Select Vertex Group"
msgstr "Markera vertexgrupp"

msgid "Select all the vertices assigned to the active vertex group"
msgstr "Markera alla hörn som tilldelats den aktiva vertexgruppen."

msgid "Vertex group to set as active"
msgstr "Vertexgrupp som ska anges som aktiv"

msgid "Parent selected objects to the selected vertices"
msgstr "Gör valda objekt underordnade de valda hörnen"

msgid "Hide unselected objects"
msgstr "Dölj ovalda objekt"

msgid "Embed data-blocks into the .blend file"
msgstr "Bädda in datablock i .blend-filen"

msgctxt "Operator"
msgid "Outliner Library Override Property Remove"
msgstr "Ta bort egenskap för Outliner-biblioteksöverskrivning"

msgid ""
"Remove the selected library override properties, and reset the relevant data"
" to the linked reference values"
msgstr ""
"Ta bort de markerade överskrivningsegenskaperna för biblioteket och "
"återställ berörda data till de länkade referensvärdena"

msgctxt "Operator"
msgid "Pack ID Data"
msgstr "Packa ID-data"

msgid "Embed selected data-blocks into the .blend file"
msgstr "Bädda in markerade datablock i .blend-filen"

msgid "Deselect Faces connected to existing selection"
msgstr "Avmarkera ytor som är kopplade till befintligt val"

msgid "If false, faces will be deselected"
msgstr "Om värdet är falskt avmarkeras ytor"

msgctxt "Operator"
msgid "Reveal Faces/Vertices"
msgstr "Visa ytor/hörn"

msgid "Affect only faces facing towards the view"
msgstr "Påverka endast ytor som är vända mot vyn"

msgctxt "Operator"
msgid "Vertex Paint"
msgstr "Hörnmålning"

msgctxt "Operator"
msgid "Vertex Paint Mode"
msgstr "Hörnmålningsläge"

msgid "Toggle the vertex paint mode in 3D view"
msgstr "Växla hörnmålningsläge i 3D-vyn"

msgid "Grow the visibility by one face based on mesh topology"
msgstr "Öka synligheten med en yta baserat på nätets topologi"

msgid ""
"Set the weights of the groups matching the attached armature's bones that "
"have \"Deform\" option enabled, using the distance between the vertices and "
"the bones"
msgstr ""
"Ange vikterna för grupper som motsvarar benen i den kopplade armaturen och "
"har alternativet \"Deform\" aktiverat, utifrån avståndet mellan hörnen och "
"benen."

msgctxt "Operator"
msgid "Join Palette Swatches"
msgstr "Sammanfoga palettprover"

msgid "Join Palette Swatches"
msgstr "Sammanfoga palettprover"

msgid "Access Token"
msgstr "Åtkomsttoken"

msgid "Personal authentication token, may be required by some asset libraries"
msgstr ""
"Personlig autentiseringstoken som kan krävas av vissa tillgångsbibliotek"

msgid "Remote URL to the asset library"
msgstr "Fjärr-URL till tillgångsbiblioteket"

msgid "The kind of asset library to add"
msgstr "Typ av tillgångsbibliotek som ska läggas till"

msgid "Add Remote Asset Library"
msgstr "Lägg till fjärrresursbibliotek"

msgid ""
"Add an asset library referencing a remote repository with support for "
"listing and updating asset libraries"
msgstr ""
"Lägg till ett resursbibliotek som refererar till en fjärrlagringsplats och "
"har stöd för att lista och uppdatera resursbibliotek."

msgid "Add Local Asset Library"
msgstr "Lägg till tillgångsbibliotek"

msgid ""
"Add an asset library managed via the file system without referencing an "
"external repository"
msgstr ""
"Lägg till ett tillgångsbibliotek som hanteras via filsystemet utan att "
"referera till ett externt arkiv"

msgid "Asset library requires an authentication token"
msgstr "Tillgångsbiblioteket kräver en autentiseringstoken"

msgid "String Variable"
msgstr "Strängvariabel"

msgid "Filepath Variable"
msgstr "Sökvägsvariabel"

msgid "Integer Variable"
msgstr "Heltalsvariabel"

msgid "Float Variable"
msgstr "Flyttalsvariabel"

msgid "Asset Library Directory"
msgstr "Katalog för tillgångsbibliotek"

msgid "Move Up"
msgstr "Flytta upp"

msgid "Move Down"
msgstr "Flytta nedåt"

msgid "Project Root"
msgstr "Projektrot"

msgid "Blend file path"
msgstr "Sökväg till blend-fil"

msgid "Filter blend files"
msgstr "Filtrera .blend-filer"

msgid "Bake all physics simulations in the current scene"
msgstr "Baka alla fysiksimuleringar i den aktuella scenen"

msgctxt "Operator"
msgid "Clear Texture Cache"
msgstr "Rensa texturcache"

msgid "Delete Cycles texture cache files from disk"
msgstr "Ta bort Cycles texturcachefiler från disken"

msgctxt "Operator"
msgid "Generate Texture Cache"
msgstr "Generera texturcache"

msgid ""
"Generate Cycles texture cache files for all images used in shader nodes"
msgstr ""
"Generera Cycles texturcachefiler för alla bilder som används i shadernoder"

msgid "Image Sequences"
msgstr "Bildsekvenser"

msgid "Generate texture cache files for all frames of image sequences"
msgstr "Generera texturcachefiler för alla bildrutor i bildsekvenser"

msgid "Flip X and Y resolutions"
msgstr "Vänd X- och Y-upplösning"

msgid "Name of the effect to duplicate. If empty duplicate the active effect"
msgstr ""
"Namnet på effekten som ska dupliceras. Om det lämnas tomt dupliceras den "
"aktiva effekten"

msgid "Name of the effect to edit"
msgstr "Namnet på effekten som ska redigeras"

msgid "Name of the effect to remove"
msgstr "Namnet på effekten som ska tas bort"

msgid "Name of the strip effect to edit"
msgstr "Namnet på remseffekten som ska redigeras"

msgctxt "Operator"
msgid "Pause Animation"
msgstr "Pausa animering"

msgid "Pause animation, stopping at the current frame"
msgstr "Pausa animeringen och stanna vid den aktuella bildrutan"

msgctxt "Operator"
msgid "Join Area"
msgstr "Sammanfoga område"

msgctxt "Operator"
msgid "Area Edge Options"
msgstr "Alternativ för områdeskant"

msgctxt "Operator"
msgid "Merge Area Edge"
msgstr "Sammanfoga områdeskant"

msgid "Merge aligned area edges"
msgstr "Sammanfoga inriktade områdeskanter"

msgctxt "Operator"
msgid "Open Project Setup..."
msgstr "Öppna projektinställningar…"

msgid "Create and manage projects"
msgstr "Skapa och hantera projekt"

msgid "Section to activate in Project Setup"
msgstr "Avsnitt som ska aktiveras i projektinställningar"

msgctxt "Operator"
msgid "Cycle Space Context"
msgstr "Växla utrymmeskontext"

msgctxt "Operator"
msgid "Cycle Space Type Set"
msgstr "Växla typ för utrymme"

msgid "Set the space type or cycle subtype"
msgstr "Ange utrymmestyp eller växla undertyp"

msgctxt "Operator"
msgid "Cycle Workspace"
msgstr "Växla arbetsyta"

msgid "Apply the filter only to the face set under the cursor"
msgstr "Tillämpa filtret endast på ansiktsuppsättningen under markören."

msgid "Immediate Apply"
msgstr "Tillämpa direkt"

msgid "Apply once without entering modal interaction"
msgstr "Tillämpa en gång utan att gå in i modal interaktion"

msgid "Use Secondary Color"
msgstr "Använd sekundärfärg"

msgid "Boundary Face Set"
msgstr "Ansiktsuppsättningsgräns"

msgid "Active Face Set"
msgstr "Aktiv ansiktsuppsättning"

msgid "Modify the active face set instead of creating a new one"
msgstr "Ändra den aktiva ansiktsuppsättningen i stället för att skapa en ny"

msgctxt "Operator"
msgid "Face Set Box Gesture"
msgstr "Rektangelgest för ansiktsuppsättning"

msgid "Add a face set in a rectangle defined by the cursor"
msgstr ""
"Lägg till en ansiktsuppsättning i en rektangel som definieras av markören"

msgctxt "Operator"
msgid "Face Sets Visibility"
msgstr "Synlighet för ansiktsuppsättningar"

msgid "Change the visibility of the face sets of the sculpt"
msgstr "Ändra synligheten för skulpturens ansiktsuppsättningar"

msgid "Show Active Face Set"
msgstr "Visa aktiv ansiktsuppsättning"

msgid "Hide the active face set"
msgstr "Dölj den aktiva ansiktsuppsättningen"

msgid "Edits the current active face set"
msgstr "Redigerar den aktuella aktiva ansiktsuppsättningen"
