#. :src: bpy.types.DynamicPaintBrushSettings.smooth_radius
msgid "Smooth falloff added after solid radius"
msgstr "Jämnt avtagande läggs till utanför den heltäckande radien"

#. :src: bpy.types.DynamicPaintBrushSettings.smudge_strength
msgid "Smudge Strength"
msgstr "Smetningsstyrka"

#. :src: bpy.types.DynamicPaintBrushSettings.smudge_strength
msgid "Smudge effect strength"
msgstr "Smetningseffektens styrka"

#. :src: bpy.types.DynamicPaintBrushSettings.solid_radius
msgid "Solid Radius"
msgstr "Heltäckande radie"

#. :src: bpy.types.DynamicPaintBrushSettings.solid_radius
msgid "Radius that will be painted solid"
msgstr "Radie som målas heltäckande"

#. :src: bpy.types.DynamicPaintBrushSettings.use_absolute_alpha
msgid "Absolute Alpha"
msgstr "Absolut alfa"

#. :src: bpy.types.DynamicPaintBrushSettings.use_absolute_alpha
msgid "Only increase alpha value if paint alpha is higher than existing"
msgstr ""
"Öka endast alfavärdet om målningsalfan är högre än det befintliga värdet"

#. :src: bpy.types.DynamicPaintBrushSettings.use_negative_volume
msgid "Negate Volume"
msgstr "Invertera volym"

#. :src: bpy.types.DynamicPaintBrushSettings.use_negative_volume
msgid "Negate influence inside the volume"
msgstr "Invertera påverkan inuti volymen"
