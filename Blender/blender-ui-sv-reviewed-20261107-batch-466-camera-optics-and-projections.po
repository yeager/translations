#. :src: bpy.types.Camera.central_cylindrical_range_v_min
msgid "Min Height"
msgstr "Minsta höjd"

#. :src: bpy.types.Camera.central_cylindrical_range_v_min
msgid "Minimum Height value for the central cylindrical lens"
msgstr "Minsta höjdvärde för den centrala cylindriska linsen"

#. :src: bpy.types.Camera.clip_end
#. :src: bpy.types.LightProbeSphere.clip_end
#. :src: bpy.types.SpaceView3D.clip_end
#. :src: bpy.types.XrSessionSettings.clip_end
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:21
msgid "Clip End"
msgstr "Beskärningsslut"

#. :src: bpy.types.Camera.clip_end
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:21
msgid "Camera far clipping distance"
msgstr "Kamerans bortre beskärningsavstånd"

#. :src: bpy.types.Camera.clip_start
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:20
msgid "Camera near clipping distance"
msgstr "Kamerans närmaste beskärningsavstånd"

#. :src: bpy.types.Camera.custom_bytecode
msgid "Custom Bytecode"
msgstr "Anpassad bytekod"

#. :src: bpy.types.Camera.custom_bytecode
msgid "Compiled bytecode of the custom shader"
msgstr "Kompilerad bytekod för den anpassade shadern"

#. :src: bpy.types.Camera.custom_bytecode_hash
msgid "Custom Bytecode Hash"
msgstr "Hash för anpassad bytekod"

#. :src: bpy.types.Camera.custom_bytecode_hash
msgid ""
"Hash of the compiled bytecode of the custom shader, for quick equality "
"checking"
msgstr ""
"Hash för den anpassade shaderns kompilerade bytekod, för snabb "
"likhetskontroll"

#. :src: bpy.types.Camera.custom_filepath
msgid "Custom File Path"
msgstr "Anpassad filsökväg"

#. :src: bpy.types.Camera.custom_filepath
msgid "Path to the shader defining the custom camera"
msgstr "Sökväg till den shader som definierar den anpassade kameran"

#. :src: bpy.types.Camera.custom_mode
msgid "Custom shader source"
msgstr "Anpassad shaderkälla"

#. :src: bpy.types.Camera.custom_mode:'EXTERNAL'
msgid "Use external file"
msgstr "Använd extern fil"

#. :src: bpy.types.Camera.custom_shader
msgid "Custom Shader"
msgstr "Anpassad shader"

#. :src: bpy.types.Camera.custom_shader
msgid "Shader defining the custom camera"
msgstr "Shader som definierar den anpassade kameran"

#. :src: bpy.types.Camera.cycles_custom
msgid "Cycles Custom Camera Settings"
msgstr "Anpassade kamerainställningar för Cycles"

#. :src: bpy.types.Camera.cycles_custom
msgid "Parameters for custom (OSL-based) Cameras"
msgstr "Parametrar för anpassade (OSL-baserade) kameror"

#. :src: bpy.types.Camera.display_size
msgid "Apparent size of the Camera object in the 3D View"
msgstr "Den synliga storleken på kameraobjektet i 3D-vyporten"

#. :src: bpy.types.Camera.fisheye_fov
msgid "Field of view for the fisheye lens"
msgstr "Synfält för fiskögeobjektivet"

#. :src: bpy.types.Camera.fisheye_lens
msgid "Fisheye Lens"
msgstr "Fiskögeobjektiv"

#. :src: bpy.types.Camera.fisheye_lens
msgid "Lens focal length (mm)"
msgstr "Objektivets brännvidd (mm)"

#. :src: bpy.types.Camera.fisheye_polynomial_k0
msgid "Fisheye Polynomial K0"
msgstr "Fiskögepolynom K0"

#. :src: bpy.types.Camera.fisheye_polynomial_k0
msgid "Coefficient K0 of the lens polynomial"
msgstr "Koefficient K0 för linsens polynom"

#. :src: bpy.types.Camera.fisheye_polynomial_k1
msgid "Fisheye Polynomial K1"
msgstr "Fiskögepolynom K1"

#. :src: bpy.types.Camera.fisheye_polynomial_k1
msgid "Coefficient K1 of the lens polynomial"
msgstr "Koefficient K1 för linsens polynom"

#. :src: bpy.types.Camera.fisheye_polynomial_k2
msgid "Fisheye Polynomial K2"
msgstr "Fiskögepolynom K2"

#. :src: bpy.types.Camera.fisheye_polynomial_k2
msgid "Coefficient K2 of the lens polynomial"
msgstr "Koefficient K2 för linsens polynom"

#. :src: bpy.types.Camera.fisheye_polynomial_k3
msgid "Fisheye Polynomial K3"
msgstr "Fiskögepolynom K3"

#. :src: bpy.types.Camera.fisheye_polynomial_k3
msgid "Coefficient K3 of the lens polynomial"
msgstr "Koefficient K3 för linsens polynom"

#. :src: bpy.types.Camera.fisheye_polynomial_k4
msgid "Fisheye Polynomial K4"
msgstr "Fiskögepolynom K4"

#. :src: bpy.types.Camera.fisheye_polynomial_k4
msgid "Coefficient K4 of the lens polynomial"
msgstr "Koefficient K4 för linsens polynom"

#. :src: bpy.types.Camera.latitude_max
msgid "Max Latitude"
msgstr "Största breddgrad"

#. :src: bpy.types.Camera.latitude_max
msgid "Maximum latitude (vertical angle) for the equirectangular lens"
msgstr ""
"Största breddgrad (vertikal vinkel) för det ekvirektangulära objektivet"

#. :src: bpy.types.Camera.latitude_min
msgid "Min Latitude"
msgstr "Minsta breddgrad"

#. :src: bpy.types.Camera.latitude_min
msgid "Minimum latitude (vertical angle) for the equirectangular lens"
msgstr "Minsta breddgrad (vertikal vinkel) för det ekvirektangulära objektivet"

#. :src: bpy.types.Camera.lens
#. :src: bpy.types.MovieTrackingCamera.focal_length
#. :src: bpy.types.MovieTrackingCamera.focal_length_pixels
#: scripts/startup/bl_ui/space_clip.py:572
#: scripts/startup/bl_ui/space_view3d.py:6302
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:17
msgid "Focal Length"
msgstr "Brännvidd"

#. :src: bpy.types.Camera.lens
msgid "Perspective Camera focal length value in millimeters"
msgstr "Perspektivkamerans brännvidd i millimeter"

#. :src: bpy.types.Camera.lens_unit
msgid "Lens Unit"
msgstr "Objektivenhet"

#. :src: bpy.types.Camera.lens_unit
msgid "Unit to edit lens in for the user interface"
msgstr "Enhet som används för att redigera objektivet i användargränssnittet"

#. :src: bpy.types.Camera.lens_unit:'MILLIMETERS'
msgid "Specify focal length of the lens in millimeters"
msgstr "Ange objektivets brännvidd i millimeter"

#. :src: bpy.types.Camera.lens_unit:'FOV'
msgid "Specify the lens as the field of view's angle"
msgstr "Ange objektivet utifrån synfältets vinkel"

#. :src: bpy.types.Camera.longitude_max
msgid "Maximum longitude (horizontal angle) for the equirectangular lens"
msgstr ""
"Största längdgrad (horisontell vinkel) för det ekvirektangulära objektivet"

#. :src: bpy.types.Camera.longitude_min
msgid "Minimum longitude (horizontal angle) for the equirectangular lens"
msgstr ""
"Minsta längdgrad (horisontell vinkel) för det ekvirektangulära objektivet"

#. :src: bpy.types.Camera.ortho_scale
#: source/blender/nodes/geometry/nodes/node_geo_camera_info.cc:26
msgid "Orthographic Scale"
msgstr "Ortografisk skala"

#. :src: bpy.types.Camera.ortho_scale
msgid "Orthographic Camera scale (similar to zoom)"
msgstr "Ortografisk kameraskala (liknar zoom)"

#. :src: bpy.types.Camera.panorama_type
msgid "Panorama Type"
msgstr "Panoramatyp"

#. :src: bpy.types.Camera.panorama_type
msgid "Distortion to use for the calculation"
msgstr "Distorsion som ska användas för beräkningen"

#. :src: bpy.types.Camera.panorama_type:'EQUIRECTANGULAR'
#. :src: bpy.types.ShaderNodeTexEnvironment.projection:'EQUIRECTANGULAR'
msgid "Equirectangular"
msgstr "Ekvirektangulär"

#. :src: bpy.types.Camera.panorama_type:'EQUIRECTANGULAR'
msgid "Spherical camera for environment maps, also known as Lat Long panorama"
msgstr ""
"Sfärisk kamera för miljökartor, även kallad längd- och breddgradspanorama"

#. :src: bpy.types.Camera.panorama_type:'EQUIANGULAR_CUBEMAP_FACE'
msgid "Equiangular Cubemap Face"
msgstr "Ekvivinklad kubkartssida"

#. :src: bpy.types.Camera.panorama_type:'EQUIANGULAR_CUBEMAP_FACE'
msgid "Single face of an equiangular cubemap"
msgstr "En sida av en ekvivinklad kubkarta"

#. :src: bpy.types.Camera.panorama_type:'MIRRORBALL'
#. :src: bpy.types.ShaderNodeTexEnvironment.projection:'MIRROR_BALL'
msgid "Mirror Ball"
msgstr "Spegelboll"

#. :src: bpy.types.Camera.panorama_type:'MIRRORBALL'
msgid "Mirror ball mapping for environment maps"
msgstr "Spegelbollsmappning för miljökartor"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_EQUIDISTANT'
msgid "Fisheye Equidistant"
msgstr "Ekvidistant fiskögeobjektiv"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_EQUIDISTANT'
msgid "Ideal for fulldomes, ignore the sensor dimensions"
msgstr "Lämplig för fullkupolprojektioner, ignorerar sensorns mått"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_EQUISOLID'
msgid "Fisheye Equisolid"
msgstr "Ekvisolid fiskögeobjektiv"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_EQUISOLID'
msgid ""
"Similar to most fisheye modern lens, takes sensor dimensions into "
"consideration"
msgstr ""
"Liknar de flesta moderna fiskögeobjektiv och tar hänsyn till sensorns mått"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_LENS_POLYNOMIAL'
msgid "Fisheye Lens Polynomial"
msgstr "Fiskögeobjektivets polynom"

#. :src: bpy.types.Camera.panorama_type:'FISHEYE_LENS_POLYNOMIAL'
msgid ""
"Defines the lens projection as polynomial to allow real world camera lenses "
"to be mimicked"
msgstr ""
"Anger objektivets projektion som ett polynom så att verkliga kameraobjektiv "
"kan efterliknas"

#. :src: bpy.types.Camera.panorama_type:'CENTRAL_CYLINDRICAL'
msgid "Central Cylindrical"
msgstr "Centralcylindrisk"

#. :src: bpy.types.Camera.panorama_type:'CENTRAL_CYLINDRICAL'
msgid ""
"Projection onto a virtual cylinder from its center, similar as a rotating "
"panoramic camera"
msgstr ""
"Projektion på en virtuell cylinder från dess mittpunkt, liknande en "
"roterande panoramakamera"

#. :src: bpy.types.Camera.passepartout_alpha
msgid "Passepartout Alpha"
msgstr "Alfa för passepartout"

#. :src: bpy.types.Camera.passepartout_alpha
msgid "Opacity (alpha) of the darkened overlay in Camera view"
msgstr "Opacitet (alfa) för den mörka överlagringen i kameravyn"

#. :src: bpy.types.Camera.sensor_fit
msgid "Sensor Fit"
msgstr "Sensoranpassning"

#. :src: bpy.types.Camera.sensor_fit
msgid "Method to fit image and field of view angle inside the sensor"
msgstr "Metod för att anpassa bilden och synfältsvinkeln till sensorn"

#. :src: bpy.types.Camera.sensor_fit:'AUTO'
msgid "Fit to the sensor width or height depending on image resolution"
msgstr "Anpassa till sensorns bredd eller höjd beroende på bildupplösningen"

#. :src: bpy.types.Camera.sensor_fit:'HORIZONTAL'
#. :src: bpy.types.ParticleSettings.angular_velocity_mode:'HORIZONTAL'
#. :src: bpy.types.BlendTexture.use_flip_axis:'HORIZONTAL'
#. :src: bpy.types.CompositorNodeLensdist.distortion_type:'HORIZONTAL'
#. :src: bpy.types.IMAGE_OT_flip.use_flip_x
#. :src: bpy.types.SCREEN_OT_area_split.direction:'HORIZONTAL'
#. :src: bpy.types.PreferencesInput.view_zoom_axis:'HORIZONTAL'
#. :src: bpy.types.ShaderFxFlip.use_flip_x
#. :src: bpy.types.ShaderFxShadow.orientation:'HORIZONTAL'
#. :src: bpy.types.ShaderFxWave.orientation:'HORIZONTAL'
#: scripts/startup/bl_ui/properties_data_curve.py:377
msgid "Horizontal"
msgstr "Horisontell"

#. :src: bpy.types.Camera.sensor_fit:'HORIZONTAL'
msgid "Fit to the sensor width"
msgstr "Anpassa till sensorns bredd"

#. :src: bpy.types.Camera.sensor_fit:'VERTICAL'
msgid "Fit to the sensor height"
msgstr "Anpassa till sensorns höjd"

#. :src: bpy.types.Camera.sensor_height
msgid "Sensor Height"
msgstr "Sensorhöjd"

#. :src: bpy.types.Camera.sensor_height
msgid "Vertical size of the image sensor area in millimeters"
msgstr "Bildsensorns vertikala storlek i millimeter"

#. :src: bpy.types.Camera.sensor_width
#: scripts/startup/bl_ui/space_clip.py:911
msgid "Sensor Width"
msgstr "Sensorbredd"

#. :src: bpy.types.Camera.sensor_width
msgid "Horizontal size of the image sensor area in millimeters"
msgstr "Bildsensorns horisontella storlek i millimeter"

#. :src: bpy.types.Camera.shift_x
#: scripts/startup/bl_ui/properties_data_camera.py:157
msgid "Shift X"
msgstr "Förskjutning X"

#. :src: bpy.types.Camera.shift_x
msgid "Camera horizontal shift"
msgstr "Kamerans horisontella förskjutning"

#. :src: bpy.types.Camera.shift_y
msgid "Shift Y"
msgstr "Förskjutning Y"

#. :src: bpy.types.Camera.shift_y
msgid "Camera vertical shift"
msgstr "Vertikal förskjutning av kameran"

#. :src: bpy.types.Camera.show_background_images
msgid "Display reference images behind objects in the 3D View"
msgstr "Visa referensbilder bakom objekt i 3D-vyporten"
