#. :src: bpy.types.SpaceDopeSheetEditor.ui_mode:'ACTION'
msgid "Action Editor"
msgstr "Action-redigeraren"

#. :src: bpy.types.ThemeNLAEditor.active_action
msgid "Active Action"
msgstr "Aktiv Action"

#. :src: bpy.types.ThemeNLAEditor.active_action_unset
msgid "No Active Action"
msgstr "Ingen aktiv Action"

#: scripts/addons_core/rigify/operators/action_layers.py:475
msgid "No slots in this Action."
msgstr "Inga slotar i denna Action."

#: scripts/addons_core/rigify/operators/action_layers.py:519
msgid "Action not in list"
msgstr "Action finns inte i listan"

#: scripts/startup/bl_operators/anim.py:631
msgid "Creating a new Slot is not possible on a linked Action"
msgstr "Det går inte att skapa en ny slot i en länkad Action"

#: scripts/startup/bl_operators/anim.py:668
msgid "This data-block has no Action slot assigned"
msgstr "Det här datablocket har ingen Action-slot tilldelad"

#: scripts/startup/bl_operators/anim.py:689
msgid "No Action slot is assigned, so there is nothing to un-assign"
msgstr "Ingen Action-slot är tilldelad, så det finns inget att ta bort tilldelningen från"

#: source/blender/editors/animation/anim_asset_ops.cc:541
msgid "Action is not editable"
msgstr "Action kan inte redigeras"

#: source/blender/editors/render/render_preview.cc:992
msgid "Action has no data, cannot render preview"
msgstr "Action har inga data och kan inte visa förhandsgranskning"

#: source/blender/editors/space_action/action_data.cc:468
msgid "Action+Slot has already been stashed"
msgstr "Action + slot har redan lagrats"

#: source/blender/editors/space_action/action_data.cc:365
msgid "Could not unassign the active Action"
msgstr "Det gick inte att ta bort tilldelningen av den aktiva Action"

#: source/blender/editors/space_action/action_data.cc:462
msgid "Could not assign a new Action to %s"
msgstr "Det gick inte att tilldela en ny Action till %s"

#: source/blender/editors/space_action/action_data.cc:470
msgid "Could not un-assign Action from %s"
msgstr "Det gick inte att ta bort tilldelningen av Action från %s"
