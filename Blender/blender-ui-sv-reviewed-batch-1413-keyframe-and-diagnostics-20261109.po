#. :src: bpy.types.ShaderNodeWireframe
msgid ""
"Retrieve the edges of an object as it appears to Cycles.\n"
"Note: as meshes are triangulated before being processed by Cycles, topology will always appear triangulated"
msgstr ""
"Hämta ett objekts kanter såsom Cycles uppfattar dem.\n"
"Obs: eftersom meshar trianguleras innan de bearbetas av Cycles visas topologin alltid triangulerad"

#. :src: bpy.types.ANIM_OT_rotation_mode_convert.bake
msgid ""
"Creates a key on every frame before conversion so interpolation is preserved"
" in the new mode"
msgstr ""
"Skapar en nyckelbildruta på varje bildruta före konverteringen så att "
"interpoleringen bevaras i det nya läget"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_sampling_interpolation_fallback
msgid ""
"Interpolation fallback for sampled animations, when the property is not "
"keyed"
msgstr ""
"Reservinterpolering för samplade animationer när egenskapen saknar "
"nyckelbildruta"

#. :src: bpy.types.GRAPH_OT_blend_offset.factor
msgid "Control which key to offset towards and how far"
msgstr "Styr vilken nyckelbildruta som ska förskjutas och hur långt"

#. :src: bpy.types.GRAPH_OT_breakdown.factor
msgid "Favor either the left or the right key"
msgstr "Favorisera antingen den vänstra eller högra nyckelbildrutan"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'LEFT_KEY'
msgid "Left Key"
msgstr "Vänster nyckelbildruta"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'RIGHT_KEY'
msgid "Right Key"
msgstr "Höger nyckelbildruta"

#. :src: bpy.types.GRAPH_OT_select_key_handles
msgctxt "Operator"
msgid "Select Key / Handles"
msgstr "Markera nyckelbildruta/handtag"

#. :src: bpy.types.GRAPH_OT_select_key_handles.key_action
msgid "Effect on the key itself"
msgstr "Effekt på själva nyckelbildrutan"

#. :src: bpy.types.ToolSettings.mesh_select_mode
msgid "Mesh Selection Mode"
msgstr "Val av meshelement"

#: source/blender/blenloader/intern/readfile.cc:5434
msgid ""
"LIB: .blend file %s seems corrupted, no owner 'Library' data found for the "
"linked data-block '%s'. Try saving the file again."
msgstr ""
"LIB: .blend-filen %s verkar vara skadad, ingen ägarinformation för "
"”Bibliotek” hittades för det länkade datablocket ”%s”. Försök spara filen "
"igen."

#: source/blender/io/csv/importer/csv_reader.cc:275
msgid "CSV Import: empty file '%s'"
msgstr "CSV-import: tom fil ”%s”"

#: source/blender/io/csv/importer/csv_reader.cc:309
msgid "CSV import: failed to parse file '%s'"
msgstr "CSV-import: kunde inte tolka filen ”%s”"

#: source/blender/io/ply/importer/ply_import.cc:226
msgid "PLY Importer: failed importing, unknown error"
msgstr "PLY-importör: importen misslyckades, okänt fel"
