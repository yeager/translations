#. :src: bpy.types.BakeSettings.use_lores_mesh
msgid "Low Resolution Mesh"
msgstr "Lågupplöst mesh"

#. :src: bpy.types.BakeSettings.use_lores_mesh
msgid "Calculate heights against unsubdivided low resolution mesh"
msgstr "Beräkna höjder mot en lågupplöst mesh utan underindelning"

#. :src: bpy.types.FluidFlowSettings.surface_distance
msgid "Height (in domain grid units) of fluid emission above the mesh surface. Higher values result in emission further away from the mesh surface. If this value and the emitter size are smaller than the domain grid unit, fluid will not be created"
msgstr "Höjd, i domänrutnätsenheter, för vätskeemission ovanför meshens yta. Högre värden ger emission längre från meshens yta. Om värdet och emitterarens storlek är mindre än domänrutnätsenheten skapas ingen vätska"

#. :src: bpy.types.Modifier.type:'REMESH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'REMESH'
msgid "Generate new mesh topology based on the current shape"
msgstr "Skapa ny meshtopologi utifrån den aktuella formen"
