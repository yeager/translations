#. :src: bpy.types.Speaker
msgid "Speaker data-block for 3D audio speaker objects"
msgstr "Högtalardatablock för 3D-ljudobjekt av typen högtalare"

#. :src: bpy.types.Speaker.attenuation
#. :src: bpy.types.SceneDisplay.matcap_ssao_attenuation
msgid "Attenuation"
msgstr "Dämpning"

#. :src: bpy.types.Speaker.attenuation
msgid "How strong the distance affects volume, depending on distance model"
msgstr "Hur starkt avståndet påverkar volymen, beroende på avståndsmodell"

#. :src: bpy.types.Speaker.cone_angle_inner
msgid "Inner Cone Angle"
msgstr "Inre konvinkel"

#. :src: bpy.types.Speaker.cone_angle_inner
msgid "Angle of the inner cone, in degrees, inside the cone the volume is 100%"
msgstr "Den inre konens vinkel i grader; i konen är volymen 100 %"

#. :src: bpy.types.Speaker.cone_angle_outer
msgid "Outer Cone Angle"
msgstr "Yttre konvinkel"

#. :src: bpy.types.Speaker.cone_angle_outer
msgid ""
"Angle of the outer cone, in degrees, outside this cone the volume is the "
"outer cone volume, between inner and outer cone the volume is interpolated"
msgstr ""
"Den yttre konens vinkel i grader; utanför konen är volymen den yttre konens "
"volym och mellan konerna interpoleras volymen"

#. :src: bpy.types.Speaker.cone_volume_outer
msgid "Outer Cone Volume"
msgstr "Yttre konvolym"

#. :src: bpy.types.Speaker.cone_volume_outer
msgid "Volume outside the outer cone"
msgstr "Volym utanför den yttre konen"

#. :src: bpy.types.Speaker.distance_max
msgid ""
"Maximum distance for volume calculation, no matter how far away the object is"
msgstr ""
"Maximalt avstånd för volymberäkning, oavsett hur långt bort objektet "
"befinner sig"

#. :src: bpy.types.Speaker.distance_reference
msgid "Reference Distance"
msgstr "Referensavstånd"

#. :src: bpy.types.Speaker.distance_reference
msgid "Reference distance at which volume is 100%"
msgstr "Referensavstånd där volymen är 100 %"

#. :src: bpy.types.Speaker.muted
msgctxt "Sound"
msgid "Mute"
msgstr "Tysta"

#. :src: bpy.types.Speaker.muted
msgid "Mute the speaker"
msgstr "Tysta högtalaren"

#. :src: bpy.types.Speaker.pitch
msgctxt "Sound"
msgid "Pitch"
msgstr "Tonhöjd"

#. :src: bpy.types.Speaker.pitch
msgid "Playback pitch of the sound"
msgstr "Ljudets tonhöjd vid uppspelning"

#. :src: bpy.types.Speaker.sound
msgid "Sound data-block used by this speaker"
msgstr "Ljuddatablock som används av denna högtalare"

#. :src: bpy.types.Speaker.volume
msgid "How loud the sound is"
msgstr "Hur högt ljudet är"

#. :src: bpy.types.Speaker.volume_max
msgid "Maximum Volume"
msgstr "Maximal volym"

#. :src: bpy.types.Speaker.volume_max
msgid "Maximum volume, no matter how near the object is"
msgstr "Maximal volym, oavsett hur nära objektet är"

#. :src: bpy.types.Speaker.volume_min
msgid "Minimum Volume"
msgstr "Minsta volym"

#. :src: bpy.types.Speaker.volume_min
msgid "Minimum volume, no matter how far away the object is"
msgstr "Minsta volym, oavsett hur långt bort objektet befinner sig"
