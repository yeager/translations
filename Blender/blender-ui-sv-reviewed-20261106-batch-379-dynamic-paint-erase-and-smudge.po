#. :src: bpy.types.DynamicPaintBrushSettings.use_paint_erase
msgid "Erase Paint"
msgstr "Radera färg"

#. :src: bpy.types.DynamicPaintBrushSettings.use_paint_erase
msgid "Erase / remove paint instead of adding it"
msgstr "Radera eller ta bort färg i stället för att lägga till den"

#. :src: bpy.types.DynamicPaintBrushSettings.use_particle_radius
msgid "Use Particle Radius"
msgstr "Använd partikelradie"

#. :src: bpy.types.DynamicPaintBrushSettings.use_particle_radius
msgid "Use radius from particle settings"
msgstr "Använd radie från partikelinställningar"

#. :src: bpy.types.DynamicPaintBrushSettings.use_proximity_project
msgid ""
"Brush is projected to canvas from defined direction within brush proximity"
msgstr ""
"Penseln projiceras på duken från en angiven riktning inom penselns "
"närhetsavstånd"

#. :src: bpy.types.DynamicPaintBrushSettings.use_proximity_ramp_alpha
#: scripts/startup/bl_ui/properties_physics_dynamicpaint.py:819
msgid "Only Use Alpha"
msgstr "Använd endast alfa"

#. :src: bpy.types.DynamicPaintBrushSettings.use_proximity_ramp_alpha
msgid "Only read color ramp alpha"
msgstr "Läs endast färggradientens alfa"

#. :src: bpy.types.DynamicPaintBrushSettings.use_smudge
msgid "Do Smudge"
msgstr "Smeta ut"

#. :src: bpy.types.DynamicPaintBrushSettings.use_smudge
msgid "Make this brush to smudge existing paint as it moves"
msgstr "Låt den här penseln smeta ut befintlig färg när den rör sig"

#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_alpha
#. :src: bpy.types.EffectStrip.multiply_alpha
#. :src: bpy.types.ImageStrip.multiply_alpha
#. :src: bpy.types.MaskStrip.multiply_alpha
#. :src: bpy.types.MetaStrip.multiply_alpha
#. :src: bpy.types.MovieClipStrip.multiply_alpha
#. :src: bpy.types.MovieStrip.multiply_alpha
#. :src: bpy.types.SceneStrip.multiply_alpha
msgid "Multiply Alpha"
msgstr "Multiplicera alfa"
