#. :src: bpy.types.MovieClipScopes
msgid "Scopes for statistical view of a movie clip"
msgstr "Omfång för statistisk vy av ett filmklipp"

#. :src: bpy.types.CompositorNodeCustomGroup
msgid "Custom Compositor Group Node for Python nodes"
msgstr "Anpassad kompositörsgruppsnod för Python-noder"

#. :src: bpy.types.CompositorNodeSplit
msgid ""
"Combine two images for side-by-side display. Typically used in combination "
"with a Viewer node"
msgstr ""
"Kombinera två bilder för visning sida vid sida. Används vanligtvis i "
"kombination med en visningsnod"

#. :src: bpy.types.GeometryNodeViewer
msgid "Display the input data in the Spreadsheet Editor"
msgstr "Visa indata i kalkylbladsredigeraren"

#. :src: bpy.types.NODE_OT_activate_viewer
msgctxt "Operator"
msgid "Activate Viewer Node"
msgstr "Aktivera visningsnod"

#. :src: bpy.types.NODE_OT_clear_viewer_border
msgctxt "Operator"
msgid "Clear Viewer Region"
msgstr "Rensa visningsområdet"

#. :src: bpy.types.NODE_OT_deactivate_viewer
msgctxt "Operator"
msgid "Deactivate Viewer Node"
msgstr "Inaktivera visningsnod"

#. :src: bpy.types.NODE_OT_viewer_shortcut_get.viewer_index
#. :src: bpy.types.NODE_OT_viewer_shortcut_set.viewer_index
msgid "Viewer Index"
msgstr "Visningsindex"

#. :src: bpy.types.Scopes.vectorscope_mode
msgid "Vectorscope Mode"
msgstr "Vektorskop-läge"

#. :src: bpy.types.Scopes.waveform_alpha
msgid "Waveform Opacity"
msgstr "Vågformens opacitet"

#. :src: bpy.types.SpaceClipEditor.scopes
msgid "Scopes to visualize movie clip statistics"
msgstr "Omfång för visualisering av filmklippsstatistik"

#. :src: bpy.types.SpaceImageEditor.scopes
msgid "Scopes to visualize image statistics"
msgstr "Omfång för visualisering av bildstatistik"

#. :src: bpy.types.SpaceNodeEditor.show_backdrop
msgid "Use active Viewer Node output as backdrop for compositing nodes"
msgstr ""
"Använd utdatan från den aktiva visningsnoden som bakgrund för "
"kompositionsnoder"
