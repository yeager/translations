#. :src: bpy.types.OUTLINER_OT_orphans_purge
msgid "Clear all orphaned data-blocks without any users from the file"
msgstr "Rensa alla föräldralösa datablock utan användare från filen"

#. :src: bpy.types.OUTLINER_OT_orphans_purge.do_recursive
msgid "Recursively check for indirectly unused data-blocks, ensuring that no orphaned data-blocks remain after execution"
msgstr "Kontrollera rekursivt om det finns indirekt oanvända datablock och se till att inga föräldralösa datablock finns kvar efter körningen"

#. :src: bpy.types.WM_OT_append.use_recursive
msgid "Localize all appended data, including those indirectly linked from other libraries"
msgstr "Gör alla tillagda data lokala, även data som är indirekt länkade från andra bibliotek"

#: source/blender/editors/space_outliner/outliner_edit.cc:381
msgid "Library path is not editable, use the Relocate operation"
msgstr "Bibliotekssökvägen kan inte redigeras. Använd åtgärden Omlokalisera"

#: source/blender/editors/space_outliner/outliner_edit.cc:2608
msgid "No orphaned data-blocks to purge"
msgstr "Inga föräldralösa datablock att rensa bort"

#: source/blender/editors/space_script/script_edit.cc:100
msgid "Cannot reload with running modal operators"
msgstr "Det går inte att ladda om med aktiva modala operatorer"

#: source/blender/windowmanager/intern/wm_files_link.cc:182
msgid "Cannot append data-block '%s' of type '%s'"
msgstr "Det går inte att lägga till datablocket ”%s” av typen ”%s”"
