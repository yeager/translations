#. :src: bpy.types.SceneCompositorEffect
msgid "Compositor effect for scene"
msgstr "Kompositöreffekt för scenen"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_draco_mesh_compression_enable
msgid "Compress mesh using Draco"
msgstr "Komprimera mesh med Draco"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_meshopt_compression_enable
msgid "Compress mesh using Meshopt"
msgstr "Komprimera mesh med Meshopt"

#. :src: bpy.types.PARTICLE_OT_connect_hair.all
msgid "Connect all hair systems to the emitter mesh"
msgstr "Anslut alla hårsystem till emittermeshen"

#. :src: bpy.types.PARTICLE_OT_connect_hair
msgid "Connect hair to the emitter mesh"
msgstr "Anslut håret till emittermeshen"

#. :src: bpy.types.MESH_OT_primitive_monkey_add
msgid "Construct a Suzanne mesh"
msgstr "Konstruera en Suzanne-mesh"

#. :src: bpy.types.MESH_OT_primitive_circle_add
msgid "Construct a circle mesh"
msgstr "Konstruera en cirkelmesh"

#. :src: bpy.types.MESH_OT_primitive_cone_add
msgid "Construct a conic mesh"
msgstr "Konstruera en konisk mesh"

#. :src: bpy.types.MESH_OT_primitive_cube_add_gizmo
msgid "Construct a cube mesh"
msgstr "Konstruera en kubmesh"

#. :src: bpy.types.MESH_OT_primitive_cube_add
msgid "Construct a cube mesh that consists of six square faces"
msgstr "Konstruera en kubmesh med sex kvadratiska ytor"

#. :src: bpy.types.MESH_OT_primitive_cylinder_add
msgid "Construct a cylinder mesh"
msgstr "Konstruera en cylindrisk mesh"

#. :src: bpy.types.MESH_OT_primitive_plane_add
msgid "Construct a filled planar mesh with 4 vertices"
msgstr "Konstruera en fylld plan mesh med fyra hörnpunkter"

#. :src: bpy.types.MESH_OT_primitive_quad_sphere_add
msgid ""
"Construct a spherical mesh from a subdivided cube, consisting entirely of "
"four-sided faces"
msgstr ""
"Skapa en sfärisk mesh från en underindelad kub som helt består av fyrsidiga "
"ytor"

#. :src: bpy.types.MESH_OT_primitive_ico_sphere_add
msgid "Construct a spherical mesh that consists of equally sized triangles"
msgstr "Konstruera en sfärisk mesh med trianglar av samma storlek"

#. :src: bpy.types.MESH_OT_primitive_uv_sphere_add
msgid ""
"Construct a spherical mesh with quad faces, except for triangle faces at the "
"top and bottom"
msgstr ""
"Konstruera en sfärisk mesh med fyrkantiga ytor, förutom triangulära ytor "
"längst upp och längst ner"

#. :src: bpy.types.MESH_OT_primitive_grid_add
msgid "Construct a subdivided plane mesh"
msgstr "Konstruera en underindelad plan mesh"

#. :src: bpy.types.MESH_OT_primitive_torus_add
msgid "Construct a torus mesh"
msgstr "Konstruera en torusmesh"

#. :src: bpy.types.GeometryNodeSetShadeSmooth
msgid ""
"Control the smoothness of mesh normals around each face by changing the "
"\"shade smooth\" attribute"
msgstr ""
"Styr jämnheten för meshnormaler runt varje yta genom att ändra attributet "
"”shade smooth”"

#. :src: bpy.types.GeometryNodeTriangulate
msgid "Convert all faces in a mesh to triangular faces"
msgstr "Konvertera alla ytor i en mesh till triangulära ytor"

#. :src: bpy.types.CompositorNodeConvertToDisplay
msgid ""
"Convert from scene linear to display color space, with a view transform and "
"look for tone mapping"
msgstr ""
"Konvertera från scenlinjär färgrymd till visningsfärgrymd med "
"visningstransformering och utseende för tonmappning"

#. :src: bpy.types.DataTransferModifier.edge_mapping:'TOPOLOGY'
#. :src: bpy.types.DataTransferModifier.loop_mapping:'TOPOLOGY'
#. :src: bpy.types.DataTransferModifier.poly_mapping:'TOPOLOGY'
#. :src: bpy.types.DataTransferModifier.vert_mapping:'TOPOLOGY'
#. :src: bpy.types.OBJECT_OT_data_transfer.edge_mapping:'TOPOLOGY'
#. :src: bpy.types.OBJECT_OT_data_transfer.loop_mapping:'TOPOLOGY'
#. :src: bpy.types.OBJECT_OT_data_transfer.poly_mapping:'TOPOLOGY'
#. :src: bpy.types.OBJECT_OT_data_transfer.vert_mapping:'TOPOLOGY'
msgid "Copy from identical topology meshes"
msgstr "Kopiera från mesh med identisk topologi"

#. :src: bpy.types.UV_OT_copy_mirrored_faces
msgid "Copy mirror UV coordinates based on a mirrored mesh"
msgstr "Kopiera speglade UV-koordinater baserat på en speglad mesh"

msgid "Could not add a new UV map to object '{:s}' (Mesh '{:s}')"
msgstr ""
"Det gick inte att lägga till en ny UV-karta till objektet ”{:s}” (meshen "
"”{:s}”)"

msgid "Could not generate mesh from grid"
msgstr "Kunde inte generera en mesh från rutnätet"

msgid "Could not get valid evaluated mesh"
msgstr "Det gick inte att hämta en giltig utvärderad mesh"

msgid "Crazyspace transformation is only available for Mesh type of objects"
msgstr "Crazyspace-transformering är endast tillgänglig för objekt av meshtyp"

#. :src: bpy.types.ShaderNodeHoldout
msgid ""
"Create a \"hole\" in the image with zero alpha transparency, which is useful "
"for compositing.\n"
"Note: the holdout shader can only create alpha when transparency is enabled "
"in the film settings"
msgstr ""
"Skapa ett ”hål” i bilden med alfatransparens noll, vilket är användbart vid "
"komposition.\n"
"Obs! Holdout-skuggning kan bara skapa alfa när transparens är aktiverad i "
"filminställningarna"

#. :src: bpy.types.SCULPT_OT_face_sets_init.mode:'LOOSE_PARTS'
msgid "Create a face set per loose part in the mesh"
msgstr "Skapa en ytuppsättning per lös del i meshen"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_NEW_UVLAYER
msgid "Create a new UV map for every mesh packed"
msgstr "Skapa en ny UV-karta för varje packad mesh"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh
msgid ""
"Create a new quad based mesh using the surface data of the current mesh. All "
"data layers will be lost"
msgstr ""
"Skapa en ny quadbaserad mesh med ytdata från den aktuella meshen. Alla "
"datalager går förlorade"

#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes
msgid "Create mesh plane(s) from image files with the appropriate aspect ratio"
msgstr "Skapa meshplan från bildfiler med lämpligt bildförhållande"

#. :src: bpy.types.OBJECT_OT_convert.target:'CURVE'
msgid "Curve from Mesh or Text objects"
msgstr "Kurva från mesh- eller textobjekt"

#. :src: bpy.types.Modifier.type:'MESH_CACHE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_CACHE'
msgid "Deform the mesh using an external frame-by-frame vertex transform cache"
msgstr ""
"Deformera meshen med en extern cache för hörnpunktstransformering bildruta "
"för bildruta"

#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.delete_ref
msgid "Delete empty image object once mesh plane is created"
msgstr "Ta bort tomt bildobjekt när meshplanet har skapats"

#. :src: bpy.types.GeometryNodeSubdivideMesh
msgid ""
"Divide mesh faces into smaller ones without changing the shape or volume, "
"using linear interpolation to place the new vertices"
msgstr ""
"Dela meshytor i mindre ytor utan att ändra form eller volym, med linjär "
"interpolering för att placera de nya hörnpunkterna"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_materials:'NONE'
msgid ""
"Do not export materials, and combine mesh primitive groups, losing material "
"slot information"
msgstr ""
"Exportera inte material och kombinera meshens primitivgrupper, vilket leder "
"till förlust av materialplatsinformation"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_materials:'PLACEHOLDER'
msgid ""
"Do not export materials, but write multiple primitive groups per mesh, "
"keeping material slot information"
msgstr ""
"Exportera inte material, utan skriv flera primitivgrupper per mesh och "
"behåll materialplatsinformation"

#. :src: bpy.types.MESH_OT_duplicate_move
msgid "Duplicate mesh and move"
msgstr "Duplicera meshen och flytta"

