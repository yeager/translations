#. :src: bpy.types.OBJECT_OT_curves_empty_hair_add
msgid ""
"Add an empty curve object to the scene with the selected mesh as surface"
msgstr "Lägg till ett tomt kurvobjekt till scenen med den valda meshen som yta"

#. :src: bpy.types.OBJECT_OT_data_transfer
msgid ""
"Transfer data layer(s) (weights, edge sharp, etc.) from active to selected "
"meshes"
msgstr "Överför datalager (vikter, kantskärpa etc.) från aktiv mesh till valda mesh"

#. :src: bpy.types.OBJECT_OT_data_transfer.use_create
msgid "Add data layers on destination meshes if needed"
msgstr "Lägg till datalager i målmesh om det behövs"

#. :src: bpy.types.OBJECT_OT_datalayout_transfer
msgid "Transfer layout of data layer(s) from active to selected meshes"
msgstr "Överför layouten för datalagret/datalagren från aktiv mesh till valda mesh"

#. :src: bpy.types.OBJECT_OT_hook_select
msgid "Select affected vertices on mesh"
msgstr "Välj berörda hörnpunkter i meshen"

#. :src: bpy.types.OBJECT_OT_laplaciandeform_bind
msgid "Bind mesh to system in laplacian deform modifier"
msgstr "Bind meshen till systemet i Laplace-deformeringsmodifieraren"

#. :src: bpy.types.OBJECT_OT_make_single_user.obdata_animation
msgid "Make object data (mesh, curve etc.) animation data local to each object"
msgstr ""
"Gör animationsdata för objektdata (mesh, kurva osv.) lokala för varje objekt"

#. :src: bpy.types.OBJECT_OT_meshdeform_bind
msgid "Bind mesh to cage in mesh deform modifier"
msgstr "Bind meshen till buren i modifieraren för meshdeformering"

#. :src: bpy.types.OBJECT_OT_modifier_apply.merge_customdata
msgid ""
"For mesh objects, merge UV coordinates that share a vertex to account for "
"imprecision in some modifiers"
msgstr ""
"För meshobjekt, slå samman UV-koordinater som delar en hörnpunkt för att "
"kompensera för bristande precision i vissa modifierare"

#. :src: bpy.types.OBJECT_OT_modifier_convert
msgid "Convert particles to a mesh object"
msgstr "Konvertera partiklar till ett meshobjekt"

#. :src: bpy.types.OBJECT_OT_multires_base_apply
msgid "Modify the base mesh to conform to the displaced mesh"
msgstr "Modifiera basmeshen så att den överensstämmer med den förskjutna meshen"

#. :src: bpy.types.OBJECT_OT_multires_higher_levels_delete
msgid "Deletes the higher resolution mesh, potential loss of detail"
msgstr ""
"Tar bort meshen med högre upplösning, vilket kan leda till förlust av detaljer"

#. :src: bpy.types.OBJECT_OT_multires_rebuild_subdiv
msgid ""
"Rebuilds all possible subdivisions levels to generate a lower resolution "
"base mesh"
msgstr ""
"Återuppbygg alla möjliga underindelningsnivåer för att generera en basmesh "
"med lägre upplösning"

#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode
msgid "How the mesh is going to be subdivided to create a new level"
msgstr "Hur meshen kommer att delas upp för att skapa en ny nivå"

#. :src: bpy.types.OBJECT_OT_multires_unsubdivide
msgid "Rebuild a lower subdivision level of the current base mesh"
msgstr "Återuppbygg en lägre underindelningsnivå av den aktuella basmeshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh
msgid ""
"Create a new quad based mesh using the surface data of the current mesh. All "
"data layers will be lost"
msgstr ""
"Skapa en ny quadbaserad mesh med ytdata från den aktuella meshen. "
"Alla datalager går förlorade"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode
msgid "How to specify the amount of detail for the new mesh"
msgstr "Hur detaljnivån för den nya meshen ska anges"
