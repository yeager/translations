#. :src: bpy.types.FModifierStepped.frame_offset
msgid ""
"Reference number of frames before frames get held (use to get hold for '1-3'"
" vs '5-7' holding patterns)"
msgstr ""
"Antal bildrutor före den första hållna bildrutan (använd för hållmönstren "
"”1–3” respektive ”5–7”)"

#. :src: bpy.types.CompositorNodeNormalize
msgid ""
"Map values to 0 to 1 range, based on the minimum and maximum pixel values"
msgstr ""
"Avbilda värden till intervallet 0–1 utifrån pixelvärdenas minimi- och "
"maximivärden"

#. :src: bpy.types.ShaderNodeMath.use_clamp
#. :src: bpy.types.ShaderNodeMixRGB.use_clamp
#. :src: bpy.types.ShaderNodeOutputLineStyle.use_clamp
#. :src: bpy.types.TextureNodeMath.use_clamp
#. :src: bpy.types.TextureNodeMixRGB.use_clamp
msgid "Clamp result of the node to 0.0 to 1.0 range"
msgstr "Begränsa nodens resultat till intervallet 0,0–1,0"

#. :src: bpy.types.ShaderNodeTexNoise.normalize
msgid "Normalize outputs to 0.0 to 1.0 range"
msgstr "Normalisera utdata till intervallet 0,0–1,0"

#. :src: bpy.types.ShaderNodeTexVoronoi.normalize
msgid "Normalize output Distance to 0.0 to 1.0 range"
msgstr "Normalisera utdataavståndet till intervallet 0,0–1,0"

#. :src: bpy.types.PreferencesInput.use_emulate_numpad
msgid "Main 1 to 0 keys act as the numpad ones (useful for laptops)"
msgstr ""
"Tangenterna 1–0 på huvudtangentbordet fungerar som på det numeriska "
"tangentbordet (praktiskt på bärbara datorer)"
