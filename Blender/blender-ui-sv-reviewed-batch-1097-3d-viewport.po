#. :src: bpy.types.GizmoGroup.bl_options:'3D'
msgid "Use in 3D viewport"
msgstr "Använd i 3D-vyporten"

#. :src: bpy.types.AreaLight.use_shadow_jitter
#. :src: bpy.types.PointLight.use_shadow_jitter
#. :src: bpy.types.SpotLight.use_shadow_jitter
#. :src: bpy.types.SunLight.use_shadow_jitter
#. :src: bpy.types.World.use_sun_shadow_jitter
msgid ""
"Enable jittered soft shadows to increase shadow precision (disabled in "
"viewport unless enabled in the render settings). Has a high performance "
"impact."
msgstr ""
"Aktivera slumpade mjuka skuggor för att öka skuggprecisionen (inaktiverat i "
"3D-vyporten om det inte är aktiverat i renderingsinställningarna). Detta påverkar "
"prestandan mycket."

#. :src: bpy.types.MetaBall.resolution
msgid "Polygonization resolution in the 3D viewport"
msgstr "Polygoniseringsupplösning i 3D-vyporten"

#. :src: bpy.types.Object.display
#. :src: bpy.types.ObjectDisplay
msgid "Object display settings for 3D viewport"
msgstr "Inställningar för objektvisning i 3D-vyporten"

#. :src: bpy.types.Object.display_type:'SOLID'
msgid ""
"Display the object as a solid (if solid drawing is enabled in the viewport)"
msgstr "Visa objektet som solitt (om solid visning är aktiverad i 3D-vyporten)"

#. :src: bpy.types.Object.empty_display_size
msgid "Size of display for empties in the viewport"
msgstr "Visningsstorlek för tomobjekt i 3D-vyporten"

#. :src: bpy.types.ParticleSettings.display_size
msgid "Size of particles on viewport"
msgstr "Partikelstorlek i 3D-vyporten"

#. :src: bpy.types.ParticleSettings.use_modifier_stack
msgid ""
"Emit particles from mesh with modifiers applied (must use same subdivision "
"surface level for viewport and render for correct results)"
msgstr ""
"Sänd ut partiklar från mesh med tillämpade modifierare (samma "
"underindelningsnivå måste användas i 3D-vyporten och vid rendering för korrekta "
"resultat)"

#. :src: bpy.types.Scene.display
#. :src: bpy.types.SceneDisplay
#. :src: bpy.types.SceneEEVEE
msgid "Scene display settings for 3D viewport"
msgstr "Inställningar för scenvisning i 3D-vyporten"

#. :src: bpy.types.SubsurfModifier.levels
msgid "Number of subdivisions to perform in the 3D viewport"
msgstr "Antal underindelningar som ska utföras i 3D-vyporten"

#. :src: bpy.types.MovieTrackingTrack.color
msgid ""
"Color of the track in the Movie Clip Editor and the 3D viewport after a solve"
msgstr "Spårets färg i Movie Clip Editor och 3D-vyporten efter en lösning"

#. :src: bpy.types.ObjectDisplay.show_shadows
msgid "Object cast shadows in the 3D viewport"
msgstr "Objekt kastar skuggor i 3D-vyporten"

#. :src: bpy.types.ARMATURE_OT_bone_primitive_add.align:'3D_VIEW'
msgid "Align new bone to match the axes of the 3D viewport"
msgstr "Rikta in det nya benet efter 3D-vyportens axlar"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_optimize_disable_viewport
msgid ""
"When exporting animations, disable viewport for other objects, for "
"performance"
msgstr ""
"När animeringar exporteras, inaktivera visning i 3D-vyporten för andra objekt "
"för bättre prestanda"

#. :src: bpy.types.VIEW3D_OT_toggle_shading
msgid "Toggle shading type in 3D viewport"
msgstr "Växla mellan olika skuggningstyper i 3D-vyporten"

#. :src: bpy.types.PreferencesView.mini_axis_type
msgid "Show small rotating 3D axes in the top right corner of the 3D viewport"
msgstr "Visa små roterande 3D-axlar i det övre högra hörnet av 3D-vyporten"

#. :src: bpy.types.RenderSettings.simplify_volumes
msgid "Resolution percentage of volume objects in viewport"
msgstr "Upplösningsprocent för volymobjekt i 3D-vyporten"

#. :src: bpy.types.SpaceView3D.overlay
#. :src: bpy.types.View3DOverlay
msgid "Settings for display of overlays in the 3D viewport"
msgstr "Inställningar för visning av överlägg i 3D-vyporten"
