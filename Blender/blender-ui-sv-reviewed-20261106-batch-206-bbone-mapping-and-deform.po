#. :src: bpy.types.Bone.bbone_handle_use_ease_end
#. :src: bpy.types.EditBone.bbone_handle_use_ease_end
msgid "End Handle Ease"
msgstr "Utjämning för sluthandtag"

#. :src: bpy.types.Bone.bbone_handle_use_ease_end
#. :src: bpy.types.EditBone.bbone_handle_use_ease_end
msgid ""
"Multiply the B-Bone Ease Out channel by the local Y scale value of the end "
"handle. This is done after the Scale Easing option and isn't affected by it."
msgstr ""
"Multiplicera B-Bone Utjämning ut-kanalen med det lokala Y-skalvärdet för "
"ändhandtaget. Detta görs efter alternativet Skalutjämning och påverkas inte "
"av det."

#. :src: bpy.types.Bone.bbone_handle_use_ease_start
#. :src: bpy.types.EditBone.bbone_handle_use_ease_start
msgid "Start Handle Ease"
msgstr "Utjämning för starthandtag"

#. :src: bpy.types.Bone.bbone_handle_use_ease_start
#. :src: bpy.types.EditBone.bbone_handle_use_ease_start
msgid ""
"Multiply the B-Bone Ease In channel by the local Y scale value of the start "
"handle. This is done after the Scale Easing option and isn't affected by it."
msgstr ""
"Multiplicera B-Bone Utjämning in-kanalen med det lokala Y-skalvärdet för "
"starthandtaget. Detta görs efter alternativet Skalutjämning och påverkas "
"inte av det."

#. :src: bpy.types.Bone.bbone_handle_use_scale_end
#. :src: bpy.types.EditBone.bbone_handle_use_scale_end
msgid "End Handle Scale"
msgstr "Skala för ändhandtag"

#. :src: bpy.types.Bone.bbone_handle_use_scale_end
#. :src: bpy.types.EditBone.bbone_handle_use_scale_end
msgid ""
"Multiply B-Bone Scale Out channels by the local scale values of the end "
"handle. This is done after the Scale Easing option and isn't affected by it."
msgstr ""
"Multiplicera B-Bone Skala ut-kanaler med de lokala skalvärdena för "
"sluthandtaget. Detta görs efter alternativet Skalutjämning och påverkas inte "
"av det."

#. :src: bpy.types.Bone.bbone_handle_use_scale_start
#. :src: bpy.types.EditBone.bbone_handle_use_scale_start
msgid "Start Handle Scale"
msgstr "Skala för starthandtag"

#. :src: bpy.types.Bone.bbone_handle_use_scale_start
#. :src: bpy.types.EditBone.bbone_handle_use_scale_start
msgid ""
"Multiply B-Bone Scale In channels by the local scale values of the start "
"handle. This is done after the Scale Easing option and isn't affected by it."
msgstr ""
"Multiplicera B-Bone Skala in-kanaler med de lokala skalvärdena för "
"starthandtaget. Detta görs efter alternativet Skalutjämning och påverkas "
"inte av det."

#. :src: bpy.types.Bone.bbone_mapping_mode
#. :src: bpy.types.EditBone.bbone_mapping_mode
msgid "B-Bone Vertex Mapping Mode"
msgstr "Mappningsläge för B-Bone-hörnpunkter"

#. :src: bpy.types.Bone.bbone_mapping_mode
#. :src: bpy.types.EditBone.bbone_mapping_mode
msgid ""
"Selects how the vertices are mapped to B-Bone segments based on their "
"position"
msgstr ""
"Väljer hur hörnpunkterna mappas till B-Bone-segment utifrån sin position"

#. :src: bpy.types.Bone.bbone_mapping_mode:'STRAIGHT'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'STRAIGHT'
#. :src: bpy.types.Image.alpha_mode:'STRAIGHT'
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.alpha_mode:'STRAIGHT'
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.alpha_mode:'STRAIGHT'
#. :src: bpy.types.EffectStrip.alpha_mode:'STRAIGHT'
#. :src: bpy.types.ImageStrip.alpha_mode:'STRAIGHT'
#. :src: bpy.types.MaskStrip.alpha_mode:'STRAIGHT'
#. :src: bpy.types.MetaStrip.alpha_mode:'STRAIGHT'
#. :src: bpy.types.MovieClipStrip.alpha_mode:'STRAIGHT'
#. :src: bpy.types.MovieStrip.alpha_mode:'STRAIGHT'
#. :src: bpy.types.SceneStrip.alpha_mode:'STRAIGHT'
msgid "Straight"
msgstr "Rakt"

#. :src: bpy.types.Bone.bbone_mapping_mode:'STRAIGHT'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'STRAIGHT'
msgid ""
"Fast mapping that is good for most situations, but ignores the rest pose "
"curvature of the B-Bone"
msgstr ""
"Snabb mappning som fungerar bra i de flesta situationer men ignorerar B-Bone-"
"kurvans krökning i vilopositionen"

#. :src: bpy.types.Bone.bbone_mapping_mode:'CURVED'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'CURVED'
#. :src: bpy.types.CompositorNodeVecBlur.use_curved
msgid "Curved"
msgstr "Böjd"

#. :src: bpy.types.Bone.bbone_mapping_mode:'CURVED'
#. :src: bpy.types.EditBone.bbone_mapping_mode:'CURVED'
msgid ""
"Slower mapping that gives better deformation for B-Bones that are sharply "
"curved in rest pose"
msgstr ""
"Långsammare mappning som ger bättre deformering för B-Bones som är kraftigt "
"böjda i vilopositionen"

#. :src: bpy.types.Bone.bbone_rollin
#. :src: bpy.types.EditBone.bbone_rollin
#. :src: bpy.types.PoseBone.bbone_rollin
#: scripts/startup/bl_ui/properties_data_bone.py:155
msgid "Roll In"
msgstr "Inrullning"

#. :src: bpy.types.Bone.bbone_rollin
#. :src: bpy.types.EditBone.bbone_rollin
#. :src: bpy.types.PoseBone.bbone_rollin
msgid "Roll offset for the start of the B-Bone, adjusts twist"
msgstr "Rullningsförskjutning för början av B-Bone; justerar vridningen"

#. :src: bpy.types.Bone.bbone_rollout
#. :src: bpy.types.EditBone.bbone_rollout
#. :src: bpy.types.PoseBone.bbone_rollout
msgid "Roll Out"
msgstr "Utrullning"

#. :src: bpy.types.Bone.bbone_rollout
#. :src: bpy.types.EditBone.bbone_rollout
#. :src: bpy.types.PoseBone.bbone_rollout
msgid "Roll offset for the end of the B-Bone, adjusts twist"
msgstr "Rullningsförskjutning för slutet av B-Bone; justerar vridningen"

#. :src: bpy.types.Bone.bbone_scalein
#. :src: bpy.types.EditBone.bbone_scalein
#. :src: bpy.types.PoseBone.bbone_scalein
#: scripts/startup/bl_ui/properties_data_bone.py:160
msgid "Scale In"
msgstr "Skala in"

#. :src: bpy.types.Bone.bbone_scalein
#. :src: bpy.types.EditBone.bbone_scalein
#. :src: bpy.types.PoseBone.bbone_scalein
msgid ""
"Scale factors for the start of the B-Bone, adjusts thickness (for tapering "
"effects)"
msgstr ""
"Skalfaktorer för början av B-Bone, justerar tjockleken (för avsmalnande "
"effekter)"

#. :src: bpy.types.Bone.bbone_scaleout
#. :src: bpy.types.EditBone.bbone_scaleout
#. :src: bpy.types.PoseBone.bbone_scaleout
#: scripts/startup/bl_ui/properties_data_bone.py:163
msgid "Scale Out"
msgstr "Skala ut"

#. :src: bpy.types.Bone.bbone_scaleout
#. :src: bpy.types.EditBone.bbone_scaleout
#. :src: bpy.types.PoseBone.bbone_scaleout
msgid ""
"Scale factors for the end of the B-Bone, adjusts thickness (for tapering "
"effects)"
msgstr ""
"Skalfaktorer för slutet av B-Bone, justerar tjockleken (för avsmalnande "
"effekter)"

