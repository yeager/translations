#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Clump Hair Curves"
msgstr "Klumpa hårkurvor"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Clumps together existing hair curves using guide curves"
msgstr "Grupperar befintliga hårkurvor kring guidekurvor"

#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Tip Spread"
msgstr "Spridning vid spetsarna"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Distance of random spread at the curve tips"
msgstr "Avstånd för slumpmässig spridning vid kurvspetsarna"

#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Clump Offset"
msgstr "Klumpförskjutning"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Offset of each clump in a random direction"
msgstr "Förskjutning av varje klump i en slumpmässig riktning"

#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Distance Falloff"
msgstr "Avtagande med avstånd"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Falloff distance for the clumping effect (0 means no falloff)"
msgstr "Avstånd där klumpningseffekten avtar (0 innebär inget avtagande)"

#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Distance Threshold"
msgstr "Avståndströskel"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Distance threshold for the falloff around the guide"
msgstr "Avståndströskel för avtagandet kring guidekurvan"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Random seed for the operation"
msgstr "Slumpfrö för åtgärden"
