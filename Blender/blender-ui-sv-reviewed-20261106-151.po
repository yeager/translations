#. :src: bpy.types.ClothSettings.density_strength
msgid "Target Density Strength"
msgstr "Styrka för måltäthet"

#. :src: bpy.types.ClothSettings.density_target
msgid "Target Density"
msgstr "Måltäthet"

#. :src: bpy.types.ClothSettings.goal_max
msgid "Goal maximum, vertex group weights are scaled to match this range"
msgstr ""
"Målmaximum; hörnpunktsgruppens vikter skalas så att de motsvarar detta "
"intervall"

#. :src: bpy.types.ClothSettings.goal_min
msgid "Goal minimum, vertex group weights are scaled to match this range"
msgstr ""
"Målminimum; hörnpunktsgruppens vikter skalas så att de motsvarar detta "
"intervall"

#. :src: bpy.types.ClothSettings.internal_tension_stiffness_max
#. :src: bpy.types.ClothSettings.tension_stiffness_max
msgid "Maximum tension stiffness value"
msgstr "Maximalt värde för dragstyvhet"

#. :src: bpy.types.ClothSettings.target_volume
msgid ""
"The mesh volume where the inner/outer pressure will be the same. If set to "
"zero the change in volume will not affect pressure."
msgstr ""
"Den meshvolym där det inre och yttre trycket är lika. Om värdet är noll "
"påverkar volymförändringen inte trycket."

#. :src: bpy.types.ClothSettings.uniform_pressure_force
msgid ""
"The uniform pressure that is constantly applied to the mesh, in units of "
"Pressure Scale. Can be negative."
msgstr ""
"Det enhetliga tryck som ständigt tillämpas på meshen, i enheter av "
"tryckskalan. Kan vara negativt."

#. :src: bpy.types.ClothSettings.use_dynamic_mesh
msgid "Dynamic Base Mesh"
msgstr "Dynamisk basmesh"

#. :src: bpy.types.ClothSettings.use_dynamic_mesh
msgid "Make simulation respect deformations in the base mesh"
msgstr "Låt simuleringen ta hänsyn till deformationer i basmeshen"

#. :src: bpy.types.ClothSettings.use_internal_springs
msgid ""
"Simulate an internal volume structure by creating springs connecting the "
"opposite sides of the mesh"
msgstr ""
"Simulera en inre volymstruktur genom att skapa fjädrar som förbinder meshens "
"motsatta sidor"

#. :src: bpy.types.ClothSettings.use_pressure
msgid "Simulate pressure inside a closed cloth mesh"
msgstr "Simulera tryck inuti en sluten tygmesh"

#. :src: bpy.types.ClothSettings.use_pressure_volume
msgid ""
"Use the Target Volume parameter as the initial volume, instead of "
"calculating it from the mesh itself"
msgstr ""
"Använd parametern Målvolym som initial volym i stället för att beräkna den "
"från själva meshen"

#. :src: bpy.types.ClothSettings.vertex_group_bending
msgid "Bending Stiffness Vertex Group"
msgstr "Hörnpunktsgrupp för böjstyvhet"

#. :src: bpy.types.ClothSettings.vertex_group_bending
msgid "Vertex group for fine control over bending stiffness"
msgstr "Hörnpunktsgrupp för finjustering av böjstyvheten"

#. :src: bpy.types.ClothSettings.vertex_group_intern
msgid "Internal Springs Vertex Group"
msgstr "Hörnpunktsgrupp för interna fjädrar"

#. :src: bpy.types.ClothSettings.vertex_group_intern
msgid "Vertex group for fine control over the internal spring stiffness"
msgstr "Hörnpunktsgrupp för finjustering av de interna fjädrarnas styvhet"

#. :src: bpy.types.ClothSettings.vertex_group_mass
msgid "Pin Vertex Group"
msgstr "Hörnpunktsgrupp för fastsättning"

#. :src: bpy.types.ClothSettings.vertex_group_mass
msgid "Vertex Group for pinning of vertices"
msgstr "Hörnpunktsgrupp för fastsättning av hörnpunkter"

#. :src: bpy.types.ClothSettings.vertex_group_pressure
msgid ""
"Vertex Group for where to apply pressure. Zero weight means no pressure "
"while a weight of one means full pressure. Faces with a vertex that has zero "
"weight will be excluded from the volume calculation."
msgstr ""
"Hörnpunktsgrupp för var tryck ska appliceras. Noll vikt innebär inget tryck, "
"medan vikten ett innebär fullt tryck. Ytor med en hörnpunkt med noll vikt "
"utesluts från volymberäkningen."

#. :src: bpy.types.ClothSettings.vertex_group_shear_stiffness
msgid "Vertex group for fine control over shear stiffness"
msgstr "Hörnpunktsgrupp för finjustering av skjuvstyvheten"
