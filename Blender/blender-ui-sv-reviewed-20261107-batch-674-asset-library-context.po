msgid ""
"Re-download the asset listing of a remote library. Only supported when the "
"active asset library is remote or has a remote component (the Essentials "
"library)"
msgstr ""
"Hämta resurslistan för ett fjärranslutet resursbibliotek på nytt. Stöds "
"endast när det "
"aktiva resursbiblioteket är fjärranslutet eller har en fjärrkomponent "
"(grundresursbiblioteket)"

msgid ""
"Add an asset library managed via the file system without referencing an "
"external repository"
msgstr ""
"Lägg till ett resursbibliotek som hanteras via filsystemet utan att hänvisa "
"till ett externt förråd"

msgid "Enable asset libraries served over HTTP/HTTPS"
msgstr "Aktivera resursbibliotek som tillhandahålls via HTTP/HTTPS"

#. :src: bpy.types.UserExtensionRepo.use_access_token_for_asset_libraries
msgid ""
"Asset libraries installed from this repository use its access token (cached "
"from the repository listing when syncing)"
msgstr ""
"Resursbibliotek som installerats från detta tilläggsförråd använder dess "
"åtkomsttoken (cachelagrad från förrådslistan vid synkronisering)"

#. :src: source/blender/makesrna/intern/rna_userdef.cc:833
msgid "Extension defined asset libraries require a remote URL"
msgstr "Resursbibliotek som definieras av tillägg kräver en fjärr-URL"
