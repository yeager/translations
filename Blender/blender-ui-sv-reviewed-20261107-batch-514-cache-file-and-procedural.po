#. :src: bpy.types.CacheFile.filepath
#. :src: bpy.types.MeshCacheModifier.filepath
#. :src: bpy.types.MultiresModifier.filepath
msgid "Path to external displacements file"
msgstr "Sökväg till filen för externa förskjutningar"

#. :src: bpy.types.CacheFile.forward_axis
#. :src: bpy.types.MeshCacheModifier.forward_axis
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.axis_forward
#. :src: bpy.types.IMPORT_ANIM_OT_bvh.axis_forward
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.axis_forward
#: source/blender/editors/io/io_stl_ops.cc:102
msgid "Forward"
msgstr "Framåt"

#. :src: bpy.types.CacheFile.frame
msgid ""
"The time to use for looking up the data in the cache file, or to determine "
"which file to use in a file sequence"
msgstr ""
"Bildrutan som används för att slå upp data i cachefilen eller avgöra vilken "
"fil som ska användas i en filsekvens"

#. :src: bpy.types.CacheFile.frame_offset
msgid ""
"Subtracted from the current frame to use for looking up the data in the "
"cache file, or to determine which file to use in a file sequence"
msgstr ""
"Dras av från den aktuella bildrutan när data slås upp i cachefilen eller när "
"en fil väljs ur en filsekvens"

#. :src: bpy.types.CacheFile.is_sequence
#. :src: bpy.types.Volume.is_sequence
#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.mode:'SEQUENCE'
#: source/blender/editors/space_image/image_buttons.cc:136
msgid "Sequence"
msgstr "Sekvens"

#. :src: bpy.types.CacheFile.is_sequence
#. :src: bpy.types.Volume.is_sequence
msgid "Whether the cache is separated in a series of files"
msgstr "Om cachen är uppdelad i en serie filer"

#. :src: bpy.types.CacheFile.layers
msgid "Layers of the cache"
msgstr "Cachelager"

#. :src: bpy.types.CacheFile.object_paths
msgid "Paths of the objects inside the Alembic archive"
msgstr "Sökvägar till objekten i Alembic-arkivet"

#. :src: bpy.types.CacheFile.override_frame
#: source/blender/editors/interface/templates/interface_template_cache_file.cc:116
msgid "Override Frame"
msgstr "Åsidosätt bildruta"

#. :src: bpy.types.CacheFile.override_frame
msgid ""
"Whether to use a custom frame for looking up data in the cache file, instead "
"of using the current scene frame"
msgstr ""
"Om en anpassad bildruta ska användas för att slå upp data i cachefilen i "
"stället för scenens aktuella bildruta"

#. :src: bpy.types.CacheFile.prefetch_cache_size
msgid "Prefetch Cache Size"
msgstr "Storlek på förhandsladdningscache"

#. :src: bpy.types.CacheFile.prefetch_cache_size
msgid ""
"Memory usage limit in megabytes for the Cycles Procedural cache, if the data "
"does not fit within the limit, rendering is aborted"
msgstr ""
"Minnesgräns i megabyte för Cycles Procedural-cachen. Om data inte ryms inom "
"gränsen avbryts renderingen"

#. :src: bpy.types.CacheFile.scale
msgid ""
"Value by which to enlarge or shrink the object with respect to the world's "
"origin (only applicable through a Transform Cache constraint)"
msgstr ""
"Värde som förstorar eller förminskar objektet i förhållande till världens "
"ursprung (gäller endast med en Transform Cache-begränsning)"

