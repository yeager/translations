#: scripts/startup/bl_operators/object.py:523
msgid "Expected one other selected mesh object to copy from"
msgstr "Förväntade ett annat markerat meshobjekt att kopiera från"

#: scripts/startup/bl_operators/object.py:529
msgid "Both objects must be meshes"
msgstr "Båda objekten måste vara meshobjekt"

#: scripts/startup/bl_operators/object_quick_effects.py:99
#: scripts/startup/bl_operators/object_quick_effects.py:461
#: scripts/startup/bl_operators/object_quick_effects.py:563
#: scripts/startup/bl_operators/object_quick_effects.py:293
msgid "Select at least one mesh object"
msgstr "Välj minst ett meshobjekt"

#: scripts/startup/bl_operators/object_quick_effects.py:279
#: source/blender/editors/mesh/mesh_join.cc:535
msgid "Active object is not a mesh"
msgstr "Det aktiva objektet är inte ett meshobjekt"

#: scripts/startup/bl_operators/object_quick_effects.py:289
msgid "Select two mesh objects"
msgstr "Välj två meshobjekt"

#: scripts/startup/bl_operators/uvcalc_lightmap.py:576
msgid "No mesh object"
msgstr "Inget meshobjekt"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:619
msgid "Add cube to mesh interactively"
msgstr "Lägg interaktivt till en kub i meshen"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:647
msgid "Add cone to mesh interactively"
msgstr "Lägg interaktivt till en kon i meshen"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:675
msgid "Add cylinder to mesh interactively"
msgstr "Lägg interaktivt till en cylinder i meshen"

#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:703
#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:731
#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:758
msgid "Add sphere to mesh interactively"
msgstr "Lägg interaktivt till en sfär i meshen"

#: source/blender/blenkernel/intern/dynamicpaint.cc:2856
msgid "Canvas mesh not updated"
msgstr "Dukmeshen uppdaterades inte"

#: source/blender/blenkernel/intern/rigidbody.cc:1485
msgid "Cannot add Rigid Body to non mesh object"
msgstr ""
"Det går inte att lägga till Rigid Body till ett objekt som inte är ett "
"meshobjekt"

#: source/blender/editors/curves/intern/curves_ops.cc:138
msgid "Curves must have a mesh surface object set"
msgstr "Kurvor måste ha ett meshobjekt inställt som yta"

#: source/blender/editors/mesh/editmesh_select.cc:89
msgid "An edit-mesh with vertex or edge selection mode is required"
msgstr "En redigeringsmesh med val av hörnpunkt eller kant krävs"

#: source/blender/editors/mesh/editmesh_tools.cc:8572
msgid "Select and use mesh item"
msgstr "Välj och använd meshelement"
