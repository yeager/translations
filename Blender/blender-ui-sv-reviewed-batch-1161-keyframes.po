# Blender UI Swedish review delta: animation keyframe terminology
# Reviewed against Blender/TERMINOLOGY.md and archived Blender UI batches.
msgid ""
msgstr ""
"Project-Id-Version: Blender UI\n"
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#. :src: bpy.types.BUILTIN_KSI_LocRot
msgid "Insert a keyframe on each of the location and rotation channels"
msgstr "Infoga en nyckelbildruta på varje positions- och rotationskanal"

#. :src: bpy.types.BUILTIN_KSI_LocScale
msgid "Insert a keyframe on each of the location and scale channels"
msgstr "Infoga en nyckelbildruta på varje positions- och skalkanal"

#. :src: bpy.types.BUILTIN_KSI_RotScale
msgid "Insert a keyframe on each of the rotation and scale channels"
msgstr "Infoga en nyckelbildruta på varje rotations- och skalningskanal"

#. :src: bpy.types.BUILTIN_KSI_VisualLoc
msgid "Insert a keyframe on each of the location channels, taking into account effects of constraints and relationships"
msgstr "Infoga en nyckelbildruta på varje positionskanal, med hänsyn till effekterna av begränsningar och relationer"

#. :src: bpy.types.BUILTIN_KSI_VisualLocRot
msgid "Insert a keyframe on each of the location and rotation channels, taking into account effects of constraints and relationships"
msgstr "Infoga en nyckelbildruta på varje positions- och rotationskanal, med hänsyn till effekterna av begränsningar och relationer"

#. :src: bpy.types.BUILTIN_KSI_VisualLocRotScale
msgid "Insert a keyframe on each of the location, rotation and scale channels, taking into account effects of constraints and relationships"
msgstr "Infoga en nyckelbildruta på varje positions-, rotations- och skalkanal, med hänsyn till effekterna av begränsningar och relationer"

#. :src: bpy.types.BUILTIN_KSI_VisualRot
msgid "Insert a keyframe on each of the rotation channels, taking into account effects of constraints and relationships"
msgstr "Infoga en nyckelbildruta på var och en av rotationskanalerna, med hänsyn till effekterna av begränsningar och relationer"

#. :src: bpy.types.BUILTIN_KSI_VisualRotScale
msgid "Insert a keyframe on each of the rotation and scale channels, taking into account effects of constraints and relationships"
msgstr "Infoga en nyckelbildruta på varje rotations- och skalkanal, med hänsyn till effekterna av begränsningar och relationer"

#. :src: bpy.types.BUILTIN_KSI_VisualScaling
msgid "Insert a keyframe on each of the scale channels, taking into account effects of constraints and relationships"
msgstr "Infoga en nyckelbildruta på var och en av skalkanalerna, med hänsyn till effekterna av begränsningar och relationer"

#. :src: bpy.types.LocRotScale
msgid "Insert a keyframe on each of the location, rotation, and scale channels"
msgstr "Infoga en nyckelbildruta på varje positions-, rotations- och skalkanal"

#. :src: bpy.types.Location
msgid "Insert a keyframe on each of the location channels"
msgstr "Infoga en nyckelbildruta på varje positionskanal"

#. :src: bpy.types.Rotation
msgid "Insert a keyframe on each of the rotation channels"
msgstr "Infoga en nyckelbildruta på var och en av rotationskanalerna"

#. :src: bpy.types.WholeCharacter
msgid "Insert a keyframe for all properties that are likely to get animated in a character rig (useful when blocking out a shot)"
msgstr "Infoga en nyckelbildruta för alla egenskaper som sannolikt kommer att animeras i en karaktärsrigg (användbart när man blockerar en tagning)"

#. :src: bpy.types.WholeCharacterSelected
msgid "Insert a keyframe for all properties that are likely to get animated in a character rig (only selected bones)"
msgstr "Infoga en nyckelbildruta för alla egenskaper som sannolikt kommer att animeras i en karaktärsrigg (endast valda ben)"

#. :src: bpy.types.ACTION_OT_select_by_type.type
msgid "The type of keyframe to select"
msgstr "Typen av nyckelbildruta som ska markeras"

#. :src: bpy.types.CLIP_OT_keyframe_delete
msgid "Delete a keyframe from selected tracks at current frame"
msgstr "Ta bort en nyckelbildruta från valda spår vid aktuell bildruta"

#. :src: bpy.types.CLIP_OT_keyframe_insert
msgid "Insert a keyframe to selected tracks at current frame"
msgstr "Infoga en nyckelbildruta för valda spår vid aktuell bildruta"

#. :src: bpy.types.CLIP_OT_set_solver_keyframe
msgctxt "Operator"
msgid "Set Solver Keyframe"
msgstr "Ange lösarnyckelbildruta"

#. :src: bpy.types.GRAPH_OT_click_insert
msgid "Insert new keyframe at the cursor position for the active F-Curve"
msgstr "Infoga ny nyckelbildruta vid markörpositionen för den aktiva F-kurvan"

#. :src: bpy.types.GRAPH_OT_click_insert.frame
msgid "Frame to insert keyframe on"
msgstr "Bildruta där nyckelbildrutan ska infogas"

#. :src: bpy.types.GRAPH_OT_click_insert.value
msgid "Value for keyframe on"
msgstr "Värde för nyckelbildrutan"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side:'BOTH'
msgid "Equalize both of a keyframe's handles"
msgstr "Utjämna båda handtagen för en nyckelbildruta"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'ALL'
msgid "Insert a keyframe on all visible and editable F-Curves using each curve's current value"
msgstr "Infoga en nyckelbildruta i alla synliga och redigerbara F-kurvor med varje kurvas aktuella värde"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'SEL'
msgid "Insert a keyframe on selected F-Curves using each curve's current value"
msgstr "Infoga en nyckelbildruta i markerade F-kurvor med varje kurvas aktuella värde"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'ACTIVE'
msgid "Insert a keyframe on the active F-Curve using the curve's current value"
msgstr "Infoga en nyckelbildruta i den aktiva F-kurvan med kurvans aktuella värde"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'CURSOR_ACTIVE'
msgid "Insert a keyframe for the active F-Curve at the cursor point"
msgstr "Infoga en nyckelbildruta i den aktiva F-kurvan vid markörpunkten"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'CURSOR_SEL'
msgid "Insert a keyframe for selected F-Curves at the cursor point"
msgstr "Infoga en nyckelbildruta för valda F-kurvor vid markörpunkten"

#. :src: bpy.types.GRAPH_OT_select_key_handles
msgid "For selected keyframes, select/deselect any combination of the key itself and its handles"
msgstr "För markerade nyckelbildrutor: markera/avmarkera valfri kombination av själva nyckelbildrutan och dess handtag"

#. :src: bpy.types.GREASE_PENCIL_OT_frame_clean_duplicate
msgid "Remove any keyframe that is a duplicate of the previous one"
msgstr "Ta bort varje nyckelbildruta som är en dubblett av den föregående"

#. :src: bpy.types.MASK_OT_shape_key_clear
msgid "Remove mask shape keyframe for active mask layer at the current frame"
msgstr "Ta bort maskformens nyckelbildruta för det aktiva masklagret vid den aktuella bildrutan"

#. :src: bpy.types.MASK_OT_shape_key_insert
msgid "Insert mask shape keyframe for active mask layer at the current frame"
msgstr "Infoga maskformens nyckelbildruta för det aktiva masklagret vid den aktuella bildrutan"

#. :src: bpy.types.POSE_OT_propagate.mode:'LAST_KEY'
msgid "Propagate pose to the last keyframe only (i.e. making action cyclic)"
msgstr "Sprid posen endast till den sista nyckelbildrutan (dvs. gör åtgärden cyklisk)"

