msgctxt "Operator"
msgid "Insert Blank Keyframe (All Layers)"
msgstr "Infoga tom nyckelbildruta (alla lager)"

#: scripts/startup/bl_ui/space_view3d.py:5928
msgctxt "Operator"
msgid "Duplicate Active Keyframe (All Layers)"
msgstr "Duplicera aktiv nyckelbildruta (alla lager)"

#: scripts/startup/bl_ui/space_view3d.py:5932
msgctxt "Operator"
msgid "Delete Active Keyframe (All Layers)"
msgstr "Ta bort aktiv nyckelbildruta (alla lager)"

#: source/blender/animrig/intern/keyframing.cc:56
msgid "Keyframe insertion failed for an unknown reason."
msgstr "Det gick inte att infoga nyckelbildruta av okänd anledning."
