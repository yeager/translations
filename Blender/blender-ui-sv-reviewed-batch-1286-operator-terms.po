#. :src: bpy.types.UI_OT_i18n_updatetranslation_init_settings
msgid "Init settings for i18n files update operators"
msgstr "Initiera inställningar för i18n-filuppdateringsoperatörerna"

#. :src: bpy.types.UI_OT_i18n_updatetranslation_settings_select
msgid ""
"(De)select (or invert selection of) all languages for i18n files update "
"operators"
msgstr ""
"(Av)markera (eller invertera markeringen av) alla språk för i18n-"
"filuppdateringsoperatörerna"

#. :src: bpy.types.OperatorOptions.is_repeat_last
msgid "True when run from the operator 'Repeat Last'"
msgstr "Sant när den körs från operatören ”Upprepa senaste”"

#. :src: bpy.types.ASSET_OT_library_refresh.use_shift_for_remote_listing
msgid ""
"When this operator is invoked and the Shift key is pressed, download the "
"remote asset library listing"
msgstr ""
"När den här operatören anropas och Skift-tangenten hålls ned hämtas "
"resurslistningen för fjärrbiblioteket"

#. :src: bpy.types.GRAPH_OT_fmodifier_delete.mode
msgid "Decide what the operator will remove"
msgstr "Ange vad operatören ska ta bort"

#. :src: bpy.types.GRAPH_OT_gaussian_smooth.filter_width
msgid "How far to each side the operator will average the key values"
msgstr ""
"Hur långt åt varje håll operatören ska beräkna medelvärdet av nyckelvärdena"

#. :src: bpy.types.GREASE_PENCIL_OT_texture_gradient.cursor
#. :src: bpy.types.IMAGE_OT_sample_line.cursor
#. :src: bpy.types.MESH_OT_bisect.cursor
#. :src: bpy.types.PAINT_OT_hide_show_line_gesture.cursor
#. :src: bpy.types.PAINT_OT_mask_line_gesture.cursor
