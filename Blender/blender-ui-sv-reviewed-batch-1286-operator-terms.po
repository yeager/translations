#. :src: bpy.types.SCULPT_OT_face_set_line_gesture.cursor
#. :src: bpy.types.SCULPT_OT_project_line_gesture.cursor
#. :src: bpy.types.SCULPT_OT_trim_line_gesture.cursor
msgid "Mouse cursor style to use during the modal operator"
msgstr "Muspekarstil som ska användas under den modala operatören"

#. :src: bpy.types.SCULPT_OT_expand
msgid "Generic sculpt expand operator"
msgstr "Allmän operatör för utökning vid skulptering"

#. :src: bpy.types.WM_OT_operator_defaults
msgctxt "Operator"
msgid "Restore Operator Defaults"
msgstr "Återställ operatörens standardvärden"

#. :src: bpy.types.WM_OT_operator_defaults
msgid "Set the active operator to its default values"
msgstr "Ange den aktiva operatörens standardvärden"
