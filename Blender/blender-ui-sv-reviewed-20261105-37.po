#. :src: bpy.types.Bone.tail
#. :src: bpy.types.EditBone.tail
#. :src: bpy.types.Armature.relation_line_position:'TAIL'
#. :src: bpy.types.ParticleSettings.line_length_tail
msgid "Tail"
msgstr "Svans"

#. :src: bpy.types.Bone.tail
msgid "Location of tail end of the bone relative to its parent"
msgstr "Benets svansändes position i förhållande till överordnat ben"

#. :src: bpy.types.Bone.tail_local
msgid "Armature-Relative Tail"
msgstr "Svans relativt riggskelett"

#. :src: bpy.types.Bone.tail_local
msgid "Location of tail end of the bone relative to armature"
msgstr "Benets svansändes position i förhållande till riggskelettet"

#. :src: bpy.types.Bone.tail_radius
#. :src: bpy.types.EditBone.tail_radius
msgid "Envelope Tail Radius"
msgstr "Kuvertets svansradie"

#. :src: bpy.types.Bone.tail_radius
#. :src: bpy.types.EditBone.tail_radius
msgid "Radius of tail of bone (for Envelope deform only)"
msgstr "Radie för benets svans (endast för kuvertdeformering)"

#. :src: bpy.types.Bone.use_connect
#. :src: bpy.types.EditBone.use_connect
#. :src: bpy.types.WeldModifier.mode:'CONNECTED'
#. :src: bpy.types.ARMATURE_OT_parent_set.type:'CONNECTED'
msgid "Connected"
msgstr "Ansluten"

#. :src: bpy.types.Bone.use_connect
#. :src: bpy.types.EditBone.use_connect
msgid "When bone has a parent, bone's head is stuck to the parent's tail"
msgstr "När ett ben har ett överordnat ben är dess huvud fäst vid den överordnades svans"

#. :src: bpy.types.Bone.use_cyclic_offset
#. :src: bpy.types.EditBone.use_cyclic_offset
msgid "Cyclic Offset"
msgstr "Cyklisk förskjutning"

#. :src: bpy.types.Bone.use_cyclic_offset
#. :src: bpy.types.EditBone.use_cyclic_offset
msgid "When bone does not have a parent, it receives cyclic offset effects (Deprecated)"
msgstr "När ett ben saknar överordnat ben får det cykliska förskjutningseffekter (föråldrat)"
