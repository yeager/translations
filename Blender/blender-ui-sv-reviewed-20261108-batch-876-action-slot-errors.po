#: scripts/addons_core/rigify/operators/action_layers.py:347
msgid "Failed to find Action Slot."
msgstr "Det gick inte att hitta Action-slotten."

#: scripts/startup/bl_operators/anim.py:628
msgid "An action slot can only be created when an action is assigned"
msgstr "En Action-slot kan bara skapas när en Action har tilldelats"

#: scripts/startup/bl_operators/anim.py:668
msgid "This data-block has no Action slot assigned"
msgstr "Det här datablocket har ingen Action-slot tilldelad"

#: scripts/startup/bl_operators/anim.py:689
msgid "No Action slot is assigned, so there is nothing to un-assign"
msgstr ""
"Ingen Action-slot är tilldelad, så det finns inget att ta bort tilldelningen "
"från"

#: source/blender/editors/animation/anim_channels_edit.cc:5278
msgid "None of the selected channels is an Action Slot"
msgstr "Ingen av de valda kanalerna är en Action-slot"

#: source/blender/editors/space_outliner/outliner_draw.cc:982
msgctxt "Operator"
msgid "Rename Action Slot"
msgstr "Byt namn på Action-slot"

#: source/blender/makesrna/intern/rna_action.cc:327
msgid "Action slot display names cannot be empty"
msgstr "Visningsnamn för Action-slotar får inte vara tomma"

#: source/blender/makesrna/intern/rna_action.cc:341
msgid "Action slot identifiers should be at least three characters"
msgstr "Identifierare för Action-slotar ska innehålla minst tre tecken"
