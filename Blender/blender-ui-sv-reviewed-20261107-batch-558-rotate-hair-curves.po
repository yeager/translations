#. :src: bpy.types.ShaderFxSwirl.angle
#. :src: Socket description from node group Rotate Hair Curves, file procedural_hair_node_assets.blend
msgid "Angle of rotation"
msgstr "Rotationsvinkel"

#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Rotate Hair Curves"
msgstr "Rotera hårkurvor"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Rotates each hair curve around an axis"
msgstr "Roterar varje hårkurva kring en axel"

#. :src: Socket description from node group Rotate Hair Curves, file procedural_hair_node_assets.blend
msgid "Factor to influence the rotation angle"
msgstr "Faktor som påverkar rotationsvinkeln"

#. :src: Socket description from node group Rotate Hair Curves, file procedural_hair_node_assets.blend
msgid "Rotation axis (default: tangent at root)"
msgstr "Rotationsaxel (standard: tangent vid roten)"

#. :src: Socket description from node group Rotate Hair Curves, file procedural_hair_node_assets.blend
msgid "Random offset to the rotation angle per curve"
msgstr "Slumpmässig förskjutning av rotationsvinkeln per kurva"

#. :src: Socket name from node group Rotate Hair Curves, file procedural_hair_node_assets.blend
msgid "Lock Ends"
msgstr "Lås ändpunkter"

#. :src: Socket description from node group Rotate Hair Curves, file procedural_hair_node_assets.blend
msgid "Lock rotation to the axis between the curve ends"
msgstr "Lås rotationen till axeln mellan kurvans ändpunkter"
