#. :src: bpy.types.AreaLight.shadow_buffer_clip_start
#. :src: bpy.types.PointLight.shadow_buffer_clip_start
#. :src: bpy.types.SpotLight.shadow_buffer_clip_start
#. :src: bpy.types.SunLight.shadow_buffer_clip_start
msgid "Shadow Buffer Clip Start"
msgstr "Skuggbuffertens klippstart"

#. :src: bpy.types.AreaLight.shadow_maximum_resolution
#. :src: bpy.types.PointLight.shadow_maximum_resolution
#. :src: bpy.types.SpotLight.shadow_maximum_resolution
#. :src: bpy.types.SunLight.shadow_maximum_resolution
#. :src: bpy.types.World.sun_shadow_maximum_resolution
msgid "Shadows Resolution Limit"
msgstr "Gräns för skuggupplösning"

#. :src: bpy.types.AreaLight.shadow_soft_size
#. :src: bpy.types.PointLight.shadow_soft_size
#. :src: bpy.types.SpotLight.shadow_soft_size
#. :src: bpy.types.SunLight.shadow_soft_size
msgid "Shadow Soft Size"
msgstr "Mjuk skuggstorlek"

#. :src: bpy.types.AreaLight.shadow_soft_size
#. :src: bpy.types.PointLight.shadow_soft_size
#. :src: bpy.types.SpotLight.shadow_soft_size
#. :src: bpy.types.SunLight.shadow_soft_size
msgid "Light size for ray shadow sampling (Raytraced shadows)"
msgstr "Ljusstorlek för sampling av strålspårade skuggor"

#. :src: bpy.types.AreaLight.shape
msgid "Shape of the area Light"
msgstr "Områdesljusets form"

#. :src: bpy.types.PointLight
msgid "Omnidirectional point Light"
msgstr "Omnidirektionellt punktljus"

#. :src: bpy.types.PointLight.use_soft_falloff
#. :src: bpy.types.SpotLight.use_soft_falloff
msgid "Soft Falloff"
msgstr "Mjukt avtagande"

#. :src: bpy.types.PointLight.use_soft_falloff
#. :src: bpy.types.SpotLight.use_soft_falloff
msgid ""
"Apply falloff to avoid sharp edges when the light geometry intersects with "
"other objects"
msgstr ""
"Tillämpa avtagande för att undvika skarpa kanter när ljusgeometrin korsar "
"andra objekt"

#. :src: bpy.types.SpotLight
msgid "Spot Light"
msgstr "Strålkastare"

#. :src: bpy.types.SpotLight.energy
msgid ""
"The energy this light would emit over its entire area if it wasn't limited "
"by the spot angle"
msgstr ""
"Den energi som detta ljus skulle avge över hela sin yta om det inte "
"begränsades av strålkastarvinkeln"

#. :src: bpy.types.SpotLight.spot_blend
msgid "Spot Blend"
msgstr "Strålkastarens övergång"

#. :src: bpy.types.SpotLight.spot_blend
msgid "The softness of the spotlight edge"
msgstr "Hur mjuk strålkastarens kant är"

#. :src: bpy.types.SpotLight.spot_size
#: scripts/addons_core/cycles/ui.py:1609
msgid "Spot Size"
msgstr "Strålkastarstorlek"

#. :src: bpy.types.SpotLight.use_square
msgid "Cast a square spot light shape"
msgstr "Skapa en kvadratisk strålkastarform"

#. :src: bpy.types.SunLight
msgid "Sun Light"
msgstr "Solljus"

#. :src: bpy.types.SunLight
msgid "Constant direction parallel ray Light"
msgstr "Parallellstrålande ljus med fast riktning"

#. :src: bpy.types.SunLight.energy
msgid "Sunlight strength in watts per meter squared (W/m²)"
msgstr "Solljusstyrka i watt per kvadratmeter (W/m²)"

#. :src: bpy.types.SunLight.shadow_cascade_count
msgid "Cascade Count"
msgstr "Antal kaskader"

#. :src: bpy.types.SunLight.shadow_cascade_exponent
msgid "Higher value increase resolution towards the viewpoint"
msgstr "Högre värden ökar upplösningen mot synvinkeln"

#. :src: bpy.types.SunLight.shadow_cascade_fade
msgid "Cascade Fade"
msgstr "Kaskadtoning"

#. :src: bpy.types.SunLight.shadow_cascade_max_distance
msgid "Cascade Max Distance"
msgstr "Kaskadens längsta avstånd"
