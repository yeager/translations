#. :src: bpy.types.Library
msgid "External .blend file from which data is linked"
msgstr "Extern .blend-fil från vilken data länkas"

#. :src: bpy.types.Library.filepath
#. :src: bpy.types.LibraryWeakReference.filepath
msgid "Path to the library .blend file"
msgstr "Sökväg till bibliotekets .blend-fil"

#. :src: bpy.types.Library.is_editable
msgid ""
"Datablocks in this library are editable despite being linked. Used by brush "
"assets and their dependencies."
msgstr ""
"Datablocken i detta bibliotek är redigerbara trots att de är länkade. "
"Används av penselresurser och deras beroenden."

#. :src: bpy.types.Library.needs_liboverride_resync
msgid "Library Overrides Need resync"
msgstr "Biblioteksåsidosättningar måste omsynkroniseras"

#. :src: bpy.types.Library.needs_liboverride_resync
msgid ""
"True if this library contains library overrides that are linked in current "
"blendfile, and that had to be recursively resynced on load (it is "
"recommended to open and re-save that library blendfile then)"
msgstr ""
"Sant om detta bibliotek innehåller biblioteksåsidosättningar som är länkade "
"i den aktuella blendfilen och måste synkroniseras rekursivt vid inläsning "
"(öppna och spara i så fall om bibliotekets blendfil)"

#. :src: bpy.types.Library.version
msgid "Version of Blender the library .blend was saved with"
msgstr "Blender-version som bibliotekets .blend-fil sparades med"
