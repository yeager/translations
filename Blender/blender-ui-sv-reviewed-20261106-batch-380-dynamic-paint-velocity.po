#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_alpha
msgid "Multiply brush influence by velocity color ramp alpha"
msgstr ""
"Multiplicera penselns påverkan med alfavärdet i hastighetsfärggradienten"

#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_color
msgid "Replace Color"
msgstr "Ersätt färg"

#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_color
msgid "Replace brush color by velocity color ramp"
msgstr "Ersätt penselfärgen med hastighetsfärggradienten"

#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_depth
msgid "Multiply Depth"
msgstr "Multiplicera djup"

#. :src: bpy.types.DynamicPaintBrushSettings.use_velocity_depth
msgid ""
"Multiply brush intersection depth (displace, waves) by velocity ramp alpha"
msgstr ""
"Multiplicera penselns skärningsdjup (förskjutning, vågor) med alfavärdet i "
"hastighetsfärggradienten"

#. :src: bpy.types.DynamicPaintBrushSettings.velocity_max
#. :src: bpy.types.Itasc.velocity_max
msgid "Max Velocity"
msgstr "Maximal hastighet"

#. :src: bpy.types.DynamicPaintBrushSettings.velocity_max
msgid "Velocity considered as maximum influence (Blender units per frame)"
msgstr ""
"Hastigheten som räknas som maximal påverkan (Blender-enheter per bildruta)"

#. :src: bpy.types.DynamicPaintBrushSettings.velocity_ramp
msgid "Velocity Color Ramp"
msgstr "Hastighetsfärggradient"

#. :src: bpy.types.DynamicPaintBrushSettings.velocity_ramp
msgid "Color ramp used to define brush velocity effect"
msgstr "Färggradient som definierar penselns hastighetseffekt"

#. :src: bpy.types.DynamicPaintBrushSettings.wave_clamp
msgid "Clamp Waves"
msgstr "Begränsa vågor"
