# Swedish Blender UI review delta — image editor, image data and textures
msgid ""
msgstr ""
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"

#: source/blender/blenkernel/intern/image_save.cc:664
msgid "When saving a tiled image, the path '%s' must contain a valid UDIM marker"
msgstr "När du sparar en plattindelad bild måste sökvägen ”%s” innehålla en giltig UDIM-markör"

#: source/blender/editors/mesh/editmesh_path.cc:959
#: source/blender/editors/uvedit/uvedit_path.cc:863
msgid "Path selection requires two matching elements to be selected"
msgstr "Sökvägsmarkering kräver att två matchande element är markerade"

#: source/blender/editors/space_image/image_ops.cc:2371
msgid "Can only save sequence on image sequences"
msgstr "Det går bara att spara en sekvens som en bildsekvens"

#: source/blender/editors/space_image/image_ops.cc:2531
msgid "Image cannot be saved, no valid file path: \"%s\""
msgstr "Bilden kan inte sparas: sökvägen ”%s” är inte giltig"

#: source/blender/editors/space_image/image_ops.cc:2176
#: source/blender/editors/space_image/image_ops.cc:2265
msgid "Cannot save image while rendering"
msgstr "Det går inte att spara bilden under pågående rendering"

#: source/blender/editors/uvedit/uvedit_clipboard.cc:361
msgid "Skipped %d of %d island(s), geometry was too complicated to detect a match"
msgstr "Hoppade över %d av %d UV-ö(ar), eftersom geometrin var för komplex för att hitta en matchning"
