msgstr ""
"Visa endast sloten för det aktiva objektet. Annars visas alla åtgärdens "
"slotar."

msgid "Vertex"
msgstr "Hörn"

msgid "Cycle through the rainbow, trying to give each curve a unique color"
msgstr "Växla genom regnbågens färger och försök ge varje kurva en unik färg."

msgid "Cycles F-Modifier"
msgstr "Cycles-F-modifierare"

msgid "After Cycles"
msgstr "Cykler efter"

msgid "Maximum number of cycles to allow after last keyframe (0 = infinite)"
msgstr ""
"Högsta antal cykler som tillåts efter sista nyckelbildrutan (0 = oändligt)"

msgid "Before Cycles"
msgstr "Cykler före"

msgid "Maximum number of cycles to allow before first keyframe (0 = infinite)"
msgstr ""
"Högsta antal cykler som tillåts före första nyckelbildrutan (0 = oändligt)"

msgid "Cycling mode to use after last keyframe"
msgstr "Cykelläge som ska användas efter sista nyckelbildrutan"

msgid "No Cycles"
msgstr "Inga cykler"

msgid "Cycling mode to use before first keyframe"
msgstr "Cykelläge som ska användas före första nyckelbildrutan"

