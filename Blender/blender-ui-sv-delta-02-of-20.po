msgstr "Välj synligheten för online- och offlinetillgångar"

msgid "Online and Offline"
msgstr "Online och offline"

msgid ""
"Show assets that are both hosted online (need downloading) and available on "
"disk already"
msgstr ""
"Visa tillgångar som både finns online (måste hämtas) och redan är "
"tillgängliga på disken"

msgid "Online Only"
msgstr "Endast online"

msgid "Show only assets that need downloading (requires internet access)"
msgstr "Visa endast tillgångar som måste hämtas (kräver internetanslutning)"

msgid "Offline Only"
msgstr "Endast offline"

msgid ""
"Show only assets that are available on disk already (no internet access "
"needed)"
msgstr ""
"Visa endast tillgångar som redan finns tillgängliga på disken (ingen "
"internetanslutning behövs)"

msgid "Catalog Visibility"
msgstr "Katalogsynlighet"

msgid "Which assets to show based on catalog filter"
msgstr "Vilka tillgångar som ska visas utifrån katalogfiltret"

msgid "Show assets from all catalogs"
msgstr "Visa tillgångar från alla kataloger"

msgid "Show assets from the active catalog only"
msgstr "Visa endast tillgångar från den aktiva katalogen"

msgid "Show assets not assigned to any catalog"
msgstr "Visa tillgångar som inte är tilldelade någon katalog"

