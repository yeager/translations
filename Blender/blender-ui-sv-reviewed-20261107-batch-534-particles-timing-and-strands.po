#. :src: bpy.types.ParticleSettings.time_tweak
msgid "A multiplier for physics timestep (1.0 means one frame = 1/25 seconds)"
msgstr ""
"En multiplikator för fysikens tidssteg (1,0 innebär att en bildruta = 1/25 "
"sekunder)"

#. :src: bpy.types.ParticleSettings.timestep
#. :src: bpy.types.ParticleSystem.dt_frac
msgid "Timestep"
msgstr "Tidssteg"

#. :src: bpy.types.ParticleSettings.timestep
msgid "The simulation timestep per frame (seconds per frame)"
msgstr "Simuleringens tidssteg per bildruta (sekunder per bildruta)"

#. :src: bpy.types.ParticleSettings.tip_radius
msgid "Tip Diameter"
msgstr "Spetsdiameter"

#. :src: bpy.types.ParticleSettings.tip_radius
msgid "Strand diameter width at the tip"
msgstr "Stråets diameter vid spetsen"

#. :src: bpy.types.ParticleSettings.trail_count
msgid "Trail Count"
msgstr "Antal spår"

#. :src: bpy.types.ParticleSettings.trail_count
msgid "Number of trail particles"
msgstr "Antal spårpartiklar"

