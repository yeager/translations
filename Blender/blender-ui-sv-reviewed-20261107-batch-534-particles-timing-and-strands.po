#. :src: bpy.types.ParticleSettings.subframes
msgid ""
"Subframes to simulate for improved stability and finer granularity "
"simulations (dt = timestep / (subframes + 1))"
msgstr ""
"Delbildrutor att simulera för bättre stabilitet och mer detaljerade "
"simuleringar (dt = tidssteg / (delbildrutor + 1))"

#. :src: bpy.types.ParticleSettings.tangent_factor
msgid "Let the surface tangent give the particle a starting velocity"
msgstr "Låt yttangenten ge partikeln en starthastighet"

#. :src: bpy.types.ParticleSettings.tangent_phase
msgid "Rotate the surface tangent"
msgstr "Rotera yttangenten"

