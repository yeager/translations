#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Attach Hair Curves to Surface"
msgstr "Fäst hårkurvor på yta"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Attaches hair curves to a surface mesh"
msgstr "Fäster hårkurvor vid ett ytmesh"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface UV Coordinate"
msgstr "Ytans UV-koordinat"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Hair Attachment Info, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Surface Normal"
msgstr "Ytnormal"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface normal at the attachment point"
msgstr "Ytnormal vid infästningspunkten"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface geometry to attach hair curves to"
msgstr "Ytgeometri som hårkurvor ska fästas vid"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Surface Object to attach to (needs to have matching transforms)"
msgstr "Ytobjekt att fästa vid (måste ha matchande transformationer)"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Hair Attachment Info, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Surface UV map used for attachment"
msgstr "Ytans UV-karta som används för infästning"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Surface Rest Position"
msgstr "Ytans viloposition"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Set the surface mesh into its rest position before attachment"
msgstr "Sätt ytmeshen i dess viloposition före infästningen"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Sample Attachment UV"
msgstr "Provta infästnings-UV"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Sample the surface UV map at the attachment point"
msgstr "Provta ytans UV-karta vid infästningspunkten"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Snap the root of each curve to the closest surface point"
msgstr "Snäpp varje kurvas rot till närmaste punkt på ytan"

#. :src: Socket name from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Align to Surface Normal"
msgstr "Rikta in efter ytnormal"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Align the curve to the surface normal (needs a guide as reference)"
msgstr "Rikta in kurvan efter ytnormalen (kräver en guide som referens)"

#. :src: Socket description from node group Attach Hair Curves to Surface, file procedural_hair_node_assets.blend
msgid "Blend deformation along each curve from the root"
msgstr "Blanda deformationen längs varje kurva från roten"

#. :src: Socket description from node group Blend Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Braid Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Curl Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Frizz Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Redistribute Curve Points, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Restore Curve Segment Length, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Roll Hair Curves, file procedural_hair_node_assets.blend
msgid "Factor to blend overall effect"
msgstr "Faktor för den övergripande effekten"

#. :src: Socket description from node group Blend Hair Curves, file procedural_hair_node_assets.blend
msgid "Radius to select neighbors for blending"
msgstr "Radie för att välja närliggande kurvor för blandning"

#. :src: Socket description from node group Blend Hair Curves, file procedural_hair_node_assets.blend
msgid "Amount of neighbors used for blending"
msgstr "Antal närliggande kurvor som används för blandning"

#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Braid Hair Curves"
msgstr "Fläta hårkurvor"

#. :src: Socket name from node group Braid Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Create Guide Index Map, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Curl Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Guide Index"
msgstr "Guideindex"

#. :src: Socket description from node group Braid Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Curl Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Duplicate Hair Curves, file procedural_hair_node_assets.blend
msgid "Guide index map that was used for the operation"
msgstr "Guideindexkarta som användes för operationen"

#. :src: Socket name from node group Braid Hair Curves, file procedural_hair_node_assets.blend
msgid "Flare Parameter"
msgstr "Utsvängningsparameter"

#. :src: Socket description from node group Braid Hair Curves, file procedural_hair_node_assets.blend
msgid "Parameter from 0 to 1 along the flare"
msgstr "Parameter från 0 till 1 längs utsvängningen"

#. :src: Socket name from node group Braid Hair Curves, file procedural_hair_node_assets.blend
msgid "Strand Index"
msgstr "Stråindex"

#. :src: Socket description from node group Braid Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Curl Hair Curves, file procedural_hair_node_assets.blend
msgid "Guide index map to be used. This input has priority"
msgstr "Guideindexkarta som ska användas. Den här inmatningen har företräde"

#. :src: Socket name from node group Braid Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Create Guide Index Map, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Curl Hair Curves, file procedural_hair_node_assets.blend
msgid "Guide Distance"
msgstr "Guideavstånd"

#. :src: Socket name from node group Braid Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Create Guide Index Map, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Curl Hair Curves, file procedural_hair_node_assets.blend
msgid "Guide Mask"
msgstr "Guidemask"

#. :src: Socket description from node group Braid Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Create Guide Index Map, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Curl Hair Curves, file procedural_hair_node_assets.blend
msgid "Mask for which curves are eligible to be selected as guides"
msgstr "Mask för vilka kurvor som kan väljas som guider"

#. :src: Socket name from node group Braid Hair Curves, file procedural_hair_node_assets.blend
msgid "Flare Length"
msgstr "Utsvängningens längd"

#. :src: Socket description from node group Braid Hair Curves, file procedural_hair_node_assets.blend
msgid "Length of the flare at the end of the braid"
msgstr "Längden på utsvängningen i slutet av flätan"

#. :src: Socket name from node group Braid Hair Curves, file procedural_hair_node_assets.blend
msgid "Flare Opening"
msgstr "Utsvängningens öppning"

#. :src: Socket description from node group Braid Hair Curves, file procedural_hair_node_assets.blend
msgid "Opening radius of the flare at the tip of the braid"
msgstr "Öppningsradie för utsvängningen vid flätans spets"

#. :src: Socket name from node group Braid Hair Curves, file procedural_hair_node_assets.blend
msgid "Hair Tie Scale"
msgstr "Hårsnoddens skala"

#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Clump Hair Curves"
msgstr "Samla hårkurvor"

#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Tip Spread"
msgstr "Spridning vid spetsarna"

#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Clump Offset"
msgstr "Klumpförskjutning"

#. :src: Socket name from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Distance Falloff"
msgstr "Avtagande med avstånd"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Falloff distance for the clumping effect (0 means no falloff)"
msgstr "Avstånd där klumpningseffekten avtar (0 innebär inget avtagande)"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
msgid "Distance threshold for the falloff around the guide"
msgstr "Avståndströskel för avtagandet kring guiden"

#. :src: Socket description from node group Clump Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Generate Hair Curves, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Interpolate Hair Curves, file procedural_hair_node_assets.blend
msgid "Random seed for the operation"
msgstr "Slumpfrö för operationen"

#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Create Guide Index Map"
msgstr "Skapa guideindexkarta"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid ""
"Creates an attribute that maps each curve to its nearest guide via index"
msgstr ""
"Skapar ett attribut som kopplar varje kurva till dess närmaste guide via ett "
"index"

#. :src: Socket name from node group Create Guide Index Map, file procedural_hair_node_assets.blend
msgid "Guide Selection"
msgstr "Markering av guider"

#. :src: Socket description from node group Create Guide Index Map, file procedural_hair_node_assets.blend
msgid "Minimum distance between two guides"
msgstr "Minsta avstånd mellan två guider"

#. :src: Socket description from node group Create Guide Index Map, file procedural_hair_node_assets.blend
msgid "ID to group curves together for guide map creation"
msgstr "ID för att gruppera kurvor vid skapandet av guideindexkartan"

#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Curl Hair Curves"
msgstr "Locka hårkurvor"

#. :src: Socket name from node group Curl Hair Curves, file procedural_hair_node_assets.blend
msgid "Curl Start"
msgstr "Start för lockning"

#. :src: Socket description from node group Curl Hair Curves, file procedural_hair_node_assets.blend
msgid "Factor for the radius at the curl start"
msgstr "Radiefaktor vid lockningens start"

#. :src: Socket description from node group Curl Hair Curves, file procedural_hair_node_assets.blend
msgid "Factor for the radius at the curl end"
msgstr "Radiefaktor vid lockningens slut"

#. :src: Socket description from node group Curl Hair Curves, file procedural_hair_node_assets.blend
msgid "Amount of random offset per curve"
msgstr "Mängd slumpmässig förskjutning per kurva"
