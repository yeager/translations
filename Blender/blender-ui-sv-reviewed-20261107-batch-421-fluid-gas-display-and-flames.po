#. :src: bpy.types.FluidDomainSettings.display_thickness
msgid "Thickness of smoke display in the viewport"
msgstr "Tjocklek på rökvisningen i vyporten"

#. :src: bpy.types.FluidDomainSettings.dissolve_speed
msgid "Dissolve Speed"
msgstr "Upplösningshastighet"

#. :src: bpy.types.FluidDomainSettings.dissolve_speed
msgid ""
"Determine how quickly the smoke dissolves (lower value makes smoke disappear "
"faster)"
msgstr ""
"Anger hur snabbt röken löses upp (lägre värde får röken att försvinna "
"snabbare)"

#. :src: bpy.types.FluidDomainSettings.domain_resolution
msgid "res"
msgstr "res"

#. :src: bpy.types.FluidDomainSettings.export_manta_script
msgid ""
"Generate and export Mantaflow script from current domain settings during "
"bake. This is only needed if you plan to analyze the cache (e.g. view grids, "
"velocity vectors, particles) in Mantaflow directly (outside of Blender) "
"after baking the simulation."
msgstr ""
"Generera och exportera Mantaflow-skript från de aktuella "
"domäninställningarna vid bakning. Det behövs endast om du efteråt vill "
"analysera cachen direkt i Mantaflow (utanför Blender), till exempel visa "
"rutnät, hastighetsvektorer eller partiklar."

#. :src: bpy.types.FluidDomainSettings.flame_grid
msgid "Flame Grid"
msgstr "Lågrutnät"

#. :src: bpy.types.FluidDomainSettings.flame_grid
msgid "Smoke flame grid"
msgstr "Rök- och lågrutnät"

#. :src: bpy.types.FluidDomainSettings.flame_ignition
msgid ""
"Minimum temperature of the flames (higher value results in faster rising "
"flames)"
msgstr ""
"Lägsta temperatur för lågorna (högre värde får lågorna att stiga snabbare)"

#. :src: bpy.types.FluidDomainSettings.flame_max_temp
msgid ""
"Maximum temperature of the flames (higher value results in faster rising "
"flames)"
msgstr ""
"Högsta temperatur för lågorna (högre värde får lågorna att stiga snabbare)"

#. :src: bpy.types.FluidDomainSettings.flame_vorticity
msgid "Additional vorticity for the flames"
msgstr "Ytterligare vorticitet för lågorna"

#. :src: bpy.types.FluidDomainSettings.flip_ratio
#: scripts/startup/bl_ui/properties_physics_fluid.py:501
msgid "FLIP Ratio"
msgstr "FLIP-förhållande"

#. :src: bpy.types.FluidDomainSettings.flip_ratio
msgid ""
"PIC/FLIP Ratio. A value of 1.0 will result in a completely FLIP based "
"simulation. Use a lower value for simulations which should produce smaller "
"splashes."
msgstr ""
"PIC/FLIP-förhållande. Ett värde på 1,0 resulterar i en helt FLIP-baserad "
"simulering. Använd ett lägre värde för simuleringar som ska ge mindre stänk."

#. :src: bpy.types.FluidDomainSettings.fluid_group
msgid "Limit fluid objects to this collection"
msgstr "Begränsa vätskeobjekt till denna samling"

#. :src: bpy.types.FluidDomainSettings.force_collection
msgid "Limit forces to this collection"
msgstr "Begränsa krafter till denna samling"
