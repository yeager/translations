#. :src: bpy.types.FluidDomainSettings.slice_axis:'Z'
#. :src: bpy.types.VolumeDisplay.slice_axis:'Z'
msgid "Slice along the Z axis"
msgstr "Skiva längs Z-axeln"

#. :src: bpy.types.FluidDomainSettings.slice_depth
