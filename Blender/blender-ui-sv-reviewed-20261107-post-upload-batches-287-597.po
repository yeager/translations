"Lower mesh concavity bound (high values tend to smoothen and fill out "
"concave regions)"
msgstr ""
"Nedre konkavitetsgräns för mesh (höga värden tenderar att jämna ut och fylla "
"ut konkava områden)"

#. :src: bpy.types.FluidDomainSettings.mesh_concave_upper
msgid "Upper Concavity"
msgstr "Övre konkavitet"

