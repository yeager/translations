msgid "Clamp the indirect lighting intensity to reduce noise (0 to disable)"
msgstr ""
"Begränsa det indirekta ljusets intensitet för att minska brus (0 för att "
"inaktivera)"

#. :src: bpy.types.LightProbeVolume.dilation_radius
msgid "Dilation Radius"
msgstr "Utvidgningsradie"

#. :src: bpy.types.LightProbeVolume.dilation_radius
msgid ""
"Radius in grid sample to search valid grid samples to copy into invalid grid "
"samples"
msgstr ""
"Radie inom rutnätsprovet för att söka efter giltiga rutnätsprov att kopiera "
"till ogiltiga rutnätsprov"

