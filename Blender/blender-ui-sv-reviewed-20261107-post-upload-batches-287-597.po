msgstr "Ändra intensiteten hos belysningen som fångas av denna ljussond"

#. :src: bpy.types.LightProbeVolume.normal_bias
msgid "Normal Bias"
msgstr "Normalförskjutning"

#. :src: bpy.types.LightProbeVolume.normal_bias
msgid ""
"Offset sampling of the irradiance grid in the surface normal direction to "
"reduce light bleeding"
msgstr ""
"Förskjut provtagningen av irradiansgallret i ytans normalriktning för att "
"minska ljusläckage"

#. :src: bpy.types.LightProbeVolume.resolution_x
