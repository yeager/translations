msgid "Bake light bounces from light sources for more accurate lighting"
msgstr "Baka ljusstudsar från ljuskällor för mer exakt belysning"

#. :src: bpy.types.LightProbeVolume.capture_world
msgid "Capture World"
msgstr "Fånga omvärldsljus"

#. :src: bpy.types.LightProbeVolume.capture_world
msgid ""
"Bake incoming light from the world instead of just the visibility for more "
"accurate lighting, but lose correct blending to surrounding irradiance "
"volumes"
msgstr ""
"Baka inkommande ljus från omvärlden i stället för enbart synlighet för mer "
"exakt belysning, men korrekt blandning med omgivande irradiansvolymer går "
"förlorad"

#. :src: bpy.types.LightProbeVolume.clamp_direct
#. :src: bpy.types.CyclesRenderSettings.sample_clamp_direct
msgid "Clamp Direct"
msgstr "Begränsa direktljus"

#. :src: bpy.types.LightProbeVolume.clamp_direct
msgid "Clamp the direct lighting intensity to reduce noise (0 to disable)"
msgstr ""
"Begränsa direktljusets intensitet för att minska brus (0 för att inaktivera)"

#. :src: bpy.types.LightProbeVolume.clamp_indirect
#. :src: bpy.types.CyclesRenderSettings.sample_clamp_indirect
msgid "Clamp Indirect"
msgstr "Begränsa indirekt ljus"

