msgstr "Baksidesgallring"

#. :src: bpy.types.Material.use_backface_culling
#. :src: bpy.types.View3DShading.show_backface_culling
msgid "Use back face culling to hide the back side of faces"
msgstr "Använd baksidesgallring för att dölja ytornas baksidor"

#. :src: bpy.types.Material.use_backface_culling_lightprobe_volume
msgid "Light Probe Volume Backface Culling"
msgstr "Baksidesgallring för volymljussond"

#. :src: bpy.types.Material.use_backface_culling_lightprobe_volume
msgid ""
"Consider material single sided for light probe volume capture. Additionally "
"helps rejecting probes inside the object to avoid light leaks."
msgstr ""
"Betrakta materialet som enkelsidigt när volymljussonden fångar in data. Det "
"hjälper även till att avvisa sonder inuti objektet och undvika ljusläckage."

#. :src: bpy.types.Material.use_backface_culling_shadow
msgid "Shadow Backface Culling"
msgstr "Baksidesgallring för skuggor"

#. :src: bpy.types.Material.use_backface_culling_shadow
msgid "Use back face culling when casting shadows"
msgstr "Använd baksidesgallring när skuggor kastas"

#. :src: bpy.types.Material.use_preview_world
msgid "Preview World"
msgstr "Förhandsgranskning av världen"

#. :src: bpy.types.Material.use_preview_world
msgid "Use the current world background to light the preview render"
msgstr ""
"Använd den aktuella världens bakgrund för att belysa förhandsgranskningen"

#. :src: bpy.types.Material.use_thickness_from_shadow
msgid "Thickness From Shadow"
msgstr "Tjocklek från skugga"

#. :src: bpy.types.Material.use_thickness_from_shadow
msgid ""
"Use the shadow maps from shadow casting lights to refine the thickness "
