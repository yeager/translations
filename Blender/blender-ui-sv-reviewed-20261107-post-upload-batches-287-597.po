#. :src: bpy.types.Material.thickness_mode
#. :src: bpy.types.SolidifyModifier.nonmanifold_thickness_mode
#: source/blender/modifiers/intern/MOD_solidify.cc:91
msgid "Thickness Mode"
msgstr "Tjockleksläge"

#. :src: bpy.types.Material.thickness_mode
msgid "Approximation used to model the light interactions inside the object"
msgstr ""
"Approximation som används för att modellera ljusinteraktionerna inuti "
"objektet"

#. :src: bpy.types.Material.thickness_mode:'SPHERE'
msgid ""
"Approximate the object as a sphere whose diameter is equal to the thickness "
"defined by the node tree"
msgstr ""
"Approximera objektet som en sfär vars diameter är lika med den tjocklek som "
"definieras av nodträdet"

#. :src: bpy.types.Material.thickness_mode:'SLAB'
msgid "Slab"
msgstr "Platta"

#. :src: bpy.types.Material.thickness_mode:'SLAB'
msgid ""
"Approximate the object as an infinite slab of thickness defined by the node "
"tree"
msgstr ""
"Approximera objektet som en oändlig platta med en tjocklek som definieras av "
"nodträdet"

#. :src: bpy.types.Material.use_backface_culling
