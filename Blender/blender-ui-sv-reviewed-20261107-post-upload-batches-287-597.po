msgid ""
"Distance around the probe volume that will be considered during the bake"
msgstr "Avstånd runt sondvolymen som kommer att beaktas under bakningen"

#. :src: bpy.types.LightProbeVolume.capture_emission
msgid "Capture Emission"
msgstr "Fånga emission"

#. :src: bpy.types.LightProbeVolume.capture_emission
msgid "Bake emissive surfaces for more accurate lighting"
msgstr "Baka emitterande ytor för mer exakt belysning"

#. :src: bpy.types.LightProbeVolume.capture_indirect
msgid "Capture Indirect"
msgstr "Fånga indirekt ljus"

