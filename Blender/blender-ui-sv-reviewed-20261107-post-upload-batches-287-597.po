#. :src: bpy.types.FluidDomainSettings.vector_display_type:'NEEDLE'
msgid "Needle"
msgstr "Nål"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'NEEDLE'
msgid "Display vectors as needles"
msgstr "Visa vektorer som nålar"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'STREAMLINE'
msgid "Display vectors as streamlines"
msgstr "Visa vektorer som strömlinjer"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'MAC'
msgid "Display vector field as MAC grid"
msgstr "Visa vektorfält som MAC-rutnät"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FLUID_VELOCITY'
msgid "Fluid Velocity"
msgstr "Vätskehastighet"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FLUID_VELOCITY'
msgid "Velocity field of the fluid domain"
msgstr "Hastighetsfält för vätskedomänen"

#. :src: bpy.types.FluidDomainSettings.vector_field:'GUIDE_VELOCITY'
msgid "Guide Velocity"
msgstr "Styrhastighet"

#. :src: bpy.types.FluidDomainSettings.vector_field:'GUIDE_VELOCITY'
msgid "Guide velocity field of the fluid domain"
msgstr "Styrhastighetsfältet i vätskedomänen"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FORCE'
msgid "Force field of the fluid domain"
msgstr "Kraftfält för vätskedomänen"

#. :src: bpy.types.FluidDomainSettings.vector_scale
msgid "Multiplier for scaling the vectors"
msgstr "Multiplikator för skalning av vektorerna"

#. :src: bpy.types.FluidDomainSettings.vector_scale_with_magnitude
msgid "Magnitude"
msgstr "Belopp"

#. :src: bpy.types.FluidDomainSettings.vector_scale_with_magnitude
msgid "Scale vectors with their magnitudes"
msgstr "Skala vektorer efter deras belopp"

#. :src: bpy.types.FluidDomainSettings.velocity_scale
#. :src: bpy.types.Volume.velocity_scale
#. :src: bpy.types.MeshSequenceCacheModifier.velocity_scale
msgid "Velocity Scale"
msgstr "Hastighetsskala"

#. :src: bpy.types.FluidDomainSettings.velocity_scale
#. :src: bpy.types.Volume.velocity_scale
msgid "Factor to control the amount of motion blur"
msgstr "Faktor för att kontrollera mängden rörelseoskärpa"

#. :src: bpy.types.FluidDomainSettings.viscosity_base
msgid "Viscosity Base"
msgstr "Viskositetsbas"

#. :src: bpy.types.FluidDomainSettings.viscosity_base
msgid ""
"Viscosity setting: value that is multiplied by 10 to the power of "
"(exponent*-1)"
msgstr ""
"Viskositetsinställning: ett värde som multipliceras med 10 upphöjt till "
"(exponent * -1)"

#. :src: bpy.types.FluidDomainSettings.viscosity_exponent
msgid "Viscosity Exponent"
msgstr "Exponent för viskositet"

#. :src: bpy.types.FluidDomainSettings.viscosity_exponent
msgid ""
"Negative exponent for the viscosity value (to simplify entering small values "
"e.g. 5*10^-6)"
msgstr ""
"Negativ exponent för viskositetsvärdet (för att förenkla inmatning av små "
"värden, t.ex. 5*10^-6)"

#. :src: bpy.types.FluidDomainSettings.viscosity_value
msgid ""
"Viscosity of liquid (higher values result in more viscous fluids, a value of "
"0 will still apply some viscosity)"
msgstr ""
"Vätskans viskositet (högre värden ger mer trögflytande vätskor, ett värde på "
"0 ger fortfarande viss viskositet)"

#. :src: bpy.types.FluidDomainSettings.vorticity
msgid "Amount of turbulence and rotation in smoke"
msgstr "Mängd turbulens och rotation i rök"

#. :src: bpy.types.FluidDomainSettings.use_color_ramp
#. :src: bpy.types.PHYSICS_PT_viewport_display_color
msgid "Grid Display"
msgstr "Rutnätsvisning"

#. :src: bpy.types.FluidDomainSettings.use_color_ramp
msgid ""
"Render a simulation field while mapping its voxels values to the colors of a "
"ramp or using a predefined color code"
msgstr ""
"Rendera ett simuleringsfält genom att färgkartlägga dess voxelvärden med "
"färgerna i en färggradient eller använda en fördefinierad färgkod"

#. :src: bpy.types.FluidDomainSettings.use_diffusion
msgid "Use Diffusion"
msgstr "Använd diffusion"

#. :src: bpy.types.FluidDomainSettings.use_diffusion
msgid "Enable fluid diffusion settings (e.g. viscosity, surface tension)"
msgstr ""
"Aktivera inställningar för vätskediffusion (t.ex. viskositet, ytspänning)"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke
msgid "Let smoke disappear over time"
msgstr "Låt röken försvinna över tid"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke_log
msgid "Logarithmic Dissolve"
msgstr "Logaritmisk upplösning"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke_log
msgid ""
"Dissolve smoke in a logarithmic fashion. Dissolves quickly at first, but "
"lingers longer."
msgstr ""
"Lös upp röken logaritmiskt. Den löses först upp snabbt men dröjer kvar "
"längre."

#. :src: bpy.types.FluidDomainSettings.use_flip_particles
msgid "Create liquid particle system"
msgstr "Skapa vätskepartikelsystem"

#. :src: bpy.types.FluidDomainSettings.use_foam_particles
#: scripts/startup/bl_ui/properties_physics_fluid.py:947
#: source/blender/modifiers/intern/MOD_ocean.cc:539
msgid "Foam"
msgstr "Skum"

#. :src: bpy.types.FluidDomainSettings.use_foam_particles
msgid "Create foam particle system"
msgstr "Skapa skumpartikelsystem"

#. :src: bpy.types.FluidDomainSettings.use_fractions
#: scripts/startup/bl_ui/properties_physics_fluid.py:519
msgid "Fractional Obstacles"
msgstr "Fraktionella hinder"

#. :src: bpy.types.FluidDomainSettings.use_fractions
msgid "Fractional obstacles improve and smoothen the fluid-obstacle boundary"
msgstr ""
"Fraktionella hinder förbättrar och jämnar ut gränsen mellan vätska och hinder"

#. :src: bpy.types.FluidDomainSettings.use_guide
msgid "Use Guiding"
msgstr "Använd styrning"

#. :src: bpy.types.FluidDomainSettings.use_guide
msgid "Enable fluid guiding"
msgstr "Aktivera vätskestyrning"

#. :src: bpy.types.FluidDomainSettings.use_slice
#. :src: bpy.types.VolumeDisplay.use_slice
msgid "Perform a single slice of the domain object"
msgstr "Visa en enda skiva av domänobjektet"

#. :src: bpy.types.FluidDomainSettings.use_speed_vectors
msgid "Speed Vectors"
msgstr "Hastighetsvektorer"

#. :src: bpy.types.FluidDomainSettings.use_speed_vectors
msgid ""
"Caches velocities of mesh vertices. These will be used (automatically) when "
"rendering with motion blur enabled."
msgstr ""
"Cachelagrar hastigheter för meshens hörnpunkter. De används automatiskt vid "
"rendering med aktiverad rörelseoskärpa."

#. :src: bpy.types.FluidDomainSettings.use_spray_particles
#: scripts/startup/bl_ui/properties_physics_fluid.py:946
msgid "Spray"
msgstr "Spray"

#. :src: bpy.types.FluidDomainSettings.use_spray_particles
msgid "Create spray particle system"
msgstr "Skapa spraypartikelsystem"

#. :src: bpy.types.FluidDomainSettings.use_tracer_particles
msgid "Tracer"
msgstr "Spårare"

#. :src: bpy.types.FluidDomainSettings.use_tracer_particles
msgid "Create tracer particle system"
msgstr "Skapa spårpartikelsystem"

#. :src: bpy.types.FluidDomainSettings.use_viscosity
msgid "Use Viscosity"
msgstr "Använd viskositet"

#. :src: bpy.types.FluidDomainSettings.use_viscosity
msgid "Simulate fluids with high viscosity using a special solver"
msgstr "Simulera vätskor med hög viskositet med en särskild lösare"

#. :src: bpy.types.FluidDomainSettings.time_scale
#. :src: bpy.types.CURVE_OT_extrude.mode:'TIME_SCALE'
#. :src: bpy.types.GRAPH_OT_duplicate.mode:'TIME_SCALE'
#. :src: bpy.types.OBJECT_OT_duplicate.mode:'TIME_SCALE'
#. :src: bpy.types.TRANSFORM_OT_transform.mode:'TIME_SCALE'
#. :src: bpy.types.RigidBodyWorld.time_scale
#: scripts/startup/bl_ui/properties_physics_fluid.py:167
msgid "Time Scale"
msgstr "Tidsskala"

#. :src: bpy.types.FluidDomainSettings.time_scale
msgid "Adjust simulation speed"
msgstr "Justera simuleringshastigheten"

#. :src: bpy.types.FluidDomainSettings.timesteps_max
msgid "Maximum number of simulation steps to perform for one frame"
msgstr "Maximalt antal simuleringssteg som ska utföras för en bildruta"

#. :src: bpy.types.FluidDomainSettings.timesteps_min
msgid "Minimum number of simulation steps to perform for one frame"
msgstr "Minsta antal simuleringssteg som ska utföras för en bildruta"

#. :src: bpy.types.FluidDomainSettings.use_adaptive_domain
#. :src: bpy.types.PHYSICS_PT_adaptive_domain
msgid "Adaptive Domain"
msgstr "Adaptiv domän"

#. :src: bpy.types.FluidDomainSettings.use_adaptive_domain
msgid "Adapt simulation resolution and size to fluid"
msgstr "Anpassa simuleringens upplösning och storlek till vätskan"

#. :src: bpy.types.FluidDomainSettings.use_adaptive_timesteps
msgid "Adaptive Time Steps"
msgstr "Adaptiva tidssteg"

#. :src: bpy.types.FluidDomainSettings.use_adaptive_timesteps
msgid ""
"Automatically decide when to perform multiple simulation steps per frame"
msgstr "Avgör automatiskt när flera simuleringssteg ska utföras per bildruta"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_back
msgid "Enable collisions with back domain border"
msgstr "Aktivera kollisioner med den bakre domängränsen"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_bottom
msgid "Enable collisions with bottom domain border"
msgstr "Aktivera kollisioner med den nedre domängränsen"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_left
msgid "Enable collisions with left domain border"
msgstr "Aktivera kollisioner med den vänstra domängränsen"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_right
msgid "Enable collisions with right domain border"
msgstr "Aktivera kollisioner med den högra domängränsen"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_top
msgid "Enable collisions with top domain border"
msgstr "Aktivera kollisioner med den övre domängränsen"

#. :src: bpy.types.FluidDomainSettings.sndparticle_life_max
msgid "Maximum Lifetime"
msgstr "Maximal livslängd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_life_max
msgid "Highest possible particle lifetime"
msgstr "Högsta möjliga partikellivslängd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_life_min
msgid "Minimum Lifetime"
msgstr "Minsta livslängd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_life_min
msgid "Lowest possible particle lifetime"
msgstr "Lägsta möjliga partikellivslängd"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_energy
msgid "Maximum Kinetic Energy Potential"
msgstr "Maximal potential för rörelseenergi"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_energy
msgid ""
"Upper clamping threshold that indicates the fluid speed where cells no "
"longer emit more particles (higher value results in generally less particles)"
msgstr ""
"Övre begränsningströskel som anger den vätskehastighet där cellerna inte "
"längre avger partiklar (högre värde ger vanligen färre partiklar)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_trappedair
msgid "Maximum Trapped Air Potential"
msgstr "Maximal potential för instängd luft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_trappedair
msgid ""
"Upper clamping threshold for marking fluid cells where air is trapped "
"(higher value results in less marked cells)"
msgstr ""
"Övre begränsningströskel för markering av vätskeceller där luft är instängd "
"(högre värde ger färre markerade celler)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_wavecrest
msgid "Maximum Wave Crest Potential"
msgstr "Maximal vågtoppspotential"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_max_wavecrest
msgid ""
"Upper clamping threshold for marking fluid cells as wave crests (higher "
"value results in less marked cells)"
msgstr ""
"Övre begränsningströskel för markering av vätskeceller som vågtoppar (högre "
"värde ger färre markerade celler)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_energy
msgid "Minimum Kinetic Energy Potential"
msgstr "Minsta potential för rörelseenergi"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_energy
msgid ""
"Lower clamping threshold that indicates the fluid speed where cells start to "
"emit particles (lower values result in generally more particles)"
msgstr ""
"Nedre begränsningströskel som anger den vätskehastighet där cellerna börjar "
"avge partiklar (lägre värde ger vanligen fler partiklar)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_trappedair
msgid "Minimum Trapped Air Potential"
msgstr "Minsta potential för instängd luft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_trappedair
msgid ""
"Lower clamping threshold for marking fluid cells where air is trapped (lower "
"value results in more marked cells)"
msgstr ""
"Nedre begränsningströskel för markering av vätskeceller där luft är instängd "
"(lägre värde ger fler markerade celler)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_wavecrest
msgid "Minimum Wave Crest Potential"
msgstr "Minsta vågtoppspotential"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_min_wavecrest
msgid ""
"Lower clamping threshold for marking fluid cells as wave crests (lower value "
"results in more marked cells)"
msgstr ""
"Nedre begränsningströskel för markering av vätskeceller som vågtoppar (lägre "
"värde ger fler markerade celler)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_radius
#: scripts/startup/bl_ui/properties_physics_fluid.py:978
msgid "Potential Radius"
msgstr "Potentialradie"

#. :src: bpy.types.FluidDomainSettings.sndparticle_potential_radius
msgid ""
"Radius to compute potential for each cell (higher values are slower but "
"create smoother potential grids)"
msgstr ""
"Radie för att beräkna potentialen för varje cell (högre värden är "
"långsammare men skapar jämnare potentialrutnät)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_sampling_trappedair
msgid "Trapped Air Sampling"
msgstr "Provtagning av instängd luft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_sampling_trappedair
msgid "Maximum number of particles generated per trapped air cell per frame"
msgstr ""
"Maximalt antal partiklar som genereras per instängd luftcell per bildruta"

#. :src: bpy.types.FluidDomainSettings.sndparticle_sampling_wavecrest
msgid "Maximum number of particles generated per wave crest cell per frame"
msgstr "Maximalt antal partiklar som genereras per vågtoppscell per bildruta"

#. :src: bpy.types.FluidDomainSettings.sndparticle_update_radius
msgid ""
"Radius to compute position update for each particle (higher values are "
"slower but particles move less chaotic)"
msgstr ""
"Radie för att beräkna positionsuppdateringen för varje partikel (högre "
"värden är långsammare men partiklarna rör sig mindre kaotiskt)"

#. :src: bpy.types.FluidDomainSettings.sndparticle_bubble_buoyancy
#: scripts/startup/bl_ui/properties_physics_fluid.py:993
msgid "Bubble Buoyancy"
msgstr "Bubblornas flytkraft"

#. :src: bpy.types.FluidDomainSettings.sndparticle_bubble_buoyancy
