#: source/blender/animrig/intern/keyframing.cc:53
msgid "Successfully inserted a key."
msgstr "Nyckelbildruta infogades."

#: source/blender/animrig/intern/keyframing.cc:69
msgid "Due to the NLA stack setup, no key was inserted."
msgstr ""
"På grund av NLA-stapelns konfiguration infogades ingen nyckelbildruta."

#: source/blender/animrig/intern/keyframing.cc:72
msgid "Inserting key has been skipped because the ID cannot be edited."
msgstr ""
"Infogning av nyckelbildruta hoppades över eftersom ID:t inte kan redigeras."

#: source/blender/animrig/intern/keyframing.cc:76
msgid "Inserting key has been skipped because the ID cannot be keyed."
msgstr ""
"Infogning av nyckelbildruta hoppades över eftersom ID:t inte kan förses med "
"nyckelbildrutor."

#: source/blender/animrig/intern/keyframing.cc:80
msgid "No valid layer. Cannot insert key."
msgstr "Inget giltigt lager. Det går inte att infoga nyckelbildruta."

#: source/blender/animrig/intern/keyframing.cc:83
msgid "No valid strip. Cannot insert key."
msgstr "Ingen giltig remsa. Det går inte att infoga nyckelbildruta."

#: source/blender/animrig/intern/keyframing.cc:86
msgid "No valid slot. Cannot insert key."
msgstr "Ingen giltig Action-slot. Det går inte att infoga nyckelbildruta."

#: source/blender/animrig/intern/keyframing.cc:89
msgid "Invalid RNA path. Cannot insert key."
msgstr "Ogiltig RNA-sökväg. Det går inte att infoga nyckelbildruta."

#: source/blender/animrig/intern/keyframing.cc:504
msgid ""
"Could not delete keyframe, as RNA path is invalid for the given ID (ID = %s,"
" path = %s)"
msgstr ""
"Kunde inte ta bort nyckelbildrutan, eftersom RNA-sökvägen är ogiltig för det"
" angivna ID:t (ID = %s, sökväg = %s)"

#: source/blender/animrig/intern/keyframing.cc:582
msgid ""
"Could not clear keyframe, as RNA path is invalid for the given ID (ID = %s, "
"path = %s)"
msgstr ""
"Det gick inte att rensa nyckelbildrutan eftersom RNA-sökvägen är ogiltig för"
" det angivna ID:t (ID = %s, sökväg = %s)"

#: source/blender/blenkernel/intern/key.cc:1343
