msgid "Key %d"
msgstr "Nyckelbildruta %d"

#: source/blender/editors/animation/anim_channels_defines.cc:5925
msgid ""
"Show all keyframes during animation playback and enable all frames for "
"editing (uncheck to use only the current keyframe during animation playback "
"and editing)"
msgstr ""
"Visa alla nyckelbildrutor vid animationsuppspelning och aktivera alla "
"bildrutor för redigering (avmarkera för att bara använda den aktuella "
"nyckelbildrutan vid animationsuppspelning och redigering)"

#: source/blender/editors/animation/keyframing.cc:377
msgid ""
"Could not insert keyframe, as this type does not support animation data (ID "
"= %s)"
msgstr ""
"Det gick inte att infoga nyckelbildruta eftersom den här typen inte stöder "
"animationsdata (ID = %s)"

#: source/blender/editors/animation/keyframing.cc:969
msgid "Not deleting keyframe for locked F-Curve '%s', object '%s'"
msgstr "Tar inte bort nyckelbildruta för låst F-kurva ”%s”, objekt ”%s”"

#: source/blender/editors/animation/keyframing.cc:1013
msgid "Not deleting keyframe for locked F-Curve '%s', scene '%s'"
msgstr "Tar inte bort nyckelbildruta för låst F-kurva ”%s”, scen ”%s”"

#: source/blender/editors/animation/keyframing.cc:1506
#: source/blender/python/intern/bpy_rna_anim.cc:568
