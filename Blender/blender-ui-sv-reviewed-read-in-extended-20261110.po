#. :src: bpy.types.Addon
msgid "Python add-ons to be loaded automatically"
msgstr "Python-tillägg som ska läsas in automatiskt"

#. :src: bpy.types.BlendImportContext.options:'FORCE_INDIRECT'
msgid ""
"Force loaded ID to be tagged as indirectly linked (used in reload context "
"only)"
msgstr ""
"Tvinga det inlästa ID:t att markeras som indirekt länkat (används endast vid"
" ominläsning)"

#. :src: bpy.types.ColorManagedInputColorspaceSettings.name
msgid ""
"Color space in the image file, to convert to and from when saving and "
"loading the image"
msgstr ""
"Färgrymd i bildfilen, att konvertera till och från när bilden sparas och "
"läses in"

#. :src: bpy.types.Image.views_format
#. :src: bpy.types.ImageStrip.views_format
msgid "Mode to load image views"
msgstr "Läge för att läsa in bildvyer"

#. :src: bpy.types.PROJECT_MT_save_load
#. :src: bpy.types.USERPREF_MT_save_load
#. :src: bpy.types.SCREEN_OT_userpref_show.section:'SAVE_LOAD'
#. :src: bpy.types.Preferences.active_section:'SAVE_LOAD'
msgid "Save & Load"
msgstr "Spara och läs in"

#. :src: bpy.types.EXTENSIONS_OT_repo_refresh_all
msgid ""
"Refresh extension & legacy add-ons, reloading modules & meta-data (similar "
"to restarting)"
msgstr ""
"Uppdatera tillägg och äldre tillägg, läs in på nytt moduler och metadata "
"(motsvarar omstart)"

#. :src: bpy.types.IMPORT_ANIM_OT_bvh
msgid "Load a BVH motion capture file"
msgstr "Läs in en BVH-rörelsefångstfil"

#. :src: bpy.types.IMPORT_CURVE_OT_svg
msgid "Load a SVG file"
msgstr "Läs in en SVG-fil"

#. :src: bpy.types.IMPORT_SCENE_OT_fbx
msgid "Load a FBX file"
msgstr "Läs in en FBX-fil"

#. :src: bpy.types.IMPORT_SCENE_OT_gltf
msgid "Load a glTF 2.0 file"
msgstr "Läs in en glTF 2.0-fil"

#. :src: bpy.types.PREFERENCES_OT_theme_install
msgid "Load and apply a Blender XML theme file"
msgstr "Läs in och tillämpa en Blender XML-temafil"

#. :src: bpy.types.SCRIPT_OT_execute_preset
msgid "Load a preset"
msgstr "Läs in en förinställning"

