#. :src: bpy.types.BRUSH_OT_asset_load_preview
msgctxt "Operator"
msgid "Load Preview Image"
msgstr "Läs in förhandsgranskningsbild"

#. :src: bpy.types.CACHEFILE_OT_open
msgid "Load a cache file"
msgstr "Läs in en cachefil"

#. :src: bpy.types.CLIP_OT_open
msgid "Load a sequence of frames or a movie file"
msgstr "Läs in en sekvens av bildrutor eller en filmfil"

#. :src: bpy.types.CLIP_OT_prefetch
msgctxt "Operator"
msgid "Prefetch Frames"
msgstr "Läs in bildrutor i förväg"

#. :src: bpy.types.CLIP_OT_prefetch
msgid "Prefetch frames from disk for faster playback/tracking"
msgstr ""
"Läs in bildrutor i förväg från disken för snabbare uppspelning och spårning"

#. :src: bpy.types.ED_OT_lib_id_load_custom_preview
msgctxt "Operator"
msgid "Load Custom Preview"
msgstr "Läs in anpassad förhandsgranskning"

#. :src: bpy.types.FONT_OT_open
msgid "Load a new font from a file"
msgstr "Läs in ett nytt teckensnitt från en fil"

#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.name_from:'IMAGE'
msgid "Name from loaded image"
msgstr "Namn från inläst bild"

#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.force_reload
msgid "Force Reload"
msgstr "Tvinga ny inläsning"

#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.force_reload
msgid "Force reload the image if it is already opened elsewhere in Blender"
msgstr ""
"Tvinga ny inläsning av bilden om den redan är öppen någon annanstans i "
"Blender"

#. :src: bpy.types.OUTLINER_OT_lib_operation.type:'RELOCATE'
msgid "Select a new path for this library, and reload all its data"
msgstr "Välj en ny sökväg för biblioteket och läs in på nytt alla dess data"

#. :src: bpy.types.SCENE_OT_freestyle_module_open.make_internal
msgid "Make module file internal after loading"
msgstr "Gör modulfilen intern efter inläsning"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.sound
msgid "Load sound with the movie"
msgstr "Läs in ljud med filmen"

#. :src: bpy.types.SOUND_OT_open
msgid "Load a sound file"
msgstr "Läs in en ljudfil"

#. :src: bpy.types.SOUND_OT_open_mono
msgid "Load a sound file as mono"
msgstr "Läs in en ljudfil som mono"

#. :src: bpy.types.TEXT_OT_open.internal
msgid "Make text file internal after loading"
msgstr "Gör textfilen intern efter inläsning"

#. :src: bpy.types.UI_OT_reloadtranslation
msgid "Force a full reload of UI translation"
msgstr "Tvinga en fullständig ny inläsning av gränssnittsöversättningen"

#. :src: bpy.types.WM_OT_alembic_import
msgid "Load an Alembic archive"
msgstr "Läs in ett Alembic-arkiv"

#. :src: bpy.types.WM_OT_alembic_import.always_add_cache_reader
msgid ""
"Add cache modifiers and constraints to imported objects even if they are not"
" animated so that they can be updated when reloading the Alembic archive"
msgstr ""
"Lägg till cachemodifierare och begränsningar till importerade objekt även om"
" de inte är animerade, så att de kan uppdateras när Alembic-arkivet läses in"
" på nytt"

#. :src: bpy.types.WM_OT_obj_import
msgid "Load a Wavefront OBJ scene"
msgstr "Läs in en Wavefront OBJ-scen"

#. :src: bpy.types.WM_OT_open_mainfile.load_ui
#. :src: bpy.types.WM_OT_read_homefile.load_ui
#. :src: bpy.types.PreferencesFilePaths.use_load_ui
msgid "Load UI"
msgstr "Läs in användargränssnitt"

#. :src: bpy.types.WM_OT_read_factory_settings
msgctxt "Operator"
msgid "Load Factory Settings"
msgstr "Läs in fabriksinställningar"

#. :src: bpy.types.WM_OT_read_factory_settings
msgid ""
"Load factory default startup file and preferences. To make changes "
"permanent, use \"Save Startup File\" and \"Save Preferences\""
msgstr ""
"Läs in fabrikens startfil och inställningar. Använd ”Spara startfil” och "
"”Spara inställningar” för att göra ändringarna permanenta"

#. :src: bpy.types.WM_OT_read_factory_settings.use_empty
#. :src: bpy.types.WM_OT_read_homefile.use_empty
msgid ""
"After loading, remove everything except scenes, windows, and workspaces. "
"This makes it possible to load the startup file with its scene configuration"
" and window layout intact, but no objects, materials, animations, ..."
msgstr ""
"Efter inläsningen tas allt bort utom scener, fönster och arbetsytor. På så "
"sätt kan startfilen läsas in med scenkonfigurationen och fönsterlayouten "
"intakt, men utan objekt, material, animationer osv."

#. :src: bpy.types.WM_OT_read_factory_userpref
#: scripts/startup/bl_ui/space_userpref.py:153
msgctxt "Operator"
msgid "Load Factory Preferences"
msgstr "Läs in fabriksinställningar för användarinställningar"

#. :src: bpy.types.WM_OT_read_factory_userpref
msgid ""
"Load factory default preferences. To make changes to preferences permanent, "
"use \"Save Preferences\""
msgstr ""
"Läs in fabrikens standardinställningar. Använd ”Spara inställningar” för att"
" göra ändringar i inställningarna permanenta"

#. :src: bpy.types.WM_OT_read_history
msgid "Reloads history and bookmarks"
msgstr "Läser in historik och bokmärken på nytt"

#. :src: bpy.types.WM_OT_read_homefile.use_factory_startup
msgid ""
"Load the default ('factory startup') blend file. This is independent of the "
"normal start-up file that the user can save"
msgstr ""
"Läs in standardfilen för Blender (”fabriksstart”). Den är oberoende av den "
"vanliga startfil som användaren kan spara"

#. :src: bpy.types.WM_OT_read_userpref
msgid "Load last saved preferences"
msgstr "Läs in senast sparade inställningar"

#. :src: bpy.types.Preferences.use_preferences_save
msgid ""
"Save preferences on exit when modified (unless factory settings have been "
"loaded)"
msgstr ""
"Spara inställningar vid avslutning när de har ändrats (om inte "
"fabriksinställningarna har lästs in)"

#. :src: bpy.types.PreferencesFilePaths.use_load_ui
msgid "Load user interface setup when loading .blend files"
msgstr "Läs in användargränssnittskonfigurationen när .blend-filer läses in"

#. :src: bpy.types.CyclesRenderSettings.debug_use_optix_debug
msgid ""
"Load OptiX module in debug mode: lower logging verbosity level, enable "
"validations, and lower optimization level"
msgstr ""
"Läs in OptiX-modulen i felsökningsläge: sänk detaljnivån på loggningen, "
"aktivera valideringar och sänk optimeringsnivån"

#. :src: bpy.types.SequenceEditor.use_prefetch
msgid "Prefetch Frames"
msgstr "Läs in bildrutor i förväg"

#. :src: bpy.types.SpaceOutliner.display_mode:'ORPHAN_DATA'
msgid ""
"Display data that is unused and/or will be lost when the file is reloaded"
msgstr ""
"Visa data som inte används och/eller kommer att gå förlorade när filen läses"
" in på nytt"

#. :src: bpy.types.ImageStrip
msgid "Sequence strip to load one or more images"
msgstr "Sekvensremsa för att läsa in en eller flera bilder"

#. :src: bpy.types.MovieClipStrip
msgid "Sequence strip to load a video from the clip editor"
msgstr "Sekvensremsa för att läsa in en video från klippredigeraren"

#. :src: bpy.types.MovieStrip
msgid "Sequence strip to load a video"
msgstr "Sekvensremsa för att läsa in en video"

#. :src: bpy.types.MovieStrip.views_format
msgid "Mode to load movie views"
msgstr "Läge för att läsa in filmvisningar"

#. :src: bpy.types.Theme.filepath
msgid "The path to the preset loaded into this theme (if any)"
msgstr "Sökvägen till den förinställning som lästs in i detta tema (om någon)"

#. :src: bpy.types.VolumeGrid.is_loaded
#. :src: bpy.types.VolumeGrids.is_loaded
msgid "Is Loaded"
msgstr "Är inläst"

#. :src: bpy.types.VolumeGrids.frame_filepath
msgid ""
"Volume file used for loading the volume at the current frame. Empty if the "
"volume has not be loaded or the frame only exists in memory."
msgstr ""
"Volymfil som används för att läsa in volymen vid den aktuella bildrutan. Tom"
" om volymen inte har lästs in eller om bildrutan endast finns i minnet."

