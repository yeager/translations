#. :src: bpy.types.ParticleSettingsTextureSlot.length_factor
#. :src: Socket name from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Length Factor"
msgstr "Längdfaktor"

#. :src: Socket name from node group Restore Curve Segment Length, file procedural_hair_node_assets.blend
#. :src: Socket name from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Pin at Parameter"
msgstr "Fäst vid parameter"

#. :src: Socket description from node group Restore Curve Segment Length, file procedural_hair_node_assets.blend
#. :src: Socket description from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Pin each curve at a certain point for the operation"
msgstr "Förankra varje kurva vid en viss punkt för åtgärden"

#. :src: Asset name from file procedural_hair_node_assets.blend
msgid "Trim Hair Curves"
msgstr "Trimma hårkurvor"

#. :src: Asset description from file procedural_hair_node_assets.blend
msgid "Trims or scales hair curves to a certain length"
msgstr "Trimmar eller skalar hårkurvor till en viss längd"

#. :src: Socket description from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Scale each curve uniformly to reach the target length"
msgstr "Skala varje kurva jämnt för att uppnå mållängden"

#. :src: Socket description from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Multiply the original length by a factor"
msgstr "Multiplicera den ursprungliga längden med en faktor"

#. :src: Socket name from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Replace Length"
msgstr "Ersätt längd"

#. :src: Socket description from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Use the length input to fully replace the original length"
msgstr "Använd längdinmatningen för att helt ersätta den ursprungliga längden"

#. :src: Socket description from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Target length for the operation"
msgstr "Mållängd för åtgärden"

#. :src: Socket description from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Mask to blend overall effect"
msgstr "Mask för att blanda den övergripande effekten"

#. :src: Socket description from node group Trim Hair Curves, file procedural_hair_node_assets.blend
msgid "Trim hair curves randomly up to a certain amount"
msgstr "Trimma hårkurvor slumpmässigt upp till en viss mängd"
