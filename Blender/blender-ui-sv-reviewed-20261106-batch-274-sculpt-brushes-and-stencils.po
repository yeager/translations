#. :src: bpy.types.Brush.sharp_threshold
#. :src: bpy.types.GreasePencilSimplifyModifier.sharp_threshold
msgid "Sharp Threshold"
msgstr "Tröskel för skärpa"

#. :src: bpy.types.Brush.show_multiplane_scrape_planes_preview
msgid "Preview the scrape planes in the cursor during the stroke"
msgstr "Förhandsgranska skrapplanen i markören under penseldraget"

#. :src: bpy.types.Brush.smooth_deform_type:'SURFACE'
msgid "Smooths the surface of the mesh, preserving the volume"
msgstr "Jämnar ut meshens yta och bevarar volymen"

#. :src: bpy.types.Brush.smooth_stroke_factor
msgid "Higher values give a smoother stroke"
msgstr "Högre värden ger ett jämnare penseldrag"

#. :src: bpy.types.Brush.smooth_stroke_radius
#. :src: bpy.types.GPENCIL_OT_annotate.stabilizer_radius
msgid "Minimum distance from last point before stroke continues"
msgstr "Minsta avstånd från den senaste punkten innan penseldraget fortsätter"

#. :src: bpy.types.Brush.snake_hook_deform_type:'FALLOFF'
msgid "Applies the brush falloff in the tip of the brush"
msgstr "Tillämpa penselns avtagande vid penselspetsen"

#. :src: bpy.types.Brush.snake_hook_deform_type:'ELASTIC'
msgid "Modifies the entire mesh using elastic deform"
msgstr "Modifierar hela meshen med elastisk deformation"

#. :src: bpy.types.Brush.spacing
msgid "Spacing between brush daubs as a percentage of brush diameter"
msgstr "Avståndet mellan penselavtryck som en procentandel av penseldiametern"

#. :src: bpy.types.Brush.stabilize_normal
msgid "Stabilize the orientation of the brush plane."
msgstr "Stabilisera penselplanets orientering."

#. :src: bpy.types.Brush.stencil_dimension
msgid "Stencil Dimensions"
msgstr "Schablonmått"

#. :src: bpy.types.Brush.stencil_dimension
msgid "Dimensions of stencil in viewport"
msgstr "Mått på schablonen i visningsområdet"

#. :src: bpy.types.Brush.stencil_pos
msgid "Stencil Position"
msgstr "Schablonposition"

#. :src: bpy.types.Brush.stencil_pos
msgid "Position of stencil in viewport"
msgstr "Schablonens position i visningsområdet"

#. :src: bpy.types.Brush.strength
#. :src: bpy.types.UnifiedPaintSettings.strength
msgid "How powerful the effect of the brush is when applied"
msgstr "Hur stark penselns effekt är när den tillämpas"
