msgid "New keys will be Bézier"
msgstr "Nya nyckelbildrutor blir Bézier"

#. :src: bpy.types.ANIM_OT_channels_bake.interpolation_type:'LIN'
msgid "New keys will be linear"
msgstr "Nya nyckelbildrutor blir linjära"

