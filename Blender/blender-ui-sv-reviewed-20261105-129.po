msgid "Removes keys outside the given range, leaving only the newly baked"
msgstr ""
"Tar bort nyckelbildrutor utanför angivet intervall och lämnar endast de "
"nybakade"

#. :src: bpy.types.ANIM_OT_channels_bake.step
msgid "At which interval to add keys"
msgstr "Med vilket intervall nyckelbildrutor ska läggas till"

#. :src: bpy.types.ANIM_OT_channels_clean_empty
