msgctxt "Operator"
msgid "Bake Channels"
msgstr "Baka kanaler"

#. :src: bpy.types.ANIM_OT_channels_bake
msgid ""
"Create keyframes following the current shape of F-Curves of selected channels"
msgstr ""
"Skapa nyckelbildrutor som följer de markerade kanalernas aktuella F-kurvform"

