#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode
msgid "How the mesh is going to be subdivided to create a new level"
msgstr "Hur meshen ska delas upp för att skapa en ny nivå"

#. :src: bpy.types.OBJECT_OT_multires_unsubdivide
msgid "Rebuild a lower subdivision level of the current base mesh"
msgstr "Återuppbygg en lägre underindelningsnivå av den aktuella basmeshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh
msgid "Create a new quad based mesh using the surface data of the current mesh. All data layers will be lost"
msgstr "Skapa en ny fyrhörningsbaserad mesh med ytdata från den aktuella meshen. Alla datalager går förlorade"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode
msgid "How to specify the amount of detail for the new mesh"
msgstr "Hur detaljnivån för den nya meshen ska anges"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'RATIO'
msgid "Specify target number of faces relative to the current mesh"
msgstr "Ange målantalet ytor i förhållande till den aktuella meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'EDGE'
msgid "Input target edge length in the new mesh"
msgstr "Ange målkantlängd i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'FACES'
msgid "Input target number of faces in the new mesh"
msgstr "Ange målantalet ytor i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.preserve_attributes
msgid "Reproject attributes onto the new mesh"
msgstr "Reprojektera attribut på den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.smooth_normals
msgid "Set the output mesh normals to smooth"
msgstr "Ange att utmeshens normaler ska vara jämna"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_edge_length
msgid "Target edge length in the new mesh"
msgstr "Målkantlängd i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_faces
msgid "Approximate number of faces (quads) in the new mesh"
msgstr "Ungefärligt antal ytor (fyrkanter) i den nya meshen"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_ratio
msgid "Relative number of faces compared to the current mesh"
msgstr "Relativt antal ytor jämfört med den aktuella meshen"
