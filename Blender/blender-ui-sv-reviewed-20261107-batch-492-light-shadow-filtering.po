#. :src: bpy.types.AreaLight.shadow_buffer_clip_start
#. :src: bpy.types.PointLight.shadow_buffer_clip_start
#. :src: bpy.types.SpotLight.shadow_buffer_clip_start
#. :src: bpy.types.SunLight.shadow_buffer_clip_start
msgid "Shadow Buffer Clip Start"
msgstr "Skuggbuffertens klippstart"

#. :src: bpy.types.AreaLight.shadow_buffer_clip_start
#. :src: bpy.types.PointLight.shadow_buffer_clip_start
#. :src: bpy.types.SpotLight.shadow_buffer_clip_start
#. :src: bpy.types.SunLight.shadow_buffer_clip_start
msgid "Shadow map clip start, below which objects will not generate shadows"
msgstr ""
"Skuggkartans klippstart, under vilken objekt inte kommer att generera skuggor"

#. :src: bpy.types.AreaLight.shadow_filter_radius
#. :src: bpy.types.PointLight.shadow_filter_radius
#. :src: bpy.types.SpotLight.shadow_filter_radius
#. :src: bpy.types.SunLight.shadow_filter_radius
#. :src: bpy.types.World.sun_shadow_filter_radius
msgid "Shadow Filter Radius"
msgstr "Radie för skuggfilter"

#. :src: bpy.types.AreaLight.shadow_filter_radius
#. :src: bpy.types.PointLight.shadow_filter_radius
#. :src: bpy.types.SpotLight.shadow_filter_radius
#. :src: bpy.types.SunLight.shadow_filter_radius
#. :src: bpy.types.World.sun_shadow_filter_radius
msgid "Blur shadow aliasing using Percentage Closer Filtering"
msgstr "Minska kantartefakter i skuggor med Percentage Closer Filtering"

#. :src: bpy.types.AreaLight.shadow_jitter_overblur
#. :src: bpy.types.PointLight.shadow_jitter_overblur
#. :src: bpy.types.SpotLight.shadow_jitter_overblur
#. :src: bpy.types.SunLight.shadow_jitter_overblur
#. :src: bpy.types.World.sun_shadow_jitter_overblur
msgid "Shadow Jitter Overblur"
msgstr "Extra oskärpa vid skuggslumpning"

#. :src: bpy.types.AreaLight.shadow_jitter_overblur
#. :src: bpy.types.PointLight.shadow_jitter_overblur
#. :src: bpy.types.SpotLight.shadow_jitter_overblur
#. :src: bpy.types.SunLight.shadow_jitter_overblur
#. :src: bpy.types.World.sun_shadow_jitter_overblur
msgid ""
"Apply shadow tracing to each jittered sample to reduce under-sampling "
"artifacts"
msgstr ""
"Tillämpa skuggspårning på varje jitterat prov för att minska artefakter vid "
"undersampling"

#. :src: bpy.types.AreaLight.shadow_maximum_resolution
#. :src: bpy.types.PointLight.shadow_maximum_resolution
#. :src: bpy.types.SpotLight.shadow_maximum_resolution
#. :src: bpy.types.SunLight.shadow_maximum_resolution
#. :src: bpy.types.World.sun_shadow_maximum_resolution
msgid "Shadows Resolution Limit"
msgstr "Gräns för skuggupplösning"

#. :src: bpy.types.AreaLight.shadow_maximum_resolution
#. :src: bpy.types.PointLight.shadow_maximum_resolution
#. :src: bpy.types.SpotLight.shadow_maximum_resolution
#. :src: bpy.types.SunLight.shadow_maximum_resolution
msgid ""
"Minimum size of a shadow map pixel. Higher values use less memory at the "
"cost of shadow quality."
msgstr ""
"Minsta storlek på en pixel i skuggkartan. Högre värden använder mindre minne "
"på bekostnad av skuggans kvalitet."

#. :src: bpy.types.AreaLight.shadow_soft_size
#. :src: bpy.types.PointLight.shadow_soft_size
#. :src: bpy.types.SpotLight.shadow_soft_size
#. :src: bpy.types.SunLight.shadow_soft_size
msgid "Shadow Soft Size"
msgstr "Storlek för mjuka skuggor"

#. :src: bpy.types.AreaLight.shadow_soft_size
#. :src: bpy.types.PointLight.shadow_soft_size
#. :src: bpy.types.SpotLight.shadow_soft_size
#. :src: bpy.types.SunLight.shadow_soft_size
msgid "Light size for ray shadow sampling (Raytraced shadows)"
msgstr "Ljusstorlek för sampling av strålspårade skuggor"
