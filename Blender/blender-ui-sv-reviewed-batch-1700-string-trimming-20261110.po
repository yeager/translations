#: source/blender/nodes/function/nodes/node_fn_trim_string.cc:22
msgid "Individual characters to trim. The order of characters does not matter"
msgstr "Enskilda tecken som ska tas bort. Tecknens ordning saknar betydelse"

#: source/blender/nodes/function/nodes/node_fn_trim_string.cc:25
msgid "Trim whitespace characters in addition to the provided characters"
msgstr "Ta bort blanktecken utöver de angivna tecknen"

#: source/blender/nodes/function/nodes/node_fn_trim_string.cc:30
msgid "Trim the beginning of the string"
msgstr "Ta bort tecken från början av strängen"

#: source/blender/nodes/function/nodes/node_fn_trim_string.cc:33
msgid "Trim at the end of the string"
msgstr "Ta bort tecken från slutet av strängen"
