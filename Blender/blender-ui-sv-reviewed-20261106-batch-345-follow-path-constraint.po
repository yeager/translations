#. :src: bpy.types.FollowPathConstraint
msgid "Follow Path Constraint"
msgstr "Följ bana-begränsning"

#. :src: bpy.types.FollowPathConstraint
msgid "Lock motion to the target path"
msgstr "Lås rörelsen till målbanan"

#. :src: bpy.types.FollowPathConstraint.forward_axis
#. :src: bpy.types.WM_OT_obj_export.forward_axis
#. :src: bpy.types.WM_OT_obj_import.forward_axis
#. :src: bpy.types.WM_OT_ply_export.forward_axis
#. :src: bpy.types.WM_OT_ply_import.forward_axis
#. :src: bpy.types.WM_OT_stl_export.forward_axis
#. :src: bpy.types.WM_OT_stl_import.forward_axis
