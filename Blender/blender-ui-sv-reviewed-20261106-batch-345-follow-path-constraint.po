#: source/blender/editors/io/io_collada.cc:273
#: source/blender/editors/io/io_obj.cc:141
#: source/blender/editors/io/io_obj.cc:464
#: source/blender/editors/io/io_ply_ops.cc:123
#: source/blender/editors/io/io_stl_ops.cc:253
msgid "Forward Axis"
msgstr "Framåtriktad axel"

#. :src: bpy.types.FollowPathConstraint.forward_axis
msgid "Axis that points forward along the path"
msgstr "Axel som pekar framåt längs banan"

#. :src: bpy.types.FollowPathConstraint.offset
msgid "Offset from the position corresponding to the time frame"
msgstr "Förskjutning från positionen som motsvarar bildrutan"

#. :src: bpy.types.FollowPathConstraint.offset_factor
#. :src: bpy.types.GRAPH_OT_blend_offset.factor
#: scripts/startup/bl_ui/properties_constraint.py:189
msgid "Offset Factor"
msgstr "Förskjutningsfaktor"

#. :src: bpy.types.FollowPathConstraint.offset_factor
msgid "Percentage value defining target position along length of curve"
msgstr "Procentuellt värde som definierar målpositionen längs kurvans längd"

#. :src: bpy.types.FollowPathConstraint.target
msgid "Target Curve object"
msgstr "Målkurvobjekt"

#. :src: bpy.types.FollowPathConstraint.up_axis
#. :src: bpy.types.TrackToConstraint.up_axis
#. :src: bpy.types.Object.up_axis
#. :src: bpy.types.WM_OT_obj_export.up_axis
#. :src: bpy.types.WM_OT_obj_import.up_axis
#. :src: bpy.types.WM_OT_ply_export.up_axis
#. :src: bpy.types.WM_OT_ply_import.up_axis
#. :src: bpy.types.WM_OT_stl_export.up_axis
#. :src: bpy.types.WM_OT_stl_import.up_axis
#. :src: bpy.types.WM_OT_usd_export.export_global_up_selection
#: scripts/startup/bl_ui/properties_object.py:143
#: source/blender/editors/interface/templates/interface_template_cache_file.cc:267
#: source/blender/editors/io/io_collada.cc:275
#: source/blender/editors/io/io_obj.cc:142
#: source/blender/editors/io/io_obj.cc:465
#: source/blender/editors/io/io_ply_ops.cc:124
msgid "Up Axis"
msgstr "Uppåtriktad axel"

#. :src: bpy.types.FollowPathConstraint.up_axis
#. :src: bpy.types.LockedTrackConstraint.lock_axis
#. :src: bpy.types.TrackToConstraint.up_axis
msgid "Axis that points upward"
msgstr "Axel som pekar uppåt"

#. :src: bpy.types.FollowPathConstraint.use_curve_follow
msgid "Follow Curve"
msgstr "Följ kurvan"

#. :src: bpy.types.FollowPathConstraint.use_curve_follow
msgid "Object will follow the heading and banking of the curve"
msgstr "Objektet följer kurvans riktning och krängning"

#. :src: bpy.types.FollowPathConstraint.use_curve_radius
msgid "Object is scaled by the curve radius"
msgstr "Objektet skalas med kurvans radie"

#. :src: bpy.types.FollowPathConstraint.use_fixed_location
msgid "Fixed Position"
msgstr "Fast position"

#. :src: bpy.types.FollowPathConstraint.use_fixed_location
msgid ""
"Object will stay locked to a single point somewhere along the length of the "
"curve regardless of time"
msgstr ""
"Objektet kommer att förbli låst till en enda punkt någonstans längs kurvans "
"längd oavsett tid"
