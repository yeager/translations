msgid "Path to the OpenColorIO configuration to use for this project. May be an absolute file path, project relative path with {project_root}, or an ocio:// built-in OpenColorIO config"
msgstr "Sökväg till OpenColorIO-konfigurationen som ska användas för detta projekt. Kan vara en absolut filsökväg, en projektrelativ sökväg med {project_root} eller en inbyggd OpenColorIO-konfiguration via ocio://"

msgid "Copy the file to the destination path (or subdirectory)"
msgstr "Kopiera filen till målsökvägen (eller underkatalogen)"

msgid "Copy the file to the destination path"
msgstr "Kopiera filen till målsökvägen"

msgid "Set the file path relative to the blend file, when possible"
msgstr "Ange filsökvägen relativt .blend-filen, om möjligt"

msgid "Warning: the blend-file relative path prefix \"//\" is not supported for this property."
msgstr "Varning: Sökvägsprefixet ”//” för .blend-filrelativa sökvägar stöds inte för denna egenskap."

msgid "Property is a path which supports the \"//\" prefix, signifying the location as relative to the \".blend\" file's directory"
msgstr "Egenskapen är en sökväg som stöder prefixet ”//”, vilket anger en plats relativt .blend-filens katalog"

msgid "Cannot set relative paths with an unsaved blend file"
msgstr "Det går inte att ställa in relativa sökvägar med en osparad .blend-fil"

msgid "Pack the sound into the current blend file"
msgstr "Packa ljudet i den aktuella .blend-filen"

msgid "Pack all images into .blend file"
msgstr "Packa alla bilder i .blend-filen"

msgid "Hash representing a unique version of a packed linked data and all of its dependencies"
msgstr "Hash som representerar en unik version av packade länkade data och alla dess beroenden"
