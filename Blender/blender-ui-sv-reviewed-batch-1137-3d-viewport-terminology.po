msgid "Can only pick from the 3D viewport or the outliner"
msgstr "Det går bara att välja från 3D-vyporten eller Outliner"

msgid "When inside a 3D viewport, use layers and camera of the viewport"
msgstr "När du befinner dig i en 3D-vyport, använd lagren och kameran i vyporten"

msgid "Device up/down directly controls the Z position of the 3D viewport"
msgstr "Enhetens uppåt- och nedåtrörelse styr direkt Z-positionen i 3D-vyporten"

msgid "Denoise the image in the 3D viewport"
msgstr "Brusreducera bilden i 3D-vyporten"

msgid ""
"Synchronize the viewer perspective of virtual reality sessions with this 3D "
"viewport"
msgstr ""
"Synkronisera visarperspektivet i virtual reality-sessioner med den här 3D-"
"vyporten"

msgid "Settings for shading in the 3D viewport"
msgstr "Inställningar för skuggning i 3D-vyporten"

msgid "Type of background in the 3D viewport"
msgstr "Typ av bakgrund i 3D-vyporten"

msgid "Theme settings for the 3D viewport"
msgstr "Temainställningar för 3D-vyporten"

msgid "Volume object display settings for 3D viewport"
msgstr "Inställningar för visning av volymobjekt i 3D-vyporten"

msgid "Action when Alt-MMB dragging in the 3D viewport"
msgstr "Åtgärd när Alt-MMB dras i 3D-vyporten"

msgid "Pinned armature is not active in the 3D viewport"
msgstr "Den fästa armaturen är inte aktiv i 3D-vyporten"

msgid "Unable to access 3D viewport"
msgstr "Det går inte att komma åt 3D-vyporten"

msgid "No 3D viewport found to create image from"
msgstr "Ingen 3D-vyport hittades för att skapa bild från"
