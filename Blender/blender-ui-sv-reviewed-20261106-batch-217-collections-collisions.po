#. :src: bpy.types.CollisionSettings
#. :src: bpy.types.Object.collision
msgid "Collision Settings"
msgstr "Inställningar för kollision"

#. :src: bpy.types.CollisionSettings
msgid "Collision settings for object in physics simulation"
msgstr "Kollisionsinställningar för objekt i fysiksimulering"

#. :src: bpy.types.CollisionSettings.absorption
#. :src: bpy.types.FieldSettings.use_absorption
msgid "Absorption"
msgstr "Absorption"

#. :src: bpy.types.CollisionSettings.absorption
msgid ""
"How much of effector force gets lost during collision with this object (in "
"percent)"
msgstr ""
"Hur mycket av effektorkraften som går förlorad vid kollision med detta "
"objekt (i procent)"

#. :src: bpy.types.CollisionSettings.cloth_friction
msgid "Friction for cloth collisions"
msgstr "Friktion för tygkollisioner"

#. :src: bpy.types.CollisionSettings.damping
msgid "Amount of damping during collision"
msgstr "Mängden dämpning vid kollision"

#. :src: bpy.types.CollisionSettings.damping_factor
msgid "Damping Factor"
msgstr "Dämpningsfaktor"

#. :src: bpy.types.CollisionSettings.damping_factor
msgid "Amount of damping during particle collision"
msgstr "Mängden dämpning vid partikelkollision"

#. :src: bpy.types.CollisionSettings.damping_random
msgid "Random Damping"
msgstr "Slumpmässig dämpning"

#. :src: bpy.types.CollisionSettings.damping_random
msgid "Random variation of damping"
msgstr "Slumpmässig variation av dämpningen"

#. :src: bpy.types.CollisionSettings.friction_factor
msgid "Amount of friction during particle collision"
msgstr "Mängden friktion vid partikelkollision"

#. :src: bpy.types.CollisionSettings.friction_random
msgid "Random Friction"
msgstr "Slumpmässig friktion"

#. :src: bpy.types.CollisionSettings.friction_random
msgid "Random variation of friction"
msgstr "Slumpmässig variation av friktion"

#. :src: bpy.types.CollisionSettings.permeability
msgid "Permeability"
msgstr "Genomsläpplighet"

#. :src: bpy.types.CollisionSettings.permeability
msgid "Chance that the particle will pass through the mesh"
msgstr "Sannolikheten att partikeln passerar genom meshet"

#. :src: bpy.types.CollisionSettings.stickiness
msgid "Stickiness"
msgstr "Vidhäftning"

#. :src: bpy.types.CollisionSettings.stickiness
msgid "Amount of stickiness to surface collision"
msgstr "Vidhäftning vid kollision med en yta"

#. :src: bpy.types.CollisionSettings.thickness_inner
msgid "Inner Thickness"
msgstr "Inre tjocklek"

#. :src: bpy.types.CollisionSettings.thickness_inner
msgid "Inner face thickness (only used by softbodies)"
msgstr "Det inre ytlagrets tjocklek (används endast av mjuka kroppar)"

#. :src: bpy.types.CollisionSettings.thickness_outer
msgid "Outer Thickness"
msgstr "Yttre tjocklek"

#. :src: bpy.types.CollisionSettings.thickness_outer
msgid "Outer face thickness"
msgstr "Det yttre ytlagrets tjocklek"

