#: scripts/addons_core/bl_pkg/bl_extension_ops.py:1457
msgid "No repositories available"
msgstr "Inga tilläggsförråd tillgängliga"

#: scripts/addons_core/bl_pkg/bl_extension_ops.py:1836
msgid "The dropped extension comes from a disabled repository."
msgstr "Det släppta tillägget kommer från ett inaktiverat tilläggsförråd."

#: scripts/addons_core/bl_pkg/bl_extension_ops.py:1837
msgid "Enable the repository and try again."
msgstr "Aktivera tilläggsförrådet och försök igen."

#. :src: bpy.types.PREFERENCES_OT_extension_repo_add.remote_url
#. :src: bpy.types.UserExtensionRepo.remote_url
msgid ""
"Remote URL to the extension repository, the file-system may be referenced "
"using the file URI scheme: \"file://\""
msgstr ""
"Fjärr-URL till tilläggsförrådet, filsystemet kan refereras till med hjälp av "
"fil-URI-schemat: \"file://\""

#: scripts/addons_core/bl_pkg/bl_extension_ui.py:344
msgid "Blender's extension repository must be enabled to install extensions!"
msgstr ""
"Blenders tilläggsförråd måste vara aktiverat för att kunna installera "
"tillägg!"

#. :src: bpy.types.PreferencesExtensions.repos
msgid "Extension Repositories"
msgstr "Tilläggsförråd"

#: scripts/addons_core/bl_pkg/bl_extension_ops.py:468
msgid "Repository \"{:s}\": {:s}{:s}"
msgstr "Tilläggsförråd \"{:s}\": {:s}{:s}"

#: scripts/addons_core/bl_pkg/bl_extension_ops.py:3219
msgid "Repository: {:s}"
msgstr "Tilläggsförråd: {:s}"
