#. :src: bpy.types.SimulationStateItem.color
msgid "Color of the corresponding socket type in the node editor"
msgstr "Färg för motsvarande noduttagsdatatyp i nodredigeraren"

#. :src: bpy.types.NodesModifier.bake_directory
msgid "Simulation Bake Directory"
msgstr "Bakningskatalog för simulering"

#. :src: bpy.types.NodesModifier.bake_directory
#. :src: bpy.types.NodesModifierBake.directory
msgid "Location on disk where the bake data is stored"
msgstr "Plats på disken där bakningsdata lagras"

#. :src: bpy.types.NodesModifier.bake_target
#. :src: bpy.types.NodesModifierBake.bake_target
msgid "Where to store the baked data"
msgstr "Var bakningsdata ska lagras"

#. :src: bpy.types.NodesModifier.node_group
msgid "Node group that controls what this modifier does"
msgstr "Nodgrupp som styr vad modifieraren gör"

#. :src: bpy.types.GeometryNodeBake
msgid "Cache the incoming data so that it can be used without recomputation"
msgstr "Cachelagra inkommande data så att de kan användas utan omberäkning"

#. :src: bpy.types.GeometryNodeBoundBox
msgid "Calculate the limits of a geometry's positions and generate a box mesh with those dimensions"
msgstr "Beräkna gränserna för en geometris positioner och generera ett kuboidmesh med de dimensionerna"

#. :src: bpy.types.GeometryNodeCaptureAttribute
msgid "Store the result of a field on a geometry and output the data as a node socket. Allows remembering or interpolating data as the geometry changes, such as positions before deformation"
msgstr "Lagra resultatet av ett fält på en geometri och mata ut data som ett noduttag. Gör det möjligt att komma ihåg eller interpolera data när geometrin ändras, till exempel positioner före deformation"

#. :src: bpy.types.NODE_OT_add_foreach_geometry_element_zone
msgid "Add a For Each Geometry Element zone that allows executing nodes e.g. for each vertex separately"
msgstr "Lägg till en zon för varje geometrielement, så att noder kan köras separat för exempelvis varje hörnpunkt"

#. :src: bpy.types.NODE_OT_add_foreach_geometry_element_zone
msgctxt "Operator"
msgid "Add For Each Geometry Element Zone"
msgstr "Lägg till zon för varje geometrielement"

#. :src: bpy.types.NODE_OT_insert_offset
msgid "Automatically offset nodes on insertion"
msgstr "Förskjut noder automatiskt vid infogning"

#. :src: bpy.types.NODE_OT_nw_lazy_connect
msgid "Connect two nodes without clicking a specific socket (automatically determined"
msgstr "Anslut två noder utan att klicka på ett specifikt noduttag (bestäms automatiskt"

#. :src: bpy.types.NODE_OT_nw_del_unused.delete_muted
msgid "Delete (but reconnect, like Ctrl-X) all muted nodes"
msgstr "Ta bort (men återanslut dem, som med Ctrl-X) alla avstängda noder"

#. :src: bpy.types.OBJECT_OT_simulation_nodes_cache_calculate_to_frame
msgctxt "Operator"
msgid "Calculate Simulation to Frame"
msgstr "Beräkna simuleringen till bildrutan"

#. :src: bpy.types.OBJECT_OT_simulation_nodes_cache_delete
msgctxt "Operator"
msgid "Delete Cached Simulation"
msgstr "Ta bort cachelagrad simulering"
