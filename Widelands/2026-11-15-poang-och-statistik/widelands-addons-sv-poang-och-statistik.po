#: Transifex string 628063252
msgid "Rookie is %.1f%% of hero"
msgstr "Nybörjaren är %.1f%% av hjälten"

#: Transifex string 628063253
msgid "Hero is %.1f times as strong as rookie"
msgstr "Hjälten är %.1f gånger så stark som nybörjaren"

#: Transifex string 628063265
msgid "Train %d heroes as fast as you can."
msgstr "Träna %d hjältar så snabbt du kan."

#: Transifex string 628063267
msgid "Congratulations! You have trained %d heroes."
msgstr "Gratulerar! Du har tränat %d hjältar."

#: Transifex string 628063268
msgid "Expand your territory, train your soldiers, and guard your territory with military sites filled with heroes. You have to do all of them to get a really good score. Highest score after %s wins."
msgstr "Utvidga ditt territorium, träna soldater och bevaka territoriet med militärbyggnader fyllda av hjältar. Du måste göra allt detta för att få en riktigt bra poäng. Högst poäng efter %s vinner."

#: Transifex string 638376675
msgid "Controlled area with bonuses and penalties: %d"
msgstr "Kontrollerat område med bonusar och avdrag: %d"

#: Transifex string 638376676
msgid "Average bonus/penalty weighted by area: %+.1f%%"
msgstr "Genomsnittligt värde för bonus eller avdrag, viktat efter område: %+.1f%%"

#: Transifex string 638376677
msgid "Strength of guards with bonuses and penalties: %d"
msgstr "Vakternas styrka med bonusar och avdrag: %d"

#: Transifex string 638376678
msgid "Average bonus/penalty weighted by strength: %+.1f%%"
msgstr "Genomsnittligt värde för bonus eller avdrag, viktat efter styrka: %+.1f%%"

#: Transifex string 638376685
msgid "soldier_bonus = (ln(garrison strength) - 3.5) / 10"
msgstr "soldier_bonus = (ln(garrison strength) - 3.5) / 10"

#: Transifex string 628083487
msgid "Accurate Europe 1.3"
msgstr "Accurate Europe 1.3"
