msgid "Enable or disable the domain"
msgstr "Aktivera eller inaktivera domänen"

msgid "Enable enumerating all users/groups"
msgstr "Aktivera uppräkning av alla användare och grupper"

msgid "Display users/groups in fully-qualified form"
msgstr "Visa användare och grupper i fullständigt kvalificerat format"

msgid "How long to keep cached entries after last successful login (days)"
msgstr ""
"Hur länge cachelagrade poster ska behållas efter den senaste lyckade "
"inloggningen (dagar)"

msgid "How long should keep trying to resolve single DNS query (seconds)"
msgstr "Hur länge en enskild DNS-fråga ska fortsätta att slås upp (sekunder)"

msgid "How long to wait for replies from DNS when resolving servers (seconds)"
msgstr ""
"Hur länge SSSD ska vänta på svar från DNS vid uppslagning av servrar "
"(sekunder)"

msgid "Default subdomain homedir value"
msgstr "Standardvärde för underdomänens hemkatalog"
