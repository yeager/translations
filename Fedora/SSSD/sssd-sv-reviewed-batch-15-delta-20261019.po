msgid "Unable to create backup of local data, can not remove the cache.\n"
msgstr ""
"Kan inte skapa säkerhetskopia av lokala data och kan därför inte ta bort "
"cachen.\n"

#, c-format
msgid "Attribute %1$s already indexed.\n"
msgstr "Attributet %1$s är redan indexerat.\n"

msgid "Show domain list including primary or trusted domain type"
msgstr ""
"Visa domänlistan med information om huruvida domänerna är primära eller "
"betrodda"

msgid "None so far.\n"
msgstr "Inga hittades ännu.\n"

msgid "Show list of discovered servers"
msgstr "Visa en lista över upptäckta servrar"

#, c-format
msgid "%1$-25s Unreachable service\n"
msgstr "%1$-25s Kan inte nå tjänsten\n"

msgid "Delete log files instead of truncating"
msgstr "Ta bort loggfiler i stället för att tömma dem"

msgid "Deleting log files...\n"
msgstr "Tar bort loggfiler …\n"

msgid "Truncating log files...\n"
msgstr "Tömmer loggfiler …\n"

msgid "Unable to truncate log files\n"
msgstr "Kan inte tömma loggfiler\n"
