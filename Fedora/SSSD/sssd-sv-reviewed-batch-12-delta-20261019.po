msgid "Invalidate all cached entries"
msgstr "Invalidera alla cachelagrade poster"

msgid "Invalidate all cached sudo rules"
msgstr "Invalidera alla cachelagrade sudo-regler"

msgid ""
"Unexpected argument(s) provided, options that invalidate a single object "
"only accept a single provided argument.\n"
msgstr ""
"Oväntade argument angavs. Flaggor som invaliderar ett enskilt objekt tar "
"bara ett argument.\n"

#, c-format
msgid ""
"Could not open domain %1$s. If the domain is a subdomain (trusted domain), "
"use fully qualified name instead of --domain/-d parameter.\n"
msgstr ""
"Kunde inte öppna domänen %1$s. Om domänen är en underdomän (betrodd domän), "
"använd ett fullständigt kvalificerat namn i stället för flaggan "
"--domain/-d.\n"

msgid "Information about cached user"
msgstr "Information om cachelagrad användare"

msgid "Information about cached group"
msgstr "Information om cachelagrad grupp"

msgid "Information about cached netgroup"
msgstr "Information om cachelagrad nätgrupp"

msgid "Backup local data and remove cached content"
msgstr "Säkerhetskopiera lokala data och ta bort cachelagrat innehåll"
