msgid "The type of the authentication token of the default bind DN"
msgstr "Typ av autentiseringstoken för standardbindnings-DN"

msgid "Length of time to attempt connection"
msgstr "Tidsgräns för anslutningsförsök"

msgid "Length of time to attempt synchronous LDAP operations"
msgstr "Tidsgräns för synkrona LDAP-åtgärder"

msgid "Use Kerberos auth for LDAP connection"
msgstr "Använd Kerberosautentisering för LDAP-anslutning"

msgid "Lifetime of TGT for LDAP connection"
msgstr "Livslängd för TGT vid LDAP-anslutning"

msgid ""
"How long to retain a connection to the LDAP server before disconnecting"
msgstr ""
"Hur länge en anslutning till LDAP-servern ska behållas innan den kopplas "
"från"

msgid "Length of time to wait for a search request"
msgstr "Tidsgräns för sökbegäran"

msgid "Length of time to wait for a enumeration request"
msgstr "Tidsgräns för uppräkningsbegäran"

msgid "Maximum time deviation between cache cleanups"
msgstr "Maximal tidsavvikelse mellan cacherensningar"

msgid "Scope of user lookups"
msgstr "Omfattning för användaruppslagningar"
