msgid "The user to drop privileges to"
msgstr "Användare som behörigheten ska sänkas till"

msgid "Tune sssd to honor or ignore netlink state changes"
msgstr ""
"Finjustera SSSD för att beakta eller ignorera ändringar av "
"netlinktillståndet"

msgid "Enable or disable core dumps for all SSSD processes."
msgstr "Aktivera eller inaktivera kärndumpar för alla SSSD-processer."

msgid "Override homedir value from the identity provider with this value"
msgstr ""
"Åsidosätt värdet för hemkatalogen från identitetsleverantören med detta "
"värde"

msgid ""
"Substitute empty homedir value from the identity provider with this value"
msgstr ""
"Ersätt ett tomt värde för hemkatalogen från identitetsleverantören med detta"
" värde"

msgid "How long will be in-memory cache records valid"
msgstr "Hur länge cacheposter i minnet är giltiga"

msgid "How long to allow cached logins between online logins (days)"
msgstr ""
"Hur länge cachelagrade inloggningar tillåts mellan inloggningar online "
"(dagar)"
