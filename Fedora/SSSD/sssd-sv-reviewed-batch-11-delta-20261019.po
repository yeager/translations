msgid "Cannot get stat of SSSD socket."
msgstr "Kan inte hämta information om SSSD-socketen."

msgid "Permission denied. "
msgstr "Åtkomst nekad. "

msgid "Authenticated with cached credentials"
msgstr "Autentiserad med cachelagrade autentiseringsuppgifter"

msgid ", your cached password will expire at: "
msgstr ", ditt cachelagrade lösenord går ut: "

msgid "System is offline, password change not possible"
msgstr "Systemet är frånkopplat, ändring av lösenord är inte möjlig"

msgid "PIN locked"
msgstr "PIN-koden är låst"

#, c-format
msgid "Authenticate at \"%1$s\"."
msgstr "Autentisera hos ”%1$s”."

msgid "Press ENTER to continue."
msgstr "Tryck på Retur för att fortsätta."

msgid ""
"\n"
"******************************************************************************\n"
"Your system is configured to use the obsolete tool sss_ssh_knownhostsproxy.\n"
"Please read the sss_ssh_knownhosts(1) man page to learn about its replacement.\n"
"******************************************************************************\n"
"\n"
msgstr ""
"\n"
"******************************************************************************\n"
"Ditt system är konfigurerat att använda det föråldrade verktyget sss_ssh_knownhostsproxy.\n"
"Läs manualsidan sss_ssh_knownhosts(1) för information om dess ersättning.\n"
"******************************************************************************\n"
"\n"
