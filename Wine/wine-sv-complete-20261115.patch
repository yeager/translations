@@ -18086,6 +17368,54 @@ msgid ""
 "     Modify the registry without prompting for confirmation.\n"
 "\n"
 msgstr ""
+"REG ADD <key> [/v value_name | /ve] [/t type] [/s separator] [/d data] [/f]\n"
+"\n"
+"  Lägger till en nyckel i registret eller lägger till ett nytt värde i en\n"
+"  angiven registernyckel.\n"
+"\n"
+"  <key>\n"
+"     Registernyckeln som ska läggas till eller, om antingen [/v] eller [/ve]\n"
+"     har angetts, nyckeln där de nya registerdata ska läggas till.\n"
+"\n"
+"     Format: ROOT\\Subkey\n"
+"\n"
+"     ROOT: En fördefinierad registernyckel. Det måste vara en av följande:\n"
+"\n"
+"         HKEY_LOCAL_MACHINE  | HKLM\n"
+"         HKEY_CURRENT_USER   | HKCU\n"
+"         HKEY_CLASSES_ROOT   | HKCR\n"
+"         HKEY_USERS          | HKU\n"
+"         HKEY_CURRENT_CONFIG | HKCC\n"
+"\n"
+"     Subkey: Den fullständiga sökvägen till en registernyckel under en viss\n"
+"     ROOT-nyckel.\n"
+"\n"
+"  /v <value_name>\n"
+"     Namnet på registervärdet som ska läggas till.\n"
+"\n"
+"  /ve\n"
+"     Lägg till ett namnlöst registervärde. Alternativet ändrar registervärdet\n"
+"     (Default).\n"
+"\n"
+"  /t <type>\n"
+"     Datatypen som ska läggas till i registret. Om [/t] anges måste <type>\n"
+"     vara en av följande:\n"
+"\n"
+"         REG_SZ    | REG_MULTI_SZ | REG_EXPAND_SZ\n"
+"         REG_DWORD | REG_QWORD    | REG_BINARY   | REG_NONE\n"
+"\n"
+"     Om [/t] inte anges är standarddatatypen REG_SZ.\n"
+"\n"
+"  /s <separator>\n"
+"     Tecknet som används för att separera strängar i REG_MULTI_SZ-data.\n"
+"     Om [/s] inte anges är standardavgränsaren \\0.\n"
+"\n"
+"  /d <data>\n"
+"     Data som ska läggas till i det nya registervärdet.\n"
+"\n"
+"  /f\n"
+"     Ändra registret utan att be om bekräftelse.\n"
+"\n"
 
 #: programs/reg/reg.rc:202
 msgid ""
@@ -18121,6 +17451,36 @@ msgid ""
 "<key2>.\n"
 "\n"
 msgstr ""
+"REG COPY <key1> <key2> [/s] [/f]\n"
+"\n"
+"  Kopierar innehållet i en angiven registernyckel till en annan plats.\n"
+"  Som standard kopierar åtgärden endast registervärden. Använd [/s] för att\n"
+"  rekursivt kopiera alla undernycklar och värden.\n"
+"\n"
+"  <key1>, <key2>\n"
+"     Registernycklar som anger datans källa (<key1>) och mål (<key2>).\n"
+"     Om <key2> inte finns skapas den.\n"
+"\n"
+"     Format: ROOT\\Subkey\n"
+"\n"
+"     ROOT: En fördefinierad registernyckel. Det måste vara en av följande:\n"
+"\n"
+"         HKEY_LOCAL_MACHINE  | HKLM\n"
+"         HKEY_CURRENT_USER   | HKCU\n"
+"         HKEY_CLASSES_ROOT   | HKCR\n"
+"         HKEY_USERS          | HKU\n"
+"         HKEY_CURRENT_CONFIG | HKCC\n"
+"\n"
+"     Subkey: Den fullständiga sökvägen till en registernyckel under en viss\n"
+"     ROOT-nyckel.\n"
+"\n"
+"  /s\n"
+"     Kopiera alla undernycklar och värden från <key1> till <key2>.\n"
+"\n"
+"  /f\n"
+"     Skriv över alla registerdata i <key2> utan att be om bekräftelse.\n"
+"     Alternativet ändrar inte undernycklar och värden som bara finns i <key2>.\n"
+"\n"
 
 #: programs/reg/reg.rc:92
 msgid ""
@@ -18160,6 +17520,42 @@ msgid ""
 "     prompting for confirmation.\n"
 "\n"
 msgstr ""
+"REG DELETE <key> [/v value_name | /ve | /va] [/f]\n"
+"\n"
+"  Tar bort en registernyckel, inklusive alla undernycklar och värden, eller\n"
+"  tar bort ett eller flera värden från en angiven registernyckel.\n"
+"\n"
+"  <key>\n"
+"     Registernyckeln som ska tas bort eller, om [/v], [/ve] eller [/va] har\n"
+"     angetts, nyckeln från vilken ett eller flera registervärden ska tas bort.\n"
+"\n"
+"     Format: ROOT\\Subkey\n"
+"\n"
+"     ROOT: En fördefinierad registernyckel. Det måste vara en av följande:\n"
+"\n"
+"         HKEY_LOCAL_MACHINE  | HKLM\n"
+"         HKEY_CURRENT_USER   | HKCU\n"
+"         HKEY_CLASSES_ROOT   | HKCR\n"
+"         HKEY_USERS          | HKU\n"
+"         HKEY_CURRENT_CONFIG | HKCC\n"
+"\n"
+"     Subkey: Den fullständiga sökvägen till en registernyckel under en viss\n"
+"     ROOT-nyckel.\n"
+"\n"
+"  /v <value_name>\n"
+"     Namnet på registervärdet som ska tas bort.\n"
+"\n"
+"  /ve\n"
+"     Ta bort ett namnlöst registervärde. Alternativet tar bort registervärdet\n"
+"     (Default).\n"
+"\n"
+"  /va\n"
+"     Ta bort alla värden från en registernyckel.\n"
+"\n"
+"  /f\n"
+"     Ta bort en registernyckel, inklusive alla undernycklar och värden, utan\n"
+"     att be om bekräftelse.\n"
+"\n"
 
 #: programs/reg/reg.rc:170
 msgid ""
@@ -18191,6 +17587,34 @@ msgid ""
