  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:1310421511d8f3e3e69fcb76be9ad0ef:l:sv","source":"Unknown handheld detected.\n\nCareful: a less popular controller could be labeled as a handheld.","translation":"Okänd handhållen enhet upptäcktes.\n\nObservera: en mindre vanlig styrenhet kan felaktigt märkas som en handhållen enhet."},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:ec8717c52e88ab51cbcd07faa3398411:l:sv","source":"P%1 plays as a sideways Joy-Con","translation":"P%1 spelar med en sidställd Joy-Con"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:597cb75c2d25d53da16d0959846b73f8:l:sv","source":"P%1 plays as an upright Joy-Con","translation":"P%1 spelar med en stående Joy-Con"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:9c92603cbeb32c30ca7c7360eb6b5bc8:l:sv","source":"P%1 plays as a Pro Controller again","translation":"P%1 spelar åter med Pro Controller"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:5f4172b99a709664c33e00aaa7b6395c:l:sv","source":"P%1 plays as Dual Joy-Cons","translation":"P%1 spelar med dubbla Joy-Con"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:2d586a01c6585799f74861e4e5efd8bb:l:sv","source":"No controller: connect one, or use Manual for keyboard and mouse","translation":"Ingen styrenhet: anslut en eller använd Manuell för tangentbord och mus"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:2947eb7bd1bb39e3b6e70bb56664fc67:l:sv","source":"P%1 is on the built-in controls now: press a button on them, or reconnect a controller, to go on","translation":"P%1 använder nu de inbyggda kontrollerna: tryck på en knapp på dem eller återanslut en styrenhet för att fortsätta"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:796bae08ae81f2cfbeebedb774b56478:l:sv","source":"%1 disconnected: reconnect to go on","translation":"%1 kopplades från: återanslut för att fortsätta"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:88ee44db8f9d972983fa198f2e5d834a:l:sv","source":"%1 disconnected: reconnect, or press + on another controller to go on without %1","translation":"%1 kopplades från: återanslut eller tryck på + på en annan styrenhet för att fortsätta utan %1"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:31efd2630b17fcdd9324945cb2123669:l:sv","source":"Going on without %1","translation":"Fortsätter utan %1"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:564fa75e47df0b3120b8f3dcfdec4d67:l:sv","source":"%1: battery low (%2%)","translation":"%1: låg batterinivå (%2 %)"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:0849bb744fb599eb96c32bd8baaf13c4:l:sv","source":"\nBattery %1% (charging)","translation":"\nBatteri %1 % (laddar)"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:69da2f3bc0e93e9aa8c4776ee02f33d5:l:sv","source":"\nBattery %1%","translation":"\nBatteri %1 %"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:9cbc69b357fb7674636b12e395d95f3d:l:sv","source":"P%1: %2\nClick: rumble and open its settings\nArrows, or hold then drag: change the player order","translation":"P%1: %2\nKlicka: vibrera och öppna inställningarna\nPiltangenter, eller håll ned och dra: ändra spelarordningen"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:37db69368f757786fbf5af4c6776606b:l:sv","source":"P%1: %2\nClick: rumble and open its settings","translation":"P%1: %2\nKlicka: vibrera och öppna inställningarna"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:7914fbc3b41324d6fbfd14e0179d7199:l:sv","source":"No handheld controller is set. Pick Modern Console in Controls > Controllers, turn on Portable Handheld Gaming Device, and pick or identify the handheld's controller.","translation":"Ingen handhållen styrenhet är angiven. Välj Modern konsol i Kontroller > Styrenheter, aktivera Bärbar spelenhet och välj eller identifiera den handhållna enhetens styrenhet."}
]
