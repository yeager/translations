  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:0c5bc1f26ddf2e1f8f8b8fa04d3166ca:l:sv","source":"Turn Off","translation":"Stäng av"},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:536de946ece916a85ce7553851caa32d:l:sv","source":"Turns off P%1's controller and frees the player. Turn the controller on to join again.","translation":"Stänger av P%1:s styrenhet och frigör spelaren. Starta styrenheten för att ansluta igen."},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:c10a48c3a5ada74b2603acad5c79fb62:l:sv","source":"Press a button on this controller first, so Eden can tell it from the others like it.","translation":"Tryck först på en knapp på denna styrenhet så att Eden kan skilja den från andra likadana styrenheter."},
  {"id":"o:edenemu:p:eden-emulator:r:qt-translations:s:4b64d27d61a242269f70f8952b93b9eb:l:sv","source":"%1 (built-in, not a player while other controllers are connected)","translation":"%1 (inbyggd, inte en spelare medan andra styrenheter är anslutna)"},
