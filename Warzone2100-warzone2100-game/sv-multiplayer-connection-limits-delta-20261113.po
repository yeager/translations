msgid "Cannot change to a map with fewer slots."
msgstr "Det går inte att byta till en karta med färre platser."

msgid "The host has quit."
msgstr "Värden har avslutat."

msgid "Hit the ready box to begin your challenge!"
msgstr "Klicka i rutan Redo för att börja utmaningen!"

msgid "Press the start hosting button to begin hosting a game."
msgstr "Tryck på knappen för att börja vara värd för ett spel."

msgid "Port mapping creation is in progress..."
msgstr "Portmappning skapas ..."

#, c-format
msgid "Port mapping disabled by user. Autoconfig of port %d will not happen."
msgstr "Portmappning har stängts av av användaren. Port %d konfigureras inte automatiskt."

msgid "BLIND GAME NOTICE:"
msgstr "MEDDELANDE OM BLINDSPEL:"

msgid "Failed to load challenge:"
msgstr "Det gick inte att läsa in utmaningen:"

msgid "Failed to load the challenge's map or config"
msgstr "Det gick inte att läsa in utmaningens karta eller konfiguration"

msgid "Failed to process autohost config:"
msgstr "Det gick inte att bearbeta autovärdens konfiguration:"

#, c-format
msgid "Failed to load the autohost map or config from: %s"
msgstr "Det gick inte att läsa in autovärdens karta eller konfiguration från: %s"

msgid "Closed"
msgstr "Stängd"

msgid "Open"
msgstr "Öppen"

#, c-format
msgid "Replay File Saved With: \"%s\""
msgstr "Replayfil sparad med: \"%s\""

#, c-format
msgid "Current Warzone 2100 Version: \"%s\""
msgstr "Aktuell Warzone 2100-version: \"%s\""

msgid "Replay Version Mismatch"
msgstr "Fel version för replay"

#, c-format
msgid "%s has Left the Game"
msgstr "%s har lämnat spelet"

#, c-format
msgid "%s joined the Game"
msgstr "%s gick med i spelet"

#, c-format
