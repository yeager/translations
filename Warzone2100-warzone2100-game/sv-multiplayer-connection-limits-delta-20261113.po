msgid "The game is already full."
msgstr "Spelet är redan fullt."

#, c-format
msgid "%s (%u) has an incompatible mod, and has been kicked."
msgstr "%s (%u) har en inkompatibel mod och har sparkats ut."

msgid "Your data doesn't match the host's!"
msgstr "Dina data stämmer inte överens med värdens!"

#, c-format
msgid "%s is joining the game"
msgstr "%s ansluter till spelet"

msgid "Server message:"
msgstr "Servermeddelande:"

#. TRANSLATORS: Sidetext of structure limits screen
msgid "LIMITS"
msgstr "GRÄNSER"

msgid "Map Can Exceed Limits"
msgstr "Kartan kan överskrida gränser"

