msgstr "Tvinga gränser vid start"

msgid "Apply Defaults and Return To Previous Screen"
msgstr "Använd standardvärden och återgå till föregående skärm"

msgid "Accept Settings"
msgstr "Godkänn inställningar"

msgid "Limits reset to default values"
msgstr "Gränserna har återställts till standardvärden"

msgid "Limits Reset To Default Values"
msgstr "Gränser återställda till standardvärden"

msgid "Administrator has kicked you from the game."
msgstr "Administratören har sparkat ut dig från spelet."
