msgid "Destroy all New Paradigm units"
msgstr "Förstör alla enheter från New Paradigm"

msgid "Destroy all New Paradigm reinforcements"
msgstr "Förstör alla förstärkningar från New Paradigm"

msgid "Build at least 7 non-wall structures on the plateau and destroy all New Paradigm reinforcements"
msgstr "Bygg minst 7 byggnader som inte är murar på platån och förstör alla förstärkningar från New Paradigm"

msgid "Locate and rescue your units from the shot down transporter"
msgstr "Hitta och rädda dina enheter från den nedskjutna transporten"

msgid "Destroy all enemy bases"
msgstr "Förstör alla fientliga baser"

msgid "Rescue the civilians from The Collective before too many are captured"
msgstr "Rädda civila från The Collective innan alltför många tillfångatas"

msgid "Secure the Uplink from The Collective"
msgstr "Säkra Uplink från The Collective"

msgid "Send off at least one transporter with a truck and survive The Collective assault until the timer ends"
msgstr "Skicka iväg minst en transport med ett konstruktionsfordon och överlev The Collectives anfall tills tiden tar slut"

msgid "Send off as many transporters as you can and bring at least one truck"
msgstr "Skicka iväg så många transporter du kan och ta med minst ett konstruktionsfordon"

msgid "Move all units into the valley"
msgstr "Flytta alla enheter in i dalen"

msgid "Destroy the missile silos"
msgstr "Förstör robotsilorna"

msgid "Rescue Alpha team from Nexus"
msgstr "Rädda Alpha-gruppen från NEXUS"

msgid "Prevent any Nexus hover tanks from escaping the area"
msgstr "Hindra alla NEXUS-svävarstridsvagnar från att lämna området"

msgid "Destroy the Nexus HQ to disable the Nexus Intruder Program"
msgstr "Förstör NEXUS högkvarter för att slå ut NEXUS Intruder-program"

msgid "Warning: HQ shielded against VTOL attacks"
msgstr "Varning: högkvarteret är skyddat mot VTOL-anfall"

msgid "Research resistance circuits and survive the assault from Nexus"
msgstr "Forska om motståndskretsar och överlev NEXUS anfall"

msgid "Build a forward base at the silos"
msgstr "Bygg en framskjuten bas vid silorna"

msgid "Protect the missile silos and research for the missile codes"
msgstr "Skydda robotsilorna och forska fram robotkoderna"

msgid "Reunite a part of Beta team with a Gamma team outpost"
msgstr "Återförena en del av Beta-gruppen med en utpost från Gamma-gruppen"

msgid "Return to LZ"
msgstr "Återvänd till LZ"

msgid "Insane difficulty hint:"
msgstr "Tips för vansinnig svårighetsgrad:"

msgid "Fortify a strong base across the map to protect yourself from the Collective"
msgstr "Befäst en stark bas på andra sidan kartan för att skydda dig mot The Collective"

msgid "Destroy all enemy units and structures"
msgstr "Förstör alla fientliga enheter och byggnader"

msgid "Artifacts collected"
msgstr "Insamlade artefakter"

msgid "Bases destroyed"
msgstr "Förstörda baser"

msgid "Enemy units remaining"
msgstr "Fientliga enheter kvar"

msgid "Enemy structures remaining"
msgstr "Fientliga byggnader kvar"

msgid "Return to LZ required"
msgstr "Måste återvända till LZ"

msgid "Destroy all enemy units and bases"
msgstr "Förstör alla fientliga enheter och baser"

msgid "Survive until the timer reaches zero"
msgstr "Överlev tills tiden går ut"

msgid "Manufacture (F1)"
msgstr "Tillverkning (F1)"

msgid "Manufacture - build factory first"
msgstr "Tillverkning: bygg först en fabrik"

msgid "Research (F2)"
msgstr "Forskning (F2)"

msgid "Research - build research facility first"
msgstr "Forskning: bygg först en forskningsanläggning"

msgid "Build (F3)"
msgstr "Bygg (F3)"

msgid "Build - manufacture constructor droids first"
msgstr "Bygg: tillverka först konstruktionsdroidar"

msgid "Design (F4)"
msgstr "Design (F4)"

msgid "Design - construct HQ first"
msgstr "Design: bygg först ett högkvarter"

msgid "Commanders (F6)"
msgstr "Befälhavare (F6)"

msgid "Commanders - manufacture commanders first"
msgstr "Befälhavare: tillverka först befälhavare"

msgid "Close"
msgstr "Stäng"

msgid "Intelligence Display (F5)"
msgstr "Underrättelsevy (F5)"
