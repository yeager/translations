msgid "Host has declined to switch you to a Player"
msgstr "Värden har avslagit bytet till spelare"

msgid "Unable to switch to Spectator"
msgstr "Det gick inte att byta till åskådare"

msgid "Do you want to spectate?"
msgstr "Vill du vara åskådare?"

msgid "The host of this game wants to know if you're willing to spectate?"
msgstr "Värden för spelet vill veta om du vill vara åskådare."

msgid "You are currently a Player."
msgstr "Du är för närvarande spelare."

msgid "Yes, I will spectate!"
msgstr "Ja, jag blir åskådare!"

msgid "Do you want to play?"
msgstr "Vill du spela?"

msgid "The host of this game wants to know if you'd like to play?"
msgstr "Värden för spelet vill veta om du vill spela."

msgid "You are currently a Spectator."
msgstr "Du är för närvarande åskådare."

msgid "Yes, I want to play!"
msgstr "Ja, jag vill spela!"

#, c-format
msgid "Player %s has moved to Spectators"
msgstr "Spelaren %s har flyttats till åskådarna"

#, c-format
msgid "Unable to move %s to Players - no available slot"
msgstr "Det gick inte att flytta %s till spelarna – ingen plats är ledig"

msgid "Spectator would like to become a Player"
msgstr "Åskådaren vill bli spelare"

#, c-format
msgid "Spectator \"%s\" would like to become a player."
msgstr "Åskådaren \"%s\" vill bli spelare."

msgid "However, there are currently no open Player slots."
msgstr "Det finns dock inga lediga spelarplatser just nu."

msgid "Would you like to swap this Spectator with a Player?"
msgstr "Vill du byta ut en spelare mot åskådaren?"

msgid "Yes, select Player slot"
msgstr "Ja, välj spelarplats"

msgid "BLIND LOBBY NOTICE:"
msgstr "MEDDELANDE OM BLIND LOBBY:"

#, c-format
msgid "You have been assigned the codename: \"%s\""
msgstr "Du har tilldelats kodnamnet: \"%s\""

msgid "For Spectator:"
msgstr "För åskådare:"

msgid "For Player:"
msgstr "För spelare:"

msgid "Choose Player Slot"
msgstr "Välj spelarplats"

msgid "PLAYERS"
msgstr "SPELARE"

msgid "Add spectator slot"
msgstr "Lägg till åskådarplats"

msgid "Kicked from game"
msgstr "Utsparkad från spelet"

msgid "The host has disabled free chat. Please use Quick Chat."
msgstr "Värden har stängt av fri chatt. Använd snabbchatten."

msgid "Quick Chat"
msgstr "Snabbchatt"

msgid "Press the Tab key to open Quick Chat."
msgstr "Tryck på Tabb för att öppna snabbchatten."

msgid "The host has disabled free chat. Please use Quick Chat or /hostmsg commands."
msgstr "Värden har stängt av fri chatt. Använd snabbchatt eller /hostmsg-kommandon."

msgid "The host has enabled free chat for you."
msgstr "Värden har slagit på fri chatt för dig."

msgid "Copy Text to Clipboard"
msgstr "Kopiera text till urklipp"

#, c-format
msgid "Mute Player: %s"
msgstr "Tysta spelare: %s"

#, c-format
msgid "Unmute Player: %s"
msgstr "Slå på ljud för spelare: %s"

msgid "CHAT"
msgstr "CHATT"
