#, c-format
msgid "Moving %s to Spectators!"
msgstr "Flyttar %s till åskådarna!"

#, c-format
msgid "Asking %s to move to Players..."
msgstr "Ber %s att flytta till spelarna ..."

msgid "Disconnected from host:"
msgstr "Frånkopplad från värden:"

msgid "Unable to handle host redirect"
msgstr "Det går inte att hantera värdens omdirigering"

msgid "Unable to process redirect"
msgstr "Det går inte att bearbeta omdirigering"

msgid "Unable to process repeated or invalid redirects"
msgstr "Det går inte att bearbeta upprepade eller ogiltiga omdirigeringar"

msgid "Host supplied invalid options"
msgstr "Värden angav ogiltiga alternativ"

msgid "Host supplied invalid host config"
msgstr "Värden angav ogiltig värdkonfiguration"

msgid "You have been kicked: "
msgstr "Du har blivit utsparkad: "

msgid "Connection lost:"
msgstr "Anslutningen bröts:"

msgid "No connection to host."
msgstr "Ingen anslutning till värden."

msgid "The host moved me to Players, but I never gave permission for this change. Bye!"
msgstr "Värden flyttade mig till spelarna, men jag gav aldrig tillstånd till ändringen. Hej då!"

msgid "The host tried to move us to Players, but we never gave permission."
msgstr "Värden försökte flytta oss till spelarna, men vi gav aldrig tillstånd."

msgid "Cannot change to a map with too few slots for all players."
msgstr "Det går inte att byta till en karta med för få platser för alla spelare."

msgid "Player names will not be visible to other players (until the game is over)"
msgstr "Spelarnamn kommer inte att visas för andra spelare förrän matchen är slut"

msgid "Player names will not be visible to other players (until the game has started)"
msgstr "Spelarnamn kommer inte att visas för andra spelare förrän matchen har startat"

msgid "IMPORTANT: The host is a player, and can see and configure other players (!)"
msgstr "VIKTIGT: Värden är spelare och kan se samt konfigurera andra spelare (!)"

msgid "The host is a spectator, and can see player identities and configure players / teams"
msgstr "Värden är åskådare och kan se spelares identitet samt konfigurera spelare och lag"
