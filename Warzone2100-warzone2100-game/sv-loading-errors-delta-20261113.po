#, c-format
msgid ""
"The required mod could not be loaded: %s\n"
"\n"
"Warzone will try to load the game without it."
msgstr ""
"Den nödvändiga modden kunde inte läsas in: %s\n"
"\n"
"Warzone försöker läsa in spelet utan den."

#, c-format
msgid "Failure to load %zu game model(s)"
msgstr "Kunde inte läsa in %zu spelmodell(er)"

#, c-format
msgid "Failure to load textures for %zu model(s)"
msgstr "Kunde inte läsa in texturer för %zu modell(er)"

#, c-format
msgid "Failure to load model for %zu stat(s)"
msgstr "Kunde inte läsa in modell för %zu statistikpost(er)"

msgid "Warzone 2100 encountered error(s) loading game data:"
msgstr "Warzone 2100 påträffade fel när speldata lästes in:"

msgid "Please try removing any new mods - they may have issues or be incompatible with this version."
msgstr "Försök ta bort nya moddar. De kan vara felaktiga eller inkompatibla med den här versionen."

msgid "Loaded mod(s):"
msgstr "Inlästa moddar:"

msgid "Base game files may be corrupt or outdated - please try reinstalling the game."
msgstr "Spelets grundfiler kan vara skadade eller inaktuella. Försök installera om spelet."

msgid "Error Loading Game Data"
msgstr "Fel vid inläsning av speldata"
