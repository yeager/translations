#, c-format
msgid "(Player %u) is using cheat :%s %s"
msgstr "(Spelare %u) använder fuskkoden: %s %s"

msgid "Researched"
msgstr "Forskat fram"

msgid "Only displaying energy bars when selected"
msgstr "Visar bara energimätare när enheten är markerad"

msgid "Always displaying energy bars for units"
msgstr "Visar alltid energimätare för enheter"

msgid "Always displaying energy bars for units and structures"
msgstr "Visar alltid energimätare för enheter och byggnader"

msgid "Debug menu is Open"
msgstr "Felsökningsmenyn är öppen"

msgid "Unable to locate any oil derricks!"
msgstr "Det gick inte att hitta några oljetorn!"

msgid "Oh, the weather outside is frightful... SNOW"
msgstr "Usch, vilket förfärligt väder där ute ... SNÖ"

msgid "Singing in the rain, I'm singing in the rain... RAIN"
msgstr "Sjunger i regnet, jag sjunger i regnet ... REGN"

msgid "Forecast : Clear skies for all areas... NO WEATHER"
msgstr "Prognos: Klar himmel överallt ... INGET VÄDER"

msgid "Warning! This can have drastic consequences if used incorrectly in missions."
msgstr "Varning! Detta kan få drastiska följder om det används fel i uppdrag."

msgid "All enemies destroyed by cheating!"
msgstr "Alla fiender har förstörts med fuskkod!"

msgid "Destroying selected droids and structures!"
msgstr "Förstör markerade droider och byggnader!"

msgid "Reveal OFF"
msgstr "Avslöja AV"

msgid "Reveal ON"
msgstr "Avslöja PÅ"

msgid "Centered on player HQ, direction NORTH"
msgstr "Centrerad på spelarens högkvarter, riktning NORR"

msgid "Unable to locate HQ!"
msgstr "Det gick inte att hitta högkvarteret!"

msgid "Formation speed limiting ON"
msgstr "Hastighetsbegränsning för formationer PÅ"

msgid "Formation speed limiting OFF"
msgstr "Hastighetsbegränsning för formationer AV"

msgid "Vertical rotation direction: Normal"
msgstr "Lodrät rotationsriktning: Normal"

msgid "Vertical rotation direction: Flipped"
msgstr "Lodrät rotationsriktning: Omvänd"

msgid "Screen shake when things die: Off"
msgstr "Skärmskakning när något förstörs: Av"

msgid "Screen shake when things die: On"
msgstr "Skärmskakning när något förstörs: På"

msgid "Sorry, but game speed cannot be changed in multiplayer."
msgstr "Tyvärr går det inte att ändra spelhastigheten i flerspelarspel."

msgid "Game Speed Reset"
msgstr "Spelhastigheten återställd"

#, c-format
msgid "Game Speed Increased to %s"
msgstr "Spelhastigheten höjd till %s"

#, c-format
msgid "Game Speed Reduced to %s"
msgstr "Spelhastigheten sänkt till %s"

msgid "Radar showing friend-foe colors"
msgstr "Radarn visar vän- och fiendefärger"

msgid "Radar showing player colors"
msgstr "Radarn visar spelarfärger"

msgid "Radar showing only objects"
msgstr "Radarn visar endast objekt"

msgid "Radar blending terrain and height"
msgstr "Radarn blandar terräng och höjd"

msgid "Radar showing terrain"
msgstr "Radarn visar terräng"

msgid "Radar showing height"
msgstr "Radarn visar höjd"

msgid "Asserts turned off"
msgstr "Assert-kontroller är avstängda"

msgid "QuickSave not allowed for multiplayer or tutorial games"
msgstr "Snabbsparning är inte tillåten i flerspelarspel eller handledningar"

msgid "QuickSave not allowed in Autosaves-Only mode"
msgstr "Snabbsparning är inte tillåten i läget med endast automatiska sparningar"

msgid "QuickSave failed"
msgstr "Snabbsparning misslyckades"

msgid "QuickLoad not allowed for multiplayer or tutorial games"
msgstr "Snabbinläsning är inte tillåten i flerspelarspel eller handledningar"

msgid "QuickLoad not allowed in Autosaves-Only mode"
msgstr "Snabbinläsning är inte tillåten i läget med endast automatiska sparningar"

msgid "QuickSave file does not exist yet"
msgstr "Det finns ännu ingen snabbsparningsfil"
