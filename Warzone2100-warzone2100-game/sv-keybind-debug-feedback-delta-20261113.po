msgid "Allow"
msgstr "Tillåt"

msgid "Sorry, that cheat is disabled in multiplayer games."
msgstr "Tyvärr är den fuskkoden avstängd i flerspelarspel."

msgid "Warning! This cheat is buggy.  We recommend to NOT use it."
msgstr "Varning! Den här fuskkoden är buggig. Vi rekommenderar att den INTE används."

msgid "Gateways toggled."
msgstr "Portpassager har växlats."

msgid "Path display toggled."
msgstr "Sökvägsvisning har växlats."

#, c-format
msgid "Player %d: %d power"
msgstr "Spelare %d: %d energi"

msgid "Ouch! Droid's health is down 20%!"
msgstr "Aj! Droidens hälsa har minskat med 20 %!"

msgid "Ouch! Structure's health is down 20%!"
msgstr "Aj! Byggnadens hälsa har minskat med 20 %!"

msgid "Lets us see what you see!"
msgstr "Låt oss se det du ser!"

msgid "Fine, weapon & sensor display is off!"
msgstr "Okej, visning av vapen och sensorer är avstängd!"

msgid "View Aligned to South"
msgstr "Vyn är riktad mot söder"

msgid "View Aligned to East"
msgstr "Vyn är riktad mot öster"

msgid "View Aligned to West"
msgstr "Vyn är riktad mot väster"

#, c-format
msgid "Player %u is cheating a new droid army of: %d × %s."
msgstr "Spelare %u fuskar fram en ny droidarmé med: %d × %s."

#, c-format
msgid "(Player %u) is using cheat :%s"
msgstr "(Spelare %u) använder fuskkoden: %s"

msgid "Hard as nails!!!"
msgstr "Hård som stål!!!"

msgid "1000 big ones!!!"
msgstr "1 000 stora!!!"

msgid "Power overwhelming"
msgstr "Överväldigande energi"

msgid "A power fantasy!"
msgstr "En energifantasi!"

msgid "Taking things easy!"
msgstr "Tar det lugnt!"

msgid "Back to normality!"
msgstr "Tillbaka till normalt!"

msgid "Getting tricky!"
msgstr "Nu blir det knepigt!"

msgid "In a nightmare!"
msgstr "I en mardröm!"

msgid "Twice as nice!"
msgstr "Dubbelt så bra!"

msgid "FPS display is enabled."
msgstr "FPS-visning är påslagen."

msgid "FPS display is disabled."
msgstr "FPS-visning är avstängd."

msgid "Unit count display is enabled."
msgstr "Visning av antalet enheter är påslagen."

msgid "Unit count display is disabled."
msgstr "Visning av antalet enheter är avstängd."

#, c-format
msgid "(Player %u) is using a cheat :Num Droids: %d  Num Structures: %d  Num Features: %d"
msgstr "(Spelare %u) använder en fuskkod: Antal droider: %d  Antal byggnader: %d  Antal objekt: %d"

msgid "Infinite power disabled"
msgstr "Obegränsad energi är avstängd"

msgid "Infinite power enabled"
msgstr "Obegränsad energi är påslagen"

msgid "Lighting values for all tiles recalculated"
msgstr "Ljusstyrkevärden för alla rutor har räknats om"

msgid "All items made available"
msgstr "Alla objekt har gjorts tillgängliga"

msgid "Tile info dumped into log"
msgstr "Rutinutskrift har lagts i loggen"

msgid "Fog on"
msgstr "Dimma på"

msgid "Fog off"
msgstr "Dimma av"

#, c-format
msgid "Setting radar zoom to %u"
msgstr "Ställer in radarzoom på %u"

msgid "Toggling debug mapping priority: "
msgstr "Växlar prioritet för felsökningsmappning: "

msgid "Disabling level editor"
msgstr "Stänger av banredigeraren"

msgid "Enabling level editor"
msgstr "Slår på banredigeraren"

msgid "God Mode ON"
msgstr "Gudsläge PÅ"

msgid "God Mode OFF"
msgstr "Gudsläge AV"

msgid "View Aligned to North"
msgstr "Vyn är riktad mot norr"
