#: data/base/messages/strings/cam1strings.txt:3
#: data/base/sequenceaudio/cam1/c001.txa:12
msgid "OBJECTIVE: Locate and recover neural synapse technology"
msgstr "MÅL: Lokalisera och återta synapslänkstekniken"

#: data/base/messages/strings/cam1strings.txt:4
#: data/base/sequenceaudio/cam1/c001.txa:13
msgid "Establish a base, then search for a Pre-Collapse structure."
msgstr "Upprätta en bas och sök sedan efter en byggnad från tiden före kollapsen."

#: data/base/messages/strings/cam1strings.txt:5
#: data/base/sequenceaudio/cam1/c001.txa:14
msgid ""
"This structure contains technology vital for the success of the Project."
msgstr "Denna byggnad innehåller teknik som är avgörande för projektets framgång."

#: data/base/messages/strings/cam1strings.txt:7
msgid "ALPHA BASE MISSION: Scavenger Raiders"
msgstr "ALFABASUPPDRAG: Skrotarattack"

#: data/base/messages/strings/cam1strings.txt:8
msgid "Scavenger raiders are approaching our base."
msgstr "Skrotare närmar sig vår bas."

#: data/base/messages/strings/cam1strings.txt:9
msgid "Defend the base then destroy the Scavenger camps."
msgstr "Försvara basen och förstör sedan skrotarnas läger."

#: data/base/messages/strings/cam1strings.txt:11
#: data/base/messages/strings/cam1strings.txt:65
msgid "ALPHA BASE MISSION: Power Surge Detected"
msgstr "ALFABASUPPDRAG: Energistöt upptäckt"

#: data/base/messages/strings/cam1strings.txt:12
msgid "A power surge has been detected to the south of our position."
msgstr "En energistöt har upptäckts söder om vår position."

#: data/base/messages/strings/cam1strings.txt:13
msgid "Investigate and secure the area."
msgstr "Undersök och säkra området."

#: data/base/messages/strings/cam1strings.txt:15
msgid "ALPHA BASE MISSION: The New Paradigm"
msgstr "ALFABASUPPDRAG: New Paradigm"

#: data/base/messages/strings/cam1strings.txt:16
msgid "The New Paradigm control superior weapons technology."
msgstr "New Paradigm förfogar över överlägsen vapenteknik."

#: data/base/messages/strings/cam1strings.txt:17
msgid "They may have the synaptic link technology, it's vital we retrieve it."
msgstr "De kan ha synapslänkstekniken; det är avgörande att vi återtar den."

#: data/base/messages/strings/cam1strings.txt:19
msgid "TRANSPORT MISSION: Locate and Recover Artifacts"
msgstr "TRANSPORTUPPDRAG: Lokalisera och återta artefakter"

#: data/base/messages/strings/cam1strings.txt:20
msgid "Load an attack force into the transport."
msgstr "Last en attackstyrka i transporten."

#: data/base/messages/strings/cam1strings.txt:21
msgid "On landing, explore the ruins and recover any artifacts."
msgstr "Efter landningen ska du genomsöka ruinerna och återta alla artefakter."

#: data/base/messages/strings/cam1strings.txt:23
msgid "TRANSPORT MISSION: Investigate Research Center"
msgstr "TRANSPORTUPPDRAG: Undersök forskningscentret"

#: data/base/messages/strings/cam1strings.txt:24
msgid "Investigate the area and recover any artifacts present."
msgstr "Undersök området och återta alla artefakter som finns där."

#: data/base/messages/strings/cam1strings.txt:25
#: data/base/messages/strings/cam1strings.txt:147
msgid "Reinforcements are available."
msgstr "Förstärkningar är tillgängliga."

#: data/base/messages/strings/cam1strings.txt:27
msgid "TRANSPORT MISSION: Encoded Signals Detected"
msgstr "TRANSPORTUPPDRAG: Kodade signaler upptäckta"

#: data/base/messages/strings/cam1strings.txt:28
msgid "Take a scout force to investigate these signals."
msgstr "Skicka en spaningsstyrka för att undersöka signalerna."

#: data/base/messages/strings/cam1strings.txt:29
msgid "Use your trucks to build defenses at your LZ."
msgstr "Använd dina konstruktionsfordon för att bygga försvar vid din LZ."

#: data/base/messages/strings/cam1strings.txt:31
msgid "TRANSPORT MISSION: Enemy Transmissions Detected"
msgstr "TRANSPORTUPPDRAG: Fientliga sändningar upptäckta"

#: data/base/messages/strings/cam1strings.txt:32
msgid "Scout the designated area for enemy research facilities."
msgstr "Spana av det angivna området efter fientliga forskningsanläggningar."

#: data/base/messages/strings/cam1strings.txt:33
msgid "Proceed to LZ#2. Do not engage the enemy at this time."
msgstr "Fortsätt till LZ#2. Angrip inte fienden nu."

#: data/base/messages/strings/cam1strings.txt:35
msgid "TRANSPORT MISSION: Synaptic Link Location"
msgstr "TRANSPORTUPPDRAG: Synapslänkens plats"

#: data/base/messages/strings/cam1strings.txt:36
msgid ""
"The New Paradigm are analyzing synaptic link technology at this location."
msgstr "New Paradigm analyserar synapslänksteknik på den här platsen."

#: data/base/messages/strings/cam1strings.txt:37
msgid "Assemble an attack team and recover the synaptic link technology."
msgstr "Samla en attackgrupp och återta synapslänkstekniken."

#: data/base/messages/strings/cam1strings.txt:39
msgid "TRANSPORT MISSION: New Objectives"
msgstr "TRANSPORTUPPDRAG: Nya mål"

#: data/base/messages/strings/cam1strings.txt:40
msgid "New Paradigm are searching for artifacts in this vicinity."
msgstr "New Paradigm söker efter artefakter i närheten."

#: data/base/messages/strings/cam1strings.txt:41
msgid "Intercept them. Do not let any enemies exit this area."
msgstr "Stoppa dem. Låt ingen fiende lämna området."

#: data/base/messages/strings/cam1strings.txt:43
msgid "TRANSPORT MISSION: Enemy Base Under Construction"
msgstr "TRANSPORTUPPDRAG: Fientlig bas under uppförande"

#: data/base/messages/strings/cam1strings.txt:44
msgid "Enemy forces are establishing a forward base at this location."
msgstr "Fientliga styrkor upprättar en framskjuten bas på den här platsen."

#: data/base/messages/strings/cam1strings.txt:45
msgid "Eradicate the base and secure the area."
msgstr "Utplåna basen och säkra området."

#: data/base/messages/strings/cam1strings.txt:48
msgid "ALPHA BASE MISSION: Establish a Forward Base"
msgstr "ALFABASUPPDRAG: Upprätta en framskjuten bas"

#: data/base/messages/strings/cam1strings.txt:49
msgid "Establish a forward base on the plateau and fend off the New Paradigm."
msgstr "Upprätta en framskjuten bas på platån och håll New Paradigm stången."

#: data/base/messages/strings/cam1strings.txt:50
msgid "Build defensive structures until the green objective blip disappears."
msgstr "Bygg försvarsbyggnader tills den gröna målmarkören försvinner."

#: data/base/messages/strings/cam1strings.txt:52
msgid "ALPHA BASE MISSION: Counter Attack"
msgstr "ALFABASUPPDRAG: Motanfall"

#: data/base/messages/strings/cam1strings.txt:53
msgid "Enemy forces are approaching from the east and north."
msgstr "Fientliga styrkor närmar sig från öster och norr."

#: data/base/messages/strings/cam1strings.txt:54
msgid "Hold the bases and repulse any attacks."
msgstr "Håll baserna och slå tillbaka alla anfall."

#: data/base/messages/strings/cam1strings.txt:56
msgid "ALPHA BASE MISSION: Incoming Transmission"
msgstr "ALFABASUPPDRAG: Inkommande sändning"

#: data/base/messages/strings/cam1strings.txt:57
msgid "We are detecting enemy forces at these locations."
msgstr "Vi upptäcker fientliga styrkor på dessa platser."

#: data/base/messages/strings/cam1strings.txt:58
msgid "This is our chance to defeat the New Paradigm and destroy their base."
msgstr "Nu kan vi besegra New Paradigm och förstöra deras bas."

#: data/base/messages/strings/cam1strings.txt:66
msgid "Congratulations Commander."
msgstr "Gratulerar, befälhavare."

#: data/base/messages/strings/cam1strings.txt:67
msgid "We now have a further task for you."
msgstr "Vi har nu ytterligare en uppgift åt dig."

#: data/base/messages/strings/cam1strings.txt:70
msgid "ALPHA BASE MISSION: Locate and Recover Artifacts"
msgstr "ALFABASUPPDRAG: Lokalisera och återta artefakter"

#: data/base/messages/strings/cam1strings.txt:71
msgid "The first two zones are now secure."
msgstr "De två första zonerna är nu säkrade."

#: data/base/messages/strings/cam1strings.txt:75
msgid "PROJECT TEAM UPDATES"
msgstr "UPPDATERINGAR FRÅN PROJEKTGRUPPEN"

#: data/base/messages/strings/cam1strings.txt:78
msgid "TEAM BETA UPDATE"
msgstr "UPPDATERING FRÅN GRUPP BETA"

#: data/base/messages/strings/cam1strings.txt:79
msgid "We have recovered some artifacts."
msgstr "Vi har återtagit några artefakter."

#: data/base/messages/strings/cam1strings.txt:80
msgid "There is a better equipped force operating in this area."
msgstr "En bättre utrustad styrka är verksam i området."

#: data/base/messages/strings/cam1strings.txt:83
msgid "TEAM GAMMA UPDATE"
msgstr "UPPDATERING FRÅN GRUPP GAMMA"

#: data/base/messages/strings/cam1strings.txt:84
msgid "Nothing to report."
msgstr "Inget att rapportera."

#: data/base/messages/strings/cam1strings.txt:85
msgid "We've discovered no artifacts and encountered no hostiles."
msgstr "Vi har inte upptäckt några artefakter eller mött några fientliga styrkor."

#: data/base/messages/strings/cam1strings.txt:88
msgid "ALPHA BASE INTELLIGENCE REPORT: Enemy Attack"
msgstr "ALFABASENS UNDERRÄTTELSERAPPORT: Fientligt anfall"

#: data/base/messages/strings/cam1strings.txt:89
msgid "We are detecting an enemy attack force at this location."
msgstr "Vi upptäcker en fientlig attackstyrka på den här platsen."

#: data/base/messages/strings/cam1strings.txt:93
msgid "PRIMARY OBJECTIVE"
msgstr "HUVUDMÅL"

#: data/base/messages/strings/cam1strings.txt:94
msgid "This structure is your primary objective."
msgstr "Denna byggnad är ditt huvudmål."

#: data/base/messages/strings/cam1strings.txt:95
msgid "Search for and recover any artifacts here."
msgstr "Sök efter och återta alla artefakter här."

#: data/base/messages/strings/cam1strings.txt:97
msgid "ENEMY LZ"
msgstr "FIENDENS LZ"

#: data/base/messages/strings/cam1strings.txt:98
msgid "Destroy this LZ to prevent enemy landings."
msgstr "Förstör denna LZ för att förhindra fiendelandningar."

#: data/base/messages/strings/cam1strings.txt:101
msgid "ALPHA BASE INTELLIGENCE REPORT: NEXUS"
msgstr "ALFABASENS UNDERRÄTTELSERAPPORT: NEXUS"

#: data/base/messages/strings/cam1strings.txt:102
msgid "New objective."
msgstr "Nytt mål."

#: data/base/messages/strings/cam1strings.txt:103
msgid "We have detected and isolated an intruder program."
msgstr "Vi har upptäckt och isolerat ett intrångsprogram."

#: data/base/messages/strings/cam1strings.txt:108
msgid "Supplemental"
msgstr "Tillägg"

#: data/base/messages/strings/cam1strings.txt:109
msgid "The synaptic link technology was at this location but was removed."
msgstr "Synapslänkstekniken fanns på denna plats men har flyttats."

#: data/base/messages/strings/cam1strings.txt:111
msgid ""
"Establish a forward base then continue the search for the synaptic link."
msgstr "Upprätta en framskjuten bas och fortsätt sedan sökandet efter synapslänken."

#: data/base/messages/strings/cam1strings.txt:114
msgid "INCOMING TRANSMISSION"
msgstr "INKOMMANDE SÄNDNING"

#: data/base/messages/strings/cam1strings.txt:115
msgid "Decoding in progress....."
msgstr "Avkodning pågår....."

#: data/base/messages/strings/cam1strings.txt:119
msgid "Commander."
msgstr "Befälhavare."

#: data/base/messages/strings/cam1strings.txt:120
msgid "We have decoded the incoming message to the New Paradigm..."
msgstr "Vi har avkodat det inkommande meddelandet till New Paradigm..."

#: data/base/messages/strings/cam1strings.txt:123
msgid "Destroy Enemy Base"
msgstr "Förstör fiendens bas"

#: data/base/messages/strings/cam1strings.txt:124
msgid "Assemble an attack force and board the transport."
msgstr "Samla en attackstyrka och gå ombord på transporten."

#: data/base/messages/strings/cam1strings.txt:125
msgid "Destroy the base and recover any artifacts present."
msgstr "Förstör basen och återta alla artefakter som finns där."

#: data/base/messages/strings/cam1strings.txt:128
msgid "The synaptic link technology has been recovered!"
msgstr "Synapslänkstekniken har återtagits!"

#: data/base/messages/strings/cam1strings.txt:129
msgid "Initial research confirms it will be of great benefit to the Project."
msgstr "Inledande forskning bekräftar att den kommer att gynna projektet stort."

#: data/base/messages/strings/cam1strings.txt:132
msgid "Base Beta is under heavy attack, they may need assistance."
msgstr "Bas Beta är under hårt angrepp; den kan behöva hjälp."

#: data/base/messages/strings/cam1strings.txt:133
msgid "We will send further updates as they arrive."
msgstr "Vi skickar fler uppdateringar när de kommer."

#: data/base/messages/strings/cam1strings.txt:136
msgid "This transmission was intercepted a few minutes ago."
msgstr "Denna sändning snappades upp för några minuter sedan."

#: data/base/messages/strings/cam1strings.txt:137
msgid "It originates from the east."
msgstr "Den kommer från öster."

#: data/base/messages/strings/cam1strings.txt:140
msgid "POWER MODULE ARTIFACT"
msgstr "ARTEFAKT: ENERGIMODUL"

#: data/base/messages/strings/cam1strings.txt:141
msgid "Research the power module artifact."
msgstr "Forska på artefakten med energimodulen."

#: data/base/messages/strings/cam1strings.txt:142
msgid "Then use a truck to upgrade your power generator with the module."
msgstr "Använd sedan ett konstruktionsfordon för att uppgradera din energigenerator med modulen."

#: data/base/messages/strings/cam1strings.txt:145
msgid "SCAVENGER BASE DETECTED"
msgstr "SKROTARBAS UPPTÄCKT"

#: data/base/messages/strings/cam1strings.txt:146
msgid "Defeat the scavengers and retrieve any artifacts."
msgstr "Besegra skrotarna och återta alla artefakter."

#: data/base/messages/strings/cam1strings.txt:150
msgid ""
"Congratulations on defeating the New Paradigm, this sector is now secure."
msgstr "Gratulerar till segern över New Paradigm. Den här sektorn är nu säkrad."

#: data/base/messages/strings/cam1strings.txt:151
msgid "The Nexus Intruder Program was in the New Paradigm system."
msgstr "NEXUS intrångsprogram fanns i New Paradigms system."

#: data/base/messages/strings/cam1strings.txt:152
msgid "We recorded two conversations with it, extracts follow..."
msgstr "Vi spelade in två samtal med det. Utdrag följer..."

#: data/base/messages/strings/cam1strings.txt:155
msgid "We'll keep you informed of further developments"
msgstr "Vi håller dig informerad om fortsatta händelser"

#: data/base/messages/strings/cam1strings.txt:157
#: data/base/sequenceaudio/cam1/c001end.txt:7
msgid "Commander you are to assist Team Beta"
msgstr "Befälhavare, du ska bistå grupp Beta"

#: data/base/messages/strings/cam2strings.txt:4
#: data/base/sequenceaudio/cam2/c002.txa:8
#: data/base/sequenceaudio/cam2/c002.txa:14
msgid "BETA BASE MISSION: Eastern Sector"
msgstr "BETABASUPPDRAG: Östra sektorn"

#: data/base/messages/strings/cam2strings.txt:5
#: data/base/sequenceaudio/cam2/c002.txa:9
msgid "Upon arrival you are to assume command of the base."
msgstr "Vid ankomsten ska du ta över befälet över basen."

#: data/base/messages/strings/cam2strings.txt:6
msgid "You must defend it and hold it."
msgstr "Du måste försvara och hålla den."

#: data/base/messages/strings/cam2strings.txt:9
#: data/base/sequenceaudio/cam2/c002.txa:16
msgid "BETA BASE MISSION: Defend and Fortify"
msgstr "BETABASUPPDRAG: Försvara och befäst"

#: data/base/messages/strings/cam2strings.txt:10
#: data/base/messages/strings/cam2strings.txt:33
#: data/base/sequenceaudio/cam2/c002.txa:17
msgid "Be sure to fortify the perimeter and establish anti-aircraft defenses."
msgstr "Befäst omkretsen och upprätta luftvärn."

#: data/base/messages/strings/cam2strings.txt:11
#: data/base/messages/strings/cam2strings.txt:34
#: data/base/sequenceaudio/cam2/c002.txa:18
msgid "New technologies are available."
msgstr "Ny teknik är tillgänglig."

#: data/base/messages/strings/cam2strings.txt:14
msgid "We are currently detecting coded bitstream signals."
msgstr "Vi upptäcker nu kodade bitströmsignaler."

#: data/base/messages/strings/cam2strings.txt:15
#: data/base/messages/strings/cam2strings.txt:39
msgid "Decoding..."
msgstr "Avkodning..."

#: data/base/messages/strings/cam2strings.txt:18
#: data/base/messages/strings/cam2strings.txt:22
msgid "TRANSPORT MISSION: Transport Down"
msgstr "TRANSPORTUPPDRAG: Transport nedskjuten"

#: data/base/messages/strings/cam2strings.txt:19
msgid "Our transport carrying units from team Alpha Base has been shot down."
msgstr "Vår transport med enheter från alfabasen har skjutits ned."

#: data/base/messages/strings/cam2strings.txt:23
msgid "It is under attack from The Collective at this location."
msgstr "Den angrips av The Collective på den här platsen."

#: data/base/messages/strings/cam2strings.txt:24
msgid "Assemble a rescue team to recover the transport and its cargo."
msgstr "Samla en räddningsgrupp för att återta transporten och dess last."

#: data/base/messages/strings/cam2strings.txt:27
msgid "IN-FLIGHT BRIEFING"
msgstr "BRIEFING I LUFTEN"

#: data/base/messages/strings/cam2strings.txt:28
msgid ""
"Team Beta are searching for Vertical Takeoff and Landing (VTOL) technology."
msgstr "Grupp Beta söker efter teknik för vertikal start och landning (VTOL)."

#: data/base/messages/strings/cam2strings.txt:29
msgid "It's believed to be at a pre-Collapse airbase in this area."
msgstr "Man tror att den finns på en flygbas från tiden före kollapsen i området."

#: data/base/messages/strings/cam2strings.txt:32
msgid "Team Beta under heavy attack"
msgstr "Grupp Beta under hårt angrepp"

#: data/base/messages/strings/cam2strings.txt:37
msgid "BETA BASE MISSION: Hold at all costs"
msgstr "BETABASUPPDRAG: Håll ställningarna till varje pris"

#: data/base/messages/strings/cam2strings.txt:38
msgid "We are detecting coded bitstream signals from the Collective."
msgstr "Vi upptäcker kodade bitströmsignaler från The Collective."

#: data/base/messages/strings/cam2strings.txt:42
msgid "BETA BASE MISSION: Hold At All Costs"
msgstr "BETABASUPPDRAG: Håll ställningarna till varje pris"

#: data/base/messages/strings/cam2strings.txt:43
msgid "We are detecting ground and aerial forces from the north."
msgstr "Vi upptäcker mark- och luftstyrkor från norr."

#: data/base/messages/strings/cam2strings.txt:44
msgid ""
"Hold your position and repulse these attacks, then eradicate the enemy's "
"northern base."
msgstr "Håll ställningarna och slå tillbaka anfallen. Utplåna sedan fiendens nordliga bas."

#: data/base/messages/strings/cam2strings.txt:47
msgid "TRANSPORT MISSION: Intercept convoy."
msgstr "TRANSPORTUPPDRAG: Stoppa konvojen."

#: data/base/messages/strings/cam2strings.txt:48
msgid ""
"Data from the Collective's base indicates the presence of the NEXUS intruder "
"program."
msgstr "Data från The Collectives bas tyder på att NEXUS intrångsprogram finns där."

#: data/base/messages/strings/cam2strings.txt:49
msgid "Before NEXUS switched itself off-line we accessed the following."
msgstr "Innan NEXUS kopplade ned sig fick vi tillgång till följande."

#: data/base/messages/strings/cam2strings.txt:51
msgid ""
"An enemy commander is collecting a shipment from NEXUS at this location."
msgstr "En fientlig befälhavare hämtar en försändelse från NEXUS på den här platsen."

#: data/base/messages/strings/cam2strings.txt:52
msgid "Once at the LZ, eradicate the enemy commander and recover the shipment."
msgstr "När du är vid LZ ska du utplåna den fientliga befälhavaren och återta försändelsen."

#: data/base/messages/strings/cam2strings.txt:53
msgid "Then return to the LZ."
msgstr "Återvänd sedan till LZ."

#: data/base/messages/strings/cam2strings.txt:55
msgid "Disturbing news regarding NASDA."
msgstr "Oroande nyheter om NASDA."

#: data/base/messages/strings/cam2strings.txt:58
#: data/base/messages/strings/cam2strings.txt:63
msgid "TRANSPORT MISSION: Search for and Destroy Convoy"
msgstr "TRANSPORTUPPDRAG: Sök upp och förstör konvojen"

#: data/base/messages/strings/cam2strings.txt:59
msgid "The shipment you recovered was a decoy."
msgstr "Försändelsen du återtog var ett lockbete."

#: data/base/messages/strings/cam2strings.txt:60
msgid "We have detected another convoy proceeding along the river."
msgstr "Vi har upptäckt en annan konvoj som följer floden."

#: data/base/messages/strings/cam2strings.txt:64
msgid "You are to intercept the convoy and recover its cargo."
msgstr "Stoppa konvojen och återta dess last."

#: data/base/messages/strings/cam2strings.txt:65
msgid "Enemy VTOLs are likely to be flying close escort."
msgstr "Fientliga VTOL-farkoster lär eskortera på nära håll."

#: data/base/messages/strings/cam2strings.txt:68
#: data/base/messages/strings/cam2strings.txt:72
msgid "TRANSPORT MISSION: Rescue civilians from Containment Camp"
msgstr "TRANSPORTUPPDRAG: Rädda civila från interneringslägret"

#: data/base/messages/strings/cam2strings.txt:69
msgid "The Collective are processing and exterminating civilians at this base."
msgstr "The Collective internerar och utrotar civila vid den här basen."

#: data/base/messages/strings/cam2strings.txt:73
msgid "You are to rescue the civilians."
msgstr "Du ska rädda de civila."

#: data/base/messages/strings/cam2strings.txt:74
msgid "Then destroy the camp."
msgstr "Förstör sedan lägret."

#: data/base/messages/strings/cam2strings.txt:77
msgid "BETA BASE MISSION: Destroy Enemy Air Base and Recover VTOLs."
msgstr "BETABASUPPDRAG: Förstör fiendens flygbas och återta VTOL-farkoster."

#: data/base/messages/strings/cam2strings.txt:78
msgid ""
"Analysis of flight paths indicate that The Collective's VTOLs originate from "
"here."
msgstr "Analys av flygbanorna tyder på att The Collectives VTOL-farkoster kommer härifrån."

#: data/base/messages/strings/cam2strings.txt:81
msgid "BETA BASE MISSION: Destroy Enemy Air Base and Recover VTOLs"
msgstr "BETABASUPPDRAG: Förstör fiendens flygbas och återta VTOL-farkoster"

#: data/base/messages/strings/cam2strings.txt:82
msgid ""
"The location of the enemy airbase is here; this is your primary objective."
msgstr "Fiendens flygbas finns här; detta är ditt huvudmål."

#: data/base/messages/strings/cam2strings.txt:83
msgid "Eradicate all Collective forces and recover all artifacts."
msgstr "Utplåna alla styrkor från The Collective och återta alla artefakter."

#: data/base/messages/strings/cam2strings.txt:86
#: data/base/messages/strings/cam2strings.txt:91
msgid "SECONDARY MISSION: Destroy or Drive Off Enemy Transport"
msgstr "SIDOUPPDRAG: Förstör eller driv bort fiendens transport"

#: data/base/messages/strings/cam2strings.txt:87
msgid "The Collective are rounding up all civilians in this area."
msgstr "The Collective samlar ihop alla civila i området."

#: data/base/messages/strings/cam2strings.txt:88
msgid "They are then flying them to an unknown location."
msgstr "De flyger dem sedan till en okänd plats."

#: data/base/messages/strings/cam2strings.txt:92
msgid "Destroy or drive off The Collective's transport."
msgstr "Förstör eller driv bort The Collectives transport."

#: data/base/messages/strings/cam2strings.txt:93
msgid "Rescue as many civilians as possible."
msgstr "Rädda så många civila som möjligt."

#: data/base/messages/strings/cam2strings.txt:96
#: data/base/messages/strings/cam2strings.txt:101
msgid "TRANSPORT MISSION: Destroy Reactor"
msgstr "TRANSPORTUPPDRAG: Förstör reaktorn"

#: data/base/messages/strings/cam2strings.txt:97
msgid "The Collective are searching for knowledge of nuclear reactors."
msgstr "The Collective söker kunskap om kärnreaktorer."

#: data/base/messages/strings/cam2strings.txt:98
msgid "They must be stopped."
msgstr "De måste stoppas."

#: data/base/messages/strings/cam2strings.txt:102
msgid "Proceed from the LZ to the reactor and destroy it."
msgstr "Ta dig från LZ till reaktorn och förstör den."

#: data/base/messages/strings/cam2strings.txt:103
msgid "Do not allow the Collective to bring the reactor on-line."
msgstr "Låt inte The Collective driftsätta reaktorn."

#: data/base/messages/strings/cam2strings.txt:106
msgid "BETA BASE MISSION: Capture NASDA Central"
msgstr "BETABASUPPDRAG: Inta NASDA Central"

#: data/base/messages/strings/cam2strings.txt:107
msgid "Capture NASDA central before NEXUS and the Collective can use it."
msgstr "Inta NASDA Central innan NEXUS och The Collective kan använda den."

#: data/base/messages/strings/cam2strings.txt:111
#: data/base/messages/strings/cam2strings.txt:116
#: data/base/messages/strings/cam2strings.txt:121
msgid "TRANSPORT MISSION: Satellite Uplink Site"
msgstr "TRANSPORTUPPDRAG: Satellitlänksplats"

#: data/base/messages/strings/cam2strings.txt:112
msgid "NEXUS is searching for still functioning memory banks."
msgstr "NEXUS söker efter minnesbanker som fortfarande fungerar."

#: data/base/messages/strings/cam2strings.txt:113
msgid "Part of its consciousness has moved to a remote NASDA control-site."
msgstr "En del av dess medvetande har flyttat till en avlägsen NASDA-kontrollstation."

#: data/base/messages/strings/cam2strings.txt:117
msgid ""
"We are detecting transmissions from this site that are reaching high orbit."
msgstr "Vi upptäcker sändningar från platsen som når hög omloppsbana."

#: data/base/messages/strings/cam2strings.txt:118
msgid "NEXUS has now reconnected itself with the NASDA satellites."
msgstr "NEXUS har nu återanslutit till NASDA-satelliterna."

#: data/base/messages/strings/cam2strings.txt:122
msgid "Use the transport to carry a strike force to this site."
msgstr "Använd transporten för att föra en attackstyrka till platsen."

#: data/base/messages/strings/cam2strings.txt:123
msgid "Destroy the site and return to your base."
msgstr "Förstör platsen och återvänd till din bas."

#: data/base/messages/strings/cam2strings.txt:126
msgid "TRANSPORT MISSION: Destroy Enemy SAM Sites"
msgstr "TRANSPORTUPPDRAG: Förstör fiendens SAM-ställningar"

#: data/base/messages/strings/cam2strings.txt:127
msgid ""
"If you are to escape, eradicate the surface-to-air missile sites around your "
"base."
msgstr "För att undkomma måste du utplåna luftvärnsrobotställningarna runt din bas."

#: data/base/messages/strings/cam2strings.txt:128
msgid "Fly to the LZ, then head overland to destroy the SAM sites."
msgstr "Flyg till LZ och fortsätt sedan landvägen för att förstöra SAM-ställningarna."

#: data/base/messages/strings/cam2strings.txt:131
#: data/base/messages/strings/cam2strings.txt:136
msgid "TRANSPORT MISSION: Establish Safe Haven"
msgstr "TRANSPORTUPPDRAG: Upprätta en säker zon"

#: data/base/messages/strings/cam2strings.txt:132
msgid "We can confirm a missile is heading for Alpha Base."
msgstr "Vi kan bekräfta att en robot är på väg mot alfabasen."

#: data/base/messages/strings/cam2strings.txt:133
msgid "You are to establish a safe haven for evacuation of Beta Base."
msgstr "Du ska upprätta en säker zon för evakuering av Bas Beta."

#: data/base/messages/strings/cam2strings.txt:137
msgid "Eradicate any enemy and secure the area."
msgstr "Utplåna alla fiender och säkra området."

#: data/base/messages/strings/cam2strings.txt:138
msgid "Once a safe haven is established, return to the LZ for further orders."
msgstr "När den säkra zonen är upprättad ska du återvända till LZ för fler order."

#: data/base/messages/strings/cam2strings.txt:141
#: data/base/messages/strings/cam2strings.txt:146
#: data/base/messages/strings/cam2strings.txt:151
msgid "BETA BASE MISSION: Survive and evacuate! Bring a truck"
msgstr "BETABASUPPDRAG: Överlev och evakuera! Ta med ett konstruktionsfordon"

#: data/base/messages/strings/cam2strings.txt:142
msgid "Commander, we have grave news."
msgstr "Befälhavare, vi har allvarliga nyheter."

#: data/base/messages/strings/cam2strings.txt:143
msgid "Alpha base has been destroyed by nuclear missile attack."
msgstr "Alfabasen har förstörts av en kärnvapenrobotattack."

#: data/base/messages/strings/cam2strings.txt:147
msgid ""
"The Collective are unaware of the nuclear attack and have air units heading "
"for your base."
msgstr "The Collective känner inte till kärnvapenattacken och har flygenheter på väg mot din bas."

#: data/base/messages/strings/cam2strings.txt:148
msgid "This message was intercepted a few moments ago..."
msgstr "Det här meddelandet snappades upp för en stund sedan..."

#: data/base/messages/strings/cam2strings.txt:152
msgid "You must transport as many of your forces as possible."
msgstr "Du måste transportera så många av dina styrkor som möjligt."

#: data/base/messages/strings/cam2strings.txt:153
#: data/base/messages/strings/cam3strings.txt:30
msgid "Good luck, Commander."
msgstr "Lycka till, befälhavare."

#: data/base/messages/strings/cam3strings.txt:4
#: data/base/sequenceaudio/cam3/c003.txa:4
#: data/base/sequenceaudio/cam3/c003.txa:14
msgid "TRANSPORT MISSION: Northern Sector"
msgstr "TRANSPORTUPPDRAG: Norra sektorn"

#: data/base/messages/strings/cam3strings.txt:5
#: data/base/sequenceaudio/cam3/c003.txa:5
msgid "Congratulations on your successful evacuation of Beta Base."
msgstr "Gratulerar till den lyckade evakueringen av Bas Beta."

#: data/base/messages/strings/cam3strings.txt:6
#: data/base/sequenceaudio/cam3/c003.txa:6
msgid ""
"NEXUS has gained access to nuclear weapons and is determined to destroy the "
"Project."
msgstr "NEXUS har fått tillgång till kärnvapen och är fast beslutat att förstöra projektet."

#: data/base/messages/strings/cam3strings.txt:9
msgid "Take your forces to the Northern Sector"
msgstr "Ta dina styrkor till norra sektorn"

#: data/base/messages/strings/cam3strings.txt:10
#: data/base/sequenceaudio/cam3/c003.txa:15
msgid "Once at the mountains secure an LZ. Then establish a forward base."
msgstr "När du når bergen ska du säkra en LZ. Upprätta sedan en framskjuten bas."

#: data/base/messages/strings/cam3strings.txt:11
#: data/base/sequenceaudio/cam3/c003.txa:16
msgid "Team Gamma will contact you there."
msgstr "Grupp Gamma kontaktar dig där."

#: data/base/messages/strings/cam3strings.txt:14
msgid "TRANSPORT MISSION: Establish A Forward Base"
msgstr "TRANSPORTUPPDRAG: Upprätta en framskjuten bas"

#: data/base/messages/strings/cam3strings.txt:15
#: data/base/sequenceaudio/cam3/c003.txt:5
msgid "Commander, the success of the Project lies with you."
msgstr "Befälhavare, projektets framgång vilar på dig."

#: data/base/messages/strings/cam3strings.txt:16
msgid "Secure an LZ, then establish a forward base."
msgstr "Säkra en LZ och upprätta sedan en framskjuten bas."

#: data/base/messages/strings/cam3strings.txt:19
#: data/base/messages/strings/cam3strings.txt:28
msgid "TRANSPORT MISSION: Missile Launch Site Coordinates"
msgstr "TRANSPORTUPPDRAG: Koordinater för robotavfyrningsplatsen"

#: data/base/messages/strings/cam3strings.txt:20
msgid "We have located the site of the missile launches."
msgstr "Vi har lokaliserat robotavfyrningsplatsen."

#: data/base/messages/strings/cam3strings.txt:21
msgid "There were one or more missiles at this NASDA site."
msgstr "En eller flera robotar fanns vid denna NASDA-anläggning."

#: data/base/messages/strings/cam3strings.txt:24
msgid "We are transmitting coordinates of an LZ near the silos."
msgstr "Vi sänder koordinater till en LZ nära silorna."

#: data/base/messages/strings/cam3strings.txt:25
#: data/base/messages/strings/cam3strings.txt:61
#: data/base/sequenceaudio/cam3/cam32pl2.txt:1
msgid "Coordinate Download Completed."
msgstr "Hämtning av koordinater klar."

#: data/base/messages/strings/cam3strings.txt:29
msgid "Secure your LZ, then head overland to destroy the missile silo."
msgstr "Säkra din LZ och fortsätt sedan landvägen för att förstöra robotsilon."

#: data/base/messages/strings/cam3strings.txt:33
#: data/base/messages/strings/cam3strings.txt:38
msgid "NORTHERN SECTOR MISSION: Nuclear Blast"
msgstr "NORRA SEKTORNS UPPDRAG: Kärnvapenexplosion"

#: data/base/messages/strings/cam3strings.txt:34
msgid "All units must escape the area before the warhead detonates."
msgstr "Alla enheter måste lämna området innan stridsspetsen detonerar."

#: data/base/messages/strings/cam3strings.txt:35
msgid "Air-lift by transport is not possible. You'll have to head overland."
msgstr "Evakuering med transport är inte möjlig. Du måste fortsätta landvägen."

#: data/base/messages/strings/cam3strings.txt:39
msgid "The mountain range to the east should shield you from the blast."
msgstr "Bergskedjan österut bör skydda dig från explosionen."

#: data/base/messages/strings/cam3strings.txt:40
msgid "The valley is your only chance of escape."
msgstr "Dalen är din enda möjlighet att undkomma."

#: data/base/messages/strings/cam3strings.txt:43
msgid "AWAY TEAM UPDATE"
msgstr "UPPDATERING FRÅN INSATSGRUPPEN"

#: data/base/messages/strings/cam3strings.txt:44
msgid ""
"All communication with the away team was lost after the nuclear explosions."
msgstr "All kommunikation med insatsgruppen bröts efter kärnvapenexplosionerna."

#: data/base/messages/strings/cam3strings.txt:45
msgid "Their last transmission indicated they were heading back to base."
msgstr "Deras senaste sändning visade att de var på väg tillbaka till basen."

#: data/base/messages/strings/cam3strings.txt:48
msgid "NORTHERN SECTOR MISSION: Assist Team Gamma"
msgstr "NORRA SEKTORNS UPPDRAG: Bistå Grupp Gamma"

#: data/base/messages/strings/cam3strings.txt:49
msgid "You are to assist Team Gamma."
msgstr "Du ska bistå Grupp Gamma."

#: data/base/messages/strings/cam3strings.txt:50
msgid ""
"On reaching Gamma Base, help secure the area from further NEXUS attacks."
msgstr "När du når Bas Gamma ska du hjälpa till att säkra området mot fler NEXUS-angrepp."

#: data/base/messages/strings/cam3strings.txt:53
msgid "NEXUS DEFEATED"
msgstr "NEXUS BESEGRAT"

#: data/base/messages/strings/cam3strings.txt:54
msgid "Commander, we have defeated NEXUS."
msgstr "Befälhavare, vi har besegrat NEXUS."

#: data/base/messages/strings/cam3strings.txt:55
msgid ""
"Unfortunately, our systems' performance has been affected by NEXUS. We are "
"trying to rectify this."
msgstr ""
"Tyvärr har NEXUS påverkat våra systems prestanda. Vi försöker rätta till "
"det."

#: data/base/messages/strings/cam3strings.txt:58
msgid "We are currently receiving this transmission."
msgstr "Vi tar just nu emot den här sändningen."

#: data/base/messages/strings/cam3strings.txt:64
msgid "TRANSPORT MISSION: Team Alpha Detected"
msgstr "TRANSPORTUPPDRAG: Grupp Alfa upptäckt"

#: data/base/messages/strings/cam3strings.txt:65
msgid "Take a scout force to these coordinates and evaluate the situation."
msgstr "Skicka en spaningsstyrka till dessa koordinater och bedöm situationen."

#: data/base/messages/strings/cam3strings.txt:66
msgid ""
"Determine whether they are Team Alpha. If so, rescue and escort them back to "
"the LZ."
msgstr ""
"Avgör om de är Grupp Alfa. Om så är fallet ska du rädda dem och eskortera "
"dem till LZ."

#: data/base/messages/strings/cam3strings.txt:68
msgid ""
"This group are part of Team Alpha, Rescue them and escort them to the LZ."
msgstr "Denna grupp tillhör Grupp Alfa. Rädda dem och eskortera dem till LZ."

#: data/base/messages/strings/cam3strings.txt:71
msgid "NORTHERN SECTOR MISSION: Team Alpha Debrief"
msgstr "NORRA SEKTORNS UPPDRAG: Genomgång med Grupp Alfa"

#: data/base/messages/strings/cam3strings.txt:72
msgid "Team Alpha power transfer in progress."
msgstr "Energiöverföring från Grupp Alfa pågår."

#: data/base/messages/strings/cam3strings.txt:75
msgid ""
"Commander, after you left the Western Sector we recovered this artifact."
msgstr "Befälhavare, efter att du lämnat västra sektorn återtog vi denna artefakt."

#: data/base/messages/strings/cam3strings.txt:76
msgid "The benefits from researching it could be vast."
msgstr "Forskningsvinsterna kan bli omfattande."

#: data/base/messages/strings/cam3strings.txt:79
msgid "Enemy forces are ....... from these coordinates."
msgstr "Fientliga styrkor är ....... från dessa koordinater."

#: data/base/messages/strings/cam3strings.txt:80
msgid "Defend the base and ........ the ......."
msgstr "Försvara basen och ........ den ......."

#: data/base/messages/strings/cam3strings.txt:81
msgid "Search and destroy ...."
msgstr "Sök upp och förstör ...."

#: data/base/messages/strings/cam3strings.txt:84
msgid "TRANSPORT MISSION: Ambush NEXUS Forces"
msgstr "TRANSPORTUPPDRAG: Lägg ett bakhåll för NEXUS-styrkor"

#: data/base/messages/strings/cam3strings.txt:85
msgid "Commander, your decisive actions halted the spread of NEXUS."
msgstr "Befälhavare, dina avgörande insatser stoppade NEXUS spridning."

#: data/base/messages/strings/cam3strings.txt:86
msgid ""
"Before NEXUS was expelled, we intercepted this message - Decoding completed."
msgstr "Innan NEXUS drevs bort snappade vi upp detta meddelande. Avkodning klar."

#: data/base/messages/strings/cam3strings.txt:89
msgid "A NEXUS task force is heading for these coordinates."
msgstr "En NEXUS-insatsstyrka är på väg mot dessa koordinater."

#: data/base/messages/strings/cam3strings.txt:90
msgid "You have an opportunity to destroy NEXUS before they get there."
msgstr "Du har möjlighet att förstöra NEXUS innan den når dit."

#: data/base/messages/strings/cam3strings.txt:91
msgid ""
"Take an attack force and ambush NEXUS task force at ....... the  ......."
msgstr "Ta en attackstyrka och lägg ett bakhåll för NEXUS-insatsstyrkan vid ....... den ......."

#: data/base/messages/strings/cam3strings.txt:94
msgid "TRANSPORT MISSION: Away Team"
msgstr "TRANSPORTUPPDRAG: Insatsgruppen"

#: data/base/messages/strings/cam3strings.txt:95
msgid "Commander, your attack on ...."
msgstr "Befälhavare, ditt anfall mot ...."

#: data/base/messages/strings/cam3strings.txt:98
msgid "NEXUS exiting system."
msgstr "NEXUS lämnar systemet."

#: data/base/messages/strings/cam3strings.txt:101
msgid "Incoming transmission from away team."
msgstr "Inkommande sändning från insatsgruppen."

#: data/base/messages/strings/cam3strings.txt:104
msgid "Commander, we are attempting to return to base."
msgstr "Befälhavare, vi försöker återvända till basen."

#: data/base/messages/strings/cam3strings.txt:105
msgid "This is our current position."
msgstr "Det här är vår aktuella position."

#: data/base/messages/strings/cam3strings.txt:106
msgid "Take control of our forces and lead us."
msgstr "Ta kontroll över våra styrkor och led oss."

#: data/base/messages/strings/cam3strings.txt:109
msgid "Control transfer successful."
msgstr "Kontrollöverlämning lyckades."

#: data/base/messages/strings/cam3strings.txt:110
msgid "Entering new zone."
msgstr "Går in i en ny zon."

#: data/base/messages/strings/cam3strings.txt:113
msgid "Incoming Transmission..."
msgstr "Inkommande sändning..."

#: data/base/messages/strings/cam3strings.txt:116
msgid "Elements of Team Gamma have contacted us."
msgstr "Delar av Grupp Gamma har kontaktat oss."

#: data/base/messages/strings/cam3strings.txt:117
msgid ""
"They claim to be free of NEXUS, and offer their base as a site of operations."
msgstr "De uppger att de är fria från NEXUS och erbjuder sin bas som operationsbas."

#: data/base/messages/strings/cam3strings.txt:118
msgid "Base coordinates download in progress."
msgstr "Hämtning av baskoordinater pågår."

#: data/base/messages/strings/cam3strings.txt:121
msgid "NORTHERN SECTOR MISSION: Laser Satellites"
msgstr "UPPDRAG I NORRA SEKTORN: Lasersatelliter"

#: data/base/messages/strings/cam3strings.txt:122
msgid "We are detecting strong energy surges from orbit."
msgstr "Vi registrerar kraftiga energiurladdningar från omloppsbanan."

#: data/base/messages/strings/cam3strings.txt:123
msgid "The laser satellites are charged and moving towards our position."
msgstr "Lasersatelliterna är laddade och rör sig mot vår position."

#: data/base/messages/strings/cam3strings.txt:126
msgid "The 2nd Team Gamma base is at this location."
msgstr "Grupp Gammas andra bas finns på den här platsen."

#: data/base/messages/strings/cam3strings.txt:127
msgid "We have limited time to evacuate this base and move to Gamma Base."
msgstr "Vi har begränsat med tid för att evakuera den här basen och förflytta oss till Gammabasen."

#: data/base/messages/strings/cam3strings.txt:130
msgid "The laser satellites are not functioning properly, they are misfiring."
msgstr "Lasersatelliterna fungerar inte korrekt och skjuter fel."

#: data/base/messages/strings/cam3strings.txt:131
msgid "They are directing their fire towards this position."
msgstr "De riktar sin eld mot den här positionen."

#: data/base/messages/strings/cam3strings.txt:132
msgid "We will need to evacuate this base shortly."
msgstr "Vi måste snart evakuera den här basen."

#: data/base/messages/strings/cam3strings.txt:135
msgid "Team Gamma reports a missile silo at this location."
msgstr "Grupp Gamma rapporterar en robotsilo på den här platsen."

#: data/base/messages/strings/cam3strings.txt:136
msgid ""
"They believe that the silo contains missiles capable of reaching high orbit."
msgstr "De tror att silon innehåller robotar som kan nå hög omloppsbana."

#: data/base/messages/strings/cam3strings.txt:137
msgid "Capture this silo at all costs."
msgstr "Inta den här silon till varje pris."

#: data/base/messages/strings/cam3strings.txt:140
msgid "Missile silos captured."
msgstr "Robotsilor intagna."

#: data/base/messages/strings/cam3strings.txt:143
#: data/base/messages/strings/cam3strings.txt:161
msgid "NORTHERN SECTOR MISSION: Missile Codes"
msgstr "UPPDRAG I NORRA SEKTORN: Robotkoder"

#: data/base/messages/strings/cam3strings.txt:144
msgid "Commander, there are missiles present at the silos."
msgstr "Befälhavare, det finns robotar vid silorna."

#: data/base/messages/strings/cam3strings.txt:145
msgid "Nexus is preventing us from accessing the missile control code."
msgstr "NEXUS hindrar oss från att få åtkomst till robotstyrkoden."

#: data/base/messages/strings/cam3strings.txt:148
msgid "NEXUS is present in our systems."
msgstr "NEXUS finns i våra system."

#: data/base/messages/strings/cam3strings.txt:149
msgid "To defeat NEXUS we must research the Nexus Intruder Program."
msgstr "För att besegra NEXUS måste vi forska om NEXUS Intruder Program."

#: data/base/messages/strings/cam3strings.txt:150
msgid "Assign this task to a research facility."
msgstr "Tilldela uppgiften till en forskningsanläggning."

#: data/base/messages/strings/cam3strings.txt:153
msgid "NEXUS forces detected at these locations."
msgstr "NEXUS-styrkor upptäckta på de här platserna."

#: data/base/messages/strings/cam3strings.txt:157
msgid "NEXUS has been eradicated from all Project systems."
msgstr "NEXUS har utplånats ur alla Projektets system."

#: data/base/messages/strings/cam3strings.txt:158
msgid "We are attempting to access the missile control codes."
msgstr "Vi försöker få åtkomst till robotstyrkoderna."

#: data/base/messages/strings/cam3strings.txt:162
msgid ""
"A research facility is required to crack the code. Allocate one immediately."
msgstr "En forskningsanläggning krävs för att knäcka koden. Tilldela en omedelbart."

#: data/base/messages/strings/cam3strings.txt:163
msgid "Protect the missile silos from NEXUS attacks."
msgstr "Skydda robotsilorna mot NEXUS angrepp."

#: data/base/messages/strings/cam3strings.txt:166
msgid "PROJECT UPDATE: 1st Level Missile Code Cracked."
msgstr "PROJEKTUPPDATERING: Robotkod på nivå 1 knäckt."

#: data/base/messages/strings/cam3strings.txt:167
msgid "Missile arming in progress."
msgstr "Robotar aktiveras."

#: data/base/messages/strings/cam3strings.txt:168
msgid "More research is required to proceed further."
msgstr "Mer forskning krävs för att gå vidare."

#: data/base/messages/strings/cam3strings.txt:171
msgid "PROJECT UPDATE: 2nd Level Missile Code Cracked."
msgstr "PROJEKTUPPDATERING: Robotkod på nivå 2 knäckt."

#: data/base/messages/strings/cam3strings.txt:172
msgid "Missile target programming in progress."
msgstr "Robotarnas målinriktning programmeras."

#: data/base/messages/strings/cam3strings.txt:173
msgid "Once level 3 codes are cracked we initiate launch procedures."
msgstr "När koderna för nivå 3 är knäckta inleder vi uppskjutningsrutinerna."

#: data/base/messages/strings/cam3strings.txt:176
msgid "PROJECT UPDATE: 3rd Level Missile Code Cracked."
msgstr "PROJEKTUPPDATERING: Robotkod på nivå 3 knäckt."

#: data/base/messages/strings/cam3strings.txt:177
msgid "Missile launch sequence initiated."
msgstr "Robotuppskjutningssekvens inledd."

#: data/base/messages/strings/cam3strings.txt:180
msgid "TRANSPORT MISSION: Attack NEXUS Final Base"
msgstr "TRANSPORTUPPDRAG: Anfall mot NEXUS sista bas"

#: data/base/messages/strings/cam3strings.txt:181
msgid "We have located NEXUS' base at this location."
msgstr "Vi har lokaliserat NEXUS bas på den här platsen."

#: data/base/messages/strings/cam3strings.txt:184
msgid "This area contains numerous NEXUS structures."
msgstr "Det här området innehåller många NEXUS-byggnader."

#: data/base/messages/strings/cam3strings.txt:185
msgid "We are certain that NEXUS's core systems are located here."
msgstr "Vi är säkra på att NEXUS kärnsystem finns här."

#: data/base/messages/strings/cam3strings.txt:188
msgid "Establish an LZ."
msgstr "Upprätta en LZ."

#: data/base/messages/strings/cam3strings.txt:189
msgid "Begin your attacks on NEXUS. You must destroy his core systems."
msgstr "Inled dina angrepp mot NEXUS. Du måste förstöra dess kärnsystem."

#: data/base/messages/strings/cam3strings.txt:192
msgid "Incoming intelligence report... Team Gamma"
msgstr "Inkommande underrättelserapport... Grupp Gamma"

#: data/base/messages/strings/genstrings.txt:4
msgid "Briefing Commences:"
msgstr "Briefing börjar:"

#: data/base/messages/strings/genstrings.txt:7
msgid "Scavenger Outpost"
msgstr "Skrotarutpost"

#: data/base/messages/strings/genstrings.txt:8
msgid "Power Resource"
msgstr "Energitillgång"

#: data/base/messages/strings/genstrings.txt:9
msgid "Unknown Artifact"
msgstr "Okänd artefakt"

#: data/base/messages/strings/genstrings.txt:10
msgid "Source of Power Surge"
msgstr "Energistötens källa"

#: data/base/messages/strings/genstrings.txt:13
msgid "Landing Zone"
msgstr "Landningszon"

#: data/base/messages/strings/genstrings.txt:14
#: data/base/messages/strings/genstrings.txt:24
msgid "Mission Target"
msgstr "Uppdragsmål"

#: data/base/messages/strings/genstrings.txt:15
msgid "Pre-Collapse Research Center"
msgstr "Forskningscentrum från tiden före kollapsen"

#: data/base/messages/strings/genstrings.txt:17
msgid "En-route To Mission Site"
msgstr "På väg till uppdragsplatsen"

#: data/base/messages/strings/genstrings.txt:18
msgid "Mission Failed"
msgstr "Uppdraget misslyckades"

#: data/base/messages/strings/genstrings.txt:19
msgid "Mission Successful"
msgstr "Uppdraget lyckades"

#: data/base/messages/strings/genstrings.txt:22
msgid "Enemy Landing Zone"
msgstr "Fiendens landningszon"

#: data/base/messages/strings/genstrings.txt:23
msgid "Enemy Base"
msgstr "Fiendens bas"

#: data/base/messages/strings/genstrings.txt:27
msgid "Incoming transmission"
msgstr "Inkommande sändning"

#: data/base/messages/strings/genstrings.txt:30
msgid "Incoming intelligence report."
msgstr "Inkommande underrättelserapport."

#: data/base/messages/strings/genstrings.txt:33
msgid "Nuclear Reactor"
msgstr "Kärnreaktor"

#: data/base/messages/strings/names.txt:12
#: data/mp/messages/strings/names.txt:12
msgid "New Design"
msgstr "Ny konstruktion"

#: data/base/messages/strings/names.txt:103
#: data/mp/messages/strings/names.txt:160
msgid "Cyborg Cannon"
msgstr "Cyborgkanon"

