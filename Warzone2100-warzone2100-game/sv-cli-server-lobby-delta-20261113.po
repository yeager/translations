msgid "Set game server port"
msgstr "Ange spelserverport"

msgid "port"
msgstr "port"

msgid "Enable / disable port mapping when hosting"
msgstr "Aktivera/inaktivera portmappning vid värdskap"

msgid "[1, true, 0, false]"
msgstr "[1, true, 0, false]"

msgid "Enable lobby slash commands (for connecting clients)"
msgstr "Aktivera snedstreckskommandon i lobbyn (för anslutande klienter)"

msgid "Add a lobby admin identity hash (for slash commands)"
msgstr "Lägg till identitetshash för lobbyadministratör (för snedstreckskommandon)"

msgid "hash string"
msgstr "hashsträng"

msgid "Add a lobby admin public key (for slash commands)"
msgstr "Lägg till offentlig nyckel för lobbyadministratör (för snedstreckskommandon)"

msgid "b64-pub-key"
msgstr "b64-pub-key"

msgid "Enable command interface"
msgstr "Aktivera kommandogränssnitt"

msgid "(stdin, unixsocket:path)"
msgstr "(stdin, unixsocket:sökväg)"

msgid "Minimum required players to auto-start game"
msgstr "Minsta antal spelare för att starta spelet automatiskt"

msgid "startplayers"
msgstr "startplayers"

msgid "Game history log output mode(s)"
msgstr "Utmatningsläge(n) för spelhistoriklogg"

msgid "Game history log output key"
msgstr "Utmatningsnyckel för spelhistoriklogg"

msgid "Game history log output naming"
msgstr "Namngivning för spelhistorikloggens utdata"

msgid "Game history log frame interval"
msgstr "Bildruteintervall för spelhistoriklogg"

msgid "interval in seconds"
msgstr "intervall i sekunder"

msgid "Multiplayer game time limit (in minutes)"
msgstr "Tidsgräns för flerspelarspel (i minuter)"

msgid "number of minutes"
msgstr "antal minuter"

msgid "Convert a specular-map .png to a luma, single-channel, grayscale .png (and exit)"
msgstr "Konvertera en speglande .png-karta till en luma-.png i gråskala med en kanal (och avsluta)"

msgid "Allow Vulkan implicit layers (that may be default-disabled due to potential crashes or bugs)"
msgstr "Tillåt implicita Vulkan-lager (som kan vara inaktiverade som standard på grund av möjliga krascher eller fel)"

msgid "Set the default hosting chat configuration / permissions"
msgstr "Ange standardkonfiguration/-behörigheter för värdchatt"

msgid "Enable async join approval (for connecting clients)"
msgstr "Aktivera asynkront godkännande av anslutning (för anslutande klienter)"

msgid "Starts the host (autohost) as not ready, even if it's a spectator host"
msgstr "Startar värden (autohost) i läget inte redo, även om det är en åskådarvärd"

msgid "Base URL for on-demand video downloads"
msgstr "Bas-URL för videoöverföringar på begäran"

msgid "Base video URL"
msgstr "Bas-URL för video"

msgid "Specify connection provider type to use when hosting game sessions"
msgstr "Ange vilken typ av anslutningsleverantör som ska användas för spelmöten med värd"
