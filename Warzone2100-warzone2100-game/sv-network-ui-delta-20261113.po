msgid "System locale"
msgstr "Systemspråk"

msgid "This host has disallowed joins from certain hosting providers, VPNs, and/or proxies."
msgstr "Värden tillåter inte anslutningar från vissa webbhotell, VPN-tjänster och/eller proxyservrar."

msgid "Please try another room or disable any proxies / VPNs and try again."
msgstr "Prova ett annat rum eller inaktivera eventuella proxyservrar eller VPN-tjänster och försök igen."

msgid "Game not found in lobby."
msgstr "Matchen hittades inte i lobbyn."

msgid "The game may have already started, or the host may have disbanded the game lobby."
msgstr "Matchen kan redan ha startat, eller så kan värden ha stängt matchlobbyn."

msgid "Error hosting game in lobby server"
msgstr "Det gick inte att vara värd för matchen på lobbyservern"

#, c-format
msgid "Make sure port %d can receive incoming connections."
msgstr "Kontrollera att port %d kan ta emot inkommande anslutningar."

msgid "If you're using a router, configure it to enable UPnP/NAT-PMP/PCP or to forward the port to your system."
msgstr "Om du använder en router ska du ställa in den så att UPnP/NAT-PMP/PCP aktiveras eller så att porten vidarebefordras till din dator."

msgid "Failed to create port mapping"
msgstr "Det gick inte att skapa portmappning"

#, c-format
msgid "Manually configure your router/firewall to open port %d!"
msgstr "Ställ in routern eller brandväggen manuellt för att öppna port %d!"

#, c-format
msgid "Port mapping opened external port: %u"
msgstr "Portmappningen öppnade extern port: %u"

#, c-format
msgid "Your external IP is: %s"
msgstr "Din externa IP-adress är: %s"

msgid "Failed to create port mapping (timeout)"
msgstr "Det gick inte att skapa portmappning (tidsgränsen överskreds)"

#, c-format
msgid "Using %s network backend."
msgstr "Använder nätverksdelen %s."

msgid "Client failed to ack player index swap"
msgstr "Klienten kunde inte bekräfta bytet av spelarindex"

msgid "Game is listed in the lobby"
msgstr "Matchen visas i lobbyn"

msgid "Lobby GameId"
msgstr "Match-id i lobbyn"

msgid "Game not listed in the lobby."
msgstr "Matchen visas inte i lobbyn."

msgid "Error connecting to the lobby server."
msgstr "Det gick inte att ansluta till lobbyservern."

msgid "Please check your internet connection, or wait a short while and try hosting again."
msgstr "Kontrollera din internetanslutning eller vänta en stund och försök vara värd igen."

msgid "Your game will only be accessible via direct connection (or local LAN)."
msgstr "Din match kommer bara att vara tillgänglig via direktanslutning eller lokalt nätverk."

msgid "Multiplayer lobby support unavailable. Please update your client."
msgstr "Stöd för flerspelarlobby saknas. Uppdatera klienten."

msgid "Game not listed in the lobby:"
msgstr "Matchen visas inte i lobbyn:"

msgid "Failed to create game listing. Check WZ logs."
msgstr "Det gick inte att skapa matchlistning. Kontrollera WZ-loggarna."

msgid "The replay file format is newer than this version of Warzone 2100 can support."
msgstr "Reprisfilformatet är nyare än vad den här versionen av Warzone 2100 stöder."

#, c-format
msgid "Replay Format Version: %u"
msgstr "Reprisformatets version: %u"

msgid "Replay File Format Unsupported"
msgstr "Reprisfilformatet stöds inte"

msgid "The replay file format is older than this version of Warzone 2100 can support."
msgstr "Reprisfilformatet är äldre än vad den här versionen av Warzone 2100 stöder."

msgid "Unable to load replay: The replay file is incomplete or corrupted."
msgstr "Det gick inte att läsa in reprisen: reprisfilen är ofullständig eller skadad."

msgid "Warzone 2100: Failed to initialize graphics"
msgstr "Warzone 2100: det gick inte att initiera grafik"

msgid "Failed to initialize graphics for all backends."
msgstr "Det gick inte att initiera grafik med någon grafikrutin."

msgid "Error Details:"
msgstr "Felinformation:"

msgid "Please update and/or reinstall your graphics drivers, and check your system settings."
msgstr "Uppdatera eller installera om grafikdrivrutinerna och kontrollera systeminställningarna."

msgid "OK"
msgstr "OK"

msgid "Warzone 2100: Prior launch failed"
msgstr "Warzone 2100: föregående start misslyckades"

msgid "The prior attempt to initialize the following graphics backend caused a crash:"
msgstr "Det föregående försöket att initiera följande grafikrutin orsakade en krasch:"

#, c-format
msgid "Graphics Backend: %s"
msgstr "Grafikrutin: %s"

msgid "Warzone 2100 will now attempt to launch using a different graphics backend."
msgstr "Warzone 2100 försöker nu starta med en annan grafikrutin."

msgid "Menu"
msgstr "Meny"

msgid "Campaign"
msgstr "Kampanj"

msgid "Challenge"
msgstr "Utmaning"

msgid "Skirmish"
msgstr "Skärmytsling"

msgid "Multiplayer"
msgstr "Flerspelarläge"

msgid "Menu Music"
msgstr "Menymusik"

msgid "(untitled)"
msgstr "(utan titel)"

msgid "Copy Path to Clipboard"
msgstr "Kopiera sökväg till urklipp"

msgid "Copy JSON to Clipboard"
msgstr "Kopiera JSON till urklipp"

msgid "Dump JSON to StdOut"
msgstr "Skriv JSON till standardutdata"

msgid "Tab Scroll left"
msgstr "Bläddra åt vänster i flik"

msgid "Tab Scroll right"
msgstr "Bläddra åt höger i flik"

msgid "Please enter the text below"
msgstr "Skriv in texten nedan"

msgid "Enter the text"
msgstr "Skriv in texten"

msgid "Please drag the slider to verify"
msgstr "Dra reglaget för att verifiera"

msgid "Please drag the tile to verify"
msgstr "Dra rutan för att verifiera"
