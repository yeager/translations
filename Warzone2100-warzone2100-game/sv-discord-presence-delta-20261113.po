msgid "The invite link you have followed specifies a non-default lobby server:"
msgstr "Inbjudningslänken du har följt anger en annan lobbyserver än standardservern:"

msgid "Do you wish to trust this lobby server, and continue?"
msgstr "Vill du lita på den här lobbyservern och fortsätta?"

msgid "Discord: Connect to Untrusted Lobby?"
msgstr "Discord: Ansluta till ej betrodd lobby?"

msgid "Trust & Connect"
msgstr "Lita på och anslut"

msgid "The invite link you have followed specifies a direct connection."
msgstr "Inbjudningslänken du har följt anger en direktanslutning."

msgid "It has not been vetted / verified by a lobby server."
msgstr "Den har inte granskats eller verifierats av en lobbyserver."

msgid "Do you wish to trust this direct connection invite?"
msgstr "Vill du lita på den här inbjudan till direktanslutning?"

msgid "Discord: Direct Connection Invite"
msgstr "Discord: Inbjudan till direktanslutning"

msgid "The invite link you have followed isn't supported by this version of Warzone 2100."
msgstr "Inbjudningslänken du har följt stöds inte av den här versionen av Warzone 2100."

msgid "A newer version of Warzone 2100 may be required, if available."
msgstr "En nyare version av Warzone 2100 kan krävas, om en sådan finns."

msgid "Discord: Unsupported / Invalid Invite"
msgstr "Discord: Inbjudan stöds inte eller är ogiltig"

msgid "Playing: Campaign"
msgstr "Spelar: Kampanj"

msgid "Playing: Challenge"
msgstr "Spelar: Utmaning"

msgid "Playing: Skirmish"
msgstr "Spelar: Skärmytsling"

#. TRANSLATORS: "%s" is a team description, ex. "2v2"
#, c-format
msgid "Playing: %s Skirmish"
msgstr "Spelar: %s-skärmytsling"

msgid "Map:"
msgstr "Karta:"

#. TRANSLATORS: AI Bots. (Used to describe the number of bot players.)
#. Should be a fairly short string - space is limited. Use an abbreviation / acronym if necessary.
msgid "Bots:"
msgstr "Botar:"

msgid "In Multiplayer Lobby"
msgstr "I flerspelarlobbyn"

msgid "In Multiplayer Game"
msgstr "I flerspelarspel"

#, c-format
msgid "Game Name: \"%s\" by %s"
msgstr "Spelnamn: \"%s\" av %s"

#. TRANSLATORS: "No:" to signify limits - example usage: "No: Tanks,VTOLs"
#. Should be a short string - space is limited. Use an abbreviation / symbol if necessary.
msgid "No:"
msgstr "Nej:"

#. TRANSLATORS: Should be a fairly short string - space is limited. Use an abbreviation if necessary.
msgid "Alliances:"
msgstr "Allianser:"

msgid "In Menu"
msgstr "I menyn"

#, c-format
msgid "Discord user \"%s\" would like to join your game."
msgstr "Discord-användaren \"%s\" vill ansluta till ditt spel."

msgid "Allow this player to join your game?"
msgstr "Tillåta spelaren att ansluta till ditt spel?"

#, c-format
msgid "Join Request from %s"
msgstr "Anslutningsbegäran från %s"
