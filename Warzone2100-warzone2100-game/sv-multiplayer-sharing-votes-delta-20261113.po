#, c-format
msgid "Traf: %lu/%lu"
msgstr "Trafik: %lu/%lu"

#, c-format
msgid "Uncompressed: %lu/%lu"
msgstr "Okomprimerat: %lu/%lu"

#, c-format
msgid "Pack: %lu/%lu"
msgstr "Paket: %lu/%lu"

msgid "Players View"
msgstr "Spelarvy"

msgid "Team Strategy"
msgstr "Lagstrategi"

#, c-format
msgid "Host initialized %u limits, unable to show them due to mods"
msgstr "Värden initierade %u gränser som inte kan visas på grund av moddar"

msgid "MAP REQUESTED!"
msgstr "KARTA BEGÄRD!"

msgid "MOD REQUESTED!"
msgstr "MODD BEGÄRD!"

msgid "Warning, this is a map-mod, it could alter normal gameplay."
msgstr "Varning! Det här är en kartmodd som kan ändra det vanliga spelet."

msgid "Warning, HOST has altered the game code, and can't be trusted!"
msgstr "Varning! VÄRDEN har ändrat spelkoden och kan inte litas på!"

msgid "The host has enabled free chat for everyone."
msgstr "Värden har slagit på fri chatt för alla."

msgid "The host has muted free chat for everyone."
msgstr "Värden har tystat fri chatt för alla."

#, c-format
msgid "The host has enabled free chat for player: %s"
msgstr "Värden har slagit på fri chatt för spelaren: %s"

#, c-format
msgid "The host has enabled free chat for %d players"
msgstr "Värden har slagit på fri chatt för %d spelare"

#, c-format
msgid "The host has muted free chat for player: %s"
msgstr "Värden har tystat fri chatt för spelaren: %s"

#, c-format
msgid "The host has muted free chat for %d players"
msgstr "Värden har tystat fri chatt för %d spelare"

msgid "Limits set to default."
msgstr "Gränserna är satta till standardvärden."

#, c-format
msgid "Changed structure limits [%u]:"
msgstr "Ändrade byggnadsgränser [%u]:"

#, c-format
msgid "Kicking player %s, because they tried to bypass data integrity check!"
msgstr "Sparkar ut spelaren %s eftersom hen försökte kringgå dataintegritetskontrollen!"

msgid "Invalid data!"
msgstr "Ogiltiga data!"

#, c-format
msgid "Auto kicking player %s, invalid command received: %u"
msgstr "Sparkar automatiskt ut spelaren %s: ogiltigt kommando togs emot: %u"

msgid "Unauthorized network command"
msgstr "Obehörigt nätverkskommando"

msgid "REPLAY HAS ENDED"
msgstr "REPLAYEN ÄR SLUT"

msgid "(Press ESC to quit.)"
msgstr "(Tryck på Esc för att avsluta.)"

#, c-format
msgid "Auto kicking player %s, invalid command received."
msgstr "Sparkar automatiskt ut spelaren %s: ogiltigt kommando togs emot."

msgid "Map was requested: SENDING MAP!"
msgstr "Karta begärdes: SKICKAR KARTA!"

msgid "Mod was requested: SENDING MOD!"
msgstr "Modd begärdes: SKICKAR MODD!"

msgid "FILE SENT!"
msgstr "FIL SKICKAD!"

msgid "MAP DOWNLOADED!"
msgstr "KARTA HÄMTAD!"

#, c-format
msgid "Beacon %d"
msgstr "Fyr %d"

#, c-format
msgid "Beacon received from %s!"
msgstr "Fyr mottagen från %s!"

msgid "Spectator Mode"
msgstr "Åskådarläge"

msgid "You are a spectator. Enjoy watching the game!"
msgstr "Du är åskådare. Ha nöje av att titta på spelet!"

msgid "Vote"
msgstr "Rösta"

msgid "Allow host to change map or randomize?"
msgstr "Tillåta värden att byta karta eller slumpa?"

msgid "A vote was started to kick you from the game."
msgstr "En omröstning har startats för att sparka ut dig från spelet."

#, c-format
msgid "A vote was started to kick %s from the game."
msgstr "En omröstning har startats för att sparka ut %s från spelet."

#, c-format
msgid "Vote To Kick: %s"
msgstr "Rösta om att sparka ut: %s"

#, c-format
msgid "Should player %s be kicked from the game?"
msgstr "Ska spelaren %s sparkas ut från spelet?"

msgid "Yes, Kick Them"
msgstr "Ja, sparka ut spelaren"

#, c-format
msgid "Starting vote to kick player: %s"
msgstr "Startar omröstning om att sparka ut spelaren: %s"
