msgid "MISSING AI NAME"
msgstr "AI-NAMN SAKNAS"

msgid "MISSING AI DESCRIPTION"
msgstr "AI-BESKRIVNING SAKNAS"

#, c-format
msgid "AI tournament: %3.1f%% wins, %3.1f%% losses, %3.1f%% draws"
msgstr "AI-turnering: %3.1f %% vinster, %3.1f %% förluster, %3.1f %% oavgjorda"

msgid "Not enough votes to randomize or change the map."
msgstr "Inte tillräckligt många röster för att slumpa eller byta karta."

msgid "Select Player Name"
msgstr "Välj spelarnamn"

msgid "Player Name changes are not allowed when you are muted"
msgstr "Det går inte att byta spelarnamn när du är tystad"

msgid "Player Name changes are not allowed by the host"
msgstr "Värden tillåter inte byte av spelarnamn"

msgid "Blind Game:"
msgstr "Blindspel:"

msgid "- Player names will not be visible to other players (until the game is over)"
msgstr "- Spelarnamn visas inte för andra spelare förrän spelet är slut"

msgid "Blind Lobby:"
msgstr "Blind lobby:"

msgid "- Player names will not be visible to other players (until the game has started)"
msgstr "- Spelarnamn visas inte för andra spelare förrän spelet har startat"

msgid "OPTIONS"
msgstr "ALTERNATIV"

msgid "Return To Previous Screen"
msgstr "Återgå till föregående skärm"

msgid "DIFFICULTY"
msgstr "SVÅRIGHETSGRAD"

msgid "Starts disadvantaged"
msgstr "Börjar med nackdel"

msgid "Plays nice"
msgstr "Spelar vänligt"

msgid "No holds barred"
msgstr "Inga hämningar"

msgid "Starts with advantages"
msgstr "Börjar med fördelar"

msgid "CHOOSE AI"
msgstr "VÄLJ AI"

msgid "Allow human players to join in this slot"
msgstr "Tillåt mänskliga spelare på den här platsen"

msgid "Leave this slot unused"
msgstr "Lämna den här platsen tom"

msgid "Allow spectators to join in this slot"
msgstr "Tillåt åskådare på den här platsen"

msgid "Click to change to this slot"
msgstr "Klicka för att byta till den här platsen"

#, c-format
msgid "Click to take player slot %u"
msgstr "Klicka för att ta spelarplats %u"

msgid "Click to swap player to this slot"
msgstr "Klicka för att flytta spelaren till den här platsen"

#, c-format
msgid "Spectator %s has moved to Players"
msgstr "Åskådaren %s har flyttats till spelarna"

msgid "Cannot swap with host"
msgstr "Det går inte att byta med värden"

msgid "Spectator"
msgstr "Åskådare"

#, c-format
msgid "The host has kicked %s from the game!"
msgstr "Värden har sparkat ut %s från spelet!"

msgid "The host has kicked you from the game."
msgstr "Värden har sparkat ut dig från spelet."

#, c-format
msgid "The host has banned %s from the game!"
msgstr "Värden har stängt av %s från spelet!"

msgid "The host has banned you from the game."
msgstr "Värden har stängt av dig från spelet."

#, c-format
msgid "Failed to move %s to Spectators"
msgstr "Det gick inte att flytta %s till åskådarna"

#, c-format
msgid "The host has moved %s to Spectators!"
msgstr "Värden har flyttat %s till åskådarna!"

msgid "Move to Spectators"
msgstr "Flytta till åskådarna"

msgid "Ask Spectator to Play"
msgstr "Fråga åskådaren om hen vill spela"
