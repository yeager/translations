msgstr "Bygg reparationsanläggningar"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
msgid "Build power generators"
msgstr "Bygg energigeneratorer"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
msgid "Capture oil resources"
msgstr "Ta kontroll över oljeresurser"

msgid "That didn't go well..."
msgstr "Det gick inte så bra ..."

msgid "I have another plan"
msgstr "Jag har en annan plan"

msgid "Good game"
msgstr "Bra match"

msgid "I give up"
msgstr "Jag ger upp"

msgid "Sorry, I have to leave"
msgstr "Förlåt, jag måste gå"

msgid "Message delivery failure - try again"
msgstr "Meddelandet kunde inte levereras. Försök igen"
