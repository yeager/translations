msgid "Sorry, I don't understand. (Use Quick Chat?)"
msgstr "Förlåt, jag förstår inte. Använd snabbchatten?"

msgid "Get ready..."
msgstr "Gör er redo ..."

msgid "You're going to regret that"
msgstr "Det kommer du att ångra"

msgid "Barely a scratch!"
msgstr "Bara en skråma!"

msgid "Attack now?"
msgstr "Anfalla nu?"

msgid "Group up"
msgstr "Samlas"

msgid "Split up"
msgstr "Dela upp er"

msgid "Focus attacks where marked"
msgstr "Koncentrera anfallen där det är markerat"

msgid "Retreat!"
msgstr "Dra er tillbaka!"

msgid "I need help!"
msgstr "Jag behöver hjälp!"

msgid "Left side"
msgstr "Vänster sida"

msgid "Right side"
msgstr "Höger sida"

msgid "Transfer Request: Units"
msgstr "Överföringsbegäran: Enheter"

msgid "Transfer Request: Trucks"
msgstr "Överföringsbegäran: Konstruktionsfordon"

#. TRANSLATORS: As in "I am attacking now!" (but shorter, more informal)
msgid "Attacking now!"
msgstr "Anfaller nu!"

#. TRANSLATORS: As in "I am on my way!" (but shorter, more informal)
msgid "On my way!"
msgstr "Jag är på väg!"

msgid "They're coming!"
msgstr "De kommer!"

msgid "I'm being attacked!"
msgstr "Jag blir anfallen!"

msgid "I'm rushing oils"
msgstr "Jag rusar mot oljekällorna"

msgid "They're rushing oils!"
msgstr "De rusar mot oljekällorna!"

msgid "I don't have enough power"
msgstr "Jag har inte tillräckligt med energi"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
msgid "Build more units"
msgstr "Bygg fler enheter"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
msgid "Build different units"
msgstr "Bygg andra enheter"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
msgid "Check team strategy view"
msgstr "Kontrollera lagets strategivy"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
msgid "Research different tech"
msgstr "Forska på annan teknik"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
msgid "Keep research centers busy"
msgstr "Håll forskningsanläggningarna sysselsatta"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
msgid "Build anti-air"
msgstr "Bygg luftvärn"

#. TRANSLATORS: A suggestion to other player(s), as in "Suggestion: %s"
