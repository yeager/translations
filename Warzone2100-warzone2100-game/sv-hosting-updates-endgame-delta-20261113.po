msgid "Hide Player Preferences"
msgstr "Dölj spelarinställningar"

msgid "Not editable while in a game."
msgstr "Kan inte redigeras under ett spel."

msgid "Not editable while in a multiplayer game."
msgstr "Kan inte redigeras under ett flerspelarspel."

msgid "Takes effect on game restart"
msgstr "Träder i kraft när spelet startas om"

msgid "Advanced Hosting Options:"
msgstr "Avancerade värdalternativ:"

msgid "Host Role"
msgstr "Värdroll"

msgid "Player Host"
msgstr "Spelande värd"

msgid "Host is a player in the game (the default)."
msgstr "Värden är en spelare i spelet (standard)."

msgid "Spectator Host"
msgstr "Åskådarvärd"

msgid "Host is a spectator in the game."
msgstr "Värden är åskådare i spelet."

msgid "Blind Mode"
msgstr "Blint läge"

msgid "Whether and when players are blinded to other players' identities."
msgstr "Om och när spelarnas identiteter döljs för andra spelare."

msgid "Blind modes are only available when host is a Spectator Host."
msgstr "Blinda lägen är endast tillgängliga när värden är åskådarvärd."

msgid "Players' identities are visible, in lobby and in game (the default)."
msgstr "Spelarnas identiteter visas i lobbyn och i spelet (standard)."

msgid "Start Hosting"
msgstr "Börja vara värd"

msgid "Configure Advanced Hosting Options"
msgstr "Konfigurera avancerade värdalternativ"

msgid "Launch Transport"
msgstr "Starta transporten"

msgid "Launch the Transporter"
msgstr "Starta transporten"

msgid "There is not enough room in the Transport!"
msgstr "Det finns inte tillräckligt med plats i transporten!"

msgid "Reinforcements landing"
msgstr "Förstärkningar landar"

msgid "Update Available"
msgstr "Uppdatering tillgänglig"

#, c-format
msgid "A new build of Warzone 2100 (%s) is available!"
msgstr "En ny version av Warzone 2100 (%s) är tillgänglig!"

msgid "A new build of Warzone 2100 is available!"
msgstr "En ny version av Warzone 2100 är tillgänglig!"

msgid "Get Update Now"
msgstr "Hämta uppdatering nu"

msgid "Compatibility Warning"
msgstr "Kompatibilitetsvarning"

#, c-format
msgid "(Notice ID: %s)"
msgstr "(Meddelande-ID: %s)"

#. TRANSLATORS: Printed when compiling with uncommitted changes
msgid " (modified locally)"
msgstr " (ändrad lokalt)"

#. TRANSLATORS: Printed in Debug builds
msgid " - DEBUG"
msgstr " – FELSÖKNING"

