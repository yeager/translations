msgstr "Version: %s,%s Byggd: %s%s"

msgid "GAME OVER"
msgstr "SPELET ÄR SLUT"

msgid "The battle is over - you can leave the room."
msgstr "Slaget är över – du kan lämna rummet."

msgid "YOU ARE VICTORIOUS!"
msgstr "DU HAR VUNNIT!"

msgid "YOU WERE DEFEATED!"
msgstr "DU BLEV BESEGRAD!"

msgid "Script Debugger"
msgstr "Skriptfelsökare"
