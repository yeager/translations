{"data":[{"id":"o:veyon-solutions:p:veyon:r:addons:s:0dc46094fbb48c79f5adfb2d785c7870:l:sv","type":"resource_translations","attributes":{"strings":{"other":"Veyon anv\u00e4nder MAC-adresser f\u00f6r att starta datorer via `Wake-on-LAN <https://en.wikipedia.org/wiki/Wake-on-LAN>`_. Om du vill anv\u00e4nda funktionen kan du fylla i varje enhets MAC-adresser i ett visst attribut, till exempel ett till\u00e4ggsattribut, och ange attributets namn i f\u00e4ltet :guilabel:`MAC-adressattribut`. Om dina enheter hanteras via Microsoft Intune kan du ocks\u00e5 \u00e4ndra inst\u00e4llningen s\u00e5 att Ethernet- eller Wi-Fi-MAC-adresserna som lagras i Intune anv\u00e4nds. Beroende p\u00e5 det valda alternativet l\u00e4ses antingen endast Ethernet- eller Wi-Fi-MAC-adresserna, eller b\u00e5da, d\u00e4r den f\u00f6rsta prioriteras. Det vill s\u00e4ga att den andra adressen endast anv\u00e4nds om den f\u00f6rsta \u00e4r tom. Gl\u00f6m inte att l\u00e4gga till API-beh\u00f6righeten ``DeviceManagementManagedDevices.Read.All``."},"reviewed":false,"proofread":false,"finalized":false,"origin":"API","datetime_created":"2026-11-06T09:48:02Z","datetime_translated":"2026-11-12T22:02:16Z","datetime_reviewed":null,"datetime_proofread":null},"relationships":{"resource":{"data":{"type":"resources","id":"o:veyon-solutions:p:veyon:r:addons"},"links":{"related":"https://rest.api.transifex.com/resources/o:veyon-solutions:p:veyon:r:addons"}},"language":{"data":{"type":"languages","id":"l:sv"},"links":{"related":"https://rest.api.transifex.com/languages/l:sv"}},"translator":{"data":{"type":"users","id":"u:yeager"},"links":{"related":"https://rest.api.transifex.com/users/u:yeager"}},"reviewer":null,"proofreader":null,"resource_string":{"data":{"type":"resource_strings","id":"o:veyon-solutions:p:veyon:r:addons:s:0dc46094fbb48c79f5adfb2d785c7870"},"links":{"related":"https://rest.api.transifex.com/resource_strings/o:veyon-solutions:p:veyon:r:addons:s:0dc46094fbb48c79f5adfb2d785c7870"}}},"links":{"self":"https://rest.api.transifex.com/resource_translations/o:veyon-solutions:p:veyon:r:addons:s:0dc46094fbb48c79f5adfb2d785c7870:l:sv"}},{"id":"o:veyon-solutions:p:veyon:r:addons:s:1ab6785055a8c1a1a27756b74ac8fd45:l:sv","type":"resource_translations","attributes":{"strings":{"other":"I Windows kan Veyon tillf\u00e4lligt \u00e4ndra de lokala anslutningsinst\u00e4llningarna f\u00f6r internet s\u00e5 att de pekar p\u00e5 en obefintlig proxyserver. Alla webbl\u00e4sare som f\u00f6ljer operativsystemets proxyinst\u00e4llningar f\u00f6r internet st\u00f6ds. Det g\u00e5r att konfigurera statiska undantag, till exempel f\u00f6r intran\u00e4t och l\u00e4rplattformar. Till skillnad fr\u00e5n de tv\u00e5 andra bak\u00e4ndarna st\u00f6ds \u00e4ven jokertecken f\u00f6r att till\u00e5ta alla underdom\u00e4ner eller servrar i en dom\u00e4n."},"reviewed":false,"proofread":false,"finalized":false,"origin":"API","datetime_created":"2026-11-06T10:02:34Z","datetime_translated":"2026-11-12T22:02:16Z","datetime_reviewed":null,"datetime_proofread":null},"relationships":{"resource":{"data":{"type":"resources","id":"o:veyon-solutions:p:veyon:r:addons"},"links":{"related":"https://rest.api.transifex.com/resources/o:veyon-solutions:p:veyon:r:addons"}},"language":{"data":{"type":"languages","id":"l:sv"},"links":{"related":"https://rest.api.transifex.com/languages/l:sv"}},"translator":{"data":{"type":"users","id":"u:yeager"},"links":{"related":"https://rest.api.transifex.com/users/u:yeager"}},"reviewer":null,"proofreader":null,"resource_string":{"data":{"type":"resource_strings","id":"o:veyon-solutions:p:veyon:r:addons:s:1ab6785055a8c1a1a27756b74ac8fd45"},"links":{"related":"https://rest.api.transifex.com/resource_strings/o:veyon-solutions:p:veyon:r:addons:s:1ab6785055a8c1a1a27756b74ac8fd45"}}},"links":{"self":"https://rest.api.transifex.com/resource_translations/o:veyon-solutions:p:veyon:r:addons:s:1ab6785055a8c1a1a27756b74ac8fd45:l:sv"}},{"id":"o:veyon-solutions:p:veyon:r:addons:s:2352a66d574529ab