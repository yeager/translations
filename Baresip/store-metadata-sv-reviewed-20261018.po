#: changelogs/531.txt:1
#, max-length:500
msgctxt "changelogs/531.txt:1"
msgid ""
"- Added Edit button also to Android contact top app bar\n"
"- Use baresip's missed call notification also for missed mobile calls\n"
"- Restored capability to turn speakerphone on also before call starts\n"
"- New translations from Weblate (Russian)"
msgstr ""
"- Lade även till knappen Redigera i det övre fältet på Androids kontaktskärm\n"
