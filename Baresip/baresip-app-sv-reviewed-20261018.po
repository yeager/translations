msgstr "Felsökning"

#, java-printf-format
msgctxt "debug_help"
msgid "If checked, provides debug and info level log messages to Logcat."
msgstr ""
"Kryssa i för att skicka felsöknings- och info-meddelanden till Logcat."

#, java-printf-format
msgctxt "sip_trace"
msgid "SIP Trace"
msgstr "SIP-trafik"

#, java-printf-format
msgctxt "sip_trace_help"
