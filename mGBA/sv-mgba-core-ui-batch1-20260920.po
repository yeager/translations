#. QGBA::ApplicationUpdatePrompt
msgctxt "QGBA::ApplicationUpdatePrompt"
msgid "Verifying download failed. Please update manually."
msgstr "Verifieringen misslyckades. Uppdatera manuellt."

#. QGBA::AudioProcessorDummy
msgctxt "QGBA::AudioProcessorDummy"
msgid "Can't start an audio processor without input"
msgstr "Det går inte att starta en ljudprocessor utan indata"

#. QGBA::AudioProcessorQt
msgctxt "QGBA::AudioProcessorQt"
msgid "Audio outputting to %1"
msgstr "Ljud skickas ut till %1"

#. QGBA::BattleChipModel
msgctxt "QGBA::BattleChipModel"
msgid "Failed to open chip names list"
msgstr "Kunde inte öppna listan över chipnamn"

#. QGBA::CoreManager
msgctxt "QGBA::CoreManager"
msgid "Temporary file loaded"
msgstr "Tillfällig fil har lästs in"

#. QGBA::CoreManager
msgctxt "QGBA::CoreManager"
msgid "The ROM appears to be loaded from a temporary directory, perhaps automatically extracted from an archive (e.g. a zip file)."
msgstr "ROM-filen verkar ha lästs in från en tillfällig katalog, möjligen automatiskt extraherad från ett arkiv (t.ex. en zip-fil)."

#. QGBA::CoreManager
msgctxt "QGBA::CoreManager"
msgid "Could not open save file"
msgstr "Kunde inte öppna sparfilen"

#. QGBA::CoreManager
msgctxt "QGBA::CoreManager"
msgid "Failed to open save file; in-game saves cannot be updated."
msgstr "Kunde inte öppna sparfilen; sparningar i spelet kan inte uppdateras."

#. QGBA::CoreManager
msgctxt "QGBA::CoreManager"
msgid "Would you like to copy the ROM to a different location? If you don't, this will likely lead to data loss (e.g. saves, screenshots, etc.)."
msgstr "Vill du kopiera ROM-filen till en annan plats? Om du inte gör det kommer det troligen att leda till dataförlust (t.ex. sparningar, skärmbilder osv.)."

#. QGBA::CoreManager
msgctxt "QGBA::CoreManager"
msgid "Copy failed"
msgstr "Kopieringen misslyckades"

#. QGBA::CoreManager
msgctxt "QGBA::CoreManager"
msgid "Failed to copy ROM. Do you want to try again?"
msgstr "Det gick inte att kopiera ROM-filen. Vill du försöka igen?"

#. QGBA::CoreManager
msgctxt "QGBA::CoreManager"
msgid "New ROM location"
msgstr "Ny plats för ROM-fil"

#. QGBA::DebuggerConsole
msgctxt "QGBA::DebuggerConsole"
msgid "Continue"
msgstr "Fortsätt"

