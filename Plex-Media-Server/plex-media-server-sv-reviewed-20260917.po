msgid "Amount of brightness to apply when tone mapping on Windows with an Intel device (-100.0 - 100.0)."
msgstr "Ljusstyrka att använda vid tonmappning i Windows med en Intel-enhet (-100.0 - 100.0)."

#. Transifex: o:plex-1:p:plex-media-server:r:enpo:s:3bf0651342bdc42654afa3c38c779523
msgid "Directory to use when transcoding for temporary files. This should ideally be a location on a local physical drive. It is not recommended to set this to a network location or RAM disk."
msgstr "Katalog att använda för tillfälliga filer vid omkodning. Den bör helst ligga på en lokal fysisk enhet. Det rekommenderas inte att använda en nätverksplats eller RAM-disk."

#. Transifex: o:plex-1:p:plex-media-server:r:enpo:s:c86e596b63a50ca02b36cc2b095dc06b
msgid "Downloads temporary directory"
msgstr "Tillfällig katalog för hämtningar"

#. Transifex: o:plex-1:p:plex-media-server:r:enpo:s:fec8c340738765ae7f0922f3cf3d32d7
msgid "Directory to use when storing transcoded downloads until the client downloads them. This should ideally be a location on a local physical drive. It is not recommended to set this to a network location or RAM disk."
msgstr "Katalog att använda för lagring av omkodade hämtningar tills klienten hämtar dem. Den bör helst ligga på en lokal fysisk enhet. Det rekommenderas inte att använda en nätverksplats eller RAM-disk."

#. Transifex: o:plex-1:p:plex-media-server:r:enpo:s:bfbc57e63fc04d7cbe0315eae9898414
msgid "Maximum simultaneous GPU transcodes"
msgstr "Högsta antal samtidiga GPU-omkodningar"

#. Transifex: o:plex-1:p:plex-media-server:r:enpo:s:c8c43ce6734b26be29d1e8b7e8926ec4
