msgid "Amount of contrast to apply when tone mapping on Windows with an Intel device (0.0 - 10.0)."
msgstr "Kontrast att använda vid tonmappning i Windows med en Intel-enhet (0.0 - 10.0)."

#. Transifex: o:plex-1:p:plex-media-server:r:enpo:s:b0192637818e9d5aed3b24d81f164481
msgid "Tone Mapping Brightness"
msgstr "Ljusstyrka för tonmappning"

