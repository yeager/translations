"Describe how ARASAAC pictograms and materials are used in this initiative..."
msgstr "Beskriv hur ARASAAC:s piktogram och material används i initiativet…"

#: en.json:7771
msgctxt "app.containers.UploadWorldView.descriptionTooLong"
msgid "Description cannot exceed 1800 characters (approx. 300 words)"
msgstr "Beskrivningen får inte innehålla fler än 1 800 tecken (cirka 300 ord)"

#: en.json:7511
