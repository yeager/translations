msgctxt "68403"
msgid "Exclude from list"
msgstr "Uteslut från listan"

msgctxt "68405"
msgid ""
"Excluding doesn’t fix the risk to your password. To protect your account, "
"change your password first."
msgstr ""
"Att utesluta åtgärdar inte risken för lösenordet. För att skydda kontot "
"ändrar du först lösenordet."

msgctxt "68407"
msgid "Exclude anyway"
msgstr "Uteslut ändå"
