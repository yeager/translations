#. MENU_ENUM_LABEL_VALUE_VIDEO_WINDOW_ATTACHED
msgid "Attached"
msgstr "Kopplad"

#. MENU_ENUM_LABEL_VALUE_VIDEO_WINDOW_HIDDEN
msgid "Hidden"
msgstr "Dold"

#. MENU_ENUM_SUBLABEL_VIDEO_WINDOWS_ENABLE_ANDROID
msgid "Show secondary screens on another display."
msgstr "Visa sekundära skärmar på en annan bildskärm."

#. MENU_ENUM_LABEL_VALUE_VIDEO_SCREEN_WINDOW_MODE
msgid "Screen %u"
msgstr "Skärm %u"

#. MENU_ENUM_SUBLABEL_VIDEO_SCREEN_WINDOW_MODE
msgid "Attached keeps this screen with the others. Separate puts it on a window or display of its own. Hidden leaves it out."
msgstr "Kopplad behåller skärmen tillsammans med de andra. Separat visar den i ett eget fönster eller på en egen bildskärm. Dold utelämnar den."

#. MENU_ENUM_LABEL_VALUE_VIDEO_SCREEN_WINDOW_MONITOR
msgid "Screen %u Display"
msgstr "Bildskärm för skärm %u"

#. MENU_ENUM_SUBLABEL_VIDEO_SCREEN_WINDOW_MONITOR
msgid "Where this screen goes when it is Separate. Auto picks a second display. The display RetroArch is on keeps the screen attached."
msgstr "Var den här skärmen visas när den är separat. Automatiskt väljer en andra bildskärm. På bildskärmen där RetroArch körs behålls skärmen kopplad."

#. MENU_ENUM_LABEL_VALUE_VIDEO_WINDOWS_ENABLE
msgid "Separate Screen Windows"
msgstr "Separata skärmfönster"

#. MENU_ENUM_SUBLABEL_VIDEO_WINDOWS_ENABLE
msgid "Allow secondary screens to use separate desktop windows."
msgstr "Tillåt sekundära skärmar i separata skrivbordsfönster."
