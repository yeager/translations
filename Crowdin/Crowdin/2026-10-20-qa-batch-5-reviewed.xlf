<xliff version="1.2">
  <file original="Crowdin QA batch 5" source-language="en" target-language="sv">
    <body>
      <trans-unit id="6969352">
        <source>:negative_squared_cross_mark: *Declined*</source>
        <target>:negative_squared_cross_mark: *Avvisad*</target>
      </trans-unit>
      <trans-unit id="7036043">
        <source>:passkeyName passkey</source>
        <target>:passkeyName säkerhetsnyckel</target>
      </trans-unit>
      <trans-unit id="7036577">
        <source>:userName revoked token</source>
        <target>:userName återkallade en token</target>
      </trans-unit>
      <trans-unit id="7036595">
        <source>:userName revoked session</source>
        <target>:userName återkallade sessionen</target>
      </trans-unit>
      <trans-unit id="7036601">
        <source>:userName revoked all sessions</source>
        <target>:userName återkallade alla sessioner</target>
      </trans-unit>
      <trans-unit id="7036605">
        <source>:userName connected auth provider</source>
        <target>:userName anslöt en autentiseringsleverantör</target>
      </trans-unit>
      <trans-unit id="7036611">
        <source>:userName disconnected auth provider</source>
        <target>:userName kopplade från en autentiseringsleverantör</target>
      </trans-unit>
      <trans-unit id="7036617">
        <source>:userName register account</source>
        <target>:userName registrerade ett konto</target>
      </trans-unit>
      <trans-unit id="7036637">
        <source>:userName installed Crowdin application</source>
        <target>:userName installerade Crowdins app</target>
      </trans-unit>
      <trans-unit id="7036643">
        <source>:userName uninstalled Crowdin application</source>
        <target>:userName avinstallerade Crowdins app</target>
      </trans-unit>
      <trans-unit id="7036685">
        <source>Support team reset two-factor authentication for :userName</source>
        <target>Supportteamet återställde tvåfaktorsautentisering för :userName</target>
      </trans-unit>
      <trans-unit id="7037053">
        <source>@if($enabled)
        Your account's Two-Factor Authentication (&lt;b&gt;{{ $method2fa }}&lt;/b&gt;) has been successfully set up, adding an extra layer of security.</source>
        <target>@if($enabled)
        Ditt kontos tvåfaktorsautentisering (&lt;b&gt;{{ $method2fa }}&lt;/b&gt;) har konfigurerats och ger ett extra säkerhetslager.</target>
      </trans-unit>
      <trans-unit id="7037377">
        <source>@if($is_reminder)
        It looks like you haven't confirmed your email address yet.</source>
        <target>@if($is_reminder)
        Det ser ut som om du inte har bekräftat din e-postadress ännu.</target>
      </trans-unit>
      <trans-unit id="7043041">
        <source>:userName requested reset user Two-Factor Authentication</source>
        <target>:userName begärde återställning av tvåfaktorsautentisering</target>
      </trans-unit>
      <trans-unit id="7043065">
        <source>:userName unblocked user</source>
        <target>:userName avblockerade en användare</target>
      </trans-unit>
    </body>
