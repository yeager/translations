"pkg:s:6273cde4bbb4bd7a3673a5db55ebc09e:l:sv"
msgid "%{quota} (Default)"
msgstr "%{quota} (standard)"

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"pkg:s:d380725f0028969fc265529af12b941b:l:sv"
msgid "Result %{current} of %{total}"
msgstr "Resultat %{current} av %{total}"

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:7d63ae151af5b54055d82403a6c671ee:l:sv"
msgid "Enter the PIN from the email we sent you."
msgstr "Ange PIN-koden i e-postmeddelandet vi skickade till dig."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:ca95844bc6dbeec47ad2e6ea6e355d96:l:sv"
msgid "Too many PINs were requested. Please try again later."
msgstr "För många PIN-koder har begärts. Försök igen senare."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:e517416ba65bfe31d997a4a37fc4a423:l:sv"
msgid "Too many PINs were requested. Please try again %{time}."
msgstr "För många PIN-koder har begärts. Försök igen %{time}."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:bd0bd1f07b6acf113f98085b4c89791a:l:sv"
msgid "Enter PIN"
msgstr "Ange PIN-kod"

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:33c701429febe351db41ac2d6f77d9e7:l:sv"
msgid "Your session expires soon"
msgstr "Din session löper snart ut"

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:65537595c461653ab3fe829a14906a88:l:sv"
msgid "Request PIN"
msgstr "Begär PIN-kod"

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:9b9ed9cb73dab1b3cc4bfe1b8bc2b683:l:sv"
msgid "Request new invitation"
msgstr "Begär en ny inbjudan"

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:76aa4998df8a91ad027e70acf441565e:l:sv"
msgid "A PIN could not be requested. Please try again later."
msgstr "Det gick inte att begära en PIN-kod. Försök igen senare."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:76bb19db25e847dfdd1ffee8e3495797:l:sv"
msgid ""
"A PIN could not be requested. Save your changes before your session expires "
"at %{time}."
msgstr ""
"Det gick inte att begära en PIN-kod. Spara dina ändringar innan sessionen "
"löper ut %{time}."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:692a5516c3eed143d2d756fe3ad084c3:l:sv"
msgid "Your session has expired"
msgstr "Din session har löpt ut"

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:dff05c9e3d7b58cf105cc2447f4db5ac:l:sv"
msgid ""
"Your session expires at %{time}. Save your changes, or request a PIN by "
"email to stay signed in."
msgstr ""
"Din session löper ut %{time}. Spara dina ändringar eller begär en PIN-kod "
"via e-post för att förbli inloggad."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:3df4669f456097cedd0ba2a97793b357:l:sv"
msgid ""
"Your session expires at %{time}. We sent you a PIN by email, enter it to "
"stay signed in."
msgstr ""
"Din session löper ut %{time}. Vi har skickat en PIN-kod via e-post. Ange den"
" för att förbli inloggad."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:df462af9374f9218aaff01fbc58dba79:l:sv"
msgid ""
"Open the invitation link from your most recent email to continue. If it has "
"expired or has already been used, a new one is on its way."
msgstr ""
"Öppna inbjudningslänken i ditt senaste e-postmeddelande för att fortsätta. "
"Om den har löpt ut eller redan har använts skickas en ny."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:c9580e9fb4d1744791b886ca9f786b7e:l:sv"
msgid "Request a new invitation by email to continue."
msgstr "Begär en ny inbjudan via e-post för att fortsätta."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:977afac95ca2527c789b634ccbbc7580:l:sv"
msgid "Enter the PIN we sent you by email to continue."
msgstr "Ange PIN-koden som vi har skickat via e-post för att fortsätta."

msgctxt ""
"o:opencloud-eu:p:opencloud-eu:r:web-"
"runtime:s:158c4fa295840576eeb04a422b54c96f:l:sv"
msgid "Your session has been renewed"
msgstr "Din session har förnyats"

msgctxt ""
"o:opencloud-eu:p:opencloud-"
"eu:r:desktop:s:09250795b410120ed526801050ed0623:l:sv"
msgid "Failed to load excludes"
msgstr "Kunde inte läsa in undantag"

msgctxt ""
"o:opencloud-eu:p:opencloud-"
"eu:r:desktop:s:ed682789ba4862aa2928d66d59a4f9e0:l:sv"
msgid "Reloading excludes on folder »%1«"
msgstr "Läser in undantag igen i mappen »%1«"
