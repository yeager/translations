msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:6a391a9eab1b30cf1d10bd8fac30a057:l:sv"
msgid "Repository url must be a valid http or https URL"
msgstr "Förvarets URL måste vara en giltig HTTP- eller HTTPS-adress."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:8a86619760947b58e3f2daf1b5f30afb:l:sv"
msgid "Contributing in <b>{projects} project</b> as a <b>{roles}</b>."
msgid_plural "Contributing in <b>{projects} projects</b> as a <b>{roles}</b>."
msgstr[0] "Bidrar till <b>{projects} projekt</b> som <b>{roles}</b>."
msgstr[1] "Bidrar till <b>{projects} projekt</b> som <b>{roles}</b>."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:f5a30418111ae2f065f4fff9213d9068:l:sv"
msgid "Contributing in <b>{projects} project</b>."
msgid_plural "Contributing in <b>{projects} projects</b>."
msgstr[0] "Bidrar till <b>{projects} projekt</b>."
msgstr[1] "Bidrar till <b>{projects} projekt</b>."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:8af41901796be001b69b47951690602a:l:sv"
msgid "Languages excluded from similar locales"
msgstr "Språk som undantas från liknande språkinställningar"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:bee394e6d6e713cf3c0a28b26a810c3a:l:sv"
msgid ""
"These languages are never matched against other locales that share their "
"language, both when filling up from the Translation Memory and when showing "
"suggestions in the editor."
msgstr ""
"Dessa språk matchas aldrig mot andra språkinställningar som delar deras "
"språk, vare sig när översättningsminnet fylls på eller när förslag visas i "
"redigeraren."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:84832974719adbbf9bedef8f45f31f84:l:sv"
msgid ""
"Single Sign-On can be enforced once every member has signed in through it. "
"Still to sign in: {usernames}."
msgstr ""
"Enkel inloggning kan krävas när alla medlemmar har loggat in med den. "
"Återstår att logga in: {usernames}."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:d8ead71a4d45fdd6b79974255d1852cb:l:sv"
msgid ""
"\n"
"      If you contact support, quote this reference: {reference_id}\n"
"    "
msgstr ""
"\n"
"      Om du kontaktar supporten anger du denna referens: {reference_id}\n"
"    "

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:67895c140d42ec90edb68a35f92a4158:l:sv"
msgid "Hi,"
msgstr "Hej!"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:413c35f2a97f3ba438bf8a65fa294c10:l:sv"
msgid ""
"You asked to reset your Transifex password. Your organizations sign in with "
"Single Sign-On, so you don't have a Transifex password to reset."
msgstr ""
"Du har begärt återställning av ditt lösenord för Transifex. Dina "
"organisationer använder enkel inloggning, så du har inget lösenord för "
"Transifex att återställa."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:c53d5cb55883fd2b9ebe6ea27354cbb4:l:sv"
msgid ""
"To sign in, go to the following page and choose \"Login with Single Sign-"
"On\":"
msgstr ""
"För att logga in går du till följande sida och väljer ”Logga in med enkel "
"inloggning”:"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:f6dcdf72dc59d4dff6e07a14b0637cc7:l:sv"
msgid ""
"If you can't sign in with Single Sign-On, contact your organization's "
"administrator."
msgstr ""
"Om du inte kan logga in med enkel inloggning kontaktar du organisationens "
"administratör."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:0d9f0cdbe88696b127955fc01e9a5c8e:l:sv"
msgid "The Transifex team"
msgstr "Teamet på Transifex"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:662a044e10bf69c428aeed8db1cf9160:l:sv"
msgid "Sign in to Transifex with Single Sign-On"
msgstr "Logga in på Transifex med enkel inloggning"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:6be027ee69b005bf747ca1687a474b39:l:sv"
msgid "Back to sign in"
msgstr "Tillbaka till inloggningen"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:8aab06a7d1dee82fb7c645245ffe5797:l:sv"
msgid ""
"You asked to choose a Transifex password so you can accept your invitation. "
"Go to the following page to choose it:"
msgstr ""
"Du har begärt att få välja ett lösenord för Transifex för att kunna "
"acceptera din inbjudan. Gå till följande sida för att välja det:"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:0a0d24298e1f78b844ec3ab8ae212849:l:sv"
msgid ""
"You'll use this password to sign in to organizations that don't use Single "
"Sign-On. The link works once and expires soon."
msgstr ""
"Du använder lösenordet för att logga in på organisationer som inte använder "
"enkel inloggning. Länken fungerar en gång och slutar snart att gälla."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:f19a59fc1a12210a89530b427722d13b:l:sv"
msgid "Choose your Transifex password"
msgstr "Välj ett lösenord för Transifex"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:393918538b483e0e8b58066255f51b0f:l:sv"
msgid "Choose a password to join"
msgstr "Välj ett lösenord för att gå med"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:4cf63972b5102a29ae90d530b21bbab6:l:sv"
msgid ""
"To join this organization, choose a password. You'll use it to sign in to "
"organizations that don't use Single Sign-On."
msgstr ""
"För att gå med i organisationen väljer du ett lösenord. Du använder det för "
"att logga in på organisationer som inte använder enkel inloggning."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:ee9d45ee58b2e440291c10448070352f:l:sv"
msgid "We've emailed you a link to choose your password. Check your inbox."
msgstr ""
"Vi har skickat en länk till din e-post som du kan använda för att välja "
"lösenord. Kontrollera inkorgen."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:88d8b0346861acb3caee45d168058d53:l:sv"
msgid ""
"To join this organization, you need a Transifex password. First, confirm "
"it's you: we'll email you a link to choose one."
msgstr ""
"För att gå med i organisationen behöver du ett lösenord för Transifex. "
"Bekräfta först din identitet genom att vi skickar en länk som du kan använda"
" för att välja ett."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:9a65eeb986658e1597c5b18ca6d5a7d1:l:sv"
msgid "Set password and join"
msgstr "Välj lösenord och gå med"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:e657bc0fb8235fe134a8c230ee69668e:l:sv"
msgid "The link works once and expires soon."
msgstr "Länken fungerar en gång och slutar snart att gälla."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:8932804b4eefb0f8e55a342ead923ac9:l:sv"
msgid "Email me the link"
msgstr "Skicka länken via e-post"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:1f5557b359ce18b3ac0d6f817a3a653d:l:sv"
msgid ""
"Single Sign-On can be enforced once every member has signed in through it."
msgstr "Enkel inloggning kan krävas när alla medlemmar har loggat in med den."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:b4f683ca1fc5b826473ca133f2e7e18b:l:sv"
msgid "Continue with Single Sign-On"
msgstr "Fortsätt med enkel inloggning"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:120df25fa61a6e323f67d865483b3da6:l:sv"
msgid "Check your email"
msgstr "Kontrollera din e-post"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:140bda21ed14e6fd87c5312389de5650:l:sv"
msgid "{organization_name} now signs in with Single Sign-On."
msgstr "{organization_name} använder nu enkel inloggning."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:d4e18786b649f9036d0e727beff1b1b3:l:sv"
msgid ""
"Sign in through your company's identity provider to keep working there."
msgstr ""
"Logga in via din organisations identitetsleverantör för att fortsätta arbeta"
" där."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:8812a97616d80fd4868dfe28b5f37554:l:sv"
msgid "We've emailed you an invitation to set it up."
msgstr "Vi har skickat en inbjudan via e-post så att du kan konfigurera den."

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:81ffa6ced2e73eab568209efebcee6a9:l:sv"
msgid "Continue with SSO"
msgstr "Fortsätt med enkel inloggning"

msgctxt ""
"o:transifex:p:transifex-app:r:transifex-"
"app:s:53e53629a3a49c63c775e85b33664c44:l:sv"
msgid "Continue to Transifex"
msgstr "Fortsätt till Transifex"
