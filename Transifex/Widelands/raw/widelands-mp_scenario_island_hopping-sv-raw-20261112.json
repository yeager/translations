  {
    "translation_id": "o:widelands:p:widelands:r:mp_scenario_island_hopping:s:ee2e134e4ad286bfa5b046a94b6023fb:l:sv",
    "source_id": "o:widelands:p:widelands:r:mp_scenario_island_hopping:s:ee2e134e4ad286bfa5b046a94b6023fb",
    "source": {
      "other": "If you finish a castle in the target area on the second island, you will get a third headquarters on the third island with all wares, workers and soldiers getting transferred from your previous headquarters and warehouses again. You must build a castle at the center of the third island and hold it for 20 minutes to win the game."
    },
    "target": {
      "other": "Om du färdigställer ett slott i målområdet på den andra ön får du ett tredje högkvarter på den tredje ön. Dit flyttas återigen alla varor, arbetare och soldater från dina tidigare högkvarter och lagerbyggnader. Du måste bygga ett slott mitt på den tredje ön och hålla det i 20 minuter för att vinna."
    },
    "context": "",
    "developer_comment": null,
    "key": "If you finish a castle in the target area on the second island, you will get a third headquarters on the third island with all wares, workers and soldiers getting transferred from your previous headquarters and warehouses again. You must build a castle at the center of the third island and hold it for 20 minutes to win the game.",
    "pluralized": false,
    "reviewed": false
  },
