msgid "Ability gained:"
msgstr "Förmåga erhållen:"

msgid "Ability lost:"
msgstr "Förmåga förlorad:"

msgid "Give/remove yourself an ability or list abilities"
msgstr "Ge eller ta bort en förmåga för dig själv, eller lista förmågor"

msgid "(add <ability>) | (remove <ability>) | list"
msgstr "(lägg till <förmåga>) | (ta bort <förmåga>) | lista"

msgid "No player."
msgstr "Ingen spelare."

msgid "All abilities added."
msgstr "Alla förmågor har lagts till."

msgid "All abilities removed."
msgstr "Alla förmågor har tagits bort."

msgid "Unknown ability."
msgstr "Okänd förmåga."

msgid "No abilities."
msgstr "Inga förmågor."

msgid "Super Slope Sliding"
msgstr "Superglidning i branta sluttningar"

msgid "Can slide up tall slopes"
msgstr "Kan glida uppför branta sluttningar"

msgid "Sliding"
msgstr "Glidning"

msgid "Can slide on flat ground and small slopes"
msgstr "Kan glida på plan mark och små sluttningar"

msgid "Press Forward/Backward/Left/Right key"
msgstr "Tryck på tangenten Framåt/Bakåt/Vänster/Höger"

msgid "Power-Sliding"
msgstr "Kraftglidning"

msgid "Can use small speed boosts on the floor"
msgstr "Kan använda små fartökningar på golvet"

msgid "Hold down Aux1 and press Forward"
msgstr "Håll ned Aux1 och tryck på Framåt"

msgid "Climbing"
msgstr "Klättring"

msgid "Can climb at certain places"
msgstr "Kan klättra på vissa platser"

msgid "Press Jump to climb up; press Sneak key to climb down"
msgstr ""
"Tryck på Hoppa för att klättra uppåt; tryck på Smyg för att klättra nedåt"

msgid "Launching"
msgstr "Uppskjutning"

msgid "Can use launchpads"
msgstr "Kan använda avfyrningsramper"

msgid "Hold down Aux1 or Jump key on a launchpad"
msgstr "Håll ned Aux1 eller Hoppa på en avfyrningsramp"
