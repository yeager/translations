"Ogiltigt filnamnsmönster. Det måste innehålla mallsträngen '{orig_file_name}"
"' och en filändelse"

#: lada/cli/main.py:172
msgid "Invalid output directory. If input is a directory then --output must also be set to a directory"
msgstr ""
"Ogiltig utdatakatalog. Om indata är en katalog måste --output också anges "
"som en katalog"

#: lada/cli/main.py:175
#, python-brace-format
msgid "Invalid input. No file or directory at {input_path}"
msgstr "Ogiltig indata. Ingen fil eller katalog vid {input_path}"

#: lada/cli/main.py:178
#, python-brace-format
msgid "Temporary directory {temporary_path} doesn't exist. Creating…"
msgstr "Den tillfälliga katalogen {temporary_path} finns inte. Skapar …"

