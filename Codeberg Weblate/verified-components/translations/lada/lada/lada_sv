#: lada/cli/main.py:69
#, python-format
msgid "Reduces VRAM usage and may increase speed on modern GPUs, with negligible quality difference. (default: %(default)s)"
msgstr ""
"Minskar VRAM-användningen och kan öka hastigheten på moderna GPU:er, med "
"försumbar kvalitetsskillnad. (standard: %(default)s)"

#: lada/cli/main.py:70
msgid "List available devices and exit"
msgstr "Lista tillgängliga enheter och avsluta"

#: lada/cli/main.py:71
msgid "Display version and exit"
msgstr "Visa version och avsluta"

#: lada/cli/main.py:72
msgid "Show this help message and exit"
msgstr "Visa detta hjälpmeddelande och avsluta"

#: lada/cli/main.py:75
#, python-format
msgid "Select encoding preset by name. Use \"--list-encoding-presets\" to see what's available. Ignored if \"--encoder\" and \"--encoder-options\" are used (default: %(default)s)"
msgstr ""
"Välj kodningsförinställning efter namn. Använd \"--list-encoding-presets\" "
"för att se tillgängliga. Ignoreras om \"--encoder\" och \"--encoder-"
"options\" används (standard: %(default)s)"

#: lada/cli/main.py:76
msgid "List available encoding presets and exit"
msgstr "Lista tillgängliga kodningsförinställningar och avsluta"

#: lada/cli/main.py:77
#, python-format
msgid "Select video encoder by name. Use \"--list-encoders\" to see what's available. (default: %(default)s)"
msgstr ""
"Välj videokodare efter namn. Använd \"--list-encoders\" för att se "
"tillgängliga. (standard: %(default)s)"

#: lada/cli/main.py:78
msgid "List available encoders and exit"
msgstr "Lista tillgängliga kodare och avsluta"

#: lada/cli/main.py:79
#, python-format
msgid "Space-separated list of options for the encoder set via \"--encoder\". Use \"--list-encoder-options\" to see what's available. (default: %(default)s)"
msgstr ""
"Mellanslagsseparerad lista med alternativ för kodaren som angetts med \"--"
"encoder\". Använd \"--list-encoder-options\" för att se tillgängliga. "
"(standard: %(default)s)"

#: lada/cli/main.py:80
msgid "List available options of the given encoder and exit"
msgstr "Lista tillgängliga alternativ för angiven kodare och avsluta"

#: lada/cli/main.py:81
#, python-format
msgid "Allows playing the file while it's being written. Sets .mp4 mov flags \"frag_keyframe+empty_moov+faststart\". (default: %(default)s)"
msgstr ""
"Tillåter uppspelning av filen medan den skrivs. Anger .mp4 mov-flaggorna "
"\"frag_keyframe+empty_moov+faststart\". (standard: %(default)s)"

#: lada/cli/main.py:83
msgid "Mosaic Restoration"
msgstr "Mosaikåterställning"

#: lada/cli/main.py:84
msgid "List available restoration models found in model weights directory and exit (default location is './model_weights' if not overwritten by environment variable LADA_MODEL_WEIGHTS_DIR)"
msgstr ""
"Lista tillgängliga återställningsmodeller i katalogen för modellvikter och "
"avsluta (standardplats är './model_weights' om den inte skrivs över av "
"miljövariabeln LADA_MODEL_WEIGHTS_DIR)"

#: lada/cli/main.py:85
#, python-format
msgid "Name of detection model or path to model weights file. Use \"--list-mosaic-restoration-models\" to see what's available. (default: %(default)s)"
msgstr ""
"Namn på identifieringsmodell eller sökväg till fil med modellvikter. Använd "
"\"--list-mosaic-restoration-models\" för att se tillgängliga. (standard: %"
"(default)s)"

#: lada/cli/main.py:86
msgid "Path to restoration model configuration file. You'll not have to set this unless you're training your own custom models"
msgstr ""
"Sökväg till konfigurationsfil för återställningsmodell. Du behöver inte ange "
"detta om du inte tränar egna anpassade modeller"

#: lada/cli/main.py:87
#, python-format
msgid "Maximum number of frames for restoration. Higher values improve temporal stability. Lower values reduce memory footprint. If set too low flickering could appear (default: %(default)s)"
msgstr ""
"Maximalt antal bildrutor för återställning. Högre värden förbättrar "
"tidsmässig stabilitet. Lägre värden minskar minnesanvändningen. Om värdet är "
"för lågt kan flimmer uppstå (standard: %(default)s)"

#: lada/cli/main.py:89
msgid "Mosaic Detection"
msgstr "Mosaikidentifiering"

#: lada/cli/main.py:90
#, python-format
msgid "Name of detection model or path to model weights file. Use \"--list-mosaic-detection-models\" to see what's available. (default: %(default)s)"
msgstr ""
"Namn på identifieringsmodell eller sökväg till fil med modellvikter. Använd "
"\"--list-mosaic-detection-models\" för att se tillgängliga. (standard: %"
"(default)s)"

#: lada/cli/main.py:91
msgid "List available detection models found in model weights directory and exit (default location is './model_weights' if not overwritten by environment variable LADA_MODEL_WEIGHTS_DIR)"
msgstr ""
"Lista tillgängliga identifieringsmodeller i katalogen för modellvikter och "
"avsluta (standardplats är './model_weights' om den inte skrivs över av "
"miljövariabeln LADA_MODEL_WEIGHTS_DIR)"

#: lada/cli/main.py:92
#, python-format
msgid "Detect and ignore areas of pixelated faces. Can prevent restoration artifacts but may worsen detection of NSFW mosaics. Available for models v3 and newer. (default: %(default)s)"
msgstr ""
"Identifiera och ignorera områden med pixlade ansikten. Kan förhindra "
"återställningsartefakter men kan försämra identifieringen av NSFW-mosaiker. "
"Tillgängligt för modeller v3 och senare. (standard: %(default)s)"

#: lada/cli/main.py:132
msgid "Processing audio"
msgstr "Bearbetar ljud"

