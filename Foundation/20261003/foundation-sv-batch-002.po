msgid ""
msgstr ""
"Language: sv_SE\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Reach Harvest Festival Tier {1}"
msgstr "Nå nivå {1} i skördefestivalen"

msgid "Unlocked later in progression"
msgstr "Låses upp senare i utvecklingen"

msgid "Unlocked at Harvest Festival Tier {1}"
msgstr "Låses upp på nivå {1} i skördefestivalen"

msgid "Delivering Material resources"
msgstr "Levererar materialresurser"

msgid ""
"No additional Festive Drinks are available at this moment. Keep progressing "
"to unlock more drink choices."
msgstr ""
"Inga ytterligare festdrycker är tillgängliga just nu. Fortsätt utvecklas för"
" att låsa upp fler dryckesval."

msgid ""
"No additional Festive Meals are available at this moment. Keep progressing "
"to unlock more recipe choices."
msgstr ""
"Inga ytterligare festmåltider är tillgängliga just nu. Fortsätt utvecklas "
"för att låsa upp fler receptval."

msgid "Next Harvest Festival available in {1} day(s)."
msgstr "Nästa skördefestival kan hållas om {1} dag(ar)."

msgid "Start a new Harvest Festival now."
msgstr "Starta en ny skördefestival nu."

msgid "Cancel Planned Harvest Festival"
msgstr "Avbryt planerad skördefestival"

msgid "Cancel Harvest Festival"
msgstr "Avbryt skördefestival"

msgid "Are you sure you want to cancel the planned Harvest Festival?"
msgstr "Vill du verkligen avbryta den planerade skördefestivalen?"

msgid "{1}/{2} Spectator Capacity"
msgstr "{1}/{2} Åskådarkapacitet"

msgid "{1}/{2} {3} are currently served at this table"
msgstr "{1}/{2} {3} serveras för närvarande vid det här bordet"

msgid "Choose an Entertainer"
msgstr "Välj en underhållare"

msgid "Harvest Ham"
msgstr "Skördeskinka"

msgid "Sweet-Roasted Chicken"
msgstr "Sötrostad kyckling"

msgid "Abbey Fish"
msgstr "Klosterfisk"

msgid "Forager's Bread"
msgstr "Samlarbröd"

msgid ""
"Material resources will be delivered to {1} to ensure new parts can be "
"deployed during the next Harvest Festival."
msgstr ""
"Materialresurser levereras till {1} för att se till att nya delar kan byggas"
" ut under nästa skördefestival."

msgid "Material resources to deliver:"
msgstr "Materialresurser att leverera:"

msgid ""
"Material resources will be delivered to {1} followed by preparation for the "
"Harvest Festival.\n"
msgstr ""
"Materialresurser levereras till {1}, följt av förberedelser för "
"skördefestivalen.\n"

msgid "All Material resources have been delivered"
msgstr "Alla materialresurser har levererats"

msgid "Builders will prioritise this task."
msgstr "Byggare prioriterar den här uppgiften."

msgid "Material resources delivery in progress"
msgstr "Leverans av materialresurser pågår"

msgid "A Harvest Festival cannot be cancelled once preparation has started."
msgstr ""
"En skördefestival kan inte avbrytas när förberedelserna har påbörjats."

msgid "{1} Bonus"
msgstr "Bonus på {1}"

msgid ""
"Fulfil the requirements to have {1} in your Croft and gain an Animal "
"Productivity bonus."
msgstr ""
"Uppfyll kraven för att ha {1} i ditt torp och få en bonus för "
"djurproduktivitet."

msgid "Gain a {1}% Animal Productivity bonus on this {2}"
msgstr "Få en bonus på {1}% för djurproduktiviteten i denna {2}"

msgid "chickens"
msgstr "höns"

msgid "Chicks"
msgstr "Kycklingar"

msgid "geese"
msgstr "gäss"

msgid "Goslings"
msgstr "Gåsungar"

msgid "pigs"
msgstr "grisar"

msgid "Piglets"
msgstr "Kultingar"

msgid "Build a {1}"
msgstr "Bygg ett {1}"

msgid "Maximise the Animal Productivity on this Animal Pen"
msgstr "Maximera djurproduktiviteten i den här djurfållan"

msgid "{1} are stepping out of their pen!"
msgstr "{1} lämnar sin fålla!"

msgid ""
"Thanks to your care, the {1} feel comfortable enough to let their offspring "
"roam outside. A first in the village!"
msgstr ""
"Tack vare din omsorg känner sig {1} tillräckligt trygga för att låta sina "
"ungar gå fritt. Första gången i byn!"

msgid ""
"All animals in this Animal Pen must be satiated to maximize their "
"Productivity."
msgstr ""
"Alla djur i den här djurfållan måste vara mätta för att maximera sin "
"produktivitet."

msgid "Croft Occupancy"
msgstr "Beläggning i torpet"

msgid "Festival Attendees"
msgstr "Festivaldeltagare"

msgid "Total Festival Attendees"
msgstr "Totalt antal festivaldeltagare"

msgid "Needs Fulfilment"
msgstr "Behovstillfredsställelse"

msgid "Earnable Score"
msgstr "Möjlig poäng"

msgid "Recommendations"
msgstr "Rekommendationer"

msgid "Prepare varied Festive Meals"
msgstr "Tillaga varierade festmåltider"

msgid "Prepare more Festive Meals"
msgstr "Tillaga fler festmåltider"

msgid "Place more Entertainment Sites"
msgstr "Placera ut fler underhållningsplatser"

msgid "Serve more Festive Drinks"
msgstr "Servera fler festdrycker"

msgid "Serve varied Festive Drinks"
msgstr "Servera varierade festdrycker"
