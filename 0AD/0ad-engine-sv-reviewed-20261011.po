#: i18n/L10n.cpp:342
msgid "Long strings"
msgstr "Långa strängar"

#: lobby/GlooxConversion.cpp:68 lobby/GlooxConversion.cpp:106
#: lobby/GlooxConversion.cpp:142
msgid "Error"
msgstr "Fel"

#: lobby/GlooxConversion.cpp:71 lobby/GlooxConversion.cpp:109
msgid "No error"
msgstr "Inget fel"

#: lobby/GlooxConversion.cpp:73
msgid "Player already logged in"
msgstr "Spelaren är redan inloggad"

#: lobby/GlooxConversion.cpp:75
msgid "Forbidden"
msgstr "Förbjudet"

#: lobby/GlooxConversion.cpp:77
msgid "Internal server error"
msgstr "Internt serverfel"

#: lobby/GlooxConversion.cpp:81
msgid "Not allowed"
msgstr "Inte tillåtet"

#: lobby/GlooxConversion.cpp:82
msgid "Not authorized"
msgstr "Inte behörig"

#: lobby/GlooxConversion.cpp:85
msgid "Recipient temporarily unavailable"
msgstr "Mottagare inte tillgänglig för tillfället"

#: lobby/GlooxConversion.cpp:87
msgid "Registration required"
msgstr "Registrering krävs"

#: lobby/GlooxConversion.cpp:92
msgid "Service unavailable"
msgstr "Tjänsten inte tillgänglig"

#: lobby/GlooxConversion.cpp:97 lobby/GlooxConversion.cpp:133
msgid "Unknown error"
msgstr "Okänt fel"

#: lobby/GlooxConversion.cpp:110
msgid "Stream error"
msgstr "Strömningsfel"

#: lobby/GlooxConversion.cpp:111
msgid "The incoming stream version is unsupported"
msgstr "Versionen av den inkommande strömmen stöds inte"

#: lobby/GlooxConversion.cpp:112
msgid "The stream has been closed by the server"
msgstr "Servern har stängt strömmen"

#: lobby/GlooxConversion.cpp:117
msgid "An I/O error occurred"
msgstr "Ett I/O fel har inträffat"

#: lobby/GlooxConversion.cpp:119
msgid "The connection was refused by the server"
msgstr "Servern nekade anslutningen"

#: lobby/GlooxConversion.cpp:120
msgid "Resolving the server's hostname failed"
msgstr "Kunde inte slå upp serverns värdnamn"

#: lobby/GlooxConversion.cpp:121
msgid "This system is out of memory"
msgstr "Systemet har slut på minne"

#: lobby/GlooxConversion.cpp:124
msgid "handshake did not complete successfully"
msgstr "handskakningen färdigställdes inte helt"

#: lobby/GlooxConversion.cpp:126
msgid "The server did not offer required TLS encryption"
msgstr "Servern erbjuder inte den begärda TLS-krypteringen"

#: lobby/GlooxConversion.cpp:129
msgid "Authentication failed. Incorrect password or account does not exist"
msgstr "Autentisering misslyckades. Felaktigt lösenord eller kontot finns inte"

#: lobby/GlooxConversion.cpp:130
msgid "The user or system requested a disconnect"
msgstr "Användaren eller systemet begärde en frånkoppling"

#: lobby/GlooxConversion.cpp:131
msgid "There is no active connection"
msgstr "Det finns ingen aktiv anslutning"

#: lobby/GlooxConversion.cpp:145
msgid "Your account has been successfully registered"
msgstr "Ditt konto har registrerats"

#: lobby/GlooxConversion.cpp:146
msgid "Not all necessary information provided"
msgstr "Inte all nödvändig information angiven"

#: lobby/GlooxConversion.cpp:147
msgid "Username already exists"
msgstr "Användarnamn redan registrerat"

#: lobby/GlooxConversion.cpp:164
msgid "The certificate is not trusted."
msgstr "Certifikatet är inte betrott."

#: lobby/GlooxConversion.cpp:165
msgid "The certificate hasn't got a known issuer."
msgstr "Certifikatet har ingen känd utfärdare."

#: lobby/GlooxConversion.cpp:166
msgid "The certificate has been revoked."
msgstr "Certifikatet har återkallats."

#: lobby/GlooxConversion.cpp:167
msgid "The certificate has expired."
msgstr "Certifikatet har gått ut."

#: lobby/GlooxConversion.cpp:168
msgid "The certificate is not yet active."
msgstr "Certifikatet är inte aktivt än."

#: lobby/GlooxConversion.cpp:170
msgid "The certificate has not been issued for the peer connected to."
msgstr "Certifikatet har inte utfärdats för denna motpart att ansluta till."

#: lobby/GlooxConversion.cpp:172
msgid "The certificate signer is not a certificate authority."
msgstr "Certifikatets signerare är ingen giltig certifikatutfärdare."

#: lobby/XmppClient.cpp:1168
msgid "unknown subtype (see logs)"
msgstr "okänd subtyp (se loggar)"

#: ps/ModIo.cpp:290
#, c-format
msgid "Failure while starting querying for game id. Error: %s; %s."
msgstr "Fel vid början av förfrågan om spel-id. Fel: %s; %s."

#: ps/ModIo.cpp:320
#, c-format
msgid "Failure while starting querying for mods. Error: %s; %s."
msgstr "Fel vid början av förfrågan om mods. Fel: %s; %s."

#: ps/ModIo.cpp:346
#, c-format
msgid "Could not create mod directory: %s."
msgstr "Kunde inte skapa mod-katalog: %s."

#: ps/ModIo.cpp:371
#, c-format
msgid "Could not open temporary file for mod download: %s."
msgstr "Kunde inte öppna temporär fil för mod-hämtning: %s."

#: ps/ModIo.cpp:381
#, c-format
msgid "Failed to start the download. Error: %s; %s."
msgstr "Det gick inte att starta hämtningen: Fel %s; %s."

#: ps/ModIo.cpp:426
#, c-format
msgid "Asynchronous download failure: %s, %s."
msgstr "Asynkron hämtning misslyckades: %s, %s."

#: ps/ModIo.cpp:454
#, c-format
msgid "Download failure. Server response: %s; %s."
msgstr "Hämtningsfel. Serversvar: %s; %s."

#: ps/ModIo.cpp:560
msgid "Mismatched filesize."
msgstr "Felaktig filstorlek."

#: ps/ModIo.cpp:578
#, c-format
msgid "Invalid file. Expected md5 %s, got %s."
msgstr "Ogiltig fil. Förväntade md5 %s, fick %s."

#: ps/ModIo.cpp:593
msgid "Failed to compute final hash."
msgstr "Kunde inte beräkna slutgiltig kontrollsumma."

#: ps/ModIo.cpp:599
msgid "Failed to verify signature."
msgstr "Kunde inte verifiera signatur."

#: ps/scripting/JSInterface_Debug.cpp:93
msgid "custom build"
msgstr "egenbyggd"

#: renderer/Renderer.cpp:710 renderer/Renderer.cpp:835
#, c-format
msgid "Screenshot written to '%s'"
msgstr "Skärmdump sparad till '%s'"
