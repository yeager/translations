msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:296f258160f04dd4689f2836ccd1b53d"
msgid "Login {0} with username and password"
msgstr "Logga in {0} med användarnamn och lösenord"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:a8ddc88b07fa08e03c4a3c3263e11578"
msgid "No login credentials could be found in the Keychain"
msgstr "Inga inloggningsuppgifter kunde hittas i nyckelringen"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:998178fe0e4e2a1e888bb8fa48da627e"
msgid "The use of the Keychain is disabled in the Preferences"
msgstr "Användning av nyckelringen är inaktiverad i Inställningar"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:993078cacbb0257018a0bc94d03259f3"
msgid "Invalid passphrase"
msgstr "Ogiltig lösenfras"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:d509f07b2a2aa3e1e6135122a38df7a4"
msgid "Private key password protected"
msgstr "Den privata nyckeln är lösenordsskyddad"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:ac477484371f0d6cc42c2dfc268b95f2"
msgid "Enter the passphrase for the private key file"
msgstr "Ange lösenfrasen för den privata nyckelfilen"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:ca590683a5c9946805c9ad31c289df25"
msgid "Login canceled"
msgstr "Inloggning avbröts"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:02e19eb26b578634e491cde222e57f4b"
msgid "Login failed"
msgstr "Inloggning misslyckades"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:42a79de032b7ece4ec98eb8bac06352f"
msgid "Login successful"
msgstr "Inloggning lyckades"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:21e635112568af0f7c1d99254ed1c755"
msgid "Select the private key in PEM or PuTTY format"
msgstr "Välj den privata nyckeln i PEM- eller PuTTY-format"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:e5e90839dbca85374eed9cbed1fab7ca"
msgid "Partial authentication success"
msgstr "Autentiseringen lyckades delvis"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:01642febd2a01e0d4562a1775b9bdd29"
msgid "Provide additional login credentials"
msgstr "Ange ytterligare inloggningsuppgifter"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:cac81c648846c9b8c3e6085a45782c7e"
msgid "Username"
msgstr "Användarnamn"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:b341a59d5636ed3d6a819137495b08a0"
msgid "Password"
msgstr "Lösenord"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:c6ce1ba48815bdf59e457a5aa7bb7c3a"
msgid "Unsecured {0} connection"
msgstr "Okrypterad {0}-anslutning"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:9af7389ab25eb5b4e86fc027f38a1fb5"
msgid "{0} will be sent in plaintext."
msgstr "{0} kommer att skickas i klartext."

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:0f43bff37b1e4c5b405f96a5c123f9bd"
msgid "Don't show again"
msgstr "Visa inte igen"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:0eb84a756a0efb96624e019ea3d9cc23"
msgid "Continue"
msgstr "Fortsätt"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:fc9a2b8188767a37879286cbb86bdf60"
msgid "Disconnect"
msgstr "Koppla från"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:7bdfe4e2244c610cc79ff2610688e045"
msgid "The server supports encrypted connections. Do you want to switch to {0}?"
msgstr "Servern stöder krypterade anslutningar. Vill du växla till {0}?"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:4a6b693c5a70df618be0d0e82894848b"
msgid "Change"
msgstr "Ändra"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:84a00c537e45ce5e6bb34939577b4848"
msgid "Paste the authentication code from your web browser"
msgstr "Klistra in autentiseringskoden från din webbläsare"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:121f238a6437364b0bb9de41a79f6a74"
msgid "Open web browser to authenticate and obtain an authorization code"
msgstr "Öppna webbläsaren för att autentisera dig och hämta en auktoriseringskod"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:e1cd7edfb3121c66e7b8dd5b4c17566f"
msgid "Authentication Code"
msgstr "Autentiseringskod"

msgctxt "o:cyberduck:p:cyberduck:r:Credentials:s:694b6675802b62135dbc1d240f142013"
msgid "Create a passphrase required to access {0}"
msgstr "Skapa en lösenfras som krävs för åtkomst till {0}"

