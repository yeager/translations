#: assets/about_dialog.rml
msgid "About NXEmu"
msgstr "Om NXEmu"

#: assets/about_dialog.rml
msgid "NXEmu is an experimental open-source Nintendo Switch emulator."
msgstr "NXEmu är en experimentell Nintendo Switch-emulator med öppen källkod."

#: assets/about_dialog.rml
msgid ""
"You are responsible for ensuring your use of this software complies with the"
" laws in your jurisdiction."
msgstr ""
"Du ansvarar för att din användning av programmet följer lagarna där du "
"befinner dig."

#: assets/about_dialog.rml
msgid "With thanks to"
msgstr "Tack till"

#: assets/about_dialog.rml
msgid "the yuzu project, Fabrice, Alexwpi, Stardust, and NullVector"
msgstr "yuzu-projektet, Fabrice, Alexwpi, Stardust och NullVector"

#: assets/about_dialog.rml
msgid "Website"
msgstr "Webbplats"

#: assets/about_dialog.rml
msgid "Source Code"
msgstr "Källkod"

#: assets/about_dialog.rml
msgid ""
"\"Nintendo Switch\" is a trademark of Nintendo. NXEmu is not affiliated with"
" Nintendo in any way."
msgstr ""
"”Nintendo Switch” är ett varumärke som tillhör Nintendo. NXEmu har ingen "
"anknytning till Nintendo."

#: assets/about_dialog.rml
msgid "OK"
msgstr "OK"

#: assets/advanced_dialog.rml assets/directories_dialog.rml
#: assets/general_dialog.rml assets/main_window.rml assets/profiles_dialog.rml
#: views/hotkeys.h
msgid "Settings"
msgstr "Inställningar"

#: assets/advanced_dialog.rml assets/directories_dialog.rml
#: assets/general_dialog.rml assets/profiles_dialog.rml
msgid "General"
msgstr "Allmänt"

#: assets/advanced_dialog.rml assets/directories_dialog.rml
#: assets/general_dialog.rml assets/profiles_dialog.rml
msgid "Profiles"
msgstr "Profiler"

#: assets/advanced_dialog.rml assets/directories_dialog.rml
#: assets/general_dialog.rml assets/profiles_dialog.rml
msgid "Game directories"
msgstr "Spelmappar"

#: assets/advanced_dialog.rml assets/directories_dialog.rml
#: assets/general_dialog.rml assets/profiles_dialog.rml
msgid "Advanced"
msgstr "Avancerat"

#: assets/advanced_dialog.rml assets/directories_dialog.rml
#: assets/general_dialog.rml assets/profiles_dialog.rml
msgid "Debug"
msgstr "Felsök"

#: assets/advanced_dialog.rml
msgid "Graphics"
msgstr "Grafik"

#: assets/advanced_dialog.rml
msgid "System"
msgstr "System"

#: assets/advanced_dialog.rml
msgid "Application"
msgstr "Program"

#: assets/advanced_dialog.rml
msgid "Shortcuts"
msgstr "Genvägar"

#: assets/advanced_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops."
msgstr ""
"Ett spel körs. Inställningar som är nedtonade kan inte ändras förrän spelet "
"har avslutats."

#: assets/advanced_dialog.rml
msgid "Picture"
msgstr "Bild"

#: assets/advanced_dialog.rml
msgid "Anti-aliasing"
msgstr "Kantutjämning"

#: assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "Jämnar ut taggiga kanter."

#: assets/advanced_dialog.rml
msgid "Anisotropic filtering"
msgstr "Anisotropisk filtrering"

#: assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "Håller texturer skarpa när de ses från sned vinkel."

#: assets/advanced_dialog.rml
msgid "Accuracy"
msgstr "Noggrannhet"

#: assets/advanced_dialog.rml
msgid "Accuracy level"
msgstr "Noggrannhetsnivå"

#: assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "Hur nära grafikchippet efterliknas."

#: assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "Videor i egen hastighet"

#: assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "Även när hastigheten inte är begränsad."

#: assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "Texturer och video"

#: assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "ASTC-omkomprimering"

#: assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "Använder mindre grafikminne men ger sämre bildkvalitet."

#: assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "Grafikminne"

#: assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "Hur mycket grafikminne spel får använda."

#: assets/advanced_dialog.rml
msgid "Shaders"
msgstr "Shaderprogram"

#: assets/advanced_dialog.rml
msgid "Keep shaders on the disk"
msgstr "Behåll shaderprogram på disken"

#: assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "Spel hackar mindre från och med andra starten."

#: assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "Stäng endast av för felsökning."

#: assets/advanced_dialog.rml
msgid "Build shaders in the background"
msgstr "Bygg shaderprogram i bakgrunden"

#: assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "Mindre hackande, men saker kan visas för sent. En tillfällig lösning."

#: assets/advanced_dialog.rml
msgid "Performance"
msgstr "Prestanda"

#: assets/advanced_dialog.rml
msgid "Keep the graphics device busy"
msgstr "Håll grafikenheten aktiv"

#: assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "Förhindrar att den sänker klockfrekvensen. Använder mer ström."

#: assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "Processor och minne"

#: assets/advanced_dialog.rml
msgid "Console memory"
msgstr "Konsolminne"

#: assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "Mer än konsolen har, för resurskrävande moddar."

#: assets/advanced_dialog.rml
msgid "Emulation"
msgstr "Emulering"

#: assets/advanced_dialog.rml views/hotkeys.h
msgid "Limit speed"
msgstr "Begränsa hastigheten"

#: assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "Av: så snabbt som datorn klarar."

#: assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr ""
"På: spel körs med den valda hastigheten. 100 % motsvarar konsolens "
"hastighet."

#: assets/advanced_dialog.rml
msgid "Audio"
msgstr "Ljud"

#: assets/advanced_dialog.rml
msgid "Output device"
msgstr "Utmatningsenhet"

#: assets/advanced_dialog.rml
msgid "Where the sound of games is played."
msgstr "Var spelljudet spelas upp."

#: assets/advanced_dialog.rml
msgid "Output mode"
msgstr "Utmatningsläge"

#: assets/advanced_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "Surroundljud kräver högtalare som stöder det."

#: assets/advanced_dialog.rml
msgid "Output engine"
msgstr "Utmatningsmotor"

#: assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "Det som spelar upp ljudet på den här datorn."

#: assets/advanced_dialog.rml assets/controller_dialog.rml
msgid "Input device"
msgstr "Inmatningsenhet"

#: assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "Mikrofonen som spel lyssnar på."

#: assets/advanced_dialog.rml assets/controller_dialog.rml
#: assets/main_window.rml views/hotkeys.h views/main_window.cpp
msgid "Controllers"
msgstr "Kontroller"

#: assets/advanced_dialog.rml assets/controller_dialog.rml
msgid "Vibration"
msgstr "Vibration"

#: assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "För varje spelare. Var och en har en egen omkopplare."

#: assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "Beteende"

#: assets/advanced_dialog.rml views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "Starta spel i helskärm"

#: assets/advanced_dialog.rml views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "Starta spel med gränssnittet dolt"

#: assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "Bekräfta före stopp"

#: assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "Frågar innan ett spel som körs stoppas."

#: assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "Närvaro i Discord"

#: assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Visar vad du spelar i Discord när Discord körs."

#: assets/advanced_dialog.rml
msgid "Emulation diagnostics"
msgstr "Emuleringsdiagnostik"

#: assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "Processormotor"

#: assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "Hur spelets kod körs."

#: assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "Processorns noggrannhet"

#: assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "För motorn som översätter koden."

#: assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "Drivrutinens pipelinecache"

#: assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "Shaderprogram läses in snabbare med vissa drivrutiner."

#: assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "Minnesläsning"

#: assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "Hur noggrant chippet läser det som spel skriver."

#: assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "Kommandosynkronisering"

#: assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "Behåller den ordning som spel skickar sina kommandon i."

#: assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr ""
"Långsammare och stabilare. När det är avstängt kan vissa spel visa fel, "
"hänga sig eller krascha."

#: assets/advanced_dialog.rml
msgid "Reactive flushing"
msgstr "Reaktiv tömning"

#: assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "Uppdaterar minnet när det läses."

#: assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "Mer exakt än att i förväg gissa när det kommer att läsas."

#: assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "Återkopplingsloopar för barriärer"

#: assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "Ritar genomskinliga föremål korrekt i vissa spel."

#: assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "Snabb GPU-tid"

#: assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "De flesta spel ritas då med sin högsta upplösning."

#: assets/advanced_dialog.rml
msgid ""
"Games that lower their resolution when the chip is slow are told it is fast."
msgstr ""
"Spel som sänker upplösningen när chippet är långsamt får besked om att det "
"är snabbt."

#: assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "ASTC-avkodning"

#: assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "Det som avkodar texturer av den här typen."

#: assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "Videoavkodning"

#: assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "Det som avkodar spelens videor."

#: assets/advanced_dialog.rml
msgid "Threads and input"
msgstr "Trådar och inmatning"

#: assets/advanced_dialog.rml
msgid "Graphics on their own thread"
msgstr "Grafik på en egen tråd"

#: assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "Bör vara aktiverat."

#: assets/advanced_dialog.rml
msgid "Presentation on its own thread"
msgstr "Presentation på en egen tråd"

#: assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "Lite snabbare på vissa datorer."

#: assets/advanced_dialog.rml
msgid "Multicore"
msgstr "Flera kärnor"

#: assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "Konsolens kärnor på lika många trådar."

#: assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr ""
"Av: spel körs på en tråd. Det är mycket långsammare och avsett för "
"felsökning."

#: assets/advanced_dialog.rml
msgid "CPU and system in step"
msgstr "Synkronisera processor och system"

#: assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "Behåller ordningen på processorns och systemets svar."

#: assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "Kräver flera kärnor."

#: assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "Noggrann vibration"

#: assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "Varje ändring skickas, vilket kan göra att vissa kontroller fördröjs."

#: assets/advanced_dialog.rml
msgid "Log"
msgstr "Logg"

#: assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "Visa loggkonsolen"

#: assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "Loggen skrivs också medan händelserna inträffar."

#: assets/advanced_dialog.rml
msgid "Log filter"
msgstr "Loggfilter"

#: assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "Vad som skrivs, angivet som klass:nivå."

#: assets/advanced_dialog.rml
msgid ""
"Click a shortcut, then press the keys or hold and release the gamepad "
"buttons. To clear it, use the cross beside it, or click it and press Delete."
msgstr ""
"Klicka på en genväg och tryck sedan på tangenterna eller håll ned och släpp "
"knapparna på spelkontrollen. Rensa den med krysset intill eller klicka på "
"den och tryck på Delete."

#: assets/advanced_dialog.rml
msgid "In game"
msgstr "I spel"

#: assets/advanced_dialog.rml assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "Återställ standardvärden"

#: assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "Ärv alla inställningar"

#: assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "Återställ standardvärdena på alla flikar?"

#: assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr ""
"Ta bort dina åsidosättningar och aktivera NXEmus inställningar för det här "
"spelet igen?"

#: assets/advanced_dialog.rml assets/profiles_dialog.rml
msgid "Keep"
msgstr "Behåll"

#: assets/advanced_dialog.rml
msgid "Restore"
msgstr "Återställ"

#: assets/advanced_dialog.rml assets/directories_dialog.rml
#: assets/firmware_dialog.rml assets/general_dialog.rml assets/main_window.rml
#: assets/profiles_dialog.rml views/firmware_dialog.cpp
msgid "Close"
msgstr "Stäng"

#: assets/controller_dialog.rml
msgid "On, games see this player's controller as plugged into the console."
msgstr "På: spel uppfattar spelarens kontroll som ansluten till konsolen."

#: assets/controller_dialog.rml
msgid "Connected"
msgstr "Ansluten"

#: assets/controller_dialog.rml
msgid "Controller"
msgstr "Kontroll"

#: assets/controller_dialog.rml views/controller_dialog.cpp
msgid "Left stick"
msgstr "Vänster spak"

#: assets/controller_dialog.rml
msgid "Deadzone"
msgstr "Dödläge"

#: assets/controller_dialog.rml
msgid "Range"
msgstr "Intervall"

#: assets/controller_dialog.rml
msgid "Modifier range"
msgstr "Modifierarens intervall"

#: assets/controller_dialog.rml
msgid "D-pad"
msgstr "Styrkors"

#: assets/controller_dialog.rml
msgid "On, the controller shakes when games ask it to."
msgstr "På: kontrollen vibrerar när spel begär det."

#: assets/controller_dialog.rml
msgid "Face buttons"
msgstr "Framsidans knappar"

#: assets/controller_dialog.rml views/controller_dialog.cpp
msgid "Right stick"
msgstr "Höger spak"

#: assets/controller_dialog.rml
msgid "Asks for each control in turn"
msgstr "Frågar efter varje styrfunktion i tur och ordning"

#: assets/controller_dialog.rml
msgid "Bind all controls"
msgstr "Tilldela alla styrfunktioner"

#: assets/controller_dialog.rml
msgid "Binds this player's controls as the input device suggests"
msgstr "Tilldelar spelarens styrfunktioner enligt inmatningsenhetens förslag"

#: assets/controller_dialog.rml assets/firmware_dialog.rml
msgid "Cancel"
msgstr "Avbryt"

#: assets/controller_dialog.rml
msgid "Save"
msgstr "Spara"

#: assets/directories_dialog.rml
msgid ""
"Add the directories your games are in. Updates, DLC and mods in the same "
"directories are matched to their games automatically. Turn on Scan "
"subfolders to also look in the folders inside a directory."
msgstr ""
"Lägg till mapparna där dina spel finns. Uppdateringar, DLC och moddar i "
"samma mappar kopplas automatiskt till sina spel. Aktivera Sök i undermappar "
"för att även söka i mapparnas undermappar."

#: assets/directories_dialog.rml
msgid "Add a directory"
msgstr "Lägg till en mapp"

#: assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "Spelmapparna kan inte ändras medan ett spel körs."

#: assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "Installera fast programvara"

#: assets/firmware_dialog.rml
msgid "Source"
msgstr "Källa"

#: assets/firmware_dialog.rml
msgid "Install"
msgstr "Installera"

#: assets/firmware_dialog.rml
msgid "Finish"
msgstr "Slutför"

#: assets/firmware_dialog.rml
msgid "Where is the firmware?"
msgstr "Var finns den fasta programvaran?"

#: assets/firmware_dialog.rml
msgid ""
"Most games need the console's firmware. Choose the package to install it "
"from, or drop it on this window."
msgstr ""
"De flesta spel behöver konsolens fasta programvara. Välj paketet som den ska"
" installeras från eller släpp det i det här fönstret."

#: assets/firmware_dialog.rml
msgid "Firmware file"
msgstr "Fil med fast programvara"

#: assets/firmware_dialog.rml
msgid "A .zip archive, or a .dxci game card image that carries an update"
msgstr ""
"Ett .zip-arkiv eller en .dxci-spelkortsavbildning som innehåller en "
"uppdatering"

#: assets/firmware_dialog.rml
msgid "Browse"
msgstr "Bläddra"

#: assets/firmware_dialog.rml
msgid "Firmware folder"
msgstr "Mapp med fast programvara"

#: assets/firmware_dialog.rml
msgid "A folder that holds the firmware's .nca files"
msgstr "En mapp som innehåller den fasta programvarans .nca-filer"

#: assets/firmware_dialog.rml
msgid "The game starts afterwards, and without it if you would rather not."
msgstr ""
"Spelet startar därefter, även utan den fasta programvaran om du föredrar "
"det."

#: assets/firmware_dialog.rml
msgid "The installed firmware stays in place until the new one is complete."
msgstr ""
"Den installerade fasta programvaran finns kvar tills den nya installationen "
"är klar."

#: assets/firmware_dialog.rml
msgid "Replace the installed firmware?"
msgstr "Ersätt den installerade fasta programvaran?"

#: assets/firmware_dialog.rml
msgid "Start without it"
msgstr "Starta utan den"

#: assets/firmware_dialog.rml
msgid "Keep the installed one"
msgstr "Behåll den installerade"

#: assets/firmware_dialog.rml
msgid "Replace"
msgstr "Ersätt"

#: assets/firmware_dialog.rml
msgid "Choose another source"
msgstr "Välj en annan källa"

#: assets/general_dialog.rml
msgid "Display"
msgstr "Visning"

#: assets/general_dialog.rml
msgid "Interface theme"
msgstr "Gränssnittstema"

#: assets/general_dialog.rml
msgid "Use the system appearance, or choose a light or dark theme."
msgstr "Använd systemets utseende eller välj ett ljust eller mörkt tema."

#: assets/general_dialog.rml views/advanced_dialog.cpp
msgid "Graphics device"
msgstr "Grafikenhet"

#: assets/general_dialog.rml
msgid "Console mode"
msgstr "Konsolläge"

#: assets/general_dialog.rml
msgid "As on the television: games draw up to 1080p."
msgstr "Som på en tv: spel ritas med upp till 1080p."

#: assets/general_dialog.rml views/main_window.cpp
msgid "Docked"
msgstr "Dockad"

#: assets/general_dialog.rml
msgid ""
"As on the console's own screen: games draw 720p, which asks less of the "
"computer."
msgstr ""
"Som på konsolens egen skärm: spel ritas med 720p, vilket ställer lägre krav "
"på datorn."

#: assets/general_dialog.rml views/controller_dialog.cpp views/main_window.cpp
msgid "Handheld"
msgstr "Handhållen"

#: assets/general_dialog.rml
msgid "Resolution"
msgstr "Upplösning"

#: assets/general_dialog.rml
msgid "Window filter"
msgstr "Fönsterfilter"

#: assets/general_dialog.rml
msgid "How the picture is fitted to the window."
msgstr "Hur bilden anpassas till fönstret."

#: assets/general_dialog.rml views/main_window.cpp
msgid "Sharpness of the FSR filter"
msgstr "Skärpa för FSR-filtret"

#: assets/general_dialog.rml
msgid "Aspect ratio"
msgstr "Bildförhållande"

#: assets/general_dialog.rml
msgid "The shape of the picture in the window."
msgstr "Bildens form i fönstret."

#: assets/general_dialog.rml
msgid "Vertical sync"
msgstr "Vertikal synkronisering"

#: assets/general_dialog.rml
msgid "Whole pictures only: no tearing."
msgstr "Endast hela bildrutor, utan bildbristning."

#: assets/general_dialog.rml
msgid "Profile"
msgstr "Profil"

#: assets/general_dialog.rml
msgid "Who plays, with saves of their own."
msgstr "Vem som spelar med sina egna sparfiler."

#: assets/general_dialog.rml
msgid "Add players, and change their names and pictures"
msgstr "Lägg till spelare och ändra deras namn och bilder"

#: assets/general_dialog.rml
msgid "Manage"
msgstr "Hantera"

#: assets/general_dialog.rml
msgid "Language"
msgstr "Språk"

#: assets/general_dialog.rml
msgid "Console language"
msgstr "Konsolspråk"

#: assets/general_dialog.rml
msgid "The language games are shown in."
msgstr "Språket som spel visas på."

#: assets/general_dialog.rml
msgid "Region"
msgstr "Region"

#: assets/general_dialog.rml
msgid ""
"On, the region is the one chosen here. Off, it follows the console language."
msgstr ""
"På: regionen som valts här används. Av: regionen följer konsolspråket."

#: assets/general_dialog.rml
msgid "Interface language"
msgstr "Gränssnittsspråk"

#: assets/general_dialog.rml
msgid ""
"On, the interface language is chosen here. Off, it follows the console "
"language."
msgstr "På: gränssnittsspråket väljs här. Av: det följer konsolspråket."

#: assets/general_dialog.rml
msgid ""
"A game is running: what is greyed out cannot change until it stops, and "
"languages are read when a game starts."
msgstr ""
"Ett spel körs. Nedtonade inställningar kan inte ändras förrän spelet har "
"avslutats och språk läses in när ett spel startar."

#: assets/main_window.rml views/main_window.cpp
msgid "Restart"
msgstr "Starta om"

#: assets/main_window.rml views/main_window.cpp
msgid "Pause emulation (F2)"
msgstr "Pausa emuleringen (F2)"

#: assets/main_window.rml
msgid "Stop emulation (F5)"
msgstr "Stoppa emuleringen (F5)"

#: assets/main_window.rml
msgid "Minimise"
msgstr "Minimera"

#: assets/main_window.rml
msgid "Maximise or restore"
msgstr "Maximera eller återställ"

#: assets/main_window.rml
msgid "Library"
msgstr "Bibliotek"

#: assets/main_window.rml
msgid "Search games..."
