msgstr "Vanliga frågor om Mullvad Browser"

#: content/mullvad-browser/faqs/contents.lr:section.title
#: https://support.torproject.org/mullvad-browser/faqs/
msgid "Frequently Asked Questions (FAQs)"
msgstr "Vanliga frågor"

