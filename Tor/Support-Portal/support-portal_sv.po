#: https://support.torproject.org/glossary/
msgid "Atlas"
msgstr "Atlas"

#: content/glossary/contents.lr:accordion_item.title
#: https://support.torproject.org/glossary/
msgid "Captcha"
msgstr "CAPTCHA"

