#, auto-java-messageformat
msgctxt "error-invalid-multivalued-size"
msgid ""
"Attribute {0} must have at least {1} and at most {2} "
"{2,choice,0#values|1#value|1<values}."
msgstr ""
"Attribut {0} måste ha minst {1} och högst {2} "
"{2,choice,0#värden|1#värde|1<värden}."

#, auto-java-messageformat
msgctxt "error-non-ascii-local-part-email"
msgid "Local part of the address must contain only ASCII characters."
msgstr "Den lokala delen av adressen får endast innehålla ASCII-tecken."

#, auto-java-messageformat
msgctxt "workflowSingleRestartStepOnly"
msgid "Workflow can have only one restart step."
msgstr "Arbetsflödet kan bara ha ett omstartssteg."

#, auto-java-messageformat
msgctxt "workflowRestartStepMustBeLast"
msgid "Workflow restart step must be the last step."
msgstr "Arbetsflödets omstartssteg måste vara det sista steget."

#, auto-java-messageformat
msgctxt "workflowRestartStepInvalidPosition"
msgid "Workflow restart step has invalid position: {0}."
msgstr "Arbetsflödets omstartssteg har en ogiltig position: {0}."

#, auto-java-messageformat
msgctxt "workflowNoScheduledStepAtPosition"
msgid "No scheduled step found if restarting at position {0}."
msgstr "Inget schemalagt steg hittades vid omstart på position {0}."

#, auto-java-messageformat
msgctxt "workflowInvalidType"
msgid "Invalid workflow type: {0}."
msgstr "Ogiltig typ av arbetsflöde: {0}."

#, auto-java-messageformat
msgctxt "workflowConditionTypesIncompatible"
msgid ""
"Provided condition types ({0}) are not compatible with workflow type ({1})."
msgstr ""
"De angivna villkorstyperna ({0}) är inte kompatibla med arbetsflödestypen ("
"{1})."

#, auto-java-messageformat
msgctxt "workflowStepUsesRequired"
msgid "Step ''uses'' cannot be null or empty."
msgstr "Steget ''uses'' får inte vara null eller tomt."

#, auto-java-messageformat
msgctxt "workflowStepAfterNegative"
msgid "Step ''after'' configuration cannot be negative."
msgstr "Konfigurationen ''after'' för steget får inte vara negativ."

#, auto-java-messageformat
msgctxt "workflowStepAfterInvalid"
msgid "Step ''after'' configuration is not valid: {0}."
msgstr "Konfigurationen ''after'' för steget är ogiltig: {0}."

#, auto-java-messageformat
msgctxt "workflowStepProviderNotFound"
msgid "Could not find step provider: {0}."
msgstr "Det gick inte att hitta stegleverantören: {0}."

#, auto-java-messageformat
msgctxt "workflowNameEmpty"
msgid "Workflow name cannot be null or empty."
msgstr "Arbetsflödets namn får inte vara null eller tomt."

#, auto-java-messageformat
msgctxt "workflowNameDuplicate"
msgid ""
"Workflow name must be unique. A workflow with name ''{0}'' already exists."
msgstr ""
"Arbetsflödets namn måste vara unikt. Det finns redan ett arbetsflöde med "
"namnet ''{0}''."

#, auto-java-messageformat
msgctxt "workflowCannotUpdateOnWithScheduled"
msgid ""
"Cannot update ''on'' configuration when there are scheduled resources for "
"the workflow."
msgstr ""
"Det går inte att uppdatera konfigurationen ''on'' när arbetsflödet har "
"schemalagda resurser."

#, auto-java-messageformat
msgctxt "workflowCannotUpdateSupports"
msgid "Cannot update ''supports'' configuration."
msgstr "Det går inte att uppdatera konfigurationen ''supports''."

#, auto-java-messageformat
msgctxt "workflowCannotChangeStepsWithScheduled"
msgid ""
"Cannot change the number or order of steps when there are scheduled "
"resources for the workflow."
msgstr ""
"Det går inte att ändra antalet eller ordningen på steg när arbetsflödet har "
"schemalagda resurser."

#, auto-java-messageformat
msgctxt "workflowMigrateDifferentTypes"
msgid ""
"Cannot migrate scheduled resources between workflows that support different "
"resource types."
msgstr ""
"Det går inte att migrera schemalagda resurser mellan arbetsflöden som stöder "
"olika resursstyper."

#, auto-java-messageformat
msgctxt "workflowMigrateConditionsNotMet"
msgid ""
"Cannot migrate resource {0} to workflow {1} as it does not satisfy the "
"workflow''s activation conditions."
msgstr ""
"Det går inte att migrera resursen {0} till arbetsflödet {1} eftersom den "
"inte uppfyller arbetsflödets aktiveringsvillkor."

#, auto-java-messageformat
msgctxt "workflowResourceTypeNotSupported"
msgid ""
"Resource type ''{0}'' is not supported for this workflow (supports {1})."
msgstr "Resurstypen ''{0}'' stöds inte för det här arbetsflödet (stöder {1})."

#, auto-java-messageformat
msgctxt "workflowInvalidResource"
msgid "Not a valid workflow resource: {0}."
msgstr "Ingen giltig arbetsflödesresurs: {0}."

#, auto-java-messageformat
msgctxt "workflowStepsIncompatible"
msgid "Steps provided are not compatible with each other."
msgstr "De angivna stegen är inte kompatibla med varandra."

#, auto-java-messageformat
msgctxt "workflowStepsSingleTypeRequired"
msgid "Steps provided should support a single type, actual: {0}."
msgstr "De angivna stegen ska stödja en enda typ; aktuell typ: {0}."

#, auto-java-messageformat
msgctxt "workflowNotFoundById"
msgid "Workflow with id ''{0}'' not found."
msgstr "Arbetsflöde med id {0} hittades inte."

#, auto-java-messageformat
msgctxt "workflowResourceNotFound"
msgid "Resource with id {0} not found."
msgstr "Resurs med id {0} hittades inte."

#, auto-java-messageformat
msgctxt "workflowMigrateStepIdsRequired"
msgid "Both ''from'' and ''to'' step ids must be provided for migration."
msgstr "Steg-id:n from och to måste anges för migreringen."

#, auto-java-messageformat
msgctxt "workflowProviderFactoryNotFound"
msgid "Could not find provider factory with id: {0}."
msgstr "Det gick inte att hitta en leverantörsfabrik med id: {0}."

#, auto-java-messageformat
msgctxt "workflowConditionRoleNotSet"
msgid "Expected role name not set."
msgstr "Förväntat rollnamn har inte angetts."

#, auto-java-messageformat
msgctxt "workflowConditionRoleNotFound"
msgid "Role with name {0} does not exist."
msgstr "Rollen med namnet {0} finns inte."

#, auto-java-messageformat
msgctxt "workflowConditionGroupNotSet"
msgid "Expected group path not set."
msgstr "Förväntad gruppsökväg har inte angetts."

#, auto-java-messageformat
msgctxt "workflowConditionGroupNotFound"
msgid "Group with name {0} does not exist."
msgstr "Gruppen med namnet {0} finns inte."

#, auto-java-messageformat
msgctxt "workflowConditionIdpNotSet"
msgid "Expected identity provider alias is not set."
msgstr "Förväntat alias för identitetsleverantören har inte angetts."

#, auto-java-messageformat
msgctxt "workflowConditionIdpNotFound"
msgid "Identity provider {0} does not exist."
msgstr "Identitetsleverantören {0} finns inte."

#, auto-java-messageformat
msgctxt "workflowConditionAttributeNotSet"
msgid "Expected ''key:value'' pair is not set."
msgstr "Förväntat par key:value har inte angetts."

#, auto-java-messageformat
msgctxt "workflowConditionAttributeInvalid"
msgid "Error reading key-value pair {0}. Expected format ''key:value''."
msgstr ""
"Det gick inte att läsa nyckel/värde-paret {0}. Förväntat format är key:value."

#, auto-java-messageformat
msgctxt "workflowExpressionEmpty"
msgid "Expression cannot be null or empty."
msgstr "Uttrycket får inte vara null eller tomt."

#, auto-java-messageformat
msgctxt "workflowExpressionMaxLength"
msgid "Expression exceeds maximum allowed length of {0} characters."
msgstr "Uttrycket överskrider den högsta tillåtna längden på {0} tecken."

#, auto-java-messageformat
msgctxt "workflowExpressionMaxDepth"
msgid "Expression exceeds maximum allowed nesting depth of {0}."
msgstr "Uttrycket överskrider det högsta tillåtna kapslingsdjupet på {0}."

#, auto-java-messageformat
msgctxt "workflowExpressionInvalid"
msgid ""
"Invalid expression: {0}\n"
"Error details:\n"
"{1}"
msgstr ""
"Ogiltigt uttryck: {0}\n"
"Felinformation:\n"
"{1}"

