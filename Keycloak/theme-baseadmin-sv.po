#, auto-java-messageformat
msgctxt "invalidPasswordMinLengthMessage"
msgid "Invalid password: minimum length {0}."
msgstr "Ogiltigt lösenord: minsta längd {0}."

#, auto-java-messageformat
msgctxt "invalidPasswordMaxLengthMessage"
msgid "Invalid password: maximum length {0}."
msgstr "Ogiltigt lösenord: maximal längd {0}."

#, auto-java-messageformat
msgctxt "invalidPasswordMinLowerCaseCharsMessage"
msgid "Invalid password: must contain at least {0} lower case characters."
msgstr "Ogiltigt lösenord: måste innehålla minst {0} gemener."

#, auto-java-messageformat
msgctxt "invalidPasswordMinDigitsMessage"
msgid "Invalid password: must contain at least {0} numerical digits."
msgstr "Ogiltigt lösenord: måste innehålla minst {0} siffror."

#, auto-java-messageformat
msgctxt "invalidPasswordMinUpperCaseCharsMessage"
msgid "Invalid password: must contain at least {0} upper case characters."
msgstr "Ogiltigt lösenord: måste innehålla minst {0} versaler."

#, auto-java-messageformat
msgctxt "invalidPasswordMinSpecialCharsMessage"
msgid "Invalid password: must contain at least {0} special characters."
msgstr "Ogiltigt lösenord: måste innehålla minst {0} specialtecken."

#, auto-java-messageformat
msgctxt "invalidPasswordNotUsernameMessage"
msgid "Invalid password: must not be equal to the username."
msgstr "Ogiltigt lösenord: får inte vara samma som användarnamnet."

#, auto-java-messageformat
msgctxt "invalidPasswordNotContainsUsernameMessage"
msgid "Invalid password: Can not contain the username."
msgstr "Ogiltigt lösenord: kan inte innehålla användarnamnet."

#, auto-java-messageformat
msgctxt "invalidPasswordNotEmailMessage"
msgid "Invalid password: must not be equal to the email."
msgstr "Ogiltigt lösenord: får inte vara samma som e-postadressen."

#, auto-java-messageformat
msgctxt "invalidPasswordRegexPatternMessage"
msgid "Invalid password: fails to match regex pattern(s)."
msgstr "Ogiltigt lösenord: matchar inte regex-mönstret."

#, auto-java-messageformat
msgctxt "invalidPasswordHistoryMessage"
msgid "Invalid password: must not be equal to any of last {0} passwords."
msgstr ""
"Ogiltigt lösenord: får inte vara samma som något av de senaste {0} "
"lösenorden."

#, auto-java-messageformat
msgctxt "invalidPasswordBlacklistedMessage"
msgid "Invalid password: password is not allowed."
msgstr "Ogiltigt lösenord: lösenordet finns på svartlistan."

#, auto-java-messageformat
msgctxt "invalidPasswordGenericMessage"
msgid "Invalid password: new password does not match password policies."
msgstr "Ogiltigt lösenord: det nya lösenordet uppfyller inte lösenordspolicyn."

#, auto-java-messageformat
msgctxt "ldapErrorEditModeMandatory"
msgid "Edit Mode is mandatory"
msgstr "Redigeringsläge är obligatoriskt"

#, auto-java-messageformat
msgctxt "ldapErrorInvalidCustomFilter"
msgid ""
"Custom configured LDAP filter does not start with \"(\" or does not end with "
"\")\"."
msgstr ""
"Anpassat konfigurerat LDAP-filter börjar inte med \"(\" eller slutar inte "
"med \")\"."

#, auto-java-messageformat
msgctxt "ldapErrorConnectionTimeoutNotNumber"
msgid "Connection Timeout must be a number"
msgstr "Anslutningstimeout måste vara ett tal"

#, auto-java-messageformat
msgctxt "ldapErrorReadTimeoutNotNumber"
msgid "Read Timeout must be a number"
msgstr "Lästimeout måste vara ett tal"

#, auto-java-messageformat
msgctxt "ldapErrorMissingClientId"
msgid ""
"Client ID needs to be provided in config when Realm Roles Mapping is not "
"used."
msgstr ""
"Klient-ID måste anges i konfigurationen när Realm Roles Mapping inte används."

#, auto-java-messageformat
msgctxt "ldapErrorCantPreserveGroupInheritanceWithUIDMembershipType"
msgid ""
"Not possible to preserve group inheritance and use UID membership type "
"together."
msgstr ""
"Det är inte möjligt att bevara grupparv och använda UID-medlemskapstyp "
"samtidigt."

#, auto-java-messageformat
msgctxt "ldapErrorCantWriteOnlyForReadOnlyLdap"
msgid "Can not set write only when LDAP provider mode is not WRITABLE"
msgstr "Kan inte sätta write-only när LDAP-leverantörläget inte är WRITABLE"

#, auto-java-messageformat
msgctxt "ldapErrorCantWriteOnlyAndReadOnly"
msgid "Can not set write-only and read-only together"
msgstr "Kan inte sätta både write-only och read-only samtidigt"

#, auto-java-messageformat
msgctxt "ldapErrorCantEnableStartTlsAndConnectionPooling"
msgid "Can not enable both StartTLS and connection pooling."
msgstr "Kan inte aktivera både StartTLS och connection pooling."

#, auto-java-messageformat
msgctxt "ldapErrorCantEnableUnsyncedAndImportOff"
msgid "Can not disable Importing users when LDAP provider mode is UNSYNCED"
msgstr ""
"Kan inte inaktivera import av användare när LDAP-leverantörläget är UNSYNCED"

#, auto-java-messageformat
msgctxt "ldapErrorMissingGroupsPathGroup"
msgid ""
"Groups path group does not exist - please create the group on specified path "
"first"
msgstr ""
"Gruppsökvägsgrupp existerar inte - skapa gruppen på angiven sökväg först"

#, auto-java-messageformat
msgctxt "ldapErrorValidatePasswordPolicyAvailableForWritableOnly"
msgid "Validate Password Policy is applicable only with WRITABLE edit mode"
msgstr ""
"Validera lösenordspolicy är endast tillämplig med WRITABLE-redigeringsläge"

#, auto-java-messageformat
msgctxt "ldapErrorConnectionUrlContainsComma"
msgid ""
"Connection URL must not contain commas. Use spaces to separate multiple LDAP "
"URLs (e.g. \"ldap://host1:389 ldap://host2:389\")."
msgstr ""
"Anslutnings-URL:en får inte innehålla kommatecken. Använd mellanslag för att "
"separera flera LDAP-URL:er (t.ex. \"ldap://host1:389 ldap://host2:389\")."

#, auto-java-messageformat
msgctxt "ldapErrorInvalidConnectionUrl"
msgid "Connection URL contains an invalid LDAP URL."
msgstr "Anslutnings-URL:en innehåller en ogiltig LDAP-URL."

#, auto-java-messageformat
msgctxt "ldapErrorInvalidConnectionUrlScheme"
msgid ""
"Connection URL contains a URL with an unsupported scheme. Each URL must use "
"the ldap:// or ldaps:// scheme."
msgstr ""
"Anslutnings-URL:en innehåller en URL med ett schema som inte stöds. Varje "
"URL måste använda schemat ldap:// eller ldaps://."

#, auto-java-messageformat
msgctxt "clientRedirectURIsFragmentError"
msgid "A redirect URI must not contain an URL fragment"
msgstr "Omdirigerings-URI:er får inte innehålla ett URI-fragment"

#, auto-java-messageformat
msgctxt "clientPostLogoutRedirectURIsFragmentError"
msgid "A post-logout redirect URI must not contain an URL fragment"
msgstr ""
"En omdirigerings-URI efter utloggning får inte innehålla ett URI-fragment"

#, auto-java-messageformat
msgctxt "clientRootURLFragmentError"
msgid "Root URL must not contain an URL fragment"
msgstr "Rot-URL får inte innehålla ett URL-fragment"

#, auto-java-messageformat
msgctxt "clientRootURLIllegalSchemeError"
msgid "Root URL uses an illegal scheme"
msgstr "Rot-URL använder ett otillåtet schema"

# Suggested in Weblate: Grundläggande URL använder ett otillåtet schema
#, auto-java-messageformat
msgctxt "clientBaseURLIllegalSchemeError"
msgid "Base URL uses an illegal scheme"
msgstr "Bas-URL använder ett otillåtet schema"

#, auto-java-messageformat
msgctxt "backchannelLogoutUrlIllegalSchemeError"
msgid "Backchannel logout URL uses an illegal scheme"
msgstr "Backchannel-utloggnings-URL använder ett otillåtet schema"

#, auto-java-messageformat
msgctxt "clientRedirectURIsIllegalSchemeError"
msgid "A redirect URI uses an illegal scheme"
msgstr "En omdirigerings-URI använder ett otillåtet schema"

#, auto-java-messageformat
msgctxt "clientPostLogoutRedirectURIsIllegalSchemeError"
msgid "A post-logout redirect URI uses an illegal scheme"
msgstr "En omdirigerings-URI efter utloggning använder ett otillåtet schema"

# Suggested in Weblate: Grundläggande URL är inte en giltig URL
#, auto-java-messageformat
msgctxt "clientBaseURLInvalid"
msgid "Base URL is not a valid URL"
msgstr "Bas-URL är inte en giltig URL"

#, auto-java-messageformat
msgctxt "clientRootURLInvalid"
msgid "Root URL is not a valid URL"
msgstr "Rot-URL är inte en giltig URL"

#, auto-java-messageformat
msgctxt "clientRedirectURIsInvalid"
msgid "A redirect URI is not a valid URI"
msgstr "En omdirigerings-URI är inte en giltig URI"

#, auto-java-messageformat
msgctxt "clientPostLogoutRedirectURIsInvalid"
msgid "A post-logout redirect URI is not a valid URI"
msgstr "En omdirigerings-URI efter utloggning är inte en giltig URI"

#, auto-java-messageformat
msgctxt "backchannelLogoutUrlIsInvalid"
msgid "Backchannel logout URL is not a valid URL"
msgstr "Backchannel-utloggnings-URL är inte en giltig URL"

#, auto-java-messageformat
msgctxt "pairwiseMalformedClientRedirectURI"
msgid "Client contained an invalid redirect URI."
msgstr "Klienten innehöll en ogiltig omdirigerings-URI."

#, auto-java-messageformat
msgctxt "pairwiseClientRedirectURIsMissingHost"
msgid "Client redirect URIs must contain a valid host component."
msgstr "Klientens omdirigerings-URI:er måste innehålla en giltig värdkomponent."

#, auto-java-messageformat
msgctxt "pairwiseClientRedirectURIsMultipleHosts"
msgid ""
"Without a configured Sector Identifier URI, client redirect URIs must not "
"contain multiple host components."
msgstr ""
"Utan en konfigurerad Sector Identifier URI får klientens omdirigerings-"
"URI:er inte innehålla flera värdkomponenter."

#, auto-java-messageformat
msgctxt "pairwiseMalformedSectorIdentifierURI"
msgid "Malformed Sector Identifier URI."
msgstr "Felaktig Sector Identifier URI."

#, auto-java-messageformat
msgctxt "pairwiseFailedToGetRedirectURIs"
msgid "Failed to get redirect URIs from the Sector Identifier URI."
msgstr ""
"Misslyckades med att hämta omdirigerings-URI:er från Sector Identifier URI."

#, auto-java-messageformat
msgctxt "pairwiseRedirectURIsMismatch"
msgid ""
"Client redirect URIs does not match redirect URIs fetched from the Sector "
"Identifier URI."
msgstr ""
"Klientens omdirigerings-URI:er matchar inte omdirigerings-URI:erna hämtade "
"från Sector Identifier URI."

#, auto-java-messageformat
msgctxt "duplicatedJwksSettings"
msgid ""
"The \"Use JWKS\" switch and the switch \"Use JWKS URL\" cannot be ON at the "
"same time."
msgstr ""
"Knapparna \"Använd JWKS\" och \"Använd JWKS URL\" kan inte vara PÅ samtidigt."

#.
#. Shown to an admin when they enter a client specific SSO idle timeout that fails validation
#.
#, auto-java-messageformat
msgctxt "clientIdleExceedsRealmRememberMeIdle"
msgid ""
"Client session idle timeout cannot exceed realm SSO session idle timeout and "
"RememberMe idle timeout."
msgstr ""
"Klientsessionens idle-timeout kan inte överskrida realm SSO-sessionens idle-"
"timeout och RememberMe idle-timeout."

#. Shown to an admin when they enter a client specific SSO idle timeout that fails validation
#.
#, auto-java-messageformat
msgctxt "clientSessionIdleTimeoutExceedsRealm"
msgid ""
"Client session idle timeout cannot exceed realm SSO session idle timeout."
msgstr ""
"Klientsessionens idle-timeout kan inte överskrida realm SSO-sessionens idle-"
"timeout."

#. Shown to an admin when they enter a client specific SSO max lifetime that fails validation
#.
#, auto-java-messageformat
msgctxt "clientSessionMaxLifespanExceedsRealm"
msgid ""
"Client session max lifespan cannot exceed realm SSO session max lifespan."
msgstr ""
"Klientsessionens maximala livslängd kan inte överskrida realm SSO-sessionens "
"maximala livslängd."

#. Shown to an admin when they enter a client specific SSO max lifetime that fails validation
#.
#, auto-java-messageformat
msgctxt "clientSessionMaxLifespanExceedsRealmRememberMeMaxSpan"
msgid ""
"Client session max lifespan cannot exceed realm SSO session max lifespan and "
"RememberMe Max span."
msgstr ""
"Klientsessionens maximala livslängd kan inte överskrida realm SSO-sessionens "
"maximala livslängd och RememberMe Max-spann."

