#| msgid "Please type in the slug of the project to confirm."
msgid "Please turn on reviews on the project first."
msgstr "Aktivera först granskning i projektet."

#| msgid "The given language already exists."
msgid "This language already has a project workflow."
msgstr "Språket har redan ett projektarbetsflöde."

#| msgctxt "Source language selection"
#| msgid "Secondary language defined in project or component"
msgid "Select a source language in a project workflow."
msgstr "Välj ett källspråk i ett projektarbetsflöde."

#| msgid "The user is not watching this project."
msgid "The source language must exist in this project."
msgstr "Källspråket måste finnas i projektet."

#| msgid "Source language text"
msgid "Source languages cannot form a cycle."
msgstr "Källspråk kan inte bilda en cykel."

#| msgid "The source string cannot be edited."
msgid "The source string has changed. Reload it before editing."
msgstr "Källsträngen har ändrats. Läs in den igen före redigering."

#| msgid "A team with this name already exists in this workspace."
msgid ""
"A string with this identity already exists or is awaiting a file update."
msgstr ""
"En sträng med denna identitet finns redan eller väntar på filuppdatering."

#| msgid "The file format does not support this."
msgid "The file format does not support this edit."
msgstr "Filformatet stöder inte denna redigering."

msgid "Keep the existing number of nonempty source forms."
msgstr "Behåll det befintliga antalet icke-tomma källformer."

#| msgid "A translation project was removed."
msgid "A translation key is required."
msgstr "En översättningsnyckel krävs."

#| msgid "Could not add new translation file."
msgid "Could not find the string in the translation file."
msgstr "Kunde inte hitta strängen i översättningsfilen."

#| msgid "Enforced checks"
msgid "Enforced checks has to be a list."
msgstr "Obligatoriska kontroller måste vara en lista."

#, python-format
#| msgid "Unused enforced checks."
msgid "Unsupported enforced check: %s"
msgstr "Obligatorisk kontroll stöds inte: %s"

#| msgid "Invalid listing column selection."
msgid "Invalid history position."
msgstr "Ogiltig historikposition."

#| msgid "This component is already shared in %s."
msgid "The component is busy. Please try again."
msgstr "Komponenten är upptagen. Försök igen."

#| msgid "Source string added"
msgid "Source string updated."
msgstr "Källsträngen uppdaterades."

#| msgid "The source string needs review."
msgid "The text is too long to preview."
msgstr "Texten är för lång för förhandsgranskning."

#| msgid "Too many search queries, please try again later."
msgid "Too many preview requests, try again later."
msgstr "För många förhandsgranskningsbegäranden. Försök igen senare."

#| msgid "Could not change additional string info!"
msgid "Could not change string flags!"
msgstr "Kunde inte ändra strängflaggor!"

#| msgid "Name contains disallowed characters."
msgid "Repository URL contains unsafe characters."
msgstr "Förrådets webbadress innehåller osäkra tecken."
