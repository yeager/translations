msgid "Triggering change ID, when change is available."
msgstr "ID för den utlösande ändringen, när ändringen är tillgänglig."

msgid "Numeric ActionEvents value, not the lowercase event name."
msgstr "Numeriskt ActionEvents-värde, inte händelsenamnet med gemener."

msgid "Change timestamp in ISO 8601 format with a timezone offset."
msgstr ""
"Ändringens tidsstämpel i ISO 8601-format med förskjutning för tidszon."

msgid "Recorded actor ID, when actor is available."
msgstr "ID för registrerad aktör, när aktören är tillgänglig."

msgid "Recorded actor username."
msgstr "Användarnamnet för den registrerade aktören."

msgid "Trigger identifier such as change, daily, or manual."
msgstr "Utlösaridentifierare, till exempel change, daily eller manual."

msgid ""
"Change timestamp, or scheduling time for other triggers; ISO 8601 with a "
"timezone offset."
msgstr ""
"Ändringens tidsstämpel eller schemalagd tid för andra utlösare; ISO 8601 med"
" förskjutning för tidszon."

msgid "Component local revision recorded when scheduled; null if unavailable."
msgstr ""
"Komponentens lokala revision som registrerades vid schemaläggningen; null om"
" den inte är tillgänglig."

msgid "list of integers or null"
msgstr "lista med heltal eller null"

msgid ""
"Currently a one-element list when the change references a unit; otherwise "
"null."
msgstr ""
"För närvarande en lista med ett element när ändringen refererar till en "
"enhet; annars null."

msgid "Source-unit IDs corresponding to ``trigger.unit_ids``; otherwise null."
msgstr "ID:n för källenheter som motsvarar ``trigger.unit_ids``; annars null."

#| msgid "Object"
msgid "object"
msgstr "objekt"
