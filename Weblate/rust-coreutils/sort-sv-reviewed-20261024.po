#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-about"
msgid ""
"Display sorted concatenation of all FILE(s). With no FILE, or when FILE is "
"-, read standard input."
msgstr ""
"Visar sorterad sammanfogning av alla FILE(er). Utan FILE, eller när FILE är "
"-, läs standard-in."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-usage"
