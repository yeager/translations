#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-warning-option-reverse-last-resort"
msgid "option '-r' only applies to last-resort comparison"
msgstr "flaggan ”-r” gäller bara jämförelsen som används som sista utväg"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-warning-obsolescent-key"
msgid ""
"obsolescent key '{ $key }' used; consider '-k { $replacement }' instead"
msgstr ""
"föråldrad nyckel '{ $key }' används. Överväg '-k { $replacement }' i stället"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-warning-separator-grouping"
msgid "field separator '{ $sep }' is treated as a group separator in numbers"
msgstr "fältavgränsaren '{ $sep }' behandlas som en gruppavgränsare i tal"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-warning-separator-decimal"
msgid "field separator '{ $sep }' is treated as a decimal point in numbers"
msgstr "fältavgränsaren '{ $sep }' behandlas som decimaltecken i tal"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-warning-separator-minus"
msgid "field separator '{ $sep }' is treated as a minus sign in numbers"
msgstr "fältavgränsaren '{ $sep }' behandlas som ett minustecken i tal"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-warning-separator-plus"
msgid "field separator '{ $sep }' is treated as a plus sign in numbers"
msgstr "fältavgränsaren '{ $sep }' behandlas som ett plustecken i tal"

#. Help messages
#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-help"
msgid "Print help information."
msgstr "Skriv ut hjälpinformation."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-version"
msgid "Print version information."
msgstr "Skriv ut versionsinformation."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-human-numeric"
msgid "compare according to human readable sizes, eg 1M > 100k"
msgstr "jämföra enligt mänskligt läsbara storlekar, t.ex. 1M > 100k"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-month"
msgid "compare according to month name abbreviation"
msgstr "jämför enligt månadens namnförkortning"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-numeric"
msgid "compare according to string numerical value"
msgstr "jämför enligt strängens numeriska värde"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-general-numeric"
msgid "compare according to string general numerical value"
msgstr "jämför enligt strängens allmänna numeriska värde"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-version-sort"
msgid "Sort by SemVer version number, eg 1.12.2 > 1.1.2"
msgstr "Sortera efter SemVer-versionsnummer, t.ex. 1.12.2 > 1.1.2"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-random"
msgid "shuffle in random order"
msgstr "sortera i slumpmässig ordning"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-random-source"
msgid "use FILE as a source of random data"
msgstr "använd FIL som källa till slumpdata"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-dictionary-order"
msgid "consider only blanks and alphanumeric characters"
msgstr "beakta endast mellanslag och alfanumeriska tecken"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-merge"
msgid "merge already sorted files; do not sort"
msgstr "sammanfoga redan sorterade filer; sortera inte"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-check"
msgid "check for sorted input; do not sort"
msgstr "kontrollera sorterad inmatning; sortera inte"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-check-silent"
msgid ""
"exit successfully if the given file is already sorted, and exit with status "
"1 otherwise."
msgstr ""
"Avsluta korrekt om den angivna filen redan är sorterad och avsluta annars "
"med status 1."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-ignore-case"
msgid "fold lower case to upper case characters"
msgstr "konvertera gemener till versaler"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-ignore-nonprinting"
msgid "ignore nonprinting characters"
msgstr "ignorera tecken som inte kan skrivas ut"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-ignore-leading-blanks"
msgid "ignore leading blanks when finding sort keys in each line"
msgstr ""
"ignorera inledande blanktecken vid sökning efter sorteringsnycklar på varje "
"rad"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-output"
msgid "write output to FILENAME instead of stdout"
msgstr "skriv utdata till FILENAME istället för standard-ut"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-reverse"
msgid "reverse the output"
msgstr "reversera utskriften"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-stable"
msgid "stabilize sort by disabling last-resort comparison"
msgstr "stabilisera sorteringen genom att inaktivera sista-utväg jämförelsen"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-unique"
msgid "output only the first of an equal run"
msgstr "skriv enbart ut det första vid en sekvens av lika värden"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-key"
msgid "sort by a key"
msgstr "sortera efter en nyckel"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-separator"
msgid "custom separator for -k"
msgstr "anpassad separator för -k"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-zero-terminated"
msgid "line delimiter is NUL, not newline"
msgstr "radavgränsare är NUL, inte nyrad"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-parallel"
msgid "change the number of threads running concurrently to NUM_THREADS"
msgstr "ändra antalet trådar som körs samtidigt till NUM_THREADS"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-buf-size"
msgid "sets the maximum SIZE of each segment in number of sorted items"
msgstr "anger maximal SIZE för varje segment i antal sorterade objekt"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-tmp-dir"
msgid "use DIR for temporaries, not $TMPDIR or /tmp"
msgstr "använd DIR för temporära filer, inte $TMPDIR eller /tmp"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-compress-prog"
msgid ""
"compress temporary files with PROG, decompress with PROG -d; PROG has to "
"take input from stdin and output to stdout"
msgstr ""
"komprimera temporära filer med PROG, dekomprimera med PROG -d; PROG måste ta"
" indata från standard-in och utdata till standard-ut"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-batch-size"
msgid "Merge at most N_MERGE inputs at once."
msgstr "Sammanfoga högst N_MERGE inmatningar samtidigt."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-files0-from"
msgid "read input from the files specified by NUL-terminated NUL_FILE"
msgstr "läs indata från filerna som anges av NUL-avslutad NUL_FILE"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "sort-help-debug"
msgid "underline the parts of the line that are actually used for sorting"
msgstr "understryk de delar av raden som faktiskt används för sortering"
