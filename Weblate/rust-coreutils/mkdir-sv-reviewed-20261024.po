#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-about"
msgid "Create the given DIRECTORY(ies) if they do not exist"
msgstr "Skapa angivna DIRECTORY(ies) om de inte finns"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-usage"
msgid "mkdir [OPTION]... DIRECTORY..."
msgstr "mkdir [OPTION]... DIRECTORY..."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-after-help"
msgid ""
"Each MODE is of the form [ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=]?[0-7]+."
msgstr "Varje MODE har formen [ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=]?[0-7]+."

#. Help messages
#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-help-mode"
msgid "set file mode (not implemented on windows)"
msgstr "ange filrättigheter (inte implementerat i Windows)"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-help-parents"
msgid "make parent directories as needed"
msgstr "skapa överordnade kataloger efter behov"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-help-verbose"
msgid "print a message for each created directory"
msgstr "skriv ut ett meddelande för varje skapad katalog"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-help-selinux"
msgid ""
"set SELinux security context of each created directory to the default type"
msgstr ""
"ange SELinux säkerhetskontext för varje skapad katalog till standardtypen"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-help-context"
msgid ""
"like -Z, or if CTX is specified then set the SELinux or SMACK security "
"context to CTX"
msgstr ""
"som -Z, eller om CTX anges, ange då SELinux eller SMACK säkerhetskontexten "
"till CTX"

#. Error messages
#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-error-invalid-mode"
msgid "invalid mode { $mode }"
msgstr "ogiltigt läge { $mode }"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-error-empty-directory-name"
msgid "cannot create directory '': No such file or directory"
msgstr "kan inte skapa katalogen '': Fil eller katalog saknas"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-error-failed-to-create-tree"
msgid "failed to create whole tree"
msgstr "misslyckades med att skapa hela filträdet"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-error-cannot-set-permissions"
msgid "cannot set permissions { $path }"
msgstr "kan inte ange behörigheter { $path }"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-error-cannot-create-directory"
msgid "cannot create directory { $path }"
msgstr "kan inte skapa katalogen { $path }"

#. Verbose output
#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "mkdir-verbose-created-directory"
msgid "{ $util_name }: created directory { $path }"
msgstr "{ $util_name }: skapade katalogen { $path }"
