msgctxt "Change origin tooltip"
msgid "Created by automation #%(addon_id)s (run #%(activity_id)s)."
msgstr ""
"Skapad av automatisering nr %(addon_id)s (körning nr %(activity_id)s)."

#, safe-html
msgctxt "Change origin tooltip"
msgid "Created by an automation."
msgstr "Skapad av en automatisering."

#, safe-html
msgctxt "Change origin tooltip"
msgid "Initiated through the API using an authentication token."
msgstr "Initierad via API:t med en autentiseringstoken."

#, safe-html
msgctxt "Change origin tooltip"
msgid "Initiated through the web interface."
msgstr "Initierad via webbgränssnittet."

#, safe-html
msgctxt "Change origin tooltip"
msgid "Imported from translation files in the repository."
msgstr "Importerad från översättningsfiler i arkivet."

#, safe-html
msgctxt "Change origin tooltip"
msgid "Created by Weblate without a recorded initiating request."
msgstr "Skapad av Weblate utan en registrerad initierande begäran."

#, safe-html
msgid "Push on update"
msgstr "Skicka upp vid uppdatering"

#, safe-html
msgid ""
"Whether the repository should be pushed upstream after updating it, even "
"when the update did not commit any translations. When turned off, commits "
"made by the update are pushed with the next translation commit."
msgstr ""
"Om arkivet ska skickas uppströms efter uppdatering, även när uppdateringen "
"inte har checkat in några översättningar. När inställningen är avstängd "
"pushas incheckningar från uppdateringen med nästa översättningsincheckning."

#, python-format, safe-html
msgid "Could not reset to remote branch on %(component)s: %(error)s"
msgstr "Kunde inte återställa till fjärrgrenen för %(component)s: %(error)s"

#, safe-html
msgid ""
"Publishes source strings, translations, and project and component origin to "
"the global shared translation memory. Project access control does not "
"restrict this shared data."
msgstr ""
"Publicerar källsträngar, översättningar samt projektets och komponentens "
"ursprung i det globala delade översättningsminnet. Projektets "
"åtkomstkontroll begränsar inte dessa delade data."

#, safe-html
msgid "Translation service slugs conflict with the new workspace."
msgstr ""
"Översättningstjänsternas sluggar står i konflikt med den nya arbetsytan."

#, safe-html
msgid "Search description"
msgstr "Sökbeskrivning"

#, safe-html
msgid "Could not reapply translations to the reconstructed repository."
msgstr ""
"Kunde inte tillämpa översättningarna på nytt i det återskapade arkivet."

#, safe-html
msgid "Project backup import completed with warnings."
msgstr "Importen av projektets säkerhetskopia slutfördes med varningar."

