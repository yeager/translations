#, python-format, safe-html
msgid "%(count)s security key registered."
msgstr "%(count)s säkerhetsnyckel registrerad."

#, python-format, safe-html
msgid "%(count)s authenticator app registered."
msgstr "%(count)s autentiseringsapp registrerad."

#, safe-html
msgid ""
"Security keys can be used as a second factor to verify your identity when "
"prompted during sign-in."
msgstr ""
"Säkerhetsnycklar kan användas som en andra faktor för att verifiera din "
"identitet när du uppmanas att göra det vid inloggning."

#, safe-html
msgid "No operations were executed."
msgstr "Inga åtgärder utfördes."

#, safe-html
msgid ""
"Uses the saved workflow. Clear “Preview without changes” to execute actions."
msgstr ""
"Använder det sparade arbetsflödet. Avmarkera ”Förhandsgranska utan "
"ändringar” för att utföra åtgärder."

#, safe-html
msgid ""
"Component scope selects strings across the component. Trigger scope selects "
"strings affected by the change."
msgstr ""
"Komponentomfattning väljer strängar i hela komponenten. Utlösaromfattning "
"väljer strängar som påverkas av ändringen."

#, safe-html
msgid "Write pending Weblate translations to the repository."
msgstr "Skriv väntande Weblate-översättningar till arkivet."

#, safe-html
msgid "Pull upstream changes into the Weblate repository."
msgstr "Hämta uppströmsändringar till Weblate-arkivet."

#, safe-html
msgid "Lock to pause translation changes."
msgstr "Lås för att pausa översättningsändringar."

#, safe-html
msgid "Choose which translations to keep"
msgstr "Välj vilka översättningar som ska behållas"

#, safe-html
msgid "Use when:"
msgstr "Använd när:"

#, safe-html
msgid "Upstream has the translations you want to keep."
msgstr "Uppströms har översättningarna du vill behålla."

#, safe-html
msgid "Result:"
msgstr "Resultat:"

#, safe-html
msgid "Reset the configured branch to upstream."
msgstr "Återställ den konfigurerade grenen till uppströms."

#, safe-html
msgid "Data loss:"
msgstr "Dataförlust:"

#, safe-html
msgid "Local commits and pending translation changes are discarded."
msgstr "Lokala incheckningar och väntande översättningsändringar kastas bort."

#. Translators: Reapply means writing Weblate’s translations onto the
#. repository after resetting it to upstream.
#, safe-html
msgid "Reset and reapply translations"
msgstr "Återställ och tillämpa översättningarna på nytt"

#, safe-html
msgid ""
"Weblate has the translations you want to keep, or its checkout is missing."
msgstr ""
"Weblate har översättningarna du vill behålla, eller så saknas dess "
"utcheckning."

#, safe-html
msgid ""
"Reset the configured branch to upstream, then write Weblate translations "
"again."
msgstr ""
"Återställ den konfigurerade grenen till uppströms och skriv sedan Weblate-"
"översättningarna igen."

#, safe-html
msgid ""
"Supported Git checkouts can be rebuilt if missing; damaged Git metadata "
"needs administrator repair."
msgstr ""
"Git-utcheckningar som stöds kan byggas om när de saknas. Skadade Git-"
"metadata behöver repareras av en administratör."

#, safe-html
msgid "Refresh translation files"
msgstr "Uppdatera översättningsfiler"

#, safe-html
msgid "Repository files are out of sync with Weblate."
msgstr "Arkivfilerna är osynkroniserade med Weblate."

#, safe-html
msgid "Write all Weblate translations to the files."
msgstr "Skriv alla Weblate-översättningar till filerna."

#, safe-html
msgid "Files contain strings Weblate has not loaded."
msgstr "Filerna innehåller strängar som Weblate inte har läst in."

#, safe-html
msgid "Load translations from the files into Weblate."
msgstr "Läs in översättningar från filerna till Weblate."

#, safe-html
msgid "Edits blocked by the commit policy may be discarded."
msgstr "Ändringar som blockeras av incheckningspolicyn kan kastas bort."

#, safe-html
msgid "Clean the local checkout"
msgstr "Rensa den lokala utcheckningen"

#, safe-html
msgid "Untracked files or unused local branches need removal."
msgstr "Ospårade filer eller oanvända lokala grenar behöver tas bort."

#, safe-html
msgid "Remove untracked files and other local Git branches."
msgstr "Ta bort ospårade filer och andra lokala Git-grenar."

#, safe-html
msgid "Unpushed commits on those branches are deleted."
msgstr "Opushade incheckningar på dessa grenar tas bort."

#, safe-html
msgid "A translation file has repeated strings absent from Weblate."
msgstr "En översättningsfil har upprepade strängar som saknas i Weblate."

#, safe-html
msgid "Remove repeated identifiers from the file."
msgstr "Ta bort upprepade identifierare från filen."

#, safe-html
msgid "Translations still contain strings removed from the base file."
msgstr ""
"Översättningarna innehåller fortfarande strängar som har tagits bort från "
"basfilen."

#, safe-html
msgid "Remove those strings from the translation file."
msgstr "Ta bort dessa strängar från översättningsfilen."

#, safe-html
msgid "Obsolete PO entries should be removed now."
msgstr "Föråldrade PO-poster bör tas bort nu."

#, safe-html
msgid "Remove obsolete strings from the PO file."
msgstr "Ta bort föråldrade strängar från PO-filen."

#, safe-html
msgid "This service is installed in the workspace."
msgstr "Den här tjänsten är installerad i arbetsytan."

#, safe-html
msgid "workspace"
msgstr "arbetsyta"

#, safe-html
msgid "This service is disabled."
msgstr "Den här tjänsten är inaktiverad."

#, safe-html
msgid "Installation slug (optional)"
msgstr "Installationsslug (valfri)"

#, safe-html
msgid "Configured translation services"
msgstr "Konfigurerade översättningstjänster"

#, safe-html
msgid "Stop using this installation without removing its configuration."
msgstr "Sluta använda denna installation utan att ta bort dess konfiguration."

#, safe-html
msgid "Stop using this inherited installation here."
msgstr "Sluta använda denna ärvda installation här."

#, safe-html
msgid "Remove this installation and its configuration."
msgstr "Ta bort denna installation och dess konfiguration."

#, safe-html
msgid "Exclude all inherited installations of this service"
msgstr "Exkludera alla ärvda installationer av denna tjänst"

#, safe-html
msgid "Exclude"
msgstr "Exkludera"

#, safe-html
msgid "Available translation services"
msgstr "Tillgängliga översättningstjänster"

#, safe-html
msgid "Sign in to see the full audit log."
msgstr "Logga in för att se hela granskningsloggen."

#, safe-html
msgid ""
"Saved searches of this project are offered in the search filters to "
"everybody translating it."
msgstr ""
"Sparade sökningar för detta projekt erbjuds i sökfiltren för alla som "
"översätter det."

#, safe-html
msgid "Saved searches are offered in the search filters."
msgstr "Sparade sökningar erbjuds i sökfiltren."
