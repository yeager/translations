#| msgctxt "Automatic suggestion service configuration"
#| msgid "Authentication service URL"
msgid "Evaluation service"
msgstr "Utvärderingstjänst"

#| msgid "Update frequency"
msgid "Evaluation frequency"
msgstr "Utvärderingsfrekvens"

#| msgid "Browse all translation changes"
msgid "Evaluate translation changes"
msgstr "Utvärdera översättningsändringar"

#| msgid "Remote repository updated"
msgid "Evaluate repository updates"
msgstr "Utvärdera uppdateringar av förrådet"

#| msgid "Plural equation"
msgid "AI quality evaluation"
msgstr "AI-baserad kvalitetsutvärdering"

msgid ""
"Evaluates existing translations using an LLM and records quality checks."
msgstr ""
"Utvärderar befintliga översättningar med en språkmodell och registrerar "
"kvalitetskontroller."

#| msgid "Per language"
msgid "Per author and language"
msgstr "Per upphovsperson och språk"

#| msgid "Inherit from workspace"
msgid "Inherit enforced checks from the workspace."
msgstr "Ärv obligatoriska kontroller från arbetsområdet."

#| msgid "Choose either a project or a workspace."
msgid "Inherit enforced checks from the project, category or workspace."
msgstr ""
"Ärv obligatoriska kontroller från projektet, kategorin eller arbetsområdet."

#| msgid "Choose either a project or a workspace."
msgid ""
"Inherit enforced checks from the parent category, project or workspace."
msgstr ""
"Ärv obligatoriska kontroller från den överordnade kategorin, projektet eller"
" arbetsområdet."

#| msgid "Adding strings is disabled in the component configuration."
msgid "Editing source strings is disabled in the component configuration."
msgstr "Redigering av källsträngar är inaktiverad i komponentkonfigurationen."

#| msgid "You do not have permission to edit glossary entries."
msgid "You do not have permission to edit this glossary."
msgstr "Du har inte behörighet att redigera den här ordlistan."

#| msgid "Automatic detection"
msgid "Automation"
msgstr "Automatisering"

msgid "Runs ordered translation operations with conditions and branches."
msgstr "Kör ordnade översättningsåtgärder med villkor och förgreningar."

#| msgid "This component is set up incorrectly."
msgid "The component is outside this add-on's scope."
msgstr "Komponenten ligger utanför tilläggets omfattning."

#| msgid "Category does not belong to this project."
msgid "The change does not belong to this component."
msgstr "Ändringen hör inte till den här komponenten."

#| msgid "Automatic translation mode"
msgid "Automation nesting is too deep."
msgstr "Automatiseringen är nästlad för djupt."

msgid "Automation definitions cannot exceed 64 KiB."
msgstr "Automatiseringsdefinitioner får inte överstiga 64 KiB."

#| msgid "The chosen sorting is not supported."
msgid "YAML aliases and tags are not supported."
msgstr "YAML-alias och -taggar stöds inte."

#| msgid "Automatically translated strings"
msgid "Automation keys must be strings."
msgstr "Automatiseringsnycklar måste vara strängar."

msgid "Invalid automation YAML or JSON."
msgstr "Ogiltig YAML- eller JSON-kod för automatisering."

#, python-format
#| msgid "%(email)s: %(error)s"
msgid "%(path)s: %(error)s"
msgstr "%(path)s: %(error)s"

msgid "Automation exceeds 100 nodes or eight nesting levels."
msgstr "Automatiseringen överskrider 100 noder eller åtta nästlingsnivåer."

msgid "Automation action IDs must be unique."
msgstr "ID:n för automatiseringsåtgärder måste vara unika."

#, python-format
msgid "%(path)s: trigger scope requires only change triggers."
msgstr "%(path)s: utlösaromfånget kräver enbart ändringsutlösare."

#, python-format
msgid "%(path)s: result scope requires an earlier action ID."
msgstr "%(path)s: resultatomfånget kräver ett tidigare åtgärds-ID."

#, python-format
msgid "%(path)s: not requires exactly one condition."
msgstr "%(path)s: ”not” kräver exakt ett villkor."

#| msgid "Automatic component list assignment"
msgid "Automation context is too large."
msgstr "Automatiseringskontexten är för stor."

msgid "CEL validation or evaluation failed or exceeded its resource limit."
msgstr ""
"CEL-valideringen eller -utvärderingen misslyckades eller överskred "
"resursgränsen."

#, python-format
#| msgid "Invalid repository branch: %s"
msgid "Invalid CEL condition: %s"
msgstr "Ogiltigt CEL-villkor: %s"

msgid "Enter an automation definition as YAML or JSON."
msgstr "Ange en automatiseringsdefinition som YAML eller JSON."

#| msgid "Create component"
msgid "Preview component ID"
msgstr "Förhandsgranska komponent-ID"

msgid "Required for inherited automations. Used only for preview."
msgstr ""
"Krävs för ärvda automatiseringar. Används endast för förhandsgranskning."

#| msgid "Review changes"
msgid "Preview change ID"
msgstr "Förhandsgranska ändrings-ID"

msgid "Optional event context. Used only for preview."
msgstr "Valfri händelsekontext. Används endast för förhandsgranskning."

msgid "Minor"
msgstr "Mindre"

msgid "The evaluation detected a change in meaning."
msgstr "Utvärderingen identifierade en betydelseförändring."

#| msgid "The translation base language is editable."
msgid "The evaluation detected a language quality issue."
msgstr "Utvärderingen identifierade ett språkfel."

#| msgid "Terminology"
msgid "AI: Terminology"
msgstr "AI: Terminologi"

msgid "The evaluation detected incorrect terminology."
msgstr "Utvärderingen identifierade felaktig terminologi."

#| msgid "The documentation has detailed instructions"
msgid "The evaluation detected a style or instruction mismatch."
msgstr ""
"Utvärderingen identifierade en avvikelse från stil eller instruktioner."

#| msgid "Vue I18n formatting"
msgid "AI: Formatting"
msgstr "AI: Formatering"

#| msgid "Translation is missing some placeholders."
msgid "The evaluation detected a formatting or placeholder issue."
msgstr "Utvärderingen identifierade ett formaterings- eller platshållarfel."

msgid "Editing Fluent messages with attributes or selectors is not supported."
msgstr ""
"Redigering av Fluent-meddelanden med attribut eller väljare stöds inte."

#| msgid "The file format does not support updating source strings."
msgid "This file format does not support editing keys or context."
msgstr "Det här filformatet stöder inte redigering av nycklar eller kontext."

#| msgid "A user with this e-mail already exists."
msgid "A string with this identity already exists."
msgstr "En sträng med denna identitet finns redan."

#| msgid "The file format does not support updating source strings."
msgid "This file format does not support editing source strings."
msgstr "Det här filformatet stöder inte redigering av källsträngar."

#| msgid ""
#| "Update source strings upload is not supported with this format."
msgid "Editing source strings with inline markup is not supported."
msgstr "Redigering av källsträngar med inbäddad märkning stöds inte."

#| msgid "This role cannot be assigned to this team."
msgid "The key cannot be represented in this file format."
msgstr "Nyckeln kan inte representeras i det här filformatet."

msgid "File validation is required for directory-based formats."
msgstr "Filvalidering krävs för katalogbaserade format."
