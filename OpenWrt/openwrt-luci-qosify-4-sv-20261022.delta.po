msgid "Sent to CAKE as atm, noatm or ptm."
msgstr "Skickas till CAKE som atm, noatm eller ptm."

msgid "Sent to CAKE as ether-vlan, once per tag."
msgstr "Skickas till CAKE som ether-vlan, en gång per tagg."

msgid "Sent to CAKE as mpu, in bytes."
msgstr "Skickas till CAKE som mpu, i byte."

msgid "Sent to CAKE as overhead, in bytes."
msgstr "Skickas till CAKE som overhead, i byte."

msgid "Service"
msgstr "Tjänst"

msgid "Shaping"
msgstr "Trafikformning"

msgid "Size"
msgstr "Storlek"

msgid "Skip this section"
msgstr "Hoppa över det här avsnittet"

msgid "Status Unknown"
msgstr "Okänd status"

msgid "TCP single port, or range from <port> to <endport>"
msgstr "En enskild TCP-port eller ett intervall från <port> till <endport>"

msgid "The detailed tc output needs write access to this page."
msgstr ""
"Den detaljerade tc-utmatningen kräver skrivbehörighet till den här sidan."

msgid ""
"The qosify UCI configuration could not be loaded — class and interface lists"
" may be incomplete."
msgstr ""
"Det gick inte att läsa in QoSifys UCI-konfiguration. Listorna över klasser "
"och gränssnitt kan vara ofullständiga."

msgid ""
"The selected files replace the ones on the router and qosify is reloaded."
msgstr "De valda filerna ersätter dem på routern och QoSify läses in på nytt."

msgid ""
"The selected files replace the ones on the router and qosify is reloaded. "
"Download a backup from this tab first if you need one."
msgstr ""
"De valda filerna ersätter dem på routern och QoSify läses in på nytt. Hämta "
"först en säkerhetskopia från den här fliken om du behöver en."

msgid ""
"Time below bulk_trigger_pps threshold until a bulk flow mark is removed"
msgstr ""
"Tid under gränsvärdet bulk_trigger_pps innan märkningen av ett massflöde tas"
" bort"

msgid "Traffic by CAKE Tin"
msgstr "Trafik per CAKE-klass"

msgid "Traffic by Class"
msgstr "Trafik per klass"

msgid "UDP single port, or range from <port> to <endport>"
msgstr "En enskild UDP-port eller ett intervall från <port> till <endport>"

msgid "Unknown"
msgstr "Okänd"

msgid "Unticked sets disabled 1 and qosify skips this section."
msgstr ""
"Avmarkering sätter disabled till 1 och QoSify hoppar över det här avsnittet."

msgid "Uplink bandwidth (same format as tc)"
msgstr "Uppströmshastighet (samma format som tc)"

msgid "Uplink bandwidth, same format as tc. Set just below line speed."
msgstr ""
"Uppströmshastighet, samma format som tc. Ange ett värde strax under "
"linjehastigheten."

msgid "Upload"
msgstr "Ladda upp"

msgid "Upload & Apply"
msgstr "Ladda upp och tillämpa"

msgid "Upload and apply"
msgstr "Ladda upp och tillämpa"

msgid "Upload bandwidth"
msgstr "Uppladdningshastighet"

msgid "Upload shaping"
msgstr "Formning av uppladdningstrafik"

msgid "Uptime"
msgstr "Drifttid"

msgid "VLAN tags"
msgstr "VLAN-taggar"

msgid "Write empty file"
msgstr "Skriv tom fil"

msgid ""
"You have read-only access to this page, so editing and service control are "
"disabled."
msgstr ""
"Du har skrivskyddad åtkomst till den här sidan, så redigering och "
"tjänstekontroll är inaktiverade."

msgid "active"
msgstr "aktiv"

msgid ""
"bandwidth_down does not look like a tc rate (100mbit, 12MBps, unlimited) — "
"passing it through anyway"
msgstr ""
"bandwidth_down verkar inte vara en tc-hastighet (100mbit, 12MBps, unlimited)"
" men skickas vidare ändå"

msgid ""
"bandwidth_up does not look like a tc rate (100mbit, 12MBps, unlimited) — "
"passing it through anyway"
msgstr ""
"bandwidth_up verkar inte vara en tc-hastighet (100mbit, 12MBps, unlimited) "
"men skickas vidare ändå"

msgid ""
"config device takes the same options, with name set to a netdev. nat "
"defaults to 1 for interfaces and 0 for devices."
msgstr ""
"config device använder samma flaggor, med name angivet som en nätverksenhet."
" nat är som standard 1 för gränssnitt och 0 för enheter."

msgid "device %s"
msgstr "enhet %s"

msgid "device: %s, ingress: %s, egress: %s"
msgstr "enhet: %s, ingående: %s, utgående: %s"

msgid ""
"disabled is set to \"%s\" — config_get_bool does not recognise that, so the "
"section stays enabled"
msgstr ""
"disabled är satt till \"%s\". config_get_bool känner inte igen det, så "
"avsnittet förblir aktiverat"

msgid "e.g. %s"
msgstr "t.ex. %s"

msgid "fnmatch() pattern supporting * and ? as wildcard characters"
msgstr "Mönster för fnmatch() med stöd för * och ? som jokertecken"

msgid "get_stats did not answer."
msgstr "get_stats svarade inte."

msgid "inactive"
msgstr "inaktiv"

msgid "ingress %s, egress %s"
msgstr "ingående %s, utgående %s"

msgid "interface %s"
msgstr "gränssnitt %s"

msgid "match"
msgstr "matchning"

msgid ""
"netifd interface (config interface) or netdev (config device) to enable QoS "
"on"
msgstr ""
"netifd-gränssnitt (config interface) eller nätverksenhet (config device) som"
" QoS ska aktiveras för"

msgid "netifd interface to enable QoS on. Required."
msgstr "netifd-gränssnitt som QoS ska aktiveras för. Krävs."

msgid "no"
msgstr "nej"

msgid "none"
msgstr "ingen"

msgid ""
"qosify did not appear on ubus, so its config was not applied — press Reload"
msgstr ""
"QoSify visades inte i ubus, så dess konfiguration tillämpades inte. Tryck på"
" Läs in igen"
