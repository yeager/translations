#, java-printf-format
msgctxt "user_add"
msgid "Add user"
msgstr "Lägg till användare"

#, java-printf-format
msgctxt "user_name_label"
msgid "Name"
msgstr "Namn"

#, java-printf-format
msgctxt "user_password_optional_label"
msgid "Password"
msgstr "Lösenord"

#, java-printf-format
msgctxt "user_password_optional_hint"
msgid "Without a password, anyone who knows the name can sign in."
msgstr "Utan lösenord kan alla som känner till namnet logga in."

#, java-printf-format
msgctxt "user_this_account"
msgid "This is your account"
msgstr "Det här är ditt konto"

#, java-printf-format
msgctxt "section_user_account"
msgid "Account"
msgstr "Konto"

#, java-printf-format
msgctxt "user_rename_title"
msgid "Rename user"
msgstr "Byt namn på användaren"

#, java-printf-format
msgctxt "user_set_password"
msgid "Set password"
msgstr "Ange lösenord"

#, java-printf-format
msgctxt "user_set_password_summary"
msgid "Signs this user out on every device"
msgstr "Loggar ut användaren från alla enheter"

#, java-printf-format
msgctxt "user_set_password_summary_self"
msgid "Signs you out on your other devices"
msgstr "Loggar ut dig från dina andra enheter"

#, java-printf-format
msgctxt "user_current_password_label"
msgid "Current password"
msgstr "Nuvarande lösenord"

#, java-printf-format
msgctxt "user_new_password_label"
msgid "New password"
msgstr "Nytt lösenord"

#, java-printf-format
msgctxt "user_confirm_password_label"
msgid "Repeat new password"
msgstr "Upprepa det nya lösenordet"

#, java-printf-format
msgctxt "user_passwords_differ"
msgid "The two passwords are not the same"
msgstr "De två lösenorden är inte lika"

#, java-printf-format
msgctxt "user_disable"
msgid "Disable account"
msgstr "Inaktivera konto"

#, java-printf-format
msgctxt "user_disable_summary"
msgid "Signs this user out and blocks sign-in"
msgstr "Loggar ut användaren och blockerar inloggning"

#, java-printf-format
msgctxt "user_disable_admin_summary"
msgid "An administrator cannot be disabled"
msgstr "En administratör kan inte inaktiveras"

#, java-printf-format
msgctxt "user_disable_title"
msgid "Disable this account?"
msgstr "Inaktivera kontot?"

#, java-printf-format
msgctxt "user_disable_message"
msgid ""
"%1$s is signed out on every device and cannot sign in until the account is "
"enabled again."
msgstr ""
"%1$s loggas ut från alla enheter och kan inte logga in förrän kontot "
"aktiveras igen."

#, java-printf-format
msgctxt "user_enable"
msgid "Enable account"
msgstr "Aktivera konto"

#, java-printf-format
msgctxt "user_enable_summary"
msgid "This account is disabled and cannot sign in"
msgstr "Kontot är inaktiverat och går inte att logga in på"

#, java-printf-format
msgctxt "user_delete"
msgid "Delete user"
msgstr "Ta bort användare"

#, java-printf-format
msgctxt "user_delete_summary"
msgid "Also deletes this user's playlists"
msgstr "Tar även bort användarens spellistor"

#, java-printf-format
msgctxt "user_delete_self_summary"
msgid "You cannot delete the account you are signed in with"
msgstr "Du kan inte ta bort kontot som du är inloggad med"

#, java-printf-format
msgctxt "user_delete_last_admin_summary"
msgid "The only administrator cannot be deleted"
msgstr "Den enda administratören kan inte tas bort"

#, java-printf-format
msgctxt "user_delete_title"
msgid "Delete this user?"
msgstr "Ta bort användaren?"

#, java-printf-format
msgctxt "user_delete_message"
msgid ""
"%1$s, their watch history and their playlists are deleted. This cannot be "
"undone."
msgstr ""
"%1$s, användarens visningshistorik och spellistor tas bort. Detta går inte "
"att ångra."

#, java-printf-format
msgctxt "user_not_found"
msgid "This user is no longer on the server"
msgstr "Användaren finns inte längre på servern"

#, java-printf-format
msgctxt "title_user_permissions"
msgid "Permissions"
msgstr "Behörigheter"

#, java-printf-format
msgctxt "user_permissions_summary"
msgid "Library access, playback and management"
msgstr "Biblioteksåtkomst, uppspelning och hantering"

#, java-printf-format
msgctxt "user_permissions_discard_message"
msgid "Your changes to this user haven't been saved."
msgstr "Dina ändringar av användaren har inte sparats."

#, java-printf-format
msgctxt "section_perm_access"
msgid "Access"
msgstr "Åtkomst"

#, java-printf-format
msgctxt "perm_administrator"
msgid "Allow this user to manage the server"
msgstr "Tillåt användaren att hantera servern"

#, java-printf-format
msgctxt "perm_administrator_self"
msgid "You cannot change this on your own account"
msgstr "Du kan inte ändra detta för ditt eget konto"

#, java-printf-format
msgctxt "perm_administrator_last"
msgid "The only administrator cannot be demoted"
msgstr "Den enda administratören kan inte degraderas"

#, java-printf-format
msgctxt "perm_hidden"
msgid "Hide this user from login screens"
msgstr "Dölj användaren från inloggningsskärmar"

#, java-printf-format
msgctxt "perm_hidden_summary"
msgid ""
"Useful for private or hidden administrator accounts. The user will need to "
"sign in manually by entering their username and password."
msgstr ""
"Användbart för privata eller dolda administratörskonton. Användaren måste "
"logga in manuellt med användarnamn och lösenord."

#, java-printf-format
msgctxt "perm_remote_access"
msgid "Allow remote connections to this server"
msgstr "Tillåt fjärranslutningar till servern"

#, java-printf-format
msgctxt "perm_remote_access_summary"
msgid "If unchecked, all remote connections will be blocked."
msgstr "Om avmarkerat blockeras alla fjärranslutningar."

#, java-printf-format
msgctxt "section_perm_libraries"
msgid "Library Access"
msgstr "Biblioteksåtkomst"

#, java-printf-format
msgctxt "perm_all_libraries"
msgid "Enable access to all libraries"
msgstr "Aktivera åtkomst till alla bibliotek"

#, java-printf-format
msgctxt "perm_libraries_help"
msgid ""
"Select the libraries to share with this user. Administrators will be able to"
" edit all folders using the metadata manager."
msgstr ""
"Välj vilka bibliotek som ska delas med användaren. Administratörer kan "
"redigera alla mappar med metadatahanteraren."

#, java-printf-format
msgctxt "section_perm_channels"
msgid "Channel Access"
msgstr "Kanalåtkomst"

#, java-printf-format
msgctxt "perm_all_channels"
msgid "Enable access to all channels"
msgstr "Aktivera åtkomst till alla kanaler"

#, java-printf-format
msgctxt "perm_channels_help"
msgid ""
"Select the channels to share with this user. Administrators will be able to "
"edit all channels using the metadata manager."
msgstr ""
"Välj vilka kanaler som ska delas med användaren. Administratörer kan "
"redigera alla kanaler med metadatahanteraren."

#, java-printf-format
msgctxt "section_perm_playback"
msgid "Media playback"
msgstr "Medieuppspelning"

#, java-printf-format
msgctxt "perm_media_playback"
msgid "Allow media playback"
msgstr "Tillåt medieuppspelning"

#, java-printf-format
msgctxt "perm_audio_transcoding"
msgid "Allow audio playback that requires transcoding"
msgstr "Tillåt ljuduppspelning som kräver omkodning"

#, java-printf-format
msgctxt "perm_video_transcoding"
msgid "Allow video playback that requires transcoding"
msgstr "Tillåt videouppspelning som kräver omkodning"

#, java-printf-format
msgctxt "perm_remuxing"
msgid "Allow video playback that requires conversion without re-encoding"
msgstr "Tillåt videouppspelning som kräver konvertering utan omkodning"

#, java-printf-format
msgctxt "perm_force_remote_transcoding"
msgid "Force transcoding of remote media sources such as Live TV"
msgstr "Tvinga omkodning av fjärrmediekällor, exempelvis direkt-tv"

#, java-printf-format
msgctxt "perm_playback_help"
msgid ""
"Restricting access to transcoding may cause playback failures in clients due"
" to unsupported media formats."
msgstr ""
"Begränsad åtkomst till omkodning kan leda till uppspelningsfel i klienter på"
" grund av medier som inte stöds."

#, java-printf-format
msgctxt "section_perm_media"
msgid "Media"
msgstr "Media"

#, java-printf-format
msgctxt "perm_downloads"
msgid "Allow media downloads"
msgstr "Tillåt mediehämtningar"

#, java-printf-format
msgctxt "perm_downloads_summary"
msgid ""
"Users can download media and store it on their devices. This is not the same"
" as a sync feature. Book libraries require this enabled to function "
"properly."
msgstr ""
"Användare kan hämta media och spara det på sina enheter. Detta är inte samma"
" sak som synkronisering. Bokbibliotek måste ha detta aktiverat för att "
"fungera korrekt."
