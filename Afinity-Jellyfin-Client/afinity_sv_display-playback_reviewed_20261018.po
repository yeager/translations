#, java-printf-format
msgctxt "config_section_paths"
msgid "Paths"
msgstr "Sökvägar"

#, java-printf-format
msgctxt "config_cache_path"
msgid "Cache path"
msgstr "Cache-sökväg"

#, java-printf-format
msgctxt "config_cache_path_summary"
msgid ""
"Specify a custom location for server cache files such as images. Leave blank"
" to use the server default."
msgstr ""
"Ange en egen plats för serverns cachefiler, exempelvis bilder. Lämna tomt "
"för att använda serverns standardplats."

#, java-printf-format
msgctxt "config_metadata_path"
msgid "Metadata path"
msgstr "Metadata-sökväg"

#, java-printf-format
msgctxt "config_metadata_path_summary"
msgid "Specify a custom location for downloaded artwork and metadata."
msgstr "Ange en egen plats för hämtad grafik och metadata."

#, java-printf-format
msgctxt "config_library_display_title"
msgid "Display"
msgstr "Visning"

#, java-printf-format
msgctxt "config_library_display_summary"
msgid "Folders, specials and collections"
msgstr "Mappar, specialavsnitt och samlingar"

#, java-printf-format
msgctxt "config_section_display"
msgid "Display"
msgstr "Visning"

#, java-printf-format
msgctxt "config_date_added"
msgid "Date added behavior for new content"
msgstr "Beteende för datum tillagt för nytt innehåll"

#, java-printf-format
msgctxt "config_date_added_summary"
msgid ""
"If a metadata value is present, it will always be used before either of "
"these options."
msgstr ""
"Om ett metadatavärde finns används det alltid före något av dessa "
"alternativ."

#, java-printf-format
msgctxt "config_date_added_import"
msgid "Use date scanned into the library"
msgstr "Använd datumet då innehållet skannades in i biblioteket"

#, java-printf-format
msgctxt "config_date_added_file"
msgid "Use file creation date"
msgstr "Använd filens skapandedatum"

#, java-printf-format
msgctxt "config_folder_view"
msgid "Display a folder view to show plain media folders"
msgstr "Visa en mappvy för vanliga mediemappar"

#, java-printf-format
msgctxt "config_folder_view_summary"
msgid ""
"Display folders alongside your other media libraries. This can be useful if "
"you'd like to have a plain folder view."
msgstr ""
"Visa mappar tillsammans med dina övriga mediebibliotek. Det kan vara "
"användbart om du vill ha en enkel mappvy."

#, java-printf-format
msgctxt "config_specials_in_seasons"
msgid "Display specials within seasons they aired in"
msgstr "Visa specialavsnitt i säsongerna där de sändes"

#, java-printf-format
msgctxt "config_group_movies"
msgid "Group movies into collections"
msgstr "Gruppera filmer i samlingar"

#, java-printf-format
msgctxt "config_group_movies_summary"
msgid ""
"Movies in a collection will be displayed as one grouped item when displaying"
" movie lists."
msgstr "Filmer i en samling visas som ett grupperat objekt i filmlistor."

#, java-printf-format
msgctxt "config_group_shows"
msgid "Group shows into collections"
msgstr "Gruppera serier i samlingar"

#, java-printf-format
msgctxt "config_group_shows_summary"
msgid ""
"Shows in a collection will be displayed as one grouped item when displaying "
"show lists."
msgstr "Serier i en samling visas som ett grupperat objekt i serielistor."

#, java-printf-format
msgctxt "config_external_suggestions"
msgid "Enable external content in suggestions"
msgstr "Aktivera externt innehåll i förslag"

#, java-printf-format
msgctxt "config_external_suggestions_summary"
msgid ""
"Allow internet trailers and live TV programs to be included within suggested"
" content."
msgstr ""
"Tillåt att trailer från internet och direkt-tv-program ingår i rekommenderat"
" innehåll."

#, java-printf-format
msgctxt "config_playback_title"
msgid "Playback"
msgstr "Uppspelning"

#, java-printf-format
msgctxt "config_resume_summary"
msgid "When titles count as played or resumable"
msgstr "När titlar räknas som sedda eller möjliga att återuppta"

#, java-printf-format
msgctxt "config_streaming_summary"
msgid "Bitrate limit for internet streaming"
msgstr "Gräns för bithastighet vid internetströmning"

#, java-printf-format
msgctxt "config_section_resume"
msgid "Resume"
msgstr "Återuppta"

#, java-printf-format
msgctxt "config_min_resume_pct"
msgid "Minimum resume percentage"
msgstr "Lägsta procent för återupptagning"

#, java-printf-format
msgctxt "config_min_resume_pct_summary"
msgid "Titles are assumed unplayed if stopped before this time."
msgstr "Titlar antas vara osedda om de stoppas före den här tidpunkten."

#, java-printf-format
msgctxt "config_max_resume_pct"
msgid "Maximum resume percentage"
msgstr "Högsta procent för återupptagning"

#, java-printf-format
msgctxt "config_max_resume_pct_summary"
msgid "Titles are assumed fully played if stopped after this time."
msgstr "Titlar antas vara helt sedda om de stoppas efter den här tidpunkten."

#, java-printf-format
msgctxt "config_min_resume_duration"
msgid "Minimum resume duration"
msgstr "Kortaste längd för återupptagning"

#, java-printf-format
msgctxt "config_min_resume_duration_summary"
msgid ""
"The shortest video length in seconds that will save playback location and "
"let you resume."
msgstr ""
"Den kortaste videolängden i sekunder som sparar uppspelningspositionen och "
"låter dig återuppta."

#, java-printf-format
msgctxt "config_min_audiobook_resume"
msgid "Minimum Audiobook resume in minutes"
msgstr "Kortaste återupptagning för ljudbok i minuter"

#, java-printf-format
msgctxt "config_min_audiobook_resume_summary"
msgid "Titles are assumed unplayed if stopped before this time."
msgstr "Titlar antas vara osedda om de stoppas före den här tidpunkten."

#, java-printf-format
msgctxt "config_max_audiobook_resume"
msgid "Audiobook remaining minutes to resume"
msgstr "Återstående minuter i ljudbok för återupptagning"

#, java-printf-format
msgctxt "config_max_audiobook_resume_summary"
msgid ""
"Titles are assumed fully played if stopped when the remaining duration is "
"less than this value."
msgstr ""
"Titlar antas vara helt sedda om de stoppas när återstående tid är kortare än"
" detta värde."

#, java-printf-format
msgctxt "config_section_streaming"
msgid "Streaming"
msgstr "Strömning"

#, java-printf-format
msgctxt "config_remote_bitrate_limit"
msgid "Internet streaming bitrate limit (Mbps)"
msgstr "Gräns för bithastighet vid internetströmning (Mbit/s)"

#, java-printf-format
msgctxt "config_remote_bitrate_limit_summary"
msgid ""
"An optional per-stream bitrate limit for all out of network devices. This is"
" useful to prevent devices from requesting a higher bitrate than your "
"internet connection can handle. This may result in increased CPU load on "
"your server in order to transcode videos on the fly to a lower bitrate."
msgstr ""
"En valfri gräns för bithastighet per ström för alla enheter utanför "
"nätverket. Det förhindrar enheter från att begära högre bithastighet än "
"internetanslutningen klarar. Det kan öka processorbelastningen på servern "
"när videor omkodas till lägre bithastighet direkt."
