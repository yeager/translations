#, java-printf-format
msgctxt "pref_mpv_device_check_title"
msgid "Vulkan compatibility"
msgstr "Vulkan-kompatibilitet"

#, java-printf-format
msgctxt "pref_mpv_device_check_summary"
msgid "Tap to verify Vulkan and HDR support"
msgstr "Tryck för att kontrollera stöd för Vulkan och HDR"

#, java-printf-format
msgctxt "mpv_device_check_vulkan_missing"
msgid "not available"
msgstr "inte tillgängligt"

#, java-printf-format
msgctxt "mpv_device_check_vulkan_needs"
msgid "(needs %1$s+)"
msgstr "(kräver %1$s+)"

#, java-printf-format
msgctxt "mpv_device_check_hdr_none"
msgid "not an HDR display"
msgstr "inte en HDR-skärm"

#, java-printf-format
msgctxt "mpv_device_check_status_checking"
msgid "checking device…"
msgstr "kontrollerar enheten…"

#, java-printf-format
msgctxt "mpv_device_check_status_supported"
msgid "HDR passthrough available. Select Vulkan as GPU API."
msgstr "HDR-genomströmning är tillgänglig. Välj Vulkan som GPU-API."

#, java-printf-format
msgctxt "mpv_device_check_status_limited"
msgid ""
"Vulkan works, but this display can't show HDR. HDR is tone-mapped to SDR."
msgstr ""
"Vulkan fungerar, men den här skärmen kan inte visa HDR. HDR tonmappas till "
"SDR."

#, java-printf-format
msgctxt "mpv_device_check_status_unsupported"
msgid "Vulkan %1$s isn't supported. HDR is tone-mapped to SDR."
msgstr "Vulkan %1$s stöds inte. HDR tonmappas till SDR."

#, java-printf-format
msgctxt "cd_rewind_30"
msgid "Rewind 30 seconds"
msgstr "Spola tillbaka 30 sekunder"

#, java-printf-format
msgctxt "player_error_connection"
msgid "Couldn't reach the server. Check your connection and try again."
msgstr ""
"Det gick inte att nå servern. Kontrollera anslutningen och försök igen."

#, java-printf-format
msgctxt "player_error_live_channel_unavailable"
msgid "This channel isn't available right now. Its source may be offline."
msgstr ""
"Den här kanalen är inte tillgänglig just nu. Källan kan vara frånkopplad."

#, java-printf-format
msgctxt "player_error_stream_failed"
msgid "The server couldn't start this video."
msgstr "Servern kunde inte starta den här videon."

#, java-printf-format
msgctxt "player_error_video_output"
msgid ""
"Video output failed to start. Try GPU API: OpenGL in the player settings."
msgstr ""
"Videoutmatningen kunde inte starta. Prova GPU-API:t OpenGL i "
"spelarinställningarna."

#, java-printf-format
msgctxt "player_error_audio_output"
msgid ""
"Audio output failed to start. Try a different Audio Output in the player "
"settings."
msgstr ""
"Ljudutmatningen kunde inte starta. Prova en annan ljudutmatning i "
"spelarinställningarna."

#, java-printf-format
msgctxt "drawer_libraries_mode_off"
msgid "Off"
msgstr "Av"

#, java-printf-format
msgctxt "drawer_libraries_mode_screen"
msgid "Libraries screen"
msgstr "Biblioteksskärmen"

#, java-printf-format
msgctxt "drawer_libraries_mode_each"
msgid "Each library"
msgstr "Varje bibliotek"

#, java-printf-format
msgctxt "pref_merge_continue_next_up_title"
msgid "Merge Continue Watching and Next Up"
msgstr "Slå ihop Fortsätt titta och Näst på tur"

#, java-printf-format
msgctxt "pref_merge_continue_next_up_summary"
msgid "Show both in one row, most recently watched first"
msgstr "Visa båda på en rad, med det som tittades på senast först"

#, java-printf-format
msgctxt "pref_next_up_max_days_title"
msgid "Max Days in Next Up"
msgstr "Maximalt antal dagar i Näst på tur"

#, java-printf-format
msgctxt "pref_next_up_max_days_hint"
msgid ""
"How long a show stays in Next Up after you last watched it. Enter 0 for no "
"limit."
msgstr ""
"Hur länge en serie visas i Näst på tur efter att du senast tittade på den. "
"Ange 0 för ingen gräns."

#, java-printf-format
msgctxt "pref_next_up_max_days_label"
msgid "Days"
msgstr "Dagar"

#, java-printf-format
msgctxt "pref_requires_next_up_row"
msgid "Turn on Next Up to use this"
msgstr "Aktivera Näst på tur för att använda detta"

