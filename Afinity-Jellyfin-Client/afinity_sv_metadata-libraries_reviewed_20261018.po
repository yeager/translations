#, java-printf-format
msgctxt "config_min_above_max"
msgid "The minimum must be lower than the maximum."
msgstr "Minimivärdet måste vara lägre än maximivärdet."

#, java-printf-format
msgctxt "config_metadata_title"
msgid "Metadata"
msgstr "Metadata"

#, java-printf-format
msgctxt "config_metadata_summary"
msgid "Default language, country and chapter images"
msgstr "Standardspråk, land och kapitelbilder"

#, java-printf-format
msgctxt "config_metadata_note"
msgid "These are your defaults and can be customized on a per-library basis."
msgstr "Detta är dina standardvärden och de kan anpassas för varje bibliotek."

#, java-printf-format
msgctxt "config_section_metadata_language"
msgid "Preferred Metadata Language"
msgstr "Föredraget språk för metadata"

#, java-printf-format
msgctxt "config_metadata_language"
msgid "Language"
msgstr "Språk"

#, java-printf-format
msgctxt "config_metadata_country"
msgid "Country/Region"
msgstr "Land/region"

#, java-printf-format
msgctxt "config_section_chapters"
msgid "Chapter Images"
msgstr "Kapitelbilder"

#, java-printf-format
msgctxt "config_chapter_interval"
msgid "Interval"
msgstr "Intervall"

#, java-printf-format
msgctxt "config_chapter_interval_summary"
msgid ""
"The interval between dummy chapters in seconds. Set to 0 to disable dummy "
"chapter generation. Changing this will have no effect on existing dummy "
"chapters."
msgstr ""
"Intervallet mellan platshållarkapitel i sekunder. Ange 0 för att inaktivera "
"generering av platshållarkapitel. Ändringen påverkar inte befintliga "
"platshållarkapitel."

#, java-printf-format
msgctxt "config_chapter_image_resolution"
msgid "Resolution"
msgstr "Upplösning"

#, java-printf-format
msgctxt "config_chapter_image_resolution_summary"
msgid ""
"The resolution of the extracted chapter images. Changing this will have no "
"effect on existing dummy chapters."
msgstr ""
"Upplösningen för de extraherade kapitelbilderna. Ändringen påverkar inte "
"befintliga platshållarkapitel."

#, java-printf-format
msgctxt "config_resolution_match_source"
msgid "Match source"
msgstr "Matcha källan"

#, java-printf-format
msgctxt "config_nfo_title"
msgid "NFO Settings"
msgstr "NFO-inställningar"

#, java-printf-format
msgctxt "config_nfo_summary"
msgid "What is written to NFO files"
msgstr "Vad som skrivs till NFO-filer"

#, java-printf-format
msgctxt "config_nfo_note"
msgid ""
"To enable or disable NFO metadata, edit a library and find the 'Metadata "
"savers' section."
msgstr ""
"Redigera ett bibliotek och leta upp avsnittet ”Metadatasparare” för att "
"aktivera eller inaktivera NFO-metadata."

#, java-printf-format
msgctxt "config_section_nfo"
msgid "NFO Settings"
msgstr "NFO-inställningar"

#, java-printf-format
msgctxt "config_nfo_user"
msgid "Save user watch data to NFO files for"
msgstr "Spara användarens visningsdata i NFO-filer för"

#, java-printf-format
msgctxt "config_nfo_user_summary"
msgid "Save watch data to NFO files for other applications to use."
msgstr "Spara visningsdata i NFO-filer så att andra program kan använda dem."

#, java-printf-format
msgctxt "config_nfo_image_paths"
msgid "Save image paths within NFO files"
msgstr "Spara bildsökvägar i NFO-filer"

#, java-printf-format
msgctxt "config_nfo_image_paths_summary"
msgid ""
"This is recommended if you have image file names that don't conform to Kodi "
"guidelines."
msgstr "Detta rekommenderas om dina bildfilnamn inte följer Kodis riktlinjer."

#, java-printf-format
msgctxt "config_nfo_path_substitution"
msgid "Enable path substitution"
msgstr "Aktivera sökvägsersättning"

#, java-printf-format
msgctxt "config_nfo_path_substitution_summary"
msgid ""
"Enable path substitution of image paths using the server's path substitution"
" settings."
msgstr ""
"Aktivera ersättning av bildsökvägar med serverns inställningar för "
"sökvägsersättning."

#, java-printf-format
msgctxt "config_nfo_extra_thumbs"
msgid "Copy extrafanart to extrathumbs field"
msgstr "Kopiera extrafanart till fältet extrathumbs"

#, java-printf-format
msgctxt "config_nfo_extra_thumbs_summary"
msgid ""
"When downloading images they can be saved into both extrafanart and "
"extrathumbs for maximum Kodi skin compatibility."
msgstr ""
"Vid hämtning av bilder kan de sparas både i extrafanart och extrathumbs för "
"maximal kompatibilitet med Kodi-teman."

#, java-printf-format
msgctxt "config_choice_search"
msgid "Search"
msgstr "Sök"

#, java-printf-format
msgctxt "library_opt_server_default"
msgid "Server default"
msgstr "Serverstandard"

#, java-printf-format
msgctxt "library_add"
msgid "Add library"
msgstr "Lägg till bibliotek"

#, java-printf-format
msgctxt "library_add_type"
msgid "Content type"
msgstr "Innehållstyp"

#, java-printf-format
msgctxt "library_add_exists"
msgid "A library with this name already exists."
msgstr "Det finns redan ett bibliotek med det här namnet."

#, java-printf-format
msgctxt "library_add_create"
msgid "Create library"
msgstr "Skapa bibliotek"

#, java-printf-format
msgctxt "library_add_creating"
msgid "Creating…"
msgstr "Skapar…"

#, java-printf-format
msgctxt "library_add_folders_help"
msgid ""
"At least one folder is needed. The library is scanned once it is created."
msgstr "Minst en mapp krävs. Biblioteket skannas när det har skapats."

#, java-printf-format
msgctxt "library_add_discard_message"
msgid "The new library hasn't been created."
msgstr "Det nya biblioteket har inte skapats."

#, java-printf-format
msgctxt "library_type_movies"
msgid "Movies"
msgstr "Filmer"

#, java-printf-format
msgctxt "library_type_shows"
msgid "Shows"
msgstr "Serier"

#, java-printf-format
msgctxt "library_type_music"
msgid "Music"
msgstr "Musik"

#, java-printf-format
msgctxt "library_type_books"
msgid "Books"
msgstr "Böcker"

#, java-printf-format
msgctxt "library_type_home_videos"
msgid "Home videos and photos"
msgstr "Hemvideor och foton"

#, java-printf-format
msgctxt "library_type_music_videos"
msgid "Music videos"
msgstr "Musikvideor"

#, java-printf-format
msgctxt "library_type_mixed"
msgid "Mixed movies and shows"
msgstr "Blandade filmer och serier"

#, java-printf-format
msgctxt "config_discard_message"
msgid "Your changes to these settings haven't been saved."
msgstr "Dina ändringar av inställningarna har inte sparats."

#, java-printf-format
msgctxt "config_general_title"
msgid "General"
msgstr "Allmänt"

#, java-printf-format
msgctxt "config_general_summary"
msgid "Name, paths, Quick Connect and performance"
msgstr "Namn, sökvägar, Quick Connect och prestanda"

#, java-printf-format
msgctxt "config_section_server"
msgid "Server"
msgstr "Server"

#, java-printf-format
msgctxt "config_section_quick_connect"
msgid "Quick Connect"
msgstr "Quick Connect"

#, java-printf-format
msgctxt "config_server_name"
msgid "Server name"
msgstr "Servernamn"

#, java-printf-format
msgctxt "config_server_name_summary"
msgid ""
"This name will be used to identify the server and will default to the "
"server's hostname."
msgstr ""
"Det här namnet används för att identifiera servern och är som standard "
"serverns värdnamn."

#, java-printf-format
msgctxt "config_quick_connect"
msgid "Enable Quick Connect on this server"
msgstr "Aktivera Quick Connect på servern"

#, java-printf-format
msgctxt "config_section_performance"
msgid "Performance"
msgstr "Prestanda"

#, java-printf-format
msgctxt "config_scan_concurrency"
msgid "Parallel library scan tasks limit"
msgstr "Gräns för parallella biblioteksskanningar"

#, java-printf-format
msgctxt "config_scan_concurrency_summary"
msgid ""
"Maximum number of parallel tasks during library scans. Setting this to 0 "
"will choose a limit based on your systems core count. WARNING: Setting this "
"number too high may cause issues with network file systems; if you encounter"
" problems lower this number."
msgstr ""
"Högsta antal parallella uppgifter vid biblioteksskanningar. Värdet 0 väljer "
"en gräns utifrån systemets antal processorkärnor. Varning: Ett för högt "
"värde kan orsaka problem med nätverksfilsystem. Sänk värdet om problem "
"uppstår."

#, java-printf-format
msgctxt "config_image_encoding_limit"
msgid "Parallel image encoding limit"
msgstr "Gräns för parallell bildkodning"

#, java-printf-format
msgctxt "config_image_encoding_limit_summary"
msgid ""
"Maximum number of image encodings that are allowed to run in parallel. "
"Setting this to 0 will choose a limit based on your systems core count."
msgstr ""
"Högsta antal bildkodningar som får köras parallellt. Värdet 0 väljer en "
"gräns utifrån systemets antal processorkärnor."

#, java-printf-format
msgctxt "config_section_logs"
msgid "Logs"
msgstr "Loggar"

#, java-printf-format
msgctxt "config_activity_retention"
msgid "Days to keep the activity log"
msgstr "Antal dagar som aktivitetsloggen sparas"

#, java-printf-format
msgctxt "config_log_retention"
msgid "Days to keep log files"
msgstr "Antal dagar som loggfiler sparas"

#, java-printf-format
msgctxt "config_slow_response_warning"
msgid "Log a warning message if the server was slow to answer"
msgstr "Logga en varning om servern svarar långsamt"

#, java-printf-format
msgctxt "config_slow_response_threshold"
msgid "Time in ms after which a response is considered slow"
msgstr "Tid i ms efter vilken ett svar räknas som långsamt"
