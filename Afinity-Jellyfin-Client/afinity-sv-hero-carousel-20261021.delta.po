msgctxt "pref_hero_style_title"
msgid "Hero Carousel Style"
msgstr "Stil för huvudkarusell"

msgctxt "hero_style_full_bleed"
msgid "Full-bleed"
msgstr "Kant till kant"

msgctxt "hero_style_peek"
msgid "Peek cards"
msgstr "Delvis synliga kort"

msgctxt "hero_style_inset_card"
msgid "Inset card"
msgstr "Infällt kort"

msgctxt "hero_content_title"
msgid "Spotlight carousel content"
msgstr "Innehåll i framlyft karusell"

msgctxt "hero_content_settings_cd"
msgid "Choose what the spotlight carousel shows"
msgstr "Välj vad som visas i den framlyfta karusellen"

msgctxt "hero_content_group_mode"
msgid "Show"
msgstr "Visa"

msgctxt "hero_content_random"
msgid "Random"
msgstr "Slumpmässigt"

msgctxt "hero_content_random_desc"
msgid "A random mix of unwatched movies and shows."
msgstr "En slumpmässig blandning av osedda filmer och serier."

msgctxt "hero_content_recommended"
msgid "Recommended for you"
msgstr "Rekommenderas för dig"

msgctxt "hero_content_recommended_desc"
msgid ""
"Based on what you watched recently. Shows a random mix until you have some "
"watch history."
msgstr ""
"Baserat på vad du nyligen har sett. Visar en slumpmässig blandning tills du "
"har viss visningshistorik."

msgctxt "hero_content_recently_added"
msgid "Recently added"
msgstr "Nyligen tillagt"

msgctxt "hero_content_recently_added_desc"
msgid "The newest unwatched movies and shows."
msgstr "De senaste osedda filmerna och serierna."

msgctxt "hero_content_collection"
msgid "Collection or playlist"
msgstr "Samling eller spellista"

msgctxt "hero_content_collection_desc"
msgid "Rotate through one collection or video playlist."
msgstr "Växla mellan en samling eller en videospelista."

msgctxt "hero_content_custom_filter"
msgid "Custom filter"
msgstr "Anpassat filter"

msgctxt "hero_content_custom_filter_desc"
msgid ""
"Movies and shows matching the genres, studios or tags you pick, optionally "
"refined further."
msgstr ""
"Filmer och serier som matchar de genrer, studior eller taggar du väljer, med"
" möjlighet till ytterligare avgränsning."

msgctxt "hero_content_group_slides"
msgid "Slides"
msgstr "Bilder"

msgctxt "hero_content_group_filters"
msgid "Filters"
msgstr "Filter"

msgctxt "hero_slide_duration"
msgid "Seconds per slide"
msgstr "Sekunder per bild"
