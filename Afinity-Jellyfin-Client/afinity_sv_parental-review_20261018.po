#, java-printf-format
msgctxt "section_perm_deletion"
msgid "Allow media deletion from"
msgstr "Tillåt borttagning av media från"

#, java-printf-format
msgctxt "perm_deletion_all_libraries"
msgid "All libraries"
msgstr "Alla bibliotek"

#, java-printf-format
msgctxt "perm_syncplay"
msgid "SyncPlay access"
msgstr "SyncPlay-åtkomst"

#, java-printf-format
msgctxt "perm_syncplay_help"
msgid ""
"The SyncPlay feature enables to sync playback with other devices. Select the"
" level of access this user has to the SyncPlay."
msgstr ""
"Funktionen SyncPlay synkroniserar uppspelning med andra enheter. Välj "
"användarens åtkomstnivå till SyncPlay."

#, java-printf-format
msgctxt "perm_syncplay_create_and_join"
msgid "Allow user to create and join groups"
msgstr "Tillåt användaren att skapa och gå med i grupper"

#, java-printf-format
msgctxt "perm_syncplay_join"
msgid "Allow user to join groups"
msgstr "Tillåt användaren att gå med i grupper"

#, java-printf-format
msgctxt "perm_syncplay_none"
msgid "Disabled for this user"
msgstr "Inaktiverad för den här användaren"

#, java-printf-format
msgctxt "perm_bitrate_label"
msgid "Internet streaming bitrate limit (Mbps)"
msgstr "Gräns för bithastighet vid internetströmning (Mbit/s)"

#, java-printf-format
msgctxt "perm_bitrate_hint"
msgid ""
"An optional per-stream bitrate limit for all out of network devices. This is"
" useful to prevent devices from requesting a higher bitrate than your "
"internet connection can handle. This may result in increased CPU load on "
"your server in order to transcode videos on the fly to a lower bitrate. "
"Override the default global value set in server settings, see Control Panel "
"> Playback."
msgstr ""
"En valfri gräns för bithastighet per ström för alla enheter utanför "
"nätverket. Det förhindrar enheter från att begära högre bithastighet än "
"internetanslutningen klarar. Det kan öka processorbelastningen på servern "
"när videor omkodas till lägre bithastighet direkt. Åsidosätter det globala "
"standardvärdet i serverinställningarna, se Kontrollpanelen > Uppspelning."

#, java-printf-format
msgctxt "perm_collections"
msgid "Allow this user to manage collections"
msgstr "Tillåt användaren att hantera samlingar"

#, java-printf-format
msgctxt "perm_subtitles"
msgid "Allow this user to edit subtitles"
msgstr "Tillåt användaren att redigera undertexter"

#, java-printf-format
msgctxt "section_perm_live_tv"
msgid "Feature access"
msgstr "Funktionsåtkomst"

#, java-printf-format
msgctxt "perm_live_tv_access"
msgid "Allow Live TV access"
msgstr "Tillåt åtkomst till direkt-tv"

#, java-printf-format
msgctxt "perm_live_tv_manage"
msgid "Allow Live TV recording management"
msgstr "Tillåt hantering av direkt-tv-inspelningar"

#, java-printf-format
msgctxt "section_perm_remote_control"
msgid "Remote Control"
msgstr "Fjärrstyrning"

#, java-printf-format
msgctxt "perm_control_others"
msgid "Allow remote control of other users"
msgstr "Tillåt fjärrstyrning av andra användare"

#, java-printf-format
msgctxt "perm_shared_devices"
msgid "Allow remote control of shared devices"
msgstr "Tillåt fjärrstyrning av delade enheter"

#, java-printf-format
msgctxt "perm_shared_devices_summary"
msgid ""
"DLNA devices are considered shared until a user begins controlling them."
msgstr ""
"DLNA-enheter betraktas som delade tills en användare börjar styra dem."

#, java-printf-format
msgctxt "section_perm_limits"
msgid "Limits"
msgstr "Gränser"

#, java-printf-format
msgctxt "perm_max_sessions_label"
msgid "Maximum number of simultaneous user sessions"
msgstr "Maximalt antal samtidiga användarsessioner"

#, java-printf-format
msgctxt "perm_max_sessions_hint"
msgid ""
"Set the maximum number of simultaneous user sessions. A value of 0 will "
"disable the feature."
msgstr ""
"Ange maximalt antal samtidiga användarsessioner. Värdet 0 inaktiverar "
"funktionen."

#, java-printf-format
msgctxt "perm_lockout_label"
msgid "Failed login tries before user is locked out"
msgstr "Misslyckade inloggningsförsök före kontolåsning"

#, java-printf-format
msgctxt "perm_lockout_hint"
msgid ""
"Determine how many incorrect login tries can be made before lockout occurs. "
"A value of zero means inheriting the default of three tries for normal users"
" and five for administrators. Setting this to -1 will disable the feature."
msgstr ""
"Ange hur många felaktiga inloggningsförsök som får göras innan kontot låses."
" Värdet 0 ärver standardvärdet, tre försök för vanliga användare och fem för"
" administratörer. Värdet -1 inaktiverar funktionen."

#, java-printf-format
msgctxt "section_perm_devices"
msgid "Device Access"
msgstr "Enhetsåtkomst"

#, java-printf-format
msgctxt "perm_all_devices"
msgid "Enable access from all devices"
msgstr "Aktivera åtkomst från alla enheter"

#, java-printf-format
msgctxt "perm_all_devices_summary"
msgid "When off, only the devices switched on below can sign in."
msgstr "När detta är av kan endast enheterna som aktiverats nedan logga in."

