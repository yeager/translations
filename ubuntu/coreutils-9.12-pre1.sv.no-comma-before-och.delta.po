# Swedish Coreutils review delta
msgid ""
msgstr ""
"Project-Id-Version: coreutils\n"
"Language: sv\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#: src/numfmt.c:979
msgid ""
"      --suffix=SUFFIX\n"
"         add SUFFIX to output numbers,\n"
"         and accept an optional SUFFIX in input numbers\n"
msgstr ""
"      --suffix=SUFFIX\n"
"         lägg till SUFFIX till utskrivna tal\n"
"         och acceptera ett valfritt SUFFIX i indatatal\n"

#: src/numfmt.c:984
msgid ""
"      --unit-separator=SEP\n"
"         insert SEP between number and unit on output,\n"
"         and accept an optional SEP in input numbers\n"
msgstr ""
"      --unit-separator=SEP\n"
"         infoga SEP mellan tal och enhet i utdata\n"
"         och tillåt en eventuell SEP i indatatal\n"

#: src/sort.c:523
msgid ""
"      --debug\n"
"         annotate the part of the line used to sort,\n"
"         and warn about questionable usage to standard error\n"
msgstr ""
"      --debug\n"
"         annotera delarna av raden som används för sortering\n"
"         och varna om tveksam användning till standardfel\n"

#: src/stat.c:1785
msgid ""
"      --printf=FORMAT\n"
"         like --format, but interpret backslash escapes,\n"
"         and do not output a mandatory trailing newline;\n"
"         if you want a newline, include \\n in FORMAT\n"
msgstr ""
"      --printf=FORMAT\n"
"         som --format, men tolka specialkoder med omvända snedstreck\n"
"         och skriv inte ut en obligatorisk avslutande nyrad;\n"
"         om du vill ha en nyrad, ta med \\n i FORMAT\n"
