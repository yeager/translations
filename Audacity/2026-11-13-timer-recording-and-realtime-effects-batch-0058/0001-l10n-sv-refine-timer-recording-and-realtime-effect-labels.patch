 #, c-format
 msgid "Moved %s up in %s"
-msgstr "Flyttade %s upp till %s"
+msgstr "Flyttade %s upp i %s"
 
 #. i18n-hint: undo history record
 #. first parameter - realtime effect name
@@ -9408,7 +9408,7 @@ msgstr "Flyttade %s upp till %s"
 #: src/RealtimeEffectPanel.cpp
 #, c-format
 msgid "Moved %s down in %s"
-msgstr "Flyttade %s ner till %s"
