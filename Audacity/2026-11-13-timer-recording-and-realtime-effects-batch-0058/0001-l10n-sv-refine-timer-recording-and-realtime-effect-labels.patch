 au3/locale/sv.po | 26 +++++++++++++-------------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index fa1b477..f26beea 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
