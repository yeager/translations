@@ -7824,8 +7824,8 @@ msgid ""
 "At 44100 Hz, %d bytes per sample, the estimated number of\n"
 " simultaneous tracks that could be played at once: %.1f\n"
 msgstr ""
-"Vid 44100 Hz och %d byte per sampling är det uppskattade antalet\n"
-" samtidiga spår som kan spelas samtidigt: %.1f\n"
+"Vid 44 100 Hz och %d byte per sample är uppskattat antal\n"
+"spår som kan spelas upp samtidigt: %.1f\n"
 
 #: src/Benchmark.cpp
