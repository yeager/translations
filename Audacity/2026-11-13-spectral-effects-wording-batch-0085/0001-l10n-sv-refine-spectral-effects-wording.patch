Subject: [PATCH] l10n(sv): refine spectral effects wording

---
 au3/locale/sv.po | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 86d2e89..8718ec4 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -19945,7 +19945,7 @@ msgid ""
 msgstr ""
 "~aParametrarna för notchfilter kan inte tillämpas.~%~\n"
 "                      Försök att öka lågfrekvensens gräns~%~\n"
-"                      eller reducera filtret \"Width\"."
+"                      eller minska filtrets bandbredd."
 
 #: plug-ins/SpectralEditMulti.ny plug-ins/SpectralEditParametricEQ.ny
 #: plug-ins/SpectralEditShelves.ny plug-ins/nyquist-plug-in-installer.ny
@@ -19983,7 +19983,7 @@ msgid ""
 "                        For the current track, the high frequency setting cannot~%~\n"
 "                        be greater than ~a Hz"
 msgstr ""
-"~aFrekvensvalet är för högt för spårets samplingshastighet.~%~\n"
+"~aFrekvensvalet är för högt för spårets samplingsfrekvens.~%~\n"
 "                        För det aktuella spåret får inställningen för den höga~%~\n"
 "                        frekvensen inte vara större än ~a Hz"
 
@@ -20071,7 +20071,7 @@ msgstr "Slut (eller start)"
 
 #: plug-ins/adjustable-fade.ny
 msgid "Handy Presets (override controls)"
-msgstr "Praktiska förinställningar (åsidosätter reglage)"
+msgstr "Användbara förinställningar (åsidosätter reglage)"
 
 #: plug-ins/adjustable-fade.ny
 msgid "None Selected"
@@ -20237,7 +20237,7 @@ msgstr "Alternerande in/ut"
 #: plug-ins/crossfadetracks.ny
 #, lisp-format
 msgid "Error.~%Select 2 (or more) tracks to crossfade."
-msgstr "Fel.~%Välj 2 (eller fler) spår att köra crossfade på."
+msgstr "Fel.~%Välj 2 (eller fler) spår att övertona."
 
 #: plug-ins/delay.ny resources/EffectsMenuDefaults.xml
 msgid "Delay"
