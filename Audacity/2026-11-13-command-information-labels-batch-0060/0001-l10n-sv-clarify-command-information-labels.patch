@@ -10396,7 +10396,7 @@ msgstr "Hämtar information i JSON-format."
 
 #: src/commands/GetTrackInfoCommand.cpp
 msgid "Get Track Info"
-msgstr "Hämta spårinfo"
+msgstr "Hämta spårinformation"
 
 #: src/commands/GetTrackInfoCommand.cpp
 msgid "Types:"
@@ -10524,7 +10524,7 @@ msgstr "Sparar ett projekt."
 
 #: src/commands/OpenSaveCommands.h
 msgid "Saves a copy of current project."
-msgstr "Sparar en kopia av nuvarande projekt."
