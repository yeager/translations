From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 17:22:27 +0100
Subject: [PATCH] l10n(sv): refine update and widget wording

---
 au3/locale/sv.po | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 8609a93..86d2e89 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -19605,12 +19605,12 @@ msgstr "Uppdatera Audacity"
 #: src/update/UpdatePopupDialog.cpp
 msgctxt "update dialog"
 msgid "&Skip"
-msgstr "&Avbryt"
+msgstr "&Hoppa över"
 
 #: src/update/UpdatePopupDialog.cpp
 msgctxt "update dialog"
 msgid "&Install update"
-msgstr "&Installera uppdatering"
+msgstr "&Installera uppdateringen"
 
 #. i18n-hint Substitution of version number for %s.
 #: src/update/UpdatePopupDialog.cpp
@@ -19737,7 +19737,7 @@ msgstr "Mätarstil"
 
 #: src/widgets/MeterPanel.cpp
 msgid "Gradient"
-msgstr "Gradient"
+msgstr "Färgövertoning"
 
 #: src/widgets/MeterPanel.cpp
 msgid "Meter Type"
@@ -19745,7 +19745,7 @@ msgstr "Mätartyp"
 
 #: src/widgets/MeterPanel.cpp
 msgid "Orientation"
-msgstr "Orientering"
+msgstr "Riktning"
 
 #: src/widgets/MeterPanel.cpp plug-ins/crossfadetracks.ny
 msgid "Automatic"
@@ -19775,7 +19775,7 @@ msgstr "Projektet kan låta annorlunda än tänkt. %s"
 
 #: src/widgets/MissingPluginsErrorDialog.cpp
 msgid "Learn more"
-msgstr "Lär dig mer"
+msgstr "Läs mer"
 
 #: src/widgets/NumericTextCtrl.cpp
 msgid "(Use context menu to change format.)"
@@ -19790,7 +19790,7 @@ msgstr "%s (%s)"
 #: src/widgets/UnwritableLocationErrorDialog.cpp
 #, c-format
 msgid "Unable to write files to directory: %s."
-msgstr "Det går inte att skriva filer till katalogen: %s."
+msgstr "Det går inte att skriva filer i katalogen: %s."
 
 #. i18n-hint: This message describes the error in the Error dialog.
 #: src/widgets/UnwritableLocationErrorDialog.cpp
@@ -19810,7 +19810,7 @@ msgstr "Inställningar > Kataloger"
 
 #: src/widgets/Warning.cpp
 msgid "Don't show this warning again"
-msgstr "Visa inte denna varning igen"
+msgstr "Visa inte den här varningen igen"
 
 #: src/widgets/numformatter.cpp
 msgid "NaN"
