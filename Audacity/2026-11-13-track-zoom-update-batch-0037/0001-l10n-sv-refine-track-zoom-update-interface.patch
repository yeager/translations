From 7ea2417e0dadfbf308e15831ee204d265f2126bb Mon Sep 17 00:00:00 2001
From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 15:49:51 +0100
Subject: [PATCH] l10n(sv): refine track and update interface text

---
 au3/locale/sv.po | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 161c693..eef5217 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -19435,7 +19435,7 @@ msgstr "Klicka och dra för att flytta ett spår i tid"
 
 #: src/tracks/ui/TimeShiftHandle.cpp
 msgid "Could not shift between tracks"
-msgstr "Kan inte byta mellan spår"
+msgstr "Kunde inte flytta mellan spår"
 
 #: src/tracks/ui/TimeShiftHandle.cpp
 msgid "Moved clips to another track"
@@ -19510,11 +19510,11 @@ msgstr "Klicka för att zooma in, Skift-klicka för att zooma ut"
 
 #: src/tracks/ui/ZoomHandle.cpp
 msgid "Drag to Zoom Into Region, Right-Click to Zoom Out"
-msgstr "Dra för att zooma till område. Högerklicka för att zooma ut"
+msgstr "Dra för att zooma in på ett område, högerklicka för att zooma ut"
 
 #: src/tracks/ui/ZoomHandle.cpp
 msgid "Left=Zoom In, Right=Zoom Out, Middle=Normal"
-msgstr "Vänster=Zooma in, Höger=Zooma ut, Mitten=Återställ"
+msgstr "Vänster = zooma in, höger = zooma ut, mitten = återställ"
 
 #. i18n-hint: Title of the dialog no updates available.
 #: src/update/NoUpdatesAvailableDialog.cpp
@@ -19545,7 +19545,7 @@ msgstr "Fel vid sökning efter uppdateringar"
 #: src/update/UpdateManager.cpp
 msgctxt "update dialog"
 msgid "Unable to connect to Audacity update server."
-msgstr "Kan inte koppla upp mot Audacitys uppdateringsserver."
+msgstr "Det gick inte att ansluta till Audacitys uppdateringsserver."
 
 #: src/update/UpdateManager.cpp
 msgctxt "update dialog"
@@ -19574,7 +19574,7 @@ msgstr "Hämtar %s"
 #. i18n-hint: Title of the app update notice dialog.
 #: src/update/UpdateNoticeDialog.cpp
 msgid "App update checking"
-msgstr "Söker efter programuppdateringar"
+msgstr "Kontroll av programuppdateringar"
 
 #. i18n-hint: The first paragraph of app update notice dialog.
 #: src/update/UpdateNoticeDialog.cpp
@@ -19678,7 +19678,7 @@ msgstr "&Rensa"
 #. of horizontal bumps
 #: src/widgets/Grabber.cpp
 msgid "Grabber"
-msgstr "Greppare"
+msgstr "Draghandtag"
 
 #: src/widgets/Grid.cpp
 msgid "Empty"
@@ -19686,7 +19686,7 @@ msgstr "Tom"
 
 #: src/widgets/KeyView.cpp
 msgid "Menu"
-msgstr "(meny)"
+msgstr "Meny"
 
 #. i18n-hint: Noun (the meter is used for playback or record level monitoring)
 #: src/widgets/MeterPanel.cpp
