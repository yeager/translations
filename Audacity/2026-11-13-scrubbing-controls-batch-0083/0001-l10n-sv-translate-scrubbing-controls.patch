From c9ca52e4b58e0b10bf57ce6c1515eb3fc2d4a526 Mon Sep 17 00:00:00 2001
From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 17:20:47 +0100
Subject: [PATCH] l10n(sv): translate scrubbing controls

---
 au3/locale/sv.po | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index e9209c2..8609a93 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -19335,11 +19335,11 @@ msgstr "Justerade amplitudkurvan."
 #.
 #: src/tracks/ui/Scrubbing.cpp
 msgid "&Scrub"
-msgstr "Aktivera &scrubbing"
+msgstr "&Skrubba"
 
 #: src/tracks/ui/Scrubbing.cpp
 msgid "Scrubbing"
-msgstr "Scrubbing"
+msgstr "Skrubbning"
 
 #: src/tracks/ui/Scrubbing.cpp
 msgid "Seeking"
@@ -19351,7 +19351,7 @@ msgstr "Söker"
 #.
 #: src/tracks/ui/Scrubbing.cpp
 msgid "Scrub &Ruler"
-msgstr "Scrub&linjal"
+msgstr "Skrubb&linjal"
 
 #: src/tracks/ui/Scrubbing.cpp
 msgid "Playing at Speed"
@@ -19363,19 +19363,19 @@ msgstr "Flytta muspekaren för att söka"
 
 #: src/tracks/ui/Scrubbing.cpp
 msgid "Move mouse pointer to Scrub"
-msgstr "Flytta muspekaren för att använda scrubbing"
+msgstr "Flytta muspekaren för att skrubba"
 
 #: src/tracks/ui/Scrubbing.cpp
 msgid "Scru&bbing"
-msgstr "Scru&bbing"
+msgstr "Skr&ubbning"
 
 #: src/tracks/ui/Scrubbing.cpp
 msgid "Scrub Bac&kwards"
-msgstr "Spola &bakåt"
+msgstr "Skrubba &bakåt"
 
 #: src/tracks/ui/Scrubbing.cpp
 msgid "Scrub For&wards"
-msgstr "Spola &framåt"
+msgstr "Skrubba &framåt"
 
 #: src/tracks/ui/SelectHandle.cpp
 msgid "Click and drag to move left selection boundary."
@@ -19470,7 +19470,7 @@ msgstr "Öppna meny..."
 #. i18n-hint: Command names a modifier key on Macintosh keyboards
 #: src/tracks/ui/TrackSelectHandle.cpp
 msgid "Command+Click"
-msgstr "Command-klick"
+msgstr "Cmd-klick"
 
 #. i18n-hint: Ctrl names a modifier key on Windows or Linux keyboards
 #: src/tracks/ui/TrackSelectHandle.cpp
