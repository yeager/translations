From 0e129e4f88819f98ef4630e82bb2196db448219f Mon Sep 17 00:00:00 2001
From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 16:56:52 +0100
Subject: [PATCH] l10n(sv): refine export wording

---
 au3/locale/sv.po | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index a9998cd..4beb230 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -14363,7 +14363,7 @@ msgstr "Exportera flera filer"
 
 #: src/export/ExportAudioDialog.cpp
 msgid "Export current selection"
-msgstr "Exportera nuvarande urval"
+msgstr "Exportera aktuell markering"
 
 #: src/export/ExportAudioDialog.cpp
 msgid "Trim blank space before first clip"
@@ -14433,7 +14433,7 @@ msgstr "Allt markerat ljud är avstängt."
 
 #: src/export/ExportAudioDialog.cpp
 msgid "Continue to export remaining files?"
-msgstr "Fortsätt för att exportera återstående filer?"
+msgstr "Fortsätt exportera återstående filer?"
 
 #: src/export/ExportFilePanel.cpp
 msgid "Custom Sample Rate"
@@ -14492,7 +14492,7 @@ msgstr "Samplings&frekvens"
 
 #: src/export/ExportFilePanel.cpp
 msgid "Choose a location to save the exported files"
-msgstr "Välj en plats att spara de exporterade filerna"
+msgstr "Välj en plats där de exporterade filerna ska sparas"
 
 #: src/export/ExportFilePanel.cpp
 msgid "Advanced Mixing Options"
@@ -14624,7 +14624,7 @@ msgstr "&Importera"
 
 #: src/import/RawAudioGuess.cpp
 msgid "Bad data size. Could not import audio"
-msgstr "Fel datastorlek. Kan inte importera ljud"
+msgstr "Fel datastorlek. Kunde inte importera ljud"
 
 #. i18n-hint:
 #. First %s is replaced with the noun "start" or "end"
