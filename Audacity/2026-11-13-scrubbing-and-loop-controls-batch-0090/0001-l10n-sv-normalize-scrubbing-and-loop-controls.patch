From 5742084965686f7696e97236d47850ca06c5ce13 Mon Sep 17 00:00:00 2001
From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 17:36:38 +0100
Subject: [PATCH] l10n(sv): normalize scrubbing and loop controls

---
 au3/locale/sv.po | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 5eccaf6..a425a9f 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -6444,7 +6444,7 @@ msgstr "Ingen versionsidentifierare angavs"
 #: src/AboutDialog.cpp
 #, c-format
 msgid "%s, system administration"
-msgstr "%s, system administration"
+msgstr "%s, systemadministration"
 
 #. i18n-hint: For "About Audacity..." credits, substituting a person's proper name
 #: src/AboutDialog.cpp
@@ -6850,7 +6850,7 @@ msgstr "Klicka eller dra för att börja söka"
 #.
 #: src/AdornedRulerPanel.cpp
 msgid "Click or drag to begin Scrub"
-msgstr "Klicka eller dra för att börja snabblyssna"
+msgstr "Klicka eller dra för att börja skrubba"
 
 #. i18n-hint: These commands assist the user in finding a sound by ear. ...
 #. "Scrubbing" is variable-speed playback, ...
@@ -6858,7 +6858,7 @@ msgstr "Klicka eller dra för att börja snabblyssna"
 #.
 #: src/AdornedRulerPanel.cpp
 msgid "Click & move to Scrub. Click & drag to Seek."
-msgstr "Klicka och flytta för att snabblyssna. Klicka och dra för att söka."
+msgstr "Klicka och flytta för att skrubba. Klicka och dra för att söka."
 
 #. i18n-hint: These commands assist the user in finding a sound by ear. ...
 #. "Scrubbing" is variable-speed playback, ...
@@ -6874,7 +6874,7 @@ msgstr "Flytta för att söka"
 #.
 #: src/AdornedRulerPanel.cpp
 msgid "Move to Scrub"
-msgstr "Flytta för att snabblyssna"
+msgstr "Flytta för att skrubba"
 
 #: src/AdornedRulerPanel.cpp
 msgid "Drag to Seek. Release to stop seeking."
@@ -6882,11 +6882,11 @@ msgstr "Dra för att söka. Släpp för att sluta söka."
 
 #: src/AdornedRulerPanel.cpp
 msgid "Drag to Seek. Release and move to Scrub."
-msgstr "Dra för att söka. Släpp och flytta för att snabblyssna."
+msgstr "Dra för att söka. Släpp och flytta för att skrubba."
 
 #: src/AdornedRulerPanel.cpp
 msgid "Move to Scrub. Drag to Seek."
-msgstr "Flytta för att snabblyssna. Dra för att söka."
+msgstr "Flytta för att skrubba. Dra för att söka."
 
 #: src/AdornedRulerPanel.cpp
 msgid "Quick-Play disabled"
@@ -6912,7 +6912,7 @@ msgstr "Taktslag och takter"
 
 #: src/AdornedRulerPanel.cpp
 msgid "Setting a loop region also makes an audio selection"
-msgstr "Att ställa in en loopregion gör också ett ljudval"
+msgstr "När du anger ett slingområde skapas även en ljudmarkering"
 
 #. i18n-hint Clear is a verb
 #: src/AdornedRulerPanel.cpp
@@ -6921,7 +6921,7 @@ msgstr "Rensa slinga"
 
 #: src/AdornedRulerPanel.cpp
 msgid "Set Loop To Selection"
-msgstr "Ange slinga efter markering"
+msgstr "Anpassa slingan till markeringen"
 
 #: src/AdornedRulerPanel.cpp
 msgid "Scroll view to playhead"
