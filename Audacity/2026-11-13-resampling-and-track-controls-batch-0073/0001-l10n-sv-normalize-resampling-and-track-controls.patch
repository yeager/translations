From 12607f8da49c890567fd75b33b1aab63bcdc3e8a Mon Sep 17 00:00:00 2001
From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 17:01:58 +0100
Subject: [PATCH] l10n(sv): normalize resampling and track controls

---
 au3/locale/sv.po | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 5c3ea99..76be177 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -15924,15 +15924,15 @@ msgstr "Det angivna värdet är ogiltigt"
 #: src/menus/TrackMenus.cpp
 #, c-format
 msgid "Resampling track %d"
-msgstr "Återsamplar spår %d"
+msgstr "Samplar om spår %d"
 
 #: src/menus/TrackMenus.cpp
 msgid "Resampled audio track(s)"
-msgstr "Återsamplade ljudspår"
+msgstr "Samplade om ljudspår"
 
 #: src/menus/TrackMenus.cpp
 msgid "Resample Track"
-msgstr "Återsampla spår"
+msgstr "Sampla om spår"
 
 #: src/menus/TrackMenus.cpp
 msgid "Please select at least one audio track and one MIDI track."
@@ -16018,11 +16018,11 @@ msgstr "Slå &på ljud för alla spår"
 
 #: src/menus/TrackMenus.cpp
 msgid "Mut&e Tracks"
-msgstr "Däm&pa spår"
+msgstr "Tysta spå&r"
 
 #: src/menus/TrackMenus.cpp
 msgid "U&nmute Tracks"
-msgstr "Slå &på spår"
+msgstr "Slå &på ljudet för spår"
 
 #: src/menus/TrackMenus.cpp
 msgid "&Pan"
@@ -16086,7 +16086,7 @@ msgstr "Efter &namn"
 
 #: src/menus/TrackMenus.cpp
 msgid "Keep tracks synchronized (Sync-&Lock)"
-msgstr "Håll spår synkroniserade (Sync-&Lock)"
+msgstr "Håll spår synkroniserade (synkroniserings&lås)"
 
 #: src/menus/TrackMenus.cpp
 msgid "&Track"
