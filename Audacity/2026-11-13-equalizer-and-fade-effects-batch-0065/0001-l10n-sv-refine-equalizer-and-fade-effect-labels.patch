From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 16:47:09 +0100
Subject: [PATCH] l10n(sv): refine equalizer and fade effect labels

---
 au3/locale/sv.po | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 4e77579..f79c6b4 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -12573,7 +12573,7 @@ msgstr "Den begärda kurvan hittades inte. ”Namnlös” används i stället."
 
 #: src/effects/EqualizationUI.cpp
 msgid "Curve not found"
-msgstr "Hittade inte kurva"
+msgstr "Kurvan hittades inte"
 
 #: src/effects/Fade.cpp resources/EffectsMenuDefaults.xml
 msgid "Fade In"
@@ -12585,11 +12585,11 @@ msgstr "Tona ut"
 
 #: src/effects/Fade.cpp
 msgid "Applies a linear fade-in to the selected audio"
-msgstr "Tillämpar en linjär intoning för markerat ljud"
+msgstr "Tillämpar en linjär intoning av det markerade ljudet"
 
 #: src/effects/Fade.cpp
 msgid "Applies a linear fade-out to the selected audio"
-msgstr "Tillämpar en linjär uttoningseffekt på det markerade ljudet"
+msgstr "Tillämpar en linjär uttoning av det markerade ljudet"
 
 #: src/effects/FindClipping.cpp
 msgid "Find Clipping"
@@ -12624,7 +12624,7 @@ msgstr "Sl&uttröskelvärde (samplar):"
 
 #: src/effects/Generator.cpp
 msgid "There is not enough room available to generate the audio"
-msgstr "Det finns inte tillräcklig plats att skapa ljud"
+msgstr "Det finns inte tillräckligt med utrymme för att generera ljudet"
 
 #: src/effects/Invert.cpp resources/EffectsMenuDefaults.xml
 msgid "Invert"
@@ -12632,7 +12632,7 @@ msgstr "Invertera"
 
 #: src/effects/Invert.cpp
 msgid "Flips the audio samples upside-down, reversing their polarity"
-msgstr "Vänder uppochned på ljudsamplingarna och vänder på deras polaritet"
+msgstr "Vänder ljudsamplarna upp och ned och inverterar deras polaritet"
 
 #: src/effects/LegacyCompressor.cpp resources/EffectsMenuDefaults.xml
 msgid "Legacy Compressor"
