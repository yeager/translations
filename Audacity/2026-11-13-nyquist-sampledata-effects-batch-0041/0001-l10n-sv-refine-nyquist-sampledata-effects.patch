diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 2d16f37..233eb86 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -21018,7 +21018,7 @@ msgstr "Indexerad tid"
 
