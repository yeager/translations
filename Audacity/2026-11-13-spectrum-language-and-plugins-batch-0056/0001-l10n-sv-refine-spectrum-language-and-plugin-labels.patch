 #: src/MixerBoard.cpp
 #: src/tracks/playabletrack/notetrack/ui/NoteTrackSliderHandles.cpp
 msgid "Moved velocity slider"
-msgstr "Flyttade hastighetsreglaget"
+msgstr "Flyttade anslagsstyrkereglaget"
 
 #: src/MixerBoard.cpp
 #: src/tracks/playabletrack/wavetrack/ui/WaveTrackSliderHandles.cpp
@@ -8697,7 +8697,7 @@ msgstr "Hantera insticksmoduler"
 
 #: src/PluginRegistrationDialog.cpp
 msgid "Native Audacity"
-msgstr "Ursprunglig Audacity"
+msgstr "Audacitys inbyggda"
 
 #: src/PluginRegistrationDialog.cpp
 msgid "&Show:"
@@ -8725,7 +8725,7 @@ msgstr "Åter&skanna"
 
 #: src/PluginRegistrationDialog.cpp
 msgid "&Get more effects..."
-msgstr "&Hämta mer effekter..."
+msgstr "&Hämta fler effekter..."
 
 #: src/PluginStartupRegistration.cpp
 msgid "Searching for plugins"
