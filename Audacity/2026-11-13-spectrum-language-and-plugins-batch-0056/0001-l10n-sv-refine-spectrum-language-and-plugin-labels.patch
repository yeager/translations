 au3/locale/sv.po | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index c2826fc..59e340b 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -8174,7 +8174,7 @@ msgstr "För mycket ljud har valts. Endast de första %.1f sekunderna av ljud ko
 
 #: src/FreqWindow.cpp
 msgid "Not enough data selected."
-msgstr "Inte tillräckligt mycket data har markerats."
+msgstr "För lite data har markerats."
 
 #. i18n-hint: short form of 'seconds'.
 #: src/FreqWindow.cpp src/effects/AutoDuck.cpp
@@ -8221,7 +8221,7 @@ msgstr "Frekvens (Hz)\tNivå (dB)"
 
 #: src/FreqWindow.cpp
 msgid "Lag (seconds)\tFrequency (Hz)\tLevel"
-msgstr "Lagg (sekunder)\tFrekvens (Hz)\tNivå"
+msgstr "Fördröjning (sekunder)\tFrekvens (Hz)\tNivå"
 
 #: src/FreqWindow.cpp
 msgid "Plot Spectrum..."
