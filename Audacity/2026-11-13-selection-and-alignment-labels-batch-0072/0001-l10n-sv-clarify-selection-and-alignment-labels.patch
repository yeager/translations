From 321e1b23f7b89458d2e3a9ccd7e4cc247a0136ff Mon Sep 17 00:00:00 2001
From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 16:59:51 +0100
Subject: [PATCH] l10n(sv): clarify selection and alignment labels

---
 au3/locale/sv.po | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 75738bf..5c3ea99 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -15539,7 +15539,7 @@ msgstr "Från spårets &början till markören"
 
 #: src/menus/SelectMenus.cpp
 msgid "Select Track Start to Cursor"
-msgstr "Från spårets &början till markören"
+msgstr "Markera från spårets &början till markören"
 
 #: src/menus/SelectMenus.cpp
 msgid "Cursor to Track &End"
@@ -15547,7 +15547,7 @@ msgstr "Från markören till spårets &slut"
 
 #: src/menus/SelectMenus.cpp
 msgid "Select Cursor to Track End"
-msgstr "Från markören till spårets &slut"
+msgstr "Markera från markören till spårets &slut"
 
 #: src/menus/SelectMenus.cpp
 msgid "Track Start to En&d"
@@ -15846,11 +15846,11 @@ msgstr "Justerade början till markeringens slut"
 
 #: src/menus/TrackMenus.cpp
 msgid "Aligned/Moved end to cursor/selection start"
-msgstr "Justerade/flyttade slutet till markören/markerings början"
+msgstr "Justerade/flyttade slutet till markören/markeringens början"
 
 #: src/menus/TrackMenus.cpp
 msgid "Aligned end to cursor/selection start"
-msgstr "Justerade slutet till markören/markerings början"
+msgstr "Justerade slutet till markören/markeringens början"
 
 #: src/menus/TrackMenus.cpp
 msgid "Align/Move End"
