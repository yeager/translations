+++ b/au3/locale/sv.po
@@ -16636,7 +16636,7 @@ msgstr ""
 
 #: src/prefs/DirectoriesPrefs.cpp
 msgid "Directory creation failed."
-msgstr "Skapandet av katalog misslyckades."
+msgstr "Kunde inte skapa katalogen."
 
 #: src/prefs/DirectoriesPrefs.cpp
 #, c-format
@@ -16675,7 +16675,7 @@ msgstr "Uppdatera temporär katalog"
 
 #: src/prefs/DirectoriesPrefs.cpp
 msgid "'Open' directory cannot be set."
-msgstr "'Öppen' katalog kan inte ställas in."
+msgstr "Katalogen ”Öppna” kan inte ställas in."
 
 #: src/prefs/DirectoriesPrefs.cpp
 msgid "'Save' directory cannot be set."
@@ -16691,7 +16691,7 @@ msgstr "'Exportera' katalog kan inte ställas in."
 
 #: src/prefs/DirectoriesPrefs.cpp
 msgid "'Macro Output' directory cannot be set."
-msgstr "'Makro Output' katalog kan inte ställas in."
+msgstr "Katalogen ”Makroutdata” kan inte ställas in."
 
 #: src/prefs/EffectsPrefs.cpp
 msgid "Add new location"
