From 3037d811993e11124a5aab636c300fe8ad05cea9 Mon Sep 17 00:00:00 2001
From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 16:37:39 +0100
Subject: [PATCH] l10n(sv): refine track controls and command labels

---
 au3/locale/sv.po | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index f26beea..cf591f1 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -10018,7 +10018,7 @@ msgstr "Spårpanel"
 #. i18n-hint Esc is a key on the keyboard
 #: src/TrackPanel.cpp
 msgid "(Esc to cancel)"
-msgstr "(ESC för att avbryta)"
+msgstr "(Esc för att avbryta)"
 
 #: src/TrackPanelAx.cpp
 msgid "TrackView"
@@ -10058,15 +10058,15 @@ msgstr "Spår %d"
 
 #: src/TrackPanelAx.cpp
 msgid " Mute On"
-msgstr " Tystning på"
+msgstr " Tystning aktiverad"
 
 #: src/TrackPanelAx.cpp
 msgid " Solo On"
-msgstr " Solo på"
+msgstr " Solo aktiverat"
 
 #: src/TrackPanelAx.cpp
 msgid " Select On"
-msgstr " Markering på"
+msgstr " Markering aktiverad"
 
 #: src/TrackPanelResizeHandle.cpp
 msgid "Click and drag to adjust relative size of stereo tracks, double-click to make heights equal"
@@ -10243,7 +10243,7 @@ msgstr "%s är inte en parameter som accepteras av %s"
 #: src/commands/Command.cpp
 #, c-format
 msgid "Invalid value for parameter '%s': should be %s"
-msgstr "Ogiltigt värde parametern \"%s\": Den bör vara %s"
+msgstr "Ogiltigt värde för parametern \"%s\": Det ska vara %s"
 
 #: src/commands/CompareAudioCommand.cpp
 msgid "Compare Audio"
@@ -10316,7 +10316,7 @@ msgstr "Till Y:"
 
 #: src/commands/DragCommand.cpp src/commands/SelectCommand.cpp
 msgid "Relative To:"
-msgstr "Relativt till:"
+msgstr "I förhållande till:"
 
 #: src/commands/DragCommand.cpp
 msgid "Move Mouse..."
