-msgstr "Signed 16 bit PCM"
+msgstr "Signerad 16-bitars PCM"
 
 #: modules/import-export/mod-pcm/ImportPCM.cpp
 msgid "Signed 24 bit PCM"
-msgstr "Signed 24 bit PCM"
+msgstr "Signerad 24-bitars PCM"
 
