-msgstr "Signed 32 bit PCM"
+msgstr "Signerad 32-bitars PCM"
 
 #: modules/import-export/mod-pcm/ImportPCM.cpp
 msgid "Unsigned 8 bit PCM"
-msgstr "Unsigned 8 bit PCM"
+msgstr "Osignerad 8-bitars PCM"
 
 #: modules/import-export/mod-pcm/ImportPCM.cpp
 #: modules/import-export/mod-wavpack/ExportWavPack.cpp
 msgid "32 bit float"
-msgstr "32 bit float"
+msgstr "32-bitars flyttal"
 
 #: modules/import-export/mod-pcm/ImportPCM.cpp
