 #, c-format
@@ -20564,9 +20558,8 @@ msgstr ""
 "                  Endast ett ljud upptäckt."
 
 #: plug-ins/legacy-limiter.ny resources/EffectsMenuDefaults.xml
-#, fuzzy
 msgid "Legacy Limiter"
-msgstr "VO Limiter"
+msgstr "Äldre begränsare"
 
 #: plug-ins/legacy-limiter.ny
 msgid "Soft Limit"
@@ -21448,9 +21441,8 @@ msgid "Spectral Tools"
 msgstr "Spektralverktyg"
 
 #: resources/EffectsMenuDefaults.xml
-#, fuzzy
 msgid "Legacy"
-msgstr "Legal"
+msgstr "Äldre"
 
 #~ msgctxt "clip name template"
 #~ msgid "%s %i"
