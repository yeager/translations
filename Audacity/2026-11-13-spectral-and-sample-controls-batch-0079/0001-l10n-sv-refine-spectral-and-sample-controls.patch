From f84b61ed7aa0308b52505c5fed8c508729332ac9 Mon Sep 17 00:00:00 2001
From: Daniel Nylander <github@danielnylander.se>
Date: Fri, 13 Nov 2026 17:11:52 +0100
Subject: [PATCH] l10n(sv): refine spectral and sample controls

---
 au3/locale/sv.po | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/au3/locale/sv.po b/au3/locale/sv.po
index 0ea5d80..2ccb4e0 100644
--- a/au3/locale/sv.po
+++ b/au3/locale/sv.po
@@ -18320,7 +18320,7 @@ msgstr "Bandbredd"
 #. for selecting a frequency range of audio
 #: src/toolbars/SpectralSelectionBar.cpp
 msgid "Spe&ctral Selection Toolbar"
-msgstr "Verktygsfält för spektrums&markering"
+msgstr "Verktygsfält för spektral &markering"
 
 #: src/toolbars/TimeSignatureToolBar.cpp
 msgid "Time Signature"
@@ -18490,7 +18490,7 @@ msgstr "Dra en eller flera etikettgränser."
 
 #: src/tracks/labeltrack/ui/LabelGlyphHandle.cpp
 msgid "Drag label boundary."
-msgstr "Dra gräns för etikett."
+msgstr "Dra etikettgränsen."
 
 #: src/tracks/labeltrack/ui/LabelGlyphHandle.cpp
 #: src/tracks/labeltrack/ui/LabelTrackView.cpp
@@ -18635,7 +18635,7 @@ msgstr "Klicka för att återställa klippets tonhöjd."
 
 #: src/tracks/playabletrack/wavetrack/ui/ClipPitchAndSpeedButtonHandle.cpp
 msgid "Click to change clip pitch, Cmd + click to reset."
-msgstr "Klicka för att ändra klippets tonhöjd, Cmd + klicka för att återställa."
+msgstr "Klicka för att ändra klippets tonhöjd. Cmd-klicka för att återställa."
 
 #: src/tracks/playabletrack/wavetrack/ui/ClipPitchAndSpeedButtonHandle.cpp
 msgid "Click to change clip pitch, Ctrl + click to reset."
@@ -18712,11 +18712,11 @@ msgstr "Ändrad tonhöjd"
 
 #: src/tracks/playabletrack/wavetrack/ui/SampleHandle.cpp
 msgid "Click and drag to edit the samples"
-msgstr "Klicka och dra för att redigera samplingar"
+msgstr "Klicka och dra för att redigera samplar"
 
 #: src/tracks/playabletrack/wavetrack/ui/SampleHandle.cpp
 msgid "To use Draw, zoom in further until you can see the individual samples."
-msgstr "För att använda Rita, zooma in ytterligare tills du ser de individuella ljudsamplingarna."
+msgstr "För att använda Rita, zooma in ytterligare tills du ser de enskilda samplarna."
 
 #: src/tracks/playabletrack/wavetrack/ui/SampleHandle.cpp
 msgid "Moved Samples"
