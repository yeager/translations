msgstr "Del av ett rörnamn i din paste-konfigurationsfil med tjänstenamnet borttaget. Om ditt paste-avsnittsnamn är till exempel [pipeline:glance-api-keystone], använd värdet \"keystone\""

msgid "Path to the directory where json metadata files are stored"
msgstr "Sökväg till katalogen där json-metadatafiler lagras"

msgid "Plugin name '%(plugin)s' should match artifact typename '%(name)s'"
msgstr "Insticksmodulens namn \"%(plugin)s\" bör matcha artefaktens typnamn \"%(name)s\""

msgid "Pointer `%s` contains \"~\" not part of a recognized escape sequence."
msgstr "Pekaren '%s' innehåller \"~\" som inte är ett accepterat specialtecken."

msgid "Pointer `%s` contains adjacent \"/\"."
msgstr "Pekaren '%s' innehåller intilliggande \"/\"."

