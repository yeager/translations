msgstr "Pekaren '%s' innehåller ingen giltig bricka."

msgid "Pointer `%s` does not start with \"/\"."
msgstr "Pekaren '%s' börjar inte med \"/\"."

msgid "Pointer `%s` end with \"/\"."
msgstr "Pekaren '%s' slutar med \"/\"."

msgid "Pointer contains '~' which is not part of a recognized escape sequence [~0, ~1]."
msgstr "Pekaren innehåller \"~\", vilket inte är en del av en accepterad specialsekvens [~0, ~1]."

msgid "Port \"%s\" is not valid."
msgstr "Port \"%s\" är ogiltig."

msgid "Port the registry server is listening on."
msgstr "Port som registerservern lyssnar på."

msgid "Prerelease numeric component is too large (%d characters max)"
msgstr "För-release numerisk komponent är för stor (%d tecken max)"

msgid "Private key file to use when starting API server securely."
msgstr "Privat nyckelfil att använda vid säker start av API-server."

msgid "Process %d not running"
msgstr "Processen %d körs inte"

msgid "Properties %s must be set prior to saving data."
msgstr "Egenskaperna %s måste sättas innan data sparas."

msgid "Property %(property_name)s does not start with the expected resource type association prefix of '%(prefix)s'."
msgstr "Egenskapen %(property_name)s börjar inte med det förväntade resurstyps-associationsprefixet '%(prefix)s'."

msgid "Property %s already present."
msgstr "Egenskapen %s finns redan."

msgid "Property %s does not exist."
msgstr "Egenskapen %s finns inte."

msgid "Property %s may not be removed."
msgstr "Egenskapen %s får inte tas bort."

msgid "Property %s must be set prior to saving data."
msgstr "Egenskapen %s måste sättas innan data sparas."

msgid "Property '%(name)s' may not have value '%(val)s': %(msg)s"
msgstr "Egenskapen \"%(name)s\" får inte ha värdet \"%(val)s\": %(msg)s"

msgid "Property '%s' is protected"
msgstr "Egenskapen '%s' är skyddad"

msgid "Property names can't contain 4 byte unicode."
msgstr "Egenskapsnamn får inte innehålla 4-byte unicode."

msgid "Property protection on operation %(operation)s for rule %(rule)s is not found. No role will be allowed to perform this operation."
msgstr "Egenskapsskydd för åtgärden %(operation)s för regeln %(rule)s hittas inte. Ingen roll kommer tillåtas utföra den här åtgärden."

msgid "Property's %(prop)s value has not been found"
msgstr "Egenskapens %(prop)s-värde hittades inte"

msgid "Provided image size must match the stored image size. (provided size: %(ps)d, stored size: %(ss)d)"
msgstr "Angiven bildstorlek måste stämma överens med den lagrade bildens storlek. (angiven storlek: %(ps)d, lagrad storlek: %(ss)d)"

msgid "Provided object does not match schema '%(schema)s': %(reason)s"
msgstr "Givet objekt matchar inte schemat \"%(schema)s\": %(reason)s"

msgid "Provided status of task is unsupported: %(status)s"
msgstr "Given status för uppgiften stöds inte: %(status)s"

msgid "Provided type of task is unsupported: %(type)s"
msgstr "Given uppgiftstyp stöds inte: %(type)s"

msgid "Provides a user friendly description of the namespace."
msgstr "Tillhandahåller en användarvänlig beskrivning av namnrymden."

msgid "Public images do not have members."
msgstr "Offentliga bilder har inte medlemmar."

msgid "Public url to use for versions endpoint. The default is None, which will use the request's host_url attribute to populate the URL base. If Glance is operating behind a proxy, you will want to change this to represent the proxy's URL."
msgstr "Offentlig webbaddress att använda för versionsbestämning. Förvalet är Ingen, vilket kommer använda begärans host_url-attribut för att fylla i webbaddressen. Om Glance körs bakom en proxy bör du ändra det här till proxyns webbaddress."

msgid "Python module path of data access API"
msgstr "Python-modulsökväg för dataåtkomst-API"

msgid "Received invalid HTTP redirect."
msgstr "Tog emot en ogiltig HTTP-omdirigering."

msgid "Redirecting to %(uri)s for authorization."
msgstr "Omdirigerar till %(uri)s för behörighetskontroll."

msgid "Registry service can't use %s"
msgstr "Registertjänsten får inte använda %s"

msgid "Registry was not configured correctly on API server. Reason: %(reason)s"
msgstr "Registret var felkonfigurerat på API-server. Anledning: %(reason)s"

msgid "Relation %(name)s may not have multiple values"
msgstr "Relationen %(name)s får inte ha flera värden"

msgid "Reload of %(serv)s not supported"
msgstr "Omladdning av %(serv)s stöds inte"

msgid "Reloading %(serv)s (pid %(pid)s) with signal(%(sig)s)"
msgstr "Laddar om %(serv)s (pid %(pid)s) med signal(%(sig)s)"

msgid "Removing stale pid file %s"
msgstr "Tar bort gammal pid-fil %s"

msgid "Request body must be a JSON array of operation objects."
msgstr "Begärans nyttolast måste vara en JSON-array med åtgärdsobjekt."

msgid "Request must be a list of commands"
msgstr "Begäran måste vara en lista med kommandon"

msgid "Required image properties for signature verification do not exist. Cannot verify signature."
msgstr "Nödvändiga avbildsegenskaper för signaturverifiering finns inte. Kan inte verifiera signatur."

msgid "Required store %s is invalid"
msgstr "Begärd lagring %s är ogiltig"

msgid "Resource type names should be aligned with Heat resource types whenever possible: http://docs.openstack.org/developer/heat/template_guide/openstack.html"
msgstr "Resurstypnamn bör stämma överens med Heat-resurstyper när det är möjligt: http://docs.openstack.org/developer/heat/template_guide/openstack.html"

msgid "Response from Keystone does not contain a Glance endpoint."
msgstr "Svar från Keystone innehåller inte en Glance-slutpunkt."

msgid "Role used to identify an authenticated user as administrator."
msgstr "Roll som används för att identifiera en autentiserad användare som administratör."

msgid "Run as a long-running process. When not specified (the default) run the scrub operation once and then exits. When specified do not exit and run scrub on wakeup_time interval as specified in the config."
msgstr "Kör som en långkörningsprocess. När det inte anges (förval), kör skrubbningsåtgärden en gång och avsluta sedan. När det anges, avsluta inte och kör scrub på wakeup_time-intervallet som finns angivet i konfigurationen."

msgid "Scope of image accessibility"
msgstr "Omfattning av avbildningens tillgänglighet"

msgid "Scope of namespace accessibility."
msgstr "Omfattning av namnrymdens tillgänglighet."

msgid "Secret key to use to sign Glance API and Glance Registry services tracing messages."
msgstr "Hemlig nyckel som används för att signera Glance-API och Glance Registry-tjänster som spårar meddelanden."

msgid "Server %(serv)s is stopped"
msgstr "Servern %(serv)s har stoppats"

msgid "Server worker creation failed: %(reason)s."
msgstr "Kunde inte skapa serverarbetare: %(reason)s."

msgid "Set a system wide quota for every user. This value is the total capacity that a user can use across all storage systems. A value of 0 means unlimited.Optional unit can be specified for the value. Accepted units are B, KB, MB, GB and TB representing Bytes, KiloBytes, MegaBytes, GigaBytes and TeraBytes respectively. If no unit is specified then Bytes is assumed. Note that there should not be any space between value and unit and units are case sensitive."
msgstr "Ange en systemomfattande kvot för varje användare. Detta värdet är den totala kapacitet som en användare kan använda, spritt över alla lagringssystem. Värdet 0 innebär obegränsat.Valfri enhet kan specificeras för värdet. Accepterade enheter är B, KB, MB, GB och TB, som representerar Byte, KiloByte, MegaByte, GigaByte, respektive TeraByte. Om ingen enhet anges antas Byte. Observera att det inte bör finnas blanksteg mellan värdet och enheten, samt att enheter är skiftlägeskänsliga."

msgid "Show level %(shl)s is not supported in this operation"
msgstr "Visningsnivå %(shl)s stöds inte för den här åtgärden"

msgid "Signature verification failed"
msgstr "Signaturen kunde inte verifieras"

msgid "Signature verification failed."
msgstr "Signaturverifiering misslyckades."

msgid "Size of image file in bytes"
msgstr "Bildfilens storlek i byte"

msgid "Some resource types allow more than one key / value pair per instance.  For example, Cinder allows user and image metadata on volumes. Only the image properties metadata is evaluated by Nova (scheduling or drivers). This property allows a namespace target to remove the ambiguity."
msgstr "Vissa resurstyper tillåter fler än ett nyckel-/värdepar per instans. Till exempel Cinder tilllåter användar- och bildmetadata på volymer. Bara bildegenskapers metadata utvärderas av Nova (schemaläggning eller drivrutiner). Denna egenskap tillåter en namnrymd att ta bort tvetydigheten."

msgid "Sort direction supplied was not valid."
msgstr "Given sorteringsriktning var inte giltig."

msgid "Sort key supplied was not valid."
msgstr "Given sorteringsnyckel var inte giltig."

msgid "Specifies the prefix to use for the given resource type. Any properties in the namespace should be prefixed with this prefix when being applied to the specified resource type. Must include prefix separator (e.g. a colon :)."
msgstr "Anger vilket prefix som ska användas för den givna resurstypen. Egenskaper i namnrymden bör få detta prefix när de tillämpas på den angivna resurstypen. Måste inkludera prefixavdelare (t.ex. kolon :)."

msgid "Specifies which task executor to be used to run the task scripts."
msgstr "Specificerar vilken uppgiftskörare som ska användas för att hantera uppgiftens skript."

msgid "Status must be \"pending\", \"accepted\" or \"rejected\"."
msgstr "Status måste vara \"pending\", \"accepted\" eller \"rejected\"."

msgid "Status not specified"
msgstr "Status inte angiven"

msgid "Status of the image"
msgstr "Bildens status"

msgid "Status transition from %(cur_status)s to %(new_status)s is not allowed"
msgstr "Statusövergång från %(cur_status)s till %(new_status)s tillåts inte"

msgid "Stopping %(serv)s (pid %(pid)s) with signal(%(sig)s)"
msgstr "Stoppar %(serv)s (pid %(pid)s) med signal(%(sig)s)"

msgid "Store for image_id not found: %s"
msgstr "Lagring för image_id hittades inte: %s"

msgid "Store for scheme %s not found"
msgstr "Lagring för schema %s hittades inte"

msgid "Supplied %(attr)s (%(supplied)s) and %(attr)s generated from uploaded image (%(actual)s) did not match. Setting image status to 'killed'."
msgstr "Inkluderade %(attr)s (%(supplied)s) och %(attr)s skapade från uppladdad bild (%(actual)s) stämde inte överens. Sätter bildstatus till 'dödad'."

msgid "Supported values for the 'container_format' image attribute"
msgstr "Värden som stöds för avbildsattributet \"container_format\""

msgid "Supported values for the 'disk_format' image attribute"
msgstr "Värden som stöds för avbildsattributet \"disk_format\""

msgid "Suppressed respawn as %(serv)s was %(rsn)s."
msgstr "Blockerade respawn eftersom %(serv)s var %(rsn)s."

msgid "System SIGHUP signal received."
msgstr "Systemsignalen SIGHUP togs emot."

msgid "Task '%s' is required"
msgstr "Uppgiften '%s' är nödvändig"

msgid "Task does not exist"
msgstr "Uppgiften finns inte"

msgid "Task failed due to Internal Error"
msgstr "Uppgiften misslyckades på grund av internt fel"

msgid "Task was not configured properly"
msgstr "Uppgiften var felaktigt konfigurerad"

msgid "Task with the given id %(task_id)s was not found"
msgstr "Uppgiften med givet id %(task_id)s hittades inte"

msgid "The \"changes-since\" filter is no longer available on v2."
msgstr "Filtret \"changes-since\" är inte längre tillgängligt i v2."

msgid "The CA file you specified %s does not exist"
msgstr "CA-filen som du angav %s finns inte"

msgid "The HTTP header used to determine the scheme for the original request, even if it was removed by an SSL terminating proxy. Typical value is \"HTTP_X_FORWARDED_PROTO\"."
msgstr "HTTP-huvudet som används för att avgöra schemat för den ursprungliga begäran, även om den togs bort av en avslutande SSL-proxy. Typiskt värde är \"HTTP_X_FORWARDED_PROTO\"."

msgid "The Image %(image_id)s object being created by this task %(task_id)s, is no longer in valid status for further processing."
msgstr "Avbildobjektet %(image_id) som skapas av den här uppgiften %(task_id)s, är inte längre i en giltig status för vidare behandling."

msgid "The Store URI was malformed."
msgstr "Store-URI var i fel form."

msgid "The URL to the keystone service. If \"use_user_token\" is not in effect and using keystone auth, then URL of keystone can be specified."
msgstr "URL till keystone-tjänsten. Om \"use_use_token\" inte används och keystone-autentisering används kan en URL till keystone anges."

msgid "The address where the Swift authentication service is listening.(deprecated)"
msgstr "Adressen där Swift-autentiseringstjänsten lyssnar.(föråldrad)"

msgid "The administrators password. If \"use_user_token\" is not in effect, then admin credentials can be specified."
msgstr "Administratörernas lösenord. Om \"use_user_token\" inte används kan administratörsinloggning anges."

msgid "The administrators user name. If \"use_user_token\" is not in effect, then admin credentials can be specified."
msgstr "Administratörernas användarnamn. Om \"use_user_token\" inte används kan administratörsinloggning anges."

msgid "The amount of time in seconds to delay before performing a delete."
msgstr "Tidsfördröjning i sekunder innan radering utförs."

msgid "The amount of time to let an incomplete image remain in the cache, before the cache cleaner, if running, will remove the incomplete image."
msgstr "Tiden för att låta en ofullständig avbild ligga kvar i cachen, innan cache-rensare, om den är aktiv, kommer ta bort den ofullständiga avbilden."

msgid "The backlog value that will be used when creating the TCP listener socket."
msgstr "Bakåtloggningsvärdet som ska användas när TCP-lyssningssockeln skapas."

msgid "The cert file you specified %s does not exist"
msgstr "Cert-filen som du angav %s finns inte"

msgid "The config file that has the swift account(s)configs."
msgstr "Konfigfilen som har konfigurationerna för swift-konton."

msgid "The current status of this task"
msgstr "Aktuell status för uppgiften"

msgid "The device housing the image cache directory %(image_cache_dir)s does not support xattr. It is likely you need to edit your fstab and add the user_xattr option to the appropriate line for the device housing the cache directory."
msgstr "Enheten som innehåller katalogen för avbilds-cache %(image_cache_dir)s stödjer inte xattr. Troligen behöver du redigera din fstab och lägga till alternativet user_xattr på lämplig rad för enheten som innehåller cache-katalogen."

msgid "The driver to use for image cache management."
msgstr "Drivrutinen som ska användas för hantering av avbilds-cache."

msgid "The format of the version %s is not valid. Use semver notation"
msgstr "Formatet för version %s är ogiltigt. Använd semver-notering"

msgid "The format to which images will be automatically converted. When using the RBD backend, this should be set to 'raw'"
msgstr "Formatet till vilket bilder automatiskt kommer konverteras till. När du använder bakänden RBD bör detta sättas till \"raw\""

msgid "The given uri is not valid. Please specify a valid uri from the following list of supported uri %(supported)s"
msgstr "Den givna uri:n är inte giltig. Ange en giltig uri från följande lista över uri:er som stöds %(supported)s"

msgid "The hostname/IP of the pydev process listening for debug connections"
msgstr "Värdnamn/IP för pydev-processen som lyssnar efter felsökningsanslutningar"

msgid "The image %s is already present on the slave, but our check for it did not find it. This indicates that we do not have permissions to see all the images on the slave server."
msgstr "Avbilden %s finns redan på slaven, men vår sökning efter den hittade inget. Detta tyder på att vi inte har tillstånd att se alla avbilder på slavservern."

msgid "The incoming artifact blob is too large: %s"
msgstr "Inkommande artefakt-blob är för stor: %s"

msgid "The incoming image is too large: %s"
msgstr "Den inkommande bilden är för stor: %s"

msgid "The key file you specified %s does not exist"
msgstr "Nyckelfilen som du angav %s finns inte"

msgid "The limit has been exceeded on the number of allowed image locations. Attempted: %(attempted)s, Maximum: %(maximum)s"
msgstr "Gränsen har överskridits för tillåtet antal avbildsplatser. Försökt: %(attempted)s, Maximum: %(maximum)s"

msgid "The limit has been exceeded on the number of allowed image members for this image. Attempted: %(attempted)s, Maximum: %(maximum)s"
msgstr "Gränsen har överskridits för antal tillåtna bildmedlemmar för den här bilden. Testade: %(attempted)s, Maximum: %(maximum)s"

msgid "The limit has been exceeded on the number of allowed image properties. Attempted: %(attempted)s, Maximum: %(maximum)s"
msgstr "Gränsen har överskridits för tillåtet antal avbildsegenskaper. Försökt: %(attempted)s, Maximum: %(maximum)s"

msgid "The limit has been exceeded on the number of allowed image properties. Attempted: %(num)s, Maximum: %(quota)s"
msgstr "Gränsen överskreds för antalet tillåtna bildegenskaper. Testade: %(num)s, Maximum: %(quota)s"

msgid "The limit has been exceeded on the number of allowed image tags. Attempted: %(attempted)s, Maximum: %(maximum)s"
msgstr "Gränsen har överskridits för tillåtet antal avbildsetiketter. Försökt: %(attempted)s, Maximum: %(maximum)s"

msgid "The location %(location)s already exists"
msgstr "Platsen %(location)s finns redan"

msgid "The location data has an invalid ID: %d"
msgstr "Platsdata har ogiltig ID: %d"

msgid "The location of the property protection file.This file contains the rules for property protections and the roles/policies associated with it. If this config value is not specified, by default, property protections won't be enforced. If a value is specified and the file is not found, then the glance-api service will not start."
msgstr "Platsen för egenskapsskyddsfilen.Denna fil innehåller reglerna för egenskapsskydd och rollerna/policyerna som associeras med den. Om det här konfigvärdet inte anges kommer som standard egenskapsskydd inte tillämpas. Om ett värde specificeras men filen inte hittas kommer tjänsten glance-api inte startas."

msgid "The metadata definition %(record_type)s with name=%(record_name)s not deleted. Other records still refer to it."
msgstr "Metadatadefinitionen %(record_type)s med namnet=%(record_name)s raderades inte. Andra poster hänvisar fortfarande till den."

msgid "The metadata definition namespace=%(namespace_name)s already exists."
msgstr "Metadatadefinitionens namnrymd=%(namespace_name)s finns redan."

msgid "The metadata definition object with name=%(object_name)s was not found in namespace=%(namespace_name)s."
msgstr "Metadatadefinitionens objekt med namnet=%(object_name)s hittades inte i namnrymden=%(namespace_name)s."

msgid "The metadata definition property with name=%(property_name)s was not found in namespace=%(namespace_name)s."
msgstr "Metadatadefinitionens egenskap med namnet=%(property_name)s hittades inte i namnrymden=%(namespace_name)s."

msgid "The metadata definition resource-type association of resource-type=%(resource_type_name)s to namespace=%(namespace_name)s already exists."
msgstr "Metadatadefinitionens resurstypassociering för resurstypen=%(resource_type_name)s till namnrymden=%(namespace_name)s finns redan."

msgid "The metadata definition resource-type association of resource-type=%(resource_type_name)s to namespace=%(namespace_name)s, was not found."
msgstr "Metadatadefinitionens resurstypassociering för resurstypen=%(resource_type_name)s till namnrymden=%(namespace_name)s, hittades inte."

msgid "The metadata definition resource-type with name=%(resource_type_name)s, was not found."
msgstr "Metadatadefinitionens resurstyp med namnet=%(resource_type_name)s, hittades inte."

msgid "The metadata definition tag with name=%(name)s was not found in namespace=%(namespace_name)s."
msgstr "Metadatadefinitionens etikett med namnet=%(name)s hittades inte i namnrymden=%(namespace_name)s."

msgid "The mode in which the engine will run. Can be 'serial' or 'parallel'."
msgstr "Läget motorn kommer att köras i. Kan vara 'serial' eller 'parallel'."

msgid "The number of child process workers that will be created to service requests. The default will be equal to the number of CPUs available."
msgstr "Antal underprocessarbetare som ska skapas för att hantera begäran. Förvalet är samma som antalet tillgängliga CPU:er."

msgid "The number of parallel activities executed at the same time by the engine. The value can be greater than one when the engine mode is 'parallel'."
msgstr "Antal parallella aktiviteter som körs samtidigt av motorn. Värdet kan vara större än en när motorns läge är 'parallel'."

msgid "The parameters required by task, JSON blob"
msgstr "Parametrarna som krävs av uppgift, JSON-klump"

msgid "The path to the cert file to use in SSL connections to the registry server, if any. Alternately, you may set the GLANCE_CLIENT_CERT_FILE environment variable to a filepath of the CA cert file"
msgstr "Sökvägen till cert-filen som ska användas vid eventuella SSL-anslutningar till registerservern. Du kan också sätta miljövariabeln GLANCE_CLIENT_CERT_FILE till en filsökväg för CA-cert-filen"

msgid "The path to the certifying authority cert file to use in SSL connections to the registry server, if any. Alternately, you may set the GLANCE_CLIENT_CA_FILE environment variable to a filepath of the CA cert file."
msgstr "Sökvägen till certifieringsagenturens cert-fil som ska användas vid eventuella SSL-anslutningar till registerservern. Du kan också sätta miljövariabeln GLANCE_CLIENT_CA_FILE till en filsökväg till CA-cert-filen."

msgid "The path to the key file to use in SSL connections to the registry server, if any. Alternately, you may set the GLANCE_CLIENT_KEY_FILE environment variable to a filepath of the key file"
msgstr "Sökvägen till nyckelfilen som ska användas vid eventuella SSL-anslutningar till registerservern. Du kan också sätta miljövariabeln GLANCE_CLIENT_KEY_FILE till en filsökväg för nyckelfilen"

msgid "The path to the sqlite file database that will be used for image cache management."
msgstr "Sökvägen till sqlite-fildatabasen som ska användas för hantering av avbilds-cache."

msgid "The period of time, in seconds, that the API server will wait for a registry request to complete. A value of 0 implies no timeout."
msgstr "Tidsperiod, i sekunder, som API-servern kommer att vänta på att en registerförfrågan slutförs. Värdet 0 betyder ingen tidsgräns."

msgid "The port on which a pydev process is listening for connections."
msgstr "Porten på vilken en pydev-process lyssnar efter anslutningar."

msgid "The port on which the server will listen."
msgstr "Porten som servern ska lyssna på."

msgid "The protocol to use for communication with the registry server.  Either http or https."
msgstr "Protokoll att använda för kommunikation med registerservern. Antingen http eller https."

msgid "The provided body %(body)s is invalid under given schema: %(schema)s"
msgstr "Den givna brödtexten %(body)s är ogiltig under angivet schema: %(schema)s"

msgid "The provided image is too large."
msgstr "Given avbild är för stor."

msgid "The provided path '%(path)s' is invalid: %(explanation)s"
msgstr "Den angivna sökvägen \"%(path)s\" är ogiltig: %(explanation)s"

msgid "The reference to the default swift account/backing store parameters to use for adding new images."
msgstr "Referensen till de förvalda swift-konto-/backningslagringsparametrarna för att lägga till nya avbilder."

msgid "The region for the authentication service. If \"use_user_token\" is not in effect and using keystone auth, then region name can be specified."
msgstr "Region för autentiseringstjänsten. Om \"use_user_token\" inte används och keystone-autentisering används kan regionnamnet anges."

msgid "The request returned 500 Internal Server Error."
msgstr "Begäran returnerade 500 Internal Server Error."

msgid "The request returned 503 Service Unavailable. This generally occurs on service overload or other transient outage."
msgstr "Begäran returnerade 503 Service Unavailable. Detta brukar hända när tjänster överbelastas eller vid annat övergående stopp."

msgid ""
"The request returned a 302 Multiple Choices. This generally means that you have not included a version indicator in a request URI.\n"
"\n"
"The body of response returned:\n"
"%(body)s"
msgstr ""
"Begäran returnerade en 302 Multiple Choices. Detta betyder i regel att du inte inkluderade en versionsindikator i en begärans URI.\n"
"\n"
"Brödtext i returnerat svar:\n"
"%(body)s"

msgid ""
"The request returned a 413 Request Entity Too Large. This generally means that rate limiting or a quota threshold was breached.\n"
"\n"
"The response body:\n"
"%(body)s"
msgstr ""
"Begäran returnerade en 413 Request Entity Too Large. Detta betyder i regel att hastighetsgränsen eller en kvottröskel överskreds.\n"
"\n"
"Brödtext från svaret:\n"
"%(body)s"

msgid ""
"The request returned an unexpected status: %(status)s.\n"
"\n"
"The response body:\n"
"%(body)s"
msgstr ""
