msgstr "Det finns ett problem med din %(error_key_name)s %(error_filename)s. Verifiera. Fel: %(ioe)s"

msgid "There is a problem with your %(error_key_name)s %(error_filename)s.  Please verify it. OpenSSL error: %(ce)s"
msgstr "Det finns ett problem med din %(error_key_name)s %(error_filename)s. Verifiera. OpenSSL-fel: %(ce)s"

msgid "There is a problem with your key pair.  Please verify that cert %(cert_file)s and key %(key_file)s belong together.  OpenSSL error %(ce)s"
msgstr "Det finns ett problem med ditt nyckelpar. Verifiera att cert %(cert_file)s och nyckeln %(key_file)s hör ihop. OpenSSL-fel %(ce)s"

