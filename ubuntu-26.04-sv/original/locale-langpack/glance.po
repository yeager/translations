msgstr "Kunde inte hitta nödvändigt konfigurationsalternativ"

msgid "Could not find task %s"
msgstr "Kunde inte hitta uppgiften %s"

msgid "Could not update image: %s"
msgstr "Kunde inte uppdatera bild: %s"

msgid "Currently, OVA packages containing multiple disk are not supported."
msgstr "För närvarande stöds inte OVA-paket som innehåller flera diskar."

msgid "Custom validators list should contain tuples '(function, message)'"
msgstr "Listan över egna validatorer bör innehålla par \"(funktion, meddelande)\""

msgid "Data for image_id not found: %s"
msgstr "Data för image_id hittades inte: %s"

msgid "Data supplied was not valid."
msgstr "Given data var inte giltig."

msgid "Date and time of image member creation"
msgstr "Tid och datum för bildmedlemmens skapande"

msgid "Date and time of image registration"
msgstr "Tid och datum för bildens registrering"

msgid "Date and time of last modification of image member"
msgstr "Tid och datum för senaste ändring av bildmedlem"

msgid "Date and time of namespace creation"
msgstr "Tid och datum när namnrymden skapades"

msgid "Date and time of object creation"
msgstr "Tid och datum när objektet skapades"

msgid "Date and time of resource type association"
msgstr "Tid och datum för resurstypassociering"

msgid "Date and time of tag creation"
msgstr "Tid och datum när etiketten skapades"

msgid "Date and time of the last image modification"
msgstr "Tid och datum för bildens senaste ändring"

msgid "Date and time of the last namespace modification"
msgstr "Tid och datum för senaste namnrymdsändringen"

msgid "Date and time of the last object modification"
msgstr "Tid och datum för senaste objektändingen"

