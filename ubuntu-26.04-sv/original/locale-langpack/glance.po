msgid "Datetime when this resource was created"
msgstr "Tid och datum när resursen skapades"

msgid "Datetime when this resource was updated"
msgstr "Tid och datum när resursen uppdaterades"

msgid "Datetime when this resource would be subject to removal"
msgstr "Tid och datum när resursen skulle tas bort"

msgid "Default value for the number of items returned by a request if not specified explicitly in the request"
msgstr "Förvalt värde för antal objekt som returneras av en begäran om detta inte uttryckligen specificeras i begäran"

msgid "Default value is invalid"
msgstr "Förvalt värde är ogiltigt"

msgid "Denying attempt to upload artifact because it exceeds the quota: %s"
msgstr "Nekar försök att ladda upp artefakt eftersom den överskrider kvoten: %s"

msgid "Denying attempt to upload image because it exceeds the quota: %s"
msgstr "Nekar försök att ladda upp bild eftersom den överskrider kvoten: %s"

msgid "Denying attempt to upload image larger than %d bytes."
msgstr "Nekar försök att ladda upp bild större än %d byte."

msgid "Dependency property '%s' has to be deleted first"
msgstr "Beroendeegenskapen '%s' måste tas bort först"

msgid "Dependency relations cannot be mutable"
msgstr "Beroenderelationer får inte vara föränderliga"

msgid "Deploy the v1 OpenStack Images API."
msgstr "Använd v1 OpenStack Images-API."

msgid "Deploy the v1 OpenStack Registry API."
msgstr "Använd v1 OpenStack Registry-API."

msgid "Deploy the v2 OpenStack Images API."
msgstr "Använd v2 OpenStack Images-API."

msgid "Deploy the v2 OpenStack Registry API."
msgstr "Använd v2 OpenStack Registry-API."

msgid "Descriptive name for the image"
msgstr "Beskrivande namn för avbildningen"

msgid "Dictionary contains unexpected key(s)"
msgstr "Ordbok innehåller oväntade nycklar"

msgid "Dictionary size is greater than maximum"
msgstr "Ordbokens storlek är större än maximum"

msgid "Dictionary size is less than minimum"
msgstr "Ordboksstorlek är mindre än minimum"

msgid "Digest algorithm which will be used for digital signature. Use the command \"openssl list-message-digest-algorithms\" to get the available algorithms supported by the version of OpenSSL on the platform. Examples are \"sha1\", \"sha256\", \"sha512\", etc."
msgstr "Hash-algoritm som ska användas för digital signering. Använd kommandot \"openssl list-message-digest-algorithms\" för att visa tillgängliga algoritmer som stöds av plattformens version av OpenSSL. Exempel är \"sha1\", \"sha256\", \"sha512\" osv."

msgid "Disk format is not specified."
msgstr "Diskformat inte angivet."

msgid "Does not match pattern"
msgstr "Matchar inte mönster"

msgid "Driver %(driver_name)s could not be configured correctly. Reason: %(reason)s"
msgstr "Drivrutinen %(driver_name)s kunde inte konfigureras korrekt. Anledning: %(reason)s"

msgid "Either a file or a legacy_image_id has to be specified"
msgstr "Antingen måste en fil eller legacy_image_id anges"

msgid "Error decoding your request. Either the URL or the request body contained characters that could not be decoded by Glance"
msgstr "Fel vid avkodning av din begäran. Antingen innehöll URL:en eller begärans brödtext tecken som inte kunde avkodas av Glance"

msgid "Error fetching members of image %(image_id)s: %(inner_msg)s"
msgstr "Fel vid hämtning av medlemmar för bilden %(image_id)s: %(inner_msg)s"

msgid "Error in store configuration. Adding artifacts to store is disabled."
msgstr "Fel i lagringskonfiguration. Att lägga till artefakter till lagring är avaktiverat."

msgid "Error in store configuration. Adding images to store is disabled."
msgstr "Fel i lagringskonfiguration. Inte längre möjligt att lägga till bilder i lagring."

msgid "Error occurred while creating the verifier"
msgstr "Fel uppstod när verifieraren skapades"

msgid "Error occurred while verifying the signature"
msgstr "Fel uppstod när signaturen verifierades"

msgid "Expected a member in the form: {\"member\": \"image_id\"}"
msgstr "En medlem förväntades i formen: {\"medlem\": \"image_id\"}"

msgid "Expected a status in the form: {\"status\": \"status\"}"
msgstr "En status förväntades i formen: {\"status\": \"status}"

msgid "External source should not be empty"
msgstr "Extern källa bör inte vara tom"

msgid "External sources are not supported: '%s'"
msgstr "Externa källor stöds inte: '%s'"

msgid "Failed to activate image. Got error: %s"
msgstr "Kunde inte aktivera bild. Fick fel: %s"

msgid "Failed to add image metadata. Got error: %s"
msgstr "Kunde inte lägga till avbildsmetadata. Fick felet: %s"

msgid "Failed to find artifact %(artifact_id)s to delete"
msgstr "Kunde inte hitta artefakt %(artifact_id)s att ta bort"

msgid "Failed to find image %(image_id)s to delete"
msgstr "Kunde inte hitta bild %(image_id)s att ta bort"

msgid "Failed to find image to delete: %s"
msgstr "Kunde inte hitta bild att ta bort: %s"

msgid "Failed to find image to update: %s"
msgstr "Kunde inte hitta bild att uppdatera: %s"

msgid "Failed to find resource type %(resourcetype)s to delete"
msgstr "Kunde inte hitta resurstypen %(resourcetype)s som skulle tas bort"

msgid "Failed to initialize the image cache database. Got error: %s"
msgstr "Kunde inte initiera databas för avbilds-cache. Fick felet: %s"

msgid "Failed to read %s from config"
msgstr "Kunde inte läsa %s från konfig"

msgid "Failed to reserve image. Got error: %s"
msgstr "Kunde inte reservera bild. Fick fel: %s"

msgid "Failed to update image metadata. Got error: %s"
msgstr "Kunde inte uppdatera bildens metadata. Fick fel: %s"

msgid "Failed to upload image %s"
msgstr "Kunde inte ladda upp bilden %s"

msgid "Failed to upload image data for image %(image_id)s due to HTTP error: %(error)s"
msgstr "Kunde inte ladda upp bilddata för bilden %(image_id)s på grund av HTTP-fel: %(error)s"

msgid "Failed to upload image data for image %(image_id)s due to internal error: %(error)s"
msgstr "Kunde inte ladda upp bilddata för bilden %(image_id)s på grund av internt fel: %(error)s"

msgid "File %(path)s has invalid backing file %(bfile)s, aborting."
msgstr "Filen %(path)s har en ogiltig backningsfil %(bfile)s, avbryter."

msgid "File based imports are not allowed. Please use a non-local source of image data."
msgstr "Filbaserad importering tillåts inte. Använd en icke-lokal källa för avbildsdata."

msgid "File too large"
msgstr "Fil för stor"

msgid "File too small"
msgstr "Fil för liten"

msgid "Forbidden image access"
msgstr "Förbjuden bildåtkomst"

msgid "Forbidden to delete a %s image."
msgstr "Förbjuden från att ta bort en %s-bild."

msgid "Forbidden to delete image: %s"
msgstr "Förbjuden från att ta bort bild: %s"

msgid "Forbidden to modify '%(key)s' of %(status)s image."
msgstr "Förbjudet att ändra \"%(key)s\" för %(status)s bild."

msgid "Forbidden to modify '%s' of image."
msgstr "Förbjudet att ändra \"%s\" för bild."

msgid "Forbidden to reserve image."
msgstr "Förbjuden från att reservera bild."

