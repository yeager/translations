msgid "\t%s"
msgstr "\t%s"

msgid "%(attribute)s have to be string"
msgstr "%(attribute)s måste vara en sträng"

msgid "%(attribute)s is required"
msgstr "%(attribute)s krävs"

msgid "%(attribute)s may not be longer than %(length)i"
msgstr "%(attribute)s får inte vara längre än %(length)i"

msgid "%(attribute)s may not be shorter than %(length)i"
msgstr "%(attribute)s får inte vara kortare än %(length)i"

msgid "%(attribute)s should match pattern %(pattern)s"
msgstr "%(attribute)s bör matcha mönstret %(pattern)s"

msgid "%(cls)s exception was raised in the last rpc call: %(val)s"
msgstr "%(cls)s-undantag uppstod i senaste rpc-anropet: %(val)s"

msgid "%(m_id)s not found in the member list of the image %(i_id)s."
msgstr "%(m_id)s hittades inte i medlemslistan för bilden %(i_id)s."

msgid "%(serv)s (pid %(pid)s) is running..."
msgstr "%(serv)s (pid %(pid)s) körs…"

msgid "%(serv)s appears to already be running: %(pid)s"
msgstr "%(serv)s verkar redan köras: %(pid)s"

msgid "%(strategy)s is registered as a module twice. %(module)s is not being used."
msgstr "%(strategy)s har registrerats som modul två gånger. %(module)s används inte."

msgid "%(task_id)s of %(task_type)s not configured properly. Could not load the filesystem store"
msgstr "%(task_id)s av %(task_type)s inte korrekt konfigurerad. Kunde inte ladda filsystemslagring"

msgid "%(task_id)s of %(task_type)s not configured properly. Missing work dir: %(work_dir)s"
msgstr "%(task_id)s av %(task_type)s inte korrekt konfigurerad. Saknar arbetskat: %(work_dir)s"

msgid "%(verb)sing %(serv)s"
msgstr "%(verb)sar %(serv)s"

msgid "%(verb)sing %(serv)s with %(conf)s"
msgstr "%(verb)sar %(serv)s med %(conf)s"

msgid "%s Please specify a host:port pair, where host is an IPv4 address, IPv6 address, hostname, or FQDN. If using an IPv6 address, enclose it in brackets separately from the port (i.e., \"[fe80::a:b:c]:9876\")."
msgstr "%s Specificera ett värd:port-par, där värden är en IPv4-adress, IPv6-adress, värdnamn, eller FQDN. Om du använder en IPv6-adress, skriv den inom parenteser separerade från porten (dvs. \"[fe80::a:b:c]:9876\")."

msgid "%s can't contain 4 byte unicode characters."
msgstr "%s får inte innehålla 4-byte unicode-tecken."

msgid "%s is already stopped"
msgstr "%s har redan stoppats"

msgid "%s is stopped"
msgstr "%s är stoppad"

msgid "'%(param)s' value out of range, must not exceed %(max)d"
msgstr "\"%(param)s\"-värdet utanför intervallet, får inte överstiga %(max)d"

msgid "--os_auth_url option or OS_AUTH_URL environment variable required when keystone authentication strategy is enabled\n"
msgstr "Alternativet --os_auth_url eller miljövariabeln OS_AUTH_URL krävs när autentiseringsstrategin keystone är aktiverad\n"

msgid "A body is not expected with this request."
msgstr "En brödtext förväntas inte tillsammans med den här begäran."

msgid "A list of artifacts that are allowed in the format name or name-version. Empty list means that any artifact can be loaded."
msgstr "En lista över artefakter som tillåts i formatnamnet eller namnversion. Tom lista innebär att alla artefakter kan läsas in."

msgid "A metadata definition object with name=%(object_name)s already exists in namespace=%(namespace_name)s."
msgstr "Ett metadatadefinitionsobjekt med namnet=%(object_name)s finns redan i namnrymden=%(namespace_name)s."

msgid "A metadata definition property with name=%(property_name)s already exists in namespace=%(namespace_name)s."
msgstr "En metadatadefinitionsegenskap med namnet=%(property_name)s finns redan i namnrymden=%(namespace_name)s."

msgid "A metadata definition resource-type with name=%(resource_type_name)s already exists."
msgstr "En metadatadefinitions resurstyp med namnet=%(resource_type_name)s finns redan."

msgid "A metadata tag with name=%(name)s already exists in namespace=%(namespace_name)s. (Please note that metadata tag names are case insensitive)."
msgstr "En metadataetikett med namnet=%(name)s finns redan i namnrymden=%(namespace_name)s. (Observera att metadataetikettnamn inte är skiftlägeskänsliga.)"

msgid "A set of URLs to access the image file kept in external store"
msgstr "Några webbadresser för att komma åt avbildningsfilen som lagras externt"

msgid "AES key for encrypting store 'location' metadata. This includes, if used, Swift or S3 credentials. Should be set to a random string of length 16, 24 or 32 bytes"
msgstr "AES-nyckeln för kryptering av lagringens metadata \"location\". Det inkluderar, om detta används, Swift- eller S3-behörigheter. Bör sättas till en slumpad sträng med längden 16, 24 eller 32 byte"

msgid "Address to bind the server.  Useful when selecting a particular network interface."
msgstr "Adress för att binda servern. Praktiskt vid val av ett särskilt nätverksgränssnitt."

msgid "Address to find the registry server."
msgstr "Adress för att hitta registerservern."

msgid "Allow unauthenticated users to access the API with read-only privileges. This only applies when using ContextMiddleware."
msgstr "Tillåt ej autentiserade användare att komma åt API:et med endast läsrättigheter. Detta gäller bara när ContextMiddleware används."

msgid "Allowed values %s are invalid under given validators"
msgstr "Tillåtna värden %s är ogiltiga under givna validatorer"

msgid "Amount of disk space (in GB) required to boot image."
msgstr "Mängden diskutrymme (i GB) som krävs för att starta avbildning."

msgid "Amount of ram (in MB) required to boot image."
msgstr "Mängd RAM (i MB) som krävs för att starta avbildningen."

msgid "An identifier for the image"
msgstr "En identifierare för bilden"

msgid "An identifier for the image member (tenantId)"
msgstr "En identifierare för bildmedlemmen (tenantId)"

msgid "An identifier for the owner of this task"
msgstr "En identifierare för uppgiftens ägare"

msgid "An identifier for the task"
msgstr "En identifierare för uppgiften"

msgid "An image file url"
msgstr "En bildfil-url"

msgid "An image schema url"
msgstr "En bildschema-url"

msgid "An image self url"
msgstr "An image self url"

msgid "An image with identifier %s already exists"
msgstr "En bild med identifieraren %s finns redan"

msgid "An import task exception occurred"
msgstr "Ett undantag uppstod för importeringsuppgift"

msgid "An object with the same identifier already exists."
msgstr "Ett objekt med samma identifierare finns redan."

msgid "An object with the same identifier is currently being operated on."
msgstr "Ett objekt med samma identifierare är mål för en pågående åtgärd."

msgid "An object with the specified identifier was not found."
msgstr "Ett objekt med den givna identifieraren hittades inte."

msgid "An unknown exception occurred"
msgstr "Ett okänt undantag inträffade"

msgid "An unknown task exception occurred"
msgstr "Ett okänt uppgiftsundantag uppstod"

msgid "Array has no element at position %d"
msgstr "Array har inget element vid position %d"

msgid "Array property can't have item_type=Array"
msgstr "Array-egenskap får inte ha item_type=Array"

msgid "Artifact %s could not be deleted because it is in use: %s"
msgstr "Artefakten %s kunde inte tas bort eftersom den används: %s"

msgid "Artifact cannot change state from %(source)s to %(target)s"
msgstr "Artefakt kan inte ändra tillstånd från %(source)s till %(target)s"

msgid "Artifact exceeds the storage quota: %s"
msgstr "Artefakt överskrider lagringskvoten: %s"

msgid "Artifact has no property %(prop)s"
msgstr "Artefakten saknar egenskapen %(prop)s"

msgid "Artifact state cannot be changed from %(curr)s to %(to)s"
msgstr "Artefaktens tillstånd kan inte ändras från %(curr)s till %(to)s"

msgid "Artifact storage media is full: %s"
msgstr "Artefaktlagringsmedia är fullt: %s"

msgid "Artifact type with name '%(name)s' and version '%(version)s' is not known"
msgstr "Artefakttypen med namnet \"%(name)s\" och version \"%(version)s\" är okänd"

msgid "Artifact with a circular dependency can not be created"
msgstr "Artefakt med cirkulära beroenden kan inte skapas"

msgid "Artifact with id=%(id)s is not accessible"
msgstr "Artefakt med ID=%(id)s är oåtkomlig"

msgid "Artifact with id=%(id)s was not found"
msgstr "Artefakt med ID=%(id)s hittades inte"

msgid "Artifact with the specified type, name and version already exists"
msgstr "Artefakt med angiven typ, namn och version finns redan"

msgid "Artifact with the specified type, name and version already has the direct dependency=%(dep)s"
msgstr "Artefakt med angiven typ, namn och version har redan det direkta beroendet=%(dep)s"

msgid "Artifact with the specified type, name and version already has the transitive dependency=%(dep)s"
msgstr "Artefakt med given typ, namn och version har redan det transitiva beroendet=%(dep)s"

msgid "Attempt to set readonly property"
msgstr "Försöker sätta egenskapen skrivskydd"

msgid "Attempt to set value of immutable property"
msgstr "Försöker sätta värdet på ej föränderlig egenskap"

msgid "Attempt to upload duplicate image: %s"
msgstr "Försökte ladda upp dubblettbild: %s"

msgid "Attempted to update Location field for an image not in queued status."
msgstr "Försökte uppdatera Platsfält för en bild som inte ligger i kö."

msgid "Attribute '%(property)s' is read-only."
msgstr "Attributet \"%(property)s\" är skrivskyddat."

msgid "Attribute '%(property)s' is reserved."
msgstr "Attributet \"%(property)s\" är reserverat."

msgid "Attribute '%s' is read-only."
msgstr "Attributet '%s' är skrivskyddat."

msgid "Attribute '%s' is reserved."
msgstr "Attributet '%s' är reserverat."

msgid "Attribute container_format can be only replaced for a queued image."
msgstr "Attributet container_format får bara ersättas för en köad avbild."

msgid "Attribute disk_format can be only replaced for a queued image."
msgstr "Attributet disk_format får bara ersättas för en köad avbild."

msgid "Auth key for the user authenticating against the Swift authentication service. (deprecated)"
msgstr "Aut.-nyckel för användaren som autentiserar mot Swift-autentiseringstjänsten. (föråldrad)"

msgid "Auth service at URL %(url)s not found."
msgstr "Aut.tjänst på URL %(url)s hittades inte."

msgid "Authentication error - the token may have expired during file upload. Deleting image data for %s."
msgstr "Autentiseringsfel - token kan ha gått ut under filuppladdning. Raderar bilddata för %s."

msgid "Authorization failed."
msgstr "Behörighetskontroll misslyckades."

msgid "Available categories:"
msgstr "Tillgängliga kategorier:"

msgid "Bad \"%s\" query filter format. Use ISO 8601 DateTime notation."
msgstr "Felaktigt \"%s\" sökfilterformat. Använd ISO 8601 TidDatum-notering."

msgid "Bad Command: %s"
msgstr "Felaktigt kommando: %s"

msgid "Bad header: %(header_name)s"
msgstr "Felaktigt huvud: %(header_name)s"

msgid "Bad value passed to filter %(filter)s got %(val)s"
msgstr "Dåligt värde skickat till filtret %(filter)s fick %(val)s"

msgid "Badly formed S3 URI: %(uri)s"
msgstr "Felformad S3-URI: %(uri)s"

msgid "Badly formed credentials '%(creds)s' in Swift URI"
msgstr "Felformade inloggningsdetaljer \"%(creds)s\" i Swift-URI"

msgid "Badly formed credentials in Swift URI."
msgstr "Felformade inloggnignsdetaljer i Swift-URI."

msgid "Base directory that the image cache uses."
msgstr "Baskatalog som avbilds-cachen använder."

msgid "BinaryObject property cannot be declared mutable"
msgstr "Egenskapen BinaryObject får inte deklareras som föränderlig"

msgid "Blob %(name)s may not have multiple values"
msgstr "Blob %(name)s får inte ha flera värden"

msgid "Blob size is not set"
msgstr "Blob-storlek är inte satt"

msgid "Body expected in request."
msgstr "Nyttotext förväntades i begäran."

msgid "Both file and legacy_image_id may not be specified at the same time"
msgstr "Både fil och legacy_image_id får inte anges samtidigt"

msgid "CA certificate file to use to verify connecting clients."
msgstr "CA-certifikatfil att använda för att verifiera anslutande klienter."

msgid "Cannot be a negative value"
msgstr "Får inte vara ett negativt värde"

msgid "Cannot be a negative value."
msgstr "Får inte vara ett negativt värde."

msgid "Cannot convert image %(key)s '%(value)s' to an integer."
msgstr "Kan inte konvertera avbildens %(key)s \"%(value)s\" till ett heltal."

msgid "Cannot declare artifact property with reserved name 'metadata'"
msgstr "Får inte deklarera artefaktegenskap med reserverat namn \"metadata\""

msgid "Cannot load artifact '%(name)s'"
msgstr "Kan inte läsa in artefakten \"%(name)s\""

msgid "Cannot remove last location in the image."
msgstr "Kan inte ta bort sista platsen i bilden."

msgid "Cannot save data for image %(image_id)s: %(error)s"
msgstr "Kan inte spara data för bilden %(image_id)s: %(error)s"

msgid "Cannot set locations to empty list."
msgstr "Kan inte ange platser för tom lista."

msgid "Cannot specify 'max_size' explicitly"
msgstr "Får inte specificera \"max_size\" explicit"

msgid "Cannot specify 'min_size' explicitly"
msgstr "Får inte specificera \"min_size\" explicit"

msgid "Cannot upload to an unqueued image"
msgstr "Kan inte ladda upp till en bild utanför kön"

msgid "Cannot use this parameter with the operator %(op)s"
msgstr "Kan inte använda denna parameter med operanden %(op)s"

msgid "Certificate file to use when starting API server securely."
msgstr "Certifikatfil att använda vid säker start av API-server."

msgid "Certificate format not supported: %s"
msgstr "Certifikatets format stöds inte: %s"

msgid "Certificate is not valid after: %s UTC"
msgstr "Certifikatet inte giltligt efter: %s UTC"

msgid "Certificate is not valid before: %s UTC"
msgstr "Certifikatet inte giltigt innan: %s UTC"

msgid "Checksum verification failed. Aborted caching of image '%s'."
msgstr "Kunde inte verifiera kontrollsumma. Avbryter cache-lagring av avbilden \"%s\"."

msgid "Client disconnected before sending all data to backend"
msgstr "Klienten kopplade ner innan all data skickades till bakänden"

msgid "Command not found"
msgstr "Kommandot hittades inte"

msgid "Configuration option was not valid"
msgstr "Konfigurationsalternativ var ogiltigt"

msgid "Connect error/bad request to Auth service at URL %(url)s."
msgstr "Koppla fel/felaktig begäran till aut.tjänst på URL %(url)s."

msgid "Constructed URL: %s"
msgstr "Konstruerad URL: %s"

msgid "Container format is not specified."
msgstr "Behållarformat inte angivet."

msgid "Content-Type must be application/octet-stream"
msgstr "Innehållstyp måste vara application/octet-stream"

msgid "Corrupt image download for image %(image_id)s"
msgstr "Trasig bildnedladdning för bilden %(image_id)s"

msgid "Could not bind to %(host)s:%(port)s after trying for 30 seconds"
msgstr "Kunde inte binda till %(host)s:%(port)s efter att ha försökt i 30 sekunder"

msgid "Could not find OVF file in OVA archive file."
msgstr "Kunde inte hitta OVF-fil i OVA-arkivfil."

msgid "Could not find metadata object %s"
msgstr "Kunde inte hitta metadataobjektet %s"

msgid "Could not find metadata tag %s"
msgstr "Kunde inte hitta metadataetikett %s"

msgid "Could not find namespace %s"
msgstr "Kunde inte hitta namnrymden %s"

msgid "Could not find property %s"
msgstr "Kunde inte hitta egenskapen %s"

