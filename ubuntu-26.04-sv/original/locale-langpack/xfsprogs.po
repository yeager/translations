msgid ""
"Usage: %s\n"
"/* blocksize */\t\t[-b size=num]\n"
"/* config file */\t[-c options=xxx]\n"
"/* metadata */\t\t[-m crc=0|1,finobt=0|1,uuid=xxx,rmapbt=0|1,reflink=0|1,\n"
"\t\t\t    inobtcount=0|1,bigtime=0|1,autofsck=xxx,\n"
"\t\t\t    metadir=0|1]\n"
"/* quota */\t\t[-m uquota|uqnoenforce,gquota|gqnoenforce,\n"
"\t\t\t    pquota|pqnoenforce]\n"
"/* data subvol */\t[-d agcount=n,agsize=n,file,name=xxx,size=num,\n"
"\t\t\t    (sunit=value,swidth=value|su=num,sw=num|noalign),\n"
"\t\t\t    sectsize=num,concurrency=num]\n"
"/* force overwrite */\t[-f]\n"
"/* inode size */\t[-i perblock=n|size=num,maxpct=n,attr=0|1|2,\n"
"\t\t\t    projid32bit=0|1,sparse=0|1,nrext64=0|1,\n"
"\t\t\t    exchange=0|1,max_atomic_write=n]\n"
"/* no discard */\t[-K]\n"
"/* log subvol */\t[-l agnum=n,internal,size=num,logdev=xxx,version=n\n"
"\t\t\t    sunit=value|su=num,sectsize=num,lazy-count=0|1,\n"
"\t\t\t    concurrency=num]\n"
"/* label */\t\t[-L label (maximum 12 characters)]\n"
"/* naming */\t\t[-n size=num,version=2|ci,ftype=0|1,parent=0|1]]\n"
"/* no-op info only */\t[-N]\n"
"/* prototype file */\t[-p fname]\n"
"/* populate from directory */\t[-p dirname,atime=0|1]\n"
"/* quiet */\t\t[-q]\n"
"/* realtime subvol */\t[-r extsize=num,size=num,rtdev=xxx,rgcount=n,rgsize=n,\n"
"\t\t\t    concurrency=num,zoned=0|1,start=n,reserved=n]\n"
"/* sectorsize */\t[-s size=num]\n"
"/* version */\t\t[-V]\n"
"\t\t\tdevicename\n"
"<devicename> is required unless -d name=xxx is given.\n"
"<num> is xxx (bytes), xxxs (sectors), xxxb (fs blocks), xxxk (xxx KiB),\n"
"      xxxm (xxx MiB), xxxg (xxx GiB), xxxt (xxx TiB) or xxxp (xxx PiB).\n"
"<value> is xxx (512 byte blocks).\n"
msgstr ""
"Användning: %s\n"
"/* blocksize */\t\t[-b size=num]\n"
"/* config file */\t[-c options=xxx]\n"
"/* metadata */\t\t[-m crc=0|1,finobt=0|1,uuid=xxx,rmapbt=0|1,reflink=0|1,\n"
"\t\t\t    inobtcount=0|1,bigtime=0|1,autofsck=xxx,\n"
"\t\t\t    metadir=0|1]\n"
"/* quota */\t\t[-m uquota|uqnoenforce,gquota|gqnoenforce,\n"
"\t\t\t    pquota|pqnoenforce]\n"
"/* data subvol */\t[-d agcount=n,agsize=n,file,name=xxx,size=num,\n"
"\t\t\t    (sunit=value,swidth=value|su=num,sw=num|noalign),\n"
"\t\t\t    sectsize=num,concurrency=num]\n"
"/* force overwrite */\t[-f]\n"
"/* inode size */\t[-i perblock=n|size=num,maxpct=n,attr=0|1|2,\n"
"\t\t\t    projid32bit=0|1,sparse=0|1,nrext64=0|1,\n"
"\t\t\t    exchange=0|1,max_atomic_write=n]\n"
"/* no discard */\t[-K]\n"
"/* log subvol */\t[-l agnum=n,internal,size=num,logdev=xxx,version=n\n"
"\t\t\t    sunit=value|su=num,sectsize=num,lazy-count=0|1,\n"
"\t\t\t    concurrency=num]\n"
"/* label */\t\t[-L label (maximum 12 characters)]\n"
"/* naming */\t\t[-n size=num,version=2|ci,ftype=0|1,parent=0|1]]\n"
"/* no-op info only */\t[-N]\n"
"/* prototype file */\t[-p fname]\n"
"/* populate from directory */\t[-p dirname,atime=0|1]\n"
"/* quiet */\t\t[-q]\n"
"/* realtime subvol */\t[-r extsize=num,size=num,rtdev=xxx,rgcount=n,rgsize=n,\n"
"\t\t\t    concurrency=num,zoned=0|1,start=n,reserved=n]\n"
"/* sectorsize */\t[-s size=num]\n"
"/* version */\t\t[-V]\n"
"\t\t\tdevicename\n"
"<devicename> is required unless -d name=xxx is given.\n"
"<num> is xxx (bytes), xxxs (sectors), xxxb (fs blocks), xxxk (xxx KiB),\n"
"      xxxm (xxx MiB), xxxg (xxx GiB), xxxt (xxx TiB) or xxxp (xxx PiB).\n"
"<value> is xxx (512 byte blocks).\n"

msgid "Usage: %s [-V] [-x] [-f] [-p prog] [-c cmd]... [-d project]... [path]\n"
msgstr "Användning: %s [-V] [-x] [-f] [-p prog] [-c cmd]... [-d projekt]... [sökväg]\n"

msgid "Usage: %s [-adfinrRstVx] [-m mode] [-p prog] [[-c|-C] cmd]... file\n"
msgstr "Användning: %s [-adfinrRstVx] [-m mode] [-p prog] [[-c|-C] cmd]... fil\n"

msgid "Usage: %s [-bdV] [-L logfile] source target [target ...]\n"
msgstr "Användning: %s [-bdV] [-L loggfil] källa mål [mål ...]\n"

msgid "Usage: %s [-c cmd] file\n"
msgstr "Användning: %s [-c cmd] fil\n"

msgid ""
"Usage: %s [-d] [-v] [-g] [-t time] [-p passes] [-f leftf] [-m mtab]\n"
"       %s [-d] [-v] [-g] xfsdev | dir | file ...\n"
"       %s -V\n"
"\n"
"Options:\n"
"       -g              Print to syslog (default if stdout not a tty).\n"
"       -t time         How long to run in seconds.\n"
"       -p passes       Number of passes before terminating global re-org.\n"
"       -f leftoff      Use this instead of %s.\n"
"       -m mtab         Use something other than /etc/mtab.\n"
"       -d              Debug, print even more.\n"
"       -v              Verbose, more -v's more verbose.\n"
"       -V              Print version number and exit.\n"
msgstr ""
"Användning: %s [-d] [-v] [-g] [-t time] [-p passes] [-f leftf] [-m mtab]\n"
"       %s [-d] [-v] [-g] xfsdev | dir | fil ...\n"
"       %s -V\n"
"\n"
"Alternativ:\n"
"       -g Skriv ut till syslog (standard om stdout inte är en tty).\n"
"       -t time Hur länge körningen ska pågå i sekunder.\n"
"       -p passes Antal passeringar innan global omorg avslutas.\n"
"       -f leftoff Använd detta istället för %s.\n"
"       -m mtab Använd något annat än /etc/mtab.\n"
"       -d Debugga, skriva ut ännu mer.\n"
"       -v Verbose, mer -v är mer verbose.\n"
"       -V Skriv ut versionsnummer och avsluta.\n"

msgid "Usage: %s [-ifFrxV] [-p prog] [-l logdev] [-R rtdev] [-c cmd]... device\n"
msgstr "Användning: %s [-ifFrxV] [-p prog] [-l logdev] [-R rtdev] [-c cmd]... enhet\n"

msgid "Usage: %s [OPTIONS] mountpoint\n"
msgstr "Användning: %s [OPTIONS] mountpoint\n"

msgid ""
"Usage: %s [options...] <device>\n"
"\n"
"Options:\n"
"    -c\t            try to continue if error found in log\n"
"    -C <filename>   copy the log from the filesystem to filename\n"
"    -d\t            dump the log in log-record format\n"
"    -e\t            exit when an error is found in the log\n"
"    -f\t            specified device is actually a file\n"
"    -l <device>     filename of external log\n"
"    -n\t            don't try and interpret log data\n"
"    -o\t            print buffer data in hex\n"
"    -s <start blk>  block # to start printing\n"
"    -v              print \"overwrite\" data\n"
"    -t\t            print out transactional view\n"
"\t-b          in transactional view, extract buffer info\n"
"\t-i          in transactional view, extract inode info\n"
"\t-q          in transactional view, extract quota info\n"
"    -D              print only data; no decoding\n"
"    -V              print version information\n"
msgstr ""
"Användning: %s [flaggor...] <enhet>\n"
"\n"
"Flaggor:\n"
"    -c försök att fortsätta om fel hittas i loggen\n"
"    -C <filename> kopiera loggen från filsystemet till filnamnet\n"
"    -d dumpa loggen i loggboksformat\n"
"    -e avsluta när ett fel hittas i loggen\n"
"    -f angiven enhet är faktiskt en fil\n"
"    -l <device> filnamn för extern logg\n"
"    -n försök inte att tolka loggdata\n"
"    -o skriv ut buffertdata i hex\n"
"    -s <start blk> block # för att starta utskriften\n"
"    -v skriv ut \"överskrivningsdata\"\n"
"    -t skriv ut transaktionsvyn\n"
"\t-b i transaktionsvyn, extrahera buffertinformation\n"
"\t-i i transaktionsvyn, extrahera inode-information\n"
"\t-q i transaktionsvyn, extrahera kvotinformation\n"
"    -D skriver endast ut data, ingen avkodning\n"
"    -V skriver ut versionsinformation\n"

msgid ""
"Usage: %s [options] device\n"
"\n"
"Options:\n"
"  -f           The device is a file\n"
"  -L           Force log zeroing. Do this as a last resort.\n"
"  -l logdev    Specifies the device where the external log resides.\n"
"  -m maxmem    Maximum amount of memory to be used in megabytes.\n"
"  -n           No modify mode, just checks the filesystem for damage.\n"
"               (Cannot be used together with -e.)\n"
"  -P           Disables prefetching.\n"
"  -r rtdev     Specifies the device where the realtime section resides.\n"
"  -v           Verbose output.\n"
"  -c subopts   Change filesystem parameters - use xfs_admin.\n"
"  -o subopts   Override default behaviour, refer to man page.\n"
"  -t interval  Reporting interval in seconds.\n"
"  -d           Repair dangerously.\n"
"  -e           Exit with a non-zero code if any errors were repaired.\n"
"               (Cannot be used together with -n.)\n"
"  -V           Reports version and exits.\n"
msgstr ""
"Användning: %s [flaggor] enhet\n"
"\n"
"Flaggor:\n"
"  -f Enheten är en fil\n"
"  -L Forcera nollställning av loggar. Gör detta som en sista utväg.\n"
"  -l logdev Anger den enhet där den externa loggen finns.\n"
"  -m maxmem Maximal minnesmängd som ska användas i megabyte.\n"
"  -n Inget modifieringsläge, kontrollerar bara om filsystemet är skadat.\n"
"               (Kan inte användas tillsammans med -e.)\n"
"  -P Avaktiverar förhämtning.\n"
"  -r rtdev Anger den enhet där realtidsavsnittet finns.\n"
"  -v Verbose-utdata.\n"
"  -c subopts Ändra filsystemets parametrar - använd xfs_admin.\n"
"  -o subopts Åsidosätta standardbeteende, se man-sidan.\n"
"  -t interval Rapporteringsintervall i sekunder.\n"
"  -d Reparera på ett farligt sätt.\n"
"  -e Avsluta med en kod som inte är noll om några fel har reparerats.\n"
"               (Kan inte användas tillsammans med -n.)\n"
"  -V Rapporterar version och avslutas.\n"

msgid ""
"Usage: %s [options] mountpoint\n"
"\n"
"Options:\n"
"\t-d          grow data/metadata section\n"
"\t-l          grow log section\n"
"\t-r          grow realtime section\n"
"\t-n          don't change anything, just show geometry\n"
"\t-i          convert log from external to internal format\n"
"\t-t          alternate location for mount table (/etc/mtab)\n"
"\t-x          convert log from internal to external format\n"
"\t-D size     grow data/metadata section to size blks\n"
"\t-L size     grow/shrink log section to size blks\n"
"\t-R size     grow realtime section to size blks\n"
"\t-e size     set realtime extent size to size blks\n"
"\t-m imaxpct  set inode max percent to imaxpct\n"
"\t-V          print version information\n"
msgstr ""
"Användning: %s [flaggor] monteringspunkt\n"
"\n"
"Flaggor:\n"
"\t-d          väx data/metadata-avsnitt\n"
"\t-l          väx loggavsnitt\n"
"\t-r          väx realtidsavsnitt\n"
"\t-n          ändrar ingenting, visar bara geometri\n"
"\t-i          konvertera logg från externt till internt format\n"
"\t-t          alternativ plats för monteringstabell (/etc/mtab)\n"
"\t-x          konvertera loggen från internt till externt format\n"
"\t-D strl     utöka data/metadatasektionen till storlek blks\n"
"\t-L strl     växa/krympa loggsektion till storlek blks\n"
"\t-R strl     växa realtidsavsnittet till storlek blks\n"
"\t-e strl     ställ in realtidsavsnittets storlek till storlek blks\n"
"\t-m imaxpct  ställ in inode max procent till imaxpct\n"
"\t-V          skriv ut versionsinformation\n"

msgid ""
"Usage: %s [opts] directory [directory ...]\n"
"\t-b blocksize (fundamental filesystem blocksize)\n"
"\t-i logsize (internal log size)\n"
"\t-e logsize (external log size)\n"
"\t-v prints more verbose messages\n"
"\t-V prints version and exits\n"
"\t-h prints this usage message\n"
"\n"
"Note:\tblocksize may have 'k' appended to indicate x1024\n"
"\tlogsize may also have 'm' appended to indicate (1024 x 1024)\n"
msgstr ""
"Användning: %s [flaggor] katalog [katalog ...]\n"
"\t-b blocksize (grundläggande blockstorlek för filsystem)\n"
"\t-i logsize (intern loggstorlek)\n"
"\t-e loggstorlek (extern loggstorlek)\n"
"\t-v skriver ut mer utförliga meddelanden\n"
"\t-V skriver ut version och avslutar\n"
"\t-h skriver ut detta användningsmeddelande\n"
"\n"
"Obs: blocksize kan ha \"k\" som tillägg för att ange x1024\n"
"\tlogsize kan också ha tillägget \"m\" för att indikera (1024 x 1024)\n"

