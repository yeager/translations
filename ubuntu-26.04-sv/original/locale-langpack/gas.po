"  -mesa                   assemble for Enterprise System Architecture/390\n"
"  -mzarch                 assemble for z/Architecture\n"
"  -march=<processor>      assemble for processor <processor>\n"
"  -mregnames              allow symbolic names for registers\n"
"  -mno-regnames           do not allow symbolic names for registers\n"
"  -mwarn-areg-zero        warn about base/index register zero\n"
"  -mwarn-regtype-mismatch=strict\n"
"                          warn about register name type mismatches\n"
"  -mwarn-regtype-mismatch=relaxed\n"
"                          warn about register name type mismatches,\n"
"                          but allow FPR and VR to be used interchangeably\n"
"  -mno-warn-regtype-mismatch\n"
"                          do not warn about register name type mismatches\n"
msgstr ""
"S390-flaggor:\n"
"  -m31                    generera 31-bitars filformat (31/32 bitars ordstorlek)\n"
"  -m64                    generera 64-bitars filformat (64 bitars ordstorlek)\n"
"  -mesa                   assemblera för Enterprise System Architecture/390\n"
"  -mzarch                 assemblera för z/Architecture\n"
"  -march=<processor>     assemblera för processor <processor>\n"
"  -mregnames              tillåt symboliska namn för register\n"
"  -mno-regnames           tillåt inte symboliska namn för register\n"
"  -mwarn-areg-zero        varna om bas-/indexregister noll\n"
"  -mwarn-regtype-mismatch=strict\n"
"                          varna om registernamnstypskrockar\n"
"  -mwarn-regtype-mismatch=relaxed\n"
"                          varna om registernamnstypkonflikter,\n"
"                          men tillåt att FPR och VR används omväxlande\n"
"  -mno-warn-regtype-mismatch\n"
"                          varna inte om registernamnstypkonflikter\n"

