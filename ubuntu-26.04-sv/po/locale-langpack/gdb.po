msgstr "GDB stöder inte pekare till metoder på detta mål"

msgid "GDB internal error, type is NULL in stabsread.c."
msgstr "GDB internt fel, typen är NULL i stabsread.c."

msgid "GDB internal error: bad real_filenum"
msgstr "GDB internt fel: felaktigt real_filenum"

msgid "GDB serial timeout has expired.  Target detached."
msgstr "GDB:s seriella timeout har löpt ut. Målet har kopplats bort."

msgid "GDB sim does not yet support a load offset."
msgstr "GDB sim stöder ännu inte lastförskjutning."

msgid "GDB task: 0x%lx, pid: %d\n"
msgstr "GDB-uppgift: 0x%lx, pid: %d\n"

msgid ""
"GDB will not be able to display syscall names nor to verify if\n"
"any provided syscall numbers are valid."
msgstr "GDB kommer inte att kunna visa syscall-namn eller verifiera om några angivna syscall-nummer är giltiga."

msgid "GDB: Failed to set controlling terminal: %s"
msgstr "GDB: Det gick inte att ställa in styrterminalen: %s"

msgid "Garbage '%s' at end of command"
msgstr "Skräp '%s' i slutet av kommandot"

msgid "Garbage '%s' follows condition"
msgstr "Sopor '%s' följer villkoret"

msgid "Garbage after \"%s\" command: `%s'"
msgstr "Sopor efter kommandot \"%s\": `%s'"

msgid "Garbage after \"show remote system-call-allowed\" command: `%s'"
msgstr "Skräp efter kommandot \"show remote system-call-allowed\": `%s'"

msgid "Garbage at end of command"
msgstr "Sopor vid kommandots slut"

msgid "Gdb's prompt is \"%s\".\n"
msgstr "Gdb:s prompt är \"%s\"\n"

msgid "Generic command for manipulating the kernel memory interface."
msgstr "Generiskt kommando för att manipulera kärnminnesgränssnittet."

msgid "Generic command for setting command history parameters."
msgstr "Generiskt kommando för att ställa in parametrar för kommandohistorik."

msgid "Generic command for setting gdb debugging flags"
msgstr "Generiskt kommando för att ställa in gdb-felsökningsflaggor"

msgid "Generic command for setting how things print."
msgstr "Generiskt kommando för att ställa in hur saker ska skrivas ut."

msgid "Generic command for setting how types print."
msgstr "Generiskt kommando för att ställa in hur typer skrivs ut."

msgid "Generic command for showing Ada-specific settings."
msgstr "Generiskt kommando för att visa Ada-specifika inställningar."

msgid "Generic command for showing command history parameters."
msgstr "Generiskt kommando för att visa kommandohistorikparametrar."

msgid "Generic command for showing gdb debugging flags"
msgstr "Generiskt kommando för att visa gdb-felsökningsflaggor"

msgid "Generic command for showing print settings."
msgstr "Generiskt kommando för att visa utskriftsinställningar."

msgid "Generic command for showing things about the debugger."
msgstr "Generiskt kommando för att visa information om felsökaren."

msgid "Generic command for showing things about the program being debugged."
msgstr "Generiskt kommando för att visa information om programmet som felsöks."

msgid "Generic command for showing type-printing settings."
msgstr "Generiskt kommando för att visa inställningar för typsnitt."

msgid ""
"Get fatal error; make debugger dump its core.\n"
"GDB sets its handling of SIGQUIT back to SIG_DFL and then sends\n"
"itself a SIGQUIT signal."
msgstr "Få ett allvarligt fel; få felsökaren att dumpa sin kärna. GDB återställer sin hantering av SIGQUIT till SIG_DFL och skickar sedan en SIGQUIT-signal till sig själv."

msgid "Get info on a specific port."
msgstr "Få information om en specifik port."

msgid "Get info on a specific task."
msgstr "Få information om en specifik uppgift."

msgid "Get info on a specific thread."
msgstr "Få information om ett specifikt ämne."

msgid "Get information on all mach region for the task."
msgstr "Hämta information om alla mach-regioner för uppgiften."

msgid "Get information on all mach sub region for the task."
msgstr "Få information om alla mach-underregioner för uppgiften."

msgid "Get information on mach region at given address."
msgstr "Hämta information om mach-regionen på angiven adress."

msgid "Get list of ports in a task."
msgstr "Hämta lista över portar i en uppgift."

msgid "Get list of tasks in system."
msgstr "Hämta lista över uppgifter i systemet."

msgid "Get list of threads in a task."
msgstr "Hämta lista över trådar i en uppgift."

msgid "Getting a string is unsupported in this language."
msgstr "Det går inte att få en sträng i det här språket."

msgid ""
"Give GDB an internal error.\n"
"Cause GDB to behave as if an internal error was detected."
msgstr "Ge GDB ett internt fel. Få GDB att bete sig som om ett internt fel upptäckts."

msgid ""
"Give GDB an internal warning.\n"
"Cause GDB to behave as if an internal warning was reported."
msgstr "Ge GDB en intern varning. Få GDB att bete sig som om en intern varning rapporterats."

msgid "Give a trace of entries into the syscall."
msgstr "Ge en spårning av poster i syscall."

msgid "Give a trace of exits from the syscall."
msgstr "Ge en spårning av utgångar från syscall."

msgid "Go backward to insn number %s\n"
msgstr "Gå tillbaka till insn-nummer %s\n"

msgid "Go forward to insn number %s\n"
msgstr "Gå vidare till insn-nummer %s\n"

msgid ""
"Go to an earlier-bookmarked point in the program's execution history.\n"
"Argument is the bookmark number of a bookmark saved earlier by using \n"
"the 'bookmark' command, or the special arguments:\n"
"  start (beginning of recording)\n"
"  end   (end of recording)\n"
msgstr "Gå till en tidigare bokmärkt punkt i programmets exekveringshistorik. Argumentet är bokmärkesnumret för ett bokmärke som tidigare sparats med kommandot \"bookmark\", eller de speciella argumenten: start (början av inspelningen) slut (slutet av inspelningen)\n"

msgid "Got a strange event, msg id = %d."
msgstr "Fick ett konstigt meddelande, msg id = %d."

msgid "Got object file from memory but can't read symbols: %s."
msgstr "Hämtade objektfilen från minnet men kan inte läsa symbolerna: %s."

msgid "Got request for bad register number %d."
msgstr "Fick begäran om ogiltigt registernummer %d."

msgid "Got request to store bad register number %d."
msgstr "Fick begäran om att lagra ogiltigt registernummer %d."

msgid "HMM: threadlist did not echo arg thread, dropping it."
msgstr "HMM: trådlistan ekade inte arg-tråden, så den tas bort."

msgid "Handling event, msgid = %d: %s"
msgstr "Hantering av händelse, msgid = %d: %s"

msgid "Hardware FPU type %d\n"
msgstr "Hårdvara FPU-typ %d\n"

msgid "Hardware assisted breakpoint %d"
msgstr "Hårdvarustödd brytpunkt %d"

msgid "Hardware assisted ranged breakpoint %d from %s to %s."
msgstr "Hårdvaruassisterad avbrottspunkt %d från %s till %s."

msgid "Hardware breakpoints used exceeds limit."
msgstr "Antalet använda hårdvarubrytpunkter överskrider gränsen."

msgid "Hardware flow control is %s.\n"
msgstr "Hårdvaruflödeskontroll är %s\n"

msgid "Hex-encoded '%s' must have an even number of characters."
msgstr "Hex-kodade '%s' måste ha ett jämnt antal tecken."

msgid "Highest recorded instruction number is %s.\n"
msgstr "Det högsta registrerade instruktionsnumret är %s\n"

msgid "History does not go back to $$%d."
msgstr "Historiken går inte tillbaka till $$%d."

msgid "History expansion on command input is %s.\n"
msgstr "Historikens utvidgning vid kommandoinmatning är %s\n"

msgid "History has not yet reached $%d."
msgstr "Historiken har ännu inte nått $%d."

msgid "History value must have integer type."
msgstr "Historikvärdet måste vara av typen heltal."

msgid "History values used in line specs must have integer values."
msgstr "Historikvärden som används i linjespecifikationer måste vara heltal."

msgid "Hit beginning of text section without finding enclosing function for address %s"
msgstr "Början av textavsnittet träffad utan att någon omslutande funktion för adress %s hittades"

msgid "Hit heuristic-fence-post without finding enclosing function for address %s"
msgstr "Träffade heuristisk staketstolpe utan att hitta omslutande funktion för adress %s"

msgid "Host %s resolved to: %s.\n"
msgstr "Värd %s upplöst till: %s\n"

msgid "I don't know how this 8 byte value is returned."
msgstr "Jag vet inte hur detta 8-byte-värde returneras."

msgid "I don't know how to return an 8 byte value."
msgstr "Jag vet inte hur man returnerar ett 8-bytesvärde."

msgid "I refuse to debug myself!"
msgstr "Jag vägrar att felsöka mig själv!"

msgid "I'm confused:  virtual function table has bad type"
msgstr "Jag är förvirrad: den virtuella funktionstabellen har fel typ"

msgid "I'm sorry, Dave, I can't do that.  Symbol format `%s' unknown."
msgstr "Jag är ledsen, Dave, men det kan jag inte göra. Symbolformatet `%s' är okänt."

msgid "IDs of currently known checkpoints."
msgstr "ID-nummer för för närvarande kända kontrollpunkter."

msgid "IDs of specified inferiors (all inferiors if no argument)."
msgstr "ID för angivna underordnade (alla underordnade om inget argument anges)."

msgid ""
"If \"on\", symbols from all shared object libraries will be loaded\n"
"automatically when the inferior begins execution, when the dynamic linker\n"
"informs gdb that a new library has been loaded, or when attaching to the\n"
"inferior.  Otherwise, symbols must be loaded manually, using `sharedlibrary'."
msgstr "Om \"på\", kommer symboler från alla delade objektbibliotek att laddas automatiskt när underordnade börjar köras, när den dynamiska länkaren informerar gdb om att ett nytt bibliotek har laddats, eller när man ansluter till underordnade. Annars måste symboler laddas manuellt med hjälp av `sharedlibrary'."

msgid ""
"If ON, GDB will display disassembly of the next source line, in addition\n"
"to displaying the source line itself.  If the next source line cannot\n"
"be displayed (e.g., source is unavailable or there's no line info), GDB\n"
"will display disassembly of next instruction instead of showing the\n"
"source line.\n"
"If AUTO, display disassembly of next instruction only if the source line\n"
"cannot be displayed.\n"
"If OFF (which is the default), never display the disassembly of the next\n"
"source line."
msgstr ""
"Om ON är aktiverat visar GDB disassembleringen av nästa källkodsrad, utöver att visa själva källkodsraden. Om nästa källkodsrad inte kan visas (t.ex. om källkoden inte är tillgänglig eller om det inte finns någon radinformation) visar GDB disassembleringen av nästa instruktion istället för att visa källkodsraden.\n"
"Om AUTO, visa endast disassembleringen av nästa instruktion om källraden inte kan visas. Om OFF (vilket är standard), visa aldrig disassembleringen av nästa källrad."

msgid ""
"If `unix', target file names (e.g., loaded shared library file names)\n"
"starting the forward slash (`/') character are considered absolute,\n"
"and the directory separator character is the forward slash (`/').  If\n"
"`dos-based', target file names starting with a drive letter followed\n"
"by a colon (e.g., `c:'), are also considered absolute, and the\n"
"backslash (`\\') is also considered a directory separator.  Set to\n"
"`auto' (which is the default), to let GDB decide, based on its\n"
"knowledge of the target operating system."
msgstr ""
"Om `unix', betraktas målfilnamn (t.ex. namn på laddade delade biblioteksfiler) som börjar med ett snedstreck (`/') som absoluta, och katalogseparatorn är snedstrecket (`/'). Om\n"
"dos-baserad betraktas även målfilnamn som börjar med en enhetsbokstav följd av ett kolon (t.ex. c:) som absoluta, och backslash (\\) betraktas också som ett katalogavgränsningstecken. Ställ in på auto (vilket är standard) för att låta GDB avgöra utifrån sin kunskap om målsystemet."

msgid ""
"If enabled, auto-loaded Python scripts are loaded when the debugger reads\n"
"an executable or shared library.\n"
"This options has security implications for untrusted inferiors."
msgstr "Om denna funktion är aktiverad laddas automatiskt laddade Python-skript när felsökaren läser en körbar fil eller ett delat bibliotek. Detta alternativ har säkerhetsimplikationer för icke-betrodda underordnade."

msgid ""
"If enabled, canned sequences of commands are loaded when debugger starts\n"
"from .gdbinit file in current directory.  Such files are deprecated,\n"
"use a script associated with inferior executable file instead.\n"
"This options has security implications for untrusted inferiors."
msgstr "Om detta är aktiverat laddas fördefinierade kommandosekvenser när felsökaren startar från .gdbinit-filen i aktuell katalog. Sådana filer är föråldrade, använd istället ett skript som är associerat med den underordnade körbara filen. Detta alternativ har säkerhetsimplikationer för opålitliga underordnade program."

msgid ""
"If enabled, canned sequences of commands are loaded when the debugger reads\n"
"an executable or shared library.\n"
"This options has security implications for untrusted inferiors."
msgstr "Om denna funktion är aktiverad laddas fördefinierade kommandosekvenser när felsökaren läser en körbar fil eller ett delat bibliotek. Detta alternativ har säkerhetsimplikationer för icke-betrodda underordnade."

msgid ""
"If enabled, libthread_db will be searched in 'set libthread-db-search-path'\n"
"locations to load libthread_db compatible with the inferior.\n"
"Standard system libthread_db still gets loaded even with this option off.\n"
"This options has security implications for untrusted inferiors."
msgstr "Om detta alternativ är aktiverat kommer libthread_db att sökas i 'set libthread-db-search-path'-platser för att ladda libthread_db som är kompatibelt med underordnade program. Standardlibthread_db laddas fortfarande även om detta alternativ är inaktiverat. Detta alternativ har säkerhetsimplikationer för opålitliga underordnade program."

msgid ""
"If nonzero, gdb will give control to the user when the dynamic linker\n"
"notifies gdb of shared library events.  The most common event of interest\n"
"to the user would be loading/unloading of a new library."
msgstr "Om värdet är större än noll kommer gdb att ge kontrollen till användaren när den dynamiska länkaren meddelar gdb om händelser i delade bibliotek. Den vanligaste händelsen som är av intresse för användaren är laddning/avlastning av ett nytt bibliotek."

msgid ""
"If on, GDB assumes that standard input is a terminal.  In practice, it\n"
"means that GDB should wait for the user to answer queries associated to\n"
"commands entered at the command prompt.  If off, GDB assumes that standard\n"
"input is not a terminal, and uses the default answer to all queries.\n"
"If auto (the default), determine which mode to use based on the standard\n"
"input settings."
msgstr "Om den är på, antar GDB att standardinmatningen är en terminal. I praktiken innebär det att GDB ska vänta på att användaren svarar på frågor som är kopplade till kommandon som matats in i kommandotolken. Om den är av, antar GDB att standardinmatningen inte är en terminal och använder standardsvaret på alla frågor. Om den är auto (standard), bestämmer den vilket läge som ska användas baserat på standardinmatningsinställningarna."

msgid ""
"If on, GDB will delegate some of the debugging operations to the\n"
"agent, if the target supports it.  This will speed up those\n"
"operations that are supported by the agent.\n"
"If off, GDB will not use agent, even if such is supported by the\n"
"target."
msgstr "Om den är aktiverad kommer GDB att delegera vissa felsökningsåtgärder till agenten, om målet stöder detta. Detta kommer att påskynda de åtgärder som stöds av agenten. Om den är inaktiverad kommer GDB inte att använda agenten, även om detta stöds av målet."

msgid ""
"If on, an unrecognized breakpoint location will cause gdb to create a\n"
"pending breakpoint.  If off, an unrecognized breakpoint location results in\n"
"an error.  If auto, an unrecognized breakpoint location results in a\n"
"user-query to see if a pending breakpoint should be created."
msgstr "Om den är påslagen kommer en okänd brytpunkt att få gdb att skapa en väntande brytpunkt. Om den är avstängd resulterar en okänd brytpunkt i ett fel. Om den är inställd på auto resulterar en okänd brytpunkt i en användarfråga om en väntande brytpunkt ska skapas."

msgid ""
"If on, and some memory map is defined, debugger will emit errors on\n"
"accesses to memory not defined in the memory map. If off, accesses to all\n"
"memory addresses will be allowed."
msgstr "Om funktionen är aktiverad och någon minneskarta är definierad, kommer felsökaren att rapportera fel vid åtkomst till minne som inte är definierat i minneskartan. Om funktionen är inaktiverad tillåts åtkomst till alla minnesadresser."

msgid ""
"If on, gdb will use displaced stepping to step over breakpoints if it is\n"
"supported by the target architecture.  If off, gdb will not use displaced\n"
"stepping to step over breakpoints, even if such is supported by the target\n"
"architecture.  If auto (which is the default), gdb will use displaced stepping\n"
"if the target architecture supports it and non-stop mode is active, but will not\n"
"use it in all-stop mode (see help set non-stop)."
msgstr "Om den är påslagen kommer gdb att använda förskjuten stegning för att hoppa över brytpunkter om detta stöds av målarkitekturen.  Om den är avstängd kommer gdb inte att använda förskjutna steg för att gå över brytpunkter, även om detta stöds av målarkitekturen. Om den är inställd på auto (vilket är standard) kommer gdb att använda förskjutna steg om målarkitekturen stöder det och non-stop-läget är aktivt, men kommer inte att använda det i all-stop-läget (se help set non-stop)."

msgid ""
"If redirect is off, output will go to both the screen and the log file.\n"
"If redirect is on, output will go only to the log file."
msgstr "Om omdirigering är avstängd kommer utdata att skickas både till skärmen och till loggfilen. Om omdirigering är påslagen kommer utdata endast att skickas till loggfilen."

msgid "If set, a break, instead of a cntrl-c, is sent to the remote target."
msgstr "Om inställt skickas ett avbrott, istället för cntrl-c, till det fjärranslutna målet."

msgid "If set, logging overrides the log file."
msgstr "Om inställt, åsidosätter loggningen loggfilen."

msgid ""
"If set, the debugger will automatically use hardware breakpoints for\n"
"breakpoints set with \"break\" but falling in read-only memory.  If not set,\n"
"a warning will be emitted for such breakpoints."
msgstr "Om detta är inställt kommer felsökaren automatiskt att använda hårdvarubrytpunkter för brytpunkter som är inställda med \"break\" men som hamnar i skrivskyddat minne. Om detta inte är inställt kommer en varning att visas för sådana brytpunkter."

msgid ""
"If true, GDB will use only one debug register when watching a variable of\n"
"scalar type, thus assuming that the variable is accessed through the address\n"
"of its first byte."
msgstr "Om detta är sant kommer GDB endast att använda ett felsökningsregister när den övervakar en variabel av skalär typ, och därmed anta att variabeln nås via adressen till dess första byte."

msgid ""
"If you are debugging a stripped executable, GDB needs to search through the\n"
"program for the start of a function.  This command sets the distance of the\n"
"search.  The only need to set it is when debugging a stripped executable."
msgstr "Om du felsöker en strippad körbar fil måste GDB söka igenom programmet efter början på en funktion. Detta kommando ställer in sökavståndet. Det enda tillfället då det behöver ställas in är vid felsökning av en strippad körbar fil."

msgid ""
"If zero, gdb will not use hardware for new watchpoints, even if\n"
"such is available.  (However, any hardware watchpoints that were\n"
"created before setting this to nonzero, will continue to use watchpoint\n"
"hardware.)"
msgstr "Om värdet är noll kommer gdb inte att använda hårdvara för nya övervakningspunkter, även om sådan finns tillgänglig. (Alla hårdvaruövervakningspunkter som skapades innan detta värde sattes till något annat än noll kommer dock att fortsätta att använda övervakningspunktshårdvara.)"

msgid ""
"Ignore a file while stepping.\n"
"Usage: skip file [FILENAME]\n"
"If no filename is given, ignore the current file."
msgstr "Ignorera en fil under stegvis körning. Användning: skip file [FILNAMN] Om inget filnamn anges ignoreras den aktuella filen."

msgid ""
"Ignore a function while stepping.\n"
"Usage: skip [FUNCTION NAME]\n"
"If no function name is given, ignore the current function."
msgstr "Ignorera en funktion under stegning. Användning: skip [FUNKTIONSNAMN] Om inget funktionsnamn anges ignoreras den aktuella funktionen."

msgid ""
"Ignore a function while stepping.\n"
"Usage: skip function [FUNCTION NAME]\n"
"If no function name is given, skip the current function."
msgstr "Ignorera en funktion under stegning. Användning: skip function [FUNKTIONSNAMN] Om inget funktionsnamn anges, hoppa över den aktuella funktionen."

msgid "Ignore count ignored for tracepoint %d."
msgstr "Ignoreringsantal ignorerat för spårpunkt %d."

msgid "Ignore file pending future shared library load? "
msgstr "Ignorera fil i väntan på framtida delad biblioteksinläsning? "

msgid "Ignore function pending future shared library load? "
msgstr "Ignorera funktionen i väntan på framtida delad biblioteksinläsning? "

msgid "Ignored signals bitmap: %s\n"
msgstr "Ignorerade signaler bitmap: %s\n"

msgid "Ignoring packet error, continuing...\n"
msgstr "Ignorerar paketfel, fortsätter..\n"

msgid "Ignoring trace file definition \"%s\""
msgstr "Ignorerar spårningsfilsdefinitionen \"%s\""

msgid "Ignoring unknown attribute %s"
msgstr "Ignorerar okänt attribut %s"

msgid "Illegal argument for \"%s\" command, should be \"%s\" or \"%s\"."
msgstr "Olagligt argument för kommandot \"%s\", ska vara \"%s\" eller \"%s\"."

msgid "Illegal argument for \"%s\" command, should be an integer."
msgstr "Olagligt argument för kommandot \"%s\", ska vara ett heltal."

msgid "Illegal argument for \"set remote system-call-allowed\" command"
msgstr "Olagligt argument för kommandot \"set remote system-call-allowed\""

msgid ""
"Illegal argument to \"set signal-thread\" command.\n"
"Should be an integer thread ID, or `none'."
msgstr "Olagligt argument till kommandot \"set signal-thread\". Bör vara ett heltal som tråd-ID eller \"none\"."

msgid "Illegal process-id: %s."
msgstr "Olaglig process-id: %s."

msgid "Illegal return value length: %d"
msgstr "Olaglig returvärdeslängd: %d"

msgid "Implicitly sized type can not contain bitfield \"%s\""
msgstr "Implicit storleksanpassad typ kan inte innehålla bitfält \"%s\""

msgid "Impossible to change the Thread Local Base"
msgstr "Omöjligt att ändra trådens lokala bas"

msgid "In %s,\n"
msgstr "I %s,\n"

msgid ""
"In observer mode, GDB can get data from the inferior, but not\n"
"affect its execution.  Registers and memory may not be changed,\n"
"breakpoints may not be set, and the program cannot be interrupted\n"
"or signalled."
msgstr "I observatörsläge kan GDB hämta data från underordnade enheter, men inte påverka deras körning. Register och minne får inte ändras, brytpunkter får inte sättas och programmet får inte avbrytas eller signaleras."

msgid "Inappropriate modifiers to format specifier '%c' in printf"
msgstr "Olämpliga modifierare för formatangivelsen '%c' i printf"

msgid "Incompatible types in assignment"
msgstr "Inkompatibla typer vid tilldelning"

msgid "Incompatible types on DWARF stack"
msgstr "Inkompatibla typer på DWARF-stacken"

msgid "Incomplete format specifier at end of format string"
msgstr "Ofullständig formatangivelse i slutet av formatsträngen"

msgid "Incomplete response to threadinfo request."
msgstr "Ofullständigt svar på begäran om trådinformation."

msgid ""
"Incorrect Number of Arguments.\n"
"%s"
msgstr "Felaktigt antal argument. %s"

msgid "Incorrect usage, too few arguments in command"
msgstr "Felaktig användning, för få argument i kommandot"

msgid "Incorrect usage, too many arguments in command"
msgstr "Felaktig användning, för många argument i kommandot"

msgid "Index in component association out of bounds."
msgstr "Index i komponentassociation utanför gränserna."

msgid ""
"Inferior %d and inferior %d would have identical simulator state.\n"
"(This simulator does not support the running of more than one inferior.)"
msgstr "Inferior %d och inferior %d skulle ha identiskt simulatorstatus. (Denna simulator stöder inte körning av mer än en inferior.)"

msgid "Inferior ID %d has no threads."
msgstr "Underordnad ID %d har inga trådar."

msgid "Inferior ID %d not known."
msgstr "Underordnad ID %d okänd."

msgid "Inferior arguments must be provided in a tuple."
msgstr "Underordnade argument måste anges i en tupel."

msgid "Inferior debugging is %s.\n"
msgstr "Undermålig felsökning är %s\n"

msgid "Inferior has no threads."
msgstr "Inferior har inga trådar."

msgid "Inferior no longer exists."
msgstr "Underlägsenhet existerar inte längre."

msgid "Inferior not available"
msgstr "Underlägsen inte tillgänglig"

msgid "Inferior's terminal status (currently saved by GDB):\n"
msgstr "Inferiors terminalstatus (för närvarande sparad av GDB)\n"

msgid "Infinite loop detected"
msgstr "Oändlig loop upptäckt"

msgid "Info about currently known program spaces."
msgstr "Information om för närvarande kända programutrymmen."

msgid "Info record options"
msgstr "Info-postalternativ"

msgid "Information about the current source file."
msgstr "Information om den aktuella källfilen."

msgid "Init-if-undefined requires an assignment expression."
msgstr "Init-if-undefined kräver ett tilldelningsuttryck."

