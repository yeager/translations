msgid "  --args             Arguments after executable-file are passed to inferior\n"
msgstr "  --args Argument efter exekverbar-fil skickas till underordnad\n"

msgid ""
"  --dbx              DBX compatibility mode.\n"
"  --directory=DIR    Search for source files in DIR.\n"
"  --exec=EXECFILE    Use EXECFILE as the executable.\n"
"  --fullname         Output information used by emacs-GDB interface.\n"
"  --help             Print this message.\n"
msgstr "  --dbx DBX-kompatibilitetsläge. --directory=DIR Sök efter källfiler i DIR. --exec=EXECFILE Använd EXECFILE som körbar fil. --fullname Skriv ut information som används av emacs-GDB-gränssnittet. --help Skriv ut detta meddelande\n"

msgid ""
"  --interpreter=INTERP\n"
"                     Select a specific interpreter / user interface\n"
msgstr "  --interpreter=INTERP Välj en specifik tolk/användargränssnitt\n"

msgid ""
"  --se=FILE          Use FILE as symbol file and executable file.\n"
"  --symbols=SYMFILE  Read symbols from SYMFILE.\n"
"  --tty=TTY          Use TTY for input/output by the program being debugged.\n"
msgstr "  --se=FILE Använd FILE som symbolfil och körbar fil. --symbols=SYMFILE Läs symboler från SYMFILE. --tty=TTY Använd TTY för in-/utdata av programmet som felsöks\n"

msgid "  --tui              Use a terminal user interface.\n"
msgstr "  --tui Använd ett terminalanvändargränssnitt\n"

msgid ""
"  --version          Print version information and then exit.\n"
"  -w                 Use a window interface.\n"
"  --write            Set writing into executable and core files.\n"
"  --xdb              XDB compatibility mode.\n"
msgstr "  --version Skriv ut versionsinformation och avsluta sedan. -w Använd ett fönstergränssnitt. --write Ställ in skrivning till körbara filer och kärnfiler. --xdb XDB-kompatibilitetsläge\n"

msgid ""
"  -b BAUDRATE        Set serial port baud rate used for remote debugging.\n"
"  --batch            Exit after processing options.\n"
"  --batch-silent     As for --batch, but suppress all gdb stdout output.\n"
"  --return-child-result\n"
"                     GDB exit code will be the child's exit code.\n"
"  --cd=DIR           Change current directory to DIR.\n"
"  --command=FILE, -x Execute GDB commands from FILE.\n"
"  --eval-command=COMMAND, -ex\n"
"                     Execute a single GDB command.\n"
"                     May be used multiple times and in conjunction\n"
"                     with --command.\n"
"  --init-command=FILE, -ix Like -x but execute it before loading inferior.\n"
"  --init-eval-command=COMMAND, -iex Like -ex but before loading inferior.\n"
"  --core=COREFILE    Analyze the core dump COREFILE.\n"
"  --pid=PID          Attach to running process PID.\n"
msgstr ""
"  -b BAUDRATE Ställ in baudhastigheten för seriell port som används för fjärrfelsökning. --batch Avsluta efter bearbetning av alternativ. --batch-silent Som för --batch, men undertryck all gdb stdout-utdata. --return-child-result GDB-avslutningskoden blir barnets avslutningskod.\n"
"  --cd=DIR Ändra aktuell katalog till DIR. --command=FILE, -x Kör GDB-kommandon från FILE. --eval-command=COMMAND, -ex Kör ett enda GDB-kommando. Kan användas flera gånger och i kombination med --command.\n"
"  --init-command=FILE, -ix Som -x men körs innan inferior laddas. --init-eval-command=COMMAND, -iex Som -ex men innan inferior laddas. --core=COREFILE Analyserar kärndumpen COREFILE. --pid=PID Kopplar till den körande processen PID\n"

msgid ""
"  -l TIMEOUT         Set timeout in seconds for remote debugging.\n"
"  --nw\t\t     Do not use a window interface.\n"
"  --nx               Do not read any "
msgstr "  -l TIMEOUT Ställ in timeout i sekunder för fjärrfelsökning. --nw Använd inte ett fönstergränssnitt. --nx Läs inte något "

