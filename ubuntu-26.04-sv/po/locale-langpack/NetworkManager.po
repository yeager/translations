"    bond:         [queue-id <0-65535>]\n"
"\n"
"  IP_OPTIONS:\n"
"                  [ip4 <IPv4 address>] [gw4 <IPv4 gateway>]\n"
"                  [ip6 <IPv6 address>] [gw6 <IPv6 gateway>]\n"
