#: .././db/agf.c:24
msgid "set address to agf header"
msgstr "ange adress till AGF-huvudet"

#: .././db/agf.c:72
msgid ""
"\n"
" set allocation group free block list\n"
"\n"
" Example:\n"
"\n"
" agf 2 - move location to AGF in 2nd filesystem allocation group\n"
"\n"
" Located in the second sector of each allocation group, the AGF\n"
" contains the root of two different freespace btrees:\n"
" The 'cnt' btree keeps track freespace indexed on section size.\n"
" The 'bno' btree tracks sections of freespace indexed on block number.\n"
msgstr ""
"\n"
" ange tilldelningsgruppens lista över fria block\n"
"\n"
" Exempel:\n"
"\n"
" agf 2 - flytta positionen till AGF i filsystemets andra tilldelningsgrupp\n"
"\n"
" AGF finns i den andra sektorn i varje tilldelningsgrupp och innehåller\n"
" roten till två olika B-träd för fritt utrymme:\n"
" B-trädet 'cnt' håller reda på fritt utrymme indexerat efter sektionsstorlek.\n"
" B-trädet 'bno' spårar avsnitt med fritt utrymme indexerat efter blocknummer.\n"

#: .././db/agf.c:97 .././db/agfl.c:95 .././db/agi.c:85 .././db/sb.c:178
#, c-format
msgid "bad allocation group number %s\n"
msgstr "ogiltigt allokeringsgruppsnummer %s\n"

#: .././db/agfl.c:25
msgid "set address to agfl block"
msgstr "ange adress till AGFL-blocket"

#: .././db/agfl.c:68
msgid ""
"\n"
" set allocation group freelist\n"
"\n"
" Example:\n"
"\n"
" agfl 5\n"
" Located in the fourth sector of each allocation group,\n"
" the agfl freelist for internal btree space allocation is maintained\n"
" for each allocation group.  This acts as a reserved pool of space\n"
" separate from the general filesystem freespace (not used for user data).\n"
"\n"
msgstr ""
"\n"
" ange tilldelningsgruppens frilista\n"
"\n"
" Exempel:\n"
"\n"
" agfl 5\n"
" AGFL-frilistan för intern tilldelning av B-trädsutrymme finns i den\n"
" fjärde sektorn i varje tilldelningsgrupp. Den fungerar som en reserverad\n"
" utrymmespott skild från filsystemets allmänna fria utrymme\n"
" (används inte för användardata).\n"
"\n"

#: .././db/agi.c:24
msgid "set address to agi header"
msgstr "ange adress till AGI-huvudet"

#: .././db/agi.c:60
msgid ""
"\n"
" set allocation group inode btree\n"
"\n"
" Example:\n"
"\n"
" agi 3 (set location to 3rd allocation group inode btree and type to 'agi')\n"
"\n"
" Located in the 3rd 512 byte block of each allocation group,\n"
" the agi inode btree tracks all used/free inodes in the allocation group.\n"
" Inodes are allocated in 16k 'chunks', each btree entry tracks a 'chunk'.\n"
"\n"
msgstr ""
"\n"
" ange inode-B-trädet för tilldelningsgruppen\n"
"\n"
" Exempel:\n"
"\n"
" agi 3 (ange positionen till inode-B-trädet i den tredje tilldelningsgruppen och typen till 'agi')\n"
"\n"
" AGI:s inode-B-träd finns i det tredje 512-byteblocket i varje tilldelningsgrupp\n"
" och spårar alla använda och fria inoder i tilldelningsgruppen.\n"
" Inoder tilldelas i 16k-'block', och varje B-trädspost spårar ett 'block'.\n"
"\n"

