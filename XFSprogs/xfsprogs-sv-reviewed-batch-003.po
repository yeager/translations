msgstr ""
"Den aktuella filen är inte en mellanlagringsfil för en atomär uppdatering.\n"

#: .././io/exchrange.c:368
msgid "committing update"
msgstr "genomför uppdatering"

#: .././io/exchrange.c:372
#, c-format
msgid "Committed updates to '%s'.\n"
msgstr "Genomförde uppdateringar av '%s'.\n"

#: .././io/exchrange.c:377
#, c-format
