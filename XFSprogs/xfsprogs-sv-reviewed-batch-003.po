#: .././spaceman/trim.c:94
#, c-format
msgid ""
"\n"
"Discard filesystem free space\n"
"\n"
" -a agno       -- trim all the freespace in the given AG agno\n"
" -f            -- trim all the freespace in the entire filesystem\n"
" offset length -- trim the freespace in the range {offset, length}\n"
" -m minlen     -- skip freespace extents smaller than minlen\n"
"\n"
"One of -a, -f, or the offset/length pair are required.\n"
"\n"
msgstr ""
"\n"
"Kassera filsystemets lediga utrymme\n"
"\n"
" -a agno       -- trimma allt ledigt utrymme i angiven AG agno\n"
" -f            -- trimma allt ledigt utrymme i hela filsystemet\n"
" offset length -- trimma ledigt utrymme i intervallet {offset, length}\n"
" -m minlen     -- hoppa över utsträckningar med ledigt utrymme mindre än minlen\n"
"\n"
"Ett av -a, -f eller offset/längd-paret krävs.\n"
"\n"

#: .././spaceman/trim.c:117
msgid "Discard filesystem free space"
msgstr "Kassera ledigt utrymme i filsystemet"

