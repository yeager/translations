#: .././spaceman/freesp.c:341
#, c-format
msgid ""
"\n"
"Examine filesystem free space\n"
"\n"
" -a agno  -- Scan only the given AG agno.\n"
" -b       -- binary histogram bin size\n"
" -d       -- debug output\n"
" -e bsize -- Use fixed histogram bin size of bsize\n"
" -g       -- Print only a per-AG summary.\n"
" -h hbsz  -- Use custom histogram bin size of h1.\n"
"             Multiple specifications are allowed.\n"
" -m bmult -- Use histogram bin size multiplier of bmult.\n"
" -r       -- Display realtime device free space information.\n"
" -s       -- Emit freespace summary information.\n"
"\n"
"Only one of -b, -e, -h, or -m may be specified.\n"
"\n"
msgstr ""
"\n"
"Undersök filsystemets lediga utrymme\n"
"\n"
" -a agno  -- Genomsök endast angiven AG agno.\n"
" -b       -- Binär histogramklassbredd\n"
" -d       -- Felsökningsutdata\n"
" -e bsize -- Använd fast histogramklassbredd bsize\n"
" -g       -- Skriv endast ut en sammanfattning per AG.\n"
" -h hbsz  -- Använd anpassad histogramklassbredd h1.\n"
"             Flera specifikationer tillåts.\n"
" -m bmult -- Använd histogramklassbreddsmultiplikator bmult.\n"
" -r       -- Visa information om ledigt utrymme på realtidsenheten.\n"
" -s       -- Skriv ut sammanfattande information om ledigt utrymme.\n"
"\n"
"Endast en av -b, -e, -h eller -m kan anges.\n"
"\n"

