  {
    "owner_key": "component::elkm1::config::step::reconfigure::description",
    "target_key": "component::elkm1::config::step::manual_connection::description",
    "owner_en_live": "The address string must be in the form 'address[:port]' for 'secure' and 'non-secure'. Example: '192.168.1.1'. The port is optional and defaults to 2101 for 'non-secure' and 2601 for 'secure'. For the serial protocol, the address must be in the form 'tty[:baud]'. Example: '/dev/ttyS1'. The baud is optional and defaults to 115200.",
    "owner_sv_live": "Adresssträngen måste vara i formen 'address[:port]' för 'säker' och 'icke säker'. Exempel: '192.168.1.1'. Porten är valfri och standardinställningen är 2101 för 'icke säker' och 2601 för 'säker'. För serieprotokollet måste adressen vara i formen 'tty[:baud]'. Exempel: '/dev/ttyS1'. Bauden är valfri och standardinställningen är 115200.",
    "target_en_live": "The address string must be in the form 'address[:port]' for 'secure' and 'non-secure'. Example: '192.168.1.1'. The port is optional and defaults to 2101 for 'non-secure' and 2601 for 'secure'. For the serial protocol, the address must be in the form 'tty[:baud]'. Example: '/dev/ttyS1'. The baud is optional and defaults to 115200.",
    "target_sv_live": "Adressträngen måste ha formen \"address[:port]\" för \"säker\" och \"icke-säker\". Exempel: '192.168.1.1'. Porten är valfri att ange och är som standard 2101 för \"icke-säker\" och 2601 för \"säker\". För det seriella protokollet måste adressen vara i formen 'tty[:baud]'. Exempel: '/dev/ttyS1'. Baud är valfri att ange och är som standard 115200.",
    "target_source": "The address string must be in the form 'address[:port]' for 'secure' and 'non-secure'. Example: '192.168.1.1'. The port is optional and defaults to 2101 for 'non-secure' and 2601 for 'secure'. For the serial protocol, the address must be in the form 'tty[:baud]'. Example: '/dev/ttyS1'. The baud is optional and defaults to 115200.",
    "owner_english_matches_target": true,
    "target_english_matches_source": true,
    "owner_swedish_matches_target": false,
    "target_key_id": "147705013"
