  {
    "owner_key": "component::satel_integra::config_subentries::partition::step::reconfigure::data_description::arm_home_mode",
    "target_key": "component::satel_integra::config_subentries::partition::step::user::data_description::arm_home_mode",
    "owner_en_live": "The arming mode to use for 'arm home':\nMode 1 fully arms and bypasses zones that have the 'Bypassed if no exit' option enabled.\nMode 2 disarms interior zones; exterior zones trigger silent alarms and other alarm zones trigger loud alarms.\nMode 3 is like mode 2, but delayed zones are instant.",
    "owner_sv_live": "Läget i vilket område tillkopplas när 'tillkoppla hemma' används. För mer information om skillnaderna mellan dem, se Satel Integras manual.",
    "target_en_live": "The arming mode to use for 'arm home':\nMode 1 fully arms and bypasses zones that have the 'Bypassed if no exit' option enabled.\nMode 2 disarms interior zones; exterior zones trigger silent alarms and other alarm zones trigger loud alarms.\nMode 3 is like mode 2, but delayed zones are instant.",
    "target_sv_live": "Vilket aktiveringsläge som ska användas för ”arm home”:\nLäge 1 aktiverar systemet fullt ut och kringgår zoner där alternativet ”Kringgås om ingen utgång” är aktiverat.\nLäge 2 avaktiverar zoner inomhus; zoner utomhus utlöser tysta larm och övriga larmzoner utlöser högljudda larm.\nLäge 3 fungerar som läge 2, men zoner med fördröjning aktiveras omedelbart.",
    "target_source": "The arming mode to use for 'arm home':\nMode 1 fully arms and bypasses zones that have the 'Bypassed if no exit' option enabled.\nMode 2 disarms interior zones; exterior zones trigger silent alarms and other alarm zones trigger loud alarms.\nMode 3 is like mode 2, but delayed zones are instant.",
    "owner_english_matches_target": true,
    "target_english_matches_source": true,
    "owner_swedish_matches_target": false,
    "target_key_id": "711840813"
