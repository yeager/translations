  {
    "key": "component::vicare::issues::update_redirect_uri::description",
    "key_id": "849365809",
    "translation_id": "8449378039",
    "en": "ViCare has been migrated to OAuth2 authentication. Your existing session will continue to work, but if re-authentication is ever needed, you must first add a redirect URI to your API client.\n\nGo to the [Viessmann Developer Portal]({viessmann_developer_portal}) and add the following redirect URI to your API client:\n\n`{redirect_url}`\n\nThis is not urgent, but we recommend doing it soon.",
    "sv": "ViCare har övergått till OAuth2-autentisering. Din befintliga session fortsätter att fungera, men om du behöver autentisera dig på nytt måste du först lägga till en omdirigerings-URI i API-klienten.\n\nGå till [Viessmann Developer Portal]({viessmann_developer_portal}) och lägg till följande omdirigerings-URI i din API-klient:\n\n`{redirect_url}`\n\nDet är inte brådskande, men vi rekommenderar att du gör det snart.",
    "verification_method": "Lokalise API GET; current Core source and shared reference target reviewed",
    "verified_date": "2026-11-27",
    "status": "saved-and-read-back",
    "source_revision": "1d07105b760c73093145526a51758938e87cc658"
  },
