  {
    "key": "component::teslemetry::preview_features::charge_on_solar::description",
    "key_id": "965007057",
    "translation_id": "10130729845",
    "en": "Adds a vehicle switch to enable and disable Tesla's charge on solar mode, and a number entity to set its lower charge limit. The existing charge limit number entity is reused as the upper charge limit.\n\nThis feature does not currently expose a reliable state from the API, so the switch and lower limit use an assumed state.",
    "sv": "Lägger till en fordonsbrytare för att aktivera och inaktivera Teslas läge för laddning med solel samt ett numeriskt reglage för den nedre laddningsgränsen. Den befintliga entiteten för laddningsgräns används som övre laddningsgräns.\n\nFunktionen visar för närvarande inget tillförlitligt tillstånd via API:t, så brytaren och den nedre gränsen använder ett antaget tillstånd.",
    "verification_method": "Lokalise API write and live readback",
    "status": "saved-and-read-back",
    "verified_date": "2026-11-28",
    "source_revision": "1d07105b760c73093145526a51758938e87cc658"
  },
  {
    "key": "component::teslemetry::preview_features::charge_on_solar::disable_confirmation",
    "key_id": "965007058",
    "translation_id": "10130729909",
    "en": "The charge-on-solar switch and lower limit will be removed from your Teslemetry vehicles.",
    "sv": "Brytaren för laddning med solel och den nedre gränsen tas bort från dina Teslemetry-fordon.",
    "verification_method": "Lokalise API write and live readback",
    "status": "saved-and-read-back",
    "verified_date": "2026-11-28",
    "source_revision": "1d07105b760c73093145526a51758938e87cc658"
  },
  {
    "key": "component::teslemetry::preview_features::charge_on_solar::enable_confirmation",
    "key_id": "965007059",
    "translation_id": "10130729973",
    "en": "The charge-on-solar switch and lower limit will be added to your Teslemetry vehicles.",
    "sv": "Brytaren för laddning med solel och den nedre gränsen läggs till i dina Teslemetry-fordon.",
    "verification_method": "Lokalise API write and live readback",
