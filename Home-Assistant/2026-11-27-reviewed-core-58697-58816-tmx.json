[
  {
    "key": "component::teslemetry::issues::streaming_toggle::fix_flow::step::confirm::description",
    "key_id": "876851291",
    "translation_id": "8900088454",
    "en": "Home Assistant cannot receive streaming data from {vehicle} because the \"Allow Third-Party App Data Streaming\" toggle is disabled. This option is only available on older Model S and Model X vehicles with Intel-based computers.\n\n1. In {vehicle}, open Controls > Safety.\n2. Enable **Allow Third-Party App Data Streaming**.\n3. Select **Submit** below to re-check.",
    "sv": "Home Assistant kan inte ta emot strömmande data från {vehicle}, eftersom alternativet ”Tillåt dataströmning från tredjepartsappar” är inaktiverat. Det här alternativet finns bara på äldre Model S- och Model X-fordon med Intel-baserade datorer.\n\n1. Öppna Kontroller > Säkerhet i {vehicle}.\n2. Aktivera **Tillåt dataströmning från tredjepartsappar**.\n3. Välj **Skicka** nedan för att kontrollera igen.",
    "verification_method": "Lokalise API PUT/GET readback",
    "verified_date": "2026-11-27",
    "status": "saved-and-read-back",
    "source_revision": "1d07105b760c73093145526a51758938e87cc658"
  },
