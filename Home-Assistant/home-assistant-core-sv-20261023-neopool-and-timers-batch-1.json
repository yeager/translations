  {
    "translation_id": 9864226019,
    "key_id": 943419473,
    "key_name": "component::fronius::config::step::reconfigure::data_description::auto_revert_power_limit",
    "source": "The inverter drops the AC power limit an hour after it last received it, and returns to its own settings. Home Assistant sends the limit again every 15 minutes, so this only takes effect once it stops sending - because Home Assistant is down, or because the integration was removed. Battery setpoints are not affected - the inverter supports no timeout for them.",
    "translation": "Växelriktaren tar bort AC-effektgränsen en timme efter att den senast tog emot den och återgår till sina egna inställningar. Home Assistant skickar gränsen igen var femtonde minut, så detta får bara effekt när systemet slutar skicka den eftersom Home Assistant är nere eller integreringen tagits bort. Batteriernas börvärden påverkas inte. Växelriktaren har ingen tidsgräns för dem."
  },
  {
    "translation_id": 9864226083,
    "key_id": 943419474,
    "key_name": "component::fronius::config::step::user::data::auto_revert_power_limit",
    "source": "Revert the AC power limit if Home Assistant stops",
    "translation": "Återställ gränsen för AC-effekt om Home Assistant stoppas"
  },
  {
    "translation_id": 9864226147,
    "key_id": 943419475,
    "key_name": "component::fronius::config::step::user::data_description::auto_revert_power_limit",
    "source": "The inverter drops the AC power limit an hour after it last received it, and returns to its own settings. Home Assistant sends the limit again every 15 minutes, so this only takes effect once it stops sending - because Home Assistant is down, or because the integration was removed. Battery setpoints are not affected - the inverter supports no timeout for them.",
    "translation": "Växelriktaren tar bort AC-effektgränsen en timme efter att den senast tog emot den och återgår till sina egna inställningar. Home Assistant skickar gränsen igen var femtonde minut, så detta får bara effekt när systemet slutar skicka den eftersom Home Assistant är nere eller integreringen tagits bort. Batteriernas börvärden påverkas inte. Växelriktaren har ingen tidsgräns för dem."
  },
