msgstr "Ett tillägg med detta UUID har redan lagts till"

#: sweettooth/extensions/serializers.py:180 extensions-web-domain-django:1
msgid "The `version-name` field in `metadata.json` must be a string"
msgstr "Fältet `version-name` i `metadata.json` måste vara en sträng"

#: sweettooth/extensions/serializers.py:94 extensions-web-domain-django:1
msgid "You must agree with the extensions.gnome.org terms of service"
msgstr "Du måste godkänna användningsvillkoren för extensions.gnome.org"

