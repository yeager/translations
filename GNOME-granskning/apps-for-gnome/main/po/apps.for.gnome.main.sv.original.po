msgstr "Glest översatt"

msgid "Switch Language"
msgstr "Växla språk"

msgid "The GNOME Project"
msgstr "GNOME-projektet"

msgid "This app is available in your language."
msgstr "Detta program finns tillgängligt på ditt språk."

