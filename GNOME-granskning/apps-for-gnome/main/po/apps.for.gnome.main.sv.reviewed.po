msgstr "Vissa delar av det här programmet är tillgängliga på ditt språk."

msgid "Sparsely translated"
msgstr "Sparsamt översatt"

msgid "Switch Language"
msgstr "Växla språk"

msgid "The GNOME Project"
msgstr "GNOME-projektet"

msgid "This app is available in your language."
msgstr "Det här programmet finns på ditt språk."

msgid "This app is not available in your language."
msgstr "Det här programmet finns inte på ditt språk."

msgid "This website is available in many languages"
msgstr "Webbplatsen finns på många språk"

msgid "Visit the dedicated homepage for this project."
msgstr "Besök projektets egen webbplats."

msgid "Visit the online help page for this app."
msgstr "Besök programmets hjälpsida."

msgid "Website"
msgstr "Webbplats"

#. Translators: Information about seasonal header image
msgid ""
"[Disability Pride "
"Month](https://en.wikipedia.org/wiki/Disability_Pride_Month), displaying two"
" [disability flags](https://en.wikipedia.org/wiki/Disability_flag) and an "
"[autistic flag](https://en.wikipedia.org/wiki/Autistic_Pride_Day)."
msgstr ""
"[Månaden för "
"funktionsnedsättningsstolthet](https://en.wikipedia.org/wiki/Disability_Pride_Month),"
" med två "
"[funktionsrättsflaggor](https://en.wikipedia.org/wiki/Disability_flag) och "
"en [autismflagga](https://en.wikipedia.org/wiki/Autistic_Pride_Day)."

#. Translators: Information about seasonal header image
msgid ""
"[Queer Pride Month](https://en.wikipedia.org/wiki/Pride_Month), displaying "
"the [intersex](https://en.wikipedia.org/wiki/Intersex_flag), "
"[trans](https://en.wikipedia.org/wiki/Transgender_flag), and "
"[rainbow](https://en.wikipedia.org/wiki/Rainbow_flag_(LGBT)), flags."
msgstr ""
"[Månaden för queer pride](https://en.wikipedia.org/wiki/Pride_Month), med "
"[intersexflaggan](https://en.wikipedia.org/wiki/Intersex_flag), "
"[transflaggan](https://en.wikipedia.org/wiki/Transgender_flag) och "
"[regnbågsflaggan](https://en.wikipedia.org/wiki/Rainbow_flag_(LGBT))."

#. Translators: The {} will be replaced with a social media name like
#. 'Mastodon'
msgid "{} account"
msgstr "{}-konto"

