#: src/org.gnome.Terminal.gschema.xml:138
msgid "Human-readable name of the profile"
msgstr "Läsbart namn för profilen"

#: src/org.gnome.Terminal.gschema.xml:139
msgid "Human-readable name of the profile."
msgstr "Läsbart namn för profilen."

#: src/org.gnome.Terminal.gschema.xml:143
msgid "Default color of text in the terminal"
msgstr "Standardfärg för texten i terminalfönstret"

#: src/org.gnome.Terminal.gschema.xml:144
msgid ""
"Default color of text in the terminal, as a color specification (can be "
"HTML-style hex digits, or a color name such as “red”)."
msgstr ""
"Standardfärg för terminaltexten, angiven som en färgspecifikation (till "
"exempel hexadecimala siffror i HTML-format eller ett färgnamn som ”red”)."

#: src/org.gnome.Terminal.gschema.xml:148
msgid "Default color of terminal background"
msgstr "Standardfärg för terminalbakgrund"

#: src/org.gnome.Terminal.gschema.xml:149
msgid ""
"Default color of terminal background, as a color specification (can be HTML-"
"style hex digits, or a color name such as “red”)."
msgstr ""
"Standardfärg för terminalbakgrunden, angiven som en färgspecifikation (till "
"exempel hexadecimala siffror i HTML-format eller ett färgnamn som ”red”)."

#: src/org.gnome.Terminal.gschema.xml:153
msgid "Default color of bold text in the terminal"
msgstr "Standardfärg för fet text i terminalfönstret"

#: src/org.gnome.Terminal.gschema.xml:154
msgid ""
"Default color of bold text in the terminal, as a color specification (can be"
" HTML-style hex digits, or a color name such as “red”). This is ignored if "
"bold-color-same-as-fg is true."
msgstr ""
"Standardfärg för fet terminaltext, angiven som en färgspecifikation (till "
"exempel hexadecimala siffror i HTML-format eller ett färgnamn som ”red”). "
"Färgen används inte om bold-color-same-as-fg är true (sant)."

#: src/org.gnome.Terminal.gschema.xml:158
msgid "Whether bold text should use the same color as normal text"
msgstr "Anger om fet text ska ha samma färg som vanlig text"

#: src/org.gnome.Terminal.gschema.xml:159
msgid ""
"If true, boldface text will be rendered using the same color as normal text."
msgstr "Om true (sant) återges fet text med samma färg som vanlig text."

#: src/org.gnome.Terminal.gschema.xml:164
msgid ""
"Scale factor for the cell height to increase line spacing. (Does not "
"increase the font’s height.)"
msgstr ""
"Skalningsfaktor för teckencellernas höjd som ökar radavståndet. (Typsnittets"
" höjd påverkas inte.)"

#: src/org.gnome.Terminal.gschema.xml:169
msgid ""
"Scale factor for the cell width to increase letter spacing. (Does not "
"increase the font’s width.)"
msgstr ""
"Skalningsfaktor för teckencellernas bredd som ökar teckenavståndet. "
"(Typsnittets bredd påverkas inte.)"

#: src/org.gnome.Terminal.gschema.xml:173
msgid "Whether to use custom cursor colors"
msgstr "Anger om anpassade markörfärger ska användas"

#: src/org.gnome.Terminal.gschema.xml:174
msgid "If true, use the cursor colors from the profile."
msgstr "Om true (sant) används profilens markörfärger."

#: src/org.gnome.Terminal.gschema.xml:178
msgid "Cursor background color"
msgstr "Bakgrundsfärg för markör"

#: src/org.gnome.Terminal.gschema.xml:179
msgid ""
"Custom color of the background of the terminal’s cursor, as a color "
"specification (can be HTML-style hex digits, or a color name such as “red”)."
" This is ignored if cursor-colors-set is false."
msgstr ""
"Anpassad bakgrundsfärg för terminalmarkören, angiven som en "
"färgspecifikation (till exempel hexadecimala siffror i HTML-format eller ett"
" färgnamn som ”red”). Färgen används inte om cursor-colors-set är false "
"(falskt)."

#: src/org.gnome.Terminal.gschema.xml:183
msgid "Cursor foreground colour"
msgstr "Förgrundsfärg för markör"

#: src/org.gnome.Terminal.gschema.xml:184
msgid ""
"Custom color for the foreground of the text character at the terminal’s "
"cursor position, as a color specification (can be HTML-style hex digits, or "
"a color name such as “red”). This is ignored if cursor-colors-set is false."
msgstr ""
"Anpassad förgrundsfärg för tecknet vid terminalmarkören, angiven som en "
"färgspecifikation (till exempel hexadecimala siffror i HTML-format eller ett"
" färgnamn som ”red”). Färgen används inte om cursor-colors-set är false "
"(falskt)."

#: src/org.gnome.Terminal.gschema.xml:188
msgid "Whether to use custom highlight colors"
msgstr "Anger om anpassade markeringsfärger ska användas"

#: src/org.gnome.Terminal.gschema.xml:189
msgid "If true, use the highlight colors from the profile."
msgstr "Om true (sant) används profilens markeringsfärger."

#: src/org.gnome.Terminal.gschema.xml:193
msgid "Highlight background color"
msgstr "Bakgrundsfärg för färgmarkering"

#: src/org.gnome.Terminal.gschema.xml:194
msgid ""
"Custom color of the background of the terminal’s highlight, as a color "
"specification (can be HTML-style hex digits, or a color name such as “red”)."
" This is ignored if highlight-colors-set is false."
msgstr ""
"Anpassad bakgrundsfärg för markeringen i terminalen, angiven som en "
"färgspecifikation (till exempel hexadecimala siffror i HTML-format eller ett"
" färgnamn som ”red”). Färgen används inte om highlight-colors-set är false "
"(falskt)."

#: src/org.gnome.Terminal.gschema.xml:198
msgid "Highlight foreground colour"
msgstr "Förgrundsfärg för färgmarkering"

#: src/org.gnome.Terminal.gschema.xml:199
msgid ""
"Custom color for the foreground of the text character at the terminal’s "
"highlight position, as a color specification (can be HTML-style hex digits, "
"or a color name such as “red”). This is ignored if highlight-colors-set is "
"false."
msgstr ""
"Anpassad förgrundsfärg för tecknet vid terminalens markör, angiven som en "
"färgspecifikation (till exempel hexadecimala siffror i HTML-format eller ett"
" färgnamn som ”red”). Färgen används inte om highlight-colors-set är false "
"(falskt)."

#: src/org.gnome.Terminal.gschema.xml:203
msgid "Whether to perform bidirectional text rendering"
msgstr "Anger om dubbelriktad textåtergivning ska användas"

#: src/org.gnome.Terminal.gschema.xml:204
msgid "If true, perform bidirectional text rendering (“BiDi”)."
msgstr "Om true (sant) används dubbelriktad textåtergivning (”BiDi”)."

#: src/org.gnome.Terminal.gschema.xml:208
msgid "Whether to perform Arabic shaping"
msgstr "Anger om arabisk textformning ska användas"

#: src/org.gnome.Terminal.gschema.xml:209
msgid "If true, shape Arabic text."
msgstr "Om true (sant) formas arabisk text."

#: src/org.gnome.Terminal.gschema.xml:213
msgid "Whether to enable SIXEL images"
msgstr "Anger om SIXEL-bilder ska aktiveras"

#: src/org.gnome.Terminal.gschema.xml:214
msgid "If true, SIXEL sequences are parsed and images are rendered."
msgstr "Om true (sant) tolkas SIXEL-sekvenser och bilder återges."

#: src/org.gnome.Terminal.gschema.xml:218
msgid "Whether bold is also bright"
msgstr "Anger om fet text också ska vara ljus"

#: src/org.gnome.Terminal.gschema.xml:219
msgid ""
"If true, setting bold on the first 8 colors also switches to their bright "
"variants."
msgstr ""
"Om true (sant) växlar de första åtta färgerna till ljusa varianter när de "
"görs feta."

#: src/org.gnome.Terminal.gschema.xml:223
msgid "Whether to ring the terminal bell"
msgstr "Anger om terminalens ljudsignal ska användas"

#: src/org.gnome.Terminal.gschema.xml:227
#| msgid ""
#| "List of ASCII punctuation characters that are not to be treated as part of a"
#| " word when doing word-wise selection"
msgid "List of punctuation characters that are treated as word characters"
msgstr "Lista över skiljetecken som behandlas som ordtecken"

#: src/org.gnome.Terminal.gschema.xml:228
msgid ""
"By default, when doing word-wise selection, most punctuation breaks up word "
"boundaries. This list of exceptions will instead be treated as part of the "
"word."
msgstr ""
"Som standard delar de flesta skiljetecken upp ord vid ordvis markering. "
"Tecknen i den här undantagslistan behandlas i stället som en del av ordet."

#: src/org.gnome.Terminal.gschema.xml:233
msgid "Default number of columns"
msgstr "Antal kolumner som standard"

#: src/org.gnome.Terminal.gschema.xml:234
msgid ""
"Number of columns in newly created terminal windows. Has no effect if "
"use_custom_default_size is not enabled."
msgstr ""
"Antal kolumner i nyligen skapade terminalfönster. Har ingen effekt om "
"use_custom_default_size inte har aktiverats."

#: src/org.gnome.Terminal.gschema.xml:239
msgid "Default number of rows"
msgstr "Antal rader som standard"

#: src/org.gnome.Terminal.gschema.xml:240
msgid ""
"Number of rows in newly created terminal windows. Has no effect if "
"use_custom_default_size is not enabled."
msgstr ""
"Antal rader i nyligen skapade terminalfönster. Har ingen effekt om "
"use_custom_default_size inte har aktiverats."

#: src/org.gnome.Terminal.gschema.xml:244
msgid "When to show the scrollbar"
msgstr "När rullningslisten ska visas"

#: src/org.gnome.Terminal.gschema.xml:248
#| msgid "Whether to enable SIXEL images"
msgid "Whether to enable kinetic scrolling"
msgstr "Anger om tröghetsrullning ska aktiveras"

#: src/org.gnome.Terminal.gschema.xml:252
msgid "Number of lines to keep in scrollback"
msgstr "Antal rader som ska behållas i rullningshistoriken"

#: src/org.gnome.Terminal.gschema.xml:253
msgid ""
"Number of scrollback lines to keep around. You can scroll back in the "
"terminal by this number of lines; lines that don’t fit in the scrollback are"
" discarded. If scrollback_unlimited is true, this value is ignored."
msgstr ""
"Antal rader som ska behållas i rullningshistoriken. Du kan rulla så många "
"rader bakåt i terminalen; rader som inte ryms tas bort. Om "
"scrollback_unlimited är true (sant) ignoreras det här värdet."

#: src/org.gnome.Terminal.gschema.xml:257
msgid "Whether an unlimited number of lines should be kept in scrollback"
msgstr ""
"Anger om ett obegränsat antal rader ska behållas i rullningshistoriken"

#: src/org.gnome.Terminal.gschema.xml:258
msgid ""
"If true, scrollback lines will never be discarded. The scrollback history is"
" stored on disk temporarily, so this may cause the system to run out of disk"
" space if there is a lot of output to the terminal."
msgstr ""
"Om true (sant) tas rader i rullningshistoriken aldrig bort. Historiken "
"lagras tillfälligt på disk, så den kan fylla disken om terminalen visar "
"mycket utdata."

#: src/org.gnome.Terminal.gschema.xml:262
#| msgid "Whether to scroll to the bottom when a key is pressed"
msgid "Whether to scroll to the bottom when text is inserted"
msgstr "Anger om terminalen ska rulla längst ned när text klistras in"

#: src/org.gnome.Terminal.gschema.xml:263
#| msgid "Whether to scroll to the bottom when a key is pressed"
msgid ""
"If true, the terminal will scroll to the bottom when text is inserted by "
"paste."
msgstr "Om true (sant) rullar terminalen längst ned när text klistras in."

#: src/org.gnome.Terminal.gschema.xml:267
msgid "Whether to scroll to the bottom when a key is pressed"
msgstr "Anger om terminalen ska rulla längst ned när en tangent trycks ned"

#: src/org.gnome.Terminal.gschema.xml:268
msgid "If true, pressing a key jumps the scrollbar to the bottom."
msgstr ""
"Om true (sant) flyttas rullningslisten längst ned när en tangent trycks ned."

#: src/org.gnome.Terminal.gschema.xml:272
msgid "Whether to scroll to the bottom when there’s new output"
msgstr "Anger om terminalen ska rulla längst ned när nya utdata visas"

#: src/org.gnome.Terminal.gschema.xml:273
msgid ""
"If true, whenever there’s new output the terminal will scroll to the bottom."
msgstr ""
"Om true (sant) rullar terminalen längst ned så snart nya utdata visas."

#: src/org.gnome.Terminal.gschema.xml:277
msgid "What to do with the terminal when the child command exits"
msgstr "Vad som ska hända med terminalen när barnkommandot avslutas"

#: src/org.gnome.Terminal.gschema.xml:278
msgid ""
"Possible values are “close” to close the terminal, “restart” to restart the "
"command, and “hold” to keep the terminal open with no command running "
"inside."
msgstr ""
"Möjliga värden är ”close” för att stänga terminalen, ”restart” för att "
"starta om kommandot och ”hold” för att lämna terminalen öppen utan ett "
"körande kommando."

#: src/org.gnome.Terminal.gschema.xml:282
msgid "Whether to launch the command in the terminal as a login shell"
msgstr "Anger om kommandot i terminalen ska köras som ett inloggningsskal"

#: src/org.gnome.Terminal.gschema.xml:283
msgid ""
"If true, the command inside the terminal will be launched as a login shell "
"(argv[0] will have a hyphen in front of it)."
msgstr ""
"Om true (sant) körs kommandot i terminalen som ett inloggningsskal (ett "
"bindestreck läggs före argv[0])."

#: src/org.gnome.Terminal.gschema.xml:287
msgid "Whether to preserve the working directory when opening a new terminal"
msgstr "Anger om arbetskatalogen ska bevaras när en ny terminal öppnas"

#: src/org.gnome.Terminal.gschema.xml:288
msgid ""
"Controls when opening a new terminal from a previous one carries over the "
"working directory of the opening terminal to the new one."
msgstr ""
"Anger om den nya terminalen ska ärva arbetskatalogen från terminalen den "
"öppnades från."

#: src/org.gnome.Terminal.gschema.xml:294
msgid "Whether to run a custom command instead of the shell"
msgstr "Anger om ett anpassat kommando ska köras i stället för skalet"

#: src/org.gnome.Terminal.gschema.xml:295
msgid ""
"If true, the value of the custom_command setting will be used in place of "
"running a shell."
msgstr ""
"Om true (sant) används värdet för inställningen custom_command i stället för"
" att starta ett skal."

#: src/org.gnome.Terminal.gschema.xml:299
msgid "Whether to blink the cursor"
msgstr "Anger om markören ska blinka"

#: src/org.gnome.Terminal.gschema.xml:300
msgid ""
"The possible values are “system” to use the global cursor blinking settings,"
" or “on” or “off” to set the mode explicitly."
msgstr ""
"Möjliga värden är ”system” för att använda systemets globala inställning för"
" markörblinkning, eller ”on” och ”off” för att välja läge uttryckligen."

#: src/org.gnome.Terminal.gschema.xml:304
msgid "The cursor appearance"
msgstr "Markörens utseende"

#: src/org.gnome.Terminal.gschema.xml:308
msgid ""
"Possible values are “always” or “never” allow blinking text, or only when "
"the terminal is “focused” or “unfocused”."
msgstr ""
"Möjliga värden är ”always” eller ”never” för att tillåta blinkande text "
"alltid respektive aldrig, eller endast när terminalen är ”focused” (har "
