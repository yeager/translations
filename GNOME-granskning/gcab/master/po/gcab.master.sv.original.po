#: src/gcab.c:83
msgid "Dumping data to:"
msgstr "Dumpar data till:"

#: src/gcab.c:120
msgid "Print program version"
msgstr "Skriv ut version på programmet"

#: src/gcab.c:121
msgid "Be verbose"
msgstr "Var informativ"

#: src/gcab.c:122
msgid "Create archive"
msgstr "Skapa arkiv"

#: src/gcab.c:123
msgid "Extract all files"
msgstr "Extrahera alla filer"

#: src/gcab.c:125
msgid "Refuse to extract more than N bytes (0 for unlimited)"
msgstr "Vägra extrahera mer än N byte (0 för obegränsat)"

#: src/gcab.c:125
msgid "N"
msgstr "N"

#: src/gcab.c:126
msgid "Dump reserved and extra data"
msgstr "Dumpa reserverad och extra data"

#: src/gcab.c:127
msgid "List content"
msgstr "Lista innehåll"

#: src/gcab.c:128
msgid "List content with file details"
msgstr "Lista innehåll med fildetaljer"

#: src/gcab.c:129
msgid "Change to directory DIR"
msgstr "Ändra till katalogen KAT"

#: src/gcab.c:129
msgid "DIR"
msgstr "KAT"

#: src/gcab.c:130
msgid "Use zip compression"
msgstr "Använd zip-komprimering"

#: src/gcab.c:131
msgid "Do not include path"
msgstr "Inkludera inte sökväg"

#: src/gcab.c:132
msgid "Reserve space in cabinet for signing (e.g. -s 6144 reserves 6K bytes)"
msgstr ""
"Reservera utrymme i kabinettet för signering (-s 6144 reserverar t.ex 6K "
"byte)"

#: src/gcab.c:133
msgid "FILE INPUT_FILES..."
msgstr "FIL INDATAFILER…"

#: src/gcab.c:144
msgid "- create a Cabinet file"
msgstr "- skapa en kabinettfil"

#: src/gcab.c:145
msgid "Report bugs to:"
msgstr "Rapportera fel till:"

#: src/gcab.c:147
msgid ""
"gcab saves many files together into a cabinet archive, and can restore\n"
"individual files from the archive."
msgstr ""
"gcab sparar många filer samtidigt till ett kabinettarkiv och kan återställa\n"
"individuella filer från arkivet."

#: src/gcab.c:154
msgid "Option parsing failed"
msgstr "Tolkning av flaggor misslyckades"

#: src/gcab.c:164
msgid "Please specify a single operation"
msgstr "Ange en enstaka åtgärd"

#: src/gcab.c:169
msgid "Extraction size limit must not be negative"
msgstr "Extraktionsgränsen får inte vara negativ"

#: src/gcab.c:174
msgid "Reserved space must be between 0 and 65535 bytes"
msgstr "Reserverat utrymme måste vara mellan 0 och 65535 byte"

#: src/gcab.c:179
msgid "Cabinet file must be specified"
msgstr "Kabinettfil måste anges"

#: src/gcab.c:194
msgid "Error reading"
msgstr "Fel vid läsning"

#: src/gcab.c:224
msgid "<unknown-date>"
msgstr "<okänt-datum>"

#: src/gcab.c:239
msgid "Error during extraction"
msgstr "Fel vid extrahering"

#: src/gcab.c:255
msgid "Error while reading signature"
msgstr "Fel vid läsning av signatur"

#: src/gcab.c:267
msgid "No input files specified"
msgstr "Inga indatafiler angivna"

#: src/gcab.c:286
msgid "Cannot add file"
msgstr "Kan inte lägga till fil"

#: src/gcab.c:292
msgid "No files to be archived"
msgstr "Inga filer att arkivera"

#: src/gcab.c:300
msgid "Cannot create cab file"
msgstr "Kan inte skapa cab-fil"

#: src/gcab.c:306
msgid "Cannot add folder to cab file"
msgstr "Kan inte lägga till mapp till cab-fil"

#: src/gcab.c:316
msgid "Cannot write cab file"
msgstr "Kan inte skriva cab-fil"
