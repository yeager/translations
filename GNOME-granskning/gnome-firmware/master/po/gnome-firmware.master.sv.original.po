#. window title
#: data/appdata/org.gnome.Firmware.metainfo.xml.in:8
#: data/org.gnome.Firmware.desktop.in:2 src/gfu-main.ui:8 src/gfu-main.ui:109
msgid "Firmware"
msgstr "Firmware"

#: data/appdata/org.gnome.Firmware.metainfo.xml.in:9
#: data/org.gnome.Firmware.desktop.in:3
msgid "Install firmware on devices"
msgstr "Installera fast programvara på enheter"

#: data/appdata/org.gnome.Firmware.metainfo.xml.in:11
msgid ""
"A power-user tool that allows updating, reinstalling and downgrading of "
"firmware on devices supported by fwupd."
msgstr ""
"Ett verktyg för avancerade användare som tillåter uppdatering, "
"ominstallation och nedgradering av fast programvara på enheter som stöds av "
"fwupd."

#: data/appdata/org.gnome.Firmware.metainfo.xml.in:23
msgid "Devices panel"
msgstr "Enhetspanel"

#: data/appdata/org.gnome.Firmware.metainfo.xml.in:27
msgid "Releases panel"
msgstr "Utgåvepanel"

#: data/appdata/org.gnome.Firmware.metainfo.xml.in:32
msgid "Richard Hughes"
msgstr "Richard Hughes"

#. TRANSLATORS: these are desktop keywords - remember the trailing ';' :)
#: data/org.gnome.Firmware.desktop.in:11
msgid "Firmware;"
msgstr "Firmware;Fast programvara;"

#. TRANSLATORS: schema summary
#: data/org.gnome.Firmware.gschema.xml:6
msgid "Timestamp of the last device list request"
msgstr "Tidsstämpel för senaste förfrågan om enhetslista"

#. TRANSLATORS: schema description
#: data/org.gnome.Firmware.gschema.xml:8
msgid "The timestamp of the last time we uploaded the device list."
msgstr "Tidsstämpeln för när vi senast skickade enhetslistan."

#. TRANSLATORS: schema summary
#: data/org.gnome.Firmware.gschema.xml:13
msgid "Device ID"
msgstr "Enhets-ID"

#. TRANSLATORS: schema description
#: data/org.gnome.Firmware.gschema.xml:15
msgid "The device ID of the last device viewed in the UI."
msgstr "Enhets-ID för den sista enheten som visats i användargränssnittet."

#. TRANSLATORS: We verified the payload against the server
#: src/gfu-common.c:144
msgid "Trusted payload"
msgstr "Betrodd nyttolast"

#. TRANSLATORS: We verified the meatdata against the server
#: src/gfu-common.c:148
msgid "Trusted metadata"
msgstr "Betrodda metadata"

#. TRANSLATORS: version is newer
#: src/gfu-common.c:152
msgid "Is upgrade"
msgstr "Är uppgradering"

#. TRANSLATORS: version is older
#: src/gfu-common.c:156
msgid "Is downgrade"
msgstr "Är nedgradering"

#. TRANSLATORS: version cannot be installed due to policy
#: src/gfu-common.c:160
msgid "Blocked version"
msgstr "Blockerad version"

#. TRANSLATORS: version cannot be installed due to policy
#: src/gfu-common.c:164
msgid "Not approved"
msgstr "Inte godkänd"

#. TRANSLATORS: is not the main firmware stream
#: src/gfu-common.c:168
msgid "Alternate branch"
msgstr "Alternativ gren"

#. TRANSLATORS: is not supported by the vendor
#: src/gfu-common.c:172
msgid "Community supported"
msgstr "Stöds av gemenskapen"

#. TRANSLATORS: the QA team is someone we trust
#: src/gfu-common.c:176
msgid "Report is trusted"
msgstr "Rapporten är betrodd"

#. TRANSLATORS: Device cannot be removed easily
#: src/gfu-common.c:301
msgid "Internal device"
msgstr "Intern enhet"

#. TRANSLATORS: Device is updatable in this or any other mode
#: src/gfu-common.c:305
msgid "Updatable"
msgstr "Uppdateringsbar"

#. TRANSLATORS: Must be plugged in to an outlet
#: src/gfu-common.c:309
msgid "System requires external power source"
msgstr "Systemet kräver extern strömkälla"

#. TRANSLATORS: Is locked and can be unlocked
#: src/gfu-common.c:313
msgid "Device is locked"
msgstr "Enhet är låst"

#. TRANSLATORS: Is found in current metadata
#: src/gfu-common.c:317
msgid "Supported on LVFS"
msgstr "Stöds på LVFS"

#. TRANSLATORS: Requires a bootloader mode to be manually enabled by the user
#: src/gfu-common.c:321
msgid "Requires a bootloader"
msgstr "Kräver en starthanterare"

#. TRANSLATORS: Requires a reboot to apply firmware or to reload hardware
#: src/gfu-common.c:325
msgid "Needs a reboot after installation"
msgstr "Kräver en omstart efter installation"

#. TRANSLATORS: Requires system shutdown to apply firmware
#: src/gfu-common.c:329
msgid "Needs shutdown after installation"
msgstr "Kräver en nedstängning efter installation"

#. TRANSLATORS: Has been reported to a metadata server
#: src/gfu-common.c:333
msgid "Reported to LVFS"
msgstr "Rapporterat till LVFS"

#. TRANSLATORS: User has been notified
#: src/gfu-common.c:337
msgid "User has been notified"
msgstr "Användare har aviserats"

#. TRANSLATORS: Is currently in bootloader mode
#: src/gfu-common.c:341
msgid "Is in bootloader mode"
msgstr "Är i starthanterarläge"

#. TRANSLATORS: The hardware is waiting to be replugged
#: src/gfu-common.c:345
msgid "Hardware is waiting to be replugged"
msgstr "Hårdvara väntar på att bli utdragen/återinsatt"

#. TRANSLATORS: Device update needs to be separately activated
#: src/gfu-common.c:353
msgid "Device update needs activation"
msgstr "Enhetsuppdatering kräver aktivering"

#. TRANSLATORS: Device will not return after update completes
#: src/gfu-common.c:361
msgid "Device will not re-appear after update completes"
msgstr ""
"Enhet kommer inte att dyka upp igen efter att uppdateringen färdigställs"

#. TRANSLATORS: Device supports some form of checksum verification
#: src/gfu-common.c:365
msgid "Cryptographic hash verification is available"
msgstr "Kryptografisk hashverifiering är tillgänglig"

#. TRANSLATORS: Device supports a safety mechanism for flashing
#: src/gfu-common.c:373
msgid "Device stages updates"
msgstr "Enhet genomför uppdatering i steg"

#. TRANSLATORS: Device supports a safety mechanism for flashing
#: src/gfu-common.c:377
msgid "Device can recover flash failures"
msgstr "Enhet kan återhämta sig från flashningsfel"

#. TRANSLATORS: Device remains usable during update
#: src/gfu-common.c:381
msgid "Device is usable for the duration of the update"
msgstr "Enhet går använda under tiden som uppdateringen pågår"

#. TRANSLATORS: Device does not jump directly to the newest
#: src/gfu-common.c:385
msgid "Device installs all intermediate releases"
msgstr "Enhet installerar alla mellanliggande utgåvor"

#. TRANSLATORS: the stream can be provided by different vendors
#: src/gfu-common.c:389
msgid "Device supports switching to a different stream of firmware"
msgstr "Enhet stöder byte till en annan ström av fast programvara"

#. TRANSLATORS: it is saved to the users local disk
#: src/gfu-common.c:393
msgid "Device firmware will be saved before installing updates"
msgstr ""
"Enhetens fasta programvara kommer sparas innan uppdateringar installeras"

#. TRANSLATORS: on some systems certain devices have to have matching versions,
#. * e.g. the EFI driver for a given network card cannot be different
#: src/gfu-common.c:398
msgid "All devices of the same type will be updated at the same time"
msgstr "Alla enheter av samma typ kommer uppdateras samtidigt"

#. TRANSLATORS: some devices can only be updated to a new semver and cannot
#. * be downgraded or reinstalled with the sexisting version
#: src/gfu-common.c:403
msgid "Only version upgrades are allowed"
msgstr "Endast versionsuppgraderingar är tillåtna"

#. TRANSLATORS: the device is currently unreachable, perhaps because it is in a
#. * lower power state or is out of wireless range
#: src/gfu-common.c:408
msgid "Device is currently unreachable"
msgstr "Enheten kan för närvarande inte nås"

#. TRANSLATORS: a volume with full-disk-encryption was found on this machine,
#. * typically a Windows NTFS partition with BitLocker
#: src/gfu-common.c:413
msgid "May invalidate secrets used to decrypt volumes"
msgstr "Kan göra hemligheter som används för kryptering av volymer ogiltiga"

#. TRANSLATORS: the vendor is no longer supporting the device
#: src/gfu-common.c:417
msgid "End of life"
msgstr "Har nått slutet på sin livstid"

#. TRANSLATORS: firmware is verified on-device the payload using strong crypto
#: src/gfu-common.c:421
msgid "Signed payload"
msgstr "Signerad nyttolast"

#. TRANSLATORS: firmware payload is unsigned and it is possible to modify it
#: src/gfu-common.c:425
msgid "Unsigned payload"
msgstr "Osignerad nyttolast"

#. TRANSLATORS: this device is not actually real
#: src/gfu-common.c:429
msgid "Emulated"
msgstr "Emulerad"

#. TRANSLATORS: we're saving all USB events for emulation
#: src/gfu-common.c:433
msgid "Tagged for emulation"
msgstr "Taggad för emulering"

#. TRANSLATORS: device should stay on one firmware version unless the new version
#. * is explicitly specified
#: src/gfu-common.c:438
msgid "Only explicit updates"
msgstr "Endast explicita uppdateringar"

#. TRANSLATORS: daemon is inactive
#: src/gfu-common.c:522
msgid "Idle…"
msgstr "Inaktiv…"

#. TRANSLATORS: decompressing the firmware file
#: src/gfu-common.c:526
msgid "Decompressing…"
msgstr "Dekomprimerar…"

#. TRANSLATORS: parsing the firmware information
#: src/gfu-common.c:530
msgid "Loading…"
msgstr "Läser in…"

#. TRANSLATORS: restarting the device to pick up new F/W
#: src/gfu-common.c:534
msgid "Restarting device…"
msgstr "Startar om enhet…"

#. TRANSLATORS: reading from the flash chips
#: src/gfu-common.c:538
msgid "Reading…"
msgstr "Läser…"

#. TRANSLATORS: writing to the flash chips
#: src/gfu-common.c:542
msgid "Writing…"
msgstr "Skriver…"

#. TRANSLATORS: erasing contents of the flash chips
#: src/gfu-common.c:546
msgid "Erasing…"
msgstr "Raderar…"

#. TRANSLATORS: verifying we wrote the firmware correctly
#: src/gfu-common.c:550
msgid "Verifying…"
msgstr "Verifierar…"

#. TRANSLATORS: scheduing an update to be done on the next boot
#: src/gfu-common.c:554
msgid "Scheduling…"
msgstr "Schemalägger…"

#. TRANSLATORS: downloading from a remote server
#: src/gfu-common.c:558
msgid "Downloading…"
msgstr "Hämtar…"

#. TRANSLATORS: waiting for user to authenticate
#: src/gfu-common.c:562
msgid "Authenticating…"
msgstr "Autentiserar…"

#. TRANSLATORS: waiting for device to do something
#: src/gfu-common.c:566
msgid "Waiting…"
msgstr "Väntar…"

#. TRANSLATORS: waiting for daemon
#: src/gfu-common.c:570
msgid "Shutting down…"
msgstr "Stänger ner…"

#. TRANSLATORS: waiting for daemon
#: src/gfu-common.c:574
msgid "Waiting for user…"
msgstr "Väntar på användare…"

#. TRANSLATORS: button text
#: src/gfu-main.c:82
msgid "Understood"
msgstr "Uppfattat"

#: src/gfu-main.c:324
msgid "_Apply"
msgstr "_Verkställ"

#. TRANSLATORS: error dialog title when applying a BIOS setting failed
#: src/gfu-main.c:413 src/gfu-main.c:504
msgid "Modifying BIOS Settings Failed"
msgstr "Modifiering av BIOS-inställningar misslyckades"

#. TRANSLATORS: prompting a reboot to the user
#: src/gfu-main.c:459
msgid "Reboot Required"
msgstr "Omstart krävs"

#: src/gfu-main.c:460
msgid "The update requires a reboot to complete."
msgstr "Uppdateringen kräver en omstart för att slutföras."

#. TRANSLATORS: button text
#: src/gfu-main.c:462 src/gfu-main.c:2967
msgid "Reboot"
msgstr "Starta om"

#. TRANSLATORS: button text
#: src/gfu-main.c:467 src/gfu-main.c:2250 src/gfu-main.c:2955
#: src/gfu-main.c:2972
msgid "Later"
msgstr "Senare"

#. TRANSLATORS: error dialog body when no valid value was chosen
#: src/gfu-main.c:506
msgid "No valid setting value was selected."
msgstr "Inget giltigt inställningsvärde valdes."

#: src/gfu-main.c:568
msgid "Getting BIOS Settings Failed"
msgstr "Erhållande av BIOS-inställningar misslyckades"

#. TRANSLATORS: the attestation failed
#: src/gfu-main.c:623
msgid "Not OK"
msgstr "Inte OK"

#. TRANSLATORS: the checksum verified
#. TRANSLATORS: button text
#: src/gfu-main.c:628 src/gfu-main.c:2498
msgid "OK"
msgstr "OK"

#. TRANSLATORS: as in laptop battery power
#: src/gfu-main.c:639
msgid "System power is too low to perform the update"
msgstr "Systemet har för lite batteri för att utföra uppdateringen"

#. TRANSLATORS: as in laptop battery power
#: src/gfu-main.c:643
#, c-format
msgid "System power is too low to perform the update (%u%%, requires %u%%)"
msgstr ""
"Systemet har för lite batteri för att utföra uppdateringen (%u%%, behöver "
"%u%%)"

#. TRANSLATORS: for example, a Bluetooth mouse that is in powersave mode
#: src/gfu-main.c:649
msgid "Device is unreachable, or out of wireless range"
msgstr "Enheten kan inte nås, eller är utanför den trådlösa räckvidden"

#. TRANSLATORS: for example the batteries *inside* the Bluetooth mouse
#: src/gfu-main.c:656
msgid "Device battery power is too low"
msgstr "Enheten har för lite batteri"

#. TRANSLATORS: for example the batteries *inside* the Bluetooth mouse
#: src/gfu-main.c:659
#, c-format
msgid "Device battery power is too low (%u%%, requires %u%%)"
msgstr "Enheten har för lite batteri (%u%%, behöver %u%%)"

#. TRANSLATORS: usually this is when we're waiting for a reboot
#: src/gfu-main.c:665
msgid "Device is waiting for the update to be applied"
msgstr "Enheten väntar på att uppdateringen ska tillämpas"

#. TRANSLATORS: as in, wired mains power for a laptop
#: src/gfu-main.c:669
msgid "Device requires AC power to be connected"
msgstr "Enheten behöver vara ansluten till nätspänning"

#. TRANSLATORS: lid means "laptop top cover"
#: src/gfu-main.c:673
msgid "Device cannot be used while the lid is closed"
msgstr "Enheten kan inte användas medan locket är stängt"

#. TRANSLATORS: device cannot be interrupted, for instance taking a phone call
#: src/gfu-main.c:677
msgid "Device is in use"
msgstr "Enheten används"

#. TRANSLATORS: device cannot be interrupted, for instance taking a phone call
#: src/gfu-main.c:681
msgid "Device cannot be used while there are no displays plugged in"
msgstr "Enheten kan inte användas utan inkopplade skärmar"

#. TRANSLATORS: the hw IDs the device defines,
#. * e.g. USB:0x1234
#: src/gfu-main.c:781 src/gfu-main.ui:204
msgid "Vendor ID"
msgid_plural "Vendor IDs"
msgstr[0] "Tillverkar-ID"
msgstr[1] "Tillverkar-ID"

#. TRANSLATORS: the checksum state was unknown
#: src/gfu-main.c:816
msgid "Unknown"
msgstr "Okänt"

#. TRANSLATORS: error in shutting down the system
#: src/gfu-main.c:933
msgid "Shutdown Failed"
msgstr "Nedstängning misslyckades"

#: src/gfu-main.c:934
msgid "A manual shutdown is required."
msgstr "En manuell nedstängning krävs."

#. TRANSLATORS: error in rebooting down the system
#: src/gfu-main.c:944
msgid "Reboot Failed"
msgstr "Omstart misslyckades"

#: src/gfu-main.c:945
msgid "A manual reboot is required."
msgstr "En manuell omstart krävs."

#. TRANSLATORS: fwupd refused us data
#: src/gfu-main.c:1001 src/gfu-main.c:1512
msgid "Getting Remotes Failed"
msgstr "Erhållande av fjärrar misslyckades"

#. TRANSLATORS: the LVFS remote could not be enabled
#: src/gfu-main.c:1118
msgid "Uploading Failed"
msgstr "Sändning misslyckades"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:1167
msgid "Upload Device List?"
msgstr "Skicka enhetslista?"

#. TRANSLATORS: dialog body, %1 is typically "Linux Vendor Firmware Service"
#. *  and %2 is a URL to the privacy policy
#: src/gfu-main.c:1172
#, c-format
msgid ""
"Help to improve the %s by sending the list of current devices. The list is "
"anonymous and does not include personally identifiable information — see the "
"<a href=\"%s\">privacy policy</a> for more information."
msgstr ""
"Hjälp till att förbättra %s genom att skicka listan på aktuella enheter. "
"Listan är anonym och innehåller ingen personligt identifierbar information — "
"se <a href=\"%s\">sekretesspolicyn</a> för mer information."

#. TRANSLATORS: button text
#: src/gfu-main.c:1181 src/gfu-main.c:1630 src/gfu-main.c:1897
#: src/gfu-main.c:2389
msgid "_Cancel"
msgstr "A_vbryt"

#. TRANSLATORS: button text
#: src/gfu-main.c:1184
msgid "_Upload"
msgstr "_Skicka"

#. TRANSLATORS: header before the JSON listing
#: src/gfu-main.c:1193
msgid "Device List"
msgstr "Enhetslista"

#: src/gfu-main.c:1224
msgid "Copy"
msgstr "Kopiera"

#. TRANSLATORS: fwupd refused us data
#: src/gfu-main.c:1302
msgid "Getting Devices Failed"
msgstr "Erhållande av enheter misslyckades"

#. TRANSLATORS: no devices supporting firmware updates were found
#: src/gfu-main.c:1327
msgid "No supported devices were found…"
msgstr "Inga enheter som stöds hittades…"

#. TRANSLATORS: the list of available firmware failed to be updated
#: src/gfu-main.c:1472
msgid "Refreshing Metadata Failed"
msgstr "Uppdatering av metadata misslyckades"

#. TRANSLATORS: the LVFS remote could not be enabled
#: src/gfu-main.c:1496
msgid "Modifying Remote Failed"
msgstr "Modifiering av fjärr misslyckades"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:1542
msgid "Nothing To Do!"
msgstr "Inget att göra!"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:1544
msgid "There are no unsupported devices detected."
msgstr "Inga enheter som inte stöds hittades."

#. TRANSLATORS: dialog title
#. TRANSLATORS: the firmware install failed for an unspecified reason
#: src/gfu-main.c:1578 src/gfu-main.c:1690 src/gfu-main.c:2224
msgid "Installation Failed"
msgstr "Installationen misslyckades"

#. TRANSLATORS: dialog title
#. TRANSLATORS: window title
#: src/gfu-main.c:1624 src/gfu-main.c:1665
msgid "Write Raw File"
msgstr ""

#. TRANSLATORS: dialog body
#: src/gfu-main.c:1626
msgid "Write the raw firmware blob to the device?"
msgstr ""

#. TRANSLATORS: button text
#: src/gfu-main.c:1633 src/gfu-main.c:1662
msgid "Write"
msgstr ""

#: src/gfu-main.c:1740
msgid "This firmware is not compatible with devices found on your system."
msgstr "Denna fasta programvara är inte kompatibel med enheter på ditt system."

#. TRANSLATORS: dialog title, where %1 is the firmware version (e.g. '1.2.3')
#: src/gfu-main.c:1750
#, c-format
msgid "Cannot Install %s"
msgstr "Kan inte installera %s"

#. TRANSLATORS: button text
#: src/gfu-main.c:1759
msgid "_Close"
msgstr "S_täng"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:1785 src/gfu-main.c:1792
msgid "Getting File Details Failed"
msgstr "Erhållande av fildetaljer misslyckades"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:1815
msgid "Firmware Version Blocked"
msgstr "Fast programvaruversion har blockerats"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:1822
msgid "Firmware Not Approved"
msgstr "Fast programvara inte godkänd"

#. TRANSLATORS: dialog title, where %1 is the device name (e.g. 'ThinkPad P1G3')
#. * and %2 is the firmware version (e.g. '1.2.3')
#: src/gfu-main.c:1829
#, c-format
msgid "Install %s %s?"
msgstr "Installera %s %s?"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:1836
msgid "Unsigned Firmware"
msgstr "Osignerad fast programvara"

#: src/gfu-main.c:1837
msgid "Only signed firmware can be installed."
msgstr "Endast signerad fast programvara kan installeras."

#. TRANSLATORS: dialog title, where %1 is the device name (e.g. 'ThinkPad P1G3')
#. * and %2 is the firmware version (e.g. '1.2.3')
#: src/gfu-main.c:1842
#, c-format
msgid "Install UNTRUSTED %s %s:"
msgstr "Installera den EJ BETRODDA %s %s:"

#. TRANSLATORS: this is for an different stream of firmware, e.g.
#. * produced by a different entity than the original vendor.
#. * %1 is something like 'oss'
#: src/gfu-main.c:1852
#, c-format
msgid "This firmware is from the alternate '%s' branch."
msgstr "Denna fasta programvara är från den alternativa grenen ”%s”."

#. TRANSLATORS: this is when the community is now providing updates
#. * rather than the original (dead?) upstream OEM
#: src/gfu-main.c:1859
msgid ""
"This firmware has been built by the community, rather than the original OEM "
"vendor."
msgstr ""
"Denna fasta programvara har byggts av gemenskapen snarare än den "
"ursprungliga OEM-leverantören."

#. TRANSLATORS: this is when an OEM or ODM the user trusts has
#. tested the firmware update
#: src/gfu-main.c:1866
msgid "This firmware has been tested by a trusted vendor."
msgstr "Denna fasta programvara har testats av en betrodd tillverkare."

#. TRANSLATORS: button text
#: src/gfu-main.c:1879
msgid "Update"
msgstr "Uppdatera"

#. TRANSLATORS: button text
#: src/gfu-main.c:1882
msgid "Downgrade"
msgstr "Nedgradera"

#. TRANSLATORS: button text
#: src/gfu-main.c:1886
msgid "Reinstall"
msgstr "Installera om"

#. TRANSLATORS: button text
#: src/gfu-main.c:1954
msgid "Install"
msgstr "Installera"

#. TRANSLATORS: window title
#: src/gfu-main.c:1957
msgid "Install Cabinet Archive"
msgstr "Installera kabinettarkiv"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:1980
msgid "Loading Emulation Data Failed"
msgstr "Inläsning av emuleringsdata misslyckades"

#. TRANSLATORS: button text
#: src/gfu-main.c:2021
msgid "Load"
msgstr "Läs in"

#. TRANSLATORS: window title
#: src/gfu-main.c:2024
msgid "Load Device Emulation Data"
msgstr "Läs in enhetsemuleringsdata"

#. TRANSLATORS: dialog title
#: src/gfu-main.c:2045
msgid "Saving Emulation Data Failed"
msgstr "Sparande av emuleringsdata misslyckades"

#. TRANSLATORS: button text
#: src/gfu-main.c:2088
msgid "Save"
msgstr "Spara"

#. TRANSLATORS: window title
#: src/gfu-main.c:2091
msgid "Save Device Emulation Data"
msgstr "Spara enhetsemuleringsdata"

#. TRANSLATORS: the user needs to do something, e.g. remove the device
#: src/gfu-main.c:2129
msgid "Further Action Required"
msgstr "Vidare åtgärd krävs"

#. TRANSLATORS: the user needs to do something, e.g. remove the device
#: src/gfu-main.c:2132
msgid "Action Required"
msgstr "Åtgärd krävs"

#. TRANSLATORS: button text
#: src/gfu-main.c:2137 src/gfu-main.c:2296
msgid "Continue"
msgstr "Fortsätt"

#: src/gfu-main.c:2242 src/gfu-main.c:2947
msgid "Shutdown Required"
