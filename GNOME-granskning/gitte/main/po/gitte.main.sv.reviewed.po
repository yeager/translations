#: data/de.wwwtech.gitte.desktop.in:2 data/de.wwwtech.gitte.metainfo.xml.in:7
msgid "Gitte"
msgstr "Gitte"

#: data/de.wwwtech.gitte.desktop.in:3 data/de.wwwtech.gitte.metainfo.xml.in:8
msgid "Manage your code history"
msgstr "Hantera din kodhistorik"

#: data/de.wwwtech.gitte.desktop.in:9
msgid "Git;Version Control;VCS;Repository;Commit;Branch;Merge;Diff;Stash;"
msgstr "Git;Versionshantering;VCS;Förråd;Arkiv;Repository;Incheckning;Commit;Gren;Branch;Merge;Sammanslagning;Diff;Stash;"

#: data/de.wwwtech.gitte.gschema.xml:6
msgid "Window width"
msgstr "Fönsterbredd"

#: data/de.wwwtech.gitte.gschema.xml:7
msgid "The width of the application window."
msgstr "Bredden på programmets fönster."

#: data/de.wwwtech.gitte.gschema.xml:11
msgid "Window height"
msgstr "Fönsterhöjd"

#: data/de.wwwtech.gitte.gschema.xml:12
msgid "The height of the application window."
msgstr "Höjden på programmets fönster."

#: data/de.wwwtech.gitte.gschema.xml:16
msgid "Sidebar pane position"
msgstr "Position på sidopanel"

#: data/de.wwwtech.gitte.gschema.xml:17
msgid "The position of the sidebar pane divider in the repository view."
msgstr "Positionen för sidopanelens avdelare i arkivvyn."

#: data/de.wwwtech.gitte.gschema.xml:21
msgid "Sidebar visible"
msgstr "Sidopanelen är synlig"

#: data/de.wwwtech.gitte.gschema.xml:22
msgid "Whether the sidebar is visible in the repository view."
msgstr "Huruvida sidopanelen ska vara synlig i arkivvyn."

#: data/de.wwwtech.gitte.gschema.xml:26
msgid "Files pane position"
msgstr "Position för filpanel"

#: data/de.wwwtech.gitte.gschema.xml:27
msgid "The position of the files pane divider in the repository view."
msgstr "Positionen för filpanelens avdelaren i arkivvyn."

#: data/de.wwwtech.gitte.gschema.xml:31
msgid "History pane position"
msgstr "Position för historikpanel"

#: data/de.wwwtech.gitte.gschema.xml:32
msgid ""
"The position of the history (commit graph) pane divider in the repository "
"view."
msgstr ""
"Positionen för historikens (incheckningsgrafens) panelavdelare i arkivvyn."

#: data/de.wwwtech.gitte.gschema.xml:41
msgid "Start screen sort order"
msgstr "Sorteringsordning för startskärm"

#: data/de.wwwtech.gitte.gschema.xml:42
msgid "How repositories are sorted on the start screen."
msgstr "Hur arkiv sorteras på startskärmen."

#: data/de.wwwtech.gitte.gschema.xml:46
msgid "Default location for repositories"
msgstr "Standardplats för arkiv"

#: data/de.wwwtech.gitte.gschema.xml:47
msgid ""
"Filesystem path used as the starting folder when cloning, initializing, or "
"adding repositories. An empty string falls back to the user's home directory."
msgstr ""
"Filsystemssökväg som används som startmapp vid kloning, initiering eller att "
"lägga till arkiv. En tom sträng faller tillbaka på användarens hemkatalog."

#: data/de.wwwtech.gitte.gschema.xml:51
msgid "Auto-fetch enabled (global default)"
msgstr "Automatisk hämtning aktiverad (global standard)"

#: data/de.wwwtech.gitte.gschema.xml:52
msgid ""
"Global default for whether to automatically fetch from all remotes at a "
"regular interval."
msgstr ""
"Globalt standardvärde för om automatisk hämtning ska ske från alla fjärrar "
"med ett regelbundet intervall."

#: data/de.wwwtech.gitte.gschema.xml:57
msgid "Auto-fetch interval (global default)"
msgstr "Intervall för automatisk hämtning (global standard)"

#: data/de.wwwtech.gitte.gschema.xml:58
msgid "Global default interval in seconds between automatic fetches."
msgstr "Globalt standardintervall i sekunder mellan automatiska hämtningar."

#: data/de.wwwtech.gitte.gschema.xml:62
msgid "Tag sorting method (global default)"
msgstr "Taggsorteringsmetod (global standard)"

#: data/de.wwwtech.gitte.gschema.xml:63
msgid ""
"Global default for tag sorting: \"semver\", \"alphabetical\", or \"date\". "
"Repositories can override."
msgstr ""
"Global standard för taggsortering: ”semver”, ”alphabetical” eller ”date”. "
"Arkiv kan åsidosätta detta."

#: data/de.wwwtech.gitte.gschema.xml:67
msgid "Tag sort direction (global default)"
msgstr "Taggsorteringsriktning (global standard)"

#: data/de.wwwtech.gitte.gschema.xml:68
msgid ""
"Global default sort direction for tags: \"asc\" or \"desc\". Repositories "
"can override."
msgstr ""
"Global standardsorteringsriktning för taggar: ”asc” eller ”desc”. Arkiv kan "
"åsidosätta detta."

#: data/de.wwwtech.gitte.gschema.xml:72
msgid "Branch sorting method (global default)"
msgstr "Grensorteringsmetod (global standard)"

#: data/de.wwwtech.gitte.gschema.xml:73
msgid ""
"Global default for branch sorting: \"alphanumeric\", \"last-checkout\", or "
"\"last-commit\". Repositories can override."
msgstr ""
"Global standard för grensortering: ”alphanumeric”, ”last-checkout” eller "
"”last-commit”. Arkiv kan åsidosätta detta."

#: data/de.wwwtech.gitte.gschema.xml:77
msgid "Branch sort direction (global default)"
msgstr "Grensorteringsriktning (global standard)"

#: data/de.wwwtech.gitte.gschema.xml:78
msgid ""
"Global default sort direction for branches: \"asc\" or \"desc\". "
"Repositories can override."
msgstr ""
"Global standardsorteringsriktning för grenar: ”asc” eller ”desc”. Arkiv kan "
"åsidosätta detta."

#: data/de.wwwtech.gitte.gschema.xml:82
msgid "Font for diff views"
msgstr "Typsnitt för diffvyer"

#: data/de.wwwtech.gitte.gschema.xml:83
msgid ""
"Pango font description (e.g. \"JetBrains Mono 11\") used for diff content. "
"Empty string falls back to the system monospace font."
msgstr ""
"Pango-typssnittsbeskrivning (t.ex. ”JetBrains Mono 11”) som används för "
"diffinnehåll. Tom sträng faller tillbaka på systemets typsnitt med fast "
"breddsteg."

#: data/de.wwwtech.gitte.gschema.xml:92
msgid "Color scheme"
msgstr "Färgschema"

#: data/de.wwwtech.gitte.gschema.xml:93
msgid ""
"Whether to follow the system color scheme or force a light or dark "
"appearance."
msgstr ""
"Huruvida systemets färgschema ska användas eller ett ljust eller mörkt "
"utseende ska tvingas."

#: data/de.wwwtech.gitte.gschema.xml:97
msgid "Path to the git binary"
msgstr "Sökväg till git-binären"

#: data/de.wwwtech.gitte.gschema.xml:98
msgid ""
"Command used to invoke git for rebase operations. Use \"git\" to rely on "
"PATH, an absolute path for a specific binary, or e.g. \"flatpak-spawn --host "
"git\" to run git outside the sandbox."
msgstr ""
"Kommando som används för att köra git för ombaseringsåtgärder. Använd ”git” "
"för att förlita dig på PATH, en absolut sökväg för en specifik binär, eller "
"t.ex. ”flatpak-spawn --host git” för att köra git utanför sandlådan."

#: data/de.wwwtech.gitte.gschema.xml:102
msgid "External editor command"
msgstr "Kommando för extern redigerare"

#: data/de.wwwtech.gitte.gschema.xml:103
msgid ""
"Command used to open files in an external editor. An empty string falls back "
"to the system default application. Supports the placeholders {file} "
"(absolute path) and {line} (line number). Examples: \"gedit +{line} {file}"
"\", \"gnome-text-editor {file}\", \"kate --line {line} {file}\", \"open -a "
"'Zed' {file}:{line}\". Inside a Flatpak sandbox, prefix with \"flatpak-spawn "
"--host\" to run a host editor, e.g. \"flatpak-spawn --host gedit +{line} "
"{file}\"."
msgstr ""
"Kommando som används för att öppna filer i en extern redigerare. En tom "
"sträng faller tillbaka på systemets standardprogram. Stöder platshållarna "
"{file} (absolut sökväg) och {line} (radnummer). Exempel: ”gedit +{line} "
"{file}”, ”gnome-text-editor {file}”, ”kate --line {line} {file}”, ”open -a "
"'Zed' {file}:{line}”. Inuti en Flatpak-sandlåda, använd prefixet ”flatpak-"
"spawn --host” för att köra en värdredigerare, t.ex. ”flatpak-spawn --host "
"gedit +{line} {file}”."

#: data/de.wwwtech.gitte.gschema.xml:107
msgid "External terminal command"
msgstr "Kommando för extern terminal"

#: data/de.wwwtech.gitte.gschema.xml:108
msgid ""
"Command used to open a terminal in the repository directory. An empty string "
"auto-detects an installed terminal emulator. Supports the placeholder {path} "
"(absolute repository path); the command is also started with the repository "
"as its working directory, so {path} is optional. Examples: \"gnome-terminal "
"--working-directory={path}\", \"ghostty --working-directory={path}\", \"open "
"-a Terminal {path}\". Inside a Flatpak sandbox, prefix with \"flatpak-spawn "
"--host\" to run a host terminal, e.g. \"flatpak-spawn --host ghostty --"
"working-directory={path}\"."
msgstr ""
"Kommando som används för att öppna en terminal i arkivkatalogen. En tom "
"sträng identifierar automatiskt en installerad terminalemulator. Stöder "
"platshållaren {path} (absolut arkivsökväg); kommandot startas också med "
"arkivet som sin arbetskatalog, så {path} är valfri. Exempel: ”gnome-terminal "
"--working-directory={path}”, ”ghostty --working-directory={path}”, ”open -a "
"Terminal {path}”. Inuti en Flatpak-sandlåda, använd prefixet ”flatpak-spawn "
"--host” för att köra en värdterminal, t.ex. ”flatpak-spawn --host ghostty --"
"working-directory={path}”."

#: data/de.wwwtech.gitte.gschema.xml:112
msgid "Bypass local git configuration for network operations"
msgstr "Gå förbi lokal git-konfiguration för nätverksåtgärder"

#: data/de.wwwtech.gitte.gschema.xml:113
msgid ""
"Disable credential helpers, hooks, and the pager when invoking git fetch/"
"push/pull. Useful in sandboxed (Flatpak) environments where host-side "
"helpers like `gh` are unreachable. When unset by the user, this defaults to "
"true inside Flatpak and false otherwise."
msgstr ""
"Inaktivera autentiseringshjälpare, krokar och sidvisare vid anrop till "
"”fetch”, ”push” eller ”pull”. Användbart i sandlådemiljöer (Flatpak) där "
"hjälpfunktioner på värden som `gh` inte kan nås. När det inte satts av "
"användaren är detta som standard true inuti Flatpak och annars false."

#: data/de.wwwtech.gitte.gschema.xml:117
msgid "Force overwrite of probed environment variables from the login shell"
msgstr "Tvinga överskrivning av avkända miljövariabler från inloggningsskalet"

#: data/de.wwwtech.gitte.gschema.xml:118
msgid ""
"When enabled, SSH/GPG/proxy related environment variables are always taken "
"from the user's login shell on startup and overwrite any value inherited by "
"the current process — even if already set. If the login shell reports an "
"empty value, the variable is set to the empty string. Takes effect on next "
"startup."
msgstr ""
"När aktiverat tas SSH/GPG/proxy-relaterade miljövariabler alltid från "
"användarens inloggningsskal vid uppstart och skriver över eventuella värden "
"som ärvts av den aktuella processen — även om de redan satts. Om "
"inloggningsskalet rapporterar ett tomt värde sätts variabeln till en tom "
"sträng. Börjar gälla vid nästa uppstart."

#: data/de.wwwtech.gitte.gschema.xml:122
msgid "Last version for which the What's New dialog was shown"
msgstr "Den senaste versionen som ”Vad är nytt”-dialogen visades för"

#: data/de.wwwtech.gitte.gschema.xml:123
msgid ""
"Empty string means the user has never seen any What's New dialog (e.g. fresh "
"install). On startup, if this differs from the current app version, release "
"notes are shown and this value is updated."
msgstr ""
"Tom sträng betyder att användaren aldrig har sett någon ”Vad är nytt”-dialog "
"(t.ex ny installation). Om detta skiljer sig från aktuell programversion vid "
"uppstart så visas utgåveanteckningar och detta värde uppdateras."

#: data/de.wwwtech.gitte.gschema.xml:127
#: data/de.wwwtech.gitte.metainfo.xml.in:58
msgid "Compact UI mode"
msgstr "Kompakt användargränssnittsläge"

#: data/de.wwwtech.gitte.gschema.xml:128
msgid "Reduces spacing and padding throughout the UI for a denser layout."
msgstr ""
"Reducerar utrymme och utfyllnad över användargränssnittet för en tätare "
"layout."

#: data/de.wwwtech.gitte.gschema.xml:132
msgid "Open repository in current directory"
msgstr "Öppna arkiv i aktuell katalog"

#: data/de.wwwtech.gitte.gschema.xml:133
msgid ""
"When Gitte is launched from a terminal without a path argument, open the Git "
"repository found in (or above) the current working directory. If no "
"repository is found, the repository selection screen is shown as usual."
msgstr ""
"När Gitte körs från en tarminal utan ett sökvägsargument, öppna Git-arkivet "
"som finns i (eller ovanför) aktuell arbetskatalog. Om inget arkiv hittas "
"visas arkivvalsskärmen som vanligt."

#: data/de.wwwtech.gitte.gschema.xml:137
msgid "Check out newly created branches"
msgstr "Checka ut nyskapade grenar"

#: data/de.wwwtech.gitte.gschema.xml:138
msgid ""
"Remembers the last state of the “Check out after creating” switch in the "
"create-branch dialog."
msgstr ""
"Kommer ihåg det senaste tillståndet för växlingsknappen ”Checka ut efter "
"delning” i dialogrutan för att skapa gren."

#: data/de.wwwtech.gitte.gschema.xml:142
msgid "Last update-banner version dismissed by the user"
msgstr "Senaste version av uppdateringsbanderoll som avfärdades av användaren"

#: data/de.wwwtech.gitte.gschema.xml:143
msgid ""
"If this equals the latest version reported by Flathub, the update banner is "
"suppressed."
msgstr ""
"Om detta är samma som den senaste versionen som rapporteras av Flathuv så "
"undertrycks uppdateringsbanderollen."

#: data/de.wwwtech.gitte.gschema.xml:147
msgid "Unix timestamp of the last successful update check"
msgstr "Tidsstämpel för den senaste lyckade uppdateringskontrollen"

#: data/de.wwwtech.gitte.gschema.xml:148
msgid "Used to throttle update checks to at most once every 24 hours."
msgstr ""
"Används för att strypa uppdateringskontroller till högst en gång på 24 "
"timmar."

#: data/de.wwwtech.gitte.gschema.xml:152
msgid "Additive line selection in diff view"
msgstr "Additiv radmarkering i diffvy"

#: data/de.wwwtech.gitte.gschema.xml:153
msgid ""
"When enabled, a single left click in the diff view toggles a line (additive) "
"and click-drag extends the selection. When disabled, standard GTK selection "
"behavior is used (click selects single, Ctrl-click toggles, Shift-click "
"extends)."
msgstr ""
"När aktiverad markerar ett vänsterklick i diffvyn en (additivt) och att "
"klicka och dra utökar markeringen. När inaktiverat används GTK:s "
"standardbeteende (klick markerar en, Ctrl-klick växlar, Skift-klicka utökar)."

#: data/de.wwwtech.gitte.gschema.xml:161
msgid "History diff view layout"
msgstr "Diffvylayout för historik"

#: data/de.wwwtech.gitte.gschema.xml:162
msgid ""
"How diffs are displayed in the commit log, commit graph and stashes: "
"\"unified\" shows a single column with additions and deletions interleaved, "
"\"side-by-side\" shows the old content on the left and the new content on "
"the right."
msgstr ""
"Hur diffar visas i incheckningsloggen, incheckningsgrafen och stashar: "
"”unified” visar en ensam kolumn med både tillägg och borttagningar, ”side-by-"
"side” visar det gamla innehållet till vänster och det nya innehållet till "
"höger."

#: data/de.wwwtech.gitte.gschema.xml:170
msgid "Working copy diff view layout"
msgstr "Diffvylayout för arbetskopia"

#: data/de.wwwtech.gitte.gschema.xml:171
msgid ""
"How diffs are displayed in the working copy staging view: \"unified\" shows "
"a single column with additions and deletions interleaved, \"side-by-side\" "
"shows the old content on the left and the new content on the right."
msgstr ""
"Hur diffar visas i arbetskopians kövy: ”unified” visar en ensam kolumn med "
"både tillägg och borttagningar, ”side-by-side” visar det gamla innehållet "
"till vänster och det nya innehållet till höger."

#: data/de.wwwtech.gitte.gschema.xml:175
msgid "Show changes and stashes in commit graph"
msgstr "Visa ändringar och stashar i incheckningsgraf"

#: data/de.wwwtech.gitte.gschema.xml:176
msgid ""
"Whether the commit graph shows uncommitted changes and stashes as rows at "
"the top."
msgstr ""
"Huruvida incheckningsgrafen visar ej incheckade ändringar och stashar som "
"rader högst upp."

#: data/de.wwwtech.gitte.gschema.xml:185
msgid "Ignore whitespace in diffs"
msgstr "Ignorera blanktecken i diffar"

# hunks=chunks
#: data/de.wwwtech.gitte.gschema.xml:186
msgid ""
"Controls whether whitespace-only differences are hidden in diffs. \"none\" "
"shows all changes, \"change\" ignores changes in amount of whitespace (git "
"-b), \"all\" ignores all whitespace (git -w). When set to anything other "
"than \"none\", staging individual hunks or lines in the working copy is "
"disabled because the displayed diff no longer matches the on-disk bytes."
msgstr ""
"Styr huruvida ändringar bara i blanktecken döljs i diffar. ”none” visar alla "
"ändringar, ”change” ignorerar ändringar i mängd blanktecken (git -b), ”all” "
"ignorerar alla blanktecken (git -w). När detta satts till något annat än "
"”none”, kommer köande av enskilda stycken eller rader i arbetskopian att "
"inaktiveras för att den visade diffen inte längre matchar de byte som finns "
"på disk."

#: data/de.wwwtech.gitte.gschema.xml:194
msgid "Amount of context shown in diffs"
msgstr "Mängd sammanhang som visas i diffar"

#: data/de.wwwtech.gitte.gschema.xml:195
msgid ""
"How much surrounding context is shown around each change in diffs. "
"\"default\" shows the git default of three lines, \"whole\" shows the entire "
"file."
msgstr ""
"Hur mycket omgivande sammanhang som visas runt varje ändring i diffar. "
"”default” visar git-standarden med tre rader, ”whole” visar hela filen."

#: data/de.wwwtech.gitte.gschema.xml:199
msgid "Treat matching files as binary"
msgstr "Behandla matchande filer som binärer"

#: data/de.wwwtech.gitte.gschema.xml:200
msgid ""
"Comma-separated git pathspec/glob patterns (e.g. \"*.tscn, *.uid\"). Files "
"whose path matches a pattern are not shown as a diff; instead a placeholder "
"with a \"Load anyway\" button is displayed. Matching uses git pathspec "
"semantics, so \"*.ext\" matches files in any subdirectory."
msgstr ""
"Kommaseparerade git-sökvägsangivelser/globmönster (t.ex. ”*.tscn, *.uid”). "
"Filer vars sökväg matchar ett mönster visas inte som en diff, i stället "
"visas en platshållare, och en knapp ”Läs in i alla fall” visas. Matchning "
"använder gits semantik för sökvägsangivelser, så ”*.ext” matchar filer i "
"alla underkataloger."

#: data/de.wwwtech.gitte.gschema.xml:204
msgid "Force the Cairo (software) renderer"
msgstr "Tvinga Cairos (programvaru)renderare"

#: data/de.wwwtech.gitte.gschema.xml:205
msgid ""
"Workaround for rendering glitches such as window flicker when opening "
"dialogs on macOS. When enabled, the application starts with "
"GSK_RENDERER=cairo, falling back to CPU-side software rendering. Disables "
"GPU acceleration, which may make scrolling through large diffs or long "
"commit logs less smooth, especially on high-DPI displays. Requires an "
"application restart to take effect. An explicit GSK_RENDERER environment "
"variable always takes precedence over this setting."
msgstr ""
"Speciallösning för renderingsproblem som skärmflimmer vid öppnande av "
"dialoger på macOS. När aktiverad startar programmet med GSK_RENDERER=cairo, "
"och faller tillbaka till programvarurendering på processorsidan. Inaktiverar "
"GPU-acceleration, så rullning genom stora diffar eller långa "
"incheckningsloggar kan bli mindre jämn, särskilt på skärmar med hög DPI. "
"Kräver omstart av programmet för att börja gälla. En explicit GSK_RENDERER-"
"miljövariabel har alltid företräde över denna inställning."

#: data/de.wwwtech.gitte.gschema.xml:213
msgid "Working copy view layout"
msgstr "Layout för arbetskopievy"

#: data/de.wwwtech.gitte.gschema.xml:214
msgid ""
"How changed files are displayed: \"unified\" shows a single list, \"split\" "
"shows staged and unstaged changes in separate sections."
msgstr ""
"Hur ändrade filer visas: ”unified” visar en ensam lista, ”split” visar köade "
"och oköade ändringar i separata delar."

#: data/de.wwwtech.gitte.gschema.xml:222
msgid "Order of sections in the split working copy view"
msgstr "Ordning på delar i den delade arbetskopievyn"

#: data/de.wwwtech.gitte.gschema.xml:223
msgid ""
"Which section is shown first in the split layout: \"unstaged-first\" lists "
"unstaged changes above staged changes, \"staged-first\" lists staged changes "
"first."
msgstr ""
"Vilken del som visas först i den delade layouten: ”unstaged-first” listar "
"oköade ändringar ovanför köade ändringar, ”staged-first” listar köade "
"ändringar först."

#: data/de.wwwtech.gitte.gschema.xml:232
msgid "Which changed files are shown in the working copy"
msgstr "Vilka ändrade filer som visas i arbetskopian"

#: data/de.wwwtech.gitte.gschema.xml:233
msgid ""
"Filters the changed files view: \"all\" shows every change, \"new\" shows "
"only untracked files, \"modified\" shows only tracked changes (untracked "
"files are hidden)."
msgstr ""
"Filtrerar vyn för ändrade filer: ”all” visar alla ändringar, ”new” visar "
"endast ospårade filer, ”modified” visare endast spårade ändringar (ospårade "
"filer döljs)."

#: data/de.wwwtech.gitte.gschema.xml:237
msgid "Recurse into untracked directories"
msgstr "Gå rekursivt in i ospårade kataloger"

#: data/de.wwwtech.gitte.gschema.xml:238
msgid ""
"When enabled, untracked directories are expanded to list their full contents "
"in the changed files view; otherwise each untracked directory is shown as a "
"single entry."
msgstr ""
"När aktiverad expanderas ospårade kataloger så de listar sina fulla innehåll "
"i vyn över ändrade filer. Annars visas varje ospårad katalog som en ensam "
"post."

#: data/de.wwwtech.gitte.gschema.xml:242
msgid "Auto-collapse empty working copy sections"
msgstr "Fäll automatiskt ihop tomma delar av arbetskopia"

#: data/de.wwwtech.gitte.gschema.xml:243
msgid ""
"When enabled, the staged and unstaged sections in the split working copy "
"view automatically collapse when they contain no files and expand when they "
"have files."
msgstr ""
"När aktiverad fälls de köade och oköade delarna i den delade arbetskopievyn "
"automatiskt då de inte innehåller några filer och expanderas då de har filer."

#: data/de.wwwtech.gitte.gschema.xml:252
msgid "Default view when opening a repository (global default)"
msgstr "Standardvy vid öppnande av ett arkiv (globalt standardvärde)"

#: data/de.wwwtech.gitte.gschema.xml:253
msgid ""
"Which workspace view is shown when a repository is opened: \"changes\", "
"\"current-branch\", or \"commit-graph\". Repositories can override."
msgstr ""
"Vilken arbetsytevy som visas när detta arkiv öppnas: ”changes”, ”current-"
"branch” eller ”commit-graph”. Arkiv kan åsidosätta detta."

#: data/de.wwwtech.gitte.gschema.xml:257
msgid "Predefined commit trailers"
msgstr "Fördefinierade släprader för incheckning"

#: data/de.wwwtech.gitte.gschema.xml:258
msgid ""
"Trailers offered in the commit form, as pairs of stable IDs and \"Token: "
"Value\" strings. \"{identity}\", \"{name}\" and \"{email}\" are replaced "
"with the committer identity; an empty value asks for the value when the "
"trailer is used."
msgstr ""
"Släprader som erbjuds i incheckningsformuläret som par av stabila ID:n och "
"”Token: Värde”-strängar. ”{identity}”, ”{name}” och ”{email}” ersätts med "
"incheckarens identitet. Ett tomt värde gör att värdet efterfrågas varje gång "
"släpraden används."

#: data/de.wwwtech.gitte.gschema.xml:264
msgid "Branches section expanded"
msgstr "Grendel expanderad"

#: data/de.wwwtech.gitte.gschema.xml:265
msgid "Whether the Branches section in the sidebar is expanded."
msgstr "Huruvida grendelen i sidopanelen är expanderad."

#: data/de.wwwtech.gitte.gschema.xml:269
msgid "Tags section expanded"
msgstr "Taggdel expanderad"

#: data/de.wwwtech.gitte.gschema.xml:270
msgid "Whether the Tags section in the sidebar is expanded."
msgstr "Huruvida taggdelen i sidopanelen är expanderad."

#: data/de.wwwtech.gitte.gschema.xml:274
msgid "Remotes section expanded"
msgstr "Fjärrdel expanderad"

#: data/de.wwwtech.gitte.gschema.xml:275
msgid "Whether the Remotes section in the sidebar is expanded."
msgstr "Huruvida fjärrdelen i sidopanelen är expanderad."

#: data/de.wwwtech.gitte.gschema.xml:279
msgid "Unstaged changes section expanded"
msgstr "Del för oköade ändringar expanderad"

#: data/de.wwwtech.gitte.gschema.xml:280
msgid ""
"Whether the Unstaged Changes list in the split working copy view is expanded."
msgstr ""
"Huruvida listan för oköade ändringar i den delade arbetsytevyn är expanderad."

#: data/de.wwwtech.gitte.gschema.xml:284
msgid "Staged changes section expanded"
msgstr "Del för köade ändringar expanderad"

#: data/de.wwwtech.gitte.gschema.xml:285
msgid ""
"Whether the Staged Changes list in the split working copy view is expanded."
msgstr ""
"Huruvida listan för köade ändringar i den delade arbetsytevyn är expanderad."

#: data/de.wwwtech.gitte.gschema.xml:289
msgid "Include remote branches in commit graph"
msgstr "Inkludera fjärrgrenar i incheckningsgraf"

#: data/de.wwwtech.gitte.gschema.xml:290
msgid ""
"Whether the commit graph includes remote-tracking branches (git log --"
"remotes)."
msgstr ""
"Huruvida incheckningsgrafen inkluderar fjärrspårande grenar (git log --"
"remotes)."

#: data/de.wwwtech.gitte.gschema.xml:300
msgid "Tag sorting method"
msgstr "Taggsorteringsmetod"

#: data/de.wwwtech.gitte.gschema.xml:301
msgid ""
"How to sort tags: \"global-default\" uses the global setting, otherwise "
"\"semver\", \"alphabetical\", or \"date\""
msgstr ""
"Hur taggar ska sorteras: ”global-default” använder den globala "
"inställningen, annars ”semver”, ”alphabetical” eller ”date”"

#: data/de.wwwtech.gitte.gschema.xml:310
msgid "Tag sort direction"
msgstr "Taggsorteringsriktning"

#: data/de.wwwtech.gitte.gschema.xml:311
msgid ""
"Sort direction for tags: \"global-default\" uses the global setting, "
"otherwise \"asc\" or \"desc\""
msgstr ""
"Sorteringsriktning för taggar: ”global-default” använder den globala "
"inställningen, annars ”asc” eller ”desc”"

#: data/de.wwwtech.gitte.gschema.xml:321
msgid "Branch sorting method"
msgstr "Grensorteringsmetod"

#: data/de.wwwtech.gitte.gschema.xml:322
msgid ""
"How to sort branches: \"global-default\" uses the global setting, otherwise "
"\"alphanumeric\", \"last-checkout\", or \"last-commit\""
msgstr ""
"Hur grenar ska sorteras: ”global-default” använder den globala "
"inställningen, annars ”alphanumeric”, ”last-checkout” eller ”last-commit”"

#: data/de.wwwtech.gitte.gschema.xml:331
msgid "Branch sort direction"
msgstr "Grensorteringsriktning"

#: data/de.wwwtech.gitte.gschema.xml:332
msgid ""
"Sort direction for branches: \"global-default\" uses the global setting, "
"otherwise \"asc\" or \"desc\""
msgstr ""
"Sorteringsriktning för grenar: ”global-default” använder den globala "
"inställningen, annars ”asc” eller ”desc”"

#: data/de.wwwtech.gitte.gschema.xml:336
msgid "Collapsed branch groups"
msgstr "Ihopfällda grengrupper"

#: data/de.wwwtech.gitte.gschema.xml:337
msgid "List of branch group prefixes that are collapsed in the sidebar."
msgstr "Lista över grengruppsprefix som fälls ihop i sidopanelen."

#: data/de.wwwtech.gitte.gschema.xml:341
msgid "Expanded remote groups"
msgstr "Expanderade fjärrgrupper"

#: data/de.wwwtech.gitte.gschema.xml:342
msgid "List of remote names that are explicitly expanded in the sidebar."
msgstr "Lista över fjärrnamn som explicit expanderas i sidopanelen."

#: data/de.wwwtech.gitte.gschema.xml:353
msgid "Default merge strategy"
msgstr "Standardsammanslagningsstrategi"

#: data/de.wwwtech.gitte.gschema.xml:354
msgid ""
"The merge strategy preselected in the merge dialog for this repository. "
"Updated each time the user confirms a merge."
msgstr ""
"Sammanslagningsstrategin som är förvald i sammanslagningsdialogen för detta "
"arkiv. Uppdaterad varje gång användaren bekräftar en sammanslagning."

#: data/de.wwwtech.gitte.gschema.xml:358
msgid "Treat matching files as binary (per repository)"
msgstr "Behandla matchande filer som binärer (per arkiv)"

#: data/de.wwwtech.gitte.gschema.xml:359
msgid ""
"Comma-separated git pathspec/glob patterns for this repository. \"global-"
"default\" uses the global setting; any other value overrides it for this "
"repository (an empty value disables filtering here)."
msgstr ""
"Kommaseparerade git-sökvägsangivelser/globmönster för detta arkiv. ”global-"
"default” använder den globala inställningen; alla andra värden åsidosätter "
"den för detta arkiv (ett tomt värde inaktiverar filtrering här)."

#: data/de.wwwtech.gitte.gschema.xml:368
msgid "Auto-fetch mode"
msgstr "Läge för automatisk hämtning"

#: data/de.wwwtech.gitte.gschema.xml:369
msgid ""
"Auto-fetch mode for this repository: \"global-default\" uses the global "
"setting, \"enabled\" forces on, \"disabled\" forces off."
msgstr ""
"Läge för automatisk hämtning för detta arkiv: ”global-default” använder den "
"globala inställningen, ”enabled” slår på, ”disabled” slår av."

#: data/de.wwwtech.gitte.gschema.xml:374
msgid "Auto-fetch interval"
msgstr "Intervall för automatisk hämtning"

#: data/de.wwwtech.gitte.gschema.xml:375
msgid ""
"Interval in seconds between automatic fetches (used when auto-fetch-mode is "
"\"enabled\")."
msgstr ""
"Intervall i sekunder mellan automatiska hämtningar (används när auto-fetch-"
"mode är ”enabled”)."

#: data/de.wwwtech.gitte.gschema.xml:380
msgid "Commit subject length"
msgstr "Ämneslängd för incheckning"

#: data/de.wwwtech.gitte.gschema.xml:381
msgid ""
"Maximum number of characters in the commit subject (first line). When "
"exceeded, the subject is highlighted instead of being truncated. 0 means "
"unlimited."
msgstr ""
"Maximalt antal tecken i incheckningsämnet (första raden). När det överskrids "
"färgmarkeras ämnet i stället för att trunkeras. 0 betyder obegränsat."

#: data/de.wwwtech.gitte.gschema.xml:386
msgid "Commit body line length"
msgstr "Radlängd för incheckningstext"

#: data/de.wwwtech.gitte.gschema.xml:387
msgid ""
"Maximum characters per line in the commit body/details. Overlong portions "
"are highlighted instead of being wrapped. 0 means unlimited."
msgstr ""
"Maximalt antal tecken per rad i incheckningens text/detaljer. Överdrivet "
"långa delar färgmarkeras i stället för att radbrytas. 0 betyder obegränsat."

#: data/de.wwwtech.gitte.gschema.xml:391
msgid "Capitalize commit subject"
msgstr "Versalisera incheckningsämne"

#: data/de.wwwtech.gitte.gschema.xml:392
msgid ""
"When enabled, the first character of the commit subject is automatically "
"capitalized as you type."
msgstr ""
"När aktiverat versaliseras automatiskt den första bokstaven i "
"incheckningsämnet då du skriver."

#: data/de.wwwtech.gitte.gschema.xml:396
msgid "Sign off commits by default"
msgstr "Sign-off på incheckningar som standard"

#: data/de.wwwtech.gitte.gschema.xml:397
msgid ""
"Whether \"Sign Off Commit\" is enabled by default when opening this "
"repository."
msgstr ""
"Huruvida ”Sign-off på incheckning” är aktiverat som standard vid öppnande av "
"detta arkiv."

#: data/de.wwwtech.gitte.gschema.xml:401
msgid "Enable commit trailers"
msgstr "Aktivera incheckningssläprader"

#: data/de.wwwtech.gitte.gschema.xml:402
msgid ""
"Whether this repository shows commit trailer controls and inserts configured "
"default trailers."
msgstr ""
"Huruvida detta arkiv visar kontroller för släprader och infogar "
"konfigurerade standardsläprader."

#: data/de.wwwtech.gitte.gschema.xml:406
msgid "Default commit trailers"
msgstr "Standardincheckningssläprader"

#: data/de.wwwtech.gitte.gschema.xml:407
msgid ""
"Stable IDs of predefined trailers inserted into every new commit message in "
"this repository."
msgstr ""
"Stabila ID:n för fördefinierade släprader som infogas i varje nytt "
"incheckningsmeddelande i detta arkiv."

#: data/de.wwwtech.gitte.gschema.xml:411
msgid "Mainline branch"
msgstr "Huvudlinjesgren"

#: data/de.wwwtech.gitte.gschema.xml:412
msgid ""
"Name of the branch acting as the mainline for this repository (used to "
"display ahead/behind in the commit log). Empty string means auto-detect via "
"heuristic (origin/HEAD, then main/master/develop/trunk)."
msgstr ""
"Namnet på grenen som agerar som huvudlinje för detta arkiv (används för att "
"visa före/erfter i incheckningsloggen). Tom sträng betyder identifiera "
"automatiskt med en heuristik (origin/HEAD, sedan main/master/develop/trunk)."

#: data/de.wwwtech.gitte.gschema.xml:420
msgid "Mainline branch kind"
msgstr "Grentyp för huvudlinje"

#: data/de.wwwtech.gitte.gschema.xml:421
msgid ""
"Whether the configured mainline-branch refers to a local or a remote branch."
msgstr ""
"Huruvida den konfigurerade huvudlinjesgrenen hänvisar till en lokal gren "
"eller en fjärrgren."

#: data/de.wwwtech.gitte.gschema.xml:434
msgid "Forge type"
msgstr "Smedjetyp"

#: data/de.wwwtech.gitte.gschema.xml:435
msgid ""
"Which forge the origin remote points at, used to turn bare references "
"(#123, !123) in commit messages into links. 'auto' detects the forge from "
"the remote host; 'manual' ignores the remote and uses the custom URL "
"templates below; 'none' disables bare-reference linking."
msgstr ""
"Vilken smedja som fjärren origin pekar på, används för att omvandla nakna "
"referenser (#123, !123) i incheckningsmeddelanden till länkar. ”auto” "
"identifierar smedjan från fjärrvärden; ”manual” ignorerar fjärren och "
"använder de anpassade URL-mallarna nedan; ”none” inaktiverar länkning av "
"nakna referenser."

#: data/de.wwwtech.gitte.gschema.xml:439
msgid "Custom issue/PR URL template"
msgstr "Anpassad URL-mall för ärende/PR"

#: data/de.wwwtech.gitte.gschema.xml:440
msgid ""
"URL template used to link #123 references in commit messages when forge-type "
"is \"manual\". Use {id} as a placeholder for the reference number, e.g. "
"\"https://tracker.example.com/issues/{id}\". Empty disables #-linking in "
"manual mode."
msgstr ""
"URL-mall att använda för att länka #123-referenser i incheckningsmeddelanden "
"när forge-type är ”manual”. Använd {id} som en platshållare för "
"referensnumret, t.ex. ”https://tracker.example.com/issues/{id}”. Tom "
"inaktivera #-länkande i manuellt läge."

#: data/de.wwwtech.gitte.gschema.xml:444
msgid "Custom merge-request URL template"
msgstr "Anpassad URL-mall för merge-förfrågan"

#: data/de.wwwtech.gitte.gschema.xml:445
msgid ""
"URL template used to link !123 references in commit messages when forge-type "
"is \"manual\". Use {id} as a placeholder for the reference number, e.g. "
"\"https://tracker.example.com/merge_requests/{id}\". Empty disables !-"
"linking in manual mode."
msgstr ""
"URL-mall att använda för att länka !123-referenser i incheckningsmeddelanden "
"när forge-type är ”manual”. Använd {id} som en platshållare för "
"referensnumret, t.ex. ”https://tracker.example.com/merge_requests/{id}”. En "
"tom mall inaktiverar länkning av referenser med utropstecken i manuellt läge."

#: data/de.wwwtech.gitte.gschema.xml:455
msgid "Default view when opening this repository"
msgstr "Standardvy när detta arkiv öppnas"

#: data/de.wwwtech.gitte.gschema.xml:456
msgid ""
"Which workspace view is shown when this repository is opened: \"global-"
"default\" uses the global setting, otherwise \"changes\", \"current-"
"branch\", or \"commit-graph\"."
msgstr ""
"Vilken arbetsytevy som visas när detta arkiv öppnas: ”global-default” "
"använder den globala inställningen, annars ”changes”, ”current-branch” eller "
"”commit-graph”."

#: data/de.wwwtech.gitte.metainfo.xml.in:10
msgid ""
"Gitte is built around putting commits together with care. Stage or discard "
"your changes line by line, in larger blocks, or a whole file at a time, so "
"every commit holds exactly the work you mean it to and nothing more. It "
"opens straight into your current changes, ready to work."
msgstr ""
"Gitte är byggt runt att omsorgsfullt sätta ihop incheckningar. Köa eller "
"förkasta dina ändringar rad för rad, i större block, eller en hel fil åt "
"gången, så varje incheckning innehåller precis det arbete du tänkt och inget "
"mer. Det öppnas rakt i dina aktuella ändringar, redo att arbeta."

#: data/de.wwwtech.gitte.metainfo.xml.in:11
msgid ""
"Beyond that, follow how your project's history branches and merges in a "
"visual graph, organize branches and tags, set work aside for later, and sync "
"with the places your code is stored, all in a clean, native interface."
msgstr ""
"Bortom det kan du följa hur ditt projekts historik förgrenas och slås ihop i "
"en visuell graf, organisera grenar och taggar, lägga arbete åt sidan för "
"senare, och synkronisera med platserna där din kod finns lagrad, allt i ett "
"rent, inhemskt gränssnitt."

