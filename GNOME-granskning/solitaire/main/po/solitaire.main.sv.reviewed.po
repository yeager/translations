#: data/org.gnome.gitlab.wwarner.Solitaire.desktop.in.in:2
#: data/org.gnome.gitlab.wwarner.Solitaire.metainfo.xml.in.in:7
#: src/window.blp:55 src/window.blp:59
msgid "Solitaire"
msgstr "Solitaire"

#: data/org.gnome.gitlab.wwarner.Solitaire.desktop.in.in:8
msgid ""
"patience;cards;card game;klondike;freecell;tri peaks;spider;pyramid;yukon"
msgstr ""
"patiens;kort;kortspel;klondike;klondyke;freecell;Napoleon på S:t Helena;tri "
"peaks;triple peaks;spindeln;pyramiden;yukon"

#: data/org.gnome.gitlab.wwarner.Solitaire.metainfo.xml.in.in:8
msgid "Play patience games"
msgstr "Spela patienser"

#: data/org.gnome.gitlab.wwarner.Solitaire.metainfo.xml.in.in:10
msgid ""
"Solitaire features simple interface to play a variety of patience games, "
"also known as solitaire games."
msgstr ""
"Solitaire har ett enkelt gränssnitt för att spela en rad olika patienser."

#: data/org.gnome.gitlab.wwarner.Solitaire.metainfo.xml.in.in:14
msgid ""
"Solitaire can figure out if the game you're playing can be won, and will let "
"you undo the move that made the game unwinnable."
msgstr ""
"Solitaire kan räkna ut om spelet du spelar kan vinnas och låter dig ångra "
"draget som gjorde spelet omöjligt att vinna."

#: data/org.gnome.gitlab.wwarner.Solitaire.metainfo.xml.in.in:18
msgid ""
"If you need a hint, Solitaire will give you one that is guaranteed to lead "
"to a win."
msgstr ""
"Om du behöver ett tips ger Solitaire dig ett som är garanterat att leda till "
"vinst."

#: data/org.gnome.gitlab.wwarner.Solitaire.metainfo.xml.in.in:34
msgid "Playing a game of Klondike (solitaire)"
msgstr "Spelar en omgång Klondyke (solitaire)"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:6
msgid "The theme of the playing cards"
msgstr "Temat för kortleken"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:7
msgid ""
"The theme that will be used when rendering cards. This should be the name of "
"one of the SVGs that are bundled as a gresource under card_themes."
msgstr ""
"Temat som kommer användas vid rendering av kort. Detta ska vara namnet på en "
"av SVG-filerna som skickas med som en gresource under card_themes."

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:11
msgid "Enable the game solver"
msgstr "Aktivera spellösaren"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:12
msgid ""
"Used to determine if the solver should be run (to see if the game is "
"winnable or to get hints)."
msgstr ""
"Används för att bestämma om lösaren ska köras (för att se om spelet går att "
"vinna eller för att få tips)."

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:16
msgid "Enable the 'Impossible to Win Game' warning"
msgstr "Aktivera ”Omöjligt att vinna spelet”-varningen"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:17
msgid ""
"Enable the 'Impossible to Win Game' warning, the solver must be enabled for "
"this to work."
msgstr ""
"Aktivera ”Omöjligt att vinna spelet”-varningen, lösaren måste vara aktiverad "
"för att detta ska fungera."

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:25
msgid "The method of scoring games"
msgstr "Metoden för att poängsätta spel"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:26
msgid "The method of scoring that should be used for all games."
msgstr "Metoden som ska användas för att poängsätta alla spel."

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:30
msgid "Whether to use the custom seed"
msgstr "Huruvida det anpassade fröet ska användas"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:31
msgid "Whether to use the custom seed."
msgstr "Huruvida det anpassade fröet ska användas."

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:35
msgid "The seed used for dealing"
msgstr "Fröet som används för giv"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:36
msgid "Used to determine which cards are given in a game."
msgstr "Används för att bestämma vilka kort som delas i ett spel."

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:40
msgid "Width of the window in pixels"
msgstr "Bredden på fönstret i bildpunkter"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:44
msgid "Height of the window in pixels"
msgstr "Höjden på fönstret i bildpunkter"

#: data/org.gnome.gitlab.wwarner.Solitaire.gschema.xml:48
msgid "If the window is maximized"
msgstr "Huruvida fönstret är maximerat"

