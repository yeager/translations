#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:9
#: data/gsettings/org.gnome.shotwell.gschema.xml:444
msgid "OAuth Access Phase Token"
msgstr "OAuth-token för åtkomstfas"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:10
msgid "The authorization token for the currently logged in Tumblr user, if any"
msgstr ""
"Autentiseringstoken för den inloggade Tumblr-användaren, om en sådan finns"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:15
#: data/gsettings/org.gnome.shotwell.gschema.xml:450
msgid "OAuth Access Phase Token Secret"
msgstr "OAuth-hemlighet för åtkomstfas"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:16
msgid ""
"The cryptographic secret used to sign requests against the authorization "
"token for the currently logged in Tumblr user, if any"
msgstr ""
"Kryptografisk hemlighet som används för att signera begäranden med "
"autentiseringstoken för den inloggade Tumblr-användaren, om en sådan finns"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:21
#: data/gsettings/org.gnome.shotwell.gschema.xml:456
#: data/gsettings/org.gnome.shotwell.gschema.xml:514
#: data/gsettings/org.gnome.shotwell.gschema.xml:576
msgid "username"
msgstr "användarnamn"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:22
#: data/gsettings/org.gnome.shotwell.gschema.xml:457
msgid "The user name of the currently logged in Flickr user, if any"
msgstr "Användarnamnet för den inloggade Flickr-användaren, om en sådan finns"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:27
#: data/gsettings/org.gnome.shotwell.gschema.xml:488
msgid "default size"
msgstr "standardstorlek"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:28
msgid ""
"A numeric code representing the default size for photos uploaded to Tumblr"
msgstr "Sifferkod för standardstorleken på bilder som laddas upp till Tumblr"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:33
msgid "default blog"
msgstr "standardblogg"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:34
msgid "The name of the default blog of the user, if any"
msgstr "Namnet på standardbloggen för användaren, om någon"

#: data/gsettings/org.gnome.shotwell.gschema.xml:25
msgid "display basic properties"
msgstr "visa grundläggande egenskaper"

#: data/gsettings/org.gnome.shotwell.gschema.xml:26
msgid "True if the basic properties pane is to be displayed, false otherwise"
msgstr "Sant om panelen med grundläggande egenskaper ska visas, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:31
msgid "display extended properties"
msgstr "visa utökade egenskaper"

#: data/gsettings/org.gnome.shotwell.gschema.xml:32
msgid ""
"True if the extended properties window is to be displayed, false otherwise"
msgstr "Sant om fönstret med utökade egenskaper ska visas, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:37
msgid "display sidebar"
msgstr "visa sidopanelen"

#: data/gsettings/org.gnome.shotwell.gschema.xml:38
msgid "True if the sidebar is to be displayed, false otherwise"
msgstr "Sant om sidopanelen ska visas, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:43
msgid "display toolbar"
msgstr "visa verktygsfältet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:44
msgid "True if the bottom toolbar is to be displayed, false otherwise"
msgstr "Sant om det nedre verktygsfältet ska visas, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:49
msgid "display map widget"
msgstr "visa kartkomponent"

#: data/gsettings/org.gnome.shotwell.gschema.xml:50
msgid "True if the map widget is to be displayed, false otherwise"
msgstr "Sant om kartkomponenten ska visas, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:55
msgid "display search bar"
msgstr "visa sökfältet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:56
msgid "True if the Search/Filter Toolbar is to be displayed, false otherwise"
msgstr "Sant om sök- och filterverktygsfältet ska visas, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:61
msgid "display photo titles"
msgstr "visa bildtitlar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:62
msgid ""
"True if photo titles are to be displayed beneath thumbnails in collection "
"views, false otherwise"
msgstr ""
"Sant om bildtitlar ska visas under miniatyrbilderna i samlingsvyerna, annars "
"falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:67
msgid "display photo comments"
msgstr "visa bildkommentarer"

#: data/gsettings/org.gnome.shotwell.gschema.xml:68
msgid ""
"True if photo comments are to be displayed beneath thumbnails in collection "
"views, false otherwise"
msgstr ""
"Sant om bildkommentarer ska visas under miniatyrbilderna i samlingsvyerna, "
"annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:73
msgid "display event comments"
msgstr "visa händelsekommentarer"

#: data/gsettings/org.gnome.shotwell.gschema.xml:74
msgid ""
"True if event comments are to be displayed beneath thumbnails in event "
"views, false otherwise"
msgstr ""
"Sant om händelsekommentarer ska visas under miniatyrbilderna i "
"händelsevyerna, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:79
msgid "display photo tags"
msgstr "visa bildtaggar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:80
msgid ""
"True if photo tags are to be listed beneath thumbnails in collection views, "
"false otherwise"
msgstr ""
"Sant om bildtaggar ska visas under miniatyrbilderna i samlingsvyerna, annars "
"falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:85
msgid "display photo ratings"
msgstr "visa bildbetyg"

#: data/gsettings/org.gnome.shotwell.gschema.xml:86
msgid ""
"True if a photo’s rating should be displayed as overlaid trinket, false "
"otherwise"
msgstr ""
"Sant om bildens betyg ska visas som en överlagrad symbol, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:91
msgid "rating filter level"
msgstr "betygsfilternivå"

#: data/gsettings/org.gnome.shotwell.gschema.xml:92
msgid ""
"Determines how to filter photos based on their ratings. 1: Rejected or "
"better, 2: Unrated or better, 3: One or better, 4: Two or better, 5: Three "
"or better, 6: Four or better, 7: Five or better"
msgstr ""
"Avgör hur bilder filtreras baserat på deras betyg: 1: Avvisad eller bättre, "
"2: Ej betygsatt eller bättre, 3: Ett eller bättre, 4: Två eller bättre, 5: "
"Tre eller bättre, 6: Fyra eller bättre, 7: Fem eller bättre"

#: data/gsettings/org.gnome.shotwell.gschema.xml:97
msgid "sort events ascending"
msgstr "sortera händelser stigande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:98
msgid "True if events should be sorted ascending, false if descending"
msgstr ""
"Sant om händelser ska sorteras i stigande ordning, annars i fallande ordning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:103
msgid "sort library photos ascending"
msgstr "sortera biblioteksbilder stigande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:104
msgid "True if library photos should be sorted ascending, false if descending"
msgstr ""
"Sant om bibliotekets bilder ska sorteras i stigande ordning, annars i "
"fallande ordning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:109
msgid "sort library photos criteria"
msgstr "kriterier för att sortera biblioteksbilder"

#: data/gsettings/org.gnome.shotwell.gschema.xml:110
msgid ""
"A numeric code that specifies the sort criteria for photos in library views"
msgstr "Sifferkod som anger sorteringskriteriet för bilder i biblioteksvyer"

#: data/gsettings/org.gnome.shotwell.gschema.xml:115
msgid "sort event photos ascending"
msgstr "sortera händelsebilder stigande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:116
msgid "True if event photos should be sorted ascending, false if descending"
msgstr ""
"Sant om händelsebilder ska sorteras i stigande ordning, annars i fallande "
"ordning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:121
msgid "sort event photos criteria"
msgstr "sortera händelsebilder efter kriterier"

#: data/gsettings/org.gnome.shotwell.gschema.xml:122
msgid "Specifies the sort criteria for event photos"
msgstr "Anger sorteringskriteriet för händelsebilder"

#: data/gsettings/org.gnome.shotwell.gschema.xml:127
msgid "use 24 hour time"
msgstr "använd 24-timmarstid"

#: data/gsettings/org.gnome.shotwell.gschema.xml:128
msgid ""
"True if should display times with a 24 hour clock, false if times should use "
"AM/PM notation"
msgstr "Sant om tider ska visas med 24-timmarsklocka, annars med AM/PM-format"

#: data/gsettings/org.gnome.shotwell.gschema.xml:133
msgid "keep relative time between photos"
msgstr "behåll relativ tid mellan bilder"

#: data/gsettings/org.gnome.shotwell.gschema.xml:134
msgid ""
"True if when adjusting time/date of photos, relative time should be "
"maintained. False if all photos should be set to the same time"
msgstr ""
"Sant om tidsintervallet mellan bilder ska behållas när deras datum och tid "
"justeras. Falskt om alla bilder ska få samma tid"

#: data/gsettings/org.gnome.shotwell.gschema.xml:139
msgid "modify original photo files"
msgstr "ändra originalbildfiler"

#: data/gsettings/org.gnome.shotwell.gschema.xml:140
msgid ""
"True if when adjusting time/date of photos, the original files should be "
"modified as well. False if changes are made only in the database"
msgstr ""
"Sant om originalfilerna också ska ändras när bilders datum och tid justeras. "
"Falskt om ändringarna bara ska göras i databasen"

#: data/gsettings/org.gnome.shotwell.gschema.xml:145
msgid "show welcome dialog on startup"
msgstr "visa välkomstdialog vid start"

#: data/gsettings/org.gnome.shotwell.gschema.xml:146
msgid ""
"True if, when on startup, a welcome dialog should be shown. False if it "
"should not be shown"
msgstr "Sant om en välkomstdialog ska visas vid programstart, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:151
msgid "sidebar position"
msgstr "position på sidopanel"

#: data/gsettings/org.gnome.shotwell.gschema.xml:152
msgid "The width, in pixels, of the sidebar"
msgstr "Sidopanelens bredd i bildpunkter"

#: data/gsettings/org.gnome.shotwell.gschema.xml:157
msgid "photo thumbnail scale"
msgstr "miniatyrbildsskala"

#: data/gsettings/org.gnome.shotwell.gschema.xml:158
msgid "The scale of photo thumbnails, ranging from 72 to 360"
msgstr "Skalan för miniatyrbilder, i intervallet 72 till 360"

#: data/gsettings/org.gnome.shotwell.gschema.xml:163
msgid "pin toolbar state"
msgstr "verktygsfältets fästtillstånd"

#: data/gsettings/org.gnome.shotwell.gschema.xml:164
msgid "Pin toolbar in fullscreen, or not"
msgstr "Fäst verktygsfält vid helskärm, eller fäst inte"

#: data/gsettings/org.gnome.shotwell.gschema.xml:169
msgid "prefer GTK+’s dark theme"
msgstr "föredra GTK+:s mörka tema"

#: data/gsettings/org.gnome.shotwell.gschema.xml:170
msgid "Whether to use the dark theme of GTK+ for Shotwell or not"
msgstr "Om det mörka temat för GTK+ ska användas för Shotwell eller inte"

#: data/gsettings/org.gnome.shotwell.gschema.xml:175
msgid "background for transparent images"
msgstr "bakgrund för transparenta bilder"

#: data/gsettings/org.gnome.shotwell.gschema.xml:176
msgid "The background to use for transparent images"
msgstr "Bakgrund att använda för transparenta bilder"

#: data/gsettings/org.gnome.shotwell.gschema.xml:181
msgid "color for solid transparency background"
msgstr "färg för heltäckande transparent bakgrund"

#: data/gsettings/org.gnome.shotwell.gschema.xml:182
msgid "Color to use if background for transparent images is set to solid color"
msgstr ""
"Färg som används om bakgrunden för genomskinliga bilder är inställd på "
"enfärgad"

#: data/gsettings/org.gnome.shotwell.gschema.xml:187
msgid "Selection state of “hide photos” option"
msgstr "Valtillstånd för alternativet ”dölj bilder”"

#: data/gsettings/org.gnome.shotwell.gschema.xml:188
msgid ""
"Last used selection state of the “hide photos already imported” option in "
"the import page"
msgstr ""
"Senast använda tillstånd för ”dölj bilder som redan importerats” på "
"importsidan"

#: data/gsettings/org.gnome.shotwell.gschema.xml:195
msgid "duration"
msgstr "varaktighet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:196
msgid "The time (in seconds) to show each photo in the slideshow"
msgstr "Tiden (i sekunder) som varje bild visas i bildspelet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:201
msgid "transition duration"
msgstr "övergångslängd"

#: data/gsettings/org.gnome.shotwell.gschema.xml:202
msgid ""
"The time (in seconds) that a transition runs between photos in a slideshow"
msgstr "Tiden (i sekunder) som en övergång körs mellan bilder i ett bildspel"

#: data/gsettings/org.gnome.shotwell.gschema.xml:207
msgid "transition effect id"
msgstr "övergångseffekt-ID"

#: data/gsettings/org.gnome.shotwell.gschema.xml:208
msgid ""
"The time (in seconds) to show each transition between photos in a slideshow"
msgstr ""
"Tiden (i sekunder) som varje övergång mellan bilder i ett bildspel varar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:213
msgid "Show title"
msgstr "Visa titel"

#: data/gsettings/org.gnome.shotwell.gschema.xml:214
msgid "Whether to show the title of a photo during the slideshow"
msgstr "Om bildens titel ska visas under bildspelet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:219
#: data/ui/slideshow_settings.ui:78
msgid "Shuffle"
msgstr "Blanda"

#: data/gsettings/org.gnome.shotwell.gschema.xml:220
msgid "Whether to shuffle the order of photos during the slideshow"
msgstr "Om bilderna ska visas i slumpmässig ordning under bildspelet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:227
msgid "maximize library window"
msgstr "maximera biblioteksfönstret"

#: data/gsettings/org.gnome.shotwell.gschema.xml:228
msgid "True if library application is maximized, false otherwise"
msgstr "Sant om biblioteksfönstret är maximerat, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:233
msgid "width of library window"
msgstr "bredd på biblioteksfönstret"

#: data/gsettings/org.gnome.shotwell.gschema.xml:234
msgid "The last recorded width of the library application window"
msgstr "Den senast lagrade bredden på biblioteksprogrammets fönster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:239
msgid "height of library window"
msgstr "höjden på biblioteksfönstret"

#: data/gsettings/org.gnome.shotwell.gschema.xml:240
msgid "The last recorded height of the library application window"
msgstr "Den senast lagrade höjden på biblioteksprogrammets fönster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:245
msgid "maximize direct-edit window"
msgstr "maximera direktredigeringsfönstret"

#: data/gsettings/org.gnome.shotwell.gschema.xml:246
msgid "True if direct-edit application is maximized, false otherwise"
msgstr "Sant om direktredigeringsfönstret är maximerat, annars falskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:251
msgid "width of direct-edit window"
msgstr "bredd på direktredigeringsfönstret"

#: data/gsettings/org.gnome.shotwell.gschema.xml:252
msgid "The last recorded width of the direct-edit application window"
msgstr "Den senast lagrade bredden på direktredigeringsprogrammets fönster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:257
msgid "height of direct-edit window"
msgstr "höjd på direktredigeringsfönstret"

#: data/gsettings/org.gnome.shotwell.gschema.xml:258
msgid "The last recorded height of the direct-edit application window"
msgstr "Den senast lagrade höjden på direktredigeringsprogrammets fönster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:263
msgid "sidebar divider position"
msgstr "position på sidopanelens avdelare"

#: data/gsettings/org.gnome.shotwell.gschema.xml:264
msgid ""
"The last recorded position of the divider between the sidebar and view in "
"library application window"
msgstr ""
"Den senast lagrade positionen på avdelaren mellan sidopanelen och vyn i "
"biblioteksprogrammets fönster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:271
msgid "import directory"
msgstr "importkatalog"

#: data/gsettings/org.gnome.shotwell.gschema.xml:272
msgid "Directory in which imported photo files are placed"
msgstr "Katalog i vilken importerade bildfiler placeras"

#: data/gsettings/org.gnome.shotwell.gschema.xml:277
msgid "watch library directory for new files"
msgstr "bevaka bibliotekskatalogen efter nya filer"

#: data/gsettings/org.gnome.shotwell.gschema.xml:278
msgid ""
"If true, files added to the library directory are automatically imported"
msgstr ""
"Om sant importeras filer som läggs till i bibliotekskatalogen automatiskt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:283
msgid "write metadata to master files"
msgstr "skriver metadata till huvudfiler"

#: data/gsettings/org.gnome.shotwell.gschema.xml:284
msgid ""
"If true, changes to metadata (tags, titles, etc.) are written to the master "
"photo file"
msgstr ""
"Om sant skrivs ändringar i metadata (taggar, titlar med mera) till "
"originalbildfilen"

#: data/gsettings/org.gnome.shotwell.gschema.xml:289
msgid "use lowercase filenames"
msgstr "använd filnamn i gemener"

#: data/gsettings/org.gnome.shotwell.gschema.xml:290
msgid ""
"If true, Shotwell will convert all filenames to lowercase when importing "
"photo files"
msgstr "Om sant gör Shotwell alla filnamn till gemener när bilder importeras"

#: data/gsettings/org.gnome.shotwell.gschema.xml:295
msgid "directory pattern"
msgstr "katalogmönster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:296
msgid ""
"A string encoding a naming pattern that will be used to name photo "
"directories on import"
msgstr ""
"En sträng med namnmönster som kommer att användas för att namnge "
"bildkataloger vid import"

#: data/gsettings/org.gnome.shotwell.gschema.xml:301
msgid "directory pattern custom"
msgstr "anpassat katalogmönster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:302
msgid ""
"A string encoding a custom naming pattern that will be used to name photo "
"directories on import"
msgstr ""
"En sträng med ett anpassat namnmönster som kommer att användas för att "
"namnge bildkataloger vid import"

#: data/gsettings/org.gnome.shotwell.gschema.xml:307
msgid "RAW developer default"
msgstr "Standard-RAW-framkallare"

#: data/gsettings/org.gnome.shotwell.gschema.xml:308
msgid "Default option for which RAW developer Shotwell will use"
msgstr "Standardalternativ för vilken RAW-framkallare Shotwell ska använda"

#: data/gsettings/org.gnome.shotwell.gschema.xml:315
msgid "Most-recently-used crop aspect ratio menu choice"
msgstr "Menyval för senast använda bildförhållande vid beskärning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:316
msgid "A numeric code representing the last crop menu choice the user made"
msgstr "Sifferkod för användarens senaste val i beskärningsmenyn"

#: data/gsettings/org.gnome.shotwell.gschema.xml:320
msgid "Most-recently-used crop custom aspect ratio’s numerator"
msgstr "Täljare för senast använda anpassade bildförhållande vid beskärning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:321
msgid ""
"A nonzero, positive integer representing the width part of the last custom "
"crop ratio the user entered"
msgstr ""
"Positivt heltal större än noll som anger bredden i det senast angivna "
"anpassade beskärningsförhållandet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:325
msgid "Most-recently-used crop custom aspect ratio’s denominator"
msgstr "Nämnare för senast använda anpassade bildförhållande vid beskärning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:326
msgid ""
"A nonzero, positive integer representing the height part of the last custom "
"crop ratio the user entered"
msgstr ""
"Positivt heltal större än noll som anger höjden i det senast angivna "
"anpassade beskärningsförhållandet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:333
msgid "external photo editor"
msgstr "extern bildredigerare"

#: data/gsettings/org.gnome.shotwell.gschema.xml:334
msgid "External application used to edit photos"
msgstr "Externt program att använda för att redigera bilder"

#: data/gsettings/org.gnome.shotwell.gschema.xml:339
msgid "external raw editor"
msgstr "extern RAW-redigerare"

#: data/gsettings/org.gnome.shotwell.gschema.xml:340
msgid "External application used to edit RAW photos"
msgstr "Externt program att använda för att redigera RAW-bilder"

#: data/gsettings/org.gnome.shotwell.gschema.xml:385
#: data/gsettings/org.gnome.shotwell.gschema.xml:386
msgid "Setting in export dialog: how to trim images"
msgstr "Inställning i exportdialogen: hur bilder justeras"

#: data/gsettings/org.gnome.shotwell.gschema.xml:391
msgid "export metadata"
msgstr "exportera metadata"

#: data/gsettings/org.gnome.shotwell.gschema.xml:392
msgid "Setting in export dialog: option to export metadata"
msgstr "Inställning i exportdialogen: exportalternativ för metadata"

#: data/gsettings/org.gnome.shotwell.gschema.xml:397
msgid "format setting, special value"
msgstr "formatinställning, specialvärde"

#: data/gsettings/org.gnome.shotwell.gschema.xml:398
msgid "Setting in export dialog: format setting, special value"
msgstr "Inställning i exportdialogen: formatinställning, specialvärde"

#: data/gsettings/org.gnome.shotwell.gschema.xml:403
msgid "format setting, type value"
msgstr "formatinställning, typvärde"

#: data/gsettings/org.gnome.shotwell.gschema.xml:404
msgid "Setting in export dialog: format setting, type value"
msgstr "Inställning i exportdialogen: formatinställning, typvärde"

#: data/gsettings/org.gnome.shotwell.gschema.xml:409
msgid "JPEG quality option"
msgstr "Alternativ för JPEG-kvalitet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:410
msgid "Setting in export dialog: jpeg quality option"
msgstr "Inställning i exportdialogen: alternativ för jpeg-kvalitet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:415
msgid "maximal size of image"
msgstr "maximal bildstorlek"

#: data/gsettings/org.gnome.shotwell.gschema.xml:416
msgid "Setting in export dialog: maximal size of image"
msgstr "Inställning i exportdialogen: maximal bildstorlek"

#: data/gsettings/org.gnome.shotwell.gschema.xml:423
msgid "last used publishing service"
