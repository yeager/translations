 #: src/glossary/glossary.xml:1234(phrase)
 #: src/glossary/glossary.xml:1237(primary)
@@ -1410,11 +1884,16 @@
 "quote>, where <quote>rr</quote> represents red, <quote>gg</quote> represents "
