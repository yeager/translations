#: src/filters/distort/vpropagate.xml:82(term)
#: src/filters/distort/wind.xml:108(term)
#: src/filters/distort/video.xml:78(term)
#: src/filters/distort/whirlpinch.xml:121(term)
#: src/filters/distort/waves.xml:71(term)
