#: src/menus/help/welcome-dialog.xml:12(para)
msgid ""
"The <guimenuitem>Welcome Dialog</guimenuitem> command opens the <link "
"linkend=\"gimp-welcome-dialog\">Welcome Dialog</link>. See there for more "
"information."
msgstr ""
"Kommandot <guimenuitem>Välkomstdialog</guimenuitem> öppnar <link "
"linkend=\"gimp-welcome-dialog\">välkomstdialogen</link>. Där finns mer "
"information."

#: src/menus/help/welcome-dialog.xml:19(title)
