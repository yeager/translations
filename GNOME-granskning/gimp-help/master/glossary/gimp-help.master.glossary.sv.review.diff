 #: src/glossary/glossary.xml:628(para)
 msgid ""
-"\"Display-referred white\" (or for simplicity, \"white\") means the floating "
-"point RGB color (1.0, 1.0, 1.0) and the integer equivalents (255,255,255),"
-"(65535,65535,65535), etc, for 8-bit integer, 16-bit integer, etc."
-msgstr ""
+"\"Display-referred white\" (or for simplicity, \"white\") means the floating"
+" point RGB color (1.0, 1.0, 1.0) and the integer equivalents "
+"(255,255,255),(65535,65535,65535), etc, for 8-bit integer, 16-bit integer, "
+"etc."
+msgstr ""
+"\"Visningsrelaterat vitt\" (eller kort och gott \"vitt\") avser RGB-färgen "
+"med flyttalsvärdena (1.0, 1.0, 1.0) och heltalsekvivalenterna (255,255,255),"
+" (65535,65535,65535) och så vidare för 8-bitars heltal, 16-bitars heltal och"
+" så vidare."
 
 #: src/glossary/glossary.xml:633(para)
 msgid ""
-"\"Display-referred white\" has the very special significance that in display-"
-"referred editing there's no such thing as \"brighter than white\". So in "
-"display-referred image editing, all RGB channel values are less than or "
-"equal to 1.0 and no color is brighter than \"white\", (1.0, 1.0, 1.0)."
-msgstr ""
+"\"Display-referred white\" has the very special significance that in "
+"display-referred editing there's no such thing as \"brighter than white\". "
+"So in display-referred image editing, all RGB channel values are less than "
+"or equal to 1.0 and no color is brighter than \"white\", (1.0, 1.0, 1.0)."
+msgstr ""
+"\"Visningsrelaterat vitt\" har den mycket särskilda innebörden att det i "
+"visningsrelaterad redigering inte finns något som är \"ljusare än vitt\". "
+"Vid visningsrelaterad bildredigering är alltså alla RGB-kanalvärden mindre "
+"än eller lika med 1.0, och ingen färg är ljusare än \"vitt\", (1.0, 1.0, "
+"1.0)."
 
