 #: src/menus/colors/components/decompose.xml:219(para)
 msgid ""
-"This option decomposes image into three grayscale layers, layer <quote>L</"
-"quote> for Luminance, layer <quote>A</quote> for colors between green and "
-"red, layer <quote>B</quote> for colors between blue and yellow."
-msgstr ""
+"This option decomposes image into three grayscale layers, layer "
+"<quote>L</quote> for Luminance, layer <quote>A</quote> for colors between "
+"green and red, layer <quote>B</quote> for colors between blue and yellow."
+msgstr ""
+"Det här alternativet delar upp bilden i tre gråskalelager: <quote>L</quote> "
+"för luminans, <quote>A</quote> för färger mellan grönt och rött och "
+"<quote>B</quote> för färger mellan blått och gult."
 
 #: src/menus/colors/components/decompose.xml:225(para)
 msgid ""
 "The LAB Decomposing is a color model of the Luminance-Color family. A "
-"channel is used for the Luminosity while two other channels are used for the "
-"Colors. The LAB color model is used by Photoshop."
-msgstr ""
+"channel is used for the Luminosity while two other channels are used for the"
+" Colors. The LAB color model is used by Photoshop."
+msgstr ""
+"LAB-uppdelningen är en färgmodell ur familjen luminans-färg. En kanal "
+"används för ljusstyrkan medan två andra kanaler används för färgerna. "
+"Färgmodellen LAB används av Photoshop."
 
 #: src/menus/colors/components/decompose.xml:234(term)
 msgid "LCH"
-msgstr ""
+msgstr "LCH"
 
 #: src/menus/colors/components/decompose.xml:236(para)
