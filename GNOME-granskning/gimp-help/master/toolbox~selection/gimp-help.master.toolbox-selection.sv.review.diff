 #: src/toolbox/selection/fuzzy.xml:18(secondary)
 #: src/toolbox/selection/fuzzy.xml:25(primary)
@@ -746,24 +740,24 @@
 
 #: src/toolbox/selection/fuzzy.xml:28(primary)
