 "Scissors</guimenuitem></menuchoice>,"
-msgstr ""
+msgstr "Från bildmenyraden <menuchoice><guimenu>Verktyg</guimenu><guisubmenu>Markeringsverktyg</guisubmenu><guimenuitem>Intelligenta saxar</guimenuitem></menuchoice>,"
 
