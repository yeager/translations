msgid ""
"The <guimenuitem>Add Alpha to Selection</guimenuitem> command creates a "
"selection from the combined alpha channels of all selected layers and adds "
"that to the already existing selection."
msgstr ""
"Kommandot <guimenuitem>Lägg till alfakanal till markering</guimenuitem> "
"skapar en markering utifrån de markerade lagrens sammanslagna alfakanaler "
"och lägger till den i den befintliga markeringen."

#: src/menus/layer/alpha-selection-add.xml:39(para)
msgid ""
"You can access this command from the main menu through "
"<menuchoice><guimenu>Layer</guimenu><guisubmenu>Transparency</guisubmenu><guimenuitem>Add"
" Alpha to Selection</guimenuitem></menuchoice>."
msgstr ""
"Du hittar kommandot i huvudmenyn under "
"<menuchoice><guimenu>Lager</guimenu><guisubmenu>Transparens</guisubmenu><guimenuitem>Lägg"
" till alfakanal till markering</guimenuitem></menuchoice>."

#: src/menus/layer/alpha-selection-add.xml:52(title)
msgid "Applying <quote>Add Alpha to Selection</quote>"
msgstr "Använda <quote>Lägg till alfakanal till markering</quote>"

#: src/menus/layer/alpha-selection-add.xml:78(para)
