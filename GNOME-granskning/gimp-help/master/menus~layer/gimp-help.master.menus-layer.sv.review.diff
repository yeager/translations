+"<keycombo><keycap>Shift</keycap><keycap>Ctrl</keycap><keycap>O</keycap></keycombo>."
+msgstr ""
+"Du kan också använda snabbtangenten "
+"<keycombo><keycap>Skift</keycap><keycap>Ctrl</keycap><keycap>O</keycap></keycombo>."
 
