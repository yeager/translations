 msgid "<quote>Offset</quote> Options"
-msgstr ""
+msgstr "Alternativ för <quote>Förskjutning</quote>"
 
 #: src/menus/layer/offset.xml:63(title)
 msgid "The <quote>Offset</quote> dialog"
