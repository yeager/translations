 #: src/menus/select/float.xml:152(para)
 msgid ""
@@ -1246,33 +1527,55 @@
 "transform\">Unified Transform</link>, <link linkend=\"gimp-tool-"
 "rotate\">Rotate</link>, <link linkend=\"gimp-tool-scale\">Scale</link>, "
 "<link linkend=\"gimp-tool-shear\">Shear</link>, <link linkend=\"gimp-tool-"
-"flip\">Flip</link>, <link linkend=\"gimp-tool-perspective\">Perspective</"
-"link>, <link linkend=\"gimp-tool-transform-3d\">3D Transform</link>, and "
-"<link linkend=\"gimp-tool-handle-transform\">Handle Transform</link>, create "
-"a floating selection when they are used on a selection, rather than a layer. "
-"When the <guilabel>Transform</guilabel> mode is <emphasis>Layer</emphasis> "
-"and a selection already exists, these tools transform the selection and "
-"create a floating selection with the result. If a selection does not exist, "
-"they transform the current layer and do not create a floating selection. (If "
-"the <guilabel>Transform</guilabel> mode is <emphasis>Selection</emphasis>, "
-"they also do not create a floating selection.)"
-msgstr ""
+"flip\">Flip</link>, <link linkend=\"gimp-tool-"
+"perspective\">Perspective</link>, <link linkend=\"gimp-tool-"
+"transform-3d\">3D Transform</link>, and <link linkend=\"gimp-tool-handle-"
+"transform\">Handle Transform</link>, create a floating selection when they "
+"are used on a selection, rather than a layer. When the "
+"<guilabel>Transform</guilabel> mode is <emphasis>Layer</emphasis> and a "
+"selection already exists, these tools transform the selection and create a "
+"floating selection with the result. If a selection does not exist, they "
+"transform the current layer and do not create a floating selection. (If the "
+"<guilabel>Transform</guilabel> mode is <emphasis>Selection</emphasis>, they "
+"also do not create a floating selection.)"
+msgstr ""
+"Dessutom skapar alla transformverktyg en flytande markering när de används "
+"på en markering i stället för på ett lager: <link linkend=\"gimp-tool-"
+"unified-transform\">Enhetlig transform</link>, <link linkend=\"gimp-tool-"
+"rotate\">Rotera</link>, <link linkend=\"gimp-tool-scale\">Skala</link>, "
+"<link linkend=\"gimp-tool-shear\">Skeva</link>, <link linkend=\"gimp-tool-"
+"flip\">Vänd</link>, <link linkend=\"gimp-tool-"
+"perspective\">Perspektiv</link>, <link linkend=\"gimp-tool-"
+"transform-3d\">3D-transformering</link> och <link linkend=\"gimp-tool-"
+"handle-transform\">Handtagstransformering</link>. Om läget "
+"<guilabel>Transformera</guilabel> är <emphasis>Lager</emphasis> och det "
+"redan finns en markering omvandlar verktygen markeringen och skapar en "
+"flytande markering av resultatet. Om det inte finns någon markering "
+"omvandlas det aktuella lagret utan att en flytande markering skapas. (Det "
+"skapas inte heller någon flytande markering om läget "
+"<guilabel>Transformera</guilabel> är <emphasis>Markering</emphasis>.)"
 
