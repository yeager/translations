#: src/menus/select/grow.xml:92(None)
msgid ""
"@@image: 'images/menus/selection-grow-corners.png'; md5=THIS FILE DOESN'T "
"EXIST"
msgstr ""
"@@image: 'images/menus/selection-grow-corners.png'; md5=THIS FILE DOESN'T "
