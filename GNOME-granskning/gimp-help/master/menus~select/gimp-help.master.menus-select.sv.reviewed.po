#: src/menus/select/to-path.xml:11(title)
msgid "To Path"
msgstr "Till bana"

#: src/menus/select/to-path.xml:13(primary)
#: src/menus/select/to-channel.xml:23(primary)
#: src/menus/select/shrink.xml:23(primary)
#: src/menus/select/sharpen.xml:23(primary)
