#: src/menus/select/dialog.xml:22(phrase)
#: src/menus/select/dialog.xml:61(quote) src/menus/select/dialog.xml:67(quote)
#: src/menus/select/dialog.xml:161(quote)
msgid "Selection Editor"
msgstr "Markeringsredigerare"

#: src/menus/select/dialog.xml:26(secondary)
#: src/menus/select/dialog.xml:29(primary)
msgid "Editor"
msgstr "Redigerare"

#: src/menus/select/dialog.xml:31(para)
msgid ""
"The <guimenuitem>Selection Editor</guimenuitem> command displays the "
"<quote>Selection Editor</quote> dialog window. This dialog window displays "
"the active selection in the current image and gives you easy access to the "
"selection-related commands. It is not really intended for editing selections "
"directly, but if you are working on a selection, it is handy to have the "
"selection commands all together, since it is easier to click on a button "
"than to search for commands in the command tree of the menubar. The "
"<quote>Selection Editor</quote> also offers some advanced options for the "
"<quote>Select to Path</quote> command."
msgstr ""
"Kommandot <guimenuitem>Markeringsredigerare</guimenuitem> visar dialogfönstret "
"<quote>Markeringsredigerare</quote>. Dialogfönstret visar den aktiva "
"markeringen i den aktuella bilden och ger enkel åtkomst till kommandon som "
"rör markeringar. Det är inte avsett för direkt redigering av markeringar, "
"men när du arbetar med en markering är det praktiskt att ha alla "
"markeringskommandon samlade, eftersom det är enklare att klicka på en knapp "
"än att söka efter kommandon i menyradens kommandoträd. "
"<quote>Markeringsredigerare</quote> erbjuder också avancerade alternativ "
"för kommandot <quote>Markering till bana</quote>."

#: src/menus/select/dialog.xml:48(para)
msgid ""
"You can access this command from the image menubar through "
"<menuchoice><guimenu>Select</guimenu><guimenuitem>Selection Editor</"
"guimenuitem></menuchoice>."
msgstr ""
"Du kommer åt kommandot från bildens menyrad via <menuchoice><guimenu>"
"Markera</guimenu><guimenuitem>Markeringsredigerare</guimenuitem></menuchoice>."

#: src/menus/select/dialog.xml:78(term)
msgid "The Buttons"
msgstr "Knapparna"

#: src/menus/select/dialog.xml:80(para)
msgid ""
"The <quote>Selection Editor</quote> dialog window has several buttons which "
"you can use to easily access selection commands:"
msgstr ""
"Dialogfönstret <quote>Markeringsredigerare</quote> har flera knappar som du "
"kan använda för att lätt komma åt markeringskommandon:"

#: src/menus/select/dialog.xml:86(para)
msgid ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-all-16.png"
"\"/></guiicon> The <link linkend=\"gimp-selection-all\">Select All</link> "
"button."
msgstr ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-all-16.png\"/>"
"</guiicon> Knappen <link linkend=\"gimp-selection-all\">Markera allt</link>."

#: src/menus/select/dialog.xml:95(para)
msgid ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-none-16.png"
"\"/></guiicon> The <link linkend=\"gimp-selection-none\">Select None</link> "
"button."
msgstr ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-none-16.png\"/>"
"</guiicon> Knappen <link linkend=\"gimp-selection-none\">Markera inget</link>."

#: src/menus/select/dialog.xml:104(para)
msgid ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-invert-16.png\"/></"
"guiicon> The <link linkend=\"gimp-selection-invert\">Select Invert</link> "
"button."
msgstr ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-invert-16.png\"/>"
"</guiicon> Knappen <link linkend=\"gimp-selection-invert\">Invertera markering</link>."

#: src/menus/select/dialog.xml:113(para)
msgid ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-to-channel-"
"16.png\"/></guiicon> The <link linkend=\"gimp-selection-to-channel\">Save to "
"Channel</link> button."
msgstr ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-to-channel-"
"16.png\"/></guiicon> Knappen <link linkend=\"gimp-selection-to-channel"
"\">Spara till kanal</link>."

#: src/menus/select/dialog.xml:122(para)
msgid ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-to-path-16."
"png\"/></guiicon> The <link linkend=\"selection-to-path\">To Path</link> "
"button. If you hold the <keycap>Shift</keycap> key while clicking on this "
"button, the <quote>Advanced Settings</quote> dialog is displayed. Please see "
"the next section for details about these options."
msgstr ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-to-path-16."
"png\"/></guiicon> Knappen <link linkend=\"selection-to-path\">Till bana</link>. Om du "
"håller ned <keycap>Skift</keycap> medan du klickar på knappen visas "
"dialogrutan <quote>Avancerade inställningar</quote>. Se nästa avsnitt för "
"information om dessa alternativ."

#: src/menus/select/dialog.xml:134(para)
msgid ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-stroke-16."
"png\"/></guiicon> The <link linkend=\"gimp-selection-stroke\">Stroke "
"Selection</link> button."
msgstr ""
"<guiicon><inlinegraphic fileref=\"images/dialogs/stock-selection-stroke-16."
"png\"/></guiicon> Knappen <link linkend=\"gimp-selection-stroke\">Stryk "
"markering</link>."

#: src/menus/select/dialog.xml:146(term)
msgid "The display window"
msgstr "Visningsfönstret"

#: src/menus/select/dialog.xml:148(para)
msgid ""
"In the display window, selected areas of the image are white, non-selected "
"areas are black, and partially selected areas are in shades of gray. "
"Clicking in this window acts like <link linkend=\"gimp-selection-by_color"
"\">Select by Color</link>. See the example below."
msgstr ""
"I visningsfönstret är bildens markerade områden vita, omarkerade områden "
"svarta och delvis markerade områden visas i gråtoner. Ett klick i detta "
"fönster fungerar som <link linkend=\"gimp-selection-by_color\">Markera "
"efter färg</link>. Se exemplet nedan."

#: src/menus/select/dialog.xml:160(phrase)
msgid "Example of clicking in the <placeholder-1/> display window"
msgstr "Exempel på att klicka i visningsfönstret <placeholder-1/>"

#: src/menus/select/dialog.xml:170(para)
msgid ""
"Clicking in the <quote>Selection Editor</quote> display window to "
"<quote>Select By Color</quote>. Note that this figure could just as well "
"show the appearance of the <quote>Selection Editor</quote> display window "
"when <quote>Select By Color</quote> is used in the image window."
msgstr ""
"Ett klick i visningsfönstret <quote>Markeringsredigerare</quote> för att "
"<quote>markera efter färg</quote>. Observera att bilden lika gärna kunde "
"visa visningsfönstret <quote>Markeringsredigerare</quote> när <quote>"
"Markera efter färg</quote> används i bildfönstret."

#: src/menus/select/dialog.xml:185(quote)
msgid "Selection to Path Advanced Settings"
msgstr "Avancerade inställningar för markering till bana"

#: src/menus/select/dialog.xml:190(secondary)
msgid "Selection to Path"
msgstr "Markering till slinga"

#: src/menus/select/dialog.xml:191(tertiary)
msgid "Advanced options"
msgstr "Avancerade alternativ"

#: src/menus/select/dialog.xml:196(quote)
msgid "Advanced Settings"
msgstr "Avancerade inställningar"

#: src/menus/select/dialog.xml:205(para)
msgid ""
"The <quote>Selection to Path Advanced Settings</quote> dialog, that you get "
"by <keycap>Shift</keycap> clicking on the <guibutton> Selection to Path</"
"guibutton> button, contains a number of options, most of which you can set "
"with either a slider bar or a text box. There is also one check box. These "
"options are mostly used by advanced users. They are:"
msgstr ""
"Dialogrutan <quote>Avancerade inställningar för markering till bana</quote>, "
"som du får genom att <keycap>Skift</keycap>-klicka på knappen <guibutton>Markering till bana</guibutton>, "
"innehåller ett antal alternativ. De flesta kan ställas in med antingen ett "
"skjutreglage eller en textruta. Det finns även en kryssruta. Alternativen "
"används främst av avancerade användare:"

#: src/menus/select/dialog.xml:215(para)
msgid ""
"<emphasis>Align Threshold</emphasis>: If two endpoints are closer than this "
"value, they are made to be equal."
msgstr "<emphasis>Justeringsgräns</emphasis>: Om två ändpunkter ligger närmare varandra än detta värde görs de lika."

#: src/menus/select/dialog.xml:221(para)
msgid ""
"<emphasis>Corner Always Threshold</emphasis>: If the angle defined by a "
"point and its predecessors and successors is smaller than this, it is a "
"corner, even if it is within <emphasis>Corner Surround</emphasis> pixels of "
"a point with a smaller angle."
msgstr "<emphasis>Alltid hörn-gräns</emphasis>: Om vinkeln som definieras av en punkt och dess föregångare och efterföljare är mindre än detta är den ett hörn, även om den ligger inom <emphasis>Hörnomgivning</emphasis> bildpunkter från en punkt med mindre vinkel."

#: src/menus/select/dialog.xml:229(para)
msgid ""
"<emphasis>Corner Surround</emphasis>: Number of points to consider when "
"determining if a point is a corner or not."
msgstr "<emphasis>Hörnomgivning</emphasis>: Antal punkter att överväga när det avgörs om en punkt är ett hörn eller inte."

#: src/menus/select/dialog.xml:235(para)
msgid ""
"<emphasis>Corner Threshold</emphasis>: If a point, its predecessors, and its "
"successors define an angle smaller than this, it is a corner."
msgstr "<emphasis>Hörngräns</emphasis>: Om en punkt samt dess föregångare och efterföljare definierar en vinkel som är mindre än detta är den ett hörn."

#: src/menus/select/dialog.xml:243(para)
msgid ""
"<quote>Spline</quote> is a mathematical term for a function which defines a "
"curve by using a series of control points, such as a Bézier curve. "
"<placeholder-1/> See Wikipedia for more information."
msgstr "<quote>Spline</quote> är en matematisk term för en funktion som definierar en kurva med hjälp av en serie kontrollpunkter, till exempel en Bézierkurva. <placeholder-1/> Se Wikipedia för mer information."

#: src/menus/select/dialog.xml:241(para)
msgid ""
"<emphasis>Error Threshold</emphasis>: Amount of error at which a fitted "
"spline <placeholder-1/> is unacceptable. If any pixel is further away than "
"this from the fitted curve, the algorithm tries again."
msgstr "<emphasis>Felgräns</emphasis>: Mängden fel då en anpassad spline <placeholder-1/> inte är godtagbar. Om någon bildpunkt ligger längre bort än detta från den anpassade kurvan försöker algoritmen igen."

#: src/menus/select/dialog.xml:254(para)
msgid ""
"<emphasis>Filter Alternative Surround</emphasis>: A second number of "
"adjacent points to consider when filtering."
msgstr "<emphasis>Alternativ filteromgivning</emphasis>: Ett andra antal intilliggande punkter att beakta vid filtrering."

#: src/menus/select/dialog.xml:260(para)
msgid ""
"<emphasis>Filter Epsilon</emphasis>: If the angles between the vectors "
"produced by <emphasis>Filter Surround</emphasis> and <emphasis>Filter "
"Alternative Surround</emphasis> points differ by more than this, use the one "
"from <emphasis>Filter Alternative Surround</emphasis>."
msgstr "<emphasis>Filterepsilon</emphasis>: Om vinklarna mellan de vektorer som skapas av punkter i <emphasis>Filteromgivning</emphasis> och <emphasis>Alternativ filteromgivning</emphasis> skiljer sig mer än detta används den från <emphasis>Alternativ filteromgivning</emphasis>."

#: src/menus/select/dialog.xml:269(para)
msgid ""
"<emphasis>Filter Iteration Count</emphasis>: The number of times to smooth "
"the original data points. Increasing this number dramatically, to 50 or so, "
"can produce vastly better results. But if any points that <quote>should</"
"quote> be corners aren't found, the curve goes wild around that point."
msgstr "<emphasis>Antal filteriterationer</emphasis>: Antalet gånger som de ursprungliga datapunkterna ska jämnas ut. En kraftig ökning av detta tal, till ungefär 50, kan ge mycket bättre resultat. Men om punkter som <quote>borde</quote> vara hörn inte hittas blir kurvan vild runt den punkten."

#: src/menus/select/dialog.xml:278(para)
msgid ""
"<emphasis>Filter Percent</emphasis>: To produce the new point, use the old "
"point plus this times the neighbors."
msgstr "<emphasis>Filterprocent</emphasis>: För att skapa den nya punkten används den gamla punkten plus detta gånger grannpunkterna."

#: src/menus/select/dialog.xml:283(para)
msgid ""
"<emphasis>Filter Secondary Surround</emphasis>: Number of adjacent points to "
"consider if <emphasis>Filter Surround</emphasis> points defines a straight "
"line."
msgstr "<emphasis>Sekundär filteromgivning</emphasis>: Antal intilliggande punkter att beakta om punkter i <emphasis>Filteromgivning</emphasis> definierar en rak linje."

#: src/menus/select/dialog.xml:290(para)
msgid ""
"<emphasis>Filter Surround</emphasis>: Number of adjacent points to consider "
"when filtering."
msgstr "<emphasis>Filteromgivning</emphasis>: Antal intilliggande punkter att beakta vid filtrering."

#: src/menus/select/dialog.xml:295(para)
msgid ""
"<emphasis>Keep Knees</emphasis>: This check box says whether or not to "
"remove <quote>knee</quote> points after finding the outline."
msgstr "<emphasis>Behåll knän</emphasis>: Denna kryssruta anger om <quote>knäpunkter</quote> ska tas bort efter att konturen har hittats."

#: src/menus/select/dialog.xml:301(para)
msgid ""
"<emphasis>Line Reversion Threshold</emphasis>: If a spline is closer to a "
"straight line than this value, it remains a straight line, even if it would "
"otherwise be changed back to a curve. This is weighted by the square of the "
"curve length, to make shorter curves more likely to be reverted."
msgstr "<emphasis>Gräns för återställning till linje</emphasis>: Om en spline ligger närmare en rak linje än detta värde förblir den en rak linje, även om den annars skulle ändras tillbaka till en kurva. Detta viktas med kvadraten på kurvlängden för att kortare kurvor ska återställas oftare."

#: src/menus/select/dialog.xml:310(para)
msgid ""
"<emphasis>Line Threshold</emphasis>: How many pixels (on the average) a "
"spline can diverge from the line determined by its endpoints before it is "
"changed to a straight line."
msgstr "<emphasis>Linjegräns</emphasis>: Hur många bildpunkter en spline i genomsnitt får avvika från linjen som definieras av ändpunkterna innan den ändras till en rak linje."

#: src/menus/select/dialog.xml:317(para)
msgid ""
"<emphasis>Reparametrize Improvement</emphasis>: If reparameterization "
"doesn't improve the fit by this much percent, the algorithm stops doing it."
msgstr "<emphasis>Förbättring vid omparametrisering</emphasis>: Om omparametriseringen inte förbättrar anpassningen med så här många procent slutar algoritmen med den."

#: src/menus/select/dialog.xml:323(para)
msgid ""
"<emphasis>Reparametrize Threshold</emphasis>: Amount of error at which it is "
"pointless to reparameterize. This happens, for example, when the algorithm "
"is trying to fit the outline of the outside of an <quote>O</quote> with a "
"single spline. The initial fit is not good enough for the Newton-Raphson "
"iteration to improve it. It may be that it would be better to detect the "
"cases where the algorithm didn't find any corners."
msgstr "<emphasis>Gräns för omparametrisering</emphasis>: Mängden fel då det är meningslöst att omparametrisera. Detta händer till exempel när algoritmen försöker anpassa konturen på utsidan av ett <quote>O</quote> med en enda spline. Den första anpassningen är inte tillräckligt bra för att Newton–Raphson-iterationen ska förbättra den. Det kan vara bättre att upptäcka de fall där algoritmen inte hittade några hörn."

#: src/menus/select/dialog.xml:333(para)
msgid ""
"<emphasis>Subdivide Search</emphasis>: Percentage of the curve away from the "
"worst point to look for a better place to subdivide."
msgstr "<emphasis>Sökning efter delning</emphasis>: Den procentandel av kurvan bort från den sämsta punkten där en bättre plats för delning söks."

#: src/menus/select/dialog.xml:339(para)
msgid ""
"<emphasis>Subdivide Surround</emphasis>: Number of points to consider when "
"deciding whether a given point is a better place to subdivide."
msgstr "<emphasis>Delningsomgivning</emphasis>: Antal punkter att beakta när det avgörs om en given punkt är en bättre plats för delning."

#: src/menus/select/dialog.xml:345(para)
msgid ""
"<emphasis>Subdivide Threshold</emphasis>: How many pixels a point can "
"diverge from a straight line and still be considered a better place to "
"subdivide."
msgstr "<emphasis>Delningsgräns</emphasis>: Hur många bildpunkter en punkt kan avvika från en rak linje och ändå anses vara en bättre plats för delning."

#: src/menus/select/dialog.xml:352(para)
msgid ""
"<emphasis>Tangent Surround</emphasis>: Number of points to look at on either "
"side of a point when computing the approximation to the tangent at that "
"point."
msgstr "<emphasis>Tangentomgivning</emphasis>: Antal punkter på vardera sidan om en punkt som ska beaktas när approximationen av tangenten vid punkten beräknas."

#: src/menus/select/by_color.xml:20(phrase)
msgid "By Color"
msgstr "Efter färg"

#: src/menus/select/by_color.xml:24(secondary)
msgid "By Color select"
msgstr "Markera efter färg"

#: src/menus/select/by_color.xml:26(para)
msgid ""
"The <guimenuitem>Select By Color</guimenuitem> command is an alternate way "
"of accessing the <quote>Select By Color</quote> tool, one of the basic "
"selection tools. You can find more information about using this tool in "
"<link linkend=\"gimp-tool-by-color-select\">Select By Color</link>."
msgstr ""
"Kommandot <guimenuitem>Markera efter färg</guimenuitem> är ett annat sätt "
"att komma åt verktyget <quote>Markera efter färg</quote>, ett av de "
"grundläggande markeringsverktygen. Mer information om verktyget finns i "
"<link linkend=\"gimp-tool-by-color-select\">Markera efter färg</link>."

#: src/menus/select/by_color.xml:38(para)
msgid ""
"You can access this command from the image menubar through "
"<menuchoice><guimenu>Select</guimenu><guimenuitem>By Color</guimenuitem></"
"menuchoice>,"
msgstr ""
"Du kommer åt kommandot från bildens menyrad via <menuchoice><guimenu>"
"Markera</guimenu><guimenuitem>Efter färg</guimenuitem></menuchoice>,"

#: src/menus/select/by_color.xml:44(para)
msgid ""
"or by using the keyboard shortcut <keycombo><keycap>Shift</keycap><keycap>O</"
"keycap></keycombo>."
msgstr ""
"eller med tangentbordsgenvägen <keycombo><keycap>Skift</keycap><keycap>O</keycap></keycombo>."

