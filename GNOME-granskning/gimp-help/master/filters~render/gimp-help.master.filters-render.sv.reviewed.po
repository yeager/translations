"guimenu><guisubmenu>Render</guisubmenu><guisubmenu>Pattern</"
"guisubmenu><guimenuitem>Spiral…</guimenuitem></menuchoice>."
msgstr ""
"Detta filter finns i huvudmenyn under <menuchoice><guimenu>Filter</"
"guimenu><guisubmenu>Rendera</guisubmenu><guisubmenu>Mönster</"
"guisubmenu><guimenuitem>Spiral…</guimenuitem></menuchoice>."

