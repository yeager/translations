msgstr "Ny"

#: src/menus/file/new.xml:23(primary)
msgid "New Image"
msgstr "Ny bild"

#: src/menus/file/new.xml:27(para)
msgid ""
"Using the <quote>Create a New Image</quote> dialog, you can create a new "
"empty image and set its properties. The image is shown in a new image "
"window. You may have more than one image on your screen at the same time."
msgstr ""
"Med dialogrutan <quote>Skapa en ny bild</quote> kan du skapa en ny tom bild "
"och ange dess egenskaper. Bilden visas i ett nytt bildfönster. Du kan ha "
"flera bilder på skärmen samtidigt."

#: src/menus/file/new.xml:38(para)
#| msgid ""
#| "You can access this command from the image menubar through "
#| "<menuchoice><guimenu>File</guimenu><guimenuitem>New…</guimenuitem></menuchoice>,"
msgid ""
"You can access this command from the main menu through "
"<menuchoice><guimenu>File</guimenu><guimenuitem>New…</guimenuitem></menuchoice>."
msgstr ""
"Du hittar kommandot i huvudmenyn via "
"<menuchoice><guimenu>Arkiv</guimenu><guimenuitem>Ny…</guimenuitem></menuchoice>."

#: src/menus/file/new.xml:47(para)
#| msgid ""
#| "or by using the keyboard shortcut "
#| "<keycombo><keycap>Ctrl</keycap><keycap>N</keycap></keycombo>."
