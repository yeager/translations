#: src/toolbox/zoom.xml:18(title) src/toolbox/zoom.xml:21(secondary)
#: src/toolbox/zoom.xml:24(primary)
msgid "Zoom"
msgstr "Zooma"

#: src/toolbox/zoom.xml:20(primary)
#: src/toolbox/transform-tools.xml:14(primary)
