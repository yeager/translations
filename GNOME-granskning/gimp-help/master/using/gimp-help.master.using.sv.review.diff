 #: src/using/layers.xml:33(para)
 msgid ""
-"Selecting <menuchoice><guimenu>Layer</guimenu><guimenuitem>Duplicate Layers</"
-"guimenuitem></menuchoice> in the main menu. This creates a new layer, that "
-"is a perfect copy of the currently active layer, just above the active layer."
-msgstr ""
-"Välja <menuchoice><guimenu>Lager</guimenu><guimenuitem>Duplicera lager</"
-"guimenuitem></menuchoice> i huvudmenyn. Detta skapar ett nytt lager som är "
-"en perfekt kopia av det för närvarande aktiva lagret, direkt ovanför det "
-"aktiva lagret."
+"Selecting <menuchoice><guimenu>Layer</guimenu><guimenuitem>Duplicate "
+"Layers</guimenuitem></menuchoice> in the main menu. This creates a new "
+"layer, that is a perfect copy of the currently active layer, just above the "
+"active layer."
+msgstr ""
+"Välj <menuchoice><guimenu>Lager</guimenu><guimenuitem>Duplicera "
+"lager</guimenuitem></menuchoice> i huvudmenyn. Då skapas ett nytt lager "
+"direkt ovanför det aktiva lagret, som en exakt kopia."
 
 #: src/using/layers.xml:44(para)
 msgid ""
