#: src/menus/colors/max_rgb.xml:27(secondary)
#: src/menus/colors/max_rgb.xml:30(primary)
#: src/menus/colors/max_rgb.xml:39(quote)
#: src/menus/colors/max_rgb.xml:83(quote)
msgid "Max RGB"
msgstr "Max RGB"

#: src/menus/colors/max_rgb.xml:38(phrase)
msgid "Example for the filter <placeholder-1/>"
msgstr "Exempel på filtret <placeholder-1/>"

#: src/menus/colors/max_rgb.xml:55(para)
msgid "Filter <quote>Max RGB</quote> applied"
msgstr "Filtret <quote>Max RGB</quote> tillämpat"

#: src/menus/colors/max_rgb.xml:59(para)
msgid ""
"For every pixel of the image, this filter holds the channel with the maximal/"
"minimal intensity. The result is an image with only three colors, red, green "
"and blue, and possibly pure gray."
msgstr ""
"För varje bildpunkt behåller filtret kanalen med högsta respektive lägsta "
"intensitet. Resultatet är en bild med bara tre färger – rött, grönt och blått "
"– och möjligen rent grått."

#: src/menus/colors/max_rgb.xml:69(para)
msgid ""
"This filter is found in the image window menu under "
"<menuchoice><guimenu>Colors</guimenu><guimenuitem>Max RGB</guimenuitem></"
"menuchoice>."
msgstr ""
"Filtret finns i bildfönstrets meny under "
"<menuchoice><guimenu>Färger</guimenu><guimenuitem>Max RGB</guimenuitem>"
"</menuchoice>."

#: src/menus/colors/max_rgb.xml:83(phrase)
msgid "<placeholder-1/> options"
msgstr "Alternativ för <placeholder-1/>"

#: src/menus/colors/max_rgb.xml:93(term)
msgid "Preview"
msgstr "Förhandsvisning"

#: src/menus/colors/max_rgb.xml:95(para)
msgid ""
"This preview displays, in real time, the resulting image after treatment by "
"filter."
msgstr "Förhandsvisningen visar i realtid bilden efter att den har behandlats av filtret."

#: src/menus/colors/max_rgb.xml:102(term)
msgid "Parameter Settings"
msgstr "Parameterinställningar"

#: src/menus/colors/max_rgb.xml:104(para)
msgid ""
"<guilabel>Hold the maximal channels</guilabel>: For every pixel, the filter "
"keeps intensity of the RGB color channel which has the maximal intensity and "
"reduces other both to zero. For example: 220, 158, 175 max--&gt; 220, 0, 0. "
"If two channels have same intensity, both are held: 210, 54, 210 max--&gt; "
"210, 0, 210."
msgstr ""
"<guilabel>Behåll kanaler med högsta värde</guilabel>: För varje bildpunkt "
"behåller filtret intensiteten i den RGB-färgkanal som har högst intensitet "
"och sätter de två andra till noll. Exempel: 220, 158, 175 max--&gt; 220, 0, 0. "
"Om två kanaler har samma intensitet behålls båda: 210, 54, 210 max--&gt; 210, 0, 210."

#: src/menus/colors/max_rgb.xml:110(para)
msgid ""
"<guilabel>Hold the minimal channels</guilabel>: For every pixel, the filter "
"keeps intensity of the RGB color channel which has the minimal intensity and "
"reduce both others to zero. For example: 220, 158, 175 min--&gt; 0, 158, 0. "
"If two minimal channels have same intensity, both are held: 210, 54, 54 min--"
"&gt; 0, 54, 54."
msgstr ""
"<guilabel>Behåll kanaler med lägsta värde</guilabel>: För varje bildpunkt "
"behåller filtret intensiteten i den RGB-färgkanal som har lägst intensitet "
"och sätter de två andra till noll. Exempel: 220, 158, 175 min--&gt; 0, 158, 0. "
"Om två kanaler har samma lägsta intensitet behålls båda: 210, 54, 54 min--&gt; 0, 54, 54."

#: src/menus/colors/max_rgb.xml:117(para)
msgid ""
"Grey levels are not changed since light intensity is the same in all three "
"channels."
msgstr "Gråtoner ändras inte eftersom ljusintensiteten är densamma i alla tre kanaler."

