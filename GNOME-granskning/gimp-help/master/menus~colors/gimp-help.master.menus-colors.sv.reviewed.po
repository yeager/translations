"<menuchoice><guimenu>Colors</guimenu><guimenuitem>Invert</guimenuitem></"
"menuchoice>."
msgstr ""
"Du kommer åt kommandot från bildens menyrad via "
"<menuchoice><guimenu>Färger</guimenu><guimenuitem>Invertera</guimenuitem>"
"</menuchoice>."

