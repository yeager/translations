 msgid "Flip Segment"
-msgstr ""
+msgstr "Vänd segment"
 
 #: src/dialogs/gradient-editor-dialog.xml:501(para)
 msgid ""
 "This option does a right-to-left flip of the selected range (segment or "
 "selection), flipping all colors and endpoint locations."
 msgstr ""
+"Alternativet vänder det valda intervallet, segmentet eller markeringen, från "
+"höger till vänster och vänder alla färger och ändpunktspositioner."
 
 #: src/dialogs/gradient-editor-dialog.xml:509(term)
 msgid "Replicate Segment"
-msgstr ""
+msgstr "Duplicera segment"
 
