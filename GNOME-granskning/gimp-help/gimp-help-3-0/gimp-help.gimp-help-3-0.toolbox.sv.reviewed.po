msgstr "Det resulterande histogrammet (nedan) visar nu högdagrar, men skuggorna dominerar fortfarande."

#: src/toolbox/tool-levels.xml:504(title)
msgid "Setting the balance between Shadows and Highlights"
msgstr "Ställa in balansen mellan skuggor och högdagrar"

#: src/toolbox/tool-levels.xml:510(para)
