#. /wireplumber.settings.schema/stream.default-capture-volume/name
#: wireplumber.conf
msgid "Default capture volume"
msgstr "Standardvolym för inspelningsströmmar"

#. /wireplumber.settings.schema/stream.default-media-role/description
#: wireplumber.conf
msgid "Default media.role to assign on streams that do not specify it"
msgstr "Standardvärde för media.role för strömmar som inte anger någon roll"

#. /wireplumber.settings.schema/stream.default-media-role/name
#: wireplumber.conf
msgid "Default media role"
msgstr "Standardroll för media"

#. /wireplumber.settings.schema/stream.default-playback-volume/description
#: wireplumber.conf
#| msgid "The default volume for playback nodes"
