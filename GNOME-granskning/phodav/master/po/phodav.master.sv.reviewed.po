#: bin/chezdav.c:142
msgid "--tls-cert contains no private key, pass it with --tls-key\n"
msgstr "--tls-cert innehåller ingen privat nyckel, ange den med --tls-key\n"

#: bin/chezdav.c:179
msgid "Print program version"
msgstr "Visa programmets version"

#: bin/chezdav.c:180
msgid "Be verbose"
msgstr "Var utförlig"

#: bin/chezdav.c:181
msgid "Unix socket to listen on"
msgstr "Unix-uttag att lyssna på"

#: bin/chezdav.c:182
msgid "Port to listen to"
msgstr "Port att lyssna på"

#: bin/chezdav.c:183
msgid "Listen on loopback only"
msgstr "Lyssna endast på loopback"

#: bin/chezdav.c:184
msgid "Listen on all interfaces"
msgstr "Lyssna på alla gränssnitt"

#: bin/chezdav.c:185
msgid "Path to export"
msgstr "Sökväg att exportera"

#: bin/chezdav.c:186
msgid "Path to htdigest file"
msgstr "Sökväg till htdigest-filen"

#: bin/chezdav.c:187
msgid "DIGEST realm"
msgstr "DIGEST-domän"

#: bin/chezdav.c:188
msgid "Read-only access"
msgstr "Skrivskyddad åtkomst"

#: bin/chezdav.c:189
msgid "Refuse uploads over SIZE bytes (0 for no limit)"
msgstr "Neka uppladdningar större än SIZE byte (0 för ingen gräns)"

#: bin/chezdav.c:189
msgid "SIZE"
msgstr "STORLEK"

#: bin/chezdav.c:190
msgid ""
"Serve HTTPS, with the TLS certificate in CERT (which must include the "
"private key, unless --tls-key is given)"
msgstr ""
"Tillhandahåll HTTPS med TLS-certifikatet i CERT (som måste innehålla den "
"privata nyckeln om inte --tls-key anges)"

#: bin/chezdav.c:190
msgid "CERT"
msgstr "CERT"

#: bin/chezdav.c:191
msgid "Path to the TLS private key, when it is not in the certificate file"
msgstr ""
"Sökväg till den privata TLS-nyckeln när den inte finns i certifikatfilen"

#: bin/chezdav.c:191
msgid "KEY"
msgstr "NYCKEL"

#: bin/chezdav.c:193
msgid "Skip mDNS service announcement"
msgstr "Hoppa över mDNS-tjänsteannonsering"

#: bin/chezdav.c:205
msgid "- simple WebDAV server"
msgstr "– enkel WebDAV-server"

#: bin/chezdav.c:206
#, c-format
msgid "Report bugs to <%s>"
msgstr "Rapportera fel till <%s>"

#: bin/chezdav.c:212
#, c-format
msgid "Option parsing failed: %s\n"
msgstr "Tolkning av flaggor misslyckades: %s\n"

#: bin/chezdav.c:219
#, c-format
msgid "Unsupported extra arguments: %s ...\n"
msgstr "Ytterligare argument som inte stöds: %s …\n"

#: bin/chezdav.c:228
msgid "--socket and --local are mutually exclusive\n"
msgstr "--socket och --local kan inte användas tillsammans\n"

#: bin/chezdav.c:230
msgid "--socket and --public are mutually exclusive\n"
msgstr "--socket och --public kan inte användas tillsammans\n"

#: bin/chezdav.c:232
msgid "--socket and --port are mutually exclusive\n"
msgstr "--socket och --port kan inte användas tillsammans\n"

#: bin/chezdav.c:234
msgid "--local and --public are mutually exclusive\n"
msgstr "--local och --public kan inte användas tillsammans\n"

#: bin/chezdav.c:237
msgid "--max-upload must not be negative\n"
msgstr "--max-upload får inte vara negativ\n"

#: bin/chezdav.c:240
msgid "--tls-key requires --tls-cert\n"
msgstr "--tls-key kräver --tls-cert\n"

#: bin/chezdav.c:280
#, c-format
msgid "Failed to load the certificate: %s\n"
msgstr "Kunde inte läsa in certifikatet: %s\n"

#: bin/chezdav.c:308
#, c-format
msgid "Failed to open htdigest: %s\n"
msgstr "Kunde inte öppna htdigest: %s\n"

#: bin/chezdav.c:322
#, c-format
msgid "mDNS failed: %s\n"
msgstr "mDNS misslyckades: %s\n"

#: bin/chezdav.c:345
#, c-format
msgid "Listen failed: %s\n"
msgstr "Kunde inte lyssna: %s\n"
