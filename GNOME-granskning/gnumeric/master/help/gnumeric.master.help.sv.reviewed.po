"=SUM(Sheet1!A1:A5)\n"
"        "
msgstr ""
"\n"
"='Sheet 0'!A1+'Sheet 3'!A5\n"
"\n"
"=SUM(Sheet1!A1:A5)\n"
"        "

#. (itstool) path: sect4/title
