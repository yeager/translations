+"\t# ”column” och ”row” tar referenser och returnerar en matris med kolumn- eller rad\n"
+"\t# nummer för varje cell i referensen. Exempel: [[1, 1, 1], [2, 2, 2]]\n"
+"\t# för kolumner och [[2, 3, 4], [2, 3, 4]] för rader.\n"
+"\n"
+"\ttry:\n"
+"\t\tcolumns = col(range_ref)\n"
+"\t\trows    = row(range_ref)\n"
+"\n"
+"\t\tbegin_col = columns[0][0] - 1  \n"
+"\t\tbegin_row = rows[0][0] - 1     \n"
+"\n"
+"\t\tend_col = columns[-1][-1]\n"
+"\t\tend_row = rows[-1][-1]\n"
+"\n"
+"\t\t# Vi drog bort 1 från startvärdena eftersom API:et\n"
+"\t\t# börjar indexeringen vid 0, medan ”column” och ”row” börjar vid 1.\n"
+"\t\t# Vi drog INTE bort 1 från slutvärdena, så att de passar\n"
+"\t\t# Pythons range(begin, end)-konvention.\n"
+"\t\t\n"
+"\texcept TypeError:\n"
+"\t\traise GnumericError,GnumericErrorVALUE\n"
+"\texcept NameError:                     # rätt namn?\n"
+"\t\traise GnumericError,Gnumeric.GnumericErrorNAME\n"
+"\texcept RefError:                     # rätt namn?\n"
+"\t\traise GnumericError,Gnumeric.GnumericErrorREF\n"
+"\texcept NumError:                     # rätt namn?\n"
+"\t\traise GnumericError,Gnumeric.GnumericErrorNUM\n"
+"\n"
+"\n"
+"\treturn [ (begin_col, begin_row), (end_col, end_row) ]\n"
+"\t\t"
 
