#: atk/atkobject.c:273
msgid "Accessible Name"
msgstr "Hjälpmedelsnamn"

#: atk/atkobject.c:280
msgid "Accessible Description"
msgstr "Hjälpmedelsbeskrivning"

#: atk/atkobject.c:287
msgid "Accessible Parent"
msgstr "Hjälpmedelsförälder"

#: atk/atkobject.c:288
msgid ""
"Parent of the current accessible as returned by atk_object_get_parent()"
msgstr ""
"Förälder till det aktuella hjälpmedelsobjektet, som returneras av "
"atk_object_get_parent()"

#: atk/atkobject.c:304
msgid "Accessible Value"
msgstr "Hjälpmedelsvärde"

#: atk/atkobject.c:313
msgid "Accessible Role"
msgstr "Hjälpmedelsroll"

#: atk/atkobject.c:314
msgid "The accessible role of this object"
msgstr "Hjälpmedelsrollen för det här objektet"

#: atk/atkobject.c:321
msgid "Accessible Layer"
msgstr "Hjälpmedelslager"

#: atk/atkobject.c:322
msgid "The accessible layer of this object"
msgstr "Hjälpmedelslagret för det här objektet"

#: atk/atkobject.c:330
msgid "Accessible MDI Value"
msgstr "Hjälpmedelsvärde för MDI"

#: atk/atkobject.c:331
msgid "The accessible MDI value of this object"
msgstr "Hjälpmedelsvärdet för MDI för det här objektet"

#: atk/atkobject.c:347
msgid "Accessible Table Caption"
msgstr "Bildtext för hjälpmedelstabellen"

#: atk/atkobject.c:348
msgid ""
"Is used to notify that the table caption has changed; this property should "
"not be used. accessible-table-caption-object should be used instead"
msgstr ""
"Används för att meddela att tabellens bildtext har ändrats. Använd inte den "
"här egenskapen; använd i stället accessible-table-caption-object"

#: atk/atkobject.c:362
msgid "Accessible Table Column Header"
msgstr "Kolumnrubrik i hjälpmedelstabellen"

#: atk/atkobject.c:378
msgid "Accessible Table Column Description"
msgstr "Kolumnbeskrivning i hjälpmedelstabellen"

#: atk/atkobject.c:394
msgid "Accessible Table Row Header"
msgstr "Radrubrik i hjälpmedelstabellen"

#: atk/atkobject.c:409
msgid "Accessible Table Row Description"
msgstr "Radbeskrivning i hjälpmedelstabellen"

#: atk/atkobject.c:416
msgid "Accessible Table Summary"
msgstr "Sammanfattning av hjälpmedelstabellen"

#: atk/atkobject.c:423
msgid "Accessible Table Caption Object"
msgstr "Objekt för bildtexten i hjälpmedelstabellen"

#: atk/atkobject.c:430
msgid "Number of Accessible Hypertext Links"
msgstr "Antal hypertextlänkar i hjälpmedelsobjektet"

#: atk/atkobject.c:440
msgid "Accessible ID"
msgstr "Hjälpmedels-ID"

#: atk/atkobject.c:441
msgid "ID for the accessible; useful for automated testing"
msgstr "ID för hjälpmedelsobjektet; användbart vid automatiserad testning"

#: atk/atkobject.c:448
msgid "Help text associated with the accessible"
msgstr "Hjälptext som hör till hjälpmedelsobjektet"
