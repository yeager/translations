msgid "Accessible MDI Value"
msgstr "Tillgängligt MDI-värde"

#: atk/atkobject.c:331
msgid "The accessible MDI value of this object"
msgstr "Det tillgängliga MDI-värdet för det här objektet"

#: atk/atkobject.c:347
msgid "Accessible Table Caption"
msgstr "Tillgänglig tabellrubrik"

#: atk/atkobject.c:348
msgid ""
"Is used to notify that the table caption has changed; this property should "
"not be used. accessible-table-caption-object should be used instead"
msgstr ""
"Används för att signalera att tabellrubriken har ändrats. Använd inte den "
"här egenskapen; använd i stället accessible-table-caption-object"

#: atk/atkobject.c:362
msgid "Accessible Table Column Header"
msgstr "Tillgänglig kolumnrubrik i tabellen"

#: atk/atkobject.c:363
msgid "Is used to notify that the table column header has changed"
msgstr "Används för att signalera att kolumnrubriken i tabellen har ändrats"

#: atk/atkobject.c:378
msgid "Accessible Table Column Description"
msgstr "Tillgänglig kolumnbeskrivning i tabellen"

#: atk/atkobject.c:379
msgid "Is used to notify that the table column description has changed"
msgstr ""
"Används för att signalera att kolumnbeskrivningen i tabellen har ändrats"

#: atk/atkobject.c:394
msgid "Accessible Table Row Header"
msgstr "Tillgänglig radrubrik i tabellen"

#: atk/atkobject.c:395
msgid "Is used to notify that the table row header has changed"
msgstr "Används för att signalera att radrubriken i tabellen har ändrats"

#: atk/atkobject.c:409
msgid "Accessible Table Row Description"
msgstr "Tillgänglig radbeskrivning i tabellen"

#: atk/atkobject.c:410
msgid "Is used to notify that the table row description has changed"
msgstr "Används för att signalera att radbeskrivningen i tabellen har ändrats"

#: atk/atkobject.c:416
msgid "Accessible Table Summary"
msgstr "Tillgänglig tabellsammanfattning"

#: atk/atkobject.c:417
msgid "Is used to notify that the table summary has changed"
msgstr "Används för att signalera att tabellsammanfattningen har ändrats"

#: atk/atkobject.c:423
msgid "Accessible Table Caption Object"
msgstr "Objekt för tillgänglig tabellrubrik"

#: atk/atkobject.c:424
msgid "Is used to notify that the table caption has changed"
msgstr "Används för att meddela att tabellrubriken har ändrats"

