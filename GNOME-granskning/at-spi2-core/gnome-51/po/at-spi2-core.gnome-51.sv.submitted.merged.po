#: atk/atkobject.c:273
msgid "Accessible Name"
msgstr "Tillgängligt namn"

#: atk/atkobject.c:274
msgid "Object instance’s name formatted for assistive technology access"
msgstr "Objektinstansens namn, formaterat för användning med hjälpmedel"

#: atk/atkobject.c:280
msgid "Accessible Description"
msgstr "Tillgänglig beskrivning"

#: atk/atkobject.c:281
msgid "Description of an object, formatted for assistive technology access"
msgstr "Beskrivning av objektet, formaterad för användning med hjälpmedel"

#: atk/atkobject.c:287
msgid "Accessible Parent"
msgstr "Tillgängligt föräldraobjekt"

#: atk/atkobject.c:288
msgid "Parent of the current accessible as returned by atk_object_get_parent()"
msgstr ""
"Föräldern till det aktuella tillgängliga objektet, som returneras av "
"atk_object_get_parent()"

#: atk/atkobject.c:304
msgid "Accessible Value"
msgstr "Tillgängligt värde"

#: atk/atkobject.c:305
msgid "Is used to notify that the value has changed"
msgstr "Används för att signalera att värdet har ändrats"

#: atk/atkobject.c:313
msgid "Accessible Role"
msgstr "Tillgänglig roll"

#: atk/atkobject.c:314
msgid "The accessible role of this object"
msgstr "Tillgänglighetsrollen för det här objektet"

#: atk/atkobject.c:321
msgid "Accessible Layer"
msgstr "Tillgängligt lager"

#: atk/atkobject.c:322
msgid "The accessible layer of this object"
msgstr "Tillgänglighetslagret för det här objektet"

