#: proxy/libproxy/glibproxyresolver.c:165
msgid "Proxy resolver internal error."
msgstr "Internt fel i proxylösaren."

#: tls/base/gtlsconnection-base.c:734 tls/base/gtlsinputstream.c:78
#: tls/base/gtlsinputstream.c:141 tls/base/gtlsoutputstream.c:78
#: tls/base/gtlsoutputstream.c:143
msgid "Connection is closed"
msgstr "Anslutningen är stängd"

#. Cannot perform a blocking operation during a handshake on the
#. * same thread that triggered the handshake. The only way this can
#. * occur is if the application is doing something weird in its
#. * accept-certificate callback. Allowing a blocking op would stall
#. * the handshake (forever, if there's no timeout). Even a close
#. * op would deadlock here.
#.
#: tls/base/gtlsconnection-base.c:808
msgid "Cannot perform blocking operation during TLS handshake"
msgstr "Kan inte utföra en blockerande åtgärd under TLS-handskakningen"

#: tls/base/gtlsconnection-base.c:873 tls/base/gtlsconnection-base.c:1419
#: tls/openssl/gtlsconnection-openssl.c:380
msgid "Socket I/O timed out"
msgstr "Tidsgränsen överskreds vid in-/utmatning via uttaget"

#: tls/base/gtlsconnection-base.c:1045
msgid "Server required TLS certificate"
msgstr "Servern krävde ett TLS-certifikat"

#: tls/base/gtlsconnection-base.c:1621
#, c-format
msgid "Handshake is not finished, no channel binding information yet"
msgstr "Handskakningen är inte klar ännu, så kanalbindningsinformation saknas"

#: tls/base/gtlsconnection-base.c:1822 tls/gnutls/gtlsconnection-gnutls.c:484
#: tls/openssl/gtlsconnection-openssl.c:185
#: tls/openssl/gtlsconnection-openssl.c:816
msgid "Unacceptable TLS certificate"
msgstr "TLS-certifikatet godtas inte"

#: tls/base/gtlsconnection-base.c:2298
#, c-format
msgid "Receive flags are not supported"
msgstr "Flaggor för mottagning stöds inte"

#: tls/base/gtlsconnection-base.c:2439
#, c-format
msgid "Send flags are not supported"
msgstr "Flaggor för sändning stöds inte"

