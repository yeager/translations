msgid "Proxy resolver internal error."
msgstr "Internt fel i proxylösaren."

msgid "Connection is closed"
msgstr "Anslutningen är stängd"

#. Cannot perform a blocking operation during a handshake on the
#. * same thread that triggered the handshake. The only way this can
#. * occur is if the application is doing something weird in its
#. * accept-certificate callback. Allowing a blocking op would stall
#. * the handshake (forever, if there's no timeout). Even a close
#. * op would deadlock here.
msgid "Cannot perform blocking operation during TLS handshake"
msgstr "Kan inte utföra en blockerande åtgärd under TLS-handskakningen"

msgid "Socket I/O timed out"
msgstr "Tidsgränsen överskreds vid in-/utmatning via uttaget"

msgid "Server required TLS certificate"
msgstr "Servern krävde ett TLS-certifikat"

#, c-format
msgid "Handshake is not finished, no channel binding information yet"
msgstr "Handskakningen är inte klar ännu, så kanalbindningsinformation saknas"

msgid "Unacceptable TLS certificate"
msgstr "TLS-certifikatet godtas inte"

#, c-format
msgid "Receive flags are not supported"
msgstr "Flaggor för mottagning stöds inte"

#, c-format
msgid "Send flags are not supported"
msgstr "Flaggor för sändning stöds inte"

#, c-format
msgid "Failed to import PKCS #12: %s"
msgstr "Det gick inte att importera PKCS #12: %s"

#, c-format
msgid "Could not parse DER certificate: %s"
msgstr "Det gick inte att tolka DER-certifikatet: %s"

#, c-format
msgid "Could not parse PEM certificate: %s"
msgstr "Det gick inte att tolka PEM-certifikatet: %s"

#, c-format
msgid "Could not parse DER private key: %s"
msgstr "Det gick inte att tolka den privata nyckeln i DER-format: %s"

#, c-format
msgid "Could not parse PEM private key: %s"
msgstr "Det gick inte att tolka den privata nyckeln i PEM-format: %s"

#, c-format
msgid "Could not import PKCS #11 certificate URI: %s"
msgstr "Det gick inte att importera certifikat-URI:n för PKCS #11: %s"

msgid "No certificate data provided"
msgstr "Inga certifikatdata angavs"

#, c-format
msgid "Cannot verify peer identity of unexpected type %s"
msgstr "Kan inte verifiera motpartsidentitet av den oväntade typen %s"

msgid "Could not create TLS connection:"
msgstr "Det gick inte att upprätta TLS-anslutningen:"

#, c-format
msgid "Could not create TLS connection: %s"
msgstr "Det gick inte att upprätta TLS-anslutningen: %s"

#, c-format
msgid "Peer failed to perform TLS handshake: %s"
msgstr "Motparten kunde inte utföra TLS-handskakningen: %s"

msgid "TLS connection closed unexpectedly"
msgstr "TLS-anslutningen stängdes oväntat"

msgid "TLS connection peer did not send a certificate"
msgstr "Motparten i TLS-anslutningen skickade inget certifikat"

#, c-format
msgid "Peer sent fatal TLS alert: %s"
msgstr "Motparten skickade en kritisk TLS-varning: %s"

msgid "Protocol version downgrade attack detected"
msgstr "Attack med nedgradering av protokollversion upptäcktes"

#, c-format
msgid "Message is too large for DTLS connection; maximum is %u byte"
msgid_plural "Message is too large for DTLS connection; maximum is %u bytes"
msgstr[0] ""
"Meddelandet är för stort för DTLS-anslutningen; högsta storlek är %u byte"
msgstr[1] ""
"Meddelandet är för stort för DTLS-anslutningen; högsta storlek är %u byte"

msgid "The operation timed out"
msgstr "Tidsgränsen för åtgärden överskreds"

msgid "Error performing TLS handshake"
msgstr "Fel vid TLS-handskakning"

#, c-format
msgid ""
"Empty channel binding data indicates a bug in the TLS library implementation"
msgstr ""
"Avsaknad av kanalbindningsdata tyder på ett fel i TLS-bibliotekets "
"implementation"

#, c-format
msgid "Channel binding type is not implemented in the TLS library"
msgstr "Kanalbindningstypen har inte implementerats i TLS-biblioteket"

#, c-format
msgid "Channel binding data is not yet available"
msgstr "Kanalbindningsdata är ännu inte tillgängliga"

#, c-format
msgid "Requested channel binding type is not implemented"
msgstr "Den begärda typen av kanalbindning har inte implementerats"

msgid "Error reading data from TLS socket"
msgstr "Fel vid läsning från TLS-uttaget"

#. flags
msgid "Error writing data to TLS socket"
msgstr "Fel vid skrivning till TLS-uttaget"

#, c-format
msgid "Message of size %lu byte is too large for DTLS connection"
msgid_plural "Message of size %lu bytes is too large for DTLS connection"
msgstr[0] "Meddelandet på %lu byte är för stort för DTLS-anslutningen"
msgstr[1] "Meddelandet på %lu byte är för stort för DTLS-anslutningen"

#, c-format
msgid "(maximum is %u byte)"
msgid_plural "(maximum is %u bytes)"
msgstr[0] "(högsta storlek är %u byte)"
msgstr[1] "(högsta storlek är %u byte)"

#, c-format
msgid "Error performing TLS close: %s"
msgstr "Fel när TLS-anslutningen skulle stängas: %s"

#, c-format
msgid "Failed to allocate credentials: %s"
msgstr "Det gick inte att allokera autentiseringsuppgifterna: %s"

# osäker
msgid ""
"Failed to load system trust store: GnuTLS was not configured with a system "
"trust"
msgstr ""
"Det gick inte att läsa in systemets certifikatarkiv: GnuTLS har inte "
"konfigurerats med systemets betrodda certifikat"

# osäker
#, c-format
msgid "Failed to load system trust store: %s"
msgstr "Det gick inte att läsa in systemets certifikatarkiv: %s"

# osäker
#, c-format
msgid ""
"System trust contains zero trusted certificates; please investigate your "
"GnuTLS configuration"
msgstr ""
"Systemets certifikatarkiv innehåller inga betrodda certifikat. Kontrollera "
"GnuTLS-konfigurationen"

# trust list är ett kommando
#, c-format
msgid "Failed to initialize trust list: %s"
msgstr "Det gick inte att initiera den betrodda certifikatlistan: %s"

# trust list är ett kommando
#, c-format
msgid "Failed to populate trust list from %s: %s"
msgstr "Det gick inte att fylla den betrodda certifikatlistan från %s: %s"

msgid "Certificate has no private key"
msgstr "Certifikatet saknar en privat nyckel"

#, c-format
msgid "Could not set TLS cipher list: %s"
msgstr "Kunde inte ställa in TLS-chifferlistan: %s"

#, c-format
msgid "Could not set MAX protocol to %d: %s"
msgstr "Kunde inte ange MAX-protokollet till %d: %s"

#, c-format
msgid "Could not create TLS session: %s"
msgstr "Kunde inte skapa TLS-session: %s"

#, c-format
msgid "Could not create TLS context: %s"
msgstr "Kunde inte skapa TLS-kontext: %s"

msgid "Unacceptable TLS certificate authority"
msgstr "TLS-certifikatutfärdaren godtas inte"

msgid "Digest too big for RSA key"
msgstr "Sammandraget är för stort för RSA-nyckeln"

#, c-format
msgid "%s: The connection is broken"
msgstr "%s: Anslutningen bröts"

msgid "The request is invalid."
msgstr "Begäran är ogiltig."

msgid "Channel binding data tls-unique is not available"
msgstr "Kanalbindningsdata för tls-unique är inte tillgängliga"

msgid "X.509 Certificate is not available on the connection"
msgstr "X.509-certifikatet saknas i anslutningen"

msgid "Unable to obtain certificate signature algorithm"
msgstr "Det gick inte att hämta certifikatets signaturalgoritm"

msgid ""
"Current X.509 certificate uses unknown or unsupported signature algorithm"
msgstr ""
"Det aktuella X.509-certifikatet använder en okänd eller ej stödd "
"signaturalgoritm"

msgid "Failed to generate X.509 certificate digest"
msgstr "Det gick inte att beräkna X.509-certifikatets sammandrag"

msgid "TLS Connection does not support TLS-Exporter feature"
msgstr "TLS-anslutningen stöder inte funktionen TLS-Exporter"

msgid "Unexpected error while exporting keying data"
msgstr "Oväntat fel vid export av nyckelmaterial"

msgid "Error performing TLS close"
msgstr "Fel när TLS-anslutningen skulle stängas"

msgid "Could not get trust settings for certificate"
msgstr "Kunde inte erhålla tillitsinställningar för certifikat"

msgid "Could not retrieve certificates"
msgstr "Kunde inte hämta certifikat"

msgid "Could not get root certificate store"
msgstr "Kunde inte hämta rotcertifikatarkivet"

msgid "Could not get CA certificate store"
msgstr "Kunde inte hämta CA-certifikatarkivet"

msgid "Could not create CA store"
msgstr "Kunde inte skapa CA-certifikatarkivet"

#, c-format
msgid "There is a problem with the certificate: %s"
msgstr "Det har uppstått ett problem med certifikatet: %s"

#, c-format
msgid "There is a problem with the certificate private key: %s"
msgstr "Det har uppstått ett problem med certifikatets privata nyckel: %s"

#, c-format
msgid "There was a problem clearing the chain certificates: %s"
msgstr "Det gick inte att ta bort certifikaten i kedjan: %s"

#, c-format
msgid "There was a problem adding the chain certificate: %s"
msgstr "Det gick inte att lägga till certifikatet i kedjan: %s"

