#: src/quick_reference_dialog.rs:86
msgid "Matches either an a, b, or c character"
msgstr "Matchar antingen ett tecken a, b eller c"

#: src/quick_reference_dialog.rs:91
msgid "Matches everything except an a, b, or c character"
msgstr "Matchar allt utom a, b eller c"

#: src/quick_reference_dialog.rs:96
msgid "Matches every character between a and z"
msgstr "Matchar alla tecken från a till z"

#: src/quick_reference_dialog.rs:101
msgid "Matches both an a or a b"
msgstr "Matchar antingen a eller ab"

#: src/quick_reference_dialog.rs:106
msgid "Matches every word character, equivalent to [a-zA-Z0-9_]"
msgstr "Matchar alla ordtecken, ekvivalent med [a-zA-Z0-9_]"

#: src/quick_reference_dialog.rs:111
msgid "Matches every digit character, equivalent to [0-9]"
msgstr "Matchar alla siffror, ekvivalent med [0-9]"

#: src/quick_reference_dialog.rs:126
msgid "Matches the start of the string"
msgstr "Matchar början på strängen"

#: src/quick_reference_dialog.rs:131
msgid "Matches the end of the string"
msgstr "Matchar slutet på strängen"

#: src/quick_reference_dialog.rs:146
msgid "Matches zero or more of a"
msgstr "Matchar noll eller fler a"

#: src/quick_reference_dialog.rs:151
msgid "Matches one or more of a"
msgstr "Matchar ett eller fler a"

#: src/quick_reference_dialog.rs:156
msgid "Matches exactly 2 of consecutive 'a' characters"
msgstr "Matchar exakt 2 på varandra följande tecken ”a”"
