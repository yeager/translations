#| msgid "The first crossword shown in dark mode"
msgid "A crossword shown in dark mode"
msgstr "Ett korsord i mörkt läge"

#: data/org.gnome.Crosswords.metainfo.xml.in.in:176
msgid "The print preview of a crossword"
msgstr "Förhandsgranskning av korsordsutskrift"

