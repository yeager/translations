#: libsoup/cache/soup-cache-input-stream.c:70
msgid "Network stream unexpectedly closed"
msgstr "Nätverksström stängdes oväntat"

#: libsoup/cache/soup-cache-input-stream.c:252
msgid "Failed to completely cache the resource"
msgstr "Det gick inte att cachelagra hela resursen"

#: libsoup/content-decoder/soup-converter-wrapper.c:197
#, c-format
msgid "Output buffer is too small"
msgstr "Utmatningsbufferten är för liten"

#: libsoup/http1/soup-body-input-stream.c:160
#: libsoup/http1/soup-body-input-stream.c:198
#: libsoup/http1/soup-body-input-stream.c:274
#: libsoup/http1/soup-body-input-stream.c:294
#: libsoup/http1/soup-message-io-data.c:76
#: libsoup/http2/soup-client-message-io-http2.c:488
#: libsoup/server/http2/soup-server-message-io-http2.c:512
msgid "Connection terminated unexpectedly"
msgstr "Anslutningen avslutades oväntat"

#: libsoup/http1/soup-body-input-stream.c:220
#: libsoup/http1/soup-body-input-stream.c:230
#| msgid "Invalid hostname"
msgid "Invalid chunk size"
msgstr "Ogiltig blockstorlek"

#: libsoup/http1/soup-body-input-stream.c:239
msgid "Too large chunk"
msgstr "Datablocket är för stort"

#: libsoup/http1/soup-body-input-stream.c:541
msgid "Invalid seek request"
msgstr "Ogiltig begäran om positionering"

#: libsoup/http1/soup-body-input-stream.c:569
msgid "Cannot truncate SoupBodyInputStream"
msgstr "Kan inte trunkera ”SoupBodyInputStream”"

#: libsoup/http1/soup-client-message-io-http1.c:320
#: libsoup/http1/soup-client-message-io-http1.c:774
#: libsoup/http2/soup-body-input-stream-http2.c:248
#: libsoup/server/http1/soup-server-message-io-http1.c:418
#: libsoup/server/http1/soup-server-message-io-http1.c:945
msgid "Operation would block"
msgstr "Åtgärden skulle blockera"

#: libsoup/http1/soup-client-message-io-http1.c:461
msgid "Could not parse HTTP response"
msgstr "Kunde inte tolka HTTP-svar"

#: libsoup/http1/soup-client-message-io-http1.c:484
msgid "Unrecognized HTTP response encoding"
msgstr "Okänd teckenkodning i HTTP-svaret"

#: libsoup/http1/soup-client-message-io-http1.c:733
#: libsoup/http1/soup-client-message-io-http1.c:759
#: libsoup/http2/soup-client-message-io-http2.c:1940
#: libsoup/http2/soup-client-message-io-http2.c:1963
msgid "Operation was cancelled"
msgstr "Åtgärden avbröts"

#: libsoup/http1/soup-message-io-data.c:104
#: libsoup/soup-multipart-input-stream.c:415
msgid "Header too big"
msgstr "HTTP-huvudet är för stort"

#: libsoup/server/soup-listener.c:265
msgid "Could not import existing socket: "
msgstr "Kan inte importera befintlig socket: "

#: libsoup/server/soup-listener.c:271
msgid "Can’t import unconnected socket"
msgstr "Kan inte importera en oansluten socket"

#: libsoup/server/soup-server.c:1238
msgid "Can’t create a TLS server without a TLS certificate"
msgstr "Kan inte skapa en TLS-server utan ett TLS-certifikat"

#: libsoup/soup-session.c:1132
msgid "Location header is missing or empty in response headers"
msgstr "Location-huvudet saknas eller är tomt i svarshuvudena"

#: libsoup/soup-session.c:1146
#, c-format
msgid "Invalid URI “%s” in Location response header"
msgstr "Ogiltig URI ”%s” i Location-svarshuvud"

#: libsoup/soup-session.c:1166
msgid "Too many redirects"
msgstr "För många omdirigeringar"

#: libsoup/soup-session.c:1171
msgid "Message was restarted too many times"
msgstr "Meddelandet startades om för många gånger"

#: libsoup/soup-session.c:3168 libsoup/soup-session.c:3321
msgid "Message is already in session queue"
msgstr "Meddelandet finns redan i sessionskön"

#: libsoup/soup-session.c:3801
msgid "The server did not accept the WebSocket handshake."
msgstr "Servern accepterade inte WebSocket-handskakningen."

#: libsoup/soup-tld.c:129
msgid "No public-suffix list available."
msgstr "Ingen lista över publika suffix är tillgänglig."

#: libsoup/soup-tld.c:139 libsoup/soup-tld.c:155
msgid "Invalid hostname"
msgstr "Ogiltigt värdnamn"

#: libsoup/soup-tld.c:146
msgid "Hostname is an IP address"
msgstr "Värdnamnet är en IP-adress"

#: libsoup/soup-tld.c:167
msgid "Hostname has no base domain"
msgstr "Värdnamnet har ingen basdomän"

#: libsoup/soup-tld.c:175
msgid "Not enough domains"
msgstr "För få domäner"

#: libsoup/websocket/soup-websocket-connection.c:760
msgid "WebSocket message is too large to send"
msgstr "WebSocket-meddelandet är för stort för att skickas"

#: libsoup/websocket/soup-websocket.c:391
#: libsoup/websocket/soup-websocket.c:435
#: libsoup/websocket/soup-websocket.c:451
msgid "Server requested unsupported extension"
msgstr "Servern begärde ett tillägg som inte stöds"

#: libsoup/websocket/soup-websocket.c:414
#: libsoup/websocket/soup-websocket.c:606
#, c-format
msgid "Incorrect WebSocket “%s” header"
msgstr "Felaktigt WebSocket ”%s”-huvud"

#: libsoup/websocket/soup-websocket.c:415
#: libsoup/websocket/soup-websocket.c:870
#, c-format
msgid "Server returned incorrect “%s” key"
msgstr "Servern returnerade felaktig ”%s”-nyckel"

#: libsoup/websocket/soup-websocket.c:478
#, c-format
msgid "Duplicated parameter in “%s” WebSocket extension header"
msgstr "Duplicerad parameter i ”%s”-WebSocket-tilläggshuvud"

#: libsoup/websocket/soup-websocket.c:479
#, c-format
msgid ""
"Server returned a duplicated parameter in “%s” WebSocket extension header"
msgstr ""
"Servern returnerade en duplicerad parameter i ”%s”-WebSocket-tilläggshuvud"

#: libsoup/websocket/soup-websocket.c:569
#: libsoup/websocket/soup-websocket.c:579
msgid "WebSocket handshake expected"
msgstr "WebSocket-handskakning förväntades"

#: libsoup/websocket/soup-websocket.c:587
msgid "Unsupported WebSocket version"
msgstr "WebSocket-versionen stöds inte"

#: libsoup/websocket/soup-websocket.c:596
msgid "Invalid WebSocket key"
msgstr "Ogiltig WebSocket-nyckel"

#: libsoup/websocket/soup-websocket.c:615
msgid "Unsupported WebSocket subprotocol"
msgstr "WebSocket-underprotokollet stöds inte"

#: libsoup/websocket/soup-websocket.c:821
msgid "Server rejected WebSocket handshake"
msgstr "Servern avvisade WebSocket-handskakningen"

#: libsoup/websocket/soup-websocket.c:829
#: libsoup/websocket/soup-websocket.c:838
msgid "Server ignored WebSocket handshake"
msgstr "Servern ignorerade WebSocket-handskakningen"

#: libsoup/websocket/soup-websocket.c:850
msgid "Server requested unsupported protocol"
msgstr "Servern begärde ett protokoll som inte stöds"

