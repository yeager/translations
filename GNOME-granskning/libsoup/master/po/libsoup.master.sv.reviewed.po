#~ msgstr "Kunde inte tolka URI:n ”%s”: %s"

#~ msgid "Unsupported URI scheme “%s”"
#~ msgstr "URI-schemat ”%s” stöds inte"

#~ msgid "Invalid “%s” URI: %s"
#~ msgstr "Ogiltig ”%s”-URI: %s"

