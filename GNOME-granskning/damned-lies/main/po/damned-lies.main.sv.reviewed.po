#: api/views.py:1222
msgid ""
"You are not allowed to trigger a refresh on this branch. You do not have the "
"required permissions. You need to be a site admin, a team coordinator, or a "
"maintainer of the module."
msgstr ""
"Du får inte utlösa en uppdatering på denna gren. Du har inte rättigheterna "
"som krävs. Du behöver vara en webbplatsadministratör, gruppkoordinator eller "
"en av de ansvariga för modulen."

#: api/views.py:1231
msgid "A refresh is already in progress."
msgstr "En uppdatering pågår redan."

#: api/views.py:1241
msgid "Refresh started."
msgstr "Uppdatering startad."

#: common/vcs/checkout.py:224 common/vcs/checkout.py:468
#, python-format
msgid "Git repository %s is not valid. Calling ‘git-status’ failed."
msgstr "Git-arkivet %s är inte giltigt. Anrop av ”git-status” misslyckades."

#: common/vcs/checkout.py:251 common/vcs/checkout.py:524
#, python-format
msgid "Git repository at %(name)s could not be cloned. %(command_error)s"
msgstr "Git-arkivet på %(name)s kunde inte klonas. %(command_error)s"

#: common/vcs/checkout.py:271 common/vcs/checkout.py:569
#, python-format
msgid "Git repository %(name)s could not be fetched: %(command_error)s"
msgstr "Git-arkivet %(name)s kunde inte hämtas: %(command_error)s"

#: common/vcs/checkout.py:299 common/vcs/checkout.py:656
#, python-format
msgid "Git repository %(name)s could not be updated: %(command_error)s"
msgstr "Git-arkivet %(name)s kunde inte uppdateras: %(command_error)s"

#: common/vcs/checkout.py:314
#, python-format
msgid ""
"Git repository %(name)s could not checkout to feature branch: "
"%(command_error)s"
msgstr ""
"Git-arkivet %(name)s kunde inte checka ut till funktionsgren: "
"%(command_error)s"

#: common/vcs/checkout.py:330 common/vcs/checkout.py:697
#, python-format
msgid ""
"Git repository %(name)s could not create feature branch: %(command_error)s"
msgstr "Git-arkivet %(name)s kunde inte skapa funktionsgren: %(command_error)s"

#: common/vcs/checkout.py:357 common/vcs/checkout.py:728
#, python-format
msgid ""
"Git branch ‘%(name)s’ could not be renamed in repository: %(command_error)s"
msgstr ""
"Kunde inte byta namn på git-grenen ”%(name)s” i arkivet: %(command_error)s"

#: common/vcs/checkout.py:372 common/vcs/checkout.py:793
msgid ""
"Git repository could not be removed due to insufficient rights on the "
"filesystem."
msgstr ""
"Git-arkiv kunde inte tas bort på grund av otillräckliga rättigheter på "
"filsystemet."

#: common/vcs/checkout.py:399 common/vcs/checkout.py:879
#, python-format
msgid ""
"Git branch ‘%(name)s’ could not be removed from repository: %(command_error)s"
msgstr ""
"Kunde inte ta bort git-grenen ”%(name)s” från arkivet: %(command_error)s"

#: common/vcs/checkout.py:591
#, python-format
msgid ""
"Git repository %(name)s could not create a worktree for branch ‘%(branch)s’: "
"%(command_error)s"
msgstr ""
"Git-arkivet %(name)s kunde inte skapa ett arbetsträd för grenen "
"”%(branch)s”: %(command_error)s"

#: common/vcs/committer.py:119
#, python-format
msgid "Git repository %(name)s could not be committed: %(command_error)s"
msgstr "Kunde inte checka in på Git-arkivet %(name)s: %(command_error)s"

#: common/vcs/committer.py:291
#, python-format
msgid ""
"Git repository %(name)s could not cherry-pick commit ‘%(hash)s’: "
"%(command_error)s"
msgstr ""
"Git-arkivet %(name)s kunde inte köra ”cherry-pick” på incheckningen "
"”%(hash)s”: %(command_error)s"

#: common/vcs/git_helpers.py:68
#, python-format
msgid "Git remote branches could not be listed for %(url)s: %(command_error)s"
msgstr "Git-fjärrgrenar kunde inte listas för %(url)s: %(command_error)s"

#: common/vcs/push.py:146
#, python-format
msgid ""
"Git repository %(name)s could not be pushed: %(command_error)s. The branch "
"seems protected and Damned Lies is unable to push references to the "
"repository. Ask the project maintenance team to update the protection for "
"branches to allow Damned Lies to push commits."
msgstr ""
"Kunde inte köra ”push” på Git-arkivet %(name)s: %(command_error)s. Grenen "
"verkar vara skyddad och Förbannade lögner kan inte skicka referenser till "
"arkivet. Fråga projektets grupp för underhåll om att uppdatera skyddet för "
"grenar för att låta Förbannade lögner skicka incheckningar."

#: common/vcs/push.py:155
#, python-format
msgid ""
"Git repository %(name)s could not be pushed because of an unknown error: "
"%(command_error)s"
msgstr ""
"Kunde inte köra ”push” på Git-arkivet %(name)s på grund av ett okänt fel: "
"%(command_error)s"

# request_type är "pull request" eller "merge request"
#: common/vcs/push.py:235
#, python-format
msgid ""
"Git repository %(name)s could not create a %(request_type)s: "
"%(command_error)s"
msgstr ""
"Git-arkivet %(name)s kunde inte skapa en %(request_type)s: %(command_error)s"

#: common/vcs/push.py:284
#, python-format
msgid ""
"Git repository %(name)s could not push branch: %(command_error)s. The branch "
"seems protected and Damned Lies is unable to push references to the "
"repository. Ask the project maintenance team to update the protection for "
"branches to allow Damned Lies to push commits."
msgstr ""
"Git-arkivet %(name)s kunde inte köra ”push” för gren: %(command_error)s. "
"Grenen verkar vara skyddad och Förbannade lögner kan inte skicka referenser "
"till arkivet. Fråga projektets grupp för underhåll om att uppdatera skyddet "
"för grenar för att låta Förbannade lögner skicka incheckningar."

#: common/vcs/push.py:449
#, python-format
msgid ""
"Git repository %(name)s could not create a pull request: GitHub CLI (gh) is "
"not installed. Please install it from https://cli.github.com/"
msgstr ""
"Git-arkivet %(name)s kunde inte skapa en pull-förfrågan: CLI för GitHub (gh) "
"är inte installerat. Installera det från https://cli.github.com/"

#: common/vcs/push.py:463
#, python-format
msgid ""
"Git repository %(name)s could not create a pull request: A pull request "
"already exists for this branch."
msgstr ""
"Git-arkivet %(name)s kunde inte skapa en pull-förfrågan: En pull-förfrågan "
"finns redan för denna gren."

