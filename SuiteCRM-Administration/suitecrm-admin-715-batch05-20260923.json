      "translationId": 2533681,
      "status": 201
    },
    {
      "stringId": 125634,
      "source": "Green means the file does exist.",
      "target": "Grönt betyder att filen finns.",
      "translationId": 2533677,
      "status": 201
    },
    {
      "stringId": 125636,
      "source": "Orange means there is no indexed file, so we cannot look it up.",
      "target": "Orange betyder att det inte finns någon indexerad fil och att den därför inte kan slås upp.",
      "translationId": 2533675,
      "status": 201
    },
    {
      "stringId": 125638,
