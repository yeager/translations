+
+std::string_view localize(Language language, std::string_view source) {
+    if (language != Language::swedish)
+        return source;
+    for (const auto& entry : swedish)
+        if (entry.source == source)
+            return entry.swedish;
+    return source;
+}
+} // namespace shelf
