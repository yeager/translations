    {"translation_id":"o:dwarf-fortress-translation:p:dwarf-fortress-steam:r:hardcoded_steam:s:e5038361d75930fdb38862b50e91ab74:l:sv","source":"I love raunchy poetry!","translation":"Jag älskar snuskig poesi!"},
