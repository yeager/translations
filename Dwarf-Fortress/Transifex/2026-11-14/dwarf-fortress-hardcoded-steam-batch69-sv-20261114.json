    {"translation_id":"o:dwarf-fortress-translation:p:dwarf-fortress-steam:r:hardcoded_steam:s:36a9548cbb3f0adec763a5241b6b5b46:l:sv","source":"  [C:5:0:1]This creature is known to be dead.","translation":"  [C:5:0:1]Den här varelsen är känd som död."},
