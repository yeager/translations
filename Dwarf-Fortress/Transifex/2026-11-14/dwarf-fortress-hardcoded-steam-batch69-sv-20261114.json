    {"translation_id":"o:dwarf-fortress-translation:p:dwarf-fortress-steam:r:hardcoded_steam:s:00b8c6544e3cb49172cf23c2f94ee800:l:sv","source":"Pillage ","translation":"Plundra "},
    {"translation_id":"o:dwarf-fortress-translation:p:dwarf-fortress-steam:r:hardcoded_steam:s:cac301df16a16d160d91c60ce66df0fe:l:sv","source":"After you embark, help is available by pressing the help button in the top right corner, including all of the tutorials.","translation":"När du har påbörjat bosättningen finns hjälp, inklusive alla handledningar, tillgänglig med hjälpknappen uppe till höger."},
    {"translation_id":"o:dwarf-fortress-translation:p:dwarf-fortress-steam:r:hardcoded_steam:s:4525cd4322fbb8348503363f063f0141:l:sv","source":"a few weeks ago","translation":"för några veckor sedan"},
    {"translation_id":"o:dwarf-fortress-translation:p:dwarf-fortress-steam:r:hardcoded_steam:s:233812836506f8f68a2028b1afdfc01d:l:sv","source":"the atlas","translation":"atlasen"},
    {"translation_id":"o:dwarf-fortress-translation:p:dwarf-fortress-steam:r:hardcoded_steam:s:4a13c98c643899d216406f398b347e4b:l:sv","source":"Alternatively, you can reduce the number of swamp squares and regions required by the parameters.","translation":"Alternativt kan du minska antalet sumpmarksrutor och regioner som parametrarna kräver."},
