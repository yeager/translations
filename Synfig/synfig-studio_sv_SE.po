#: ../org.synfig.SynfigStudio.desktop.in.h:1 ../src/gui/dialogs/about.cpp:79
msgid "2D vector animation studio"
msgstr "2D-vektoranimationsstudio"

#: ../org.synfig.SynfigStudio.desktop.in.h:2
msgid "Create and edit 2D animations and compositions"
msgstr "Skapa och redigera 2D-animationer och -kompositioner"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:1
msgid ""
"Synfig Studio is a free and open-source 2D animation software, designed as "
"powerful industrial-strength solution for creating film-quality animation "
"using a vector and bitmap artwork. It eliminates the need to create "
"animation frame-by frame, allowing you to produce 2D animation of a higher "
"quality with fewer people and resources."
msgstr "Synfig Studio är ett gratisprogram med öppen källkod för 2D-animation, gjort för att vara en kraftfull lösning i världsklass för att skapa vektor- och rasteranimationer med filmkvalitet. Med Synfig slipper du göra animationer bildruta för bildruta, vilket låter dig producera 2D-animationer med bättre kvalitet och färre människor och resurser."

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:2
msgid "Features:"
msgstr "Funktioner:"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:3
msgid "Can manipulate vector and bitmap artwork"
msgstr "Kan hantera vektor- och bitmappsgrafik"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:4
msgid "Automatic tweening (independent from FPS)"
msgstr "Automatisk mellanbildsberäkning (oberoende av bildfrekvens)"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:5
msgid ""
"Multitude of layers of various types (geometry primitives, shapes, "
"gradients, fratals)"
msgstr ""
"Många lager av olika typer (geometriska primitiver, former, gradienter och "
"fraktaler)"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:6
msgid "Full-featured bone system"
msgstr "Fullständigt skelettsystem"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:7
msgid ""
"Filters and effects for compositing (blurs, distortions, color manipulation,"
" masks)"
msgstr ""
"Filter och effekter för sammansättning (oskärpa, förvrängningar, "
"färgjustering och masker)"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:8
msgid "All color operations use High Dynamic-Range Imaging (HDRI)"
msgstr "Alla färgåtgärder använder HDR-bilder (High Dynamic Range)"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:9
msgid "Pentablet-friendly tools"
msgstr "Verktyg anpassade för ritplattor"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:10
msgid "Sound support"
msgstr "Stöd för ljud"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:11
msgid "Linking data on file- or parameter-level"
msgstr "Länkning av data på fil- eller parameternivå"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:12
msgid "Automatic animation using mathematical functions"
msgstr "Automatisk animering med matematiska funktioner"

#: ../org.synfig.SynfigStudio.appdata.xml.in.h:13
msgid "Synfig Studio workspace"
msgstr "Synfig Studios arbetsyta"

#: ../synfigstudio-thumbnailer.schemas.in.h:1
msgid "enable"
msgstr "aktivera"

#: ../synfigstudio-thumbnailer.schemas.in.h:2
msgid "Enable this thumbnailer."
msgstr "Aktivera den här miniatyr-generatorn"

#: ../synfigstudio-thumbnailer.schemas.in.h:3
msgid "Invoke Synfig as Thumbnailer"
msgstr "Använd Synfig som minatyr-generator"

#: ../synfigstudio-thumbnailer.schemas.in.h:4
msgid "Invokes Synfig as a gnome thumbnailer for image/sif files"
msgstr "Använder Synfig för att skapa minatyrer av bild-/sif-filer i GNOME."

#: ../plugins/add-skeleton-simple/plugin.xml.in.h:1
msgid "Add Skeleton (Simple)"
msgstr "Lägg till skelett (enkelt)"

#: ../plugins/lottie-exporter/plugin.xml.in.h:1
msgid "Export to Lottie format"
msgstr "Exportera till Lottie-format"

#: ../plugins/lottie-exporter/plugin.xml.in.h:2
msgid "Lottie HTML Preview (*.html)"
msgstr "Lottie-förhandsvisning i HTML (*.html)"

#: ../plugins/lottie-exporter/plugin.xml.in.h:3
msgid "Lottie Animation (*.json)"
msgstr "Lottie-animering (*.json)"

#: ../plugins/lottie-exporter/plugin.xml.in.h:4
msgid "Lottie HTML Preview without variable widths (*.html)"
msgstr "Lottie-förhandsvisning i HTML utan varierande bredder (*.html)"

#: ../plugins/lottie-exporter/plugin.xml.in.h:5
msgid "Lottie Animation without variable widths (*.json)"
msgstr "Lottie-animering utan varierande bredder (*.json)"

#: ../plugins/view-unhide-all-layers/plugin.xml.in.h:1
msgid "Unhide All Layers"
msgstr "Visa alla lager"

#: ../src/brushlib/brushsettings.py:26
msgid "Pressure"
msgstr "Tryck"

#: ../src/brushlib/brushsettings.py:26
msgid ""
"The pressure reported by the tablet, between 0.0 and 1.0. If you use the "
"mouse, it will be 0.5 when a button is pressed and 0.0 otherwise."
msgstr "Trycket rapporterat av plattan, mellan 0.0 och 1.0. Om du använder en mus, är det 0.5 om någon knapp är nertryckt , annars 0.0."

#: ../src/brushlib/brushsettings.py:27
msgid "Fine speed"
msgstr "Finhastighet"

#: ../src/brushlib/brushsettings.py:27
msgid ""
"How fast you currently move. This can change very quickly. Try 'print input "
"values' from the 'help' menu to get a feeling for the range; negative values"
" are rare but possible for very low speed."
msgstr "Hur snabbt du rör dig för tillfället. Detta kan förändras väldigt snabbt. Pröva 'visa inmatade värden' i 'hjälp'-menyn för att få en känsla för bredden; negativa värden är sällsynta men kan användas för väldigt låg hastighet."

#: ../src/brushlib/brushsettings.py:28
msgid "Gross speed"
msgstr "Grov hastighet"

#: ../src/brushlib/brushsettings.py:28
msgid ""
"Same as fine speed, but changes slower. Also look at the 'gross speed "
"filter' setting."
msgstr ""
"Samma som fin hastighet, men ändras långsammare. Se även inställningen för "
"filtret för grov hastighet."

#: ../src/brushlib/brushsettings.py:29
msgid "Random"
msgstr "Slumpmässig"

#: ../src/brushlib/brushsettings.py:29
msgid ""
"Fast random noise, changing at each evaluation. Evenly distributed between 0"
" and 1."
msgstr ""
"Snabbt slumpbrus som ändras vid varje beräkning. Jämnt fördelat mellan 0 "
"och 1."

#: ../src/brushlib/brushsettings.py:30
msgid "Stroke"
msgstr "Penseldrag"

#: ../src/brushlib/brushsettings.py:30
msgid ""
"This input slowly goes from zero to one while you draw a stroke. It can also"
" be configured to jump back to zero periodically while you move. Look at the"
" 'stroke duration' and 'stroke hold time' settings."
msgstr ""
"Den här inmatningen går långsamt från noll till ett när du ritar ett "
"penseldrag. Den kan också ställas in på att periodvis hoppa tillbaka till "
"noll medan du flyttar pekaren. Se inställningarna för penseldragets "
"varaktighet och hålltid."

#: ../src/brushlib/brushsettings.py:31
msgid "Direction"
msgstr "Riktning"

#: ../src/brushlib/brushsettings.py:31
msgid ""
"The angle of the stroke, in degrees. The value will stay between 0.0 and "
"180.0, effectively ignoring turns of 180 degrees."
msgstr ""
"Penseldragets vinkel i grader. Värdet hålls mellan 0,0 och 180,0 och "
"ignorerar därmed i praktiken vridningar på 180 grader."

#: ../src/brushlib/brushsettings.py:32
msgid "Declination"
msgstr "Lutning"

#: ../src/brushlib/brushsettings.py:32
msgid ""
"Declination of stylus tilt. 0 when stylus is parallel to tablet and 90.0 "
"when it's perpendicular to tablet."
msgstr ""
"Lutningsvinkel för pennan. 0 när pennan är parallell med ritplattan och "
"90,0 när den är vinkelrät mot ritplattan."

#: ../src/brushlib/brushsettings.py:33
msgid "Ascension"
msgstr "Stigning"

#: ../src/brushlib/brushsettings.py:33
msgid ""
"Right ascension of stylus tilt. 0 when stylus working end points to you, +90"
" when rotated 90 degrees clockwise, -90 when rotated 90 degrees "
"counterclockwise."
msgstr ""
"Rät uppstigning för pennans lutning. 0 när pennans spets pekar mot dig, +90 "
"när den vrids 90 grader medurs och -90 när den vrids 90 grader moturs."

#: ../src/brushlib/brushsettings.py:35
msgid "Custom"
msgstr "Anpassad"

#: ../src/brushlib/brushsettings.py:35
msgid ""
"This is a user defined input. Look at the 'custom input' setting for "
"details."
msgstr ""
"Detta är en användardefinierad inmatning. Se inställningen för anpassad "
"inmatning för mer information."

#: ../src/brushlib/brushsettings.py:44 ../src/gui/states/state_bline.cpp:548
#: ../src/gui/states/state_circle.cpp:573 ../src/gui/states/state_draw.cpp:648
#: ../src/gui/states/state_gradient.cpp:428
#: ../src/gui/states/state_lasso.cpp:626
#: ../src/gui/states/state_polygon.cpp:506
#: ../src/gui/states/state_rectangle.cpp:524
#: ../src/gui/states/state_star.cpp:636 ../src/gui/states/state_text.cpp:414
msgid "Opacity"
msgstr "Opacitet"

#: ../src/brushlib/brushsettings.py:44
msgid ""
"0 means brush is transparent, 1 fully visible\n"
"(also known as alpha or opacity)"
msgstr ""
"0 betyder att penseln är genomskinlig, 1 att den är helt synlig\n"
"(även känt som alfa eller opacitet)"

#: ../src/brushlib/brushsettings.py:45
msgid "Opacity multiply"
msgstr "Multiplicera opacitet"

#: ../src/brushlib/brushsettings.py:45
msgid ""
"This gets multiplied with opaque. You should only change the pressure input of this setting. Use 'opaque' instead to make opacity depend on speed.\n"
"This setting is responsible to stop painting when there is zero pressure. This is just a convention, the behaviour is identical to 'opaque'."
msgstr ""
"Detta multipliceras med opacitet. Du bör bara ändra tryckinmatningen för "
"den här inställningen. Använd opacitet i stället för att låta opaciteten "
"bero på hastigheten.\n"
"Inställningen ansvarar för att stoppa målning när trycket är noll. Detta är "
"bara en konvention; beteendet är identiskt med opacitet."

#: ../src/brushlib/brushsettings.py:46
msgid "Opacity linearize"
msgstr "Lineariserad opacitet"

#: ../src/brushlib/brushsettings.py:46
msgid ""
"Correct the nonlinearity introduced by blending multiple dabs on top of each other. This correction should get you a linear (\"natural\") pressure response when pressure is mapped to opaque_multiply, as it is usually done. 0.9 is good for standard strokes, set it smaller if your brush scatters a lot, or higher if you use dabs_per_second.\n"
"0.0 the opaque value above is for the individual dabs\n"
"1.0 the opaque value above is for the final brush stroke, assuming each pixel gets (dabs_per_radius*2) brushdabs on average during a stroke"
msgstr ""
"Korrigera olinjäriteten som uppstår när flera duttar blandas ovanpå "
"varandra. Korrigeringen bör ge ett linjärt (”naturligt”) trycksvar när "
"tryck mappas till opaque_multiply, vilket är normalt. 0,9 är bra för "
"standardpenseldrag; välj lägre om penseln sprider sig mycket eller högre om "
"du använder dabs_per_second.\n"
"0,0: opacitetsvärdet ovan avser de enskilda duttarna\n"
"1,0: opacitetsvärdet ovan avser det färdiga penseldraget, förutsatt att "
"varje bildpunkt i genomsnitt får (dabs_per_radius*2) penselduttar under ett "
"drag"

#: ../src/brushlib/brushsettings.py:47 ../src/gui/dialogs/dialog_setup.cpp:789
msgid "Radius"
msgstr "Radie"

#: ../src/brushlib/brushsettings.py:47
msgid ""
"Basic brush radius (logarithmic)\n"
" 0.7 means 2 pixels\n"
" 3.0 means 20 pixels"
msgstr ""
"Grundradie för penseln (logaritmisk)\n"
" 0,7 betyder 2 bildpunkter\n"
" 3,0 betyder 20 bildpunkter"

#: ../src/brushlib/brushsettings.py:48
msgid "Hardness"
msgstr "Hårdhet"

#: ../src/brushlib/brushsettings.py:48
msgid ""
"Hard brush-circle borders (setting to zero will draw nothing). To reach the "
"maximum hardness, you need to disable Anti-aliasing."
msgstr ""
"Hårda kanter på penselcirkeln (inställningen noll ritar inget). För att "
"uppnå maximal hårdhet måste du inaktivera kantutjämning."

#: ../src/brushlib/brushsettings.py:49
msgid "Anti-aliasing"
msgstr "Kantutjämning"

#: ../src/brushlib/brushsettings.py:49
msgid ""
"This setting decreases the hardness when necessary to prevent a pixel staircase effect.\n"
" 0.0 disable (for very strong erasers and pixel brushes)\n"
" 1.0 blur one pixel (good value)\n"
" 5.0 notable blur, thin strokes will disappear"
msgstr ""
"Den här inställningen minskar hårdheten vid behov för att förhindra "
"trappstegseffekter.\n"
" 0,0 inaktivera (för mycket starka suddgummin och pixelpenslar)\n"
" 1,0 gör en bildpunkt oskarp (bra värde)\n"
" 5,0 påtaglig oskärpa, tunna penseldrag försvinner"

#: ../src/brushlib/brushsettings.py:50
msgid "Dabs per basic radius"
msgstr "Duttar per grundradie"

#: ../src/brushlib/brushsettings.py:50
msgid ""
"How many dabs to draw while the pointer moves a distance of one brush radius"
" (more precise: the base value of the radius)"
msgstr ""
"Antal duttar att rita medan pekaren flyttas en penselradie (mer exakt: "
"radiens grundvärde)"

#: ../src/brushlib/brushsettings.py:51
msgid "Dabs per actual radius"
msgstr "Duttar per faktisk radie"

#: ../src/brushlib/brushsettings.py:51
msgid ""
"Same as above, but the radius actually drawn is used, which can change "
"dynamically"
msgstr ""
"Samma som ovan, men använder den radie som faktiskt ritas och som kan "
"ändras dynamiskt"

#: ../src/brushlib/brushsettings.py:52
msgid "Dabs per second"
msgstr "Duttar per sekund"

#: ../src/brushlib/brushsettings.py:52
msgid "Dabs to draw each second, no matter how far the pointer moves"
msgstr "Penselduttar att rita per sekund, oavsett hur långt pekaren flyttas"

#: ../src/brushlib/brushsettings.py:53
msgid "Radius by random"
msgstr "Radie efter slump"

#: ../src/brushlib/brushsettings.py:53
msgid ""
"Alter the radius randomly each dab. You can also do this with the by_random input on the radius setting. If you do it here, there are two differences:\n"
"1) the opaque value will be corrected such that a big-radius dabs is more transparent\n"
"2) it will not change the actual radius seen by dabs_per_actual_radius"
msgstr ""
"Ändra radien slumpmässigt för varje dutt. Du kan också göra detta med "
"inmatningen by_random i radieinställningen. Om du gör det här finns det två "
"skillnader:\n"
"1) opacitetsvärdet korrigeras så att duttar med stor radie blir mer "
"genomskinliga\n"
"2) den faktiska radien som dabs_per_actual_radius ser ändras inte"

#: ../src/brushlib/brushsettings.py:54
msgid "Fine speed filter"
msgstr "Filter för fin hastighet"

#: ../src/brushlib/brushsettings.py:54
msgid ""
"How slow the input fine speed is following the real speed\n"
"0.0 change immediately as your speed changes (not recommended, but try it)"
msgstr ""
"Hur långsamt den fina hastighetsinmatningen följer den verkliga hastigheten\n"
"0,0 ändra genast när hastigheten ändras (rekommenderas inte, men prova)"

#: ../src/brushlib/brushsettings.py:55
msgid "Gross speed filter"
msgstr "Filter för grov hastighet"

#: ../src/brushlib/brushsettings.py:55
msgid "Same as 'fine speed filter', but note that the range is different"
msgstr "Samma som filtret för fin hastighet, men observera att intervallet skiljer sig"

#: ../src/brushlib/brushsettings.py:56
msgid "Fine speed gamma"
msgstr "Gamma för fin hastighet"

#: ../src/brushlib/brushsettings.py:56
msgid ""
"This changes the reaction of the 'fine speed' input to extreme physical speed. You will see the difference best if 'fine speed' is mapped to the radius.\n"
"-8.0 very fast speed does not increase 'fine speed' much more\n"
"+8.0 very fast speed increases 'fine speed' a lot\n"
"For very slow speed the opposite happens."
msgstr ""
"Detta ändrar hur inmatningen för fin hastighet reagerar på extrema fysiska "
"hastigheter. Skillnaden syns bäst om fin hastighet är mappad till radien.\n"
"-8,0 mycket hög hastighet ökar inte fin hastighet särskilt mycket\n"
"+8,0 mycket hög hastighet ökar fin hastighet mycket\n"
"Vid mycket låg hastighet gäller motsatsen."

#: ../src/brushlib/brushsettings.py:57
msgid "Gross speed gamma"
msgstr "Gamma för grov hastighet"

#: ../src/brushlib/brushsettings.py:57
msgid "Same as 'fine speed gamma' for gross speed"
msgstr "Samma som gamma för fin hastighet, fast för grov hastighet"

#: ../src/brushlib/brushsettings.py:58
msgid "Jitter"
msgstr "Skakning"

#: ../src/brushlib/brushsettings.py:58
msgid ""
"Add a random offset to the position where each dab is drawn\n"
" 0.0 disabled\n"
" 1.0 standard deviation is one basic radius away\n"
"<0.0 negative values produce no jitter"
msgstr ""
"Lägg till en slumpmässig förskjutning till positionen där varje dutt ritas\n"
" 0,0 inaktiverat\n"
" 1,0 standardavvikelsen är en grundradie\n"
"<0,0 negativa värden ger ingen skakning"

#: ../src/brushlib/brushsettings.py:59
msgid "Offset by speed"
msgstr "Förskjutning efter hastighet"

#: ../src/brushlib/brushsettings.py:59
msgid ""
"Change position depending on pointer speed\n"
"= 0 disable\n"
"> 0 draw where the pointer moves to\n"
"< 0 draw where the pointer comes from"
msgstr ""
"Ändra positionen beroende på pekarens hastighet\n"
"= 0 inaktivera\n"
"> 0 rita dit pekaren flyttas\n"
"< 0 rita där pekaren kommer ifrån"

#: ../src/brushlib/brushsettings.py:60
msgid "Offset by speed filter"
msgstr "Filter för hastighetsförskjutning"

#: ../src/brushlib/brushsettings.py:60
msgid "How slow the offset goes back to zero when the cursor stops moving"
msgstr "Hur långsamt förskjutningen återgår till noll när pekaren slutar röra sig"

#: ../src/brushlib/brushsettings.py:61
msgid "Slow position tracking"
msgstr "Trög positionsföljning"

#: ../src/brushlib/brushsettings.py:61
msgid ""
"Slowdown pointer tracking speed. 0 disables it, higher values remove more "
"jitter in cursor movements. Useful for drawing smooth, comic-like outlines."
msgstr ""
"Sakta ned pekarens följningshastighet. 0 inaktiverar den, högre värden tar "
"bort mer skakning i pekarens rörelser. Användbart för att rita mjuka, "
"serieartade konturer."

#: ../src/brushlib/brushsettings.py:62
msgid "Slow tracking per dab"
msgstr "Trög följning per dutt"

#: ../src/brushlib/brushsettings.py:62
msgid ""
"Similar as above but at brushdab level (ignoring how much time has past, if "
"brushdabs do not depend on time)"
msgstr ""
"Liknande som ovan, men på penselduttnivå (tiden som passerat ignoreras om "
"penselduttar inte beror på tiden)"

#: ../src/brushlib/brushsettings.py:63
msgid "Tracking noise"
msgstr "Följningsbrus"

#: ../src/brushlib/brushsettings.py:63
msgid ""
"Add randomness to the mouse pointer; this usually generates many small lines"
" in random directions; maybe try this together with 'slow tracking'"
msgstr ""
"Lägg till slumpmässighet för muspekaren; detta skapar vanligtvis många små "
"linjer i slumpmässiga riktningar. Prova gärna tillsammans med trög följning."

#: ../src/brushlib/brushsettings.py:65
msgid "Color hue"
msgstr "Färgton"

#: ../src/brushlib/brushsettings.py:66
msgid "Color saturation"
msgstr "Färgmättnad"

#: ../src/brushlib/brushsettings.py:67
msgid "Color value"
msgstr "Färgvärde"

#: ../src/brushlib/brushsettings.py:67
msgid "Color value (brightness, intensity)"
msgstr "Färgvärde (ljusstyrka, intensitet)"

#: ../src/brushlib/brushsettings.py:68
msgid "Save color"
msgstr "Spara färg"

#: ../src/brushlib/brushsettings.py:68
msgid ""
"When selecting a brush, the color can be restored to the color that the brush was saved with.\n"
" 0.0 do not modify the active color when selecting this brush\n"
" 0.5 change active color towards brush color\n"
" 1.0 set the active color to the brush color when selected"
msgstr ""
"När du väljer en pensel kan färgen återställas till den färg som penseln "
"sparades med.\n"
" 0,0 ändra inte den aktiva färgen när denna pensel väljs\n"
" 0,5 ändra den aktiva färgen mot penselfärgen\n"
" 1,0 ställ in den aktiva färgen på penselfärgen när den väljs"

#: ../src/brushlib/brushsettings.py:69
msgid "Change color hue"
msgstr "Ändra färgton"

#: ../src/brushlib/brushsettings.py:69
msgid ""
"Change color hue.\n"
"-0.1 small clockwise color hue shift\n"
" 0.0 disable\n"
" 0.5 counterclockwise hue shift by 180 degrees"
msgstr ""
"Ändra färgton.\n"
"-0,1 liten medurs förskjutning av färgtonen\n"
" 0,0 inaktivera\n"
" 0,5 moturs förskjutning av färgtonen med 180 grader"

#: ../src/brushlib/brushsettings.py:70
msgid "Change color lightness (HSL)"
msgstr "Ändra färgens ljushet (HSL)"

#: ../src/brushlib/brushsettings.py:70
msgid ""
"Change the color lightness (luminance) using the HSL color model.\n"
"-1.0 blacker\n"
" 0.0 disable\n"
" 1.0 whiter"
msgstr ""
"Ändra färgens ljushet (luminans) med färgmodellen HSL.\n"
"-1,0 svartare\n"
" 0,0 inaktivera\n"
" 1,0 vitare"

#: ../src/brushlib/brushsettings.py:71
msgid "Change color satur. (HSL)"
msgstr "Ändra färgmättnad (HSL)"

#: ../src/brushlib/brushsettings.py:71
msgid ""
"Change the color saturation using the HSL color model.\n"
"-1.0 more grayish\n"
" 0.0 disable\n"
" 1.0 more saturated"
msgstr ""
"Ändra färgmättnaden med färgmodellen HSL.\n"
"-1,0 mer gråaktig\n"
" 0,0 inaktivera\n"
" 1,0 mer mättad"

#: ../src/brushlib/brushsettings.py:72
msgid "Change color value (HSV)"
msgstr "Ändra färgvärde (HSV)"

#: ../src/brushlib/brushsettings.py:72
msgid ""
"Change the color value (brightness, intensity) using the HSV color model. HSV changes are applied before HSL.\n"
"-1.0 darker\n"
" 0.0 disable\n"
" 1.0 brighter"
msgstr ""
"Ändra färgvärdet (ljusstyrka, intensitet) med färgmodellen HSV. "
"HSV-ändringar tillämpas före HSL.\n"
"-1,0 mörkare\n"
" 0,0 inaktivera\n"
" 1,0 ljusare"

#: ../src/brushlib/brushsettings.py:73
msgid "Change color satur. (HSV)"
msgstr "Ändra färgmättnad (HSV)"

#: ../src/brushlib/brushsettings.py:73
msgid ""
"Change the color saturation using the HSV color model. HSV changes are applied before HSL.\n"
"-1.0 more grayish\n"
" 0.0 disable\n"
" 1.0 more saturated"
msgstr ""
"Ändra färgmättnaden med färgmodellen HSV. HSV-ändringar tillämpas före "
"HSL.\n"
"-1,0 mer gråaktig\n"
" 0,0 inaktivera\n"
" 1,0 mer mättad"

#: ../src/brushlib/brushsettings.py:74
msgid "Smudge"
msgstr "Smeta ut"

#: ../src/brushlib/brushsettings.py:74
msgid ""
"Paint with the smudge color instead of the brush color. The smudge color is slowly changed to the color you are painting on.\n"
" 0.0 do not use the smudge color\n"
" 0.5 mix the smudge color with the brush color\n"
" 1.0 use only the smudge color"
msgstr ""
"Måla med utsmetningsfärgen i stället för penselfärgen. Utsmetningsfärgen "
"ändras långsamt till färgen du målar på.\n"
" 0,0 använd inte utsmetningsfärgen\n"
" 0,5 blanda utsmetningsfärgen med penselfärgen\n"
" 1,0 använd endast utsmetningsfärgen"

#: ../src/brushlib/brushsettings.py:75
msgid "Smudge length"
msgstr "Smetningslängd"

#: ../src/brushlib/brushsettings.py:75
msgid ""
"This controls how fast the smudge color becomes the color you are painting on.\n"
"0.0 immediately update the smudge color (requires more CPU cycles because of the frequent color checks)\n"
"0.5 change the smudge color steadily towards the canvas color\n"
"1.0 never change the smudge color"
msgstr ""
"Detta styr hur snabbt utsmetningsfärgen blir färgen du målar på.\n"
"0,0 uppdatera utsmetningsfärgen omedelbart (kräver fler CPU-cykler på "
"grund av täta färgkontroller)\n"
"0,5 ändra utsmetningsfärgen stadigt mot arbetsytans färg\n"
"1,0 ändra aldrig utsmetningsfärgen"

#: ../src/brushlib/brushsettings.py:76
msgid "Smudge radius"
msgstr "Smetningsradie"

#: ../src/brushlib/brushsettings.py:76
msgid ""
"This modifies the radius of the circle where color is picked up for smudging.\n"
" 0.0 use the brush radius\n"
"-0.7 half the brush radius (fast, but not always intuitive)\n"
"+0.7 twice the brush radius\n"
"+1.6 five times the brush radius (slow performance)"
msgstr ""
"Detta ändrar radien för cirkeln där färg hämtas för utsmetning.\n"
" 0,0 använd penselradien\n"
"-0,7 hälften av penselradien (snabbt, men inte alltid intuitivt)\n"
"+0,7 dubbla penselradien\n"
"+1,6 fem gånger penselradien (långsam prestanda)"

#: ../src/brushlib/brushsettings.py:77 ../src/gui/states/state_brush.cpp:502
msgid "Eraser"
msgstr "Suddgummi"

#: ../src/brushlib/brushsettings.py:77
msgid ""
"how much this tool behaves like an eraser\n"
" 0.0 normal painting\n"
" 1.0 standard eraser\n"
" 0.5 pixels go towards 50% transparency"
msgstr ""
"hur mycket verktyget beter sig som ett suddgummi\n"
" 0,0 vanlig målning\n"
" 1,0 standardsuddgummi\n"
" 0,5 bildpunkter närmar sig 50 % genomskinlighet"

#: ../src/brushlib/brushsettings.py:79
msgid "Stroke threshold"
msgstr "Strecktröskel"

#: ../src/brushlib/brushsettings.py:79
msgid ""
"How much pressure is needed to start a stroke. This affects the stroke input"
" only. Mypaint does not need a minimal pressure to start drawing."
msgstr ""
"Hur mycket tryck som krävs för att starta ett penseldrag. Detta påverkar "
"endast inmatningen för penseldrag. MyPaint behöver inget minimitryck för "
"att börja rita."

#: ../src/brushlib/brushsettings.py:80
msgid "Stroke duration"
msgstr "Streckets varaktighet"

#: ../src/brushlib/brushsettings.py:80
msgid ""
"How far you have to move until the stroke input reaches 1.0. This value is "
"logarithmic (negative values will not inverse the process)."
msgstr ""
"Hur långt du måste flytta innan inmatningen för penseldrag når 1,0. Värdet "
"är logaritmiskt (negativa värden vänder inte processen)."

#: ../src/brushlib/brushsettings.py:81
msgid "Stroke hold time"
msgstr "Streckets hålltid"

#: ../src/brushlib/brushsettings.py:81
msgid ""
"This defines how long the stroke input stays at 1.0. After that it will reset to 0.0 and start growing again, even if the stroke is not yet finished.\n"
"2.0 means twice as long as it takes to go from 0.0 to 1.0\n"
"9.9 and bigger stands for infinite"
msgstr ""
"Detta anger hur länge inmatningen för penseldrag hålls på 1,0. Därefter "
"återställs den till 0,0 och börjar öka igen, även om penseldraget ännu inte "
"är klart.\n"
"2,0 betyder dubbelt så lång tid som det tar att gå från 0,0 till 1,0\n"
"9,9 och större betyder oändligt"

#: ../src/brushlib/brushsettings.py:82
msgid "Custom input"
msgstr "Anpassad inmatning"

#: ../src/brushlib/brushsettings.py:82
msgid ""
"Set the custom input to this value. If it is slowed down, move it towards this value (see below). The idea is that you make this input depend on a mixture of pressure/speed/whatever, and then make other settings depend on this 'custom input' instead of repeating this combination everywhere you need it.\n"
"If you make it change 'by random' you can generate a slow (smooth) random input."
msgstr ""
"Ställ in den anpassade inmatningen på detta värde. Om den bromsas, flytta "
"den mot detta värde (se nedan). Tanken är att du låter inmatningen bero på "
"en kombination av tryck, hastighet eller annat och låter andra inställningar "
"bero på denna anpassade inmatning i stället för att upprepa kombinationen "
"överallt där den behövs.\n"
"Om du låter den ändras slumpmässigt kan du skapa en långsam, jämn "
"slumpmässig inmatning."

#: ../src/brushlib/brushsettings.py:83
msgid "Custom input filter"
msgstr "Filter för anpassad inmatning"

#: ../src/brushlib/brushsettings.py:83
msgid ""
"How slow the custom input actually follows the desired value (the one above). This happens at brushdab level (ignoring how much time has past, if brushdabs do not depend on time).\n"
"0.0 no slowdown (changes apply instantly)"
msgstr ""
"Hur långsamt den anpassade inmatningen faktiskt följer det önskade värdet "
"(ovan). Detta sker på penselduttnivå (tiden som passerat ignoreras om "
"penselduttar inte beror på tiden).\n"
"0,0 ingen inbromsning (ändringar tillämpas omedelbart)"

#: ../src/brushlib/brushsettings.py:85
msgid "Elliptical dab: ratio"
msgstr "Elliptisk penseldutt: proportion"

#: ../src/brushlib/brushsettings.py:85
msgid ""
"Aspect ratio of the dabs; must be >= 1.0, where 1.0 means a perfectly round "
"dab. TODO: linearize? start at 0.0 maybe, or log?"
msgstr ""
"Bildförhållande för duttarna; måste vara >= 1,0, där 1,0 betyder en "
"perfekt rund dutt. ATT GÖRA: lineariseras? Börja kanske på 0,0 eller "
"logaritmiskt?"

#: ../src/brushlib/brushsettings.py:86
msgid "Elliptical dab: angle"
msgstr "Elliptisk penseldutt: vinkel"

#: ../src/brushlib/brushsettings.py:86
msgid ""
"Angle by which elliptical dabs are tilted\n"
" 0.0 horizontal dabs\n"
" 45.0 45 degrees, turned clockwise\n"
" 180.0 horizontal again"
msgstr ""
"Vinkel med vilken elliptiska duttar lutar\n"
" 0,0 horisontella duttar\n"
" 45,0 45 grader, vridna medurs\n"
" 180,0 horisontella igen"

#: ../src/brushlib/brushsettings.py:87
msgid "Direction filter"
msgstr "Riktningsfilter"

#: ../src/brushlib/brushsettings.py:87
msgid ""
"A low value will make the direction input adapt more quickly, a high value "
"will make it smoother"
msgstr ""
"Ett lågt värde gör att riktningsinmatningen anpassas snabbare, ett högt "
"värde gör den jämnare"

#: ../src/brushlib/brushsettings.py:89
msgid "Lock alpha"
msgstr "Lås alfa"

#: ../src/brushlib/brushsettings.py:89
msgid ""
"Do not modify the alpha channel of the layer (paint only where there is paint already)\n"
" 0.0 normal painting\n"
" 0.5 half of the paint gets applied normally\n"
" 1.0 alpha channel fully locked"
msgstr ""
"Ändra inte lagrets alfakanal (måla bara där det redan finns färg).\n"
" 0,0 vanlig målning\n"
" 0,5 hälften av färgen tillämpas som vanligt\n"
" 1,0 alfakanalen är helt låst"

