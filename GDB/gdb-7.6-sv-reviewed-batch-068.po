#. Define the classes of commands.
#. They will appear in the help list in alphabetical order.
#: cli/cli-cmds.c:1641
msgid ""
"Maintenance commands.\n"
"Some gdb commands are provided just for use by gdb maintainers.\n"
"These commands are subject to frequent change, and may not be as\n"
"well documented as user commands."
msgstr ""
"Underhållskommandon.\n"
"Vissa GDB-kommandon är endast avsedda för GDB:s underhållare.\n"
"Kommandona ändras ofta och är kanske inte lika väl dokumenterade som\n"
"användarkommandon."

#: cli/cli-cmds.c:1647
msgid "Obscure features."
msgstr "Mindre vanliga funktioner."

#: cli/cli-cmds.c:1649
msgid "Aliases of other commands."
msgstr "Alias för andra kommandon."

#: cli/cli-cmds.c:1650
msgid ""
"User-defined commands.\n"
"The commands in this class are those defined by the user.\n"
"Use the \"define\" command to define a command."
msgstr ""
"Användardefinierade kommandon.\n"
"Kommandona i denna klass definieras av användaren.\n"
"Använd kommandot \"define\" för att definiera ett kommando."

#: cli/cli-cmds.c:1654
msgid "Support facilities."
msgstr "Stödfunktioner."

#: cli/cli-cmds.c:1656
msgid "Status inquiries."
msgstr "Statusförfrågningar."

#: cli/cli-cmds.c:1657
msgid "Specifying and examining files."
msgstr "Ange och granska filer."

#: cli/cli-cmds.c:1660
msgid "Making program stop at certain points."
msgstr "Få programmet att stanna vid vissa punkter."

#: cli/cli-cmds.c:1661
msgid "Examining data."
msgstr "Granska data."

#: cli/cli-cmds.c:1662
msgid ""
"Examining the stack.\n"
"The stack is made up of stack frames.  Gdb assigns numbers to stack frames\n"
"counting from zero for the innermost (currently executing) frame.\n"
"\n"
"At any time gdb identifies one frame as the \"selected\" frame.\n"
"Variable lookups are done with respect to the selected frame.\n"
"When the program being debugged stops, gdb selects the innermost frame.\n"
"The commands below can be used to select other frames by number or address."
msgstr ""
"Granska stacken.\n"
"Stacken består av stackramar. GDB numrerar stackramarna med noll för den innersta\n"
"(den som körs just nu) ramen.\n"
"\n"
"GDB har alltid en ram som den \"valda\" ramen.\n"
"Variabeluppslagningar görs med avseende på den valda ramen.\n"
"När programmet som felsöks stannar väljer GDB den innersta ramen.\n"
"Kommandona nedan kan användas för att välja andra ramar efter nummer eller adress."

#: cli/cli-cmds.c:1671
msgid "Running the program."
msgstr "Köra programmet."

#. Define general commands.
#: cli/cli-cmds.c:1675
msgid "Print working directory.  This is used for your program as well."
msgstr "Skriv ut arbetskatalogen. Detta används även för ditt program."

#: cli/cli-cmds.c:1678
msgid ""
"Set working directory to DIR for debugger and program being debugged.\n"
"The change does not take effect for the program being debugged\n"
"until the next time it is started."
msgstr ""
"Ställ in arbetskatalogen till DIR för felsökaren och programmet som felsöks.\n"
"Ändringen träder inte i kraft för det felsökta programmet\n"
"förrän nästa gång det startas."

#: cli/cli-cmds.c:1684
msgid ""
"Print a constant string.  Give string as argument.\n"
"C escape sequences may be used in the argument.\n"
"No newline is added at the end of the argument;\n"
"use \"\\n\" if you want a newline to be printed.\n"
"Since leading and trailing whitespace are ignored in command arguments,\n"
"if you want to print some you must use \"\\\" before leading whitespace\n"
"to be printed or after trailing whitespace."
msgstr ""
"Skriv ut en konstant sträng. Ange strängen som argument.\n"
"C-escape-sekvenser kan användas i argumentet.\n"
"Ingen radbrytning läggs till efter argumentet;\n"
"använd \"\\n\" om du vill skriva ut en radbrytning.\n"
"Eftersom inledande och avslutande blanktecken ignoreras i kommandoargument\n"
"måste du använda \"\\\" före inledande blanktecken eller efter avslutande blanktecken\n"
"för att skriva ut dem."

#: cli/cli-cmds.c:1694
msgid "Set mode for script filename extension recognition."
msgstr "Ställ in läge för igenkänning av skriptfilnamnstillägg."

#: cli/cli-cmds.c:1695
msgid "Show mode for script filename extension recognition."
msgstr "Visa läge för igenkänning av filnamnstillägg för skript."

#: cli/cli-cmds.c:1696
msgid ""
"off  == no filename extension recognition (all sourced files are GDB scripts)\n"
"soft == evaluate script according to filename extension, fallback to GDB script\n"
"strict == evaluate script according to filename extension, error if not supported"
msgstr ""
"off  == ingen igenkänning av filnamnstillägg (alla inlästa filer är GDB-skript)\n"
"soft == utvärdera skriptet enligt filnamnstillägget, återgå till GDB-skript\n"
"strict == utvärdera skriptet enligt filnamnstillägget, fel om det inte stöds"

#: cli/cli-cmds.c:1706
msgid "Exit gdb."
msgstr "Avsluta GDB."

#: cli/cli-cmds.c:1708
msgid "Print list of commands."
msgstr "Skriv ut en lista över kommandon."

#: cli/cli-cmds.c:1713
msgid "Set verbosity."
msgstr "Ställ in detaljeringsgrad."

#: cli/cli-cmds.c:1714
msgid "Show verbosity."
msgstr "Visa detaljeringsgrad."

#: cli/cli-cmds.c:1721
msgid "Generic command for setting command history parameters."
msgstr "Generiskt kommando för att ställa in parametrar för kommandohistorik."

#: cli/cli-cmds.c:1724
msgid "Generic command for showing command history parameters."
msgstr "Generiskt kommando för att visa kommandohistorikparametrar."

#: cli/cli-cmds.c:1727
msgid "Set history expansion on command input."
msgstr "Ställ in historikutvidgning vid kommandoinmatning."

#: cli/cli-cmds.c:1728
msgid "Show history expansion on command input."
msgstr "Visa historikutvidgning vid kommandoinmatning."

#: cli/cli-cmds.c:1729
msgid "Without an argument, history expansion is enabled."
msgstr "Utan argument är historikutvidgning aktiverad."

#: cli/cli-cmds.c:1735
msgid "Generic command for showing things about the program being debugged."
msgstr ""
"Generiskt kommando för att visa information om programmet som felsöks."

#: cli/cli-cmds.c:1742
msgid "List the completions for the rest of the line as a command."
msgstr ""
"Lista möjliga kompletteringar för återstoden av raden som ett kommando."

#: cli/cli-cmds.c:1744
msgid "Generic command for showing things about the debugger."
msgstr "Generiskt kommando för att visa information om felsökaren."

#. Another way to get at the same thing.
#: cli/cli-cmds.c:1748
msgid "Show all GDB settings."
msgstr "Visa alla GDB-inställningar."

#: cli/cli-cmds.c:1750
msgid ""
"Show the history of commands you typed.\n"
"You can supply a command number to start with, or a `+' to start after\n"
"the previous command number shown."
msgstr ""
"Visa historiken över kommandon som du har skrivit.\n"
"Du kan ange ett kommandonummer att börja med, eller `+' för att börja efter\n"
"det senast visade kommandonumret."

#: cli/cli-cmds.c:1757
msgid "Show what version of GDB this is."
msgstr "Visa vilken version av GDB det här är."

#. If target is open when baud changes, it doesn't take effect until
