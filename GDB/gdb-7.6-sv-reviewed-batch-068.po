#: cli/cli-logging.c:284
msgid ""
"\"set logging\" lets you log output to a file.\n"
"Usage: set logging on [FILENAME]\n"
"       set logging off\n"
"       set logging file FILENAME\n"
"       set logging overwrite [on|off]\n"
"       set logging redirect [on|off]\n"
msgstr ""
"\"set logging\" låter dig logga utdata till en fil.\n"
"Användning: set logging on [FILNAMN]\n"
"       set logging off\n"
"       set logging file FILNAMN\n"
"       set logging overwrite [on|off]\n"
"       set logging redirect [on|off]\n"

#: cli/cli-logging.c:296
#, possible-c-format
msgid "Currently logging to \"%s\".\n"
msgstr "Loggar för närvarande till \"%s\"\n"

#: cli/cli-logging.c:299
#, possible-c-format
