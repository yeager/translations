msgid "Print the status of the floating point unit\n"
msgstr "Skriv ut status för flyttalsenheten.\n"

#: infcmd.c:3183
msgid "Print the status of the vector unit\n"
msgstr "Skriv ut status för vektorenheten.\n"

#: infcmd.c:3186
msgid ""
"Show /proc process information about any running process.\n"
"Specify any process id, or use the program being debugged by default."
msgstr ""
"Visa /proc-processinformation om en godtycklig körande process.\n"
"Ange valfritt process-ID eller använd det felsökta programmet som standard."

#. allow-unknown
#: infcmd.c:3192
msgid "List of mapped memory regions."
msgstr "Lista över mappade minnesregioner."

