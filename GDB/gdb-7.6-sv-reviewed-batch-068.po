msgstr "Det stoppade vid brytpunkten %d.\n"

#: infcmd.c:1862
#, possible-c-format
msgid "It stopped with signal %s, %s.\n"
msgstr "Det stoppade med signal %s, %s.\n"

#: infcmd.c:1869
msgid "Type \"info stack\" or \"info registers\" for more information.\n"
msgstr "Skriv \"info stack\" eller \"info registers\" för mer information\n"

#: infcmd.c:1914
msgid "environment variable and value"
msgstr "miljövariabel och värde"

#: infcmd.c:1938
msgid "environment variable to set"
msgstr "miljövariabel att ställa in"

#: infcmd.c:1960
#, possible-c-format
