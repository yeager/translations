#: cli/cli-dump.c:719
msgid ""
"Write contents of memory to an srec file.\n"
"Arguments are FILE START STOP.  Writes the contents of memory\n"
"within the range [START .. STOP) to the specified FILE in srec format."
msgstr ""
"Skriv innehållet i minnet till en srec-fil.\n"
"Argumenten är FILE START STOP.\n"
"Skriver innehållet i minnet inom intervallet [START .. STOP) till den angivna filen i srec-format."

#: cli/cli-dump.c:725
msgid ""
"Write the value of an expression to an srec file.\n"
"Arguments are FILE EXPRESSION.  Writes the value of EXPRESSION\n"
"to the specified FILE in srec format."
msgstr ""
"Skriv värdet av ett uttryck till en srec-fil.\n"
"Argumenten är FIL UTTRYCK.\n"
"Skriver värdet av UTTRYCK till den angivna FILEN i srec-format."

#: cli/cli-dump.c:731
msgid ""
"Write contents of memory to an ihex file.\n"
"Arguments are FILE START STOP.  Writes the contents of memory within\n"
"the range [START .. STOP) to the specified FILE in intel hex format."
msgstr ""
"Skriv innehållet i minnet till en ihex-fil.\n"
"Argumenten är FILE START STOP.\n"
"Skriver innehållet i minnet inom intervallet [START .. STOP) till den angivna filen i Intel hex-format."

#: cli/cli-dump.c:737
msgid ""
"Write the value of an expression to an ihex file.\n"
"Arguments are FILE EXPRESSION.  Writes the value of EXPRESSION\n"
"to the specified FILE in intel hex format."
msgstr ""
"Skriv värdet av ett uttryck till en ihex-fil.\n"
"Argumenten är FIL UTTRYCK.\n"
"Skriver värdet av UTTRYCK till den angivna FILEN i Intel hex-format."

#: cli/cli-dump.c:743
msgid ""
"Write contents of memory to a tekhex file.\n"
"Arguments are FILE START STOP.  Writes the contents of memory\n"
"within the range [START .. STOP) to the specified FILE in tekhex format."
msgstr ""
"Skriv innehållet i minnet till en tekhex-fil.\n"
"Argumenten är FILE START STOP.\n"
"Skriver innehållet i minnet inom intervallet [START .. STOP) till den angivna filen i tekhex-format."

#: cli/cli-dump.c:749
msgid ""
"Write the value of an expression to a tekhex file.\n"
"Arguments are FILE EXPRESSION.  Writes the value of EXPRESSION\n"
"to the specified FILE in tekhex format."
msgstr ""
"Skriv värdet av ett uttryck till en tekhex-fil.\n"
"Argumenten är FIL UTTRYCK.\n"
"Skriver värdet av UTTRYCK till den angivna FILEN i tekhex-format."

#: cli/cli-dump.c:755
msgid ""
"Write contents of memory to a raw binary file.\n"
"Arguments are FILE START STOP.  Writes the contents of memory\n"
"within the range [START .. STOP) to the specified FILE in binary format."
msgstr ""
"Skriv innehållet i minnet till en rå binärfil.\n"
"Argumenten är FILE START STOP.\n"
"Skriver innehållet i minnet inom intervallet [START .. STOP) till den angivna filen FILE i binärt format."

#: cli/cli-dump.c:761
msgid ""
"Write the value of an expression to a raw binary file.\n"
"Arguments are FILE EXPRESSION.  Writes the value of EXPRESSION\n"
"to the specified FILE in raw target ordered bytes."
msgstr ""
"Skriv värdet av ett uttryck till en rå binärfil.\n"
"Argumenten är FIL UTTRYCK.\n"
"Skriver värdet av UTTRYCK till den angivna FILEN i råa målordnade byte."

#: cli/cli-dump.c:767
msgid ""
"Append contents of memory to a raw binary file.\n"
"Arguments are FILE START STOP.  Writes the contents of memory within the\n"
"range [START .. STOP) to the specified FILE in raw target ordered bytes."
msgstr ""
"Lägg till innehållet i minnet till en rå binärfil.\n"
"Argumenten är FILE START STOP.\n"
"Skriver innehållet i minnet inom intervallet [START .. STOP) till den angivna filen FILE i råa målordnade byte."

#: cli/cli-dump.c:773
msgid ""
"Append the value of an expression to a raw binary file.\n"
"Arguments are FILE EXPRESSION.  Writes the value of EXPRESSION\n"
"to the specified FILE in raw target ordered bytes."
msgstr ""
"Lägg till värdet av ett uttryck till en rå binärfil.\n"
"Argumenten är FIL UTTRYCK.\n"
"Skriver värdet av UTTRYCK till den angivna FILEN i råa målordnade byte."

#: cli/cli-dump.c:779
msgid ""
"Restore the contents of FILE to target memory.\n"
"Arguments are FILE OFFSET START END where all except FILE are optional.\n"
"OFFSET will be added to the base address of the file (default zero).\n"
"If START and END are given, only the file contents within that range\n"
"(file relative) will be restored to target memory."
msgstr ""
"Återställ innehållet i FIL till målminnet.\n"
"Argumenten är FIL OFFSET START SLUT, där alla argument utom FIL är valfria.\n"
"OFFSET läggs till filens basadress (standard är noll).\n"
"Om START och SLUT anges återställs bara filinnehållet inom det intervallet\n"
"(filrelativt) till målminnet."

