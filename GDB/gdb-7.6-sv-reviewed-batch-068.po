#: thread.c:1468
msgid ""
"Display currently known threads.\n"
"Usage: info threads [ID]...\n"
"Optional arguments are thread IDs with spaces between.\n"
"If no arguments, all threads are displayed."
msgstr ""
"Visa aktuella kända trådar.\n"
"Användning: info threads [ID]...\n"
"Valfria argument är tråd-ID:n med mellanslag mellan.\n"
"Om inga argument anges visas alla trådar."

#: thread.c:1473
msgid ""
"Use this command to switch between threads.\n"
"The new thread ID must be currently known."
msgstr ""
"Använd kommandot för att växla mellan trådar.\n"
"Det nya tråd-ID:t måste vara känt för tillfället."

#: thread.c:1479
msgid "Apply a command to a list of threads."
msgstr "Tillämpa ett kommando på en lista med trådar."

#: thread.c:1483
msgid "Apply a command to all threads."
msgstr "Tillämpa ett kommando på alla trådar."

#: thread.c:1486
msgid ""
"Set the current thread's name.\n"
"Usage: thread name [NAME]\n"
"If NAME is not given, then any existing name is removed."
msgstr ""
"Ange namnet på den aktuella tråden.\n"
"Användning: thread name [NAME]\n"
"Om NAME inte anges tas befintligt namn bort."

#: thread.c:1490
msgid ""
"Find threads that match a regular expression.\n"
"Usage: thread find REGEXP\n"
"Will display thread ids whose name, target ID, or extra info matches REGEXP."
msgstr ""
"Hitta trådar som matchar ett reguljärt uttryck.\n"
"Användning: thread find REGEXP\n"
"Visar tråd-ID:n vars namn, mål-ID eller extrainformation matchar REGEXP."

#: thread.c:1500
