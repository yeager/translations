#: remote.c:11716
msgid "Set interrupt sequence to remote target."
msgstr "Ställ in avbrottssekvensen till fjärrmålet."

#: remote.c:11717
msgid "Show interrupt sequence to remote target."
msgstr "Visa avbrottssekvens till fjärrmål."

#: remote.c:11718
msgid "Valid value is \"Ctrl-C\", \"BREAK\" or \"BREAK-g\". The default is \"Ctrl-C\"."
msgstr ""
"Giltiga värden är \"Ctrl-C\", \"BREAK\" eller \"BREAK-g\". Standardvärdet är"
" \"Ctrl-C\"."

#: remote.c:11725
