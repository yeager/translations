#, possible-c-format
msgid "[%s exited]\n"
msgstr "[%s avslutades]\n"

#: inf-ttrace.c:1115
#, possible-c-format
msgid "[%s has been terminated]\n"
msgstr "[%s har avslutats]\n"

#: interps.c:154
#, possible-c-format
msgid "Could not suspend interpreter \"%s\"."
msgstr "Kunde inte avbryta tolken \"%s\"."

#: interps.c:199
#, possible-c-format
msgid "Failed to initialize new interp \"%s\" %s"
msgstr "Misslyckades med att initialisera ny interp \"%s\" %s"

#: interps.c:414
msgid "interpreter-exec command"
msgstr "interpreter-exec-kommando"

#: interps.c:424
msgid "usage: interpreter-exec <interpreter> [ <command> ... ]"
msgstr "användning: interpreter-exec <interpreter> [ <command> ... ]"

#: interps.c:430
#, possible-c-format
msgid "Could not find interpreter \"%s\"."
msgstr "Kunde inte hitta tolken \"%s\"."

#: interps.c:437
#, possible-c-format
msgid "Could not switch to interpreter \"%s\"."
msgstr "Det gick inte att växla till tolken \"%s\"."

#: interps.c:448
#, possible-c-format
msgid "error in command: \"%s\"."
msgstr "fel i kommandot: \"%s\"."

#: interps.c:514
msgid ""
"Execute a command in an interpreter.  It takes two arguments:\n"
"The first argument is the name of the interpreter to use.\n"
"The second argument is the command to execute.\n"
msgstr ""
"Kör ett kommando i en tolk. Det tar två argument:\n"
"Det första argumentet är namnet på tolken som ska användas.\n"
"Det andra argumentet är kommandot som ska köras.\n"

#: iq2000-tdep.c:488
#, possible-c-format
msgid "breakpoint_from_pc: invalid breakpoint address 0x%lx"
msgstr "breakpoint_from_pc: ogiltig brytpunktsadress 0x%lx"

#: jit.c:70
#, possible-c-format
msgid "JIT debugging is %s.\n"
msgstr "JIT-felsökning är %s.\n"

#: jit.c:175
#, possible-c-format
msgid "Opening shared object %s.\n"
msgstr "Öppnar delat objekt %s.\n"

#: jit.c:182
#, possible-c-format
msgid "Could not locate initialization function: %s."
msgstr "Kunde inte hitta initialiseringsfunktionen: %s."

#: jit.c:186
msgid "Reader not GPL compatible."
msgstr "Läsaren är inte kompatibel med GPL."

#: jit.c:190
msgid "Reader version does not match GDB version."
msgstr "Läsarversionen stämmer inte överens med GDB-versionen."

#: jit.c:209
msgid "No reader name provided."
msgstr "Inget läsarnamn angivet."

#: jit.c:212
msgid "JIT reader already loaded.  Run jit-reader-unload first."
msgstr "JIT-läsaren är redan laddad. Kör först jit-reader-unload."

#: jit.c:230
msgid "No JIT reader loaded."
msgstr "Ingen JIT-läsare laddad."

#: jit.c:373
msgid "Unable to read JIT descriptor from remote memory\n"
msgstr "Kan inte läsa JIT-deskriptorn från fjärrminnet.\n"

#: jit.c:418
msgid "Unable to read JIT code entry from remote memory!"
msgstr "Det går inte att läsa JIT-kod från fjärrminnet!"

#: jit.c:891
msgid "Error opening JITed symbol file, ignoring it.\n"
msgstr "Fel vid öppning av JIT-symbolfil, ignorerar den.\n"

#: jit.c:899
msgid "JITed symbol file is not an object file, ignoring it.\n"
msgstr "JITed-symbolfilen är inte en objektfil, ignorerar den.\n"

#: jit.c:908
#, possible-c-format
msgid ""
"JITed object file architecture %s is not compatible with target architecture"
" %s."
msgstr ""
"JIT-objektfilarkitekturen %s är inte kompatibel med målarkitekturen %s."

#: jit.c:1097
