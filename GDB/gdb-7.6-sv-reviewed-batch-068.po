msgstr "Om inställt skriver loggningen över loggfilen."

#: cli/cli-logging.c:344
msgid "Set the logging output mode."
msgstr "Ställ in loggningsutmatningsläget."

#: cli/cli-logging.c:345
msgid "Show the logging output mode."
msgstr "Visa loggningsutmatningsläget."

#: cli/cli-logging.c:346
msgid ""
"If redirect is off, output will go to both the screen and the log file.\n"
"If redirect is on, output will go only to the log file."
msgstr ""
"Om omdirigering är av skickas utdata både till skärmen och loggfilen.\n"
"Om omdirigering är på skickas utdata bara till loggfilen."

#: cli/cli-logging.c:352
msgid "Set the current logfile."
msgstr "Ställ in aktuell loggfil."

#: cli/cli-logging.c:353
msgid "Show the current logfile."
msgstr "Visa den aktuella loggfilen."

#: cli/cli-logging.c:354
msgid "The logfile is used when directing GDB's output."
msgstr "Loggfilen används när man styr GDB:s utdata."

#: cli/cli-logging.c:360
msgid "Enable logging."
msgstr "Aktivera loggning."

#: cli/cli-logging.c:362
msgid "Disable logging."
msgstr "Inaktivera loggning."

