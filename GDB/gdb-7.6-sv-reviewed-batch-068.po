#: main.c:1070
msgid ""
"This is the GNU debugger.  Usage:\n"
"\n"
"    gdb [options] [executable-file [core-file or process-id]]\n"
"    gdb [options] --args executable-file [inferior-arguments ...]\n"
"\n"
"Options:\n"
"\n"
msgstr ""
"Detta är GNU-felsökaren. Användning:\n"
"\n"
"    gdb [flaggor] [körbar fil [kärnfil eller process-ID]]\n"
"    gdb [flaggor] --args körbar fil [underordnade argument ...]\n"
"\n"
"Flaggor:\n"
"\n"

#: main.c:1076
msgid ""
"  --args             Arguments after executable-file are passed to "
"inferior\n"
msgstr ""
"  --args             Argument efter körbar fil skickas till det underordnade"
" programmet\n"

#: main.c:1079
msgid ""
"  -b BAUDRATE        Set serial port baud rate used for remote debugging.\n"
"  --batch            Exit after processing options.\n"
"  --batch-silent     As for --batch, but suppress all gdb stdout output.\n"
"  --return-child-result\n"
"                     GDB exit code will be the child's exit code.\n"
"  --cd=DIR           Change current directory to DIR.\n"
"  --command=FILE, -x Execute GDB commands from FILE.\n"
"  --eval-command=COMMAND, -ex\n"
"                     Execute a single GDB command.\n"
"                     May be used multiple times and in conjunction\n"
"                     with --command.\n"
"  --init-command=FILE, -ix Like -x but execute it before loading inferior.\n"
"  --init-eval-command=COMMAND, -iex Like -ex but before loading inferior.\n"
"  --core=COREFILE    Analyze the core dump COREFILE.\n"
"  --pid=PID          Attach to running process PID.\n"
msgstr ""
"  -b BAUDRATE        Ställ in baudhastigheten för seriell port vid fjärrfelsökning.\n"
"  --batch            Avsluta efter att flaggorna har bearbetats.\n"
"  --batch-silent     Som --batch, men undertryck all standardutdata från GDB.\n"
"  --return-child-result\n"
"                     GDB:s avslutningskod blir barnprocessens avslutningskod.\n"
"  --cd=DIR           Byt aktuell katalog till DIR.\n"
"  --command=FILE, -x Kör GDB-kommandon från FILE.\n"
"  --eval-command=COMMAND, -ex\n"
"                     Kör ett GDB-kommando.\n"
"                     Kan användas flera gånger tillsammans\n"
"                     med --command.\n"
"  --init-command=FILE, -ix Som -x, men kör det innan det underordnade programmet läses in.\n"
"  --init-eval-command=COMMAND, -iex Som -ex, men innan det underordnade programmet läses in.\n"
"  --core=COREFILE    Analysera kärndumpen COREFILE.\n"
"  --pid=PID          Anslut till den körande processen PID.\n"

#: main.c:1096
msgid ""
"  --dbx              DBX compatibility mode.\n"
"  --directory=DIR    Search for source files in DIR.\n"
"  --exec=EXECFILE    Use EXECFILE as the executable.\n"
"  --fullname         Output information used by emacs-GDB interface.\n"
"  --help             Print this message.\n"
msgstr ""
"  --dbx              DBX-kompatibilitetsläge.\n"
"  --directory=DIR    Sök efter källfiler i DIR.\n"
"  --exec=EXECFILE    Använd EXECFILE som körbar fil.\n"
"  --fullname         Skriv ut information som används av gränssnittet emacs-GDB.\n"
"  --help             Skriv ut detta meddelande.\n"

#: main.c:1103
msgid ""
"  --interpreter=INTERP\n"
"                     Select a specific interpreter / user interface\n"
msgstr ""
"  --interpreter=INTERP\n"
"                     Välj en specifik tolk eller ett användargränssnitt\n"

#: main.c:1107
msgid ""
"  -l TIMEOUT         Set timeout in seconds for remote debugging.\n"
"  --nw\t\t     Do not use a window interface.\n"
"  --nx               Do not read any "
msgstr ""
"  -l TIMEOUT         Ställ in tidsgränsen i sekunder för fjärrfelsökning.\n"
"  --nw\t\t     Använd inte ett fönstergränssnitt.\n"
"  --nx               Läs inga "

#: main.c:1112
msgid ""
" files.\n"
"  --nh               Do not read "
msgstr ""
" filer.\n"
"  --nh               Läs ingen "

#: main.c:1115
msgid ""
" file from home directory.\n"
"  --quiet            Do not print version number on startup.\n"
"  --readnow          Fully read symbol files on first access.\n"
msgstr ""
" fil från hemkatalogen.\n"
"  --quiet            Skriv inte ut versionsnumret vid start.\n"
"  --readnow          Läs in symbolfiler helt vid första åtkomst.\n"

#: main.c:1119
msgid ""
"  --se=FILE          Use FILE as symbol file and executable file.\n"
"  --symbols=SYMFILE  Read symbols from SYMFILE.\n"
"  --tty=TTY          Use TTY for input/output by the program being debugged.\n"
msgstr ""
"  --se=FILE          Använd FILE som symbolfil och körbar fil.\n"
"  --symbols=SYMFILE  Läs symboler från SYMFILE.\n"
"  --tty=TTY          Använd TTY för in- och utdata från programmet som felsöks.\n"

#: main.c:1125
msgid "  --tui              Use a terminal user interface.\n"
msgstr "  --tui              Använd ett terminalanvändargränssnitt.\n"

#: main.c:1129
msgid ""
"  --version          Print version information and then exit.\n"
"  -w                 Use a window interface.\n"
"  --write            Set writing into executable and core files.\n"
"  --xdb              XDB compatibility mode.\n"
msgstr ""
"  --version          Skriv ut versionsinformation och avsluta sedan.\n"
"  -w                 Använd ett fönstergränssnitt.\n"
"  --write            Aktivera skrivning till körbara filer och kärnfiler.\n"
"  --xdb              XDB-kompatibilitetsläge.\n"

