msgid "List process info from /proc/PID/stat."
msgstr "Lista processinformation från /proc/PID/stat."

#: infcmd.c:3200
msgid "List process info from /proc/PID/status."
msgstr "Lista processinformation från /proc/PID/status."

#: infcmd.c:3204
msgid "List current working directory of the process."
msgstr "Visa processens aktuella arbetskatalog."

#: infcmd.c:3208
msgid "List command line arguments of the process."
