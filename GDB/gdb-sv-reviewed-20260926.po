msgstr "Rad %ps finns inte i `%s'. Hoppa ändå? "

#: infcmd.c:1122
msgid "WARNING!!!  Destination is in unmapped overlay!  Jump anyway? "
msgstr "VARNING!!! Målet finns i en omappad överlagring! Hoppa ändå? "

#: infcmd.c:1135
msgid "Continuing at "
msgstr "Fortsätter vid "

#: infcmd.c:1166 infcmd.c:1255
