#, possible-c-format
msgid ""
"Single stepping until exit from function %s,\n"
"which has no line number information.\n"
msgstr "Stegkör tills funktionen %s avslutas,\nsom saknar radnummerinformation.\n"

#: infcmd.c:1071
msgid "starting address"
msgstr "startadress"

#: infcmd.c:1087
msgid "Jump request is ambiguous: does not resolve to a single address"
msgstr "Hoppbegäran är tvetydig: den kan inte lösas till en enda adress"

#: infcmd.c:1094
msgid "No source file has been specified."
msgstr "Ingen källfil har angetts."

#: infcmd.c:1104
#, possible-c-format
