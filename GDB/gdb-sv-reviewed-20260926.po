msgstr "Spårningen stoppades av ett fel (%s, spårpunkt %d).\n"

#: tracepoint.c:1795
#, possible-c-format
msgid "Trace stopped by an error (%s).\n"
msgstr "Spårningen stoppades av ett fel (%s).\n"

#: tracepoint.c:1799
msgid "Trace stopped for an unknown reason.\n"
msgstr "Spårningen stoppades av okänd anledning.\n"

#: tracepoint.c:1802
#, possible-c-format
msgid "Trace stopped for some other reason (%d).\n"
msgstr "Spårningen avbröts av någon annan anledning (%d).\n"

#: tracepoint.c:1811
#, possible-c-format
msgid "Buffer contains %d trace frames (of %d created total).\n"
msgstr "Buffert innehåller %d spårningsramar (av totalt %d skapade).\n"

#: tracepoint.c:1817
#, possible-c-format
msgid "Collected %d trace frames.\n"
msgstr "Samlade in %d spårningsramar.\n"

#: tracepoint.c:1825
#, possible-c-format
msgid "Trace buffer has %d bytes of %d bytes free"
msgstr "Spårningsbufferten har %d bytes av %d bytes lediga"

#: tracepoint.c:1828
#, possible-c-format
msgid " (%d%% full)"
msgstr " (%d%% full)"

#: tracepoint.c:1835
#, possible-c-format
msgid "Trace buffer has %d bytes free.\n"
msgstr "Spårningsbufferten har %d bytes lediga.\n"

#: tracepoint.c:1840
msgid "Trace will continue if GDB disconnects.\n"
msgstr "Spårningen fortsätter om GDB kopplas bort.\n"

#: tracepoint.c:1842
msgid "Trace will stop if GDB disconnects.\n"
msgstr "Spårningen stoppas om GDB kopplas bort.\n"

#: tracepoint.c:1845
msgid "Trace buffer is circular.\n"
msgstr "Spårningsbufferten är cirkulär.\n"

#: tracepoint.c:1848
#, possible-c-format
msgid "Trace user is %s.\n"
msgstr "Spårningsanvändaren är %s.\n"

#: tracepoint.c:1851
#, possible-c-format
msgid "Trace notes: %s.\n"
msgstr "Spårningsanteckningar: %s.\n"

#: tracepoint.c:1855
#, possible-c-format
msgid "Looking at trace frame %d, tracepoint %d.\n"
msgstr "Tittar på spårningsram %d, spårningspunkt %d.\n"

#: tracepoint.c:1858
