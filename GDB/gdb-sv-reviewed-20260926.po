msgstr "Spårningen stoppades eftersom bufferten var full.\n"

#: tracepoint.c:1783
msgid "Trace stopped because of disconnection.\n"
msgstr "Spårningen stoppades på grund av frånkoppling.\n"

#: tracepoint.c:1786
#, possible-c-format
