#, possible-c-format
msgid "Trace started at %ld.%06ld secs, stopped %ld.%06ld secs later.\n"
msgstr ""
"Spårningen startade vid %ld.%06ld sekunder och stoppades %ld.%06ld sekunder "
"senare.\n"

#: tracepoint.c:1875
#, possible-c-format
msgid "Trace started at %ld.%06ld secs.\n"
msgstr "Spårningen startade vid %ld.%06ld sekunder.\n"

#: tracepoint.c:1880
#, possible-c-format
msgid "Trace stopped at %ld.%06ld secs.\n"
msgstr "Spårningen stoppades vid %ld.%06ld sekunder.\n"

#: tracepoint.c:2036
msgid "Trace is running and will continue after detach; detach anyway? "
msgstr "Spårningen körs och fortsätter efter frånkoppling; koppla från ändå?"

#: tracepoint.c:2042
msgid "Trace is running but will stop on detach; detach anyway? "
msgstr "Spårningen körs men stoppas vid frånkoppling; koppla från ändå?"

#: tracepoint.c:2117
msgid "Target failed to find requested trace frame."
msgstr "Målet kunde inte hitta den begärda spårramen."

#: tracepoint.c:2159
#, possible-c-format
msgid "Found trace frame %d, tracepoint %d\n"
msgstr "Hittade spårningsram %d, spårningspunkt %d\n"

#: tracepoint.c:2168
msgid "No longer looking at any trace frame\n"
msgstr "Tittar inte längre på någon spårram\n"

#. This case may never occur, check.
#: tracepoint.c:2170
msgid "No trace frame found\n"
msgstr "Ingen spårram hittades\n"

#: tracepoint.c:2203 tracepoint.c:2431
msgid "May not look at trace frames while trace is running."
msgstr "Får inte titta på spårningsramar medan spårningen pågår."

#: tracepoint.c:2238
msgid "not debugging trace buffer"
msgstr "inte felsökning av spårningsbuffert"

#: tracepoint.c:2240
msgid "already at start of trace buffer"
msgstr "redan i början av spårningsbufferten"

#: tracepoint.c:2251
#, possible-c-format
msgid "invalid input (%d is less than zero)"
msgstr "ogiltig inmatning (%d är mindre än noll)"

#: tracepoint.c:2304
msgid "No current tracepoint -- please supply an argument."
msgstr "Ingen aktuell spårpunkt – ange ett argument."

#: tracepoint.c:2347
msgid "No line number information available."
msgstr "Ingen information om linjenummer tillgänglig."

#: tracepoint.c:2371
msgid "Cannot find a good line."
msgstr "Kan inte hitta en bra linje."

#. Is there any case in which we get here, and have an address
#. which the user would want to see?  If we have debugging
#. symbols and no line numbers?
#: tracepoint.c:2379
#, possible-c-format
msgid "Line number %d is out of range for \"%s\"."
msgstr "Radnummer %d ligger utanför intervallet för \"%s\"."

#: tracepoint.c:2469
msgid "requires an argument (function, line or *addr) to define a scope"
msgstr "kräver ett argument (funktion, rad eller *addr) för att definiera en räckvidd"

#: tracepoint.c:2724
msgid "No current trace frame."
msgstr "Ingen aktuell spårram."

#: tracepoint.c:2729
#, possible-c-format
msgid "No known tracepoint matches 'current' tracepoint #%d."
msgstr "Ingen känd spårpunkt matchar den ”aktuella” spårpunkten #%d."

#: tracepoint.c:2819
msgid "Buffer too small for source encoding"
msgstr "Buffert för liten för källkodning"

#: tracepoint.c:2824
msgid "Source string too long for buffer"
msgstr "Källsträngen för lång för bufferten"

#: tracepoint.c:2862
msgid "Target does not support trace notes, user ignored"
msgstr "Målet stöder inte spårningsanteckningar, användaren ignoreras"

#: tracepoint.c:2886
msgid "Target does not support trace notes, stop note ignored"
msgstr "Målet stöder inte spårnoter, stoppnoter ignoreras"

#: tracepoint.c:2918
msgid "could not change traceframe"
msgstr "kunde inte ändra spårram"

#: tracepoint.c:3067
#, possible-c-format
msgid "Assuming tracepoint %d is same as target's tracepoint %d at %s.\n"
msgstr "Antar att spårpunkt %d är samma som målets spårpunkt %d på %s.\n"

#: tracepoint.c:3090
#, possible-c-format
msgid "Created tracepoint %d for target's tracepoint %d at %s.\n"
msgstr "Skapade spårpunkt %d för målets spårpunkt %d på %s.\n"

#: tracepoint.c:3095
#, possible-c-format
msgid ""
"Failed to create tracepoint for target's tracepoint %d at %s, skipping it.\n"
msgstr "Kunde inte skapa spårpunkt för målets spårpunkt %d vid %s; hoppar över den.\n"

#: tracepoint.c:3181
#, possible-c-format
msgid "Assuming trace state variable $%s is same as target's variable %d.\n"
msgstr ""
"Antar att spårningsstatusvariabeln $%s är densamma som målets variabel %d.\n"

#: tracepoint.c:3189
#, possible-c-format
msgid "Created trace state variable $%s for target's variable %d.\n"
msgstr "Skapade spårningsstatusvariabeln $%s för målets variabel %d.\n"

#: tracepoint.c:3242
#, possible-c-format
msgid ""
"Malformed trace status, at %s\n"
"Status line: '%s'\n"
msgstr ""
"Missbildad spårningsstatus, vid %s\n"
"Statusrad: \"%s\n"

#: tracepoint.c:3452
#, possible-c-format
msgid "Unrecognized char '%c' in tracepoint definition, skipping rest"
msgstr "Oigenkänt tecken '%c' i spårpunktsdefinitionen; hoppar över resten"

#. Don't error out, the target might be sending us optional
#. info that we don't care about.
#: tracepoint.c:3506
#, possible-c-format
msgid "Unrecognized tracepoint piece '%c', ignoring"
msgstr "Oigenkänd spårpunktsdel '%c'; ignoreras"

#: tracepoint.c:3561
#, possible-c-format
msgid "bad marker definition: %s"
msgstr "dålig markördefinition: %s"

#: tracepoint.c:3659
msgid "Data: \""
msgstr "Data: \""

#: tracepoint.c:3671
msgid "Probed by static tracepoints: "
msgstr "Provas av statiska tracepoints: "

#: tracepoint.c:3765
msgid ""
"Can not parse XML trace frame info; XML support was disabled at compile time"
msgstr ""
"Kan inte tolka XML-information om spårningsram; XML-stöd inaktiverades vid "
"kompileringstillfället"

#: tracepoint.c:3847
msgid "trace frame info"
msgstr "spårramsinformation"

#: tracepoint.c:3936
msgid "List the variables local to a scope."
msgstr "Lista variablerna som är lokala för ett område."

#: tracepoint.c:3939
msgid "Tracing of program execution without stopping the program."
msgstr "Spårning av programkörning utan att programmet stoppas."

#: tracepoint.c:3943
msgid "Print everything collected at the current tracepoint."
msgstr "Skriv ut allt som samlats in vid den aktuella spårpunkten."

#: tracepoint.c:3945
msgid ""
"Define a trace state variable.\n"
"Argument is a $-prefixed name, optionally followed\n"
"by '=' and an expression that sets the initial value\n"
"at the start of tracing."
msgstr ""
"Definiera en variabel för spårningstillstånd.\n"
"Argumentet är ett $-prefixerat namn, eventuellt följt av\n"
"av '=' och ett uttryck som anger det initiala värdet vid\n"
"i början av spårningen."

#: tracepoint.c:3952
msgid ""
"Delete one or more trace state variables.\n"
"Arguments are the names of the variables to delete.\n"
"If no arguments are supplied, delete all variables."
msgstr ""
"Ta bort en eller flera spårningsstatusvariabler.\n"
"Argumenten är namnen på de variabler som ska raderas.\n"
"Om inga argument anges raderas alla variabler."

#. FIXME add a trace variable completer.
#: tracepoint.c:3958
msgid "Status of trace state variables and their values."
msgstr "Status för spårningsvariabler och deras värden."

#: tracepoint.c:3962
msgid "List target static tracepoints markers."
msgstr "Lista statiska spårningspunkter."

#: tracepoint.c:3965
msgid ""
"Select a trace frame.\n"
"No argument means forward by one frame; '-' means backward by one frame."
msgstr ""
"Välj en spårram. Inget\n"
"argument innebär framåt med en ram; '-' innebär bakåt med en ram."

#: tracepoint.c:3970
msgid ""
"Select a trace frame whose PC is outside the given range (exclusive).\n"
"Usage: tfind outside ADDR1, ADDR2"
msgstr ""
"Välj en spårram vars PC ligger utanför det angivna intervallet (exklusivt).\n"
"Användning: tfind outside ADDR1, ADDR2"

#: tracepoint.c:3975
msgid ""
"Select a trace frame whose PC is in the given range (inclusive).\n"
"Usage: tfind range ADDR1, ADDR2"
msgstr ""
"Välj en spårram vars PC ligger inom det angivna intervallet (inklusive).\n"
"Användning: tfind range ADDR1, ADDR2"

#: tracepoint.c:3980
msgid ""
"Select a trace frame by source line.\n"
"Argument can be a line number (with optional source file),\n"
"a function name, or '*' followed by an address.\n"
"Default argument is 'the next source line that was traced'."
msgstr ""
"Välj en spårningsram per källrad.\n"
"Argumentet kan vara ett radnummer (med valfri källfil),\n"
"ett funktionsnamn eller '*' följt av en adress.\n"
"Standardargumentet är \"nästa källrad som spårades\"."

#: tracepoint.c:3987
msgid ""
"Select a trace frame by tracepoint number.\n"
"Default is the tracepoint for the current trace frame."
msgstr "Välj en spårram efter spårpunktsnummer.\nStandardvärdet är spårpunkten för den aktuella spårramen."

#: tracepoint.c:3992
msgid ""
"Select a trace frame by PC.\n"
"Default is the current PC, or the PC of the current trace frame."
msgstr ""
"Välj en spårningsram efter PC.\n"
"Standard är aktuell PC, eller PC för aktuell spårningsram."

#: tracepoint.c:3998
msgid "De-select any trace frame and resume 'live' debugging."
msgstr "Avmarkera alla spårramar och återuppta ”live”-felsökning."

#: tracepoint.c:4004
msgid "Select the first trace frame in the trace buffer."
msgstr "Välj den första spårningsramen i spårningsbufferten."

#: tracepoint.c:4008
msgid "Display the status of the current trace data collection."
msgstr "Visar status för den aktuella insamlingen av spårningsdata."

#: tracepoint.c:4010
msgid ""
"Stop trace data collection.\n"
"Usage: tstop [NOTES]...\n"
"Any arguments supplied are recorded with the trace as a stop reason and\n"
"reported by tstatus (if the target supports trace notes)."
msgstr ""
"Stoppa insamlingen av spårningsdata.\n"
"Användning: tstop [NOTES]...\n"
"Alla angivna argument registreras med spårningen som en orsak till stoppet "
"och\n"
"rapporteras av tstatus (om målet stöder spårningsanteckningar)."

#: tracepoint.c:4016
msgid ""
"Start trace data collection.\n"
"Usage: tstart [NOTES]...\n"
"Any arguments supplied are recorded with the trace as a note and\n"
"reported by tstatus (if the target supports trace notes)."
msgstr ""
"Starta insamling av spårningsdata.\n"
"Användning: tstart [NOTES]...\n"
"Alla angivna argument registreras med spårningen som en anteckning och\n"
"rapporteras av tstatus (om målet stöder spårningsanteckningar)."

#: tracepoint.c:4022
msgid ""
"Ends a list of commands or actions.\n"
"Several GDB commands allow you to enter a list of commands or actions.\n"
"Entering \"end\" on a line by itself is the normal way to terminate\n"
"such a list.\n"
"\n"
"Note: the \"end\" command cannot be used at the gdb prompt."
msgstr ""
"Avslutar en lista med kommandon eller åtgärder.\n"
"Flera GDB-kommandon låter dig ange en lista med kommandon eller åtgärder.\n"
"Att skriva \"end\" på en rad för sig själv är det normala sättet att "
"avsluta\n"
"en sådan lista.\n"
"\n"
"Observera: kommandot \"end\" kan inte användas vid GDB-prompten."

#: tracepoint.c:4030
msgid ""
"Specify single-stepping behavior at a tracepoint.\n"
"Argument is number of instructions to trace in single-step mode\n"
"following the tracepoint.  This command is normally followed by\n"
"one or more \"collect\" commands, to specify what to collect\n"
"while single-stepping.\n"
"\n"
"Note: this command can only be used in a tracepoint \"actions\" list."
msgstr "Ange enkelstegsbeteende vid en spårpunkt.\nArgumentet är antalet instruktioner som ska spåras i enkelstegsläge\nefter spårpunkten. Det här kommandot följs normalt av\nett eller flera ”collect”-kommandon för att ange vad som ska samlas in\nvid enkelstegning.\n\nObs: det här kommandot kan endast användas i en spårpunkts ”actions”-lista."

#: tracepoint.c:4041
msgid ""
"Specify one or more data items to be collected at a tracepoint.\n"
"Accepts a comma-separated list of (one or more) expressions.  GDB will\n"
"collect all data (variables, registers) referenced by that expression.\n"
"Also accepts the following special arguments:\n"
"    $regs   -- all registers.\n"
"    $args   -- all function arguments.\n"
"    $locals -- all variables local to the block/function scope.\n"
"    $_sdata -- static tracepoint data (ignored for non-static tracepoints).\n"
"Note: this command can only be used in a tracepoint \"actions\" list."
msgstr ""
"Ange ett eller flera dataobjekt som ska samlas in vid en tracepoint.\n"
"Accepterar en kommaseparerad lista med (ett eller flera) uttryck.  GDB "
"kommer att\n"
"samla in alla data (variabler, register) som refereras till av det här "
"uttrycket.\n"
"Accepterar även följande specialargument:\n"
"    $regs -- alla register.\n"
"    $args -- alla funktionsargument.\n"
"    $locals -- alla variabler som är lokala för blockets/funktionens "
"omfattning.\n"
"    $_sdata -- statiska tracepoint-data (ignoreras för icke-statiska "
"tracepoints).\n"
"Observera: det här kommandot kan endast användas i en tracepoint-\"actions\"-"
"lista."

#: tracepoint.c:4052
msgid ""
"Specify one or more expressions to be evaluated at a tracepoint.\n"
"Accepts a comma-separated list of (one or more) expressions.\n"
"The result of each evaluation will be discarded.\n"
"Note: this command can only be used in a tracepoint \"actions\" list."
msgstr ""
"Ange ett eller flera uttryck som ska utvärderas vid en tracepoint.\n"
"Accepterar en kommaseparerad lista med (ett eller flera) uttryck.\n"
"Resultatet av varje utvärdering kommer att kasseras.\n"
"Obs: det här kommandot kan endast användas i en lista över \"åtgärder\" för "
"en tracepoint."

#: tracepoint.c:4058
msgid ""
"Specify the actions to be taken at a tracepoint.\n"
"Tracepoint actions may include collecting of specified data,\n"
"single-stepping, or enabling/disabling other tracepoints,\n"
"depending on target's capabilities."
msgstr ""
"Ange vilka åtgärder som ska vidtas vid en tracepoint.\n"
"Tracepoint-åtgärder kan omfatta insamling av specificerade data,\n"
"enkelsteg, eller aktivera/inaktivera andra tracepoints,\n"
"beroende på målets kapacitet."

#: tracepoint.c:4065
msgid "Set the list of expressions to collect by default."
msgstr "Ställ in listan över uttryck som ska samlas in som standard."

#: tracepoint.c:4066
msgid "Show the list of expressions to collect by default."
msgstr "Visa listan över uttryck som ska samlas in som standard."

#: tracepoint.c:4072
msgid "Set whether tracing continues after GDB disconnects."
msgstr "Ange om spårningen ska fortsätta efter att GDB kopplas från."

#: tracepoint.c:4073
msgid "Show whether tracing continues after GDB disconnects."
msgstr "Visa om spårningen fortsätter efter att GDB kopplas från."

#: tracepoint.c:4074
msgid ""
"Use this to continue a tracing run even if GDB disconnects\n"
"or detaches from the target.  You can reconnect later and look at\n"
"trace data collected in the meantime."
msgstr ""
"Använd detta för att fortsätta en spårningskörning även om GDB kopplar\n"
"eller kopplas bort från målet.  Du kan återansluta senare och titta på\n"
"spårningsdata som samlats in under tiden."

#: tracepoint.c:4084
msgid "Set target's use of circular trace buffer."
msgstr "Ställ in målets användning av cirkulär spårningsbuffert."

#: tracepoint.c:4085
msgid "Show target's use of circular trace buffer."
msgstr "Visa målets användning av cirkulär spårningsbuffert."

#: tracepoint.c:4086
msgid ""
"Use this to make the trace buffer into a circular buffer,\n"
"which will discard traceframes (oldest first) instead of filling\n"
"up and stopping the trace run."
msgstr ""
"Använd detta för att göra spårningsbufferten till en cirkulär buffert,\n"
"som kasserar spårningsramar (äldst först) istället för att fylla\n"
"och stoppa spårningskörningen."

#: tracepoint.c:4096
msgid "Set requested size of trace buffer."
msgstr "Ställ in önskad storlek på spårningsbufferten."

#: tracepoint.c:4097
msgid "Show requested size of trace buffer."
msgstr "Visa önskad storlek på spårningsbufferten."

#: tracepoint.c:4098
msgid ""
"Use this to choose a size for the trace buffer.  Some targets\n"
"may have fixed or limited buffer sizes.  Specifying \"unlimited\" or -1\n"
"disables any attempt to set the buffer size and lets the target choose."
msgstr "Använd detta för att välja storlek på spårningsbufferten. Vissa mål kan\nha fasta eller begränsade buffertstorlekar. Värdet ”unlimited” eller -1\ninaktiverar alla försök att ställa in buffertstorleken och låter målet välja."

#: tracepoint.c:4106
msgid "Set the user name to use for current and future trace runs."
msgstr ""
"Ställ in användarnamnet som ska användas för nuvarande och framtida "
"spårningskörningar."

#: tracepoint.c:4107
msgid "Show the user name to use for current and future trace runs."
msgstr ""
"Visa användarnamnet som ska användas för nuvarande och framtida "
"spårningskörningar."

#: tracepoint.c:4113
msgid "Set notes string to use for current and future trace runs."
msgstr ""
"Ställ in anteckningssträngen som ska användas för nuvarande och framtida "
"spårningskörningar."

#: tracepoint.c:4114
msgid "Show the notes string to use for current and future trace runs."
msgstr ""
"Visa anteckningssträngen som ska användas för nuvarande och framtida "
"spårningskörningar."

#: tracepoint.c:4120
msgid "Set notes string to use for future tstop commands."
msgstr ""
"Ställ in anteckningssträngen som ska användas för framtida tstop-kommandon."

#: tracepoint.c:4121
msgid "Show the notes string to use for future tstop commands."
msgstr ""
"Visa anteckningssträngen som ska användas för framtida tstop-kommandon."

#: tui/tui-io.c:945
msgid "Cannot create pipe for readline"
msgstr "Kan inte skapa pipe för readline"

#: tui/tui-io.c:949
msgid "Cannot redirect readline output"
msgstr "Kan inte omdirigera readline-utdata"

#: tui/tui-layout.c:342
#, possible-c-format
msgid "Unknown window type \"%s\""
msgstr "Okänd fönstertyp \"%s\""

#: tui/tui-layout.c:346
#, possible-c-format
msgid "Could not create window \"%s\""
msgstr "Kunde inte skapa fönstret \"%s\""

#: tui/tui-layout.c:380
#, possible-c-format
msgid "Window type \"%s\" is built-in"
msgstr "Fönstertyp \"%s\" är inbyggd"

#: tui/tui-layout.c:385
msgid "invalid whitespace character in window name"
msgstr "ogiltigt blankstegstecken i fönsternamn"

#: tui/tui-layout.c:388
#, possible-c-format
msgid "invalid character '%c' in window name"
msgstr "ogiltigt tecken '%c' i fönsternamn"

#: tui/tui-layout.c:392
#, possible-c-format
msgid "window name must start with a letter, not '%c'"
msgstr "fönstrets namn måste börja med en bokstav, inte '%c'"

#: tui/tui-layout.c:747 tui/tui-win.c:985
