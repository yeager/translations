"specifika delarna\n"
"av den underordnade anropsmekanismen."

#: riscv-tdep.c:4833
msgid "Set riscv stack unwinding debugging."
msgstr "Ställ in felsökning av riscv-stackramavveckling."

#: riscv-tdep.c:4834
msgid "Show riscv stack unwinding debugging."
msgstr "Visa felsökning av riscv-stackramavveckling."

