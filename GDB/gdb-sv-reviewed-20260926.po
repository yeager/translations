#: arm-tdep.c:11086
msgid "Show usage of ARM 32-bit mode."
msgstr "Visa användning av ARM 32-bitarsläge."

#: arm-tdep.c:11087
msgid "When off, a 26-bit PC will be used."
msgstr "När den är avstängd används en 26-bitars PC."

#: arm-tdep.c:11095
msgid "Set the floating point type."
msgstr "Ställ in flyttalstypen."

#: arm-tdep.c:11096
msgid "Show the floating point type."
msgstr "Visa flyttalstypen."

#: arm-tdep.c:11097
msgid ""
"auto - Determine the FP typefrom the OS-ABI.\n"
"softfpa - Software FP, mixed-endian doubles on little-endian ARMs.\n"
"fpa - FPA co-processor (GCC compiled).\n"
"softvfp - Software FP with pure-endian doubles.\n"
"vfp - VFP co-processor."
msgstr ""
"auto - Fastställer FP-typen utifrån OS-ABI.\n"
"softfpa - Programvaru-FP, mixed-endian-dubbleringar på little-endian ARM.\n"
"fpa - FPA-samprocessor (GCC-kompilerad).\n"
"softvfp - FP-programvara med pure-endian-dubbleringar.\n"
"vfp - VFP-samprocessor."

