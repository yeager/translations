msgstr "Olika ARM-specifika kommandon."

#: arm-tdep.c:11071
msgid "The valid values are:\n"
msgstr "De giltiga värdena är:\n"

#: arm-tdep.c:11073
msgid "The default is \"std\"."
msgstr "Standardvärdet är \"std\"."

#: arm-tdep.c:11077
msgid "Set the disassembly style."
msgstr "Ställ in avassembleringsstilen."

#: arm-tdep.c:11078
msgid "Show the disassembly style."
msgstr "Visa avassembleringsstilen."

