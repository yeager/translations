msgstr "Lista processinformation från /proc/PID/stat."

#: infcmd.c:3375
msgid "List process info from /proc/PID/status."
msgstr "Lista processinformation från /proc/PID/status."

#: infcmd.c:3379
msgid "List current working directory of the specified process."
msgstr "Visa aktuell arbetskatalog för den angivna processen."

#: infcmd.c:3383
msgid "List command line arguments of the specified process."
msgstr "Lista kommandoradsargument för den angivna processen."

#: infcmd.c:3387
msgid "List absolute filename for executable of the specified process."
msgstr "Lista den absoluta sökvägen till den körbara filen för den angivna processen."

#: infcmd.c:3391
