#: skip.c:665
msgid ""
"Ignore a function while stepping.\n"
"\n"
"Usage: skip [FUNCTION-NAME]\n"
"       skip [FILE-SPEC] [FUNCTION-SPEC]\n"
"If no arguments are given, ignore the current function.\n"
"\n"
"FILE-SPEC is one of:\n"
"       -fi|-file FILE-NAME\n"
"       -gfi|-gfile GLOB-FILE-PATTERN\n"
"FUNCTION-SPEC is one of:\n"
"       -fu|-function FUNCTION-NAME\n"
"       -rfu|-rfunction FUNCTION-NAME-REGULAR-EXPRESSION"
msgstr "Hoppa över en funktion vid stegning.\n\nAnvändning: skip [FUNCTION-NAME]\n       skip [FILE-SPEC] [FUNCTION-SPEC]\nOm inga argument anges hoppas den aktuella funktionen över.\n\nFILE-SPEC är ett av:\n       -fi|-file FILE-NAME\n       -gfi|-gfile GLOB-FILE-PATTERN\nFUNCTION-SPEC är ett av:\n       -fu|-function FUNCTION-NAME\n       -rfu|-rfunction FUNCTION-NAME-REGULAR-EXPRESSION"

#: skip.c:680
msgid ""
"Ignore a file while stepping.\n"
"Usage: skip file [FILE-NAME]\n"
"If no filename is given, ignore the current file."
msgstr "Hoppa över en fil vid stegning.\nAnvändning: skip file [FILE-NAME]\nOm inget filnamn anges hoppas den aktuella filen över."

#: skip.c:687
msgid ""
"Ignore a function while stepping.\n"
"Usage: skip function [FUNCTION-NAME]\n"
"If no function name is given, skip the current function."
msgstr "Hoppa över en funktion vid stegning.\nAnvändning: skip function [FUNCTION-NAME]\nOm inget funktionsnamn anges hoppas den aktuella funktionen över."

#: skip.c:694
msgid ""
"Enable skip entries.\n"
"Usage: skip enable [NUMBER | RANGE]...\n"
"You can specify numbers (e.g. \"skip enable 1 3\"),\n"
"ranges (e.g. \"skip enable 4-8\"), or both (e.g. \"skip enable 1 3 4-8\").\n"
"\n"
"If you don't specify any numbers or ranges, we'll enable all skip entries."
msgstr "Aktivera skip-poster.\nAnvändning: skip enable [NUMBER | RANGE]...\nDu kan ange nummer (t.ex. \"skip enable 1 3\"),\nintervall (t.ex. \"skip enable 4-8\") eller båda (t.ex. \"skip enable 1 3 4-8\").\n\nOm du inte anger några nummer eller intervall aktiveras alla skip-poster."

#: skip.c:703
msgid ""
"Disable skip entries.\n"
"Usage: skip disable [NUMBER | RANGE]...\n"
"You can specify numbers (e.g. \"skip disable 1 3\"),\n"
"ranges (e.g. \"skip disable 4-8\"), or both (e.g. \"skip disable 1 3 4-"
"8\").\n"
"\n"
"If you don't specify any numbers or ranges, we'll disable all skip entries."
msgstr "Inaktivera skip-poster.\nAnvändning: skip disable [NUMBER | RANGE]...\nDu kan ange nummer (t.ex. \"skip disable 1 3\"),\nintervall (t.ex. \"skip disable 4-8\") eller båda (t.ex. \"skip disable 1 3 4-8\").\n\nOm du inte anger några nummer eller intervall inaktiveras alla skip-poster."

#: skip.c:712
msgid ""
"Delete skip entries.\n"
"Usage: skip delete [NUMBER | RANGES]...\n"
"You can specify numbers (e.g. \"skip delete 1 3\"),\n"
"ranges (e.g. \"skip delete 4-8\"), or both (e.g. \"skip delete 1 3 4-8\").\n"
"\n"
"If you don't specify any numbers or ranges, we'll delete all skip entries."
msgstr "Ta bort skip-poster.\nAnvändning: skip delete [NUMBER | RANGES]...\nDu kan ange nummer (t.ex. \"skip delete 1 3\"),\nintervall (t.ex. \"skip delete 4-8\") eller båda (t.ex. \"skip delete 1 3 4-8\").\n\nOm du inte anger några nummer eller intervall tas alla skip-poster bort."

#: skip.c:721
msgid ""
"Display the status of skips.\n"
"Usage: info skip [NUMBER | RANGES]...\n"
"You can specify numbers (e.g. \"info skip 1 3\"),\n"
"ranges (e.g. \"info skip 4-8\"), or both (e.g. \"info skip 1 3 4-8\").\n"
"\n"
"If you don't specify any numbers or ranges, we'll show all skips."
msgstr "Visa status för skip-poster.\nAnvändning: info skip [NUMBER | RANGES]...\nDu kan ange nummer (t.ex. \"info skip 1 3\"),\nintervall (t.ex. \"info skip 4-8\") eller båda (t.ex. \"info skip 1 3 4-8\").\n\nOm du inte anger några nummer eller intervall visas alla skip-poster."

