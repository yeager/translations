msgid ""
"Style-specific settings.\n"
"Configure various style-related variables, such as colors"
msgstr ""
"Stilspecifika inställningar.\n"
"Konfigurera olika stilrelaterade variabler, såsom färger"

#: cli/cli-style.c:509
msgid "Set whether CLI styling is enabled."
msgstr "Ställ in om CLI-formatering ska vara aktiverad."

#: cli/cli-style.c:510
msgid "Show whether CLI is enabled."
msgstr "Visa om CLI-formatering är aktiverad."

#: cli/cli-style.c:511
