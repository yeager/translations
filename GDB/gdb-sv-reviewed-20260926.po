#. Note: The options in the list below are only approximately sorted
#. in the alphabetical order, so as to group closely related options
#. together.
#: main.c:1409
msgid ""
"This is the GNU debugger.  Usage:\n"
"\n"
"    gdb [options] [executable-file [core-file or process-id]]\n"
"    gdb [options] --args executable-file [inferior-arguments ...]\n"
"\n"
msgstr "Detta är GNU-felsökaren. Användning:\n\n    gdb [options] [executable-file [core-file or process-id]]\n    gdb [options] --args executable-file [inferior-arguments ...]\n\n"

#: main.c:1414
msgid ""
"Selection of debuggee and its files:\n"
"\n"
"  --args             Arguments after executable-file are passed to "
"inferior.\n"
"  --core=COREFILE    Analyze the core dump COREFILE.\n"
"  --exec=EXECFILE    Use EXECFILE as the executable.\n"
"  --pid=PID          Attach to running process PID.\n"
"  --directory=DIR    Search for source files in DIR.\n"
"  --se=FILE          Use FILE as symbol file and executable file.\n"
"  --symbols=SYMFILE  Read symbols from SYMFILE.\n"
"  --readnow          Fully read symbol files on first access.\n"
"  --readnever        Do not read symbol files.\n"
"  --write            Set writing into executable and core files.\n"
"\n"
msgstr "Val av felsökt program och dess filer:\n\n  --args             Argument efter executable-file skickas till underprocessen.\n  --core=COREFILE    Analysera minnesavbilden COREFILE.\n  --exec=EXECFILE    Använd EXECFILE som körbar fil.\n  --pid=PID          Anslut till körande process PID.\n  --directory=DIR    Sök efter källfiler i DIR.\n  --se=FILE          Använd FILE som symbolfil och körbar fil.\n  --symbols=SYMFILE  Läs symboler från SYMFILE.\n  --readnow          Läs symbolfiler helt vid första åtkomst.\n  --readnever        Läs inte symbolfiler.\n  --write            Tillåt skrivning i körbara filer och minnesavbilder.\n\n"

#: main.c:1427
msgid ""
"Initial commands and command files:\n"
"\n"
"  --command=FILE, -x Execute GDB commands from FILE.\n"
"  --init-command=FILE, -ix\n"
"\t\t     Like -x but execute commands before loading inferior.\n"
"  --eval-command=COMMAND, -ex\n"
"\t\t     Execute a single GDB command.\n"
"\t\t     May be used multiple times and in conjunction\n"
"\t\t     with --command.\n"
"  --init-eval-command=COMMAND, -iex\n"
"\t\t     Like -ex but before loading inferior.\n"
"  --nh               Do not read ~/.gdbinit.\n"
"  --nx               Do not read any .gdbinit files in any directory.\n"
"\n"
msgstr "Startkommandon och kommandofiler:\n\n  --command=FILE, -x Kör GDB-kommandon från FILE.\n  --init-command=FILE, -ix\n\t\t     Som -x, men kör kommandon innan underprocessen läses in.\n  --eval-command=COMMAND, -ex\n\t\t     Kör ett GDB-kommando.\n\t\t     Kan användas flera gånger och tillsammans\n\t\t     med --command.\n  --init-eval-command=COMMAND, -iex\n\t\t     Som -ex, men innan underprocessen läses in.\n  --nh               Läs inte ~/.gdbinit.\n  --nx               Läs inga .gdbinit-filer i någon katalog.\n\n"

#: main.c:1441
msgid ""
"Output and user interface control:\n"
"\n"
"  --fullname         Output information used by emacs-GDB interface.\n"
"  --interpreter=INTERP\n"
"\t\t     Select a specific interpreter / user interface.\n"
"  --tty=TTY          Use TTY for input/output by the program being "
"debugged.\n"
"  -w                 Use the GUI interface.\n"
"  --nw               Do not use the GUI interface.\n"
msgstr "Utdata och styrning av användargränssnitt:\n\n  --fullname         Utdata som används av emacs-GDB-gränssnittet.\n  --interpreter=INTERP\n\t\t     Välj en viss tolk eller ett användargränssnitt.\n  --tty=TTY          Använd TTY för in- och utdata från det felsökta programmet.\n  -w                 Använd GUI-gränssnittet.\n  --nw               Använd inte GUI-gränssnittet.\n"

#: main.c:1451
msgid "  --tui              Use a terminal user interface.\n"
msgstr "  --tui              Använd ett terminalbaserat användargränssnitt.\n"

#: main.c:1455
msgid ""
"  -q, --quiet, --silent\n"
"\t\t     Do not print version number on startup.\n"
"\n"
msgstr ""
"  -q, --quiet, --silent\n"
"\t\t     Skriv inte ut versionsnumret vid uppstart.\n"
"\n"

#: main.c:1459
msgid ""
"Operating modes:\n"
"\n"
"  --batch            Exit after processing options.\n"
"  --batch-silent     Like --batch, but suppress all gdb stdout output.\n"
"  --return-child-result\n"
"\t\t     GDB exit code will be the child's exit code.\n"
"  --configuration    Print details about GDB configuration and then exit.\n"
"  --help             Print this message and then exit.\n"
"  --version          Print version information and then exit.\n"
"\n"
"Remote debugging options:\n"
"\n"
"  -b BAUDRATE        Set serial port baud rate used for remote debugging.\n"
"  -l TIMEOUT         Set timeout in seconds for remote debugging.\n"
"\n"
"Other options:\n"
"\n"
"  --cd=DIR           Change current directory to DIR.\n"
"  --data-directory=DIR, -D\n"
"\t\t     Set GDB's data-directory to DIR.\n"
"  --binary-output    Set the translation mode of stdout/stderr to binary,\n"
"\t\t     disabling CRLF translation.\n"
msgstr "Driftlägen:\n\n  --batch            Avsluta efter bearbetning av alternativ.\n  --batch-silent     Som --batch, men undertryck all GDB-utdata till stdout.\n  --return-child-result\n\t\t     GDB:s avslutningskod blir barnprocessens avslutningskod.\n  --configuration    Skriv ut GDB-konfiguration och avsluta.\n  --help             Skriv ut detta meddelande och avsluta.\n  --version          Skriv ut versionsinformation och avsluta.\n\nAlternativ för fjärrfelsökning:\n\n  -b BAUDRATE        Ställ in seriell överföringshastighet för fjärrfelsökning.\n  -l TIMEOUT         Ställ in tidsgräns i sekunder för fjärrfelsökning.\n\nÖvriga alternativ:\n\n  --cd=DIR           Byt aktuell katalog till DIR.\n  --data-directory=DIR, -D\n\t\t     Ställ in GDB:s data-directory till DIR.\n  --binary-output    Ställ in översättningsläget för stdout/stderr till binärt,\n\t\t     så att CRLF-översättning inaktiveras.\n"

