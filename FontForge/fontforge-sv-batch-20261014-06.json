  {
    "projectId": 368599,
    "branchId": null,
    "identifier": "CursEntry",
    "type": "text",
    "context": "#. GT: Cursive Entry. This defines a point on the glyph that should be matched\n#. GT: with the \"Cursive Exit\" point of the preceding glyph.\n#. GT: This is a special way of joining letters which was developed for Urdu\n#. GT: fonts. Essentially every glyph has an entry point and an exit point.\n#. GT: When written the glyphs in sequence are aligned so that the exit point\n#. GT: of each glyph matches the entry point of the following. It means you\n#. GT: get a join such as might be expected for script. Urdu is odd because\n#. GT: letters within a word crawl diagonally up the page, but with each word\n#. GT: the writing point starts at the baseline.\n#: ../fontforgeexe/cvgetinfo.cpp:1456\n",
    "maxLength": 0,
    "isHidden": false,
    "isDuplicate": false,
    "masterStringId": null,
    "hasPlurals": false,
    "isIcu": false,
    "labelIds": [],
