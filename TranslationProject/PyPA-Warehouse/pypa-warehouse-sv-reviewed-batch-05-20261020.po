#: warehouse/templates/manage/account.html:608
msgid ""
"Need to connect a different account from the same service? Remove the "
"existing connection first."
msgstr ""
"Behöver du ansluta ett annat konto från samma tjänst? Ta först bort den "
"befintliga anslutningen."

#: warehouse/templates/manage/account.html:614
#: warehouse/templates/manage/project/settings.html:29
msgid "API tokens"
msgstr "API-token"

#: warehouse/templates/manage/account.html:616
#: warehouse/templates/manage/project/settings.html:30
msgid ""
"API tokens provide an alternative way to authenticate when uploading "
"packages to PyPI."
msgstr ""
"API-token erbjuder ett alternativt sätt att autentisera dig när du laddar "
"upp paket till PyPI."

#: warehouse/templates/manage/account.html:616
msgid "Learn more about API tokens"
msgstr "Läs mer om API-token"

#: warehouse/templates/manage/account.html:620
msgid "Active API tokens for this account"
msgstr "Aktiva API-token för detta konto"

#: warehouse/templates/manage/account.html:636
msgid "Add API token"
msgstr "Lägg till API-token"

#: warehouse/templates/manage/account.html:639
#, python-format
msgid ""
"<a href=\"%(href)s\">Verify your primary email address</a> to add API tokens"
" to your account."
msgstr ""
"<a href=\"%(href)s\">Verifiera din primära e-postadress</a> för att lägga "
"till API-token på ditt konto."

#: warehouse/templates/manage/account.html:663
#: warehouse/templates/manage/account.html:873
