#: warehouse/templates/manage/account/publishing.html:133
#: warehouse/templates/manage/account/publishing.html:231
#: warehouse/templates/manage/account/publishing.html:299
#: warehouse/templates/manage/organization/publishing.html:21
#: warehouse/templates/manage/organization/publishing.html:130
#: warehouse/templates/manage/organization/publishing.html:244
#: warehouse/templates/manage/organization/publishing.html:312
msgid "PyPI Project Name"
msgstr "PyPI-projektnamn"

#: warehouse/templates/manage/account/publishing.html:140
#: warehouse/templates/manage/account/publishing.html:238
#: warehouse/templates/manage/account/publishing.html:312
msgid "The project (on PyPI) that will be created when this publisher is used"
msgstr "Projektet på PyPI som skapas när denna utgivare används"

#: warehouse/templates/manage/account/publishing.html:153
#: warehouse/templates/manage/organization/publishing.html:150
#: warehouse/templates/manage/project/publishing.html:135
msgid ""
"The GitLab username or GitLab group/subgroup namespace that the project is "
"under"
msgstr ""
"GitLab-användarnamnet eller namnområdet för GitLab-gruppen eller "
"undergruppen som projektet tillhör"

#: warehouse/templates/manage/account/publishing.html:166
#: warehouse/templates/manage/organization/publishing.html:163
#: warehouse/templates/manage/project/publishing.html:148
msgid "The name of the GitLab project that contains the publishing workflow"
msgstr "Namnet på GitLab-projektet som innehåller publiceringsarbetsflödet"

#: warehouse/templates/manage/account/publishing.html:172
#: warehouse/templates/manage/organization/publishing.html:169
#: warehouse/templates/manage/project/publishing.html:154
msgid "Top-level pipeline file path"
msgstr "Sökväg till pipelinefil på högsta nivån"

#: warehouse/templates/manage/account/publishing.html:177
#: warehouse/templates/manage/organization/publishing.html:174
#: warehouse/templates/manage/project/publishing.html:159
msgid ".gitlab-ci.yml"
msgstr ".gitlab-ci.yml"

#: warehouse/templates/manage/account/publishing.html:179
#: warehouse/templates/manage/organization/publishing.html:176
#: warehouse/templates/manage/project/publishing.html:161
msgid ""
"The file path of the top-level pipeline, relative to the project's root. "
"This file should exist in the project configured above (external pipelines "
"are not supported)."
msgstr ""
"Sökvägen till pipelinefilen på högsta nivån, relativt till projektets rot. "
"Filen ska finnas i projektet som konfigurerats ovan. Externa pipelines stöds"
" inte."

#: warehouse/templates/manage/account/publishing.html:194
#: warehouse/templates/manage/organization/publishing.html:191
#: warehouse/templates/manage/project/publishing.html:176
#, python-format
msgid ""
"The name of the <a href=\"%(href)s\">GitLab CI/CD environment</a> that the "
"above workflow uses for publishing.  This should be configured under the "
"project's settings. While not required, a dedicated publishing environment "
"is <strong>strongly</strong> encouraged, <strong>especially</strong> if your"
" project has maintainers with commit access who shouldn't have PyPI "
"publishing access."
msgstr ""
"Namnet på den <a href=\"%(href)s\">GitLab CI/CD-miljö</a> som arbetsflödet "
"ovan använder för publicering. Detta ska konfigureras i projektets "
"inställningar. En särskild publiceringsmiljö krävs inte men rekommenderas "
"<strong>starkt</strong>, <strong>särskilt</strong> om projektet har "
"underhållare med skrivbehörighet som inte ska kunna publicera till PyPI."

#: warehouse/templates/manage/account/publishing.html:217
#: warehouse/templates/manage/organization/publishing.html:230
#: warehouse/templates/manage/project/publishing.html:216
#, python-format
msgid ""
"Read more about Google's OpenID Connect support <a "
"href=\"%(href)s\">here</a>."
msgstr "Läs mer om Googles stöd för OpenID Connect <a href=\"%(href)s\">här</a>."

#: warehouse/templates/manage/account/publishing.html:251
#: warehouse/templates/manage/organization/publishing.html:264
#: warehouse/templates/manage/project/publishing.html:237
msgid "The email address of the account or service account used to publish."
msgstr ""
"E-postadressen till kontot eller tjänstekontot som används för publicering."

#: warehouse/templates/manage/account/publishing.html:272
#: warehouse/templates/manage/organization/publishing.html:285
#, python-format
msgid ""
"The subject is the numeric ID that represents the principal making the "
"request. While not required, providing the subject further restricts the "
"identity used for publishing. <a href=\"%(href)s\">More details here.</a>"
msgstr ""
"Subjektet är det numeriska ID som representerar den huvudman som gör "
"begäran. Det är inte obligatoriskt men om du anger subjektet begränsas "
"identiteten som används för publicering ytterligare. <a "
"href=\"%(href)s\">Mer information finns här.</a>"

#: warehouse/templates/manage/account/publishing.html:285
#: warehouse/templates/manage/organization/publishing.html:298
#: warehouse/templates/manage/project/publishing.html:272
#, python-format
msgid ""
"Read more about ActiveState's OpenID Connect support <a "
"href=\"%(href)s\">here</a>."
msgstr ""
"Läs mer om ActiveStates stöd för OpenID Connect <a "
"href=\"%(href)s\">här</a>."

#: warehouse/templates/manage/account/publishing.html:323
#: warehouse/templates/manage/organization/publishing.html:336
#: warehouse/templates/manage/project/publishing.html:291
msgid "my-organization"
msgstr "min-organisation"

#: warehouse/templates/manage/account/publishing.html:330
#: warehouse/templates/manage/organization/publishing.html:343
#: warehouse/templates/manage/project/publishing.html:298
msgid "The ActiveState organization name that owns the project"
msgstr "Namnet på ActiveState-organisationen som äger projektet"

#: warehouse/templates/manage/account/publishing.html:335
#: warehouse/templates/manage/organization/publishing.html:348
#: warehouse/templates/manage/project/publishing.html:303
msgid "ActiveState Project name"
msgstr "ActiveState-projektnamn"

#: warehouse/templates/manage/account/publishing.html:340
#: warehouse/templates/manage/organization/publishing.html:353
#: warehouse/templates/manage/project/publishing.html:308
msgid "my-project"
msgstr "mitt-projekt"

#: warehouse/templates/manage/account/publishing.html:348
#: warehouse/templates/manage/organization/publishing.html:361
#: warehouse/templates/manage/project/publishing.html:316
msgid "The ActiveState project that will build your Python artifact."
msgstr "ActiveState-projektet som bygger din Python-artefakt."

#: warehouse/templates/manage/account/publishing.html:354
#: warehouse/templates/manage/organization/publishing.html:367
#: warehouse/templates/manage/project/publishing.html:322
msgid "Actor Username"
msgstr "Aktörens användarnamn"

#: warehouse/templates/manage/account/publishing.html:359
#: warehouse/templates/manage/organization/publishing.html:372
#: warehouse/templates/manage/project/publishing.html:327
msgid "my-username"
msgstr "mitt-användarnamn"

#: warehouse/templates/manage/account/publishing.html:365
#: warehouse/templates/manage/organization/publishing.html:378
#: warehouse/templates/manage/project/publishing.html:333
msgid ""
"The username for the ActiveState account that will trigger the build of your"
" Python artifact."
msgstr ""
"Användarnamnet för ActiveState-kontot som startar bygget av din Python-"
"artefakt."
