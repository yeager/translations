#: warehouse/templates/pages/organizations.html:42
msgid "Free for qualifying community projects"
msgstr "Kostnadsfritt för kvalificerade gemenskapsprojekt"

#: warehouse/templates/pages/organizations.html:46
msgid "Create a community organization"
msgstr "Skapa en gemenskapsorganisation"

#: warehouse/templates/pages/organizations.html:54
msgid "Company organization"
msgstr "Företagsorganisation"

#: warehouse/templates/pages/organizations.html:57
msgid "For companies and other private organizations."
msgstr "För företag och andra privata organisationer."

#: warehouse/templates/pages/organizations.html:59
msgid "All current organization features, on a monthly subscription"
msgstr "Alla aktuella organisationsfunktioner med månadsprenumeration"

#: warehouse/templates/pages/organizations.html:60
msgid "Billed monthly by card through Stripe"
msgstr "Faktureras varje månad via kortbetalning hos Stripe"

#: warehouse/templates/pages/organizations.html:63
msgid "$5 per member, per month"
msgstr "5 USD per medlem och månad"

#: warehouse/templates/pages/organizations.html:67
msgid "Apply for a company organization"
msgstr "Ansök om en företagsorganisation"

#: warehouse/templates/pages/organizations.html:77
msgid "Does your company need a PyPI service agreement?"
msgstr "Behöver ditt företag ett tjänsteavtal med PyPI?"

#: warehouse/templates/pages/organizations.html:90
msgid "PyPI Service Agreement Interest"
msgstr "Intresse för PyPI:s tjänsteavtal"

#: warehouse/templates/pages/security-key-giveaway.html:7
msgid "Two Titan security keys, one USB-A and one USB-C"
msgstr "Två Titan-säkerhetsnycklar, en USB-A och en USB-C"

#: warehouse/templates/pages/security.html:9
msgid "Reporting a security issue"
msgstr "Rapportera ett säkerhetsproblem"

#: warehouse/templates/pages/security.html:17
msgid "Our GitHub issue tracker"
msgstr "Vår ärendehanterare på GitHub"

#: warehouse/templates/pages/security.html:20
msgid "Official or unofficial chat channels"
msgstr "Officiella eller inofficiella chattkanaler"

#: warehouse/templates/pages/security.html:23
msgid "Official or unofficial mailing lists"
msgstr "Officiella eller inofficiella e-postlistor"

#: warehouse/templates/pages/security.html:28
msgid "If you've identified a security issue with a project hosted on PyPI"
msgstr ""
"Om du har identifierat ett säkerhetsproblem i ett projekt som finns på PyPI"

#: warehouse/templates/pages/security.html:37
msgid "A URL to the project in question"
msgstr "En URL till projektet i fråga"

#: warehouse/templates/pages/security.html:38
msgid "An explanation of what makes the project a security issue"
msgstr "En förklaring till vad som gör projektet till ett säkerhetsproblem"

#: warehouse/templates/pages/security.html:50
msgid "What happens next?"
msgstr "Vad händer sedan?"

#: warehouse/templates/pages/security.html:57
msgid "This security policy was last updated on March 2024."
msgstr "Denna säkerhetspolicy uppdaterades senast i mars 2024."
