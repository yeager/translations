#. Crowdin string ID: 6203387
msgctxt "OPTION_VAL_RELAXED_RPCS3_ZCULL_ACCURACY"
msgid "Relaxed (Fastest)"
msgstr "Avslappnad (snabbast)"

#. Crowdin string ID: 6203389
msgctxt "RPCS3_DRIVER_WAKEUP_DELAY_INFO_0"
msgid ""
"Driver wake-up delay in microseconds. 0 by default, as in RPCS3; raise it "
"only when a game needs it."
msgstr ""
"Fördröjning för drivrutinens uppvakning i mikrosekunder. 0 som standard, "
"precis som i RPCS3; höj den bara när ett spel behöver det."

#. Crowdin string ID: 6203391
msgctxt "OPTION_VAL_0_RPCS3_DRIVER_WAKEUP_DELAY"
msgid "0 (Default)"
msgstr "0 (Standard)"

#. Crowdin string ID: 6203393
msgctxt "OPTION_VAL_40"
msgid "40ms"
msgstr "40 ms"

