msgctxt "Crowdin stringId 3361967"
msgid "BASIC mode"
msgstr "BASIC-läge"

msgctxt "Crowdin stringId 3361979"
msgid "Sub-CPU mode"
msgstr "Underprocessorläge"

msgctxt "Crowdin stringId 3361981"
msgid "Recommended: Run Sub-CPU only during disk access."
msgstr "Rekommenderas: Kör underprocessorn endast under diskettåtkomst."

msgctxt "Crowdin stringId 3361983"
msgid "Run Sub-CPU only during disk access"
msgstr "Kör underprocessorn endast under diskettåtkomst"

msgctxt "Crowdin stringId 3361985"
msgid "Run both CPUs during disk access"
msgstr "Kör båda processorerna under diskettåtkomst"

msgctxt "Crowdin stringId 3361987"
msgid "Always run both CPUs"
msgstr "Kör alltid båda processorerna"

msgctxt "Crowdin stringId 3361991"
msgid ""
"Recommended: 4MHz or 8MHz. Some software may run too fast with an 8MHz CPU."
msgstr ""
"Rekommenderas: 4 MHz eller 8 MHz. En del program kan köras för snabbt med en"
" CPU på 8 MHz."

msgctxt "Crowdin stringId 3362009"
msgid ""
"Recommended: OPNA. Some software will sound different when using OPN "
"hardware."
msgstr ""
"Rekommenderas: OPNA. Vissa program låter annorlunda när OPN-maskinvara "
"används."

msgctxt "Crowdin stringId 3362015"
msgid "FDC-Wait"
msgstr "Vänteläge för FDC"

msgctxt "Crowdin stringId 3362017"
msgid ""
"Recommended: ON. Enables more accurate IO timing for the floppy disk "
"controller."
msgstr ""
"Rekommenderas: PÅ. Möjliggör mer exakt tidtagning för diskettkontrollen."

msgctxt "Crowdin stringId 3362021"
msgid "Recommended: OFF. May be required for some PC-8000 software."
msgstr "Rekommenderas: AV. Kan krävas för viss PC-8000-programvara."

msgctxt "Crowdin stringId 3362025"
msgid ""
"Recommended: OFF. Changes the core's preferred save behavior.\n"
"\\\n"
"- OFF: Data written to floppy disks will be stored in a separate file in the frontend's save directory.\n"
"\\\n"
"- ON: Data will be written directly to the loaded disk file(s). Will not work with zipped content."
msgstr ""
"Rekommenderas: AV. Ändrar kärnans föredragna sätt att spara.\n"
"\\\n"
"- AV: Data som skrivs till disketter lagras i en separat fil i gränssnittets sparkatalog.\n"
"\\\n"
"- PÅ: Data skrivs direkt till de laddade diskfilerna. Fungerar inte med komprimerat innehåll."

msgctxt "Crowdin stringId 3362029"
msgid ""
"Recommended: N/A. Imitates the read sounds on the floppy disk controller "
"using the controller's rumble."
msgstr ""
"Rekommenderas: N/A. Efterliknar läsljud från diskettkontrollen med hjälp av "
"handkontrollens vibrationer."

msgctxt "Crowdin stringId 3362033"
msgid ""
"Recommended: Half. Allows the core to scale the image down. Recommended for "
"the PSP screen."
msgstr ""
"Rekommenderas: Halverad. Gör det möjligt för kärnan att skala ned bilden. "
"Rekommenderas för PSP-skärmen."

msgctxt "Crowdin stringId 3362035"
msgid ""
"Recommended: Half. Allows the core to scale the image down. Recommended for "
"the Nintendo 3DS screen."
msgstr ""
"Rekommenderas: Halverad. Gör det möjligt för kärnan att skala ned bilden. "
"Rekommenderas för Nintendo 3DS-skärmen."

msgctxt "Crowdin stringId 3362037"
msgid ""
"Recommended: Full. Allows the core to scale the image down. Only recommended"
" for display heights below 400."
msgstr ""
"Rekommenderas: Full storlek. Gör det möjligt för kärnan att skala ned "
"bilden. Rekommenderas endast för skärmhöjder under 400."

msgctxt "Crowdin stringId 3362039"
msgid "Full (640x400)"
msgstr "Full storlek (640 × 400)"

msgctxt "Crowdin stringId 6203973"
msgid "2.53 MHz (PC80)"
msgstr "2,53 MHz (PC80)"
