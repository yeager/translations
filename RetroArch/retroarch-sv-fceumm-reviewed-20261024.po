msgid "20%"
msgstr "20 %"

msgctxt "3361093"
msgid "30%"
msgstr "30 %"

msgctxt "3361095"
msgid "40%"
msgstr "40 %"

msgctxt "3361097"
msgid "50%"
msgstr "50 %"

msgctxt "3361099"
msgid "60%"
msgstr "60 %"

msgctxt "3361101"
msgid "70%"
msgstr "70 %"

msgctxt "3361103"
msgid "80%"
msgstr "80 %"

msgctxt "3361105"
msgid "90%"
msgstr "90 %"

msgctxt "3361107"
msgid "100%"
msgstr "100 %"

msgctxt "3361109"
msgid "Audio Channel 1 (Square 1)"
msgstr "Ljudkanal 1 (fyrkantsvåg 1)"

msgctxt "3361111"
msgid "Channel 1 (Square 1)"
msgstr "Kanal 1 (fyrkantsvåg 1)"

msgctxt "3361113"
msgid "Enables or disables pulse wave generator audio output 1."
msgstr "Aktiverar eller inaktiverar ljudutmatning från pulsvåggenerator 1."

msgctxt "3361115"
msgid "Audio Channel 2 (Square 2)"
msgstr "Ljudkanal 2 (fyrkantsvåg 2)"

msgctxt "3361117"
msgid "Channel 2 (Square 2)"
msgstr "Kanal 2 (fyrkantsvåg 2)"

msgctxt "3361119"
msgid "Enables or disables pulse wave generator audio output 2."
msgstr "Aktiverar eller inaktiverar ljudutmatning från pulsvåggenerator 2."

msgctxt "3361125"
msgid "Enables or disables triangle wave generator audio output."
msgstr "Aktiverar eller inaktiverar ljudutmatning från triangelvåggeneratorn."

msgctxt "3361131"
msgid "Enables or disables noise generator audio output."
msgstr "Aktiverar eller inaktiverar ljudutmatning från brusgeneratorn."

msgctxt "3361137"
msgid "Enables or disables delta modulation channel audio output."
msgstr ""
"Aktiverar eller inaktiverar ljudutmatning från deltmoduleringskanalen."

msgctxt "3361139"
msgid "Turbo Enable"
msgstr "Aktivera turbo"

msgctxt "3361141"
msgid "Enables or disables turbo buttons."
msgstr "Aktiverar eller inaktiverar turboknappar."

msgctxt "3361151"
msgid "Turbo Delay (in frames)"
msgstr "Turbofördröjning (i bildrutor)"

msgctxt "3361171"
msgid "Sets how many pixels from target area is on target."
msgstr "Anger hur många bildpunkter från målområdet som räknas som träff."

msgctxt "3361177"
msgid "No Sprite Limit"
msgstr "Ingen spritegräns"

msgctxt "3361179"
msgid ""
"Removes the 8-per-scanline hardware limit. This reduces sprite flickering "
"but can cause some games to glitch since some use this for effects."
msgstr ""
"Tar bort hårdvarubegränsningen på 8 sprites per skanningslinje. Det minskar "
"spriteflimmer men kan orsaka fel i vissa spel eftersom begränsningen används"
" för effekter."

msgctxt "3361181"
msgid "Overclock"
msgstr "Överklockning"

msgctxt "3361183"
msgid ""
"Enables or disables overclocking, which can reduce slowdowns in some games. "
"Postrender method is more compatible with every game, Vblank is more "
"effective for games like Contra Force."
msgstr ""
"Aktiverar eller inaktiverar överklockning, som kan minska inbromsningar i "
"vissa spel. Efterrenderingsmetoden är mer kompatibel med alla spel, medan "
"VBlank är effektivare i spel som Contra Force."

msgctxt "3361185"
msgid "2x-Postrender"
msgstr "2×-efterrendering"

msgctxt "3361187"
msgid "2x-VBlank"
msgstr "2×-VBlank"

msgctxt "3361189"
msgid "RAM Power-On Fill (Restart Required)"
msgstr "RAM-fyllning vid påslag (omstart krävs)"

msgctxt "3361191"
msgid ""
"RAM values on power up. Some games rely on initial RAM values for random "
"number generation as an example."
msgstr ""
"RAM-värden vid uppstart. Vissa spel använder initiala RAM-värden för "
"exempelvis slumptalsgenerering."

msgctxt "4592933"
msgid "Change turbo and light gun settings."
msgstr "Ändra inställningar för turboläge och ljuspistol."

msgctxt "4592935"
msgid ""
"Change processor overclocking and emulation accuracy settings affecting low-"
"level performance and compatibility."
msgstr ""
"Ändra inställningar för processoröverklockning och emuleringsnoggrannhet som"
" påverkar prestanda och kompatibilitet på låg nivå."

msgctxt "4592949"
msgid ""
"Blargg's NTSC filters are used to replicate RF, Composite, S-Video, and RGB "
"cable signals."
msgstr ""
"Blarggs NTSC-filter används för att efterlikna RF-, komposit-, S-Video- och "
"RGB-kabelsignaler."

msgctxt "4592951"
msgid "Audio RF Filter"
msgstr "RF-ljudfilter"

msgctxt "4592953"
msgid ""
"Apply a low pass audio filter to simulate the 'muted' sound of the NES when "
"connected to a television via the RF modulator."
msgstr ""
"Använd ett lågpassfilter för att simulera det dämpade ljudet från NES när "
"den är ansluten till en tv via RF-modulatorn."

msgctxt "4592955"
msgid "Stereo Sound Effect"
msgstr "Stereoljudeffekt"

msgctxt "4592957"
msgid ""
"Enable a fake stereo sound effect by delaying the right audio channel when "
"upmixing the mono signal output from the NES."
msgstr ""
"Aktivera en konstgjord stereoljudeffekt genom att fördröja den högra "
"ljudkanalen när NES monosignal mixas upp."

msgctxt "4593023"
msgid "Selects device to use for Zapper games."
msgstr "Välj enhet för Zapper-spel."

msgctxt "4593025"
msgid "Crosshair light gun"
msgstr "Ljuspistol med hårkors"

msgctxt "4593027"
msgid "Sequential Targets light gun"
msgstr "Ljuspistol med sekventiella mål"

msgctxt "4593029"
msgid "Shows or hides on-screen crosshairs when using a Zapper."
msgstr "Visar eller döljer hårkors på skärmen när en Zapper används."

msgctxt "4593031"
msgid "Invert Zapper Trigger Signal"
msgstr "Invertera Zapper-avtryckarsignalen"

msgctxt "4593033"
msgid ""
"Inverts trigger logic when using a Zapper. Disabling it resembles original "
"hardware behavior."
msgstr ""
"Inverterar avtryckarlogiken när en Zapper används. Inaktivering motsvarar "
"den ursprungliga hårdvarans beteende."

msgctxt "4593035"
msgid "Invert Zapper Sensor Signal"
msgstr "Invertera Zapper-sensorsignalen"

msgctxt "4593037"
msgid ""
"Inverts sensor logic when using a Zapper (Sequential Targets Light gun mode "
"only). Disabling it resembles original NES/FC hardware behavior."
msgstr ""
"Inverterar sensorlogiken när en Zapper används, endast i läget Sequential "
"Targets Light gun. Inaktivering motsvarar den ursprungliga NES/FC-hårdvarans"
" beteende."

