msgctxt "Crowdin stringId 3358177"
msgid "Force HLE BIOS (Restart Required)"
msgstr "Tvinga användning av HLE BIOS (omstart krävs)"

msgctxt "Crowdin stringId 3358191"
msgid "6Player Adaptor on Port 1"
msgstr "Adapter för 6 spelare på port 1"

msgctxt "Crowdin stringId 3358195"
msgid "6Player Adaptor on Port 2"
msgstr "Adapter för 6 spelare på port 2"

msgctxt "Crowdin stringId 3358199"
msgid "Number of Threads (Restart Required)"
msgstr "Antal trådar (omstart krävs)"

msgctxt "Crowdin stringId 3358233"
msgid "Add-on Cartridge (Restart Required)"
msgstr "Tilläggskassett (omstart krävs)"

msgctxt "Crowdin stringId 3390082"
msgid ""
"Use High Level Emulation BIOS. Not recommended, as it's causing more issues "
"than it solves."
msgstr ""
"Använd HLE BIOS. Rekommenderas inte eftersom det orsakar fler problem än det"
" löser."

msgctxt "Crowdin stringId 3390084"
msgid ""
"Emulate an add-on RAM expansion cartridge. Some games require this to be "
"played, while a few others will have improved performance."
msgstr ""
"Emulera en RAM-expansionskassett som tillägg. Vissa spel kräver den för att "
"kunna spelas, medan andra får bättre prestanda."

msgctxt "Crowdin stringId 3390086"
msgid "Enable multitap in port 1."
msgstr "Aktivera stöd för flera spelare på port 1."

msgctxt "Crowdin stringId 3390088"
msgid "Enable multitap in port 2."
msgstr "Aktivera stöd för flera spelare på port 2."

msgctxt "Crowdin stringId 3390092"
msgid "1MB RAM"
msgstr "1 MB RAM"

msgctxt "Crowdin stringId 3390094"
msgid "4MB RAM"
msgstr "4 MB RAM"
