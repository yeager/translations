msgstr "Säkerhetskod"

#.  SecurityCodeDialog: Instruction comparing safety number. %1$s = contact
#. name, e.g. Bob. Sentence with E2E explanation
#, java-printf-format, xml-text
msgctxt "compare_this_code_with_on_their_device_i"
msgid ""
"Compare this code with <xliff:g id=\"person_name\" "
"example=\"Bob\">%1$s</xliff:g> on their device. If the numbers match on both"
" phones, your connection is verified end-to-end — no one is intercepting it."
msgstr ""
"Jämför den här koden med <xliff:g id=\"person_name\" "
"example=\"Bob\">%1$s</xliff:g> på personens enhet. Om siffrorna matchar på "
"båda telefonerna är anslutningen verifierad från ände till ände. Ingen "
"avlyssnar den."

#.  SecurityCodeDialog: Loading placeholder while computing safety number.
#. Verb, progressive
#, java-printf-format
msgctxt "computing"
msgid "Computing…"
msgstr "Beräknar…"

#.  SecurityCodeDialog: Error when other party key not available. %1$s =
#. person name. Sentence
#, java-printf-format, xml-text
msgctxt "couldn_t_compute_yet_s_key_isn_t_availab"
msgid ""
"Couldn't compute yet — <xliff:g id=\"person_name\" "
"example=\"Bob\">%1$s</xliff:g>'s key isn't available. Make sure you're both "
"connected, then try again."
msgstr ""
"Kan inte beräkna ännu: nyckeln för <xliff:g id=\"person_name\" "
"example=\"Bob\">%1$s</xliff:g> är inte tillgänglig. Kontrollera att ni båda "
"är anslutna och försök sedan igen."

