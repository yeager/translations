#.  MainActivity / launcher: App name. Noun, proper name
#, java-printf-format
msgctxt "app_name"
msgid "Find Family"
msgstr "Hitta familj"

#.  LocationTrackingService: Notification channel name for foreground location
#. tracking. Noun
#, java-printf-format
msgctxt "notification_channel_location_tracking_name"
msgid "Location Tracking"
msgstr "Platsspårning"

#.  LocationTrackingService: Notification channel description for location
#. tracking. Explains background updates
#, java-printf-format
msgctxt "notification_channel_location_tracking_desc"
msgid "Used for FindFamily background location updates"
msgstr "Används för Find Familys platsuppdateringar i bakgrunden"

#.  LocationTrackingService: Notification channel name for low-battery alerts.
#. Noun
#, java-printf-format
msgctxt "notification_channel_battery_name"
msgid "Battery Alerts"
msgstr "Batterivarningar"

#.  LocationTrackingService: Notification channel description for battery
#. alerts. Sentence
#, java-printf-format
msgctxt "notification_channel_battery_desc"
msgid "Alerts when a family member has low battery"
msgstr "Varnar när en familjemedlem har låg batterinivå"

#.  LocationTrackingService: Notification channel name for geofence
#. entry/exit. Noun phrase
#, java-printf-format
msgctxt "notification_channel_entry_exit_name"
msgid "Arrivals & Departures"
msgstr "Ankomster och avresor"

#.  LocationTrackingService: Notification channel description for waypoint
#. entry/exit events
#, java-printf-format
msgctxt "notification_channel_entry_exit_desc"
msgid "Notifications for when family members enter or leave waypoints"
msgstr ""
"Aviseringar när familjemedlemmar anländer till eller lämnar sparade platser"

#.  Per-person arrival channel name. %1$s = person name, e.g. Alice
#, java-printf-format, xml-text
msgctxt "notification_channel_arrival_name"
msgid "<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> · Arrivals"
msgstr "<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> · Ankomster"

#.  Per-person arrival channel description. %1$s = person name
#, java-printf-format, xml-text
msgctxt "notification_channel_arrival_desc"
msgid ""
"Notifications when <xliff:g id=\"person_name\" "
"example=\"Alice\">%1$s</xliff:g> arrives at a place"
msgstr ""
"Aviseringar när <xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g>"
" anländer till en plats"

#.  Per-person departure channel name. %1$s = person name
#, java-printf-format, xml-text
msgctxt "notification_channel_departure_name"
msgid "<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> · Departures"
msgstr "<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> · Avresor"

#.  Per-person departure channel description. %1$s = person name
#, java-printf-format, xml-text
msgctxt "notification_channel_departure_desc"
msgid ""
"Notifications when <xliff:g id=\"person_name\" "
"example=\"Alice\">%1$s</xliff:g> leaves a place"
msgstr ""
"Aviseringar när <xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g>"
" lämnar en plats"

#.  Per-person no-show channel name. %1$s = person name, e.g. Alice
#, java-printf-format, xml-text
msgctxt "notification_channel_noshow_name"
msgid "<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> · No-show alerts"
msgstr ""
"<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> · Varningar vid"
" utebliven ankomst"

#.  Per-person no-show channel description. %1$s = person name
#, java-printf-format, xml-text
msgctxt "notification_channel_noshow_desc"
msgid ""
"Notifications when <xliff:g id=\"person_name\" "
"example=\"Alice\">%1$s</xliff:g> doesn't arrive at an expected place"
msgstr ""
"Aviseringar när <xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g>"
" inte kommer till en förväntad plats"

#.  PersonDetailSheet: button opening system settings for this person's
#. arrival notifications
#, java-printf-format
msgctxt "notification_settings_arrival"
msgid "Arrival alerts"
msgstr "Ankomstvarningar"

#.  PersonDetailSheet: button opening system settings for this person's
#. departure notifications
#, java-printf-format
msgctxt "notification_settings_departure"
msgid "Departure alerts"
msgstr "Avresevarningar"

#.  LocationTrackingService: Foreground service notification title when
#. tracking is active. Noun phrase
#, java-printf-format
msgctxt "notification_tracking_title"
msgid "FindFamily is active"
msgstr "Find Family är aktiv"

#.  LocationTrackingService: Foreground service notification body. Sentence
#. explaining sharing state
#, java-printf-format
msgctxt "notification_tracking_text"
msgid "Sharing location with your selected contacts"
msgstr "Delar plats med dina valda kontakter"

#.  LocationTrackingService: Dynamic notification body for low battery. %1$s =
#. contact display name, e.g. Alice
#, java-printf-format, xml-text
msgctxt "notification_low_battery"
msgid "<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> has low battery"
msgstr ""
"<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> har låg "
"batterinivå"

#.  LocationTrackingService: Dynamic notification when contact enters
#. waypoint. %1$s = person name (Alice), %2$s = waypoint name (Home)
#, java-printf-format, xml-text
msgctxt "notification_entered_waypoint"
msgid ""
"<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> has entered "
"<xliff:g id=\"waypoint_name\" example=\"Home\">%2$s</xliff:g>"
msgstr ""
"<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> har anlänt till"
" <xliff:g id=\"waypoint_name\" example=\"Home\">%2$s</xliff:g>"

#.  LocationTrackingService: Dynamic notification when contact exits waypoint.
#. %1$s = person name, %2$s = waypoint name
#, java-printf-format, xml-text
msgctxt "notification_exited_waypoint"
msgid ""
"<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> has exited "
"<xliff:g id=\"waypoint_name\" example=\"Home\">%2$s</xliff:g>"
msgstr ""
"<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> har lämnat "
"<xliff:g id=\"waypoint_name\" example=\"Home\">%2$s</xliff:g>"

#.  Permission screen: Shown after fine location granted. Status label with
#. emoji
#, java-printf-format
msgctxt "permission_fine_location_granted"
msgid "✅ Fine Location Granted"
msgstr "✅ Exakt plats har beviljats"

#.  Permission screen: Button to request ACCESS_FINE_LOCATION. Verb phrase,
#. step 1
#, java-printf-format
msgctxt "permission_grant_fine_location"
msgid "1. Grant Fine Location"
msgstr "1. Bevilja exakt plats"

#.  Permission screen: Status label after background location granted. Noun
#. phrase
#, java-printf-format
msgctxt "permission_background_granted"
msgid "✅ Background Granted"
msgstr "✅ Bakgrundsbehörighet har beviljats"

#.  Permission screen: Button to enable background 'Allow all the time'. Verb
#. phrase, step 2
#, java-printf-format
msgctxt "permission_enable_all_the_time"
msgid "2. Enable 'Allow all the time'"
msgstr "2. Aktivera ”Tillåt alltid”"

#.  Permission screen: Explanation for background permission rationale.
#. Sentence
#, java-printf-format
msgctxt "permission_background_explanation"
msgid ""
"To enable background tracking, please select 'Allow all the time' in the "
"next screen."
msgstr ""
"Välj ”Tillåt alltid” på nästa skärm för att aktivera spårning i bakgrunden."

#.  Permission screen: Message when user granted only approximate location.
#. Sentence, requires upgrade
#, java-printf-format
msgctxt "permission_approximate_only_explanation"
msgid ""
"FindFamily only works with precise (fine) location. You granted approximate "
"location only — please upgrade to precise location to continue."
msgstr ""
"Find Family fungerar bara med exakt plats. Du har bara beviljat ungefärlig "
"plats. Uppgradera till exakt plats för att fortsätta."

#.  Permission screen: Button to reopen upgrade prompt for precise location.
#. Verb phrase
#, java-printf-format
msgctxt "permission_reopen_upgrade_prompt"
msgid "Upgrade to precise location"
msgstr "Uppgradera till exakt plats"

#.  Permission upgrade dialog: Title. Noun phrase
#, java-printf-format
msgctxt "permission_upgrade_dialog_title"
msgid "Precise location required"
msgstr "Exakt plats krävs"

#.  Permission upgrade dialog: Body message explaining why precise location
#. needed. Sentence
#, java-printf-format
msgctxt "permission_upgrade_dialog_message"
msgid ""
"FindFamily needs precise (fine) location to share your exact position. "
"Please allow precise location."
msgstr ""
"Find Family behöver exakt plats för att dela din exakta position. Tillåt "
"exakt plats."

#.  Permission upgrade dialog: Confirm button. Verb phrase
#, java-printf-format
msgctxt "permission_upgrade_dialog_confirm"
msgid "Allow precise location"
msgstr "Tillåt exakt plats"

#.  Permission upgrade dialog: Dismiss button. Verb phrase
#, java-printf-format
msgctxt "permission_upgrade_dialog_dismiss"
msgid "Not now"
msgstr "Inte nu"

#.  MainPage FAB menu: Option to add a person/contact. Noun
#, java-printf-format
msgctxt "fab_person"
msgid "Person"
msgstr "Person"

#.  MainPage FAB menu: Option to add a saved place/waypoint. Noun
#, java-printf-format
msgctxt "fab_location"
msgid "Location"
msgstr "Plats"

#.  MainPage FAB menu: Option to create temporary share link. Noun
#, java-printf-format
msgctxt "fab_link"
msgid "Link"
msgstr "Länk"

#.  MainPage FAB menu (dev builds only): bind a custom UWB tracker. Noun
#, java-printf-format
msgctxt "fab_tracker"
msgid "Tracker"
msgstr "Spårare"

#.  Add Tracker dialog title
#, java-printf-format
msgctxt "add_tracker_title"
msgid "Add tracker"
msgstr "Lägg till spårare"

#.  Add Tracker dialog: label for the tracker name text field
#, java-printf-format
msgctxt "add_tracker_name_label"
msgid "Tracker name"
msgstr "Spårarens namn"

#.  Add Tracker dialog: hint explaining the tracker must be in pairing mode
#, java-printf-format
msgctxt "add_tracker_scan_hint"
msgid "Put the tracker in pairing mode, then pick it below."
msgstr "Sätt spåraren i parkopplingsläge och välj den sedan nedan."

#.  Add Tracker dialog: shown while scanning for nearby trackers
#, java-printf-format
msgctxt "add_tracker_scanning"
msgid "Scanning for trackers…"
msgstr "Söker efter spårare…"

#.  Add Tracker dialog: shown while binding to the selected tracker
#, java-printf-format
msgctxt "add_tracker_binding"
msgid "Binding…"
msgstr "Kopplar…"

#.  Add Tracker dialog: shown when binding fails
#, java-printf-format
msgctxt "add_tracker_failed"
msgid "Could not bind to that tracker. Try again."
msgstr "Kunde inte koppla den spåraren. Försök igen."

#.  MainPage: Section header for pending location-sharing requests list. Noun
#. phrase
#, java-printf-format
msgctxt "section_location_sharing_requests"
msgid "Location Sharing Requests"
msgstr "Förfrågningar om platsdelning"

#.  MainPage: Section header for temporary links grid. Noun phrase
#, java-printf-format
msgctxt "section_temporary_links"
msgid "Temporary Links"
msgstr "Tillfälliga länkar"

#.  MainPage: Section header for saved waypoints/places. Noun phrase
#, java-printf-format
msgctxt "section_saved_places"
msgid "Saved Places"
msgstr "Sparade platser"

#.  MainPage: AwaitingRequestCard header. %1$s = encoded sender ID in Base26,
#. e.g. ABC123
#, java-printf-format, xml-text
msgctxt "request_from"
msgid "Request from <xliff:g id=\"sender_id\" example=\"ABC123\">%1$s</xliff:g>"
msgstr "Förfrågan från <xliff:g id=\"sender_id\" example=\"ABC123\">%1$s</xliff:g>"

#.  MainPage: TemporaryLinkCard expiry label. %1$s = relative future time
#. string, e.g. in 5 minutes / very soon
#, java-printf-format, xml-text
msgctxt "expires"
msgid "Expires <xliff:g id=\"relative_time\" example=\"in 5 minutes\">%1$s</xliff:g>"
msgstr "Upphör <xliff:g id=\"relative_time\" example=\"in 5 minutes\">%1$s</xliff:g>"

#.  MainPage: WaypointCard empty state when no one is inside waypoint. Noun
#. phrase, sentence fragment
#, java-printf-format
msgctxt "nobody_here"
msgid "nobody is currently here"
msgstr "ingen är här just nu"

#.  MainPage: WaypointCard when single user inside. %1$s = person name, e.g.
#. Alice. Sentence
#, java-printf-format, xml-text
msgctxt "user_is_here"
msgid "<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> is currently here"
msgstr "<xliff:g id=\"person_name\" example=\"Alice\">%1$s</xliff:g> är här just nu"

#.  MainPage: WaypointCard when multiple users inside. %1$s = comma-separated
#. names, e.g. Alice, Bob. Sentence
#, java-printf-format, xml-text
msgctxt "users_are_here"
msgid ""
"<xliff:g id=\"person_names\" example=\"Alice, Bob\">%1$s</xliff:g> are "
"currently here"
msgstr ""
"<xliff:g id=\"person_names\" example=\"Alice, Bob\">%1$s</xliff:g> är här "
"just nu"

#.  MainPage: UserCard since label when last entry just happened (<60s).
#. Adverbial phrase
#, java-printf-format
msgctxt "since_just_now"
msgid "Since just now"
msgstr "Sedan nyss"

#.  MainPage: UserCard since label for minutes. %1$d = minutes count, e.g. 5
#, java-printf-format, xml-text
msgctxt "since_minutes_ago"
msgid "Since <xliff:g id=\"minutes\" example=\"5\">%1$d</xliff:g> minutes ago"
msgstr "Sedan <xliff:g id=\"minutes\" example=\"5\">%1$d</xliff:g> minuter"

#.  MainPage: UserCard since label with formatted time and date. %1$s = time
#. e.g. 3:45 PM, %2$s = date e.g. today/yesterday/Jun 4
#, java-printf-format, xml-text
msgctxt "since_time_date"
msgid ""
"Since <xliff:g id=\"time\" example=\"3:45 PM\">%1$s</xliff:g> <xliff:g "
"id=\"date\" example=\"today\">%2$s</xliff:g>"
msgstr ""
"Sedan <xliff:g id=\"time\" example=\"3:45 PM\">%1$s</xliff:g> <xliff:g "
"id=\"date\" example=\"today\">%2$s</xliff:g>"

#.  MainPage: Date token for today. Noun, used inside since_time_date
#, java-printf-format
msgctxt "today"
msgid "today"
msgstr "i dag"

#.  MainPage: Date token for yesterday. Noun, used inside since_time_date
#, java-printf-format
msgctxt "yesterday"
msgid "yesterday"
msgstr "i går"

#.  MainPage: UserCard multiline status block. %1$s = last updated relative
#. time (just now/minutes ago), %2$s = location name, %3$s = since string
#, java-printf-format, xml-text
msgctxt "user_card_status"
msgid ""
"Updated <xliff:g id=\"last_updated\" example=\"5 minutes ago\">%1$s</xliff:g>\n"
"At <xliff:g id=\"location_name\" example=\"Home\">%2$s</xliff:g>\n"
"<xliff:g id=\"since_text\" example=\"Since today\">%3$s</xliff:g>"
msgstr ""
"Uppdaterad <xliff:g id=\"last_updated\" example=\"5 minutes ago\">%1$s</xliff:g>\n"
"Vid <xliff:g id=\"location_name\" example=\"Home\">%2$s</xliff:g>\n"
"<xliff:g id=\"since_text\" example=\"Since today\">%3$s</xliff:g>"

#.  MainPage: UserCard status block for a phone that sent its parting shutdown
#. report. %1$s = shutdown age (just now/5 minutes ago), %2$s = fix age, %3$s
#. = location name, %4$s = since string
#, java-printf-format, xml-text
msgctxt "user_card_shutdown"
msgid ""
"Phone switched off <xliff:g id=\"shutdown_age\" example=\"5 minutes ago\">%1$s</xliff:g>\n"
"Last location <xliff:g id=\"last_updated\" example=\"20 minutes ago\">%2$s</xliff:g>\n"
"At <xliff:g id=\"location_name\" example=\"Home\">%3$s</xliff:g>\n"
"<xliff:g id=\"since_text\" example=\"Since today\">%4$s</xliff:g>"
msgstr ""
"Telefonen stängdes av <xliff:g id=\"shutdown_age\" example=\"5 minutes ago\">%1$s</xliff:g>\n"
"Senaste plats <xliff:g id=\"last_updated\" example=\"20 minutes ago\">%2$s</xliff:g>\n"
"Vid <xliff:g id=\"location_name\" example=\"Home\">%3$s</xliff:g>\n"
"<xliff:g id=\"since_text\" example=\"Since today\">%4$s</xliff:g>"

#.  MainPage: UserCard status block for a low-battery report (phone still
#. alive, same stale-fix shape as shutdown). Same params as user_card_shutdown
#, java-printf-format, xml-text
msgctxt "user_card_battery_low"
msgid ""
"Low battery report <xliff:g id=\"report_age\" example=\"5 minutes ago\">%1$s</xliff:g>\n"
"Last location <xliff:g id=\"last_updated\" example=\"20 minutes ago\">%2$s</xliff:g>\n"
"At <xliff:g id=\"location_name\" example=\"Home\">%3$s</xliff:g>\n"
"<xliff:g id=\"since_text\" example=\"Since today\">%4$s</xliff:g>"
msgstr ""
"Rapport om låg batterinivå <xliff:g id=\"report_age\" example=\"5 minutes ago\">%1$s</xliff:g>\n"
"Senaste plats <xliff:g id=\"last_updated\" example=\"20 minutes ago\">%2$s</xliff:g>\n"
"Vid <xliff:g id=\"location_name\" example=\"Home\">%3$s</xliff:g>\n"
"<xliff:g id=\"since_text\" example=\"Since today\">%4$s</xliff:g>"

#.  MainPage: BatteryBar percentage label. %1$d = battery level 0-100, e.g. 85
#, java-printf-format, xml-text
msgctxt "battery_percentage"
msgid "<xliff:g id=\"battery_level\" example=\"85\">%1$d</xliff:g>%%"
msgstr "<xliff:g id=\"battery_level\" example=\"85\">%1$d</xliff:g>%%"

#.  MainPage: timestring helper for just now. Adverbial phrase, past
#, java-printf-format
msgctxt "time_just_now"
msgid "just now"
msgstr "nyss"

#.  MainPage: timestring past minutes. %1$d = count, e.g. 5
#, java-printf-format, xml-text
msgctxt "time_minutes_ago"
msgid "<xliff:g id=\"minutes\" example=\"5\">%1$d</xliff:g> minutes ago"
