#.  MainPage: timestring future very soon. Adverb phrase for expiry
#, java-printf-format
msgctxt "time_very_soon"
msgid "very soon"
msgstr "mycket snart"

#.  MainPage: timestring future minutes. %1$d = minutes, e.g. 5
#, java-printf-format, xml-text
msgctxt "time_in_minutes"
msgid "in <xliff:g id=\"minutes\" example=\"5\">%1$d</xliff:g> minutes"
