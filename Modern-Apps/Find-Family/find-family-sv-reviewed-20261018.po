#.  MainPage: timestring future hours. %1$d = hours count
#, java-printf-format, xml-text
msgctxt "time_in_hours"
msgid "in <xliff:g id=\"hours\" example=\"2\">%1$d</xliff:g> hours"
msgstr "om <xliff:g id=\"hours\" example=\"2\">%1$d</xliff:g> timmar"

#.  MainPage: timestring future days. %1$d = days count
#, java-printf-format, xml-text
msgctxt "time_in_days"
msgid "in <xliff:g id=\"days\" example=\"3\">%1$d</xliff:g> days"
msgstr "om <xliff:g id=\"days\" example=\"3\">%1$d</xliff:g> dagar"

