#, java-printf-format
msgctxt "app_name"
msgid "Calculator"
msgstr "Kalkylator"

#, java-printf-format
msgctxt "history"
msgid "History"
msgstr "Historik"

#, java-printf-format
msgctxt "no_calculations_yet"
msgid "No calculations yet."
msgstr "Inga beräkningar ännu."

#, java-printf-format
msgctxt "add_function"
msgid "Add function"
msgstr "Lägg till funktion"

#.  Graph: accessibility label for the coloured dot that shows or hides one
#. curve.
#, java-printf-format
msgctxt "toggle_curve_visibility"
msgid "Show or hide this curve"
msgstr "Visa eller dölj denna kurva"

#.  Graph: label on a marker where a curve crosses the x-axis. Lowercase noun,
#. shown as "root (2, 0)".
#, java-printf-format
msgctxt "feature_root"
msgid "root"
msgstr "nollställe"

#.  Graph: label on a marker where a curve crosses the y-axis. Lowercase noun,
#. shown as "y-intercept (0, 3)".
#, java-printf-format
msgctxt "feature_y_intercept"
msgid "y-intercept"
msgstr "skärning med y-axeln"

#.  Graph: label on a marker at a curve's local low point. Lowercase noun,
#. shown as "minimum (0, -2)".
#, java-printf-format
msgctxt "feature_minimum"
msgid "minimum"
msgstr "minimum"

#.  Graph: label on a marker at a curve's local high point. Lowercase noun,
#. shown as "maximum (1.57, 1)".
#, java-printf-format
msgctxt "feature_maximum"
msgid "maximum"
msgstr "maximum"

#.  Graph: label on a marker where two curves cross. Lowercase noun, shown as
#. "intersection (1, 1)".
#, java-printf-format
msgctxt "feature_intersection"
msgid "intersection"
msgstr "skärningspunkt"

#.  Bottom navigation label for the unit converter tab.
#, java-printf-format
msgctxt "units"
msgid "Units"
msgstr "Enheter"

#.  Calculator: content description / title for the unit picker that inserts a
#. unit into the expression.
#, java-printf-format
msgctxt "insert_unit"
msgid "Insert unit"
msgstr "Infoga enhet"

#.  Calculator: label before the dropdown that chooses which unit the result
#. is shown in.
#, java-printf-format
msgctxt "convert_to"
msgid "Convert to"
msgstr "Omvandla till"

#.  Converter: label for the field holding the value being converted.
#, java-printf-format
msgctxt "converter_value"
msgid "Value"
msgstr "Värde"

#.  Converter: label above the unit the value is converted from.
#, java-printf-format
msgctxt "converter_from"
msgid "From"
msgstr "Från"

#.  Converter: label above the unit the value is converted to.
#, java-printf-format
msgctxt "converter_to"
msgid "To"
msgstr "Till"

#.  Converter: label above the converted result.
#, java-printf-format
msgctxt "converter_result"
msgid "Result"
msgstr "Resultat"

#.  Converter: content description for the button that swaps the from and to
#. units.
#, java-printf-format
msgctxt "converter_swap"
msgid "Swap units"
msgstr "Byt enheter"

#.  Insert-unit sheet: tab holding the date/time pickers that insert absolute
#. instants.
#, java-printf-format
msgctxt "absolute_time"
msgid "Absolute time"
msgstr "Absolut tid"

#.  Keypad button that opens a calendar date picker.
#, java-printf-format
msgctxt "key_date"
msgid "Date"
msgstr "Datum"

#.  Keypad button that opens a time-of-day picker.
#, java-printf-format
msgctxt "key_time"
msgid "Time"
msgstr "Tid"

#.  Keypad button that opens a combined date-and-time picker.
#, java-printf-format
msgctxt "key_datetime"
msgid "Date & time"
msgstr "Datum och tid"

#.  Title of the time picker dialog.
#, java-printf-format
msgctxt "select_time"
msgid "Select time"
msgstr "Välj tid"

#.  Generic confirm button.
#, java-printf-format
msgctxt "ok"
msgid "OK"
msgstr "OK"

#.  Converter: shown while live currency exchange rates are being fetched.
#, java-printf-format
msgctxt "currency_loading"
msgid "Fetching exchange rates…"
msgstr "Hämtar växelkurser…"

#.  Converter: shown when exchange rates could not be loaded.
#, java-printf-format
msgctxt "currency_unavailable"
msgid "Exchange rates are unavailable"
msgstr "Växelkurser är inte tillgängliga"

#.  Converter: button to retry fetching exchange rates after a failure.
#, java-printf-format
msgctxt "currency_retry"
msgid "Retry"
msgstr "Försök igen"

#.  Home-screen widget name shown in the widget picker for the keypad widget.
#. Noun phrase.
#, java-printf-format
msgctxt "calculator_widget_label"
msgid "Calculator"
msgstr "Kalkylator"

#.  Widget picker description for the keypad widget. Full sentence.
#, java-printf-format
msgctxt "calculator_widget_description"
msgid ""
"A working keypad on your home screen - tap the display to open Calculator"
msgstr ""
"En fungerande knappsats på startskärmen – tryck på skärmen för att öppna "
"Kalkylator"

#.  Keypad widget setting: switch that removes the widget's own background so
#. the wallpaper shows through.
#, java-printf-format
msgctxt "calculator_widget_transparent"
msgid "Transparent background"
msgstr "Genomskinlig bakgrund"

#.  Supporting line under the transparent background switch.
#, java-printf-format
msgctxt "calculator_widget_transparent_summary"
msgid ""
"Show the wallpaper behind the keypad. The keys stay filled in so they remain"
" readable."
msgstr ""
"Visa bakgrundsbilden bakom knappsatsen. Knapparna förblir fyllda så att de "
"är läsbara."

#.  Home-screen widget name shown in the widget picker for the unit converter
#. widget. Noun phrase.
#, java-printf-format
msgctxt "units_widget_label"
msgid "Unit Converter"
msgstr "Enhetsomvandlare"

#.  Widget picker description for the unit converter widget. Full sentence.
#, java-printf-format
msgctxt "units_widget_description"
msgid "Convert between units at a glance - tap to open the converter"
msgstr "Omvandla enheter med en blick – tryck för att öppna omvandlaren"

#.  Unit converter widget: accessibility label for the chevron that expands a
#. unit category.
#, java-printf-format
msgctxt "units_widget_choose_category"
msgid "Choose a unit category"
msgstr "Välj enhetskategori"
