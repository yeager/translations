msgid "Gallery"
msgstr "Galleri"

#.  Permissions
#.  Full-screen permission gate when CAMERA and RECORD_AUDIO not granted
#, java-printf-format
msgctxt "grant_camera_permission"
msgid "Grant Camera Permission"
msgstr "Ge kamerabehörighet"

#.  TopBar settings strip: timer, aspect ratio, flash categories
#.  Aspect ratio
#.  Setting category and TopBar contentDescription for aspect ratio picker
#, java-printf-format
msgctxt "settings_aspect_ratio"
msgid "Aspect Ratio"
msgstr "Bildförhållande"

#.  Flash setting category in settings row
#.  Location / Geotagging settings
#.  SettingsPage: section title for location tagging
#, java-printf-format
msgctxt "settings_location"
msgid "Location"
msgstr "Plats"

#.  SettingsPage: summary explaining save location in EXIF metadata
#, java-printf-format
msgctxt "settings_location_description"
msgid "Save location in photo metadata"
msgstr "Spara plats i bildmetadata"

#.  SettingsPage: section title for selfie (front camera) mirroring
#, java-printf-format
msgctxt "settings_mirror_front"
msgid "Selfie mirroring"
msgstr "Spegelvänd selfie"

#.  SettingsPage: summary explaining front-camera mirroring toggle
#, java-printf-format
msgctxt "settings_mirror_front_description"
msgid "Mirror the front camera preview and saved selfies"
msgstr "Spegelvänd förhandsvisningen från främre kameran och sparade selfies"

#.  Post-processing toggles (SettingsPage, issue #662)
#.  SettingsPage: section title for noise-reduction toggle
#, java-printf-format
msgctxt "settings_noise_reduction"
msgid "Noise reduction"
msgstr "Brusreducering"

#.  SettingsPage: summary explaining noise-reduction toggle
#, java-printf-format
msgctxt "settings_noise_reduction_description"
msgid "Soften noise in photos and video (turn off for raw detail)"
msgstr "Minska brus i foton och videor (stäng av för obehandlade detaljer)"

#.  SettingsPage: section title for edge-sharpening toggle
#, java-printf-format
msgctxt "settings_edge_sharpening"
msgid "Edge sharpening"
msgstr "Kantskärpning"

#.  SettingsPage: summary explaining edge-sharpening toggle
#, java-printf-format
msgctxt "settings_edge_sharpening_description"
msgid "Sharpen edges in photos and video (turn off for a natural look)"
msgstr ""
"Gör kanterna skarpare i foton och videor (stäng av för ett naturligt "
"utseende)"

#.  Video codec settings (SettingsPage)
#.  SettingsPage: section header for video codec selection
#, java-printf-format
msgctxt "settings_video_codec"
msgid "Video codec"
msgstr "Videokodek"

#.  Video codec option label: H.264 / AVC
#, java-printf-format
msgctxt "codec_avc_label"
msgid "H.264 / AVC"
msgstr "H.264 / AVC"

#.  Video codec description: most compatible, explain compatibility trade-off
#, java-printf-format
msgctxt "codec_avc_description"
msgid "Most compatible"
msgstr "Mest kompatibel"

#.  Video codec option label: H.265 / HEVC
#, java-printf-format
msgctxt "codec_hevc_label"
msgid "H.265 / HEVC"
msgstr "H.265 / HEVC"

#.  Video codec description: more efficient than AVC
#, java-printf-format
msgctxt "codec_hevc_description"
msgid "More efficient"
msgstr "Effektivare"

#.  Video codec option label: AV1
#, java-printf-format
msgctxt "codec_av1_label"
msgid "AV1"
msgstr "AV1"

#.  Video codec description: most efficient but may not be supported
#. everywhere
#, java-printf-format
msgctxt "codec_av1_description"
msgid "Most efficient"
msgstr "Mest effektiv"

#.  Motion-Photo duration settings (SettingsPage, issue #712)
