#, java-printf-format
msgctxt "motion_duration_1s"
msgid "%1$d second"
msgstr "%1$d sekund"

#.  Motion-Photo duration: multi-second clip. %1$d = seconds
#, java-printf-format
msgctxt "motion_duration_ns"
msgid "%1$d seconds"
msgstr "%1$d sekunder"

#.  Audio input source settings (SettingsPage): mic source used for video
#. recordings
#.  SettingsPage: section header for audio input source selection
#, java-printf-format
msgctxt "settings_audio_source"
msgid "Audio input source"
msgstr "Ljudingångskälla"

