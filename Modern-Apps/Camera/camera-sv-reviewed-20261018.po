msgstr "Obearbetat"

#.  Audio source description: raw audio with no processing
#, java-printf-format
msgctxt "audio_source_unprocessed_description"
msgid "Raw, no processing"
msgstr "Rått, utan bearbetning"

#.  QR code detection overlay
#.  QrResultOverlay: header title when QR code detected
#, java-printf-format
msgctxt "qr_result"
msgid "QR Code"
msgstr "QR-kod"

#.  QrResultOverlay: header title when an eSIM activation code QR is detected
#, java-printf-format
msgctxt "esim_qr_result"
msgid "eSIM QR Code"
msgstr "QR-kod för eSIM"

#.  QrResultOverlay: button to hand an eSIM activation code to the system LPA.
#. Verb.
#, java-printf-format
msgctxt "add_esim"
msgid "Add eSIM"
msgstr "Lägg till eSIM"

#.  Toast error when no LPA can handle the eSIM activation intent
#, java-printf-format
msgctxt "no_app_to_add_esim"
msgid "No app can add this eSIM"
msgstr "Ingen app kan lägga till detta eSIM"

#.  QrResultOverlay: button to open URL from QR. Verb.
#, java-printf-format
msgctxt "open_url"
msgid "Open URL"
msgstr "Öppna URL"

#.  Toast error when no app can handle the URL from QR
#, java-printf-format
msgctxt "no_app_to_open_url"
msgid "No app can open this link"
msgstr "Ingen app kan öppna länken"

#.  QrResultOverlay: button to copy QR text to clipboard. Verb.
#, java-printf-format
msgctxt "copy_text"
msgid "Copy"
msgstr "Kopiera"

#.  CameraScreen overlay pill: the bound camera session has no analysis stream
#. (some vendor
#.          night extensions cannot host one), so the viewfinder cannot look
#. for QR codes
#, java-printf-format
msgctxt "qr_scanning_paused"
msgid "QR scanning paused"
msgstr "QR-skanning pausad"

#.  Pro / manual controls
#.  CameraScreen: slider label for portrait blur/bokeh strength
#, java-printf-format
msgctxt "blur"
msgid "Blur"
msgstr "Oskärpa"

#.  Shown when ISO values not available. Abbreviation for Not Available
#, java-printf-format
msgctxt "not_available"
msgid "N/A"
msgstr "Ej tillgängligt"

#.  ShutterRow overlay: counts burst shots taken while holding shutter. %1$d =
#. shot count
#, java-printf-format, xml-text
msgctxt "burst_count"
msgid "Burst <xliff:g id=\"count\" example=\"12\">%1$d</xliff:g>"
msgstr "Bildserie <xliff:g id=\"count\" example=\"12\">%1$d</xliff:g>"

#.  Audio and focus controls
#.  CameraScreen overlay pill: auto-exposure and auto-focus locked after long
#. press on preview
#, java-printf-format
msgctxt "ae_af_lock"
msgid "AE/AF LOCK"
msgstr "LÅS AE/AF"

