#, java-printf-format
msgctxt "app_name"
msgid "Translate"
msgstr "Översätt"

#, java-printf-format
msgctxt "enter_text"
msgid "Enter text"
msgstr "Ange text"

#, java-printf-format
msgctxt "loading_translator"
msgid "Loading translator…"
msgstr "Läser in översättare…"

#, java-printf-format
msgctxt "copy"
msgid "Copy"
msgstr "Kopiera"

#, java-printf-format
msgctxt "speak"
msgid "Speak"
msgstr "Läs upp"

#, java-printf-format
msgctxt "translation"
msgid "Translation"
msgstr "Översättning"

#, java-printf-format
msgctxt "translation_model_not_installed_showing"
msgid "Translation model not installed — showing detected text only"
msgstr ""
"Översättningsmodellen är inte installerad — visar endast identifierad text"

#, java-printf-format
msgctxt "grant_camera_access"
msgid "Grant camera access to translate what you see"
msgstr "Ge kameraåtkomst för att översätta det du ser"

#, java-printf-format
msgctxt "no_voice_installed"
msgid "No %1$s voice installed"
msgstr "Ingen %1$s-röst är installerad"

#, java-printf-format
msgctxt "install_voice"
msgid "Install"
msgstr "Installera"

#.  Language picker screen title when choosing the source language.
#, java-printf-format
msgctxt "select_source_language"
msgid "Source language"
msgstr "Källspråk"

#.  Language picker screen title when choosing the target language.
#, java-printf-format
msgctxt "select_target_language"
msgid "Target language"
msgstr "Målspråk"

#.  Placeholder of the search field that filters the language list.
#, java-printf-format
msgctxt "search_languages"
msgid "Search languages"
msgstr "Sök språk"

#.  Section header above the most-recently-used languages.
#, java-printf-format
msgctxt "recent_languages"
msgid "Recent languages"
msgstr "Senast använda språk"

#.  Section header above the full language list.
#, java-printf-format
msgctxt "all_languages"
msgid "All languages"
msgstr "Alla språk"

#.  Empty state when the search query matches no language; %1$s is the query.
#, java-printf-format
msgctxt "no_languages_match"
msgid "No languages match “%1$s”"
msgstr "Inga språk matchar ”%1$s”"

#.  History screen title (saved translations).
#, java-printf-format
msgctxt "history"
msgid "History"
msgstr "Historik"

#.  Empty state when no translations have been saved yet.
#, java-printf-format
msgctxt "history_empty"
msgid "Translations you make will appear here"
msgstr "Översättningarna du gör visas här"

#.  Clear-history action: removes every non-favorite entry.
#, java-printf-format
msgctxt "clear_history"
msgid "Clear"
msgstr "Rensa"

#.  History row subtitle: the language pair; %1$s source, %2$s target.
#, java-printf-format
msgctxt "history_language_pair"
msgid "%1$s → %2$s"
msgstr "%1$s → %2$s"

#.  Save-to-favorites action on the translation output card.
#, java-printf-format
msgctxt "save"
msgid "Save"
msgstr "Spara"

#.  Saved-state label on the translation output card (already a favorite).
#, java-printf-format
msgctxt "saved"
msgid "Saved"
msgstr "Sparad"
