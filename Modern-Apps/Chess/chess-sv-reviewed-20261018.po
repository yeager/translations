#.  MainActivity: App name displayed in TopAppBar and launcher. Noun, proper
#, java-printf-format
msgctxt "app_name"
msgid "Chess"
msgstr "Schack"

#.  ChessGame / NewGameDialog: Dialog title when starting new Human vs AI
#. game. Verb phrase
#, java-printf-format
msgctxt "start_new_game"
msgid "Start New Game"
msgstr "Starta nytt spel"

#.  NewGameDialog: Label before color chooser White/Black. Verb phrase,
#. trailing spaces separate from chips
#, java-printf-format
msgctxt "play_as"
msgid "Play as    "
msgstr "Spela som    "

#.  NewGameDialog: Color option White for player side. Noun/adjective
#, java-printf-format
msgctxt "color_white"
msgid "White"
msgstr "Vit"

#.  NewGameDialog: Color option Black for player side. Noun/adjective
#, java-printf-format
msgctxt "color_black"
msgid "Black"
msgstr "Svart"

#.  NewGameDialog: AI difficulty Master (hardest). Noun/adjective
#, java-printf-format
msgctxt "difficulty_master"
msgid "Master"
msgstr "Mästare"

#.  NewGameDialog: Confirm button to start AI game. Verb phrase CTA
#, java-printf-format
msgctxt "start_game"
msgid "Start Game"
msgstr "Starta spel"

#.  MainActivity: Game mode option for two players on same device. Noun phrase
#, java-printf-format
msgctxt "two_player_local"
msgid "2-Player Local"
msgstr "Lokalt för två spelare"

#.  MainActivity: Game mode option Human vs AI. Noun phrase
#, java-printf-format
msgctxt "human_vs_ai"
msgid "Human vs AI"
msgstr "Människa mot AI"

#.  PawnPromotionDialog / Learn / Puzzles: Title when pawn reaches last rank
#. choose piece. Verb phrase
#, java-printf-format
msgctxt "promote_pawn"
msgid "Promote Pawn"
msgstr "Befordra bonde"

#.  ChessViewModel: Game status when king in check. Interjection/noun
#, java-printf-format
msgctxt "check"
msgid "Check!"
msgstr "Schack!"

#.  ChessViewModel: Game over when white checkmates black. Sentence
#, java-printf-format
msgctxt "white_wins"
msgid "Checkmate! White wins."
msgstr "Schackmatt! Vit vinner."

#.  ChessViewModel: Game over when black checkmates white. Sentence
#, java-printf-format
msgctxt "black_wins"
msgid "Checkmate! Black wins."
msgstr "Schackmatt! Svart vinner."

#.  ChessViewModel: Game over stalemate draw. Sentence
#, java-printf-format
msgctxt "stalemate"
msgid "Stalemate! It's a draw."
msgstr "Patt! Partiet är remi."

#.  ChessViewModel: Game over insufficient material draw. Sentence
#, java-printf-format
msgctxt "draw_insufficient_material"
msgid "Draw — insufficient material."
msgstr "Remi: otillräckligt material."

#.  ChessBoard: Accessibility content description for white king piece. Noun
#. phrase
#, java-printf-format
msgctxt "piece_white_king"
msgid "White King"
msgstr "Vit kung"

#.  ChessBoard: Accessibility description for white queen. Noun
#, java-printf-format
msgctxt "piece_white_queen"
msgid "White Queen"
msgstr "Vit dam"

#.  ChessBoard: Accessibility description for white rook. Noun
#, java-printf-format
msgctxt "piece_white_rook"
msgid "White Rook"
msgstr "Vitt torn"

#.  ChessBoard: Accessibility description for white bishop. Noun
#, java-printf-format
msgctxt "piece_white_bishop"
msgid "White Bishop"
msgstr "Vit löpare"

#.  ChessBoard: Accessibility description for white knight. Noun
#, java-printf-format
msgctxt "piece_white_knight"
msgid "White Knight"
msgstr "Vit springare"

#.  ChessBoard: Accessibility description for white pawn. Noun
#, java-printf-format
msgctxt "piece_white_pawn"
msgid "White Pawn"
msgstr "Vit bonde"

#.  ChessBoard: Accessibility description for black king. Noun
#, java-printf-format
msgctxt "piece_black_king"
msgid "Black King"
msgstr "Svart kung"

#.  ChessBoard: Accessibility description for black queen. Noun
#, java-printf-format
msgctxt "piece_black_queen"
msgid "Black Queen"
msgstr "Svart dam"

#.  ChessBoard: Accessibility description for black rook. Noun
#, java-printf-format
msgctxt "piece_black_rook"
msgid "Black Rook"
msgstr "Svart torn"

#.  ChessBoard: Accessibility description for black bishop. Noun
#, java-printf-format
msgctxt "piece_black_bishop"
msgid "Black Bishop"
msgstr "Svart löpare"

#.  ChessBoard: Accessibility description for black knight. Noun
#, java-printf-format
msgctxt "piece_black_knight"
msgid "Black Knight"
msgstr "Svart springare"

#.  ChessBoard: Accessibility description for black pawn. Noun
#, java-printf-format
msgctxt "piece_black_pawn"
msgid "Black Pawn"
msgstr "Svart bonde"

#.  MainActivity: Bottom navigation tab for offline (local + AI) play. Noun
#. phrase
#, java-printf-format
msgctxt "tab_offline"
msgid "Offline Play"
msgstr "Spela offline"

#.  MainActivity: Bottom navigation tab for online (Lichess) play. Noun phrase
#, java-printf-format
msgctxt "tab_online"
msgid "Online Play"
msgstr "Spela online"

#.  MainActivity: Bottom navigation tab for Puzzles screen. Noun
#, java-printf-format
msgctxt "tab_puzzles"
msgid "Puzzles"
msgstr "Problem"

#.  MainActivity: Bottom navigation tab for Learn lessons. Noun
#, java-printf-format
msgctxt "tab_learn"
msgid "Learn"
msgstr "Lär dig"

#.  Learn: Stage intro dialog title. %1$d = stage id integer e.g. 1, %2$s =
#. stage title e.g. Basics. Noun heading
#, java-printf-format, xml-text
msgctxt "learn_stage_number"
msgid ""
"Stage <xliff:g id=\"stage_id\" example=\"1\">%1$d</xliff:g>: <xliff:g "
"id=\"stage_title\" example=\"Basics\">%2$s</xliff:g>"
msgstr ""
"Nivå <xliff:g id=\"stage_id\" example=\"1\">%1$d</xliff:g>: <xliff:g "
"id=\"stage_title\" example=\"Basics\">%2$s</xliff:g>"

#.  Learn: CTA button in stage intro to start lessons. Verb phrase
#, java-printf-format
msgctxt "learn_lets_go"
msgid "Let's go!"
msgstr "Kör!"

#.  Learn: Feedback text when lesson succeeded. Declarative, celebratory
#, java-printf-format
msgctxt "learn_completed"
msgid "Well done!"
msgstr "Bra jobbat!"

#.  Learn: StageCompleteDialog title. %1$d = stage id e.g. 2. Noun phrase
#, java-printf-format, xml-text
msgctxt "learn_stage_complete_n"
msgid "Stage <xliff:g id=\"stage_id\" example=\"2\">%1$d</xliff:g> complete"
msgstr "Nivå <xliff:g id=\"stage_id\" example=\"2\">%1$d</xliff:g> klar"

#.  Learn: Score display in stage complete dialog. %1$d = score integer e.g.
#. 350, includes apples, captures, bonus
#, java-printf-format, xml-text
msgctxt "learn_your_score"
msgid "Your score: <xliff:g id=\"score\" example=\"350\">%1$d</xliff:g>"
msgstr "Din poäng: <xliff:g id=\"score\" example=\"350\">%1$d</xliff:g>"

#.  Learn: Button to go to next stage after completing. %1$s = next stage
#. title e.g. Tactics. CTA
#, java-printf-format, xml-text
msgctxt "learn_next_stage"
msgid "Next: <xliff:g id=\"next_stage\" example=\"Tactics\">%1$s</xliff:g>"
msgstr "Nästa: <xliff:g id=\"next_stage\" example=\"Tactics\">%1$s</xliff:g>"

#.  Learn: Button back to main menu after stage complete. Verb phrase
#, java-printf-format
msgctxt "learn_back_to_menu"
msgid "Back to menu"
msgstr "Tillbaka till menyn"

#.  Learn: Progress indicator on stage card. %1$d = completed levels with star
#. e.g. 3, %2$d = total levels e.g. 5. Status
#, java-printf-format, xml-text
msgctxt "learn_progress"
msgid ""
"<xliff:g id=\"done\" example=\"3\">%1$d</xliff:g>/<xliff:g id=\"total\" "
"example=\"5\">%2$d</xliff:g>"
msgstr ""
"<xliff:g id=\"done\" example=\"3\">%1$d</xliff:g>/<xliff:g id=\"total\" "
"example=\"5\">%2$d</xliff:g>"

#.  Puzzles: Header showing puzzle rating. %1$d = Lichess rating integer e.g.
#. 1200. Noun
#, java-printf-format, xml-text
msgctxt "puzzle_rating"
msgid "Rating <xliff:g id=\"rating\" example=\"1200\">%1$d</xliff:g>"
msgstr "Betyg <xliff:g id=\"rating\" example=\"1200\">%1$d</xliff:g>"

#.  Puzzles: Instruction when puzzle starts, user to find best move. Sentence
#, java-printf-format
msgctxt "puzzle_your_move"
msgid "Your turn — find the best move."
msgstr "Din tur. Hitta bästa draget."

#.  Puzzles: Turn indicator White to move. Declarative
#, java-printf-format
msgctxt "puzzle_white_to_move"
msgid "White to move."
msgstr "Vit vid draget."

#.  Puzzles: Turn indicator Black to move. Declarative
#, java-printf-format
msgctxt "puzzle_black_to_move"
msgid "Black to move."
msgstr "Svart vid draget."

#.  Puzzles: Status when puzzle solved correctly. Declarative
#, java-printf-format
msgctxt "puzzle_solved"
msgid "Solved!"
msgstr "Löst!"

#.  Puzzles: Status when puzzle failed. Sentence, encouraging retry
#, java-printf-format
msgctxt "puzzle_failed"
msgid "Not quite — try again."
msgstr "Inte riktigt. Försök igen."

#.  Puzzles: Button to load next random puzzle after solved. Verb phrase
#, java-printf-format
msgctxt "puzzle_next"
msgid "Next Puzzle"
msgstr "Nästa problem"

#.  Puzzles: Button to reveal solution after failing. Verb phrase
#, java-printf-format
msgctxt "puzzle_show_solution"
msgid "Show Solution"
msgstr "Visa lösning"

#.  Puzzles: Loading state while fetching puzzle. Verb progressive
#, java-printf-format
msgctxt "puzzle_loading"
msgid "Loading puzzle…"
msgstr "Läser in problem …"

#.  Online: Sign-in CTA. Opens Lichess OAuth in a Custom Tab. Verb phrase
#, java-printf-format
msgctxt "online_sign_in"
msgid "Sign in with Lichess"
msgstr "Logga in med Lichess"

#.  Online: Signed-in identity line. %1$s = Lichess username e.g. alice.
#. Status
#, java-printf-format, xml-text
msgctxt "online_signed_in_as"
msgid "Signed in as <xliff:g id=\"username\" example=\"alice\">%1$s</xliff:g>"
msgstr "Inloggad som <xliff:g id=\"username\" example=\"alice\">%1$s</xliff:g>"

#.  Online: Sign-out button. Verb phrase
#, java-printf-format
msgctxt "online_sign_out"
msgid "Sign out"
msgstr "Logga ut"

#.  Online: Lobby time-control option 1+0 (1 minute, no increment). Label
#, java-printf-format
msgctxt "online_tc_1_0"
msgid "1+0"
msgstr "1+0"

#.  Online: Lobby time-control option 3+2. Label
#, java-printf-format
msgctxt "online_tc_3_2"
msgid "3+2"
msgstr "3+2"

#.  Online: Lobby time-control option 5+3. Label
#, java-printf-format
msgctxt "online_tc_5_3"
msgid "5+3"
msgstr "5+3"

#.  Online: Lobby time-control option 10+0. Label
#, java-printf-format
msgctxt "online_tc_10_0"
msgid "10+0"
msgstr "10+0"

#.  Online: Quick Seek button, starts matchmaking with selected time control.
#. Verb phrase CTA
#, java-printf-format
msgctxt "online_quick_seek"
msgid "Quick Seek"
msgstr "Snabbsökning"

#.  Online: Seeking indicator while matchmaking. %1$s = time control e.g. 3+2.
#. Verb progressive
#, java-printf-format, xml-text
msgctxt "online_seeking"
msgid "Seeking <xliff:g id=\"time_control\" example=\"3+2\">%1$s</xliff:g>…"
msgstr "Söker <xliff:g id=\"time_control\" example=\"3+2\">%1$s</xliff:g>…"

#.  Online: Username field label for challenge-by-username. Noun phrase
#, java-printf-format
msgctxt "online_challenge_username"
msgid "Challenge by username"
msgstr "Utmana via användarnamn"

#.  Online: Challenge button. Sends a game challenge to the typed username.
#. Verb phrase CTA
#, java-printf-format
msgctxt "online_challenge"
msgid "Challenge"
msgstr "Utmaning"

#.  Online: Confirmation after a challenge is sent. %1$s = opponent username
#. e.g. alice. Sentence
#, java-printf-format, xml-text
msgctxt "online_challenge_sent"
msgid "Challenge sent to <xliff:g id=\"username\" example=\"alice\">%1$s</xliff:g>."
msgstr ""
"Utmaning skickad till <xliff:g id=\"username\" "
"example=\"alice\">%1$s</xliff:g>."

#.  Online: Notice when the challenged player declines. Sentence
#, java-printf-format
msgctxt "online_challenge_declined"
msgid "Challenge declined."
msgstr "Utmaning avvisad."

#.  Online: Waiting for the Lichess approval to come back to the app. Verb
#. progressive
#, java-printf-format
msgctxt "online_signing_in"
msgid "Waiting for Lichess approval…"
msgstr "Väntar på godkännande från Lichess…"

#.  Online: You-resigned result line. Sentence
#, java-printf-format
msgctxt "online_result_resigned"
msgid "You resigned."
msgstr "Du gav upp."

#.  Online: Opponent resigns result line. Sentence
#, java-printf-format
msgctxt "online_result_opponent_resigned"
msgid "Opponent resigned. You win!"
msgstr "Motståndaren gav upp. Du vinner!"

#.  Online: Win result line. Sentence
#, java-printf-format
msgctxt "online_result_win"
msgid "You win!"
msgstr "Du vinner!"

#.  Online: Draw result line. Sentence
#, java-printf-format
msgctxt "online_result_draw"
msgid "Draw."
msgstr "Remi."

#.  Online: Loss result line. Sentence
#, java-printf-format
msgctxt "online_result_loss"
msgid "You lose."
msgstr "Du förlorar."

#.  Online: Back-to-lobby button shown after a game ends. Verb phrase
#, java-printf-format
msgctxt "online_back_to_lobby"
msgid "Back to lobby"
msgstr "Tillbaka till lobbyn"

#.  Online: Resign confirm dialog title. Verb phrase
#, java-printf-format
msgctxt "online_resign_title"
msgid "Resign this game?"
msgstr "Ge upp det här partiet?"

#.  Online: Resign confirm button. Verb
#, java-printf-format
msgctxt "online_resign_confirm"
msgid "Resign"
msgstr "Ge upp"

#.  Online: Abort confirm dialog title. Shown before either side's first move.
#. Verb phrase
#, java-printf-format
msgctxt "online_abort_title"
msgid "Abort this game?"
msgstr "Avbryt det här partiet?"

#.  Online: Abort confirm button. Verb
#, java-printf-format
msgctxt "online_abort_confirm"
msgid "Abort"
msgstr "Avbryt"

#.  Online: Connection banner while the game stream reconnects. Verb
#. progressive
#, java-printf-format
msgctxt "online_reconnecting"
msgid "Reconnecting…"
msgstr "Återansluter…"

#.  Online: Error when the Lichess token expired (HTTP 401). Sentence
#, java-printf-format
msgctxt "online_auth_expired"
msgid "Signed out by Lichess — please sign in again."
msgstr "Du loggades ut av Lichess. Logga in igen."

#.  Online: Error when a seek or challenge fails. Sentence
#, java-printf-format
msgctxt "online_matchmaking_failed"
msgid "Could not start a game. Try again."
msgstr "Kunde inte starta ett parti. Försök igen."

#.  Online: Error when sending a move fails. Sentence
#, java-printf-format
msgctxt "online_move_failed"
msgid "Move not sent. Try again."
msgstr "Draget skickades inte. Försök igen."

#.  Online: Error when sign-in fails. Sentence
#, java-printf-format
msgctxt "online_sign_in_failed"
msgid "Sign-in failed. Try again."
msgstr "Det gick inte att logga in. Försök igen."

#.  Online: Opponent label in game screen. %1$s = opponent username. Noun
#, java-printf-format, xml-text
msgctxt "online_opponent"
msgid "<xliff:g id=\"username\" example=\"alice\">%1$s</xliff:g>"
msgstr "<xliff:g id=\"username\" example=\"alice\">%1$s</xliff:g>"
