#, java-printf-format
msgctxt "editor_desc_invert"
msgid "Invert all colors (photo negative)."
msgstr "Invertera alla färger (fotonegativ)."

#.  Desc: blur background for depth-of-field look (Lens Blur)
#, java-printf-format
msgctxt "editor_desc_lens_blur"
msgid "Blur the background for a depth-of-field look."
msgstr "Gör bakgrunden oskarp för ett kort skärpedjup."

#.  Desc: paint an adjustment onto specific spots (Selective)
#, java-printf-format
msgctxt "editor_desc_selective"
msgid "Paint an adjustment onto specific spots."
msgstr "Måla en justering på specifika områden."

#.  Desc: apply baked-in photo filter to pixels (Filters FX)
#, java-printf-format
msgctxt "editor_desc_filter_fx"
msgid "Apply a baked-in photo filter to the pixels."
msgstr "Använd ett inbakat fotofilter på bildpunkterna."

#.  Desc: push and warp pixels around (Liquify)
#, java-printf-format
msgctxt "editor_desc_liquify"
msgid "Push and warp pixels around."
msgstr "Flytta och förvräng bildpunkter."

#.  Desc: remove blemishes by copying nearby pixels (Healing)
#, java-printf-format
msgctxt "editor_desc_healing"
msgid "Remove blemishes by copying nearby pixels."
msgstr "Ta bort skavanker genom att kopiera närliggande bildpunkter."

#.  Desc: tap each eye to remove red-eye
#, java-printf-format
msgctxt "editor_desc_red_eye"
msgid "Tap each eye to remove red-eye."
msgstr "Tryck på varje öga för att ta bort röda ögon."

#.  Desc: brush to lighten (dodge) or darken (burn)
#, java-printf-format
msgctxt "editor_desc_dodge_burn"
msgid "Brush to lighten (dodge) or darken (burn)."
msgstr "Använd penseln för att ljusa upp eller mörka ned."

#.  Desc: drag to smear pixels like wet paint (Smudge)
#, java-printf-format
msgctxt "editor_desc_smudge"
msgid "Drag to smear pixels like wet paint."
msgstr "Dra för att smeta ut bildpunkter som våt färg."

#.  Desc: draw an area, edits then apply only inside it (Selection)
#, java-printf-format
msgctxt "editor_desc_selection"
msgid "Draw an area; edits then apply only inside it."
msgstr "Rita ett område. Redigeringar används sedan bara i området."

#.  Desc: crop, straighten, and rotate the photo
#, java-printf-format
msgctxt "editor_desc_crop"
msgid "Crop, straighten, and rotate the photo."
msgstr "Beskär, räta upp och rotera bilden."

#.  Desc: scale, rotate, skew, or distort layer by dragging its corners; flip
#. it (Free Transform)
#, java-printf-format
msgctxt "editor_desc_free_transform"
msgid ""
"Scale, rotate, skew, or distort the layer by dragging its corners; flip it."
msgstr ""
"Skala, rotera, skeva eller förvräng lagret genom att dra i hörnen. Vänd det."

#.  Desc: stack, blend, and mask layers
#, java-printf-format
msgctxt "editor_desc_layers"
msgid "Stack, blend, and mask layers."
msgstr "Stapla, blanda och maskera lager."

#.  Desc: brush on active layer mask to hide or reveal parts
#, java-printf-format
msgctxt "editor_desc_mask_paint"
msgid "Brush on the active layer's mask: hide or reveal parts of it."
msgstr ""
"Måla på det aktiva lagrets mask för att dölja eller visa delar av det."

#.  Desc: tap to flood-fill an area with chosen color
#, java-printf-format
msgctxt "editor_desc_fill"
msgid "Tap to flood-fill an area with the chosen color."
msgstr "Tryck för att fylla ett område med den valda färgen."

#.  Desc: drag to draw a color-to-transparent gradient
#, java-printf-format
msgctxt "editor_desc_gradient_tool"
msgid "Drag to draw a color-to-transparent gradient."
msgstr "Dra för att rita en toning från färg till genomskinlighet."

#.  Desc: drag to draw a filled rectangle (Shape tool)
#, java-printf-format
msgctxt "editor_desc_shape_rect"
msgid "Drag to draw a filled rectangle."
msgstr "Dra för att rita en fylld rektangel."

#.  Desc: drag to draw a filled ellipse
#, java-printf-format
msgctxt "editor_desc_shape_ellipse"
msgid "Drag to draw a filled ellipse."
msgstr "Dra för att rita en fylld ellips."

#.  Desc: drag to draw a line
#, java-printf-format
msgctxt "editor_desc_shape_line"
msgid "Drag to draw a line."
msgstr "Dra för att rita en linje."

#, java-printf-format
msgctxt "edit_with_label"
msgid "Edit with My App"
msgstr "Redigera med My App"

#, java-printf-format
msgctxt "live_wallpaper_description"
msgid "Animated wallpaper from your photos"
msgstr "Animerad bakgrund från dina bilder"

#, java-printf-format
msgctxt "live_wallpaper_unavailable"
msgid "Live wallpapers are not supported on this device"
msgstr "Levande bakgrunder stöds inte på den här enheten"
