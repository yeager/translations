#.  App name: launcher label and widget owner title
#, java-printf-format
msgctxt "app_name"
msgid "Photos"
msgstr "Bilder"

#.  Badge on a gallery thumbnail marking an animated GIF. Keep as the
#. uppercase file-format acronym
#, java-printf-format
msgctxt "gif_badge"
msgid "GIF"
msgstr "GIF"

#.  Glance widget description shown in widget picker. Full sentence describing
#. rotating photo widget
#, java-printf-format
msgctxt "photo_widget_description"
msgid "A rotating photo from your gallery - tap to shuffle"
msgstr "Ett roterande foto från galleriet – tryck för att blanda"

#.  Permission prompt button to grant READ_MEDIA_IMAGES/VIDEO. Verb phrase
#, java-printf-format
msgctxt "grant_image_video_permissions"
msgid "Grant Image/Video Permissions"
msgstr "Ge behörighet till bilder och videor"

#.  Button to request storage permission. Shown on Android versions below 13.
#. Verb phrase
#, java-printf-format
msgctxt "grant_storage_permission"
msgid "Grant Storage Permission"
msgstr "Ge lagringsbehörighet"

#.  Title when Media Management permission required to delete/move
#, java-printf-format
msgctxt "media_management_permission_required"
msgid "Media Management Permission Required"
msgstr "Behörighet att hantera media krävs"

#.  Explanatory body when canManageMedia false, tells user to grant Allow
#. media management in Settings
#, java-printf-format
msgctxt "this_app_needs_permission_to_manage_medi"
msgid ""
"This app needs permission to manage media files to function properly. Please"
" grant 'Allow media management' permission in Settings."
msgstr ""
"Appen behöver behörighet att hantera mediefiler för att fungera. Ge "
"behörigheten ”Tillåt mediehantering” i Inställningar."

#.  Button to open system Settings from permission blocker screen. Verb phrase
#, java-printf-format
msgctxt "open_settings"
msgid "Open Settings"
msgstr "Öppna inställningar"

#.  Navigation label: Gallery tab. Noun
#, java-printf-format
msgctxt "label_gallery"
msgid "Gallery"
msgstr "Galleri"

#.  Navigation label: Map tab. Noun
#, java-printf-format
msgctxt "label_map"
msgid "Map"
msgstr "Karta"

#.  Navigation label: People face-grouping tab. Noun plural
#, java-printf-format
msgctxt "label_people"
msgid "People"
msgstr "Personer"

#.  Navigation label: Albums tab. Noun plural
#, java-printf-format
msgctxt "label_albums"
msgid "Albums"
msgstr "Album"

#.  Navigation label: Trash tab. Noun
#, java-printf-format
msgctxt "label_trash"
msgid "Trash"
msgstr "Papperskorg"

#.  Navigation label: Secure Folder tab. Noun phrase
#, java-printf-format
msgctxt "label_secure_folder"
msgid "Secure Folder"
msgstr "Säker mapp"

#.  Empty state centered text when Secure Folder has no photos
#, java-printf-format
msgctxt "secure_folder_is_empty"
msgid "Secure Folder is empty"
msgstr "Den säkra mappen är tom"

#.  Empty state centered text when Trash has no photos
#, java-printf-format
msgctxt "trash_is_empty"
msgid "Trash is empty"
msgstr "Papperskorgen är tom"

#.  Empty state centered text when no albums exist yet (empty library).
#. Sentence
#, java-printf-format
msgctxt "albums_empty"
msgid "No albums yet. Albums appear here once your photos have been synced."
msgstr "Inga album ännu. Album visas här när dina bilder har synkroniserats."

#.  Fallback album name for photos with no MediaStore bucket (rows predating
#. the album column, or bucket-less MediaStore rows). Noun
#, java-printf-format
msgctxt "albums_unknown"
msgid "Unknown"
msgstr "Okänd"

#.  Subtitle per album grid cell showing photo count. %1$d = count
#, java-printf-format, xml-text
msgctxt "album_photo_count"
msgid "<xliff:g id=\"count\" example=\"12\">%1$d</xliff:g> photo"
msgid_plural "<xliff:g id=\"count\" example=\"12\">%1$d</xliff:g> photos"
msgstr[0] "<xliff:g id=\"count\" example=\"12\">%1$d</xliff:g> bild"
msgstr[1] "<xliff:g id=\"count\" example=\"12\">%1$d</xliff:g> bilder"

#.  Title of the selection action / dialog to add the chosen photos to an
#. album. Verb phrase
#, java-printf-format
msgctxt "label_add_to_album"
msgid "Add to album"
msgstr "Lägg till i album"

#.  Text field label/hint for entering an album name. Noun
#, java-printf-format
msgctxt "album_name_hint"
msgid "Album name"
msgstr "Albumnamn"

#.  Confirm button in the add-to-album dialog that creates a new album. Verb
#, java-printf-format
msgctxt "album_create"
msgid "Create"
msgstr "Skapa"

#.  Overflow menu item / confirm button to rename the current album. Verb
#, java-printf-format
msgctxt "album_rename"
msgid "Rename"
msgstr "Byt namn"

#.  Overflow menu item / confirm button to delete the current album. Verb
#, java-printf-format
msgctxt "album_delete"
msgid "Delete album"
msgstr "Ta bort album"

#.  Delete-album confirmation body. Photos are kept; only the album grouping
#. is removed. %1$s = album name
#, java-printf-format, xml-text
msgctxt "album_delete_confirm"
msgid ""
"Remove the album \"<xliff:g id=\"name\" example=\"Beach\">%1$s</xliff:g>\"? "
"The photos will be kept and returned to your library."
msgstr ""
"Ta bort albumet ”<xliff:g id=\"name\" example=\"Beach\">%1$s</xliff:g>”? "
"Bilderna behålls och återgår till biblioteket."

#.  Generic cancel button in dialogs. Verb
#, java-printf-format
msgctxt "action_cancel"
msgid "Cancel"
msgstr "Avbryt"

#.  Generic selection count badge in TopAppBar of Gallery, SecureFolder,
#. Trash. %1$d = number selected
#, java-printf-format, xml-text
msgctxt "items_selected"
msgid "<xliff:g id=\"count\" example=\"5\">%1$d</xliff:g> selected"
msgstr "<xliff:g id=\"count\" example=\"5\">%1$d</xliff:g> valda"

#.  Vault viewer error when the encrypted file cannot be decrypted to the
#. cache. Sentence
#, java-printf-format
msgctxt "vault_viewer_decrypt_failed"
msgid "Couldn't open this item"
msgstr "Kunde inte öppna objektet"

#.  Vault viewer message when the item no longer exists in the vault. Sentence
#, java-printf-format
msgctxt "vault_viewer_not_found"
msgid "This item is no longer in the Secure Folder"
msgstr "Objektet finns inte längre i den säkra mappen"

#.  Gallery grouping header: month + year. %1$s = month name e.g. January,
#. %2$d = year e.g. 2024
#, java-printf-format, xml-text
msgctxt "month_year_format"
msgid ""
"<xliff:g id=\"month\" example=\"January\">%1$s</xliff:g> <xliff:g "
"id=\"year\" example=\"2024\">%2$d</xliff:g>"
msgstr ""
"<xliff:g id=\"month\" example=\"January\">%1$s</xliff:g> <xliff:g "
"id=\"year\" example=\"2024\">%2$d</xliff:g>"

#.  Search bar placeholder hint. Noun phrase with ellipsis
#, java-printf-format
msgctxt "search_placeholder"
msgid "Search photos…"
msgstr "Sök bilder…"

#.  Gallery progress when query empty: percent of photos processed. %1$d =
#. percent 0-100, %% literal percent sign
#, java-printf-format, xml-text
msgctxt "of_photos_processed"
msgid "<xliff:g id=\"percent\" example=\"45\">%1$d</xliff:g>%% of photos processed"
msgstr ""
"<xliff:g id=\"percent\" example=\"45\">%1$d</xliff:g> %% av bilderna "
"bearbetade"

#.  Gallery progress: visual search embedding index progress. %1$d = done,
#. %2$d = total
#, java-printf-format, xml-text
msgctxt "photos_indexed_for_visual_search"
msgid ""
"<xliff:g id=\"done\" example=\"120\">%1$d</xliff:g> / <xliff:g id=\"total\" "
"example=\"500\">%2$d</xliff:g> photos indexed for visual search"
msgstr ""
"<xliff:g id=\"done\" example=\"120\">%1$d</xliff:g> / <xliff:g id=\"total\" "
"example=\"500\">%2$d</xliff:g> bilder indexerade för visuell sökning"

#.  Gallery progress: text search OCR index progress. %1$d = done, %2$d =
#. total
#, java-printf-format, xml-text
msgctxt "photos_indexed_for_text_search"
msgid ""
"<xliff:g id=\"done\" example=\"120\">%1$d</xliff:g> / <xliff:g id=\"total\" "
"example=\"500\">%2$d</xliff:g> photos indexed for text search"
msgstr ""
"<xliff:g id=\"done\" example=\"120\">%1$d</xliff:g> / <xliff:g id=\"total\" "
"example=\"500\">%2$d</xliff:g> bilder indexerade för textsökning"

#.  ListItem shown when the bundled AI search model could not be loaded
#, java-printf-format
msgctxt "semantic_search_unavailable"
msgid ""
"AI photo search is unavailable on this install. Text and filename search "
"still work."
msgstr ""
"AI-bildsökning är inte tillgänglig i den här installationen. Sökning i text "
"och filnamn fungerar ändå."

#.  Empty state: no faces found yet, scanning happens in background background
#. explanation
#, java-printf-format
msgctxt "people_empty"
msgid ""
"No people found yet. Scanning happens in the background — check back after "
"your photos have been indexed."
msgstr ""
"Inga personer hittades ännu. Genomsökning sker i bakgrunden. Titta igen när "
"bilderna har indexerats."

#.  Subtitle while face grouping still running. Sentence with ellipsis
#, java-printf-format
msgctxt "people_scanning"
msgid "Grouping faces… people will appear here as they are found."
msgstr "Grupperar ansikten… personer visas här när de hittas."

#.  Linear progress text for face indexing. %1$d = processed, %2$d = total
#, java-printf-format, xml-text
msgctxt "face_indexing_progress"
msgid ""
"Indexing <xliff:g id=\"processed\" example=\"20\">%1$d</xliff:g> / <xliff:g "
"id=\"total\" example=\"100\">%2$d</xliff:g>"
msgstr ""
"Indexerar <xliff:g id=\"processed\" example=\"20\">%1$d</xliff:g> / <xliff:g"
" id=\"total\" example=\"100\">%2$d</xliff:g>"

#.  Error when mobilefacenet.tflite model missing, instructions to add asset
#. with FaceRecognizer reference
#, java-printf-format
msgctxt "people_model_missing"
msgid ""
"Face grouping needs a MobileFaceNet model. Add a permissively-licensed "
"mobilefacenet.tflite to photos/src/main/assets (see FaceRecognizer)."
msgstr ""
"Ansiktsgruppering kräver en MobileFaceNet-modell. Lägg till en tillåtande "
"licensierad mobilefacenet.tflite i photos/src/main/assets (se "
"FaceRecognizer)."

#.  Subtitle per person grid cell showing photo count. %1$d = count
#, java-printf-format, xml-text
msgctxt "people_photo_count"
msgid "<xliff:g id=\"count\" example=\"12\">%1$d</xliff:g> photo"
msgid_plural "<xliff:g id=\"count\" example=\"12\">%1$d</xliff:g> photos"
msgstr[0] "<xliff:g id=\"count\" example=\"12\">%1$d</xliff:g> bild"
msgstr[1] "<xliff:g id=\"count\" example=\"12\">%1$d</xliff:g> bilder"

#.  Label under a person grid cell with no name yet; tapping it opens the
#. contact picker. Adjective
#, java-printf-format
msgctxt "people_unnamed"
msgid "Unnamed"
msgstr "Namnlös"

#.  Photo detail badge: number of people in this photo. Plural handling. %1$d
#. = count
#, java-printf-format, xml-text
msgctxt "people_in_photo"
msgid "<xliff:g id=\"count\" example=\"1\">%1$d</xliff:g> person"
msgid_plural "<xliff:g id=\"count\" example=\"3\">%1$d</xliff:g> people"
msgstr[0] "<xliff:g id=\"count\" example=\"1\">%1$d</xliff:g> person"
msgstr[1] "<xliff:g id=\"count\" example=\"1\">%1$d</xliff:g> personer"

#.  Metadata row: capture date label. %1$s = formatted date e.g. Jan 5 2024
#, java-printf-format, xml-text
msgctxt "taken_on"
msgid "Taken on: <xliff:g id=\"date\" example=\"Jan 5, 2024\">%1$s</xliff:g>"
msgstr "Tagen: <xliff:g id=\"date\" example=\"Jan 5, 2024\">%1$s</xliff:g>"

#.  Metadata row: reverse geocoded location. %1$s = place name
#, java-printf-format, xml-text
msgctxt "location"
msgid "Location: <xliff:g id=\"place\" example=\"Paris, France\">%1$s</xliff:g>"
msgstr "Plats: <xliff:g id=\"place\" example=\"Paris, France\">%1$s</xliff:g>"

#.  Metadata row: image resolution. %1$d = width e.g. 4000, %2$d = height e.g.
#. 3000, keep 'x' separator
#, java-printf-format, xml-text
msgctxt "resolution"
msgid ""
"Resolution: <xliff:g id=\"width\" example=\"4000\">%1$d</xliff:g> x <xliff:g"
" id=\"height\" example=\"3000\">%2$d</xliff:g>"
msgstr ""
"Upplösning: <xliff:g id=\"width\" example=\"4000\">%1$d</xliff:g> × <xliff:g"
" id=\"height\" example=\"3000\">%2$d</xliff:g>"

#.  Metadata row: file size on disk. %1$s = formatted size e.g. 2.5 MB
#, java-printf-format, xml-text
msgctxt "file_size"
msgid "Size: <xliff:g id=\"size\" example=\"2.5 MB\">%1$s</xliff:g>"
msgstr "Storlek: <xliff:g id=\"size\" example=\"2.5 MB\">%1$s</xliff:g>"

#.  Metadata overlay placeholder while reverse geocoding pending. Verb present
#. participle
#, java-printf-format
msgctxt "detecting"
msgid "Detecting…"
msgstr "Identifierar…"

#.  Button to open 360 degree photo viewer. Verb phrase with degree symbol
#, java-printf-format
msgctxt "view_360"
msgid "View 360°"
msgstr "Visa 360°"

#.  Button to open panorama viewer. Verb phrase
#, java-printf-format
msgctxt "view_panorama"
msgid "View panorama"
msgstr "Visa panorama"

#.  Fallback label when panorama type detected but no specific kind
#, java-printf-format
msgctxt "panorama"
msgid "Panorama"
msgstr "Panorama"

#.  Button to play the embedded clip of a motion photo, replacing the still.
#. Verb phrase
#, java-printf-format
msgctxt "play_motion_photo"
msgid "Play motion photo"
msgstr "Spela upp rörligt foto"

#.  Button to stop motion-photo playback and return to the still. Verb phrase
#, java-printf-format
msgctxt "stop_motion_photo"
msgid "Stop motion"
msgstr "Stoppa rörelse"

#.  Viewer metadata badge marking a motion photo (a still with an embedded
#. clip). Keep uppercase
#, java-printf-format
msgctxt "motion_badge"
msgid "MOTION"
msgstr "RÖRELSE"

#.  Snackbar when the embedded motion-photo clip could not be extracted for
#. playback. Sentence
#, java-printf-format
msgctxt "motion_photo_failed"
msgid "Couldn't play the motion photo."
msgstr "Kunde inte spela upp det rörliga fotot."

#.  Secure Folder settings dialog title. Noun phrase
#, java-printf-format
msgctxt "secure_folder_relock_title"
msgid "Secure Folder settings"
msgstr "Inställningar för säker mapp"

#.  Secure Folder settings row label for the re-lock-on-exit toggle. Verb
#. phrase
#, java-printf-format
msgctxt "secure_folder_relock_label"
msgid "Lock when leaving"
msgstr "Lås när du lämnar"

#.  Secure Folder settings row description explaining the re-lock toggle.
#. Sentence
#, java-printf-format
msgctxt "secure_folder_relock_description"
msgid ""
"When on, the Secure Folder locks every time you leave it and asks for unlock"
" on every open."
msgstr ""
"När detta är på låses den säkra mappen varje gång du lämnar den och ber om "
"upplåsning vid varje öppning."

#.  TopAppBar title for photo editor screen. Verb phrase
#, java-printf-format
msgctxt "title_edit_photo"
msgid "Edit Photo"
msgstr "Redigera bild"

#.  Menu item: save, overwrites original. Verb
#, java-printf-format
msgctxt "action_save"
msgid "Save"
msgstr "Spara"

#.  Menu item: save as copy, keeps original. Verb phrase
#, java-printf-format
msgctxt "action_save_as_copy"
msgid "Save as Copy"
msgstr "Spara som kopia"

#.  Reset all adjustments to default. Verb phrase
#, java-printf-format
msgctxt "reset_all"
msgid "Reset All"
msgstr "Återställ allt"

#.  Export menu: export current image as WebP format. Verb phrase
#, java-printf-format
msgctxt "export_as_webp"
msgid "Export as WebP"
msgstr "Exportera som WebP"

#.  Export menu: export as PNG format. Verb phrase
#, java-printf-format
msgctxt "export_as_png"
msgid "Export as PNG"
msgstr "Exportera som PNG"

#.  TopAppBar title for video editor screen. Verb phrase
#, java-printf-format
msgctxt "title_edit_video"
msgid "Edit Video"
msgstr "Redigera video"

#.  Video editor tool: trim clip length. Verb
#, java-printf-format
msgctxt "video_trim"
msgid "Trim"
msgstr "Trimma"

#.  Hint under crop/rotate tools: drag the corner handles on the preview to
#. crop. Sentence instruction
#, java-printf-format
msgctxt "video_crop_hint"
msgid "Drag the corners on the preview to crop."
msgstr "Dra i hörnen på förhandsvisningen för att beskära."

#.  Video editor tool: audio track. Noun
#, java-printf-format
msgctxt "video_audio"
msgid "Audio"
msgstr "Ljud"

#.  Button label: audio is currently on (tap to mute). Adjective phrase
#, java-printf-format
msgctxt "video_audio_on"
msgid "Audio on"
msgstr "Ljud på"

#.  Button label: audio is currently muted (tap to unmute). Adjective
#, java-printf-format
msgctxt "video_muted"
msgid "Muted"
msgstr "Avstängt ljud"

#.  Filter preset: no filter. Noun
#, java-printf-format
msgctxt "video_filter_none"
msgid "None"
msgstr "Ingen"

#.  Filter preset: black &amp; white. Noun
#, java-printf-format
msgctxt "video_filter_mono"
msgid "Mono"
msgstr "Mono"

#.  Filter preset: warm tint. Adjective
#, java-printf-format
msgctxt "video_filter_warm"
msgid "Warm"
msgstr "Varm"

#.  Filter preset: cool tint. Adjective
#, java-printf-format
msgctxt "video_filter_cool"
msgid "Cool"
msgstr "Kall"

#.  Filter preset: vivid/saturated. Adjective
#, java-printf-format
msgctxt "video_filter_vivid"
msgid "Vivid"
msgstr "Livfull"

#.  Save dialog body: ask whether to keep original or overwrite. Question
#, java-printf-format
msgctxt "video_save_prompt"
msgid "Save the edited video as a new copy or overwrite the original?"
msgstr ""
"Spara den redigerade videon som en ny kopia eller skriv över originalet?"

#.  Save dialog button: overwrite the original video. Verb
#, java-printf-format
msgctxt "video_overwrite"
msgid "Overwrite"
msgstr "Skriv över"

#.  Progress dialog title while exporting the video. Verb
#, java-printf-format
msgctxt "video_exporting"
msgid "Exporting…"
msgstr "Exporterar…"

#.  Toast/message when video export fails. Sentence
#, java-printf-format
msgctxt "video_export_failed"
msgid "Video export failed."
msgstr "Videoexporten misslyckades."

#.  "Edit with" chooser label for the external video edit intent
#, java-printf-format
msgctxt "video_edit_with_label"
msgid "Edit video with My App"
msgstr "Redigera video med My App"

#.  Slider label: opacity of brush stroke. Noun
#, java-printf-format
msgctxt "opacity"
msgid "Opacity"
msgstr "Opacitet"

#.  Slider label: thickness of brush/line. Noun
#, java-printf-format
msgctxt "thickness"
msgid "Thickness"
msgstr "Tjocklek"

#.  Section header: color picker. Noun
#, java-printf-format
msgctxt "color"
msgid "Color"
msgstr "Färg"

#.  Recent colors section header. Adjective
#, java-printf-format
msgctxt "recent"
msgid "Recent"
msgstr "Senaste"

#.  Label for aspect ratio lock dropdown. Noun phrase
#, java-printf-format
msgctxt "aspect_ratio"
msgid "Aspect ratio"
msgstr "Bildförhållande"

#.  Tooltip: drag corners to distort free transform. Sentence instruction
#, java-printf-format
msgctxt "drag_corners_to_distort"
msgid "Drag corners to distort."
msgstr "Dra i hörnen för att förvränga."

#.  Button: rotate image 90 degrees. Verb phrase with symbol
#, java-printf-format
msgctxt "rotate_90"
msgid "Rotate 90°"
msgstr "Rotera 90°"

#.  Tool name: rotate / straighten. Verb
#, java-printf-format
msgctxt "rotate"
msgid "Rotate"
msgstr "Rotera"

#.  Hint for selection combine mode: how to add points. %1$s = current mode
#. e.g. New. Keep colon
#, java-printf-format, xml-text
msgctxt "tap_to_add_points"
msgid "Tap to add points (<xliff:g id=\"mode\" example=\"New\">%1$s</xliff:g>)"
msgstr ""
"Tryck för att lägga till punkter (<xliff:g id=\"mode\" "
"example=\"New\">%1$s</xliff:g>)"

#.  Slider/tool: edge softness/feather of selection. Noun phrase
#, java-printf-format
msgctxt "edge_softness"
msgid "Edge softness"
msgstr "Kantmjukhet"

#.  Combine mode for selections: boolean combination. Verb
#, java-printf-format
msgctxt "combine"
msgid "Combine"
msgstr "Kombinera"

#.  Tool: fill flood with color. Noun/verb ambiguous, used as tool name noun
#, java-printf-format
msgctxt "tolerance"
msgid "Tolerance"
msgstr "Tolerans"

#.  Dialog title: edit text content for text layer
#, java-printf-format
msgctxt "edit_text"
msgid "Edit Text"
msgstr "Redigera text"

#.  Info text: instruction to tap image to pick color with eyedropper
#, java-printf-format
msgctxt "tap_the_image_to_pick_a_color"
msgid "Tap the image to pick a color."
msgstr "Tryck på bilden för att välja en färg."

#.  Tool: font selection for text layer. Noun
#, java-printf-format
msgctxt "font"
msgid "Font"
msgstr "Teckensnitt"

#.  Slider label: brush size for healing. Noun phrase
#, java-printf-format
msgctxt "brush_size"
msgid "Brush Size"
msgstr "Penselstorlek"

#.  Switch label: set clone source point for healing/clone tool
#, java-printf-format
msgctxt "set_source_point"
msgid "Set Source Point"
msgstr "Ange källpunkt"

#.  Toggle: show mask overlay. Verb phrase
#, java-printf-format
msgctxt "show_mask"
msgid "Show Mask"
msgstr "Visa mask"

#.  Button: add new mask to active layer. Verb phrase
#, java-printf-format
msgctxt "add_mask"
msgid "Add Mask"
msgstr "Lägg till mask"

#.  Explanatory text after inverting colors: how to undo via layer visibility
#. toggle
#, java-printf-format
msgctxt "colors_inverted_toggle_the_layer_s_visib"
msgid ""
"Colors inverted. Toggle the layer's visibility or delete the Invert layer to"
" undo."
msgstr ""
"Färgerna är inverterade. Växla lagrets synlighet eller ta bort lagret "
"Invertera för att ångra."

#.  Info hint for draw tools row: explains freehand, highlight, erase, tap for
#. text, tap again to change color/size
#, java-printf-format
msgctxt "draw_freehand_highlight_erase_or_tap_to"
msgid ""
"Draw freehand, highlight, erase, or tap to add text. Tap a tool again to "
"change its color and size."
msgstr ""
"Rita på fri hand, markera, sudda eller tryck för att lägga till text. Tryck "
"på verktyget igen för att ändra färg och storlek."

#.  Info hint for crop aspect ratio lock: explains Free vs fixed width:height
#. shape
#, java-printf-format
msgctxt "locks_the_crop_to_a_fixed_width_height_s"
msgid ""
"Locks the crop to a fixed width:height shape. \"Free\" lets you crop to any "
"size."
msgstr ""
"Låser beskärningen till ett fast förhållande mellan bredd och höjd. ”Fri” "
"låter dig beskära i valfri storlek."

#.  Info hint for crop rotate handle: drag round handle above crop box to tilt
#. and straighten
#, java-printf-format
msgctxt "drag_the_round_handle_above_the_crop_box"
msgid ""
"Drag the round handle above the crop box to tilt and straighten the photo."
msgstr ""
