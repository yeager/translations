msgstr "Engelska"

#, java-printf-format
msgctxt "abc"
msgid "ABC"
msgstr "ABC"

#, java-printf-format
msgctxt "enable_keyboard"
msgid "Enable keyboard"
msgstr "Aktivera tangentbord"

#, java-printf-format
msgctxt "choose_keyboard"
msgid "Choose keyboard"
msgstr "Välj tangentbord"

#, java-printf-format
msgctxt "key_height"
msgid "Key height"
msgstr "Tangenthöjd"

#, java-printf-format
msgctxt "theme"
msgid "Theme"
msgstr "Tema"

#, java-printf-format
msgctxt "follows_the_system_light_dark_theme_and"
msgid "Follows the system light/dark theme and Material You colors"
msgstr "Följer systemets ljusa/mörka tema och Material You-färger"

#, java-printf-format
msgctxt "try_the_keyboard_here"
msgid "Try the keyboard here"
msgstr "Prova tangentbordet här"

#, java-printf-format
msgctxt "keyboard_languages"
msgid "Keyboard languages"
msgstr "Tangentbordsspråk"

#, java-printf-format
msgctxt "available_for_english_layouts_only"
msgid "Available for English layouts only"
msgstr "Tillgängligt endast för engelska tangentbordslayouter"

#, java-printf-format
msgctxt "search_emoji"
msgid "Search emoji"
msgstr "Sök efter emoji"

#, java-printf-format
msgctxt "emoji_you_use_show_up_here"
msgid "Emoji you use show up here"
msgstr "Emoji som du använder visas här"

#, java-printf-format
msgctxt "image"
msgid "Image"
msgstr "Bild"

#, java-printf-format
msgctxt "clear_clipboard"
msgid "Clear all"
msgstr "Rensa allt"

#, java-printf-format
msgctxt "clear_clipboard_history"
msgid "Clear clipboard history"
msgstr "Rensa urklippshistoriken"

#, java-printf-format
msgctxt "copied_text_shows_up_here"
msgid "Copied text and images show up here"
msgstr "Kopierad text och kopierade bilder visas här"

#.  Fallback label for a framework input-method subtype on platforms below API
#. 34, where per-subtype names are unavailable.
#, java-printf-format
msgctxt "subtype_keyboard"
msgid "Keyboard"
msgstr "Tangentbord"

#.  Keyboard: shown in the strip above the keys when an image clip cannot be
#. pasted because the cached file is gone.
#, java-printf-format
msgctxt "clipboard_image_unavailable"
msgid "Image is no longer available"
msgstr "Bilden är inte längre tillgänglig"

#.  Keyboard: shown in the strip above the keys when an image clip cannot be
#. pasted because the field only accepts text.
#, java-printf-format
msgctxt "clipboard_image_not_supported"
msgid "This field doesn't accept images"
msgstr "Det här fältet accepterar inte bilder"

#.  Keyboard setup screen.
#, java-printf-format
msgctxt "setting_haptic_feedback"
msgid "Haptic feedback"
msgstr "Haptisk återkoppling"

#, java-printf-format
msgctxt "setting_key_sound"
msgid "Key sound"
msgstr "Tangentljud"

#, java-printf-format
msgctxt "setting_auto_capitalize"
msgid "Auto-capitalize"
msgstr "Automatisk stor bokstav"

#, java-printf-format
msgctxt "setting_double_space_period"
msgid "Double-space inserts period"
msgstr "Dubbeltryck på mellanslag infogar punkt"

#, java-printf-format
msgctxt "setting_show_suggestions"
msgid "Show suggestions"
msgstr "Visa förslag"

#, java-printf-format
msgctxt "setting_auto_correct"
msgid "Auto-correct"
msgstr "Automatisk korrigering"

#, java-printf-format
msgctxt "setting_number_row"
msgid "Number row"
msgstr "Sifferrad"

#, java-printf-format
msgctxt "setting_clipboard_history"
msgid "Clipboard history"
msgstr "Urklippshistorik"

#, java-printf-format
msgctxt "setting_clipboard_history_desc"
msgid "Remember what you copy and offer it back above the keys"
msgstr "Kom ihåg det du kopierar och erbjud det igen ovanför tangenterna"

#, java-printf-format
msgctxt "status_enabled"
msgid "Enabled in system settings"
msgstr "Aktiverat i systeminställningarna"

#, java-printf-format
msgctxt "status_selected"
msgid "Selected as active keyboard"
msgstr "Valt som aktivt tangentbord"

#.  Accessibility label for the long-press action on the keyboard's enter key,
#. which starts dictation.
#, java-printf-format
msgctxt "voice_input"
msgid "Voice input"
msgstr "Röstinmatning"

#.  Keyboard: shown in the strip above the keys while the microphone is
#. recording speech.
#, java-printf-format
msgctxt "voice_listening"
msgid "Listening…"
msgstr "Lyssnar …"

#.  Keyboard: shown in the strip above the keys after recording stops, while
#. the speech is being turned into text.
#, java-printf-format
msgctxt "voice_transcribing"
msgid "Transcribing…"
msgstr "Transkriberar …"

#.  Keyboard error in the strip above the keys: the device has no speech
#. recognition app installed at all.
#, java-printf-format
msgctxt "voice_unavailable"
msgid "No speech recognition app installed"
msgstr "Ingen app för taligenkänning är installerad"

#.  Keyboard error in the strip above the keys: the user declined the
#. microphone permission prompt.
#, java-printf-format
msgctxt "voice_permission_denied"
msgid "Voice input needs the microphone"
msgstr "Röstinmatning behöver mikrofonen"

#.  Keyboard error in the strip above the keys: the microphone permission was
#. permanently denied, so it can only be granted in system settings. A
#. settings button sits next to this text.
#, java-printf-format
msgctxt "voice_permission_blocked"
msgid "Allow the microphone in Settings"
msgstr "Tillåt mikrofonen i Inställningar"

#.  Keyboard error in the strip above the keys: speech recognition needs a
#. network connection and there is none.
#, java-printf-format
msgctxt "voice_network"
msgid "Voice input needs a connection"
msgstr "Röstinmatning behöver en anslutning"

#.  Keyboard error in the strip above the keys: the recording contained no
#. recognizable speech.
#, java-printf-format
msgctxt "voice_no_speech"
msgid "Didn't catch that"
msgstr "Uppfattade inte det"

#.  Keyboard error in the strip above the keys: the speech recognizer is
#. already busy with another request.
#, java-printf-format
msgctxt "voice_busy"
msgid "Speech recognizer is busy"
msgstr "Taligenkännaren är upptagen"

#.  Keyboard error in the strip above the keys: the microphone could not be
#. recorded from.
#, java-printf-format
msgctxt "voice_audio_error"
msgid "Couldn't record audio"
msgstr "Det gick inte att spela in ljud"

#.  Keyboard error in the strip above the keys: dictation failed for a reason
#. we cannot be more specific about.
#, java-printf-format
msgctxt "voice_failed"
msgid "Voice input failed"
msgstr "Röstinmatningen misslyckades"
