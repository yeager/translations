#.  App name displayed in launcher and system Accounts settings
#, java-printf-format
msgctxt "app_name"
msgid "EverySync"
msgstr "EverySync"

#.  AccountsScreen: TopAppBar title for accounts list home screen
#, java-printf-format
msgctxt "accounts_title"
msgid "EverySync"
msgstr "EverySync"

#.  AccountsScreen empty state / AccountDetail fallback: Message when no
#. accounts added yet. Includes + hint
#, java-printf-format
msgctxt "no_accounts"
msgid "No accounts yet. Tap + to add one."
msgstr "Inga konton ännu. Tryck på + för att lägga till ett."

#.  AccountDetailScreen: Button to trigger immediate sync for this account.
#. Verb phrase
#, java-printf-format
msgctxt "sync_now"
msgid "Sync now"
msgstr "Synkronisera nu"

#.  AccountsScreen: Row status showing sync currently in progress
#, java-printf-format
msgctxt "syncing"
msgid "Syncing…"
msgstr "Synkroniserar…"

#.  AccountsScreen: Row showing last sync time. %1$s = formatted date/time
#, java-printf-format, xml-text
msgctxt "last_synced"
msgid "Last synced: <xliff:g id=\"date\" example=\"Today 10:30 AM\">%1$s</xliff:g>"
msgstr "Senast synkroniserad: %1$s"

#.  AccountsScreen: Row status when account never synced before
#, java-printf-format
msgctxt "never_synced"
msgid "Never synced"
msgstr "Aldrig synkroniserad"

#.  AddAccountScreen: TopAppBar title for provider chooser screen
#, java-printf-format
msgctxt "add_account_title"
msgid "Add account"
msgstr "Lägg till konto"

#.  AccountDetailScreen: Toggle label for contacts sync capability. Verb
#. phrase
#, java-printf-format
msgctxt "sync_contacts"
msgid "Sync contacts"
msgstr "Synkronisera kontakter"

#.  AccountDetailScreen: Toggle label for calendar sync capability. Verb
#. phrase
#, java-printf-format
msgctxt "sync_calendar"
msgid "Sync calendars"
msgstr "Synkronisera kalendrar"

#.  AccountDetailScreen: Toggle label for passwords vault sync capability.
#. Verb phrase
#, java-printf-format
msgctxt "sync_passwords"
msgid "Sync passwords"
msgstr "Synkronisera lösenord"

#.  AccountDetailScreen: Toggle label for notes vault sync capability. Verb
#. phrase
#, java-printf-format
msgctxt "sync_notes"
msgid "Sync notes"
msgstr "Synkronisera anteckningar"

#.  AccountDetailScreen: Toggle label for todos vault sync capability. Verb
#. phrase
#, java-printf-format
msgctxt "sync_todos"
msgid "Sync todos"
msgstr "Synkronisera uppgifter"

#.  AccountDetailScreen: Destructive button to remove account from app. Verb
#. phrase
#, java-printf-format
msgctxt "remove_account"
msgid "Remove account"
msgstr "Ta bort konto"

#.  VaultSharingSection: Section header over personal E2EE vaults. Noun,
#. plural
#, java-printf-format
msgctxt "vaults_title"
msgid "Personal vaults"
msgstr "Personliga valv"

#.  VaultSharingSection: Label for the new-vault title field. Noun phrase
#, java-printf-format
msgctxt "vault_new_title"
msgid "New vault title"
msgstr "Nytt valvnamn"

#.  VaultSharingSection: Button creating a contacts vault. Verb + noun
#, java-printf-format
msgctxt "vault_create_contacts"
msgid "Contacts vault"
msgstr "Kontaktvalv"

#.  VaultSharingSection: Button creating a calendar vault. Verb + noun
#, java-printf-format
msgctxt "vault_create_calendar"
msgid "Calendar vault"
msgstr "Kalendervalv"

#.  VaultSharingSection: Empty state when no vaults exist yet. Full sentence
#, java-printf-format
msgctxt "vaults_empty"
msgid "No vaults yet. Name one above to create an end-to-end encrypted vault."
msgstr ""
"Inga valv ännu. Ange ett namn ovan för att skapa ett ände-till-ände-"
"krypterat valv."

#.  VaultRow: Button opening the share dialog. Verb
#, java-printf-format
msgctxt "vault_share"
msgid "Share"
msgstr "Dela"

#.  VaultSharingSection: Chooser title for the share-link sheet. Noun phrase
#, java-printf-format
msgctxt "share_link_chooser"
msgid "Share vault link"
msgstr "Dela länk till valv"

#.  Vault flow: Snackbar after a sealed invite is delivered. Short
#. confirmation
#, java-printf-format
msgctxt "invite_sent"
msgid "Invite sent"
msgstr "Inbjudan skickad"

#.  Vault flow: Snackbar when sealing or delivering an invite fails. Short
#. error
#, java-printf-format
msgctxt "invite_failed"
msgid "Could not send invite"
msgstr "Kunde inte skicka inbjudan"

#.  Vault flow: Snackbar after creating a vault. Short confirmation
#, java-printf-format
msgctxt "vault_created"
msgid "Vault created"
msgstr "Valv skapat"

#.  Vault flow: Snackbar when vault creation fails. Short error
#, java-printf-format
msgctxt "vault_create_failed"
msgid "Could not create vault"
msgstr "Kunde inte skapa valvet"

#.  Vault flow: Snackbar when the safety code cannot be computed. Short error
#, java-printf-format
msgctxt "safety_code_failed"
msgid "Could not compute safety code"
msgstr "Kunde inte beräkna säkerhetskoden"

#.  Join-link flow: Snackbar while the join request sends. Verb, progressive
#, java-printf-format
msgctxt "join_request_sending"
msgid "Sending join request…"
msgstr "Skickar begäran om anslutning…"

#.  Join-link flow: Snackbar after the join request is delivered. Short
#. confirmation
#, java-printf-format
msgctxt "join_request_sent"
msgid "Join request sent"
msgstr "Begäran om anslutning skickad"

#.  Join-link flow: Snackbar when the join request fails. Short error
#, java-printf-format
msgctxt "join_request_failed"
msgid "Could not send join request"
msgstr "Kunde inte skicka begäran om anslutning"

#.  SettingsScreen: TopAppBar title for global settings
#, java-printf-format
msgctxt "settings_title"
msgid "Settings"
msgstr "Inställningar"

#.  SettingsScreen: Label for global sync interval in minutes field
#, java-printf-format
msgctxt "global_interval"
msgid "Sync interval (minutes)"
msgstr "Synkroniseringsintervall (minuter)"

#.  SettingsScreen: Switch label to restrict syncing to Wi-Fi only
#, java-printf-format
msgctxt "wifi_only"
msgid "Sync on Wi-Fi only"
msgstr "Synkronisera endast via Wi-Fi"

#.  SettingsScreen: Section header for conflict resolution policy radios
#, java-printf-format
msgctxt "conflict_policy"
msgid "Conflict resolution"
msgstr "Konfliktlösning"

#.  SettingsScreen conflict option: Last writer wins strategy. Phrase
#, java-printf-format
msgctxt "conflict_lww"
msgid "Last writer wins"
msgstr "Senaste ändringen vinner"

#.  SettingsScreen conflict option: Prefer data from server when conflict.
#. Verb phrase
#, java-printf-format
msgctxt "conflict_remote"
msgid "Prefer server"
msgstr "Föredra servern"

#.  SettingsScreen conflict option: Prefer local device data when conflict.
#. Verb phrase
#, java-printf-format
msgctxt "conflict_local"
msgid "Prefer device"
msgstr "Föredra enheten"

#.  AccountsScreen PermissionsChecker: Rationale text explaining why
#. contacts/calendar permission needed
#, java-printf-format
msgctxt "need_permissions"
msgid "EverySync needs contacts and calendar access to sync your vaults."
msgstr ""
"EverySync behöver åtkomst till kontakter och kalender för att synkronisera "
"dina valv."

#.  SyncErrorBanner: user-facing text for stable abort codes (see
#. VaultSyncAbort). No key material, no contents
#, java-printf-format
msgctxt "sync_error_pull_failed"
msgid ""
"Could not reach the sync server. Nothing was changed — will retry "
"automatically."
msgstr ""
"Kunde inte nå synkroniseringsservern. Inga ändringar gjordes. Försöker "
"automatiskt igen."

#, java-printf-format
msgctxt "sync_error_undecryptable"
msgid ""
"The server data could not be unlocked with this vault key. Nothing was "
"changed — check the vault key epoch."
msgstr ""
"Serverdata kunde inte låsas upp med den här valvnyckeln. Inga ändringar "
"gjordes. Kontrollera valvnyckelns epok."

#, java-printf-format
msgctxt "sync_error_local_read"
msgid ""
"Could not read local data (the app may be locked). Nothing was changed — "
"will retry automatically."
msgstr ""
"Kunde inte läsa lokala data. Appen kan vara låst. Inga ändringar gjordes. "
"Försöker automatiskt igen."

#, java-printf-format
msgctxt "sync_error_relay_unavailable"
msgid ""
"The sync server is unavailable. Nothing was changed — will retry "
"automatically."
msgstr ""
"Synkroniseringsservern är otillgänglig. Inga ändringar gjordes. Försöker "
"automatiskt igen."

#, java-printf-format
msgctxt "sync_error_hint"
msgid "Sync paused safely: no data was deleted. It resumes on the next sync."
msgstr ""
"Synkroniseringen har pausats säkert: inga data raderades. Den återupptas vid"
" nästa synkronisering."

#.  SnapshotSection: header + description for daily encrypted recovery
#. snapshots
#, java-printf-format
msgctxt "snapshots_title"
msgid "Recovery snapshots"
msgstr "Återställningskopior"

#, java-printf-format
msgctxt "snapshots_description"
msgid ""
"One encrypted snapshot per day, kept for 30 days. Restoring replays a day "
"through sync — newer edits still win where they conflict."
msgstr ""
"En krypterad säkerhetskopia per dag sparas i 30 dagar. Vid återställning "
"spelas en dags ändringar upp via synkroniseringen. Nyare ändringar får "
"företräde vid konflikter."

#.  SnapshotSection row: %1$s = vault type, %2$d = record count
#, java-printf-format, xml-text
msgctxt "snapshot_row"
msgid "%1$s · <xliff:g id=\"count\" example=\"42\">%2$d</xliff:g> records"
msgstr "%1$s · <xliff:g id=\"count\" example=\"42\">%2$d</xliff:g> poster"

#, java-printf-format
msgctxt "snapshot_restore"
msgid "Restore"
msgstr "Återställ"

#, java-printf-format
msgctxt "snapshot_take_now"
msgid "Back up now"
msgstr "Säkerhetskopiera nu"

#, java-printf-format
msgctxt "snapshots_empty"
msgid ""
"No snapshots yet. Snapshots are taken daily and before sync is turned off."
msgstr ""
"Inga säkerhetskopior ännu. Säkerhetskopior tas varje dag och innan "
"synkronisering stängs av."

#, java-printf-format
msgctxt "snapshot_restore_title"
msgid "Restore snapshot?"
msgstr "Återställa säkerhetskopia?"

#.  SnapshotSection restore confirm: %1$s = date, %2$s = vault type
#, java-printf-format, xml-text
msgctxt "snapshot_restore_confirm"
msgid ""
"Replay <xliff:g id=\"date\" example=\"Oct 13, 2026\">%1$s</xliff:g> "
"(<xliff:g id=\"type\" example=\"passwords\">%2$s</xliff:g>) through sync? "
"Newer edits still win where they conflict."
msgstr ""
"Spela upp <xliff:g id=\"date\" example=\"Oct 13, 2026\">%1$s</xliff:g> "
"(<xliff:g id=\"type\" example=\"passwords\">%2$s</xliff:g>) via "
"synkronisering? Nyare ändringar får företräde vid konflikter."

#.  ViewModel announce: %1$d = restored record count
#, java-printf-format, xml-text
msgctxt "snapshot_restored"
msgid ""
"Restored <xliff:g id=\"count\" example=\"42\">%1$d</xliff:g> records. "
"Reconciling with the server…"
msgstr ""
"Återställde <xliff:g id=\"count\" example=\"42\">%1$d</xliff:g> poster. "
"Synkroniserar med servern…"

#, java-printf-format
msgctxt "snapshot_restore_failed"
msgid "Could not restore that snapshot."
msgstr "Kunde inte återställa säkerhetskopian."
