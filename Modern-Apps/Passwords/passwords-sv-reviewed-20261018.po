#.  App name: launcher label and Passkey Credential Manager create-entry title
#, java-printf-format
msgctxt "app_name"
msgid "Passwords"
msgstr "Lösenord"

#.  Field label. Noun. Username associated with credential. May be empty.
#, java-printf-format
msgctxt "label_username"
msgid "Username"
msgstr "Användarnamn"

#.  Field label. Noun. The secret password itself
#, java-printf-format
msgctxt "label_password"
msgid "Password"
msgstr "Lösenord"

#.  Field label. Noun. TOTP = Time-based One-Time Password. Keep acronym,
#. input is base32 secret
#, java-printf-format
msgctxt "label_totp_secret"
msgid "TOTP Secret"
msgstr "TOTP-hemlighet"

#.  TextField hint/label for adding a website URL chip. Verb phrase, Title
#. Case, action to add
#, java-printf-format
msgctxt "label_add_website"
msgid "Add website"
msgstr "Lägg till webbplats"

#.  TopAppBar title when creating new entry. Verb phrase, Title Case
#, java-printf-format
msgctxt "add_password"
msgid "Add Password"
msgstr "Lägg till lösenord"

#.  TopAppBar title when editing existing entry. Verb phrase
#, java-printf-format
msgctxt "edit_password"
msgid "Edit Password"
msgstr "Redigera lösenord"

#.  Button inside password field to hide contents. Verb, Title Case
#, java-printf-format
msgctxt "hide"
msgid "Hide"
msgstr "Dölj"

#.  Button inside password field to reveal contents. Verb, Title Case
#, java-printf-format
msgctxt "show"
msgid "Show"
msgstr "Visa"

#.  Section header for TOTP code block. Noun, acronym TOTP
#, java-printf-format
msgctxt "section_totp"
msgid "TOTP"
msgstr "TOTP"

#.  Placeholder shown when TOTP secret is empty. Parentheses intentional,
#. lower case
#, java-printf-format
msgctxt "totp_not_configured"
msgid "(not configured)"
msgstr "(inte konfigurerat)"

#.  TOTP countdown label. %1$d = seconds remaining until code rotates, e.g.
#. 15. Keep %1$d and 's' for seconds
#, java-printf-format, xml-text
msgctxt "totp_refreshes_in"
msgid "Refreshes in <xliff:g id=\"seconds\" example=\"15\">%1$d</xliff:g> s"
msgstr "Uppdateras om <xliff:g id=\"seconds\" example=\"15\">%1$d</xliff:g> s"

#.  Section header for associated websites list. Noun plural
#, java-printf-format
msgctxt "section_websites"
msgid "Websites"
msgstr "Webbplatser"

#.  Empty state when no websites attached to credential. Parentheses
#. intentional
#, java-printf-format
msgctxt "websites_none"
msgid "(none)"
msgstr "(inga)"

#.  List fallback when password entry has no name. Parentheses
#, java-printf-format
msgctxt "no_name"
msgid "(no name)"
msgstr "(inget namn)"

#.  Detail header fallback when username and email are blank. Parentheses
#, java-printf-format
msgctxt "no_user"
msgid "(no user)"
msgstr "(ingen användare)"

#.  TopAppBar fallback title for passkey detail when RP name blank. Noun
#, java-printf-format
msgctxt "passkey_detail_title"
msgid "Passkey"
msgstr "Passkey"

#.  Detail row label. Relying Party ID = domain e.g. example.com. Keep ID
#. capitalization
#, java-printf-format
msgctxt "passkey_rp_id"
msgid "Relying Party ID"
msgstr "Förlitande parts ID"

#.  Detail row label. Relying Party display name
#, java-printf-format
msgctxt "passkey_rp_name"
msgid "Relying Party"
msgstr "Förlitande part"

#.  Detail row label. Username bound to passkey
#, java-printf-format
msgctxt "passkey_user_name"
msgid "User Name"
msgstr "Användarnamn"

#.  Detail row label. Display name of user for this passkey
#, java-printf-format
msgctxt "passkey_user_display_name"
msgid "Display Name"
msgstr "Visningsnamn"

#.  Detail row label. Long credential ID (base64url truncated in UI)
#, java-printf-format
msgctxt "passkey_credential_id"
msgid "Credential ID"
msgstr "Inloggningsuppgifternas ID"

#.  Detail row label. Timestamp when passkey was created. Noun
#, java-printf-format
msgctxt "passkey_created"
msgid "Created"
msgstr "Skapad"

#.  Detail row label. Timestamp when passkey was last used
#, java-printf-format
msgctxt "passkey_last_used"
msgid "Last Used"
msgstr "Senast använd"

#.  Section header on the password detail screen for passkeys belonging to
#. this entry. Noun plural
#, java-printf-format
msgctxt "section_passkeys"
msgid "Passkeys"
msgstr "Passkeys"

#.  Section header on the passkey detail screen for which password entry it
#. belongs to. Noun
#, java-printf-format
msgctxt "passkey_link_section"
msgid "Linked Entry"
msgstr "Länkad post"

#.  Shown in place of an entry name when this passkey belongs to no password
#. entry
#, java-printf-format
msgctxt "passkey_link_none"
msgid "Not linked"
msgstr "Inte länkad"

#.  Shown under the linked entry name when the link was found by matching, not
#. chosen by the user
#, java-printf-format
msgctxt "passkey_link_auto"
msgid "Matched automatically"
msgstr "Matchades automatiskt"

#.  Shown under the linked entry name when the user chose the link by hand
#, java-printf-format
msgctxt "passkey_link_manual"
msgid "Linked by you"
msgstr "Länkad av dig"

#.  Shown in place of an entry name when the user disconnected this passkey.
#. Explains why it does not re-match
#, java-printf-format
msgctxt "passkey_link_detached"
msgid "Disconnected. It will not be matched automatically."
msgstr "Frånkopplad. Den matchas inte automatiskt."

#.  Button. Detaches this passkey from its password entry. Verb
#, java-printf-format
msgctxt "passkey_disconnect"
msgid "Unlink"
msgstr "Ta bort länk"

#.  Button. Returns a disconnected passkey to being matched automatically.
#. Verb phrase
#, java-printf-format
msgctxt "passkey_link_use_auto"
msgid "Match automatically"
msgstr "Matcha automatiskt"

#.  Title of the dialog listing password entries to link a passkey to
#, java-printf-format
msgctxt "passkey_link_dialog_title"
msgid "Link to entry"
msgstr "Länka till post"

#.  Empty state in the link dialog when the vault has no password entries
#, java-printf-format
msgctxt "passkey_link_dialog_empty"
msgid "No entries to link to"
msgstr "Det finns inga poster att länka till"

#.  Confirmation message. %1$s = name of the password entry the passkey was
#. linked to
#, java-printf-format, xml-text
msgctxt "passkey_linked_message"
msgid "Linked to <xliff:g id=\"entry\" example=\"Example Mail\">%1$s</xliff:g>"
msgstr "Länkad till <xliff:g id=\"entry\" example=\"Example Mail\">%1$s</xliff:g>"

#.  Confirmation message after unlinking a passkey from its entry
#, java-printf-format
msgctxt "passkey_unlinked_message"
msgid "Passkey unlinked"
msgstr "Länken till passkey togs bort"

#.  Badge on a list row with more than one passkey. %1$d = how many, e.g. 2
#, java-printf-format
msgctxt "passkey_count"
msgid "%1$d"
msgstr "%1$d"

#.  Biometric/auth prompt action label shown when database needs unlocking
#. (PasskeyCredentialService pending intent). Verb phrase
#, java-printf-format
msgctxt "unlock_database"
msgid "Unlock Passwords"
msgstr "Lås upp Lösenord"

#.  Warning text above import button about CSV being plaintext
#, java-printf-format
msgctxt "import_csv_warning"
msgid ""
"Importing a CSV will bring plaintext credentials into this app. Please "
"delete the export after importing."
msgstr ""
"Import av en CSV-fil lägger in okrypterade inloggningsuppgifter i den här "
"appen. Ta bort exportfilen efter importen."

#.  Button that opens dropdown of import sources. Verb phrase
#, java-printf-format
msgctxt "import_passwords"
msgid "Import Passwords"
msgstr "Importera lösenord"

#.  Import source: Bitwarden brand name. Noun
#, java-printf-format
msgctxt "import_source_bitwarden"
msgid "Bitwarden"
msgstr "Bitwarden"

#.  Import source: Google Chrome brand name
#, java-printf-format
msgctxt "import_source_chrome"
msgid "Google Chrome"
msgstr "Google Chrome"

#.  Import source: Firefox brand name
#, java-printf-format
msgctxt "import_source_firefox"
msgid "Firefox"
msgstr "Firefox"

#.  Import source: LastPass brand name
#, java-printf-format
msgctxt "import_source_lastpass"
msgid "LastPass"
msgstr "LastPass"

#.  Import source: 1Password brand name, includes number
#, java-printf-format
msgctxt "import_source_one_password"
msgid "1Password"
msgstr "1Password"

#.  Import source: Dashlane brand name
#, java-printf-format
msgctxt "import_source_dashlane"
msgid "Dashlane"
msgstr "Dashlane"

#.  Import source: Apple Passwords product name
#, java-printf-format
msgctxt "import_source_apple"
msgid "Apple Passwords"
msgstr "Apple Lösenord"

#, java-printf-format
msgctxt "import_source_proton_pass"
msgid "Proton Pass"
msgstr "Proton Pass"

#.  Notification channel name. Covers both cross-device sign-in and
#. registration
#, java-printf-format
msgctxt "cable_channel_name"
msgid "Cross-device passkeys"
msgstr "Passkeys mellan enheter"

#.  First notification text, before the tunnel is up
#, java-printf-format
msgctxt "cable_starting"
msgid "Starting cross-device request"
msgstr "Startar begäran mellan enheter"

#.  Biometric prompt title when a scanned QR code starts a cross-device
#. passkey request
#, java-printf-format
msgctxt "cable_prompt_title"
msgid "Continue on your other device?"
msgstr "Fortsätta på din andra enhet?"

#.  Biometric prompt subtitle. Verb phrase, "Verify" = confirm your identity
#, java-printf-format
msgctxt "cable_prompt_subtitle"
msgid "Verify to approve this passkey request"
msgstr "Verifiera för att godkänna denna passkey-begäran"

#.  Notification text while connecting to the relay server. Noun phrase
#, java-printf-format
msgctxt "cable_status_connecting"
msgid "Connecting"
msgstr "Ansluter"

#.  Notification text while broadcasting over Bluetooth so the other device
#. can find this one
#, java-printf-format
msgctxt "cable_status_advertising"
msgid "Advertising over Bluetooth"
msgstr "Sänder ut via Bluetooth"

#.  Notification text during the encrypted handshake with the other device
#, java-printf-format
msgctxt "cable_status_handshake"
msgid "Performing secure handshake"
msgstr "Utför säker handskakning"

#.  Notification text once connected, waiting for the other device to say what
#. it needs
#, java-printf-format
msgctxt "cable_status_waiting"
msgid "Waiting for the other device"
msgstr "Väntar på den andra enheten"

#.  Notification text after a successful cross-device sign-in
#, java-printf-format
msgctxt "cable_status_signed_in"
msgid "Signed in on your other device"
msgstr "Inloggad på din andra enhet"

#.  Notification text after a passkey was successfully registered from the
#. other device
#, java-printf-format
msgctxt "cable_status_registered"
msgid "Passkey created"
msgstr "Passkey skapades"

#.  Notification text when the request could not be completed
#, java-printf-format
msgctxt "cable_status_failed"
msgid "Request failed"
msgstr "Begäran misslyckades"

#.  Notification text when the other device cancelled the request
#, java-printf-format
msgctxt "cable_status_cancelled"
msgid "Cancelled by the other device"
msgstr "Avbröts av den andra enheten"

#.  Message when Bluetooth is off and the user dismisses the enable-Bluetooth
#. prompt instead of turning it on
#, java-printf-format
msgctxt "cable_bluetooth_disabled_message"
msgid "Bluetooth is off. Turn it on to continue with this passkey request."
msgstr ""
"Bluetooth är avstängt. Slå på det för att fortsätta med begäran om "
"passnyckel."

#.  Message when the device has no Bluetooth adapter, so cross-device passkeys
#. cannot run
#, java-printf-format
msgctxt "cable_bluetooth_unsupported_message"
msgid ""
"This device does not support Bluetooth, so cross-device sign-in is "
"unavailable."
msgstr ""
"Den här enheten har inte stöd för Bluetooth, så inloggning mellan enheter är"
" inte tillgänglig."

#, java-printf-format
msgctxt "name_required"
msgid "Name cannot be empty"
msgstr "Namnet får inte vara tomt"

#.  Section header for the two-way KeePass file sync settings. KDBX = KeePass
#. database file extension, keep as-is
#, java-printf-format
msgctxt "sync_section"
msgid "KDBX Sync"
msgstr "KDBX-synkronisering"

#.  Toggle row title. Verb phrase enabling two-way sync with a KeePass file
#, java-printf-format
msgctxt "sync_enable"
msgid "Sync with a KDBX file"
msgstr "Synkronisera med en KDBX-fil"

#.  Supporting text under the sync toggle explaining the behaviour
#, java-printf-format
msgctxt "sync_enable_description"
msgid ""
"Keeps this vault and a KeePass file in agreement every 15 minutes and after "
"each change."
msgstr ""
"Håller detta valv och en KeePass-fil synkroniserade var 15:e minut och efter"
" varje ändring."

#.  Row title for choosing which file to sync with. Noun phrase
#, java-printf-format
msgctxt "sync_file"
msgid "KDBX file"
msgstr "KDBX-fil"

#.  Supporting text when no file has been picked yet. Parentheses intentional
#, java-printf-format
msgctxt "sync_file_none"
msgid "(none selected)"
msgstr "(ingen vald)"

#.  Menu item: pick an existing .kdbx file via the system file picker. Verb
#. phrase
#, java-printf-format
msgctxt "sync_choose_file"
msgid "Choose existing file"
msgstr "Välj befintlig fil"

#.  Menu item: create a brand new empty .kdbx file. Verb phrase
#, java-printf-format
msgctxt "sync_create_file"
msgid "Create new file"
msgstr "Skapa ny fil"

#.  Row title for the password that unlocks the KDBX file. Distinct from the
#. app unlock
#, java-printf-format
msgctxt "sync_vault_password"
msgid "Vault password"
msgstr "Valvlösenord"

#.  Supporting text when no vault password has been stored yet. Parentheses
#. intentional
#, java-printf-format
msgctxt "sync_vault_password_unset"
msgid "(not set)"
msgstr "(inte angivet)"

#.  Row title showing when the last sync ran. Noun phrase
#, java-printf-format
msgctxt "sync_last"
msgid "Last sync"
msgstr "Senaste synkronisering"

#.  Supporting text when no sync has ever completed. Adverb
#, java-printf-format
msgctxt "sync_never"
msgid "Never"
msgstr "Aldrig"

#.  Row title triggering an immediate sync. Verb phrase, Title Case
#, java-printf-format
msgctxt "sync_now"
msgid "Sync now"
msgstr "Synkronisera nu"

#.  Error: the chosen file could not be opened, e.g. moved, deleted, or
#. permission revoked
#, java-printf-format
msgctxt "sync_error_file_missing"
msgid "The KDBX file could not be opened. Nothing was changed locally."
msgstr "Det gick inte att öppna KDBX-filen. Inget ändrades lokalt."

#.  Error: the stored vault password does not unlock the file
#, java-printf-format
msgctxt "sync_error_wrong_password"
msgid "Wrong vault password. Nothing was changed locally."
msgstr "Fel valvlösenord. Inget ändrades lokalt."

#.  Error: the merged vault failed its re-parse check, so the file was left
#. untouched
#, java-printf-format
msgctxt "sync_error_verify_failed"
msgid "The merged vault failed verification, so the file was not written."
msgstr ""
"Kontrollen av det sammanfogade valvet misslyckades, så filen skrevs inte."

#.  Error with details. %1$s = raw failure message from the sync
#, java-printf-format, xml-text
msgctxt "sync_error_generic"
msgid ""
"Sync failed: <xliff:g id=\"reason\" example=\"No space left on "
"device\">%1$s</xliff:g>"
msgstr ""
"Synkroniseringen misslyckades: <xliff:g id=\"reason\" example=\"No space "
"left on device\">%1$s</xliff:g>"

#.  Status: entries vanished from the file without deletion markers, so sync
#. halted with nothing changed
#, java-printf-format
msgctxt "sync_error_quarantined"
msgid ""
"Sync paused: entries vanished from the file without deletion markers. "
"Nothing was changed. Review below to resolve."
msgstr ""
"Synkroniseringen har pausats: poster försvann från filen utan "
"borttagningsmarkeringar. Inga ändringar gjordes. Granska nedan för att lösa "
"problemet."

#.  Quarantine row title. Noun phrase
#, java-printf-format
msgctxt "sync_quarantine_title"
msgid "Review paused sync"
msgstr "Granska pausad synkronisering"

#.  Quarantine row supporting text. %1$s = date/time the sync was paused
#, java-printf-format, xml-text
msgctxt "sync_quarantine_description"
msgid ""
"Paused <xliff:g id=\"when\" example=\"Oct 14, 2026 9:41 PM\">%1$s</xliff:g>."
" Your passwords are untouched."
msgstr ""
"Pausad <xliff:g id=\"when\" example=\"Oct 14, 2026 9:41 PM\">%1$s</xliff:g>."
" Dina lösenord är orörda."

#.  Quarantine dialog body. %1$s = internal reason code for support
#, java-printf-format, xml-text
msgctxt "sync_quarantine_dialog"
msgid ""
"Another app appears to have deleted entries from the sync file (reason: "
"<xliff:g id=\"reason\" example=\"foreign_delete\">%1$s</xliff:g>). If that "
"deletion was intentional, open the file in that app and delete the same "
"entries there, or re-add them here — then resume. Resuming re-checks the "
"file; if the entries are still missing, the sync pauses again instead of "
"deleting anything."
msgstr ""
"En annan app verkar ha tagit bort poster från synkroniseringsfilen (orsak: "
"<xliff:g id=\"reason\" example=\"foreign_delete\">%1$s</xliff:g>). Om "
"borttagningen var avsiktlig öppnar du filen i den appen och tar bort samma "
"poster där eller lägger till dem här igen. När du återupptar "
"synkroniseringen kontrolleras filen igen. Om posterna fortfarande saknas "
"pausas synkroniseringen igen i stället för att något tas bort."

#.  Quarantine dialog confirm button. Verb phrase
#, java-printf-format
msgctxt "sync_quarantine_resolve"
msgid "Re-check and resume"
msgstr "Kontrollera igen och återuppta"
