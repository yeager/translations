#.  App name: launcher label. Proper noun YouPipe
#, java-printf-format
msgctxt "app_name"
msgid "YouPipe"
msgstr "YouPipe"

#.  Search bar placeholder hint. Noun, also tab label for search
#.  Video item + channel header: subscriber count. %1$s = formatted count e.g.
#. 12K. Keep word subscribers lower case
#, java-printf-format, xml-text
msgctxt "subscribers_count"
msgid "<xliff:g id=\"count\" example=\"12K\">%1$s</xliff:g> subscribers"
msgstr "<xliff:g id=\"count\" example=\"12K\">%1$s</xliff:g> prenumeranter"

#.  Empty state when recommendations empty, prompts user to watch videos to
#. get personalized feed
#, java-printf-format
msgctxt "empty_recommendations"
msgid "Watch some videos to get personalized recommendations"
msgstr "Titta på några videor för att få personliga rekommendationer"

#.  Video item details: channel | views | time. %1$s = channel name, %2$s =
#. view count e.g. 1.2M views, %3$s = time ago e.g. 2 days ago. Keep pipe
#. separators
#, java-printf-format, xml-text
msgctxt "video_info_format"
msgid ""
"<xliff:g id=\"channel\" example=\"Linus Tech Tips\">%1$s</xliff:g> | "
"<xliff:g id=\"views\" example=\"1.2M\">%2$s</xliff:g> views | <xliff:g "
"id=\"time\" example=\"2 days ago\">%3$s</xliff:g>"
msgstr ""
"<xliff:g id=\"channel\" example=\"Linus Tech Tips\">%1$s</xliff:g> | "
"<xliff:g id=\"views\" example=\"1.2M\">%2$s</xliff:g> visningar | <xliff:g "
"id=\"time\" example=\"2 days ago\">%3$s</xliff:g>"

#.  Recommendation explanation line: why this video suggested. %1$s = reason
#. e.g. watched similar
#, java-printf-format, xml-text
msgctxt "recommendation_reason"
msgid "Why: <xliff:g id=\"reason\" example=\"watched similar\">%1$s</xliff:g>"
msgstr "Varför: <xliff:g id=\"reason\" example=\"watched similar\">%1$s</xliff:g>"

#.  Section header for recommendations feed. Noun plural
#, java-printf-format
msgctxt "label_recommendations"
msgid "Recommendations"
msgstr "Rekommendationer"

#.  Time ago: just now (<1 minute). Phrase
