msgctxt "count_k_format"
msgid "<xliff:g id=\"number\" example=\"12.3\">%1$s</xliff:g>K"
msgstr "<xliff:g id=\"number\" example=\"12.3\">%1$s</xliff:g> t"

#.  Short count: millions. %1$s = number, suffix M
#, java-printf-format, xml-text
msgctxt "count_m_format"
msgid "<xliff:g id=\"number\" example=\"1.2\">%1$s</xliff:g>M"
msgstr "<xliff:g id=\"number\" example=\"1.2\">%1$s</xliff:g> mn"

#.  Short count: billions. %1$s = number, suffix B
#, java-printf-format, xml-text
msgctxt "count_b_format"
msgid "<xliff:g id=\"number\" example=\"3.4\">%1$s</xliff:g>B"
msgstr "<xliff:g id=\"number\" example=\"3.4\">%1$s</xliff:g> mdr"

#.  Video load error dialog text explaining YouTube may have blocked anonymous
#. watch from IP
#, java-printf-format
msgctxt "video_load_error"
msgid ""
"Video load error - Youtube may have blocked anonymous watch access from this"
" IP"
msgstr ""
"Det gick inte att läsa in videon. YouTube kan ha blockerat anonym visning "
"från den här IP-adressen"

