#.  Video stats format: views | time ago for channel list items. %1$s = views
#. e.g. 1M, %2$s = time ago e.g. 3 days ago
#, java-printf-format, xml-text
msgctxt "video_stat_format"
msgid ""
"<xliff:g id=\"views\" example=\"1M\">%1$s</xliff:g> views | <xliff:g "
