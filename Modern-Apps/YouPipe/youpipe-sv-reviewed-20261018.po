msgctxt "settings_sponsorblock"
msgid "SponsorBlock"
msgstr "SponsorBlock"

#.  Settings hub row: data and backup category. Noun phrase with ampersand
#, java-printf-format
msgctxt "settings_data"
msgid "Data & Backup"
msgstr "Data och säkerhetskopiering"

#.  Settings hub summary: how many SponsorBlock categories are blocked out of
#. the total. %1$d = blocked count, %2$d = total
#, java-printf-format
msgctxt "settings_sponsorblock_summary"
msgid "%1$d of %2$d blocked"
msgstr "%1$d av %2$d blockerade"

#.  Recommendation preset name when the user has manually adjusted the dials.
#. Adjective
#, java-printf-format
msgctxt "preset_custom"
msgid "Custom"
msgstr "Anpassat"

#.  Player controls: title of the playback tempo (speed) slider. Noun
#, java-printf-format
msgctxt "playback_tempo"
msgid "Tempo"
msgstr "Tempo"

#.  Player controls: title of the playback pitch slider. Noun
#, java-printf-format
msgctxt "playback_pitch"
msgid "Pitch"
msgstr "Tonhöjd"

#.  Player controls: tempo value as a multiplier. %1$s = value e.g. 1.5. Keep
#. the x suffix
#, java-printf-format, xml-text
msgctxt "playback_tempo_value"
msgid "<xliff:g id=\"value\" example=\"1.5\">%1$s</xliff:g>x"
msgstr "<xliff:g id=\"value\" example=\"1.5\">%1$s</xliff:g>x"

#.  Player controls: pitch value as a percentage. %1$d = value e.g. 100. Keep
#. the percent sign
#, java-printf-format, xml-text
msgctxt "playback_pitch_value"
msgid "<xliff:g id=\"value\" example=\"100\">%1$d</xliff:g>%%"
msgstr "<xliff:g id=\"value\" example=\"100\">%1$d</xliff:g> %%"

#.  Player controls: checkbox to control pitch independently of tempo (may
#. distort audio). Phrase
#, java-printf-format
msgctxt "playback_unhook_pitch"
msgid "Unhook pitch (may distort)"
msgstr "Frikoppla tonhöjden (kan förvränga ljudet)"

#.  Player controls: button that resets tempo and pitch to default. Verb
#.  Player controls: content description for the lock-controls button shown in
#. fullscreen. Verb phrase
#, java-printf-format
msgctxt "lock_controls"
msgid "Lock controls"
msgstr "Lås reglagen"

#.  Player controls: content description for the unlock button shown while
#. controls are locked. Verb phrase
#, java-printf-format
msgctxt "unlock_controls"
msgid "Unlock controls"
msgstr "Lås upp reglagen"

#.  Player section header in general settings. Noun
#, java-printf-format
msgctxt "label_player"
msgid "Player"
msgstr "Spelare"

#.  Toggle: keep video player controls always visible instead of auto-hiding.
#. Verb phrase
#, java-printf-format
msgctxt "label_keep_controls_visible"
msgid "Keep player controls visible"
msgstr "Visa spelarreglagen hela tiden"

#.  Description for keep-controls toggle: controls stay on screen rather than
#. hiding after inactivity. Accessibility feature
#, java-printf-format
msgctxt "label_keep_controls_visible_description"
msgid ""
"Controls stay on screen instead of hiding after 2 seconds. Useful for "
"accessibility."
msgstr ""
"Reglagen visas på skärmen i stället för att döljas efter två sekunder. "
"Praktiskt för tillgängligheten."

#.  Toggle: replace the player seek slider with a slim notification-style two-
#. state (playing/paused) progress bar. Verb phrase
#, java-printf-format
msgctxt "label_notification_style_progress"
msgid "Notification-style progress bar"
msgstr "Förloppsindikator i aviseringsstil"

#.  Description for notification-style progress toggle
#, java-printf-format
msgctxt "label_notification_style_progress_description"
msgid ""
"Replace the seek slider with a slim bar like the notification controls. It "
"looks different when playing vs paused."
msgstr ""
"Ersätt sökreglaget med en smal indikator som reglagen i aviseringen. Den ser"
" olika ut vid uppspelning och paus."

#.  Casting the video to a TV through the MA Cast app.
#.  Content description for the cast button in the player controls
#, java-printf-format
msgctxt "cast_to_tv"
msgid "Cast to a television"
msgstr "Casta till en tv"

#.  Shown where the video was, once it is playing on the TV instead. %1$s is
#. the TV's name
#, java-printf-format
msgctxt "cast_playing_on"
msgid "Playing on %1$s"
msgstr "Spelas upp på %1$s"

#.  Button under the "playing on TV" panel
#, java-printf-format
msgctxt "cast_stop"
msgid "Stop casting"
msgstr "Stoppa castning"

#.  Shown when the Cast app is not installed and the store listing is being
#. opened
#, java-printf-format
msgctxt "cast_install_prompt"
msgid "MA Cast is not installed. Opening its listing so you can install it."
msgstr ""
"MA Cast är inte installerat. Appens butikssida öppnas så att du kan "
"installera den."

#.  Shown when the installed Cast app is too old to stream app content
#, java-printf-format
msgctxt "cast_update_prompt"
msgid ""
"MA Cast is too old to play videos on your TV. Opening its listing so you can"
" update it."
msgstr ""
"MA Cast är för gammal för att spela upp videor på din tv. Appens butikssida "
"öppnas så att du kan uppdatera den."

#.  Shown when the TV would not start a stream
#, java-printf-format
msgctxt "cast_failed"
msgid "Could not start casting to your TV"
msgstr "Det gick inte att börja casta till din tv"
