#, java-printf-format, xml-text
msgctxt "time_ago_years"
msgid "<xliff:g id=\"years\" example=\"1\">%1$d</xliff:g> years ago"
msgstr "för <xliff:g id=\"years\" example=\"1\">%1$d</xliff:g> år sedan"

