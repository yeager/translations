#, java-printf-format, xml-text
msgctxt "time_ago_days"
msgid "<xliff:g id=\"days\" example=\"2\">%1$d</xliff:g> days ago"
msgstr "för <xliff:g id=\"days\" example=\"2\">%1$d</xliff:g> dagar sedan"

