"<xliff:g id=\"channel\" example=\"Linus Tech Tips\">%1$s</xliff:g> | Paid | "
"<xliff:g id=\"time\" example=\"2 days ago\">%2$s</xliff:g>"
msgstr ""
"<xliff:g id=\"channel\" example=\"Linus Tech Tips\">%1$s</xliff:g> | "
"Betalvideo | <xliff:g id=\"time\" example=\"2 days ago\">%2$s</xliff:g>"

