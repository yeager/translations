#.  App name displayed in launcher
#, java-printf-format
msgctxt "app_name"
msgid "Calendar"
msgstr "Kalender"

#.  Calendar layout picker: long display names for calendar view modes
#.  Main calendar: Agenda view showing list of upcoming events
#, java-printf-format
msgctxt "layout_agenda"
msgid "Agenda"
msgstr "Agenda"

#.  Main calendar: Day view showing single day hourly grid
#, java-printf-format
msgctxt "layout_day"
msgid "Day"
msgstr "Dag"

#.  Main calendar: Work Week view Mon-Fri
#, java-printf-format
msgctxt "layout_work_week"
msgid "Work Week"
msgstr "Arbetsvecka"

#.  Main calendar: Full Week view Mon-Sun
#, java-printf-format
msgctxt "layout_full_week"
msgid "Full Week"
msgstr "Hel vecka"

#.  Main calendar: Month view grid
#, java-printf-format
msgctxt "layout_month"
msgid "Month"
msgstr "Månad"

#.  Main calendar: Summary of work week events
#, java-printf-format
msgctxt "layout_work_week_summary"
msgid "Work Week Summary"
msgstr "Sammanfattning av arbetsvecka"

#.  Main calendar: Summary of full week events
#, java-printf-format
msgctxt "layout_full_week_summary"
