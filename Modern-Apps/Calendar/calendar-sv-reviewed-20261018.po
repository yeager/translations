msgstr "Kompakt arbetsvecka"

#.  Main calendar: Full week hourly grid where hours with no events are shrunk
#. so the whole day fits without scrolling
#, java-printf-format
msgctxt "layout_full_week_compact"
msgid "Full Week Compact"
msgstr "Kompakt hel vecka"

#.  Layout picker: short single-letter abbreviation for Agenda (keep very
#. short)
#, java-printf-format
msgctxt "layout_short_agenda"
msgid "A"
msgstr "A"

#.  Layout picker: short abbreviation for Day
#, java-printf-format
msgctxt "layout_short_day"
msgid "D"
msgstr "D"

#.  Layout picker: short abbreviation for Work Week 5 days
#, java-printf-format
msgctxt "layout_short_work_week"
msgid "W5"
msgstr "W5"

#.  Layout picker: short abbreviation for Full Week 7 days
#, java-printf-format
msgctxt "layout_short_full_week"
msgid "W7"
msgstr "W7"

#.  Layout picker: short abbreviation for Month
#, java-printf-format
msgctxt "layout_short_month"
msgid "M"
msgstr "M"

#.  Layout picker: short abbreviation for Work Week Summary (5-day summary)
#, java-printf-format
msgctxt "layout_short_work_week_summary"
msgid "W5S"
msgstr "W5S"

#.  Layout picker: short abbreviation for Full Week Summary (7-day summary)
#, java-printf-format
msgctxt "layout_short_full_week_summary"
msgid "W7S"
msgstr "W7S"

#.  Layout picker: short abbreviation for Work Week Compact (5-day compact)
#, java-printf-format
msgctxt "layout_short_work_week_compact"
msgid "W5C"
msgstr "W5C"

#.  Layout picker: short abbreviation for Full Week Compact (7-day compact)
#, java-printf-format
msgctxt "layout_short_full_week_compact"
msgid "W7C"
msgstr "W7C"

#.  Theme settings: ThemeMode enum labels
#.  Settings: follow system light/dark theme
#, java-printf-format
msgctxt "theme_system_default"
msgid "System default"
msgstr "Systemstandard"

#.  Settings: light theme option
#, java-printf-format
msgctxt "theme_light"
msgid "Light"
msgstr "Ljust"

#.  Settings: dark theme option
#, java-printf-format
msgctxt "theme_dark"
msgid "Dark"
msgstr "Mörkt"

#.  Widget: content description for app widget in widget picker
#, java-printf-format
msgctxt "calendar_widget_description"
msgid "Upcoming events at a glance - tap to open Calendar"
msgstr "Kommande händelser i överblick – tryck för att öppna Kalender"

#.  Widget: content description for month-view app widget in widget picker
#, java-printf-format
msgctxt "calendar_month_widget_description"
msgid "Month grid at a glance - tap to open Calendar"
msgstr "Månadsvy i överblick – tryck för att öppna Kalender"

#.  Month widget: overflow line in a day cell when events exceed the chip cap.
#. %1$d = hidden event count
#, java-printf-format, xml-text
msgctxt "month_widget_more_events"
msgid "+<xliff:g id=\"count\" example=\"1\">%1$d</xliff:g> more"
msgid_plural "+<xliff:g id=\"count\" example=\"3\">%1$d</xliff:g> more"
msgstr[0] "+<xliff:g id=\"count\" example=\"1\">%1$d</xliff:g> till"
msgstr[1] "+<xliff:g id=\"count\" example=\"3\">%1$d</xliff:g> till"

#.  Common actions: generic buttons used across dialogs
#.  Event details: button to add a reminder/notification for event
#, java-printf-format
msgctxt "add_reminder"
msgid "Add reminder"
msgstr "Lägg till påminnelse"

#.  Event display: titles and date formatting
#.  Shown when event has empty title
#, java-printf-format
msgctxt "no_title"
msgid "(No title)"
msgstr "(Ingen titel)"

#.  Error when event id not found in provider
#, java-printf-format
msgctxt "event_not_found"
msgid "Event not found"
msgstr "Händelsen hittades inte"

#.  Header showing month and year. %1$s = month name, %2$d = year number
#, java-printf-format, xml-text
msgctxt "month_year_format"
msgid ""
"<xliff:g id=\"month_name\" example=\"January\">%1$s</xliff:g> <xliff:g "
"id=\"year\" example=\"2025\">%2$d</xliff:g>"
msgstr ""
"<xliff:g id=\"month_name\" example=\"January\">%1$s</xliff:g> <xliff:g "
"id=\"year\" example=\"2025\">%2$d</xliff:g>"

#.  Displays a range of dates, e.g. Jan 1 - Jan 2. %1$s = start date, %2$s =
#. end date
#, java-printf-format, xml-text
msgctxt "date_range_format"
msgid ""
"<xliff:g id=\"start_date\" example=\"Jan 1\">%1$s</xliff:g> - <xliff:g "
"id=\"end_date\" example=\"Jan 2\">%2$s</xliff:g>"
msgstr ""
"<xliff:g id=\"start_date\" example=\"Jan 1\">%1$s</xliff:g> – <xliff:g "
"id=\"end_date\" example=\"Jan 2\">%2$s</xliff:g>"

#.  Displays same-day range with time. %1$s = date, %2$s = start time, %3$s =
#. end time
#, java-printf-format, xml-text
msgctxt "date_time_range_format"
msgid ""
"<xliff:g id=\"date\" example=\"Jan 1\">%1$s</xliff:g> • <xliff:g "
"id=\"start_time\" example=\"9:00 AM\">%2$s</xliff:g> - <xliff:g "
"id=\"end_time\" example=\"10:00 AM\">%3$s</xliff:g>"
msgstr ""
"<xliff:g id=\"date\" example=\"Jan 1\">%1$s</xliff:g> • <xliff:g "
"id=\"start_time\" example=\"9:00 AM\">%2$s</xliff:g> – <xliff:g "
"id=\"end_time\" example=\"10:00 AM\">%3$s</xliff:g>"

#.  Displays full range across days with times. %1$s = start date, %2$s =
#. start time, %3$s = end date, %4$s = end time
#, java-printf-format, xml-text
msgctxt "full_date_time_range_format"
msgid ""
"<xliff:g id=\"start_date\" example=\"Jan 1\">%1$s</xliff:g>, <xliff:g "
"id=\"start_time\" example=\"9:00 AM\">%2$s</xliff:g> - <xliff:g "
"id=\"end_date\" example=\"Jan 2\">%3$s</xliff:g>, <xliff:g id=\"end_time\" "
"example=\"10:00 AM\">%4$s</xliff:g>"
msgstr ""
"<xliff:g id=\"start_date\" example=\"Jan 1\">%1$s</xliff:g>, <xliff:g "
"id=\"start_time\" example=\"9:00 AM\">%2$s</xliff:g> – <xliff:g "
"id=\"end_date\" example=\"Jan 2\">%3$s</xliff:g>, <xliff:g id=\"end_time\" "
"example=\"10:00 AM\">%4$s</xliff:g>"

#.  Hour labels in calendar day/week grid
#.  Grid label for midnight hour
#, java-printf-format
msgctxt "twelve_am"
msgid "12 AM"
msgstr "00:00"

#.  Grid label for AM hours. %1$d = hour number 1-11
#, java-printf-format, xml-text
msgctxt "hour_am"
msgid "<xliff:g id=\"hour\" example=\"9\">%1$d</xliff:g> AM"
msgstr "<xliff:g id=\"hour\" example=\"9\">%1$d</xliff:g>:00"

#.  Grid label for noon hour
#, java-printf-format
msgctxt "twelve_pm"
msgid "12 PM"
msgstr "12:00"

#.  Grid label for PM hours. %1$d = hour number 1-11
#, java-printf-format, xml-text
msgctxt "hour_pm"
msgid "<xliff:g id=\"hour\" example=\"3\">%1$d</xliff:g> PM"
msgstr "<xliff:g id=\"hour\" example=\"3\">%1$d</xliff:g>:00"

#.  Edit event screen
#.  Text field label for event title
#, java-printf-format
msgctxt "label_title"
msgid "Title"
msgstr "Titel"

#.  Text field label for event description/details
#, java-printf-format
msgctxt "label_description"
msgid "Description"
msgstr "Beskrivning"

#.  Text field label for event location
#, java-printf-format
msgctxt "label_location"
msgid "Location"
msgstr "Plats"

#.  Button to choose which calendar to save event to
#, java-printf-format
msgctxt "select_calendar"
msgid "Select calendar"
msgstr "Välj kalender"

#.  Toggle for all-day event (no specific time)
#, java-printf-format
msgctxt "all_day"
msgid "All-day"
msgstr "Hela dagen"

#.  Recurrence: event does not repeat
#, java-printf-format
msgctxt "does_not_repeat"
msgid "Does not repeat"
msgstr "Upprepas inte"

#.  Recurrence section label: shows repeat rule summary. Noun/verb
#, java-printf-format
msgctxt "repeats"
msgid "Repeats"
msgstr "Upprepas"

#.  Settings screen
#.  Account label when calendar has no account
#, java-printf-format
msgctxt "no_account"
msgid "(No account)"
msgstr "(Inget konto)"

#.  Settings: shows calendar database ID. %1$d = numeric calendar ID
#, java-printf-format, xml-text
msgctxt "calendar_id_label"
msgid "ID: <xliff:g id=\"calendar_id\" example=\"1\">%1$d</xliff:g>"
msgstr "ID: <xliff:g id=\"calendar_id\" example=\"1\">%1$d</xliff:g>"

#.  Calendar picker dialog
#.  Dialog title to pick a calendar from list
#, java-printf-format
msgctxt "choose_calendar"
msgid "Choose calendar"
msgstr "Välj kalender"

#.  Label for local on-device account, no cloud sync
#, java-printf-format
msgctxt "local_account"
msgid "(Local)"
msgstr "(Lokal)"

#.  Date picker dialog
#.  Menu action to jump to specific date. Verb.
#, java-printf-format
msgctxt "go_to_date"
msgid "Go to date"
msgstr "Gå till datum"

#.  Recurrence dialog: RRULE editor
#.  Dialog title and option for repetition. Verb/Noun.
#, java-printf-format
msgctxt "repeat"
msgid "Repeat"
msgstr "Upprepa"

#.  Label meaning every N interval. Part of 'Every 2 weeks'
#, java-printf-format
msgctxt "every"
msgid "Every"
msgstr "Varje"

#.  Dropdown showing selected frequency, ▼ indicates dropdown. %1$s =
#. frequency like Weekly
#, java-printf-format, xml-text
msgctxt "dropdown_freq_format"
msgid "<xliff:g id=\"frequency\" example=\"Weekly\">%1$s</xliff:g> ▼"
msgstr "<xliff:g id=\"frequency\" example=\"Weekly\">%1$s</xliff:g> ▼"

#.  Label for weekday selection in weekly repeat
#, java-printf-format
msgctxt "on_days_of_week"
msgid "On days of week"
msgstr "På veckodagar"

#.  Preposition for date rules, e.g. 'On day 15'
#, java-printf-format
msgctxt "on_label"
msgid "On"
msgstr "Den"

#.  Monthly recurrence: on specific day of month. %1$d = day number 1-31
#, java-printf-format, xml-text
msgctxt "month_option_day_of_month"
msgid "On day <xliff:g id=\"day\" example=\"15\">%1$d</xliff:g> of the month"
msgstr "Den <xliff:g id=\"day\" example=\"15\">%1$d</xliff:g>:e dagen i månaden"

#.  Monthly recurrence: on nth weekday, e.g. On the second Monday. %1$s =
#. ordinal like first/second, %2$s = weekday
#, java-printf-format, xml-text
msgctxt "month_option_nth_weekday"
msgid ""
"On the <xliff:g id=\"ordinal\" example=\"second\">%1$s</xliff:g> <xliff:g "
"id=\"weekday\" example=\"Monday\">%2$s</xliff:g>"
msgstr ""
"Den <xliff:g id=\"ordinal\" example=\"second\">%1$s</xliff:g> <xliff:g "
"id=\"weekday\" example=\"Monday\">%2$s</xliff:g>"

#.  Monthly recurrence: on last weekday of month, e.g. On the last Friday.
#. %1$s = weekday name
#, java-printf-format, xml-text
msgctxt "month_option_last_weekday"
msgid "On the last <xliff:g id=\"weekday\" example=\"Friday\">%1$s</xliff:g>"
msgstr "Sista <xliff:g id=\"weekday\" example=\"Friday\">%1$s</xliff:g>"

#.  Yearly recurrence: on month and day. %1$s = month name, %2$d = day number
#, java-printf-format, xml-text
msgctxt "year_option_month_day"
msgid ""
"On <xliff:g id=\"month\" example=\"March\">%1$s</xliff:g> <xliff:g "
"id=\"day\" example=\"15\">%2$d</xliff:g>"
msgstr ""
"Den <xliff:g id=\"month\" example=\"March\">%1$s</xliff:g> <xliff:g "
"id=\"day\" example=\"15\">%2$d</xliff:g>"

#.  Yearly: on specific week of year. %1$d = week number, %2$s = weekday
#, java-printf-format, xml-text
msgctxt "year_option_week"
msgid ""
"On week <xliff:g id=\"week_num\" example=\"12\">%1$d</xliff:g> of the year "
"on <xliff:g id=\"weekday\" example=\"Monday\">%2$s</xliff:g>"
msgstr ""
"Vecka <xliff:g id=\"week_num\" example=\"12\">%1$d</xliff:g> på året, "
"<xliff:g id=\"weekday\" example=\"Monday\">%2$s</xliff:g>"

#.  Yearly: on specific day of year. %1$d = day of year 1-365
#, java-printf-format, xml-text
msgctxt "year_option_day_of_year"
msgid "On day <xliff:g id=\"day_of_year\" example=\"100\">%1$d</xliff:g> of the year"
msgstr "Dag <xliff:g id=\"day_of_year\" example=\"100\">%1$d</xliff:g> på året"

#.  Recurrence end options header. Noun/Verb.
#, java-printf-format
msgctxt "end"
msgid "End"
msgstr "Slut"

#.  Recurrence never ends
#, java-printf-format
msgctxt "never"
msgid "Never"
msgstr "Aldrig"

#.  Recurrence ends after count. Noun, number of occurrences
#, java-printf-format
msgctxt "count"
msgid "Count"
msgstr "Antal"

#.  Recurrence ends on date. Preposition.
#, java-printf-format
msgctxt "until"
msgid "Until"
msgstr "Till och med"

#.  Shows selected until date. %1$s = formatted date
#, java-printf-format, xml-text
msgctxt "until_date"
msgid "Until: <xliff:g id=\"date\" example=\"Dec 31, 2025\">%1$s</xliff:g>"
msgstr "Till och med: <xliff:g id=\"date\" example=\"Dec 31, 2025\">%1$s</xliff:g>"

#.  Repeat mode: a recurring pattern such as every 2 weeks
#, java-printf-format
msgctxt "repeat_mode_pattern"
msgid "Pattern"
msgstr "Mönster"

#.  Repeat mode: a hand-picked set of dates rather than a pattern
#, java-printf-format
msgctxt "repeat_mode_dates"
msgid "Specific dates"
msgstr "Specifika datum"

#.  Header for the list of hand-picked repeat dates
#, java-printf-format
msgctxt "repeat_on_dates"
msgid "Repeats on these dates"
msgstr "Upprepas på dessa datum"

#.  The event's own date, always the first occurrence. %1$s = formatted date
#, java-printf-format, xml-text
msgctxt "repeat_date_first"
msgid "<xliff:g id=\"date\" example=\"Mon, Dec 1\">%1$s</xliff:g> (event date)"
msgstr "<xliff:g id=\"date\" example=\"Mon, Dec 1\">%1$s</xliff:g> (händelsedatum)"

#.  Button that opens a date picker to add another repeat date
#, java-printf-format
msgctxt "repeat_add_date"
msgid "Add date"
msgstr "Lägg till datum"

#.  Repeat summary for hand-picked dates. %1$d = how many days the event
#. happens on
#, java-printf-format, xml-text
msgctxt "repeat_dates_summary"
msgid "On <xliff:g id=\"count\" example=\"1\">%1$d</xliff:g> date"
msgid_plural "On <xliff:g id=\"count\" example=\"4\">%1$d</xliff:g> dates"
msgstr[0] "På <xliff:g id=\"count\" example=\"1\">%1$d</xliff:g> datum"
msgstr[1] "På <xliff:g id=\"count\" example=\"4\">%1$d</xliff:g> datum"

#.  Add calendar dialog
#.  Dialog title for creating new local calendar
#, java-printf-format
msgctxt "new_local_calendar"
msgid "New local calendar"
msgstr "Ny lokal kalender"

#.  Text field label for calendar name input
#, java-printf-format
msgctxt "calendar_name"
msgid "Calendar name"
msgstr "Kalendernamn"

#.  Label for color picker section
#, java-printf-format
msgctxt "choose_color"
msgid "Choose color:"
msgstr "Välj färg:"

#.  Change color dialog
#.  Dialog title for changing calendar color
#, java-printf-format
msgctxt "change_color_for"
msgid "Change color for this calendar"
msgstr "Ändra färg för den här kalendern"

#.  Button to confirm color change. Verb.
#, java-printf-format
msgctxt "change_color"
msgid "Change color"
msgstr "Ändra färg"

#.  Delete calendar flow
#.  Dialog title to delete calendar. Verb phrase.
#, java-printf-format
msgctxt "delete_calendar"
msgid "Delete calendar"
msgstr "Ta bort kalender"

#.  Confirmation message when deleting calendar with events
#, java-printf-format
msgctxt "delete_calendar_confirm"
msgid ""
"Are you sure you want to delete this calendar? This will remove all events "
"in the calendar."
msgstr ""
"Vill du ta bort den här kalendern? Alla händelser i kalendern tas då bort."

#.  Confirmation with calendar name. %1$s = calendar name
#, java-printf-format, xml-text
msgctxt "delete_calendar_name_confirm"
msgid ""
"Are you sure you want to delete \"<xliff:g id=\"calendar_name\" "
"example=\"Work\">%1$s</xliff:g>\"? This will remove all events in the "
"calendar."
msgstr ""
"Vill du ta bort ”<xliff:g id=\"calendar_name\" "
"example=\"Work\">%1$s</xliff:g>”? Alla händelser i kalendern tas då bort."

#.  Rename calendar dialog
#.  Dialog title to rename calendar
#, java-printf-format
msgctxt "rename_calendar"
msgid "Rename calendar"
msgstr "Byt namn på kalender"

#.  Text field label for new calendar name
#, java-printf-format
msgctxt "new_name"
msgid "New name"
msgstr "Nytt namn"

#.  Empty state when no calendars exist, prompts user to create
#, java-printf-format
msgctxt "create_a_calendar"
msgid "Create a calendar"
msgstr "Skapa en kalender"

#.  Timezone picker
#.  Dialog title to choose timezone
#, java-printf-format
msgctxt "choose_timezone"
msgid "Choose timezone"
msgstr "Välj tidszon"

#.  Event details: location row action
#.  Button to open event location in navigation/maps app. Verb.
#, java-printf-format
msgctxt "open_location_in_navigation"
msgid "Open location"
msgstr "Öppna plats"

#.  Delete event dialog: when editing recurring event, choose single vs all
#.  Option to delete only this occurrence of recurring event
#, java-printf-format
msgctxt "delete_this_event"
msgid "Delete this event"
msgstr "Ta bort den här händelsen"

#.  Option to delete all occurrences of recurring event
#, java-printf-format
msgctxt "delete_all_events"
msgid "Delete all events"
msgstr "Ta bort alla händelser"

#.  Shown when the provider refused to delete an event. Sentence
#, java-printf-format
msgctxt "event_delete_failed"
msgid "Couldn't delete the event"
msgstr "Det gick inte att ta bort händelsen"

#.  Edit event: save-scope chooser for recurring events, mirrors the delete
#. options
#.  Option to apply edits to only this occurrence of a recurring event
#, java-printf-format
msgctxt "save_this_event"
msgid "Save this event"
msgstr "Spara den här händelsen"

#.  Option to apply edits to this and all following occurrences
#, java-printf-format
msgctxt "save_this_and_following_events"
msgid "Save this and following events"
msgstr "Spara den här och följande händelser"

#.  Option to apply edits to every occurrence
#, java-printf-format
msgctxt "save_all_events"
msgid "Save all events"
msgstr "Spara alla händelser"

#.  Shown when the edited occurrence can't be resolved; nothing is saved
#, java-printf-format
msgctxt "edit_occurrence_not_found"
msgid "Couldn't find this occurrence — nothing was saved"
msgstr "Det gick inte att hitta den här förekomsten – inget sparades"

#.  Shown when an event's calendar is missing
#, java-printf-format
msgctxt "calendar_not_found"
msgid "Calendar not found"
msgstr "Kalendern hittades inte"

#.  Import ICS dialog: import events from .ics file
#.  Dropdown option to create new calendar for import. + indicates add new
#, java-printf-format
msgctxt "create_new_calendar"
msgid "+ Create new calendar"
msgstr "+ Skapa ny kalender"

#.  Settings: row to open file picker for .ics import
#, java-printf-format
msgctxt "import_ics_file"
msgid "Import .ics file"
msgstr "Importera .ics-fil"

#.  Settings: row to choose a destination file for .ics export
#, java-printf-format
msgctxt "export_ics_file"
msgid "Export .ics file"
msgstr "Exportera .ics-fil"

#.  Settings: row to export events to an .ics file
#, java-printf-format
msgctxt "export_events_to_ics_file"
msgid "Export events to an .ics file"
msgstr "Exportera händelser till en .ics-fil"

#.  Confirmation after writing an .ics file
#, java-printf-format
msgctxt "export_ics_success"
msgid "Calendar exported"
msgstr "Kalendern har exporterats"

#.  Shown when writing an .ics file failed. %1$s = error message
#, java-printf-format, xml-text
msgctxt "export_ics_failed_format"
msgid ""
"Calendar export failed: <xliff:g id=\"error\" example=\"permission "
"denied\">%1$s</xliff:g>"
msgstr ""
"Kalenderexport misslyckades: <xliff:g id=\"error\" example=\"permission "
"denied\">%1$s</xliff:g>"

#.  Settings: row label for ICS import feature
#, java-printf-format
msgctxt "import_events"
msgid "Import events"
msgstr "Importera händelser"

#.  Import flow: option to import into existing calendar
#, java-printf-format
msgctxt "import_to_existing_calendar"
msgid "Import to existing calendar"
msgstr "Importera till befintlig kalender"

#.  Import flow: option to create new calendar for imported events
#, java-printf-format
msgctxt "create_new_calendar_option"
msgid "Create new calendar"
msgstr "Skapa ny kalender"

#.  Empty state when ICS file contains no parsable events
#, java-printf-format
msgctxt "no_events_found"
msgid "No events found"
msgstr "Inga händelser hittades"

#.  Summary showing number of events parsed and ready. %1$d = event count
#, java-printf-format, xml-text
msgctxt "import_summary"
msgid "<xliff:g id=\"count\" example=\"5\">%1$d</xliff:g> event ready to import"
msgid_plural ""
"<xliff:g id=\"count\" example=\"5\">%1$d</xliff:g> events ready to import"
msgstr[0] ""
"<xliff:g id=\"count\" example=\"5\">%1$d</xliff:g> händelse klar att "
