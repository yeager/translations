#. before the app relaunches itself so the restored files take effect. Long
#. duration
#, java-printf-format
msgctxt "backup_import_success"
msgid "Backup imported successfully. Restarting the app…"
msgstr "Säkerhetskopian har importerats. Appen startas om …"

#.  Shared library: UI – BackupButtons: Toast when import fails. %1$s = raw
#. exception message, do not translate placeholder content
#, java-printf-format, xml-text
msgctxt "backup_import_failed_format"
msgid ""
"Backup import failed: <xliff:g id=\"error\" example=\"invalid "
"file\">%1$s</xliff:g>"
msgstr ""
"Det gick inte att importera säkerhetskopian: <xliff:g id=\"error\" "
"example=\"invalid file\">%1$s</xliff:g>"

