msgstr "Ange ett huvudlösenord för KDBX-filen:"

#.  Shared library: UI – BackupButtons: Toast shown when KDBX backup export
#. succeeds. Short success feedback
#, java-printf-format
msgctxt "backup_export_success"
msgid "Backup exported successfully"
msgstr "Säkerhetskopian har exporterats"

#.  Shared library: UI – BackupButtons: Toast when export fails. %1$s = raw
#. exception message, do not translate placeholder content
#, java-printf-format, xml-text
msgctxt "backup_export_failed_format"
msgid ""
"Backup export failed: <xliff:g id=\"error\" example=\"permission "
"denied\">%1$s</xliff:g>"
msgstr ""
"Det gick inte att exportera säkerhetskopian: <xliff:g id=\"error\" "
"example=\"permission denied\">%1$s</xliff:g>"

