#.  Shared library: UI – BackupButtons: AlertDialog title when exporting KDBX
#. backup, shown after SAF CreateDocument picker if password needed
#, java-printf-format
msgctxt "backup_dialog_title_export"
msgid "Export Password"
msgstr "Exportera lösenord"

#.  Shared library: UI – BackupButtons: AlertDialog title when importing KDBX
#. backup, shown after SAF OpenDocument picker if password needed
#, java-printf-format
msgctxt "backup_dialog_title_import"
msgid "Import Password"
msgstr "Importera lösenord"

